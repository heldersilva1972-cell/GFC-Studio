@using Microsoft.AspNetCore.Authorization
@using GFC.BlazorServer.Auth
@using GFC.Core.Interfaces
@using GFC.Core.Models
@inject NavigationManager Navigation
@inject IUserUsageService UsageService
@inject CustomAuthenticationStateProvider AuthStateProvider
@inject IUserManagementService UserService

<nav class="app-nav-bar animate-entrance">
    <div class="container nav-tabs-container">
        @* SLOT 1: HUB (Always Fixed) *@
        <button class="nav-tab-item @GetActiveClass("Hub")" style="border: none; background: none;" @onclick='() => NavigateTo("/mobile", "Hub")'>
            <i class="bi bi-grid@(_activeTab == "Hub" ? "-fill" : "")"></i>
            <span class="small" style="font-size: 0.65rem; font-weight: 600;">Hub</span>
        </button>

        @* SLOT 2 *@
        @RenderSlot(_slot2)

        @* SLOT 3 *@
        @RenderSlot(_slot3)

        @* SLOT 4 *@
        @RenderSlot(_slot4)
    </div>
</nav>

@code {
    [Parameter]
    public string ActiveTab { get; set; } = "Hub";

    // Internal state
    private string _activeTab => ActiveTab; // normalized
    private NavItem? _slot2;
    private NavItem? _slot3;
    private NavItem? _slot4;

    private class NavItem
    {
        public string Label { get; set; }
        public string Icon { get; set; }
        public string? ActiveIcon { get; set; } // Explicit active icon
        public string Route { get; set; }
        public string Identifier { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadNavItems();
        
        // Track current page usage (Fire and forget to not block UI)
        _ = TrackUsage();
    }

    private async Task TrackUsage()
    {
        try
        {
            var user = AuthStateProvider.GetCurrentUser();
            if (user != null && !string.IsNullOrEmpty(ActiveTab) && ActiveTab != "Hub")
            {
                await UsageService.TrackPageUsageAsync(user.UserId, ActiveTab);
            }
        }
        catch { /* Ignore tracking errors */ }
    }

    private async Task LoadNavItems()
    {
        var user = AuthStateProvider.GetCurrentUser();
        if (user == null) return;

        // 1. Get User Permissions
        HashSet<string> permittedRoutes = new();
        if (user.IsAdmin)
        {
            permittedRoutes.Add("ALL"); // Wildcard for admins
        }
        else
        {
            var permissions = await Task.Run(() => UserService.GetUserPagePermissions(user.UserId));
            permittedRoutes = permissions.Select(p => p.Page?.PageRoute?.ToLower() ?? "").ToHashSet();
        }

        bool CanAccess(string feature)
        {
            if (feature == "Hub") return true;
            if (permittedRoutes.Contains("ALL")) return true;

            return feature switch
            {
                "Bartenders schedule" => permittedRoutes.Contains("mobile/schedule"),
                "End of shift sales" => permittedRoutes.Contains("mobile/shift-report"),
                "Bartender liquor checkout" => permittedRoutes.Contains("mobile/liquor/checkout"),
                "liquor inventory manager" => permittedRoutes.Contains("mobile/liquor/manage"),
                "income charts" => permittedRoutes.Contains("mobile/analytics"),
                "Key Cards" => permittedRoutes.Contains("mobile/keycards"),
                "Dues" => permittedRoutes.Contains("mobile/dues"),
                "bartender schedule manager" => permittedRoutes.Contains("mobile/manage-schedule"),
                _ => false
            };
        }

        // 2. Get Usage Data (Get enough to fill slots)
        var topPages = await UsageService.GetTopUsedPagesAsync(user.UserId, 20);

        // 3. Define Default Priority (Fallback if no usage data exists)
        // This ensures new users or users with cleared history still see the most important apps first
        var defaultPriority = new List<string> 
        { 
            "Bartenders schedule", 
            "End of shift sales", 
            "income charts", 
            "Bartender liquor checkout", 
            "liquor inventory manager", 
            "Key Cards", 
            "Dues", 
            "bartender schedule manager" 
        };

        // 4. Merge Usage + Defaults
        // We prioritize high usage items first, then fill gaps with defaults
        var candidateIds = new List<string>(topPages);
        foreach (var def in defaultPriority)
        {
            if (!candidateIds.Contains(def))
            {
                candidateIds.Add(def);
            }
        }

        // 5. Select Final Slots
        // We need exactly 3 slots for positions 2, 3, and 4 (Hub is always #1)
        var finalSlots = new List<NavItem>();
        
        foreach (var id in candidateIds)
        {
            if (finalSlots.Count >= 3) break; 

            // Filter: Must not be Hub (fixed), must be permitted
            if (id != "Hub" && CanAccess(id))
            {
                finalSlots.Add(GetDefinition(id));
            }
        }

        // 6. Assign to component state
        if (finalSlots.Count > 0) _slot2 = finalSlots[0];
        if (finalSlots.Count > 1) _slot3 = finalSlots[1];
        if (finalSlots.Count > 2) _slot4 = finalSlots[2];
        
        StateHasChanged();
    }

    private void NavigateTo(string route, string identifier)
    {
        Navigation.NavigateTo(route);
    }

    private string GetActiveClass(string identifier)
    {
        return _activeTab == identifier ? "active" : "";
    }

    private RenderFragment RenderSlot(NavItem? item) => builder =>
    {
        if (item == null) return;
        
        bool isActive = _activeTab == item.Identifier;
        string iconClass = isActive ? (item.ActiveIcon ?? item.Icon.Replace("-fill", "") + "-fill") : item.Icon;
        
        builder.OpenElement(0, "button");
        builder.AddAttribute(1, "class", $"nav-tab-item {GetActiveClass(item.Identifier)}");
        builder.AddAttribute(2, "style", "border: none; background: none;");
        builder.AddAttribute(3, "onclick", EventCallback.Factory.Create(this, () => NavigateTo(item.Route, item.Identifier)));
        
        builder.OpenElement(4, "i");
        builder.AddAttribute(5, "class", iconClass); 
        builder.CloseElement(); // i

        builder.OpenElement(6, "span");
        builder.AddAttribute(7, "class", "small");
        builder.AddAttribute(8, "style", "font-size: 0.65rem; font-weight: 600;");
        builder.AddContent(9, item.Label);
        builder.CloseElement(); // span

        builder.CloseElement(); // button
    };

    private NavItem GetDefinition(string identifier)
    {
        return identifier switch
        {
            "Bartenders schedule" => new NavItem { Label = "Schedule", Icon = "bi bi-calendar-event", ActiveIcon = "bi bi-calendar-event-fill", Route = "/mobile/schedule", Identifier = "Bartenders schedule" },
            "End of shift sales" => new NavItem { Label = "Reports", Icon = "bi bi-calendar-check", ActiveIcon = "bi bi-calendar-check-fill", Route = "/mobile/shift-report", Identifier = "End of shift sales" },
            "income charts" => new NavItem { Label = "Charts", Icon = "bi bi-graph-up-arrow", ActiveIcon = "bi bi-graph-up-arrow-fill", Route = "/mobile/analytics", Identifier = "income charts" },
            "Bartender liquor checkout" => new NavItem { Label = "Checkout", Icon = "bi bi-qr-code-scan", ActiveIcon = "bi bi-qr-code-scan", Route = "/mobile/liquor/checkout", Identifier = "Bartender liquor checkout" },
            "liquor inventory manager" => new NavItem { Label = "Liquor", Icon = "bi bi-boxes", ActiveIcon = "bi bi-boxes", Route = "/mobile/liquor/manage", Identifier = "liquor inventory manager" },
            "Key Cards" => new NavItem { Label = "Cards", Icon = "bi bi-credit-card", ActiveIcon = "bi bi-credit-card-fill", Route = "/mobile/keycards", Identifier = "Key Cards" },
            "Dues" => new NavItem { Label = "Dues", Icon = "bi bi-cash-stack", ActiveIcon = "bi bi-cash-stack", Route = "/mobile/dues", Identifier = "Dues" },
            "bartender schedule manager" => new NavItem { Label = "Admin", Icon = "bi bi-gear", ActiveIcon = "bi bi-gear-fill", Route = "/mobile/manage-schedule", Identifier = "bartender schedule manager" },
            _ => new NavItem { Label = identifier, Icon = "bi bi-app", ActiveIcon = "bi bi-app-indicator", Route = "/mobile", Identifier = identifier }
        };
    }
}
