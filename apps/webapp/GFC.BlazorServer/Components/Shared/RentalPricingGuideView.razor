@code {
    [Parameter] public WebsiteSettings? Settings { get; set; }
    [Parameter] public bool HideToolbar { get; set; } = false;
    [Parameter] public bool ShowFullPageLink { get; set; } = true;
    [Parameter] public string? InitialSectionFilter { get; set; }
    [Parameter] public string? InitialMode { get; set; }
    [Parameter] public EventCallback<RentalPricingGuideModel> OnCustomGuideSaved { get; set; }

    private string ActiveMode { get; set; } = "live";
    private bool IsEditing { get; set; } = false;
    private bool IsPrintMode { get; set; } = false;
    private bool _isSaving { get; set; } = false;
    private string? _activeSectionFilter { get; set; } = null;

    private bool _showEmbedModal = false;
    private string _selectedEmbedTab = "tiers";

    private bool IsSingleSectionMode => !string.IsNullOrEmpty(_activeSectionFilter) && _activeSectionFilter != "all";

    private RentalPricingGuideModel _liveModel = new();
    private RentalPricingGuideModel _customModel = new();

    private RentalPricingGuideModel ActiveModel => ActiveMode == "live" ? _liveModel : _customModel;

    private string? _lastLoadedPricingGuideJson = null;

    protected override void OnParametersSet()
    {
        if (!string.IsNullOrEmpty(InitialMode) && string.IsNullOrEmpty(_lastLoadedPricingGuideJson))
        {
            ActiveMode = InitialMode;
        }

        if (!string.IsNullOrEmpty(InitialSectionFilter))
        {
            _activeSectionFilter = InitialSectionFilter;
        }

        // Only reload if we are not actively editing and the JSON content has changed
        if (!IsEditing && (_lastLoadedPricingGuideJson != Settings?.PricingGuideJson || _lastLoadedPricingGuideJson == null))
        {
            RefreshModels();
        }
    }

    private bool ShouldShowSection(string section)
    {
        if (string.IsNullOrEmpty(_activeSectionFilter) || _activeSectionFilter == "all") return true;
        if (section == "header") return _activeSectionFilter == "all";
        if (section == "tiers") return _activeSectionFilter == "tiers";
        if (section == "chart") return _activeSectionFilter == "chart";
        if (section == "bottom") return _activeSectionFilter == "bar" || _activeSectionFilter == "addons";
        if (section == "bar") return _activeSectionFilter == "bar" || _activeSectionFilter == "all";
        if (section == "addons") return _activeSectionFilter == "addons" || _activeSectionFilter == "all";
        return false;
    }

    private void RefreshModels()
    {
        _lastLoadedPricingGuideJson = Settings?.PricingGuideJson;
        _liveModel = RentalPricingGuideModel.CreateDefaultFromSettings(Settings);

        if (!string.IsNullOrWhiteSpace(Settings?.PricingGuideJson))
        {
            try
            {
                var deserialized = JsonSerializer.Deserialize<RentalPricingGuideModel>(Settings.PricingGuideJson);
                if (deserialized != null)
                {
                    _customModel = deserialized;
                    return;
                }
            }
            catch { }
        }

        _customModel = RentalPricingGuideModel.CreateSample2027Model();
    }

    private void SetMode(string mode)
    {
        ActiveMode = mode;
        if (mode == "live")
        {
            IsEditing = false;
        }
    }

    private void ToggleEdit()
    {
        IsEditing = !IsEditing;
    }

    private void CopyFromLiveSettings()
    {
        _customModel = RentalPricingGuideModel.CreateDefaultFromSettings(Settings);
        ToastService.ShowSuccess("Copied live settings into custom pricing guide!");
    }

    private void LoadSample2027()
    {
        _customModel = RentalPricingGuideModel.CreateSample2027Model();
        ToastService.ShowSuccess("Loaded 2027 proposal sample rates!");
    }

    private async Task SaveCustomGuide()
    {
        _isSaving = true;
        try
        {
            var json = JsonSerializer.Serialize(_customModel);

            if (Settings != null)
            {
                Settings.PricingGuideJson = json;
                _lastLoadedPricingGuideJson = json;
                await WebsiteSettingsService.UpdateWebsiteSettingsAsync(Settings);
            }
            else
            {
                var current = await WebsiteSettingsService.GetWebsiteSettingsAsync();
                current.PricingGuideJson = json;
                _lastLoadedPricingGuideJson = json;
                await WebsiteSettingsService.UpdateWebsiteSettingsAsync(current);
            }

            if (OnCustomGuideSaved.HasDelegate)
            {
                await OnCustomGuideSaved.InvokeAsync(_customModel);
            }
            IsEditing = false;
            ToastService.ShowSuccess("Custom Pricing Guide saved successfully!");
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Failed to save: {ex.Message}");
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task TriggerPrint()
    {
        await JSRuntime.InvokeVoidAsync("window.print");
    }

    private async Task CopySectionEmbed(string sectionKey)
    {
        var baseUrl = Navigation.BaseUri.TrimEnd('/');
        var (name, height) = sectionKey switch
        {
            "tiers" => ("Top 3 Pricing Tier Cards", 450),
            "bar" => ("Bar Service Options", 320),
            "addons" => ("Additional Services", 320),
            "chart" => ("Rate Comparison Chart", 400),
            _ => ("Pricing Guide Sheet", 850)
        };

        var url = string.IsNullOrEmpty(sectionKey) || sectionKey == "all"
            ? $"{baseUrl}/rentals/pricing-guide?mode={ActiveMode}&embed=true"
            : $"{baseUrl}/rentals/pricing-guide?section={sectionKey}&mode={ActiveMode}&embed=true";

        var code = $"<iframe src=\"{url}\" width=\"100%\" height=\"{height}\" frameborder=\"0\" style=\"border:none; width:100%; min-height:{height}px;\"></iframe>";
        
        try
        {
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", code);
            ToastService.ShowSuccess($"{name} embed code copied to clipboard!");
        }
        catch
        {
            ToastService.ShowInfo($"Embed code for {name} is ready.");
        }
    }

    private string GetEmbedCodeForTab(string tab)
    {
        var baseUrl = Navigation.BaseUri.TrimEnd('/');
        var height = tab switch
        {
            "tiers" => 450,
            "bar" => 320,
            "addons" => 320,
            "chart" => 400,
            _ => 850
        };

        var url = string.IsNullOrEmpty(tab) || tab == "all"
            ? $"{baseUrl}/rentals/pricing-guide?mode={ActiveMode}&embed=true"
            : $"{baseUrl}/rentals/pricing-guide?section={tab}&mode={ActiveMode}&embed=true";

        return $"<iframe src=\"{url}\" width=\"100%\" height=\"{height}\" frameborder=\"0\" style=\"border:none; width:100%; min-height:{height}px;\"></iframe>";
    }

    private void AddTierItem(PricingGuideTierCard card)
    {
        card.Items.Add(new PricingGuideItem { Label = "New Slot", PriceText = "$0" });
    }

    private void RemoveTierItem(PricingGuideTierCard card, PricingGuideItem item)
    {
        card.Items.Remove(item);
    }

    private void AddChartRow()
    {
        ActiveModel.ChartRows.Add(new PricingComparisonRow { DayLabel = "New Time Slot", NonMemberAmount = 0, MemberAmount = 0, NonProfitAmount = 0 });
    }

    private void RemoveChartRow(PricingComparisonRow row)
    {
        ActiveModel.ChartRows.Remove(row);
    }

    private void AddServiceItem(PricingGuideSection section)
    {
        section.Items.Add(new PricingGuideServiceItem { Name = "New Service", Description = "Service description", FeeBadgeText = "$0 flat" });
    }

    private void RemoveServiceItem(PricingGuideSection section, PricingGuideServiceItem item)
    {
        section.Items.Remove(item);
    }
}
