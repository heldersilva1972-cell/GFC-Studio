@using GFC.Core.Models
@using GFC.Core.Interfaces
@using System.Text.Json
@inject IJSRuntime JSRuntime
@inject IToastService ToastService
@inject NavigationManager Navigation
@inject IWebsiteSettingsService WebsiteSettingsService

<div class="pricing-guide-view-wrapper @(IsPrintMode ? "print-mode" : "")">
    <!-- TOP TOOLBAR (Hidden during direct print or when embedded) -->
    @if (!HideToolbar)
    {
        <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2 p-3 bg-white rounded-4 border shadow-sm no-print">
            <!-- Mode Switcher -->
            <div class="d-flex align-items-center gap-2">
                <span class="fw-bold small text-dark me-1"><i class="bi bi-layers-half text-primary me-1"></i>Guide Mode:</span>
                <div class="btn-group btn-group-sm shadow-sm" role="group">
                    <button type="button" class="btn @(ActiveMode == "live" ? "btn-primary fw-bold" : "btn-outline-secondary")" @onclick='() => SetMode("live")'>
                        <i class="bi bi-arrow-repeat me-1"></i>Live Settings Rates
                    </button>
                    <button type="button" class="btn @(ActiveMode == "custom" ? "btn-primary fw-bold" : "btn-outline-secondary")" @onclick='() => SetMode("custom")'>
                        <i class="bi bi-pencil-square me-1"></i>Custom / Proposal Rates
                    </button>
                </div>
            </div>

            <!-- Action Buttons -->
            <div class="d-flex align-items-center gap-2 flex-wrap">
                @if (ActiveMode == "custom")
                {
                    @if (IsEditing)
                    {
                        <button type="button" class="btn btn-sm btn-outline-info d-flex align-items-center gap-1 shadow-sm" @onclick="CopyFromLiveSettings" title="Populate from Current Settings">
                            <i class="bi bi-box-arrow-in-down"></i>
                            <span>Copy Live Settings</span>
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-warning d-flex align-items-center gap-1 shadow-sm" @onclick="LoadSample2027" title="Load 2027 Sample Rates">
                            <i class="bi bi-magic"></i>
                            <span>Load 2027 Sample</span>
                        </button>
                        <button type="button" class="btn btn-sm btn-success d-flex align-items-center gap-1 shadow-sm fw-bold px-3" @onclick="SaveCustomGuide" disabled="@_isSaving">
                            @if (_isSaving)
                            {
                                <span class="spinner-border spinner-border-sm"></span>
                                <span>Saving...</span>
                            }
                            else
                            {
                                <i class="bi bi-check2-circle"></i>
                                <span>Save Changes</span>
                            }
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="ToggleEdit">
                            <span>Done Editing</span>
                        </button>
                    }
                    else
                    {
                        <button type="button" class="btn btn-sm btn-primary d-flex align-items-center gap-1 shadow-sm fw-semibold" @onclick="ToggleEdit">
                            <i class="bi bi-pencil"></i>
                            <span>Edit &amp; Rename Everything</span>
                        </button>
                    }
                }
                else
                {
                    <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-2 py-1 small">
                        <i class="bi bi-check-circle me-1"></i>Auto-Synchronized with Live Settings
                    </span>
                }

                <button type="button" class="btn btn-sm btn-outline-primary d-flex align-items-center gap-1 shadow-sm" @onclick="() => _showEmbedModal = true" title="Embed individual boxes or full guide on your website">
                    <i class="bi bi-code-slash"></i>
                    <span>Embed on Website</span>
                </button>

                <button type="button" class="btn btn-sm btn-outline-secondary d-flex align-items-center gap-1 shadow-sm" @onclick="TriggerPrint">
                    <i class="bi bi-printer"></i>
                    <span>Print / Save PDF</span>
                </button>

                @if (ShowFullPageLink)
                {
                    <a href="/hall-rentals/pricing-guide" target="_blank" class="btn btn-sm btn-outline-primary d-flex align-items-center gap-1 shadow-sm" title="Open Full Page">
                        <i class="bi bi-box-arrow-up-right"></i>
                        <span>Open Full Page</span>
                    </a>
                }
            </div>
        </div>
    }

    <!-- MAIN PRICING GUIDE CONTAINER -->
    <div class="pricing-guide-sheet bg-white rounded-4 border @(IsSingleSectionMode ? "p-2" : "p-4") shadow-sm mx-auto position-relative" style="max-width: 920px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; background: #fafbfc;">
        
        <!-- 1. LIGHT HEADER BANNER -->
        @if (ShouldShowSection("header"))
        {
            <div class="guide-header text-center mb-4 p-3 rounded-4 border" style="background: #ffffff; box-shadow: 0 2px 8px rgba(0,0,0,0.04);">
                @if (IsEditing && ActiveMode == "custom")
                {
                    <div class="mb-2">
                        <label class="form-label small text-muted mb-1 fw-bold">Guide Title</label>
                        <input type="text" class="form-control form-control-lg text-center fw-bold text-dark border-primary" @bind="ActiveModel.HeaderTitle" placeholder="EVENT PRICING GUIDE" />
                    </div>
                    <div>
                        <label class="form-label small text-muted mb-1 fw-bold">Subtitle Categories</label>
                        <input type="text" class="form-control text-center text-muted border-primary" @bind="ActiveModel.HeaderSubtitle" placeholder="Private Rentals • Member Pricing • Community Rates • Bar & Add-On Services" />
                    </div>
                }
                else
                {
                    <h3 class="fw-bolder mb-1 text-dark text-uppercase tracking-wider" style="letter-spacing: 0.06em; font-size: 1.35rem;">@ActiveModel.HeaderTitle</h3>
                    <div class="text-secondary small fw-medium" style="font-size: 0.85rem; letter-spacing: 0.02em;">@ActiveModel.HeaderSubtitle</div>
                }
            </div>
        }

        <!-- 2. TOP 3 TIER CARDS GRID (Always 3 Columns Side-by-Side) -->
        @if (ShouldShowSection("tiers"))
        {
            @if (!HideToolbar)
            {
                <div class="d-flex justify-content-between align-items-center mb-2 px-1 no-print">
                    <span class="small fw-bold text-muted text-uppercase" style="font-size: 0.75rem; letter-spacing: 0.04em;"><i class="bi bi-grid-3x3-gap-fill me-1 text-primary"></i>Top 3 Pricing Tier Cards</span>
                    <button type="button" class="btn btn-xs btn-outline-secondary d-flex align-items-center gap-1 shadow-xs" style="font-size: 0.72rem;" @onclick='() => CopySectionEmbed("tiers")' title="Copy iframe embed code for Top 3 Tier Cards">
                        <i class="bi bi-code-slash text-primary"></i>
                        <span>Copy Embed (3 Tiers)</span>
                    </button>
                </div>
            }

            <div class="row g-2 mb-3 tier-cards-row">
                @for (int i = 0; i < ActiveModel.TierCards.Count; i++)
                {
                    var cardIndex = i;
                    var card = ActiveModel.TierCards[cardIndex];
                    var headerBg = card.ThemeColor switch
                    {
                        "primary" => "background: #dbeafe; color: #1e40af; border-bottom: 1px solid #bfdbfe;",
                        "success" => "background: #d1fae5; color: #065f46; border-bottom: 1px solid #a7f3d0;",
                        "warning" => "background: #fef3c7; color: #92400e; border-bottom: 1px solid #fde68a;",
                        _ => "background: #f1f5f9; color: #334155; border-bottom: 1px solid #e2e8f0;"
                    };
                    var priceColor = card.ThemeColor switch
                    {
                        "primary" => "color: #2563eb;",
                        "success" => "color: #059669;",
                        "warning" => "color: #d97706;",
                        _ => "color: #1e293b;"
                    };

                    <div class="col-4 tier-card-col">
                        <div class="card h-100 border rounded-3 shadow-sm overflow-hidden d-flex flex-column tier-card" style="background: #ffffff; border-color: #e2e8f0 !important;">
                            <!-- Header -->
                            <div class="p-2 text-center card-header-box" style="@headerBg">
                                @if (IsEditing && ActiveMode == "custom")
                                {
                                    <input type="text" class="form-control form-control-sm text-center fw-bold mb-1" @bind="card.Title" placeholder="Card Title" />
                                    <input type="text" class="form-control form-control-sm text-center small text-muted" @bind="card.Subtitle" placeholder="Subtitle" />
                                }
                                else
                                {
                                    <h6 class="fw-bolder mb-0 text-uppercase tier-title" style="letter-spacing: 0.05em; font-size: 0.92rem;">@card.Title</h6>
                                    <div class="small mt-1 text-muted tier-subtitle" style="font-size: 0.75rem;">@card.Subtitle</div>
                                }
                            </div>

                            <!-- Rows with distinct rounded pill boxes like image -->
                            <div class="p-2 flex-grow-1 d-flex flex-column gap-2 card-body-box" style="background: #fafbfc;">
                                @for (int j = 0; j < card.Items.Count; j++)
                                {
                                    var itemIndex = j;
                                    var item = card.Items[itemIndex];
                                    <div class="d-flex justify-content-between align-items-center px-2 py-1 rounded-2 border bg-white shadow-xs tier-item-pill" style="border-color: #e2e8f0 !important;">
                                        @if (IsEditing && ActiveMode == "custom")
                                        {
                                            <input type="text" class="form-control form-control-sm border-0 bg-transparent fw-bold me-1 p-0" @bind="item.Label" placeholder="Day / Slot" />
                                            <input type="text" class="form-control form-control-sm border-0 bg-transparent fw-bolder text-end p-0 me-1" style="max-width: 80px; @priceColor" @bind="item.PriceText" placeholder="$0" />
                                            <button type="button" class="btn btn-link text-danger p-0 ms-1" style="font-size: 0.85rem; text-decoration: none;" @onclick="() => RemoveTierItem(card, item)" title="Remove Item">
                                                <i class="bi bi-x-circle-fill"></i>
                                            </button>
                                        }
                                        else
                                        {
                                            <span class="fw-bold text-dark item-label" style="font-size: 0.84rem;">@item.Label</span>
                                            <span class="fw-bolder item-price" style="@priceColor; font-size: 0.92rem;">@item.PriceText</span>
                                        }
                                    </div>
                                }

                                @if (IsEditing && ActiveMode == "custom")
                                {
                                    <button type="button" class="btn btn-xs btn-outline-primary w-100 py-1 d-flex align-items-center justify-content-center gap-1 mt-1 shadow-xs border-dashed" style="font-size: 0.72rem; border-style: dashed;" @onclick="() => AddTierItem(card)">
                                        <i class="bi bi-plus-circle"></i>
                                        <span>Add Rate / Slot</span>
                                    </button>
                                }
                            </div>

                            <!-- Footer Note -->
                            <div class="p-1 text-center border-top bg-white mt-auto card-footer-box" style="border-color: #f1f5f9 !important;">
                                @if (IsEditing && ActiveMode == "custom")
                                {
                                    <input type="text" class="form-control form-control-sm text-center text-muted" @bind="card.FooterNote" placeholder="Footer Note" />
                                }
                                else
                                {
                                    <span class="text-muted small card-footer-text" style="font-size: 0.72rem;">@card.FooterNote</span>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }

        <!-- 3. RATE COMPARISON HORIZONTAL BAR CHART (EXACT MATCH TO 1790348307839.png) -->
        @if (ShouldShowSection("chart"))
        {
            <div class="card border rounded-3 p-3 mb-3 chart-card shadow-sm bg-white" style="border-color: #e2e8f0 !important;">
                <div class="d-flex justify-content-between align-items-center mb-2 flex-wrap gap-2 border-bottom pb-2 chart-header-row">
                    @if (IsEditing && ActiveMode == "custom")
                    {
                        <input type="text" class="form-control form-control-sm fw-bold text-dark border-primary" style="max-width: 420px;" @bind="ActiveModel.ChartTitle" placeholder="Chart Title" />
                    }
                    else
                    {
                        <h6 class="fw-bolder text-dark mb-0 text-uppercase chart-main-title" style="letter-spacing: 0.04em; font-size: 0.85rem;">@ActiveModel.ChartTitle</h6>
                    }

                    <!-- Chart Legend & Embed -->
                    <div class="d-flex align-items-center gap-2">
                        <div class="d-flex align-items-center gap-3 chart-legend-row">
                            <span class="d-flex align-items-center gap-1 small"><span class="d-inline-block rounded-1" style="background: #2563eb; width: 12px; height: 9px;"></span> <span class="text-secondary small fw-semibold" style="font-size: 0.75rem;">Non-Member</span></span>
                            <span class="d-flex align-items-center gap-1 small"><span class="d-inline-block rounded-1" style="background: #0f766e; width: 12px; height: 9px;"></span> <span class="text-secondary small fw-semibold" style="font-size: 0.75rem;">Member</span></span>
                            <span class="d-flex align-items-center gap-1 small"><span class="d-inline-block rounded-1" style="background: #d97706; width: 12px; height: 9px;"></span> <span class="text-secondary small fw-semibold" style="font-size: 0.75rem;">Non-Profit</span></span>
                        </div>
                        @if (!HideToolbar)
                        {
                            <button type="button" class="btn btn-xs btn-outline-secondary d-flex align-items-center gap-1 shadow-xs no-print ms-2" style="font-size: 0.70rem;" @onclick='() => CopySectionEmbed("chart")' title="Copy embed code for Comparison Chart">
                                <i class="bi bi-code-slash text-info"></i>
                                <span>Copy Embed</span>
                            </button>
                        }
                    </div>
                </div>

                <!-- Comparison Chart with Grid Lines like Reference Picture -->
                <div class="chart-comparison-wrapper position-relative py-1">
                    <div class="d-flex flex-column gap-2 chart-rows-container">
                        @{
                            var maxVal = Math.Max(700m, ActiveModel.ChartRows.SelectMany(r => new[] { r.NonMemberAmount, r.MemberAmount, r.NonProfitAmount }).DefaultIfEmpty(700m).Max());
                        }
                        @foreach (var row in ActiveModel.ChartRows)
                        {
                            var nonMemberPct = Math.Min(100, Math.Max(2, (row.NonMemberAmount / maxVal) * 100));
                            var memberPct = Math.Min(100, Math.Max(2, (row.MemberAmount / maxVal) * 100));
                            var nonProfitPct = Math.Min(100, Math.Max(2, (row.NonProfitAmount / maxVal) * 100));

                            <div class="d-flex align-items-center chart-day-row">
                                <!-- Y-Axis Label -->
                                <div class="fw-bold text-dark chart-y-label" style="width: 120px; min-width: 120px; font-size: 0.82rem;">
                                    @if (IsEditing && ActiveMode == "custom")
                                    {
                                        <div class="d-flex align-items-center gap-1">
                                            <input type="text" class="form-control form-control-sm" @bind="row.DayLabel" />
                                            <button type="button" class="btn btn-link text-danger p-0" style="font-size: 0.85rem; text-decoration: none;" @onclick="() => RemoveChartRow(row)" title="Remove Chart Row">
                                                <i class="bi bi-x-circle-fill"></i>
                                            </button>
                                        </div>
                                    }
                                    else
                                    {
                                        <span>@row.DayLabel</span>
                                    }
                                </div>

                                <!-- Horizontal Grid Area with 3 Bars & Values placed outside bar -->
                                <div class="flex-grow-1 position-relative chart-bars-box" style="border-left: 2px solid #94a3b8; border-bottom: 1px solid #e2e8f0; padding: 2px 0 2px 6px;">
                                    <!-- Non-Member Bar -->
                                    <div class="d-flex align-items-center mb-1 bar-item">
                                        <div style="width: @nonMemberPct.ToString("F1")%; height: 12px; background: #2563eb; border-radius: 2px;"></div>
                                        @if (IsEditing && ActiveMode == "custom")
                                        {
                                            <input type="number" class="form-control form-control-sm ms-2 p-0 text-primary fw-bold" style="width: 70px;" @bind="row.NonMemberAmount" />
                                        }
                                        else
                                        {
                                            <span class="ms-2 fw-bold text-primary bar-value" style="font-size: 0.74rem;">$@row.NonMemberAmount:N0</span>
                                        }
                                    </div>

                                    <!-- Member Bar -->
                                    <div class="d-flex align-items-center mb-1 bar-item">
                                        <div style="width: @memberPct.ToString("F1")%; height: 12px; background: #0f766e; border-radius: 2px;"></div>
                                        @if (IsEditing && ActiveMode == "custom")
                                        {
                                            <input type="number" class="form-control form-control-sm ms-2 p-0 text-success fw-bold" style="width: 70px;" @bind="row.MemberAmount" />
                                        }
                                        else
                                        {
                                            <span class="ms-2 fw-bold bar-value" style="color: #0f766e; font-size: 0.74rem;">$@row.MemberAmount:N0</span>
                                        }
                                    </div>

                                    <!-- Non-Profit Bar -->
                                    <div class="d-flex align-items-center bar-item">
                                        <div style="width: @nonProfitPct.ToString("F1")%; height: 12px; background: #d97706; border-radius: 2px;"></div>
                                        @if (IsEditing && ActiveMode == "custom")
                                        {
                                            <input type="number" class="form-control form-control-sm ms-2 p-0 text-warning-emphasis fw-bold" style="width: 70px;" @bind="row.NonProfitAmount" />
                                        }
                                        else
                                        {
                                            <span class="ms-2 fw-bold bar-value" style="color: #d97706; font-size: 0.74rem;">$@row.NonProfitAmount:N0</span>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                    <!-- X-Axis Scale Baseline (0 - 700) -->
                    <div class="d-flex justify-content-between mt-1 text-muted small chart-x-axis" style="margin-left: 120px; font-size: 0.70rem; padding-left: 6px;">
                        <span>0</span>
                        <span>100</span>
                        <span>300</span>
                        <span>500</span>
                        <span>700</span>
                    </div>

                    @if (IsEditing && ActiveMode == "custom")
                    {
                        <div class="mt-2 text-end">
                            <button type="button" class="btn btn-xs btn-outline-primary py-1 px-2 d-inline-flex align-items-center gap-1 shadow-xs border-dashed" style="font-size: 0.75rem; border-style: dashed;" @onclick="AddChartRow">
                                <i class="bi bi-plus-circle"></i>
                                <span>Add Chart Comparison Row</span>
                            </button>
                        </div>
                    }
                </div>
            </div>
        }

        <!-- 4. BOTTOM ADDON SERVICES (Always 2 Columns Side-by-Side or Individual) -->
        @if (ShouldShowSection("bottom"))
        {
            <div class="row g-2 bottom-cards-row">
                <!-- Left: Bar Service Options (Soft Cream / Amber Accent) -->
                @if (ShouldShowSection("bar"))
                {
                    <div class="@(IsSingleSectionMode ? "col-12" : "col-6 bottom-card-col")">
                        <div class="card h-100 border rounded-3 p-3 shadow-sm bg-white d-flex flex-column addon-card" style="border-color: #fde68a !important; background: #ffffff;">
                            <div class="d-flex justify-content-between align-items-center mb-2 pb-1 border-bottom addon-header">
                                @if (IsEditing && ActiveMode == "custom")
                                {
                                    <input type="text" class="form-control form-control-sm fw-bold text-danger" @bind="ActiveModel.BottomLeftSection.Title" placeholder="Section Title" />
                                }
                                else
                                {
                                    <h6 class="fw-bolder mb-0 text-uppercase addon-title" style="color: #881337; letter-spacing: 0.04em; font-size: 0.82rem;">
                                        @ActiveModel.BottomLeftSection.Title
                                    </h6>
                                }
                                @if (!HideToolbar)
                                {
                                    <button type="button" class="btn btn-xs btn-outline-secondary d-flex align-items-center gap-1 shadow-xs no-print" style="font-size: 0.70rem;" @onclick='() => CopySectionEmbed("bar")' title="Copy embed code for Bar Service Options">
                                        <i class="bi bi-code-slash text-danger"></i>
                                        <span>Copy Embed</span>
                                    </button>
                                }
                            </div>

                            <div class="d-flex flex-column gap-2 flex-grow-1 addon-items-list">
                                @foreach (var item in ActiveModel.BottomLeftSection.Items)
                                {
                                    <div class="p-2 rounded-2 border d-flex justify-content-between align-items-center gap-2 addon-item-pill" style="background: #fffbeb; border-color: #fef3c7 !important;">
                                        <div class="flex-grow-1">
                                            @if (IsEditing && ActiveMode == "custom")
                                            {
                                                <input type="text" class="form-control form-control-sm fw-bold mb-1" @bind="item.Name" placeholder="Service Name" />
                                                <input type="text" class="form-control form-control-sm small text-muted" @bind="item.Description" placeholder="Description" />
                                            }
                                            else
                                            {
                                                <div class="fw-bold text-dark addon-name" style="font-size: 0.80rem;">@item.Name</div>
                                                <div class="text-muted small addon-desc" style="font-size: 0.70rem;">@item.Description</div>
                                            }
                                        </div>
                                        <div class="text-end d-flex align-items-center gap-1" style="min-width: 90px;">
                                            @if (IsEditing && ActiveMode == "custom")
                                            {
                                                <input type="text" class="form-control form-control-sm text-end fw-bold text-danger" @bind="item.FeeBadgeText" placeholder="Fee" />
                                                <button type="button" class="btn btn-link text-danger p-0 ms-1" style="font-size: 0.85rem; text-decoration: none;" @onclick="() => RemoveServiceItem(ActiveModel.BottomLeftSection, item)" title="Remove Service">
                                                    <i class="bi bi-x-circle-fill"></i>
                                                </button>
                                            }
                                            else
                                            {
                                                <span class="fw-bolder addon-fee" style="color: #b91c1c; font-size: 0.82rem;">@item.FeeBadgeText</span>
                                            }
                                        </div>
                                    </div>
                                }

                                @if (IsEditing && ActiveMode == "custom")
                                {
                                    <button type="button" class="btn btn-xs btn-outline-danger w-100 py-1 d-flex align-items-center justify-content-center gap-1 mt-1 shadow-xs border-dashed" style="font-size: 0.72rem; border-style: dashed;" @onclick="() => AddServiceItem(ActiveModel.BottomLeftSection)">
                                        <i class="bi bi-plus-circle"></i>
                                        <span>Add Option / Service</span>
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                }

                <!-- Right: Additional Services (Soft Green / Mint Accent) -->
                @if (ShouldShowSection("addons"))
                {
                    <div class="@(IsSingleSectionMode ? "col-12" : "col-6 bottom-card-col")">
                        <div class="card h-100 border rounded-3 p-3 shadow-sm bg-white d-flex flex-column addon-card" style="border-color: #bbf7d0 !important; background: #ffffff;">
                            <div class="d-flex justify-content-between align-items-center mb-2 pb-1 border-bottom addon-header">
                                @if (IsEditing && ActiveMode == "custom")
                                {
                                    <input type="text" class="form-control form-control-sm fw-bold text-success" @bind="ActiveModel.BottomRightSection.Title" placeholder="Section Title" />
                                }
                                else
                                {
                                    <h6 class="fw-bolder mb-0 text-uppercase addon-title" style="color: #065f46; letter-spacing: 0.04em; font-size: 0.82rem;">
                                        @ActiveModel.BottomRightSection.Title
                                    </h6>
                                }
                                @if (!HideToolbar)
                                {
                                    <button type="button" class="btn btn-xs btn-outline-secondary d-flex align-items-center gap-1 shadow-xs no-print" style="font-size: 0.70rem;" @onclick='() => CopySectionEmbed("addons")' title="Copy embed code for Additional Services">
                                        <i class="bi bi-code-slash text-success"></i>
                                        <span>Copy Embed</span>
                                    </button>
                                }
                            </div>

                            <div class="d-flex flex-column gap-2 flex-grow-1 addon-items-list">
                                @foreach (var item in ActiveModel.BottomRightSection.Items)
                                {
                                    <div class="p-2 rounded-2 border d-flex justify-content-between align-items-center gap-2 addon-item-pill" style="background: #f0fdf4; border-color: #dcfce7 !important;">
                                        <div class="flex-grow-1">
                                            @if (IsEditing && ActiveMode == "custom")
                                            {
                                                <input type="text" class="form-control form-control-sm fw-bold mb-1" @bind="item.Name" placeholder="Service Name" />
                                                <input type="text" class="form-control form-control-sm small text-muted" @bind="item.Description" placeholder="Description" />
                                            }
                                            else
                                            {
                                                <div class="fw-bold text-dark addon-name" style="font-size: 0.80rem;">@item.Name</div>
                                                <div class="text-muted small addon-desc" style="font-size: 0.70rem;">@item.Description</div>
                                            }
                                        </div>
                                        <div class="text-end d-flex align-items-center gap-1" style="min-width: 90px;">
                                            @if (IsEditing && ActiveMode == "custom")
                                            {
                                                <input type="text" class="form-control form-control-sm text-end fw-bold text-success" @bind="item.FeeBadgeText" placeholder="Fee" />
                                                <button type="button" class="btn btn-link text-danger p-0 ms-1" style="font-size: 0.85rem; text-decoration: none;" @onclick="() => RemoveServiceItem(ActiveModel.BottomRightSection, item)" title="Remove Service">
                                                    <i class="bi bi-x-circle-fill"></i>
                                                </button>
                                            }
                                            else
                                            {
                                                <span class="fw-bolder text-success addon-fee" style="font-size: 0.82rem;">@item.FeeBadgeText</span>
                                            }
                                        </div>
                                    </div>
                                }

                                @if (IsEditing && ActiveMode == "custom")
                                {
                                    <button type="button" class="btn btn-xs btn-outline-success w-100 py-1 d-flex align-items-center justify-content-center gap-1 mt-1 shadow-xs border-dashed" style="font-size: 0.72rem; border-style: dashed;" @onclick="() => AddServiceItem(ActiveModel.BottomRightSection)">
                                        <i class="bi bi-plus-circle"></i>
                                        <span>Add Service / Amenity</span>
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

