@using GFC.BlazorServer.Models
@using GFC.BlazorServer.Services
@using GFC.Core.Interfaces
@using GFC.Core.Models
@inject IGoogleCalendarService CalendarService
@inject IRentalService RentalService
@inject IWebsiteSettingsService WebsiteSettingsService
@inject CalendarSettingsService SettingsService
@inject IJSRuntime JSRuntime
@implements IAsyncDisposable

<div class="gfc-calendar-wrap position-relative">

    @* Loading overlay *@
    <div id="@(_containerId + "-loading")"
         style="display:@(_isLoading ? "flex" : "none"); position:absolute; inset:0; background:rgba(20,20,35,0.7);
                z-index:10; align-items:center; justify-content:center; border-radius:12px; flex-direction:column; gap:12px;">
        <div class="spinner-border" style="color:#C49A49; width:2.5rem; height:2.5rem;" role="status"></div>
        <span style="color:#C49A49; font-weight:600; font-size:0.9rem; letter-spacing:0.05em;">Loading Events…</span>
    </div>

    @* FullCalendar mount point *@
    <div id="@_containerId" style="min-height:580px;"></div>

    @* Error banner *@
    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="alert alert-warning mt-2 d-flex align-items-center gap-2 small" role="alert">
            <i class="bi bi-exclamation-triangle-fill"></i>
            <span>@_errorMessage</span>
        </div>
    }
</div>

@code {
    /// <summary>
    /// When true the component manages its own settings/event fetch (public calendar mode).
    /// When false the parent supplies Settings and Events directly (preview mode).
    /// </summary>
    [Parameter] public bool Standalone { get; set; } = true;

    /// <summary>Injected from parent when Standalone=false.</summary>
    [Parameter] public CalendarSettings? Settings { get; set; }

    /// <summary>Injected from parent when Standalone=false.</summary>
    [Parameter] public List<CalendarEventItem>? Events { get; set; }

    /// <summary>How often (ms) to auto-refresh. Default 5 minutes. Set 0 to disable.</summary>
    [Parameter] public int RefreshIntervalMs { get; set; } = 5 * 60 * 1000;

    /// <summary>Callback when user clicks 'Ask a Question' on a specific date in the calendar modal or drawer.</summary>
    [Parameter] public EventCallback<string> OnInquiryRequested { get; set; }

    private string _containerId = "gfc-cal-" + Guid.NewGuid().ToString("N")[..8];
    private DotNetObjectReference<FullCalendarWrapper>? _dotNetRef;

    private CalendarSettings _settings = new();
    private GoogleCalendarSettings? _googleSettings;
    private WebsiteSettings? _webSettings;
    private List<CalendarEventItem> _events = new();
    private List<HallRentalRequest> _dbRentalRequests = new();
    private bool _isLoading = true;
    private bool _initialised = false;
    private string? _errorMessage;

    protected override void OnInitialized()
    {
        RentalService.OnCalendarUpdated += OnDataChanged;
    }

    private async void OnDataChanged()
    {
        try
        {
            await InvokeAsync(async () =>
            {
                await LoadDataAsync();
                await UpdateCalendarAsync();
                StateHasChanged();
            });
        }
        catch { }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dotNetRef = DotNetObjectReference.Create(this);

            if (Settings != null)
                _settings = Settings;

            if (Events != null && Events.Count > 0)
            {
                _events = Events;
                _isLoading = false;
            }
            else
            {
                await LoadDataAsync();
            }

            await RenderCalendarAsync();
            _initialised = true;
        }
        else if (_initialised)
        {
            if (Settings != null)
                _settings = Settings;

            if (Events != null && Events.Count > 0)
                _events = Events;

            await UpdateCalendarAsync();
        }
    }

    /// <summary>Called by the JS auto-refresh timer.</summary>
    [JSInvokable]
    public async Task AutoRefresh()
    {
        await LoadDataAsync();
        await UpdateCalendarAsync();
        StateHasChanged();
    }

    /// <summary>Called by the FullCalendar JS modal/drawer when user clicks 'Ask a Question' for a date.</summary>
    [JSInvokable]
    public async Task TriggerInquiry(string dateStr)
    {
        if (OnInquiryRequested.HasDelegate)
        {
            await OnInquiryRequested.InvokeAsync(dateStr);
        }
    }

    private async Task LoadDataAsync()
    {
        _isLoading = true;
        _errorMessage = null;
        StateHasChanged();

        try
        {
            _webSettings = await WebsiteSettingsService.GetWebsiteSettingsAsync();

            if (Settings != null)
                _settings = Settings;
            else
                _settings = await SettingsService.GetAsync();

            _googleSettings = await CalendarService.GetSettingsAsync();
            var calSettings = _googleSettings;
            var calendarEvents = new List<CalendarEventItem>();

            // 1. Fetch live Google Calendar / iCal feeds
            try
            {
                var fetched = await CalendarService.FetchAllFeedsAsync(calSettings);
                if (fetched != null) calendarEvents.AddRange(fetched);
            }
            catch (Exception ex)
            {
                System.Diagnostics.Debug.WriteLine($"[FullCalendarWrapper] FetchAllFeeds warning: {ex.Message}");
            }

            // 2. Merge database rental requests & remove cancelled/deleted ones
            try
            {
                var dbRequests = await RentalService.GetRentalRequestsAsync();
                _dbRentalRequests = dbRequests.ToList();
                
                // Exclude cancelled/denied requests from calendar
                var cancelledRequests = dbRequests.Where(r => 
                    string.Equals(r.Status, "Cancelled", StringComparison.OrdinalIgnoreCase) || 
                    string.Equals(r.Status, "Denied", StringComparison.OrdinalIgnoreCase)).ToList();

                foreach (var cancelled in cancelledRequests)
                {
                    string cleanCancelledName = (cancelled.ApplicantName ?? "").Trim();
                    int parenIdx = cleanCancelledName.IndexOf('(');
                    if (parenIdx > 0) cleanCancelledName = cleanCancelledName.Substring(0, parenIdx).Trim();

                    calendarEvents.RemoveAll(e => 
                        e.Start.Date == cancelled.EventDate.Date && 
                        (
                            (!string.IsNullOrWhiteSpace(cleanCancelledName) && e.Title.Contains(cleanCancelledName, StringComparison.OrdinalIgnoreCase)) ||
                            (!string.IsNullOrWhiteSpace(cancelled.RequesterName) && e.Title.Contains(cancelled.RequesterName, StringComparison.OrdinalIgnoreCase)) ||
                            (!string.IsNullOrWhiteSpace(cancelled.EventType) && e.Title.Contains(cancelled.EventType, StringComparison.OrdinalIgnoreCase))
                        ));
                }

                // Merge all actual rental applications (Approved and Pending) from database - Inquiries are strictly internal
                foreach (var req in dbRequests.Where(r => 
                    !string.Equals(r.Status, "Cancelled", StringComparison.OrdinalIgnoreCase) &&
                    !string.Equals(r.Status, "Denied", StringComparison.OrdinalIgnoreCase) &&
                    !string.Equals(r.Status, "Archived", StringComparison.OrdinalIgnoreCase) &&
                    !string.Equals(r.Status, "Inquiry", StringComparison.OrdinalIgnoreCase) &&
                    !string.Equals(r.Status, "Responded", StringComparison.OrdinalIgnoreCase)))
                {
                    string cleanApplicant = (req.ApplicantName ?? "").Trim();
                    int parenIdx = cleanApplicant.IndexOf('(');
                    if (parenIdx > 0) cleanApplicant = cleanApplicant.Substring(0, parenIdx).Trim();

                    bool isApproved = string.Equals(req.Status, "Approved", StringComparison.OrdinalIgnoreCase);
                    string status = isApproved ? "Approved" : "Pending";
                    string defaultTitle = !string.IsNullOrWhiteSpace(req.EventType) ? req.EventType : "Hall Rental";

                    // Match Google event to this rental request:
                    // 1) Explicit GoogleEventId match or internal rental ID match
                    // 2) Description references this request ID (e.g. GFC-REQ-{id} or db-rental-{id})
                    // 3) Existing/legacy events: exact date match and applicant name match (e.g. "Click digit")
                    var existing = calendarEvents.FirstOrDefault(e => 
                        (!string.IsNullOrWhiteSpace(e.GoogleEventId) && (e.GoogleEventId == $"db-rental-{req.Id}" || (!string.IsNullOrWhiteSpace(req.GoogleEventId) && e.GoogleEventId == req.GoogleEventId))) ||
                        (e.RentalRequestId.HasValue && e.RentalRequestId.Value == req.Id) ||
                        (!string.IsNullOrWhiteSpace(e.Description) && (e.Description.Contains($"GFC-REQ-{req.Id}", StringComparison.OrdinalIgnoreCase) || e.Description.Contains($"db-rental-{req.Id}", StringComparison.OrdinalIgnoreCase))) ||
                        (
                            e.Start.Date == req.EventDate.Date &&
                            (
                                (!string.IsNullOrWhiteSpace(cleanApplicant) && (e.Title.Contains(cleanApplicant, StringComparison.OrdinalIgnoreCase) || (!string.IsNullOrWhiteSpace(e.Description) && e.Description.Contains(cleanApplicant, StringComparison.OrdinalIgnoreCase)))) ||
                                (!string.IsNullOrWhiteSpace(req.RequesterName) && (e.Title.Contains(req.RequesterName, StringComparison.OrdinalIgnoreCase) || (!string.IsNullOrWhiteSpace(e.Description) && e.Description.Contains(req.RequesterName, StringComparison.OrdinalIgnoreCase)))) ||
                                (!string.IsNullOrWhiteSpace(req.EventType) && e.Title.Contains(req.EventType, StringComparison.OrdinalIgnoreCase)) ||
                                (!string.IsNullOrWhiteSpace(req.RoomSelected) && string.Equals(e.Location, req.RoomSelected, StringComparison.OrdinalIgnoreCase))
                            )
                        ));

                    if (existing == null)
                    {
                        DateTime start = req.EventDate.Date.AddHours(12);
                        DateTime end = req.EventDate.Date.AddHours(17);
                        if (!string.IsNullOrWhiteSpace(req.StartTime) && DateTime.TryParse(req.StartTime, out var ps)) start = req.EventDate.Date.Add(ps.TimeOfDay);
                        if (!string.IsNullOrWhiteSpace(req.EndTime) && DateTime.TryParse(req.EndTime, out var pe)) end = req.EventDate.Date.Add(pe.TimeOfDay);

                        calendarEvents.Add(new CalendarEventItem
                        {
                            GoogleEventId = $"db-rental-{req.Id}",
                            RentalRequestId = req.Id,
                            Title = defaultTitle,
                            Start = start,
                            End = end,
                            Location = req.RoomSelected ?? "Main Function Hall",
                            Source = "Rental Booking",
                            Status = status,
                            Description = $"Applicant: {req.ApplicantName}\nReserved: {req.RoomSelected ?? "Main Function Hall"}"
                        });
                    }
                    else
                    {
                        if (existing.RentalRequestId == null || existing.RentalRequestId == 0)
                        {
                            existing.RentalRequestId = req.Id;
                        }
                        if (string.IsNullOrWhiteSpace(existing.Location) && !string.IsNullOrWhiteSpace(req.RoomSelected))
                        {
                            existing.Location = req.RoomSelected;
                        }
                        existing.Status = status;
                    }
                }

                // 2b. Merge database blackout dates & club events (from AvailabilityCalendars table)
                var dbBlackouts = await RentalService.GetUnavailableDatesAsync(includeRentalRequests: false);
                foreach (var unavail in dbBlackouts)
                {
                    var rawTitle = !string.IsNullOrWhiteSpace(unavail.EventType) ? unavail.EventType : "Club Event";
                    var isOffice = rawTitle.Contains("Office", StringComparison.OrdinalIgnoreCase);
                    var loc = isOffice ? (_webSettings?.SecondaryFlexibleLocation ?? "Office") : (_webSettings?.ManagedRentalLocation ?? "Function Hall");

                    var existing = calendarEvents.FirstOrDefault(e => 
                        (!string.IsNullOrWhiteSpace(e.GoogleEventId) && e.GoogleEventId == $"db-blackout-{unavail.Id}") ||
                        (!string.IsNullOrWhiteSpace(e.Description) && e.Description.Contains($"DbBlackoutId:{unavail.Id}")));

                    if (existing == null)
                    {
                        DateTime start = unavail.Date.Date.AddHours(9);
                        DateTime end = unavail.Date.Date.AddHours(23);
                        bool isAllDay = unavail.IsFullDay;

                        if (!unavail.IsFullDay && !string.IsNullOrWhiteSpace(unavail.EventTime))
                        {
                            var parts = unavail.EventTime.Split('-', StringSplitOptions.TrimEntries);
                            if (parts.Length == 2 && DateTime.TryParse(parts[0], out var ps) && DateTime.TryParse(parts[1], out var pe))
                            {
                                start = unavail.Date.Date.Add(ps.TimeOfDay);
                                end = unavail.Date.Date.Add(pe.TimeOfDay);
                                isAllDay = false;
                            }
                        }

                        calendarEvents.Add(new CalendarEventItem
                        {
                            GoogleEventId = $"db-blackout-{unavail.Date:yyyyMMdd}-{Math.Abs(rawTitle.GetHashCode()):X}",
                            Title = rawTitle.StartsWith("Club Event", StringComparison.OrdinalIgnoreCase) ? rawTitle : $"Club Event: {rawTitle}",
                            Start = start,
                            End = end,
                            IsAllDay = isAllDay,
                            Location = loc,
                            Source = "Club Event",
                            Status = "Confirmed",
                            Description = isOffice ? "Event Category: Club Event\nClub Event (Office Space)\nShow on Public Calendar: Yes" : "Event Category: Club Event\nClub Event / Blackout"
                        });
                    }
                }
            }
            catch (Exception dbEx)
            {
                System.Diagnostics.Debug.WriteLine($"[FullCalendarWrapper] DB merge warning: {dbEx.Message}");
            }

            // 3. Clean Distinct Pass: preserve all events distinctly unless identical GoogleEventId or Uid
            var distinctList = new List<CalendarEventItem>();
            foreach (var evt in calendarEvents)
            {
                bool isExactDup = distinctList.Any(d =>
                    (!string.IsNullOrWhiteSpace(d.GoogleEventId) && !string.IsNullOrWhiteSpace(evt.GoogleEventId) && d.GoogleEventId == evt.GoogleEventId) ||
                    (!string.IsNullOrWhiteSpace(d.Uid) && !string.IsNullOrWhiteSpace(evt.Uid) && d.Uid == evt.Uid) ||
                    (d.RentalRequestId.HasValue && evt.RentalRequestId.HasValue && d.RentalRequestId.Value > 0 && d.RentalRequestId.Value == evt.RentalRequestId.Value)
                );

                if (!isExactDup)
                {
                    distinctList.Add(evt);
                }
            }
            _events = distinctList;

            // 4. Enrich Google Calendar events with Database Overrides (EventFee, BarRequested)
            try
            {
                var overrides = await RentalService.GetAllGoogleEventOverridesAsync();
                if (overrides != null && overrides.Count > 0)
                {
                    foreach (var ev in _events)
                    {
                        var key = !string.IsNullOrWhiteSpace(ev.GoogleEventId) ? ev.GoogleEventId : (!string.IsNullOrWhiteSpace(ev.Uid) ? ev.Uid : null);
                        if (key != null && overrides.TryGetValue(key, out var ov))
                        {
                            ev.EventFee = ov.EventFee;
                            ev.BarRequested = ov.BarRequested;
                        }
                    }
                }
            }
            catch (Exception ovEx)
            {
                System.Diagnostics.Debug.WriteLine($"[FullCalendarWrapper] Overrides enrich warning: {ovEx.Message}");
            }
        }
        catch (Exception ex)
        {
            _errorMessage = "Could not load calendar events — please try again shortly.";
            System.Diagnostics.Debug.WriteLine($"[FullCalendarWrapper] LoadDataAsync error: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task RenderCalendarAsync()
    {
        try
        {
            var payload = BuildPayload(includeAutoRefresh: Standalone && RefreshIntervalMs > 0);
            await JSRuntime.InvokeVoidAsync("GfcFullCalendar.init", _containerId, payload);
        }
        catch { /* JS not loaded yet — graceful degradation */ }
    }

    private async Task UpdateCalendarAsync()
    {
        try
        {
            var payload = BuildPayload(includeAutoRefresh: false);
            await JSRuntime.InvokeVoidAsync("GfcFullCalendar.update", _containerId, payload);
        }
        catch { }
    }

    private bool IsClubEvent(CalendarEventItem? evt)
    {
        if (evt == null) return false;
        var desc = evt.Description ?? string.Empty;

        // If explicitly tagged as Club Event or Secondary Space Meeting / Internal
        if (desc.Contains("Category: Club Event", StringComparison.OrdinalIgnoreCase) ||
            desc.Contains("Event Category: Club Event", StringComparison.OrdinalIgnoreCase) ||
            desc.Contains("Meeting / Internal", StringComparison.OrdinalIgnoreCase) ||
            desc.Contains("Category: Meeting", StringComparison.OrdinalIgnoreCase))
        {
            return true;
        }

        // If it possesses hall rental / application structure, it is a rental
        if (desc.Contains("Preferred Event Date:", StringComparison.OrdinalIgnoreCase) ||
            desc.Contains("Hall Rental Application", StringComparison.OrdinalIgnoreCase) ||
            desc.Contains("Full Name (Applicant):", StringComparison.OrdinalIgnoreCase) ||
            desc.Contains("Contact Phone Number:", StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }

        // Check if calendar feed source is specifically a Rental Calendar
        if (!string.IsNullOrEmpty(evt.Source) && evt.Source.Contains("Rental", StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }

        // Check room location: if in secondary space (e.g. Office, Directors Room) and not a rental application, treat as internal meeting
        var evtRoomNorm = NormalizeRoomName(evt.Location);
        var managedLocNorm = NormalizeRoomName(_webSettings?.ManagedRentalLocation ?? "Function Hall");
        if (evtRoomNorm != managedLocNorm && evtRoomNorm != "entire facility")
        {
            return true;
        }

        // Check if matching a database rental request
        if (evt.RentalRequestId.HasValue && evt.RentalRequestId.Value > 0)
        {
            return false;
        }
        if (!string.IsNullOrWhiteSpace(evt.GoogleEventId) && evt.GoogleEventId.StartsWith("db-rental-", StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }

        // Check title convention
        var title = evt.Title ?? string.Empty;
        if (title.StartsWith("Hall Rental", StringComparison.OrdinalIgnoreCase) ||
            title.StartsWith("PENDING -", StringComparison.OrdinalIgnoreCase) ||
            title.StartsWith("PENDING:", StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }

        return true;
    }

    private string CleanPublicDescription(string? desc, bool isClub)
    {
        if (string.IsNullOrWhiteSpace(desc)) return string.Empty;
        if (!isClub) return desc;

        var lines = desc.Split(new[] { "\r\n", "\r", "\n" }, StringSplitOptions.None)
            .Where(l => !l.StartsWith("Category:", StringComparison.OrdinalIgnoreCase) &&
                        !l.StartsWith("Event Category:", StringComparison.OrdinalIgnoreCase) &&
                        !l.StartsWith("Block Out Rental Slots:", StringComparison.OrdinalIgnoreCase) &&
                        !l.StartsWith("Created By:", StringComparison.OrdinalIgnoreCase) &&
                        !l.StartsWith("Created:", StringComparison.OrdinalIgnoreCase) &&
                        !l.StartsWith("Modified By:", StringComparison.OrdinalIgnoreCase) &&
                        !l.StartsWith("Modified:", StringComparison.OrdinalIgnoreCase))
            .Select(l => l.StartsWith("Notes:", StringComparison.OrdinalIgnoreCase) ? l.Substring(6).Trim() : l)
            .Where(l => !string.IsNullOrWhiteSpace(l))
            .ToList();

        return string.Join("\n", lines).Trim();
    }

    public static string NormalizeRoomName(string? room)
    {
        if (string.IsNullOrWhiteSpace(room)) return "function hall";
        var r = room.Trim().ToLowerInvariant();
        if (r.Contains("hall") || r.Contains("function")) return "function hall";
        if (r.Contains("office")) return "office";
        if (r.Contains("entire") || r.Contains("facility")) return "entire facility";
        return r;
    }

    private object BuildPayload(bool includeAutoRefresh)
    {
        var rawEvents = _events ?? new List<CalendarEventItem>();
        var managedLocNorm = NormalizeRoomName(_webSettings?.ManagedRentalLocation ?? "Function Hall");

        var filteredEvents = rawEvents.Where(e =>
        {
            // Inquiries are strictly for internal management and must NEVER be displayed publicly
            if (string.Equals(e.Status, "Inquiry", StringComparison.OrdinalIgnoreCase) ||
                string.Equals(e.Source, "General Inquiry", StringComparison.OrdinalIgnoreCase) ||
                (e.Title != null && e.Title.StartsWith("INQUIRY:", StringComparison.OrdinalIgnoreCase)))
            {
                return false;
            }

            // 1. Database-backed Bookings & Club Events (from Web App, Connect App, Online Application, or Availability table)
            bool isDbEvent = (e.RentalRequestId.HasValue && e.RentalRequestId.Value > 0) ||
                             (!string.IsNullOrWhiteSpace(e.GoogleEventId) && e.GoogleEventId.StartsWith("db-", StringComparison.OrdinalIgnoreCase)) ||
                             string.Equals(e.Source, "Rental Booking", StringComparison.OrdinalIgnoreCase) ||
                             string.Equals(e.Source, "Club Event", StringComparison.OrdinalIgnoreCase);

            // 2. Google Calendar Feed Events
            bool isExternalGoogleEvent = !isDbEvent &&
                                         (string.Equals(e.Source, "Google Calendar", StringComparison.OrdinalIgnoreCase) ||
                                          (!string.IsNullOrWhiteSpace(e.GoogleEventId) && !e.GoogleEventId.StartsWith("db-", StringComparison.OrdinalIgnoreCase)));

            if (isExternalGoogleEvent)
            {
                // Only display on public calendar if admin explicitly enabled it in Google Calendar settings or flagged in description
                string evtId = !string.IsNullOrWhiteSpace(e.GoogleEventId) ? e.GoogleEventId : (!string.IsNullOrWhiteSpace(e.Uid) ? e.Uid : $"{e.Title}_{e.Start:yyyyMMddHHmm}");
                bool isExplicitlyPublic = (_googleSettings?.PubliclyVisibleGoogleEventIds != null && _googleSettings.PubliclyVisibleGoogleEventIds.Contains(evtId)) ||
                                          (e.Description != null && e.Description.Contains("Show on Public Calendar: Yes", StringComparison.OrdinalIgnoreCase));
                if (!isExplicitlyPublic) return false;
            }

            // 3. If event is in a secondary flexible space (e.g. Office), only display on public calendar if explicitly flagged
            var evtLocNorm = NormalizeRoomName(e.Location);
            bool isSecondarySpace = evtLocNorm != managedLocNorm && evtLocNorm != "entire facility";
            if (isSecondarySpace)
            {
                bool showOnPublic = e.Description != null && e.Description.Contains("Show on Public Calendar: Yes", StringComparison.OrdinalIgnoreCase);
                if (!showOnPublic) return false;
            }

            return true;
        }).ToList();

        return new
        {
            defaultView        = _settings.DefaultView,
            primaryColor       = _settings.PrimaryColor,
            textColor          = _settings.TextColor,
            colorCodeClubEvents        = _settings.ColorCodeClubEvents,
            clubEventColor             = _settings.ClubEventColor,
            clubEventTextColor         = _settings.ClubEventTextColor,
            secondarySpaceEventColor   = _settings.SecondarySpaceEventColor,
            secondarySpaceEventTextColor = _settings.SecondarySpaceEventTextColor,
            monthDisplayMode   = _settings.MonthDisplayMode ?? "multiline",
            monthFields        = (_settings.MonthCalendarFields ?? CalendarSettings.GetDefaultPublicMonthCalendarFields())
                                    .Where(f => f.IsEnabled)
                                    .OrderBy(f => f.Order)
                                    .Select(f => new { key = f.FieldKey, label = f.Label, order = f.Order })
                                    .ToArray(),
            pendingBadgeText   = _settings.PendingBadgeText ?? "PENDING",
            approvedBadgeText  = _settings.ApprovedBadgeText ?? "RESERVED",
            showPendingBadge   = _settings.ShowPendingBadge,
            showApprovedBadge  = _settings.ShowApprovedBadge,
            showPartialAvailabilityBadge = _settings.ShowPartialAvailabilityBadge,
            partialAvailabilityBadgeText = _settings.PartialAvailabilityBadgeText ?? "Slot Open",
            
            // Modal detail preferences
            showEventModal     = _settings.ShowEventModal,
            showModalTitle     = _settings.ShowModalTitle,
            showModalTime      = _settings.ShowModalTime,
            showModalLoc       = _settings.ShowModalLocation,
            showModalStatus    = _settings.ShowModalStatus,
            showModalDesc      = _settings.ShowModalDescription,
            showModalSource    = _settings.ShowModalSource,

            // Independent Modal action buttons
            showModalBookButton     = _settings.ShowModalBookButton,
            modalBookButtonText     = _settings.ModalBookButtonText ?? "Book this Hall",
            modalBookButtonUrl      = (!string.IsNullOrWhiteSpace(_settings.ModalBookButtonUrl) && _settings.ModalBookButtonUrl != "/rentals/apply") 
                                        ? _settings.ModalBookButtonUrl 
                                        : (!string.IsNullOrWhiteSpace(_settings.HeaderBookButtonUrl) ? _settings.HeaderBookButtonUrl : "/rentals/apply"),
            showModalQuestionButton = _settings.ShowModalQuestionButton,
            modalQuestionButtonText = _settings.ModalQuestionButtonText ?? "Ask a Question",
            modalQuestionButtonUrl  = (!string.IsNullOrWhiteSpace(_settings.ModalQuestionButtonUrl) && _settings.ModalQuestionButtonUrl != "/rentals/apply?mode=inquiry")
                                        ? _settings.ModalQuestionButtonUrl
                                        : (!string.IsNullOrWhiteSpace(_settings.HeaderQuestionButtonUrl) ? _settings.HeaderQuestionButtonUrl : "/rentals/apply?mode=inquiry"),
            daySchedules            = (_webSettings?.GetDaySchedulesList() ?? WebsiteSettings.GetDefaultDaySchedules())
                                        .Select(d => new
                                        {
                                            day = (int)d.Day,
                                            dayOfWeek = (int)d.DayOfWeek,
                                            isAvailable = d.IsAvailable,
                                            slots = (d.Slots ?? new List<DayScheduleSlotConfig>()).Select(s => new
                                            {
                                                startTime = s.StartTime,
                                                endTime = s.EndTime,
                                                isActive = s.IsActive
                                            }).ToArray()
                                        }).ToArray(),
            // Mobile Preferences
            mobileDisplayMode              = _settings.MobileDisplayMode ?? "drawer",
            mobileShowBookAvailableSlot    = _settings.MobileShowBookAvailableSlot,
            mobileBookAvailableSlotText    = _settings.MobileBookAvailableSlotText ?? "Book Available Slot",
            mobileShowQuestionAvailableSlot= _settings.MobileShowQuestionAvailableSlot,
            mobileQuestionAvailableSlotText= _settings.MobileQuestionAvailableSlotText ?? "Ask a Question",
            mobileOpenSlotMessage          = _settings.MobileOpenSlotMessage ?? "Remaining time slot(s) are available for booking on this date!",

            refreshMs          = includeAutoRefresh ? RefreshIntervalMs : 0,
            dotNetRef          = _dotNetRef,
            events             = filteredEvents.Select(e =>
            {
                string rawTitle = e.Title ?? "(No Title)";
                string status = e.Status ?? "Approved";
                bool isClub = IsClubEvent(e);
                var eLocNorm = NormalizeRoomName(e.Location);
                bool isSecSpace = eLocNorm != managedLocNorm && eLocNorm != "entire facility";
                bool isBlackout = isClub && e.Description != null && e.Description.Contains("Block Out Rental Slots: Yes", StringComparison.OrdinalIgnoreCase);
                string publicDesc = CleanPublicDescription(e.Description, isClub);

                if (rawTitle.StartsWith("PENDING:", StringComparison.OrdinalIgnoreCase))
                {
                    status = "Pending";
                    rawTitle = rawTitle.Substring(8).Trim();
                }
                else if (rawTitle.StartsWith("INQUIRY:", StringComparison.OrdinalIgnoreCase))
                {
                    status = "Inquiry";
                    rawTitle = rawTitle.Substring(8).Trim();
                }

                // Parse separate applicantName and eventType from linked DB request, title, or description
                string applicantName = "";
                string eventType = "";

                if (isClub)
                {
                    bool explicitlyPublic = e.Description != null && e.Description.Contains("Show on Public Calendar: Yes", StringComparison.OrdinalIgnoreCase);
                    eventType = explicitlyPublic ? rawTitle : "Reserved";
                    if (!explicitlyPublic)
                    {
                        rawTitle = "Reserved";
                        publicDesc = string.Empty;
                    }
                }
                else
                {
                    // 1. If title has delimiters (e.g., "Helder Silva | Anniversary" or "Helder Silva - Anniversary"), split first
                    if (rawTitle.Contains(" | "))
                    {
                        var parts = rawTitle.Split(" | ", 2, StringSplitOptions.TrimEntries);
                        applicantName = parts[0];
                        if (parts.Length > 1) eventType = parts[1];
                    }
                    else if (rawTitle.Contains(" - "))
                    {
                        var parts = rawTitle.Split(" - ", 2, StringSplitOptions.TrimEntries);
                        applicantName = parts[0];
                        eventType = parts[1];
                    }

                    // 2. Try resolving or enriching from matched database rental request
                    HallRentalRequest? matchedReq = null;
                    if (e.RentalRequestId.HasValue && e.RentalRequestId.Value > 0)
                    {
                        matchedReq = _dbRentalRequests.FirstOrDefault(r => r.Id == e.RentalRequestId.Value);
                    }
                    if (matchedReq == null && !string.IsNullOrWhiteSpace(e.GoogleEventId) && e.GoogleEventId.StartsWith("db-rental-", StringComparison.OrdinalIgnoreCase))
                    {
                        if (int.TryParse(e.GoogleEventId.Substring("db-rental-".Length), out int reqId))
                        {
                            matchedReq = _dbRentalRequests.FirstOrDefault(r => r.Id == reqId);
                        }
                    }
                    if (matchedReq == null)
                    {
                        matchedReq = _dbRentalRequests.FirstOrDefault(r => 
                            r.EventDate.Date == e.Start.Date && 
                            (!string.IsNullOrWhiteSpace(r.ApplicantName) && rawTitle.Contains(r.ApplicantName, StringComparison.OrdinalIgnoreCase) ||
                             !string.IsNullOrWhiteSpace(r.EventType) && rawTitle.Contains(r.EventType, StringComparison.OrdinalIgnoreCase)));
                    }

                    if (matchedReq != null)
                    {
                        if (string.IsNullOrWhiteSpace(applicantName))
                            applicantName = matchedReq.ApplicantName?.Trim() ?? "";
                        if (string.IsNullOrWhiteSpace(eventType))
                            eventType = !string.IsNullOrWhiteSpace(matchedReq.EventType) ? matchedReq.EventType.Trim() : "";
                    }

                    // 3. Check description fallback for "Applicant: XYZ"
                    if (string.IsNullOrWhiteSpace(applicantName) && !string.IsNullOrEmpty(e.Description) && e.Description.Contains("Applicant:", StringComparison.OrdinalIgnoreCase))
                    {
                        var match = System.Text.RegularExpressions.Regex.Match(e.Description, @"Applicant:\s*([^\r\n]+)", System.Text.RegularExpressions.RegexOptions.IgnoreCase);
                        if (match.Success)
                        {
                            applicantName = match.Groups[1].Value.Trim();
                        }
                    }

                    // If event type is still empty after separating, use rawTitle
                    if (string.IsNullOrWhiteSpace(eventType))
                    {
                        eventType = string.IsNullOrWhiteSpace(applicantName) ? rawTitle : "";
                    }
                }

                return new
                {
                    id                = e.GoogleEventId ?? Guid.NewGuid().ToString("N"),
                    title             = rawTitle,
                    applicantName     = applicantName,
                    eventType         = eventType,
                    status            = status,
                    isClubEvent       = isClub,
                    isSecondarySpace  = isSecSpace,
                    isBlackoutBlocked = isBlackout,
                    start             = e.Start.ToString("o"),
                    end               = e.End != default ? e.End.ToString("o") : (string?)null,
                    allDay            = e.IsAllDay,
                    description       = publicDesc,
                    location          = e.Location,
                    source            = e.Source,
                    barRequested      = e.BarRequested,
                    eventFee          = e.EventFee,
                    isSlotBlock       = isClub && (rawTitle.StartsWith("Slot Blocked", StringComparison.OrdinalIgnoreCase) || 
                                                  (!string.IsNullOrEmpty(e.Description) && e.Description.StartsWith("Slot Blocked", StringComparison.OrdinalIgnoreCase)))
                };
            }).ToArray()
        };
    }

    public async ValueTask DisposeAsync()
    {
        RentalService.OnCalendarUpdated -= OnDataChanged;
        try { await JSRuntime.InvokeVoidAsync("GfcFullCalendar.destroy", _containerId); }
        catch { }
        _dotNetRef?.Dispose();
    }
}
