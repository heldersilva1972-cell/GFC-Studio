
@using Microsoft.JSInterop
@using GFC.BlazorServer.Services
@using System.Threading
@implements IAsyncDisposable

@inject IJSRuntime JSRuntime
@inject IBlazorSystemSettingsService SystemSettingsService
@inject NavigationManager NavigationManager
@inject CustomAuthenticationStateProvider AuthStateProvider
@inject ILogger<SessionMonitor> Logger

<div class="modal fade" id="sessionWarningModal" tabindex="-1" aria-labelledby="sessionWarningModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="sessionWarningModalLabel">Session Timeout Warning</h5>
            </div>
            <div class="modal-body">
                <p>Your session is about to expire due to inactivity. You will be logged out in <span class="fw-bold">@_countdownSeconds</span> seconds.</p>
                <p>To stay logged in, please move your mouse or press any key.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" @onclick="StayLoggedIn">Stay Logged In</button>
            </div>
        </div>
    </div>
</div>

@code {
    private DotNetObjectReference<SessionMonitor> _dotNetRef;
    private int _idleTimeoutMinutes;
    private Timer _countdownTimer;
    private int _countdownSeconds = 60;
    private bool _logoutInProgress = false;  // prevents double-logout race between JS and C# timers
    private bool _lastIsStation;
    private bool _isInitialized = false;

    [Parameter]
    public bool IsStation { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender || (_isInitialized && _lastIsStation != IsStation))
        {
            _lastIsStation = IsStation;
            _isInitialized = true;

            var settings = await SystemSettingsService.GetSystemSettingsAsync();
            _idleTimeoutMinutes = settings?.IdleTimeoutMinutes ?? 20;

            // [STATION MODE] Faster idle logout for shared devices
            if (IsStation)
            {
                _idleTimeoutMinutes = 15;
            }

            // [SECURITY FIX] Ensure a minimum of 5 minutes to prevent race conditions or session reset loops
            if (_idleTimeoutMinutes < 5) _idleTimeoutMinutes = 5;

            // Clean up old reference if we are re-initializing
            if (_dotNetRef != null)
            {
                try { _dotNetRef.Dispose(); } catch { }
            }

            _dotNetRef = DotNetObjectReference.Create(this);
            await JSRuntime.InvokeVoidAsync("sessionMonitor.init", _dotNetRef, _idleTimeoutMinutes, _idleTimeoutMinutes - 1);
        }
    }

    [JSInvokable]
    public void ShowIdleWarning()
    {
        // [FIX] Always dispose existing timer before starting a new one to prevent countdown speed-up
        _countdownTimer?.Dispose();

        _countdownSeconds = 60;
        _countdownTimer = new Timer(async _ =>
        {
            _countdownSeconds--;
            if (_countdownSeconds <= 0)
            {
                _countdownTimer?.Dispose();
                Logger.LogWarning("Session auto-logout triggered after countdown expired.");
                await LogoutUser();
                return; // Do NOT call StateHasChanged after navigation — component is being torn down
            }

            try
            {
                await InvokeAsync(StateHasChanged);
            }
            catch (Exception ex)
            {
                // Circuit may have disconnected. Stop the timer to prevent repeated failures.
                Logger.LogWarning(ex, "StateHasChanged failed in session countdown — disposing timer.");
                _countdownTimer?.Dispose();
            }
        }, null, 1000, 1000);

        Logger.LogInformation("Idle warning displayed. User has 60 seconds to respond.");
        JSRuntime.InvokeVoidAsync("sessionMonitor.showWarningModal");
    }

    [JSInvokable]
    public async Task LogoutUser()
    {
        // Prevent double-logout: both the JS 30-min timeout and the C# countdown
        // can independently trigger this method at nearly the same time.
        if (_logoutInProgress) return;
        _logoutInProgress = true;

        _countdownTimer?.Dispose();

        try
        {
            // JS context may be unavailable (degraded circuit, navigation already in progress, etc.)
            // Must NOT let this throw — the logout must always complete.
            await JSRuntime.InvokeVoidAsync("sessionMonitor.cleanup");
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "JS cleanup failed during logout — proceeding with server-side logout.");
        }

        try
        {
            await AuthStateProvider.LogoutAsync();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "AuthStateProvider.LogoutAsync() failed — forcing navigation to login.");
        }

        await InvokeAsync(() => NavigationManager.NavigateTo("/login", true));
    }

    private async Task StayLoggedIn()
    {
        await JSRuntime.InvokeVoidAsync("sessionMonitor.resetTimer");
    }

    [JSInvokable]
    public async Task ResetFromJavaScript()
    {
        _countdownTimer?.Dispose();
        _logoutInProgress = false; // allow future logout attempts after a session reset
        await JSRuntime.InvokeVoidAsync("sessionMonitor.hideWarningModal");
    }

    public async ValueTask DisposeAsync()
    {
        _countdownTimer?.Dispose();
        if (_dotNetRef != null)
        {
            try 
            {
                await JSRuntime.InvokeVoidAsync("sessionMonitor.cleanup");
            }
            catch (Exception) { /* JS already dead? */ }
            _dotNetRef.Dispose();
        }
    }
}
