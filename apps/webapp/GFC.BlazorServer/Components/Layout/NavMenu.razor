@code {
    [Parameter] public bool IsAdmin { get; set; }
    private string SearchTerm { get; set; } = "";
    private List<int> UserPermissionIds { get; set; } = new();
    private List<GFC.Core.Models.AppPage> AllPages { get; set; } = new();
    
    private Dictionary<string, bool> ExpandedSections = new()
    {
        { "Membership", false }, { "Controllers", false }, { "Bartenders", false }, { "HallRentals", false },
        { "Finance", false }, { "Bar", false }, { "Lottery", false }, { "PosSystem", false }, { "Cameras", false }, { "Website", false },
        { "Admin", false }, { "System", false }, { "Studio", false }, { "MobileHub", false }, { "Bingo", false }
    };
    private EventHandler<Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs>? _locationChangedHandler;

    protected override async Task OnInitializedAsync()
    {
        _locationChangedHandler = (s, e) => StateHasChanged();
        Navigation.LocationChanged += _locationChangedHandler;
        PermissionState.OnPermissionsChanged += OnPermissionsChanged;
        await ReloadPermissions();
    }

    private void OnPermissionsChanged()
    {
        InvokeAsync(async () =>
        {
            await ReloadPermissions();
        });
    }

    private async Task ReloadPermissions()
    {
        try {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var userIdClaim = authState.User.FindFirst("UserId") ?? authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier);
            if (userIdClaim != null && int.TryParse(userIdClaim.Value, out var userId)) {
                UserPermissionIds = UserService.GetUserPagePermissions(userId).Select(p => p.PageId).ToList();
            }
            AllPages = UserService.GetAllPages().ToList();
            StateHasChanged();
        } catch { AllPages = new(); UserPermissionIds = new(); }
    }

    private bool HasAccessTo(string route) {
        if (IsAdmin) return true;
        var normalizedRoute = route.TrimStart('/').ToLowerInvariant();
        
        // Exact match — if the page is registered, return the explicit permission result (never fall through)
        var page = AllPages.FirstOrDefault(p => p.PageRoute.TrimStart('/').ToLowerInvariant() == normalizedRoute);
        if (page != null) return UserPermissionIds.Contains(page.PageId);

        // Sub-route match (inheritance) — only for unregistered dynamic routes
        return AllPages.Any(p => 
            normalizedRoute.StartsWith(p.PageRoute.TrimStart('/').ToLowerInvariant() + "/") && 
            UserPermissionIds.Contains(p.PageId));
    }

    private void ToggleSection(string section) {
        if (!ExpandedSections.ContainsKey(section)) return;
        var current = ExpandedSections[section];
        foreach (var key in ExpandedSections.Keys.ToList()) ExpandedSections[key] = false;
        ExpandedSections[section] = !current;
    }

    private bool IsSectionExpanded(string section) => !string.IsNullOrWhiteSpace(SearchTerm) || (ExpandedSections.ContainsKey(section) && ExpandedSections[section]);

    private int GetSectionItemCount(string category) {
        if (AllPages == null || !AllPages.Any()) return 0;
        return AllPages.Count(p => string.Equals(p.Category, category, StringComparison.OrdinalIgnoreCase) && p.IsActive && HasAccessTo(p.PageRoute));
    }

    private bool ShouldShowSection(string category) => GetSectionItemCount(category) > 0;
    private bool ShouldShowWorkspace(params string[] categories) => categories.Any(ShouldShowSection);

    public void Dispose()
    {
        if (_locationChangedHandler != null)
        {
            Navigation.LocationChanged -= _locationChangedHandler;
        }
        PermissionState.OnPermissionsChanged -= OnPermissionsChanged;
    }
}
