@using GFC.BlazorServer.Components.Common
@inherits LayoutComponentBase
@implements IDisposable
@implements IAsyncDisposable
@using GFC.Core.Enums
@using GFC.Core.Interfaces
@using GFC.BlazorServer.Services
@using Microsoft.AspNetCore.Authorization
@inject CustomAuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject IAuthenticationService AuthService
@inject IVersionService VersionService
@inject IBlazorSystemSettingsService SystemSettingsService
@inject ILogger<MainLayout> Logger
@inject ThemeService ThemeService
@inject IUserConnectionService UserConnectionService
@inject ControllerHealthService ControllerHealthService
@inject IUserSessionService UserSessionService
@inject IJSRuntime JSRuntime
@inject IAuditLogger AuditLogger
@inject IDeviceTrustService DeviceTrustService
@inject IUserManagementService UserService
@inject SignInDrawPrintService PrintDrawService

@if (_stableIsMobile && string.IsNullOrEmpty(Navigation.ToBaseRelativePath(Navigation.Uri)))
{
    @* Defensive: Redirection is in progress. Show nothing to prevent dashboard flicker. *@
    <div style="height: 100vh; background: white; display:flex; align-items:center; justify-content:center;">
        <div class="spinner-border text-primary"></div>
    </div>
}
else
{
    <div class="app-shell">
    @if (_safeModeEnabled)
    {
        <div style="background-color: #ff4444; color: white; text-align: center; padding: 0.5rem; font-weight: bold; position: sticky; top: 0; z-index: 2000;">
            ⚠️ SYSTEM IN SAFE MODE. RESTRICTED ACCESS ACTIVE.
        </div>
    }
    <header class="app-topbar">
        <div class="app-topbar-left">
            <button class="menu-toggle-btn" @onclick="ToggleSidebar" title="Toggle Menu">
                <i class="bi bi-list"></i>
            </button>
            <span class="app-logo">GFC</span>
            <span class="app-title">GFC Membership System</span>
        </div>
        <div class="app-topbar-right">
            <AuthorizeView>
                <Authorized>
                    <!-- Desktop only items -->
                    <div class="desktop-actions d-flex align-items-center gap-3">

                        <div class="connection-status @GetConnectionStatusClass()" title="Card Access Controller Status">
                            <i class="bi @GetConnectionStatusIcon()"></i>
                            <span>@_connectionStatus</span>
                        </div>
                        
                        @if (_isStation)
                        {
                            <div class="badge bg-warning text-dark px-3 py-2 rounded-pill shadow-sm animate-pulse" style="font-size: 0.7rem; border: 1px solid rgba(0,0,0,0.1);">
                                <i class="bi bi-display-fill me-1"></i> STATION ACTIVE
                            </div>
                        }

                        <span class="app-user">@_currentUsername</span>
                        @if (_isAdmin || IsAdminUser())
                        {
                            <span class="app-badge">Admin</span>
                        }

                        <button class="app-link-button" @onclick="HandleLogout" type="button">
                            Logout
                        </button>
                    </div>
                </Authorized>
                <NotAuthorized>
                    <a class="app-link-button" href="/login">Login</a>
                </NotAuthorized>
            </AuthorizeView>
            <button class="theme-toggle" @onclick="ThemeService.ToggleThemeAsync" title="Toggle Theme" type="button">
                @if (ThemeService.IsDarkMode)
                {
                    <i class="bi bi-sun-fill"></i>
                }
                else
                {
                    <i class="bi bi-moon-stars-fill"></i>
                }
            </button>
            @if (_canInstallPwa && !_isPwaInstalled)
            {
                <button class="app-link-button ms-2" @onclick="InstallPwa" title="Install App">
                    <i class="bi bi-download me-1"></i> Install App
                </button>
            }
            else if (!_isPwaInstalled && _isIOS)
            {
                <span class="small text-muted ms-3 d-none d-md-inline" title="iOS Installation Hint">
                    <i class="bi bi-apple me-1"></i> Tap <i class="bi bi-share"></i> then 'Add to Home Screen'
                </span>
            }
        </div>
    </header>

    <div class="app-main">
        <AuthorizeView>
            <Authorized>
                <aside class="app-sidebar @(_sidebarOpen ? "open" : "")">
                    <div class="app-sidebar-inner">
                        <div class="app-sidebar-header">
                            <div class="app-logo-mark">GFC</div>
                            <div class="app-sidebar-title">
                                <div class="app-sidebar-title__main">Membership</div>
                                <div class="app-sidebar-title__sub">Control Center</div>
                            </div>
                            <button class="sidebar-close-btn" @onclick="CloseSidebar">
                                <i class="bi bi-x-lg"></i>
                            </button>
                        </div>

                        <div style="flex: 1; overflow-y: auto; min-height: 0;">
                            <NavMenu IsAdmin="_isAdmin || IsAdminUser()" />
                        </div>

                        <div class="app-sidebar-footer">
                            <!-- Mobile only actions -->
                            <div class="d-lg-none mb-3 d-flex flex-column gap-2">
                                <div class="p-2 rounded bg-surface border border-glass">
                                    <small class="text-muted d-block mb-1">Status</small>
                                    <div class="d-flex align-items-center gap-2 mb-2">
                                        <i class="bi @GetConnectionStatusIcon() text-@( _isControllerOnline ? "success" : "danger" )"></i>
                                        <span class="small">@(_isControllerOnline ? "Controller Online" : "Controller Offline")</span>
                                    </div>

                                </div>
                                

                                <button class="btn btn-danger w-100 btn-sm text-start" @onclick="HandleLogout">
                                    <i class="bi bi-box-arrow-right me-2"></i> Logout
                                </button>
                            </div>

                            <div class="version-info">
                                <div class="version-info__developer">@VersionService.GetDeveloper() @VersionService.GetYear()</div>
                                <div class="version-info__revision">Revision @VersionService.GetRevision()</div>
                            </div>
                        </div>
                    </div>
                </aside>
                @if (_sidebarOpen)
                {
                    <div class="sidebar-overlay" @onclick="CloseSidebar"></div>
                }
            </Authorized>
        </AuthorizeView>

        <main class="app-content">
            <Toast />
            <div class="content px-4">
                @Body
            </div>
        </main>
    </div> <!-- app-main -->
</div> <!-- app-shell -->

<SignInDrawPrintContent @ref="_printDrawContent" />
}

<SessionMonitor IsStation="@_isStation" />

@code {
    private int _currentPageLogId;
    private string _currentUsername = string.Empty;
    private bool _isAdmin = false;
    private bool _safeModeEnabled = false;
    private string _connectionStatus = "Checking...";
    private System.Threading.Timer? _healthTimer;
    private System.Threading.Timer? _sessionTimer;
    private System.Threading.Timer? _activityTimer;
    private bool _isControllerOnline = false;
    private bool _isStation = false;

    private bool _canInstallPwa = false;
    private bool _isPwaInstalled = false;
    private bool _isIOS = false;
    private bool _isDisposed = false;
    private bool _sidebarOpen = false;
    private bool _stableIsMobile = false;

    private string? _deviceToken;
    private SystemSettings? _settings;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // 1. Parallelize all core startup data fetching for lower latency
            var settingsTask = SystemSettingsService.GetSystemSettingsAsync();
            var safeModeTask = SystemSettingsService.GetSafeModeEnabledAsync();
            var userInfoTask = UpdateUserInfo();
            var themeInitTask = ThemeService.InitializeAsync();
            
            await Task.WhenAll(settingsTask, safeModeTask, userInfoTask, themeInitTask);
            
            _settings = await settingsTask;
            _safeModeEnabled = await safeModeTask;

            // 2. Critical Enforcement Checks
            UserConnectionService.DetectConnectionIfNeeded(); 
            _stableIsMobile = UserConnectionService.IsMobile;

            if (_safeModeEnabled && !_isAdmin && !IsAdminUser())
            {
                Navigation.NavigateTo("/safe-mode-lockout");
                return;
            }

            UpdateControllerStatus();
            EnforceVpnEnforcementSync(_settings);

            // 3. Handle Special Redirects (Password/Activation/Mobile Only)
            var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
            if (Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query).TryGetValue("token", out var token))
            {
                if (!uri.AbsolutePath.Contains("/setup/device", StringComparison.OrdinalIgnoreCase)) {
                    Navigation.NavigateTo($"/setup/device?token={token}&native=true", forceLoad: true);
                    return;
                }
            }

            EnforceSecuritySetup();
            RedirectMobileUsersIfNeeded();
            EnforcePageAccess();

            // 4. Start Background Monitors
            StartSystemMonitors();
            
            // 5. Detection for Station Mode is now handled via claims for zero-latency UI response
            // No startup delay required.

            AuthStateProvider.AuthenticationStateChanged += HandleAuthenticationStateChanged;
            ThemeService.OnThemeChanged += StateHasChanged;
            Navigation.LocationChanged += HandleLocationChanged;
            PrintDrawService.OnPrintRequested += HandlePrintRequested;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Critical failure during MainLayout initialization.");
            _currentUsername = "System Error";
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LogCurrentPage();
        }
    }

    private void StartSystemMonitors()
    {
        _healthTimer = new System.Threading.Timer(async _ => 
        {
            if (_isDisposed) return;
            try {
                UpdateControllerStatus();
                await CheckPwaStatus();

                // [FIX] Throttled Refresh: Only hit the DB every 30s if the circuit is actually active
                // This prevents "zombie" disconnected circuits from holding DB connections open.
                await AuthStateProvider.RefreshUserAsync();
                await ValidateSession();
                
                if (!_isDisposed) 
                {
                    await InvokeAsync(StateHasChanged);
                }
            } catch (Exception ex) {
                Logger.LogWarning("Health monitor cycle encountered an error: {Message}", ex.Message);
            }
        }, null, 10000, 30000); 

        _sessionTimer = new System.Threading.Timer(async _ =>
        {
            if (_isDisposed) return;
            var absoluteSessionMaxMinutes = _settings?.AbsoluteSessionMaxMinutes ?? 1440;
            
            // [SAFEGUARD] Ensure a minimum of 60 minutes for the absolute session to prevent accidental lockout loops
            if (absoluteSessionMaxMinutes < 60) absoluteSessionMaxMinutes = 60;

            if (UserSessionService.LoginTimeUtc != default && (DateTime.UtcNow - UserSessionService.LoginTimeUtc).TotalMinutes > absoluteSessionMaxMinutes)
            {
                Logger.LogWarning("Session limit reached ({Limit}m). Logging out Station: {IsStation}.", absoluteSessionMaxMinutes, _isStation);
                await HandleLogout();
            }
        }, null, 60000, 60000);

        _activityTimer = new System.Threading.Timer(_ => 
        {
            if (!_isDisposed) _ = RecordActivityHeartbeat();
        }, null, 60000, 60000);
    }

    private void EnforceVpnEnforcementSync(SystemSettings? settings)
    {
        if (settings == null || !settings.EnforceVpn || UserConnectionService.LocationType == LocationType.Local) return;

        bool shouldBlock = settings.AccessMode switch {
            AccessMode.VpnOnly => UserConnectionService.LocationType != LocationType.VPN,
            AccessMode.LanOrVpn => UserConnectionService.LocationType != LocationType.LAN && UserConnectionService.LocationType != LocationType.VPN,
            _ => false
        };

        if (shouldBlock) Navigation.NavigateTo("/vpn-required");
    }

    private void EnforcePageAccess()
    {
        try
        {
            var currentUser = AuthStateProvider.GetCurrentUser();
            if (currentUser == null) return;
            if (currentUser.IsAdmin) return;

            var currentUri = Navigation.ToAbsoluteUri(Navigation.Uri).AbsolutePath.ToLower();
            
            var publicPaths = new[] { "/login", "/setup", "/changepassword", "/error", "/safe-mode-lockout", "/vpn-required", "/mobile", "/verify-mfa", "/cameras/secure-access" };
            if (publicPaths.Any(p => currentUri.StartsWith(p.ToLower())) || currentUri == "/") 
            {
                return;
            }

            // Check if user has permission for this page
            // We use the service which checks the database and repository
            if (!UserService.UserHasPageAccess(currentUser.UserId, currentUri))
            {
                Logger.LogWarning("ACCESS BLOCKED: User {UserId} ({Username}) attempted to access unauthorized page: {Path}", 
                    currentUser.UserId, currentUser.Username, currentUri);
                
                // If on mobile, they should stay in mobile hub
                if (UserConnectionService.IsMobile)
                {
                    Navigation.NavigateTo("/mobile", forceLoad: false);
                }
                else
                {
                    // For web, send to dashboard or show unauthorized
                    Navigation.NavigateTo("/", forceLoad: false);
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Error checking page access permissions.");
        }
    }

    private void RedirectMobileUsersIfNeeded()
    {
        if (!UserConnectionService.IsMobile) return;

        var currentUri = Navigation.ToAbsoluteUri(Navigation.Uri).AbsolutePath.ToLower();
        
        // Allowed paths for mobile that are NOT technically /mobile/*
        var allowedPaths = new[] { "/login", "/setup", "/changepassword", "/safe-mode-lockout", "/vpn-required", "/verify-mfa", "/cameras/secure-access" };
        
        if (allowedPaths.Any(p => currentUri.StartsWith(p.ToLower()))) return;
        if (currentUri.StartsWith("/mobile")) return;

        // If on mobile and not on an allowed path or mobile path, force redirect to mobile hub
        Navigation.NavigateTo("/mobile", forceLoad: false);
    }

    private async Task CheckPwaStatus()
    {
        try
        {
            _canInstallPwa = await JSRuntime.InvokeAsync<bool>("window.GFC.canInstall");
            _isPwaInstalled = await JSRuntime.InvokeAsync<bool>("window.GFC.isPwaInstalled");
            _isIOS = await JSRuntime.InvokeAsync<bool>("window.GFC.isIOS");
        }
        catch 
        {
            // Ignore JS interop errors during prerendering or if script not loaded
        }
    }

    private async Task InstallPwa()
    {
        try
        {
            var isIOS = await JSRuntime.InvokeAsync<bool>("window.GFC.isIOS");
            if (isIOS)
            {
                await JSRuntime.InvokeVoidAsync("alert", "To install on iOS: Tap the Share button in Safari, then select 'Add to Home Screen'.");
            }
            else
            {
                await JSRuntime.InvokeAsync<bool>("window.GFC.triggerInstall");
                // Recheck status after attempt
                await Task.Delay(1000); 
                await CheckPwaStatus();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"PWA Install Error: {ex.Message}");
        }
    }

    private async Task CheckVpnEnforcement()
    {
        var settings = await SystemSettingsService.GetAsync();
        if (!settings.EnforceVpn || UserConnectionService.LocationType == LocationType.Local)
        {
            return;
        }

        bool shouldBlock = false;
        switch (settings.AccessMode)
        {
            case AccessMode.VpnOnly:
                if (UserConnectionService.LocationType != LocationType.VPN)
                {
                    shouldBlock = true;
                }
                break;
            case AccessMode.LanOrVpn:
                if (UserConnectionService.LocationType != LocationType.LAN && UserConnectionService.LocationType != LocationType.VPN)
                {
                    shouldBlock = true;
                }
                break;
            case AccessMode.Open:
            default:
                break;
        }

        if (shouldBlock)
        {
            Navigation.NavigateTo("/vpn-required");
        }
    }

    public async ValueTask DisposeAsync()
    {
        _isDisposed = true;
        _healthTimer?.Dispose();
        _sessionTimer?.Dispose();
        _activityTimer?.Dispose();
        AuthStateProvider.AuthenticationStateChanged -= HandleAuthenticationStateChanged;
        ThemeService.OnThemeChanged -= StateHasChanged;
        Navigation.LocationChanged -= HandleLocationChanged;
        PrintDrawService.OnPrintRequested -= HandlePrintRequested;
    }

    private SignInDrawPrintContent? _printDrawContent;
    private async Task HandlePrintRequested()
    {
        if (_printDrawContent != null)
        {
            await _printDrawContent.RefreshAndPrint();
        }
    }

    private async void HandleAuthenticationStateChanged(Task<AuthenticationState> task)
    {
        await InvokeAsync(async () => {
            await UpdateUserInfo();
            EnforceSecuritySetup();
            StateHasChanged();
        });
    }

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        CloseSidebar();
        LogCurrentPage();
        EnforceSecuritySetup();
        RedirectMobileUsersIfNeeded();
        EnforcePageAccess();
        
        // Check session validity only if on a protected page
        var currentUri = Navigation.ToAbsoluteUri(Navigation.Uri).AbsolutePath.ToLower();
        if (!currentUri.Contains("/login") && !currentUri.Contains("/setup"))
        {
            _ = InvokeAsync(async () => await ValidateSession());
        }
    }

    private async Task LogCurrentPage()
    {
        try
        {
            int userId = 0;
            var currentUser = AuthStateProvider.GetCurrentUser();

            if (currentUser != null && currentUser.UserId > 0)
            {
                userId = currentUser.UserId;
            }
            else
            {
                // [FIX] Fallback: Verify async state if synchronous user is missing (common during circuit startup)
                var authState = await AuthStateProvider.GetAuthenticationStateAsync();
                if (authState.User.Identity?.IsAuthenticated == true)
                {
                    var idClaim = authState.User.FindFirst("UserId")?.Value ?? 
                                 authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
                    int.TryParse(idClaim, out userId);
                }
            }

            if (userId > 0)
            {
                var relativeUri = Navigation.ToBaseRelativePath(Navigation.Uri);
                
                // Map empty root to "Dashboard"
                if (string.IsNullOrEmpty(relativeUri))
                {
                    relativeUri = "Dashboard";
                }
                
                // Ignore specific system or noisy paths if needed
                if (relativeUri.Contains("_blazor") || relativeUri.Contains("_framework"))
                {
                    return;
                }

                // [NEW] Robust Machine Identity Capture
                string? deviceToken = null;
                string? ipAddress = UserConnectionService.IpAddress;

                try
                {
                    // 1. Try Cookies First (Fastest) - Use robust window.getCookie helper
                    deviceToken = await JSRuntime.InvokeAsync<string>("window.getCookie", "GFC_StationIdentity");
                    if (string.IsNullOrEmpty(deviceToken))
                    {
                        deviceToken = await JSRuntime.InvokeAsync<string>("window.getCookie", "GFC_DeviceTrustToken");
                    }

                    // 2. Try LocalStorage Fallback
                    if (string.IsNullOrEmpty(deviceToken))
                    {
                        deviceToken = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "gfc_device_token");
                    }

                }
                catch { /* Not interactive yet or JS disconnected */ }

                _currentPageLogId = await AuditLogger.LogPageViewAsync(userId, relativeUri, null, ipAddress, deviceToken);
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to log page view");
        }
    }

    private async Task RecordActivityHeartbeat()
    {
        try
        {
            var currentUser = AuthStateProvider.GetCurrentUser();
            if (currentUser != null)
            {
                var relativeUri = Navigation.ToBaseRelativePath(Navigation.Uri);
                if (string.IsNullOrEmpty(relativeUri)) relativeUri = "Dashboard";
                
                // [NEW] Capture Machine Identity for Heartbeat
                string? deviceToken = null;
                try
                {
                    deviceToken = await JSRuntime.InvokeAsync<string>("window.getCookie", "GFC_StationIdentity");
                    if (string.IsNullOrEmpty(deviceToken))
                    {
                        deviceToken = await JSRuntime.InvokeAsync<string>("window.getCookie", "GFC_DeviceTrustToken");
                    }

                    // Fallback to LocalStorage
                    if (string.IsNullOrEmpty(deviceToken))
                    {
                        deviceToken = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "gfc_device_token");
                    }
                }
                catch { }

                await AuditLogger.UpdatePageViewDurationAsync(currentUser.UserId, relativeUri, 30, UserConnectionService.IpAddress, deviceToken, _currentPageLogId);
                
                // We've successfully updated the identity if it was missing 
            }
        }
        catch { /* Best effort */ }
    }

    /// <summary>
    /// Unified security enforcement for both Desktop and Mobile.
    /// Redirects users to required setup steps (Password Change, Passcode Setup, etc.)
    /// </summary>
    private void EnforceSecuritySetup()
    {
        try
        {
            var currentUser = AuthStateProvider.GetCurrentUser();
            var currentUri = Navigation.ToAbsoluteUri(Navigation.Uri).AbsolutePath.ToLower();
            
            // 1. Unified Bypass List (Public/Auth/Setup pages)
            var publicPaths = new[] { 
                "/login", "/setup", "/changepassword", "/error", "/safe-mode-lockout", 
                "/vpn-required", "/verify-mfa", "/logout", "/auth/magic-login", "/otp",
                "/cameras/secure-access", "/mobile"
            };
            
            bool isPublicPage = publicPaths.Any(p => currentUri.StartsWith(p.ToLower()));

            if (isPublicPage) 
            {
                return;
            }

            // [FIX] If we have no user object but are on a protected page, we MUST redirect to login.
            // This captures cases where the user was deleted or the session expired.
            if (currentUser == null)
            {
                Logger.LogWarning("Security Enforcement: Unauthenticated access attempt to {Path}. Redirecting to login.", currentUri);
                Navigation.NavigateTo("/login", forceLoad: true);
                return;
            }

            // 2. Force Password Change (Legacy password check)
            if (currentUser.PasswordChangeRequired)
            {
                Navigation.NavigateTo("/changepassword", forceLoad: false);
                return;
            }

            // 3. Force Passcode Setup (Next Gen Security)
        // [FIX] Mandatory for Mobile (Shield requirement). Optional/Prompt-only for Desktop.
        if (string.IsNullOrEmpty(currentUser.PassCodeHash))
        {
            // [BYPASS] Emergency 'admin' on the host computer should never be locked out of the UI
            bool isHostAdmin = currentUser.Username.ToLower() == "admin" && UserConnectionService.LocationType == LocationType.Local;
            
            if (UserConnectionService.IsMobile && !isHostAdmin)
            {
                 Logger.LogInformation("Security Enforcement: Mobile User {Username} is missing passcode. Redirecting to mandatory setup.", currentUser.Username);
                 Navigation.NavigateTo("/setup/wizard?setup=true", forceLoad: false);
                 return;
            }
        }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Safety catch: Security enforcement check failed.");
        }
    }

    private async Task UpdateUserInfo()
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            _currentUsername = authState.User.Identity?.Name ?? "Unknown";
            
            _isAdmin = authState.User.IsInRole(AppRoles.Admin);
            
            // [NEW] Zero-latency station detection via claims
            _isStation = authState.User.HasClaim("IsStation", "true");

            if (!_isAdmin)
            {
                var currentUser = AuthStateProvider.GetCurrentUser();
                if (currentUser != null)
                {
                    _isAdmin = currentUser.IsAdmin;
                }
            }
        }
        catch
        {
            _currentUsername = "Unknown";
            _isAdmin = false;
        }
    }

    private void NavigateToLogin()
    {
        try
        {
            Navigation.NavigateTo("/login", forceLoad: true);
        }
        catch { }
    }

    private async Task HandleLogout()
    {
        try
        {
            Logger.LogInformation("HandleLogout initiated for user: {Username}", _currentUsername);

            // [FIX] Explicitly pass the current session token to ensure isolation.
            // We retrieve the specific USER session token to revoke just this specific circuit's session.
            var sessionToken = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "gfc_device_token");
            await AuthStateProvider.LogoutAsync(sessionToken);

            Navigation.NavigateTo("/login", forceLoad: true);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error during HandleLogout for user: {Username}", _currentUsername);
            Navigation.NavigateTo("/login", forceLoad: true);
        }
    }

    private bool IsAdminUser()
    {
        try
        {
            if (_isAdmin) return true;
            var currentUser = AuthStateProvider.GetCurrentUser();
            return currentUser?.IsAdmin == true;
        }
        catch
        {
            return false;
        }
    }

    private string GetConnectionStatusClass()
    {
        return _isControllerOnline ? "status-lan" : "status-public";
    }

    private string GetConnectionStatusIcon()
    {
        return _isControllerOnline ? "bi-check-circle-fill" : "bi-x-circle-fill";
    }

    private void UpdateControllerStatus()
    {
        var status = ControllerHealthService.GetHealthStatus();
        _isControllerOnline = status.IsOnline;
        _connectionStatus = _isControllerOnline ? "Card Access Controller: Online" : "Card Access Controller: Offline";
    }



    private async Task ValidateSession()
    {
        try
        {
            // [MODIFIED] Only check if we are currently authenticated in the UI
            if (string.IsNullOrEmpty(_currentUsername) || _currentUsername == "Unknown") return;

            // [NEW] Check if the provider still thinks we are authenticated
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            if (authState.User.Identity?.IsAuthenticated != true)
            {
                // The underlying provider already lost auth, update UI but don't force a loopify logout
                if (!string.IsNullOrEmpty(_currentUsername) && _currentUsername != "Unknown")
                {
                    await UpdateUserInfo();
                }
                return;
            }

            // [NEW] Trigger security re-validation if the user object might be stale
            // This captures admin-driven changes (like Passcode Reset) within 30s.
            EnforceSecuritySetup();

            bool isMobile = UserConnectionService.IsMobile;
            if (!isMobile) return; 

            var token = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "gfc_device_token");
            if (!string.IsNullOrEmpty(token))
            {
                // Check if token is still valid (not revoked, not expired)
                var isValid = DeviceTrustService.ValidateToken(token);
                if (!isValid)
                {
                    Logger.LogWarning("ValidateSession: Mobile Token '{TokenSnippet}' is no longer valid (Revoked/Expired).", token.Length > 8 ? token.Substring(0, 8) : token);
                    
                    // Defense: Double check if the user is still valid in the identity system
                    var currentUser = AuthStateProvider.GetCurrentUser();
                    if (currentUser == null || !currentUser.IsActive)
                    {
                        var currentUri = Navigation.ToAbsoluteUri(Navigation.Uri).AbsolutePath.ToLower();
                        bool isProtected = !currentUri.Contains("/login") && !currentUri.Contains("/setup") && !currentUri.Contains("/mobile");
                        
                        if (isProtected)
                        {
                            Logger.LogInformation("Forcing logout: Mobile Session/User invalid on protected page.");
                            await HandleLogout();
                        }
                    }
                }
            }
        }
        catch (Exception ex)
        { 
             /* Ignore JS errors or concurrent disconnects */ 
             if (!(ex is JSDisconnectedException || ex is TaskCanceledException))
             {
                 Logger.LogDebug("ValidateSession: Suppressed error: {Message}", ex.Message);
             }
        }
    }
    private void ToggleSidebar()
    {
        _sidebarOpen = !_sidebarOpen;
    }

    private void CloseSidebar()
    {
        if (_sidebarOpen)
        {
            _sidebarOpen = false;
            StateHasChanged();
        }
    }

    public void Dispose()
    {
        _isDisposed = true;
        _healthTimer?.Dispose();
        _sessionTimer?.Dispose();
        _activityTimer?.Dispose();
    }
}
