@page "/lottery/compliance"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@using GFC.Core.Interfaces
@using GFC.Core.DTOs
@using System.Globalization
@inject ILotteryShiftService LotteryService
@inject GFC.Core.Interfaces.IUserManagementService UserService
@inject GFC.BlazorServer.Services.CustomAuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation

<style>
    .compliance-container {
        padding: 0.5rem 0 2rem 0;
        background: transparent;
        width: 100%;
    }

    .compliance-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 16px;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -1px rgba(0, 0, 0, 0.02);
        padding: 2rem;
    }

    .legend-dot {
        width: 12px;
        height: 12px;
        border-radius: 50%;
        display: inline-block;
    }

    .bg-success-dot {
        background-color: #10b981 !important; /* Premium Emerald green */
        box-shadow: 0 0 6px rgba(16, 185, 129, 0.4);
    }

    .bg-draft-dot {
        background-color: #f59e0b !important; /* Amber yellow */
        box-shadow: 0 0 6px rgba(245, 158, 11, 0.4);
    }

    .bg-duplicate-dot {
        background-color: #ef4444 !important; /* Vibrant red */
        box-shadow: 0 0 6px rgba(239, 68, 68, 0.4);
    }

    .bg-missing-dot {
        background-color: rgba(148, 163, 184, 0.15) !important;
        border: 1.5px solid #cbd5e1 !important;
    }

    /* Shift Dot Hover Animations */
    .shift-dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        cursor: default;
        transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.2s ease;
    }

    .shift-dot:hover {
        transform: scale(1.4);
        z-index: 10;
    }

    .table-bordered th {
        font-weight: 800;
        text-transform: uppercase;
        font-size: 0.72rem;
        letter-spacing: 0.05em;
        background: #f1f5f9;
        color: #475569;
    }

    .month-col {
        font-weight: 900;
        color: #0f172a;
        width: 90px;
        text-align: left;
        padding-left: 1rem !important;
    }

    .day-cell {
        width: 32px;
        height: 32px;
        padding: 4px !important;
    }

    .animate-entrance {
        animation: fadeIn 0.4s ease-out forwards;
    }

    @@keyframes fadeIn {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
    }
</style>

<div class="compliance-container animate-entrance">
    <div class="compliance-card">
        <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
            <div>
                <h3 class="fw-bold mb-1 text-dark">Lottery Compliance Audit</h3>
                <p class="text-muted small mb-0">Year-at-a-glance shift verification grid</p>
            </div>

            <div class="d-flex align-items-center gap-3 flex-wrap">
                <!-- Legend -->
                <div class="d-flex align-items-center gap-3 border rounded-pill px-4 py-2 bg-light shadow-sm" style="font-size: 0.75rem;">
                    <div class="d-flex align-items-center gap-2">
                        <span class="legend-dot bg-missing-dot"></span>
                        <span class="fw-bold text-secondary">MISSING</span>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <span class="legend-dot bg-draft-dot"></span>
                        <span class="fw-bold text-warning">DRAFT</span>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <span class="legend-dot bg-success-dot"></span>
                        <span class="fw-bold text-success">SUBMITTED</span>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <span class="legend-dot bg-duplicate-dot"></span>
                        <span class="fw-bold text-danger">DUPLICATE</span>
                    </div>
                </div>

                <!-- Year Select -->
                <div class="input-group input-group-sm w-auto shadow-sm rounded-pill overflow-hidden border">
                    <span class="input-group-text border-0 bg-white fw-bold px-3 text-secondary">AUDIT YEAR:</span>
                    <select class="form-select border-0 fw-bold px-3" @bind="_complianceYear" @bind:after="LoadComplianceData" style="height: 38px;">
                        @foreach (var year in _availableYears)
                        {
                            <option value="@year">@year</option>
                        }
                    </select>
                </div>
            </div>
        </div>

        @if (_isLoading)
        {
            <div class="text-center py-5">
                <div class="spinner-border text-primary" role="status"></div>
                <p class="text-muted mt-2 small">Fetching lottery shifts...</p>
            </div>
        }
        else
        {
            <div class="table-responsive border rounded-4 shadow-sm bg-white overflow-hidden">
                <table class="table table-bordered text-center align-middle mb-0" style="font-size: 0.8rem;">
                    <thead>
                        <tr>
                            <th class="month-col ps-3">Month</th>
                            @for (int d = 1; d <= 31; d++)
                            {
                                <th style="width: 32px; padding: 6px 4px;">@d</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @for (int m = 1; m <= 12; m++)
                        {
                            var localMonth = m;
                            <tr>
                                <td class="month-col fw-bold bg-light">@GetMonthAbbreviation(localMonth)</td>
                                @for (int d = 1; d <= 31; d++)
                                {
                                    var localDay = d;
                                    var daysInMonth = DateTime.DaysInMonth(_complianceYear, localMonth);
                                    if (localDay > daysInMonth)
                                    {
                                        <td class="bg-light bg-opacity-50"></td>
                                    }
                                    else
                                    {
                                        var status = _complianceGrid.ContainsKey((localMonth, localDay)) 
                                            ? _complianceGrid[(localMonth, localDay)] 
                                            : (DayStatus: "Missing", NightStatus: "Missing", DayCount: 0, NightCount: 0);

                                        <td class="day-cell">
                                            <div class="d-flex flex-column gap-1 align-items-center justify-content-center">
                                                <!-- Day shift dot -->
                                                @{
                                                    string dayColor = "bg-missing-dot";
                                                    if (status.DayCount > 1) dayColor = "bg-duplicate-dot";
                                                    else if (status.DayStatus == "Submitted") dayColor = "bg-success-dot";
                                                    else if (status.DayStatus == "Draft") dayColor = "bg-draft-dot";

                                                    string dayTitle = $"Day Shift: {(status.DayCount > 0 ? status.DayStatus : "Missing")}";
                                                    if (status.DayCount > 1) dayTitle += $" ({status.DayCount} entries - Duplicate)";
                                                }
                                                <div class="shift-dot @dayColor" title="@dayTitle"></div>

                                                <!-- Night shift dot -->
                                                @{
                                                    string nightColor = "bg-missing-dot";
                                                    if (status.NightCount > 1) nightColor = "bg-duplicate-dot";
                                                    else if (status.NightStatus == "Submitted") nightColor = "bg-success-dot";
                                                    else if (status.NightStatus == "Draft") nightColor = "bg-draft-dot";

                                                    string nightTitle = $"Night Shift: {(status.NightCount > 0 ? status.NightStatus : "Missing")}";
                                                    if (status.NightCount > 1) nightTitle += $" ({status.NightCount} entries - Duplicate)";
                                                }
                                                <div class="shift-dot @nightColor" title="@nightTitle"></div>
                                            </div>
                                        </td>
                                    }
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@code {
    private int _complianceYear = DateTime.Now.Year;
    private bool _isLoading = false;
    private List<int> _availableYears = new() { DateTime.Now.Year };
    private Dictionary<(int Month, int Day), (string DayStatus, string NightStatus, int DayCount, int NightCount)> _complianceGrid = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadYears();
        await LoadComplianceData();
    }

    private async Task LoadYears()
    {
        try
        {
            var shifts = await Task.Run(() => LotteryService.GetAllShifts());
            if (shifts != null && shifts.Any())
            {
                var years = shifts.Select(s => s.ShiftDate.Year).Distinct().OrderByDescending(y => y).ToList();
                if (!years.Contains(DateTime.Now.Year))
                {
                    years.Insert(0, DateTime.Now.Year);
                }
                _availableYears = years;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading available lottery years: {ex.Message}");
        }
    }

    private async Task LoadComplianceData()
    {
        if (_isLoading) return;
        _isLoading = true;
        _complianceGrid = new Dictionary<(int, int), (string, string, int, int)>();
        StateHasChanged();

        try
        {
            var startDate = new DateTime(_complianceYear, 1, 1);
            var endDate = new DateTime(_complianceYear, 12, 31);
            var shifts = await Task.Run(() => LotteryService.GetShiftsByDateRange(startDate, endDate));

            if (shifts != null)
            {
                foreach (var shift in shifts)
                {
                    var date = shift.ShiftDate.Date;
                    var key = (date.Month, date.Day);
                    
                    var current = _complianceGrid.ContainsKey(key)
                        ? _complianceGrid[key]
                        : (DayStatus: "Missing", NightStatus: "Missing", DayCount: 0, NightCount: 0);

                    bool isNight = shift.ShiftType?.Equals("Night", StringComparison.OrdinalIgnoreCase) == true;
                    string status = shift.Status ?? "Submitted";

                    if (isNight)
                    {
                        current.NightCount++;
                        current.NightStatus = status;
                    }
                    else
                    {
                        current.DayCount++;
                        current.DayStatus = status;
                    }

                    _complianceGrid[key] = current;
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading lottery compliance grid: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private string GetMonthAbbreviation(int month)
    {
        return CultureInfo.CurrentCulture.DateTimeFormat.GetAbbreviatedMonthName(month);
    }
}
