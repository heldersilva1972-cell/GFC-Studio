@page "/app"
@page "/download"
@using GFC.Core.Interfaces
@inject IDeviceTrustService DeviceTrustService
@inject NavigationManager NavManager
@inject IJSRuntime JS
@layout GFC.BlazorServer.Components.Layout.EmptyLayout

<PageTitle>GFC Connect - Download & Setup</PageTitle>

<div class="gfc-download-wrapper">
    <div class="gfc-download-card">
        <!-- Brand Header -->
        <div class="gfc-brand-header">
            <div class="gfc-logo-badge">
                <i class="bi bi-shield-lock-fill"></i>
            </div>
            <h1 class="gfc-title">GFC Connect</h1>
            <p class="gfc-subtitle">Download the official Gloucester Fraternity Club member app for door access and alerts.</p>
        </div>

        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <div class="gfc-alert-error">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                <span>@_errorMessage</span>
            </div>
        }

        <!-- Direct 1-Tap Download Button -->
        <div class="text-center mb-4">
            <a href="/api/app/download/latest.apk" class="gfc-btn-verify text-decoration-none">
                <i class="bi bi-download me-2"></i>
                <span>DOWNLOAD GFC CONNECT (APK)</span>
            </a>
            <div class="text-muted small mt-2">
                <i class="bi bi-shield-check text-info me-1"></i>Official Direct Download from Club Server
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(_cleanCode))
        {
            <!-- Admin Setup Code Card -->
            <div class="p-3 rounded-4 mb-4" style="background: rgba(0, 229, 255, 0.08); border: 1.5px dashed rgba(0, 229, 255, 0.4);">
                <div class="text-info small fw-bold text-uppercase mb-1" style="letter-spacing: 0.05em;">
                    <i class="bi bi-key-fill me-1"></i>Your 8-Digit Setup Code
                </div>
                <div class="display-6 fw-bold text-white mb-2" style="letter-spacing: 0.15em;">
                    @_displayCode
                </div>
                <div class="text-muted small mb-3">
                    Enter this code inside the app after installing to link your member profile.
                </div>

                @{
                    var deepLink = $"gfcconnect://pair?code={_cleanCode}";
                }
                <a href="@deepLink" class="btn btn-outline-info btn-sm w-100 fw-bold py-2 rounded-pill">
                    <i class="bi bi-box-arrow-up-right me-1"></i> Already Installed? Open &amp; Pair App
                </a>
            </div>
        }

        <!-- 3 Quick Start Steps -->
        <div class="gfc-steps-card">
            <div class="gfc-step-item">
                <div class="gfc-step-number">1</div>
                <div class="gfc-step-icon"><i class="bi bi-download"></i></div>
                <div class="gfc-step-text">
                    <strong>1. Tap Download</strong>
                    <span>Your browser downloads the latest APK file</span>
                </div>
            </div>
            <div class="gfc-step-item">
                <div class="gfc-step-number">2</div>
                <div class="gfc-step-icon"><i class="bi bi-android2"></i></div>
                <div class="gfc-step-text">
                    <strong>2. Tap Open &amp; Install</strong>
                    <span>If prompted, allow installation from this source</span>
                </div>
            </div>
            <div class="gfc-step-item">
                <div class="gfc-step-number">3</div>
                <div class="gfc-step-icon"><i class="bi bi-fingerprint"></i></div>
                <div class="gfc-step-text">
                    <strong>3. Open App &amp; Pair</strong>
                    <span>Enter your setup code once inside the app to finish</span>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .gfc-download-wrapper {
        min-height: 100vh;
        background: linear-gradient(135deg, #070D1E 0%, #0F1D38 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 16px 12px;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        box-sizing: border-box;
    }
    .gfc-download-card {
        background: #111C35;
        border: 1px solid rgba(0, 229, 255, 0.2);
        border-radius: 24px;
        max-width: 440px;
        width: 100%;
        padding: 28px 16px;
        box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5), 0 0 30px rgba(0, 229, 255, 0.08);
        box-sizing: border-box;
    }
    @@media (max-width: 380px) {
        .gfc-download-card {
            padding: 24px 12px;
        }
        .gfc-digit-box {
            height: 44px;
            font-size: 1.15rem;
        }
    }
    .gfc-brand-header {
        text-align: center;
        margin-bottom: 28px;
    }
    .gfc-logo-badge {
        width: 60px;
        height: 60px;
        background: linear-gradient(135deg, #00E5FF, #0077B6);
        border-radius: 18px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: #070D1E;
        font-size: 28px;
        margin-bottom: 16px;
        box-shadow: 0 8px 20px rgba(0, 229, 255, 0.3);
    }
    .gfc-title {
        color: #FFFFFF;
        font-weight: 800;
        font-size: 1.75rem;
        letter-spacing: -0.5px;
        margin-bottom: 8px;
    }
    .gfc-subtitle {
        color: #94A3B8;
        font-size: 0.9rem;
        line-height: 1.4;
        margin-bottom: 0;
    }
    .gfc-alert-error {
        background: rgba(239, 68, 68, 0.15);
        border: 1px solid rgba(239, 68, 68, 0.4);
        color: #FCA5A5;
        border-radius: 12px;
        padding: 12px 16px;
        font-size: 0.85rem;
        margin-bottom: 20px;
        display: flex;
        align-items: center;
    }
    .gfc-code-container {
        width: 100%;
    }
    .gfc-digit-inputs {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 4px;
        margin-bottom: 24px;
        width: 100%;
    }
    .gfc-digit-box {
        flex: 1 1 0;
        min-width: 0;
        max-width: 44px;
        height: 50px;
        background: #0B132B;
        border: 1.5px solid rgba(0, 229, 255, 0.3);
        border-radius: 10px;
        color: #00E5FF;
        font-size: 1.35rem;
        font-weight: 700;
        text-align: center;
        outline: none;
        padding: 0;
        transition: all 0.2s ease;
    }
    .gfc-digit-box:focus {
        border-color: #00E5FF;
        box-shadow: 0 0 15px rgba(0, 229, 255, 0.4);
        background: #0E1A3A;
    }
    .gfc-digit-separator {
        color: #64748B;
        font-size: 1.25rem;
        font-weight: 700;
        padding: 0 2px;
        flex-shrink: 0;
    }
    .gfc-btn-verify {
        width: 100%;
        background: linear-gradient(135deg, #00E5FF 0%, #00B4D8 100%);
        color: #070D1E;
        border: none;
        border-radius: 14px;
        padding: 16px;
        font-weight: 800;
        font-size: 1rem;
        letter-spacing: 0.5px;
        cursor: pointer;
        transition: transform 0.15s ease, box-shadow 0.2s ease;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 8px 25px rgba(0, 229, 255, 0.3);
    }
    .gfc-btn-verify:hover:not(:disabled) {
        transform: translateY(-2px);
        box-shadow: 0 12px 30px rgba(0, 229, 255, 0.45);
    }
    .gfc-btn-verify:active:not(:disabled) {
        transform: translateY(0);
    }
    .gfc-btn-verify:disabled {
        opacity: 0.6;
        cursor: not-allowed;
    }
    .gfc-steps-card {
        margin-top: 28px;
        background: #0B132B;
        border-radius: 16px;
        padding: 16px;
        border: 1px solid rgba(255, 255, 255, 0.05);
        display: flex;
        flex-direction: column;
        gap: 12px;
    }
    .gfc-step-item {
        display: flex;
        align-items: center;
        gap: 12px;
    }
    .gfc-step-number {
        width: 22px;
        height: 22px;
        background: rgba(0, 229, 255, 0.15);
        color: #00E5FF;
        border-radius: 50%;
        font-size: 0.75rem;
        font-weight: 700;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }
    .gfc-step-icon {
        color: #94A3B8;
        font-size: 1.1rem;
        flex-shrink: 0;
    }
    .gfc-step-text {
        display: flex;
        flex-direction: column;
    }
    .gfc-step-text strong {
        color: #E2E8F0;
        font-size: 0.85rem;
    }
    .gfc-step-text span {
        color: #64748B;
        font-size: 0.75rem;
    }
    .gfc-spinner {
        width: 48px;
        height: 48px;
        border: 4px solid rgba(0, 229, 255, 0.2);
        border-top-color: #00E5FF;
        border-radius: 50%;
        animation: gfc-spin 1s linear infinite;
        margin: 0 auto;
    }
    @@keyframes gfc-spin {
        to { transform: rotate(360deg); }
    }
    .gfc-success-state {
        text-align: center;
        padding: 10px 0;
    }
    .gfc-download-complete-badge {
        width: 64px;
        height: 64px;
        background: rgba(16, 185, 129, 0.15);
        color: #10B981;
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 2.2rem;
        box-shadow: 0 0 25px rgba(16, 185, 129, 0.25);
    }
    .gfc-install-guide {
        background: #0B132B;
        border-radius: 16px;
        padding: 16px;
        border: 1px solid rgba(255, 255, 255, 0.06);
    }
    .gfc-guide-step {
        display: flex;
        align-items: flex-start;
        gap: 12px;
    }
    .gfc-guide-num {
        width: 24px;
        height: 24px;
        background: linear-gradient(135deg, #00E5FF, #0077B6);
        color: #070D1E;
        font-weight: 800;
        border-radius: 50%;
        font-size: 0.75rem;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        margin-top: 2px;
    }
</style>

@code {
    [SupplyParameterFromQuery(Name = "code")]
    public string? QueryCode { get; set; }

    private string? _cleanCode;
    private string? _displayCode;
    private string? _errorMessage;

    protected override void OnInitialized()
    {
        if (!string.IsNullOrWhiteSpace(QueryCode))
        {
            var clean = QueryCode.Replace("-", "").Trim();
            if (clean.Length == 8)
            {
                _cleanCode = clean;
                _displayCode = $"{clean.Substring(0, 4)}-{clean.Substring(4, 8)}";
            }
        }
    }
}

