@page "/app"
@page "/download"
@using GFC.Core.Interfaces
@inject IDeviceTrustService DeviceTrustService
@inject NavigationManager NavManager
@inject IJSRuntime JS
@layout GFC.BlazorServer.Components.Layout.EmptyLayout

<PageTitle>GFC Connect - Download & Setup</PageTitle>

<div class="gfc-download-wrapper">
    <div class="gfc-download-card">
        <!-- Brand Header -->
        <div class="gfc-brand-header">
            <div class="gfc-logo-badge">
                <i class="bi bi-shield-lock-fill"></i>
            </div>
            <h1 class="gfc-title">GFC Connect</h1>
            <p class="gfc-subtitle">Enter the 8-digit setup code generated by your club administrator to verify your device and download the app.</p>
        </div>

        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <div class="gfc-alert-error">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                <span>@_errorMessage</span>
            </div>
        }

        @if (_isDownloading)
        {
            <div class="gfc-success-state">
                <div class="gfc-spinner"></div>
                <h3 class="mt-3 text-white fw-bold">Downloading GFC Connect APK...</h3>
                <p class="text-muted small">Your download should begin automatically. If it does not start, click below.</p>
                <a href="@_directDownloadUrl" class="btn btn-outline-info btn-sm mt-2 rounded-pill px-4">
                    <i class="bi bi-cloud-arrow-down-fill me-1"></i> Direct Download Link
                </a>
            </div>
        }
        else
        {
            <!-- 8-Digit Code Input Section (4 + 4) -->
            <div class="gfc-code-container">
                <div class="gfc-digit-inputs">
                    <input type="text" maxlength="1" @bind="_d1" @bind:event="oninput" @ref="_input1" class="gfc-digit-box" inputmode="numeric" />
                    <input type="text" maxlength="1" @bind="_d2" @bind:event="oninput" @ref="_input2" class="gfc-digit-box" inputmode="numeric" />
                    <input type="text" maxlength="1" @bind="_d3" @bind:event="oninput" @ref="_input3" class="gfc-digit-box" inputmode="numeric" />
                    <input type="text" maxlength="1" @bind="_d4" @bind:event="oninput" @ref="_input4" class="gfc-digit-box" inputmode="numeric" />
                    <span class="gfc-digit-separator">-</span>
                    <input type="text" maxlength="1" @bind="_d5" @bind:event="oninput" @ref="_input5" class="gfc-digit-box" inputmode="numeric" />
                    <input type="text" maxlength="1" @bind="_d6" @bind:event="oninput" @ref="_input6" class="gfc-digit-box" inputmode="numeric" />
                    <input type="text" maxlength="1" @bind="_d7" @bind:event="oninput" @ref="_input7" class="gfc-digit-box" inputmode="numeric" />
                    <input type="text" maxlength="1" @bind="_d8" @bind:event="oninput" @ref="_input8" class="gfc-digit-box" inputmode="numeric" />
                </div>

                <button class="gfc-btn-verify" @onclick="VerifyAndDownload" disabled="@_isVerifying">
                    @if (_isVerifying)
                    {
                        <span class="spinner-border spinner-border-sm me-2"></span>
                        <span>VERIFYING CODE...</span>
                    }
                    else
                    {
                        <i class="bi bi-shield-check me-2"></i>
                        <span>VERIFY & DOWNLOAD APK</span>
                    }
                </button>
            </div>
        }

        <!-- 3 Quick Start Steps -->
        <div class="gfc-steps-card">
            <div class="gfc-step-item">
                <div class="gfc-step-number">1</div>
                <div class="gfc-step-icon"><i class="bi bi-key-fill"></i></div>
                <div class="gfc-step-text">
                    <strong>Enter Setup Code</strong>
                    <span>Validate your device authorization</span>
                </div>
            </div>
            <div class="gfc-step-item">
                <div class="gfc-step-number">2</div>
                <div class="gfc-step-icon"><i class="bi bi-android2"></i></div>
                <div class="gfc-step-text">
                    <strong>Download & Install</strong>
                    <span>Allow one-time unknown sources prompt</span>
                </div>
            </div>
            <div class="gfc-step-item">
                <div class="gfc-step-number">3</div>
                <div class="gfc-step-icon"><i class="bi bi-fingerprint"></i></div>
                <div class="gfc-step-text">
                    <strong>Biometric Sign-In</strong>
                    <span>Touch fingerprint sensor to activate</span>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .gfc-download-wrapper {
        min-height: 100vh;
        background: linear-gradient(135deg, #070D1E 0%, #0F1D38 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 20px;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    }
    .gfc-download-card {
        background: #111C35;
        border: 1px solid rgba(0, 229, 255, 0.2);
        border-radius: 24px;
        max-width: 460px;
        width: 100%;
        padding: 32px 24px;
        box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5), 0 0 30px rgba(0, 229, 255, 0.08);
    }
    .gfc-brand-header {
        text-align: center;
        margin-bottom: 28px;
    }
    .gfc-logo-badge {
        width: 60px;
        height: 60px;
        background: linear-gradient(135deg, #00E5FF, #0077B6);
        border-radius: 18px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: #070D1E;
        font-size: 28px;
        margin-bottom: 16px;
        box-shadow: 0 8px 20px rgba(0, 229, 255, 0.3);
    }
    .gfc-title {
        color: #FFFFFF;
        font-weight: 800;
        font-size: 1.75rem;
        letter-spacing: -0.5px;
        margin-bottom: 8px;
    }
    .gfc-subtitle {
        color: #94A3B8;
        font-size: 0.9rem;
        line-height: 1.4;
        margin-bottom: 0;
    }
    .gfc-alert-error {
        background: rgba(239, 68, 68, 0.15);
        border: 1px solid rgba(239, 68, 68, 0.4);
        color: #FCA5A5;
        border-radius: 12px;
        padding: 12px 16px;
        font-size: 0.85rem;
        margin-bottom: 20px;
        display: flex;
        align-items: center;
    }
    .gfc-digit-inputs {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        margin-bottom: 24px;
    }
    .gfc-digit-box {
        width: 44px;
        height: 54px;
        background: #0B132B;
        border: 1.5px solid rgba(0, 229, 255, 0.3);
        border-radius: 12px;
        color: #00E5FF;
        font-size: 1.5rem;
        font-weight: 700;
        text-align: center;
        outline: none;
        transition: all 0.2s ease;
    }
    .gfc-digit-box:focus {
        border-color: #00E5FF;
        box-shadow: 0 0 15px rgba(0, 229, 255, 0.4);
        background: #0E1A3A;
    }
    .gfc-digit-separator {
        color: #64748B;
        font-size: 1.5rem;
        font-weight: 700;
    }
    .gfc-btn-verify {
        width: 100%;
        background: linear-gradient(135deg, #00E5FF 0%, #00B4D8 100%);
        color: #070D1E;
        border: none;
        border-radius: 14px;
        padding: 16px;
        font-weight: 800;
        font-size: 1rem;
        letter-spacing: 0.5px;
        cursor: pointer;
        transition: transform 0.15s ease, box-shadow 0.2s ease;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 8px 25px rgba(0, 229, 255, 0.3);
    }
    .gfc-btn-verify:hover:not(:disabled) {
        transform: translateY(-2px);
        box-shadow: 0 12px 30px rgba(0, 229, 255, 0.45);
    }
    .gfc-btn-verify:active:not(:disabled) {
        transform: translateY(0);
    }
    .gfc-btn-verify:disabled {
        opacity: 0.6;
        cursor: not-allowed;
    }
    .gfc-steps-card {
        margin-top: 28px;
        background: #0B132B;
        border-radius: 16px;
        padding: 16px;
        border: 1px solid rgba(255, 255, 255, 0.05);
        display: flex;
        flex-direction: column;
        gap: 12px;
    }
    .gfc-step-item {
        display: flex;
        align-items: center;
        gap: 12px;
    }
    .gfc-step-number {
        width: 22px;
        height: 22px;
        background: rgba(0, 229, 255, 0.15);
        color: #00E5FF;
        border-radius: 50%;
        font-size: 0.75rem;
        font-weight: 700;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }
    .gfc-step-icon {
        color: #94A3B8;
        font-size: 1.1rem;
        flex-shrink: 0;
    }
    .gfc-step-text {
        display: flex;
        flex-direction: column;
    }
    .gfc-step-text strong {
        color: #E2E8F0;
        font-size: 0.85rem;
    }
    .gfc-step-text span {
        color: #64748B;
        font-size: 0.75rem;
    }
    .gfc-spinner {
        width: 48px;
        height: 48px;
        border: 4px solid rgba(0, 229, 255, 0.2);
        border-top-color: #00E5FF;
        border-radius: 50%;
        animation: gfc-spin 1s linear infinite;
        margin: 0 auto;
    }
    @@keyframes gfc-spin {
        to { transform: rotate(360deg); }
    }
    .gfc-success-state {
        text-align: center;
        padding: 20px 0;
    }
</style>

@code {
    [SupplyParameterFromQuery(Name = "code")]
    public string? QueryCode { get; set; }

    private string _d1 = "", _d2 = "", _d3 = "", _d4 = "", _d5 = "", _d6 = "", _d7 = "", _d8 = "";
    private ElementReference _input1, _input2, _input3, _input4, _input5, _input6, _input7, _input8;
    private string? _errorMessage;
    private bool _isVerifying;
    private bool _isDownloading;
    private string _directDownloadUrl = "";

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrEmpty(QueryCode))
        {
            var clean = QueryCode.Replace("-", "").Trim();
            if (clean.Length == 8)
            {
                _d1 = clean[0].ToString();
                _d2 = clean[1].ToString();
                _d3 = clean[2].ToString();
                _d4 = clean[3].ToString();
                _d5 = clean[4].ToString();
                _d6 = clean[5].ToString();
                _d7 = clean[6].ToString();
                _d8 = clean[7].ToString();

                // Auto-verify if code passed in URL
                await VerifyAndDownload();
            }
        }
    }

    private async Task VerifyAndDownload()
    {
        _errorMessage = null;
        var fullCode = $"{_d1}{_d2}{_d3}{_d4}-{_d5}{_d6}{_d7}{_d8}".Trim();
        var cleanCode = fullCode.Replace("-", "").Trim();

        if (cleanCode.Length != 8)
        {
            _errorMessage = "Please enter all 8 digits of your setup code.";
            return;
        }

        _isVerifying = true;
        try
        {
            var token = await DeviceTrustService.ValidateSetupCodeAsync(fullCode);
            if (string.IsNullOrEmpty(token))
            {
                _errorMessage = "Invalid or expired setup code. Please request a new code from an administrator.";
                _isVerifying = false;
                return;
            }

            // Success: Device trusted! Trigger authenticated download stream
            _isDownloading = true;
            _directDownloadUrl = $"/api/app/download/latest.apk?token={Uri.EscapeDataString(token)}";

            // Trigger download via JavaScript navigation
            await JS.InvokeVoidAsync("window.location.assign", _directDownloadUrl);
        }
        catch (Exception ex)
        {
            _errorMessage = "An unexpected error occurred while verifying the code.";
        }
        finally
        {
            _isVerifying = false;
        }
    }
}
