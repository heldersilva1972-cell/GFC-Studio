        mappedModifiers.Remove(mod);
        selectedCategory.ModifiersJson = global::System.Text.Json.JsonSerializer.Serialize(mappedModifiers);
        using var db = await DbFactory.CreateDbContextAsync();
        var cat = await db.PosCategories.FindAsync(selectedCategory.Id);
        if (cat != null)
        {
            cat.ModifiersJson = selectedCategory.ModifiersJson;
            await db.SaveChangesAsync();
            await ToastService.ShowSuccess("Modifier removed");
        }
        await ReloadItems();
    }

    private async Task LoadAllItems()
    {
        using var db = await DbFactory.CreateDbContextAsync();
        allItemsForTokens = await db.LiquorItems.Where(i => i.IsActive && (!i.ParentItemId.HasValue || i.ShowInPos)).OrderBy(i => i.Name).ToListAsync();
    }

    private async Task ToggleShowArchived(ChangeEventArgs e)
    {
        if (e.Value is bool val)
        {
            showArchived = val;
            await ReloadItems(silent: true);
        }
    }

    private async Task UpdateModifierName(PosModifierDto mod, object? val)
    {
        if (val == null || selectedCategory == null) return;
        var name = val.ToString()?.Trim() ?? string.Empty;
        if (!string.IsNullOrEmpty(name))
        {
            mod.Name = name;
            selectedCategory.ModifiersJson = global::System.Text.Json.JsonSerializer.Serialize(mappedModifiers);
            using var db = await DbFactory.CreateDbContextAsync();
            var cat = await db.PosCategories.FindAsync(selectedCategory.Id);
            if (cat != null)
            {
                cat.ModifiersJson = selectedCategory.ModifiersJson;
                await db.SaveChangesAsync();
                await ToastService.ShowSuccess("Modifier name updated");
            }
        }
    }

    private string GetEventDisplayName(string name)
    {
        if (string.IsNullOrEmpty(name)) return "";
        if (name.EndsWith(" [Direct]")) return name.Substring(0, name.Length - 9);
        if (name.EndsWith("[Direct]")) return name.Substring(0, name.Length - 8);
        return name;
    }

    private async Task LoadProfiles()
    {
        using var db = await DbFactory.CreateDbContextAsync();
        profiles = await db.PosMenuProfiles.Where(p => !p.IsDeleted).OrderBy(p => p.Name).ToListAsync();
        terminals = await db.PosTerminals.Where(t => !t.IsDeleted).OrderBy(t => t.TerminalName).ToListAsync();
    }

    private async Task SelectProfilesTab()
    {
        selectedCategory = null;
        showUncategorized = false;
        showTokensTab = false;
        showPayoutTab = false;
        showEventsTab = false;
        showProfilesTab = true;
