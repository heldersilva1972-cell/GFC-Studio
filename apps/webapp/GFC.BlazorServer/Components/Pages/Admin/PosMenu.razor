    private bool IsItemEligible(int itemId)
    {
        if (editingToken == null || string.IsNullOrEmpty(editingToken.EligibleItemIds)) return false;
        var ids = editingToken.EligibleItemIds.Split(',', StringSplitOptions.RemoveEmptyEntries);
        return ids.Contains(itemId.ToString());
    }

    private void ToggleItemEligibility(int itemId, object? val)
    {
        if (editingToken == null) return;
        var ids = string.IsNullOrEmpty(editingToken.EligibleItemIds) 
            ? new List<string>() 
            : editingToken.EligibleItemIds.Split(',', StringSplitOptions.RemoveEmptyEntries).ToList();

        if (val is bool isChecked)
        {
            if (isChecked && !ids.Contains(itemId.ToString())) ids.Add(itemId.ToString());
            else if (!isChecked) ids.Remove(itemId.ToString());
        }

        editingToken.EligibleItemIds = string.Join(",", ids);
    }

    private bool IsCategoryEligible(string catName)
    {
        if (editingToken == null || string.IsNullOrEmpty(editingToken.CreditEligibleCategories)) return false;
        var cats = editingToken.CreditEligibleCategories.Split(',', StringSplitOptions.RemoveEmptyEntries);
        return cats.Contains(catName.Trim().ToUpper());
    }

    private void ToggleCategoryEligibility(string catName, object? val)
    {
