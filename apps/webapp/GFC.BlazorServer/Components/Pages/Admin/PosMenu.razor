        var cats = string.IsNullOrEmpty(editingToken.CreditEligibleCategories) 
            ? new List<string>() 
            : editingToken.CreditEligibleCategories.Split(',', StringSplitOptions.RemoveEmptyEntries).ToList();

        var upperCat = catName.Trim().ToUpper();
        if (val is bool isChecked)
        {
            if (isChecked && !cats.Contains(upperCat)) cats.Add(upperCat);
            else if (!isChecked) cats.Remove(upperCat);
        }

        editingToken.CreditEligibleCategories = string.Join(",", cats);
    }

    private async Task SaveToken()
    {
        if (editingToken == null) return;
        try
        {
            if (!editingToken.AllowCreditUpgrade.GetValueOrDefault())
            {
                editingToken.UpgradesFromTokenId = null;
            }

            using var db = await DbFactory.CreateDbContextAsync();
            if (editingToken.Id == 0)
            {
                db.PosTokens.Add(editingToken);
                await ToastService.ShowSuccess("Token created.");
            }
            else
            {
                var original = await db.PosTokens.FindAsync(editingToken.Id);
                if (original != null)
                {
                    original.Name = editingToken.Name;
                    original.SalePrice = editingToken.SalePrice;
                    original.ColorHex = editingToken.ColorHex;
                    original.EligibleItemIds = editingToken.EligibleItemIds;
                    original.AllowCreditUpgrade = editingToken.AllowCreditUpgrade;
                    original.CreditValue = editingToken.CreditValue;
                    original.CreditEligibleCategories = editingToken.CreditEligibleCategories;
                    original.UpgradesFromTokenId = editingToken.UpgradesFromTokenId;
                }
            }
            await db.SaveChangesAsync();
            editingToken = null;
            await LoadTokens();
        }
        catch (Exception ex)
        {
            await ToastService.ShowError($"Error saving token: {ex.Message}");
        }
    }

