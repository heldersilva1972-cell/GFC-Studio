@code {
    private List<PosCategory>? categories;
    private PosCategory? selectedCategory;
    private List<LiquorItem>? categoryItems;
    private bool isLoadingItems = false;
    private bool showUncategorized = false;
    private bool showTokensTab = false;
    private int uncategorizedCount = 0;
    private string searchQuery = "";
    private bool showArchived = false;

    private bool showProfilesTab = false;
    private List<PosMenuProfile>? profiles;
    private List<PosTerminal>? terminals;
    private PosMenuProfile? editingProfile;
    private int selectedProfileId = -1;
    private Dictionary<int, PosMenuOverride> overrideMap = new();

    private bool showAddCatModal = false;
    private string newCategoryName = "";
    private int newCategoryOrder = 0;
    private bool newCategoryIsModifier = false;
    private int newCategoryInventoryType = 0;

    private bool showEventsTab = false;
    private List<EventTemplate>? eventTemplates;
    private List<ActiveEvent>? activeEvents;
    private EventTemplate? editingEventTemplate;
    private ActiveEvent? creatingActiveEvent;
    private bool _newEventDirectCheckout = false;
    private bool _templateDirectCheckout = false;
    private List<BanquetOverrideDto> editingEventOverrides = new();
    private string selectedOverrideCategory = "BEER";
    private string activeEventTemplateTab = "general";

    private bool showPayoutTab = false;
    private List<string> payoutCategories = new();
    private string newPayoutCategory = "";

    private LiquorItem? editingItem;
    private bool showFullInventoryDetails = false;
    private List<LiquorVendor> vendors = new();
    private SystemSettings? systemSettings;

    private bool sellByGlass;
    private decimal glassPrice;
    private decimal glassPourSize = 5.0m;
    private bool sellByBottle;
    private decimal bottlePrice;
    private int bottleVolumeMl = 750;

    protected override async Task OnInitializedAsync()
    {
        await LoadProfiles();
        await LoadPayoutCategories();
        await LoadVendors();
        try
        {
            systemSettings = await SystemSettingsService.GetAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[POS Menu Manager] Failed to load system settings: {ex.Message}");
        }
    }

    private async Task LoadVendors()
    {
        try
        {
            using var db = await DbFactory.CreateDbContextAsync();
            vendors = await db.LiquorVendors.OrderBy(v => v.Name).ToListAsync();
        }
        catch (Exception ex)
        {
            await ToastService.ShowError($"Failed to load vendors: {ex.Message}");
        }
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/"); 
    }

    private Dictionary<string, int> categoryWarnings = new();

    private async Task LoadCategories()
    {
        using var db = await DbFactory.CreateDbContextAsync();
        if (selectedProfileId > 0)
        {
            categories = await db.PosCategories
                .Where(c => c.IsActive && (c.MenuProfileId == null || c.MenuProfileId == selectedProfileId))
                .OrderBy(c => c.DisplayOrder)
                .ToListAsync();
        }
        else
        {
            categories = await db.PosCategories
                .Where(c => c.IsActive && c.MenuProfileId == null)
                .OrderBy(c => c.DisplayOrder)
                .ToListAsync();
        }
        
        // Count items that don't match any of our organized categories
        var allManaged = await db.LiquorItems.Where(i => i.IsActive || i.ShowInPos).ToListAsync();
        var catNames = categories.Select(c => c.Name.Trim().ToUpper()).ToList();
        
        uncategorizedCount = allManaged
            .Count(i => i.IsActive && (string.IsNullOrWhiteSpace(i.Category) || !catNames.Contains(i.Category.Trim().ToUpper())));

        // Track inconsistencies: IsActive=false but ShowInPos=true
        categoryWarnings = categories.ToDictionary(
            c => c.Name.Trim().ToUpper(),
            c => allManaged.Count(i => !i.IsActive && i.ShowInPos && i.Category?.Trim().ToUpper() == c.Name.Trim().ToUpper())
        );
    }

