    private ActiveEvent? inlineTallyEvent;
    private string? inlineTallyMode;
    private List<BeerTallyItem> currentTallies = new();
    private int selectedBeerIdToAdd;

    public class BeerTallyItem
    {
        public int ItemId { get; set; }
        public string Name { get; set; } = string.Empty;
        public decimal Price { get; set; }
        public int QuantityTaken { get; set; }
        public int QuantityReturned { get; set; }
        public int Consumed => Math.Max(0, QuantityTaken - QuantityReturned);
        public decimal Subtotal => Consumed * Price;
    }

    private List<BeerTallyItem> GetActiveEventTallies(ActiveEvent ae)
    {
        if (string.IsNullOrEmpty(ae.BeerTalliesJson)) return new List<BeerTallyItem>();
        try
        {
            return global::System.Text.Json.JsonSerializer.Deserialize<List<BeerTallyItem>>(
                ae.BeerTalliesJson,
                new global::System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true }
            ) ?? new();
        }
        catch
        {
            return new List<BeerTallyItem>();
        }
    }

    private bool HasRemovedBeers(ActiveEvent ae)
    {
        var tallies = GetActiveEventTallies(ae);
        return tallies.Any(t => t.QuantityTaken > 0);
    }

    private decimal CalculateRemovedValue(ActiveEvent ae)
    {
        var tallies = GetActiveEventTallies(ae);
        return tallies.Sum(t => t.QuantityTaken * t.Price);
    }

    private decimal CalculateConsumedValue(ActiveEvent ae)
    {
        var tallies = GetActiveEventTallies(ae);
        return tallies.Sum(t => t.Consumed * t.Price);
    }

    private void StartInlineTallyEdit(ActiveEvent ae, string mode)
    {
        inlineTallyEvent = ae;
        inlineTallyMode = mode;
        currentTallies = new List<BeerTallyItem>();
        selectedBeerIdToAdd = 0;

        // Load existing tallies if any
        if (!string.IsNullOrEmpty(ae.BeerTalliesJson))
        {
            try
            {
                currentTallies = global::System.Text.Json.JsonSerializer.Deserialize<List<BeerTallyItem>>(
                    ae.BeerTalliesJson, 
                    new global::System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true }
                ) ?? new();
            }
            catch (Exception)
            {
                currentTallies = new();
            }
        }

        // Merge with template override items (beers only)
        var templateOverrides = new List<BanquetOverrideDto>();
        if (ae.Template != null && !string.IsNullOrEmpty(ae.Template.ItemsOverrideJson))
        {
            try
            {
                templateOverrides = global::System.Text.Json.JsonSerializer.Deserialize<List<BanquetOverrideDto>>(
                    ae.Template.ItemsOverrideJson,
                    new global::System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true }
                ) ?? new();
            }
            catch (Exception) { }
        }

        var overrideBeerIds = new HashSet<int>();
        foreach (var ov in templateOverrides.Where(o => o.TrackTally))
        {
            var liquorItem = allItemsForTokens?.FirstOrDefault(i => i.Id == ov.ItemId);
            if (liquorItem != null && liquorItem.IsBeer)
            {
                overrideBeerIds.Add(ov.ItemId);
                if (!currentTallies.Any(t => t.ItemId == ov.ItemId))
                {
                    currentTallies.Add(new BeerTallyItem
                    {
                        ItemId = ov.ItemId,
                        Name = liquorItem.Name,
                        Price = ov.OverridePrice,
                        QuantityTaken = 0,
                        QuantityReturned = 0
                    });
                }
            }
        }

        // Fallback: If no existing tallies and no overrides configured at all, populate with default beers
        if (!currentTallies.Any() && !templateOverrides.Any() && allItemsForTokens != null)
        {
            foreach (var item in allItemsForTokens.Where(i => i.IsBeer))
            {
                if (!currentTallies.Any(t => t.ItemId == item.Id))
                {
                    currentTallies.Add(new BeerTallyItem
                    {
                        ItemId = item.Id,
                        Name = item.Name,
                        Price = item.CurrentPrice > 0 ? item.CurrentPrice : item.RetailPrice,
                        QuantityTaken = 0,
                        QuantityReturned = 0
                    });
                }
            }
        }
    }

    private void CloseInlineTallyModal()
    {
        inlineTallyEvent = null;
        inlineTallyMode = null;
        currentTallies = new List<BeerTallyItem>();
    }

    private void AddBeerToTallySheet()
    {
        if (selectedBeerIdToAdd == 0 || allItemsForTokens == null) return;

        var liquorItem = allItemsForTokens.FirstOrDefault(i => i.Id == selectedBeerIdToAdd);
        if (liquorItem != null)
        {
            if (!currentTallies.Any(t => t.ItemId == liquorItem.Id))
            {
                currentTallies.Add(new BeerTallyItem
                {
                    ItemId = liquorItem.Id,
                    Name = liquorItem.Name,
                    Price = liquorItem.CurrentPrice > 0 ? liquorItem.CurrentPrice : liquorItem.RetailPrice,
                    QuantityTaken = 0,
                    QuantityReturned = 0
                });
            }
        }
        selectedBeerIdToAdd = 0; // reset
    }

    private void RemoveBeerFromTallySheet(BeerTallyItem t)
    {
        currentTallies.Remove(t);
    }

    private async Task SaveInlineTally(bool closeEvent)
    {
        if (inlineTallyEvent == null) return;

        // Perform sanity check: Returned cannot exceed Taken
        foreach (var t in currentTallies)
        {
            if (t.QuantityReturned > t.QuantityTaken)
            {
                await ToastService.ShowError($"For {t.Name}, quantity returned ({t.QuantityReturned}) cannot exceed quantity taken ({t.QuantityTaken}).");
                return;
            }
        }

        try
        {
            using var db = await DbFactory.CreateDbContextAsync();
            var orig = await db.ActiveEvents.FindAsync(inlineTallyEvent.Id);
            if (orig != null)
            {
                // Serialize tallies
                orig.BeerTalliesJson = global::System.Text.Json.JsonSerializer.Serialize(currentTallies);
                
                // Update InitialAmount (preloaded money)
                orig.InitialAmount = inlineTallyEvent.InitialAmount;

                // Calculate total consumed cost
                decimal totalConsumedCost = currentTallies.Sum(t => t.Subtotal);

                // Update CurrentBalance based on prepaid vs running tab
                if (orig.Type == EventTabType.PrePaid)
                {
                    orig.CurrentBalance = orig.InitialAmount - totalConsumedCost;
                }
                else
                {
                    orig.CurrentBalance = -totalConsumedCost;
                }

                if (closeEvent)
                {
                    orig.Status = EventTabStatus.Closed;
                }

                await db.SaveChangesAsync();
                
                if (closeEvent)
                {
                    await ToastService.ShowSuccess("Event settled and closed successfully!");
                    CloseInlineTallyModal();
                }
                else
                {
                    await ToastService.ShowSuccess("Beer tallies saved successfully!");
                    CloseInlineTallyModal();
                }
                
                await LoadEvents();
            }
        }
        catch (Exception ex)
        {
            await ToastService.ShowError(ex.Message);
        }
    }

