@page "/admin/pos-menu"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

<PageTitle>POS Menu Manager | GFC</PageTitle>

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-0 fw-bold">POS Menu Manager</h1>
            <p class="text-muted">Manage liquor prices, categories, and fast-tap buttons.</p>
        </div>
        <button class="btn btn-primary rounded-pill px-4 shadow-sm" disabled>
            <i class="bi bi-plus-lg me-2"></i> Add New Category
        </button>
    </div>

    <div class="row">
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 mb-4 p-4 text-center text-muted">
                <i class="bi bi-list-columns-reverse fs-2 mb-2"></i>
                <h5 class="fw-bold text-dark">No Menu Created Yet</h5>
                <p class="small">Start adding items to your bar menu to see them in the POS terminal.</p>
            </div>
        </div>
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 p-5 text-center bg-white h-100">
                <div class="py-5">
                    <i class="bi bi-grid-3x3-gap fs-1 text-primary opacity-25 mb-3 d-block"></i>
                    <h4 class="fw-bold">No Items Drafted</h4>
                    <p class="text-muted">Once categories are added, they'll appear here for button layout.</p>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .rounded-4 { border-radius: 1rem !important; }
</style>
