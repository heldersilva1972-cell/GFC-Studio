    private void OpenAddProfileModal()
    {
        editingProfile = new PosMenuProfile { Name = "" };
    }

    private void OpenEditProfileModal(PosMenuProfile p)
    {
        editingProfile = new PosMenuProfile { Id = p.Id, Name = p.Name };
    }

    private async Task SaveProfile()
    {
        if (editingProfile == null || string.IsNullOrWhiteSpace(editingProfile.Name)) return;
        try
        {
            using var db = await DbFactory.CreateDbContextAsync();
            if (editingProfile.Id == 0)
            {
                db.PosMenuProfiles.Add(editingProfile);
                await ToastService.ShowSuccess("Profile created successfully.");
            }
            else
            {
                var orig = await db.PosMenuProfiles.FindAsync(editingProfile.Id);
                if (orig != null)
                {
                    orig.Name = editingProfile.Name;
                    await ToastService.ShowSuccess("Profile name updated.");
                }
            }
            await db.SaveChangesAsync();
            editingProfile = null;
            await LoadProfiles();
        }
        catch (Exception ex)
        {
            await ToastService.ShowError($"Error saving profile: {ex.Message}");
        }
    }

    private async Task DeleteProfile(PosMenuProfile p)
    {
        try
        {
            using var db = await DbFactory.CreateDbContextAsync();
            var orig = await db.PosMenuProfiles.FindAsync(p.Id);
            if (orig != null)
            {
                orig.IsDeleted = true;
                await db.SaveChangesAsync();
                await ToastService.ShowSuccess("Profile deleted.");
                await LoadProfiles();
            }
        }
        catch (Exception ex)
        {
            await ToastService.ShowError($"Error: {ex.Message}");
        }
    }

    private async Task DeleteTerminal(PosTerminal t)
    {
        try
        {
            using var db = await DbFactory.CreateDbContextAsync();
            var orig = await db.PosTerminals.FindAsync(t.Id);
            if (orig != null)
