    private async Task AssignProfileToTerminal(PosTerminal terminal, int profileId)
    {
        try
        {
            using var db = await DbFactory.CreateDbContextAsync();
            var orig = await db.PosTerminals.FindAsync(terminal.Id);
            if (orig != null)
            {
                orig.MenuProfileId = profileId > 0 ? profileId : null;
                await db.SaveChangesAsync();
                terminal.MenuProfileId = orig.MenuProfileId;
                await ToastService.ShowSuccess($"Profile assigned to terminal '{terminal.TerminalName}' successfully.");
                await LoadProfiles();
            }
        }
        catch (Exception ex)
        {
            await ToastService.ShowError($"Error assigning profile: {ex.Message}");
        }
    }

    private async Task OnProfileChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int profileId))
        {
            selectedProfileId = profileId;
            if (selectedProfileId >= 0)
            {
                await LoadCategories();
                await LoadAllItems();
                if (categories != null && categories.Any())
                {
                    await SelectCategory(categories.First());
                }
                else
                {
                    selectedCategory = null;
                }
            }
            else
            {
                categories = null;
                selectedCategory = null;
                categoryItems = null;
            }
        }
    }

    private async Task UpdateItemOverridePrice(LiquorItem item, object? val)
    {
        if (selectedProfileId <= 0) return;
        try {
            using var db = await DbFactory.CreateDbContextAsync();
            var o = await db.PosMenuOverrides.FirstOrDefaultAsync(x => x.MenuProfileId == selectedProfileId && x.LiquorItemId == item.Id);
            
            if (val == null || string.IsNullOrWhiteSpace(val.ToString()) || !decimal.TryParse(val.ToString(), out var newPrice) || newPrice <= 0)
            {
                if (o != null)
                {
                    db.PosMenuOverrides.Remove(o);
                    await db.SaveChangesAsync();
                    await ToastService.ShowSuccess($"Cleared price override for {item.Name}");
                }
            }
            else
            {
                if (o == null)
                {
                    o = new PosMenuOverride
                    {
                        MenuProfileId = selectedProfileId,
                        LiquorItemId = item.Id,
                        OverridePrice = newPrice
                    };
                    db.PosMenuOverrides.Add(o);
                }
                else
                {
                    o.OverridePrice = newPrice;
                }
                await db.SaveChangesAsync();
                await ToastService.ShowSuccess($"Price overridden for {item.Name} to {newPrice:C}");
            }
            await ReloadItems(silent: true);
        } catch (Exception ex) {
            await ToastService.ShowError($"Error: {ex.Message}");
        }
    }
}
