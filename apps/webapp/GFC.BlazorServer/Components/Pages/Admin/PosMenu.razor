@page "/admin/pos-menu"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using GFC.BlazorServer.Data
@using GFC.Core.Models
@using GFC.Core.Enums
@attribute [Authorize]
@inject Microsoft.EntityFrameworkCore.IDbContextFactory<GFC.BlazorServer.Data.GfcDbContext> DbFactory
@inject GFC.BlazorServer.Services.IToastService ToastService
@inject NavigationManager Navigation

<PageTitle>POS Menu Manager | GFC</PageTitle>

<div class="container-fluid py-2 d-flex flex-column pos-menu-wrapper overflow-hidden">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div class="d-flex align-items-center">
            <button class="btn btn-light rounded-circle me-3 shadow-sm border" @onclick="GoBack" title="Go Back">
                <i class="bi bi-chevron-left fs-5"></i>
            </button>
            <div>
                <h1 class="h3 mb-0 fw-bold">POS Menu Manager</h1>
                <p class="text-muted mb-0">Manage liquor prices, categories, and fast-tap buttons.</p>
            </div>
        </div>
        <button class="btn btn-primary rounded-pill px-4 shadow-sm" @onclick="OpenAddCategoryModal">
            <i class="bi bi-plus-lg me-2"></i> Add New Category
        </button>
    </div>

    <div class="row flex-grow-1 min-height-0 overflow-hidden">
        <div class="col-lg-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 overflow-hidden bg-white">
                <div class="card-header bg-light border-0 py-3 flex-shrink-0">
                    <h6 class="fw-bold mb-0 text-muted small text-uppercase">Menu Categories</h6>
                </div>
                <div class="list-group list-group-flush flex-grow-1 overflow-y-auto scroll-area">
                    @if (categories == null)
                    {
                        <div class="text-center py-5"><div class="spinner-border spinner-border-sm text-primary"></div></div>
                    }
                    else
                    {
                        @foreach (var cat in categories.OrderBy(c => c.DisplayOrder))
                        {
                            <button class="list-group-item list-group-item-action border-0 py-3 @(selectedCategory?.Id == cat.Id && !showUncategorized ? "active" : "")" 
                                    @onclick="() => SelectCategory(cat)">
                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="fw-bold">@cat.Name</span>
                                    @if (categoryWarnings.TryGetValue(cat.Name.Trim().ToUpper(), out var warnCount) && warnCount > 0)
                                    {
                                        <span class="badge bg-warning text-dark rounded-pill extra-small ms-auto me-2">@warnCount INACTIVE</span>
                                    }
                                    <i class="bi bi-chevron-right small"></i>
                                </div>
                            </button>
                        }
                        
                        <div class="card-header bg-light border-0 py-2 mt-3">
                            <h6 class="fw-bold mb-0 text-muted extra-small text-uppercase">Maintenance</h6>
                        </div>
                        <button class="list-group-item list-group-item-action border-0 py-3 @(showUncategorized ? "bg-warning-subtle text-warning-emphasis fw-bold" : "")" 
                                @onclick="SelectUncategorized">
                            <div class="d-flex justify-content-between align-items-center">
                                <span><i class="bi bi-exclamation-triangle-fill me-2"></i> NEEDS CATEGORY</span>
                                @if (uncategorizedCount > 0)
                                {
                                    <span class="badge bg-danger rounded-pill">@uncategorizedCount</span>
                                }
                            </div>
                        </button>

                        <div class="card-header bg-light border-0 py-2 mt-3">
                            <h6 class="fw-bold mb-0 text-muted extra-small text-uppercase">Automation</h6>
                        </div>
                        <button class="list-group-item list-group-item-action border-0 py-3 @(showTokensTab ? "active" : "")" 
                                @onclick="SelectTokensTab">
                            <div class="d-flex justify-content-between align-items-center">
                                <span><i class="bi bi-ticket-perforated-fill me-2"></i> TOKEN MANAGER</span>
                                <i class="bi bi-chevron-right small"></i>
                            </div>
                        </button>

                        <div class="card-header bg-light border-0 py-2 mt-3">
                            <h6 class="fw-bold mb-0 text-muted extra-small text-uppercase">Events</h6>
                        </div>
                        <button class="list-group-item list-group-item-action border-0 py-3 @(showEventsTab ? "active" : "")" 
                                @onclick="SelectEventsTab">
                            <div class="d-flex justify-content-between align-items-center">
                                <span><i class="bi bi-calendar-event me-2"></i> BANQUETS & TABS</span>
                                <i class="bi bi-chevron-right small"></i>
                            </div>
                        </button>
                    }
                </div>
            </div>
        </div>
        <div class="col-lg-9 h-100">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white p-3 d-flex flex-column overflow-hidden">
                @if (showTokensTab)
                {
                    <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-4 flex-shrink-0">
                        <div>
                            <h2 class="fw-black mb-1">Token Manager</h2>
                            <p class="text-muted small mb-0">Define tokens and link them to eligible drinks.</p>
                        </div>
                        <button class="btn btn-primary rounded-pill px-4" @onclick="OpenAddTokenModal">
                            <i class="bi bi-plus-lg me-2"></i> Add New Token
                        </button>
                    </div>

                    <div class="flex-grow-1 overflow-y-auto pe-2 scroll-area">

                    @if (tokens == null)
                    {
                        <div class="text-center py-5"><div class="spinner-border text-primary"></div></div>
                    }
                    else if (!tokens.Any())
                    {
                        <div class="text-center py-5">
                            <i class="bi bi-ticket-perforated fs-1 text-muted opacity-25"></i>
                            <h5 class="mt-3">No Tokens Defined</h5>
                            <p class="text-muted">Create a token like "Beer Token" to start.</p>
                        </div>
                    }
                    else
                    {
                        <div class="row row-cols-1 row-cols-md-2 g-4">
                            @foreach (var token in tokens)
                            {
                                <div class="col">
                                    <div class="card h-100 border-2 rounded-4 p-3 @(token.IsActive ? "" : "opacity-50")" style="border-left: 8px solid @token.ColorHex;">
                                        <div class="d-flex justify-content-between align-items-start">
                                            <div>
                                                <h5 class="fw-bold mb-1">@token.Name</h5>
                                                <div class="badge bg-light text-dark border px-3 py-2 rounded-pill mb-2">
                                                    Sale Price: @token.SalePrice.ToString("C")
                                                </div>
                                                <p class="small text-muted mb-0">
                                                    @(string.IsNullOrEmpty(token.EligibleItemIds) ? "No drinks linked" : $"{token.EligibleItemIds.Split(',').Length} drinks linked")
                                                </p>
                                            </div>
                                            <div class="d-flex gap-2">
                                                <button class="btn btn-sm btn-light border rounded-pill" @onclick="() => OpenEditTokenModal(token)">Edit</button>
                                                <button class="btn btn-sm btn-outline-danger border rounded-pill" @onclick="() => DeleteToken(token)"><i class="bi bi-trash"></i></button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
            else if (showEventsTab)
            {
                <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-4 flex-shrink-0">
                    <div>
                        <h2 class="fw-black mb-1">Event & Tab Manager</h2>
                        <p class="text-muted small mb-0">Manage pre-paid banquets and running tabs.</p>
                    </div>
                    <button class="btn btn-primary rounded-pill px-4 shadow-sm" @onclick="OpenAddEventTemplateModal">
                        <i class="bi bi-plus-lg me-2"></i> New Event Template
                    </button>
                </div>

                <div class="flex-grow-1 overflow-y-auto pe-2 scroll-area">
                    <h5 class="fw-bold mb-3">Active Tabs (Running Now)</h5>
                    @if (activeEvents == null) { <div class="text-center py-4"><div class="spinner-border text-primary"></div></div> }
                    else if (!activeEvents.Any()) { <div class="text-muted small mb-4">No active events currently running.</div> }
                    else {
                        <div class="list-group mb-5">
                        @foreach(var ae in activeEvents) {
                            <div class="list-group-item p-4 border-2 rounded-4 mb-3 shadow-sm" style="border-left: 6px solid @(ae.Type == EventTabType.PrePaid ? "var(--bs-primary)" : "var(--bs-success)") !important;">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <h5 class="fw-bold mb-1">@ae.Name <span class="badge @(ae.Type == EventTabType.PrePaid ? "bg-primary" : "bg-success") ms-2">@ae.Type</span></h5>
                                        <p class="mb-0 small text-muted">Started: @ae.CreatedAt.ToLocalTime().ToString("g")</p>
                                    </div>
                                    <div class="text-end">
                                        <div class="small fw-bold text-muted text-uppercase mb-1">@(ae.Type == EventTabType.PrePaid ? "Remaining Balance" : "Current Tab")</div>
                                        <h4 class="fw-black mb-2 @(ae.CurrentBalance <= 0 && ae.Type == EventTabType.PrePaid ? "text-danger" : "text-dark")">
                                            @ae.CurrentBalance.ToString("C")
                                        </h4>
                                        <div class="d-flex gap-2 justify-content-end">
                                            @if(ae.Type == EventTabType.PrePaid) {
                                                <button class="btn btn-sm btn-success rounded-pill px-3 shadow-sm" @onclick="() => OpenAddFundsModal(ae)">Add Funds</button>
                                            }
                                            <button class="btn btn-sm btn-outline-danger rounded-pill px-3" @onclick="() => CloseActiveEvent(ae)">Close Tab</button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                        </div>
                    }

                    <div class="d-flex justify-content-between align-items-center mb-3 mt-4">
                        <h5 class="fw-bold mb-0">Saved Event Templates</h5>
                    </div>
                    @if (eventTemplates == null) { <div class="text-center py-4"><div class="spinner-border text-primary"></div></div> }
                    else if (!eventTemplates.Any()) { <div class="text-muted small">No templates saved.</div> }
                    else {
                        <div class="row row-cols-1 row-cols-md-2 g-3">
                        @foreach(var t in eventTemplates) {
                            <div class="col">
                                <div class="card h-100 border-2 rounded-4 p-3 bg-white">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <div>
                                            <h6 class="fw-bold mb-1">@t.Name</h6>
                                            <span class="badge bg-light text-dark border rounded-pill">Default: @t.DefaultType</span>
                                        </div>
                                        <div class="d-flex gap-2">
                                            <button class="btn btn-sm btn-light border rounded-circle" @onclick="() => OpenEditEventTemplateModal(t)"><i class="bi bi-pencil"></i></button>
                                            <button class="btn btn-sm btn-success rounded-circle text-white" title="Start Event" @onclick="() => OpenCreateActiveEventModal(t)"><i class="bi bi-play-fill"></i></button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                        </div>
                    }
                </div>
            }
            else if (selectedCategory == null)
                {
                    <div class="text-center py-5">
                        <i class="bi bi-grid-3x3-gap fs-1 text-primary opacity-25 mb-3 d-block"></i>
                        <h4 class="fw-bold">Select a Category</h4>
                        <p class="text-muted">Select a category on the left to manage its items and layout.</p>
                    </div>
                }
                else
                {
                    <div class="d-flex justify-content-between align-items-center mb-2 flex-shrink-0">
                        <div>
                            <h2 class="fw-black mb-0 text-uppercase">@selectedCategory.Name</h2>
                            <p class="text-muted small mb-0">Managing items and position for @selectedCategory.Name</p>
                        </div>
                        <div class="d-flex gap-2 align-items-center p-2 bg-light rounded-3 border">
                            <div style="width: 150px;">
                                <label class="small fw-bold text-muted mb-0" style="font-size: 0.65rem;">RENAME CATEGORY</label>
                                <input type="text" class="form-control form-control-sm" @bind="selectedCategory.Name" />
                            </div>
                            <div style="width: 80px;">
                                <label class="small fw-bold text-muted mb-0" style="font-size: 0.65rem;">TAB POS.</label>
                                <input type="number" class="form-control form-control-sm" @bind="selectedCategory.DisplayOrder" />
                            </div>
                            <div style="width: 150px;">
                                <label class="small fw-bold text-muted mb-0" style="font-size: 0.65rem;">MODIFIER CATEGORY?</label>
                                <div class="form-check form-switch mt-1 ms-2">
                                    <input class="form-check-input" type="checkbox" @bind="selectedCategory.IsModifierCategory" />
                                </div>
                            </div>
                            <button class="btn btn-sm btn-primary mt-3" @onclick="SaveCategoryChanges" title="Save Category Settings">
                                <i class="bi bi-save"></i>
                            </button>
                            <div class="vr mx-1 mt-3" style="height: 20px;"></div>
                            <button class="btn btn-sm btn-outline-danger mt-3" @onclick="DeleteCategory" title="Delete Category">
                                <i class="bi bi-trash"></i>
                            </button>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-2 flex-shrink-0">
                        @if (!isLoadingItems)
                        {
                            @if (selectedCategory.IsModifierCategory)
                            {
                                <button class="btn btn-primary rounded-pill px-4 fw-bold shadow-sm" @onclick="OpenAddModifierModal" style="background: #7c3aed; border-color: #7c3aed;">
                                    <i class="bi bi-plus-lg me-2"></i> DESIGNATE MAPPED MODIFIER FOR @selectedCategory.Name.ToUpper()
                                </button>
                            }
                            else if (categoryItems != null && categoryItems.Any())
                            {
                                <button class="btn btn-primary rounded-pill px-4 fw-bold shadow-sm" @onclick="OpenAddItemModal">
                                    <i class="bi bi-plus-lg me-2"></i> ADD NEW ITEM TO @selectedCategory.Name.ToUpper()
                                </button>
                            }
                        }
                        <div class="ms-auto d-flex gap-2 align-items-center">
                            @if (!string.IsNullOrWhiteSpace(searchQuery))
                            {
                                <span class="badge bg-light text-dark border px-3 py-2 rounded-pill">Showing matching items</span>
                            }
                        </div>
                    </div>

                    <div class="flex-grow-1 overflow-y-auto pe-2 scroll-area">
                        @if (isLoadingItems)
                        {
                            <div class="text-center py-5"><div class="spinner-border text-primary"></div></div>
                        }
                        else if (selectedCategory.IsModifierCategory)
                        {
                            @if (mappedModifiers == null || !mappedModifiers.Any())
                            {
                                <div class="text-center py-5">
                                    <i class="bi bi-plus-circle-dotted fs-1 text-muted opacity-25"></i>
                                    <h5 class="mt-3">No Mapped Modifiers Designated</h5>
                                    <p class="text-muted">Click the button above to select items from your existing inventory list as add-ons.</p>
                                </div>
                            }
                            else
                            {
                                <table class="table table-hover align-middle sticky-header">
                                    <thead class="table-light">
                                        <tr>
                                            <th class="py-3 px-4 text-muted small fw-bold text-uppercase">Item Name</th>
                                            <th class="py-3 px-4 text-muted small fw-bold text-uppercase text-center">Add-on Display Name</th>
                                            <th class="py-3 px-4 text-muted small fw-bold text-uppercase text-center" style="width: 150px;">Price Override</th>
                                            <th class="py-3 px-4 text-muted small fw-bold text-uppercase text-center" style="width: 150px;">Stock Deduction</th>
                                            <th class="text-end px-4">Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var mod in mappedModifiers)
                                        {
                                            var baseItem = allItemsForTokens?.FirstOrDefault(i => i.Id == mod.ItemId);
                                            <tr>
                                                <td class="py-2 px-4 fw-bold">@(baseItem?.Name ?? (mod.ItemId < 0 ? "CUSTOM NON-INVENTORY" : "UNKNOWN ITEM"))</td>
                                                <td class="py-2 px-4 text-center">
                                                    <input type="text" class="form-control form-control-sm fw-bold text-primary text-center mx-auto"
                                                           value="@mod.Name"
                                                           @onchange="@((e) => UpdateModifierName(mod, e.Value))"
                                                           style="max-width: 200px;" />
                                                </td>
                                                <td class="py-2 px-4">
                                                    <div class="input-group input-group-sm mx-auto" style="width: 110px;">
                                                        <span class="input-group-text">$</span>
                                                        <input type="number" step="0.01" class="form-control text-center fw-bold"
                                                               value="@mod.Price"
                                                               @onchange="@((e) => UpdateModifierPrice(mod, e.Value))" />
                                                    </div>
                                                </td>
                                                <td class="py-2 px-4">
                                                    @if (mod.ItemId > 0)
                                                    {
                                                        <div class="input-group input-group-sm mx-auto" style="width: 110px;">
                                                            <input type="number" step="0.1" class="form-control text-center fw-bold"
                                                                   value="@mod.PourSize"
                                                                   @onchange="@((e) => UpdateModifierPourSize(mod, e.Value))" />
                                                            <span class="input-group-text">@(baseItem?.IsUnitBased == true ? "btl" : "oz")</span>
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <div class="text-center text-muted small">N/A</div>
                                                    }
                                                </td>
                                                <td class="py-2 px-4 text-end">
                                                    <button class="btn btn-sm btn-outline-danger rounded-circle p-1 border-0" @onclick="() => RemoveModifierFromCategory(mod)">
                                                        <i class="bi bi-trash fs-5"></i>
                                                    </button>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            }
                        }
                        else if (categoryItems == null || !categoryItems.Any())
                        {
                            <div class="text-center py-5">
                                <i class="bi bi-box2-heart fs-1 text-muted opacity-25"></i>
                                <h5 class="mt-3">No Items Found</h5>
                                <p class="text-muted">Try using a different name or adding items for this category.</p>
                            </div>
                        }
                        else
                        {
                            <table class="table table-hover align-middle sticky-header">
                                    <thead class="table-light">
                                        <tr>
                                            <th class="py-3 px-4 text-muted small fw-bold text-uppercase" style="width: 100px;">Sort</th>
                                            <th class="py-3 px-4 text-muted small fw-bold text-uppercase">Name</th>
                                            <th class="py-3 px-4 text-muted small fw-bold text-uppercase text-center">Retail Price</th>
                                            <th class="py-3 px-4 text-muted small fw-bold text-uppercase text-center">Current Cat</th>
                                            <th class="py-3 px-4 text-muted small fw-bold text-uppercase text-center">Show in POS</th>
                                            <th class="text-end px-4">Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in categoryItems.OrderBy(i => i.DisplayOrder).ThenBy(i => i.Name).Where(i => string.IsNullOrWhiteSpace(searchQuery) || i.Name.Contains(searchQuery, StringComparison.OrdinalIgnoreCase)))
                                        {
                                             <tr class="@(!item.IsActive ? "bg-warning-subtle" : "")">
                                                <td class="py-2 px-4">
                                                    <input type="number" class="form-control form-control-sm text-center fw-bold" 
                                                           value="@item.DisplayOrder" 
                                                           @onchange="@((e) => UpdateItemOrder(item, e.Value))"
                                                           style="width: 60px; background: #f8fafc;" />
                                                </td>
                                                <td class="py-2 px-4 fw-bold">
                                                    @item.Name
                                                    @if (!item.IsActive)
                                                    {
                                                        <span class="badge bg-danger rounded-pill extra-small ms-2" style="font-size: 0.6rem;">INACTIVE IN HUB</span>
                                                    }
                                                </td>
                                                <td class="py-2 px-4 text-center">@item.RetailPrice.ToString("C")</td>
                                                <td class="py-2 px-4 text-center text-muted small">@item.Category</td>
                                                <td class="py-2 px-4 text-center">
                                                    <div class="form-check form-switch d-flex justify-content-center">
                                                        <input class="form-check-input" type="checkbox" checked="@item.ShowInPos" 
                                                               @onchange="(e) => ToggleShowInPos(item, e.Value)" />
                                                    </div>
                                                </td>
                                                <td class="py-2 px-4 text-end">
                                                    <button class="btn btn-sm btn-light border rounded-pill px-3" @onclick="() => OpenEditItemModal(item)">Edit</button>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                            </table>
                        }
                    </div>

                }
            </div>
        </div>
    </div>
</div>

@if (showAddModifierModal)
{
    <div class="modal fade show" tabindex="-1" style="display: block; background: rgba(0,0,0,0.5);" role="dialog">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg rounded-4">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold" style="color: #7c3aed;"><i class="bi bi-plus-circle-fill me-2"></i>Designate Add-on Modifier</h5>
                    <button type="button" class="btn-close" @onclick="() => showAddModifierModal = false"></button>
                </div>
                <div class="modal-body py-4">
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-muted text-uppercase">Select Existing Item</label>
                        <select class="form-select rounded-3 border-2" @onchange="@((e) => OnAddModifierItemChanged(int.Parse(e.Value?.ToString() ?? "0")))">
                            <option value="0">-- Select Inventory Product --</option>
                            <option value="-1" style="font-weight: bold; color: #7c3aed;">[+ CREATE CUSTOM ADD-ON (NON-INVENTORY) ]</option>
                            @if (allItemsForTokens != null)
                            {
                                @foreach (var item in allItemsForTokens.OrderBy(i => i.Name))
                                {
                                    <option value="@item.Id">@item.Name (@(item.Category ?? "Uncategorized"))</option>
                                }
                            }
                        </select>
                    </div>
                    @if (selectedModifierItemId != 0)
                    {
                        var selectedItemObj = selectedModifierItemId < 0 ? null : allItemsForTokens?.FirstOrDefault(i => i.Id == selectedModifierItemId);
                        <div class="mb-3">
                            <label class="form-label small fw-bold text-muted text-uppercase">Add-on Display Name</label>
                            <input type="text" class="form-control rounded-3" @bind="newModifierName" placeholder="e.g. Splash of Red Bull" />
                        </div>
                        <div class="row g-3">
                            <div class="col-6">
                                <label class="form-label small fw-bold text-muted text-uppercase">Add-on Price Override</label>
                                <div class="input-group">
                                    <span class="input-group-text">$</span>
                                    <input type="number" step="0.01" class="form-control" @bind="newModifierPrice" />
                                </div>
                            </div>
                            @if (selectedModifierItemId > 0)
                            {
                                <div class="col-6">
                                    <label class="form-label small fw-bold text-muted text-uppercase">Stock Deduction Qty</label>
                                    <div class="input-group">
                                        <input type="number" step="0.1" class="form-control" @bind="newModifierPourSize" />
                                        <span class="input-group-text">@(selectedItemObj?.IsUnitBased == true ? "btl" : "oz")</span>
                                    </div>
                                    <span class="extra-small text-muted d-block mt-1">Def: @(selectedItemObj?.IsUnitBased == true ? "1.0 btl" : $"{selectedItemObj?.PourSize} oz")</span>
                                </div>
                            }
                            else
                            {
                                <div class="col-6">
                                    <label class="form-label small fw-bold text-muted text-uppercase">Stock Tracking</label>
                                    <div class="form-control bg-light text-muted border-0 small">No stock link (Custom)</div>
                                </div>
                            }
                        </div>
                    }
                </div>
