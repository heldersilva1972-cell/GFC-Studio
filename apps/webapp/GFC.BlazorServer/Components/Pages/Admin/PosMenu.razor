    private async Task ReloadItems(bool silent = false)
    {
        showTokensTab = false;
        showEventsTab = false;
        showPayoutTab = false;
        showProfilesTab = false;
        if (selectedCategory == null) return;
        
        if (!silent)
        {
            isLoadingItems = true;
            categoryItems = null;
            StateHasChanged();
        }

        using var db = await DbFactory.CreateDbContextAsync();
        
        mappedModifiers = new List<PosModifierDto>();
        if (selectedCategory.IsModifierCategory && !string.IsNullOrWhiteSpace(selectedCategory.ModifiersJson))
        {
            try
            {
                mappedModifiers = global::System.Text.Json.JsonSerializer.Deserialize<List<PosModifierDto>>(selectedCategory.ModifiersJson) ?? new List<PosModifierDto>();
            }
            catch {}
        }
        
        // Load overrides if a profile is active
        overrideMap = new Dictionary<int, PosMenuOverride>();
        if (selectedProfileId > 0)
        {
            var oList = await db.PosMenuOverrides.Where(o => o.MenuProfileId == selectedProfileId).ToListAsync();
            overrideMap = oList.ToDictionary(o => o.LiquorItemId);
        }

        // 1. First, find all items we care about (Active OR currently showing in POS OR showArchived is enabled)
        var allAvailable = await db.LiquorItems.Where(i => (showArchived || i.IsActive || i.ShowInPos)).ToListAsync();
        
        if (showUncategorized)
        {
            var catNames = categories?.Select(c => c.Name.Trim().ToUpper()).ToList() ?? new List<string>();
            categoryItems = allAvailable
                .Where(i => string.IsNullOrWhiteSpace(i.Category) || !catNames.Contains(i.Category.Trim().ToUpper()))
                .OrderBy(i => i.Name)
                .ToList();
        }
        else
        {
            var nameToFind = (selectedCategory.Name ?? "").Trim().ToUpper();
            
            // Loop through items and filter based on resolved category name if overridden!
            categoryItems = new List<LiquorItem>();
            foreach (var i in allAvailable)
            {
                string resolvedCat = i.Category ?? "MISC";
                PosMenuOverride? o = null;
                if (selectedProfileId > 0)
                {
                    overrideMap.TryGetValue(i.Id, out o);
                }

                if (o != null && !string.IsNullOrWhiteSpace(o.OverrideCategory))
                {
                    resolvedCat = o.OverrideCategory;
                }

                if (resolvedCat.Trim().ToUpper() == nameToFind)
                {
                    // Update item properties to match overrides temporarily for the UI display,
                    // so sorting, visibility, and pricing match the profile overrides perfectly!
                    if (o != null)
                    {
                        if (o.OverridePrice.HasValue) i.RetailPrice = o.OverridePrice.Value;
                        if (o.IsVisible.HasValue) i.ShowInPos = o.IsVisible.Value;
                        if (o.DisplayOrder.HasValue) i.DisplayOrder = o.DisplayOrder.Value;
                    }
                    categoryItems.Add(i);
                }
            }
            categoryItems = categoryItems.OrderBy(i => i.DisplayOrder).ThenBy(i => i.Name).ToList();
        }
            
        isLoadingItems = false;
        await LoadCategories(); // Sync the count badge
        StateHasChanged();
    }

