    private async Task SaveCategoryChanges()
    {
        if (selectedCategory == null) return;
        
        try {
            using var db = await DbFactory.CreateDbContextAsync();
            var original = await db.PosCategories.FindAsync(selectedCategory.Id);
            if (original != null)
            {
                string oldName = original.Name;
                string newName = selectedCategory.Name.Trim().ToUpper();
                
                // 1. Update the Category Name & Tracking Pool
                original.Name = newName;
                original.DisplayOrder = selectedCategory.DisplayOrder;
                original.InventoryTrackType = selectedCategory.InventoryTrackType;
                original.ZReportGroup = selectedCategory.ZReportGroup;
                
                // 2. IMPORTANT: If name changed, update all items linked to it
                if (oldName != newName)
                {
                    var itemsToMigrate = await db.LiquorItems
                        .Where(i => i.Category == oldName)
                        .ToListAsync();
                    
                    foreach(var i in itemsToMigrate) i.Category = newName;
                }
                
                await db.SaveChangesAsync();
                await ToastService.ShowSuccess("Category updated successfully.");
                await LoadCategories();
                await ReloadItems();
            }
        } catch (Exception ex) {
            await ToastService.ShowError($"Error: {ex.Message}");
        }
    }

    private async Task SaveItem()
    {
        if (editingItem == null) return;
        
        try
        {
            using var db = await DbFactory.CreateDbContextAsync();
            
            bool isWine = editingItem.Category?.Trim().ToUpper() == "WINE";
            if (isWine)
            {
                if (editingItem.IsUnitBased)
                {
                    editingItem.ShowInPos = true;
                    editingItem.RetailPrice = bottlePrice;
                    editingItem.BottleVolumeOunces = null;
                    sellByGlass = false;
                }
                else
                {
                    editingItem.ShowInPos = sellByBottle;
                    editingItem.RetailPrice = bottlePrice;
                    editingItem.BottleVolumeOunces = bottleVolumeMl * 0.033814m;
                    editingItem.PourVolumeOunces = sellByGlass ? glassPourSize : null;
                }
            }

            if (editingItem.Id == 0)
            {
                if (!showFullInventoryDetails)
                {
                    decimal globalPour = systemSettings?.GlobalLiquorPourSize ?? 1.5m;
                    editingItem.PackSize = 1;
                    editingItem.MinStockLimit = 2;
                    editingItem.MinimumOrderQuantity = 1;
                    editingItem.PourSize = globalPour;
                    editingItem.IsUnitBased = editingItem.IsUnitBased;
                    editingItem.IsActive = true;
                    editingItem.IsBeer = false;
                }
                db.LiquorItems.Add(editingItem);
                await db.SaveChangesAsync();
                await ToastService.ShowSuccess("Item added successfully.");
            }
            else
            {
                var original = await db.LiquorItems.FindAsync(editingItem.Id);
                if (original != null)
                {
                    original.Name = editingItem.Name;
                    original.Category = editingItem.Category;
                    original.InventoryTrackType = editingItem.InventoryTrackType;
                    
                    if (isWine)
                    {
                        if (editingItem.IsUnitBased)
                        {
                            original.ShowInPos = true;
                            original.RetailPrice = bottlePrice;
                            original.BottleVolumeOunces = null;
                            original.IsUnitBased = true;
                        }
                        else
                        {
                            original.ShowInPos = sellByBottle;
                            original.RetailPrice = bottlePrice;
                            original.BottleVolumeOunces = bottleVolumeMl * 0.033814m;
                            original.PourVolumeOunces = sellByGlass ? glassPourSize : null;
                            original.IsUnitBased = false;
                        }
                    }
                    else
                    {
                        original.ShowInPos = editingItem.ShowInPos;
                        original.RetailPrice = editingItem.RetailPrice;
                    }
                    
                    if (showFullInventoryDetails)
                    {
                        original.BottleSize = editingItem.BottleSize;
                        original.PackSize = editingItem.PackSize;
                        original.IsUnitBased = editingItem.IsUnitBased;
                        original.VendorId = editingItem.VendorId;
                        original.MinStockLimit = editingItem.MinStockLimit;
                        original.CurrentPrice = editingItem.CurrentPrice;
                        original.MinimumOrderQuantity = editingItem.MinimumOrderQuantity;
                        original.PourSize = editingItem.PourSize;
                        original.IsActive = editingItem.IsActive;
                        original.IsBeer = editingItem.IsBeer;
                        original.AllowLooseReconciliation = editingItem.AllowLooseReconciliation;
                    }
                    else
                    {
                        original.IsActive = true;
                    }
                    
                    db.LiquorItems.Update(original);
                    await db.SaveChangesAsync();
                }
                await ToastService.ShowSuccess("Item updated.");
            }

            if (isWine)
            {
                var parentId = editingItem.Id;
                var child = await db.LiquorItems.FirstOrDefaultAsync(x => x.ParentItemId == parentId);
                
                if (sellByGlass)
                {
                    if (child == null)
                    {
                        child = new LiquorItem
                        {
                            Name = editingItem.Name + " (Glass)",
                            Category = editingItem.Category,
                            RetailPrice = glassPrice,
                            PourVolumeOunces = glassPourSize,
                            ParentItemId = parentId,
                            ShowInPos = true,
                            IsActive = true,
                            IsUnitBased = false,
                            CurrentStock = 0,
                            DisplayOrder = editingItem.DisplayOrder + 1,
                            MinStockLimit = 0
                        };
                        db.LiquorItems.Add(child);
                    }
                    else
                    {
                        child.Name = editingItem.Name + " (Glass)";
                        child.Category = editingItem.Category;
                        child.RetailPrice = glassPrice;
                        child.PourVolumeOunces = glassPourSize;
                        child.ShowInPos = true;
                        child.IsActive = true;
                        db.LiquorItems.Update(child);
                    }
                }
                else
                {
                    if (child != null)
                    {
                        child.ShowInPos = false;
                        child.IsActive = false;
                        db.LiquorItems.Update(child);
                    }
                }
                await db.SaveChangesAsync();
            }
            
            editingItem = null;
            await LoadCategories(); // Refresh badges
            await ReloadItems();
        }
        catch (Exception ex)
        {
            await ToastService.ShowError($"Failed to save: {ex.Message}");
        }
    }

