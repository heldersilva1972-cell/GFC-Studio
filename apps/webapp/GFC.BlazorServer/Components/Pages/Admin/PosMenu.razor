@code {
    private List<PosCategory>? categories;
    private PosCategory? selectedCategory;
    private List<LiquorItem>? categoryItems;
    private bool isLoadingItems = false;
    private bool showUncategorized = false;
    private bool showTokensTab = false;
    private int uncategorizedCount = 0;
    private string searchQuery = "";

    private bool showAddCatModal = false;
    private string newCategoryName = "";
    private int newCategoryOrder = 0;
    private bool newCategoryIsModifier = false;

    private bool showEventsTab = false;
    private List<EventTemplate>? eventTemplates;
    private List<ActiveEvent>? activeEvents;
    private EventTemplate? editingEventTemplate;
    private ActiveEvent? creatingActiveEvent;

    private LiquorItem? editingItem;

    protected override async Task OnInitializedAsync()
    {
        await LoadCategories();
        await LoadAllItems();
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/"); 
    }

    private Dictionary<string, int> categoryWarnings = new();

    private async Task LoadCategories()
    {
        using var db = await DbFactory.CreateDbContextAsync();
        categories = await db.PosCategories.Where(c => c.IsActive).OrderBy(c => c.DisplayOrder).ToListAsync();
        
        // Count items that don't match any of our organized categories
        var allManaged = await db.LiquorItems.Where(i => i.IsActive || i.ShowInPos).ToListAsync();
        var catNames = categories.Select(c => c.Name.Trim().ToUpper()).ToList();
        
        uncategorizedCount = allManaged
            .Count(i => i.IsActive && (string.IsNullOrWhiteSpace(i.Category) || !catNames.Contains(i.Category.Trim().ToUpper())));

        // Track inconsistencies: IsActive=false but ShowInPos=true
        categoryWarnings = categories.ToDictionary(
            c => c.Name.Trim().ToUpper(),
            c => allManaged.Count(i => !i.IsActive && i.ShowInPos && i.Category?.Trim().ToUpper() == c.Name.Trim().ToUpper())
        );
    }

    private async Task SelectCategory(PosCategory cat)
    {
        showUncategorized = false;
        showEventsTab = false;
        selectedCategory = cat;
        await ReloadItems();
    }

    private async Task SelectUncategorized()
    {
        selectedCategory = new PosCategory { Name = "NEEDS CATEGORY" };
        showUncategorized = true;
        showEventsTab = false;
        await ReloadItems();
    }

    private async Task SelectEventsTab()
    {
        selectedCategory = null;
        showUncategorized = false;
        showTokensTab = false;
        showEventsTab = true;
        await LoadEvents();
    }
    
    private async Task LoadEvents()
    {
        using var db = await DbFactory.CreateDbContextAsync();
        eventTemplates = await db.EventTemplates.Where(t => !t.IsDeleted).OrderBy(t => t.Name).ToListAsync();
        activeEvents = await db.ActiveEvents.Include(e => e.Template).Where(e => e.Status == EventTabStatus.Open && !e.IsDeleted).OrderByDescending(e => e.CreatedAt).ToListAsync();
    }
    
    private void OpenAddEventTemplateModal()
    {
        editingEventTemplate = new EventTemplate { DefaultType = EventTabType.PrePaid, Name = "" };
    }
    
    private void OpenEditEventTemplateModal(EventTemplate t)
    {
        editingEventTemplate = new EventTemplate { Id = t.Id, Name = t.Name, DefaultType = t.DefaultType };
    }
    
    private async Task SaveEventTemplate()
    {
        if (editingEventTemplate == null || string.IsNullOrWhiteSpace(editingEventTemplate.Name)) return;
        try {
            using var db = await DbFactory.CreateDbContextAsync();
            if (editingEventTemplate.Id == 0) {
                db.EventTemplates.Add(editingEventTemplate);
                await ToastService.ShowSuccess("Template added.");
            } else {
                var orig = await db.EventTemplates.FindAsync(editingEventTemplate.Id);
                if (orig != null) {
                    orig.Name = editingEventTemplate.Name;
                    orig.DefaultType = editingEventTemplate.DefaultType;
                    await ToastService.ShowSuccess("Template updated.");
                }
            }
            await db.SaveChangesAsync();
            editingEventTemplate = null;
            await LoadEvents();
        } catch (Exception ex) {
            await ToastService.ShowError(ex.Message);
        }
    }
    
    private void OpenCreateActiveEventModal(EventTemplate t)
    {
        creatingActiveEvent = new ActiveEvent 
        { 
            TemplateId = t.Id, 
            Name = t.Name, 
            Type = t.DefaultType, 
            InitialAmount = 0, 
            CurrentBalance = 0,
            Status = EventTabStatus.Open 
        };
    }
    
    private async Task StartActiveEvent()
    {
        if (creatingActiveEvent == null) return;
        try {
            creatingActiveEvent.CurrentBalance = creatingActiveEvent.Type == EventTabType.PrePaid ? creatingActiveEvent.InitialAmount : 0;
            using var db = await DbFactory.CreateDbContextAsync();
            db.ActiveEvents.Add(creatingActiveEvent);
            await db.SaveChangesAsync();
            await ToastService.ShowSuccess("Event started!");
            creatingActiveEvent = null;
            await LoadEvents();
        } catch (Exception ex) {
            await ToastService.ShowError(ex.Message);
        }
    }
    
    private async Task CloseActiveEvent(ActiveEvent ae)
    {
        try {
            using var db = await DbFactory.CreateDbContextAsync();
            var orig = await db.ActiveEvents.FindAsync(ae.Id);
            if (orig != null) {
                orig.Status = EventTabStatus.Closed;
                await db.SaveChangesAsync();
                await ToastService.ShowSuccess("Event closed.");
                await LoadEvents();
            }
        } catch (Exception ex) {
            await ToastService.ShowError(ex.Message);
        }
    }

    private async Task SelectTokensTab()
    {
        selectedCategory = null;
        showUncategorized = false;
        showEventsTab = false;
        showTokensTab = true;
        await LoadTokens();
    }

    private List<PosToken>? tokens;
    private List<LiquorItem>? allItemsForTokens;
    private PosToken? editingToken;

    private async Task LoadTokens()
    {
        using var db = await DbFactory.CreateDbContextAsync();
        tokens = await db.PosTokens.OrderBy(t => t.Name).ToListAsync();
        allItemsForTokens = await db.LiquorItems.Where(i => i.IsActive).OrderBy(i => i.Name).ToListAsync();
    }

    private async Task ReloadItems()
    {
        showTokensTab = false;
        showEventsTab = false;
        if (selectedCategory == null) return;
        
        isLoadingItems = true;
        categoryItems = null;
        StateHasChanged();

        using var db = await DbFactory.CreateDbContextAsync();
        
        mappedModifiers = new List<PosModifierDto>();
        if (selectedCategory.IsModifierCategory && !string.IsNullOrWhiteSpace(selectedCategory.ModifiersJson))
        {
            try
            {
                mappedModifiers = global::System.Text.Json.JsonSerializer.Deserialize<List<PosModifierDto>>(selectedCategory.ModifiersJson) ?? new List<PosModifierDto>();
            }
            catch {}
        }
        
        // 1. First, find all items we care about (Active OR currently showing in POS)
        var allAvailable = await db.LiquorItems.Where(i => i.IsActive || i.ShowInPos).ToListAsync();
        
        if (showUncategorized)
        {
            var catNames = categories?.Select(c => c.Name.Trim().ToUpper()).ToList() ?? new List<string>();
            categoryItems = allAvailable
                .Where(i => string.IsNullOrWhiteSpace(i.Category) || !catNames.Contains(i.Category.Trim().ToUpper()))
                .OrderBy(i => i.Name)
                .ToList();
        }
        else
        {
            var nameToFind = (selectedCategory.Name ?? "").Trim().ToUpper();
            categoryItems = allAvailable
                .Where(i => !string.IsNullOrWhiteSpace(i.Category) && i.Category.Trim().ToUpper() == nameToFind)
                .OrderBy(i => i.DisplayOrder)
                .ThenBy(i => i.Name)
                .ToList();
        }
            
        isLoadingItems = false;
        await LoadCategories(); // Sync the count badge
        StateHasChanged();
    }

    private void OpenAddCategoryModal()
    {
        newCategoryName = "";
        newCategoryOrder = (categories?.Count ?? 0) + 1;
        newCategoryIsModifier = false;
        showAddCatModal = true;
    }

    private async Task SaveNewCategory()
    {
        if (string.IsNullOrWhiteSpace(newCategoryName)) return;

        try
        {
            using var db = await DbFactory.CreateDbContextAsync();
            var category = new PosCategory
            {
