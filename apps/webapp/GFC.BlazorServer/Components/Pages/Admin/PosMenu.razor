    private List<PosModifierDto> mappedModifiers = new();
    private bool showAddModifierModal = false;
    private int selectedModifierItemId = 0;
    private string newModifierName = string.Empty;
    private decimal newModifierPrice = 0;
    private decimal newModifierPourSize = 1;

    private void OpenAddModifierModal()
    {
        selectedModifierItemId = 0;
        newModifierName = string.Empty;
        newModifierPrice = 0;
        newModifierPourSize = 1;
        showAddModifierModal = true;
    }

    private void OnAddModifierItemChanged(int itemId)
    {
        selectedModifierItemId = itemId;
        if (itemId == -1)
        {
            newModifierName = "";
            newModifierPrice = 1.50m;
            newModifierPourSize = 0;
        }
        else
        {
            var item = allItemsForTokens?.FirstOrDefault(i => i.Id == itemId);
            if (item != null)
            {
                newModifierName = item.Name + " Add-on";
                newModifierPrice = item.RetailPrice > 0 ? item.RetailPrice * 0.5m : 1.50m;
                newModifierPourSize = item.IsUnitBased ? 1.0m : (item.PourSize > 0 ? item.PourSize : 1.5m);
            }
        }
    }

    private async Task SaveNewModifier()
    {
        if (selectedModifierItemId == 0 || selectedCategory == null) return;

        if (selectedModifierItemId < 0)
        {
            var existingCustomCount = mappedModifiers.Count(m => m.ItemId < 0);
            var uniqueId = -1 - existingCustomCount;
            mappedModifiers.Add(new PosModifierDto
            {
                ItemId = uniqueId,
                Name = newModifierName,
                Price = newModifierPrice,
                PourSize = 0
            });
        }
        else
        {
            var existing = mappedModifiers.FirstOrDefault(m => m.ItemId == selectedModifierItemId);
            if (existing != null)
            {
                existing.Name = newModifierName;
                existing.Price = newModifierPrice;
                existing.PourSize = newModifierPourSize;
            }
            else
            {
                mappedModifiers.Add(new PosModifierDto
                {
                    ItemId = selectedModifierItemId,
                    Name = newModifierName,
                    Price = newModifierPrice,
                    PourSize = newModifierPourSize
                });
            }
        }

        selectedCategory.ModifiersJson = global::System.Text.Json.JsonSerializer.Serialize(mappedModifiers);
        using var db = await DbFactory.CreateDbContextAsync();
        var cat = await db.PosCategories.FindAsync(selectedCategory.Id);
        if (cat != null)
        {
            cat.ModifiersJson = selectedCategory.ModifiersJson;
            await db.SaveChangesAsync();
            await ToastService.ShowSuccess($"Designated modifier {newModifierName}");
        }

        showAddModifierModal = false;
        await ReloadItems();
    }

