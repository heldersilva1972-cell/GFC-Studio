        };
        showFullInventoryDetails = false;

        sellByGlass = false;
        glassPrice = 0;
        glassPourSize = 5.0m;
        sellByBottle = itemToEdit.ShowInPos;
        bottlePrice = itemToEdit.RetailPrice;

        if (itemToEdit.BottleVolumeOunces.HasValue)
        {
            bottleVolumeMl = (int)Math.Round(itemToEdit.BottleVolumeOunces.Value / 0.033814m);
        }
        else
        {
            if (!string.IsNullOrEmpty(itemToEdit.BottleSize) && itemToEdit.BottleSize.EndsWith("ml", StringComparison.OrdinalIgnoreCase))
            {
                if (int.TryParse(itemToEdit.BottleSize.Substring(0, itemToEdit.BottleSize.Length - 2), out int parsedMl))
                {
                    bottleVolumeMl = parsedMl;
                }
                else
                {
                    bottleVolumeMl = 750;
                }
            }
            else
            {
                bottleVolumeMl = 750;
            }
        }

        try
        {
            using var db = DbFactory.CreateDbContext();
            var child = db.LiquorItems.FirstOrDefault(x => x.ParentItemId == itemToEdit.Id && x.IsActive);
            if (child != null)
            {
                sellByGlass = child.ShowInPos;
                glassPrice = child.RetailPrice;
                glassPourSize = child.PourVolumeOunces ?? 5.0m;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[POS Menu Manager] Failed to load child items: {ex.Message}");
        }
    }

