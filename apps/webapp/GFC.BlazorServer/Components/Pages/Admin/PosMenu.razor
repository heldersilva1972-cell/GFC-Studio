    private void OnAddModifierItemChanged(int itemId)
    {
        selectedModifierItemId = itemId;
        if (itemId == -1)
        {
            newModifierName = "";
            newModifierPrice = 1.50m;
            newModifierPourSize = 0;
        }
        else
        {
            var item = allItemsForTokens?.FirstOrDefault(i => i.Id == itemId);
            if (item != null)
            {
                newModifierName = item.Name + " Add-on";
                newModifierPrice = item.RetailPrice > 0 ? item.RetailPrice * 0.5m : 1.50m;
                newModifierPourSize = item.IsUnitBased ? 1.0m : (item.PourSize > 0 ? item.PourSize : 1.5m);
            }
        }
    }

    private void ToggleNewModifierCategory(string categoryName, object? isChecked)
    {
        var catUpper = categoryName.Trim().ToUpper();
        if (isChecked is bool val && val)
        {
            if (!newModifierEligibleCategoriesList.Contains(catUpper))
                newModifierEligibleCategoriesList.Add(catUpper);
        }
        else
        {
            newModifierEligibleCategoriesList.Remove(catUpper);
        }
    }

    private async Task ToggleTableModifierCategory(PosModifierDto mod, string categoryName, object? isChecked)
    {
        if (selectedCategory == null) return;
        var catUpper = categoryName.Trim().ToUpper();
        var currentList = string.IsNullOrEmpty(mod.EligibleCategories)
            ? new List<string>()
            : mod.EligibleCategories.Split(',', StringSplitOptions.RemoveEmptyEntries).Select(c => c.Trim().ToUpper()).ToList();

        if (isChecked is bool val && val)
        {
            if (!currentList.Contains(catUpper))
                currentList.Add(catUpper);
        }
        else
        {
            currentList.Remove(catUpper);
        }

        mod.EligibleCategories = currentList.Any() ? string.Join(",", currentList) : null;
        selectedCategory.ModifiersJson = global::System.Text.Json.JsonSerializer.Serialize(mappedModifiers);
