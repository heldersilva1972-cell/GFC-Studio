    private async Task SaveEventTemplate()
    {
        if (editingEventTemplate == null || string.IsNullOrWhiteSpace(editingEventTemplate.Name)) return;
        try {
            var cleanName = editingEventTemplate.Name.Trim();
            if (cleanName.EndsWith(" [Direct]")) cleanName = cleanName.Substring(0, cleanName.Length - 9).Trim();
            else if (cleanName.EndsWith("[Direct]")) cleanName = cleanName.Substring(0, cleanName.Length - 8).Trim();

            if (_templateDirectCheckout)
            {
                editingEventTemplate.Name = cleanName + " [Direct]";
            }
            else
            {
                editingEventTemplate.Name = cleanName;
            }

            editingEventTemplate.ItemsOverrideJson = global::System.Text.Json.JsonSerializer.Serialize(editingEventOverrides);
            
            using var db = await DbFactory.CreateDbContextAsync();
            if (editingEventTemplate.Id == 0) {
                db.EventTemplates.Add(editingEventTemplate);
                await ToastService.ShowSuccess("Template added.");
            } else {
                var orig = await db.EventTemplates.FindAsync(editingEventTemplate.Id);
                if (orig != null) {
                    orig.Name = editingEventTemplate.Name;
                    orig.DefaultType = editingEventTemplate.DefaultType;
                    orig.ItemsOverrideJson = editingEventTemplate.ItemsOverrideJson;
                    orig.EnableBeerTally = editingEventTemplate.EnableBeerTally;
                    await ToastService.ShowSuccess("Template updated.");
                }
            }
            await db.SaveChangesAsync();
            editingEventTemplate = null;
            await LoadEvents();
