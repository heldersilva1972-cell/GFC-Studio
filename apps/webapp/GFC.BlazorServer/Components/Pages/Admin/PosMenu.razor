        {
            cat.ModifiersJson = selectedCategory.ModifiersJson;
            await db.SaveChangesAsync();
            await ToastService.ShowSuccess("Modifier target categories updated");
        }
    }

    private async Task SaveNewModifier()
    {
        if (selectedModifierItemId == 0 || selectedCategory == null) return;

        var eligibleCatsStr = newModifierEligibleCategoriesList.Any()
            ? string.Join(",", newModifierEligibleCategoriesList)
            : null;

        if (selectedModifierItemId < 0)
        {
            var existingCustomCount = mappedModifiers.Count(m => m.ItemId < 0);
            var uniqueId = -1 - existingCustomCount;
            mappedModifiers.Add(new PosModifierDto
            {
                ItemId = uniqueId,
                Name = newModifierName,
                Price = newModifierPrice,
                PourSize = 0,
                EligibleCategories = eligibleCatsStr
            });
        }
        else
        {
            var existing = mappedModifiers.FirstOrDefault(m => m.ItemId == selectedModifierItemId);
            if (existing != null)
            {
                existing.Name = newModifierName;
                existing.Price = newModifierPrice;
                existing.PourSize = newModifierPourSize;
                existing.EligibleCategories = eligibleCatsStr;
            }
            else
            {
                mappedModifiers.Add(new PosModifierDto
                {
                    ItemId = selectedModifierItemId,
                    Name = newModifierName,
                    Price = newModifierPrice,
                    PourSize = newModifierPourSize,
                    EligibleCategories = eligibleCatsStr
                });
            }
        }

        selectedCategory.ModifiersJson = global::System.Text.Json.JsonSerializer.Serialize(mappedModifiers);
        using var db = await DbFactory.CreateDbContextAsync();
        var cat = await db.PosCategories.FindAsync(selectedCategory.Id);
        if (cat != null)
        {
            cat.ModifiersJson = selectedCategory.ModifiersJson;
            await db.SaveChangesAsync();
            await ToastService.ShowSuccess($"Designated modifier {newModifierName}");
        }

        showAddModifierModal = false;
        await ReloadItems();
    }


