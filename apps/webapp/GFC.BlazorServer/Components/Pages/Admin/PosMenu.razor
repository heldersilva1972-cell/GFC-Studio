                    original.Name = editingToken.Name;
                    original.SalePrice = editingToken.SalePrice;
                    original.ColorHex = editingToken.ColorHex;
                    original.EligibleItemIds = editingToken.EligibleItemIds;
                    original.AllowCreditUpgrade = editingToken.AllowCreditUpgrade;
                    original.CreditValue = editingToken.CreditValue;
                    original.CreditEligibleCategories = editingToken.CreditEligibleCategories;
