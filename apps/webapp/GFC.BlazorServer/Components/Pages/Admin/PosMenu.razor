    private void OpenEditTokenModal(PosToken token)
    {
        editingToken = new PosToken
        {
            Id = token.Id,
            Name = token.Name,
            SalePrice = token.SalePrice,
            ColorHex = token.ColorHex,
            IsActive = token.IsActive,
            EligibleItemIds = token.EligibleItemIds,
