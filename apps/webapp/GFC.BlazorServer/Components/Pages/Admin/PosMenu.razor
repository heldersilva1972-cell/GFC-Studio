@page "/admin/pos-menu"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using GFC.BlazorServer.Data
@using GFC.Core.Models
@using GFC.Core.Enums
@using GFC.Core.DTOs
@attribute [Authorize]
@inject Microsoft.EntityFrameworkCore.IDbContextFactory<GFC.BlazorServer.Data.GfcDbContext> DbFactory
@inject GFC.BlazorServer.Services.IToastService ToastService
@inject NavigationManager Navigation
@inject GFC.BlazorServer.Services.IBlazorSystemSettingsService SystemSettingsService

<PageTitle>POS Menu Manager | GFC</PageTitle>

<div class="container-fluid py-2 d-flex flex-column pos-menu-wrapper overflow-hidden">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div class="d-flex align-items-center">
            <button class="btn btn-light rounded-circle me-3 shadow-sm border" @onclick="GoBack" title="Go Back">
                <i class="bi bi-chevron-left fs-5"></i>
            </button>
            <div>
                <h1 class="h3 mb-0 fw-bold">POS Menu Manager</h1>
                <p class="text-muted mb-0">Manage liquor prices, categories, and fast-tap buttons.</p>
            </div>
        </div>
        <div class="d-flex align-items-center gap-3">
            <div class="d-flex align-items-center gap-2">
                <span class="fw-bold text-muted small text-uppercase" style="font-size: 0.75rem;">Menu Profile:</span>
                <select class="form-select form-select-sm rounded-pill px-3 fw-bold border-2" style="width: auto; min-width: 180px;" value="@selectedProfileId" @onchange="OnProfileChanged">
                    <option value="-1">-- SELECT PROFILE --</option>
                    <option value="0">Default (Master)</option>
                    @if (profiles != null)
                    {
                        @foreach (var p in profiles)
                        {
                            <option value="@p.Id">@p.Name</option>
                        }
                    }
                </select>
            </div>
            <button class="btn btn-primary rounded-pill px-4 shadow-sm" @onclick="OpenAddCategoryModal" disabled="@(selectedProfileId == -1)">
                <i class="bi bi-plus-lg me-2"></i> Add New Category
            </button>
        </div>
    </div>

    @if (selectedProfileId == -1)
    {
        <div class="d-flex justify-content-center align-items-center flex-grow-1 py-5">
            <div class="card border-0 shadow-sm rounded-4 p-5 text-center bg-white" style="max-width: 500px;">
                <div class="mb-4">
                    <div class="bg-primary bg-opacity-10 d-inline-flex p-4 rounded-circle text-primary">
                        <i class="bi bi-pc-display fs-1"></i>
                    </div>
                </div>
                <h4 class="fw-black text-dark mb-2">Select a Menu Profile</h4>
                <p class="text-muted small mb-0">Please select a menu profile from the dropdown at the top right to start managing categories, prices, and register layouts.</p>
            </div>
        </div>
    }
    else
    {
        <div class="row flex-grow-1 min-height-0 overflow-hidden">
        <div class="col-lg-3 h-100">
            <div class="card border-0 shadow-sm rounded-4 h-100 d-flex flex-column overflow-hidden bg-white">
                <div class="card-header bg-light border-0 py-2 flex-shrink-0">
                    <h6 class="fw-bold mb-0 text-muted small text-uppercase" style="font-size: 0.75rem;">Menu Categories</h6>
                </div>
                <div class="list-group list-group-flush flex-grow-1 overflow-y-auto scroll-area">
                    @if (categories == null)
                    {
                        <div class="text-center py-4"><div class="spinner-border spinner-border-sm text-primary"></div></div>
                    }
                    else
                    {
                        @foreach (var cat in categories.OrderBy(c => c.DisplayOrder))
                        {
                            <button class="list-group-item list-group-item-action border-0 py-2 @(selectedCategory?.Id == cat.Id && !showUncategorized ? "active" : "")" 
                                    @onclick="() => SelectCategory(cat)">
                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="fw-bold" style="font-size: 0.9rem;">@cat.Name</span>
                                    @if (categoryWarnings.TryGetValue(cat.Name.Trim().ToUpper(), out var warnCount) && warnCount > 0)
                                    {
                                        <span class="badge bg-warning text-dark rounded-pill extra-small ms-auto me-2">@warnCount INACTIVE</span>
                                    }
                                    <i class="bi bi-chevron-right small"></i>
                                </div>
                            </button>
                        }
                        
                        <div class="card-header bg-light border-0 py-1.5 mt-2 flex-shrink-0">
                            <h6 class="fw-bold mb-0 text-muted extra-small text-uppercase" style="font-size: 0.7rem;">Maintenance</h6>
                        </div>
                        <button class="list-group-item list-group-item-action border-0 py-2 @(showUncategorized ? "bg-warning-subtle text-warning-emphasis fw-bold" : "")" 
                                @onclick="SelectUncategorized">
                            <div class="d-flex justify-content-between align-items-center">
                                <span style="font-size: 0.9rem;"><i class="bi bi-exclamation-triangle-fill me-2 text-warning"></i> NEEDS CATEGORY</span>
                                @if (uncategorizedCount > 0)
                                {
                                    <span class="badge bg-danger rounded-pill">@uncategorizedCount</span>
                                }
                            </div>
                        </button>
 
                        <div class="card-header bg-light border-0 py-1.5 mt-2 flex-shrink-0">
                            <h6 class="fw-bold mb-0 text-muted extra-small text-uppercase" style="font-size: 0.7rem;">Automation</h6>
                        </div>
                        <button class="list-group-item list-group-item-action border-0 py-2 @(showTokensTab ? "active" : "")" 
                                @onclick="SelectTokensTab">
                            <div class="d-flex justify-content-between align-items-center">
                                <span style="font-size: 0.9rem;"><i class="bi bi-ticket-perforated-fill me-2 text-primary"></i> TOKEN MANAGER</span>
                                <i class="bi bi-chevron-right small"></i>
                            </div>
                        </button>
 
                        <div class="card-header bg-light border-0 py-1.5 mt-2 flex-shrink-0">
                            <h6 class="fw-bold mb-0 text-muted extra-small text-uppercase" style="font-size: 0.7rem;">Events</h6>
                        </div>
                        <button class="list-group-item list-group-item-action border-0 py-2 @(showEventsTab ? "active" : "")" 
                                @onclick="SelectEventsTab">
                            <div class="d-flex justify-content-between align-items-center">
                                <span style="font-size: 0.9rem;"><i class="bi bi-calendar-event me-2 text-success"></i> BANQUETS & TABS</span>
                                <i class="bi bi-chevron-right small"></i>
                            </div>
                        </button>
 
                        <div class="card-header bg-light border-0 py-1.5 mt-2 flex-shrink-0">
                            <h6 class="fw-bold mb-0 text-muted extra-small text-uppercase" style="font-size: 0.7rem;">Drawer Control</h6>
                        </div>
                        <button class="list-group-item list-group-item-action border-0 py-2 @(showPayoutTab ? "active" : "")" 
                                @onclick="SelectPayoutTab">
                            <div class="d-flex justify-content-between align-items-center">
                                <span style="font-size: 0.9rem;"><i class="bi bi-wallet2 me-2 text-info"></i> PAYOUT SETTINGS</span>
                                <i class="bi bi-chevron-right small"></i>
                            </div>
                        </button>
 
                        <div class="card-header bg-light border-0 py-1.5 mt-2 flex-shrink-0">
                            <h6 class="fw-bold mb-0 text-muted extra-small text-uppercase" style="font-size: 0.7rem;">Terminal Profiles</h6>
                        </div>
                        <button class="list-group-item list-group-item-action border-0 py-2 @(showProfilesTab ? "active" : "")" 
                                @onclick="SelectProfilesTab">
                            <div class="d-flex justify-content-between align-items-center">
                                <span style="font-size: 0.9rem;"><i class="bi bi-pc-display me-2 text-dark"></i> POS TERMINALS</span>
                                <i class="bi bi-chevron-right small"></i>
                            </div>
                        </button>
                    }
                </div>
            </div>
        </div>
        <div class="col-lg-9 h-100">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white p-3 d-flex flex-column overflow-hidden">
                @if (showTokensTab)
                {
                    <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-4 flex-shrink-0">
                        <div>
                            <h2 class="fw-black mb-1">Token Manager</h2>
                            <p class="text-muted small mb-0">Define tokens and link them to eligible drinks.</p>
                        </div>
                        <button class="btn btn-primary rounded-pill px-4" @onclick="OpenAddTokenModal">
                            <i class="bi bi-plus-lg me-2"></i> Add New Token
                        </button>
                    </div>

                    <div class="flex-grow-1 overflow-y-auto pe-2 scroll-area">
                        <!-- Token Manager Guide -->
                        <div class="alert border-0 shadow-sm rounded-4 p-3 mb-4 d-flex align-items-start gap-3" style="background-color: #f0f9ff; border-left: 5px solid #0284c7 !important;">
                            <i class="bi bi-ticket-perforated-fill fs-4 text-info mt-1"></i>
                            <div>
                                <h6 class="fw-black mb-1 text-dark" style="font-size: 0.95rem;">Token Management Quick Guide</h6>
                                <p class="text-muted small mb-2">Configure physical tokens or promotional tickets used for rapid checkout payments at register terminals.</p>
                                <ul class="mb-0 text-muted small ps-3">
                                    <li class="mb-1"><strong>1. Create & Color-Code:</strong> Create tokens (e.g. <em>"Beer Token"</em>) and assign colors to match physical tickets.</li>
                                    <li class="mb-1"><strong>2. Link Beverage Items:</strong> Select the menu items this token is authorized to pay for.</li>
                                    <li class="mb-0"><strong>3. Smart Upgrades (Partial Credit):</strong> Toggle <em>"Enable Credit Upgrades"</em> to let the token act as partial cash credit (e.g., $5.00 credit) toward more expensive items. (This keeps the regular token option active and adds a dedicated "Upgrade" button in the POS terminal!)</li>
                                </ul>
                            </div>
                        </div>

                    @if (tokens == null)
                    {
                        <div class="text-center py-5"><div class="spinner-border text-primary"></div></div>
                    }
                    else if (!tokens.Any())
                    {
                        <div class="text-center py-5">
                            <i class="bi bi-ticket-perforated fs-1 text-muted opacity-25"></i>
                            <h5 class="mt-3">No Tokens Defined</h5>
                            <p class="text-muted">Create a token like "Beer Token" to start.</p>
                        </div>
                    }
                    else
                    {
                        <div class="row row-cols-1 row-cols-md-2 g-4">
                            @foreach (var token in tokens)
                            {
                                <div class="col">
                                    <div class="card h-100 border-2 rounded-4 p-3 @(token.IsActive ? "" : "opacity-50")" style="border-left: 8px solid @token.ColorHex;">
                                        <div class="d-flex justify-content-between align-items-start">
                                            <div class="w-100">
                                                <div class="d-flex align-items-center flex-wrap gap-2 mb-2">
                                                    <h5 class="fw-bold mb-0">@token.Name</h5>
                                                    @if (token.AllowCreditUpgrade.GetValueOrDefault())
                                                    {
                                                        <span class="badge bg-warning bg-opacity-10 text-warning border border-warning border-opacity-20 px-2 py-1 rounded-pill" style="font-size: 0.65rem; font-weight: 800; letter-spacing: 0.5px;">UPGRADE</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-20 px-2 py-1 rounded-pill" style="font-size: 0.65rem; font-weight: 800; letter-spacing: 0.5px;">STANDARD</span>
                                                    }
                                                </div>
                                                <div class="d-flex align-items-center flex-wrap gap-2 mb-2">
                                                    <div class="badge bg-light text-dark border px-3 py-2 rounded-pill">
                                                        Sale Price: @token.SalePrice.ToString("C")
                                                    </div>
                                                    @if (token.AllowCreditUpgrade.GetValueOrDefault() && token.CreditValue.HasValue)
                                                    {
                                                        <div class="badge bg-warning bg-opacity-10 text-warning border border-warning border-opacity-20 px-3 py-2 rounded-pill">
                                                            Credit: @token.CreditValue.Value.ToString("C")
                                                        </div>
                                                    }
                                                </div>
                                                @if (token.AllowCreditUpgrade.GetValueOrDefault() && token.UpgradesFromTokenId.HasValue)
                                                {
                                                    var parentToken = tokens.FirstOrDefault(t => t.Id == token.UpgradesFromTokenId.Value);
                                                    <div class="small text-warning fw-bold mb-2" style="font-size: 0.8rem;">
                                                        <i class="bi bi-arrow-up-right-circle me-1"></i> Upgrades From: <span class="text-dark bg-light px-2 py-1 rounded border">@(parentToken?.Name ?? $"Token #{token.UpgradesFromTokenId}")</span>
                                                    </div>
                                                }
                                                <p class="small text-muted mb-0">
                                                    @(string.IsNullOrEmpty(token.EligibleItemIds) ? "No drinks linked" : $"{token.EligibleItemIds.Split(',').Length} drinks linked")
                                                </p>
                                            </div>
                                            <div class="d-flex gap-2">
                                                <button class="btn btn-sm btn-light border rounded-pill" @onclick="() => OpenEditTokenModal(token)">Edit</button>
                                                <button class="btn btn-sm btn-outline-danger border rounded-pill" @onclick="() => DeleteToken(token)"><i class="bi bi-trash"></i></button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
            else if (showEventsTab)
            {
                <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-4 flex-shrink-0">
                    <div>
                        <h2 class="fw-black mb-1">Event & Tab Manager</h2>
                        <p class="text-muted small mb-0">Manage pre-paid banquets and running tabs.</p>
                    </div>
                    <button class="btn btn-primary rounded-pill px-4 shadow-sm" @onclick="OpenAddEventTemplateModal">
                        <i class="bi bi-plus-lg me-2"></i> New Event Template
                    </button>
                </div>

                <div class="flex-grow-1 overflow-y-auto pe-2 scroll-area">
                    <!-- Banquets & Events Guide -->
                    <div class="alert border-0 shadow-sm rounded-4 p-3 mb-4 d-flex align-items-start gap-3" style="background-color: #f0fdf4; border-left: 5px solid #16a34a !important;">
                        <i class="bi bi-calendar-event fs-4 text-success mt-1"></i>
                        <div>
                            <h6 class="fw-black mb-1 text-success-emphasis" style="font-size: 0.95rem;">Banquets & Event Tabs Quick Guide</h6>
                            <p class="text-muted small mb-2">Configure custom discount structures and templates for wedding banquets, corporate accounts, or running tabs.</p>
                            <ul class="mb-0 text-muted small ps-3">
                                <li class="mb-1"><strong>1. Create Event Template:</strong> Define which items are visible under <em>"Custom Menu & Prices"</em> and set special discounted or free prices for the event.</li>
                                <li class="mb-1"><strong>2. Start Active Event:</strong> Launch the template as a **Pre-Paid** account (countdown deposit, e.g., $1000) or **Current Tab** (accrues from $0).</li>
                                <li class="mb-0"><strong>3. Direct Tab Checkout:</strong> Enable <em>"Direct Tab Checkout"</em> to display a dedicated **TAB** button next to **PAY** on checkout registers for rapid one-tap ordering.</li>
                            </ul>
                        </div>
                    </div>

                    <h5 class="fw-bold mb-3">Active Tabs (Running Now)</h5>
                    @if (activeEvents == null) { <div class="text-center py-4"><div class="spinner-border text-primary"></div></div> }
                    else if (!activeEvents.Any()) { <div class="text-muted small mb-4">No active events currently running.</div> }
                    else {
                        <div class="list-group mb-5">
                        @foreach(var ae in activeEvents) {
                            <div class="list-group-item p-4 border-2 rounded-4 mb-3 shadow-sm" style="border-left: 6px solid @(ae.Type == EventTabType.PrePaid ? "var(--bs-primary)" : "var(--bs-success)") !important;">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <h5 class="fw-bold mb-1">@GetEventDisplayName(ae.Name) <span class="badge @(ae.Type == EventTabType.PrePaid ? "bg-primary" : "bg-success") ms-2">@ae.Type</span></h5>
                                        <p class="mb-0 small text-muted">Started: @ae.CreatedAt.ToLocalTime().ToString("g")</p>
                                    </div>
                                    <div class="text-end">
                                        <div class="small fw-bold text-muted text-uppercase mb-1">@(ae.Type == EventTabType.PrePaid ? "Remaining Balance" : "Current Tab")</div>
                                        <h4 class="fw-black mb-2 @(ae.CurrentBalance <= 0 && ae.Type == EventTabType.PrePaid ? "text-danger" : "text-dark")">
                                            @(ae.Type == EventTabType.PrePaid ? ae.CurrentBalance.ToString("C") : Math.Abs(ae.CurrentBalance).ToString("C"))
                                        </h4>
                                        <div class="d-flex gap-2 justify-content-end">
                                             @if (ae.EnableBeerTally)
                                             {
                                                 <button class="btn btn-sm btn-outline-primary rounded-pill px-3 fw-bold" @onclick='() => StartInlineTallyEdit(ae, "remove")'>
                                                     <i class="bi bi-plus-circle me-1"></i> Remove Beers
                                                 </button>
                                                 <button class="btn btn-sm btn-outline-warning rounded-pill px-3 fw-bold" @onclick='() => StartInlineTallyEdit(ae, "return")' disabled="@(!HasRemovedBeers(ae))">
                                                     <i class="bi bi-arrow-left-right me-1"></i> Return Beers
                                                 </button>
                                                 <button class="btn btn-sm btn-outline-success rounded-pill px-3 fw-bold" @onclick='() => StartInlineTallyEdit(ae, "settle")'>
                                                     <i class="bi bi-cash-stack me-1"></i> Settle Balance
                                                 </button>
                                             }
                                             else
                                             {
                                                 <button class="btn btn-sm btn-info text-white rounded-pill px-3 shadow-sm" @onclick="() => OpenBeerTallyModal(ae)">
                                                     <i class="bi bi-beer me-1"></i> Beer Tally
                                                 </button>
                                             }
                                             @if(ae.Type == EventTabType.PrePaid) {
                                                 <button class="btn btn-sm btn-success rounded-pill px-3 shadow-sm" @onclick="() => OpenAddFundsModal(ae)">Add Funds</button>
                                             }
                                             <button class="btn btn-sm btn-outline-danger rounded-pill px-3" @onclick="() => CloseActiveEvent(ae)">Close Tab</button>
                                         </div>
                                    </div>
                                </div>
                                 
                                 @if (ae.EnableBeerTally)
                                 {
                                     <!-- Inline Beer Display -->
                                     <div class="mt-3 pt-3 border-top">
                                         <div class="row">
                                             <div class="col-md-7 border-end">
                                                 <h6 class="small fw-bold text-muted text-uppercase mb-2"><i class="bi bi-box-seam me-1 text-primary"></i> Beers Removed (Removed from Stock)</h6>
                                                 @{
                                                     var tallies = GetActiveEventTallies(ae);
                                                 }
                                                 @if (!tallies.Any(t => t.QuantityTaken > 0))
                                                 {
                                                     <p class="text-muted small mb-0"><i class="bi bi-info-circle me-1"></i> No beers removed yet. Click "Remove Beers" above to begin tracking.</p>
                                                 }
                                                 else
                                                 {
                                                     <div class="d-flex flex-wrap gap-2">
                                                         @foreach (var t in tallies.Where(t => t.QuantityTaken > 0))
                                                         {
                                                             <div class="badge bg-light text-dark border p-2 rounded-3 d-flex align-items-center gap-2">
                                                                 <span class="fw-bold text-primary">@t.QuantityTaken x</span>
                                                                 <span class="fw-bold">@t.Name</span>
                                                                 <span class="text-muted">(@t.Price.ToString("C") ea)</span>
                                                                 @if (t.QuantityReturned > 0)
                                                                 {
                                                                     <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-20 rounded-pill">
                                                                         <i class="bi bi-arrow-return-left me-1"></i>@t.QuantityReturned returned
                                                                     </span>
                                                                 }
                                                             </div>
                                                         }
                                                     </div>
                                                 }
                                             </div>
                                             <div class="col-md-5 ps-3">
                                                 <div class="d-flex justify-content-between align-items-center mb-1">
                                                     <span class="small fw-bold text-muted text-uppercase">Total Removed Value:</span>
                                                     <span class="fw-black text-dark">@CalculateRemovedValue(ae).ToString("C")</span>
                                                 </div>
                                                 <div class="d-flex justify-content-between align-items-center mb-1">
                                                     <span class="small fw-bold text-muted text-uppercase">Total Consumed Value:</span>
                                                     <span class="fw-black text-primary">@CalculateConsumedValue(ae).ToString("C")</span>
                                                 </div>
                                                 @if (ae.InitialAmount > 0)
                                                 {
                                                     <div class="d-flex justify-content-between align-items-center">
                                                         <span class="small fw-bold text-muted text-uppercase">Preloaded Cash:</span>
                                                         <span class="fw-bold text-success">@ae.InitialAmount.ToString("C")</span>
                                                     </div>
                                                 }
                                             </div>
                                         </div>
                                     </div>
                                 }
                            </div>
                        }
                        </div>
                    }

                    <div class="d-flex justify-content-between align-items-center mb-3 mt-4">
                        <h5 class="fw-bold mb-0">Saved Event Templates</h5>
                    </div>
                    @if (eventTemplates == null) { <div class="text-center py-4"><div class="spinner-border text-primary"></div></div> }
                    else if (!eventTemplates.Any()) { <div class="text-muted small">No templates saved.</div> }
                    else {
                        <div class="row row-cols-1 row-cols-md-2 g-3">
                        @foreach(var t in eventTemplates) {
                            <div class="col">
                                <div class="card h-100 border-2 rounded-4 p-3 bg-white">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <div>
                                            <h6 class="fw-bold mb-1">@GetEventDisplayName(t.Name)</h6>
                                            <span class="badge bg-light text-dark border rounded-pill">Default: @t.DefaultType</span>
                                        </div>
                                        <div class="d-flex gap-2">
                                            <button class="btn btn-sm btn-light border rounded-circle" title="Edit Template" @onclick="() => OpenEditEventTemplateModal(t)"><i class="bi bi-pencil"></i></button>
                                            <button class="btn btn-sm btn-success rounded-circle text-white" title="Start Event" @onclick="() => OpenCreateActiveEventModal(t)"><i class="bi bi-play-fill"></i></button>
                                            <button class="btn btn-sm btn-outline-danger rounded-circle" title="Delete Template" @onclick="() => DeleteEventTemplate(t)"><i class="bi bi-trash"></i></button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                        </div>
                    }
                </div>
            }
            else if (showPayoutTab)
            {
                <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-4 flex-shrink-0">
                    <div>
                        <h2 class="fw-black mb-1" style="color: #ea580c;"><i class="bi bi-wallet2 me-2"></i>Drawer Payout Categories</h2>
                        <p class="text-muted small mb-0">Configure standard bookkeeping options for bartender/cashier cash drawer payouts.</p>
                    </div>
                </div>

                <div class="flex-grow-1 d-flex flex-column overflow-hidden pe-2">
                    <div class="flex-shrink-0">
                        <!-- Drawer Payout Guide -->
                        <div class="alert border-0 shadow-sm rounded-4 p-3 mb-3 d-flex align-items-start gap-3" style="background-color: #fff7ed; border-left: 5px solid #ea580c !important;">
                            <i class="bi bi-wallet2 fs-4" style="color: #ea580c; margin-top: 4px;"></i>
                            <div>
                                <h6 class="fw-black mb-1" style="font-size: 0.95rem; color: #c2410c;">Cash Till Payouts Quick Guide</h6>
                                <p class="text-muted small mb-1">Configure ledger reasons required by POS terminals when cash is physically withdrawn from the cash till.</p>
                                <ul class="mb-0 text-muted small ps-3">
                                    <li class="mb-1"><strong>Accountability:</strong> When bartenders pay local vendors, buy emergency lemons/supplies, or hand out performer payouts, they must select a category.</li>
                                    <li class="mb-0"><strong>Reconciliation:</strong> Keeps petty cash tracked so register drawer totals balance perfectly at closing.</li>
                                </ul>
                            </div>
                        </div>

                        <div class="card border-0 rounded-4 p-3 mb-3 shadow-sm" style="background-color: #fff7ed;">
                            <h6 class="fw-bold mb-2 text-dark"><i class="bi bi-plus-circle-fill me-2" style="color: #ea580c;"></i>Create Category</h6>
                            <div class="d-flex gap-3 align-items-center">
                                <div class="flex-grow-1">
                                    <input type="text" class="form-control form-control-sm rounded-3 border-2" 
                                           @bind="newPayoutCategory" placeholder="e.g. FOOD, SUPPLIES, MUSIC, POSTAGE..." />
                                </div>
                                <button class="btn btn-sm rounded-pill px-3 py-1.5 fw-bold shadow-sm text-white" style="background-color: #ea580c; border-color: #ea580c;" @onclick="AddPayoutCategory" disabled="@string.IsNullOrWhiteSpace(newPayoutCategory)">
                                    <i class="bi bi-plus-lg me-1"></i> Add
                                </button>
                            </div>
                        </div>

                        <h6 class="fw-bold mb-2 d-flex align-items-center justify-content-between">
                            <span>Current Payout Options</span>
                            <span class="badge bg-secondary rounded-pill">@payoutCategories.Count categories</span>
                        </h6>
                    </div>

                    <div class="flex-grow-1 overflow-y-auto pe-1 scroll-area">
                        @if (!payoutCategories.Any())
                        {
                            <div class="text-center py-4 bg-white border border-2 border-dashed rounded-4">
                                <i class="bi bi-wallet fs-2 text-muted opacity-25"></i>
                                <h6 class="mt-2 mb-1">No Payout Categories Configured</h6>
                                <p class="text-muted small mb-0">Without categories, POS operators cannot file drawer payouts.</p>
                            </div>
                        }
                        else
                        {
                            <div class="list-group rounded-4 shadow-sm border overflow-hidden">
                                @foreach (var pCat in payoutCategories)
                                {
                                    <div class="list-group-item d-flex justify-content-between align-items-center py-2 px-3 hover-bg bg-white border-0 border-bottom">
                                        <div class="d-flex align-items-center">
                                            <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold me-3 text-uppercase" style="width: 28px; height: 28px; background-color: #ffedd5; color: #ea580c; font-size: 0.8rem; flex-shrink: 0;">
                                                @pCat.Substring(0, 1)
                                            </div>
                                            <span class="fw-bold text-dark fs-6">@pCat</span>
                                        </div>
                                        <button class="btn btn-outline-danger btn-sm border-0 rounded-circle p-1" @onclick="() => DeletePayoutCategory(pCat)" title="Delete @pCat">
                                            <i class="bi bi-trash-fill fs-6"></i>
                                        </button>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            }
            else if (showProfilesTab)
            {
                <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-4 flex-shrink-0">
                    <div>
                        <h2 class="fw-black mb-1"><i class="bi bi-pc-display me-2 text-primary"></i>POS Terminal & Profile Manager</h2>
                        <p class="text-muted small mb-0">Define menu layout profiles and assign them to physical POS terminals.</p>
                    </div>
                    <button class="btn btn-primary rounded-pill px-4 shadow-sm" @onclick="OpenAddProfileModal">
                        <i class="bi bi-plus-lg me-2"></i> Create New Profile
                    </button>
                </div>

                <div class="flex-grow-1 d-flex flex-column overflow-hidden">
                    <!-- Profiles Instruction Card -->
                    <div class="alert alert-info border-0 shadow-sm rounded-4 p-3 mb-4 d-flex align-items-start gap-3 flex-shrink-0" style="background-color: #f0f9ff; border-left: 5px solid #0284c7 !important;">
                        <i class="bi bi-info-circle-fill fs-4 text-info mt-1"></i>
                        <div>
                            <h6 class="fw-black mb-1 text-dark" style="font-size: 0.95rem;">Quick Guide: How Menu Profiles & Station Swapping Work</h6>
                            <ul class="mb-0 text-muted small ps-3">
                                <li class="mb-1"><strong>1. Create a Profile:</strong> Click <em>"Create New Profile"</em> above to create a custom profile (e.g., <em>"Upstairs Bar"</em> or <em>"Patio"</em>).</li>
                                <li class="mb-1"><strong>2. Assign to Stations:</strong> Any physical POS hardware running the GFC app will automatically register here under <em>"POS Terminals"</em>. Pick the profile from the dropdown next to each terminal.</li>
                                <li class="mb-0"><strong>3. Override Menu & Prices:</strong> Choose that profile from the <strong>MENU PROFILE</strong> dropdown at the top-right of this page. Any price overrides, visibility toggles, or category sort changes you make will apply <em>only</em> to that specific profile!</li>
                            </ul>
                        </div>
                    </div>

                    <div class="row flex-grow-1 min-height-0 overflow-hidden g-4" style="min-height: 0;">
                        <!-- Profiles List -->
                        <div class="col-md-6 d-flex flex-column h-100 overflow-hidden">
                            <h5 class="fw-bold mb-3 flex-shrink-0">Menu Profiles</h5>
                            @if (profiles == null)
                            {
                                <div class="text-center py-4"><div class="spinner-border text-primary"></div></div>
                            }
                            else if (!profiles.Any())
                            {
                                <div class="text-muted small py-4">No custom menu profiles created yet. Creating a profile lets you override prices and visibility for a specific station.</div>
                            }
                            else
                            {
                                <div class="flex-grow-1 overflow-y-auto pe-2 scroll-area animate__animated animate__fadeIn">
                                    @foreach (var p in profiles)
                                    {
                                        <div class="list-group-item d-flex justify-content-between align-items-center py-3 border-2 rounded-4 mb-2 shadow-sm bg-white border-primary-subtle" style="border-left: 6px solid var(--bs-primary) !important;">
                                            <div>
                                                <h6 class="fw-bold mb-1">@p.Name</h6>
                                                <span class="badge bg-light text-dark border rounded-pill">Custom Layout & Pricing Override</span>
                                            </div>
                                            <div class="d-flex gap-2">
                                                <button class="btn btn-sm btn-light border rounded-circle" @onclick="() => OpenEditProfileModal(p)" title="Rename Profile"><i class="bi bi-pencil"></i></button>
                                                <button class="btn btn-sm btn-outline-danger rounded-circle" @onclick="() => DeleteProfile(p)" title="Delete Profile"><i class="bi bi-trash"></i></button>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>

                        <!-- Terminals Mapping -->
                        <div class="col-md-6 border-start ps-4 d-flex flex-column h-100 overflow-hidden">
                            <h5 class="fw-bold mb-3 flex-shrink-0">POS Terminals (Auto-Discovered)</h5>
                            @if (terminals == null)
                            {
                                <div class="text-center py-4"><div class="spinner-border text-primary"></div></div>
                            }
                            else if (!terminals.Any())
                            {
                                <div class="text-muted small py-4">No physical POS terminals have registered yet. Terminals appear automatically when they request their menu online.</div>
                            }
                            else
                            {
                                <div class="flex-grow-1 overflow-y-auto pe-2 scroll-area animate__animated animate__fadeIn">
                                    @foreach (var t in terminals)
                                    {
                                        <div class="list-group-item py-3 border-2 rounded-4 mb-3 shadow-sm bg-white border-success-subtle" style="border-left: 6px solid var(--bs-success) !important;">
                                            <div class="d-flex justify-content-between align-items-start mb-2">
                                                <div>
                                                    <h6 class="fw-bold mb-0 text-primary">@t.TerminalName</h6>
                                                    <span class="extra-small text-muted" style="font-size: 0.75rem;">Last Seen: @t.LastSeenAt.ToLocalTime().ToString("g")</span>
                                                </div>
                                                <div class="d-flex align-items-center gap-2">
                                                    <span class="badge bg-success rounded-pill px-2">Online Sync</span>
                                                    <button class="btn btn-outline-danger btn-sm border-0 rounded-circle p-1" @onclick="() => DeleteTerminal(t)" title="Delete Terminal">
                                                        <i class="bi bi-trash-fill fs-6"></i>
                                                    </button>
                                                </div>
                                            </div>
                                            
                                            <div class="d-flex align-items-center gap-2 mt-2 pt-2 border-top">
                                                <span class="small fw-bold text-muted text-uppercase mb-0" style="font-size: 0.7rem;">Assigned Profile:</span>
                                                <select class="form-select form-select-sm rounded-pill px-3 fw-bold border-2" style="width: auto; min-width: 180px;" 
                                                        value="@(t.MenuProfileId ?? 0)" @onchange="@((e) => AssignProfileToTerminal(t, int.Parse(e.Value?.ToString() ?? "0")))">
                                                    <option value="0">Default (Master)</option>
                                                    @if (profiles != null)
                                                    {
                                                        @foreach (var p in profiles)
                                                        {
                                                            <option value="@p.Id">@p.Name</option>
                                                        }
                                                    }
                                                </select>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
            else if (selectedCategory == null)
                {
                    <div class="text-center py-5">
                        <i class="bi bi-grid-3x3-gap fs-1 text-primary opacity-25 mb-3 d-block"></i>
                        <h4 class="fw-bold">Select a Category</h4>
                        <p class="text-muted">Select a category on the left to manage its items and layout.</p>
                    </div>
                }
                else
                {
                    <div class="d-flex justify-content-between align-items-center mb-2 flex-shrink-0">
                        <div>
                            <h2 class="fw-black mb-0 text-uppercase">@selectedCategory.Name</h2>
                            <p class="text-muted small mb-0">Managing items and position for @selectedCategory.Name</p>
                        </div>
                        <div class="d-flex gap-2 align-items-center p-2 bg-light rounded-3 border">
                            <div style="width: 150px;">
                                <label class="small fw-bold text-muted mb-0" style="font-size: 0.65rem;">RENAME CATEGORY</label>
                                <input type="text" class="form-control form-control-sm" @bind="selectedCategory.Name" />
                            </div>
                            <div style="width: 80px;">
                                <label class="small fw-bold text-muted mb-0" style="font-size: 0.65rem;">TAB POS.</label>
                                <input type="number" class="form-control form-control-sm" @bind="selectedCategory.DisplayOrder" />
                            </div>
                            <div style="width: 150px;">
                                <label class="small fw-bold text-muted mb-0" style="font-size: 0.65rem;">MODIFIER CATEGORY?</label>
                                <div class="form-check form-switch mt-1 ms-2">
                                    <input class="form-check-input" type="checkbox" @bind="selectedCategory.IsModifierCategory" />
                                </div>
                            </div>
                            <div style="width: 170px;">
                                <label class="small fw-bold text-muted mb-0" style="font-size: 0.65rem;">INVENTORY POOL</label>
                                <select class="form-select form-select-sm fw-bold" @bind="selectedCategory.InventoryTrackType">
                                    <option value="0">None (No Track)</option>
                                    <option value="1">Liquor Hub</option>
                                    <option value="2">General/Food</option>
                                </select>
                            </div>
                            <div style="width: 185px;">
                                <label class="small fw-bold text-muted mb-0" style="font-size: 0.65rem;">Z-REPORT GROUP</label>
                                <select class="form-select form-select-sm fw-bold" @bind="selectedCategory.ZReportGroup">
                                    <option value="0">Auto (Default)</option>
                                    <option value="1">Food & Non-Alcoholic</option>
                                    <option value="2">Liquor & Alcohol</option>
                                    <option value="3">Excluded / None</option>
                                </select>
                            </div>
                             <button class="btn btn-sm btn-success mt-3 fw-bold px-3 shadow-sm" @onclick="SaveCategoryChanges" title="Save Category Settings">
                                 <i class="bi bi-check-lg me-1"></i> SAVE CHANGES
                             </button>
                             <div class="vr mx-1 mt-3" style="height: 20px;"></div>
                             <button class="btn btn-sm btn-outline-danger mt-3" @onclick="DeleteCategory" title="Delete Category">
                                 <i class="bi bi-trash"></i>
                             </button>
                         </div>
                     </div>
 
                     <div class="extra-small text-muted mb-2 px-3 py-2 bg-light rounded-3 border d-flex align-items-center gap-2 flex-shrink-0" style="font-size: 0.75rem;">
                         <i class="bi bi-info-circle text-primary"></i>
                         <span>
                             Category Inventory Default: 
                             @if (selectedCategory.InventoryTrackType == 0) { <strong class="text-danger">None (Not Tracked)</strong><text> - Items in this category do not appear in any inventory sheets by default.</text> }
                             else if (selectedCategory.InventoryTrackType == 1) { <strong class="text-primary">Liquor Hub</strong><text> - Items in this category default to the Liquor Hub.</text> }
                             else if (selectedCategory.InventoryTrackType == 2) { <strong class="text-success">Food/General Inventory</strong><text> - Items in this category default to the General Inventory page.</text> }
                             <span class="text-danger fw-bold ms-2"><i class="bi bi-exclamation-triangle-fill me-1"></i>Click "SAVE CHANGES" above to apply your edits!</span>
                         </span>
                     </div>
 
                     <div class="d-flex justify-content-between align-items-center mb-2 flex-shrink-0">
                        @if (!isLoadingItems)
                        {
                            @if (selectedCategory.IsModifierCategory)
                            {
                                <button class="btn btn-primary rounded-pill px-4 fw-bold shadow-sm" @onclick="OpenAddModifierModal" style="background: #7c3aed; border-color: #7c3aed;">
                                    <i class="bi bi-plus-lg me-2"></i> DESIGNATE MAPPED MODIFIER FOR @selectedCategory.Name.ToUpper()
                                </button>
                            }
                            else if (categoryItems != null)
                            {
                                <button class="btn btn-primary rounded-pill px-4 fw-bold shadow-sm" @onclick="OpenAddItemModal">
                                    <i class="bi bi-plus-lg me-2"></i> ADD NEW ITEM TO @selectedCategory.Name.ToUpper()
                                </button>
                            }
                        }
                        <div class="ms-auto d-flex gap-3 align-items-center">
                             <div class="form-check form-switch mb-0 d-flex align-items-center gap-2">
                                 <input class="form-check-input" type="checkbox" id="showArchivedSwitch" checked="@showArchived" @onchange="ToggleShowArchived" style="cursor: pointer; width: 36px; height: 18px;" />
                                 <label class="form-check-label small fw-bold text-muted text-uppercase mb-0" for="showArchivedSwitch" style="cursor: pointer; select-layout: none; line-height: 1;">Show Archived Items</label>
                             </div>
                            @if (!string.IsNullOrWhiteSpace(searchQuery))
                            {
                                <span class="badge bg-light text-dark border px-3 py-2 rounded-pill">Showing matching items</span>
                            }
                        </div>
                    </div>

                    <div class="flex-grow-1 overflow-y-auto pe-2 scroll-area">
                        @if (isLoadingItems)
                        {
                            <div class="text-center py-5"><div class="spinner-border text-primary"></div></div>
                        }
                        else if (selectedCategory.IsModifierCategory)
                        {
                            <div class="alert border-0 rounded-4 p-3 mb-3 small" style="background-color: #faf5ff; border-left: 5px solid #7c3aed !important; color: #581c87;">
                                <div class="d-flex gap-2">
                                    <i class="bi bi-info-circle-fill fs-5" style="color: #7c3aed;"></i>
                                    <div>
                                        <h6 class="fw-bold mb-1" style="color: #4c1d95;">Modifier Category Enabled</h6>
                                        <p class="mb-0 opacity-90">Items in this category act as customizable add-ons or upsell choices (e.g., <em>"Splash of Juice"</em> or <em>"Extra Shot"</em>) mapped from existing inventory or custom definitions. When terminal operators select menu items, these options allow rapid, structured upcharging and dynamic stock deduction.</p>
                                    </div>
                                </div>
                            </div>

                            @if (mappedModifiers == null || !mappedModifiers.Any())
                            {
                                <div class="text-center py-5">
                                    <i class="bi bi-plus-circle-dotted fs-1 text-muted opacity-25"></i>
                                    <h5 class="mt-3">No Mapped Modifiers Designated</h5>
                                    <p class="text-muted">Click the button above to select items from your existing inventory list as add-ons.</p>
                                </div>
                            }
                            else
                            {
                                <table class="table table-hover align-middle sticky-header">
                                    <thead class="table-light">
                                        <tr>
                                            <th class="py-3 px-4 text-muted small fw-bold text-uppercase">Item Name</th>
                                            <th class="py-3 px-4 text-muted small fw-bold text-uppercase text-center">Add-on Display Name</th>
                                            <th class="py-3 px-4 text-muted small fw-bold text-uppercase text-center">Eligible Categories</th>
                                            <th class="py-3 px-4 text-muted small fw-bold text-uppercase text-center" style="width: 150px;">Price Override</th>
                                            <th class="py-3 px-4 text-muted small fw-bold text-uppercase text-center" style="width: 150px;">Stock Deduction</th>
                                            <th class="text-end px-4">Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var mod in mappedModifiers)
                                        {
                                            var baseItem = allItemsForTokens?.FirstOrDefault(i => i.Id == mod.ItemId);
                                            <tr>
                                                <td class="py-2 px-4 fw-bold">@(baseItem?.Name ?? (mod.ItemId < 0 ? "CUSTOM NON-INVENTORY" : "UNKNOWN ITEM"))</td>
                                                <td class="py-2 px-4 text-center">
                                                    <input type="text" class="form-control form-control-sm fw-bold text-primary text-center mx-auto"
                                                           value="@mod.Name"
                                                           @onchange="@((e) => UpdateModifierName(mod, e.Value))"
                                                           style="max-width: 200px;" />
                                                </td>
                                                <td class="py-2 px-4 text-center">
                                                    <div class="dropdown">
                                                        <button class="btn btn-sm btn-outline-secondary dropdown-toggle rounded-pill w-100" type="button" data-bs-toggle="dropdown" aria-expanded="false" style="max-width: 250px;">
                                                            @{
                                                                var selectedCats = string.IsNullOrEmpty(mod.EligibleCategories) 
                                                                    ? "All Categories" 
                                                                    : string.Join(", ", mod.EligibleCategories.Split(',', StringSplitOptions.RemoveEmptyEntries).Select(c => c.Trim()));
                                                            }
                                                            <span class="text-truncate d-inline-block align-middle" style="max-width: 180px;">@selectedCats</span>
                                                        </button>
                                                        <div class="dropdown-menu p-3" style="min-width: 220px; max-height: 250px; overflow-y: auto; z-index: 1050;">
                                                            @if (categories != null)
                                                            {
                                                                @foreach (var cat in categories.Where(c => !c.IsModifierCategory))
                                                                {
                                                                    var catUpper = cat.Name.Trim().ToUpper();
                                                                    var isChecked = !string.IsNullOrEmpty(mod.EligibleCategories) && 
                                                                                    mod.EligibleCategories.Split(',', StringSplitOptions.RemoveEmptyEntries)
                                                                                        .Select(c => c.Trim().ToUpper())
                                                                                        .Contains(catUpper);
                                                                    <div class="form-check mb-1 text-start">
                                                                        <input class="form-check-input" type="checkbox" id="tblcat_@(mod.ItemId)_@(cat.Id)" 
                                                                               checked="@isChecked" 
                                                                               @onchange="@((e) => ToggleTableModifierCategory(mod, cat.Name, e.Value))" />
                                                                        <label class="form-check-label small fw-bold" for="tblcat_@(mod.ItemId)_@(cat.Id)">@cat.Name</label>
                                                                    </div>
                                                                }
                                                            }
                                                        </div>
                                                    </div>
                                                </td>
                                                <td class="py-2 px-4">
                                                    <div class="input-group input-group-sm mx-auto" style="width: 110px;">
                                                        <span class="input-group-text">$</span>
                                                        <input type="number" step="0.01" class="form-control text-center fw-bold"
                                                               value="@mod.Price"
                                                               @onchange="@((e) => UpdateModifierPrice(mod, e.Value))" />
                                                    </div>
                                                </td>
                                                <td class="py-2 px-4">
                                                    @if (mod.ItemId > 0)
                                                    {
                                                        <div class="input-group input-group-sm mx-auto" style="width: 110px;">
                                                            <input type="number" step="0.1" class="form-control text-center fw-bold"
                                                                   value="@mod.PourSize"
                                                                   @onchange="@((e) => UpdateModifierPourSize(mod, e.Value))" />
                                                            <span class="input-group-text">@(baseItem?.IsUnitBased == true ? "btl" : "oz")</span>
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <div class="text-center text-muted small">N/A</div>
                                                    }
                                                </td>
                                                <td class="py-2 px-4 text-end">
                                                    <button class="btn btn-sm btn-outline-danger rounded-circle p-1 border-0" @onclick="() => RemoveModifierFromCategory(mod)">
                                                        <i class="bi bi-trash fs-5"></i>
                                                    </button>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            }
                        }
                        else if (categoryItems == null || !categoryItems.Any())
                        {
                            <div class="text-center py-5">
                                <i class="bi bi-box2-heart fs-1 text-muted opacity-25"></i>
                                <h5 class="mt-3">No Items Found</h5>
                                <p class="text-muted">Try using a different name or adding items for this category.</p>
                                <button class="btn btn-primary rounded-pill px-4 fw-bold shadow-sm mt-3" @onclick="OpenAddItemModal">
                                    <i class="bi bi-plus-lg me-2"></i> Add First Item
                                </button>
                            </div>
                        }
                        else
                        {
                            <table class="table table-hover align-middle sticky-header">
                                    <thead class="table-light">
                                        <tr>
                                            <th class="py-3 px-4 text-muted small fw-bold text-uppercase" style="width: 100px;">Sort</th>
                                            <th class="py-3 px-4 text-muted small fw-bold text-uppercase">Name</th>
                                            <th class="py-3 px-4 text-muted small fw-bold text-uppercase text-center">Retail Price</th>
                                            <th class="py-3 px-4 text-muted small fw-bold text-uppercase text-center">Current Cat</th>
                                            <th class="py-3 px-4 text-muted small fw-bold text-uppercase text-center" style="width: 110px;">Sold by Unit</th>
                                            <th class="py-3 px-4 text-muted small fw-bold text-uppercase text-center" style="width: 100px;">Pack Size</th>
                                            <th class="py-3 px-4 text-muted small fw-bold text-uppercase text-center" style="width: 110px;">Loose Audit</th>
                                            <th class="py-3 px-4 text-muted small fw-bold text-uppercase text-center" style="width: 180px;">Inventory Override</th>
                                            <th class="py-3 px-4 text-muted small fw-bold text-uppercase text-center" style="width: 185px;">Z-Report Group</th>
                                            <th class="py-3 px-4 text-muted small fw-bold text-uppercase text-center">Show in POS</th>
                                            <th class="text-end px-4">Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in categoryItems.OrderBy(i => i.DisplayOrder).ThenBy(i => i.Name).Where(i => string.IsNullOrWhiteSpace(searchQuery) || i.Name.Contains(searchQuery, StringComparison.OrdinalIgnoreCase)))
                                        {
                                             <tr class="@(!item.IsActive ? "bg-warning-subtle" : "")">
                                                <td class="py-2 px-4">
                                                    <input type="number" class="form-control form-control-sm text-center fw-bold" 
                                                           value="@item.DisplayOrder" 
                                                           @onchange="@((e) => UpdateItemOrder(item, e.Value))"
                                                           style="width: 60px; background: #f8fafc;" />
                                                </td>
                                                <td class="py-2 px-4 fw-bold">
                                                    @item.Name
                                                    @if (!item.IsActive)
                                                    {
                                                         <span class="badge bg-danger rounded-pill extra-small ms-2" style="font-size: 0.6rem;">INACTIVE IN HUB</span>
                                                    }
                                                </td>
                                                <td class="py-2 px-4 text-center">
                                                    @if (selectedProfileId > 0)
                                                    {
                                                        <div class="input-group input-group-sm mx-auto" style="width: 100px;">
                                                            <span class="input-group-text">$</span>
                                                            <input type="number" step="0.01" class="form-control text-center fw-bold" 
                                                                   value="@item.RetailPrice" 
                                                                   @onchange="@((e) => UpdateItemOverridePrice(item, e.Value))" />
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        @item.RetailPrice.ToString("C")
                                                    }
                                                </td>
                                                <td class="py-2 px-4 text-center text-muted small">@item.Category</td>
                                                <td class="py-2 px-4 text-center">
                                                    @if (item.ParentItemId.HasValue)
                                                    {
                                                        <span class="text-muted small">N/A</span>
                                                    }
                                                    else
                                                    {
                                                        <div class="form-check form-switch d-flex justify-content-center">
                                                            <input class="form-check-input" type="checkbox" checked="@item.IsUnitBased" 
                                                                   @onchange="(e) => ToggleIsUnitBased(item, e.Value)" />
                                                        </div>
                                                    }
                                                </td>
                                                <td class="py-2 px-4 text-center fw-bold text-muted small">
                                                    @(item.ParentItemId.HasValue ? "N/A" : item.PackSize.ToString())
                                                </td>
                                                <td class="py-2 px-4 text-center">
                                                    @if (item.ParentItemId.HasValue)
                                                    {
                                                        <span class="text-muted small">N/A</span>
                                                    }
                                                    else if (item.PackSize > 1)
                                                    {
                                                        <div class="form-check form-switch d-flex justify-content-center">
                                                            <input class="form-check-input" type="checkbox" checked="@item.AllowLooseReconciliation" 
                                                                   @onchange="(e) => ToggleAllowLooseReconciliation(item, e.Value)" />
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted small">N/A</span>
                                                    }
                                                </td>
                                                <td class="py-2 px-4 text-center">
                                                    @if (item.ParentItemId.HasValue)
                                                    {
                                                        <span class="text-muted small">N/A</span>
                                                    }
                                                    else
                                                    {
                                                        <select class="form-select form-select-sm fw-bold border-2" 
                                                                value="@item.InventoryTrackType" 
                                                                @onchange="@((e) => UpdateItemInventoryTrackType(item, e.Value))">
                                                            <option value="0">Inherited</option>
                                                            <option value="1">None (No Track)</option>
                                                            <option value="2">Liquor Hub</option>
                                                            <option value="3">General/Food</option>
                                                        </select>
                                                    }
                                                </td>
                                                <td class="py-2 px-4 text-center">
                                                    @if (item.ParentItemId.HasValue)
                                                    {
                                                        <span class="text-muted small">N/A</span>
                                                    }
                                                    else
                                                    {
                                                        <select class="form-select form-select-sm fw-bold border-2" 
                                                                value="@item.ZReportGroup" 
                                                                @onchange="@((e) => UpdateItemZReportGroup(item, e.Value))">
                                                            <option value="0">Inherited</option>
                                                            <option value="1">Food & Non-Alcoholic</option>
                                                            <option value="2">Liquor & Alcohol</option>
                                                            <option value="3">Excluded / None</option>
                                                        </select>
                                                    }
                                                </td>
                                                <td class="py-2 px-4 text-center">
                                                    <div class="form-check form-switch d-flex justify-content-center">
                                                        <input class="form-check-input" type="checkbox" checked="@item.ShowInPos" 
                                                               @onchange="(e) => ToggleShowInPos(item, e.Value)" />
                                                    </div>
                                                </td>
                                                <td class="py-2 px-4 text-end">
                                                    <button class="btn btn-sm btn-light border rounded-pill px-3" @onclick="() => OpenEditItemModal(item)">Edit</button>
                                                </td>
                                             </tr>
                                        }
                                    </tbody>
                            </table>
                        }
                    </div>

                }
            </div>
        </div>
    </div>
}
</div>

@if (editingProfile != null)
{
    <div class="modal fade show" tabindex="-1" style="display: block; background: rgba(0,0,0,0.5);" role="dialog">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg rounded-4">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold">@(editingProfile.Id == 0 ? "Create Menu Profile" : "Edit Profile Name")</h5>
                    <button type="button" class="btn-close" @onclick="() => editingProfile = null"></button>
                </div>
                <div class="modal-body py-4">
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-muted text-uppercase">Profile Name</label>
                        <input type="text" class="form-control form-control-lg rounded-3 border-2" 
                               @bind="editingProfile.Name" placeholder="e.g. Patio Bar, Beach Bar..." />
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light rounded-pill px-4" @onclick="() => editingProfile = null">Cancel</button>
                    <button type="button" class="btn btn-primary rounded-pill px-4 shadow-sm" @onclick="SaveProfile">Save Profile</button>
                </div>
            </div>
        </div>
    </div>
}

@if (showAddModifierModal)
{
    <div class="modal fade show" tabindex="-1" style="display: block; background: rgba(0,0,0,0.5);" role="dialog">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg rounded-4">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold" style="color: #7c3aed;"><i class="bi bi-plus-circle-fill me-2"></i>Designate Add-on Modifier</h5>
                    <button type="button" class="btn-close" @onclick="() => showAddModifierModal = false"></button>
                </div>
                <div class="modal-body py-4">
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-muted text-uppercase">Select Existing Item</label>
                        <select class="form-select rounded-3 border-2" @onchange="@((e) => OnAddModifierItemChanged(int.Parse(e.Value?.ToString() ?? "0")))">
                            <option value="0">-- Select Inventory Product --</option>
                            <option value="-1" style="font-weight: bold; color: #7c3aed;">[+ CREATE CUSTOM ADD-ON (NON-INVENTORY) ]</option>
                            @if (allItemsForTokens != null)
                            {
                                @foreach (var item in allItemsForTokens.OrderBy(i => i.Name))
                                {
                                    <option value="@item.Id">@item.Name (@(item.Category ?? "Uncategorized"))</option>
                                }
                            }
                        </select>
                    </div>
                    @if (selectedModifierItemId != 0)
                    {
                        var selectedItemObj = selectedModifierItemId < 0 ? null : allItemsForTokens?.FirstOrDefault(i => i.Id == selectedModifierItemId);
                        <div class="mb-3">
                            <label class="form-label small fw-bold text-muted text-uppercase">Add-on Display Name</label>
                            <input type="text" class="form-control rounded-3" @bind="newModifierName" placeholder="e.g. Splash of Red Bull" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-bold text-muted text-uppercase">Eligible Categories</label>
                            <div class="d-flex flex-wrap gap-2 p-3 border rounded-3 bg-light" style="max-height: 150px; overflow-y: auto;">
                                @if (categories != null)
                                {
                                    @foreach (var cat in categories.Where(c => !c.IsModifierCategory))
                                    {
                                        var catUpper = cat.Name.Trim().ToUpper();
                                        var isChecked = newModifierEligibleCategoriesList.Contains(catUpper);
                                        <div class="form-check me-3 mb-2">
                                            <input class="form-check-input" type="checkbox" id="addcat_@cat.Id" 
                                                   checked="@isChecked" 
                                                   @onchange="@((e) => ToggleNewModifierCategory(cat.Name, e.Value))" />
                                            <label class="form-check-label small fw-bold" for="addcat_@cat.Id">@cat.Name</label>
                                        </div>
                                    }
                                }
                            </div>
                            <span class="extra-small text-muted d-block mt-1">Select the categories this modifier applies to. If none are selected, it applies to all categories.</span>
                        </div>
                        <div class="row g-3">
                            <div class="col-6">
                                <label class="form-label small fw-bold text-muted text-uppercase">Add-on Price Override</label>
                                <div class="input-group">
                                    <span class="input-group-text">$</span>
                                    <input type="number" step="0.01" class="form-control" @bind="newModifierPrice" />
                                </div>
                            </div>
                            @if (selectedModifierItemId > 0)
                            {
                                <div class="col-6">
                                    <label class="form-label small fw-bold text-muted text-uppercase">Stock Deduction Qty</label>
                                    <div class="input-group">
                                        <input type="number" step="0.1" class="form-control" @bind="newModifierPourSize" />
                                        <span class="input-group-text">@(selectedItemObj?.IsUnitBased == true ? "btl" : "oz")</span>
                                    </div>
                                    <span class="extra-small text-muted d-block mt-1">Def: @(selectedItemObj?.IsUnitBased == true ? "1.0 btl" : $"{selectedItemObj?.PourSize} oz")</span>
                                </div>
                            }
                            else
                            {
                                <div class="col-6">
                                    <label class="form-label small fw-bold text-muted text-uppercase">Stock Tracking</label>
                                    <div class="form-control bg-light text-muted border-0 small">No stock link (Custom)</div>
                                </div>
                            }
                        </div>
                    }
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light rounded-pill px-4" @onclick="() => showAddModifierModal = false">Cancel</button>
                    <button type="button" class="btn btn-primary rounded-pill px-4" style="background: #7c3aed; border-color: #7c3aed;"
                            @onclick="SaveNewModifier" disabled="@(selectedModifierItemId == 0 || string.IsNullOrWhiteSpace(newModifierName))">
                        Designate Modifier
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@if (showAddCatModal)
{
    <div class="modal fade show" tabindex="-1" style="display: block; background: rgba(0,0,0,0.5);" role="dialog">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg rounded-4">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold">Add New Category</h5>
                    <button type="button" class="btn-close" @onclick="() => showAddCatModal = false"></button>
                </div>
                <div class="modal-body py-4">
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-muted text-uppercase">Category Name</label>
                        <input type="text" class="form-control form-control-lg rounded-3 border-2" 
                               @bind="newCategoryName" placeholder="e.g. BEERS, LIQUOR, SNACKS..." />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-muted text-uppercase">Display Order</label>
                        <input type="number" class="form-control rounded-3" @bind="newCategoryOrder" />
                    </div>
                    <div class="form-check form-switch mt-2">
                        <input class="form-check-input" type="checkbox" id="newCatModifierSwitch" @bind="newCategoryIsModifier" />
                        <label class="form-check-label fw-bold small text-muted text-uppercase" for="newCatModifierSwitch">Treat as Modifier / Add-on Category</label>
                    </div>
                    <div class="mb-3 mt-3">
                        <label class="form-label small fw-bold text-muted text-uppercase">Inventory Tracking Default</label>
                        <select class="form-select rounded-3 border-2 fw-bold" @bind="newCategoryInventoryType">
                            <option value="0">None (Do Not Track)</option>
                            <option value="1">Liquor Hub (Drinks/Beer)</option>
                            <option value="2">Food/General Inventory (Kitchen/Merch)</option>
                        </select>
                        <span class="text-muted d-block mt-1" style="font-size: 0.7rem; line-height: 1.25;">
                            @if (newCategoryInventoryType == 0) { <text>Items in this category will not be tracked in any inventory sheets by default.</text> }
                            else if (newCategoryInventoryType == 1) { <text>Items will default to tracking under the Liquor Hub (Ordering, Audits, yields).</text> }
                            else if (newCategoryInventoryType == 2) { <text>Items will default to tracking under the General Inventory sheet (Food, Merch, supplies).</text> }
                        </span>
                    </div>
                    <div class="extra-small text-muted mt-1 bg-light p-2 rounded border" style="font-size: 0.75rem; line-height: 1.35;">
                        <i class="bi bi-info-circle-fill text-primary me-1"></i> Modifiers are custom add-ons/upcharges (e.g. <em>Double Pour</em> or <em>Splash of Red Bull</em>) that prompt during regular drink selection rather than appearing as standalone sales products. They allow custom pricing and physical stock deductions.
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light rounded-pill px-4" @onclick="() => showAddCatModal = false">Cancel</button>
                    <button type="button" class="btn btn-primary rounded-pill px-4" 
                            @onclick="SaveNewCategory" disabled="@string.IsNullOrWhiteSpace(newCategoryName)">
                        Save Category
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@if (editingItem != null)
{
    <div class="modal fade show" tabindex="-1" style="display: block; background: rgba(0,0,0,0.5);" role="dialog">
        <div class="modal-dialog modal-dialog-centered @(showFullInventoryDetails ? "modal-lg" : "")">
            <div class="modal-content border-0 shadow-lg rounded-4">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold">@(editingItem.Id == 0 ? "Add Item" : "Edit Item")</h5>
                    <button type="button" class="btn-close" @onclick="() => editingItem = null"></button>
                </div>
                <div class="modal-body py-4">
                    <!-- Toggle switch for Minimum vs Full details -->
                    <div class="form-check form-switch bg-light p-3 rounded-3 border mb-4 d-flex justify-content-between align-items-center">
                        <label class="form-check-label fw-bold text-dark mb-0" for="fullInventoryDetailsSwitch" style="cursor: pointer;">
                            <i class="bi bi-list-task text-primary me-2"></i> Show Full Inventory Details
                        </label>
                        <input class="form-check-input ms-0" type="checkbox" id="fullInventoryDetailsSwitch" @bind="showFullInventoryDetails" style="width: 40px; height: 20px; cursor: pointer;" />
                    </div>

                    @if (!showFullInventoryDetails)
                    {
                        <!-- Minimum Details Layout -->
                        <div class="mb-3">
                            <label class="form-label small fw-bold text-muted text-uppercase">Item Name</label>
                            <input type="text" class="form-control rounded-3 border-2" @bind="editingItem.Name" />
                        </div>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label class="form-label small fw-bold text-muted text-uppercase">Category</label>
                                    <select class="form-select border-2" @bind="editingItem.Category">
                                        <option value="">-- NO CATEGORY --</option>
                                        @if (categories != null)
                                        {
                                            @foreach (var cat in categories)
                                            {
                                                <option value="@cat.Name">@cat.Name</option>
                                            }
                                        }
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label class="form-label small fw-bold text-muted text-uppercase">Inventory Override</label>
                                    <select class="form-select border-2 fw-bold" @bind="editingItem.InventoryTrackType">
                                        <option value="0">Inherit Category Setting</option>
                                        <option value="1">None (Do Not Track)</option>
                                        <option value="2">Track in Liquor Hub</option>
                                        <option value="3">Track in General/Food</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        @if (editingItem.Category?.Trim().ToUpper() == "WINE")
                        {
                            <div class="card border-primary border-opacity-25 bg-light p-3 rounded-4 mb-3">
                                <h6 class="fw-bold text-primary mb-2.5"><i class="bi bi-funnel"></i> Wine Serve Configurations</h6>
                                
                                <div class="table-responsive bg-white rounded-3 border p-2">
                                    <table class="table table-sm table-borderless align-middle mb-0" style="font-size: 0.8rem;">
                                        <thead>
                                            <tr class="border-bottom text-muted" style="font-size: 0.75rem;">
                                                <th style="width: 25%;">SERVE OPTION</th>
                                                <th style="width: 45%;">HOW IT TRACKS STOCK</th>
                                                <th style="width: 15%;" class="text-end">PRICE ($)</th>
                                                <th style="width: 15%;" class="text-end">SIZE</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <!-- 1. Sell by Glass -->
                                            <tr class="border-bottom">
                                                <td>
                                                    <div class="form-check form-switch mb-0">
                                                        <input class="form-check-input" type="checkbox" id="sellByGlassCheck" @bind="sellByGlass" disabled="@editingItem.IsUnitBased" />
                                                        <label class="form-check-label fw-bold text-dark" for="sellByGlassCheck">Sell by Glass</label>
                                                    </div>
                                                </td>
                                                <td>
                                                    <span class="text-muted extra-small d-block" style="font-size: 0.7rem; line-height: 1.2;">
                                                        POS sells <strong>(Glass)</strong> menu item. Deducts 1 bottle when ounces sold equal a bottle.
                                                    </span>
                                                </td>
                                                <td class="text-end">
                                                    <input type="number" step="0.01" class="form-control form-control-sm text-end" style="width: 80px; display: inline-block;" @bind="glassPrice" disabled="@(!sellByGlass || editingItem.IsUnitBased)" placeholder="0.00" />
                                                </td>
                                                <td class="text-end">
                                                    <div class="input-group input-group-sm" style="width: 90px; display: inline-flex;">
                                                        <input type="number" step="0.1" class="form-control text-end" @bind="glassPourSize" disabled="@(!sellByGlass || editingItem.IsUnitBased)" />
                                                        <span class="input-group-text" style="font-size: 0.65rem; padding: 0.25rem 0.4rem;">oz</span>
                                                    </div>
                                                </td>
                                            </tr>

                                            <!-- 2. Sell by Bottle -->
                                            <tr class="border-bottom">
                                                <td>
                                                    <div class="form-check form-switch mb-0">
                                                        <input class="form-check-input" type="checkbox" id="sellByBottleCheck" @bind="sellByBottle" disabled="@editingItem.IsUnitBased" />
                                                        <label class="form-check-label fw-bold text-dark" for="sellByBottleCheck">Sell by Bottle</label>
                                                    </div>
                                                </td>
                                                <td>
                                                    <span class="text-muted extra-small d-block" style="font-size: 0.7rem; line-height: 1.2;">
                                                        POS sells full bottle. Deducts 1 bottle directly from stock per sale.
                                                    </span>
                                                </td>
                                                <td class="text-end">
                                                    <input type="number" step="0.01" class="form-control form-control-sm text-end" style="width: 80px; display: inline-block;" @bind="bottlePrice" disabled="@(!sellByBottle || editingItem.IsUnitBased)" placeholder="0.00" />
                                                </td>
                                                <td class="text-end">
                                                    <div class="input-group input-group-sm" style="width: 90px; display: inline-flex;">
                                                        <input type="number" class="form-control text-end" @bind="bottleVolumeMl" disabled="@(!sellByBottle || editingItem.IsUnitBased)" />
                                                        <span class="input-group-text" style="font-size: 0.65rem; padding: 0.25rem 0.4rem;">ml</span>
                                                    </div>
                                                </td>
                                            </tr>

                                            <!-- 3. Single-Serve Split -->
                                            <tr>
                                                <td>
                                                    <div class="form-check form-switch mb-0">
                                                        <input class="form-check-input" type="checkbox" id="isWineSingleServe" @bind="editingItem.IsUnitBased" />
                                                        <label class="form-check-label fw-bold text-primary" for="isWineSingleServe">Single-Serve Split</label>
                                                    </div>
                                                </td>
                                                <td>
                                                    <span class="text-muted extra-small d-block" style="font-size: 0.7rem; line-height: 1.2;">
                                                        Pre-packaged split (e.g. 187ml). Deducts 1 unit per sale (disables glass tracking).
                                                    </span>
                                                </td>
                                                <td class="text-end">
                                                    <input type="number" step="0.01" class="form-control form-control-sm text-end" style="width: 80px; display: inline-block;" @bind="bottlePrice" disabled="@(!editingItem.IsUnitBased)" placeholder="0.00" />
                                                </td>
                                                <td class="text-end">
                                                    <input type="text" class="form-control form-control-sm text-end" style="width: 90px; display: inline-block;" @bind="editingItem.BottleSize" placeholder="e.g. 187ml" disabled="@(!editingItem.IsUnitBased)" />
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label class="form-label small fw-bold text-muted text-uppercase">Retail Price</label>
                                        <div class="input-group">
                                            <span class="input-group-text">$</span>
                                            <input type="number" step="0.01" class="form-control" @bind="editingItem.RetailPrice" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="form-check form-switch mt-2 mb-3">
                                <input class="form-check-input" type="checkbox" id="showInPosSwitch" @bind="editingItem.ShowInPos" />
                                <label class="form-check-label fw-bold small text-muted text-uppercase" for="showInPosSwitch">Show in POS Terminal</label>
                            </div>
                        }

                        <div class="extra-small text-muted mb-3 bg-light p-2 rounded-3 border" style="font-size: 0.75rem; line-height: 1.35;">
                            <i class="bi bi-info-circle-fill text-primary me-1"></i>
                            <span>
                                @if (editingItem.InventoryTrackType == 0)
                                {
                                    var matchedCat = categories?.FirstOrDefault(c => c.Name.Equals(editingItem.Category, StringComparison.OrdinalIgnoreCase));
                                    <text>Currently inheriting default tracking: </text>
                                    @if (matchedCat == null || matchedCat.InventoryTrackType == 0) { <strong class="text-danger">None (Not Tracked)</strong> }
                                    else if (matchedCat.InventoryTrackType == 1) { <strong class="text-primary">Liquor Hub</strong> }
                                    else if (matchedCat.InventoryTrackType == 2) { <strong class="text-success">Food/General Inventory</strong> }
                                }
                                else if (editingItem.InventoryTrackType == 1) { <strong class="text-danger">None (Do Not Track)</strong><text> - Excluded from all stock lists.</text> }
                                else if (editingItem.InventoryTrackType == 2) { <strong class="text-primary">Liquor Hub</strong><text> - Overridden to track in Liquor Hub.</text> }
                                else if (editingItem.InventoryTrackType == 3) { <strong class="text-success">Food/General</strong><text> - Overridden to track in General Inventory.</text> }
                            </span>
                        </div>
                    }
                    else
                    {
                        <!-- Full Inventory Details Layout (Liquor Hub Style) -->
                        <div class="row g-3">
                            <div class="col-md-8">
                                <label class="small fw-bold text-muted mb-1">Product Name</label>
                                <input type="text" class="form-control rounded-pill border-2" @bind="editingItem.Name" placeholder="e.g. Grey Goose" />
                            </div>
                            <div class="col-md-4">
                                <label class="small fw-bold text-muted mb-1">Bottle/Can Size</label>
                                <select class="form-select rounded-pill border-2" @bind="editingItem.BottleSize">
                                    <option value="">-- Choose Size --</option>
                                    <option value="50ml">50ml</option>
                                    <option value="187ml">187ml</option>
                                    <option value="355ml">355ml</option>
                                    <option value="375ml">375ml</option>
                                    <option value="750ml">750ml</option>
                                    <option value="1L">1L</option>
                                    <option value="1.75L">1.75L</option>
                                    <option value="12oz">12oz (Can/Bottle)</option>
                                    <option value="16oz">16oz (Pint)</option>
                                </select>
                            </div>
                            
                            <div class="col-md-6">
                                <label class="small fw-bold text-muted mb-1">Category</label>
                                <select class="form-select rounded-pill border-2" @bind="editingItem.Category">
                                    <option value="">-- NO CATEGORY --</option>
                                    @if (categories != null)
                                    {
                                        @foreach (var cat in categories)
                                        {
                                            <option value="@cat.Name">@cat.Name</option>
                                        }
                                    }
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="small fw-bold text-muted mb-1">Inventory Override</label>
                                <select class="form-select rounded-pill border-2 fw-bold" @bind="editingItem.InventoryTrackType">
                                    <option value="0">Inherit Category Setting</option>
                                    <option value="1">None (Do Not Track)</option>
                                    <option value="2">Track in Liquor Hub</option>
                                    <option value="3">Track in General/Food</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="small fw-bold text-muted mb-1">Z-Report Group Override</label>
                                <select class="form-select rounded-pill border-2 fw-bold" @bind="editingItem.ZReportGroup">
                                    <option value="0">Inherit Category Default</option>
                                    <option value="1">Food & Non-Alcoholic</option>
                                    <option value="2">Liquor & Alcohol</option>
                                    <option value="3">Excluded / None</option>
                                </select>
                            </div>

                            <div class="col-md-6">
                                <label class="small fw-bold text-muted mb-1">Pack Size</label>
                                <input type="number" class="form-control rounded-pill border-2" onfocus="this.select();" @bind="editingItem.PackSize" />
                            </div>
                            <div class="col-md-6">
                                <label class="small fw-bold text-muted mb-1">Primary Vendor</label>
                                <select class="form-select rounded-pill border-2" @bind="editingItem.VendorId">
                                    <option value="">-- No Vendor --</option>
                                    @if (vendors != null)
                                    {
                                        @foreach (var v in vendors) { <option value="@v.Id">@v.Name</option> }
                                    }
                                </select>
                            </div>

                            <div class="col-12">
                                <div class="form-check form-switch bg-light p-3 rounded-pill border ms-0">
                                    <input class="form-check-input ms-0 me-2" type="checkbox" id="isUnitBasedNew" @bind="editingItem.IsUnitBased">
                                    <label class="form-check-label fw-bold text-dark small" for="isUnitBasedNew">
                                        Sold by Unit (e.g., Red Bull, High Noon, Beer)
                                    </label>
                                </div>
                            </div>

                            @if (editingItem.IsUnitBased)
                            {
                                <div class="col-12">
                                     <div class="alert alert-info rounded-4 border-0 d-flex align-items-center gap-3 py-3 mb-2 animate-fade-in shadow-sm">
                                         <div class="bg-white p-2 rounded-3 text-info shadow-sm">
                                             <i class="bi bi-box-seam-fill fs-5"></i>
                                         </div>
                                         <div>
                                             <div class="fw-black text-uppercase text-info mb-1" style="font-size: 0.65rem;">Pack Size Required</div>
                                             <p class="mb-0 text-muted fw-bold" style="font-size: 0.6rem; line-height: 1.2;">Please specify how many individual units come in a case (e.g. 24 for beer cases) in the Pack Size field above.</p>
                                         </div>
                                     </div>
                                </div>
                            }

                            <div class="col-md-6">
                                <label class="small fw-bold text-muted mb-1">Min Stock Limit</label>
                                <input type="number" class="form-control rounded-pill border-2" onfocus="this.select();" @bind="editingItem.MinStockLimit" />
                            </div>
                            <div class="col-md-6">
                                <label class="small fw-bold text-muted mb-1">Bottle/Case Cost ($)</label>
                                <input type="number" class="form-control rounded-pill border-2" onfocus="this.select();" @bind="editingItem.CurrentPrice" step="0.01" />
                            </div>

                            <div class="col-md-6">
                                <label class="small fw-bold text-muted mb-1">Min Order Qty</label>
                                <input type="number" class="form-control rounded-pill border-2" onfocus="this.select();" @bind="editingItem.MinimumOrderQuantity" />
                            </div>
                            <div class="col-md-6">
                                <label class="small fw-bold text-muted mb-1">Drink Price (Retail Price) ($)</label>
                                <input type="number" class="form-control rounded-pill border-2" onfocus="this.select();" @bind="editingItem.RetailPrice" step="0.01" />
                            </div>

                            <div class="col-md-6">
                                <label class="small fw-bold text-muted mb-1">Shot oz</label>
                                <input type="number" class="form-control rounded-pill border-2" onfocus="this.select();" @bind="editingItem.PourSize" step="0.1" disabled="@editingItem.IsUnitBased" />
                            </div>
                            @if (editingItem.PackSize > 1)
                            {
                                <div class="col-md-6 d-flex align-items-end">
                                    <div class="form-check form-switch bg-light p-3 rounded-pill border ms-0 w-100">
                                        <input class="form-check-input ms-0 me-2" type="checkbox" id="allowLooseNew" @bind="editingItem.AllowLooseReconciliation">
                                        <label class="form-check-label fw-bold text-dark small" for="allowLooseNew">
                                            Allow Loose (Bottles) Audit
                                        </label>
                                    </div>
                                </div>
                            }

                            <div class="col-12 mt-2">
                                <div class="bg-light p-3 rounded-4 border">
                                    <div class="form-check form-switch p-0 d-flex align-items-center justify-content-between mb-2">
                                        <div>
                                            <h6 class="fw-black text-uppercase mb-0" style="font-size: 0.75rem;">Product is Active</h6>
                                            <p class="extra-small text-muted mb-0" style="font-size: 0.65rem;">Uncheck to hide from inventory lists</p>
                                        </div>
                                        <input class="form-check-input ms-0" type="checkbox" style="width: 40px; height: 20px;" @bind="editingItem.IsActive" id="itemActiveCheckNew">
                                    </div>

                                    <div class="form-check form-switch p-0 d-flex align-items-center justify-content-between mb-2">
                                        <div>
                                            <h6 class="fw-black text-uppercase mb-0 text-primary" style="font-size: 0.75rem;">Product is Beer</h6>
                                            <p class="extra-small text-muted mb-0" style="font-size: 0.65rem;">Adds bottle return fee on orders</p>
                                        </div>
                                        <input class="form-check-input ms-0" type="checkbox" style="width: 40px; height: 20px;" @bind="editingItem.IsBeer" id="itemBeerCheckNew">
                                    </div>

                                    <hr class="my-2 opacity-10" />

                                    <div class="form-check form-switch p-0 d-flex align-items-center justify-content-between">
                                        <div>
                                            <h6 class="fw-black text-uppercase mb-0 text-success" style="font-size: 0.75rem;">Show in POS Terminal</h6>
                                            <p class="extra-small text-muted mb-0" style="font-size: 0.65rem;">Make visible for sales at the bar</p>
                                        </div>
                                        <input class="form-check-input ms-0" type="checkbox" style="width: 40px; height: 20px;" @bind="editingItem.ShowInPos" id="itemPosCheckNew">
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light rounded-pill px-4" @onclick="() => editingItem = null">Cancel</button>
                    <button type="button" class="btn btn-primary rounded-pill px-4 shadow-sm" @onclick="SaveItem">Save Changes</button>
                </div>
            </div>
        </div>
    </div>
}

@if (editingToken != null)
{
    <div class="modal fade show" tabindex="-1" style="display: block; background: rgba(0,0,0,0.5);" role="dialog">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg rounded-4">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold">@(editingToken.Id == 0 ? "Add New Token" : "Edit Token")</h5>
                    <button type="button" class="btn-close" @onclick="() => editingToken = null"></button>
                </div>
                <div class="modal-body py-4">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label small fw-bold text-muted text-uppercase">Token Name</label>
                                <input type="text" class="form-control rounded-3 border-2" @bind="editingToken.Name" placeholder="e.g. Beer Token" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="mb-3">
                                <label class="form-label small fw-bold text-muted text-uppercase">Sale Price</label>
                                <div class="input-group">
                                    <span class="input-group-text">$</span>
                                    <input type="number" step="0.01" class="form-control" @bind="editingToken.SalePrice" />
                                </div>
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="mb-3">
                                <label class="form-label small fw-bold text-muted text-uppercase">Color</label>
                                <input type="color" class="form-control form-control-color w-100" @bind="editingToken.ColorHex" />
                            </div>
                        </div>
                    </div>

                    <div class="card border-primary-subtle bg-primary-subtle bg-opacity-10 rounded-4 p-3 mb-4">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h6 class="fw-black mb-0 text-primary">SMART TOKEN UPGRADES (CREDIT)</h6>
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="allowUpgradeSwitch" @bind="editingToken.AllowCreditUpgrade" />
                                <label class="form-check-label fw-bold small" for="allowUpgradeSwitch">Enable Credit Upgrades</label>
                            </div>
                        </div>
                        
                        @if (editingToken.AllowCreditUpgrade.GetValueOrDefault())
                        {
                            <div class="row animate__animated animate__fadeIn g-3">
                                <div class="col-md-4">
                                    <div class="mb-3">
                                        <label class="form-label small fw-bold text-muted text-uppercase">Credit Value</label>
                                        <div class="input-group">
                                            <span class="input-group-text bg-white border-2">$</span>
                                            <input type="number" step="0.01" class="form-control border-2" @bind="editingToken.CreditValue" placeholder="@editingToken.SalePrice.ToString("F2")" />
                                        </div>
                                        <div class="extra-small text-muted mt-1 italic">Leave blank to use Sale Price</div>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="mb-3">
                                        <label class="form-label small fw-bold text-muted text-uppercase">Upgrades From Token</label>
                                        <select class="form-select border-2" @bind="editingToken.UpgradesFromTokenId">
                                            <option value="">-- Select Base Token --</option>
                                            @if (tokens != null)
                                            {
                                                @foreach (var tok in tokens.Where(t => t.IsActive && t.AllowCreditUpgrade != true && t.Id != editingToken.Id))
                                                {
                                                    <option value="@tok.Id">@tok.Name (@tok.SalePrice.ToString("C"))</option>
                                                }
                                            }
                                        </select>
                                        <div class="extra-small text-muted mt-1 italic">Base token whose approved drinks are eligible for this upgrade</div>
                                    </div>
                                </div>
                                <div class="col-md-12">
                                    <label class="form-label small fw-bold text-muted text-uppercase d-block mb-2">Eligible Categories for Credit</label>
                                    <div class="d-flex flex-wrap gap-2">
                                        @if (categories != null)
                                        {
                                            @foreach (var cat in categories)
                                            {
                                                <div class="form-check form-check-inline p-2 border rounded-pill bg-white px-3 mb-0">
                                                    <input class="form-check-input" type="checkbox" 
                                                           id="cat_@cat.Id"
                                                           checked="@IsCategoryEligible(cat.Name)"
                                                           @onchange="(e) => ToggleCategoryEligibility(cat.Name, e.Value)" />
                                                    <label class="form-check-label fw-bold small" for="cat_@cat.Id">@cat.Name</label>
                                                </div>
                                            }
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                    <div class="mt-4">
                        <label class="form-label small fw-bold text-muted text-uppercase d-block mb-3">Eligible Drinks</label>
                        <p class="text-muted small mb-3">Check every item that this token is authorized to cover.</p>
                        
                        <div class="border rounded-4 p-3 bg-light" style="max-height: 400px; overflow-y: auto;">
                            <div class="row row-cols-1 row-cols-md-2 g-2">
                                @if (allItemsForTokens != null)
                                {
                                    @foreach (var item in allItemsForTokens)
                                    {
                                        <div class="col">
                                            <div class="form-check p-2 rounded-3 hover-bg bg-white border">
                                                <input class="form-check-input ms-0 me-3" type="checkbox" 
                                                       value="@item.Id"
                                                       checked="@(IsItemEligible(item.Id))"
                                                       @onchange="(e) => ToggleItemEligibility(item.Id, e.Value)" />
                                                <label class="form-check-label fw-bold">@item.Name</label>
                                                <span class="d-block small text-muted">@item.Category - @item.RetailPrice.ToString("C")</span>
                                            </div>
                                        </div>
                                    }
                                }
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light rounded-pill px-4" @onclick="() => editingToken = null">Cancel</button>
                    <button type="button" class="btn btn-primary rounded-pill px-4 shadow-sm" @onclick="SaveToken">Save Token Settings</button>
                </div>
            </div>
        </div>
    </div>
}

@if (editingEventTemplate != null)
{
    <div class="modal fade show" tabindex="-1" style="display: block; background: rgba(0,0,0,0.5);" role="dialog">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg rounded-4">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold">@(editingEventTemplate.Id == 0 ? "New Event Template" : "Edit Event Template")</h5>
                    <button type="button" class="btn-close" @onclick="() => editingEventTemplate = null"></button>
                </div>
                <div class="modal-body py-3">
                    <ul class="nav nav-pills mb-3 border-bottom pb-2" role="tablist">
                        <li class="nav-item">
                            <button type="button" class="nav-link @(activeEventTemplateTab == "general" ? "active" : "")" @onclick='() => activeEventTemplateTab = "general"'>General Info</button>
                        </li>
                        <li class="nav-item">
                            <button type="button" class="nav-link @(activeEventTemplateTab == "menu" ? "active" : "")" @onclick='() => activeEventTemplateTab = "menu"'>Custom Menu & Prices</button>
                        </li>
                    </ul>

                    @if (activeEventTemplateTab == "general")
                    {
                        <div class="mb-3">
                            <label class="form-label small fw-bold text-muted text-uppercase">Event Name</label>
                            <input type="text" class="form-control form-control-lg rounded-3 border-2" @bind="editingEventTemplate.Name" placeholder="e.g. Annual Gala" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-bold text-muted text-uppercase">Default Tab Type</label>
                            <select class="form-select form-select-lg rounded-3 border-2" @bind="editingEventTemplate.DefaultType">
                                @foreach (var type in Enum.GetValues(typeof(EventTabType)).Cast<EventTabType>())
                                {
                                    <option value="@type">@type</option>
                                }
                            </select>
                        </div>
                        <div class="mb-3 p-3 bg-light rounded-3 border">
                            <div class="form-check form-switch d-flex align-items-center justify-content-between p-0 m-0">
                                <div>
                                    <label class="form-check-label fw-bold text-dark mb-0" for="directCheckoutSwitchTemplate" style="font-size: 0.9rem; cursor: pointer;">
                                        Direct Tab Checkout
                                    </label>
                                    <div class="small text-muted" style="font-size: 0.75rem;">Default to showing the TAB button side-by-side with PAY</div>
                                </div>
                                <input class="form-check-input ms-2" type="checkbox" role="switch" id="directCheckoutSwitchTemplate" @bind="_templateDirectCheckout" style="width: 2.5em; height: 1.25em; cursor: pointer;" />
                            </div>
                        </div>
                        <div class="mb-3 p-3 bg-light rounded-3 border">
                            <div class="form-check form-switch d-flex align-items-center justify-content-between p-0 m-0">
                                <div>
                                    <label class="form-check-label fw-bold text-dark mb-0" for="beerTallySwitchTemplate" style="font-size: 0.9rem; cursor: pointer;">
                                        Beer Inventory Tracking
                                    </label>
                                    <div class="small text-muted" style="font-size: 0.75rem;">Enable tracking beers taken out, returned, and final settlement on event cards.</div>
                                </div>
                                <input class="form-check-input ms-2" type="checkbox" role="switch" id="beerTallySwitchTemplate" @bind="editingEventTemplate.EnableBeerTally" style="width: 2.5em; height: 1.25em; cursor: pointer;" />
                            </div>
                        </div>
                    }
                    else if (activeEventTemplateTab == "menu")
                    {
                        <div class="row">
                            <div class="col-4 border-end">
                                <label class="form-label small fw-bold text-muted text-uppercase d-block mb-2">Categories</label>
                                <div class="list-group list-group-flush rounded-3 border">
                                    @foreach (var cat in categories ?? new())
                                    {
                                        <button type="button" class="list-group-item list-group-item-action py-2 @(selectedOverrideCategory.Trim().ToUpper() == cat.Name.Trim().ToUpper() ? "active fw-bold" : "")" @onclick="() => selectedOverrideCategory = cat.Name">
                                            @cat.Name
                                        </button>
                                    }
                                </div>
                            </div>
                            <div class="col-8">
                                <label class="form-label small fw-bold text-muted text-uppercase d-block mb-2">Items in @selectedOverrideCategory</label>
                                <div class="border rounded-3 p-2 bg-light" style="max-height: 380px; overflow-y: auto;">
                                    @{
                                        var itemsInCategory = allItemsForTokens?.Where(i => i.Category?.Trim().ToUpper() == selectedOverrideCategory.Trim().ToUpper()).ToList() ?? new();
                                    }
                                    @if (!itemsInCategory.Any())
                                    {
                                        <div class="text-center text-muted small py-4">No active items in this category.</div>
                                    }
                                    else
                                    {
                                        <table class="table table-sm table-hover align-middle m-0 sticky-header" style="background: white;">
                                             <thead class="table-light small">
                                                 <tr>
                                                     <th class="ps-2">Include <i class="bi bi-info-circle ms-1 text-muted" title="Include this item in the custom menu for the event." style="cursor: help;"></i></th>
                                                     @if (selectedOverrideCategory.Trim().ToUpper() == "BEER")
                                                     {
                                                         <th>Track Tally <i class="bi bi-info-circle ms-1 text-muted" title="Enables tracking of beer inventory (units taken out, returned, and sold) on the event card." style="cursor: help;"></i></th>
                                                         <th>Split Revenue <i class="bi bi-info-circle ms-1 text-muted" title="Splits the revenue for this item, routing a designated amount to the club." style="cursor: help;"></i></th>
                                                         <th style="width: 140px;">Club Portion <i class="bi bi-info-circle ms-1 text-muted" title="The specific dollar amount of the item price that goes directly to the club." style="cursor: help;"></i></th>
                                                     }
                                                     <th>Drink Name</th>
                                                     <th>Retail</th>
                                                     <th style="width: 130px;">Banquet Price</th>
                                                 </tr>
                                             </thead>
                                             <tbody>
                                                 @foreach (var item in itemsInCategory)
                                                 {
                                                     var overrideItem = editingEventOverrides.FirstOrDefault(o => o.ItemId == item.Id);
                                                     var isChecked = overrideItem?.IsVisible ?? false;
                                                     var isTallyChecked = overrideItem?.TrackTally ?? false;
                                                     var isSplitChecked = overrideItem?.EnableClubSplit ?? false;
                                                     var currentPrice = overrideItem?.OverridePrice ?? item.RetailPrice;
                                                     var currentClubSplitPrice = overrideItem?.ClubSplitAmount ?? 0;
                                                     
                                                     <tr>
                                                         <td class="ps-2">
                                                             <div class="form-check form-switch m-0">
                                                                 <input class="form-check-input" type="checkbox" checked="@isChecked" @onchange="(e) => ToggleItemOverride(item.Id, (bool)e.Value)" style="cursor: pointer;" />
                                                             </div>
                                                         </td>
                                                         @if (selectedOverrideCategory.Trim().ToUpper() == "BEER")
                                                         {
                                                             <td>
                                                                 <div class="form-check form-switch m-0">
                                                                     <input class="form-check-input" type="checkbox" checked="@isTallyChecked" @onchange="(e) => ToggleItemTallyOverride(item.Id, (bool)e.Value)" style="cursor: pointer;" />
                                                                 </div>
                                                             </td>
                                                             <td>
                                                                 <div class="form-check form-switch m-0">
                                                                     <input class="form-check-input" type="checkbox" checked="@isSplitChecked" @onchange="(e) => ToggleItemSplitOverride(item.Id, (bool)e.Value)" style="cursor: pointer;" disabled="@(!isTallyChecked)" />
                                                                 </div>
                                                             </td>
                                                             <td>
                                                                 <div class="input-group input-group-sm">
                                                                     <span class="input-group-text bg-light border-end-0">$</span>
                                                                     <input type="number" class="form-control ps-1 border-start-0" step="0.01" min="0" value="@currentClubSplitPrice.ToString("F2")" @onchange="(e) => UpdateItemClubSplitPrice(item.Id, e.Value)" disabled="@(!isSplitChecked || !isTallyChecked)" />
                                                                 </div>
                                                             </td>
                                                         }
                                                         <td class="small fw-bold text-dark">@item.Name</td>
                                                         <td class="small text-muted">@item.RetailPrice.ToString("C")</td>
                                                         <td class="pe-2">
                                                             <div class="input-group input-group-sm">
                                                                 <span class="input-group-text bg-light border-end-0">$</span>
                                                                 <input type="number" class="form-control ps-1 border-start-0" step="0.01" min="0" value="@currentPrice.ToString("F2")" @onchange="(e) => UpdateItemOverridePrice(item.Id, e.Value)" disabled="@(!isChecked)" />
                                                             </div>
                                                         </td>
                                                     </tr>
                                                 }
                                            </tbody>
                                        </table>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light rounded-pill px-4" @onclick="() => editingEventTemplate = null">Cancel</button>
                    <button type="button" class="btn btn-primary rounded-pill px-4 shadow-sm" @onclick="SaveEventTemplate">Save Template</button>
                </div>
            </div>
        </div>
    </div>
}

@if (creatingActiveEvent != null)
{
    <div class="modal fade show" tabindex="-1" style="display: block; background: rgba(0,0,0,0.5);" role="dialog">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg rounded-4">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold">Start Event: @creatingActiveEvent.Name</h5>
                    <button type="button" class="btn-close" @onclick="() => creatingActiveEvent = null"></button>
                </div>
                <div class="modal-body py-4">
                    <div class="alert alert-info rounded-3 small mb-4">
                        Starting this event will make it immediately available on all POS terminals.
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-muted text-uppercase">Tab Type</label>
                        <select class="form-select form-select-lg rounded-3 border-2" @bind="creatingActiveEvent.Type">
                            @foreach (var type in Enum.GetValues(typeof(EventTabType)).Cast<EventTabType>())
                            {
                                <option value="@type">@type</option>
                            }
                        </select>
                    </div>
                    @if (creatingActiveEvent.Type == EventTabType.PrePaid)
                    {
                        <div class="mb-3">
                            <label class="form-label small fw-bold text-muted text-uppercase">Pre-Paid Amount</label>
                            <div class="input-group">
                                <span class="input-group-text bg-white border-2">$</span>
                                <input type="number" step="0.01" class="form-control form-control-lg border-2" @bind="creatingActiveEvent.InitialAmount" />
                            </div>
                        </div>
                    }
                    <div class="mb-3 p-3 bg-light rounded-3 border">
                        <div class="form-check form-switch d-flex align-items-center justify-content-between p-0 m-0">
                            <div>
                                <label class="form-check-label fw-bold text-dark mb-0" for="directCheckoutSwitchAdmin" style="font-size: 0.9rem; cursor: pointer;">
                                    Direct Tab Checkout
                                </label>
                                <div class="small text-muted" style="font-size: 0.75rem;">Shows TAB button side-by-side with PAY</div>
                            </div>
                            <input class="form-check-input ms-2" type="checkbox" role="switch" id="directCheckoutSwitchAdmin" @bind="_newEventDirectCheckout" style="width: 2.5em; height: 1.25em; cursor: pointer;" />
                        </div>
                    </div>
                    <div class="mb-3 p-3 bg-light rounded-3 border">
                        <div class="form-check form-switch d-flex align-items-center justify-content-between p-0 m-0">
                            <div>
                                <label class="form-check-label fw-bold text-dark mb-0" for="beerTallySwitchAdmin" style="font-size: 0.9rem; cursor: pointer;">
                                    Beer Inventory Tracking
                                </label>
                                <div class="small text-muted" style="font-size: 0.75rem;">Enables tracking of beers taken out, returned, and final settlement on the event banner.</div>
                            </div>
                            <input class="form-check-input ms-2" type="checkbox" role="switch" id="beerTallySwitchAdmin" @bind="creatingActiveEvent.EnableBeerTally" style="width: 2.5em; height: 1.25em; cursor: pointer;" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light rounded-pill px-4" @onclick="() => creatingActiveEvent = null">Cancel</button>
                    <button type="button" class="btn btn-success rounded-pill px-4 fw-bold shadow-sm" @onclick="StartActiveEvent">Start Event Tab</button>
                </div>
            </div>
        </div>
    </div>
}

@if (addingFundsEvent != null)
{
