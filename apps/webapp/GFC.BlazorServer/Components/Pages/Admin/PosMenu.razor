@if (inlineTallyEvent != null)
{
    <div class="modal fade show" tabindex="-1" style="display: block; background: rgba(0,0,0,0.5); z-index: 1050;" role="dialog">
        <div class="modal-dialog modal-lg modal-dialog-centered" style="max-width: @(inlineTallyMode == "settle" ? "850px" : "750px");">
            <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
                
                @if (inlineTallyMode == "remove")
                {
                    <div class="modal-header border-0 bg-primary text-white py-3 px-4 d-flex justify-content-between align-items-center">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-plus-circle fs-4"></i>
                            <div>
                                <h5 class="modal-title fw-black mb-0">Remove Beers (Send to Event)</h5>
                                <span class="small opacity-75">Event: @inlineTallyEvent.Name</span>
                            </div>
                        </div>
                        <button type="button" class="btn-close btn-close-white" @onclick="CloseInlineTallyModal"></button>
                    </div>
                    <div class="modal-body py-4 px-4 bg-light" style="max-height: 60vh; overflow-y: auto;">
                        <div class="alert alert-info rounded-3 small mb-3">
                            Select the quantity of each beer taken out for the event. The price can be overridden for this event.
                        </div>

                        <!-- Dropdown to add beer -->
                        <div class="card border-0 shadow-sm rounded-4 p-3 mb-3 bg-white">
                            <label class="form-label small fw-bold text-muted text-uppercase">Add Beer to Tally Sheet</label>
                            <div class="d-flex gap-2">
                                <select class="form-select rounded-pill fw-bold border-2" @bind="selectedBeerIdToAdd">
                                    <option value="0">-- Select Beer --</option>
                                    @if (allItemsForTokens != null)
                                    {
                                        @foreach (var item in allItemsForTokens.Where(i => i.IsBeer && !currentTallies.Any(t => t.ItemId == i.Id)))
                                        {
                                            <option value="@item.Id">@item.Name</option>
                                        }
                                    }
                                </select>
                                <button class="btn btn-primary rounded-pill px-4 fw-bold" @onclick="AddBeerToTallySheet" disabled="@(selectedBeerIdToAdd == 0)">
                                    <i class="bi bi-plus-lg me-1"></i> Add
                                </button>
                            </div>
                        </div>

                        <!-- Table -->
                        <div class="card border-0 shadow-sm rounded-4 bg-white overflow-hidden">
                            <div class="table-responsive">
                                <table class="table align-middle mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th class="py-3 px-4 text-muted small fw-bold text-uppercase">Beer Type</th>
                                            <th class="py-3 px-3 text-muted small fw-bold text-uppercase text-center" style="width: 140px;">Event Price ($)</th>
                                            <th class="py-3 px-3 text-muted small fw-bold text-uppercase text-center" style="width: 180px;">Qty Removed (Taken Out)</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (!currentTallies.Any())
                                        {
                                            <tr>
                                                <td colspan="3" class="text-center py-5 text-muted">
                                                    <i class="bi bi-inboxes fs-3 mb-2 d-block opacity-50"></i>
                                                    No beers added yet. Use the dropdown above to add beer types.
                                                </td>
                                            </tr>
                                        }
                                        else
                                        {
                                            @foreach (var t in currentTallies)
                                            {
                                                <tr>
                                                    <td class="py-3 px-4 fw-bold text-dark">
                                                        <div class="d-flex align-items-center gap-2">
                                                            <button class="btn btn-sm btn-outline-danger border-0 p-1 rounded-circle" @onclick="() => RemoveBeerFromTallySheet(t)" title="Remove beer">
                                                                <i class="bi bi-x-circle-fill"></i>
                                                            </button>
                                                            <span>@t.Name</span>
                                                        </div>
                                                    </td>
                                                    <td class="py-3 px-3 text-center">
                                                        <input type="number" step="0.01" class="form-control form-control-sm text-center fw-bold rounded border-2" @bind="t.Price" />
                                                    </td>
                                                    <td class="py-3 px-3">
                                                        <div class="input-group input-group-sm">
                                                            <button class="btn btn-outline-secondary border-2" type="button" @onclick="() => t.QuantityTaken = Math.Max(0, t.QuantityTaken - 1)"><i class="bi bi-dash"></i></button>
                                                            <input type="number" class="form-control text-center fw-bold border-2" @bind="t.QuantityTaken" min="0" />
                                                            <button class="btn btn-outline-secondary border-2" type="button" @onclick="() => t.QuantityTaken++"><i class="bi bi-plus"></i></button>
                                                        </div>
                                                    </td>
                                                </tr>
                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer border-0 bg-light py-3 px-4 d-flex justify-content-between align-items-center">
                        <button type="button" class="btn btn-light rounded-pill px-4" @onclick="CloseInlineTallyModal">Cancel</button>
                        <button type="button" class="btn btn-primary rounded-pill px-4 fw-bold shadow-sm" @onclick="() => SaveInlineTally(false)">
                            <i class="bi bi-save me-1"></i> Save Removed Beers
                        </button>
                    </div>
                }

                @if (inlineTallyMode == "return")
                {
                    <div class="modal-header border-0 bg-warning text-dark py-3 px-4 d-flex justify-content-between align-items-center">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-arrow-left-right fs-4"></i>
                            <div>
                                <h5 class="modal-title fw-black mb-0">Return Unsold Beers</h5>
                                <span class="small opacity-75">Event: @inlineTallyEvent.Name</span>
                            </div>
                        </div>
                        <button type="button" class="btn-close" @onclick="CloseInlineTallyModal"></button>
                    </div>
                    <div class="modal-body py-4 px-4 bg-light" style="max-height: 60vh; overflow-y: auto;">
                        <div class="alert alert-warning rounded-3 small mb-3">
                            Select how many unsold beers were returned. Returned beers are excluded from the final sales calculation.
                        </div>

                        <!-- Table -->
                        <div class="card border-0 shadow-sm rounded-4 bg-white overflow-hidden">
                            <div class="table-responsive">
                                <table class="table align-middle mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th class="py-3 px-4 text-muted small fw-bold text-uppercase">Beer Type</th>
                                            <th class="py-3 px-3 text-muted small fw-bold text-uppercase text-center" style="width: 140px;">Qty Removed</th>
                                            <th class="py-3 px-3 text-muted small fw-bold text-uppercase text-center" style="width: 180px;">Qty Returned</th>
                                            <th class="py-3 px-3 text-muted small fw-bold text-uppercase text-center" style="width: 120px;">Consumed</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var t in currentTallies.Where(t => t.QuantityTaken > 0))
                                        {
                                            <tr>
                                                <td class="py-3 px-4 fw-bold text-dark">@t.Name</td>
                                                <td class="py-3 px-3 text-center fw-bold">@t.QuantityTaken</td>
                                                <td class="py-3 px-3">
                                                    <div class="input-group input-group-sm">
                                                        <button class="btn btn-outline-secondary border-2" type="button" @onclick="() => t.QuantityReturned = Math.Max(0, t.QuantityReturned - 1)"><i class="bi bi-dash"></i></button>
                                                        <input type="number" class="form-control text-center fw-bold border-2 @(t.QuantityReturned > t.QuantityTaken ? "border-danger text-danger" : "")" @bind="t.QuantityReturned" min="0" />
                                                        <button class="btn btn-outline-secondary border-2" type="button" @onclick="() => t.QuantityReturned = Math.Min(t.QuantityTaken, t.QuantityReturned + 1)"><i class="bi bi-plus"></i></button>
                                                    </div>
                                                </td>
                                                <td class="py-3 px-3 text-center">
                                                    <span class="badge @(t.Consumed > 0 ? "bg-success" : "bg-light text-muted") rounded-pill px-3 py-2 fw-bold">
                                                        @t.Consumed
                                                    </span>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer border-0 bg-light py-3 px-4 d-flex justify-content-between align-items-center">
                        <button type="button" class="btn btn-light rounded-pill px-4" @onclick="CloseInlineTallyModal">Cancel</button>
                        <button type="button" class="btn btn-warning rounded-pill px-4 fw-bold text-dark shadow-sm" @onclick="() => SaveInlineTally(false)">
                            <i class="bi bi-save me-1"></i> Save Returned Beers
                        </button>
                    </div>
                }

                @if (inlineTallyMode == "settle")
                {
                    <div class="modal-header border-0 bg-success text-white py-3 px-4 d-flex justify-content-between align-items-center">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-cash-stack fs-4"></i>
                            <div>
                                <h5 class="modal-title fw-black mb-0">Settle Event Cash Drawer Balance</h5>
                                <span class="small opacity-75">Event: @inlineTallyEvent.Name</span>
                            </div>
                        </div>
                        <button type="button" class="btn-close btn-close-white" @onclick="CloseInlineTallyModal"></button>
                    </div>
                    <div class="modal-body py-4 px-4 bg-light" style="max-height: 70vh; overflow-y: auto;">
                        
                        <!-- Preloaded Cash Input -->
                        <div class="card border-0 shadow-sm rounded-4 p-3 mb-4 bg-white">
                            <div class="row align-items-center">
                                <div class="col-md-7">
                                    <h6 class="fw-bold mb-1 text-dark"><i class="bi bi-cash-coin me-2 text-success"></i>Preloaded Drawer Cash</h6>
                                    <p class="text-muted small mb-0">Specify preloaded cash deposited/placed in the drawer for this event.</p>
                                </div>
                                <div class="col-md-5">
                                    <div class="input-group input-group-lg">
                                        <span class="input-group-text bg-light border-2">$</span>
                                        <input type="number" step="0.01" class="form-control fw-bold border-2" @bind="inlineTallyEvent.InitialAmount" placeholder="0.00" />
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Consumed Beers Summary -->
                        <div class="card border-0 shadow-sm rounded-4 bg-white overflow-hidden mb-4">
                            <div class="card-header bg-light border-0 py-3">
                                <h6 class="fw-black text-dark mb-0"><i class="bi bi-calculator me-1"></i> Sales Calculator</h6>
                            </div>
                            <div class="table-responsive">
                                <table class="table align-middle mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th class="py-3 px-4 text-muted small fw-bold text-uppercase">Beer Type</th>
                                            <th class="py-3 px-3 text-muted small fw-bold text-uppercase text-center">Price</th>
                                            <th class="py-3 px-3 text-muted small fw-bold text-uppercase text-center">Removed</th>
                                            <th class="py-3 px-3 text-muted small fw-bold text-uppercase text-center">Returned</th>
                                            <th class="py-3 px-3 text-muted small fw-bold text-uppercase text-center">Consumed</th>
                                            <th class="py-3 px-4 text-muted small fw-bold text-uppercase text-end">Subtotal</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var t in currentTallies.Where(t => t.QuantityTaken > 0))
                                        {
                                            <tr>
                                                <td class="py-3 px-4 fw-bold text-dark">@t.Name</td>
                                                <td class="py-3 px-3 text-center">@t.Price.ToString("C")</td>
                                                <td class="py-3 px-3 text-center">@t.QuantityTaken</td>
                                                <td class="py-3 px-3 text-center">@t.QuantityReturned</td>
                                                <td class="py-3 px-3 text-center">
                                                    <span class="badge @(t.Consumed > 0 ? "bg-success" : "bg-light text-muted") rounded-pill px-3 py-2 fw-bold">
                                                        @t.Consumed
                                                    </span>
                                                </td>
                                                <td class="py-3 px-4 text-end fw-black text-dark">@t.Subtotal.ToString("C")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <!-- Calculations summary -->
                        <div class="card border-0 shadow-sm rounded-4 p-4 text-white" style="background: linear-gradient(135deg, #1e293b, #0f172a);">
                            <h6 class="fw-bold mb-3 text-uppercase text-muted" style="letter-spacing: 0.5px; font-size: 0.75rem;">Drawer Settlement</h6>
                            <div class="row g-3">
                                <div class="col-md-4">
                                    <div class="bg-white bg-opacity-10 rounded-3 p-3 border border-white border-opacity-15 h-100">
                                        <div class="small opacity-75 mb-1">Total Beers Consumed</div>
                                        <h5 class="fw-black mb-1">@currentTallies.Sum(t => t.Consumed) units</h5>
                                        <div class="fs-5 fw-bold opacity-90">@currentTallies.Sum(t => t.Subtotal).ToString("C")</div>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="bg-white bg-opacity-10 rounded-3 p-3 border border-white border-opacity-15 h-100">
                                        <div class="small opacity-75 mb-1">Preloaded Drawer Cash</div>
                                        <h3 class="fw-black mb-0">@inlineTallyEvent.InitialAmount.ToString("C")</h3>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    @{
                                        decimal consumedSum = currentTallies.Sum(t => t.Subtotal);
                                        decimal netOwed = consumedSum - inlineTallyEvent.InitialAmount;
                                    }
                                    <div class="rounded-3 p-3 border h-100 @(netOwed < 0 ? "bg-success bg-opacity-20 border-success border-opacity-30 text-success-emphasis" : "bg-warning bg-opacity-20 border-warning border-opacity-30 text-warning-emphasis")" style="color: white !important;">
                                        <div class="small opacity-75 mb-1">@(netOwed < 0 ? "Refund Due" : "Extra Cash Owed")</div>
                                        <h3 class="fw-black mb-0">@Math.Abs(netOwed).ToString("C")</h3>
                                        <span class="extra-small opacity-75">@(netOwed < 0 ? "Return excess cash from drawer" : "Collect extra cash to drawer")</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                    <div class="modal-footer border-0 bg-light py-3 px-4 d-flex justify-content-between align-items-center">
                        <button type="button" class="btn btn-light rounded-pill px-4" @onclick="CloseInlineTallyModal">Cancel</button>
                        <div class="d-flex gap-2">
                            <button type="button" class="btn btn-outline-info rounded-pill px-4 fw-bold shadow-sm" @onclick="() => SaveInlineTally(false)">
                                <i class="bi bi-save me-1"></i> Save Progress
                            </button>
                            <button type="button" class="btn btn-success rounded-pill px-4 fw-bold shadow-sm" @onclick="() => SaveInlineTally(true)">
                                <i class="bi bi-check-circle-fill me-1"></i> Settle & Close Event
                            </button>
                        </div>
                    </div>
                }

            </div>
        </div>
    </div>
}

