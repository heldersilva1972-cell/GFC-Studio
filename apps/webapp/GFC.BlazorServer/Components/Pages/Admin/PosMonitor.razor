@page "/admin/pos-monitor"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

<PageTitle>Live POS Monitor | GFC</PageTitle>

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-0 fw-bold">Live POS Monitor</h1>
            <p class="text-muted">Real-time view of all active bar terminals.</p>
        </div>
        <div class="badge bg-success-soft text-success p-2">
            <i class="bi bi-broadcast me-1"></i> Live Connection Active
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="card border-0 shadow-sm rounded-4 p-5 text-center bg-white">
                <div class="py-5">
                    <i class="bi bi-activity fs-1 text-primary opacity-25 mb-3 d-block"></i>
                    <h4 class="fw-bold">No Active Terminals</h4>
                    <p class="text-muted">Waiting for POS terminals to connect...</p>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .bg-success-soft { background-color: rgba(16, 185, 129, 0.1); }
    .rounded-4 { border-radius: 1rem !important; }
</style>
