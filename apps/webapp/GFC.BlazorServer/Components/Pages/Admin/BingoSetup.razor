@page "/admin/bingo/setup"
@using GFC.Core.Models
@using GFC.BlazorServer.Data
@using Microsoft.EntityFrameworkCore
@using global::System.Security.Claims
@inject GfcDbContext DbContext
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject GFC.Core.Interfaces.IUserManagementService UserService
@inject GFC.Core.Interfaces.ISystemSettingsService SettingsService
@inject GFC.Core.Interfaces.IAuditLogRepository AuditLogRepository
@inject GFC.BlazorServer.Services.CustomAuthenticationStateProvider AuthStateProvider
@attribute [Authorize]

<PageTitle>Bingo Setup | GFC Admin</PageTitle>

<div class="admin-container p-4">
    <div class="sticky-top bg-white border-bottom shadow-sm mb-4" style="z-index: 1020; margin: -1.5rem -1.5rem 1.5rem -1.5rem; padding: 1.5rem 1.5rem 1rem 1.5rem;">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h1 class="fw-black text-dark mb-1">BINGO SETUP</h1>
                <p class="text-muted mb-0 text-uppercase extra-small fw-bold">Manage sheet colors, admission packs, and game programs.</p>
            </div>
            <div class="d-flex gap-2">
                <button class="btn @(ActiveTab == "Sheets" ? "btn-primary" : "btn-light") rounded-pill px-4 fw-bold" @onclick='() => ActiveTab = "Sheets"'>
                    BINGO SHEETS
                </button>
                <button class="btn @(ActiveTab == "Admissions" ? "btn-primary" : "btn-light") rounded-pill px-4 fw-bold" @onclick='() => ActiveTab = "Admissions"'>
                    ADMISSIONS
                </button>
                <button class="btn @(ActiveTab == "Financials" ? "btn-primary" : "btn-light") rounded-pill px-4 fw-bold" @onclick='() => ActiveTab = "Financials"'>
                    PERCENTAGES
                </button>
                <button class="btn @(ActiveTab == "Progressives" ? "btn-primary" : "btn-light") rounded-pill px-4 fw-bold" @onclick='() => ActiveTab = "Progressives"'>
                    PROGRESSIVES
                </button>
                <button class="btn @(ActiveTab == "PullTabs" ? "btn-primary" : "btn-light") rounded-pill px-4 fw-bold" @onclick='() => ActiveTab = "PullTabs"'>
                    PULL TABS
                </button>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <div class="alert alert-danger shadow-sm rounded-4 mb-4">
            <h6 class="fw-black mb-1"><i class="bi bi-exclamation-triangle-fill me-2"></i> CRITICAL ERROR</h6>
            <p class="small mb-0">@ErrorMessage</p>
        </div>
    }

    @if (Loading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-2 text-muted">Loading Program...</p>
        </div>
    }
    else if (ActiveTab == "Sheets")
    {
        <div class="d-flex justify-content-end mb-3">
            <button class="btn btn-primary btn-sm rounded-pill px-3 fw-bold" @onclick="() => OpenSheetModal()">
                <i class="bi bi-plus-lg me-2"></i> ADD NEW SHEET
            </button>
        </div>
        <div class="row g-4">
            @foreach (var sheet in Sheets)
            {
                <div class="col-md-6 col-lg-4 col-xl-3">
                    <div class="glass-card h-100 shadow-sm border-top border-4" style="border-top-color: @sheet.DisplayColor !important;">
                        <div class="p-3">
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <div>
                                    <h5 class="fw-black mb-1 text-uppercase">@sheet.ColorName</h5>
                                    <div class="d-flex flex-wrap gap-1">
                                        <span class="badge bg-light text-muted border">@sheet.DefaultPrice.ToString("C2")</span>
                                        @if (sheet.IsIncludedInAdmission && sheet.IsAdmissionOnly) { <span class="badge bg-primary-subtle text-primary border border-primary border-opacity-10">STANDARD</span> }
                                        else if (sheet.IsIncludedInAdmission && !sheet.IsAdmissionOnly) { <span class="badge bg-info-subtle text-info border border-info border-opacity-10">SPECIAL (INCL)</span> }
                                        else { <span class="badge bg-secondary-subtle text-secondary border border-secondary border-opacity-10">FLOOR ONLY</span> }
                                        
                                        @if (sheet.PayoutMode == 1 || sheet.Games.Any(g => g.PayoutMode == 1)) { <span class="badge bg-warning-subtle text-warning border border-warning border-opacity-10">50/50</span> }
                                        else if (sheet.PayoutMode == 2 || sheet.Games.Any(g => g.PayoutMode == 2)) { <span class="badge bg-success-subtle text-success border border-success border-opacity-10">GROSS %</span> }
                                        @if (sheet.Games.Any(g => g.IsProgressive)) { <span class="badge bg-primary-subtle text-primary border border-primary border-opacity-10">PROGRESSIVE</span> }
                                    </div>
                                </div>
                                <div class="dropdown">
                                    <button class="btn btn-link text-muted p-0" data-bs-toggle="dropdown">
                                        <i class="bi bi-three-dots-vertical"></i>
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end shadow border-0" style="z-index: 1050;">
                                        <li><a class="dropdown-item" @onclick="() => OpenSheetModal(sheet)"><i class="bi bi-pencil me-2"></i> Edit</a></li>
                                        <li><a class="dropdown-item text-danger" @onclick="() => PromptDeleteSheet(sheet)"><i class="bi bi-trash me-2"></i> Delete</a></li>
                                    </ul>
                                </div>
                            </div>

                            <div class="game-list bg-light rounded-3 p-2 mb-3">
                                <label class="extra-small fw-black text-muted text-uppercase mb-2 d-block">Program Games</label>
                                @if (!sheet.Games.Any())
                                {
                                    <div class="text-center py-2 text-muted extra-small italic">No games defined</div>
                                }
                                @foreach (var game in sheet.Games.OrderBy(g => g.DisplayOrder))
                                {
                                    <div class="d-flex align-items-center gap-2 mb-1">
                                        <i class="bi bi-dot text-primary"></i>
                                        <span class="small fw-bold">@game.GameName</span>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else if (ActiveTab == "Admissions")
    {
        <div class="d-flex justify-content-between align-items-end mb-3">
            <div class="bg-white p-3 rounded-4 shadow-sm border flex-grow-1 me-3 d-flex gap-4">
                <div>
                    <label class="extra-small fw-black text-muted text-uppercase d-block mb-1">Standard Base (9-Pack)</label>
                    <div class="input-group input-group-sm" style="width: 120px;">
                        <span class="input-group-text">$</span>
                        <input type="number" class="form-control fw-bold" @bind="SystemSettings.BingoBaseAdmissionPrice" />
                    </div>
                </div>
                <div>
                    <label class="extra-small fw-black text-muted text-uppercase d-block mb-1">Extra Card Price (3 Squares)</label>
                    <div class="input-group input-group-sm" style="width: 140px;">
                        <span class="input-group-text">$</span>
                        <input type="number" class="form-control fw-bold" @bind="SystemSettings.BingoAdditionalCardPrice" />
                    </div>
                </div>
                <div>
                    <label class="extra-small fw-black text-muted text-uppercase d-block mb-1">Payout Rounding</label>
                    <select class="form-select form-select-sm fw-bold" @bind="SystemSettings.BingoPayoutRoundingMode" style="width: 160px;">
                        <option value="0">None (Exact)</option>
                        <option value="1">Round Up ($1.00)</option>
                        <option value="2">Round Down ($1.00)</option>
                    </select>
                </div>
                <div class="d-flex align-items-end">
                    <button class="btn btn-sm btn-outline-primary fw-bold rounded-pill px-3" @onclick="SaveGlobalSettings">
                        <i class="bi bi-save me-1"></i> UPDATE RATES
                    </button>
                </div>
            </div>
            <button class="btn btn-primary btn-sm rounded-pill px-3 fw-bold" @onclick="() => OpenAdmissionModal()">
                <i class="bi bi-plus-lg me-2"></i> ADD ADMISSION PACK
            </button>
        </div>

        <div class="row mb-5">
            <div class="col-12">
                <div class="section-divider mb-3 mt-4">
                    <span>PAYOUT ADMISSION TIERS</span>
                </div>
                <div class="glass-card shadow-sm border p-4">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div>
                            <h6 class="fw-black text-uppercase mb-1" style="letter-spacing: 0.02em;">Attendance-Based Prize Scaling</h6>
                            <p class="text-muted small mb-0">Automatically scale game prizes based on the total number of admissions sold in a session.</p>
                        </div>
                        <button class="btn btn-primary btn-sm rounded-pill px-3 fw-bold shadow-sm" @onclick="AddPayoutTier">
                            <i class="bi bi-plus-lg me-1"></i> ADD NEW TIER
                        </button>
                    </div>
                    
                    <div class="table-responsive rounded-4 border">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="bg-light">
                                <tr class="extra-small text-muted fw-black text-uppercase">
                                    <th style="width: 220px;" class="ps-4">Admission Min</th>
                                    <th style="width: 180px;">Payout Percent</th>
                                    <th>Rule Description & Range</th>
                                    <th style="width: 60px;" class="text-center">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!PayoutTiers.Any())
                                {
                                    <tr>
                                        <td colspan="4" class="text-center py-5">
                                            <div class="text-muted opacity-50 mb-2"><i class="bi bi-slash-circle fs-2"></i></div>
                                            <div class="fw-bold text-muted">No payout tiers defined. All games will pay 100% by default.</div>
                                        </td>
                                    </tr>
                                }
                                @foreach (var tier in PayoutTiers.OrderBy(t => t.MinAdmissions))
                                {
                                    <tr>
                                        <td class="ps-4">
                                            <div class="input-group input-group-sm" style="max-width: 160px;">
                                                <span class="input-group-text bg-white border-end-0 text-muted extra-small fw-bold">IF SOLD ≥</span>
                                                <input type="number" class="form-control fw-black border-start-0 ps-0 fs-6" @bind="tier.MinAdmissions" @onfocus="OnInputFocus" />
                                            </div>
                                        </td>
                                        <td>
                                            <div class="input-group input-group-sm" style="max-width: 140px;">
                                                <span class="input-group-text bg-white border-end-0 text-muted extra-small fw-bold">PAY</span>
                                                <input type="number" class="form-control fw-black border-start-0 border-end-0 ps-0 text-center fs-6" @bind="tier.PayoutPercentage" @onfocus="OnInputFocus" />
                                                <span class="input-group-text bg-white border-start-0 text-muted fw-bold">%</span>
                                            </div>
                                        </td>
                                        <td>
                                            @{
                                                var nextTier = PayoutTiers.OrderBy(t => t.MinAdmissions).FirstOrDefault(t => t.MinAdmissions > tier.MinAdmissions);
                                                if (nextTier != null)
                                                {
                                                    <div class="d-flex align-items-center">
                                                        <span class="badge bg-primary-subtle text-primary border border-primary border-opacity-25 px-3 py-2 rounded-pill fw-bold" style="font-size: 0.75rem;">
                                                            @tier.MinAdmissions to @(nextTier.MinAdmissions - 1) Sales
                                                        </span>
                                                        <i class="bi bi-arrow-right mx-3 text-muted fs-5"></i>
                                                        <span class="fw-bold text-dark fs-6">Game pays <span class="text-primary fw-black">@tier.PayoutPercentage%</span> of the base prize</span>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div class="d-flex align-items-center">
                                                        <span class="badge bg-success-subtle text-success border border-success border-opacity-25 px-3 py-2 rounded-pill fw-bold" style="font-size: 0.75rem;">
                                                            @tier.MinAdmissions or More Sales
                                                        </span>
                                                        <i class="bi bi-arrow-right mx-3 text-muted fs-5"></i>
                                                        <span class="fw-bold text-dark fs-6">Game pays <span class="text-success fw-black">@tier.PayoutPercentage%</span> of the base prize</span>
                                                    </div>
                                                }
                                            }
                                        </td>
                                        <td class="text-center">
                                            <button class="btn btn-sm btn-outline-danger border-0 rounded-circle" @onclick="() => PromptDeleteTier(tier)">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    
                    <div class="d-flex justify-content-between align-items-center mt-4 border-top pt-3">
                        <div class="d-flex align-items-center gap-2 text-muted">
                            <i class="bi bi-info-circle-fill text-primary"></i>
                            <span class="extra-small italic">Below the lowest tier, 0% payout is assumed unless a 0-minimum tier exists.</span>
                        </div>
                        <button class="btn btn-primary rounded-pill px-5 fw-black shadow-sm" @onclick="SavePayoutTiers">
                            <i class="bi bi-check2-all me-2"></i> SAVE ATTENDANCE RULES
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <div class="section-divider mb-3">
            <span>ADMISSION PACKAGES</span>
        </div>
        <div class="row g-4">
            @foreach (var pack in Admissions)
            {
                <div class="col-md-6 col-lg-4 col-xl-3">
                    <div class="glass-card shadow-sm border-start border-4" style="border-left-color: @pack.DisplayColor !important;">
                        <div class="p-3 d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="fw-black mb-0 text-uppercase">@pack.Name</h6>
                                <div class="fw-bold text-primary">@pack.Price.ToString("C2")</div>
                            </div>
                            <div class="d-flex gap-2">
                                <button class="btn btn-sm btn-light" @onclick="() => OpenAdmissionModal(pack)"><i class="bi bi-pencil"></i></button>
                                <button class="btn btn-sm btn-light text-danger" @onclick="() => PromptDeleteAdmission(pack)"><i class="bi bi-trash"></i></button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else if (ActiveTab == "Financials")
    {
        <div class="glass-card shadow-sm border p-0 overflow-hidden rounded-4">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" style="table-layout: fixed; width: 100%;">
                    <thead class="bg-light">
                        <tr class="extra-small text-muted fw-black text-uppercase border-bottom">
                            <th class="ps-4 py-3" style="width: 30%;">Bingo Sheet</th>
                            <th class="py-3" style="width: 15%;">Category</th>
                            <th class="py-3 text-center" style="width: 12%;">Payout Mode</th>
                            <th class="py-3 text-center" style="width: 10%;">State Tax</th>
                            <th class="py-3 text-center" style="width: 10%;">Club Share</th>
                            <th class="py-3 text-center" style="width: 10%;">Player Payout</th>
                            <th class="py-3 text-center" style="width: 13%;">Overrides</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var sheet in Sheets.OrderBy(s => s.DisplayOrder))
                        {
                            var lot = sheet.LotteryPercentage * 100;
                            var isStandard = sheet.IsIncludedInAdmission && sheet.IsAdmissionOnly;
                            var clubInput = isStandard ? 0.0m : (sheet.PayoutMode == 1 ? 0.50m : sheet.ClubPercentage) * 100;
                            var hasOverrides = sheet.Games.Any(g => g.LotteryPercentage.HasValue || g.ClubPercentage.HasValue);
                            
                            // Effective math matching the edit modal
                            decimal clubEff, playerEff;
                            if (sheet.PayoutMode == 1) { // 50/50 split (Sequential)
                                clubEff = (100 - lot) * (clubInput / 100);
                            } else { // gross/fixed additive math
                                clubEff = clubInput;
                            }
                            playerEff = 100 - lot - clubEff;

                            <tr class="bg-light bg-opacity-75">
                                <td colspan="7" class="ps-4 py-2 border-bottom">
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="rounded-circle shadow-sm" style="width: 12px; height: 12px; background: @sheet.DisplayColor; border: 1px solid rgba(0,0,0,0.15);"></div>
                                        <span class="fw-black text-uppercase text-dark" style="font-size: 0.8rem; letter-spacing: 0.03em;">@sheet.ColorName SHEET</span>
                                        @if (isStandard) { <span class="badge bg-primary-subtle text-primary border border-primary border-opacity-10 extra-small">STANDARD</span> }
                                        else if (sheet.IsIncludedInAdmission && !sheet.IsAdmissionOnly) { <span class="badge bg-info-subtle text-info border border-info border-opacity-10 extra-small">SPECIAL</span> }
                                        else { <span class="badge bg-secondary-subtle text-secondary border border-secondary border-opacity-10 extra-small">FLOOR ONLY</span> }
                                    </div>
                                </td>
                            </tr>

                            @foreach (var game in sheet.Games.OrderBy(g => g.DisplayOrder))
                            {
                                bool hasOverride = game.LotteryPercentage.HasValue || game.ClubPercentage.HasValue;
                                decimal gLot = (game.LotteryPercentage ?? sheet.LotteryPercentage) * 100;
                                decimal gClubInput = (game.ClubPercentage ?? (game.PayoutMode == 1 ? 0.50m : game.PayoutMode == 2 ? 0.05m : sheet.ClubPercentage)) * 100;
                                
                                decimal gClubEff, gPlayerEff;
                                if (game.PayoutMode == 1) { // 50/50 (Sequential)
                                    gClubEff = (100 - gLot) * (gClubInput / 100);
                                } else {
                                    gClubEff = gClubInput;
                                }
                                gPlayerEff = 100 - gLot - gClubEff;

                                <tr>
                                    <td class="ps-5 py-2">
                                        <div class="d-flex align-items-center gap-2">
                                            <i class="bi bi-arrow-return-right text-muted opacity-50"></i>
                                            <span class="small fw-bold">@game.GameName</span>
                                        </div>
                                    </td>
                                    <td></td>
                                    <td class="text-center">
                                        <div class="d-flex flex-column align-items-center">
                                            <span class="extra-small fw-bold text-muted">@(game.PayoutMode == 0 ? "FIXED" : game.PayoutMode == 1 ? "50/50" : "GROSS %")</span>
                                            @if (game.IsProgressive) { <span class="extra-small fw-black text-primary text-uppercase" style="font-size: 0.55rem;">Progressive</span> }
                                        </div>
                                    </td>
                                    <td class="text-center">
                                        <span class="extra-small fw-bold @(game.LotteryPercentage.HasValue ? "text-danger" : "text-muted")">@gLot.ToString("N1")%</span>
                                    </td>
                                    <td class="text-center">
                                        @if (game.PayoutMode == 0)
                                        {
                                            <span class="badge bg-primary-subtle text-primary border border-primary border-opacity-10 fw-black px-2 py-1 rounded-pill extra-small">REMAINDER</span>
                                        }
                                        else
                                        {
                                            <span class="extra-small fw-bold @(game.ClubPercentage.HasValue ? "text-primary" : "text-muted")">@gClubEff.ToString("N1")%</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        @if (game.PayoutMode == 0)
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success border-opacity-10 fw-black px-2 py-1 rounded-pill extra-small">@game.DefaultPayout.ToString("C2")</span>
                                        }
                                        else
                                        {
                                            <span class="extra-small fw-black @(hasOverride ? "text-success" : "text-muted")">@gPlayerEff.ToString("N1")%</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        @if (hasOverride)
                                        {
                                            <span class="badge bg-warning-subtle text-warning border border-warning border-opacity-25" style="font-size: 0.6rem;">
                                                <i class="bi bi-sliders me-1"></i> CUSTOM
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="extra-small text-muted opacity-50">SHARED</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else if (ActiveTab == "Progressives")
    {
        <div class="glass-card shadow-sm border p-4">
            <h5 class="fw-black text-uppercase mb-3">Progressive Games & Target Goals</h5>
            <p class="text-muted small mb-3">Monitor historical play, view manual override logs, and adjust the current rolling ball targets for progressive games.</p>

            <div class="alert alert-info border-info border-opacity-25 rounded-4 mb-4" style="background: rgba(13, 110, 253, 0.05);">
                <h6 class="fw-bold text-primary mb-2 text-uppercase"><i class="bi bi-info-circle-fill me-2"></i> How Progressive Goals Work</h6>
                <div class="text-muted small mb-0" style="line-height: 1.5;">
                    <ul class="mb-0 ps-3">
                        <li class="mb-1"><strong>Baseline Goal:</strong> The starting ball count goal defined in the game setup.</li>
                        <li class="mb-1"><strong>Current Target Goal:</strong> The actual target goal active for the next/current tracking session.</li>
                        <li class="mb-1"><strong>Automatic Incrementing:</strong> If a bingo session is completed and locked with a ball count <em>higher</em> than the Current Target Goal (meaning the progressive jackpot was NOT won), the target goal automatically increments by <strong>1 ball</strong> for the next session.</li>
                        <li class="mb-1"><strong>Jackpot Reset:</strong> If the progressive jackpot IS won (a game is completed in <em>fewer or equal</em> balls than the Current Target Goal), the target goal automatically resets back to the <strong>Baseline Goal</strong> for the next session.</li>
                        <li class="mb-0"><strong>Manual Overrides:</strong> Use the controls below to adjust the Current Target Goal at any time. Any changes are saved to the server and logged in the audit trail.</li>
                    </ul>
                </div>
            </div>

            <div class="row g-4">
                @{
                    bool hasProgressives = false;
                }
                @foreach (var sheet in Sheets)
                {
                    @foreach (var game in sheet.Games.Where(g => g.IsProgressive))
                    {
                        hasProgressives = true;
                        <div class="col-12 mb-3">
                            <div class="card shadow-sm border rounded-4 overflow-hidden">
                                <div class="card-header border-bottom bg-light py-3 px-4 d-flex justify-content-between align-items-center" style="border-left: 6px solid @sheet.DisplayColor;">
                                    <div>
                                        <span class="badge bg-primary text-uppercase me-2" style="font-size: 0.65rem;">@sheet.ColorName</span>
                                        <strong class="text-dark text-uppercase fs-6">@game.GameName</strong>
                                    </div>
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="text-end me-2">
                                            <span class="extra-small fw-bold text-muted text-uppercase d-block" style="font-size: 0.55rem;">Baseline Goal</span>
                                            <span class="fw-bold text-dark">@game.ProgressiveBallGoal Balls</span>
                                        </div>
                                        <div class="border-start ps-3 d-flex align-items-center gap-2">
                                            <div style="width: 140px;">
                                                <span class="extra-small fw-black text-muted text-uppercase d-block mb-1" style="font-size: 0.55rem;">Current Goal</span>
                                                <div class="input-group input-group-sm">
                                                    <button class="btn btn-outline-dark" type="button" @onclick="() => DecrementCurrentGoal(game)"><i class="bi bi-dash-lg"></i></button>
                                                    <input type="number" class="form-control text-center fw-black fs-6" @bind="game.CurrentProgressiveBallGoal" style="min-width: 50px;" />
                                                    <button class="btn btn-outline-dark" type="button" @onclick="() => IncrementCurrentGoal(game)"><i class="bi bi-plus-lg"></i></button>
                                                </div>
                                            </div>
                                            <button class="btn btn-sm btn-primary rounded-pill px-3 shadow-sm fw-bold align-self-end mb-1" style="height: 31px;" @onclick="() => SaveProgressiveOverride(game)">
                                                SAVE
                                            </button>
                                        </div>
                                    </div>
                                </div>
                                <div class="card-body p-4 bg-white">
                                    <div class="row g-3 mb-2">
                                        <div class="col-md-3">
                                            <div class="p-3 border rounded-4 bg-light text-center">
                                                <span class="extra-small fw-black text-muted d-block text-uppercase mb-1">Jackpot Amount</span>
                                                <span class="fs-4 fw-black text-success">@game.ProgressiveJackpotAmount.ToString("C0")</span>
                                            </div>
                                        </div>
                                        <div class="col-md-3">
                                            <div class="p-3 border rounded-4 bg-light text-center">
                                                <span class="extra-small fw-black text-muted d-block text-uppercase mb-1">Consolation Amount</span>
                                                <span class="fs-4 fw-black text-danger">@game.ProgressiveConsolationAmount.ToString("C0")</span>
                                            </div>
                                        </div>
                                        <div class="col-md-6 d-flex align-items-center justify-content-end">
                                            <button class="btn btn-outline-primary rounded-pill px-4 fw-bold shadow-sm" @onclick="() => ToggleHistory(game)">
                                                <i class="bi @(IsHistoryExpanded(game) ? "bi-chevron-up" : "bi-clock-history") me-2"></i>
                                                @(IsHistoryExpanded(game) ? "HIDE LOGS" : "VIEW HISTORY LOGS")
                                            </button>
                                        </div>
                                    </div>

                                    @if (IsHistoryExpanded(game))
                                    {
                                        <div class="mt-3 border-top pt-3">
                                            <h6 class="fw-black text-uppercase text-muted mb-3" style="font-size: 0.75rem;"><i class="bi bi-clock-history me-1"></i> HISTORY & OVERRIDE LOG</h6>
                                            
                                            @if (GameHistoryLoading(game))
                                            {
                                                <div class="text-center py-3">
                                                    <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                                                    <span class="ms-2 text-muted extra-small">Loading history...</span>
                                                </div>
                                            }
                                            else if (!GetGameHistory(game).Any())
                                            {
                                                <div class="text-center py-4 bg-light rounded-4 text-muted italic extra-small">
                                                    No history found for this game.
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="table-responsive rounded-4 border">
                                                    <table class="table table-hover align-middle mb-0">
                                                        <thead class="bg-light">
                                                            <tr class="extra-small text-muted fw-black text-uppercase">
                                                                <th class="ps-4">Date / Time</th>
                                                                <th>Activity Type</th>
                                                                <th>Goal / Ball Value</th>
                                                                <th>Log Details</th>
                                                                <th class="pe-4">Performed By</th>
                                                            </tr>
                                                        </thead>
                                                        <tbody>
                                                            @foreach (var log in GetGameHistory(game))
                                                            {
                                                                <tr>
                                                                    <td class="ps-4 py-2 small fw-bold">@log.Timestamp.ToString("g")</td>
                                                                    <td>
                                                                        @if (log.Type == "Manual Override")
                                                                        {
                                                                            <span class="badge bg-warning-subtle text-warning border border-warning border-opacity-25 px-2 py-1 rounded-pill fw-bold" style="font-size: 0.6rem;">
                                                                                <i class="bi bi-sliders me-1"></i> OVERRIDE
                                                                            </span>
                                                                        }
                                                                        else
                                                                        {
                                                                            <span class="badge bg-success-subtle text-success border border-success border-opacity-25 px-2 py-1 rounded-pill fw-bold" style="font-size: 0.6rem;">
                                                                                <i class="bi bi-play-fill me-1"></i> SESSION PLAY
                                                                            </span>
                                                                        }
                                                                    </td>
                                                                    <td class="fw-black text-primary">@log.Value</td>
                                                                    <td class="small text-muted">@log.Details</td>
                                                                    <td class="pe-4 small fw-bold text-dark">@log.PerformedBy</td>
                                                                </tr>
                                                            }
                                                        </tbody>
                                                    </table>
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                }
                @if (!hasProgressives)
                {
                    <div class="col-12 text-center py-5">
                        <i class="bi bi-rocket-takeoff text-muted" style="font-size: 3rem; opacity: 0.3;"></i>
                        <p class="text-muted fw-bold mt-3">No Progressive Games Defined</p>
                        <small class="text-muted">Create or edit a game definition and turn on the "Progressive" toggle to manage it here.</small>
                    </div>
                }
            </div>
        </div>
    }
    else if (ActiveTab == "PullTabs")
    {
        <div class="d-flex justify-content-end mb-3">
            <button class="btn btn-primary btn-sm rounded-pill px-3 fw-bold" @onclick="() => OpenPullTabModal()">
                <i class="bi bi-plus-lg me-2"></i> ADD NEW PULL TAB GAME
            </button>
        </div>

        <div class="row g-4">
            @if (!PullTabGames.Any())
            {
                <div class="col-12 text-center py-5">
                    <div class="text-muted opacity-50 mb-2"><i class="bi bi-ticket-detailed fs-1"></i></div>
                    <p class="fw-bold text-muted">No Pull Tab games configured. Click "Add New Pull Tab Game" to start.</p>
                </div>
            }
            @foreach (var game in PullTabGames)
            {
                <div class="col-md-6 col-lg-4 col-xl-3">
                    <div class="glass-card h-100 shadow-sm border-top border-4 border-primary">
                        <div class="p-3">
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <div>
                                    <h5 class="fw-black mb-1 text-uppercase text-dark">@game.GameName</h5>
                                    <div class="d-flex flex-wrap gap-1">
                                        <span class="badge bg-light text-muted border">@game.DefaultTicketCount Tickets</span>
                                        <span class="badge bg-success-subtle text-success border border-success border-opacity-10">@game.TicketPrice.ToString("C2") / Ticket</span>
                                        @if (!game.IsActive)
                                        {
                                            <span class="badge bg-danger-subtle text-danger border border-danger border-opacity-10">INACTIVE</span>
                                        }
                                    </div>
                                </div>
                                <div class="dropdown">
                                    <button class="btn btn-link text-muted p-0" data-bs-toggle="dropdown">
                                        <i class="bi bi-three-dots-vertical"></i>
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end shadow border-0" style="z-index: 1050;">
                                        <li><a class="dropdown-item" @onclick="() => OpenPullTabModal(game)"><i class="bi bi-pencil me-2"></i> Edit</a></li>
                                        <li><a class="dropdown-item text-danger" @onclick="() => PromptDeletePullTabGame(game)"><i class="bi bi-trash me-2"></i> Delete</a></li>
                                    </ul>
                                </div>
                            </div>

                            <div class="game-list bg-light rounded-3 p-2 mb-3">
                                <label class="extra-small fw-black text-muted text-uppercase mb-2 d-block">Winner Options</label>
                                @if (!game.PrizeOptions.Any(o => !o.IsDeleted))
                                {
                                    <div class="text-center py-2 text-muted extra-small italic">No options defined</div>
                                }
                                @foreach (var opt in game.PrizeOptions.Where(o => !o.IsDeleted))
                                {
                                    <div class="d-flex align-items-center justify-content-between mb-1">
                                        <span class="small fw-bold"><i class="bi bi-dot text-primary"></i> @opt.OptionLabel</span>
                                        <span class="small fw-black text-success">@opt.PayoutAmount.ToString("C0")</span>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@if (ShowPullTabModal && EditingPullTabGame != null)
{
    <div class="modal fade show d-block" style="background: rgba(0,0,0,0.5); z-index: 1060;">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg" style="border-radius: 24px;">
                <div class="modal-header border-0 p-4 pb-0">
                    <h5 class="modal-title fw-black">@(EditingPullTabGame.Id == 0 ? "NEW PULL TAB GAME" : "EDIT PULL TAB GAME")</h5>
                    <button type="button" class="btn-close" @onclick="() => ShowPullTabModal = false"></button>
                </div>
                <div class="modal-body p-4 pt-2">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label extra-small fw-black text-muted mb-1 text-uppercase">Game Name</label>
                            <input type="text" class="form-control fw-bold" @bind="EditingPullTabGame.GameName" placeholder="e.g. Speedball" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label extra-small fw-black text-muted mb-1 text-uppercase">Default Ticket Count</label>
                            <input type="number" class="form-control fw-bold" @bind="EditingPullTabGame.DefaultTicketCount" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label extra-small fw-black text-muted mb-1 text-uppercase">Ticket Price</label>
                            <div class="input-group">
                                <span class="input-group-text bg-white fw-bold">$</span>
                                <input type="number" step="0.01" class="form-control fw-bold" @bind="EditingPullTabGame.TicketPrice" />
                            </div>
                        </div>
                        <div class="col-12">
                            <div class="form-check form-switch mt-2">
                                <input class="form-check-input" type="checkbox" id="ptActiveSwitch" @bind="EditingPullTabGame.IsActive" />
                                <label class="form-check-label fw-bold small" for="ptActiveSwitch">Game Active (show on tablet)</label>
                            </div>
                        </div>

                        <!-- Winner Options configuration -->
                        <div class="col-12 mt-4">
                            <div class="bg-light p-3 rounded-4">
                                <h6 class="fw-black text-uppercase text-muted mb-3" style="font-size: 0.75rem;">Configure Winner Options</h6>
                                
                                <div class="row g-2 mb-3">
                                    <div class="col-md-6">
                                        <input type="text" class="form-control form-control-sm fw-bold" @bind="NewPrizeOptionLabel" placeholder="Option Label (e.g. 3 Winners @@ $50.00)" />
                                    </div>
                                    <div class="col-md-4">
                                        <div class="input-group input-group-sm">
                                            <span class="input-group-text bg-white fw-bold">$</span>
                                            <input type="number" step="1" class="form-control fw-bold" @bind="NewPrizeOptionPayout" placeholder="Payout Amount" />
                                        </div>
                                    </div>
                                    <div class="col-md-2">
                                        <button class="btn btn-sm btn-dark w-100 rounded-3 fw-bold" @onclick="AddPrizeOptionToEditor">ADD OPTION</button>
                                    </div>
                                </div>

                                <div class="table-responsive rounded-3 border bg-white">
                                    <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
                                        <thead class="bg-light">
                                            <tr>
                                                <th class="ps-3">Option Label</th>
                                                <th style="width: 150px;">Expected Payout</th>
                                                <th style="width: 80px;" class="text-center">Action</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @if (!EditingPullTabGame.PrizeOptions.Any(o => !o.IsDeleted))
                                            {
                                                <tr>
                                                    <td colspan="3" class="text-center text-muted py-3 italic small">No winner options added yet.</td>
                                                </tr>
                                            }
                                            @foreach (var opt in EditingPullTabGame.PrizeOptions.Where(o => !o.IsDeleted))
                                            {
                                                <tr>
                                                    <td class="ps-3 fw-bold">@opt.OptionLabel</td>
                                                    <td class="fw-black text-success">@opt.PayoutAmount.ToString("C2")</td>
                                                    <td class="text-center">
                                                        <button class="btn btn-sm btn-link text-danger p-0" @onclick="() => opt.IsDeleted = true">
                                                            <i class="bi bi-trash"></i>
                                                        </button>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 p-4">
                    <button class="btn btn-light rounded-pill px-4" @onclick="() => ShowPullTabModal = false">CANCEL</button>
                    <button class="btn btn-primary rounded-pill px-4 fw-bold" @onclick="SavePullTabGame">SAVE CHANGES</button>
                </div>
            </div>
        </div>
    </div>
}

@if (ShowSheetModal && EditingSheet != null)
{
    <div class="modal fade show d-block" style="background: rgba(0,0,0,0.5); z-index: 1060;">
        <div class="modal-dialog modal-xl modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg" style="border-radius: 24px;">
                <div class="modal-header border-0 p-4 pb-0">
                    <h5 class="modal-title fw-black">@(EditingSheet.Id == 0 ? "NEW BINGO SHEET" : "EDIT BINGO SHEET")</h5>
                    <button type="button" class="btn-close" @onclick="() => ShowSheetModal = false"></button>
                </div>
                <div class="modal-body p-4 pt-2">
                    <div class="row g-4">
                        <!-- LEFT COLUMN: Sheet Settings & Payout Preview -->
                        <div class="col-lg-5">
                            <div class="bg-light p-4 rounded-4 h-100">
                                <div class="row g-3">
                                    <div class="col-md-8">
                                        <label class="form-label extra-small fw-black text-muted mb-1 text-uppercase">Color Name</label>
                                        <input type="text" class="form-control fw-black" @bind="EditingSheet.ColorName" placeholder="e.g. White" @onfocus="OnInputFocus" />
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label extra-small fw-black text-muted mb-1 text-uppercase">Display</label>
                                        <div class="d-flex gap-2">
                                            <input type="color" class="form-control form-control-color w-100 border-0" @bind="EditingSheet.DisplayColor" />
                                            <input type="number" class="form-control text-center fw-black" @bind="EditingSheet.DisplayOrder" style="width: 60px;" @onfocus="OnInputFocus" />
                                        </div>
                                    </div>

                                    <div class="col-12">
                                        <label class="form-label extra-small fw-black text-muted d-block mb-2 text-uppercase">Game Category</label>
                                        <div class="btn-group w-100 shadow-sm rounded-pill overflow-hidden" role="group">
                                            <input type="radio" class="btn-check" name="cat" id="cat1" checked="@(_uiCategory == 1)" @onchange="() => SetGameCategory(1)">
                                            <label class="btn btn-outline-primary border-0 fw-bold py-2" for="cat1" style="font-size: 0.7rem;">STANDARD</label>
                                            
                                            <input type="radio" class="btn-check" name="cat" id="cat2" checked="@(_uiCategory == 2)" @onchange="() => SetGameCategory(2)">
                                            <label class="btn btn-outline-primary border-0 fw-bold py-2" for="cat2" style="font-size: 0.7rem;">SPECIAL</label>
                                            
                                            <input type="radio" class="btn-check" name="cat" id="cat3" checked="@(_uiCategory == 3)" @onchange="() => SetGameCategory(3)">
                                            <label class="btn btn-outline-primary border-0 fw-bold py-2" for="cat3" style="font-size: 0.7rem;">FLOOR ONLY</label>
                                        </div>
                                    </div>

                                    <div class="col-12">
                                        <div class="p-3 border rounded-4 bg-white shadow-sm">
                                            @if (_uiCategory == 1) {
                                                <div class="text-center py-2">
                                                    <i class="bi bi-lock-fill text-muted mb-1 d-block fs-4"></i>
                                                    <span class="extra-small fw-black text-muted text-uppercase">9-Pack (Admissions Only)</span>
                                                    <div class="mt-2 p-2 bg-primary bg-opacity-10 rounded-3 border border-primary border-opacity-10">
                                                        <p class="extra-small fw-bold text-primary mb-0" style="font-size: 0.6rem;">
                                                            <i class="bi bi-info-circle-fill me-1"></i> NOTE: State Tax for standard sheets is automatically deducted from the total Admission Revenue as a 5% lump sum.
                                                        </p>
                                                    </div>
                                                </div>
                                            } else if (_uiCategory == 2) {
                                                <div class="d-flex justify-content-between align-items-center mb-2">
                                                    <label class="extra-small fw-black text-muted mb-0">ALLOW FLOOR SALES?</label>
                                                    <div class="form-check form-switch m-0">
                                                        <input class="form-check-input" type="checkbox" role="switch" checked="@(!EditingSheet.IsAdmissionOnly)" @onchange="@(e => OnFloorSalesToggle((bool)(e.Value ?? true)))">
                                                    </div>
                                                </div>
                                                @if (!EditingSheet.IsAdmissionOnly) {
                                                    <div class="input-group input-group-sm">
                                                        <span class="input-group-text bg-light border-0 fw-bold">$</span>
                                                        <input type="number" step="0.50" class="form-control border-0 bg-light fw-black" @bind="EditingSheet.DefaultPrice" @onfocus="OnInputFocus" />
                                                    </div>
                                                }
                                            } else {
                                                <div class="d-flex justify-content-between align-items-center">
                                                    <label class="extra-small fw-black text-primary mb-0"><i class="bi bi-cart-check-fill me-1"></i> FLOOR SALE PRICE</label>
                                                    <div class="input-group input-group-sm" style="width: 120px;">
                                                        <span class="input-group-text bg-light border-0 fw-bold">$</span>
                                                        <input type="number" step="0.50" class="form-control border-0 bg-light fw-black" @bind="EditingSheet.DefaultPrice" @onfocus="OnInputFocus" />
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                    @if (_uiCategory != 1)
                                    {
                                        <!-- SHEET LEVEL SETTINGS (Specials/Floor Only) -->
                                        <div class="col-12 mt-3">
                                            <div class="p-3 border rounded-4 bg-light bg-opacity-25 shadow-sm">
                                                <div class="row g-3">
                                                    <div class="col-12 text-center">
                                                        <label class="extra-small fw-black text-danger d-block mb-1">STATE LOTTERY TAX (%)</label>
                                                        <div class="input-group input-group-sm mx-auto" style="max-width: 150px;">
                                                            <input type="number" step="0.1" class="form-control fw-bold border-danger border-opacity-25 text-center" value="@(EditingSheet.LotteryPercentage * 100)" 
                                                                   @onchange="@(e => { if (decimal.TryParse(e.Value?.ToString(), out var v)) EditingSheet.LotteryPercentage = v / 100m; })" 
                                                                   @onfocus="OnInputFocus" />
                                                            <span class="input-group-text fw-bold border-danger border-opacity-25 text-danger">%</span>
                                                        </div>
                                                        <div class="extra-small text-muted mt-1" style="font-size: 0.55rem;">Applied globally to all games on this sheet</div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>

                        <!-- RIGHT COLUMN: Games Configuration -->
                        <div class="col-lg-7">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <label class="extra-small fw-black text-muted text-uppercase mb-0 px-2">Games & Payout Setup</label>
                                <button class="btn btn-sm btn-primary rounded-pill px-3 shadow-sm fw-bold" @onclick="AddGameToEditor">
                                    <i class="bi bi-plus-lg me-1"></i> ADD GAME
                                </button>
                            </div>

                            <div class="d-flex flex-column gap-3 overflow-auto pr-2" style="max-height: 580px; padding-bottom: 20px;">
                                @foreach (var game in EditingSheet.Games.OrderBy(g => g.DisplayOrder))
                                {
                                    <div class="bg-white p-3 rounded-4 border shadow-sm border-opacity-50">
                                        @{
                                            decimal gLot = (_uiCategory == 1 ? 0m : EditingSheet.LotteryPercentage) * 100;
                                            if (game.PayoutMode == 1) game.ClubPercentage = 0.5m;
                                            if (game.PayoutMode == 2 && (game.ClubPercentage == null || game.ClubPercentage == 0.5m)) game.ClubPercentage = 0.05m;
                                            
                                            decimal gClubInput = (game.ClubPercentage ?? (game.PayoutMode == 2 ? 0.05m : 0.5m)) * 100;
                                            decimal gTotalClub = (game.PayoutMode == 1) ? (100 - gLot) * (gClubInput / 100) : gClubInput;
                                            decimal gPlayer = 100 - gLot - gTotalClub;
                                        }
                                        <!-- Row 1: Identity -->
                                        <div class="d-flex gap-3 align-items-center mb-3">
                                            <div style="width: 40px;">
                                                <label class="extra-small fw-black text-muted d-block text-center mb-1">#</label>
                                                <input type="number" class="form-control form-control-sm fw-black text-center border-0 bg-light" @bind="game.DisplayOrder" @onfocus="OnInputFocus" />
                                            </div>
                                            <div class="flex-grow-1">
                                                <label class="extra-small fw-black text-muted d-block mb-1">GAME NAME</label>
                                                <input type="text" class="form-control form-control-sm fw-black border-0 bg-light text-uppercase" @bind="game.GameName" placeholder="e.g. Regular Bingo" @onfocus="OnInputFocus" />
                                            </div>
                                            <div class="d-flex align-items-end gap-2">
                                                <div class="form-check form-switch m-0 pt-3 d-flex align-items-center gap-2">
                                                    <input class="form-check-input" type="checkbox" role="switch" id="prog-@game.GetHashCode()" @bind="game.IsProgressive">
                                                    <label class="form-check-label extra-small fw-black text-muted text-uppercase mb-0" for="prog-@game.GetHashCode()" style="font-size: 0.6rem;">PROGRESSIVE</label>
                                                </div>
                                                <button class="btn btn-sm btn-light text-danger rounded-circle border-0 mt-3" @onclick="() => PromptRemoveGame(game)">
                                                    <i class="bi bi-trash-fill"></i>
                                                </button>
                                            </div>
                                        </div>

                                        <!-- Row 2: Payout Configuration -->
                                        <div class="row g-2 mb-3">
                                            <div class="col-md-5">
                                                <label class="extra-small fw-black text-muted d-block mb-1">PAYOUT MODE</label>
                                                <select class="form-select form-select-sm fw-bold border-0 bg-light rounded-3" @bind="game.PayoutMode">
                                                    <option value="0">FIXED PRIZE</option>
                                                    <option value="1">50/50 SPLIT</option>
                                                    <option value="2">GROSS %</option>
                                                </select>
                                            </div>
                                            <div class="col-md-7">
                                                @if (game.PayoutMode == 0) {
                                                    <label class="extra-small fw-black text-muted d-block mb-1">PRIZE AMOUNT ($)</label>
                                                    <div class="input-group input-group-sm">
                                                        <span class="input-group-text border-0 bg-light fw-bold">$</span>
                                                        <input type="number" class="form-control form-control-sm fw-black border-0 bg-light" @bind="game.DefaultPayout" @onfocus="OnInputFocus" />
                                                    </div>
                                                } else if (game.PayoutMode == 1) {
                                                    <label class="extra-small fw-black text-muted d-block mb-1">CLUB SPLIT %</label>
                                                    <div class="bg-light rounded-3 px-3 py-1 text-center border-0">
                                                        <span class="fw-black text-primary">50.0%</span>
                                                        <span class="extra-small text-muted ms-2 italic">(Automatic)</span>
                                                    </div>
                                                } else {
                                                    <label class="extra-small fw-black text-muted d-block mb-1">CLUB TAKE % (GROSS)</label>
                                                    <div class="bg-light rounded-3 px-3 py-1 text-center border-0">
                                                        <span class="fw-black text-primary">@((game.ClubPercentage ?? 0.05m) * 100)%</span>
                                                        <span class="extra-small text-muted ms-2 italic">(Automatic)</span>
                                                    </div>
                                                }
                                            </div>
                                        </div>

                                        <!-- Row 3: Special Payout Details / Preview -->
                                        <div class="mt-2 p-2 rounded-3 @(game.IsProgressive ? "bg-primary bg-opacity-10 border border-primary border-opacity-10" : "bg-light border-0")">
                                            @if (game.IsProgressive) {
                                                <div class="row g-2">
                                                    <div class="col-4">
                                                        <label class="extra-small fw-black text-muted d-block">BALL GOAL</label>
