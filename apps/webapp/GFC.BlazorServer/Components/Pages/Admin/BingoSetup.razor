    private bool IsHistoryExpanded(BingoGameDefinition game) => _expandedGames.Contains(game.Id);
    private bool GameHistoryLoading(BingoGameDefinition game) => _loadingHistoryGames.Contains(game.Id);
    private List<ProgressiveHistoryDto> GetGameHistory(BingoGameDefinition game) => 
        _gameHistories.TryGetValue(game.Id, out var list) ? list : new List<ProgressiveHistoryDto>();

    private void IncrementCurrentGoal(BingoGameDefinition game)
    {
        game.CurrentProgressiveBallGoal++;
    }

    private void DecrementCurrentGoal(BingoGameDefinition game)
    {
        if (game.CurrentProgressiveBallGoal > 0)
            game.CurrentProgressiveBallGoal--;
    }

    private async Task ToggleHistory(BingoGameDefinition game)
    {
        if (_expandedGames.Contains(game.Id))
        {
            _expandedGames.Remove(game.Id);
        }
        else
        {
            _expandedGames.Add(game.Id);
            if (!_gameHistories.ContainsKey(game.Id))
            {
                await LoadGameHistory(game);
            }
        }
    }

    private async Task LoadGameHistory(BingoGameDefinition game)
    {
        var sheet = Sheets.FirstOrDefault(s => s.Games.Any(g => g.Id == game.Id));
        if (sheet == null) return;

        _loadingHistoryGames.Add(game.Id);
        StateHasChanged();

        try
        {
            var events = new List<ProgressiveHistoryDto>();

            // 1. Get ALL Game Entries from DB to trace progression accurately
            var entries = await DbContext.BingoGameEntries
                .Include(e => e.Session)
                .Where(e => e.GameName == game.GameName 
                            && e.SheetColor == sheet.ColorName 
                            && e.BallsCalled > 0 
                            && e.Session != null 
                            && !e.Session.IsDeleted 
                            && !e.IsDeleted)
                .OrderBy(e => e.Session!.SessionDate)
                .ToListAsync();

            foreach (var e in entries)
            {
                events.Add(new ProgressiveHistoryDto
                {
                    Timestamp = e.Session!.SessionDate,
                    Type = "Session Play",
                    Value = e.BallsCalled,
                    BallsCalled = e.BallsCalled,
                    PrizePaid = e.PrizePaid,
                    PerformedBy = e.CreatedBy ?? "System"
                });
            }

            // 2. Get Audit logs
            var auditResult = await AuditLogRepository.GetAuditLogsAsync(
                "Override Progressive Ball Goal",
                $"'{sheet.ColorName} - {game.GameName}'",
                null, null, null, 1, 500
            );

            if (auditResult?.Items != null)
            {
                foreach (var a in auditResult.Items)
                {
                    int goalVal = 0;
                    var parts = a.Details?.Split("to ");
                    if (parts != null && parts.Length > 1 && int.TryParse(parts[1].TrimEnd('.'), out var g))
                    {
                        goalVal = g;
                    }

                    events.Add(new ProgressiveHistoryDto
                    {
                        Timestamp = a.TimestampUtc.ToLocalTime(),
                        Type = "Manual Override",
                        Value = goalVal,
                        Details = a.Details ?? "Manual override applied.",
                        PerformedBy = a.PerformedByDisplayName
                    });
                }
            }

            int baselineGoal = game.ProgressiveBallGoal;
            var sortedEvents = events.OrderBy(ev => ev.Timestamp).ToList();
            int currentGoal = baselineGoal;

            foreach (var ev in sortedEvents)
            {
                if (ev.Type == "Manual Override")
                {
                    currentGoal = ev.Value;
                }
                else if (ev.Type == "Session Play")
                {
                    ev.BallGoal = currentGoal;
                    ev.Details = $"Balls pulled: {ev.BallsCalled}. Ball goal: {ev.BallGoal}. Prize paid: {ev.PrizePaid:C2}.";

                    if (ev.BallsCalled <= currentGoal)
                    {
                        currentGoal = baselineGoal;
                    }
                    else
                    {
                        currentGoal++;
                    }
                }
            }

            _gameHistories[game.Id] = sortedEvents.OrderByDescending(h => h.Timestamp).Take(25).ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading progressive history: {ex.Message}");
        }
        finally
        {
            _loadingHistoryGames.Remove(game.Id);
            StateHasChanged();
        }
    }

    private async Task SaveProgressiveOverride(BingoGameDefinition game)
    {
        var sheet = Sheets.FirstOrDefault(s => s.Games.Any(g => g.Id == game.Id));
        if (sheet == null) return;

        try
        {
            var target = await DbContext.BingoGameDefinitions.FindAsync(game.Id);
            if (target != null)
            {
                int oldGoal = target.CurrentProgressiveBallGoal;
                target.CurrentProgressiveBallGoal = game.CurrentProgressiveBallGoal;
                target.DateLastProgressed = DateTime.UtcNow.Date;
                target.ModifiedAt = DateTime.UtcNow;
                
                var authState = await AuthStateProvider.GetAuthenticationStateAsync();
                var username = authState.User.Identity?.Name ?? "Staff";
                target.ModifiedBy = username;

                await DbContext.SaveChangesAsync();

                // Log audit
                var user = await DbContext.AppUsers.FirstOrDefaultAsync(u => u.Username == username);
                var audit = new AuditLogEntry
                {
                    TimestampUtc = DateTime.UtcNow,
                    PerformedByUserId = user?.UserId,
                    Action = "Override Progressive Ball Goal",
                    Details = $"Manual override for '{sheet.ColorName} - {game.GameName}'. Changed current goal from {oldGoal} to {game.CurrentProgressiveBallGoal}.",
                    PageUrl = "/admin/bingo/setup"
                };
                await AuditLogRepository.InsertAsync(audit);

                await JSRuntime.InvokeVoidAsync("alert", "Goal updated and audit logged successfully!");
                
                // Refresh history for this game
                await LoadGameHistory(game);
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", "Error saving override: " + ex.Message);
        }
    }

    private void OpenPullTabModal(PullTabGameDefinition game = null)
    {
        if (game == null)
        {
            EditingPullTabGame = new PullTabGameDefinition { IsActive = true };
        }
        else
        {
            EditingPullTabGame = new PullTabGameDefinition
            {
                Id = game.Id,
                GameName = game.GameName,
                DefaultTicketCount = game.DefaultTicketCount,
                TicketPrice = game.TicketPrice,
                IsActive = game.IsActive,
                PrizeOptions = game.PrizeOptions.Select(o => new PullTabPrizeOption
                {
                    Id = o.Id,
                    GameDefinitionId = o.GameDefinitionId,
                    OptionLabel = o.OptionLabel,
                    PayoutAmount = o.PayoutAmount,
                    IsActive = o.IsActive,
                    IsDeleted = o.IsDeleted
                }).ToList()
            };
        }
        NewPrizeOptionLabel = "";
        NewPrizeOptionPayout = 0;
        ShowPullTabModal = true;
    }

    private void AddPrizeOptionToEditor()
    {
        if (string.IsNullOrWhiteSpace(NewPrizeOptionLabel) || NewPrizeOptionPayout <= 0) return;
        EditingPullTabGame.PrizeOptions.Add(new PullTabPrizeOption
        {
            OptionLabel = NewPrizeOptionLabel,
            PayoutAmount = NewPrizeOptionPayout,
            IsActive = true
        });
        NewPrizeOptionLabel = "";
        NewPrizeOptionPayout = 0;
    }

    private async Task SavePullTabGame()
    {
        try
        {
            if (EditingPullTabGame.Id == 0)
            {
                var activeOptions = EditingPullTabGame.PrizeOptions.Where(o => !o.IsDeleted).ToList();
                EditingPullTabGame.PrizeOptions = activeOptions;
                DbContext.PullTabGameDefinitions.Add(EditingPullTabGame);
            }
            else
            {
                var target = await DbContext.PullTabGameDefinitions
                    .Include(g => g.PrizeOptions)
                    .FirstOrDefaultAsync(g => g.Id == EditingPullTabGame.Id);
                if (target != null)
                {
                    target.GameName = EditingPullTabGame.GameName;
                    target.DefaultTicketCount = EditingPullTabGame.DefaultTicketCount;
                    target.TicketPrice = EditingPullTabGame.TicketPrice;
                    target.IsActive = EditingPullTabGame.IsActive;

                    // Process options: update existing, add new, and soft-delete deleted ones
                    foreach (var o in EditingPullTabGame.PrizeOptions)
                    {
                        if (o.Id == 0)
                        {
                            if (!o.IsDeleted)
                            {
                                target.PrizeOptions.Add(new PullTabPrizeOption
                                {
                                    OptionLabel = o.OptionLabel,
                                    PayoutAmount = o.PayoutAmount,
                                    IsActive = o.IsActive,
                                    GameDefinitionId = target.Id
                                });
                            }
                        }
                        else
                        {
                            var existingOpt = target.PrizeOptions.FirstOrDefault(x => x.Id == o.Id);
                            if (existingOpt != null)
                            {
                                if (o.IsDeleted)
                                {
                                    existingOpt.IsDeleted = true;
                                }
                                else
                                {
                                    existingOpt.OptionLabel = o.OptionLabel;
                                    existingOpt.PayoutAmount = o.PayoutAmount;
                                    existingOpt.IsActive = o.IsActive;
                                }
                            }
                        }
                    }
                }
            }
            await DbContext.SaveChangesAsync();
            ShowPullTabModal = false;
            await LoadData();
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", "Error saving game definition: " + ex.Message + (ex.InnerException != null ? " -> " + ex.InnerException.Message : ""));
        }
    }

    private async Task DeletePullTabGame(PullTabGameDefinition game)
    {
        var target = await DbContext.PullTabGameDefinitions.FirstOrDefaultAsync(g => g.Id == game.Id);
        if (target != null)
        {
            target.IsDeleted = true;
            await DbContext.SaveChangesAsync();
            await LoadData();
        }
    }

    private void PromptDeletePullTabGame(PullTabGameDefinition game)
    {
        ConfirmTitle = "Delete Pull Tab Game";
        ConfirmMessage = $"Are you sure you want to delete '{game.GameName}'?";
        ConfirmSubMessage = "This configuration will no longer be available for the tablet app.";
        ConfirmAction = () => DeletePullTabGame(game);
        ShowConfirm = true;
    }

