@code {
    private bool Loading { get; set; } = true;
    private string ErrorMessage { get; set; }
    private string ActiveTab { get; set; } = "Sheets";
    private List<BingoSheetDefinition> Sheets { get; set; } = new();
    private List<BingoAdmissionDefinition> Admissions { get; set; } = new();
    private List<BingoPayoutTier> PayoutTiers { get; set; } = new();
    private SystemSettings SystemSettings { get; set; } = new();
    
    private bool ShowSheetModal { get; set; }
    private BingoSheetDefinition EditingSheet { get; set; } = new();
    
    private bool ShowAdmissionModal { get; set; }
    private BingoAdmissionDefinition EditingAdmission { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        if (!await HasAccess()) 
        {
            Navigation.NavigateTo("/access-denied");
            return;
        }
        await LoadData();
    }

    private async Task<bool> HasAccess()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        if (user.IsInRole("Admin")) return true;

        var userIdClaim = user.FindFirst("UserId") ?? user.FindFirst(ClaimTypes.NameIdentifier);
        if (userIdClaim != null && int.TryParse(userIdClaim.Value, out var userId))
        {
            var permissions = UserService.GetUserPagePermissions(userId);
            return permissions != null && permissions.Any(p => p.PageRoute == "/admin/bingo/setup");
        }
        return false;
    }

    private async Task LoadData()
    {
        try 
        {
            Loading = true;
            Sheets = await DbContext.BingoSheetDefinitions
                .Include(s => s.Games)
                .Where(s => !s.IsDeleted)
                .OrderBy(s => s.DisplayOrder)
                .ToListAsync();
                
            Admissions = await DbContext.BingoAdmissionDefinitions
                .Where(a => !a.IsDeleted)
                .OrderBy(a => a.DisplayOrder)
                .ToListAsync();

            PayoutTiers = await DbContext.BingoPayoutTiers
                .Where(t => !t.IsDeleted)
                .OrderBy(t => t.MinAdmissions)
                .ToListAsync();

            SystemSettings = await SettingsService.GetAsync();
                
            Loading = false;
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message + (ex.InnerException != null ? " -> " + ex.InnerException.Message : "");
            Loading = false;
        }
    }

    private async Task SaveGlobalSettings()
    {
        var existing = await SettingsService.GetAsync();
        if (existing != null)
        {
            existing.BingoBaseAdmissionPrice = SystemSettings.BingoBaseAdmissionPrice;
            existing.BingoAdditionalCardPrice = SystemSettings.BingoAdditionalCardPrice;
            existing.BingoPayoutRoundingMode = SystemSettings.BingoPayoutRoundingMode;
            await SettingsService.SaveSettingsAsync(existing);
            await JSRuntime.InvokeVoidAsync("alert", "Settings updated successfully!");
        }
    }

    private void AddPayoutTier()
    {
        PayoutTiers.Add(new BingoPayoutTier { PayoutPercentage = 100 });
    }

    private async Task SavePayoutTiers()
    {
        // 1. Validation: No duplicate MinAdmissions
        var duplicates = PayoutTiers.GroupBy(t => t.MinAdmissions)
                                   .Where(g => g.Count() > 1)
                                   .Select(g => g.Key)
                                   .ToList();

        if (duplicates.Any())
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Cannot save: Multiple tiers found for {duplicates.First()} admissions. Each tier must have a unique minimum value.");
            return;
        }

        // 2. Clear and Save
        var existing = await DbContext.BingoPayoutTiers.Where(t => !t.IsDeleted).ToListAsync();
        DbContext.BingoPayoutTiers.RemoveRange(existing);
        await DbContext.SaveChangesAsync(); // Flush deletes first
        
        foreach (var tier in PayoutTiers)
        {
            var newTier = new BingoPayoutTier 
            { 
                MinAdmissions = tier.MinAdmissions, 
                PayoutPercentage = tier.PayoutPercentage,
                CreatedAt = DateTime.UtcNow,
                CreatedBy = "Admin"
            };
            DbContext.BingoPayoutTiers.Add(newTier);
        }
        
        await DbContext.SaveChangesAsync();
        await JSRuntime.InvokeVoidAsync("alert", "Payout tiers saved successfully!");
        await LoadData();
    }

    private void OpenSheetModal(BingoSheetDefinition sheet = null)
    {
        if (sheet == null)
        {
            EditingSheet = new BingoSheetDefinition { DisplayColor = "#3b82f6" };
        }
        else
        {
            EditingSheet = new BingoSheetDefinition
            {
                Id = sheet.Id,
                ColorName = sheet.ColorName,
                DisplayColor = sheet.DisplayColor,
                DefaultPrice = sheet.DefaultPrice,
                LotteryPercentage = sheet.LotteryPercentage,
                ClubPercentage = sheet.ClubPercentage,
                IsIncludedInAdmission = sheet.IsIncludedInAdmission,
                IsAdmissionOnly = sheet.IsAdmissionOnly,
                DisplayOrder = sheet.DisplayOrder,
                PayoutMode = sheet.PayoutMode,
                Games = sheet.Games.Select(g => new BingoGameDefinition 
                { 
                    Id = 0, 
                    GameName = g.GameName, 
                    DisplayOrder = g.DisplayOrder, 
                    DefaultPayout = g.DefaultPayout,
                    IsVariablePayout = g.IsVariablePayout,
                    PayoutMode = g.PayoutMode,
                    IsProgressive = g.IsProgressive,
                    ProgressiveBallGoal = g.ProgressiveBallGoal,
                    CurrentProgressiveBallGoal = g.CurrentProgressiveBallGoal,
                    ProgressiveJackpotAmount = g.ProgressiveJackpotAmount,
                    ProgressiveConsolationAmount = g.ProgressiveConsolationAmount,
                    LotteryPercentage = g.LotteryPercentage,
                    ClubPercentage = g.ClubPercentage
                }).ToList()
            };

            // Set UI category state
            if (sheet.IsIncludedInAdmission && sheet.IsAdmissionOnly) _uiCategory = 1; // Standard
            else if (sheet.IsIncludedInAdmission && !sheet.IsAdmissionOnly) _uiCategory = 2; // Special
            else _uiCategory = 3; // Floor
        }
        ShowSheetModal = true;
    }

    private void OpenAdmissionModal(BingoAdmissionDefinition pack = null)
    {
        if (pack == null)
        {
            EditingAdmission = new BingoAdmissionDefinition { DisplayColor = "#3b82f6", DisplayOrder = Admissions.Count + 1 };
        }
        else
        {
            EditingAdmission = new BingoAdmissionDefinition
            {
                Id = pack.Id,
                Name = pack.Name,
                DisplayColor = pack.DisplayColor,
                Price = pack.Price,
                DisplayOrder = pack.DisplayOrder
            };
        }
        ShowAdmissionModal = true;
    }


    private void AddGameToEditor()
    {
        EditingSheet.Games.Add(new BingoGameDefinition 
        { 
            GameName = "New Game", 
            DisplayOrder = EditingSheet.Games.Count + 1,
            PayoutMode = 0 // Default to Fixed
        });
    }

    private async Task SaveSheet()
    {
        if (EditingSheet.Id == 0) DbContext.BingoSheetDefinitions.Add(EditingSheet);
        else
        {
            var target = await DbContext.BingoSheetDefinitions.Include(s => s.Games).FirstOrDefaultAsync(s => s.Id == EditingSheet.Id);
            if (target != null)
            {
                target.ColorName = EditingSheet.ColorName;
                target.DisplayColor = EditingSheet.DisplayColor;
                target.DefaultPrice = EditingSheet.DefaultPrice;
                target.LotteryPercentage = EditingSheet.LotteryPercentage;
                target.ClubPercentage = EditingSheet.ClubPercentage;
                target.IsIncludedInAdmission = EditingSheet.IsIncludedInAdmission;
                target.IsAdmissionOnly = EditingSheet.IsAdmissionOnly;
                target.DisplayOrder = EditingSheet.DisplayOrder;
                target.PayoutMode = (target.IsIncludedInAdmission && target.IsAdmissionOnly) ? 0 : EditingSheet.PayoutMode;

                // Robust collection update: Clear existing and add new to ensure EF tracks the changes correctly
                target.Games.Clear();
                foreach (var g in EditingSheet.Games)
                {
                    // For new progressives, initialize the current goal to the starting goal if not set
                    if (g.IsProgressive && g.CurrentProgressiveBallGoal == 0) 
                        g.CurrentProgressiveBallGoal = g.ProgressiveBallGoal;
                    
                    g.SheetDefinitionId = target.Id;
                    target.Games.Add(new BingoGameDefinition 
                    {
                        GameName = g.GameName,
                        DisplayOrder = g.DisplayOrder,
                        DefaultPayout = g.DefaultPayout,
                        IsVariablePayout = g.IsVariablePayout,
                        PayoutMode = g.PayoutMode,
                        IsProgressive = g.IsProgressive,
                        ProgressiveBallGoal = g.ProgressiveBallGoal,
                        CurrentProgressiveBallGoal = g.CurrentProgressiveBallGoal,
                        ProgressiveJackpotAmount = g.ProgressiveJackpotAmount,
                        ProgressiveConsolationAmount = g.ProgressiveConsolationAmount,
                        LotteryPercentage = g.LotteryPercentage,
                        ClubPercentage = g.ClubPercentage,
                        SheetDefinitionId = target.Id,
                        IsActive = true
                    });
                }
            }
        }
        await DbContext.SaveChangesAsync();
        ShowSheetModal = false;
        await LoadData();
    }

    private void CancelEdit()
    {
        ShowSheetModal = false;
        EditingSheet = null;
    }

    private int _uiCategory = 1; // 1=Standard, 2=Special, 3=Floor

    private void EditBingoSheet(BingoSheetDefinition sheet)
    {
        EditingSheet = sheet;
        if (sheet.IsIncludedInAdmission && sheet.IsAdmissionOnly) _uiCategory = 1; // Standard
        else if (sheet.IsIncludedInAdmission && !sheet.IsAdmissionOnly) _uiCategory = 2; // Special
        else _uiCategory = 3; // Floor
        
        StateHasChanged();
    }

    private void SetGameCategory(int type)
    {
        if (EditingSheet == null) return;
        _uiCategory = type;
        
        switch (type)
        {
            case 1: // Standard (9-Pack)
                EditingSheet.IsIncludedInAdmission = true;
                EditingSheet.IsAdmissionOnly = true; // Lock to NO floor sales
                EditingSheet.DefaultPrice = 0;
                EditingSheet.LotteryPercentage = 0.05m;
                EditingSheet.ClubPercentage = 0.0m;
                EditingSheet.PayoutMode = 0; // Standard is always fixed prizes
                break;
            case 2: // Special (Incl w/ Admit)
                EditingSheet.IsIncludedInAdmission = true;
                // Allow the user to choose. We default to YES (IsAdmissionOnly = false)
                EditingSheet.IsAdmissionOnly = false; 
                if (EditingSheet.DefaultPrice == 0) EditingSheet.DefaultPrice = 1.00m;
                break;
            case 3: // Floor Only
                EditingSheet.IsIncludedInAdmission = false;
                EditingSheet.IsAdmissionOnly = false; // Lock to YES floor sales
                if (EditingSheet.DefaultPrice == 0) EditingSheet.DefaultPrice = 1.00m;
                break;
        }
    }

    private void OnFloorSalesToggle(bool allowed)
    {
        if (EditingSheet == null) return;
        
        EditingSheet.IsAdmissionOnly = !allowed;
        if (EditingSheet.IsAdmissionOnly)
        {
            EditingSheet.IsIncludedInAdmission = true;
            EditingSheet.PayoutMode = 0; // Lock to Fixed
            EditingSheet.DefaultPrice = 0; // Price not used
        }
    }

    private async Task SaveAdmission()
    {
        EditingAdmission.DisplayColor = "#3b82f6";
        if (EditingAdmission.Id == 0) DbContext.BingoAdmissionDefinitions.Add(EditingAdmission);
        else
        {
            var existing = await DbContext.BingoAdmissionDefinitions.FirstOrDefaultAsync(a => a.Id == EditingAdmission.Id);
            if (existing != null)
            {
                existing.Name = EditingAdmission.Name;
                existing.DisplayColor = EditingAdmission.DisplayColor;
                existing.Price = EditingAdmission.Price;
                existing.DisplayOrder = EditingAdmission.DisplayOrder;
            }
        }
        await DbContext.SaveChangesAsync();
        ShowAdmissionModal = false;
        await LoadData();
    }

    private async Task DeleteSheet(BingoSheetDefinition sheet)
    {
        sheet.IsDeleted = true;
        await DbContext.SaveChangesAsync();
        await LoadData();
    }

    private async Task DeleteAdmission(BingoAdmissionDefinition pack)
    {
        pack.IsDeleted = true;
        await DbContext.SaveChangesAsync();
        await LoadData();
    }

    private async Task OnInputFocus(FocusEventArgs e)
    {
        await JSRuntime.InvokeVoidAsync("eval", "document.activeElement.select()");
    }
}
