@page "/admin/bingo/expenses"
@layout GFC.BlazorServer.Components.Layout.FullPageLayout
@using GFC.Core.Models
@using GFC.BlazorServer.Data
@using Microsoft.EntityFrameworkCore
@using global::System.Security.Claims
@using global::System.Globalization
@using global::System.Text.Json
@inject GfcDbContext DbContext
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject GFC.Core.Interfaces.IUserManagementService UserService
@inject GFC.BlazorServer.Services.CustomAuthenticationStateProvider AuthStateProvider
@attribute [Authorize]

<PageTitle>Bingo Bank Ledger & Expense Center</PageTitle>

<div class="expense-center">
    <div class="container-fluid px-4 d-flex flex-column h-100 overflow-hidden" style="max-width: 1600px; padding-top: 1rem; padding-bottom: 1rem;">
        
        <!-- Premium Header & Stats Banner -->
        <div class="header-dashboard-banner mb-4">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                <div class="d-flex align-items-center gap-3">
                    <button class="btn btn-back-circle shadow-sm" @onclick='() => Navigation.NavigateTo("/admin/bingo")' title="Back to Bingo">
                        <i class="bi bi-arrow-left fs-4"></i>
                    </button>
                    <div>
                        <h1 class="fw-black text-white m-0 tracking-tight" style="font-size: 2rem; letter-spacing: -0.5px;">BINGO BANK LEDGER</h1>
                        <p class="small fw-bold text-uppercase m-0" style="color: rgba(255, 255, 255, 0.85) !important;">Track transactions, manage cash, and reconcile bank statements</p>
                    </div>
                </div>
                
                <div class="d-flex gap-3 align-items-center">
                    <!-- Balance Metric Card -->
                    <div class="metric-card ledger-balance shadow-sm">
                        <span class="metric-label">LEDGER BALANCE</span>
                        <h3 class="metric-value @(AccountBalance >= 0 ? "text-success" : "text-danger")">
                            @AccountBalance.ToString("C2")
                        </h3>
                    </div>

                    <!-- Reconciled Balance Metric Card -->
                    <div class="metric-card reconciled-balance shadow-sm">
                        <span class="metric-label">RECONCILED BALANCE</span>
                        <h3 class="metric-value">
                            @ReconciledBalance.ToString("C2")
                        </h3>
                    </div>

                    <!-- Compact Loans Metric Card or Toggle Button -->
                    @if (TotalOutstandingLoans > 0)
                    {
                        <div class="metric-card outstanding-loans shadow-sm clickable text-center" @onclick="() => ShowLoansModal = true" style="cursor: pointer; min-height: 82px;" title="Click to view or repay active loans">
                            <span class="metric-label">OUTSTANDING LOANS ⚠️</span>
                            <h3 class="metric-value mb-1">
                                @TotalOutstandingLoans.ToString("C2")
                            </h3>
                            <span class="badge bg-warning text-dark py-1 px-2.5 rounded-pill fw-black animate-pulse" style="font-size: 0.55rem; letter-spacing: 0.5px;">REPAY / MANAGE ➔</span>
                        </div>
                    }
                    else
                    {
                        <button class="btn btn-outline-light shadow-sm d-flex align-items-center gap-2" style="height: 52px; border-radius: 16px; font-weight: 900; font-size: 0.85rem; background: rgba(255,255,255,0.08); border-color: rgba(255,255,255,0.25);" @onclick="() => ShowLoansModal = true" title="Manage active loans">
                            <i class="bi bi-wallet2"></i>
                            <span>LOANS</span>
                        </button>
                    }

                    <!-- Compact Lottery Compliance Metric -->
                    <div class="metric-card gfc-expenses shadow-sm">
                        <span class="metric-label">GFC EXPENSES</span>
                        <h3 class="metric-value @(TotalGfcExpenses >= GfcExpenseLimit ? "text-danger animate-pulse" : "text-white")" style="font-size: 1.35rem;">
                            @TotalGfcExpenses.ToString("C0") <span class="fs-7 text-white-50 font-normal font-monospace">/ @GfcExpenseLimit.ToString("C0")</span>
                        </h3>
                    </div>


                    <!-- Compact Charity Payments Metric -->
                    <div class="metric-card charity-payments shadow-sm clickable text-center" @onclick="() => ShowCharityModal = true" style="cursor: pointer; min-height: 82px;" title="Click to view Charity Donations">
                        <span class="metric-label">CHARITY PAYMENTS</span>
                        <h3 class="metric-value text-success mb-1" style="font-size: 1.35rem; color: #86efac !important;">
                            @TotalCharityPayments.ToString("C2")
                        </h3>
                        <span class="badge text-white py-1 px-2.5 rounded-pill fw-black" style="font-size: 0.55rem; letter-spacing: 0.5px; background-color: #10b981 !important;">DONATE / VIEW ➔</span>
                    </div>

                    <!-- Bank Reconciliation Toggle -->
                    <button class="btn btn-reconcile-toggle shadow-sm @(IsBalanced ? "balanced" : "unbalanced")" @onclick="ToggleReconcilePanel">
                        <i class="bi @(IsBalanced ? "bi-check-all" : "bi-arrow-left-right")"></i>
                        <span>@(IsBalanced ? "BALANCED & RECONCILED" : "RECONCILE STATEMENT")</span>
                    </button>

                    <!-- Print Report Button -->
                    <button class="btn btn-outline-light shadow-sm d-flex align-items-center justify-content-center" style="width: 52px; height: 52px; border-radius: 16px; background: rgba(255,255,255,0.08); border-color: rgba(255,255,255,0.25);" @onclick="PrintReport" title="Print Ledger Report">
                        <i class="bi bi-printer-fill text-white"></i>
                    </button>

                    <!-- Reconciliation History Button -->
                    <button class="btn btn-outline-light shadow-sm d-flex align-items-center justify-content-center" style="width: 52px; height: 52px; border-radius: 16px; background: rgba(255,255,255,0.08); border-color: rgba(255,255,255,0.25);" @onclick="() => ShowReconciliationHistoryModal = true" title="Reconciliation History">
                        <i class="bi bi-clock-history text-white"></i>
                    </button>

                    <!-- Lottery Settings Gear Button -->
                    <button class="btn btn-outline-light shadow-sm d-flex align-items-center justify-content-center" style="width: 52px; height: 52px; border-radius: 16px; background: rgba(255,255,255,0.08); border-color: rgba(255,255,255,0.25);" @onclick="() => ShowComplianceSettingsModal = true" title="Lottery Rules & Settings">
                        <i class="bi bi-gear-fill"></i>
                    </button>


                </div>
            </div>
        </div>

        <div class="row g-4 flex-grow-1 overflow-hidden min-height-0">
            
            <!-- Left Side: Transaction Entry Form & Bank Reconciliation Panel -->
            <div class="col-xl-4 col-lg-5 d-flex flex-column h-100 overflow-hidden min-height-0">
                
                <!-- Quick Entry Form -->
                <div class="card border-0 shadow-sm rounded-4 p-4 dashboard-pane h-100 d-flex flex-column overflow-hidden min-height-0 mb-0">
                    <h4 class="pane-title mb-3"><i class="bi bi-plus-circle-fill text-primary"></i> RECORD TRANSACTION</h4>

                    <div class="flex-grow-1 overflow-auto pe-1" style="min-height: 0;">
                        <!-- Compliance Alert Notice -->
                    @if (TotalGfcExpenses >= GfcExpenseLimit * 0.85m)
                    {
                        <div class="alert alert-warning border-0 rounded-4 p-3 mb-3 small d-flex align-items-start gap-2.5 shadow-inner">
                            <i class="bi bi-exclamation-triangle-fill fs-5 text-warning flex-shrink-0"></i>
                            <div>
                                <strong class="text-dark">Lottery Compliance Alert ⚠️</strong>
                                <p class="m-0 text-muted extra-small">
                                    You have used <strong>@((TotalGfcExpenses / GfcExpenseLimit * 100).ToString("F0"))%</strong> of your GFC Expense Limit (@GfcExpenseLimit.ToString("C0")).
                                    Please use the dedicated **Donations** button or select approved Bingo Expense codes for further distributions.
                                </p>
                            </div>
                        </div>
                    }

                    
                        <div class="row g-3">
                            <!-- Transaction Type Toggle -->
                            <div class="col-12">
                                <label class="form-label fw-black text-muted small text-uppercase tracking-wider mb-1.5">Transaction Type</label>
                                <div class="type-selector-pills">
                                    <button class="type-pill expense-type @(NewExpense.Type == "Expense" ? "active" : "")" 
                                            @onclick='() => SetTransactionType("Expense")'>
                                        <i class="bi bi-dash-circle-fill"></i> EXPENSE
                                    </button>
                                    <button class="type-pill deposit-type @(NewExpense.Type == "Income" ? "active" : "")" 
                                            @onclick='() => SetTransactionType("Income")'>
                                        <i class="bi bi-plus-circle-fill"></i> DEPOSIT
                                    </button>
                                </div>
                            </div>

                            <!-- Amount Input -->
                            <div class="col-12">
                                <label class="form-label fw-black text-muted small text-uppercase tracking-wider mb-1">Amount ($)</label>
                                <div class="input-group input-group-sm bg-light border-0 rounded-3 overflow-hidden shadow-inner">
                                    <span class="input-group-text border-0 bg-transparent ps-3 fw-black fs-4 text-secondary">$</span>
                                    <input type="number" step="0.01" class="form-control border-0 bg-transparent fw-black fs-3 py-1.5 text-dark" @bind="NewExpense.Amount" placeholder="0.00" autofocus />
                                </div>
                            </div>

                            @if (NewExpense.Type == "Expense")
                            {
                                <!-- Expense Type Sub-Classification -->
                                <div class="col-12">
                                    <label class="form-label fw-black text-muted small text-uppercase tracking-wider mb-1.5">Expense Classification</label>
                                    <div class="d-flex gap-2">
                                        <button class="btn btn-sm flex-grow-1 py-1.5 fw-black text-uppercase rounded-3 d-flex flex-column align-items-center justify-content-center border-2 @(IsDirectBingoExpense == false ? "btn-outline-danger border-danger" : "btn-light border-light-subtle text-muted")"
                                                @onclick="() => SetExpenseClassification(false)" style="font-size: 0.72rem; min-height: 40px;">
                                            <span>CLUB EXPENSE</span>
                                        </button>
                                        <button class="btn btn-sm flex-grow-1 py-1.5 fw-black text-uppercase rounded-3 d-flex flex-column align-items-center justify-content-center border-2 @(IsDirectBingoExpense == true ? "btn-outline-primary border-primary" : "btn-light border-light-subtle text-muted")"
                                                @onclick="() => SetExpenseClassification(true)" style="font-size: 0.72rem; min-height: 40px;">
                                            <span>BINGO EXPENSE</span>
                                        </button>
                                    </div>
                                </div>

                                <!-- Category Selector -->
                                <div class="col-12">
                                    <label class="form-label fw-black text-muted small text-uppercase tracking-wider mb-1">Category</label>
                                    <div class="d-flex gap-2">
                                        <select class="form-select border-2 bg-white rounded-3 fw-bold border-light shadow-sm" 
                                                value="@(NewExpense.CategoryId?.ToString() ?? "")" 
                                                @onchange='(e) => { NewExpense.CategoryId = string.IsNullOrEmpty(e.Value?.ToString()) ? (int?)null : int.Parse(e.Value.ToString()); }'
                                                style="height: 38px; font-size: 0.8rem; padding-top: 4px; padding-bottom: 4px; line-height: 1.2;">
                                            <option value="">Select Category...</option>
                                            @foreach (var cat in ExpenseCategories.Where(c => IsDirectBingoExpense != null && (IsDirectBingoExpense.Value ? true : !IsCategoryBingoSpecific(c))))
                                            {
                                                <option value="@cat.Id.ToString()">@cat.Name</option>
                                            }
                                        </select>

                                        <button class="btn btn-outline-primary btn-sm rounded-3 px-3 shadow-sm" @onclick="() => OpenCategoryModal()" title="Manage Categories" style="height: 38px;">
                                            <i class="bi bi-tags-fill"></i>
                                        </button>
                                    </div>
                                </div>

                                <!-- Description / Payee Input -->
                                <div class="col-12 position-relative">
                                    <label class="form-label fw-black text-muted small text-uppercase tracking-wider mb-1">Payee / Expense Detail</label>
                                    <input type="text" 
                                           class="form-control form-control-sm border-2 bg-white rounded-3 fw-bold border-light shadow-sm" 
                                           style="height: 38px;" 
                                           @bind-value="NewExpense.Description" 
                                           @bind-value:event="oninput"
                                           @onfocus="ShowPayeeSuggestions"
                                           @onblur="HidePayeeSuggestionsDeferred"
                                           placeholder="Enter vendor name..." />
                                    
                                    @if (_showPayeeSuggestions && GetFilteredPayeeSuggestions().Any())
                                    {
                                        <div class="position-absolute w-100 bg-white rounded-3 shadow-lg border border-light-subtle mt-1 overflow-auto animate__animated animate__fadeIn animate__faster" 
                                             style="max-height: 200px; z-index: 1050; left: 0; padding: 4px;"
                                             @onmousedown:preventDefault="true">
                                            @foreach (var payee in GetFilteredPayeeSuggestions())
                                            {
                                                <div class="d-flex align-items-center justify-content-between rounded-2 px-3 py-2 payee-suggestion-item" 
                                                     style="font-size: 0.8rem;"
                                                     @onmousedown:preventDefault="true"
                                                     @onclick="() => SelectPayee(payee)">
                                                    <div class="fw-semibold text-truncate flex-grow-1">
                                                        <i class="bi bi-clock-history text-muted me-2" style="font-size: 0.75rem;"></i>@payee
                                                    </div>
                                                    <button class="btn btn-link btn-sm p-0 border-0 text-muted hover-text-danger ms-2 flex-shrink-0" 
                                                            style="line-height: 1;"
                                                            @onmousedown:preventDefault="true"
                                                            @onclick="() => BlockPayee(payee)"
                                                            title="Remove suggestion">
                                                        <i class="bi bi-x-circle-fill" style="font-size: 0.85rem;"></i>
                                                    </button>
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>

                                <!-- Check Number Input -->
                                <div class="col-12">
                                    <label class="form-label fw-black text-muted small text-uppercase tracking-wider mb-1">Check Number (Optional)</label>
                                    <input type="text" class="form-control form-control-sm border-2 bg-white rounded-3 fw-bold border-light shadow-sm" style="height: 38px;" 
                                           @bind="NewExpense.CheckNumber" 
                                           placeholder="e.g. 1024" />
                                </div>
                            }

                            <!-- Transaction Date -->
                            <div class="col-12">
                                <label class="form-label fw-black text-muted small text-uppercase tracking-wider mb-1">Transaction Date</label>
                                <input type="date" class="form-control form-control-sm border-2 bg-white rounded-3 fw-bold border-light shadow-sm" style="height: 38px;" @bind="NewExpense.Date" />
                            </div>
                        </div>
                    </div>

                    <!-- Submit Button at the bottom -->
                    <div class="pt-2 border-top mt-2">
                        @if (!string.IsNullOrEmpty(_validationError))
                        {
                            <div class="alert alert-danger py-1.5 px-3 rounded-3 text-center fw-bold mb-2 animate__animated animate__shakeX" style="font-size: 0.72rem; line-height: 1.3;">
                                <i class="bi bi-exclamation-triangle-fill me-1.5"></i> @_validationError
                            </div>
                        }
                        <button class="btn @(NewExpense.Type == "Expense" ? "btn-danger" : "btn-success") w-100 py-2.5 rounded-pill fw-black shadow-sm text-uppercase" 
                                @onclick="AddExpense">
                            <i class="bi @(NewExpense.Type == "Expense" ? "bi-dash-circle" : "bi-plus-circle") me-2"></i> Record @NewExpense.Type.ToUpper()
                        </button>
                    </div>
                </div>
            </div>

            <!-- Right Side: Unified Statement Ledger -->
            <div class="col-xl-8 col-lg-7 d-flex flex-column h-100 overflow-hidden min-height-0">
                <div class="card border-0 shadow-sm rounded-4 p-4 dashboard-pane h-100 d-flex flex-column overflow-hidden min-height-0">
                    
                    <!-- Sleek Compact Filters Toolbar -->
                    <div class="d-flex flex-nowrap align-items-center justify-content-between gap-2 mb-2 pb-1 border-bottom" style="height: 38px;">
                        <div class="flex-shrink-0">
                            <h5 class="pane-title m-0" style="font-size: 0.95rem; white-space: nowrap;"><i class="bi bi-list-columns-reverse text-primary me-1.5"></i> BANK LEDGER</h5>
                        </div>

                        <div class="d-flex flex-nowrap gap-2 align-items-center">
                            <!-- Month Filter Selector -->
                            <input type="month" class="form-control form-control-sm border-2 rounded-pill fw-bold border-light bg-light shadow-sm" style="width: 190px; font-size: 0.75rem; height: 28px; padding-top: 2px; padding-bottom: 2px;" @bind="_selectedMonthFilter" @bind:after="OnMonthFilterChanged" />
                        </div>
                    </div>

                    <!-- Month Summary Strip -->
                    <div class="d-flex flex-nowrap align-items-center justify-content-between px-3 py-1.5 bg-light rounded-3 border mb-2 shadow-inner" style="min-height: 36px; font-size: 0.78rem;">
                        <div class="d-flex align-items-center gap-1.5">
                            <i class="bi bi-calendar-check text-indigo me-1"></i>
                            <span class="fw-black text-slate text-uppercase" style="font-size: 0.72rem; letter-spacing: 0.5px;">@_selectedMonthFilter.ToString("MMMM yyyy").ToUpper():</span>
                        </div>
                        <div class="d-flex gap-2.5 align-items-center">
                            <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill fw-black px-2.5 py-1" style="font-size: 0.68rem;">
                                DEPOSITS: @GetMonthlyIncome().ToString("C2")
                            </span>
                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill fw-black px-2.5 py-1" style="font-size: 0.68rem;">
                                CLUB EXPENSES: @GetMonthlyGfcExpenses().ToString("C2")
                            </span>
                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill fw-black px-2.5 py-1" style="font-size: 0.68rem;">
                                BINGO EXPENSES: @GetMonthlyBingoExpenses().ToString("C2")
                            </span>
                        </div>
                    </div>

                    <!-- Main Statement Ledger Table -->
                    <div class="flex-grow-1 overflow-auto bg-light rounded-4 border" style="min-height: 0; box-shadow: inset 0 2px 8px rgba(0,0,0,0.02);">
                        @if (!FilteredTransactions.Any())
                        {
                            <div class="text-center py-5 my-5 text-muted opacity-50">
                                <i class="bi bi-card-checklist fs-1 d-block mb-2"></i>
                                <span class="small fw-black text-uppercase">No matching transactions found</span>
                            </div>
                        }
                        else
                        {
                            <table class="table table-hover align-middle mb-0 bank-table-theme">
                                <thead class="table-white sticky-top shadow-sm border-bottom text-uppercase fs-7 fw-black text-secondary bg-white">
                                    <tr>
                                        <th class="ps-4 text-center" style="width: 140px;">Status</th>
                                        <th style="width: 120px;">Date</th>
                                        <th style="width: 100px;">Check #</th>
                                        <th>Category</th>
                                        <th>Payee / Description</th>
                                        <th class="text-end" style="width: 130px;">Amount</th>
                                        <th class="text-center" style="width: 60px;">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var entry in FilteredTransactions)
                                    {
                                        var isCleared = _permanentlyReconciledTransactionIds.Contains(entry.Id);
                                        var displayTitle = string.IsNullOrEmpty(entry.Description) 
                                            ? (entry.Type == "Income" ? "Deposit" : entry.Category?.Name ?? "General Expense") 
                                            : entry.Description;

                                        <tr class="bank-row last-border-0 @(isCleared ? "reconciled-bg" : "")">
                                            <!-- Clearance Status Label -->
                                            <td class="text-center ps-4">
                                                @if (isCleared)
                                                {
                                                    <span class="badge bg-success-subtle text-success border border-success-subtle px-2.5 py-1 rounded-pill fw-black" style="font-size: 0.65rem;">
                                                        <i class="bi bi-check-circle-fill me-1"></i> RECONCILED
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-2.5 py-1 rounded-pill fw-black" style="font-size: 0.65rem;">
                                                        <i class="bi bi-circle me-1"></i> UNCLEARED
                                                    </span>
                                                }
                                            </td>

                                            <!-- Transaction Date -->
                                            <td class="fw-bold text-secondary font-monospace" style="font-size: 0.85rem;">
                                                @entry.Date.ToString("yyyy-MM-dd")
                                            </td>

                                            <!-- Check # -->
                                            <td class="fw-bold text-secondary font-monospace" style="font-size: 0.85rem;">
                                                @(string.IsNullOrEmpty(entry.RawTransaction?.CheckNumber) ? "-" : entry.RawTransaction.CheckNumber)
                                            </td>

                                            <!-- Category -->
                                            <td>
                                                <span class="badge @(entry.Type == "Income" ? "bg-success-subtle text-success border border-success-subtle" : "bg-primary-subtle text-primary border border-primary-subtle") rounded-pill px-2.5 py-1 text-uppercase fw-black" style="font-size: 0.65rem;">
                                                    @(entry.Category?.Name ?? (entry.Type == "Income" ? "DEPOSIT" : "UNCATEGORIZED"))
                                                </span>
                                            </td>

                                            <!-- Description -->
                                            <td>
                                                <span class="fw-black text-slate text-capitalize" style="font-size: 0.9rem;">
                                                    @displayTitle
                                                </span>
                                            </td>

                                            <!-- Amount -->
                                            <td class="text-end fw-black fs-6 @(entry.Type == "Income" ? "text-success" : "text-danger")">
                                                @(entry.Type == "Income" ? "+" : "")@entry.Amount.ToString("C2")
                                            </td>

                                            <!-- Actions -->
                                            <td class="text-center">
                                                 <div class="d-flex justify-content-center gap-1">
                                                     <button class="btn btn-outline-primary btn-sm border-0 rounded-circle d-flex align-items-center justify-content-center shadow-sm" 
                                                             style="width: 32px; height: 32px;" 
                                                             @onclick="() => StartEditTransaction(entry)" 
                                                             title="Edit Entry"
                                                             disabled="@isCleared">
                                                         <i class="bi bi-pencil-fill fs-7"></i>
                                                     </button>
                                                     <button class="btn btn-outline-danger btn-sm border-0 rounded-circle d-flex align-items-center justify-content-center shadow-sm" 
                                                             style="width: 32px; height: 32px;" 
                                                             @onclick="() => RequestDeleteTransaction(entry)" 
                                                             title="Delete Entry"
                                                             disabled="@isCleared">
                                                         <i class="bi bi-trash-fill fs-7"></i>
                                                     </button>
                                                 </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                    </div>

                    <!-- Compact Status Display (Tightly Fitted) -->
                    <div class="mt-2 text-end">
                        <span class="extra-small text-muted fw-bold text-uppercase">Showing @FilteredTransactions.Count transactions</span>
                    </div>
                </div>
            </div>

        </div>

    </div>
</div>

<!-- Add Category Modal -->
@if (ShowCategoryModal)
{
    <div class="modal fade show d-block" style="background: rgba(15,23,42,0.6); z-index: 1060; backdrop-filter: blur(8px);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden animate__animated animate__zoomIn animate__faster">
                <div class="modal-header border-0 p-4 pb-0">
                    <h5 class="modal-title fw-black"><i class="bi bi-tags-fill text-primary"></i> MANAGE CATEGORIES</h5>
                    <button type="button" class="btn-close" @onclick="() => ShowCategoryModal = false"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-4 p-3 bg-light rounded-4 border">
                        <label class="form-label fw-black small text-muted text-uppercase mb-2">Create New Category</label>
                        <div class="input-group">
                            <input type="text" class="form-control border-2 fw-bold" @bind="EditingCategory.Name" placeholder="Category Name..." />
                            <button class="btn btn-primary px-4 fw-black" @onclick="SaveCategory">ADD</button>
                        </div>
                    </div>

                    <label class="form-label fw-black small text-muted text-uppercase mb-2">Existing Categories</label>
                    <div class="list-group list-group-flush rounded-3 border overflow-auto" style="max-height: 250px;">
                        @foreach (var cat in ExpenseCategories)
                        {
                            <div class="list-group-item d-flex justify-content-between align-items-center py-2 px-3">
                                <span class="fw-bold">@cat.Name</span>
                                <button class="btn btn-sm btn-outline-danger border-0 rounded-circle" @onclick="() => DeleteCategory(cat)">
                                    <i class="bi bi-trash fs-6"></i>
                                </button>
                            </div>
