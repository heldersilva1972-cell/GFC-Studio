@code {
    private string _currentUsername = "Unknown";
    private decimal AccountBalance { get; set; }
    private decimal ReconciledBalance { get; set; }
    private decimal UnclearedTotal { get; set; }
    private decimal ReconciliationDifference { get; set; }
    private DateTime ReconciliationDate { get; set; } = DateTime.Now;
    
    private decimal GetMonthlyBingoExpenses()
    {
        return Transactions
            .Where(t => t.Date.Year == _selectedMonthFilter.Year && t.Date.Month == _selectedMonthFilter.Month && t.Type == "Expense" && IsCategoryBingoSpecific(t.Category))
            .Sum(t => Math.Abs(t.Amount));
    }

    private decimal PreviousReconciliationEndingBalance => ReconciliationHistory
        .Where(r => !r.IsDeleted)
        .OrderByDescending(r => r.StatementDate)
        .FirstOrDefault()?.EndingBalance ?? 0m;

    // Bank Statement reconciliation ending balance
    private decimal _bankStatementBalance = 0;
    private bool _showReconcilePanel = false;
    private bool IsBalanced => ReconciliationDifference == 0 && _bankStatementBalance != 0;

    // Locally track reconciled transaction IDs to bypass database changes
    private HashSet<int> _reconciledTransactionIds = new();
    private HashSet<int> _permanentlyReconciledTransactionIds = new();
    private List<BingoReconciliation> ReconciliationHistory { get; set; } = new();
    private bool ShowReconciliationHistoryModal { get; set; } = false;
    private BingoReconciliation SelectedReconciliation { get; set; } = null;
    private List<BingoLotteryTransaction> SelectedReconciliationTxs { get; set; } = new();

    private List<LedgerItem> Transactions { get; set; } = new();
    private List<BingoExpenseCategory> ExpenseCategories { get; set; } = new();
    private BingoLotteryTransaction NewExpense { get; set; } = new BingoLotteryTransaction { Date = DateTime.Now, Type = "Expense" };
    private BingoExpenseCategory EditingCategory { get; set; } = new();
    private bool ShowCategoryModal { get; set; }

    // Loan Management state
    private bool ShowLoansModal { get; set; } = false;
    private bool ShowAddLoanModal { get; set; } = false;
    private bool ShowRepayLoanModal { get; set; } = false;
    private BingoActiveLoan NewLoan { get; set; } = new();
    private BingoActiveLoan SelectedLoan { get; set; }
    private decimal? RepaymentAmount { get; set; }
    private DateTime RepaymentDate { get; set; } = DateTime.Now;
    private List<BingoActiveLoan> ActiveLoans { get; set; } = new();

    private decimal TotalOutstandingLoans => ActiveLoans.Sum(l => l.RemainingBalance);

    // Custom Edit & Delete popup states
    private bool ShowEditTxModal { get; set; } = false;
    private bool ShowDeleteConfirmModal { get; set; } = false;
    private BingoLotteryTransaction EditingTx { get; set; }
    private decimal EditingTxAbsAmount { get; set; }
    private LedgerItem TxToDelete { get; set; }

    // Compliance and settings states
    private bool ShowComplianceSettingsModal { get; set; } = false;
    private bool ShowCharityModal { get; set; } = false;
    private bool ShowRecordDonationModal { get; set; } = false;
    private decimal GfcExpenseLimit { get; set; } = 9000.00m;
    private string NewDonationName { get; set; } = string.Empty;
    private decimal? NewDonationAmount { get; set; }
    private DateTime NewDonationDate { get; set; } = DateTime.Now;
    private bool? IsDirectBingoExpense { get; set; } = null;
    private string _validationError = "";
    private string NewDonationCheckNumber { get; set; } = string.Empty;
    private bool ShowEditLoanModal { get; set; } = false;
    private BingoActiveLoan? EditingLoan { get; set; }
    private bool ShowDeleteLoanConfirmModal { get; set; } = false;
    private bool _showAllTime { get; set; } = false;

    private bool IsCategoryBingoSpecific(BingoExpenseCategory cat)
    {
        if (cat == null) return false;
        var name = cat.Name.ToLower();
        return name.Contains("bingo") || 
               name.Contains("prize") || 
               name.Contains("payout") || 
               name.Contains("caller") || 
               name.Contains("paper") || 
               name.Contains("game") || 
               name.Contains("sheet") || 
               name.Contains("repayment") || 
               name.Contains("charity");
    }

    private decimal TotalGfcExpenses => Transactions
        .Where(t => t.Type == "Expense" && !IsCategoryBingoSpecific(t.Category))
        .Sum(t => Math.Abs(t.Amount));

    private decimal TotalCharityPayments => Transactions
        .Where(t => t.Category?.Name == "Charity")
        .Sum(t => Math.Abs(t.Amount));

    private decimal ReconciledInSessionSum => Transactions
        .Where(t => _reconciledTransactionIds.Contains(t.Id))
        .Sum(t => t.Amount);

    // Represent individual items inside our interactive ledger with running balance
    private class LedgerItem
    {
        public int Id { get; set; }
        public DateTime Date { get; set; }
        public string Type { get; set; } // "Income", "Expense", "Prize", etc.
        public decimal Amount { get; set; }
        public string Description { get; set; }
        public BingoExpenseCategory Category { get; set; }
        public decimal RunningBalance { get; set; }
        public BingoLotteryTransaction RawTransaction { get; set; }
    }

    private List<LedgerItem> FilteredTransactions
    {
        get
        {
            return Transactions
                .Where(t => t.Date.Year == _selectedMonthFilter.Year && t.Date.Month == _selectedMonthFilter.Month)
                .ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        _currentUsername = authState.User.Identity?.Name ?? "Unknown";

        // Load Reconciled IDs from localStorage first
        try
        {
            var storedStatementBal = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "gfc_bingo_reconciled_statement_bal");
            if (!string.IsNullOrEmpty(storedStatementBal) && decimal.TryParse(storedStatementBal, out var parsedVal))
            {
                _bankStatementBalance = parsedVal;
            }

            var storedLimit = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "gfc_bingo_lottery_expense_limit");
            if (!string.IsNullOrEmpty(storedLimit) && decimal.TryParse(storedLimit, out var parsedLimit))
            {
                GfcExpenseLimit = parsedLimit;
            }
        }

        catch (Exception ex)
        {
            Console.WriteLine($"[BINGO EXPENSES] Failed to load local reconciliation cache: {ex.Message}");
        }

        await LoadDeletedPayees();
        await LoadData();
    }

    private async Task LoadData()
    {
        // 1. Fetch all finalized database reconciliations
        var dbReconcileRuns = await DbContext.BingoReconciliations
            .Where(r => !r.IsDeleted)
            .OrderByDescending(r => r.StatementDate)
            .ToListAsync();
        ReconciliationHistory = dbReconcileRuns;

        _permanentlyReconciledTransactionIds.Clear();
        foreach (var run in dbReconcileRuns)
        {
            try
            {
                var clearedIds = JsonSerializer.Deserialize<List<int>>(run.ClearedTransactionIdsJson);
                if (clearedIds != null)
                {
                    foreach (var id in clearedIds)
                    {
                        _permanentlyReconciledTransactionIds.Add(id);
                    }
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Failed to parse historical cleared transaction IDs: {ex.Message}");
            }
        }

        // 2. Fetch raw rows from database (include session transactions too, to ensure ledger is exact!)
        var rawTransactions = await DbContext.BingoLotteryTransactions
            .Include(t => t.Category)
            .Where(t => !t.IsDeleted)
            .OrderBy(t => t.Date)  // Order oldest first to compute accurate running balance!
            .ThenBy(t => t.Id)
            .ToListAsync();

        // 3. Hydrate ledger list and compute sequential running balances
        decimal runningTotal = 0;
        decimal manualOnlyTotal = 0;
        var ledgerList = new List<LedgerItem>();

        foreach (var t in rawTransactions)
        {
            runningTotal += t.Amount;
            
            // Only list manual transactions in the ledger statement (SessionId == null)
            if (t.SessionId == null)
            {
                manualOnlyTotal += t.Amount;
                ledgerList.Add(new LedgerItem
                {
                    Id = t.Id,
                    Date = t.Date,
                    Type = t.Type,
                    Amount = t.Amount,
                    Description = t.Description,
                    Category = t.Category,
                    RunningBalance = manualOnlyTotal,
                    RawTransaction = t
                });
            }
        }

        // 4. Order ledger newest first for dashboard display
        Transactions = ledgerList.OrderByDescending(t => t.Date).ThenByDescending(t => t.Id).ToList();
        
        // AccountBalance reflects only manual transactions — bingo session net amounts are excluded
        AccountBalance = manualOnlyTotal;
        ExpenseCategories = await DbContext.BingoExpenseCategories.Where(c => !c.IsDeleted).ToListAsync();
        ActiveLoans = await DbContext.BingoActiveLoans.Where(l => !l.IsDeleted).OrderByDescending(l => l.Date).ToListAsync();
        
        await RecalculateReconciliation();
    }

    private void SetTransactionType(string type)
    {
        NewExpense.Type = type;
        NewExpense.Amount = 0;
        _validationError = "";
        StateHasChanged();
    }

    private async void ToggleReconcilePanel()
    {
        _showReconcilePanel = !_showReconcilePanel;
        if (_showReconcilePanel)
        {
            // Reset active workspace matching run
            _reconciledTransactionIds.Clear();
            _bankStatementBalance = 0;
            ReconciliationDate = DateTime.Now;
            await RecalculateReconciliation();
        }
        StateHasChanged();
    }

    private async Task ToggleReconciliation(int txId)
    {
        if (_reconciledTransactionIds.Contains(txId))
        {
            _reconciledTransactionIds.Remove(txId);
        }
        else
        {
            _reconciledTransactionIds.Add(txId);
        }

        await RecalculateReconciliation();
        StateHasChanged();
    }

    private async Task RecalculateReconciliation()
    {
        // Uncleared items are those that are NOT permanently reconciled AND NOT ticked in the active workspace
        UnclearedTotal = Transactions
            .Where(t => !_permanentlyReconciledTransactionIds.Contains(t.Id) && !_reconciledTransactionIds.Contains(t.Id))
            .Sum(t => t.Amount);

        // Reconciled balance reflects permanently reconciled + active workspace cleared items
        var totalClearedAmount = AccountBalance - UnclearedTotal;
        ReconciledBalance = totalClearedAmount;
        ReconciliationDifference = ReconciledBalance - _bankStatementBalance;

        try
        {
            await JSRuntime.InvokeVoidAsync("localStorage.setItem", "gfc_bingo_reconciled_statement_bal", _bankStatementBalance.ToString("F2"));
        }
        catch {}
    }

    private DateTime _selectedMonthFilter = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);

    private async Task OnMonthFilterChanged()
    {
        await LoadData();
        StateHasChanged();
    }

    private string GetReportMonthName()
    {
        return _showAllTime ? "ALL TIME" : _selectedMonthFilter.ToString("MMMM yyyy").ToUpper();
    }

    private decimal GetMonthlyStartingBalance()
    {
        if (_showAllTime) return 0;
        var startOfMonth = new DateTime(_selectedMonthFilter.Year, _selectedMonthFilter.Month, 1);
        return Transactions.Where(t => t.Date < startOfMonth).Sum(t => t.Amount);
    }

    private decimal GetMonthlyIncome()
    {
        if (_showAllTime)
        {
            return Transactions.Where(t => t.Type == "Income").Sum(t => t.Amount);
        }
        return Transactions.Where(t => t.Date.Year == _selectedMonthFilter.Year && t.Date.Month == _selectedMonthFilter.Month && t.Type == "Income").Sum(t => t.Amount);
    }

    private decimal GetMonthlyExpenses()
    {
        if (_showAllTime)
        {
            return Transactions.Where(t => t.Type == "Expense").Sum(t => Math.Abs(t.Amount));
        }
        return Transactions.Where(t => t.Date.Year == _selectedMonthFilter.Year && t.Date.Month == _selectedMonthFilter.Month && t.Type == "Expense").Sum(t => Math.Abs(t.Amount));
    }

    private decimal GetMonthlyCharity()
    {
        if (_showAllTime)
        {
            return Transactions.Where(t => t.Category?.Name == "Charity").Sum(t => Math.Abs(t.Amount));
        }
        return Transactions.Where(t => t.Date.Year == _selectedMonthFilter.Year && t.Date.Month == _selectedMonthFilter.Month && t.Category?.Name == "Charity").Sum(t => Math.Abs(t.Amount));
    }

    private decimal GetMonthlyGfcExpenses()
    {
        if (_showAllTime)
        {
            return TotalGfcExpenses;
        }
        return Transactions.Where(t => t.Date.Year == _selectedMonthFilter.Year && t.Date.Month == _selectedMonthFilter.Month && t.Type == "Expense" && !IsCategoryBingoSpecific(t.Category)).Sum(t => Math.Abs(t.Amount));
    }

    private async Task AddExpense()
    {
        _validationError = "";

        if (NewExpense.Amount == 0)
        {
            _validationError = "Please enter a valid non-zero amount.";
            return;
        }
        
        // For Deposits, category and payee are completely bypassed and reset
        if (NewExpense.Type == "Income")
        {
            NewExpense.Amount = Math.Abs(NewExpense.Amount);
            NewExpense.CategoryId = null; // Ensure category is empty for deposits
            NewExpense.Description = "Deposit"; // Clean default description
        }

        if (NewExpense.Type == "Expense")
        {
            if (IsDirectBingoExpense == null)
            {
                _validationError = "Expense Classification is required. Please select either Club Expense or Bingo Expense.";
                return;
            }

            if (NewExpense.CategoryId == null)
            {
                _validationError = "Please select a category.";
                return;
            }

            if (string.IsNullOrWhiteSpace(NewExpense.Description))
            {
                _validationError = "Payee / Expense Detail is required.";
                return;
            }

            if (!string.IsNullOrWhiteSpace(NewExpense.CheckNumber))
            {
                NewExpense.CheckNumber = NewExpense.CheckNumber.Trim();
            }

            NewExpense.Amount = -Math.Abs(NewExpense.Amount);
        }


        NewExpense.CreatedAt = DateTime.UtcNow;
        NewExpense.CreatedBy = _currentUsername;
        
        DbContext.BingoLotteryTransactions.Add(NewExpense);
