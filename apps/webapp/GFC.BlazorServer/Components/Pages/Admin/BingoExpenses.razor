<!-- Bank Statement Reconciliation Full Screen Workspace -->
@if (_showReconcilePanel)
{
    <div class="reconciliation-fullscreen-workspace p-4 animate__animated animate__fadeIn">
        <div class="container-fluid px-4" style="max-width: 1400px;">
            <!-- Header bar -->
            <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-circle bg-primary-subtle text-primary d-flex align-items-center justify-content-center" style="width: 48px; height: 48px; background-color: #dbeafe;">
                        <i class="bi bi-bank2 fs-4 text-primary"></i>
                    </div>
                    <div>
                        <h2 class="fw-black text-slate m-0">Reconciliation Workspace</h2>
                        <p class="text-muted extra-small fw-bold text-uppercase m-0">Audit, clear, and balance your bank statement statement-by-statement</p>
                    </div>
                </div>
                <button class="btn btn-outline-secondary rounded-pill px-4 fw-black" @onclick="ToggleReconcilePanel">
                    <i class="bi bi-x-lg me-2"></i> CLOSE WORKSPACE
                </button>
            </div>

            <div class="row g-4">
                <!-- Sidebar: Summary, inputs, and actions -->
                <div class="col-xl-4 col-lg-5">
                    <div class="card border-0 shadow-sm rounded-4 p-4 mb-4 dashboard-pane">
                        <h4 class="pane-title mb-4"><i class="bi bi-clipboard-data text-primary"></i> RECONCILIATION SUMMARY</h4>
                        
                        <div class="mb-3">
                            <label class="form-label fw-black text-muted small text-uppercase tracking-wider mb-2">Statement End Date</label>
                            <input type="date" class="form-control form-control-lg border-2 bg-white rounded-3 fw-bold border-light shadow-sm" @bind="ReconciliationDate" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-black text-muted small text-uppercase tracking-wider mb-1.5">Statement Beginning Balance (Carried Over)</label>
                            <div class="bg-light p-2.5 rounded-3 border fw-black fs-5 text-slate d-flex justify-content-between align-items-center shadow-inner" style="min-height: 42px;">
                                <span class="text-secondary fw-bold">$</span>
                                <span>@PreviousReconciliationEndingBalance.ToString("N2")</span>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-black text-muted small text-uppercase tracking-wider mb-2">Bank Statement Ending Balance</label>
                            <div class="input-group input-group-lg bg-light border-0 rounded-4 overflow-hidden shadow-inner">
                                <span class="input-group-text border-0 bg-transparent ps-4 fw-black fs-2 text-secondary">$</span>
                                <input type="number" step="0.01" class="form-control border-0 bg-transparent fw-black fs-1 py-3 text-dark" @bind="_bankStatementBalance" @bind:after="RecalculateReconciliation" placeholder="0.00" />
                            </div>
                        </div>

                        <div class="bg-light p-3 rounded-4 border mb-4">
                            <div class="d-flex justify-content-between py-2 border-bottom">
                                <span class="fw-bold text-muted small">Total Ledger Balance:</span>
                                <span class="fw-black text-slate">@AccountBalance.ToString("C2")</span>
                            </div>
                            <div class="d-flex justify-content-between py-2 border-bottom">
                                <span class="fw-bold text-muted small">Session Cleared Items:</span>
                                <span class="fw-black text-success">@ReconciledInSessionSum.ToString("C2")</span>
                            </div>
                            <div class="d-flex justify-content-between py-2 border-bottom">
                                <span class="fw-bold text-muted small">Uncleared Items:</span>
                                <span class="fw-black text-danger">@UnclearedTotal.ToString("C2")</span>
                            </div>
                            <div class="d-flex justify-content-between py-2 border-bottom">
                                <span class="fw-bold text-muted small">Calculated Reconciled Balance:</span>
                                <span class="fw-black text-primary">@ReconciledBalance.ToString("C2")</span>
                            </div>
                            <div class="d-flex justify-content-between py-2 mt-2">
                                <span class="fw-bold text-muted fs-6">Difference:</span>
                                <span class="fw-black fs-4 @(ReconciliationDifference == 0 ? "text-success animate-pulse" : "text-danger")">@ReconciliationDifference.ToString("C2")</span>
                            </div>
                        </div>

                        @if (IsBalanced)
                        {
                            <button class="btn btn-success btn-lg w-100 py-3 rounded-pill fw-black shadow-sm text-uppercase animate__animated animate__bounceIn" @onclick="FinalizeReconciliation">
                                <i class="bi bi-check-circle-fill me-2"></i> FINALIZE RECONCILIATION
                            </button>
                        }
                        else
                        {
                            <div class="alert alert-warning border-0 rounded-4 p-3 mb-0 small text-center shadow-inner">
                                <i class="bi bi-info-circle me-1 text-warning"></i>
                                <span class="text-muted extra-small">To finalize, select transactions and enter the ending balance until the Difference is <strong>$0.00</strong>.</span>
                            </div>
                        }
                    </div>
                </div>

                <!-- Main area: Uncleared Checklist -->
                <div class="col-xl-8 col-lg-7">
                    <div class="card border-0 shadow-sm rounded-4 p-4 dashboard-pane h-100 d-flex flex-column overflow-hidden" style="min-height: 500px;">
                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <div>
                                <h4 class="pane-title m-0"><i class="bi bi-check2-square text-primary"></i> SELECT UNCLEARED TRANSACTIONS</h4>
                                <p class="text-muted extra-small fw-bold text-uppercase m-0">Ticking an item adds it to your statement clearance run</p>
                            </div>
                            <span class="badge bg-primary-subtle text-primary rounded-pill px-3 py-1.5 fw-black font-monospace">
                                @_reconciledTransactionIds.Count SELECTED
                            </span>
                        </div>

                        <div class="flex-grow-1 overflow-auto bg-light rounded-4 border" style="max-height: 600px;">
                            @{
                                var unclearedTxs = Transactions.Where(t => !_permanentlyReconciledTransactionIds.Contains(t.Id)).ToList();
                            }
                            @if (!unclearedTxs.Any())
                            {
                                <div class="text-center py-5 my-5 text-muted opacity-50">
                                    <i class="bi bi-shield-check fs-1 d-block mb-2"></i>
                                    <span class="small fw-black text-uppercase">All transactions cleared! Nothing left to reconcile.</span>
                                </div>
                            }
                            else
                            {
                                <table class="table table-hover align-middle mb-0 bank-table-theme">
                                    <thead class="table-white sticky-top shadow-sm border-bottom text-uppercase fs-7 fw-black text-secondary bg-white">
                                        <tr>
                                            <th class="ps-4 text-center" style="width: 80px;">Clear</th>
                                            <th style="width: 130px;">Date</th>
                                            <th>Category</th>
                                            <th>Payee / Description</th>
                                            <th class="text-end" style="width: 130px;">Amount</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var entry in unclearedTxs)
                                        {
                                            var isSelected = _reconciledTransactionIds.Contains(entry.Id);
                                            var displayTitle = string.IsNullOrEmpty(entry.Description) 
                                                ? (entry.Type == "Income" ? "Deposit" : entry.Category?.Name ?? "General Expense") 
                                                : entry.Description;

                                            <tr class="bank-row last-border-0 @(isSelected ? "reconciled-bg border-success" : "")" @onclick="() => ToggleReconciliation(entry.Id)" style="cursor: pointer;">
                                                <td class="text-center ps-4">
                                                    <span class="btn-clearance @(isSelected ? "cleared text-success" : "uncleared text-muted")">
                                                        <i class="bi @(isSelected ? "bi-check-circle-fill" : "bi-circle")"></i>
                                                    </span>
                                                </td>
                                                <td class="fw-bold text-secondary font-monospace" style="font-size: 0.85rem;">
                                                    @entry.Date.ToString("yyyy-MM-dd")
                                                </td>
                                                <td>
                                                    <span class="badge @(entry.Type == "Income" ? "bg-success-subtle text-success border border-success-subtle" : "bg-primary-subtle text-primary border border-primary-subtle") rounded-pill px-2.5 py-1 text-uppercase fw-black" style="font-size: 0.65rem;">
                                                        @(entry.Category?.Name ?? (entry.Type == "Income" ? "DEPOSIT" : "UNCATEGORIZED"))
                                                    </span>
                                                </td>
                                                <td>
                                                    <span class="fw-black text-slate text-capitalize" style="font-size: 0.9rem;">
                                                        @displayTitle
                                                    </span>
                                                </td>
                                                <td class="text-end fw-black fs-6 @(entry.Type == "Income" ? "text-success" : "text-danger")">
                                                    @(entry.Type == "Income" ? "+" : "")@entry.Amount.ToString("C2")
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<!-- Reconciliation History List Modal -->
