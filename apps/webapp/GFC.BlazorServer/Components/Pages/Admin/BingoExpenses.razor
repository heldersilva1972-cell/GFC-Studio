<!-- Loans Manager Modal -->
@if (ShowLoansModal)
{
    <div class="modal fade show d-block" style="background: rgba(15,23,42,0.6); z-index: 1050; backdrop-filter: blur(8px);">
        <div class="modal-dialog modal-dialog-centered" style="max-width: 550px;">
            <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden animate__animated animate__zoomIn animate__faster">
                <div class="modal-header border-0 p-4 pb-0 d-flex justify-content-between align-items-center">
                    <h5 class="modal-title fw-black"><i class="bi bi-wallet2 text-primary me-2"></i> LOANS & LIABILITIES</h5>
                    <div class="d-flex gap-2 align-items-center">
                        <button class="btn btn-sm btn-primary rounded-pill px-3 py-1 fw-black text-uppercase" @onclick="OpenAddLoanModal" style="font-size: 0.75rem;">
                            <i class="bi bi-plus-lg"></i> ADD LOAN
                        </button>
                        <button type="button" class="btn-close" @onclick="() => ShowLoansModal = false"></button>
                    </div>
                </div>
                <div class="modal-body p-4">
                    <p class="text-muted extra-small fw-bold text-uppercase mb-3">Track external funding, initial seed loans, and repayments</p>

                    @if (!ActiveLoans.Any())
                    {
                        <div class="text-center py-5 rounded-4" style="border: 2px dashed #e2e8f0 !important; background-color: #f8fafc;">
                            <i class="bi bi-patch-check text-success fs-1 d-block mb-2"></i>
                            <span class="fw-black text-uppercase text-muted" style="font-size: 0.8rem;">No Active Loans Outstanding</span>
                        </div>
                    }
                    else
                    {
                        <div class="d-flex flex-column gap-3 overflow-auto" style="max-height: 400px;">
                            @foreach (var loan in ActiveLoans)
                            {
                                var pct = loan.OriginalAmount > 0 ? (int)((loan.RemainingBalance / loan.OriginalAmount) * 100) : 0;
                                <div class="p-3 rounded-4" style="background-color: #f8fafc; border: 1px solid #e2e8f0;">
                                    <div class="d-flex justify-content-between align-items-start mb-1">
                                        <div>
                                            <h6 class="fw-black text-dark m-0 text-capitalize" style="font-size: 0.95rem;">@loan.Lender</h6>
                                            <span class="text-muted" style="font-size: 0.7rem;">Received: @loan.Date.ToString("yyyy-MM-dd")</span>
                                        </div>
                                        <div class="d-flex gap-1.5 align-items-center">
                                            <button class="btn btn-sm btn-outline-secondary rounded-pill px-2.5 py-0.5 fw-black text-uppercase me-1" style="font-size: 0.7rem;" @onclick="() => OpenEditLoanModal(loan)">
                                                <i class="bi bi-pencil"></i> EDIT
                                            </button>
                                            <button class="btn btn-sm btn-outline-primary rounded-pill px-3 py-0.5 fw-black text-uppercase" style="font-size: 0.7rem;" @onclick="() => OpenRepayLoanModal(loan)">
                                                REPAY
                                            </button>
                                        </div>
                                    </div>
                                    <div class="d-flex justify-content-between align-items-baseline mt-2 mb-1">
                                        <span class="extra-small text-muted fw-bold">REMAINING:</span>
                                        <span class="fw-black text-primary" style="font-size: 0.9rem;">
                                            @loan.RemainingBalance.ToString("C2") 
                                            <span class="text-muted fs-7 font-monospace fw-normal">/ @loan.OriginalAmount.ToString("C2")</span>
                                        </span>
                                    </div>
                                    <div class="progress rounded-pill" style="height: 6px; background-color: #e2e8f0;">
                                        <div class="progress-bar bg-primary rounded-pill" role="progressbar" style="width: @(pct)%;" aria-valuenow="@pct" aria-valuemin="0" aria-valuemax="100"></div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
                <div class="modal-footer border-0 p-4 pt-0">
                    <button class="btn btn-light w-100 rounded-pill py-2.5 fw-black text-uppercase shadow-sm" @onclick="() => ShowLoansModal = false">CLOSE</button>
                </div>
            </div>
        </div>
    </div>
}


<!-- Edit Transaction Modal -->
@if (ShowEditTxModal && EditingTx != null)
{
    <div class="modal fade show d-block" style="background: rgba(15,23,42,0.6); z-index: 1070; backdrop-filter: blur(8px);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden animate__animated animate__zoomIn animate__faster">
                <div class="modal-header border-0 p-4 pb-0">
                    <h5 class="modal-title fw-black"><i class="bi bi-pencil-square text-primary"></i> EDIT TRANSACTION</h5>
                    <button type="button" class="btn-close" @onclick="() => ShowEditTxModal = false"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="row g-3">
                        <!-- Transaction Type Toggle -->
                        <div class="col-12">
                            <label class="form-label fw-black text-muted small text-uppercase tracking-wider mb-2">Transaction Type</label>
                            <div class="type-selector-pills">
                                <button class="type-pill expense-type @(EditingTx.Type == "Expense" ? "active" : "")" 
                                        @onclick='() => EditingTx.Type = "Expense"'>
                                    <i class="bi bi-dash-circle-fill"></i> EXPENSE
                                </button>
                                <button class="type-pill deposit-type @(EditingTx.Type == "Income" ? "active" : "")" 
                                        @onclick='() => EditingTx.Type = "Income"'>
                                    <i class="bi bi-plus-circle-fill"></i> DEPOSIT
                                </button>
                            </div>
                        </div>

                        <!-- Amount Input -->
                        <div class="col-12">
                            <label class="form-label fw-black text-muted small text-uppercase tracking-wider mb-1">Amount ($)</label>
                            <div class="input-group bg-light border-0 rounded-3 overflow-hidden shadow-inner">
                                <span class="input-group-text border-0 bg-transparent fw-bold">$</span>
                                <input type="number" step="0.01" class="form-control border-0 fw-black text-dark" @bind="EditingTxAbsAmount" placeholder="0.00" />
                            </div>
                        </div>

                        @if (EditingTx.Type == "Expense")
                        {
                            <!-- Category Selector -->
                            <div class="col-12">
                                <label class="form-label fw-black text-muted small text-uppercase tracking-wider mb-1">Category</label>
                                <select class="form-select border-2 bg-white rounded-3 fw-bold border-light shadow-sm" 
                                                value="@(EditingTx.CategoryId?.ToString() ?? "")" 
                                                @onchange='(e) => { EditingTx.CategoryId = string.IsNullOrEmpty(e.Value?.ToString()) ? (int?)null : int.Parse(e.Value.ToString()); }'>
                                    <option value="">Select Category...</option>
                                    @foreach (var cat in ExpenseCategories)
                                    {
                                        <option value="@cat.Id.ToString()">@cat.Name</option>
                                    }
                                </select>
                            </div>

                            <!-- Description / Payee Input -->
                            <div class="col-12">
                                <label class="form-label fw-black text-muted small text-uppercase tracking-wider mb-1">Payee / Expense Detail</label>
                                <input type="text" class="form-control border-2 bg-white rounded-3 fw-bold border-light shadow-sm" @bind="EditingTx.Description" />
                            </div>
 
                            <!-- Check Number Input -->
                            <div class="col-12">
                                <label class="form-label fw-black text-muted small text-uppercase tracking-wider mb-1">Check Number (Optional)</label>
                                <input type="text" class="form-control border-2 bg-white rounded-3 fw-bold border-light shadow-sm" @bind="EditingTx.CheckNumber" />
                            </div>
                        }
                        else
                        {
                            <!-- Deposit Payee / Description -->
                            <div class="col-12">
                                <label class="form-label fw-black text-muted small text-uppercase tracking-wider mb-1">Description / Source</label>
                                <input type="text" class="form-control border-2 bg-white rounded-3 fw-bold border-light shadow-sm" @bind="EditingTx.Description" placeholder="Deposit source..." />
                            </div>
                        }

                        <!-- Transaction Date -->
                        <div class="col-12">
                            <label class="form-label fw-black text-muted small text-uppercase tracking-wider mb-1">Transaction Date</label>
                            <input type="date" class="form-control border-2 bg-white rounded-3 fw-bold border-light shadow-sm" @bind="EditingTx.Date" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 p-4 pt-0 d-flex gap-2">
                    <button class="btn btn-light flex-grow-1 rounded-pill py-2.5 fw-black text-uppercase shadow-sm" @onclick="() => ShowEditTxModal = false">CANCEL</button>
                    <button class="btn btn-primary flex-grow-1 rounded-pill py-2.5 fw-black text-uppercase shadow-sm" @onclick="SaveEditTransaction">SAVE CHANGES</button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Custom Delete Confirmation Modal -->
@if (ShowDeleteConfirmModal && TxToDelete != null)
{
    <div class="modal fade show d-block" style="background: rgba(15,23,42,0.6); z-index: 1070; backdrop-filter: blur(8px);">
        <div class="modal-dialog modal-dialog-centered" style="max-width: 420px;">
            <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden animate__animated animate__bounceIn animate__faster">
                <div class="modal-body p-4 text-center">
                    <div class="rounded-circle bg-danger-subtle text-danger d-inline-flex align-items-center justify-content-center mb-3" style="width: 64px; height: 64px; background-color: #fee2e2;">
