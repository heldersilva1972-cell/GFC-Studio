    private async Task ViewReconciliationDetails(BingoReconciliation recon)
    {
        SelectedReconciliation = recon;
        SelectedReconciliationTxs.Clear();

        try
        {
            var ids = JsonSerializer.Deserialize<List<int>>(recon.ClearedTransactionIdsJson) ?? new List<int>();
            if (ids.Any())
            {
                SelectedReconciliationTxs = await DbContext.BingoLotteryTransactions
                    .Include(t => t.Category)
                    .Where(t => ids.Contains(t.Id))
                    .ToListAsync();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error fetching details for reconciliation {recon.Id}: {ex.Message}");
        }
    }

