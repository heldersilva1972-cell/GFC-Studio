    private async Task SaveEditTransaction()
    {
        if (EditingTx == null || EditingTxAbsAmount <= 0) return;

        var dbTx = await DbContext.BingoLotteryTransactions.FindAsync(EditingTx.Id);
        if (dbTx != null)
        {
            dbTx.Type = EditingTx.Type;
            dbTx.Date = EditingTx.Date;
            dbTx.CategoryId = EditingTx.Type == "Expense" ? EditingTx.CategoryId : null;
            dbTx.Description = string.IsNullOrWhiteSpace(EditingTx.Description) 
                ? (EditingTx.Type == "Income" ? "Deposit" : "General Expense") 
                : EditingTx.Description;
            dbTx.CheckNumber = EditingTx.Type == "Expense" ? EditingTx.CheckNumber : null;
            dbTx.Amount = EditingTx.Type == "Income" ? Math.Abs(EditingTxAbsAmount) : -Math.Abs(EditingTxAbsAmount);
            dbTx.ModifiedAt = DateTime.UtcNow;
            dbTx.ModifiedBy = _currentUsername;

            await DbContext.SaveChangesAsync();
        }

        ShowEditTxModal = false;
        await LoadData();
        StateHasChanged();
    }

