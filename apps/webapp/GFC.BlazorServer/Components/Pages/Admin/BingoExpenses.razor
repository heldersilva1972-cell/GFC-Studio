@code {
    private string _currentUsername = "Unknown";
    private decimal AccountBalance { get; set; }
    private decimal ReconciledBalance { get; set; }
    private decimal UnclearedTotal { get; set; }
    private decimal ReconciliationDifference { get; set; }
    
    // Search & filter states
    private string _searchText = "";
    private string _selectedTypeFilter = "All";
    private string _selectedReconciledFilter = "All";

    // Bank Statement reconciliation ending balance
    private decimal _bankStatementBalance = 0;
    private bool _showReconcilePanel = false;
    private bool IsBalanced => ReconciliationDifference == 0 && _bankStatementBalance != 0;

    // Locally track reconciled transaction IDs to bypass database changes
    private HashSet<int> _reconciledTransactionIds = new();

    private List<LedgerItem> Transactions { get; set; } = new();
    private List<BingoExpenseCategory> ExpenseCategories { get; set; } = new();
    private BingoLotteryTransaction NewExpense { get; set; } = new BingoLotteryTransaction { Date = DateTime.Now, Type = "Expense" };
    private BingoExpenseCategory EditingCategory { get; set; } = new();
    private bool ShowCategoryModal { get; set; }

    // Represent individual items inside our interactive ledger with running balance
    private class LedgerItem
    {
        public int Id { get; set; }
        public DateTime Date { get; set; }
        public string Type { get; set; } // "Income", "Expense", "Prize", etc.
        public decimal Amount { get; set; }
        public string Description { get; set; }
        public BingoExpenseCategory Category { get; set; }
        public decimal RunningBalance { get; set; }
        public BingoLotteryTransaction RawTransaction { get; set; }
    }

    private List<LedgerItem> FilteredTransactions
    {
        get
        {
            var query = Transactions.AsEnumerable();

            // 1. Text Search Filter (payee/description/category)
            if (!string.IsNullOrWhiteSpace(_searchText))
            {
                var term = _searchText.Trim().ToLower();
                query = query.Where(t => 
                    (t.Description ?? "").ToLower().Contains(term) ||
                    (t.Category?.Name ?? "").ToLower().Contains(term)
                );
            }

            // 2. Type Filter
            if (_selectedTypeFilter != "All")
            {
                query = query.Where(t => t.Type == _selectedTypeFilter);
            }

            // 3. Reconciled Status Filter
            if (_selectedReconciledFilter != "All")
            {
                bool showReconciled = _selectedReconciledFilter == "Reconciled";
                query = query.Where(t => _reconciledTransactionIds.Contains(t.Id) == showReconciled);
            }

            return query.ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        _currentUsername = authState.User.Identity?.Name ?? "Unknown";

        // Load Reconciled IDs from localStorage first
        try
        {
            var storedJson = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "gfc_bingo_reconciled_transaction_ids");
            if (!string.IsNullOrEmpty(storedJson))
            {
                var list = JsonSerializer.Deserialize<List<int>>(storedJson);
                if (list != null)
                {
                    _reconciledTransactionIds = new HashSet<int>(list);
                }
            }

            var storedStatementBal = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "gfc_bingo_reconciled_statement_bal");
            if (!string.IsNullOrEmpty(storedStatementBal) && decimal.TryParse(storedStatementBal, out var parsedVal))
            {
                _bankStatementBalance = parsedVal;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[BINGO EXPENSES] Failed to load local reconciliation cache: {ex.Message}");
        }

        await LoadData();
    }

    private async Task LoadData()
    {
        // 1. Fetch raw rows from database (include session transactions too, to ensure ledger is exact!)
        var rawTransactions = await DbContext.BingoLotteryTransactions
            .Include(t => t.Category)
            .Where(t => !t.IsDeleted)
            .OrderBy(t => t.Date)  // Order oldest first to compute accurate running balance!
            .ThenBy(t => t.Id)
            .ToListAsync();

        // 2. Hydrate ledger list and compute sequential running balances
        decimal runningTotal = 0;
        var ledgerList = new List<LedgerItem>();

        foreach (var t in rawTransactions)
        {
            runningTotal += t.Amount;
            
            // Only list manual transactions in the ledger statement (SessionId == null)
            if (t.SessionId == null)
            {
                ledgerList.Add(new LedgerItem
                {
                    Id = t.Id,
                    Date = t.Date,
                    Type = t.Type,
                    Amount = t.Amount,
                    Description = t.Description,
                    Category = t.Category,
                    RunningBalance = runningTotal,
                    RawTransaction = t
                });
            }
        }

        // 3. Order ledger newest first for dashboard display
        Transactions = ledgerList.OrderByDescending(t => t.Date).ThenByDescending(t => t.Id).ToList();
        
        AccountBalance = runningTotal;
        ExpenseCategories = await DbContext.BingoExpenseCategories.Where(c => !c.IsDeleted).ToListAsync();
        
        RecalculateReconciliation();
    }

    private void SetTransactionType(string type)
    {
        NewExpense.Type = type;
        StateHasChanged();
    }

    private void ToggleReconcilePanel()
    {
        _showReconcilePanel = !_showReconcilePanel;
        StateHasChanged();
    }

    private async Task ToggleReconciliation(int txId)
    {
        if (_reconciledTransactionIds.Contains(txId))
        {
            _reconciledTransactionIds.Remove(txId);
        }
        else
        {
            _reconciledTransactionIds.Add(txId);
        }

        // Persist local reconciled states
        try
        {
            var json = JsonSerializer.Serialize(_reconciledTransactionIds.ToList());
            await JSRuntime.InvokeVoidAsync("localStorage.setItem", "gfc_bingo_reconciled_transaction_ids", json);
        }
        catch {}

        RecalculateReconciliation();
        StateHasChanged();
    }

    private async Task RecalculateReconciliation()
    {
        // Uncleared items are those that have NOT been ticked reconciled
        UnclearedTotal = Transactions
            .Where(t => !_reconciledTransactionIds.Contains(t.Id))
            .Sum(t => t.Amount);

        // Reconciled balance matches statement balance when cleared
        ReconciledBalance = AccountBalance - UnclearedTotal;
        ReconciliationDifference = ReconciledBalance - _bankStatementBalance;

        try
        {
            await JSRuntime.InvokeVoidAsync("localStorage.setItem", "gfc_bingo_reconciled_statement_bal", _bankStatementBalance.ToString("F2"));
        }
        catch {}
    }

    private async Task AddExpense()
    {
        if (NewExpense.Amount == 0) return;
        
        // For Deposits, category and payee are completely bypassed and reset
        if (NewExpense.Type == "Income")
        {
            NewExpense.Amount = Math.Abs(NewExpense.Amount);
            NewExpense.CategoryId = null; // Ensure category is empty for deposits
            NewExpense.Description = "Deposit Contribution"; // Clean default description
        }
        else
        {
            NewExpense.Amount = -Math.Abs(NewExpense.Amount);
            if (string.IsNullOrWhiteSpace(NewExpense.Description))
            {
                NewExpense.Description = "Bingo Cash Expense";
            }
        }

        NewExpense.CreatedAt = DateTime.UtcNow;
        NewExpense.CreatedBy = _currentUsername;
        
        DbContext.BingoLotteryTransactions.Add(NewExpense);
        await DbContext.SaveChangesAsync();
        
        // Reset form
        NewExpense = new BingoLotteryTransaction { Date = DateTime.Now, Type = "Expense" };
        await LoadData();
        StateHasChanged();
    }

    private async Task DeleteTransaction(LedgerItem item)
    {
        if (await JSRuntime.InvokeAsync<bool>("confirm", $"Permanently delete ledger transaction: '{item.Description}'?"))
        {
            item.RawTransaction.IsDeleted = true;
            _reconciledTransactionIds.Remove(item.Id); // Clean local reconciled status if any
            
            await DbContext.SaveChangesAsync();
            await LoadData();
            StateHasChanged();
        }
    }

    private void OpenCategoryModal(BingoExpenseCategory cat = null)
    {
        EditingCategory = new BingoExpenseCategory();
        ShowCategoryModal = true;
    }

    private async Task SaveCategory()
    {
        if (string.IsNullOrWhiteSpace(EditingCategory.Name)) return;
        
        EditingCategory.Color = "#3b82f6";
        EditingCategory.Icon = "bi-tag";
        
        DbContext.BingoExpenseCategories.Add(EditingCategory);
        await DbContext.SaveChangesAsync();
        EditingCategory = new BingoExpenseCategory();
        await LoadData();
    }

    private async Task DeleteCategory(BingoExpenseCategory cat)
    {
        cat.IsDeleted = true;
        await DbContext.SaveChangesAsync();
        await LoadData();
    }
}
