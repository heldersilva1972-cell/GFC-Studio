    private List<string> GetFilteredPayeeSuggestions()
    {
        if (Transactions == null) return new List<string>();

        // 1. Get unique descriptions from historical transactions and strip embedded check numbers
        var query = Transactions
            .Select(t => t.Description?.Trim())
            .Where(d => !string.IsNullOrWhiteSpace(d) && d != "Deposit" && d != "GFC Loan" && d != "Charity Donation" && d != "Repayment")
            .Select(d => {
                int checkIndex = d.IndexOf(" (Check #");
                if (checkIndex > 0)
                {
                    return d.Substring(0, checkIndex).Trim();
                }
                return d;
            })
            .Distinct();

        // 2. Filter by blocklist
        var list = query.Where(p => !_deletedPayees.Contains(p)).ToList();

        // 3. Filter by current typing input
        if (!string.IsNullOrWhiteSpace(NewExpense.Description))
        {
            var filter = NewExpense.Description.Trim().ToLower();
            list = list.Where(p => p.ToLower().Contains(filter)).ToList();
        }

        return list.Take(6).ToList(); // Limit to 6 suggestions for sleek compact display
    }
