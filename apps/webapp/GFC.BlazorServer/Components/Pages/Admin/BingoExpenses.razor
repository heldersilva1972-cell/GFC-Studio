        {
            _deletedPayees.Add(payeeName);
            try
            {
                var json = JsonSerializer.Serialize(_deletedPayees);
                await JSRuntime.InvokeVoidAsync("localStorage.setItem", "gfc_deleted_payees", json);
            }
