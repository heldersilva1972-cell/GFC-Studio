@page "/admin/bingo/expenses"
@layout GFC.BlazorServer.Components.Layout.FullPageLayout
@using GFC.Core.Models
@using GFC.BlazorServer.Data
@using Microsoft.EntityFrameworkCore
@using global::System.Security.Claims
@using global::System.Globalization
@using global::System.Text.Json
@inject GfcDbContext DbContext
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject GFC.Core.Interfaces.IUserManagementService UserService
@inject GFC.BlazorServer.Services.CustomAuthenticationStateProvider AuthStateProvider
@attribute [Authorize]

<PageTitle>Bingo Bank Ledger & Expense Center</PageTitle>

<div class="expense-center py-4">
    <div class="container-fluid px-4" style="max-width: 1400px;">
        
        <!-- Premium Header & Stats Banner -->
        <div class="header-dashboard-banner mb-4">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                <div class="d-flex align-items-center gap-3">
                    <button class="btn btn-back-circle shadow-sm" @onclick='() => Navigation.NavigateTo("/admin/bingo")' title="Back to Bingo">
                        <i class="bi bi-arrow-left fs-4"></i>
                    </button>
                    <div>
                        <h1 class="fw-black text-white m-0 tracking-tight" style="font-size: 2rem; letter-spacing: -0.5px;">BINGO BANK LEDGER</h1>
                        <p class="small fw-bold text-uppercase m-0" style="color: rgba(255, 255, 255, 0.85) !important;">Track transactions, manage cash, and reconcile bank statements</p>
                    </div>
                </div>
                
                <div class="d-flex gap-3 align-items-center">
                    <!-- Balance Metric Card -->
                    <div class="metric-card ledger-balance shadow-sm">
                        <span class="metric-label">LEDGER BALANCE</span>
                        <h3 class="metric-value @(AccountBalance >= 0 ? "text-success" : "text-danger")">
                            @AccountBalance.ToString("C2")
                        </h3>
                    </div>

                    <!-- Reconciled Balance Metric Card -->
                    <div class="metric-card reconciled-balance shadow-sm">
                        <span class="metric-label">RECONCILED BALANCE</span>
                        <h3 class="metric-value">
                            @ReconciledBalance.ToString("C2")
                        </h3>
                    </div>

                    <!-- Bank Reconciliation Toggle -->
                    <button class="btn btn-reconcile-toggle shadow-sm @(IsBalanced ? "balanced" : "unbalanced")" @onclick="ToggleReconcilePanel">
                        <i class="bi @(IsBalanced ? "bi-check-all" : "bi-arrow-left-right")"></i>
                        <span>@(IsBalanced ? "BALANCED & RECONCILED" : "RECONCILE STATEMENT")</span>
                    </button>
                </div>
            </div>
        </div>

        <div class="row g-4">
            
            <!-- Left Side: Transaction Entry Form & Bank Reconciliation Panel -->
            <div class="col-xl-4 col-lg-5">
                
                <!-- Quick Entry Form -->
                <div class="card border-0 shadow-sm rounded-4 p-4 mb-4 dashboard-pane">
                    <h4 class="pane-title mb-4"><i class="bi bi-plus-circle-fill text-primary"></i> RECORD TRANSACTION</h4>
                    
                    <div class="row g-3">
                        <!-- Transaction Type Toggle -->
                        <div class="col-12">
                            <label class="form-label fw-black text-muted small text-uppercase tracking-wider mb-2">Transaction Type</label>
                            <div class="type-selector-pills">
                                <button class="type-pill expense-type @(NewExpense.Type == "Expense" ? "active" : "")" 
                                        @onclick='() => SetTransactionType("Expense")'>
                                    <i class="bi bi-dash-circle-fill"></i> EXPENSE
                                </button>
                                <button class="type-pill deposit-type @(NewExpense.Type == "Income" ? "active" : "")" 
                                        @onclick='() => SetTransactionType("Income")'>
                                    <i class="bi bi-plus-circle-fill"></i> DEPOSIT
                                </button>
                            </div>
                        </div>

                        <!-- Amount Input -->
                        <div class="col-12">
                            <label class="form-label fw-black text-muted small text-uppercase tracking-wider mb-1">Amount ($)</label>
                            <div class="input-group input-group-lg bg-light border-0 rounded-4 overflow-hidden shadow-inner">
                                <span class="input-group-text border-0 bg-transparent ps-4 fw-black fs-2 text-secondary">$</span>
                                <input type="number" step="0.01" class="form-control border-0 bg-transparent fw-black fs-1 py-3 text-dark" @bind="NewExpense.Amount" placeholder="0.00" autofocus />
                            </div>
                        </div>

                        @if (NewExpense.Type == "Expense")
                        {
                            <!-- Category Selector -->
                            <div class="col-12">
                                <label class="form-label fw-black text-muted small text-uppercase tracking-wider mb-1">Category</label>
                                <div class="d-flex gap-2">
                                    <select class="form-select form-select-lg border-2 bg-white rounded-3 fw-bold border-light shadow-sm" @bind="NewExpense.CategoryId">
                                        <option value="">Select Category...</option>
                                        @foreach (var cat in ExpenseCategories)
                                        {
                                            <option value="@cat.Id">@cat.Name</option>
                                        }
                                    </select>
                                    <button class="btn btn-outline-primary rounded-3 px-3 shadow-sm" @onclick="() => OpenCategoryModal()" title="Manage Categories">
                                        <i class="bi bi-tags-fill"></i>
                                    </button>
                                </div>
                            </div>

                            <!-- Description / Payee Input -->
                            <div class="col-12">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <label class="form-label fw-black text-muted small text-uppercase tracking-wider m-0">
                                        Payee / Expense Detail
                                    </label>
                                </div>
                                <input type="text" class="form-control form-control-lg border-2 bg-white rounded-3 fw-bold border-light shadow-sm" 
                                       @bind="NewExpense.Description" 
                                       placeholder="Enter vendor or payee name..." />
                            </div>
                        }

                        <!-- Transaction Date -->
                        <div class="col-12">
                            <label class="form-label fw-black text-muted small text-uppercase tracking-wider mb-1">Transaction Date</label>
                            <input type="date" class="form-control form-control-lg border-2 bg-white rounded-3 fw-bold border-light shadow-sm" @bind="NewExpense.Date" />
                        </div>

                        <!-- Submit Button -->
                        <div class="col-12 pt-3">
                            <button class="btn @(NewExpense.Type == "Expense" ? "btn-danger" : "btn-success") btn-lg w-100 py-3 rounded-pill fw-black shadow-sm text-uppercase" 
                                    @onclick="AddExpense">
                                <i class="bi @(NewExpense.Type == "Expense" ? "bi-dash-circle" : "bi-plus-circle") me-2"></i> Record @NewExpense.Type.ToUpper()
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Live Bank Reconciliation Box -->
                @if (_showReconcilePanel)
                {
                    <div class="card border-0 shadow-sm rounded-4 p-4 dashboard-pane animate__animated animate__slideInLeft animate__faster" style="background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%); border: 2px solid #cbd5e1 !important;">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h4 class="pane-title text-navy m-0"><i class="bi bi-bank2 text-primary"></i> BANK STATEMENT RECONCILIATION</h4>
                            <button class="btn btn-sm btn-link text-muted p-0 text-decoration-none" @onclick="ToggleReconcilePanel"><i class="bi bi-x-lg fs-5"></i></button>
                        </div>
                        <p class="text-muted small fw-semibold mb-4">Enter your bank statement ending balance and tick off transactions in the ledger to reconcile.</p>

                        <div class="row g-3">
                            <div class="col-12">
                                <label class="form-label fw-black text-muted small text-uppercase tracking-wider mb-1">Bank Statement Balance</label>
                                <div class="input-group bg-white rounded-3 border-2 border shadow-sm overflow-hidden">
                                    <span class="input-group-text border-0 bg-transparent fw-bold">$</span>
                                    <input type="number" step="0.01" class="form-control border-0 fw-black text-dark" @bind="_bankStatementBalance" @bind:after="RecalculateReconciliation" placeholder="0.00" />
                                </div>
                            </div>

                            <div class="col-12">
                                <div class="bg-white p-3 rounded-3 border shadow-sm text-start">
                                    <div class="d-flex justify-content-between py-1 border-bottom">
                                        <span class="small fw-bold text-muted">Ledger Balance:</span>
                                        <span class="fw-black text-slate">@AccountBalance.ToString("C2")</span>
                                    </div>
                                    <div class="d-flex justify-content-between py-1 border-bottom">
                                        <span class="small fw-bold text-muted">Uncleared Items:</span>
                                        <span class="fw-black text-danger">@UnclearedTotal.ToString("C2")</span>
                                    </div>
                                    <div class="d-flex justify-content-between py-1 border-bottom">
                                        <span class="small fw-bold text-muted">Reconciled Balance:</span>
                                        <span class="fw-black text-primary">@ReconciledBalance.ToString("C2")</span>
                                    </div>
                                    <div class="d-flex justify-content-between py-1 mt-2">
                                        <span class="small fw-bold text-muted">Difference:</span>
                                        <span class="fw-black @(ReconciliationDifference == 0 ? "text-success animate-pulse" : "text-danger")">@ReconciliationDifference.ToString("C2")</span>
                                    </div>
                                </div>
                            </div>

                            @if (IsBalanced)
                            {
                                <div class="col-12 animate__animated animate__bounceIn">
                                    <div class="alert alert-success border-0 rounded-3 p-3 text-center d-flex align-items-center justify-content-center gap-2">
                                        <i class="bi bi-patch-check-fill fs-4 text-success"></i>
                                        <span class="fw-black text-success small">LEDGER BALANCED & RECONCILED! 🟢</span>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>

            <!-- Right Side: Unified Statement Ledger -->
            <div class="col-xl-8 col-lg-7">
                <div class="card border-0 shadow-sm rounded-4 p-4 dashboard-pane h-100 d-flex flex-column overflow-hidden">
                    
                    <!-- Search, Filters, Actions Toolbar -->
                    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
                        <div>
                            <h4 class="pane-title m-0"><i class="bi bi-list-columns-reverse text-primary"></i> BANK LEDGER STATEMENT</h4>
                            <p class="text-muted extra-small fw-bold text-uppercase m-0">Showing manual ledger transactions and running balances</p>
                        </div>

                        <div class="d-flex flex-wrap gap-2 align-items-center">
                            <!-- Search Bar -->
                            <div class="input-group input-group-sm bg-light border-0 rounded-pill px-3 py-1 shadow-inner" style="max-width: 250px;">
                                <span class="input-group-text border-0 bg-transparent p-0 text-muted me-2"><i class="bi bi-search"></i></span>
                                <input type="text" class="form-control border-0 bg-transparent p-0 text-dark small" @bind="_searchText" @bind:event="oninput" placeholder="Search payee or detail..." />
                            </div>

                            <!-- Transaction Type Filter -->
                            <select class="form-select form-select-sm border-2 rounded-pill fw-bold border-light bg-light shadow-sm" style="width: 130px;" @bind="_selectedTypeFilter">
                                <option value="All">All Types</option>
                                <option value="Income">Deposits</option>
                                <option value="Expense">Expenses</option>
                            </select>

                            <!-- Status Filter -->
                            <select class="form-select form-select-sm border-2 rounded-pill fw-bold border-light bg-light shadow-sm" style="width: 140px;" @bind="_selectedReconciledFilter">
                                <option value="All">All Clearance</option>
                                <option value="Reconciled">Reconciled</option>
                                <option value="Uncleared">Uncleared</option>
                            </select>
                        </div>
                    </div>

                    <!-- Main Statement Ledger Table -->
                    <div class="flex-grow-1 overflow-auto bg-light rounded-4 border" style="max-height: 700px; box-shadow: inset 0 2px 8px rgba(0,0,0,0.02);">
                        @if (!FilteredTransactions.Any())
                        {
                            <div class="text-center py-5 my-5 text-muted opacity-50">
                                <i class="bi bi-card-checklist fs-1 d-block mb-2"></i>
                                <span class="small fw-black text-uppercase">No matching transactions found</span>
                            </div>
                        }
                        else
                        {
                            <table class="table table-hover align-middle mb-0 bank-table-theme">
                                <thead class="table-white sticky-top shadow-sm border-bottom text-uppercase fs-7 fw-black text-secondary bg-white">
                                    <tr>
                                        <th class="ps-4 text-center" style="width: 60px;">Reconciled</th>
                                        <th style="width: 130px;">Date</th>
                                        <th>Category</th>
                                        <th>Payee / Description</th>
                                        <th class="text-end" style="width: 130px;">Amount</th>
                                        <th class="text-end" style="width: 150px;">Running Balance</th>
                                        <th class="text-center" style="width: 60px;">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var entry in FilteredTransactions)
                                    {
                                        var isCleared = _reconciledTransactionIds.Contains(entry.Id);
                                        var displayTitle = string.IsNullOrEmpty(entry.Description) 
                                            ? (entry.Type == "Income" ? "Deposit Contribution" : entry.Category?.Name ?? "General Expense") 
                                            : entry.Description;

                                        <tr class="bank-row last-border-0 @(isCleared ? "reconciled-bg" : "")">
                                            <!-- Status Checkbox -->
                                            <td class="text-center ps-4">
                                                <button class="btn btn-link p-0 text-decoration-none btn-clearance @(isCleared ? "cleared text-success" : "uncleared text-muted")" 
                                                        @onclick="() => ToggleReconciliation(entry.Id)" 
                                                        title="@(isCleared ? "Click to mark Uncleared" : "Click to mark Reconciled")">
                                                    <i class="bi @(isCleared ? "bi-check-circle-fill" : "bi-circle")"></i>
                                                </button>
                                            </td>

                                            <!-- Transaction Date -->
                                            <td class="fw-bold text-secondary font-monospace" style="font-size: 0.85rem;">
                                                @entry.Date.ToString("yyyy-MM-dd")
                                            </td>

                                            <!-- Category -->
                                            <td>
                                                <span class="badge @(entry.Type == "Income" ? "bg-success-subtle text-success border border-success-subtle" : "bg-primary-subtle text-primary border border-primary-subtle") rounded-pill px-2.5 py-1 text-uppercase fw-black" style="font-size: 0.65rem;">
                                                    @(entry.Category?.Name ?? (entry.Type == "Income" ? "DEPOSIT" : "UNCATEGORIZED"))
                                                </span>
                                            </td>

                                            <!-- Description -->
                                            <td>
                                                <span class="fw-black text-slate text-capitalize" style="font-size: 0.9rem;">
                                                    @displayTitle
                                                </span>
                                            </td>

                                            <!-- Amount -->
                                            <td class="text-end fw-black fs-6 @(entry.Type == "Income" ? "text-success" : "text-danger")">
                                                @(entry.Type == "Income" ? "+" : "")@entry.Amount.ToString("C2")
                                            </td>

                                            <!-- Running Balance -->
                                            <td class="text-end fw-black text-secondary font-monospace" style="font-size: 0.95rem;">
                                                @entry.RunningBalance.ToString("C2")
                                            </td>

                                            <!-- Actions -->
                                            <td class="text-center">
                                                <button class="btn btn-outline-danger btn-sm border-0 rounded-circle d-flex align-items-center justify-content-center mx-auto shadow-sm" 
                                                        style="width: 32px; height: 32px;" 
                                                        @onclick="() => DeleteTransaction(entry)" 
                                                        title="Delete Entry">
                                                    <i class="bi bi-trash-fill fs-7"></i>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                    </div>

                    <!-- Footer Back Action -->
                    <div class="mt-4 pt-3 border-top d-flex justify-content-between align-items-center">
                        <span class="extra-small text-muted fw-bold text-uppercase">Showing @FilteredTransactions.Count transactions</span>
                        <button class="btn btn-outline-secondary rounded-pill px-4 fw-black" @onclick='() => Navigation.NavigateTo("/admin/bingo")'>
                            <i class="bi bi-speedometer me-2"></i> RETURN TO DASHBOARD
                        </button>
                    </div>
                </div>
            </div>

        </div>

    </div>
</div>

<!-- Add Category Modal -->
@if (ShowCategoryModal)
{
    <div class="modal fade show d-block" style="background: rgba(15,23,42,0.6); z-index: 1060; backdrop-filter: blur(8px);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden animate__animated animate__zoomIn animate__faster">
                <div class="modal-header border-0 p-4 pb-0">
                    <h5 class="modal-title fw-black"><i class="bi bi-tags-fill text-primary"></i> MANAGE CATEGORIES</h5>
                    <button type="button" class="btn-close" @onclick="() => ShowCategoryModal = false"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-4 p-3 bg-light rounded-4 border">
                        <label class="form-label fw-black small text-muted text-uppercase mb-2">Create New Category</label>
                        <div class="input-group">
                            <input type="text" class="form-control border-2 fw-bold" @bind="EditingCategory.Name" placeholder="Category Name..." />
                            <button class="btn btn-primary px-4 fw-black" @onclick="SaveCategory">ADD</button>
                        </div>
                    </div>

                    <label class="form-label fw-black small text-muted text-uppercase mb-2">Existing Categories</label>
                    <div class="list-group list-group-flush rounded-3 border overflow-auto" style="max-height: 250px;">
                        @foreach (var cat in ExpenseCategories)
                        {
                            <div class="list-group-item d-flex justify-content-between align-items-center py-2 px-3">
                                <span class="fw-bold">@cat.Name</span>
                                <button class="btn btn-sm btn-outline-danger border-0 rounded-circle" @onclick="() => DeleteCategory(cat)">
                                    <i class="bi bi-trash fs-6"></i>
                                </button>
                            </div>
                        }
                    </div>
                </div>
                <div class="modal-footer border-0 p-4 pt-0">
                    <button class="btn btn-light w-100 rounded-pill py-2.5 fw-black text-uppercase shadow-sm" @onclick="() => ShowCategoryModal = false">CLOSE</button>
                </div>
            </div>
        </div>
    </div>
}

<style>
    .expense-center { background: #f8fafc; min-height: 100vh; font-family: 'Inter', system-ui, -apple-system, sans-serif; }
    .text-slate { color: #0f172a; }
    .text-navy { color: #1e3a8a; }
    .extra-small { font-size: 0.65rem; }
    .fs-7 { font-size: 0.75rem; }
    .shadow-inner { box-shadow: inset 0 2px 6px rgba(0,0,0,0.05) !important; }

    /* Header Banner with slick Indigo/Violet gradient */
    .header-dashboard-banner {
        background: linear-gradient(135deg, #1e3a8a 0%, #4338ca 50%, #6d28d9 100%);
        padding: 2.25rem 2.5rem;
        border-radius: 24px;
        box-shadow: 0 10px 30px rgba(67, 56, 202, 0.2);
    }

    .btn-back-circle {
        width: 48px;
        height: 48px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.15);
        color: white;
        border: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s;
    }
    .btn-back-circle:hover {
        background: rgba(255, 255, 255, 0.35);
        transform: scale(1.05);
        color: white;
    }

    /* Metric Cards */
    .metric-card {
        background: rgba(255, 255, 255, 0.12);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.2);
        padding: 0.6rem 1.5rem;
        border-radius: 16px;
        min-width: 170px;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }
    .metric-card .metric-label {
        font-size: 0.55rem;
        font-weight: 900;
        color: rgba(255, 255, 255, 0.6);
        text-transform: uppercase;
        letter-spacing: 1px;
        margin-bottom: 2px;
    }
    .metric-card .metric-value {
        font-weight: 900;
        font-size: 1.35rem;
        margin: 0;
        letter-spacing: -0.5px;
    }
    .ledger-balance .metric-value {
        color: #86efac !important;
    }
    .reconciled-balance .metric-value {
        color: #93c5fd !important;
    }

    /* Reconcile Statement Action Button */
    .btn-reconcile-toggle {
        height: 52px;
        border-radius: 16px;
        border: none;
        padding-left: 20px;
        padding-right: 20px;
        font-weight: 900;
        font-size: 0.85rem;
        letter-spacing: 0.5px;
        text-transform: uppercase;
        display: flex;
        align-items: center;
        gap: 8px;
        transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
        cursor: pointer;
    }
    .btn-reconcile-toggle.unbalanced {
        background: white;
        color: #1e3a8a;
    }
    .btn-reconcile-toggle.unbalanced:hover {
        background: #f1f5f9;
        transform: translateY(-2px);
    }
    .btn-reconcile-toggle.balanced {
        background: #10b981;
        color: white;
        box-shadow: 0 4px 15px rgba(16, 185, 129, 0.35) !important;
    }
    .btn-reconcile-toggle.balanced:hover {
        background: #059669;
        transform: translateY(-2px);
    }

    /* Dashboard Panes */
    .dashboard-pane {
        background: white;
        border: 1px solid #e2e8f0;
        transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .dashboard-pane:hover {
        border-color: #cbd5e1;
        box-shadow: 0 10px 20px rgba(15, 23, 42, 0.03) !important;
    }
    .pane-title {
        font-size: 1.1rem;
        font-weight: 900;
        letter-spacing: -0.5px;
        color: #0f172a;
    }

    /* Type Selector segmented pill buttons */
    .type-selector-pills {
        display: flex;
        background: #f1f5f9;
        padding: 5px;
        border-radius: 14px;
        border: 1px solid #e2e8f0;
        gap: 4px;
    }
    .type-pill {
        flex: 1;
        border: none;
        border-radius: 10px;
        padding: 10px;
        font-weight: 900;
        font-size: 0.8rem;
        letter-spacing: 0.5px;
        transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        background: transparent;
        color: #64748b;
        cursor: pointer;
    }
    .type-pill.expense-type.active {
        background: #ef4444;
        color: white;
        box-shadow: 0 4px 10px rgba(239, 68, 68, 0.25);
    }
    .type-pill.deposit-type.active {
        background: #10b981;
        color: white;
        box-shadow: 0 4px 10px rgba(16, 185, 129, 0.25);
    }

    /* Statement Ledger Table Styling */
    .bank-table-theme {
        width: 100%;
        border-collapse: separate;
    }
    .bank-table-theme th {
        font-size: 0.7rem;
        letter-spacing: 1px;
        color: #64748b;
        background: white;
        padding-top: 1rem;
        padding-bottom: 1rem;
        border-bottom: 2px solid #e2e8f0;
    }
    .bank-row {
        transition: all 0.15s ease;
        cursor: pointer;
    }
    .bank-row:hover {
        background-color: #f8fafc !important;
    }
    .bank-row.reconciled-bg {
        background-color: rgba(16, 185, 129, 0.02) !important;
    }
    .bank-row.reconciled-bg:hover {
        background-color: rgba(16, 185, 129, 0.05) !important;
    }

    /* Checkmark buttons */
    .btn-clearance {
        font-size: 1.15rem;
        transition: transform 0.15s ease;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }
    .btn-clearance:hover {
        transform: scale(1.15);
    }

    .fw-black { font-weight: 900; }
