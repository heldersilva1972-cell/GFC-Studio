                </div>
                <div class="modal-footer border-0 p-4 pt-0">
                    <button class="btn btn-light w-100 rounded-pill py-2.5 fw-black text-uppercase shadow-sm" @onclick="() => ShowCategoryModal = false">CLOSE</button>
