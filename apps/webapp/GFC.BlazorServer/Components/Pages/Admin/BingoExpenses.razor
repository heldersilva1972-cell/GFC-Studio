    private async Task SaveLoanRepayment()
    {
        if (SelectedLoan == null || !RepaymentAmount.HasValue || RepaymentAmount.Value <= 0) return;

        var amountToPay = RepaymentAmount.Value;

        // Clip repayment amount to remaining balance to avoid overpaying
        if (amountToPay > SelectedLoan.RemainingBalance)
        {
            amountToPay = SelectedLoan.RemainingBalance;
        }

        SelectedLoan.RemainingBalance -= amountToPay;
        SelectedLoan.ModifiedAt = DateTime.UtcNow;
        SelectedLoan.ModifiedBy = _currentUsername;

        // If paid off, soft-delete it
        if (SelectedLoan.RemainingBalance <= 0)
        {
            SelectedLoan.IsDeleted = true;
        }

        // Fetch or create "Repayment" category to cleanly categorize the transaction
        var repaymentCat = await DbContext.BingoExpenseCategories
            .FirstOrDefaultAsync(c => c.Name.ToLower() == "repayment" && !c.IsDeleted);

        if (repaymentCat == null)
        {
            repaymentCat = new BingoExpenseCategory
            {
                Name = "Repayment",
                Color = "#6366f1", // Indigo
                Icon = "bi-arrow-left-right",
                IsDeleted = false
            };
            DbContext.BingoExpenseCategories.Add(repaymentCat);
            await DbContext.SaveChangesAsync();
        }

        // Create negative expense transaction in the database
        var repayTx = new BingoLotteryTransaction
        {
            Date = RepaymentDate,
            Type = "Expense",
            Amount = -amountToPay,
            Description = $"Loan Repayment: {SelectedLoan.Lender}",
            CategoryId = repaymentCat.Id,
            CreatedAt = DateTime.UtcNow,
            CreatedBy = _currentUsername
        };

        DbContext.BingoLotteryTransactions.Add(repayTx);
        await DbContext.SaveChangesAsync();

        ShowRepayLoanModal = false;
        await LoadData();
        StateHasChanged();
    }

