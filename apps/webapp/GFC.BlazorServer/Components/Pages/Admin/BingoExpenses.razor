<!-- High-Contrast Printable Auditor Report (Web Hidden, Print Only) -->
<div class="print-report-section d-none">
    <div style="font-family: 'Courier New', Courier, monospace; color: #000; padding: 30px; line-height: 1.4;">
        
        <!-- Header Section -->
        <table style="width: 100%; border-bottom: 3px double #000; padding-bottom: 12px; margin-bottom: 20px;">
            <tr>
                <td style="width: 70%;">
                    <h2 style="margin: 0; font-weight: bold; font-size: 1.5rem; text-transform: uppercase;">GLOUCESTER FRATERNITY CLUB, INC.</h2>
                    <p style="margin: 4px 0 0 0; font-size: 0.85rem; font-weight: bold; text-transform: uppercase; letter-spacing: 0.5px;">BINGO LOTTERY COMPLIANCE AUDIT SHEET</p>
                </td>
                <td style="width: 30%; text-align: right; vertical-align: bottom;">
                    <p style="margin: 0; font-size: 0.85rem; font-weight: bold;">MONTH: @GetReportMonthName()</p>
                    <p style="margin: 2px 0 0 0; font-size: 0.75rem; font-weight: bold;">RUN DATE: @DateTime.Now.ToString("yyyy-MM-dd HH:mm")</p>
                </td>
            </tr>
        </table>

        <!-- Monthly Balance Sheet & Ledger Totals -->
        <h4 style="margin: 0 0 8px 0; text-transform: uppercase; font-weight: bold; border-bottom: 1px solid #000; padding-bottom: 4px;">1. MONTHLY FINANCIAL STATEMENT</h4>
        <table style="width: 100%; border-collapse: collapse; margin-bottom: 25px; font-size: 0.85rem;">
            <tr style="border-bottom: 1px dashed #ccc;">
                <td style="padding: 6px 0; font-weight: bold;">STARTING MONTHLY BALANCE (As of @(new DateTime(_selectedMonthFilter.Year, _selectedMonthFilter.Month, 1).ToString("yyyy-MM-dd")))</td>
                <td style="padding: 6px 0; text-align: right; font-weight: bold;">@GetMonthlyStartingBalance().ToString("C2")</td>
            </tr>
            <tr style="border-bottom: 1px dashed #ccc;">
                <td style="padding: 6px 0; color: #000;">(+) TOTAL COLLECTIONS / DEPOSITS DURING MONTH</td>
                <td style="padding: 6px 0; text-align: right; font-weight: bold; color: #000;">+@GetMonthlyIncome().ToString("C2")</td>
            </tr>
            <tr style="border-bottom: 1px dashed #ccc;">
                <td style="padding: 6px 0; color: #000;">(-) TOTAL DISBURSEMENTS / EXPENSES DURING MONTH</td>
                <td style="padding: 6px 0; text-align: right; font-weight: bold; color: #000;">-@GetMonthlyExpenses().ToString("C2")</td>
            </tr>
            <tr style="border-bottom: 1px solid #000; font-size: 0.95rem; background-color: #f9fafb;">
                <td style="padding: 8px 6px; font-weight: bold;">ENDING LEDGER BALANCE (As of @(new DateTime(_selectedMonthFilter.Year, _selectedMonthFilter.Month, DateTime.DaysInMonth(_selectedMonthFilter.Year, _selectedMonthFilter.Month)).ToString("yyyy-MM-dd")))</td>
                <td style="padding: 8px 6px; text-align: right; font-weight: bold;">@((GetMonthlyStartingBalance() + GetMonthlyIncome() - GetMonthlyExpenses()).ToString("C2"))</td>
            </tr>
        </table>

        <!-- Income vs Expense Audit Breakdown (Compliance Tiles) -->
        <h4 style="margin: 0 0 8px 0; text-transform: uppercase; font-weight: bold; border-bottom: 1px solid #000; padding-bottom: 4px;">2. LOTTERY COMPLIANCE & EXPENDITURE AUDIT</h4>
        <table style="width: 100%; border-collapse: collapse; margin-bottom: 25px; font-size: 0.85rem;">
            <thead>
                <tr style="border-bottom: 2px solid #000; font-weight: bold;">
                    <th style="padding: 6px 0; text-align: left; width: 60%;">Compliance Metric Description</th>
                    <th style="padding: 6px 0; text-align: right; width: 20%;">Monthly Total</th>
                    <th style="padding: 6px 0; text-align: right; width: 20%;">Yearly Running</th>
                </tr>
            </thead>
            <tbody>
                <tr style="border-bottom: 1px dashed #ccc;">
                    <td style="padding: 6px 0;">GFC GENERAL EXPENSE LIMIT LEVEL (Limit: @GfcExpenseLimit.ToString("C0"))</td>
                    <td style="padding: 6px 0; text-align: right;">@GetMonthlyGfcExpenses().ToString("C2")</td>
                    <td style="padding: 6px 0; text-align: right; font-weight: bold;">@TotalGfcExpenses.ToString("C2")</td>
                </tr>
                <tr style="border-bottom: 1px dashed #ccc;">
                    <td style="padding: 6px 0;">CHARITY AND PHILANTHROPIC CONTRIBUTIONS YIELD</td>
                    <td style="padding: 6px 0; text-align: right; font-weight: bold;">@GetMonthlyCharity().ToString("C2")</td>
                    <td style="padding: 6px 0; text-align: right; font-weight: bold;">@TotalCharityPayments.ToString("C2")</td>
                </tr>
                <tr style="border-bottom: 1px dashed #ccc;">
                    <td style="padding: 6px 0;">DIRECT BINGO OPERATING EXPENSES (Exempt from limit)</td>
                    <td style="padding: 6px 0; text-align: right;">
                        @(Transactions.Where(t => t.Date.Year == _selectedMonthFilter.Year && t.Date.Month == _selectedMonthFilter.Month && t.Type == "Expense" && IsCategoryBingoSpecific(t.Category)).Sum(t => Math.Abs(t.Amount)).ToString("C2"))
                    </td>
                    <td style="padding: 6px 0; text-align: right;">
                        @(Transactions.Where(t => t.Type == "Expense" && IsCategoryBingoSpecific(t.Category)).Sum(t => Math.Abs(t.Amount)).ToString("C2"))
                    </td>
                </tr>
            </tbody>
        </table>

        <!-- Monthly Transaction Registry -->
        <h4 style="margin: 0 0 8px 0; text-transform: uppercase; font-weight: bold; border-bottom: 1px solid #000; padding-bottom: 4px;">3. TRANSACTION REGISTRY DETAIL</h4>
        @{
            var reportTxs = FilteredTransactions;
        }
        @if (!reportTxs.Any())
        {
            <p style="font-size: 0.85rem; font-style: italic; color: #666; margin-bottom: 25px;">No transactions recorded for the selected audit period.</p>
        }
        else
        {
            <!-- Flex-based high-reliability single-line ledger table -->
            <div style="width: 100%; margin-bottom: 30px;">
                <!-- Header Row -->
                <div style="display: flex; flex-direction: row; border-bottom: 2px solid #000; font-weight: bold; font-size: 0.8rem; padding: 6px 0; margin-bottom: 4px;">
                    <div style="width: 12%; text-align: left;">Date</div>
                    <div style="width: 10%; text-align: left;">Type</div>
                    <div style="width: 18%; text-align: left;">Category</div>
                    <div style="width: 40%; text-align: left;">Payee / Description</div>
                    <div style="width: 10%; text-align: right;">Amount</div>
                    <div style="width: 10%; text-align: right;">Status</div>
                </div>

                <!-- Data Rows -->
                @foreach (var entry in reportTxs.OrderBy(t => t.Date).ThenBy(t => t.Id))
                {
                    var isCleared = _permanentlyReconciledTransactionIds.Contains(entry.Id);
                    <div style="display: flex; flex-direction: row; align-items: center; border-bottom: 1px dashed #ccc; font-size: 0.75rem; padding: 5px 0; min-height: 24px;">
                        <div style="width: 12%; font-weight: bold; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; padding-right: 4px;">
                            @entry.Date.ToString("yyyy-MM-dd")
                        </div>
                        <div style="width: 10%; text-transform: uppercase; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; padding-right: 4px;">
                            @entry.Type
                        </div>
                        <div style="width: 18%; text-transform: uppercase; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; padding-right: 4px;">
                            @(entry.Category?.Name ?? (entry.Type == "Income" ? "DEPOSIT" : "GENERAL EXPENSE"))
                        </div>
                        <div style="width: 40%; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; padding-right: 4px;" title="@entry.Description">
                            @entry.Description
                        </div>
                        <div style="width: 10%; text-align: right; font-weight: bold; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; padding-right: 4px;">
                            @entry.Amount.ToString("C2")
                        </div>
                        <div style="width: 10%; text-align: right; text-transform: uppercase; font-size: 0.65rem; font-weight: bold; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                            @(isCleared ? "CLEARED" : "UNCLEARED")
                        </div>
                    </div>
                }
            </div>
        }

        <!-- Signatures -->
        <table style="width: 100%; margin-top: 50px; border-top: 1px solid #000; padding-top: 15px; font-size: 0.8rem;">
            <tr>
                <td style="width: 45%;">
                    <p style="margin: 0; font-weight: bold;">PREPARED & AUDITED BY:</p>
                    <p style="margin: 30px 0 0 0; border-bottom: 1px solid #000; width: 80%;"></p>
                    <p style="margin: 4px 0 0 0; font-size: 0.75rem; font-weight: bold;">Club Treasurer: @_currentUsername</p>
                </td>
                <td style="width: 10%;"></td>
                <td style="width: 45%; text-align: right;">
                    <p style="margin: 0; font-weight: bold; text-align: left;">APPROVED BY BOARD OF DIRECTORS:</p>
                    <p style="margin: 30px 0 0 0; border-bottom: 1px solid #000; width: 80%; float: right;"></p>
                    <div style="clear: both;"></div>
                    <p style="margin: 4px 0 0 0; font-size: 0.75rem; font-weight: bold; text-align: right;">Audit Approval Date</p>
                </td>
            </tr>
        </table>
    </div>
</div>

