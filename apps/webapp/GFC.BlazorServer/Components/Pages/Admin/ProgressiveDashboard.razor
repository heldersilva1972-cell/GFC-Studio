@page "/admin/bingo/progressive"
@using GFC.Core.Models
@using GFC.BlazorServer.Data
@using Microsoft.EntityFrameworkCore
@inject GfcDbContext DbContext
@inject IJSRuntime JSRuntime
@inject GFC.BlazorServer.Services.CustomAuthenticationStateProvider AuthStateProvider
@attribute [Authorize]

<PageTitle>Progressive Dashboard | GFC Admin</PageTitle>

<div class="admin-container p-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-black text-dark mb-1">PROGRESSIVE DASHBOARD</h1>
            <p class="text-muted">Monitor and override ball counts for progressive games.</p>
        </div>
        <button class="btn btn-primary rounded-pill px-4 fw-bold shadow-sm" @onclick="LoadData">
            <i class="bi bi-arrow-clockwise me-2"></i> REFRESH DATA
        </button>
    </div>

    @if (Loading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-2 text-muted">Loading Progressive Games...</p>
        </div>
    }
    else if (!ProgressiveGames.Any())
    {
        <div class="glass-card p-5 text-center shadow-sm">
            <div class="text-muted opacity-25 mb-3"><i class="bi bi-rocket-takeoff-fill display-1"></i></div>
            <h4 class="fw-black text-muted">No Progressive Games Configured</h4>
            <p class="text-muted mb-4">Enable "Progressive" on a game in Bingo Setup to see it here.</p>
            <a href="/admin/bingo/setup" class="btn btn-outline-primary rounded-pill px-4 fw-bold">GO TO BINGO SETUP</a>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var game in ProgressiveGames)
            {
                <div class="col-md-6 col-lg-4 col-xl-3">
                    <div class="glass-card h-100 shadow-sm border-top border-4" style="border-top-color: @(game.Sheet?.DisplayColor ?? "#3b82f6") !important;">
                        <div class="p-4">
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <div>
                                    <h6 class="extra-small fw-black text-muted text-uppercase mb-0">@game.Sheet?.ColorName</h6>
                                    <h4 class="fw-black text-dark text-uppercase mb-0">@game.GameName</h4>
                                </div>
                                <div class="badge bg-primary-subtle text-primary border border-primary border-opacity-10 px-2 py-1 rounded-pill extra-small">
                                    PROGRESSIVE
                                </div>
                            </div>

                            <div class="mt-4 text-center py-3 bg-light rounded-4 border">
                                <label class="extra-small fw-black text-muted text-uppercase d-block mb-1">Current Ball Goal</label>
                                <div class="display-3 fw-black text-primary">@game.CurrentProgressiveBallGoal</div>
                                <div class="extra-small fw-bold text-muted italic">Win at or under this number</div>
                            </div>

                            <div class="row g-2 mt-3">
                                <div class="col-6">
                                    <div class="p-2 border rounded-3 bg-white text-center">
                                        <label class="extra-small fw-black text-muted d-block mb-0">JACKPOT</label>
                                        <span class="fw-black text-success">@game.ProgressiveJackpotAmount.ToString("C0")</span>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="p-2 border rounded-3 bg-white text-center">
                                        <label class="extra-small fw-black text-muted d-block mb-0">CONSOL.</label>
                                        <span class="fw-black text-danger">@game.ProgressiveConsolationAmount.ToString("C0")</span>
                                    </div>
                                </div>
                            </div>

                            <div class="mt-4 border-top pt-3">
                                <button class="btn btn-sm btn-outline-dark w-100 rounded-pill fw-bold" @onclick="() => OpenOverrideModal(game)">
                                    <i class="bi bi-pencil-square me-2"></i> MANUAL OVERRIDE
                                </button>
                                <div class="mt-2 text-center">
                                    <span class="extra-small text-muted italic">
                                        Last Updated: @(game.DateLastProgressed?.ToShortDateString() ?? "Never")
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@if (ShowOverrideModal && EditingGame != null)
{
    <div class="modal fade show d-block" style="background: rgba(0,0,0,0.5); z-index: 1060;">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg" style="border-radius: 24px;">
                <div class="modal-header border-0 p-4">
                    <h5 class="modal-title fw-black text-uppercase">OVERRIDE BALL COUNT</h5>
                    <button type="button" class="btn-close" @onclick="() => ShowOverrideModal = false"></button>
                </div>
                <div class="modal-body p-4 pt-0">
                    <div class="text-center mb-4">
                        <div class="badge bg-primary rounded-pill px-3 py-1 mb-2">@EditingGame.Sheet?.ColorName: @EditingGame.GameName</div>
                        <p class="text-muted small">Manually adjust the current progression goal. Use this to correct errors or reset games manually.</p>
                    </div>

                    <div class="p-4 bg-light rounded-4 border text-center">
                        <label class="form-label fw-black text-muted text-uppercase mb-2">Adjusted Ball Goal</label>
                        <div class="d-flex align-items-center justify-content-center gap-3">
                            <button class="btn btn-dark rounded-circle" style="width: 45px; height: 45px;" @onclick="() => EditingGame.CurrentProgressiveBallGoal--">
                                <i class="bi bi-dash-lg"></i>
                            </button>
                            <input type="number" class="form-control form-control-lg fw-black text-center border-0 bg-transparent" 
                                   style="width: 100px; font-size: 2.5rem;" @bind="EditingGame.CurrentProgressiveBallGoal" />
                            <button class="btn btn-dark rounded-circle" style="width: 45px; height: 45px;" @onclick="() => EditingGame.CurrentProgressiveBallGoal++">
                                <i class="bi bi-plus-lg"></i>
                            </button>
                        </div>
                    </div>

                    <div class="alert alert-warning mt-3 border-0 py-2" style="font-size: 0.7rem;">
                        <i class="bi bi-exclamation-triangle-fill me-1"></i>
                        Note: Changing this will affect the calculation in the next tablet session.
                    </div>
                </div>
                <div class="modal-footer border-0 p-4">
                    <button class="btn btn-light rounded-pill px-4" @onclick="() => ShowOverrideModal = false">CANCEL</button>
                    <button class="btn btn-primary rounded-pill px-4 fw-bold" @onclick="SaveOverride">SAVE OVERRIDE</button>
                </div>
            </div>
        </div>
    </div>
}

<style>
    .extra-small { font-size: 0.65rem; }
    .glass-card {
        background: rgba(255, 255, 255, 0.7);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.2);
        border-radius: 16px;
        transition: transform 0.2s;
    }
    .glass-card:hover { transform: translateY(-5px); }
</style>

@code {
    private bool Loading { get; set; } = true;
    private List<BingoGameDefinition> ProgressiveGames { get; set; } = new();
    
    private bool ShowOverrideModal { get; set; }
    private BingoGameDefinition? EditingGame { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        Loading = true;
        ProgressiveGames = await DbContext.BingoGameDefinitions
            .Include(g => g.Sheet)
            .Where(g => g.IsProgressive && g.IsActive && !g.IsDeleted)
            .OrderBy(g => g.Sheet.DisplayOrder)
            .ThenBy(g => g.DisplayOrder)
            .ToListAsync();
        Loading = false;
    }

    private void OpenOverrideModal(BingoGameDefinition game)
    {
        EditingGame = new BingoGameDefinition
        {
            Id = game.Id,
            GameName = game.GameName,
            Sheet = game.Sheet,
            CurrentProgressiveBallGoal = game.CurrentProgressiveBallGoal,
            ProgressiveJackpotAmount = game.ProgressiveJackpotAmount,
            ProgressiveConsolationAmount = game.ProgressiveConsolationAmount
        };
        ShowOverrideModal = true;
    }

    private async Task SaveOverride()
    {
        if (EditingGame == null) return;

        var target = await DbContext.BingoGameDefinitions.FindAsync(EditingGame.Id);
        if (target != null)
        {
            target.CurrentProgressiveBallGoal = EditingGame.CurrentProgressiveBallGoal;
            target.DateLastProgressed = DateTime.UtcNow; // Mark as updated manually
            await DbContext.SaveChangesAsync();
            await JSRuntime.InvokeVoidAsync("alert", "Ball count overridden successfully!");
            ShowOverrideModal = false;
            await LoadData();
        }
    }
}
