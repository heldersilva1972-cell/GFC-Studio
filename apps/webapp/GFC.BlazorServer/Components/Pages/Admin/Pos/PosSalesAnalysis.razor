@page "/admin/pos-analysis"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using GFC.Core.Interfaces
@using GFC.BlazorServer.Data
@using GFC.BlazorServer.Data.Entities
@using GFC.Core.Models
@using global::System.Text.Json
@inject IDbContextFactory<GfcDbContext> DbFactory
@inject NavigationManager Navigation
@inject ILiquorService LiquorService
@inject ISystemSettingsService SettingsService
@inject IJSRuntime JSRuntime
@attribute [Authorize]

<PageTitle>Sales Intelligence</PageTitle>

<div class="analysis-page-wrapper">
    <!-- STICKY TOP SECTION -->
    <div class="sticky-top-section bg-light p-4 shadow-sm border-bottom">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div class="d-flex align-items-center">
                <button class="btn btn-light rounded-circle me-3 shadow-sm border" @onclick="GoBack" title="Go Back">
                    <i class="bi bi-chevron-left fs-5"></i>
                </button>
                <div>
                    <h2 class="fw-black mb-1 text-primary">SALES INTELLIGENCE</h2>
                    <p class="text-muted small mb-0">Deep dive into product performance and revenue trends</p>
                </div>
            </div>
            <div class="d-flex gap-2 align-items-center">
                <div class="quick-filters d-flex gap-1 me-2 bg-white p-1 rounded-pill border shadow-sm">
                    <button class="btn btn-sm rounded-pill fw-black px-3 @(ActivePreset == "Today" ? "btn-primary" : "btn-light")" @onclick='() => SetPreset("Today")'>TODAY</button>
                    <button class="btn btn-sm rounded-pill fw-black px-3 @(ActivePreset == "CurrentWeek" ? "btn-primary" : "btn-light")" @onclick='() => SetPreset("CurrentWeek")'>THIS WEEK</button>
                    <button class="btn btn-sm rounded-pill fw-black px-3 @(ActivePreset == "PrevWeek" ? "btn-primary" : "btn-light")" @onclick='() => SetPreset("PrevWeek")'>PREV WEEK</button>
                    <button class="btn btn-sm rounded-pill fw-black px-3 @(ActivePreset == "MonthMode" ? "btn-primary" : "btn-light")" @onclick='() => SetPreset("MonthMode")'>MONTH</button>
                    <button class="btn btn-sm rounded-pill fw-black px-3 @(ActivePreset == "YearMode" ? "btn-primary" : "btn-light")" @onclick='() => SetPreset("YearMode")'>YEAR</button>
                </div>

                @if (ActivePreset == "MonthMode" || ActivePreset == "YearMode")
                {
                    <div class="historical-filters d-flex gap-2 align-items-center bg-white p-1 rounded-pill border shadow-sm px-3 animate-slide-in">
                        @if (ActivePreset == "MonthMode")
                        {
                            <select class="form-select form-select-sm border-0 fw-bold" style="width: 130px;" @onchange="OnMonthChanged">
                                @for (int i = 1; i <= 12; i++)
                                {
                                    <option value="@i" selected="@(i == SelectedMonth)">@GetMonthName(i)</option>
                                }
                            </select>
                        }
                        <select class="form-select form-select-sm border-0 fw-bold" style="width: 100px;" @onchange="OnYearChanged">
                            @for (int year = DateTime.Today.Year; year >= 2024; year--)
                            {
                                <option value="@year" selected="@(year == SelectedYear)">@year</option>
                            }
                        </select>
                    </div>
                }

                <div class="date-selector bg-white rounded-pill px-3 py-1 d-flex align-items-center border shadow-sm">
                    <i class="bi bi-calendar-range me-2 text-primary"></i>
                    <input type="date" class="border-0 bg-transparent fw-bold small" @bind="StartDate" @bind:after="LoadAnalytics">
                    <span class="mx-2 text-muted">to</span>
                    <input type="date" class="border-0 bg-transparent fw-bold small" @bind="EndDate" @bind:after="LoadAnalytics">
                </div>
                <button class="btn btn-primary rounded-pill fw-bold shadow-sm" @onclick="LoadAnalytics">
                    <i class="bi bi-arrow-clockwise me-2"></i>RECALCULATE
                </button>
                <button class="btn btn-outline-dark rounded-pill fw-bold shadow-sm ms-2" @onclick="PrepareInventoryPrint">
                    <i class="bi bi-printer-fill me-2"></i>PRINT INVENTORY
                </button>
            </div>
        </div>

        @if (!IsLoading)
        {
            <!-- Key Metrics Ribbon -->
            <div class="row g-3">
                <div class="col-md-3">
                    <div class="stat-box">
                        <div class="icon bg-primary-light"><i class="bi bi-currency-dollar"></i></div>
                        <div class="content">
                            <div class="label">TOTAL REVENUE</div>
                            <div class="value">@TotalRevenue.ToString("C0")</div>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="stat-box">
                        <div class="icon bg-success-light"><i class="bi bi-cart-check"></i></div>
                        <div class="content">
                            <div class="label">TOTAL SALES</div>
                            <div class="value">@TotalTransactions</div>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="stat-box">
                        <div class="icon bg-warning-light"><i class="bi bi-receipt"></i></div>
                        <div class="content">
                            <div class="label">AVG SALE VALUE</div>
                            <div class="value">@AvgSaleValue.ToString("C2")</div>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="stat-box">
                        <div class="icon bg-info-light"><i class="bi bi-lightning-charge"></i></div>
                        <div class="content">
                            <div class="label">TOP STATION</div>
                            <div class="value text-uppercase">@MostActiveTerminal</div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- MAIN SCROLLABLE DASHBOARD -->
    <div class="analysis-content p-4 overflow-auto">
        @if (IsLoading)
        {
            <div class="text-center p-5">
                <div class="spinner-border text-primary" role="status"></div>
                <p class="mt-3 text-muted fw-bold">Analyzing your bar data...</p>
            </div>
        }
        else
        {
            <div class="row g-4">
                <!-- PRODUCT PERFORMANCE TABLE -->
                <div class="col-md-7">
                    <div class="chart-card">
                        <div class="header d-flex justify-content-between align-items-center">
                            <div>
                                <h5 class="fw-black mb-0">PRODUCT PERFORMANCE RANKING</h5>
                                <p class="small text-muted mb-0">Gross sales by item</p>
                            </div>
                            <span class="badge bg-primary rounded-pill">TOP 15</span>
                        </div>
                        <div class="body p-0">
                            <div class="table-responsive" style="max-height: 520px; overflow-y: auto;">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="bg-light sticky-top" style="z-index: 2;">
                                        <tr>
                                            <th class="ps-4">PRODUCT / BRAND</th>
                                            <th class="text-center">VOLUME SOLD</th>
                                            <th class="text-end">REVENUE</th>
                                            <th class="text-end pe-4">MARKET SHARE</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in ProductStats.OrderByDescending(x => x.Value.Revenue).Take(15))
                                        {
                                            var share = TotalRevenue > 0 ? (double)item.Value.Revenue / (double)TotalRevenue * 100 : 0;
                                            <tr>
                                                <td class="ps-4">
                                                    <div class="fw-black text-primary">@item.Key</div>
                                                    <div class="extra-small text-muted text-uppercase tracking-tighter">Usage Leader</div>
                                                </td>
                                                <td class="text-center">
                                                    <div class="d-flex flex-column align-items-center gap-1 py-1">
                                                        <div class="d-flex align-items-baseline gap-1">
                                                            <span class="fw-black fs-4 text-dark lh-1">@item.Value.Quantity</span>
                                                            <span class="extra-small fw-black text-primary text-uppercase tracking-wider">
                                                                @(item.Value.IsLiquor ? "SHOTS" : "UNITS")
                                                            </span>
                                                        </div>
                                                        @if (item.Value.PackSize > 1)
                                                        {
                                                            var cases = item.Value.Quantity / item.Value.PackSize;
                                                            var bottles = item.Value.Quantity % item.Value.PackSize;
                                                            var casesLabel = cases == 1 ? "Case" : "Cases";
                                                            var bottlesLabel = bottles == 1 ? "Bottle" : "Bottles";
                                                            string caseText = cases > 0 && bottles > 0 
                                                                ? $"{cases} {casesLabel}, {bottles} {bottlesLabel}" 
                                                                : (cases > 0 ? $"{cases} {casesLabel}" : $"{bottles} {bottlesLabel}");

                                                            <div class="badge rounded-pill bg-success-light text-success border border-success-subtle fw-black px-2 py-1 d-inline-flex align-items-center gap-1" style="font-size: 0.75rem; letter-spacing: 0.2px;">
                                                                <i class="bi bi-box-seam-fill"></i>
                                                                <span>@caseText</span>
                                                            </div>
                                                        }
                                                        else if (item.Value.IsLiquor)
                                                        {
                                                            var btlUsed = Math.Round(item.Value.LiquorBottlesUsed, 1);
                                                            <div class="badge rounded-pill fw-black px-2 py-1 d-inline-flex align-items-center gap-1" style="font-size: 0.75rem; letter-spacing: 0.2px; background: #f3e8ff; color: #7e22ce; border: 1px solid #e9d5ff !important;" title="@item.Value.Quantity shots @item.Value.PourSizeOz.ToString("0.#") oz each (@item.Value.TotalOuncesPoured.ToString("0.#") oz total) based on Global Shot Size">
                                                                <i class="bi bi-cup-straw"></i>
                                                                <span>@btlUsed Bottles Used (@item.Value.PourSizeOz.ToString("0.#")oz shot)</span>
                                                            </div>
                                                        }
                                                        else
                                                        {
                                                            <div class="badge rounded-pill bg-light text-secondary border fw-bold px-2 py-1" style="font-size: 0.7rem; letter-spacing: 0.2px;">
                                                                SINGLE ITEM
                                                            </div>
                                                        }
                                                    </div>
                                                </td>
                                                <td class="text-end fw-black text-dark">@item.Value.Revenue.ToString("C0")</td>
                                                <td class="text-end pe-4">
                                                    <div class="d-flex align-items-center justify-content-end gap-3">
                                                        <div class="progress rounded-pill flex-grow-1" style="height: 12px; width: 80px; background: #f1f5f9;">
                                                            <div class="progress-bar bg-primary animate-grow" style="width: @(share)%"></div>
                                                        </div>
                                                        <span class="fw-black text-primary" style="min-width: 45px;">@share.ToString("0.0")%</span>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- CATEGORY & STATION INSIGHTS -->
                <div class="col-md-5">
                    <div class="chart-card mb-4" style="height: auto;">
                        <div class="header">
                            <h5 class="fw-black mb-0">CATEGORY SALES</h5>
                            <p class="small text-muted mb-0">Revenue distribution by group</p>
                        </div>
                        <div class="body">
                            @foreach (var cat in CategoryRevenue.OrderByDescending(x => x.Value))
                            {
                                var catPct = TotalRevenue > 0 ? (double)cat.Value / (double)TotalRevenue * 100 : 0;
                                <div class="category-stat-row mb-3">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <span class="fw-black small" style="color: @GetCategoryColor(cat.Key)">@cat.Key</span>
                                        <span class="fw-black small">@cat.Value.ToString("C0")</span>
                                    </div>
                                    <div class="progress rounded-pill" style="height: 10px; background: #f1f5f9;">
                                        <div class="progress-bar" style="width: @(catPct)%; background: @GetCategoryColor(cat.Key)"></div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
 
                    <div class="chart-card" style="height: auto;">
                        <div class="header">
                            <h5 class="fw-black mb-0">STATION REVENUE SHARE</h5>
                            <p class="small text-muted mb-0">Compare bar terminal activity</p>
                        </div>
                        <div class="body">
                            @foreach (var terminal in TerminalRevenue.OrderByDescending(x => x.Value))
                            {
                                var pct = TotalRevenue > 0 ? (double)terminal.Value / (double)TotalRevenue * 100 : 0;
                                <div class="d-flex justify-content-between mb-1 small fw-bold mt-2">
                                    <span>@terminal.Key</span>
                                    <span>@terminal.Value.ToString("C2") (@pct.ToString("0")%)</span>
                                </div>
                                <div class="progress rounded-pill mb-3" style="height: 8px;">
                                    <div class="progress-bar" style="width: @(pct)%; background: @GetTerminalColor(terminal.Key)"></div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@if (_showPrintPreview)
{
    <div class="modal-overlay" @onclick="() => _showPrintPreview = false" style="background: rgba(15, 23, 42, 0.9);">
        <div class="print-preview-card shadow-2xl animate-pop-in" @onclick:stopPropagation>
            <div class="preview-header p-3 bg-white border-bottom d-flex justify-content-between align-items-center">
                <h6 class="fw-black mb-0"><i class="bi bi-eye me-2"></i>PRINT PREVIEW (RECEIPT)</h6>
                <button class="btn-close" @onclick="() => _showPrintPreview = false"></button>
            </div>
            
            <div class="preview-body p-4 bg-secondary bg-opacity-10 d-flex justify-content-center">
                <!-- VIRTUAL RECEIPT -->
                <div id="receipt-strip" class="receipt-strip shadow-sm">
                    <div class="receipt-header text-center">
                        <div class="fw-black fs-4">GFC CLUB</div>
                        <div class="fw-bold extra-small text-uppercase">Current Inventory Status</div>
                        <div class="extra-small">@DateTime.Now.ToString("MMM dd, yyyy @ h:mm tt")</div>
                        <div class="border-top border-dark border-1 my-2"></div>
                    </div>

                    <div class="receipt-content">
                        @if (_inventoryItems != null)
                        {
                            @foreach (var group in _inventoryItems.Where(i => i.IsActive).GroupBy(i => i.IsBeer ? "BEER" : "LIQUOR"))
                            {
                                <div class="fw-black text-center text-uppercase border-bottom border-dark mb-2 mt-3" style="font-size: 0.75rem;">--- @group.Key ---</div>
                                @foreach (var item in group.OrderBy(i => i.Name))
                                {
                                    <div class="d-flex justify-content-between align-items-start mb-1" style="font-size: 0.8rem; line-height: 1.1;">
                                        <div class="fw-bold pe-2">
                                            @item.Name.ToUpper()
                                            @if (item.CurrentStock <= item.MinStockLimit)
                                            {
                                                <span class="ms-1 fw-black">[!!]</span>
                                            }
                                        </div>
                                        <div class="text-end fw-black" style="white-space: nowrap;">
                                            @if (item.PackSize > 1)
                                            {
                                                <span>@(item.CurrentStock / item.PackSize)cs @(item.CurrentStock % item.PackSize)btl</span>
                                            }
                                            else
                                            {
                                                <span>@item.CurrentStock units</span>
                                            }
                                        </div>
                                    </div>
                                }
                            }
                        }
                    </div>

                    <div class="receipt-footer text-center mt-4 pt-2 border-top border-dark border-1 border-dotted">
                        <div class="extra-small fw-bold">END OF REPORT</div>
                        <div class="extra-small text-muted">Generated by GFC Intelligence</div>
                    </div>
                </div>
            </div>

            <div class="preview-footer p-3 bg-white border-top d-grid gap-2">
                <button class="btn btn-primary btn-lg fw-black rounded-pill shadow" @onclick="ExecutePrint">
                    <i class="bi bi-printer me-2"></i>CONFIRM & PRINT
                </button>
                <button class="btn btn-light rounded-pill fw-bold" @onclick="() => _showPrintPreview = false">CANCEL</button>
            </div>
        </div>
    </div>
}

<style>
    .analysis-page-wrapper { 
        height: 100vh; display: flex; flex-direction: column; overflow: hidden; background: #f8fafc;
    }
    
    .sticky-top-section { flex: 0 0 auto; z-index: 10; background: white !important; }
    .analysis-content { flex: 1; min-height: 0; }

    .fw-black { font-weight: 900; }
    .text-primary { color: #0d6efd; }
    .btn-primary { transition: all 0.2s; }

    .stat-box { background: white; padding: 1.25rem; border-radius: 16px; border: 1.5px solid #e2e8f0; display: flex; align-items: center; gap: 1rem; }
    .stat-box .icon { width: 44px; height: 44px; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 1.25rem; }
    .stat-box .label { font-size: 0.65rem; font-weight: 900; color: #64748b; letter-spacing: 0.5px; }
    .stat-box .value { font-size: 1.15rem; font-weight: 900; color: #1e293b; }

    .bg-primary-light { background: #eff6ff; color: #2563eb; }
    .bg-success-light { background: #f0fdf4; color: #16a34a; }
    .bg-warning-light { background: #fffbeb; color: #d97706; }
    .bg-info-light { background: #ecfeff; color: #0891b2; }

    .chart-card { background: white; border-radius: 20px; border: 1.5px solid #e2e8f0; height: 100%; display: flex; flex-direction: column; overflow: hidden; }
    .chart-card .header { padding: 1.25rem; border-bottom: 1.5px solid #f1f5f9; background: white; }
    .chart-card .body { padding: 1.25rem; flex: 1; }
    
    .table th { font-size: 0.7rem; font-weight: 950; text-transform: uppercase; color: #64748b; letter-spacing: 1px; border-bottom: 2px solid #e2e8f0; }
    .table td { border-bottom: 1px solid #f1f5f9; padding: 1rem 0.5rem; }

    .animate-grow { animation: growWidth 0.8s ease-out forwards; transform-origin: left; }
    @@keyframes growWidth { from { transform: scaleX(0); } to { transform: scaleX(1); } }

    .extra-small { font-size: 0.6rem; }
    .tracking-tighter { letter-spacing: -0.5px; }

    .animate-slide-in { animation: slideIn 0.2s ease-out forwards; }
    @@keyframes slideIn { from { opacity: 0; transform: translateX(-10px); } to { opacity: 1; transform: translateX(0); } }

    /* PRINT PREVIEW STYLES */
    .print-preview-card { background: #f1f5f9; width: 450px; border-radius: 24px; overflow: hidden; display: flex; flex-direction: column; max-height: 90vh; }
    .preview-body { overflow-y: auto; flex-grow: 1; }
    
    .receipt-strip { 
        background: white; 
        width: 300px; 
        padding: 30px 20px; 
        color: black; 
        font-family: 'Courier New', Courier, monospace; 
        min-height: 400px;
    }

    .modal-overlay { position: fixed; top: 0; left: 0; right: 0; bottom: 0; z-index: 2000; display: flex; align-items: center; justify-content: center; }
    .animate-pop-in { animation: popIn 0.3s cubic-bezier(0.34, 1.56, 0.64, 1) forwards; }
    @@keyframes popIn { from { opacity: 0; transform: scale(0.9); } to { opacity: 1; transform: scale(1); } }

    @@media print {
        body * { visibility: hidden; }
        #receipt-strip, #receipt-strip * { visibility: visible; }
        #receipt-strip { position: absolute; left: 0; top: 0; width: 80mm; padding: 0; margin: 0; box-shadow: none; }
    }
</style>

@code {
    private DateTime StartDate = DateTime.Today;
    private DateTime EndDate = DateTime.Today;
    private bool IsLoading = true;
    private string ActivePreset = "Today";
    
    private int SelectedMonth = DateTime.Today.Month;
    private int SelectedYear = DateTime.Today.Year;

    private decimal TotalRevenue;
    private int TotalTransactions;
    private decimal AvgSaleValue;
    private string MostActiveTerminal = "N/A";

    private bool _showPrintPreview = false;
    private List<LiquorItem>? _inventoryItems;
    
    private Dictionary<string, ProductMetric> ProductStats = new();
    private Dictionary<string, decimal> CategoryRevenue = new();
    private Dictionary<string, decimal> TerminalRevenue = new();

    public class ProductMetric {
        public int Quantity { get; set; }
        public decimal Revenue { get; set; }
        public int PackSize { get; set; } = 1;
        public double CasesSold => PackSize > 1 ? (double)Quantity / PackSize : 0;

        public bool IsLiquor { get; set; } = false;
        public decimal PourSizeOz { get; set; } = 1.5m;
        public decimal BottleVolumeOz { get; set; } = 25.36m;
        public double TotalOuncesPoured => (double)(Quantity * PourSizeOz);
        public double LiquorBottlesUsed => BottleVolumeOz > 0 ? TotalOuncesPoured / (double)BottleVolumeOz : 0;
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/");
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadAnalytics();
    }

    private async Task OnMonthChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int m))
        {
            SelectedMonth = m;
            ActivePreset = "MonthMode";
            UpdateRangeFromMonthYear();
            await LoadAnalytics();
        }
    }

    private async Task OnYearChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int y))
        {
            SelectedYear = y;
            if (ActivePreset != "MonthMode" && ActivePreset != "YearMode")
            {
                ActivePreset = "MonthMode";
            }
            UpdateRangeFromMonthYear();
            await LoadAnalytics();
        }
    }

    private void UpdateRangeFromMonthYear()
    {
        if (ActivePreset == "YearMode")
        {
            StartDate = new DateTime(SelectedYear, 1, 1);
            EndDate = new DateTime(SelectedYear, 12, 31);
        }
        else
        {
            StartDate = new DateTime(SelectedYear, SelectedMonth, 1);
            EndDate = StartDate.AddMonths(1).AddDays(-1);
        }
        
        // Don't let end date be in the future
        if (EndDate > DateTime.Today) EndDate = DateTime.Today;
    }

    private void SetPreset(string preset)
    {
        ActivePreset = preset;
        var today = DateTime.Today;

        switch (preset)
        {
            case "Today":
                StartDate = today;
                EndDate = today;
                break;
            case "CurrentWeek":
                int diff = (7 + (today.DayOfWeek - DayOfWeek.Monday)) % 7;
                StartDate = today.AddDays(-1 * diff);
                EndDate = today;
                break;
            case "PrevWeek":
                int pDiff = (7 + (today.DayOfWeek - DayOfWeek.Monday)) % 7;
                StartDate = today.AddDays(-1 * pDiff).AddDays(-7);
                EndDate = today.AddDays(-1 * pDiff).AddDays(-1);
                break;
            case "MonthMode":
                // Trigger month logic
                UpdateRangeFromMonthYear();
                break;
            case "YearMode":
                // Set to full year
                StartDate = new DateTime(SelectedYear, 1, 1);
                EndDate = new DateTime(SelectedYear, 12, 31);
                if (EndDate > today) EndDate = today;
                break;
        }

        _ = LoadAnalytics();
    }

    private string CleanProductName(string rawName)
    {
        if (string.IsNullOrEmpty(rawName)) return "";
        var name = rawName.Trim();
        if (name.StartsWith("> ")) name = name.Substring(2).Trim();
        int parenIndex = name.IndexOf('(');
        if (parenIndex != -1)
        {
            name = name.Substring(0, parenIndex).Trim();
        }
        return name;
    }

    private async Task LoadAnalytics()
    {
        IsLoading = true;
        StateHasChanged();

        using var db = DbFactory.CreateDbContext();
        
        var st = StartDate.Date.AddHours(3);
        var en = EndDate.Date.AddDays(1).AddHours(3);
        
        var sales = await db.PosSales
            .Where(s => s.Timestamp >= st && s.Timestamp < en)
            .ToListAsync();

        var sysSettings = await SettingsService.GetAsync();
        decimal globalShotSize = sysSettings?.GlobalLiquorPourSize > 0 ? sysSettings.GlobalLiquorPourSize : 1.5m;

        var inventoryItems = await db.LiquorItems.AsNoTracking().ToListAsync();
        var itemMetaMap = new Dictionary<string, LiquorItem>(StringComparer.OrdinalIgnoreCase);
        foreach (var liq in inventoryItems)
        {
            var cleanLiqName = CleanProductName(liq.Name);
            if (!string.IsNullOrEmpty(cleanLiqName))
            {
                itemMetaMap[cleanLiqName] = liq;
            }
        }

        ProductStats = new();
        CategoryRevenue = new();
        TerminalRevenue = new();
        
        int validSalesCount = 0;
        decimal calculatedRevenue = 0;

        foreach (var sale in sales)
        {
            var items = DeserializeItems(sale.ItemsJson);
            bool hasValidItem = false;

            foreach (var item in items)
            {
                var cleanName = CleanProductName(item.Name);
                if (string.IsNullOrEmpty(cleanName)) continue;

                // Filter out non-item entries like deposits, corrections, credits, payouts
                if (cleanName.Contains("DEPOSIT", StringComparison.OrdinalIgnoreCase) ||
                    cleanName.Contains("CORRECTION", StringComparison.OrdinalIgnoreCase) ||
                    cleanName.Contains("NO SALE", StringComparison.OrdinalIgnoreCase) ||
                    cleanName.Contains("CREDIT", StringComparison.OrdinalIgnoreCase) ||
                    cleanName.Contains("PAYOUT", StringComparison.OrdinalIgnoreCase))
                {
                    continue;
                }

                var catName = string.IsNullOrEmpty(item.Category) ? "UNCATEGORIZED" : item.Category.ToUpper();
                if (catName == "TOKEN_CREDIT" || catName == "PAYOUT" || catName == "PAYOUTS" || catName == "DEPOSIT" || catName == "DEPOSITS")
                {
                    continue;
                }

                hasValidItem = true;

                // Aggregate Product Stats
                if (!ProductStats.ContainsKey(cleanName))
                {
                    int packSize = 1;
                    bool isLiquor = catName == "LIQUOR";
                    decimal pourSize = globalShotSize; // Strictly use Global Shot Size (oz) from Liquor Hub configuration
                    decimal bottleVol = 25.36m;

                    if (itemMetaMap.TryGetValue(cleanName, out var liq))
                    {
                        if (liq.PackSize > 1) packSize = liq.PackSize;
                        if (!liq.IsBeer && (string.Equals(liq.Category, "LIQUOR", StringComparison.OrdinalIgnoreCase) || !liq.IsUnitBased))
                        {
                            isLiquor = true;
                        }

                        if (liq.BottleVolumeOunces.HasValue && liq.BottleVolumeOunces.Value > 0)
                        {
                            bottleVol = liq.BottleVolumeOunces.Value;
                        }
                    }

                    ProductStats[cleanName] = new ProductMetric {
                        PackSize = packSize,
                        IsLiquor = isLiquor,
                        PourSizeOz = pourSize,
                        BottleVolumeOz = bottleVol
                    };
                }
                
                ProductStats[cleanName].Quantity += item.Quantity;
                ProductStats[cleanName].Revenue += (item.Price * item.Quantity);
                calculatedRevenue += (item.Price * item.Quantity);

                // Aggregate Category Stats
                if (!CategoryRevenue.ContainsKey(catName)) CategoryRevenue[catName] = 0;
                CategoryRevenue[catName] += (item.Price * item.Quantity);

                // Aggregate Terminal Stats
                if (!TerminalRevenue.ContainsKey(sale.TerminalName))
                    TerminalRevenue[sale.TerminalName] = 0;
                TerminalRevenue[sale.TerminalName] += (item.Price * item.Quantity);
            }

            if (hasValidItem)
            {
                validSalesCount++;
            }
        }

        TotalTransactions = validSalesCount;
        TotalRevenue = calculatedRevenue;
        AvgSaleValue = TotalTransactions > 0 ? TotalRevenue / TotalTransactions : 0;

        MostActiveTerminal = sales
            .Where(s => DeserializeItems(s.ItemsJson).Any(item => {
                var cleanName = CleanProductName(item.Name);
                if (string.IsNullOrEmpty(cleanName)) return false;
                if (cleanName.Contains("DEPOSIT", StringComparison.OrdinalIgnoreCase) ||
                    cleanName.Contains("CORRECTION", StringComparison.OrdinalIgnoreCase) ||
                    cleanName.Contains("NO SALE", StringComparison.OrdinalIgnoreCase) ||
                    cleanName.Contains("CREDIT", StringComparison.OrdinalIgnoreCase) ||
                    cleanName.Contains("PAYOUT", StringComparison.OrdinalIgnoreCase)) return false;
                var catName = string.IsNullOrEmpty(item.Category) ? "UNCATEGORIZED" : item.Category.ToUpper();
                if (catName == "TOKEN_CREDIT" || catName == "PAYOUT" || catName == "PAYOUTS" || catName == "DEPOSIT" || catName == "DEPOSITS") return false;
                return true;
            }))
            .GroupBy(s => s.TerminalName)
            .OrderByDescending(g => g.Count())
            .Select(g => g.Key)
            .FirstOrDefault() ?? "N/A";

        IsLoading = false;
        StateHasChanged();
    }

    private List<PosTerminal.ProductItem> DeserializeItems(string json)
    {
        try { return JsonSerializer.Deserialize<List<PosTerminal.ProductItem>>(json) ?? new(); }
        catch { return new(); }
    }

    private string GetMonthName(int m)
    {
        return m switch
        {
            1 => "JANUARY", 2 => "FEBRUARY", 3 => "MARCH", 4 => "APRIL",
            5 => "MAY", 6 => "JUNE", 7 => "JULY", 8 => "AUGUST",
            9 => "SEPTEMBER", 10 => "OCTOBER", 11 => "NOVEMBER", 12 => "DECEMBER",
            _ => ""
        };
    }

    private string GetTerminalColor(string name)
    {
        if (name.Contains("Patio")) return "#0ea5e9";
        if (name.Contains("Main")) return "#6366f1";
        if (name.Contains("Downstairs")) return "#8b5cf6";
        return "#64748b";
    }

    private string GetCategoryColor(string category)
    {
        return category switch
        {
            "BEER" => "#16a34a",
            "LIQUOR" => "#9333ea",
            "TOKENS" => "#d97706",
            "FOOD" => "#dc2626",
            "MIXED DRINKS" => "#0891b2",
            _ => "#64748b"
        };
    }

    private async Task PrepareInventoryPrint()
    {
        _inventoryItems = (await LiquorService.GetAllItemsAsync()).ToList();
        _showPrintPreview = true;
    }

    private async Task ExecutePrint()
    {
        await JSRuntime.InvokeVoidAsync("window.print");
    }
}
