@page "/admin/pos-analysis"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using GFC.Core.Interfaces
@using GFC.BlazorServer.Data
@using GFC.BlazorServer.Data.Entities
@using GFC.Core.Models
@using global::System.Text.Json
@inject IDbContextFactory<GfcDbContext> DbFactory
@inject NavigationManager Navigation
@inject ILiquorService LiquorService
@inject ISystemSettingsService SettingsService
@inject IJSRuntime JSRuntime
@attribute [Authorize]

<PageTitle>Sales Intelligence</PageTitle>

<div class="analysis-page-wrapper">
    <!-- STICKY TOP SECTION -->
    <div class="sticky-top-section bg-light p-4 shadow-sm border-bottom">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div class="d-flex align-items-center">
                <button class="btn btn-light rounded-circle me-3 shadow-sm border" @onclick="GoBack" title="Go Back">
                    <i class="bi bi-chevron-left fs-5"></i>
                </button>
                <div>
                    <h2 class="fw-black mb-1 text-primary">SALES INTELLIGENCE</h2>
                    <p class="text-muted small mb-0">Deep dive into product performance and revenue trends</p>
                </div>
            </div>
            <div class="d-flex gap-2 align-items-center">
                <div class="quick-filters d-flex gap-1 me-2 bg-white p-1 rounded-pill border shadow-sm">
                    <button class="btn btn-sm rounded-pill fw-black px-3 @(ActivePreset == "Today" ? "btn-primary" : "btn-light")" @onclick='() => SetPreset("Today")'>TODAY</button>
                    <button class="btn btn-sm rounded-pill fw-black px-3 @(ActivePreset == "CurrentWeek" ? "btn-primary" : "btn-light")" @onclick='() => SetPreset("CurrentWeek")'>THIS WEEK</button>
                    <button class="btn btn-sm rounded-pill fw-black px-3 @(ActivePreset == "PrevWeek" ? "btn-primary" : "btn-light")" @onclick='() => SetPreset("PrevWeek")'>PREV WEEK</button>
                    <button class="btn btn-sm rounded-pill fw-black px-3 @(ActivePreset == "MonthMode" ? "btn-primary" : "btn-light")" @onclick='() => SetPreset("MonthMode")'>MONTH</button>
                    <button class="btn btn-sm rounded-pill fw-black px-3 @(ActivePreset == "YearMode" ? "btn-primary" : "btn-light")" @onclick='() => SetPreset("YearMode")'>YEAR</button>
                </div>

                @if (ActivePreset == "MonthMode" || ActivePreset == "YearMode")
                {
                    <div class="historical-filters d-flex gap-2 align-items-center bg-white p-1 rounded-pill border shadow-sm px-3 animate-slide-in">
                        @if (ActivePreset == "MonthMode")
                        {
                            <select class="form-select form-select-sm border-0 fw-bold" style="width: 130px;" @onchange="OnMonthChanged">
                                @for (int i = 1; i <= 12; i++)
                                {
                                    <option value="@i" selected="@(i == SelectedMonth)">@GetMonthName(i)</option>
                                }
                            </select>
                        }
                        <select class="form-select form-select-sm border-0 fw-bold" style="width: 100px;" @onchange="OnYearChanged">
                            @for (int year = DateTime.Today.Year; year >= 2024; year--)
                            {
                                <option value="@year" selected="@(year == SelectedYear)">@year</option>
                            }
                        </select>
                    </div>
                }

                <div class="date-selector bg-white rounded-pill px-3 py-1 d-flex align-items-center border shadow-sm">
                    <i class="bi bi-calendar-range me-2 text-primary"></i>
                    <input type="date" class="border-0 bg-transparent fw-bold small" @bind="StartDate" @bind:after="LoadAnalytics">
                    <span class="mx-2 text-muted">to</span>
                    <input type="date" class="border-0 bg-transparent fw-bold small" @bind="EndDate" @bind:after="LoadAnalytics">
                </div>
                <button class="btn btn-primary rounded-pill fw-bold shadow-sm" @onclick="LoadAnalytics">
                    <i class="bi bi-arrow-clockwise me-2"></i>RECALCULATE
                </button>
                <button class="btn btn-outline-dark rounded-pill fw-bold shadow-sm ms-2" @onclick="PrepareInventoryPrint">
                    <i class="bi bi-printer-fill me-2"></i>PRINT INVENTORY
                </button>
            </div>
        </div>

        @if (!IsLoading)
        {
            <!-- Key Metrics Ribbon -->
            <div class="row g-3">
                <div class="col-md-3">
                    <div class="stat-box">
                        <div class="icon bg-primary-light"><i class="bi bi-currency-dollar"></i></div>
                        <div class="content">
                            <div class="label">TOTAL REVENUE</div>
                            <div class="value">@TotalRevenue.ToString("C0")</div>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="stat-box">
                        <div class="icon bg-success-light"><i class="bi bi-cart-check"></i></div>
                        <div class="content">
                            <div class="label">TOTAL SALES</div>
                            <div class="value">@TotalTransactions</div>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="stat-box">
                        <div class="icon bg-warning-light"><i class="bi bi-receipt"></i></div>
                        <div class="content">
                            <div class="label">AVG SALE VALUE</div>
                            <div class="value">@AvgSaleValue.ToString("C2")</div>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="stat-box">
                        <div class="icon bg-info-light"><i class="bi bi-lightning-charge"></i></div>
                        <div class="content">
                            <div class="label">TOP STATION</div>
                            <div class="value text-uppercase">@MostActiveTerminal</div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- MAIN SCROLLABLE DASHBOARD -->
    <div class="analysis-content p-4 overflow-auto">
        @if (IsLoading)
        {
            <div class="text-center p-5">
                <div class="spinner-border text-primary" role="status"></div>
                <p class="mt-3 text-muted fw-bold">Analyzing your bar data...</p>
            </div>
        }
        else
        {
            <div class="row g-4">
                <!-- PRODUCT PERFORMANCE TABLE -->
                <div class="col-md-7">
                    <div class="chart-card">
                        <div class="header d-flex justify-content-between align-items-center flex-wrap gap-2">
                            <div>
                                <h5 class="fw-black mb-0">@(SelectedTableView == "Performance" ? "PRODUCT PERFORMANCE RANKING" : "SMART WEEKLY REORDER PREDICTOR")</h5>
                                <p class="small text-muted mb-0">@(SelectedTableView == "Performance" ? "Gross sales by item" : "7-Day forecasted demand & recommended reorder")</p>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <div class="btn-group btn-group-sm p-1 bg-light rounded-pill border">
                                    <button class="btn btn-sm rounded-pill fw-black px-3 @(SelectedTableView == "Performance" ? "btn-primary shadow-sm" : "btn-light border-0 text-muted")" style="font-size: 0.7rem;" @onclick='() => SelectedTableView = "Performance"'>PERFORMANCE</button>
                                    <button class="btn btn-sm rounded-pill fw-black px-3 @(SelectedTableView == "Reorder" ? "btn-primary shadow-sm" : "btn-light border-0 text-muted")" style="font-size: 0.7rem;" @onclick='() => SelectedTableView = "Reorder"'>REORDER PREDICTOR</button>
                                </div>
                            </div>
                        </div>

                        <!-- CATEGORY FILTER PILLS -->
                        <div class="px-3 py-2 bg-light border-bottom d-flex align-items-center gap-1 overflow-x-auto" style="white-space: nowrap;">
                            <span class="extra-small fw-black text-muted me-2 text-uppercase">Filter:</span>
                            <button class="btn btn-sm rounded-pill fw-black px-3 py-1 extra-small @(SelectedCategoryFilter == "ALL_BEVERAGES" ? "btn-primary shadow-sm" : "btn-white border text-secondary")" @onclick='() => SelectedCategoryFilter = "ALL_BEVERAGES"'>ALL DRINKS</button>
                            <button class="btn btn-sm rounded-pill fw-black px-3 py-1 extra-small @(SelectedCategoryFilter == "BEER" ? "btn-primary shadow-sm" : "btn-white border text-secondary")" @onclick='() => SelectedCategoryFilter = "BEER"'>BEER</button>
                            <button class="btn btn-sm rounded-pill fw-black px-3 py-1 extra-small @(SelectedCategoryFilter == "LIQUOR" ? "btn-primary shadow-sm" : "btn-white border text-secondary")" @onclick='() => SelectedCategoryFilter = "LIQUOR"'>LIQUOR</button>
                            <button class="btn btn-sm rounded-pill fw-black px-3 py-1 extra-small @(SelectedCategoryFilter == "SELTZER" ? "btn-primary shadow-sm" : "btn-white border text-secondary")" @onclick='() => SelectedCategoryFilter = "SELTZER"'>SELTZER</button>
                            <button class="btn btn-sm rounded-pill fw-black px-3 py-1 extra-small @(SelectedCategoryFilter == "WINE" ? "btn-primary shadow-sm" : "btn-white border text-secondary")" @onclick='() => SelectedCategoryFilter = "WINE"'>WINE</button>
                            <button class="btn btn-sm rounded-pill fw-black px-3 py-1 extra-small @(SelectedCategoryFilter == "FOOD" ? "btn-primary shadow-sm" : "btn-white border text-secondary")" @onclick='() => SelectedCategoryFilter = "FOOD"'>FOOD</button>
                            <button class="btn btn-sm rounded-pill fw-black px-3 py-1 extra-small @(SelectedCategoryFilter == "ALL" ? "btn-dark shadow-sm" : "btn-white border text-secondary")" @onclick='() => SelectedCategoryFilter = "ALL"'>ALL ITEMS</button>
                        </div>

                        @if (SelectedTableView == "Reorder")
                        {
                            <div class="px-3 py-2 bg-white border-bottom d-flex align-items-center justify-content-between flex-wrap gap-2">
                                <div class="d-flex align-items-center gap-2">
                                    <span class="extra-small fw-black text-muted text-uppercase me-1"><i class="bi bi-cpu-fill text-primary me-1"></i>Algorithm:</span>
                                    <button class="btn btn-sm rounded-pill fw-black px-3 py-0 extra-small @(PredictionMode == "Hybrid" ? "btn-primary shadow-sm" : "btn-light border text-muted")" @onclick='() => PredictionMode = "Hybrid"' title="Blends 60% Trailing 30D + 40% Same Month Last Year">
                                        🧠 SMART HYBRID
                                    </button>
                                    <button class="btn btn-sm rounded-pill fw-black px-3 py-0 extra-small @(PredictionMode == "Recent" ? "btn-primary shadow-sm" : "btn-light border text-muted")" @onclick='() => PredictionMode = "Recent"' title="100% Trailing 30-Day Sales Velocity">
                                        ⚡ RECENT TREND (30D)
                                    </button>
                                    <button class="btn btn-sm rounded-pill fw-black px-3 py-0 extra-small @(PredictionMode == "YoY" ? "btn-primary shadow-sm" : "btn-light border text-muted")" @onclick='() => PredictionMode = "YoY"' title="100% Same Month Last Year Sales Velocity">
                                        🗓️ SEASONAL YoY
                                    </button>
                                </div>
                                <span class="extra-small text-muted fw-bold">
                                    @(PredictionMode == "Hybrid" ? "60% 30D Momentum + 40% YoY Seasonality" : (PredictionMode == "Recent" ? "Trailing 30-Day Sales Velocity" : "Same Month Last Year Velocity"))
                                </span>
                            </div>
                        }
                        <div class="body p-0">
                            <div class="table-responsive" style="max-height: 520px; overflow-y: auto;">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="bg-light sticky-top" style="z-index: 2;">
                                        @if (SelectedTableView == "Performance")
                                        {
                                            <tr>
                                                <th class="ps-4">PRODUCT / BRAND</th>
                                                <th class="text-center">VOLUME SOLD</th>
                                                <th class="text-end">REVENUE</th>
                                                <th class="text-end pe-4">MARKET SHARE</th>
                                            </tr>
                                        }
                                        else
                                        {
                                            <tr>
                                                <th class="ps-4">PRODUCT / BRAND</th>
                                                <th class="text-center">CURRENT STOCK</th>
                                                <th class="text-center">7-DAY FORECAST</th>
                                                <th class="text-end pe-4">RECOMMENDED ORDER</th>
                                            </tr>
                                        }
                                    </thead>
                                    <tbody>
                                        @if (SelectedTableView == "Performance")
                                        {
                                            @foreach (var item in ProductStats.Where(x => x.Value.Quantity > 0 && IsItemInSelectedCategory(x.Value)).OrderByDescending(x => x.Value.Revenue))
                                            {
                                                var share = TotalRevenue > 0 ? (double)item.Value.Revenue / (double)TotalRevenue * 100 : 0;
                                                <tr>
                                                    <td class="ps-4">
                                                        <div class="fw-black text-primary">@item.Key</div>
                                                        <div class="extra-small text-muted text-uppercase tracking-tighter">Usage Leader</div>
                                                    </td>
                                                    <td class="text-center">
                                                        <div class="d-flex flex-column align-items-center gap-1 py-1">
                                                            <div class="d-flex align-items-baseline gap-1">
                                                                <span class="fw-black fs-4 text-dark lh-1">@item.Value.Quantity</span>
                                                                <span class="extra-small fw-black text-primary text-uppercase tracking-wider">
                                                                    @(item.Value.IsLiquor ? "SHOTS" : "UNITS")
                                                                </span>
                                                            </div>
                                                            @if (item.Value.PackSize > 1)
                                                            {
                                                                var cases = item.Value.Quantity / item.Value.PackSize;
                                                                var bottles = item.Value.Quantity % item.Value.PackSize;
                                                                var casesLabel = cases == 1 ? "Case" : "Cases";
                                                                var bottlesLabel = bottles == 1 ? "Bottle" : "Bottles";
                                                                string caseText = cases > 0 && bottles > 0 
                                                                    ? $"{cases} {casesLabel}, {bottles} {bottlesLabel}" 
                                                                    : (cases > 0 ? $"{cases} {casesLabel}" : $"{bottles} {bottlesLabel}");

                                                                <div class="badge rounded-pill bg-success-light text-success border border-success-subtle fw-black px-2 py-1 d-inline-flex align-items-center gap-1" style="font-size: 0.75rem; letter-spacing: 0.2px;">
                                                                    <i class="bi bi-box-seam-fill"></i>
                                                                    <span>@caseText</span>
                                                                </div>
                                                            }
                                                            else if (item.Value.IsLiquor)
                                                            {
                                                                var btlUsed = Math.Round(item.Value.LiquorBottlesUsed, 1);
                                                                <div class="badge rounded-pill fw-black px-2 py-1 d-inline-flex align-items-center gap-1" style="font-size: 0.75rem; letter-spacing: 0.2px; background: #f3e8ff; color: #7e22ce; border: 1px solid #e9d5ff !important;" title="@item.Value.Quantity shots @item.Value.PourSizeOz.ToString("0.#") oz each (@item.Value.TotalOuncesPoured.ToString("0.#") oz total) based on Global Shot Size">
                                                                    <i class="bi bi-cup-straw"></i>
                                                                    <span>@btlUsed Bottles Used (@item.Value.PourSizeOz.ToString("0.#")oz shot)</span>
                                                                </div>
                                                            }
                                                            else
                                                            {
                                                                <div class="badge rounded-pill bg-light text-secondary border fw-bold px-2 py-1" style="font-size: 0.7rem; letter-spacing: 0.2px;">
                                                                    SINGLE ITEM
                                                                </div>
                                                            }
                                                        </div>
                                                    </td>
                                                    <td class="text-end fw-black text-dark">@item.Value.Revenue.ToString("C0")</td>
                                                    <td class="text-end pe-4">
                                                        <div class="d-flex align-items-center justify-content-end gap-3">
                                                            <div class="progress rounded-pill flex-grow-1" style="height: 12px; width: 80px; background: #f1f5f9;">
                                                                <div class="progress-bar bg-primary animate-grow" style="width: @(share)%"></div>
                                                            </div>
                                                            <span class="fw-black text-primary" style="min-width: 45px;">@share.ToString("0.0")%</span>
                                                        </div>
                                                    </td>
                                                </tr>
                                            }
                                        }
                                        else
                                        {
                                            @foreach (var item in ProductStats.Where(x => IsItemInSelectedCategory(x.Value)).OrderByDescending(x => x.Value.GetNetUnitsNeeded(PredictionMode)).ThenByDescending(x => x.Value.Quantity30D))
                                            {
                                                var projDemand = item.Value.GetProjected7DayDemand(PredictionMode);
                                                var netNeeded = item.Value.GetNetUnitsNeeded(PredictionMode);
                                                var recCases = item.Value.GetRecommendedCases(PredictionMode);

                                                <tr>
                                                    <td class="ps-4">
                                                        <div class="fw-black text-primary">@item.Key</div>
                                                        @if (netNeeded > 0)
                                                        {
                                                            <span class="badge bg-danger-light text-danger fw-black extra-small">REORDER NEEDED</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge bg-success-light text-success fw-black extra-small">ADEQUATE STOCK</span>
                                                        }
                                                    </td>
                                                    <td class="text-center">
                                                        <div class="fw-black fs-5 text-dark">@item.Value.CurrentStock</div>
                                                        <div class="extra-small text-muted fw-bold text-uppercase">Stock On Hand</div>
                                                    </td>
                                                    <td class="text-center">
                                                        <div class="fw-black fs-5 text-primary">@projDemand</div>
                                                        <div class="extra-small text-muted fw-bold text-uppercase">@(item.Value.IsLiquor ? "Projected Shots" : "Projected Units")</div>
                                                    </td>
                                                    <td class="text-end pe-4">
                                                        @if (netNeeded == 0)
                                                        {
                                                            <div class="badge rounded-pill bg-success-light text-success border border-success-subtle fw-black px-3 py-2" style="font-size: 0.75rem;">
                                                                <i class="bi bi-check-circle-fill me-1"></i>NO ORDER NEEDED
                                                            </div>
                                                        }
                                                        else if (item.Value.PackSize > 1)
                                                        {
                                                            <div class="badge rounded-pill bg-primary-light text-primary border border-primary-subtle fw-black px-3 py-2" style="font-size: 0.75rem;">
                                                                <i class="bi bi-box-seam-fill me-1"></i>ORDER @recCases CASES (@(recCases * item.Value.PackSize) units)
                                                            </div>
                                                        }
                                                        else if (item.Value.IsLiquor)
                                                        {
                                                            var btlToOrder = Math.Max(1, (int)Math.Ceiling((double)netNeeded * (double)item.Value.PourSizeOz / (double)item.Value.BottleVolumeOz));
                                                            <div class="badge rounded-pill fw-black px-3 py-2" style="font-size: 0.75rem; background: #f3e8ff; color: #7e22ce; border: 1px solid #e9d5ff !important;">
                                                                <i class="bi bi-cup-straw me-1"></i>ORDER @btlToOrder BOTTLES (@netNeeded shots)
                                                            </div>
                                                        }
                                                        else
                                                        {
                                                            <div class="badge rounded-pill bg-primary-light text-primary border border-primary-subtle fw-black px-3 py-2" style="font-size: 0.75rem;">
                                                                <i class="bi bi-cart-plus-fill me-1"></i>ORDER @netNeeded UNITS
                                                            </div>
                                                        }
                                                    </td>
                                                </tr>
                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- CATEGORY & STATION INSIGHTS -->
                <div class="col-md-5">
                    <div class="chart-card mb-4" style="height: auto;">
                        <div class="header">
                            <h5 class="fw-black mb-0">CATEGORY SALES</h5>
                            <p class="small text-muted mb-0">Revenue distribution by group</p>
                        </div>
                        <div class="body">
                            @foreach (var cat in CategoryRevenue.OrderByDescending(x => x.Value))
                            {
                                var catPct = TotalRevenue > 0 ? (double)cat.Value / (double)TotalRevenue * 100 : 0;
                                <div class="category-stat-row mb-3">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <span class="fw-black small" style="color: @GetCategoryColor(cat.Key)">@cat.Key</span>
                                        <span class="fw-black small">@cat.Value.ToString("C0")</span>
                                    </div>
                                    <div class="progress rounded-pill" style="height: 10px; background: #f1f5f9;">
                                        <div class="progress-bar" style="width: @(catPct)%; background: @GetCategoryColor(cat.Key)"></div>
                                    </div>
                                </div>
                            }

                            @if (TokensSold > 0 || TokensRedeemed > 0)
                            {
                                <div class="mt-3 p-3 rounded-4 border border-warning-subtle d-flex justify-content-between align-items-center" style="background: #fffbeb;">
                                    <div>
                                        <div class="fw-black extra-small text-warning-emphasis text-uppercase d-flex align-items-center gap-1">
                                            <i class="bi bi-coin text-warning fs-6"></i>
                                            <span>TOKEN ACTIVITY SUMMARY</span>
                                        </div>
                                        <div class="extra-small text-muted fw-bold">Period Circulation</div>
                                    </div>
                                    <div class="d-flex gap-3 text-end">
                                        <div>
                                            <div class="fw-black text-dark fs-6">@TokensSold</div>
                                            <div class="extra-small text-muted fw-bold text-uppercase">SOLD</div>
                                        </div>
                                        <div class="border-start ps-3">
                                            <div class="fw-black text-success fs-6">@TokensRedeemed</div>
                                            <div class="extra-small text-success fw-bold text-uppercase">REDEEMED</div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
 
                    <div class="chart-card" style="height: auto;">
                        <div class="header">
                            <h5 class="fw-black mb-0">STATION REVENUE SHARE</h5>
                            <p class="small text-muted mb-0">Compare bar terminal activity</p>
                        </div>
                        <div class="body">
                            @foreach (var terminal in TerminalRevenue.OrderByDescending(x => x.Value))
                            {
                                var pct = TotalRevenue > 0 ? (double)terminal.Value / (double)TotalRevenue * 100 : 0;
                                <div class="d-flex justify-content-between mb-1 small fw-bold mt-2">
                                    <span>@terminal.Key</span>
                                    <span>@terminal.Value.ToString("C2") (@pct.ToString("0")%)</span>
                                </div>
                                <div class="progress rounded-pill mb-3" style="height: 8px;">
                                    <div class="progress-bar" style="width: @(pct)%; background: @GetTerminalColor(terminal.Key)"></div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@if (_showPrintPreview)
{
    <div class="modal-overlay" @onclick="() => _showPrintPreview = false" style="background: rgba(15, 23, 42, 0.9);">
        <div class="print-preview-card shadow-2xl animate-pop-in" @onclick:stopPropagation>
            <div class="preview-header p-3 bg-white border-bottom d-flex justify-content-between align-items-center">
                <h6 class="fw-black mb-0"><i class="bi bi-eye me-2"></i>PRINT PREVIEW (RECEIPT)</h6>
                <button class="btn-close" @onclick="() => _showPrintPreview = false"></button>
            </div>
            
            <div class="preview-body p-4 bg-secondary bg-opacity-10 d-flex justify-content-center">
                <!-- VIRTUAL RECEIPT -->
                <div id="receipt-strip" class="receipt-strip shadow-sm">
                    <div class="receipt-header text-center">
                        <div class="fw-black fs-4">GFC CLUB</div>
                        <div class="fw-bold extra-small text-uppercase">Current Inventory Status</div>
                        <div class="extra-small">@DateTime.Now.ToString("MMM dd, yyyy @ h:mm tt")</div>
                        <div class="border-top border-dark border-1 my-2"></div>
                    </div>

                    <div class="receipt-content">
                        @if (_inventoryItems != null)
                        {
                            @foreach (var group in _inventoryItems.Where(i => i.IsActive).GroupBy(i => i.IsBeer ? "BEER" : "LIQUOR"))
                            {
                                <div class="fw-black text-center text-uppercase border-bottom border-dark mb-2 mt-3" style="font-size: 0.75rem;">--- @group.Key ---</div>
                                @foreach (var item in group.OrderBy(i => i.Name))
                                {
                                    <div class="d-flex justify-content-between align-items-start mb-1" style="font-size: 0.8rem; line-height: 1.1;">
                                        <div class="fw-bold pe-2">
                                            @item.Name.ToUpper()
                                            @if (item.CurrentStock <= item.MinStockLimit)
                                            {
                                                <span class="ms-1 fw-black">[!!]</span>
                                            }
                                        </div>
                                        <div class="text-end fw-black" style="white-space: nowrap;">
                                            @if (item.PackSize > 1)
                                            {
                                                <span>@(item.CurrentStock / item.PackSize)cs @(item.CurrentStock % item.PackSize)btl</span>
                                            }
                                            else
                                            {
                                                <span>@item.CurrentStock units</span>
                                            }
                                        </div>
                                    </div>
                                }
                            }
                        }
                    </div>

                    <div class="receipt-footer text-center mt-4 pt-2 border-top border-dark border-1 border-dotted">
                        <div class="extra-small fw-bold">END OF REPORT</div>
                        <div class="extra-small text-muted">Generated by GFC Intelligence</div>
                    </div>
                </div>
            </div>

            <div class="preview-footer p-3 bg-white border-top d-grid gap-2">
                <button class="btn btn-primary btn-lg fw-black rounded-pill shadow" @onclick="ExecutePrint">
                    <i class="bi bi-printer me-2"></i>CONFIRM & PRINT
                </button>
                <button class="btn btn-light rounded-pill fw-bold" @onclick="() => _showPrintPreview = false">CANCEL</button>
            </div>
        </div>
    </div>
}

