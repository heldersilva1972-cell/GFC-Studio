@code {
    private DateTime StartDate = DateTime.Today;
    private DateTime EndDate = DateTime.Today;
    private bool IsLoading = true;
    private string ActivePreset = "Today";
    
    private int SelectedMonth = DateTime.Today.Month;
    private int SelectedYear = DateTime.Today.Year;

    private decimal TotalRevenue;
    private int TotalTransactions;
    private decimal AvgSaleValue;
    private string MostActiveTerminal = "N/A";

    private bool _showPrintPreview = false;
    private List<LiquorItem>? _inventoryItems;
    
    private Dictionary<string, ProductMetric> ProductStats = new();
    private Dictionary<string, decimal> CategoryRevenue = new();
    private Dictionary<string, decimal> TerminalRevenue = new();

    private string SelectedTableView = "Performance";
    private string SelectedCategoryFilter = "ALL_BEVERAGES";
    private string PredictionMode = "Hybrid"; // "Hybrid", "Recent", "YoY"

    private int TokensSold = 0;
    private int TokensRedeemed = 0;

    public class ProductMetric {
        public int Quantity { get; set; }
        public decimal Revenue { get; set; }
        public int PackSize { get; set; } = 1;
        public string Category { get; set; } = "UNCATEGORIZED";
        public double CasesSold => PackSize > 1 ? (double)Quantity / PackSize : 0;

        public bool IsLiquor { get; set; } = false;
        public decimal PourSizeOz { get; set; } = 1.5m;
        public decimal BottleVolumeOz { get; set; } = 25.36m;
        public double TotalOuncesPoured => (double)(Quantity * PourSizeOz);
        public double LiquorBottlesUsed => BottleVolumeOz > 0 ? TotalOuncesPoured / (double)BottleVolumeOz : 0;

        public int CurrentStock { get; set; } = 0;
        public int MinStockLimit { get; set; } = 0;
        public int Quantity30D { get; set; } = 0;
        public int QuantityYoY { get; set; } = 0;

        public int GetProjected7DayDemand(string mode)
        {
            double daily30D = (double)Quantity30D / 30.0;
            double dailyYoY = (double)QuantityYoY / 30.0;

            double blendedDailyRate = mode switch
            {
                "Recent" => daily30D,
                "YoY" => dailyYoY > 0 ? dailyYoY : daily30D,
                _ => (daily30D * 0.60) + ((dailyYoY > 0 ? dailyYoY : daily30D) * 0.40)
            };

            // Ensure baseline demand if quantity sold is > 0 but rate is small
            if (blendedDailyRate == 0 && Quantity > 0) blendedDailyRate = (double)Quantity / 30.0;

            return (int)Math.Ceiling(blendedDailyRate * 7.0);
        }

        public int GetTargetStock(string mode) => Math.Max(GetProjected7DayDemand(mode), MinStockLimit > 0 ? MinStockLimit : 2);
        public int GetNetUnitsNeeded(string mode) => Math.Max(0, GetTargetStock(mode) - CurrentStock);
        public int GetRecommendedCases(string mode) => PackSize > 1 ? (int)Math.Ceiling((double)GetNetUnitsNeeded(mode) / PackSize) : 0;
    }

    private bool IsItemInSelectedCategory(ProductMetric item)
    {
        var cat = item.Category?.ToUpper() ?? "";

        if (cat.Contains("TOKEN") || cat.Contains("DEPOSIT") || cat.Contains("PAYOUT") || cat.Contains("CORRECTION") || cat.Contains("CREDIT"))
        {
            return false;
        }

        if (SelectedCategoryFilter == "ALL") return true;

        if (SelectedCategoryFilter == "ALL_BEVERAGES")
        {
            return cat != "FOOD" && cat != "FOODS" && cat != "SNACKS" && cat != "SNACK" && cat != "NON-ALCHOHOLIC" && cat != "NON-ALCOHOLIC";
        }

        if (SelectedCategoryFilter == "FOOD")
        {
            return cat == "FOOD" || cat == "FOODS" || cat == "SNACKS" || cat == "SNACK";
        }

        return cat.Contains(SelectedCategoryFilter, StringComparison.OrdinalIgnoreCase);
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/");
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadAnalytics();
    }

    private async Task OnMonthChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int m))
        {
            SelectedMonth = m;
            ActivePreset = "MonthMode";
            UpdateRangeFromMonthYear();
            await LoadAnalytics();
        }
    }

    private async Task OnYearChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int y))
        {
            SelectedYear = y;
            if (ActivePreset != "MonthMode" && ActivePreset != "YearMode")
            {
                ActivePreset = "MonthMode";
            }
            UpdateRangeFromMonthYear();
            await LoadAnalytics();
        }
    }

    private void UpdateRangeFromMonthYear()
    {
        if (ActivePreset == "YearMode")
        {
            StartDate = new DateTime(SelectedYear, 1, 1);
            EndDate = new DateTime(SelectedYear, 12, 31);
        }
        else
        {
            StartDate = new DateTime(SelectedYear, SelectedMonth, 1);
            EndDate = StartDate.AddMonths(1).AddDays(-1);
        }
        
        // Don't let end date be in the future
        if (EndDate > DateTime.Today) EndDate = DateTime.Today;
    }

    private void SetPreset(string preset)
    {
        ActivePreset = preset;
        var today = DateTime.Today;

        switch (preset)
        {
            case "Today":
                StartDate = today;
                EndDate = today;
                break;
            case "CurrentWeek":
                int diff = (7 + (today.DayOfWeek - DayOfWeek.Monday)) % 7;
                StartDate = today.AddDays(-1 * diff);
                EndDate = today;
                break;
            case "PrevWeek":
                int pDiff = (7 + (today.DayOfWeek - DayOfWeek.Monday)) % 7;
                StartDate = today.AddDays(-1 * pDiff).AddDays(-7);
                EndDate = today.AddDays(-1 * pDiff).AddDays(-1);
                break;
            case "MonthMode":
                // Trigger month logic
                UpdateRangeFromMonthYear();
                break;
            case "YearMode":
                // Set to full year
                StartDate = new DateTime(SelectedYear, 1, 1);
                EndDate = new DateTime(SelectedYear, 12, 31);
                if (EndDate > today) EndDate = today;
                break;
        }

        _ = LoadAnalytics();
    }

    private string CleanProductName(string rawName)
    {
        if (string.IsNullOrEmpty(rawName)) return "";
        var name = rawName.Trim();
        if (name.StartsWith("> ")) name = name.Substring(2).Trim();
        int parenIndex = name.IndexOf('(');
        if (parenIndex != -1)
        {
            name = name.Substring(0, parenIndex).Trim();
        }
        return name;
    }

    private async Task LoadAnalytics()
    {
        IsLoading = true;
        StateHasChanged();

        using var db = DbFactory.CreateDbContext();
        
        var st = StartDate.Date.AddHours(3);
        var en = EndDate.Date.AddDays(1).AddHours(3);
        
        var today = DateTime.Today;

        // Trailing 30 Days Window
        var t30Start = today.AddDays(-30).Date.AddHours(3);
        var t30End = today.AddDays(1).Date.AddHours(3);

        // Same Month Last Year Window
        var yoyStart = today.AddYears(-1).AddDays(-15).Date.AddHours(3);
        var yoyEnd = today.AddYears(-1).AddDays(15).Date.AddHours(3);

        var sales = await db.PosSales
            .Where(s => s.Timestamp >= st && s.Timestamp < en)
            .ToListAsync();

        var sales30D = await db.PosSales
            .Where(s => s.Timestamp >= t30Start && s.Timestamp < t30End)
            .ToListAsync();

        var salesYoY = await db.PosSales
            .Where(s => s.Timestamp >= yoyStart && s.Timestamp < yoyEnd)
            .ToListAsync();

        var sysSettings = await SettingsService.GetAsync();
        decimal globalShotSize = sysSettings?.GlobalLiquorPourSize > 0 ? sysSettings.GlobalLiquorPourSize : 1.5m;

        var inventoryItems = await db.LiquorItems.AsNoTracking().ToListAsync();
        var itemMetaMap = new Dictionary<string, LiquorItem>(StringComparer.OrdinalIgnoreCase);
        foreach (var liq in inventoryItems)
        {
            var cleanLiqName = CleanProductName(liq.Name);
            if (!string.IsNullOrEmpty(cleanLiqName))
            {
                itemMetaMap[cleanLiqName] = liq;
            }
        }

        ProductStats = new();
        CategoryRevenue = new();
        TerminalRevenue = new();

        // Pre-populate all active catalog items so low-stock / zero-sales items are evaluated for reordering
        foreach (var liq in inventoryItems.Where(i => i.IsActive))
        {
            var cleanLiqName = CleanProductName(liq.Name);
            if (string.IsNullOrEmpty(cleanLiqName)) continue;

            int packSize = liq.PackSize > 1 ? liq.PackSize : 1;
            bool isLiquor = !liq.IsBeer && (string.Equals(liq.Category, "LIQUOR", StringComparison.OrdinalIgnoreCase) || !liq.IsUnitBased);
            decimal pourSize = globalShotSize;
            decimal bottleVol = liq.BottleVolumeOunces.HasValue && liq.BottleVolumeOunces.Value > 0 ? liq.BottleVolumeOunces.Value : 25.36m;

            if (!ProductStats.ContainsKey(cleanLiqName))
            {
                ProductStats[cleanLiqName] = new ProductMetric {
                    PackSize = packSize,
                    IsLiquor = isLiquor,
                    Category = string.IsNullOrEmpty(liq.Category) ? (liq.IsBeer ? "BEER" : "LIQUOR") : liq.Category,
                    PourSizeOz = pourSize,
                    BottleVolumeOz = bottleVol,
                    CurrentStock = liq.CurrentStock,
                    MinStockLimit = liq.MinStockLimit
                };
            }
        }
        
        int validSalesCount = 0;
        decimal calculatedRevenue = 0;
        int tokensSoldAcc = 0;
        int tokensRedeemedAcc = 0;

        foreach (var sale in sales)
        {
            var items = DeserializeItems(sale.ItemsJson);
            bool hasValidItem = false;

            foreach (var item in items)
            {
                var catCheck = string.IsNullOrEmpty(item.Category) ? "" : item.Category.ToUpper();
                var nameCheck = item.Name ?? "";

                if (catCheck == "TOKENS" || nameCheck.Contains("TOKEN SALE", StringComparison.OrdinalIgnoreCase) || nameCheck.Equals("TOKEN", StringComparison.OrdinalIgnoreCase))
                {
                    tokensSoldAcc += item.Quantity;
                }

                if (catCheck == "TOKEN_CREDIT" || item.IsTokenApplied || nameCheck.Contains("TOKEN REDEEMED", StringComparison.OrdinalIgnoreCase))
                {
                    tokensRedeemedAcc += item.Quantity;
                }

                var cleanName = CleanProductName(item.Name);
                if (string.IsNullOrEmpty(cleanName)) continue;

                // Filter out non-item entries like deposits, corrections, credits, payouts
                if (cleanName.Contains("DEPOSIT", StringComparison.OrdinalIgnoreCase) ||
                    cleanName.Contains("CORRECTION", StringComparison.OrdinalIgnoreCase) ||
                    cleanName.Contains("NO SALE", StringComparison.OrdinalIgnoreCase) ||
                    cleanName.Contains("CREDIT", StringComparison.OrdinalIgnoreCase) ||
                    cleanName.Contains("PAYOUT", StringComparison.OrdinalIgnoreCase))
                {
                    continue;
                }

                var catName = string.IsNullOrEmpty(item.Category) ? "UNCATEGORIZED" : item.Category.ToUpper();
                if (catName == "TOKEN_CREDIT" || catName == "PAYOUT" || catName == "PAYOUTS" || catName == "DEPOSIT" || catName == "DEPOSITS")
                {
                    continue;
                }

                hasValidItem = true;

                // Aggregate Product Stats
                if (!ProductStats.ContainsKey(cleanName))
                {
                    int packSize = 1;
                    bool isLiquor = catName == "LIQUOR";
                    decimal pourSize = globalShotSize; // Strictly use Global Shot Size (oz) from Liquor Hub configuration
                    decimal bottleVol = 25.36m;

                    if (itemMetaMap.TryGetValue(cleanName, out var liq))
                    {
                        if (liq.PackSize > 1) packSize = liq.PackSize;
                        if (!liq.IsBeer && (string.Equals(liq.Category, "LIQUOR", StringComparison.OrdinalIgnoreCase) || !liq.IsUnitBased))
                        {
                            isLiquor = true;
                        }

                        if (liq.BottleVolumeOunces.HasValue && liq.BottleVolumeOunces.Value > 0)
                        {
                            bottleVol = liq.BottleVolumeOunces.Value;
                        }
                    }

                    ProductStats[cleanName] = new ProductMetric {
                        PackSize = packSize,
                        IsLiquor = isLiquor,
                        Category = catName,
                        PourSizeOz = pourSize,
                        BottleVolumeOz = bottleVol
                    };
                }

                ProductStats[cleanName].Category = catName;
                
                ProductStats[cleanName].Quantity += item.Quantity;
                ProductStats[cleanName].Revenue += (item.Price * item.Quantity);
                calculatedRevenue += (item.Price * item.Quantity);

                // Aggregate Category Stats
                if (!CategoryRevenue.ContainsKey(catName)) CategoryRevenue[catName] = 0;
                CategoryRevenue[catName] += (item.Price * item.Quantity);

                // Aggregate Terminal Stats
                if (!TerminalRevenue.ContainsKey(sale.TerminalName))
                    TerminalRevenue[sale.TerminalName] = 0;
                TerminalRevenue[sale.TerminalName] += (item.Price * item.Quantity);
            }

            if (hasValidItem)
            {
                validSalesCount++;
            }
        }

        foreach (var kvp in ProductStats)
        {
            var cleanName = kvp.Key;
            var metric = kvp.Value;

            if (itemMetaMap.TryGetValue(cleanName, out var liq))
            {
                metric.CurrentStock = liq.CurrentStock;
                metric.MinStockLimit = liq.MinStockLimit;
            }
        }

        TokensSold = tokensSoldAcc;
        TokensRedeemed = tokensRedeemedAcc;

        // Populate Trailing 30-Day Sales Velocity
        foreach (var sale in sales30D)
        {
            foreach (var item in DeserializeItems(sale.ItemsJson))
            {
                var cleanName = CleanProductName(item.Name);
                if (string.IsNullOrEmpty(cleanName)) continue;
                if (ProductStats.ContainsKey(cleanName))
                {
                    ProductStats[cleanName].Quantity30D += item.Quantity;
                }
            }
        }

        // Populate Same Month Last Year (YoY) Sales Velocity
        foreach (var sale in salesYoY)
        {
            foreach (var item in DeserializeItems(sale.ItemsJson))
            {
                var cleanName = CleanProductName(item.Name);
                if (string.IsNullOrEmpty(cleanName)) continue;
                if (ProductStats.ContainsKey(cleanName))
                {
                    ProductStats[cleanName].QuantityYoY += item.Quantity;
                }
            }
        }

        TotalTransactions = validSalesCount;
        TotalRevenue = calculatedRevenue;
        AvgSaleValue = TotalTransactions > 0 ? TotalRevenue / TotalTransactions : 0;

        MostActiveTerminal = sales
            .Where(s => DeserializeItems(s.ItemsJson).Any(item => {
                var cleanName = CleanProductName(item.Name);
                if (string.IsNullOrEmpty(cleanName)) return false;
                if (cleanName.Contains("DEPOSIT", StringComparison.OrdinalIgnoreCase) ||
                    cleanName.Contains("CORRECTION", StringComparison.OrdinalIgnoreCase) ||
                    cleanName.Contains("NO SALE", StringComparison.OrdinalIgnoreCase) ||
                    cleanName.Contains("CREDIT", StringComparison.OrdinalIgnoreCase) ||
                    cleanName.Contains("PAYOUT", StringComparison.OrdinalIgnoreCase)) return false;
                var catName = string.IsNullOrEmpty(item.Category) ? "UNCATEGORIZED" : item.Category.ToUpper();
                if (catName == "TOKEN_CREDIT" || catName == "PAYOUT" || catName == "PAYOUTS" || catName == "DEPOSIT" || catName == "DEPOSITS") return false;
                return true;
            }))
            .GroupBy(s => s.TerminalName)
            .OrderByDescending(g => g.Count())
            .Select(g => g.Key)
            .FirstOrDefault() ?? "N/A";

        IsLoading = false;
        StateHasChanged();
    }

    private List<PosTerminal.ProductItem> DeserializeItems(string json)
    {
        try { return JsonSerializer.Deserialize<List<PosTerminal.ProductItem>>(json) ?? new(); }
        catch { return new(); }
    }

    private string GetMonthName(int m)
    {
        return m switch
        {
            1 => "JANUARY", 2 => "FEBRUARY", 3 => "MARCH", 4 => "APRIL",
            5 => "MAY", 6 => "JUNE", 7 => "JULY", 8 => "AUGUST",
            9 => "SEPTEMBER", 10 => "OCTOBER", 11 => "NOVEMBER", 12 => "DECEMBER",
            _ => ""
        };
    }

    private string GetTerminalColor(string name)
    {
        if (name.Contains("Patio")) return "#0ea5e9";
        if (name.Contains("Main")) return "#6366f1";
        if (name.Contains("Downstairs")) return "#8b5cf6";
        return "#64748b";
    }

    private string GetCategoryColor(string category)
    {
        return category switch
        {
            "BEER" => "#16a34a",
            "LIQUOR" => "#9333ea",
            "TOKENS" => "#d97706",
            "FOOD" => "#dc2626",
            "MIXED DRINKS" => "#0891b2",
            _ => "#64748b"
        };
    }

    private async Task PrepareInventoryPrint()
    {
        _inventoryItems = (await LiquorService.GetAllItemsAsync()).ToList();
        _showPrintPreview = true;
    }

    private async Task ExecutePrint()
    {
        await JSRuntime.InvokeVoidAsync("window.print");
    }
}
