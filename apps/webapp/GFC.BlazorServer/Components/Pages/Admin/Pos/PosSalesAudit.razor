    public class TokenYieldEntry {
        public PosToken Token { get; set; } = new();
        public bool IsLifetimeMode { get; set; } = false;
        public int Sold { get; set; }
        public int Redeemed { get; set; }
        public int ManuallyProcessedLegacyCount { get; set; } = 0;
        public int StartingBalance => IsLifetimeMode ? Token.StartingLiabilityBalance : 0;
        public int TotalSold => Sold + StartingBalance;
        public int RawLegacyRedeemed => Math.Max(0, Redeemed - TotalSold);
        public int LegacyRedeemed => Math.Max(0, RawLegacyRedeemed - ManuallyProcessedLegacyCount);
        public int InCirculation => Math.Max(0, TotalSold - Redeemed);
        public decimal ActualCashCollected { get; set; }
        public decimal TotalRevenue => ActualCashCollected + (StartingBalance * Token.SalePrice);
        public decimal RedemptionValue { get; set; } // Menu price of items redeemed
        public decimal NetFinancialImpact => TotalRevenue - RedemptionValue;
        
        // Physical Token Stock & Audit properties
        public int MasterPhysicalStock { get; set; } = 0;
        public int ExpectedPhysicalStock => Math.Max(0, MasterPhysicalStock - Sold + Redeemed);
        public int ActualPhysicalCount { get; set; } = -1;
        public int StockVariance => ActualPhysicalCount < 0 ? 0 : ActualPhysicalCount - ExpectedPhysicalStock;
        public string DiscrepancyStatus => ActualPhysicalCount < 0 ? "UNAUDITED" : (StockVariance > 0 ? "LEGACY_INFLOW" : (StockVariance < 0 ? "SHRINKAGE" : "BALANCED"));
        public string LastAuditStatus { get; set; } = "Never";
    }

