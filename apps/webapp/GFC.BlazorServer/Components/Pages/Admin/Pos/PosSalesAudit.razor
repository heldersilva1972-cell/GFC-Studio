@if (_showInsightsDetailModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5); z-index: 10500;">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content rounded-4 shadow border-0">
                <div class="modal-header border-bottom py-3">
                    <h5 class="modal-title fw-black text-primary">
                        @if (_insightsDetailType == "SALES") { <span>POS SALES BREAKDOWN</span> }
                        else if (_insightsDetailType == "AVERAGE_TICKET") { <span>AVERAGE TICKET SIZES BY STATION</span> }
                        else if (_insightsDetailType == "POUR_COST") { <span>POUR COST & SHRINKAGE BREAKDOWN</span> }
                        else if (_insightsDetailType == "INVENTORY") { <span>ON-HAND INVENTORY WHOLESALE VALUES</span> }
                    </h5>
                    <button type="button" class="btn-close" @onclick='() => _showInsightsDetailModal = false'></button>
                </div>
                <div class="modal-body p-0" style="max-height: 500px; overflow-y: auto;">
                    @if (_insightsDetailType == "INVENTORY")
                    {
                        <table class="table table-hover align-middle mb-0 small">
                            <thead class="bg-light sticky-top">
                                <tr>
                                    <th class="ps-4">PRODUCT</th>
                                    <th>CATEGORY</th>
                                    <th class="text-center">STOCK</th>
                                    <th class="text-end">UNIT COST</th>
                                    <th class="pe-4 text-end">TOTAL VALUE</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in DbLiquorItems.Where(i => i.IsActive && IsLiquorInventoryItem(i) && GetEffectiveStock(i) > 0).OrderByDescending(i => GetEffectiveStock(i) * (i.PackSize > 1 ? i.CurrentPrice / i.PackSize : i.CurrentPrice)))
                                {
                                    var unitCost = item.PackSize > 1 ? item.CurrentPrice / item.PackSize : item.CurrentPrice;
                                    var effectiveStock = GetEffectiveStock(item);
                                    var val = effectiveStock * unitCost;
                                    <tr>
                                        <td class="ps-4 fw-bold text-dark">@item.Name.ToUpper()</td>
                                        <td><span class="badge bg-light text-muted border text-uppercase" style="font-size: 0.65rem;">@item.Category</span></td>
                                        <td class="text-center fw-black">@effectiveStock @(effectiveStock == 1 ? "unit" : "units")</td>
                                        <td class="text-end text-muted">@unitCost.ToString("C")</td>
                                        <td class="pe-4 text-end fw-black text-success">@val.ToString("C")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else if (_insightsDetailType == "SALES")
                    {
                        <table class="table table-hover align-middle mb-0 small">
                            <thead class="bg-light sticky-top">
                                <tr>
                                    <th class="ps-4">ITEM NAME</th>
                                    <th>CATEGORY</th>
                                    <th class="text-center">QTY SOLD</th>
                                    <th class="pe-4 text-end">REVENUE</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var r in SummaryResults.OrderByDescending(x => x.Revenue))
                                {
                                    <tr>
                                        <td class="ps-4 fw-bold text-dark">@r.Name.ToUpper()</td>
                                        <td><span class="badge bg-light text-muted border text-uppercase" style="font-size: 0.65rem;">@r.Category</span></td>
                                        <td class="text-center fw-black">@r.Quantity</td>
                                        <td class="pe-4 text-end fw-black text-dark">@r.Revenue.ToString("C")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else if (_insightsDetailType == "AVERAGE_TICKET")
                    {
                        <table class="table table-hover align-middle mb-0 small">
                            <thead class="bg-light sticky-top">
                                <tr>
                                    <th class="ps-4">STATION / TERMINAL</th>
                                    <th class="text-center">TICKETS</th>
                                    <th class="pe-4 text-end">AVERAGE SPEND</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var station in StationTotals)
                                {
                                    var count = _allSalesForStats.Count(s => s.TerminalName == station.Key);
                                    var avg = count > 0 ? station.Value / count : 0;
                                    <tr>
                                        <td class="ps-4 fw-bold text-dark">@station.Key.ToUpper()</td>
                                        <td class="text-center fw-bold text-muted">@count</td>
                                        <td class="pe-4 text-end fw-black text-primary">@avg.ToString("C")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else if (_insightsDetailType == "POUR_COST")
                    {
                        <table class="table table-hover align-middle mb-0 small">
                            <thead class="bg-light sticky-top">
                                <tr>
                                    <th class="ps-4">LIQUOR BRAND</th>
                                    <th class="text-center">PULLS COST</th>
                                    <th class="text-center">RETAIL SALES</th>
                                    <th class="pe-4 text-end">POUR COST %</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    var st = StartDate.Date.AddHours(3);
                                    var en = EndDate.Date.AddDays(1).AddHours(3);
                                    var pulls = _ledgerTransactions
                                        .Where(t => t.TransactionType == "Checkout" && t.Timestamp >= st && t.Timestamp < en && t.Item != null && !t.Item.IsUnitBased && !t.Item.IsBeer);
                                    var groupedPulls = pulls.GroupBy(p => CleanProductName(p.Item.Name).ToUpper());
                                }
                                @foreach (var group in groupedPulls.OrderByDescending(g => g.Sum(p => Math.Abs(p.ChangeAmount) * (p.Item.PackSize > 1 ? p.Item.CurrentPrice / p.Item.PackSize : p.Item.CurrentPrice))))
                                {
                                    var brandName = group.Key;
                                    var cost = group.Sum(p => Math.Abs(p.ChangeAmount) * (p.Item.PackSize > 1 ? p.Item.CurrentPrice / p.Item.PackSize : p.Item.CurrentPrice));
                                    var salesVal = _allSalesForStats.SelectMany(s => GetItemsList(s.ItemsJson))
                                        .Where(i => i != null && CleanProductName(i.Name).Equals(brandName, StringComparison.OrdinalIgnoreCase))
                                        .Sum(i => i.Price * i.Quantity);
                                    var pc = salesVal > 0 ? (cost / salesVal) * 100 : 0;
                                    <tr>
                                        <td class="ps-4 fw-bold text-dark">@brandName</td>
                                        <td class="text-center fw-bold text-danger">@cost.ToString("C")</td>
                                        <td class="text-center fw-bold text-success">@salesVal.ToString("C")</td>
                                        <td class="pe-4 text-end fw-black">@(salesVal > 0 ? $"{pc:F1}%" : "-")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
                <div class="modal-footer border-top py-3">
                    <button class="btn btn-secondary rounded-pill fw-bold px-4" @onclick='() => _showInsightsDetailModal = false'>CLOSE DETAILS</button>
                </div>
            </div>
        </div>
    </div>
}

