                                                        <i class="bi bi-exclamation-triangle me-1"></i>SHORTAGE / SHRINKAGE
                                                    </span>
                                                }
                                                else if (log.Status == "BALANCED")
                                                {
                                                    <span class="badge bg-success text-white fw-bold" style="font-size: 0.72rem; padding: 4px 8px;">
                                                        <i class="bi bi-check-circle me-1"></i>COUNT BALANCED
                                                    </span>
