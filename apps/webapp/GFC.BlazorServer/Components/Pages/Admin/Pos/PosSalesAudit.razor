@page "/admin/pos-audit"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using GFC.BlazorServer.Data
@using GFC.BlazorServer.Data.Entities
@using global::System.Text.Json
@inject IDbContextFactory<GfcDbContext> DbFactory
@inject NavigationManager Navigation
@inject GFC.BlazorServer.Services.IBlazorSystemSettingsService SystemSettingsService
@inject GFC.Core.Interfaces.IVersionService VersionService
@inject IJSRuntime JSRuntime
@attribute [Authorize]

<PageTitle>POS Sales Audit</PageTitle>

<div class="audit-page-wrapper">
    <!-- COMPACT TOP BAR -->
    <div class="compact-top-bar px-4 py-2 bg-white border-bottom d-flex justify-content-between align-items-center">
        <div class="d-flex align-items-center">
            <button class="btn btn-light rounded-circle me-3 shadow-sm border" @onclick="GoBack" title="Go Back">
                <i class="bi bi-chevron-left fs-5"></i>
            </button>
            <div>
                <h4 class="fw-black mb-0">POS TRANSACTION AUDIT</h4>
                <div class="d-flex align-items-center gap-2">
                    <span class="badge bg-light text-muted border" style="font-size: 0.6rem;">v.@VersionService.GetRevision()</span>
                    <span class="text-muted" style="font-size: 0.65rem;">Live feed of station activity</span>
                </div>
            </div>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-outline-secondary btn-sm rounded-pill fw-bold bg-white" @onclick="LoadSales">
                <i class="bi bi-arrow-clockwise me-1"></i> REFRESH
            </button>
            <button class="btn btn-primary btn-sm rounded-pill fw-bold shadow-sm" @onclick='() => Navigation.NavigateTo("/admin/pos-terminal")'>
                OPEN POS TERMINAL
            </button>
        </div>
    </div>

    <div class="audit-main-content">
        <!-- THREE COLUMN GRID -->
        <div class="audit-workspace-container">
            @if (ActiveTab == "SALES" || ActiveTab == "ZREPORTS")
            {
                <!-- LEFT: Transaction List -->
                <div class="audit-list-panel">
                    <div class="panel-header">
                        <span>@(ActiveTab == "ZREPORTS" ? "Z-REPORTS" : "RECENT TRANSACTIONS")</span>
                        <span class="badge bg-primary text-white rounded-pill">@(ActiveTab == "ZREPORTS" ? ZReports.Count : Sales.Count)</span>
                    </div>
                    <div class="scroll-container custom-scrollbar">
                        @if (ActiveTab == "ZREPORTS")
                        {
                            @foreach (var z in ZReports)
                            {
                                <div class="sale-item @(SelectedZReport == z ? "active" : "")" @onclick="() => SelectedZReport = z">
                                    <div class="d-flex flex-column">
                                        <span class="text-muted fw-bold mb-1" style="font-size: 0.55rem; text-transform: uppercase; letter-spacing: 1px;">@z.Timestamp.ToString("ddd, MMM dd")</span>
                                        <span class="fw-black text-primary" style="font-size: 0.95rem; line-height: 1;">@GetZReportPeriod(z)</span>
                                        <div class="terminal mt-1">@z.TerminalName</div>
                                        <div class="bartender">@z.BartenderName</div>
                                    </div>
                                    <div class="text-end">
                                        <div class="sale-amount">@z.TotalGrossSales.ToString("C")</div>
                                        <div class="small text-muted" style="font-size: 0.6rem;">CASH: @z.CashTotal.ToString("C")</div>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            @foreach (var sale in Sales)
                            {
                                <div class="sale-item @(SelectedSale == sale ? "active" : "")" @onclick="() => SelectedSale = sale">
                                    <div class="d-flex flex-column">
                                        <span class="text-muted fw-bold mb-1" style="font-size: 0.55rem; text-transform: uppercase; letter-spacing: 1px;">@sale.Timestamp.ToString("ddd, MMM dd")</span>
                                        <span class="fw-black text-primary" style="font-size: 1.1rem; line-height: 1;">@sale.Timestamp.ToString("h:mm tt")</span>
                                        <div class="terminal mt-1">@sale.TerminalName</div>
                                        <div class="bartender">by @sale.BartenderName</div>
                                    </div>
                                    <div class="sale-amount">@sale.TotalAmount.ToString("C")</div>
                                </div>
                            }
                        }
                    </div>
                </div>
            }
            @if (ActiveTab == "TOKENS")
            {
                <!-- LEFT: Redemption Breakdown List (Full Height) -->
                <div class="audit-list-panel" style="width: 550px;">
                    <div class="panel-header">
                        <span>REDEMPTION BREAKDOWN (WHERE TOKENS GO)</span>
                        <span class="badge bg-primary text-white rounded-pill">@TokenUsages.Sum(x => x.Quantity)</span>
                    </div>
                    <div class="scroll-container custom-scrollbar" style="overflow-y: auto;">
                        <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
                            <thead class="bg-light sticky-top">
                                <tr>
                                    <th class="ps-4 py-2">DRINK PURCHASED</th>
                                    <th class="text-center py-2">QTY</th>
                                    <th class="text-center py-2">VAL</th>
                                    <th class="pe-4 text-end py-2">GAP</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var u in TokenUsages.OrderBy(x => x.TotalProfitLoss))
                                {
                                    <tr>
                                        <td class="ps-4 py-3">
                                            <div class="fw-bold">@u.DrinkName</div>
                                            <div class="small text-muted d-flex align-items-center">
                                                @u.TokenName 
                                                @if (u.IsUpgrade) {
                                                    <span class="ms-1 badge bg-info-subtle text-info rounded-pill" style="font-size: 0.55rem; padding: 2px 5px;">UPG</span>
                                                }
                                            </div>
                                        </td>
                                        <td class="text-center py-3 fw-black">@u.Quantity</td>
                                        <td class="text-center py-3 text-muted">@u.MenuPrice.ToString("N2")</td>
                                        <td class="pe-4 text-end py-3">
                                            <span class="fw-black @(u.ProfitLossPerUnit >= 0 ? "text-success" : "text-danger")">
                                                @(u.ProfitLossPerUnit >= 0 ? "+" : "")@u.ProfitLossPerUnit.ToString("N2")
                                            </span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
    <!-- MIDDLE: Receipt Viewer or Z-Report -->
                <div class="audit-viewer-panel custom-scrollbar">
                    @if (ActiveTab == "ZREPORTS")
                    {
                        @if (SelectedZReport != null)
                        {
                            <div class="d-flex gap-4 p-4 w-100 animate-fade-in" style="max-width: 1200px;">
                                <!-- RECEIPT PORTION -->
                                <div style="flex: 0 0 340px;">
                                    <div class="receipt-paper shadow-lg">
                                        <div class="receipt-header">
                                            <div class="brand">GFC Z-REPORT</div>
                                            <div class="fw-black text-uppercase">@SelectedZReport.TerminalName</div>
                                            <div class="timestamp">@SelectedZReport.Timestamp.ToString("f")</div>
                                            <div class="bart">Bartender: @SelectedZReport.BartenderName</div>
                                        </div>

                                        <div class="receipt-body">
                                            <div class="sidebar-label mt-4">FINANCIAL SUMMARY</div>
                                            @{
                                                var banquets = ParseBanquets(SelectedZReport.BanquetSummaryJson);
                                                var totalPrepaidDeposits = banquets.Sum(b => b.Deposits?.Sum() ?? 0);
                                            }
                                            @if (totalPrepaidDeposits > 0)
                                            {
                                                <div class="receipt-item" style="color: #15803d; font-weight: bold;">
                                                    <span class="name">PREPAID FUNDS ADDED</span>
                                                    <span class="price">+ @totalPrepaidDeposits.ToString("C")</span>
                                                </div>
                                            }
                                            <div class="receipt-item">
                                                <span class="name">GROSS SALES</span>
                                                <span class="price">@SelectedZReport.TotalGrossSales.ToString("C")</span>
                                            </div>
                                             @if (SelectedZReport.TokenCredits.GetValueOrDefault() > 0)
                                             {
                                                 <div class="receipt-item" style="color: #991b1b;">
                                                     <span class="name">TOKEN CREDITS</span>
                                                     <span class="price">- @SelectedZReport.TokenCredits.GetValueOrDefault().ToString("C")</span>
                                                 </div>
                                             }
                                            <div class="receipt-item" style="border-top: 1px solid #000; margin-top:4px; font-weight:bold;">
                                                <span class="name">CASH IN DRAWER</span>
                                                <span class="price">@SelectedZReport.CashTotal.ToString("C")</span>
                                            </div>

                                            <div class="sidebar-label mt-4">SHIFT BREAKDOWN</div>
                                            @foreach (var item in GetItemsList(SelectedZReport.SalesSummaryJson))
                                            {
                                                <div class="receipt-item">
                                                    <span class="qty">@item.Quantity x</span>
                                                    <span class="name">@item.Name</span>
                                                </div>
                                            }
                                        </div>

                                        <div class="receipt-footer">
                                            <div class="total-row">
                                                <span>TOTAL SALES</span>
                                                <span>@SelectedZReport.TotalGrossSales.ToString("C")</span>
                                            </div>
                                            <div class="ref-id mt-3">REF: @SelectedZReport.Id.ToString().ToUpper()</div>
                                        </div>
                                    </div>
                                </div>

                                <!-- DASHBOARD PORTION -->
                                <div class="flex-grow-1">
                                    <!-- Sales Activity -->
                                    <div class="bg-white rounded-4 border p-4 mb-4 shadow-sm">
                                        <div class="d-flex align-items-center gap-2 mb-3">
                                            <i class="bi bi-list-task text-primary fs-5"></i>
                                            <span class="fw-black text-muted" style="font-size: 0.75rem; letter-spacing: 1px;">POS SALES ACTIVITY</span>
                                        </div>
                                        <div class="table-responsive">
                                            <table class="table table-sm table-borderless align-middle mb-0">
                                                <thead>
                                                    <tr class="border-bottom">
                                                        <th class="text-muted small pb-2">ITEM NAME</th>
                                                        <th class="text-center text-muted small pb-2">QTY</th>
                                                        <th class="text-end text-muted small pb-2">REVENUE</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var item in GetItemsList(SelectedZReport.SalesSummaryJson))
                                                    {
                                                        <tr class="border-bottom-faint">
                                                            <td class="fw-bold py-2" style="font-size: 0.85rem;">@item.Name</td>
                                                            <td class="text-center py-2">
                                                                <span class="badge bg-light text-primary rounded-pill fw-black">@item.Quantity</span>
                                                            </td>
                                                            <td class="text-end py-2 fw-black" style="font-size: 0.85rem;">@((item.Price * item.Quantity).ToString("C"))</td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>

                                    <!-- Inventory Pulls -->
                                    <div class="bg-white rounded-4 border p-4 shadow-sm">
                                        <div class="d-flex align-items-center gap-2 mb-3">
                                            <i class="bi bi-box-seam text-primary fs-5"></i>
                                            <span class="fw-black text-muted" style="font-size: 0.75rem; letter-spacing: 1px;">INVENTORY REMOVAL LOG</span>
                                        </div>
                                        <div class="table-responsive">
                                            <table class="table table-sm table-borderless align-middle mb-0">
                                                <thead>
                                                    <tr class="border-bottom">
                                                        <th class="text-muted small pb-2">BOTTLE NAME</th>
                                                        <th class="text-end text-muted small pb-2">PULLED</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @{
                                                        var pulls = GetPullsList(SelectedZReport.InventoryPullsJson);
                                                        if (!pulls.Any())
                                                        {
                                                            <tr><td colspan="2" class="text-center py-3 text-muted small italic">No inventory pulls recorded this shift.</td></tr>
                                                        }
                                                        else
                                                        {
                                                            @foreach (var p in pulls)
                                                            {
                                                                <tr class="border-bottom-faint">
                                                                    <td class="fw-bold py-2" style="font-size: 0.85rem;">@p.Name</td>
                                                                    <td class="text-end py-2">
                                                                        <span class="badge bg-primary text-white rounded-pill fw-black">@p.Quantity</span>
                                                                    </td>
                                                                </tr>
                                                            }
                                                        }
                                                    }
                                                </tbody>
                                            </table>
                                       </div>
                                </div>

                                <!-- Event Activity Log -->
                                @if (banquets != null && banquets.Any())
                                {
                                    <div class="bg-white rounded-4 border p-4 mt-4 shadow-sm animate-fade-in">
                                        <div class="d-flex align-items-center gap-2 mb-3">
                                            <i class="bi bi-calendar-event text-primary fs-5"></i>
                                            <span class="fw-black text-muted" style="font-size: 0.75rem; letter-spacing: 1px;">EVENT ACTIVITY LOG</span>
                                        </div>
                                        @foreach (var b in banquets)
                                        {
                                            <div class="border rounded-4 overflow-hidden mb-3 bg-white shadow-sm">
                                                <div class="bg-light p-3 border-bottom d-flex justify-content-between align-items-center">
                                                    <span class="fw-black text-primary small">EVENT: @b.EventName.ToUpper()</span>
                                                    <span class="badge bg-primary text-white fw-black">TOTAL SPENT: @b.TotalSpent.ToString("C")</span>
                                                </div>
                                                <div class="p-3">
                                                    <div class="row">
                                                        @if (b.EventType != "RunningTab")
                                                        {
                                                            <div class="col-md-6 border-end">
                                                                <small class="text-muted fw-bold text-uppercase d-block mb-2" style="font-size: 0.7rem;">Deposits Logged</small>
                                                                @if (b.Deposits == null || !b.Deposits.Any())
                                                                {
                                                                    <div class="text-muted small italic">No deposits logged.</div>
                                                                }
                                                                else
                                                                {
                                                                    @foreach (var dep in b.Deposits)
                                                                    {
                                                                        <div class="d-flex justify-content-between small mb-1">
                                                                            <span class="fw-bold text-muted">- Add Funds</span>
                                                                            <span class="fw-black">@dep.ToString("C")</span>
                                                                        </div>
                                                                    }
                                                                }
                                                            </div>
                                                            <div class="col-md-6">
                                                                <small class="text-muted fw-bold text-uppercase d-block mb-2" style="font-size: 0.7rem;">Tab Purchases Summary</small>
                                                                @foreach (var item in (b.ItemSummary ?? new Dictionary<string, int>()).OrderByDescending(x => x.Value))
                                                                {
                                                                    <div class="d-flex justify-content-between small mb-1">
                                                                        <span class="fw-bold">@item.Key.ToUpper()</span>
                                                                        <span class="badge bg-light text-primary border fw-black" style="font-size: 0.7rem;">x @item.Value</span>
                                                                    </div>
                                                                }
                                                            </div>
                                                        }
                                                        else
                                                        {
                                                            <div class="col-md-12">
                                                                <small class="text-muted fw-bold text-uppercase d-block mb-2" style="font-size: 0.7rem;">Tab Purchases Summary</small>
                                                                @foreach (var item in (b.ItemSummary ?? new Dictionary<string, int>()).OrderByDescending(x => x.Value))
                                                                {
                                                                    <div class="d-flex justify-content-between small mb-1">
                                                                        <span class="fw-bold">@item.Key.ToUpper()</span>
                                                                        <span class="badge bg-light text-primary border fw-black" style="font-size: 0.7rem;">x @item.Value</span>
                                                                    </div>
                                                                }
                                                            </div>
                                                        }
                                                    </div>
                                                    <div class="mt-3 pt-3 border-top d-flex justify-content-between align-items-center">
                                                        @{
                                                            var isRunningTab = b.EventType == "RunningTab" || b.EventName.EndsWith(" [Direct]") || b.EventName.EndsWith("[Direct]");
                                                            var remaining = (b.Deposits?.Sum() ?? 0) - b.TotalSpent;
                                                        }
                                                        @if (isRunningTab)
                                                        {
                                                            <span class="fw-bold text-muted small">TOTAL DUE</span>
                                                            <span class="fw-black text-dark fs-5">@b.TotalSpent.ToString("C")</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="fw-bold text-muted small">TAB BALANCE</span>
                                                            <span class="fw-black fs-5 @(remaining < 0 ? "text-danger" : "text-success")">@remaining.ToString("C")</span>
                                                        }
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                            </div>
                    }
                    }
                    else if (ActiveTab == "SALES")
                    {
                        @if (SelectedSale != null)
                        {
                            <div class="receipt-stage animate-fade-in">
                                <div class="receipt-paper shadow-lg">
                                    <div class="receipt-header">
                                        <div class="brand">GFC POS</div>
                                        <div class="fw-black text-uppercase">@SelectedSale.TerminalName</div>
                                        <div class="timestamp">@SelectedSale.Timestamp.ToString("f")</div>
                                        <div class="bart">Bartender: @SelectedSale.BartenderName</div>
                                    </div>

                                    <div class="receipt-body">
                                        <div class="section-title">ITEMS</div>
                                        @foreach (var item in GetItemsList(SelectedSale.ItemsJson))
                                        {
                                            <div class="receipt-item">
                                                <span class="qty">@item.Quantity x</span>
                                                <span class="name">@item.Name</span>
                                                <span class="price">@((item.Price * item.Quantity).ToString("C"))</span>
                                            </div>
                                            @if (item.Modifiers != null && item.Modifiers.Any())
                                            {
                                                @foreach (var mod in item.Modifiers)
                                                {
                                                    <div class="receipt-item ps-4 text-muted" style="border-bottom: none; padding-top: 1px; padding-bottom: 1px; font-size: 0.8rem;">
                                                        <span class="qty" style="font-weight: normal;">@mod.Quantity x</span>
                                                        <span class="name" style="text-transform: uppercase; font-style: italic; color: #7c3aed; font-weight: normal;">+ @mod.Name</span>
                                                        <span class="price" style="font-weight: normal;">@((mod.Price * mod.Quantity).ToString("C"))</span>
                                                    </div>
                                                }
                                            }
                                        }
                                    </div>

                                    <div class="receipt-footer">
                                        <div class="total-row">
                                            <span>TOTAL AMOUNT</span>
                                            <span>@SelectedSale.TotalAmount.ToString("C")</span>
                                        </div>
                                        <div class="ref-id">TXN ID: @SelectedSale.Id.ToString().ToUpper()</div>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    else if (ActiveTab == "TOKENS")
                    {
                        <!-- MIDDLE (EXPANDED): Token Analysis View -->
                        <div class="audit-recon-panel bg-white border-end">
                            <div class="px-5 pt-4 pb-3 flex-shrink-0">
                                <div class="d-flex justify-content-between align-items-center">
                                    <h4 class="fw-black mb-0 text-primary">TOKEN FINANCIAL & LIABILITY ANALYSIS</h4>
                                    <div class="d-flex gap-2">
                                        <div class="badge bg-light text-primary p-2 rounded-pill px-3 fw-bold border">
                                            <i class="bi bi-info-circle me-2"></i>Tracking Lifetime Liability vs Financial Yield
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="flex-grow-1 custom-scrollbar px-5 pb-5" style="overflow-y: auto;">
                                <!-- TOP OVERVIEW CARDS -->
                                <div class="row g-4 mb-5">
                                    <div class="col-md-3">
                                        <div class="stat-card h-100 bg-light border-0 shadow-sm" style="border-radius: 24px;">
                                            <div class="label">TOTAL TOKENS SOLD</div>
                                            <div class="value" style="font-size: 2rem;">@(TokenYields.Sum(x => x.TotalSold))</div>
                                            <div class="small text-muted mt-2">Including @(TokenYields.Sum(x => x.StartingBalance)) legacy adjustments</div>
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <div class="stat-card h-100 bg-light border-0 shadow-sm" style="border-radius: 24px;">
                                            <div class="label">TOTAL REDEEMED</div>
                                            <div class="value" style="font-size: 2rem;">@(TokenYields.Sum(x => x.Redeemed))</div>
                                            <div class="small text-muted mt-2">Physical tokens collected</div>
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <div class="stat-card h-100 bg-primary text-white border-0 shadow-lg" style="border-radius: 24px;">
                                            <div class="label text-white opacity-75">IN CIRCULATION</div>
                                            <div class="value text-white" style="font-size: 2.2rem;">@(TokenYields.Sum(x => x.InCirculation))</div>
                                            <div class="small opacity-75 mt-2">Active liability in pockets</div>
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <div class="stat-card h-100 @(TokenYields.Sum(x => x.NetFinancialImpact) >= 0 ? "bg-success" : "bg-danger") text-white border-0 shadow-lg" style="border-radius: 24px;">
                                            <div class="label text-white opacity-75">NET FINANCIAL IMPACT</div>
                                            <div class="value text-white" style="font-size: 2rem;">@(TokenYields.Sum(x => x.NetFinancialImpact).ToString("C"))</div>
                                            <div class="small opacity-75 mt-2">Revenue vs Menu Value Gap</div>
                                        </div>
                                    </div>
                                </div>

                                <h5 class="fw-black mb-3 text-muted" style="letter-spacing: 1px;">TOKEN INVENTORY & LIABILITY</h5>
                                <table class="table table-hover align-middle border rounded-4 mb-5">
                                    <thead class="bg-light">
                                        <tr>
                                            <th class="ps-4 py-3">TOKEN NAME</th>
                                            <th class="text-center py-3">SOLD (POS)</th>
                                            <th class="text-center py-3">LEGACY ADJ.</th>
                                            <th class="text-center py-3">REDEEMED</th>
                                            <th class="text-center py-3">IN CIRCULATION</th>
                                            <th class="text-center py-3">FINANCIAL YIELD</th>
                                            <th class="pe-4 text-end py-3">ACTIONS</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var y in TokenYields)
                                        {
                                            <tr>
                                                <td class="ps-4">
                                                    <div class="d-flex align-items-center gap-3">
                                                        <div class="token-swatch shadow-sm" style="background: @y.Token.ColorHex; width: 12px; height: 12px; border-radius: 50%;"></div>
                                                        <span class="fw-black fs-5">@y.Token.Name</span>
                                                    </div>
                                                </td>
                                                <td class="text-center fw-bold">@y.Sold</td>
                                                <td class="text-center">
                                                    <span class="badge bg-light text-muted border rounded-pill">+ @y.StartingBalance</span>
                                                </td>
                                                <td class="text-center fw-bold text-primary">@y.Redeemed</td>
                                                <td class="text-center">
                                                    <span class="badge @(y.InCirculation < 0 ? "bg-danger" : "bg-primary") rounded-pill px-3">@y.InCirculation</span>
                                                </td>
                                                <td class="text-center fw-black @(y.NetFinancialImpact >= 0 ? "text-success" : "text-danger")">
                                                    @y.NetFinancialImpact.ToString("C")
                                                </td>
                                                <td class="pe-4 text-end">
                                                    <button class="btn btn-outline-secondary btn-sm rounded-pill fw-bold" @onclick="() => OpenAdjustmentModal(y.Token)">
                                                        <i class="bi bi-pencil-square me-1"></i> ADJUST
                                                    </button>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    }
                    else if (ActiveTab == "INVENTORY")
                    {
                        <!-- MIDDLE (EXPANDED): Reconciliation View -->
                        <div class="audit-recon-panel bg-white border-end">
                            <div class="px-5 pt-4 pb-3 flex-shrink-0">
                                <div class="d-flex justify-content-between align-items-center">
                                    <h4 class="fw-black mb-0 text-primary">BOTTLE YIELD ANALYSIS</h4>
                                    <div class="badge bg-light text-primary p-2 rounded-pill px-3 fw-bold border">
                                        @{
                                            decimal pourSize = _settings?.GlobalLiquorPourSize ?? 1.5m;
                                            int shotsPerLtr = (int)(33.8m / (pourSize > 0 ? pourSize : 1.5m));
                                        }
                                        <i class="bi bi-info-circle me-2"></i>Yield: @shotsPerLtr shots (@pourSize.ToString("F2")oz) / 1L
                                    </div>
                                </div>
                            </div>

                            <div class="flex-grow-1 custom-scrollbar px-5 pb-5" style="overflow-y: auto;">
                                <table class="table table-hover align-middle border mb-0">
                                    <thead class="bg-light sticky-top">
                                        <tr>
                                            <th class="ps-4">LIQUOR PRODUCT</th>
                                            <th class="text-center">DRINKS SOLD</th>
                                            <th class="text-center">BOTTLES REMOVED</th>
                                            <th class="text-center">EXPECTED SHOTS</th>
                                            <th class="pe-4 text-end">VARIANCE</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (!ReconResults.Any())
                                        {
                                            <tr><td colspan="5" class="text-center py-5 text-muted">No inventory pulls recorded.</td></tr>
                                        }
                                        else
                                        {
                                            @foreach (var r in ReconResults.OrderBy(x => x.ItemName))
                                            {
                                                var variance = r.ExpectedYield - r.DrinksSold;
                                                var yieldPercent = r.ExpectedYield > 0 ? (r.DrinksSold / (decimal)r.ExpectedYield * 100) : 100;
                                                <tr>
                                                    <td class="ps-4 fw-black">@r.ItemName</td>
                                                    <td class="text-center fw-bold">@r.DrinksSold</td>
                                                    <td class="text-center fw-bold">@r.BottlesPulled</td>
                                                    <td class="text-center text-muted">@r.ExpectedYield</td>
                                                    <td class="pe-4 text-end">
                                                        @if (variance > 2) { <span class="text-danger fw-black">-@variance.ToString("F0") SHOTS</span> }
                                                        else { <span class="text-success fw-bold">TIGHT</span> }
                                                    </td>
                                                </tr>
                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    }
                </div>

                <!-- RIGHT: Sidebar Controls -->
            <div class="audit-sidebar-panel custom-scrollbar">
                <!-- Navigation Tabs -->
                <div class="sidebar-section mb-2">
                    <div class="btn-group w-100 p-1 bg-light rounded-4 mb-2 border" style="font-size: 0.65rem;">
                        <button class="btn btn-xs @(ActiveTab == "SALES" ? "btn-primary shadow-sm" : "btn-link text-muted fw-bold text-decoration-none") rounded-pill py-2" @onclick='() => ActiveTab = "SALES"'>SALES</button>
                        <button class="btn btn-xs @(ActiveTab == "INVENTORY" ? "btn-primary shadow-sm" : "btn-link text-muted fw-bold text-decoration-none") rounded-pill py-2" @onclick='() => ActiveTab = "INVENTORY"'>YIELD</button>
                        <button class="btn btn-xs @(ActiveTab == "TOKENS" ? "btn-primary shadow-sm" : "btn-link text-muted fw-bold text-decoration-none") rounded-pill py-2" @onclick='() => ActiveTab = "TOKENS"'>TOKENS</button>
                        <button class="btn btn-xs @(ActiveTab == "ZREPORTS" ? "btn-primary shadow-sm" : "btn-link text-muted fw-bold text-decoration-none") rounded-pill py-2" @onclick='() => ActiveTab = "ZREPORTS"'>Z-REPORTS</button>

                    </div>
                </div>

                <!-- Stats Cards -->
                <div class="sidebar-section mb-2">
                    <label class="sidebar-label">REVENUE TOTALS</label>
                    <div class="stat-card mb-2 highlight p-2 px-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <div class="label m-0">TOTAL REVENUE</div>
                                <div class="value" style="font-size: 1.5rem;">@TodayTotal.ToString("C")</div>
                            </div>
                            <div class="text-end">
                                <div class="footer text-primary fw-bold m-0">Combined Feed</div>
                            </div>
                        </div>
                    </div>
                    
                    <div class="row g-2 mb-1">
                        @foreach (var station in StationTotals)
                        {
                            <div class="col-6">
                                <div class="stat-card station-stat h-100 p-2 ps-3">
                                    <div class="label" style="font-size: 0.55rem;">@station.Key</div>
                                    <div class="value" style="font-size: 0.95rem !important;">@station.Value.ToString("C")</div>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <!-- FILTERS -->
                <div class="sidebar-section mb-4">
                    <label class="sidebar-label">DATE & STATION FILTERS</label>
                    <div class="p-2 px-3 bg-light rounded-4 mb-3 border">
                        <div class="row g-2">
                            <div class="col-6 border-end">
                                <label class="small fw-black text-muted opacity-75 mb-0" style="font-size: 0.55rem;">START DATE</label>
                                <input type="date" class="form-control form-control-sm border-0 fw-bold bg-transparent p-0" @bind="StartDate" @bind:after="OnDateManualChanged" style="font-size: 0.8rem;">
                            </div>
                            <div class="col-6 ps-3">
                                <label class="small fw-black text-muted opacity-75 mb-0" style="font-size: 0.55rem;">END DATE</label>
                                <input type="date" class="form-control form-control-sm border-0 fw-bold bg-transparent p-0" @bind="EndDate" @bind:after="OnDateManualChanged" style="font-size: 0.8rem;">
                            </div>
                        </div>
                    </div>

                    <div class="row g-2 mb-2">
                        @foreach (var p in new[] { "today", "yesterday", "thisweek" })
                        {
                            <div class="col-4">
                                <button class="btn btn-xs w-100 rounded-pill fw-bold @(ActivePreset == p ? "btn-primary shadow-sm" : "btn-outline-secondary bg-white")" @onclick='() => SetPreset(p)' style="font-size: 0.65rem; padding: 6px 0;">@p.ToUpper()</button>
                            </div>
                        }
                    </div>
                    <div class="row g-2 mb-3">
                        @foreach (var p in new[] { "lastweek", "thismonth", "lastmonth" })
                        {
                            <div class="col-4">
                                <button class="btn btn-xs w-100 rounded-pill fw-bold @(ActivePreset == p ? "btn-primary shadow-sm" : "btn-outline-secondary bg-white")" @onclick='() => SetPreset(p)' style="font-size: 0.65rem; padding: 6px 0;">@p.ToUpper()</button>
                            </div>
                        }
                    </div>

                    <div class="row g-2 border-top pt-3">
                        <div class="col-4">
                            <select class="form-select border-0 bg-light fw-bold rounded-4 py-2" style="font-size: 0.85rem;" @bind="SelectedMonth" @bind:after="OnMonthYearChanged">
                                <option value="0">SELECT MONTH</option>
                                @for(int i=1; i<=12; i++) {
                                    <option value="@i">@(global::System.Globalization.DateTimeFormatInfo.CurrentInfo.GetMonthName(i).ToUpper())</option>
                                }
                            </select>
                        </div>
                        <div class="col-3">
                            <select class="form-select border-0 bg-light fw-bold rounded-4 py-2" style="font-size: 0.85rem;" @bind="SelectedYear" @bind:after="OnMonthYearChanged">
                                @for(int y=DateTime.Today.Year; y>=2024; y--) {
                                    <option value="@y">@y</option>
                                }
                            </select>
                        </div>
                        <div class="col-5">
                            <select class="form-select border-0 bg-light fw-bold rounded-4 py-2" style="font-size: 0.85rem;" @bind="FilterTerminal" @bind:after="LoadSales">
                                <option value="">ALL POS</option>
                                @foreach (var terminal in TerminalList) {
                                    <option value="@terminal">@terminal</option>
                                }
                            </select>
                        </div>
                    </div>
                </div>

                <!-- FINANCIAL INSIGHT (Integrated in sidebar) -->
                <div class="bg-primary bg-opacity-10 border-primary border-opacity-25 border rounded-4 p-4 text-primary mt-2">
                    <h6 class="fw-black mb-3"><i class="bi bi-lightbulb me-2"></i>FINANCIAL INSIGHT</h6>
                    <div class="small">
                         @{
                               var netVal = TokenYields.Sum(x => x.NetFinancialImpact);
                               var signStr = netVal < 0 ? "losing" : "making";
                               var moneyStr = Math.Abs(netVal).ToString("C");
                               var topUsage = TokenUsages.OrderBy(x => x.ProfitLossPerUnit).FirstOrDefault();
                               var topDrinkName = topUsage?.DrinkName ?? "Premium items";
                           }
                        You are currently <strong>@signStr @moneyStr</strong> on token redemptions.
                        @if (netVal < 0) {
                            <span><br/><br/>Warning: High-value items like <em>@topDrinkName</em> are causing a significant yield gap.</span>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

