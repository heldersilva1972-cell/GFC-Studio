    public class CachedSaleItem
    {
        public DateTime Timestamp { get; set; }
        public string CleanName { get; set; } = "";
        public int Quantity { get; set; }
        public decimal Price { get; set; }
        public bool IsVoided { get; set; }
    }

    private List<CachedSaleItem> _cachedSalesItems = new();

    public class AuditTrendPoint
    {
        public DateTime Date { get; set; }
        public string Label { get; set; } = "";
        public int Quantity { get; set; }
        public decimal Revenue { get; set; }
    }

    private List<AuditTrendPoint> GetProductTrendPoints(string productName)
    {
        var list = new List<AuditTrendPoint>();
        if (string.IsNullOrEmpty(productName)) return list;

        var cleanTarget = CleanProductName(productName);
        
        DateTime start = StartDate != default ? StartDate.Date : DateTime.Today.AddDays(-14);
        DateTime end = EndDate != default ? EndDate.Date : DateTime.Today;

        if (end < start) end = start;

        var targetItems = new List<(DateTime Timestamp, int Quantity, decimal Price)>();

        if (_cachedSalesItems != null && _cachedSalesItems.Any())
        {
            foreach (var item in _cachedSalesItems)
            {
                if (!item.IsVoided && (item.CleanName.Equals(cleanTarget, StringComparison.OrdinalIgnoreCase) || item.CleanName.Contains(cleanTarget, StringComparison.OrdinalIgnoreCase)))
                {
                    targetItems.Add((item.Timestamp, item.Quantity, item.Price));
                }
            }
        }

        if (!targetItems.Any())
        {
            var salesSource = (_allSalesForStats != null && _allSalesForStats.Any()) ? _allSalesForStats : Sales;
            if (salesSource != null)
            {
                foreach (var sale in salesSource.Where(s => !s.IsVoided))
                {
                    foreach (var sItem in GetItemsList(sale.ItemsJson))
                    {
                        var cName = CleanProductName(sItem.Name);
                        if (cName.Equals(cleanTarget, StringComparison.OrdinalIgnoreCase) || cName.Contains(cleanTarget, StringComparison.OrdinalIgnoreCase))
                        {
                            decimal price = sItem.Price;
                            if (price == 0)
                            {
                                var matchedDbItem = DbLiquorItems.FirstOrDefault(i => i.Name != null && i.Name.Equals(cName, StringComparison.OrdinalIgnoreCase));
                                if (matchedDbItem != null) price = matchedDbItem.CurrentPrice > 0 ? matchedDbItem.CurrentPrice : matchedDbItem.RetailPrice;
                            }
                            targetItems.Add((sale.Timestamp, sItem.Quantity, price));
                        }
                    }
                }
            }
        }

        bool isMonthly = ActivePreset == "thisyear" || (end - start).TotalDays > 60;

        if (isMonthly)
        {
            var m = new DateTime(start.Year, start.Month, 1);
            var endM = new DateTime(end.Year, end.Month, 1);

            while (m <= endM)
            {
                var nextM = m.AddMonths(1);
                var monthMatches = targetItems.Where(x => x.Timestamp >= m && x.Timestamp < nextM);

                int mQty = monthMatches.Sum(x => x.Quantity);
                decimal mRev = monthMatches.Sum(x => x.Quantity * x.Price);

                list.Add(new AuditTrendPoint
                {
                    Date = m,
                    Label = start.Year != end.Year ? m.ToString("MMM yy").ToUpper() : m.ToString("MMM").ToUpper(),
                    Quantity = mQty,
                    Revenue = mRev
                });

                m = nextM;
            }
        }
        else
        {
            for (var day = start; day <= end; day = day.AddDays(1))
            {
                var nextDay = day.AddDays(1);
                var dayMatches = targetItems.Where(x => x.Timestamp >= day && x.Timestamp < nextDay);

                int dayQty = dayMatches.Sum(x => x.Quantity);
                decimal dayRev = dayMatches.Sum(x => x.Quantity * x.Price);

                list.Add(new AuditTrendPoint
                {
                    Date = day,
                    Label = day.ToString("MM/dd"),
                    Quantity = dayQty,
                    Revenue = dayRev
                });
            }
        }

        return list;
    }

    private (string areaPath, string linePath, int maxQty, double width, double height, List<(double x, double y, AuditTrendPoint pt, bool showLabel)> points) CalculateTrendSvgData(List<AuditTrendPoint> trendPoints)
    {
        if (!trendPoints.Any()) return ("", "", 0, 1000, 250, new());

        double width = 1000;
        double height = 250;
        double paddingLeft = 55;
        double paddingRight = 55;
        double paddingTop = 35;
        double paddingBottom = 70;

        int maxQty = Math.Max(5, trendPoints.Max(p => p.Quantity));
        double usableWidth = width - paddingLeft - paddingRight;
        double usableHeight = height - paddingTop - paddingBottom;

        int labelInterval = 1;
        if (trendPoints.Count > 40) labelInterval = 4;
        else if (trendPoints.Count > 25) labelInterval = 3;
        else if (trendPoints.Count > 15) labelInterval = 2;

        var coords = new List<(double x, double y, AuditTrendPoint pt, bool showLabel)>();
        double step = usableWidth / Math.Max(1, trendPoints.Count - 1);

        for (int i = 0; i < trendPoints.Count; i++)
        {
            var pt = trendPoints[i];
            double x = paddingLeft + (i * step);
            double y = (height - paddingBottom) - ((double)pt.Quantity / maxQty * usableHeight);
            
            bool showLabel = (i == 0) || (i == trendPoints.Count - 1) || (i % labelInterval == 0);
            coords.Add((x, y, pt, showLabel));
        }

        string linePath = "M " + string.Join(" L ", coords.Select(c => $"{c.x:F1},{c.y:F1}"));
        string areaPath = linePath + $" L {coords.Last().x:F1},{(height - paddingBottom):F1} L {coords.First().x:F1},{(height - paddingBottom):F1} Z";

        return (areaPath, linePath, maxQty, width, height, coords);
    }

    private bool _multiProductMode = false;
    private HashSet<string> _selectedMultiTrendProducts = new(StringComparer.OrdinalIgnoreCase);

    private static readonly string[] MultiProductColors = new[]
    {
        "#2563eb", "#16a34a", "#dc2626", "#d97706", "#9333ea",
        "#0891b2", "#ec4899", "#65a30d", "#4f46e5", "#c026d3",
        "#059669", "#ea580c", "#0284c7", "#7c3aed", "#b45309"
    };

    private void SetSingleProductMode()
    {
        _multiProductMode = false;
        StateHasChanged();
    }

    private void SelectTopProducts(int count)
    {
        _multiProductMode = true;
        _selectedMultiTrendProducts.Clear();
        var active = _auditProductMetrics.Where(x => IsItemInSelectedCategory(x)).OrderByDescending(p => p.Quantity).Take(count).ToList();
        if (!active.Any())
        {
            active = _auditProductMetrics.OrderByDescending(p => p.Quantity).Take(count).ToList();
        }

        foreach (var p in active)
        {
            _selectedMultiTrendProducts.Add(p.Name);
        }
        if (active.Any())
        {
            _selectedAuditTrendProductName = active.First().Name;
        }
        StateHasChanged();
    }

    private void ToggleMultiProductSelection(string productName)
    {
        _multiProductMode = true;
        if (_selectedMultiTrendProducts.Contains(productName))
        {
            _selectedMultiTrendProducts.Remove(productName);
        }
        else
        {
            if (_selectedMultiTrendProducts.Count < 15)
            {
                _selectedMultiTrendProducts.Add(productName);
            }
        }
        StateHasChanged();
    }

    public class MultiProductSeriesData
    {
        public string ProductName { get; set; } = "";
        public string Color { get; set; } = "#2563eb";
        public string LinePath { get; set; } = "";
        public List<(double x, double y, AuditTrendPoint pt, bool showLabel)> Coords { get; set; } = new();
    }

    private (List<MultiProductSeriesData> SeriesList, int MaxQty, double Width, double Height, List<(double x, string Label, DateTime Date, bool showLabel)> Dates) CalculateMultiTrendSvgData(List<string> productNames)
    {
        double width = 1000;
        double height = 250;
        double paddingLeft = 55;
        double paddingRight = 55;
        double paddingTop = 35;
        double paddingBottom = 70;

        var result = new List<MultiProductSeriesData>();
        var allProductPoints = new Dictionary<string, List<AuditTrendPoint>>();

        foreach (var name in productNames)
        {
            allProductPoints[name] = GetProductTrendPoints(name);
        }

        int overallMaxQty = 5;
        foreach (var pts in allProductPoints.Values)
        {
            if (pts.Any())
            {
                int maxP = pts.Max(p => p.Quantity);
                if (maxP > overallMaxQty) overallMaxQty = maxP;
            }
        }

        var sampleList = allProductPoints.Values.FirstOrDefault() ?? new();
        int dayCount = sampleList.Count;

        double usableWidth = width - paddingLeft - paddingRight;
        double usableHeight = height - paddingTop - paddingBottom;

        int labelInterval = 1;
        if (dayCount > 40) labelInterval = 4;
        else if (dayCount > 25) labelInterval = 3;
        else if (dayCount > 15) labelInterval = 2;

        var dates = new List<(double x, string Label, DateTime Date, bool showLabel)>();
        double step = usableWidth / Math.Max(1, dayCount - 1);

        for (int i = 0; i < dayCount; i++)
        {
            double x = paddingLeft + (i * step);
            string lbl = sampleList.Any() && i < sampleList.Count ? sampleList[i].Label : "";
            DateTime dt = sampleList.Any() && i < sampleList.Count ? sampleList[i].Date : DateTime.Today;
            bool showLabel = (i == 0) || (i == dayCount - 1) || (i % labelInterval == 0);
            dates.Add((x, lbl, dt, showLabel));
        }

        int colorIdx = 0;
        foreach (var kvp in allProductPoints)
        {
            string pName = kvp.Key;
            var pts = kvp.Value;
            string color = MultiProductColors[colorIdx % MultiProductColors.Length];
            colorIdx++;

            var coords = new List<(double x, double y, AuditTrendPoint pt, bool showLabel)>();
            for (int i = 0; i < pts.Count; i++)
            {
                var pt = pts[i];
                double x = paddingLeft + (i * step);
                double y = (height - paddingBottom) - ((double)pt.Quantity / overallMaxQty * usableHeight);
                bool showLabel = (i == 0) || (i == dayCount - 1) || (i % labelInterval == 0);
                coords.Add((x, y, pt, showLabel));
            }

            string linePath = "M " + string.Join(" L ", coords.Select(c => $"{c.x:F1},{c.y:F1}"));
            result.Add(new MultiProductSeriesData
            {
                ProductName = pName,
                Color = color,
                LinePath = linePath,
                Coords = coords
            });
        }

        return (result, overallMaxQty, width, height, dates);
    }

    private void ExportReorderPurchaseSheet()
    {
        // Simple trigger notification or download simulation for Reorder PO
        var urgentItems = GetFilteredAuditReorderMetrics().Where(x => x.GetNetUnitsNeeded(_reorderPredictionMode) > 0).ToList();
        JSRuntime.InvokeVoidAsync("alert", $"Exporting Purchase Order sheet for {urgentItems.Count} urgent reorder items.");
    }
