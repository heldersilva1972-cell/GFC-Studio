                                                <div class="d-flex align-items-center gap-2 flex-wrap">
                                                    <!-- Preset Buttons -->
                                                    <div class="btn-group btn-group-sm rounded-pill p-1 bg-light border shadow-xs">
                                                        <button type="button" class="btn btn-sm rounded-pill px-3 fw-bold @(_auditShotSize == 1.25m ? "btn-primary shadow-xs" : "btn-light text-secondary")" @onclick="() => SetAuditShotSize(1.25m)">
                                                            1.25 oz <span class="opacity-75 font-monospace" style="font-size: 0.65rem;">(27/L)</span>
                                                        </button>
                                                        <button type="button" class="btn btn-sm rounded-pill px-3 fw-bold @(_auditShotSize == 1.50m ? "btn-primary shadow-xs" : "btn-light text-secondary")" @onclick="() => SetAuditShotSize(1.50m)">
                                                            1.50 oz <span class="opacity-75 font-monospace" style="font-size: 0.65rem;">(22/L)</span>
                                                        </button>
                                                        <button type="button" class="btn btn-sm rounded-pill px-3 fw-bold @(_auditShotSize == 1.75m ? "btn-primary shadow-xs" : "btn-light text-secondary")" @onclick="() => SetAuditShotSize(1.75m)">
                                                            1.75 oz <span class="opacity-75 font-monospace" style="font-size: 0.65rem;">(19/L)</span>
                                                        </button>
                                                        <button type="button" class="btn btn-sm rounded-pill px-3 fw-bold @(_auditShotSize == 2.00m ? "btn-primary shadow-xs" : "btn-light text-secondary")" @onclick="() => SetAuditShotSize(2.00m)">
                                                            2.00 oz <span class="opacity-75 font-monospace" style="font-size: 0.65rem;">(16/L)</span>
                                                        </button>
                                                    </div>

                                                    <!-- Custom Input -->
                                                    <div class="input-group input-group-sm" style="width: 145px;">
                                                        <input type="number" step="0.05" min="0.5" max="5.0" class="form-control fw-bold text-center" @bind="_auditShotSize" />
                                                        <span class="input-group-text bg-light text-muted fw-bold">oz</span>
                                                        <button type="button" class="btn btn-primary fw-bold" @onclick="() => SetAuditShotSize(_auditShotSize)" title="Apply Custom Pour Size">
                                                            <i class="bi bi-check2"></i>
                                                        </button>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <p class="text-muted small mb-3 fw-bold"><i class="bi bi-funnel-fill me-1 text-primary"></i>Category & Liquor Item Inclusion Filters:</p>
                                        
                                        <div class="row g-4" style="max-height: 400px; overflow-y: auto; scrollbar-width: thin;">
