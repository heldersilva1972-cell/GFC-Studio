    private List<DartsRoundAuditDto> GetDartsRoundsAudit()
    {
        var list = new List<DartsRoundAuditDto>();
        var dartsSales = Sales
            .Where(s => s.ItemsJson != null && s.ItemsJson.Contains("(DARTS"))
            .ToList();

        foreach (var s in dartsSales)
        {
            var items = new List<DartsItemDto>();
            try
            {
                if (!string.IsNullOrEmpty(s.ItemsJson))
                    items = JsonSerializer.Deserialize<List<DartsItemDto>>(s.ItemsJson, new JsonSerializerOptions { PropertyNameCaseInsensitive = true }) ?? new();
            }
            catch {}

            string teamName = "Team 1";
            if (s.ItemsJson != null)
            {
                if (s.ItemsJson.Contains("(DARTS - Team 1)")) teamName = "Team 1";
                else if (s.ItemsJson.Contains("(DARTS - Team 2)")) teamName = "Team 2";
                else if (s.ItemsJson.Contains("(DARTS - Team 3)")) teamName = "Team 3";
                else if (s.ItemsJson.Contains("(DARTS)")) teamName = "Team 1";
            }

            decimal wholesaleTotal = 0m;
            decimal retailTotal = 0m;

            foreach (var item in items)
            {
                var clean = item.Name ?? "";
                if (clean.Contains(" (")) clean = clean.Substring(0, clean.IndexOf(" (")).Trim();

                var matched = DbLiquorItems.FirstOrDefault(i => i.Name != null && i.Name.Equals(clean, StringComparison.OrdinalIgnoreCase));
                decimal unitWholesale = 0m;
                decimal unitRetail = item.Price > 0 ? item.Price : 0m;

                if (matched != null)
                {
                    var parentItem = (matched.ParentItemId.HasValue && matched.ParentItemId.Value > 0)
                        ? (DbLiquorItems.FirstOrDefault(p => p.Id == matched.ParentItemId.Value) ?? matched)
                        : matched;

                    if (unitRetail == 0) unitRetail = matched.RetailPrice > 0 ? matched.RetailPrice : parentItem.RetailPrice;

                    if (matched.IsUnitBased || matched.IsBeer || string.Equals(matched.Category, "BEER", StringComparison.OrdinalIgnoreCase))
                    {
                        var costSource = matched.CurrentPrice > 0 ? matched : parentItem;
                        if (costSource.CurrentPrice > 0)
                        {
                            unitWholesale = costSource.PackSize > 1 ? costSource.CurrentPrice / costSource.PackSize : costSource.CurrentPrice;
                        }
                    }
                    else
                    {
                        // Liquor / Wine / Pour-based items
                        var costSource = parentItem.CurrentPrice > 0 ? parentItem : matched;
                        if (costSource.CurrentPrice > 0)
                        {
                            decimal bottleOz = costSource.BottleVolumeOunces ?? 0m;
                            if (bottleOz <= 0)
                            {
                                string bSize = costSource.BottleSize ?? "1L";
                                if (bSize.Contains("750")) bottleOz = 25.4m;
                                else if (bSize.Contains("1.75")) bottleOz = 59.2m;
                                else bottleOz = 33.8m;
                            }

                            decimal pourOz = matched.PourVolumeOunces ?? matched.PourSize;
                            if (pourOz <= 0) pourOz = costSource.PourVolumeOunces ?? costSource.PourSize;
                            if (pourOz <= 0) pourOz = 1.5m;

                            if (bottleOz > 0)
                            {
                                unitWholesale = (costSource.CurrentPrice / bottleOz) * pourOz;
                            }
                            else
                            {
                                unitWholesale = costSource.PackSize > 1 ? costSource.CurrentPrice / costSource.PackSize : costSource.CurrentPrice;
                            }
                        }
                    }
                }

                wholesaleTotal += item.Quantity * unitWholesale;
                retailTotal += item.Quantity * unitRetail;
            }

            list.Add(new DartsRoundAuditDto
            {
                Id = s.Id,
                Timestamp = s.Timestamp,
                TerminalName = s.TerminalName ?? "TERMINAL 1",
                BartenderName = s.BartenderName ?? "N/A",
                TeamName = teamName,
                Items = items,
                WholesaleCost = wholesaleTotal,
                RetailValue = retailTotal
            });
        }

        return list.OrderByDescending(x => x.Timestamp).ToList();
    }

    private async Task SetInventorySubTab(string tab)
    {
        _inventorySubTab = tab;
        if (tab == "product_trends")
        {
            if (ActivePreset != "thismonth" && ActivePreset != "lastmonth" && ActivePreset != "thisyear")
            {
                await SetPreset("thismonth");
            }
            else
            {
                BuildProductAuditMetrics();
                if (_productTrendsSubView == "VELOCITY" && _velocityViewMode == "CHART")
                {
                    await Task.Delay(100);
                    await RenderVelocityMovementChart();
                }
                StateHasChanged();
            }
