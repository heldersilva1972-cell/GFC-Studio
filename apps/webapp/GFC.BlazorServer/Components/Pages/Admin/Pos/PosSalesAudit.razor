    private async Task LoadRevenueAnalysisData()
    {
        if (_isLoadingAnalysis) return;
        _isLoadingAnalysis = true;
        StateHasChanged();

        try 
        {
            _settings = await SystemSettingsService.GetAsync();
            using var db = DbFactory.CreateDbContext();
            
            var twoYearsAgo = DateTime.Today.AddMonths(-24);
            var startDate = new DateTime(twoYearsAgo.Year, twoYearsAgo.Month, 1);
            
            var sales = await db.PosSales.AsNoTracking()
                .Where(s => s.Timestamp >= startDate && !s.IsVoided)
                .ToListAsync();

            var pulls = await db.LiquorTransactions.AsNoTracking()
                .Include(t => t.Item)
                .Where(t => t.Timestamp >= startDate && t.ChangeAmount < 0 && t.Notes != null && t.Notes.Contains("POS End-of-Shift Removal"))
                .ToListAsync();

            var allMonths = new List<RevenueAnalysisMonth>();
            var monthStart = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
            
            for (int i = 0; i < 24; i++)
            {
                var currentMonth = monthStart.AddMonths(-i);
                
                var monthSales = sales.Where(s => s.Timestamp.Year == currentMonth.Year && s.Timestamp.Month == currentMonth.Month).ToList();
                var monthPulls = pulls.Where(t => t.Timestamp.Year == currentMonth.Year && t.Timestamp.Month == currentMonth.Month).ToList();
                
                decimal totalPosSales = monthSales.Sum(s => s.TotalAmount);
                decimal literalLiquorSales = 0;
                int bottlesUsed = 0;
                decimal expectedRevenue = 0;
                var topBrands = new List<BrandRevenueDetail>();

                // 1. Calculate actual sales per brand in this month
                var brandSales = new Dictionary<string, decimal>();
                var brandShots = new Dictionary<string, int>();
                foreach (var sale in monthSales)
                {
                    var itemsList = GetItemsList(sale.ItemsJson);
                    foreach (var item in itemsList)
                    {
                        var cleanName = CleanProductName(item.Name);
                        if (_itemLookup.TryGetValue(cleanName, out var liquorItem))
                        {
                            var cat = (liquorItem.Category ?? "MISC").ToUpper();
                            bool isCategoryEnabled = _categoryOptions.ContainsKey(cat) && _categoryOptions[cat];
                            bool isItemEnabled = _itemOptions.ContainsKey(cleanName) && _itemOptions[cleanName];
                            
                            if (isCategoryEnabled && isItemEnabled)
                            {
                                literalLiquorSales += item.Price * item.Quantity;
                                if (!brandSales.ContainsKey(cleanName)) brandSales[cleanName] = 0;
                                brandSales[cleanName] += item.Price * item.Quantity;

                                if (!brandShots.ContainsKey(cleanName)) brandShots[cleanName] = 0;
                                brandShots[cleanName] += item.Quantity;
                            }
                        }
                    }
                }

                // 2. Process pulls per brand in this month
                var brandPulls = new Dictionary<string, int>();
                var pullsGrouped = monthPulls.GroupBy(p => p.Item != null ? p.Item.Name : "Unknown");
                foreach (var group in pullsGrouped)
                {
                    var brandName = group.Key;
                    var pullsCount = group.Sum(t => (int)Math.Abs(t.ChangeAmount));
                    if (_itemLookup.TryGetValue(brandName, out var liquorItem))
                    {
                        var cat = (liquorItem.Category ?? "MISC").ToUpper();
                        bool isCategoryEnabled = _categoryOptions.ContainsKey(cat) && _categoryOptions[cat];
                        bool isItemEnabled = _itemOptions.ContainsKey(brandName) && _itemOptions[brandName];
                        if (isCategoryEnabled && isItemEnabled)
                        {
                            brandPulls[brandName] = pullsCount;
                        }
                    }
                }

                // 3. Combine pulls and sales into detailed brand logs
                var allMonthBrands = brandSales.Keys.Union(brandPulls.Keys).Distinct().ToList();
                foreach (var brandName in allMonthBrands)
                {
                    var pullsCount = brandPulls.ContainsKey(brandName) ? brandPulls[brandName] : 0;
                    var actRev = brandSales.ContainsKey(brandName) ? brandSales[brandName] : 0;
                    decimal expRev = 0;
                    
                    if (_itemLookup.TryGetValue(brandName, out var liquorItem))
                    {
                        bottlesUsed += pullsCount;
                        
                        decimal ounces = 33.8m;
                        decimal pour = _settings?.GlobalLiquorPourSize ?? 1.5m;
                        string bSize = liquorItem.BottleSize ?? "1L";

                        if (bSize.Contains("750")) ounces = 25.4m;
                        if (bSize.Contains("1.75")) ounces = 59.2m;
                        
                        int expectedShots = (int)Math.Floor(ounces / (pour > 0 ? pour : 1.5m));
                        expRev = expectedShots * liquorItem.RetailPrice * pullsCount;
                        expectedRevenue += expRev;
                    }
                    
                    if (pullsCount > 0 || actRev > 0)
                    {
                        var bSize = liquorItem?.BottleSize ?? "1L";
                        decimal retailPrice = liquorItem?.RetailPrice ?? 0;
                        decimal pourSize = _settings?.GlobalLiquorPourSize ?? 1.5m;
                        decimal ounces = 33.8m;
                        if (bSize.Contains("750")) ounces = 25.4m;
                        if (bSize.Contains("1.75")) ounces = 59.2m;
                        int expectedShots = (int)Math.Floor(ounces / (pourSize > 0 ? pourSize : 1.5m));

                        var shotsCount = brandShots.ContainsKey(brandName) ? brandShots[brandName] : 0;

                        topBrands.Add(new BrandRevenueDetail
                        {
                            Name = brandName,
                            PullsCount = pullsCount,
                            ActualRevenue = actRev,
                            ExpectedRevenue = expRev,
                            BottleSize = bSize,
                            RetailPrice = retailPrice,
                            ExpectedShotsPerBottle = expectedShots,
                            PourSize = pourSize,
                            ShotsSold = shotsCount
                        });
                    }
                }

                allMonths.Add(new RevenueAnalysisMonth
                {
                    Date = currentMonth,
                    TotalPosSales = totalPosSales,
                    LiteralLiquorSales = literalLiquorSales,
                    BottlesUsed = bottlesUsed,
                    ExpectedRevenue = expectedRevenue,
                    TopBrands = topBrands
                });
            }

            _revenueAnalysisMonths = allMonths;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading POS analysis: {ex.Message}");
        }
        finally
        {
            _isLoadingAnalysis = false;
            StateHasChanged();
        }
    }

    private string FormatLastSeen(DateTime lastSeenUtc)
    {
        if (lastSeenUtc == default) return "Never";
        var localTime = lastSeenUtc.ToLocalTime();
        var diff = DateTime.Now - localTime;
        if (diff.TotalMinutes < 1) return "Just now";
        if (diff.TotalMinutes < 60) return $"{(int)diff.TotalMinutes}m ago";
        if (diff.TotalHours < 24) return $"{(int)diff.TotalHours}h ago";
        return localTime.ToString("MMM dd, h:mm tt");
    }

    private string GetStockSummaryForLocation(LiquorItem item, string location)
    {
        decimal stock = 0;
        if (location == "ALL")
        {
            var mainStockRecord = DbLocationStocks.FirstOrDefault(ls => ls.ItemId == item.Id && ls.LocationName == "MAIN_STORAGE");
            decimal mainStock = mainStockRecord != null ? mainStockRecord.Stock : item.CurrentStock;
            decimal downstairsStock = DbLocationStocks.Where(ls => ls.ItemId == item.Id && ls.LocationName == "DOWNSTAIRS_BAR").Sum(ls => ls.Stock);
            decimal upstairsStock = DbLocationStocks.Where(ls => ls.ItemId == item.Id && ls.LocationName == "UPSTAIRS_BAR").Sum(ls => ls.Stock);
            
            if (!DbLocationStocks.Any(ls => ls.ItemId == item.Id))
            {
                return item.StockSummary;
            }
            stock = mainStock + downstairsStock + upstairsStock;
        }
        else
        {
            var locStock = DbLocationStocks.FirstOrDefault(ls => ls.ItemId == item.Id && ls.LocationName == location);
            if (locStock == null)
            {
                if (location == "MAIN_STORAGE") return item.StockSummary;
                return "0 cases, 0 bottles";
            }
            stock = locStock.Stock;
        }

        if (location != "MAIN_STORAGE" && location != "ALL")
        {
            return $"{stock:F2} {(stock == 1 ? "bottle" : "bottles")}";
        }

        int intStock = (int)Math.Round(stock);
        if (item.PackSize <= 1) return $"{intStock} {(intStock == 1 ? "bottle" : "bottles")}";
        int cases = intStock / item.PackSize;
        int bottles = intStock % item.PackSize;
        return $"{cases} {(cases == 1 ? "case" : "cases")}, {bottles} {(bottles == 1 ? "bottle" : "bottles")}";
    }

    private bool IsLocationLowStock(LiquorItem item, string location)
    {
        decimal stock = 0;
        if (location == "ALL")
        {
            var mainStockRecord = DbLocationStocks.FirstOrDefault(ls => ls.ItemId == item.Id && ls.LocationName == "MAIN_STORAGE");
            decimal mainStock = mainStockRecord != null ? mainStockRecord.Stock : item.CurrentStock;
            decimal downstairsStock = DbLocationStocks.Where(ls => ls.ItemId == item.Id && ls.LocationName == "DOWNSTAIRS_BAR").Sum(ls => ls.Stock);
            decimal upstairsStock = DbLocationStocks.Where(ls => ls.ItemId == item.Id && ls.LocationName == "UPSTAIRS_BAR").Sum(ls => ls.Stock);
            
            stock = mainStock + downstairsStock + upstairsStock;
            
            if (!DbLocationStocks.Any(ls => ls.ItemId == item.Id))
            {
                return item.CurrentStock <= item.MinStockLimit;
            }
        }
        else
        {
            var locStock = DbLocationStocks.FirstOrDefault(ls => ls.ItemId == item.Id && ls.LocationName == location);
            if (locStock == null)
            {
                if (location == "MAIN_STORAGE") return item.CurrentStock <= item.MinStockLimit;
                return true;
            }
            stock = locStock.Stock;
        }

        return stock <= item.MinStockLimit;
    }
