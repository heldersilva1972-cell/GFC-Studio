    private string GetEventDisplayName(string name)
    {
        if (string.IsNullOrEmpty(name)) return "";
        if (name.EndsWith(" [Direct]")) return name.Substring(0, name.Length - 9);
        if (name.EndsWith("[Direct]")) return name.Substring(0, name.Length - 8);
        return name;
    }

    private string GetEventNameForSale(PosSale? sale)
    {
        if (sale == null || !sale.ActiveEventId.HasValue || sale.ActiveEventId.Value <= 0)
            return "";

        var ev = DbActiveEvents.FirstOrDefault(e => e.Id == sale.ActiveEventId.Value);
        return ev != null ? GetEventDisplayName(ev.Name) : $"EVENT #{sale.ActiveEventId.Value}";
    }

    private string GetTransactionItemsSummary(PosSale sale)
    {
        if (sale == null) return "";
        var isDepositSale = sale.PaymentType == "DEPOSIT" || (!string.IsNullOrEmpty(sale.ItemsJson) && (sale.ItemsJson.Contains("INITIAL DEPOSIT") || sale.ItemsJson.Contains("TAB DEPOSIT") || sale.ItemsJson.Contains("ADDED FUNDS")));
        if (isDepositSale)
        {
            return sale.ItemsJson?.Contains("INITIAL DEPOSIT") == true ? "Initial Event Deposit" : "Event Deposit / Added Top-Up";
        }

        var items = GetItemsList(sale.ItemsJson);
        if (items == null || !items.Any()) return "General Sale";

        return string.Join(", ", items.Where(i => i != null && !string.IsNullOrEmpty(i.Name)).Select(i => {
            var isDonatedPrefix = i.Name.StartsWith("DONATED:", StringComparison.OrdinalIgnoreCase);
            var isTally = i.Name.StartsWith("TALLY:", StringComparison.OrdinalIgnoreCase);
            var cleanName = isTally ? i.Name.Substring(6).Trim() : (isDonatedPrefix ? i.Name.Substring(8).Trim() : i.Name);
            var isDonated = isDonatedPrefix || (isTally && IsItemDonatedForEvent(cleanName, SelectedAuditEvent)) || (i.Price == 0 && (isTally || i.Name.Contains("DONATED", StringComparison.OrdinalIgnoreCase)));
            var tag = isDonated ? " (Donated Prize)" : (isTally ? " (Tally Removed)" : "");
            return $"{i.Quantity}x {cleanName}{tag}";
        }));
    }

    // Returns $0 for donated items and the correct non-donated amount for mixed events.
    // Handles legacy records where TALLY: items were stored with non-zero prices.
    private decimal GetCorrectedEventSettlementAmount(PosSale sale, ActiveEvent? ev)
    {
        if (sale == null) return 0m;
        if (ev == null || !sale.PaymentType.Contains("EVENT SETTLEMENT", StringComparison.OrdinalIgnoreCase))
            return sale.TotalAmount;

        // If the event is 100% donated, the true club cost is always $0
        if (ev.Enable100PercentDonatedProceeds)
            return 0m;

        var items = GetItemsList(sale.ItemsJson);
        if (items == null || !items.Any()) return sale.TotalAmount;

        decimal corrected = 0m;
        foreach (var item in items.Where(i => i != null && !string.IsNullOrEmpty(i.Name)))
        {
            var isDonatedPrefix = item.Name.StartsWith("DONATED:", StringComparison.OrdinalIgnoreCase);
            var isTally = item.Name.StartsWith("TALLY:", StringComparison.OrdinalIgnoreCase);
            var cleanName = isTally ? item.Name.Substring(6).Trim() : (isDonatedPrefix ? item.Name.Substring(8).Trim() : item.Name);
            if (isDonatedPrefix || (isTally && IsItemDonatedForEvent(cleanName, ev)))
                corrected += 0m; // donated — $0 club cost
            else
                corrected += item.Price * item.Quantity;
        }
        return corrected;
    }

    private bool IsEvent100PercentProceeds(ActiveEvent? ev, string eventName)
    {
        if (ev != null && ev.Enable100PercentDonatedProceeds) return true;
        
        var cleanName = GetEventDisplayName(eventName).Trim();
        var tmpl = DbEventTemplates?.FirstOrDefault(t => GetEventDisplayName(t.Name).Equals(cleanName, StringComparison.OrdinalIgnoreCase));
        if (tmpl != null && tmpl.Enable100PercentDonatedProceeds) return true;

        // Check if incoming donations came from a donor event template with 100% proceeds
        var donorTmpl = DbEventTemplates?.FirstOrDefault(t => !string.IsNullOrEmpty(t.RecipientEventName) &&
            (GetEventDisplayName(t.RecipientEventName).Equals(cleanName, StringComparison.OrdinalIgnoreCase) ||
             t.RecipientEventName.Equals(cleanName, StringComparison.OrdinalIgnoreCase)));
        if (donorTmpl != null && donorTmpl.Enable100PercentDonatedProceeds) return true;

        var donorEv = DbActiveEvents?.FirstOrDefault(e => !string.IsNullOrEmpty(e.RecipientEventName) &&
            (GetEventDisplayName(e.RecipientEventName).Equals(cleanName, StringComparison.OrdinalIgnoreCase) ||
             e.RecipientEventName.Equals(cleanName, StringComparison.OrdinalIgnoreCase)));
        if (donorEv != null && donorEv.Enable100PercentDonatedProceeds) return true;

        return false;
    }

    private (decimal ClubPortion, decimal EventPortion) GetSalePortions(PosSale sale, ActiveEvent? ev)
    {
        if (sale == null) return (0m, 0m);

        if (sale.PaymentType == "DEPOSIT" || (!string.IsNullOrEmpty(sale.ItemsJson) && (sale.ItemsJson.Contains("INITIAL DEPOSIT") || sale.ItemsJson.Contains("TAB DEPOSIT") || sale.ItemsJson.Contains("ADDED FUNDS"))))
        {
            return (sale.TotalAmount, 0m);
        }

        var targetEvent = (sale.ActiveEventId.HasValue && sale.ActiveEventId.Value > 0)
            ? (DbActiveEvents?.FirstOrDefault(e => e.Id == sale.ActiveEventId.Value) ?? ev)
            : ev;

        var eventName = targetEvent?.Name ?? "";
        bool is100Percent = IsEvent100PercentProceeds(targetEvent, eventName);

        if (targetEvent != null && !string.IsNullOrEmpty(targetEvent.BeerTalliesJson))
        {
            var tallies = GetActiveEventTallies(targetEvent);
            if (tallies.Any())
            {
                decimal total = tallies.Sum(t => t.Subtotal);
                if (is100Percent)
                {
                    // 100% of proceeds from donor template go to event portion
                    return (0m, total);
                }
                decimal club = tallies.Sum(t => t.ClubSubtotal);
                decimal eventP = tallies.Sum(t => t.EventSubtotal);
                return (club, eventP);
            }
        }

        var items = GetItemsList(sale.ItemsJson);
        if (items == null || !items.Any()) return (sale.TotalAmount, 0m);

        decimal totalAmount = items.Sum(i => i.Price * i.Quantity);
        if (is100Percent)
        {
            return (0m, totalAmount);
        }

        decimal totalClub = 0m;
        decimal totalEvent = 0m;
        foreach (var item in items.Where(i => i != null && !string.IsNullOrEmpty(i.Name)))
        {
            var isDonatedPrefix = item.Name.StartsWith("DONATED:", StringComparison.OrdinalIgnoreCase);
            var isTally = item.Name.StartsWith("TALLY:", StringComparison.OrdinalIgnoreCase);
            var cleanName = isTally ? item.Name.Substring(6).Trim() : (isDonatedPrefix ? item.Name.Substring(8).Trim() : item.Name);

            if (targetEvent != null && !string.IsNullOrEmpty(targetEvent.BeerTalliesJson))
            {
                var tallies = GetActiveEventTallies(targetEvent);
                var tallyMatch = tallies.FirstOrDefault(t => t.Name.Equals(cleanName, StringComparison.OrdinalIgnoreCase));
                if (tallyMatch != null)
                {
                    totalClub += tallyMatch.ClubSubtotal;
                    totalEvent += tallyMatch.EventSubtotal;
                    continue;
                }
            }

            var isDonated = isDonatedPrefix || (targetEvent != null && (targetEvent.Enable100PercentDonatedProceeds || IsItemDonatedForEvent(cleanName, targetEvent)));

            if (isDonated)
            {
                totalClub += 0m;
                totalEvent += 0m;
            }
            else
            {
                totalClub += item.Price * item.Quantity;
            }
        }

        return (totalClub, totalEvent);
    }

    // Returns true if the given item name (clean, no prefix) is in the event's donated pool.
    private bool IsItemDonatedForEvent(string cleanItemName, ActiveEvent? ev)
    {
        if (ev == null || string.IsNullOrEmpty(cleanItemName)) return false;
        // 100% donated event — all tallied beers are donated
        if (ev.Enable100PercentDonatedProceeds) return true;
        if (string.IsNullOrEmpty(ev.DonatedItemIdsJson)) return false;
        try
        {
            var poolMap = JsonSerializer.Deserialize<Dictionary<int, int>>(ev.DonatedItemIdsJson);
            if (poolMap == null || poolMap.Count == 0) return false;
            var donatedIds = poolMap.Keys.ToHashSet();
            var dbItem = DbLiquorItems.FirstOrDefault(di =>
                di.Name != null && di.Name.Equals(cleanItemName, StringComparison.OrdinalIgnoreCase));
            return dbItem != null && donatedIds.Contains(dbItem.Id);
        }
        catch { return false; }
    }

    private bool HasDonatedBeers(ActiveEvent? ev)
    {
        if (ev == null) return false;
        if (ev.Enable100PercentDonatedProceeds) return true;
        var pool = GetDonatedItemPool(ev);
        return pool.Any();
    }

    private Dictionary<int, int> GetDonatedItemPool(ActiveEvent? ev)
    {
        if (ev == null || string.IsNullOrEmpty(ev.DonatedItemIdsJson)) return new();
        string json = ev.DonatedItemIdsJson;
        
        Dictionary<int, int> pool;
        try
        {
            pool = JsonSerializer.Deserialize<Dictionary<int, int>>(json) ?? new();
        }
        catch
        {
            return new();
        }

        // Subtract distributions (prizes and redonations) recorded on this event
        var distributions = GetEventDistributions(ev);
        foreach (var dist in distributions)
        {
            if (pool.ContainsKey(dist.ItemId))
            {
                pool[dist.ItemId] = Math.Max(0, pool[dist.ItemId] - dist.Cans);
            }
            else if (dist.ItemId == 0 && !string.IsNullOrEmpty(dist.BeerName))
            {
                var item = DbLiquorItems.FirstOrDefault(i => i.Name.Equals(dist.BeerName, StringComparison.OrdinalIgnoreCase));
                if (item != null && pool.ContainsKey(item.Id))
                {
                    pool[item.Id] = Math.Max(0, pool[item.Id] - dist.Cans);
                }
            }
        }

        return pool;
    }

    private async Task CalculateReconciliation(GfcDbContext db)
    {
        ReconResults.Clear();
        _settings = await SystemSettingsService.GetAsync();

        // A. Get all drinks sold in this period from POS
        var allSalesItems = _allSalesForStats.SelectMany(s => GetItemsList(s.ItemsJson)).Where(i => i != null);
        var posGrouped = allSalesItems.GroupBy(i => i.Name ?? "UNKNOWN ITEM")
                                      .ToDictionary(g => g.Key, g => g.Sum(i => i.Quantity));

        var st = StartDate.Date.AddHours(3);
        var en = EndDate.Date.AddDays(1).AddHours(3);

        // B. Get all bottles pulled from Inventory for this station/period
        var inventoryQuery = db.LiquorTransactions.AsNoTracking()
                               .Where(t => t.Timestamp >= st && t.Timestamp < en && 
                                           (t.Notes ?? "").Contains("POS End-of-Shift Removal"));
        
        if (!string.IsNullOrEmpty(FilterTerminal))
        {
            inventoryQuery = inventoryQuery.Where(t => (t.Notes ?? "").Contains($"[{FilterTerminal}]"));
        }

        var inventoryTransactions = await inventoryQuery.Include(t => t.Item).ToListAsync();
        
        // C. Process each distinct liquor involved
        var allItemNames = posGrouped.Keys.Union(inventoryTransactions.Select(t => t.Item?.Name ?? "Unknown")).Distinct();

        foreach(var name in allItemNames)
        {
            var drinksSold = posGrouped.ContainsKey(name) ? posGrouped[name] : 0;
            var pulls = inventoryTransactions.Where(t => t.Item?.Name == name).ToList();
            var bottlesPulled = pulls.Sum(t => Math.Abs(t.ChangeAmount));
            
            // Get item metadata (size/shot)
            var itemMeta = pulls.FirstOrDefault()?.Item;
            if (itemMeta == null) {
                // Try and find from db if no pull happened but sales did
                itemMeta = await db.LiquorItems.FirstOrDefaultAsync(i => i.Name == name);
            }

            // ONLY track actual liquor usage (exclude deposits, no sales, beers, seltzers, wines, etc.)
            if (itemMeta == null || itemMeta.IsUnitBased || itemMeta.IsBeer)
            {
                continue;
            }

            decimal ounces = 33.8m; // Default 1L
            decimal pour = _settings?.GlobalLiquorPourSize ?? 1.5m; // Use GLOBAL setting per user request
            string bSize = itemMeta?.BottleSize ?? "1L";

            if (bSize != null && bSize.Contains("750")) ounces = 25.4m;
            if (bSize != null && bSize.Contains("1.75")) ounces = 59.2m;
            
            // Override global pour IF it is explicitly unit based (Beer/Cans)
            if (itemMeta?.IsUnitBased == true) {
                ounces = 1;
                pour = 1;
            }

            int expectedShots = (int)(Math.Floor(ounces / (pour > 0 ? pour : 1)) * bottlesPulled);

            ReconResults.Add(new ReconEntry {
                ItemName = name,
                BottleSize = bSize,
                PourSize = pour,
                DrinksSold = drinksSold,
                BottlesPulled = bottlesPulled,
                ExpectedYield = expectedShots
            });
        }
    }

    private async Task CalculateLifetimeTokens(GfcDbContext db)
    {
        // Load persistent token audit logs
        TokenAuditLogs = await db.TokenAuditLogs.OrderByDescending(l => l.Timestamp).ToListAsync();

        // Use the same stats-based approach as the main analysis for consistency
        List<PosToken> tokens;
        try {
            tokens = await db.PosTokens.AsNoTracking().ToListAsync();
        } catch (global::System.Exception ex) {
            throw new global::System.Exception("Error in PosTokens query in CalculateLifetimeTokens: " + ex.Message, ex);
        }
        
        List<PosSale> allSales;
        try {
            allSales = await db.PosSales.AsNoTracking().ToListAsync();
        } catch (global::System.Exception ex) {
            throw new global::System.Exception("Error in PosSales query in CalculateLifetimeTokens: " + ex.Message, ex);
        }
        
        int beerSold = 0, beerUsed = 0;
        int mixedSold = 0, mixedUsed = 0;

        foreach (var sale in allSales)
        {
            var items = GetItemsList(sale.ItemsJson);
            foreach (var item in items)
            {
                bool isBeer = (item.Name ?? "").ToUpper().Contains("BEER");
                
                // SALE
                if (item.Category == "TOKENS")
                {
                    if (isBeer) beerSold += item.Quantity;
                    else mixedSold += item.Quantity;
                }

                // REDEMPTION
                bool isTrigger = item.Category == "TOKEN_CREDIT" || 
                                 item.IsTokenApplied || 
                                 (item.Price == 0 && ((item.Name ?? "").Contains("(TOKEN") || (item.Name ?? "").Contains("(CREDITED")));
                if (isTrigger)
                {
                    if (isBeer) beerUsed += item.Quantity;
                    else mixedUsed += item.Quantity;
                }
            }
        }

        LifetimeBeerSold = beerSold;
        LifetimeBeerUsed = beerUsed;
        LifetimeMixedSold = mixedSold;
        LifetimeMixedUsed = mixedUsed;
    }

