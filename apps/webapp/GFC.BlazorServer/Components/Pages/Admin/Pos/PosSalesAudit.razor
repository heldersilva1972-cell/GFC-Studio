                                            <td class="py-3">
                                                <span class="badge @(log.Status.Contains("MISSING") || log.Status == "SHRINKAGE" ? "bg-danger text-white" : (log.Status.Contains("LEGACY") ? "bg-warning text-dark" : "bg-success text-white"))">
