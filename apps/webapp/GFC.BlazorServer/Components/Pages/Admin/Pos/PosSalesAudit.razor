    private async Task LoadSales()
    {
        try {
            using var db = DbFactory.CreateDbContext();
            
            var st = StartDate.Date.AddHours(3);
            var en = EndDate.Date.AddDays(1).AddHours(3);

            // Load Sales
            try {
                var salesQuery = db.PosSales.AsNoTracking().Where(s => s.Timestamp >= st && s.Timestamp < en);
                if (!string.IsNullOrEmpty(FilterTerminal)) salesQuery = salesQuery.Where(s => s.TerminalName == FilterTerminal);
                Sales = await salesQuery.OrderByDescending(s => s.Timestamp).Take(500).ToListAsync();
            } catch (global::System.Exception ex) {
                throw new global::System.Exception("Error in loading Sales query: " + ex.Message, ex);
            }

            // Load Z-Reports
            try {
                var zQuery = db.PosZReports.AsNoTracking().Where(r => r.Timestamp >= st && r.Timestamp < en);
                if (!string.IsNullOrEmpty(FilterTerminal)) zQuery = zQuery.Where(r => r.TerminalName == FilterTerminal);
                ZReports = await zQuery.OrderByDescending(r => r.Timestamp).Take(500).ToListAsync();

                // Compute exact transaction bounds for each Z-Report
                ZReportWindows.Clear();
                foreach (var z in ZReports)
                {
                    var prevZ = await db.PosZReports.AsNoTracking()
                        .Where(r => r.TerminalName == z.TerminalName && r.Timestamp < z.Timestamp)
                        .OrderByDescending(r => r.Timestamp)
                        .FirstOrDefaultAsync();

                    var salesInShift = db.PosSales.AsNoTracking()
                        .Where(s => s.TerminalName == z.TerminalName && 
                                    s.Timestamp <= z.Timestamp && 
                                    (prevZ == null || s.Timestamp > prevZ.Timestamp));

                    if (await salesInShift.AnyAsync())
                    {
                        var first = await salesInShift.OrderBy(s => s.Timestamp).FirstOrDefaultAsync();
                        var last = await salesInShift.OrderByDescending(s => s.Timestamp).FirstOrDefaultAsync();
                        ZReportWindows[z.Id] = (first?.Timestamp, first?.BartenderName ?? "Unknown", last?.Timestamp, last?.BartenderName ?? "Unknown");
                    }
                    else
                    {
                        ZReportWindows[z.Id] = (null, "No Sales", null, "No Sales");
                    }
                }
            } catch (global::System.Exception ex) {
                throw new global::System.Exception("Error in loading ZReports query: " + ex.Message, ex);
            }

            // Calculate Totals
            TodayTotal = Sales.Sum(s => s.TotalAmount);
            StationTotals = Sales.GroupBy(s => s.TerminalName ?? "UNKNOWN STATION")
                                .ToDictionary(g => g.Key, g => g.Sum(s => s.TotalAmount));

            // Get unique terminal names
            try {
                TerminalList = await db.PosSales.AsNoTracking().Select(s => s.TerminalName).Distinct().ToListAsync();
            } catch (global::System.Exception ex) {
                throw new global::System.Exception("Error in loading TerminalList query 1: " + ex.Message, ex);
            }

            // Default Selections
            SelectedSale = Sales.FirstOrDefault();
            SelectedZReport = ZReports.FirstOrDefault();

            // Token Tracking (Daily)
            var allItems = Sales.SelectMany(s => GetItemsList(s.ItemsJson)).ToList();
            TotalTokensSold = allItems.Where(i => i != null && i.Category == "TOKENS").Sum(i => i.Quantity);
            TotalTokensRedeemed = allItems.Where(i => i != null && (i.Name ?? "").Contains("(TOKEN)") && i.Price == 0).Sum(i => i.Quantity);

            // Calculate Item Sales Summary for ITEMS Tab
            var cleanItems = allItems.Where(i => i != null)
                                    .Select(i => {
                                        var cleanName = CleanProductName(i.Name);
                                        
                                        var itemCategory = !string.IsNullOrEmpty(i.Category) && i.Category != "SHIFT TOTAL" && i.Category != "MISC"
                                            ? i.Category 
                                            : (DbItems.FirstOrDefault(di => di.Name != null && di.Name.Equals(cleanName, StringComparison.OrdinalIgnoreCase))?.Category ?? i.Category ?? "MISC");
 
                                        return new PosTerminal.ProductItem {
                                            Name = cleanName,
                                            Quantity = i.Quantity,
                                            Price = i.Price,
                                            Category = itemCategory.ToUpper(),
                                            IsTokenApplied = i.IsTokenApplied || (i.Name ?? "").Contains("(TOKEN)") || (i.Name ?? "").Contains("(CREDITED)")
                                        };
                                    })
                                    .Where(i => !string.IsNullOrEmpty(i.Name) && 
                                                !i.Name.Contains("DEPOSIT", StringComparison.OrdinalIgnoreCase) && 
                                                !i.Name.Contains("CORRECTION", StringComparison.OrdinalIgnoreCase) && 
                                                !i.Name.Contains("NO SALE", StringComparison.OrdinalIgnoreCase) && 
                                                !i.Name.Contains("CREDIT", StringComparison.OrdinalIgnoreCase) && 
                                                i.Category != "TOKEN_CREDIT")
                                    .ToList();
 
            SummaryResults = cleanItems.GroupBy(i => new { Name = i.Name, Category = i.Category })
                                    .Select(g => new SummaryResult 
                                    { 
                                        Name = g.Key.Name, 
                                        Category = g.Key.Category,
                                        Quantity = g.Sum(i => i.Quantity),
                                        Revenue = g.Sum(i => i.Price * i.Quantity),
                                        TokensRedeemed = g.Where(i => i.IsTokenApplied).Sum(i => i.Quantity)
                                    })
                                    .ToList();

            // 1. Calculate Reconciliation Data
            try {
                await CalculateReconciliation(db);
            } catch (global::System.Exception ex) {
                throw new global::System.Exception("Error in CalculateReconciliation: " + ex.Message, ex);
            }
            
            try {
                await CalculateTokenAnalysis(db);
            } catch (global::System.Exception ex) {
                throw new global::System.Exception("Error in CalculateTokenAnalysis: " + ex.Message, ex);
            }

            // Get unique terminal names for the dropdown
            try {
                TerminalList = await db.PosSales.Select(s => s.TerminalName).Distinct().ToListAsync();
                TerminalsWithStatus = await db.PosTerminals.AsNoTracking().OrderBy(t => t.TerminalName).ToListAsync();
            } catch (global::System.Exception ex) {
                throw new global::System.Exception("Error in loading TerminalList query 2: " + ex.Message, ex);
            }

            // Select the first one by default from the new results, or clear if empty
            SelectedSale = Sales.FirstOrDefault();
        } catch (global::System.Exception ex) {
            global::System.IO.File.WriteAllText(@"C:\Users\hnsil\Desktop\PosAuditError.txt", ex.ToString());
            throw;
        }
    }

    private async Task CalculateReconciliation(GfcDbContext db)
    {
        ReconResults.Clear();
        _settings = await SystemSettingsService.GetAsync();

        // A. Get all drinks sold in this period from POS
        var allSalesItems = Sales.SelectMany(s => GetItemsList(s.ItemsJson)).Where(i => i != null);
        var posGrouped = allSalesItems.GroupBy(i => i.Name ?? "UNKNOWN ITEM")
                                      .ToDictionary(g => g.Key, g => g.Sum(i => i.Quantity));

        var st = StartDate.Date.AddHours(3);
        var en = EndDate.Date.AddDays(1).AddHours(3);

        // B. Get all bottles pulled from Inventory for this station/period
        var inventoryQuery = db.LiquorTransactions.AsNoTracking()
                               .Where(t => t.Timestamp >= st && t.Timestamp < en && 
                                           (t.Notes ?? "").Contains("POS End-of-Shift Removal"));
        
        if (!string.IsNullOrEmpty(FilterTerminal))
        {
            inventoryQuery = inventoryQuery.Where(t => (t.Notes ?? "").Contains($"[{FilterTerminal}]"));
        }

        var inventoryTransactions = await inventoryQuery.Include(t => t.Item).ToListAsync();
        
        // C. Process each distinct liquor involved
        var allItemNames = posGrouped.Keys.Union(inventoryTransactions.Select(t => t.Item?.Name ?? "Unknown")).Distinct();

        foreach(var name in allItemNames)
        {
            var drinksSold = posGrouped.ContainsKey(name) ? posGrouped[name] : 0;
            var pulls = inventoryTransactions.Where(t => t.Item?.Name == name).ToList();
            var bottlesPulled = pulls.Sum(t => Math.Abs(t.ChangeAmount));
            
            // Get item metadata (size/shot)
            var itemMeta = pulls.FirstOrDefault()?.Item;
            if (itemMeta == null) {
                // Try and find from db if no pull happened but sales did
                itemMeta = await db.LiquorItems.FirstOrDefaultAsync(i => i.Name == name);
            }

            // ONLY track actual liquor usage (exclude deposits, no sales, beers, seltzers, wines, etc.)
            if (itemMeta == null || itemMeta.IsUnitBased || itemMeta.IsBeer)
            {
                continue;
            }

            decimal ounces = 33.8m; // Default 1L
            decimal pour = _settings?.GlobalLiquorPourSize ?? 1.5m; // Use GLOBAL setting per user request
            string bSize = itemMeta?.BottleSize ?? "1L";

            if (bSize != null && bSize.Contains("750")) ounces = 25.4m;
            if (bSize != null && bSize.Contains("1.75")) ounces = 59.2m;
            
            // Override global pour IF it is explicitly unit based (Beer/Cans)
            if (itemMeta?.IsUnitBased == true) {
                ounces = 1;
                pour = 1;
            }

            int expectedShots = (int)(Math.Floor(ounces / (pour > 0 ? pour : 1)) * bottlesPulled);

            ReconResults.Add(new ReconEntry {
                ItemName = name,
                BottleSize = bSize,
                PourSize = pour,
                DrinksSold = drinksSold,
                BottlesPulled = bottlesPulled,
                ExpectedYield = expectedShots
            });
        }
    }

    private async Task CalculateLifetimeTokens(GfcDbContext db)
    {
        // Use the same stats-based approach as the main analysis for consistency
        List<PosToken> tokens;
        try {
            tokens = await db.PosTokens.AsNoTracking().ToListAsync();
        } catch (global::System.Exception ex) {
            throw new global::System.Exception("Error in PosTokens query in CalculateLifetimeTokens: " + ex.Message, ex);
        }
        
        List<PosSale> allSales;
        try {
            allSales = await db.PosSales.AsNoTracking().ToListAsync();
        } catch (global::System.Exception ex) {
            throw new global::System.Exception("Error in PosSales query in CalculateLifetimeTokens: " + ex.Message, ex);
        }
        
        int beerSold = 0, beerUsed = 0;
        int mixedSold = 0, mixedUsed = 0;

        foreach (var sale in allSales)
        {
            var items = GetItemsList(sale.ItemsJson);
            foreach (var item in items)
            {
                bool isBeer = (item.Name ?? "").ToUpper().Contains("BEER");
                
                // SALE
                if (item.Category == "TOKENS")
                {
                    if (isBeer) beerSold += item.Quantity;
                    else mixedSold += item.Quantity;
                }

                // REDEMPTION
                bool isTrigger = item.Category == "TOKEN_CREDIT" || 
                                 item.IsTokenApplied || 
                                 (item.Price == 0 && ((item.Name ?? "").Contains("(TOKEN") || (item.Name ?? "").Contains("(CREDITED")));
                if (isTrigger)
                {
                    if (isBeer) beerUsed += item.Quantity;
                    else mixedUsed += item.Quantity;
                }
            }
        }

        LifetimeBeerSold = beerSold;
        LifetimeBeerUsed = beerUsed;
        LifetimeMixedSold = mixedSold;
        LifetimeMixedUsed = mixedUsed;
    }

    private async Task CalculateTokenAnalysis(GfcDbContext db)
    {
        MasterTokens = await db.PosTokens.AsNoTracking().ToListAsync();
        TokenYields.Clear();
        TokenUsages.Clear();

        // 1. We need ALL sales for Lifetime Liability, but we can filter yield by period if we want.
        // For now, let's do LIFETIME for everything as per user's requirement to "see if they are losing money".
        var allSales = await db.PosSales.AsNoTracking().ToListAsync();
        
        var stats = MasterTokens.Where(t => t.Name != null)
                                .GroupBy(t => t.Name)
                                .ToDictionary(g => g.Key, g => new TokenYieldEntry { Token = g.First() });

        foreach (var sale in allSales)
        {
            var items = GetItemsList(sale.ItemsJson);
            foreach (var item in items)
            {
                // SALE
                if (item.Category == "TOKENS")
                {
                    // Flexible matching for token sales (e.g. "Beer Tokens" should match "Beer Token" before "Beer")
                    var match = MasterTokens.OrderByDescending(t => t.Name.Length).FirstOrDefault(t => (item.Name ?? "").ToUpper().Contains(t.Name.ToUpper()));
                    if (match != null) 
                    {
                        stats[match.Name].Sold += item.Quantity;
                        stats[match.Name].ActualCashCollected += item.Price * item.Quantity;
                    }
                }

                // REDEMPTION or CREDIT
                bool isRedem = item.IsTokenApplied || 
                               (item.Name ?? "").Contains("(TOKEN") || 
                               (item.Name ?? "").Contains("(CREDITED") || 
                               item.Category == "TOKEN_CREDIT";
                
                if (isRedem)
                {
                    var drinkName = CleanProductName(item.Name);
                    
                    // If it's a credit, try to find the actual drink in the same sale to get the real name
                    if (item.Category == "TOKEN_CREDIT")
                    {
                        var target = items.FirstOrDefault(i => i.IsTokenApplied && i.Category != "TOKEN_CREDIT" && i.Quantity == item.Quantity);
                        if (target != null) 
                        {
                            string raw = target.Name ?? "";
                            drinkName = CleanProductName(raw);
                        }
                        else
                        {
                            // If we can't find a target drink for a credit, don't list it as a separate "purchase" 
                            // to avoid $0 menu price entries that skew the profit/loss logic.
                            // We still count the redemption itself though.
                            drinkName = "Unknown Item (Credit Applied)";
                        }
                    }

                    var dbItem = DbItems.FirstOrDefault(di => di.Name != null && di.Name.Equals(drinkName, StringComparison.OrdinalIgnoreCase));
                    var menuPrice = dbItem?.Price ?? (item.Category == "TOKEN_CREDIT" ? 0 : 0);
                    
                    // If we found a target for a credit, use THAT price
                    if (item.Category == "TOKEN_CREDIT" && drinkName != "Unknown Item (Credit Applied)")
                    {
                        menuPrice = dbItem?.Price ?? 0;
                    }
                    
                    // Match to Token Type (prioritize exact ID lookup, fall back to longest matching name)
                    PosToken? match = null;
                    if (item.AppliedTokenId.HasValue && item.AppliedTokenId.Value > 0)
                    {
                        match = MasterTokens.FirstOrDefault(t => t.Id == item.AppliedTokenId.Value);
                    }
                    if (match == null)
                    {
                        var nameUpper = (item.Name ?? "").ToUpper();
                        if (nameUpper.Contains("BEER") || nameUpper.Contains("SELTZER") || nameUpper.Contains("CIDER")) match = MasterTokens.OrderByDescending(t => t.Name.Length).FirstOrDefault(t => t.Name?.ToUpper().Contains("BEER") == true || t.Name?.ToUpper().Contains("SELTZER") == true);
                        else match = MasterTokens.OrderByDescending(t => t.Name.Length).FirstOrDefault(t => t.Name?.ToUpper().Contains("BEER") == false && t.Name?.ToUpper().Contains("SELTZER") == false);
                    }

                    if (match != null && match.Name != null)
                    {
                        if (stats.ContainsKey(match.Name))
                        {
                            bool isTrigger = item.Category == "TOKEN_CREDIT" || 
                                             item.IsTokenApplied || 
                                             (item.Price == 0 && ((item.Name ?? "").Contains("(TOKEN") || (item.Name ?? "").Contains("(CREDITED")));
                            
                            if (isTrigger)
                            {
                                stats[match.Name].Redeemed += item.Quantity;
                                
                                // NEW LOGIC: The value "spent" from the token pool is:
                                // 1. For upgrades (TOKEN_CREDIT): the amount of the credit (the customer paid the rest).
                                // 2. For full redemptions: the retail price of the drink.
                                decimal valueOfRedemption = item.Category == "TOKEN_CREDIT" ? Math.Abs(item.Price) : (menuPrice > 0 ? menuPrice : match.SalePrice);
                                
                                stats[match.Name].RedemptionValue += valueOfRedemption * item.Quantity;
                                
                                decimal avgPrice = stats[match.Name].Sold > 0 
                                     ? (stats[match.Name].ActualCashCollected / stats[match.Name].Sold) 
                                     : match.SalePrice;
                                 
                                  // Usage Tracking - individual entries for detailed timestamp log
                                  var usage = new TokenUsageEntry {
                                      DrinkName = drinkName,
                                      TokenName = match.Name,
                                      MenuPrice = item.Category == "TOKEN_CREDIT" ? valueOfRedemption : menuPrice,
                                      TokenSalePrice = avgPrice,
                                      IsUpgrade = item.Category == "TOKEN_CREDIT",
                                      Quantity = item.Quantity,
                                      Timestamp = sale.Timestamp
                                  };
                                  TokenUsages.Add(usage);
                            }
                        }
                    }
                }
            }
        }

        TokenYields = stats.Values.Where(y => y.Token.AllowCreditUpgrade != true).ToList();
    }

