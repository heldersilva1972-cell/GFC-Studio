@page "/admin/pos-audit"
@implements IDisposable
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using GFC.BlazorServer.Data
@using GFC.BlazorServer.Data.Entities
@using GFC.Core.Models
@using GFC.BlazorServer.Services
@using global::System.Net
@using global::System.Text.Json
@inject IDbContextFactory<GfcDbContext> DbFactory
@inject NavigationManager Navigation
@inject GFC.BlazorServer.Services.IBlazorSystemSettingsService SystemSettingsService
@inject GFC.Core.Interfaces.IVersionService VersionService
@inject IJSRuntime JSRuntime
@inject GFC.BlazorServer.Services.CustomAuthenticationStateProvider AuthStateProvider
@inject PosSyncLogService SyncLog
@attribute [Authorize]

<PageTitle>POS Sales Audit</PageTitle>

<div class="audit-page-wrapper">
    <!-- COMPACT TOP BAR -->
    <div class="compact-top-bar px-4 py-2 bg-white border-bottom d-flex justify-content-between align-items-center">
        <div class="d-flex align-items-center">
            <button class="btn btn-light rounded-circle me-3 shadow-sm border" @onclick="GoBack" title="Go Back">
                <i class="bi bi-chevron-left fs-5"></i>
            </button>
            <div>
                <h4 class="fw-black mb-0">POS TRANSACTION AUDIT</h4>
                <div class="d-flex align-items-center gap-2">
                    <span class="badge bg-light text-muted border" style="font-size: 0.6rem;">v.@VersionService.GetRevision()</span>
                    <span class="text-muted" style="font-size: 0.65rem;">Live feed of station activity</span>
                </div>
            </div>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-outline-secondary btn-sm rounded-pill fw-bold bg-white" @onclick="LoadSales">
                <i class="bi bi-arrow-clockwise me-1"></i> REFRESH
            </button>
        </div>
    </div>

    <div class="audit-main-content">
        <!-- THREE COLUMN GRID -->
        <div class="audit-workspace-container">
            @if (ActiveTab == "SALES" || ActiveTab == "ZREPORTS")
            {
                <!-- LEFT: Transaction List -->
                <div class="audit-list-panel">
                    <div class="panel-header">
                        <span>@(ActiveTab == "ZREPORTS" ? "Z-REPORTS" : "RECENT TRANSACTIONS")</span>
                        <span class="badge bg-primary text-white rounded-pill">@(ActiveTab == "ZREPORTS" ? ZReports.Count : Sales.Count)</span>
                    </div>
                    <div class="scroll-container custom-scrollbar">
                        @if (ActiveTab == "ZREPORTS")
                        {
                            @foreach (var z in ZReports)
                            {
                                var detail = GetShiftDetail(z);
                                <div class="sale-item @(SelectedZReport == z || FilterShiftId == z.Id ? "active" : "")" @onclick="() => SelectShiftFilter(z.Id)" style="padding: 0.85rem 1.25rem; cursor: pointer;">
                                    <div class="d-flex flex-column flex-grow-1">
                                        <div class="d-flex align-items-center gap-2 mb-1">
                                            <span class="text-muted fw-bold" style="font-size: 0.65rem; text-transform: uppercase; letter-spacing: 1px;">@z.Timestamp.ToString("ddd, MMM dd, yyyy")</span>
                                            @if (!string.IsNullOrEmpty(detail.BadgeText))
                                            {
                                                <span class="badge @detail.BadgeClass" style="font-size: 0.65rem; padding: 4px 8px; border-radius: 6px; font-weight: 800;">@detail.BadgeText</span>
                                            }
                                        </div>
                                        
                                        @if (detail.FirstSaleTime.HasValue)
                                        {
                                            <span class="fw-bold text-success" style="font-size: 0.8rem; line-height: 1.2;">
                                                🟢 First Sale: @detail.FirstSaleTime.Value.ToString("ddd, MMM dd h:mm tt") (@detail.FirstSaleBartender)
                                            </span>
                                            <span class="fw-bold text-danger mt-1" style="font-size: 0.8rem; line-height: 1.2;">
                                                🔴 Last Sale: @detail.LastSaleTime?.ToString("ddd, MMM dd h:mm tt") (@detail.LastSaleBartender)
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="fw-bold text-muted" style="font-size: 0.8rem; line-height: 1.2;">
                                                🚫 No sales recorded
                                            </span>
                                        }
                                        
                                        @if (!string.IsNullOrEmpty(detail.DurationDisplay) && detail.FirstSaleTime.HasValue)
                                        {
                                            <span class="text-muted fw-bold mt-1" style="font-size: 0.65rem;"><i class="bi bi-clock me-1"></i>@detail.DurationDisplay</span>
                                        }
                                        
                                        <div class="terminal mt-1">@z.TerminalName</div>
                                        <div class="bartender mt-1" style="font-size: 0.65rem; line-height: 1.2; font-weight: bold;">
                                            Closed by: @detail.ClosedBy @@ @detail.CloseTime.ToString("h:mm tt")
                                        </div>
                                    </div>
                                    <div class="text-end ms-2 d-flex flex-column justify-content-center">
                                        <div class="sale-amount" style="font-size: 0.95rem;">@z.TotalGrossSales.ToString("C")</div>
                                        <div class="small text-muted" style="font-size: 0.6rem;">CASH: @z.CashTotal.ToString("C")</div>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            @foreach (var sale in Sales)
                            {
                                var evName = GetEventNameForSale(sale);
                                var isTab = sale.PaymentType == "TAB" || sale.ActiveEventId.HasValue;
                                var isDartsRound = sale.ItemsJson != null && sale.ItemsJson.Contains("(DARTS");

                                var sItems = GetItemsList(sale.ItemsJson);
                                int tokenSalesQty = sItems.Where(item => !item.IsTokenApplied && 
                                                                         (item.Category == "TOKENS" || item.Category == "TOKEN" || (item.Name ?? "").ToUpper().Contains("TOKEN SALE")) && 
                                                                         !(item.Name ?? "").ToUpper().Contains("TOKEN REDEEMED") && 
                                                                         !(item.Name ?? "").ToUpper().Contains("(CREDITED")).Sum(i => i.Quantity);

                                int tokenRedeemQty = sItems.Where(item => item.IsTokenApplied || 
                                                                          (item.Name ?? "").ToUpper().Contains("TOKEN REDEEMED") || 
                                                                          (item.Name ?? "").ToUpper().Contains("(CREDITED") || 
                                                                          item.Category == "TOKEN_CREDIT" || 
                                                                          (item.Price == 0 && (item.Name ?? "").ToUpper().Contains("TOKEN") && !(item.Name ?? "").ToUpper().Contains("TOKEN SALE"))).Sum(i => i.Quantity);

                                <div class="sale-item @(SelectedSale == sale ? "active" : "")" @onclick="() => SelectedSale = sale">
                                    <div class="d-flex flex-column flex-grow-1 me-2">
                                        <div class="d-flex align-items-center justify-content-between mb-1">
                                            <span class="text-muted fw-bold" style="font-size: 0.55rem; text-transform: uppercase; letter-spacing: 1px;">@sale.Timestamp.ToString("ddd, MMM dd")</span>
                                            
                                            <div class="d-flex align-items-center gap-1 flex-wrap justify-content-end">
                                                @if (tokenRedeemQty > 0)
                                                {
                                                    <span class="badge bg-success-subtle text-success border border-success-subtle fw-bold px-1.5 py-0.5 rounded-pill" style="font-size: 0.62rem;">
                                                        <i class="bi bi-ticket-perforated me-1"></i>@(tokenRedeemQty > 1 ? $"{tokenRedeemQty} TOKENS REDEEMED" : "TOKEN REDEEMED")
                                                    </span>
                                                }
                                                @if (tokenSalesQty > 0)
                                                {
                                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle fw-bold px-1.5 py-0.5 rounded-pill" style="font-size: 0.62rem;">
                                                        <i class="bi bi-cart-plus me-1"></i>@(tokenSalesQty > 1 ? $"{tokenSalesQty} TOKENS SOLD" : "TOKEN SOLD")
                                                    </span>
                                                }
                                                @if (isDartsRound)
                                                {
                                                    <span class="badge text-white fw-bold px-1.5 py-0.5 rounded-pill" style="font-size: 0.62rem; background: linear-gradient(135deg, #7c3aed 0%, #6d28d9 100%);">
                                                        <i class="bi bi-bullseye me-1"></i>DART ROUND
                                                    </span>
                                                }
                                                else if (isTab || !string.IsNullOrEmpty(evName))
                                                {
                                                    <span class="badge bg-primary text-white fw-bold px-1.5 py-0.5 rounded-pill" style="font-size: 0.62rem; letter-spacing: 0.3px;">
                                                        <i class="bi bi-journal-check me-1"></i>@(string.IsNullOrEmpty(evName) ? "TAB" : evName.ToUpper())
                                                    </span>
                                                }
                                                else if (!string.IsNullOrEmpty(sale.PaymentType) && !string.Equals(sale.PaymentType, "Cash", StringComparison.OrdinalIgnoreCase) && sale.PaymentType != "TOKEN/COMP" && sale.PaymentType != "TOKEN")
                                                {
                                                    <span class="badge bg-secondary text-white fw-bold px-1.5 py-0.5 rounded-pill" style="font-size: 0.62rem;">
                                                        @sale.PaymentType
                                                    </span>
                                                }
                                            </div>
                                        </div>
                                        <span class="fw-black text-primary" style="font-size: 1.1rem; line-height: 1;">@sale.Timestamp.ToString("h:mm tt")</span>
                                        <div class="terminal mt-1">@sale.TerminalName</div>
                                        <div class="bartender">by @sale.BartenderName</div>
                                    </div>
                                    <div class="sale-amount">@sale.TotalAmount.ToString("C")</div>
                                </div>
                            }
                        }
                    </div>
                </div>
            }
            @if (ActiveTab == "TOKENS")
            {
                <!-- LEFT: Token Explorer Panel (Running Shift Amounts vs Combined Activity) -->
                <div class="audit-list-panel shadow-sm border-end" style="width: 490px; min-width: 440px; background: #ffffff;">
                    <div class="panel-header flex-column align-items-stretch gap-2 p-2.5 border-bottom bg-light">
                        <div class="d-flex justify-content-between align-items-center">
                            <div class="d-flex align-items-center gap-1.5">
                                <i class="bi bi-compass text-primary fs-6"></i>
                                <span class="fw-black text-uppercase text-dark" style="font-size: 0.76rem; letter-spacing: 0.5px;">TOKEN EXPLORER</span>
                            </div>
                            <span class="badge @(LeftTokenPanelMode == "AMOUNTS" ? "bg-primary" : "bg-dark") text-white rounded-pill shadow-xs" style="font-size: 0.72rem; padding: 4px 10px;">
                                @if (LeftTokenPanelMode == "AMOUNTS")
                                {
                                    <span>@(TokenShiftLedger.Count) SHIFTS & AUDITS</span>
                                }
                                else
                                {
                                    <span>@(CombinedTokenActivity.Count) TRANSACTIONS</span>
                                }
                            </span>
                        </div>
                        
                        <!-- 2-WAY PRIMARY TOGGLE -->
                        <div class="btn-group w-100 shadow-xs" role="group">
                            <button class="btn btn-sm @(LeftTokenPanelMode == "AMOUNTS" ? "btn-primary fw-bold text-white shadow-xs" : "btn-outline-secondary bg-white text-muted")" 
                                    style="font-size: 0.72rem; padding: 6px 10px;" 
                                    @onclick='() => LeftTokenPanelMode = "AMOUNTS"'>
                                <i class="bi bi-stack me-1.5"></i>TOKEN AMOUNTS (BY SHIFT)
                            </button>
                            <button class="btn btn-sm @(LeftTokenPanelMode == "ACTIVITY" ? "btn-primary fw-bold text-white shadow-xs" : "btn-outline-secondary bg-white text-muted")" 
                                    style="font-size: 0.72rem; padding: 6px 10px;" 
                                    @onclick='() => LeftTokenPanelMode = "ACTIVITY"'>
                                <i class="bi bi-arrow-left-right me-1.5"></i>SALES & REDEMPTIONS
                            </button>
                        </div>

                        <!-- SECONDARY QUICK FILTERS -->
                        <div class="d-flex flex-column gap-1.5 pt-1">
                            @if (LeftTokenPanelMode == "AMOUNTS")
                            {
                                <div class="d-flex justify-content-between align-items-center">
                                    <div class="d-flex gap-1">
                                        <button class="btn btn-xs @(_tokenLedgerFilter == "ALL" ? "btn-dark text-white fw-bold" : "btn-outline-secondary text-muted bg-white")" style="font-size: 0.65rem; padding: 2px 8px;" @onclick='() => _tokenLedgerFilter = "ALL"'>ALL TOKENS</button>
                                        <button class="btn btn-xs @(_tokenLedgerFilter == "Beer" ? "btn-success text-white fw-bold" : "btn-outline-secondary text-muted bg-white")" style="font-size: 0.65rem; padding: 2px 8px;" @onclick='() => _tokenLedgerFilter = "Beer"'>BEER ONLY</button>
                                        <button class="btn btn-xs @(_tokenLedgerFilter == "Mixed Drink" ? "btn-danger text-white fw-bold" : "btn-outline-secondary text-muted bg-white")" style="font-size: 0.65rem; padding: 2px 8px;" @onclick='() => _tokenLedgerFilter = "Mixed Drink"'>MIXED DRINK ONLY</button>
                                    </div>
                                    <div class="d-flex gap-1">
                                        <button class="btn btn-xs @(_tokenLedgerEventFilter == "ALL" ? "btn-secondary text-white fw-bold" : "btn-outline-secondary text-muted bg-white")" style="font-size: 0.62rem; padding: 2px 6px;" @onclick='() => _tokenLedgerEventFilter = "ALL"'>ALL</button>
                                        <button class="btn btn-xs @(_tokenLedgerEventFilter == "SHIFTS" ? "btn-outline-primary fw-bold" : "btn-outline-secondary text-muted bg-white")" style="font-size: 0.62rem; padding: 2px 6px;" @onclick='() => _tokenLedgerEventFilter = "SHIFTS"'>SHIFTS</button>
                                        <button class="btn btn-xs @(_tokenLedgerEventFilter == "AUDITS" ? "btn-outline-primary fw-bold" : "btn-outline-secondary text-muted bg-white")" style="font-size: 0.62rem; padding: 2px 6px;" @onclick='() => _tokenLedgerEventFilter = "AUDITS"'>AUDITS</button>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="d-flex justify-content-between align-items-center">
                                    <div class="d-flex gap-1">
                                        <button class="btn btn-xs @(_tokenActivityTypeFilter == "ALL" ? "btn-dark text-white fw-bold" : "btn-outline-secondary text-muted bg-white")" style="font-size: 0.65rem; padding: 2px 8px;" @onclick='() => _tokenActivityTypeFilter = "ALL"'>ALL</button>
                                        <button class="btn btn-xs @(_tokenActivityTypeFilter == "SOLD" ? "btn-danger text-white fw-bold" : "btn-outline-secondary text-muted bg-white")" style="font-size: 0.65rem; padding: 2px 8px;" @onclick='() => _tokenActivityTypeFilter = "SOLD"'>🔴 SOLD</button>
                                        <button class="btn btn-xs @(_tokenActivityTypeFilter == "REDEEMED" ? "btn-success text-white fw-bold" : "btn-outline-secondary text-muted bg-white")" style="font-size: 0.65rem; padding: 2px 8px;" @onclick='() => _tokenActivityTypeFilter = "REDEEMED"'>🟢 REDEEMED</button>
                                    </div>
                                    <div class="d-flex gap-1">
                                        <button class="btn btn-xs @(_tokenActivityTokenFilter == "ALL" ? "btn-secondary text-white fw-bold" : "btn-outline-secondary text-muted bg-white")" style="font-size: 0.65rem; padding: 2px 6px;" @onclick='() => _tokenActivityTokenFilter = "ALL"'>ALL</button>
                                        <button class="btn btn-xs @(_tokenActivityTokenFilter == "Beer" ? "btn-outline-success fw-bold" : "btn-outline-secondary text-muted bg-white")" style="font-size: 0.65rem; padding: 2px 6px;" @onclick='() => _tokenActivityTokenFilter = "Beer"'>BEER</button>
                                        <button class="btn btn-xs @(_tokenActivityTokenFilter == "Mixed Drink" ? "btn-outline-danger fw-bold" : "btn-outline-secondary text-muted bg-white")" style="font-size: 0.65rem; padding: 2px 6px;" @onclick='() => _tokenActivityTokenFilter = "Mixed Drink"'>MIXED</button>
                                    </div>
                                </div>
                            }
                        </div>
                        <!-- PINNED SUMMARY CARDS (Permanently visible, never scrolls) -->
                        <div class="bg-white p-2 border rounded-3 d-flex gap-2 shadow-xs">
                            @foreach (var y in TokenYields)
                            {
                                <div class="flex-fill bg-light-subtle border rounded p-1.5 shadow-xs">
                                    <div class="d-flex justify-content-between align-items-center mb-0.5">
                                        <span class="badge @(y.Token.Name == "Beer" ? "bg-success-subtle text-success" : "bg-danger-subtle text-danger") rounded-pill fw-bold" style="font-size: 0.62rem;">
                                            @y.Token.Name
                                        </span>
                                        <span class="text-muted small" style="font-size: 0.62rem;">@y.LastAuditStatus</span>
                                    </div>
                                    <div class="d-flex justify-content-between align-items-baseline">
                                        <span class="text-muted small" style="font-size: 0.65rem;">Drawer Stock:</span>
                                        <span class="fw-black text-dark fs-6">@y.ExpectedPhysicalStock <span class="small text-muted fw-normal" style="font-size: 0.65rem;">chips</span></span>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>

                    <div class="scroll-container custom-scrollbar" style="overflow-y: auto;">
                        @if (LeftTokenPanelMode == "AMOUNTS")
                        {
                            var filteredLedger = TokenShiftLedger.Where(x => 
                                (_tokenLedgerEventFilter == "ALL" || 
                                 (_tokenLedgerEventFilter == "SHIFTS" && x.EventType == "SHIFT_ACTIVITY") ||
                                 (_tokenLedgerEventFilter == "AUDITS" && x.EventType != "SHIFT_ACTIVITY")) &&
                                (_tokenLedgerFilter == "ALL" || 
                                 (_tokenLedgerFilter == "Beer" && (x.BeerSold > 0 || x.BeerRedeemed > 0 || x.BeerReplenished > 0 || x.BeerAuditCount > 0 || x.EventType != "SHIFT_ACTIVITY")) ||
                                 (_tokenLedgerFilter == "Mixed Drink" && (x.MixedSold > 0 || x.MixedRedeemed > 0 || x.MixedReplenished > 0 || x.MixedAuditCount > 0 || x.EventType != "SHIFT_ACTIVITY")))
                            ).ToList();

                            @if (!filteredLedger.Any())
                            {
                                <div class="text-center py-5 text-muted">
                                    <i class="bi bi-stack fs-2 opacity-50 d-block mb-2 text-primary"></i>
                                    <div class="fw-bold text-dark">No shift ledger entries recorded.</div>
                                    <div class="small">Perform a physical audit count or record sales to begin tracking.</div>
                                </div>
                            }
                            else
                            {
                                <div class="d-flex flex-column gap-2 p-2.5">
                                    @foreach (var entry in filteredLedger)
                                    {
                                        <div class="card border rounded-3 p-2.5 shadow-xs transition-hover" style="background: @(entry.EventType == "AUDIT_BASELINE_SET" ? "#eff6ff" : (entry.EventType == "STOCK_REPLENISHED" ? "#f5f3ff" : "#ffffff")); border-color: @(entry.EventType == "AUDIT_BASELINE_SET" ? "#bfdbfe" : (entry.EventType == "STOCK_REPLENISHED" ? "#ddd6fe" : "#e5e7eb")) !important;">
                                            <!-- Top Header: Shift Badge, Date, Bartender, Time -->
                                            <div class="d-flex justify-content-between align-items-center mb-2 pb-1.5 border-bottom">
                                                <div class="d-flex align-items-center gap-1.5 flex-wrap">
                                                    @if (entry.EventType == "SHIFT_ACTIVITY")
                                                    {
                                                        <span class="badge @(entry.ShiftType == "Night" ? "bg-dark text-white shadow-xs" : "bg-warning text-dark border border-warning shadow-xs") rounded-pill fw-bold" style="font-size: 0.62rem; padding: 2px 7px;">
                                                            @(entry.ShiftType == "Night" ? "🌙 NIGHT SHIFT" : "☀️ DAY SHIFT")
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-primary text-white rounded-pill fw-bold" style="font-size: 0.62rem; padding: 2px 7px;">
                                                            <i class="bi bi-clipboard-check me-1"></i>@(entry.EventType == "STOCK_REPLENISHED" ? "REPLENISHMENT" : "PHYSICAL AUDIT")
                                                        </span>
                                                    }
                                                    <span class="fw-bold text-dark" style="font-size: 0.8rem;">@entry.ShiftLabel</span>
                                                    <span class="text-muted small" style="font-size: 0.72rem;">• <i class="bi bi-person-fill text-secondary me-0.5"></i><strong>@entry.BartenderName</strong></span>
                                                </div>
                                                <span class="text-muted small" style="font-size: 0.68rem;">@entry.Timestamp.ToString("MMM dd, h:mm tt")</span>
                                            </div>

                                            @if (entry.EventType == "SHIFT_ACTIVITY")
                                            {
                                                <!-- COMBINED TOKEN ROWS (BEER & MIXED DRINK) -->
                                                <div class="d-flex flex-column gap-1.5">
                                                    <!-- BEER ROW -->
                                                    @if (_tokenLedgerFilter == "ALL" || _tokenLedgerFilter == "Beer")
                                                    {
                                                        <div class="d-flex justify-content-between align-items-center bg-light rounded-2 p-1.5 px-2 border border-light-subtle">
                                                            <div class="d-flex align-items-center gap-2">
                                                                <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill fw-black" style="font-size: 0.62rem; padding: 2px 6px; width: 48px; text-align: center;">
                                                                    BEER
                                                                </span>
                                                                <div class="d-flex align-items-center gap-1.5">
                                                                    @if (entry.BeerSold > 0)
                                                                    {
                                                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle fw-bold" style="font-size: 0.65rem;">
                                                                            -@entry.BeerSold Sold
                                                                        </span>
                                                                    }
                                                                    @if (entry.BeerRedeemed > 0)
                                                                    {
                                                                        <span class="badge bg-success-subtle text-success border border-success-subtle fw-bold" style="font-size: 0.65rem;">
                                                                            +@entry.BeerRedeemed Redeemed
                                                                        </span>
                                                                    }
                                                                    @if (entry.BeerSold == 0 && entry.BeerRedeemed == 0)
                                                                    {
                                                                        <span class="text-muted small" style="font-size: 0.65rem;">No movement</span>
                                                                    }
                                                                </div>
                                                            </div>
                                                            <!-- Right: Running Total -->
                                                            <div class="d-flex align-items-center gap-2">
                                                                <span class="small fw-semibold @(entry.BeerNetChange > 0 ? "text-success" : (entry.BeerNetChange < 0 ? "text-danger" : "text-muted"))" style="font-size: 0.62rem;">
                                                                    @(entry.BeerNetChange > 0 ? $"+{entry.BeerNetChange} net" : (entry.BeerNetChange < 0 ? $"{entry.BeerNetChange} net" : "0 change"))
                                                                </span>
                                                                <div class="d-flex align-items-baseline gap-0.5">
                                                                    <span class="fw-black text-dark" style="font-size: 0.88rem;">@entry.BeerEndingStock</span>
                                                                    <span class="small text-muted" style="font-size: 0.62rem;">chips</span>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    }

                                                    <!-- MIXED DRINK ROW -->
                                                    @if (_tokenLedgerFilter == "ALL" || _tokenLedgerFilter == "Mixed Drink")
                                                    {
                                                        <div class="d-flex justify-content-between align-items-center bg-light rounded-2 p-1.5 px-2 border border-light-subtle">
                                                            <div class="d-flex align-items-center gap-2">
                                                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill fw-black" style="font-size: 0.62rem; padding: 2px 6px; width: 48px; text-align: center;">
                                                                    MIXED
                                                                </span>
                                                                <div class="d-flex align-items-center gap-1.5">
                                                                    @if (entry.MixedSold > 0)
                                                                    {
                                                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle fw-bold" style="font-size: 0.65rem;">
                                                                            -@entry.MixedSold Sold
                                                                        </span>
                                                                    }
                                                                    @if (entry.MixedRedeemed > 0)
                                                                    {
                                                                        <span class="badge bg-success-subtle text-success border border-success-subtle fw-bold" style="font-size: 0.65rem;">
                                                                            +@entry.MixedRedeemed Redeemed
                                                                        </span>
                                                                    }
                                                                    @if (entry.MixedSold == 0 && entry.MixedRedeemed == 0)
                                                                    {
                                                                        <span class="text-muted small" style="font-size: 0.65rem;">No movement</span>
                                                                    }
                                                                </div>
                                                            </div>
                                                            <!-- Right: Running Total -->
                                                            <div class="d-flex align-items-center gap-2">
                                                                <span class="small fw-semibold @(entry.MixedNetChange > 0 ? "text-success" : (entry.MixedNetChange < 0 ? "text-danger" : "text-muted"))" style="font-size: 0.62rem;">
                                                                    @(entry.MixedNetChange > 0 ? $"+{entry.MixedNetChange} net" : (entry.MixedNetChange < 0 ? $"{entry.MixedNetChange} net" : "0 change"))
                                                                </span>
                                                                <div class="d-flex align-items-baseline gap-0.5">
                                                                    <span class="fw-black text-dark" style="font-size: 0.88rem;">@entry.MixedEndingStock</span>
                                                                    <span class="small text-muted" style="font-size: 0.62rem;">chips</span>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    }
                                                </div>
                                            }
                                            else
                                            {
                                                <!-- AUDIT / REPLENISHMENT DETAILS -->
                                                <div class="bg-white rounded-2 p-2 border">
                                                    <div class="fw-semibold text-dark small mb-1" style="font-size: 0.75rem;">@entry.Notes</div>
                                                    <div class="d-flex justify-content-between align-items-center pt-1 border-top">
                                                        <div class="d-flex gap-2">
                                                            <span class="badge bg-success-subtle text-success border" style="font-size: 0.65rem;">Beer: @entry.BeerEndingStock chips</span>
                                                            <span class="badge bg-danger-subtle text-danger border" style="font-size: 0.65rem;">Mixed: @entry.MixedEndingStock chips</span>
                                                        </div>
                                                        <div class="small fw-bold text-muted" style="font-size: 0.68rem;">
                                                            Drawer Total: <strong class="text-dark">@entry.TotalEndingStock</strong>
                                                        </div>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        }
                        else
                        {
                            var filteredActivity = CombinedTokenActivity.Where(x => 
                                (_tokenActivityTypeFilter == "ALL" || x.ActivityType == _tokenActivityTypeFilter) && 
                                (_tokenActivityTokenFilter == "ALL" || string.Equals(x.TokenName, _tokenActivityTokenFilter, StringComparison.OrdinalIgnoreCase))
                            ).ToList();

                            <table class="table table-hover align-middle mb-0" style="font-size: 0.82rem;">
                                <thead class="bg-light sticky-top shadow-xs">
                                    <tr>
                                        <th class="ps-3 py-2">ITEM / DRINK</th>
                                        <th class="text-center py-2">DATE/TIME</th>
                                        <th class="text-center py-2">QTY</th>
                                        <th class="pe-3 text-end py-2">AMOUNT</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (!filteredActivity.Any())
                                    {
                                        <tr>
                                            <td colspan="4" class="text-center py-5 text-muted">
                                                <i class="bi bi-arrow-left-right fs-2 opacity-50 d-block mb-1"></i>
                                                <div>No token sales or redemptions recorded in this timeframe.</div>
                                            </td>
                                        </tr>
                                    }
                                    else
                                    {
                                        @foreach (var act in filteredActivity)
                                        {
                                            <tr>
                                                <td class="ps-3 py-2">
                                                    <div class="d-flex align-items-center gap-1.5">
                                                        <span class="badge @(act.ActivityType == "REDEEMED" ? "bg-success" : "bg-danger") text-white fw-bold" style="font-size: 0.58rem; padding: 2px 5px;">
                                                            @(act.ActivityType == "REDEEMED" ? "REDEEM" : "SALE")
                                                        </span>
                                                        <div class="fw-bold text-dark text-truncate" style="max-width: 170px;" title="@act.ItemName">@act.ItemName</div>
                                                    </div>
                                                    <div class="small text-muted d-flex align-items-center gap-1 mt-0.5" style="font-size: 0.68rem;">
                                                        <span class="badge @(act.TokenName == "Beer" ? "bg-success-subtle text-success" : "bg-danger-subtle text-danger") rounded-pill" style="font-size: 0.55rem; padding: 1px 5px;">@act.TokenName</span>
                                                        <span>• @act.BartenderName</span>
                                                        @if (act.IsUpgrade)
                                                        {
                                                            <span class="badge bg-info-subtle text-info rounded-pill" style="font-size: 0.52rem; padding: 1px 4px;">UPG</span>
                                                        }
                                                    </div>
                                                </td>
                                                <td class="text-center py-2 text-muted" style="white-space: nowrap; font-size: 0.72rem;">@act.Timestamp.ToString("MM/dd h:mm tt")</td>
                                                <td class="text-center py-2 fw-black @(act.ActivityType == "REDEEMED" ? "text-success" : "text-danger")">@act.Quantity</td>
                                                <td class="pe-3 text-end py-2">
                                                    @if (act.ActivityType == "REDEEMED")
                                                    {
                                                        <div class="fw-black text-dark">@act.PriceOrValue.ToString("C")</div>
                                                        <div class="small text-muted" style="font-size: 0.6rem;">Menu Value</div>
                                                    }
                                                    else
                                                    {
                                                        <div class="fw-black text-success">@((act.PriceOrValue * act.Quantity).ToString("C"))</div>
                                                        @if (act.Quantity > 1)
                                                        {
                                                            <div class="small text-muted" style="font-size: 0.6rem;">@act.PriceOrValue.ToString("C")/ea</div>
                                                        }
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        }
                    </div>
                </div>
            }
            <!-- MIDDLE: Receipt Viewer or Z-Report -->
            @if (ActiveTab == "INVENTORY")
            {
                <!-- MIDDLE (EXPANDED): Unified Inventory Hub (FULL SIZE) -->
                <div class="audit-recon-panel bg-white border-end d-flex flex-column h-100 overflow-hidden" style="background: #f8fafc !important; flex: 1;">
                    
                    <!-- Sub-tabs navigation -->
                    <div class="px-5 pt-4 pb-2 bg-white border-bottom flex-shrink-0 d-flex justify-content-between align-items-center">
                        <div class="d-flex gap-2 flex-wrap">
                            <button class="btn btn-sm rounded-pill px-4 @(_inventorySubTab == "ledger" ? "btn-primary fw-bold shadow-xs" : "btn-light text-muted fw-bold border-0")" style="font-size: 0.78rem;" @onclick='() => SetInventorySubTab("ledger")'>
                                <i class="bi bi-clock-history me-1"></i> ACTIVITY LEDGER
                            </button>
                            <button class="btn btn-sm rounded-pill px-4 @(_inventorySubTab == "stock" ? "btn-primary fw-bold shadow-xs" : "btn-light text-muted fw-bold border-0")" style="font-size: 0.78rem;" @onclick='() => SetInventorySubTab("stock")'>
                                <i class="bi bi-box-seam me-1"></i> CURRENT STOCK
                            </button>
                            <button class="btn btn-sm rounded-pill px-4 @(_inventorySubTab == "trends" ? "btn-primary fw-bold shadow-xs" : "btn-light text-muted fw-bold border-0")" style="font-size: 0.78rem;" @onclick='() => SetInventorySubTab("trends")'>
                                <i class="bi bi-graph-up me-1"></i> PULL TRENDS
                            </button>
                            <button class="btn btn-sm rounded-pill px-4 @(_inventorySubTab == "ranking" ? "btn-primary fw-bold shadow-xs" : "btn-light text-muted fw-bold border-0")" style="font-size: 0.78rem;" @onclick='() => SetInventorySubTab("ranking")'>
                                <i class="bi bi-trophy me-1"></i> PERFORMANCE RANKING
                            </button>
                            <button class="btn btn-sm rounded-pill px-4 @(_inventorySubTab == "reorder" ? "btn-primary fw-bold shadow-xs" : "btn-light text-muted fw-bold border-0")" style="font-size: 0.78rem;" @onclick='() => SetInventorySubTab("reorder")'>
                                <i class="bi bi-cpu me-1"></i> REORDER PREDICTOR
                            </button>
                            <button class="btn btn-sm rounded-pill px-4 @(_inventorySubTab == "product_trends" ? "btn-primary fw-bold shadow-xs" : "btn-light text-muted fw-bold border-0")" style="font-size: 0.78rem;" @onclick='() => SetInventorySubTab("product_trends")'>
                                <i class="bi bi-graph-up-arrow me-1"></i> PRODUCT TRENDS
                            </button>
                            <button class="btn btn-sm rounded-pill px-4 @(_inventorySubTab == "insights" ? "btn-primary fw-bold shadow-xs" : "btn-light text-muted fw-bold border-0")" style="font-size: 0.78rem;" @onclick='() => SetInventorySubTab("insights")'>
                                <i class="bi bi-pie-chart me-1"></i> VISUAL INSIGHTS
                            </button>
                        </div>
                        
                        @if (FilterShiftId.HasValue && SelectedZReport != null)
                        {
                            <div class="badge bg-primary text-white p-2 rounded-pill px-3 fw-bold border shadow-sm" style="font-size: 0.7rem;">
                                <i class="bi bi-funnel-fill me-1"></i>Shift: @SelectedZReport.BartenderName (@SelectedZReport.TerminalName)
                                <i class="bi bi-x-circle-fill ms-2" @onclick="ClearShiftFilter" style="cursor: pointer;" title="Clear Shift Filter"></i>
                            </div>
                        }
                    </div>

                    @if (_inventorySubTab == "ledger")
                    {
                        <!-- Ledger Filter Bar -->
                        <div class="px-5 pt-3 pb-2 flex-shrink-0 bg-white border-bottom">
                            <div class="row g-2 p-2 bg-light rounded-4 border align-items-end">
                                <div class="col-md-5">
                                    <label class="form-label small fw-bold text-muted mb-1" style="font-size: 0.75rem;">Search Product</label>
                                    <input type="text" class="form-control form-control-sm fw-bold bg-white" placeholder="Search product..." @bind="_ledgerSearchText" @bind:after="RefreshLedgerOnly" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label small fw-bold text-muted mb-1" style="font-size: 0.75rem;">Action Type</label>
                                    <select class="form-select form-select-sm fw-bold bg-white" @bind="_ledgerActionType" @bind:after="RefreshLedgerOnly">
                                        <option value="ALL">All Actions</option>
                                        <option value="PULL">Pulls (Z-Report End-of-Shift)</option>
                                        <option value="RESTOCK">Restocks / Orders</option>
                                        <option value="CORRECTION">Corrections / Adjustments</option>
                                    </select>
                                </div>
                                <div class="col-md-3">
                                    <button class="btn btn-outline-secondary btn-sm w-100 fw-bold border bg-white" @onclick="ClearLedgerFilters">
                                        <i class="bi bi-eraser-fill me-1"></i> Clear
                                    </button>
                                </div>
                            </div>
                        </div>

                        <div class="flex-grow-1 custom-scrollbar px-5 pb-4 bg-white" style="overflow-y: auto;">
                            <table class="table table-hover align-middle border mb-0" style="font-size: 0.82rem;">
                                <thead class="bg-light sticky-top shadow-xs">
                                    <tr>
                                        <th class="ps-4">TIMESTAMP</th>
                                        <th>PRODUCT</th>
                                        <th class="text-center">ACTION</th>
                                        <th class="text-center">QTY CHANGE</th>
                                        <th>PERFORMED BY</th>
                                        <th class="pe-4">NOTES / REFERENCE</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (_ledgerTransactions == null || !_ledgerTransactions.Any())
                                    {
                                        <tr>
                                            <td colspan="6" class="text-center py-5 text-muted fw-bold">
                                                No inventory activity found matching the criteria.
                                            </td>
                                        </tr>
                                    }
                                    else
                                    {
                                        @foreach (var tx in _ledgerTransactions)
                                        {
                                            <tr>
                                                <td class="ps-4 text-muted small fw-bold">
                                                    @tx.Timestamp.ToLocalTime().ToString("MM/dd/yy h:mm tt")
                                                </td>
                                                <td class="fw-black text-dark">
                                                    @(tx.Item?.Name ?? $"Product #{tx.ItemId}")
                                                </td>
                                                <td class="text-center">
                                                    @{
                                                        var isPull = tx.TransactionType == "Checkout" || (tx.Notes != null && tx.Notes.Contains("POS Sale"));
                                                        var isRestock = tx.TransactionType == "Restock";
                                                        var isAdjustment = tx.TransactionType == "Adjustment" || tx.TransactionType == "Update" || tx.TransactionType == "Reconcile";
                                                        
                                                        string badgeClass = "bg-secondary";
                                                        string label = tx.TransactionType.ToUpper();
                                                        
                                                        if (isPull) { badgeClass = "bg-danger"; label = "POS PULL"; }
                                                        else if (isRestock) { badgeClass = "bg-success"; label = "RESTOCK"; }
                                                        else if (isAdjustment) { badgeClass = "bg-primary"; label = "CORRECTION"; }
                                                    }
                                                    <span class="badge rounded-pill pt-1 px-3 @badgeClass" style="font-size: 0.65rem; font-weight: 800;">
                                                        @label
                                                    </span>
                                                </td>
                                                <td class="text-center fw-black">
                                                    @if (tx.ChangeAmount > 0)
                                                    {
                                                        <span class="text-success">+@tx.ChangeAmount</span>
                                                    }
                                                    else if (tx.ChangeAmount < 0)
                                                    {
                                                        <span class="text-danger">@tx.ChangeAmount</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted">-</span>
                                                    }
                                                </td>
                                                <td class="text-muted small">
                                                    @(tx.User?.Username ?? "System / POS")
                                                </td>
                                                <td class="pe-4 text-muted small">
                                                    @tx.Notes
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else if (_inventorySubTab == "stock")
                    {
                        <div class="px-5 pt-3 pb-2 flex-shrink-0 bg-white border-bottom">
                            <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                                <div>
                                    <h5 class="fw-black mb-0 text-dark">CURRENT LIQUOR STOCK LEVELS</h5>
                                    <small class="text-muted fw-bold d-flex align-items-center gap-2 mt-1" style="font-size: 0.72rem;">
                                        <span class="badge bg-primary-subtle text-primary border px-2 py-0.5 rounded-pill" style="font-size: 0.65rem;">🥃 Shot Standard: @(_settings?.GlobalLiquorPourSize.ToString("F2") ?? "2.00") oz</span>
                                    </small>
                                </div>
                                <div class="d-flex gap-2 align-items-center">
                                    <div class="d-flex flex-column align-items-end">
                                        <div class="form-check form-switch bg-white rounded-pill px-3 py-1.5 border shadow-sm d-inline-flex align-items-center gap-2 cursor-pointer me-1">
                                            <input class="form-check-input ms-0 cursor-pointer" type="checkbox" id="barStockStockTabSwitch" @bind="_includeBarStock" @bind:after="OnStockFiltersChanged" />
                                            <label class="form-check-label fw-bold text-dark cursor-pointer mb-0" for="barStockStockTabSwitch" style="font-size: 0.72rem; user-select: none;">
                                                <i class="bi bi-funnel-fill text-primary me-1"></i>BAR STOCK
                                            </label>
                                        </div>
                                        @if (_lastInventoryAuditDate.HasValue)
                                        {
                                            <div class="text-muted extra-small mt-0.5 pe-1" style="font-size: 0.62rem;">
                                                Last Audit: <strong class="text-dark">@_lastInventoryAuditDate.Value.ToString("MM/dd/yy")</strong>
                                            </div>
                                        }
                                    </div>
                                    <div class="btn-group btn-group-sm rounded-pill p-1 bg-light border me-2" style="font-size: 0.72rem;">
                                        <button class="btn btn-sm rounded-pill px-3 @(_stockViewMode == "CARDS" ? "btn-primary text-white" : "btn-light text-muted border-0")" style="font-size: 0.75rem;" @onclick='() => SetStockViewMode("CARDS")'>CARD VIEW</button>
                                        <button class="btn btn-sm rounded-pill px-3 @(_stockViewMode == "VISUAL" ? "btn-primary text-white" : "btn-light text-muted border-0")" style="font-size: 0.75rem;" @onclick='() => SetStockViewMode("VISUAL")'>VISUAL VIEW</button>
                                    </div>
                                    <select class="form-select fw-bold bg-light" style="max-width: 180px; font-size: 0.85rem;" @bind="_stockCategoryFilter" @bind:after="OnStockFiltersChanged">
                                        <option value="ALL">ALL CATEGORIES</option>
                                        @foreach (var cat in DbLiquorItems.Where(i => i.IsActive && IsLiquorInventoryItem(i) && !string.IsNullOrEmpty(i.Category)).Select(i => i.Category.ToUpper()).Distinct().OrderBy(c => c))
                                        {
                                            <option value="@cat">@cat</option>
                                        }
                                    </select>
                                    <select class="form-select fw-bold bg-light" style="max-width: 180px; font-size: 0.85rem;" @bind="_stockSortOption" @bind:after="OnStockFiltersChanged">
                                        <option value="NAME_ASC">SORT: NAME A-Z</option>
                                        <option value="STOCK_DESC">SORT: STOCK HIGH-LOW</option>
                                        <option value="STOCK_ASC">SORT: STOCK LOW-HIGH</option>
                                        <option value="USAGE_DESC">SORT: USAGE HIGH-LOW</option>
                                    </select>
                                    <div class="input-group" style="max-width: 250px;">
                                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-search"></i></span>
                                        <input type="text" class="form-control fw-bold bg-light" placeholder="Search stock..." @bind="_stockSearchText" @bind:event="oninput" @onkeyup="OnStockSearchKeyup" style="font-size: 0.85rem;" />
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="flex-grow-1 overflow-auto custom-scrollbar px-5 py-4 bg-white">
                            @if (_stockViewMode == "CARDS")
                            {
                                <div class="row g-3">
                                    @foreach (var item in GetSortedStockItems(_stockPullsInPeriod))
                                    {
                                        var isMainLow = IsLocationLowStock(item, "MAIN_STORAGE");
                                        var isDownLow = IsLocationLowStock(item, "DOWNSTAIRS_BAR");
                                        var isUpLow = IsLocationLowStock(item, "UPSTAIRS_BAR");
                                        var isTotalLow = _includeBarStock ? IsLocationLowStock(item, "ALL") : isMainLow;

                                        var mainStock = GetStockSummaryForLocation(item, "MAIN_STORAGE");
                                        var downStock = GetStockSummaryForLocation(item, "DOWNSTAIRS_BAR");
                                        var upStock = GetStockSummaryForLocation(item, "UPSTAIRS_BAR");
                                        var totalStock = _includeBarStock ? GetStockSummaryForLocation(item, "ALL") : mainStock;

                                        <div class="col-12 col-md-6 col-lg-4 col-xxl-3">
                                            <div class="card border rounded-4 shadow-sm h-100 bg-white">
                                                <div class="card-body p-3 d-flex flex-column justify-content-between">
                                                    <div>
                                                        <!-- Title & Size -->
                                                        <div class="d-flex justify-content-between align-items-start gap-2 mb-1">
                                                            <h6 class="fw-black text-dark mb-0 text-uppercase text-truncate" style="font-size: 0.85rem; max-width: 70%;" title="@item.Name">@item.Name</h6>
                                                            <span class="badge bg-light text-muted border text-uppercase" style="font-size: 0.65rem; flex-shrink: 0;">@item.BottleSize</span>
                                                        </div>
                                                        <!-- Category Label -->
                                                        <div class="mb-3">
                                                            <span class="badge bg-secondary-subtle text-secondary text-uppercase" style="font-size: 0.62rem; font-weight: 700;">@item.Category</span>
                                                            @if ((item.IsUnitBased || item.IsBeer) && !_includeBarStock)
                                                            {
                                                                <!-- Single Stock Display for Main Storage Only -->
                                                                <div class="p-2 bg-light rounded text-center border border-light mb-2">
                                                                    <div class="text-muted fw-bold extra-small text-uppercase mb-1" style="font-size: 0.55rem; letter-spacing: 0.5px;">Main Storage Stock</div>
                                                                    <span class="badge @(isMainLow ? "bg-danger" : "bg-success") text-white fw-bold px-3 py-1.5" style="font-size: 0.78rem; display: inline-block;">
                                                                        @mainStock
                                                                    </span>
                                                                </div>
                                                            }
                                                            else
                                                            {
                                                                <!-- 3-Column Location Grid for Liquor and Wine -->
                                                                <div class="row g-2 mb-2">
                                                                    <!-- Main Storage -->
                                                                    <div class="col-4">
                                                                        <div class="p-2 bg-light rounded text-center h-100 border border-light">
                                                                            <div class="text-muted fw-bold extra-small text-uppercase mb-1" style="font-size: 0.55rem; letter-spacing: 0.5px;">Main</div>
                                                                            <span class="badge @(isMainLow ? "bg-danger" : "bg-success") text-white fw-bold px-1 py-1" style="font-size: 0.68rem; display: block; white-space: normal; line-height: 1.2; min-height: 1.8rem; display: flex; align-items: center; justify-content: center;">
                                                                                @mainStock
                                                                            </span>
                                                                        </div>
                                                                    </div>
                                                                    <!-- Downstairs Bar -->
                                                                    <div class="col-4">
                                                                        <div class="p-2 bg-light rounded text-center h-100 border border-light">
                                                                            <div class="text-muted fw-bold extra-small text-uppercase mb-1" style="font-size: 0.55rem; letter-spacing: 0.5px;">Down</div>
                                                                            <span class="badge @(isDownLow ? "bg-danger" : "bg-success") text-white fw-bold px-1 py-1" style="font-size: 0.68rem; display: block; white-space: normal; line-height: 1.2; min-height: 1.8rem; display: flex; align-items: center; justify-content: center;">
                                                                                @downStock
                                                                            </span>
                                                                        </div>
                                                                    </div>
                                                                    <!-- Upstairs Bar -->
                                                                    <div class="col-4">
                                                                        <div class="p-2 bg-light rounded text-center h-100 border border-light">
                                                                            <div class="text-muted fw-bold extra-small text-uppercase mb-1" style="font-size: 0.55rem; letter-spacing: 0.5px;">Up</div>
                                                                            <span class="badge @(isUpLow ? "bg-danger" : "bg-success") text-white fw-bold px-1 py-1" style="font-size: 0.68rem; display: block; white-space: normal; line-height: 1.2; min-height: 1.8rem; display: flex; align-items: center; justify-content: center;">
                                                                                @upStock
                                                                            </span>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            }
                                                        </div>
                                                    </div>

                                                    <!-- Total Footer -->
                                                    <div class="border-top pt-2 d-flex justify-content-between align-items-center">
                                                        <span class="text-muted fw-bold" style="font-size: 0.68rem; letter-spacing: 0.5px;">TOTAL STOCK:</span>
                                                        <span class="badge @(isTotalLow ? "bg-danger" : "bg-success") text-white fw-black px-2 py-1" style="font-size: 0.72rem;">
                                    @totalStock
                                                        </span>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="card border rounded-4 shadow-sm p-4 bg-white">
                                    <!-- Stock Movement & Activity Header -->
                                    <div class="d-flex justify-content-between align-items-center mb-3 pb-3 border-bottom flex-wrap gap-2">
                                        <div>
                                            <h6 class="fw-black mb-1 text-dark d-flex align-items-center gap-2">
                                                <i class="bi bi-bar-chart-line-fill text-primary"></i>CURRENT LIQUOR STOCK LEVELS
                                            </h6>
                                            <div class="text-muted extra-small" style="font-size: 0.68rem;">
                                                @if (_stockChartMode == "COMPARISON")
                                                {
                                                    <span>Comparing starting baseline stock vs. current on-hand levels, restocked quantities, and units sold.</span>
                                                }
                                                else
                                                {
                                                    <span>Displaying current on-hand stock and quantities consumed during the selected period.</span>
                                                }
                                            </div>
                                        </div>
                                        <div class="d-flex align-items-center gap-2 flex-wrap">
                                            <!-- Mode Selector Button Group -->
                                            <div class="btn-group btn-group-sm rounded-pill p-1 bg-light border me-1" style="font-size: 0.72rem;">
                                                <button class="btn btn-sm rounded-pill px-3 @(_stockChartMode == "STANDARD" ? "btn-primary text-white shadow-sm" : "btn-light text-muted border-0")" style="font-size: 0.72rem;" @onclick='() => SetStockChartMode("STANDARD")'>STOCK VS USAGE</button>
                                                <button class="btn btn-sm rounded-pill px-3 @(_stockChartMode == "COMPARISON" ? "btn-primary text-white shadow-sm" : "btn-light text-muted border-0")" style="font-size: 0.72rem;" @onclick='() => SetStockChartMode("COMPARISON")'>COMPARE STARTING VS CURRENT</button>
                                            </div>

                                            @if (_lastInventoryRestockDate.HasValue)
                                            {
                                                <span class="badge bg-success-subtle text-success border border-success-subtle px-2.5 py-1.5 rounded-pill" style="font-size: 0.68rem;">
                                                    <i class="bi bi-box-seam me-1"></i>Last Restock: <strong>@_lastInventoryRestockDate.Value.ToString("MM/dd/yy h:mm tt")</strong>
                                                </span>
                                            }
                                            @if (_lastInventoryAuditDate.HasValue)
                                            {
                                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2.5 py-1.5 rounded-pill" style="font-size: 0.68rem;">
                                                    <i class="bi bi-clipboard-check me-1"></i>Last Audit: <strong>@_lastInventoryAuditDate.Value.ToString("MM/dd/yy h:mm tt")</strong>
                                                </span>
                                            }
                                        </div>
                                    </div>

                                    <div class="chart-container" style="position: relative; width: 100%; min-height: 480px; height: 480px;">
                                        <canvas id="currentStockLevelsChart"></canvas>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else if (_inventorySubTab == "trends")
                    {
                        <!-- Pull Trends Graph & Weekly Details -->
                        <div class="flex-grow-1 d-flex flex-column bg-white p-5" style="overflow-y: auto;">
                            <h5 class="fw-black mb-3 text-dark d-flex align-items-center">
                                <i class="bi bi-graph-up me-2 text-primary"></i>INVENTORY PULL TRENDS (BOTTLES REMOVED BY PRODUCT)
                            </h5>
                            
                            <div class="chart-container bg-light rounded-4 border p-4 mb-4" style="position: relative; width: 100%; min-height: 350px; height: 350px; flex-shrink: 0;">
                                <canvas id="pullTrendsChart"></canvas>
                            </div>

                            <!-- Weekly Breakdown Section -->
                            <div class="card border rounded-4 p-4 shadow-sm bg-white flex-shrink-0">
                                <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                                    <div>
                                        <h6 class="fw-black mb-1 text-dark d-flex align-items-center">
                                            <i class="bi bi-list-ul me-2 text-primary"></i>ITEM REMOVAL BREAKDOWN
                                        </h6>
                                        <span class="text-muted small">Detailed list of all products removed from inventory for the selected period</span>
                                    </div>
                                </div>

                                <div class="table-responsive">
                                    <table class="table table-hover align-middle mb-0" style="font-size: 0.82rem;">
                                        <thead class="bg-light">
                                            <tr class="text-muted extra-small text-uppercase">
                                                <th class="ps-4">Product Name</th>
                                                <th class="text-center">Category</th>
                                                <th class="text-center">Bottle Size</th>
                                                <th class="text-center">Quantity Removed</th>
                                                <th class="pe-4 text-end">Wholesale Cost</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @if (_weeklyBreakdownItems == null || !_weeklyBreakdownItems.Any())
                                            {
                                                <tr>
                                                    <td colspan="5" class="text-center py-4 text-muted fw-bold">
                                                        No removals recorded for the selected filter range.
                                                    </td>
                                                </tr>
                                            }
                                            else
                                            {
                                                @foreach (var b in _weeklyBreakdownItems)
                                                {
                                                    <tr>
                                                        <td class="ps-4 fw-black text-dark">@b.Name.ToUpper()</td>
                                                        <td class="text-center"><span class="badge bg-light text-muted border text-uppercase" style="font-size: 0.7rem;">@b.Category</span></td>
                                                        <td class="text-center text-muted fw-bold">@b.Size</td>
                                                        <td class="text-center">
                                                            <span class="badge bg-danger-subtle text-danger fw-black" style="font-size: 0.78rem; padding: 5px 10px; border-radius: 6px;">
                                                                -@b.Quantity bottles
                                                            </span>
                                                        </td>
                                                        <td class="pe-4 text-end fw-black text-dark">
                                                            <div>@b.TotalCost.ToString("C")</div>
                                                            <div class="text-muted extra-small" style="font-size: 0.65rem;">@b.UnitCost.ToString("C")/ea</div>
                                                        </td>
                                                    </tr>
                                                }
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    }
                    else if (_inventorySubTab == "insights")
                    {
                        <div class="flex-grow-1 d-flex flex-column bg-light p-4" style="overflow-y: auto;">
                            <!-- BAR STOCK FILTER SWITCH -->
                            <div class="d-flex flex-column align-items-end mb-3">
                                <div class="form-check form-switch bg-white rounded-pill px-4 py-2 border shadow-sm d-inline-flex align-items-center gap-2 cursor-pointer">
                                    <input class="form-check-input ms-0 cursor-pointer" type="checkbox" id="barStockSwitch" @bind="_includeBarStock" @bind:after="OnBarStockToggleChanged" />
                                    <label class="form-check-label fw-bold text-dark cursor-pointer extra-small mb-0" for="barStockSwitch" style="font-size: 0.72rem; user-select: none;">
                                        <i class="bi bi-funnel-fill text-primary me-1"></i>INCLUDE ACTIVE BAR STOCK
                                    </label>
                                </div>
                                @if (_lastInventoryAuditDate.HasValue)
                                {
                                    <div class="text-muted extra-small mt-1 pe-2" style="font-size: 0.65rem;">
                                        <i class="bi bi-clock-history me-1 text-secondary"></i>Last bar audit: <strong class="text-dark">@_lastInventoryAuditDate.Value.ToString("MM/dd/yyyy h:mm tt")</strong>
                                    </div>
                                }
                                else
                                {
                                    <div class="text-muted extra-small mt-1 pe-2" style="font-size: 0.65rem;">
                                        <i class="bi bi-clock-history me-1 text-secondary"></i>Last bar audit: <span class="fst-italic text-muted">Never audited</span>
                                    </div>
                                }
                            </div>
                            <!-- STATS CARDS GRID -->
                            <div class="row g-3 mb-4">
                                <div class="col-12 col-sm-6 col-xl">
                                    <div class="card border rounded-4 shadow-sm p-3 bg-white h-100" @onclick='() => OpenInsightsDetail("SALES")' style="cursor: pointer;">
                                        <div class="text-muted fw-bold extra-small text-uppercase mb-1" style="font-size: 0.65rem;">TOTAL POS SALES</div>
                                        <div class="d-flex justify-content-between align-items-baseline">
                                            <span class="fs-4 fw-black text-dark">@InsightsTotalSales.ToString("C")</span>
                                            <div class="text-end" title="@InsightsComparisonTooltip">
                                                <span class="badge @(InsightsSalesDiffPercent >= 0 ? "bg-success-subtle text-success" : "bg-danger-subtle text-danger")" style="font-size: 0.72rem;">
                                                    @(InsightsSalesDiffPercent >= 0 ? "+" : "")@InsightsSalesDiffPercent.ToString("F1")%
                                                </span>
                                                <div class="text-muted fw-bold extra-small mt-0.5" style="font-size: 0.52rem;">@InsightsComparisonLabel</div>
                                            </div>
                                        </div>
                                        <div class="text-muted extra-small mt-1" style="font-size: 0.62rem;">Tickets: @InsightsTotalTickets</div>
                                    </div>
                                </div>
                                <div class="col-12 col-sm-6 col-xl">
                                    <div class="card border rounded-4 shadow-sm p-3 bg-white h-100" @onclick='() => OpenInsightsDetail("AVERAGE_TICKET")' style="cursor: pointer;">
                                        <div class="text-muted fw-bold extra-small text-uppercase mb-1" style="font-size: 0.65rem;">AVERAGE TICKET SIZE</div>
                                        <div class="d-flex justify-content-between align-items-baseline">
                                            <span class="fs-4 fw-black text-primary">@InsightsAverageTicket.ToString("C")</span>
                                            <div class="text-end" title="@InsightsComparisonTooltip">
                                                <span class="badge @(InsightsAvgTicketDiffPercent >= 0 ? "bg-success-subtle text-success" : "bg-danger-subtle text-danger")" style="font-size: 0.72rem;">
                                                    @(InsightsAvgTicketDiffPercent >= 0 ? "+" : "")@InsightsAvgTicketDiffPercent.ToString("F1")%
                                                </span>
                                                <div class="text-muted fw-bold extra-small mt-0.5" style="font-size: 0.52rem;">@InsightsComparisonLabel</div>
                                            </div>
                                        </div>
                                        <div class="text-muted extra-small mt-1" style="font-size: 0.62rem;">Per customer transaction</div>
                                    </div>
                                </div>
                                <div class="col-12 col-sm-6 col-xl">
                                    <div class="card border rounded-4 shadow-sm p-3 bg-white h-100" @onclick='() => OpenInsightsDetail("POUR_COST")' style="cursor: pointer;" title="Estimated pour cost = (Wholesale inventory cost / Drink sales) * 100. Lower is better.">
                                        <div class="d-flex justify-content-between align-items-center mb-1">
                                            <div class="text-muted fw-bold extra-small text-uppercase" style="font-size: 0.65rem;">ESTIMATED POUR COST (COGS)</div>
                                            <span class="badge bg-light text-muted border" style="font-size: 0.52rem;" title="Cost of inventory as % of drink sales">INVENTORY / SALES</span>
                                        </div>
                                        <div class="d-flex justify-content-between align-items-baseline">
                                            @{
                                                string pcColor = InsightsPourCostPercent > 25 ? "text-danger" : (InsightsPourCostPercent > 20 ? "text-warning" : "text-success");
                                            }
                                            <span class="fs-4 fw-black @pcColor">@InsightsPourCostPercent.ToString("F1")%</span>
                                            <div class="text-end" title="@InsightsComparisonTooltip">
                                                <span class="badge @(InsightsPourCostDiffPercent <= 0 ? "bg-success-subtle text-success" : "bg-danger-subtle text-danger")" style="font-size: 0.72rem;">
                                                    @(InsightsPourCostDiffPercent >= 0 ? "+" : "")@InsightsPourCostDiffPercent.ToString("F1")% pts
                                                </span>
                                                <div class="text-muted fw-bold extra-small mt-0.5" style="font-size: 0.52rem;">@InsightsComparisonLabel</div>
                                            </div>
                                        </div>
                                        <div class="d-flex justify-content-between align-items-center text-muted extra-small mt-1" style="font-size: 0.62rem;">
                                            <span>Cost: @InsightsPourCostCost.ToString("C")</span>
                                            <span class="fw-bold text-success">@((100 - InsightsPourCostPercent).ToString("F1"))% Margin Made</span>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-12 col-sm-6 col-xl">
                                    <div class="card border rounded-4 shadow-sm p-3 bg-white h-100" @onclick='() => OpenInsightsDetail("NET_PROFIT")' style="cursor: pointer;">
                                        <div class="text-muted fw-bold extra-small text-uppercase mb-1" style="font-size: 0.65rem;">NET TOTAL MADE</div>
                                        <div class="d-flex justify-content-between align-items-baseline">
                                            <span class="fs-4 fw-black text-success">@InsightsNetProfit.ToString("C")</span>
                                            <div class="text-end" title="@InsightsComparisonTooltip">
                                                <span class="badge @(InsightsNetProfitDiffPercent >= 0 ? "bg-success-subtle text-success" : "bg-danger-subtle text-danger")" style="font-size: 0.72rem;">
                                                    @(InsightsNetProfitDiffPercent >= 0 ? "+" : "")@InsightsNetProfitDiffPercent.ToString("F1")%
                                                </span>
                                                <div class="text-muted fw-bold extra-small mt-0.5" style="font-size: 0.52rem;">@InsightsComparisonLabel</div>
                                            </div>
                                        </div>
                                        <div class="text-muted extra-small mt-1" style="font-size: 0.62rem;">
                                            Margin: @(InsightsTotalSales > 0 ? (InsightsNetProfit / InsightsTotalSales * 100).ToString("F1") : "0.0")% after inventory
                                        </div>
                                    </div>
                                </div>
                                <div class="col-12 col-sm-6 col-xl">
                                    <div class="card border rounded-4 shadow-sm p-3 bg-white h-100" @onclick='() => OpenInsightsDetail("INVENTORY")' style="cursor: pointer;">
                                        <div class="text-muted fw-bold extra-small text-uppercase mb-1" style="font-size: 0.65rem;">TOTAL ON-HAND INVENTORY VALUE</div>
                                        <div class="d-flex justify-content-between align-items-baseline">
                                            <span class="fs-4 fw-black text-primary">@InsightsStockValue.ToString("C")</span>
                                        </div>
                                        <div class="text-muted extra-small mt-1" style="font-size: 0.62rem;">Wholesale asset value</div>
                                    </div>
                                </div>
                            </div>

                            <!-- CHARTS ROW 1 -->
                             <div class="row g-4 mb-4">
                                 <div class="col-12 col-lg-4">
                                     <div class="card border rounded-4 shadow-sm p-4 bg-white">
                                         <div class="d-flex justify-content-between align-items-center mb-3">
                                             <h6 class="fw-black mb-0 text-dark" style="font-size: 0.85rem;"><i class="bi bi-bar-chart-fill me-2 text-primary"></i>STOCK VS. USAGE</h6>
                                             <div class="btn-group btn-group-sm rounded-pill p-0 bg-light border" style="font-size: 0.7rem;">
                                                 <button class="btn btn-sm rounded-pill py-0 px-2 @(_insightsChartFilter == "ALL" ? "btn-primary text-white" : "btn-light text-muted border-0")" style="font-size: 0.65rem;" @onclick='() => SetInsightsChartFilter("ALL")'>ALL</button>
                                                 <button class="btn btn-sm rounded-pill py-0 px-2 @(_insightsChartFilter == "LIQUOR" ? "btn-primary text-white" : "btn-light text-muted border-0")" style="font-size: 0.65rem;" @onclick='() => SetInsightsChartFilter("LIQUOR")'>LIQ</button>
                                                 <button class="btn btn-sm rounded-pill py-0 px-2 @(_insightsChartFilter == "BEER" ? "btn-primary text-white" : "btn-light text-muted border-0")" style="font-size: 0.65rem;" @onclick='() => SetInsightsChartFilter("BEER")'>BEER</button>
                                                 <button class="btn btn-sm rounded-pill py-0 px-2 @(_insightsChartFilter == "SELTZER" ? "btn-primary text-white" : "btn-light text-muted border-0")" style="font-size: 0.65rem;" @onclick='() => SetInsightsChartFilter("SELTZER")'>SELTZ</button>
                                             </div>
                                         </div>
                                         <div class="chart-container" style="position: relative; width: 100%; height: 320px;">
                                             <canvas id="stockVsUsageChart"></canvas>
                                         </div>
                                     </div>
                                 </div>
                                 <div class="col-12 col-lg-4">
                                     <div class="card border rounded-4 shadow-sm p-4 bg-white">
                                         <h6 class="fw-black mb-3 text-dark"><i class="bi bi-pie-chart-fill me-2 text-primary"></i>REVENUE BY CATEGORY</h6>
                                         <div class="chart-container" style="position: relative; width: 100%; height: 320px;">
                                             <canvas id="categoryShareChart"></canvas>
                                         </div>
                                     </div>
                                 </div>
                                 <div class="col-12 col-lg-4">
                                     <div class="card border rounded-4 shadow-sm p-4 bg-white">
                                         <h6 class="fw-black mb-3 text-dark"><i class="bi bi-pie-chart-fill me-2 text-primary"></i>REVENUE BY PRODUCT (TOP 10)</h6>
                                         <div class="chart-container" style="position: relative; width: 100%; height: 320px;">
                                             <canvas id="productShareChart"></canvas>
                                         </div>
                                     </div>
                                 </div>
                             </div>

                            <!-- CHARTS ROW 2 (HISTORICAL TRENDS) -->
                            <div class="row g-4">
                                <div class="col-12">
                                    <div class="card border rounded-4 shadow-sm p-4 bg-white">
                                        <h6 class="fw-black mb-3 text-dark"><i class="bi bi-graph-up me-2 text-primary"></i>SALES REVENUE VS. COST OF GOODS USED (LAST 12 MONTHS)</h6>
                                        <div class="chart-container" style="position: relative; width: 100%; height: 280px;">
                                            <canvas id="insightsTrendChart"></canvas>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                    else if (_inventorySubTab == "ranking")
                    {
                        <!-- PRODUCT PERFORMANCE RANKING TAB -->
                        <div class="flex-grow-1 d-flex flex-column bg-light p-4 overflow-auto">
                            <!-- STAT CARDS BANNER -->
                            <div class="row g-3 mb-4 flex-shrink-0">
                                <div class="col-12 col-md-3">
                                    <div class="card border rounded-4 shadow-sm p-3 bg-white h-100">
                                        <div class="text-muted fw-bold extra-small text-uppercase mb-1" style="font-size: 0.65rem;">TOTAL VOLUME SOLD</div>
                                        <div class="fs-4 fw-black text-dark">@_auditProductMetrics.Where(x => IsItemInSelectedCategory(x)).Sum(x => x.Quantity).ToString("N0") <span class="fs-6 text-muted font-normal">units</span></div>
                                        <div class="text-muted extra-small mt-1" style="font-size: 0.62rem;">Across filtered items</div>
                                    </div>
                                </div>
                                <div class="col-12 col-md-3">
                                    <div class="card border rounded-4 shadow-sm p-3 bg-white h-100">
                                        <div class="text-muted fw-bold extra-small text-uppercase mb-1" style="font-size: 0.65rem;">GROSS SALES REVENUE</div>
                                        <div class="fs-4 fw-black text-success">@_auditProductMetrics.Where(x => IsItemInSelectedCategory(x)).Sum(x => x.Revenue).ToString("C0")</div>
                                        <div class="text-muted extra-small mt-1" style="font-size: 0.62rem;">Filtered products sales total</div>
                                    </div>
                                </div>
                                <div class="col-12 col-md-3">
                                    <div class="card border rounded-4 shadow-sm p-3 bg-white h-100">
                                        <div class="text-muted fw-bold extra-small text-uppercase mb-1" style="font-size: 0.65rem;">TOP VOLUME LEADER</div>
                                        @{
                                            var topVol = _auditProductMetrics.Where(x => IsItemInSelectedCategory(x)).OrderByDescending(x => x.Quantity).ThenByDescending(x => x.Revenue).ThenBy(x => x.Name).FirstOrDefault();
                                        }
                                        <div class="fs-5 fw-black text-primary text-truncate">@(topVol != null && topVol.Quantity > 0 ? topVol.Name.ToUpper() : "N/A")</div>
                                        <div class="text-muted extra-small mt-1" style="font-size: 0.62rem;">@(topVol != null && topVol.Quantity > 0 ? $"{topVol.Quantity:N0} units sold" : "No sales data")</div>
                                    </div>
                                </div>
                                <div class="col-12 col-md-3">
                                    <div class="card border rounded-4 shadow-sm p-3 bg-white h-100">
                                        <div class="text-muted fw-bold extra-small text-uppercase mb-1" style="font-size: 0.65rem;">TOP REVENUE GENERATOR</div>
                                        @{
                                            var topRev = _auditProductMetrics.Where(x => IsItemInSelectedCategory(x)).OrderByDescending(x => x.Revenue).ThenByDescending(x => x.Quantity).ThenBy(x => x.Name).FirstOrDefault();
                                        }
                                        <div class="fs-5 fw-black text-purple text-truncate" style="color: #6f42c1;">@(topRev != null && topRev.Revenue > 0 ? topRev.Name.ToUpper() : "N/A")</div>
                                        <div class="text-muted extra-small mt-1" style="font-size: 0.62rem;">@(topRev != null && topRev.Revenue > 0 ? $"{topRev.Revenue:C0} generated" : "No sales data")</div>
                                    </div>
                                </div>
                            </div>

                            <!-- CATEGORY FILTER PILLS, VIEW MODE SWITCHER & SEARCH BAR -->
                            <div class="card border rounded-4 shadow-sm p-3 mb-4 bg-white flex-shrink-0">
                                <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                                    <div class="d-flex align-items-center gap-1 overflow-x-auto" style="white-space: nowrap;">
                                        <span class="extra-small fw-black text-muted me-2 text-uppercase">Filter:</span>
                                        <button class="btn btn-sm rounded-pill fw-black px-3 py-1 extra-small @(_auditCategoryFilter == "ALL_BEVERAGES" ? "btn-primary shadow-sm" : "btn-white border text-secondary")" @onclick='() => OnRankingCategoryFilterChanged("ALL_BEVERAGES")'>ALL DRINKS</button>
                                        <button class="btn btn-sm rounded-pill fw-black px-3 py-1 extra-small @(_auditCategoryFilter == "BEER" ? "btn-primary shadow-sm" : "btn-white border text-secondary")" @onclick='() => OnRankingCategoryFilterChanged("BEER")'>BEER</button>
                                        <button class="btn btn-sm rounded-pill fw-black px-3 py-1 extra-small @(_auditCategoryFilter == "LIQUOR" ? "btn-primary shadow-sm" : "btn-white border text-secondary")" @onclick='() => OnRankingCategoryFilterChanged("LIQUOR")'>LIQUOR</button>
                                        <button class="btn btn-sm rounded-pill fw-black px-3 py-1 extra-small @(_auditCategoryFilter == "SELTZER" ? "btn-primary shadow-sm" : "btn-white border text-secondary")" @onclick='() => OnRankingCategoryFilterChanged("SELTZER")'>SELTZER</button>
                                        <button class="btn btn-sm rounded-pill fw-black px-3 py-1 extra-small @(_auditCategoryFilter == "WINE" ? "btn-primary shadow-sm" : "btn-white border text-secondary")" @onclick='() => OnRankingCategoryFilterChanged("WINE")'>WINE</button>
                                        <button class="btn btn-sm rounded-pill fw-black px-3 py-1 extra-small @(_auditCategoryFilter == "FOOD" ? "btn-primary shadow-sm" : "btn-white border text-secondary")" @onclick='() => OnRankingCategoryFilterChanged("FOOD")'>FOOD</button>
                                        <button class="btn btn-sm rounded-pill fw-black px-3 py-1 extra-small @(_auditCategoryFilter == "ALL" ? "btn-dark shadow-sm" : "btn-white border text-secondary")" @onclick='() => OnRankingCategoryFilterChanged("ALL")'>ALL ITEMS</button>
                                    </div>

                                    <div class="d-flex align-items-center gap-2 ms-auto">
                                        <!-- VIEW MODE TOGGLE (TABLE VS CHART) -->
                                        <div class="btn-group btn-group-sm p-1 bg-light rounded-pill border" role="group">
                                            <button type="button" class="btn btn-sm rounded-pill fw-black px-3 py-1 extra-small @(_rankingViewMode == "TABLE" ? "btn-white text-primary shadow-xs border" : "text-muted border-0")" @onclick='() => SetRankingViewMode("TABLE")'>
                                                <i class="bi bi-table me-1"></i> TABLE
                                            </button>
                                            <button type="button" class="btn btn-sm rounded-pill fw-black px-3 py-1 extra-small @(_rankingViewMode == "CHART" ? "btn-primary shadow-xs" : "text-muted border-0")" @onclick='() => SetRankingViewMode("CHART")'>
                                                <i class="bi bi-bar-chart-line-fill me-1"></i> CHART
                                            </button>
                                        </div>

                                        <div class="position-relative" style="width: 200px;">
                                            <i class="bi bi-search position-absolute top-50 start-0 translate-middle-y ms-3 text-muted" style="font-size: 0.8rem;"></i>
                                            <input type="text" class="form-select form-select-sm rounded-pill ps-4 pe-3 border shadow-xs" placeholder="Search product..." style="font-size: 0.78rem;" @bind="_rankingSearchTerm" @bind:event="oninput" @bind:after="OnRankingSearchInputChanged" />
                                        </div>
                                    </div>
                                </div>
                            </div>

                            @if (_rankingViewMode == "CHART")
                            {
                                <!-- PERFORMANCE RANKING CHART VIEW CONTROLS & CANVASES -->
                                <div class="flex-grow-1 d-flex flex-column gap-3 overflow-hidden">
                                    <!-- CHART METRIC SELECTOR TOOLBAR -->
                                    <div class="card border rounded-4 shadow-sm p-3 bg-white flex-shrink-0">
                                        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                                            <div class="d-flex align-items-center gap-2">
                                                <span class="extra-small fw-black text-muted text-uppercase">Chart Metric:</span>
                                                <button class="btn btn-sm rounded-pill fw-black px-3 py-1 extra-small @(_rankingChartMetric == "REVENUE" ? "btn-success shadow-sm text-white" : "btn-light border text-secondary")" @onclick='() => SetRankingChartMetric("REVENUE")'>
                                                    <i class="bi bi-currency-dollar me-1"></i> GROSS REVENUE ($)
                                                </button>
                                                <button class="btn btn-sm rounded-pill fw-black px-3 py-1 extra-small @(_rankingChartMetric == "VOLUME" ? "btn-primary shadow-sm" : "btn-light border text-secondary")" @onclick='() => SetRankingChartMetric("VOLUME")'>
                                                    <i class="bi bi-box-seam me-1"></i> VOLUME SOLD (UNITS)
                                                </button>
                                                <button class="btn btn-sm rounded-pill fw-black px-3 py-1 extra-small @(_rankingChartMetric == "SHARE" ? "btn-purple shadow-sm text-white" : "btn-light border text-secondary")" style="@(_rankingChartMetric == "SHARE" ? "background-color: #6f42c1; border-color: #6f42c1;" : "")" @onclick='() => SetRankingChartMetric("SHARE")'>
                                                    <i class="bi bi-pie-chart-fill me-1"></i> MARKET SHARE (%)
                                                </button>
                                            </div>

                                            <div class="d-flex align-items-center gap-2">
                                                <span class="extra-small fw-black text-muted text-uppercase">Display Limit:</span>
                                                <button class="btn btn-sm rounded-pill fw-bold px-2 py-0 extra-small @(_rankingChartTopLimit == 10 ? "btn-dark" : "btn-outline-secondary")" @onclick='() => SetRankingChartTopLimit(10)'>Top 10</button>
                                                <button class="btn btn-sm rounded-pill fw-bold px-2 py-0 extra-small @(_rankingChartTopLimit == 15 ? "btn-dark" : "btn-outline-secondary")" @onclick='() => SetRankingChartTopLimit(15)'>Top 15</button>
                                                <button class="btn btn-sm rounded-pill fw-bold px-2 py-0 extra-small @(_rankingChartTopLimit == 25 ? "btn-dark" : "btn-outline-secondary")" @onclick='() => SetRankingChartTopLimit(25)'>Top 25</button>
                                                <button class="btn btn-sm rounded-pill fw-bold px-2 py-0 extra-small @(_rankingChartTopLimit == 0 ? "btn-dark" : "btn-outline-secondary")" @onclick='() => SetRankingChartTopLimit(0)'>All</button>
                                                
                                                <button class="btn btn-sm rounded-pill fw-bold px-2 py-1 extra-small ms-2 btn-outline-primary" @onclick="ToggleRankingChartOrientation" title="Toggle Vertical / Horizontal Bar Layout">
                                                    <i class="bi @(_rankingChartHorizontal ? "bi-bar-chart" : "bi-bar-chart-steps") me-1"></i> @(_rankingChartHorizontal ? "Vertical" : "Horizontal")
                                                </button>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- CHART CANVAS CONTAINER -->
                                    <div class="row g-3 flex-grow-1 min-h-0 overflow-auto">
                                        <div class="col-12 col-lg-8 d-flex">
                                            <div class="card border rounded-4 shadow-sm bg-white p-4 w-100 d-flex flex-column h-100" style="min-height: 420px;">
                                                <div class="d-flex justify-content-between align-items-center mb-3">
                                                    <h6 class="fw-black mb-0 text-dark">
                                                        <i class="bi bi-graph-up-arrow text-primary me-2"></i>
                                                        PRODUCT PERFORMANCE COMPARISON (@_rankingChartMetric)
                                                    </h6>
                                                    <span class="badge bg-light text-muted border fw-bold" style="font-size: 0.7rem;">
                                                        @_auditCategoryFilter.Replace("_", " ")
                                                    </span>
                                                </div>
                                                <div class="chart-container flex-grow-1 position-relative" style="width: 100%; min-height: 350px;">
                                                    <canvas id="rankingPerformanceChart"></canvas>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-12 col-lg-4 d-flex">
                                            <div class="card border rounded-4 shadow-sm bg-white p-4 w-100 d-flex flex-column h-100" style="min-height: 420px;">
                                                <h6 class="fw-black mb-3 text-dark">
                                                    <i class="bi bi-pie-chart text-purple me-2" style="color: #6f42c1;"></i>
                                                    TOP REVENUE SHARE BREAKDOWN
                                                </h6>
                                                <div class="chart-container flex-grow-1 position-relative" style="width: 100%; min-height: 330px;">
                                                    <canvas id="rankingShareDonutChart"></canvas>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <!-- ORIGINAL PERFORMANCE RANKING TABLE -->
                                <div class="card border rounded-4 shadow-sm bg-white overflow-hidden flex-grow-1">
                                    <div class="table-responsive h-100" style="max-height: 550px;">
                                        <table class="table table-hover align-middle mb-0" style="font-size: 0.82rem;">
                                            <thead class="bg-light sticky-top" style="z-index: 2;">
                                                <tr class="text-muted extra-small text-uppercase">
                                                    <th class="ps-4">PRODUCT / BRAND</th>
                                                    <th class="text-center">VOLUME SOLD</th>
                                                    <th class="text-end">REVENUE</th>
                                                    <th class="text-end pe-4">MARKET SHARE</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @{
                                                    var totalAuditRev = _auditProductMetrics.Where(x => x.Quantity > 0 && IsItemInSelectedCategory(x)).Sum(m => m.Revenue);
                                                    var filteredRankingMetrics = GetFilteredAuditRankingMetrics();
                                                }
                                                @if (!filteredRankingMetrics.Any())
                                                {
                                                    <tr>
                                                        <td colspan="4" class="text-center py-5 text-muted fw-bold">
                                                            <i class="bi bi-inbox fs-2 d-block mb-2 text-muted"></i>
                                                            No product performance data found matching filters.
                                                        </td>
                                                    </tr>
                                                }
                                                else
                                                {
                                                    @foreach (var item in filteredRankingMetrics)
                                                    {
                                                        var share = totalAuditRev > 0 ? (double)(item.Revenue / totalAuditRev * 100m) : 0;
                                                        <tr>
                                                            <td class="ps-4">
                                                                <div class="fw-black text-primary cursor-pointer" style="cursor: pointer;" @onclick="() => OpenProductTrendModal(item.Name)" title="Click to view sales trend & 7-day forecast">
                                                                    @item.Name.ToUpper() <i class="bi bi-graph-up-arrow ms-1 text-muted extra-small"></i>
                                                                </div>
                                                                <div class="extra-small text-muted text-uppercase tracking-tighter">Usage Leader</div>
                                                            </td>
                                                            <td class="text-center">
                                                                <div class="d-flex flex-column align-items-center gap-1 py-1">
                                                                    <div class="d-flex align-items-baseline gap-1">
                                                                        <span class="fw-black fs-4 text-dark lh-1">@item.Quantity</span>
                                                                        <span class="extra-small fw-black text-primary text-uppercase tracking-wider">
                                                                            @(item.IsLiquor ? "SHOTS" : "UNITS")
                                                                        </span>
                                                                    </div>
                                                                    @if (item.PackSize > 1)
                                                                    {
                                                                        var cases = item.Quantity / item.PackSize;
                                                                        var bottles = item.Quantity % item.PackSize;
                                                                        var casesLabel = cases == 1 ? "Case" : "Cases";
                                                                        var bottlesLabel = bottles == 1 ? "Bottle" : "Bottles";
                                                                        string caseText = cases > 0 && bottles > 0 
                                                                            ? $"{cases} {casesLabel}, {bottles} {bottlesLabel}" 
                                                                            : (cases > 0 ? $"{cases} {casesLabel}" : $"{bottles} {bottlesLabel}");

                                                                        <div class="badge rounded-pill bg-success-subtle text-success border border-success-subtle fw-black px-2 py-1 d-inline-flex align-items-center gap-1" style="font-size: 0.75rem; background: #e6f4ea !important;">
                                                                            <i class="bi bi-box-seam-fill"></i>
                                                                            <span>@caseText</span>
                                                                        </div>
                                                                    }
                                                                    else if (item.IsLiquor)
                                                                    {
                                                                        var btlUsed = Math.Round(item.LiquorBottlesUsed, 1);
                                                                        <div class="badge rounded-pill fw-black px-2 py-1 d-inline-flex align-items-center gap-1" style="font-size: 0.75rem; background: #f3e8ff; color: #7e22ce; border: 1px solid #e9d5ff !important;">
                                                                            <i class="bi bi-cup-straw"></i>
                                                                            <span>@btlUsed Bottles Used (@item.PourSizeOz.ToString("0.#")oz shot)</span>
                                                                        </div>
                                                                    }
                                                                    else
                                                                    {
                                                                        <div class="badge rounded-pill bg-light text-secondary border fw-bold px-2 py-1" style="font-size: 0.7rem;">
                                                                            SINGLE ITEM
                                                                        </div>
                                                                    }
                                                                </div>
                                                            </td>
                                                            <td class="text-end fw-black text-dark fs-5">@item.Revenue.ToString("C0")</td>
                                                            <td class="text-end pe-4">
                                                                <div class="d-flex align-items-center justify-content-end gap-3">
                                                                    <div class="progress rounded-pill flex-grow-1" style="height: 12px; width: 80px; background: #f1f5f9;">
                                                                        <div class="progress-bar bg-primary" style="width: @(share)%"></div>
                                                                    </div>
                                                                    <span class="fw-black text-primary" style="min-width: 45px;">@share.ToString("0.0")%</span>
                                                                </div>
                                                            </td>
                                                        </tr>
                                                    }
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else if (_inventorySubTab == "reorder")
                    {
                        <!-- SMART WEEKLY REORDER PREDICTOR TAB -->
                        <div class="flex-grow-1 d-flex flex-column bg-light p-4 overflow-auto">
                            <!-- STAT CARDS BANNER -->
                            <div class="row g-3 mb-4 flex-shrink-0">
                                @{
                                    var reorderMetrics = GetFilteredAuditReorderMetrics();
                                    var urgentCount = reorderMetrics.Count(x => x.GetNetUnitsNeeded(_reorderPredictionMode) > 0);
                                    var outOfStockCount = reorderMetrics.Count(x => x.CurrentStock == 0 && x.GetProjected7DayDemand(_reorderPredictionMode) > 0);
                                    var totalEstReorderCost = reorderMetrics.Sum(x => x.GetNetUnitsNeeded(_reorderPredictionMode) * (x.WholesaleCost > 0 ? x.WholesaleCost : 12.50m));
                                }
                                <div class="col-12 col-md-4">
                                    <div class="card border rounded-4 shadow-sm p-3 bg-white h-100 border-start border-4 border-warning">
                                        <div class="text-muted fw-bold extra-small text-uppercase mb-1" style="font-size: 0.65rem;">URGENT REORDERS NEEDED</div>
                                        <div class="d-flex justify-content-between align-items-baseline">
                                            <span class="fs-3 fw-black text-warning">@urgentCount</span>
                                            <span class="badge bg-warning-subtle text-warning fw-bold" style="font-size: 0.72rem;">Items below 7D forecast</span>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-12 col-md-4">
                                    <div class="card border rounded-4 shadow-sm p-3 bg-white h-100 border-start border-4 border-danger">
                                        <div class="text-muted fw-bold extra-small text-uppercase mb-1" style="font-size: 0.65rem;">CRITICAL OUT OF STOCK RISK</div>
                                        <div class="d-flex justify-content-between align-items-baseline">
                                            <span class="fs-3 fw-black text-danger">@outOfStockCount</span>
                                            <span class="badge bg-danger-subtle text-danger fw-bold" style="font-size: 0.72rem;">Zero stock active demand</span>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-12 col-md-4">
                                    <div class="card border rounded-4 shadow-sm p-3 bg-white h-100 border-start border-4 border-success">
                                        <div class="text-muted fw-bold extra-small text-uppercase mb-1" style="font-size: 0.65rem;">ESTIMATED REORDER WHOLESALE COST</div>
                                        <div class="d-flex justify-content-between align-items-baseline">
                                            <span class="fs-3 fw-black text-success">@totalEstReorderCost.ToString("C0")</span>
                                            <span class="badge bg-success-subtle text-success fw-bold" style="font-size: 0.72rem;">Purchase order total</span>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- ALGORITHM SELECTION HEADER -->
                            <div class="card border rounded-4 shadow-sm p-3 mb-3 bg-white flex-shrink-0">
                                <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="extra-small fw-black text-muted text-uppercase me-1"><i class="bi bi-cpu-fill text-primary me-1"></i>Algorithm:</span>
                                        <button class="btn btn-sm rounded-pill fw-black px-3 py-0 extra-small @(_reorderPredictionMode == "Hybrid" ? "btn-primary shadow-sm" : "btn-light border text-muted")" @onclick='() => SetPredictionMode("Hybrid")' title="Blends 60% Trailing 30D + 40% Same Month Last Year">
                                            🧠 SMART HYBRID
                                        </button>
                                        <button class="btn btn-sm rounded-pill fw-black px-3 py-0 extra-small @(_reorderPredictionMode == "Recent" ? "btn-primary shadow-sm" : "btn-light border text-muted")" @onclick='() => SetPredictionMode("Recent")' title="100% Trailing 30-Day Sales Velocity">
                                            ⚡ RECENT TREND (30D)
                                        </button>
                                        <button class="btn btn-sm rounded-pill fw-black px-3 py-0 extra-small @(_reorderPredictionMode == "YoY" ? "btn-primary shadow-sm" : "btn-light border text-muted")" @onclick='() => SetPredictionMode("YoY")' title="100% Same Month Last Year Sales Velocity">
                                            🗓️ SEASONAL YoY
                                        </button>
                                    </div>
                                    <span class="extra-small text-muted fw-bold">
                                        @(_reorderPredictionMode == "Hybrid" ? "60% 30D Momentum + 40% YoY Seasonality" : (_reorderPredictionMode == "Recent" ? "Trailing 30-Day Sales Velocity" : "Same Month Last Year Velocity"))
                                    </span>
                                </div>
                            </div>

                            <!-- CATEGORY FILTER PILLS & TOOLBAR -->
                            <div class="card border rounded-4 shadow-sm p-3 mb-4 bg-white flex-shrink-0">
                                <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                                    <div class="d-flex align-items-center gap-1 overflow-x-auto" style="white-space: nowrap;">
                                        <span class="extra-small fw-black text-muted me-2 text-uppercase">Filter:</span>
                                        <button class="btn btn-sm rounded-pill fw-black px-3 py-1 extra-small @(_auditCategoryFilter == "ALL_BEVERAGES" ? "btn-primary shadow-sm" : "btn-white border text-secondary")" @onclick='() => _auditCategoryFilter = "ALL_BEVERAGES"'>ALL DRINKS</button>
                                        <button class="btn btn-sm rounded-pill fw-black px-3 py-1 extra-small @(_auditCategoryFilter == "BEER" ? "btn-primary shadow-sm" : "btn-white border text-secondary")" @onclick='() => _auditCategoryFilter = "BEER"'>BEER</button>
                                        <button class="btn btn-sm rounded-pill fw-black px-3 py-1 extra-small @(_auditCategoryFilter == "LIQUOR" ? "btn-primary shadow-sm" : "btn-white border text-secondary")" @onclick='() => _auditCategoryFilter = "LIQUOR"'>LIQUOR</button>
                                        <button class="btn btn-sm rounded-pill fw-black px-3 py-1 extra-small @(_auditCategoryFilter == "SELTZER" ? "btn-primary shadow-sm" : "btn-white border text-secondary")" @onclick='() => _auditCategoryFilter = "SELTZER"'>SELTZER</button>
                                        <button class="btn btn-sm rounded-pill fw-black px-3 py-1 extra-small @(_auditCategoryFilter == "WINE" ? "btn-primary shadow-sm" : "btn-white border text-secondary")" @onclick='() => _auditCategoryFilter = "WINE"'>WINE</button>
                                        <button class="btn btn-sm rounded-pill fw-black px-3 py-1 extra-small @(_auditCategoryFilter == "FOOD" ? "btn-primary shadow-sm" : "btn-white border text-secondary")" @onclick='() => _auditCategoryFilter = "FOOD"'>FOOD</button>
                                        <button class="btn btn-sm rounded-pill fw-black px-3 py-1 extra-small @(_auditCategoryFilter == "ALL" ? "btn-dark shadow-sm" : "btn-white border text-secondary")" @onclick='() => _auditCategoryFilter = "ALL"'>ALL ITEMS</button>
                                    </div>

                                    <div class="d-flex align-items-center gap-2 ms-auto">
                                        <div class="form-check form-switch cursor-pointer mb-0 me-2">
                                            <input class="form-check-input cursor-pointer" type="checkbox" id="urgentOnlySwitch" @bind="_reorderUrgentOnly" />
                                            <label class="form-check-label fw-bold text-dark extra-small cursor-pointer" for="urgentOnlySwitch" style="font-size: 0.75rem; user-select: none;">
                                                REORDERS ONLY (@urgentCount)
                                            </label>
                                        </div>
                                        <div class="position-relative" style="width: 180px;">
                                            <i class="bi bi-search position-absolute top-50 start-0 translate-middle-y ms-3 text-muted" style="font-size: 0.8rem;"></i>
                                            <input type="text" class="form-select form-select-sm rounded-pill ps-4 pe-3 border shadow-xs" placeholder="Search item..." style="font-size: 0.78rem;" @bind="_reorderSearchTerm" @bind:event="oninput" />
                                        </div>
                                        <button class="btn btn-sm btn-dark rounded-pill px-3 fw-bold shadow-xs" style="font-size: 0.78rem;" @onclick="ExportReorderPurchaseSheet">
                                            <i class="bi bi-file-earmark-spreadsheet me-1"></i> EXPORT PO SHEET
                                        </button>
                                    </div>
                                </div>
                            </div>

                            <!-- ORIGINAL REORDER PREDICTOR TABLE LAYOUT -->
                            <div class="card border rounded-4 shadow-sm bg-white overflow-hidden flex-grow-1">
                                <div class="table-responsive h-100" style="max-height: 550px;">
                                    <table class="table table-hover align-middle mb-0">
                                        <thead class="bg-light sticky-top" style="z-index: 2;">
                                            <tr>
                                                <th class="ps-4">PRODUCT / BRAND</th>
                                                <th class="text-center">CURRENT STOCK</th>
                                                <th class="text-center">7-DAY FORECAST (EST. DEMAND)</th>
                                                <th class="text-end pe-4">RECOMMENDED ORDER (7-DAY SUPPLY)</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @if (!reorderMetrics.Any())
                                            {
                                                <tr>
                                                    <td colspan="4" class="text-center py-5 text-muted fw-bold">
                                                        <i class="bi bi-check-circle fs-2 text-success d-block mb-2"></i>
                                                        No reorder recommendations matching active filters.
                                                    </td>
                                                </tr>
                                            }
                                            else
                                            {
                                                @foreach (var item in reorderMetrics)
                                                {
                                                    var projDemand = item.GetProjected7DayDemand(_reorderPredictionMode);
                                                    var netNeeded = item.GetNetUnitsNeeded(_reorderPredictionMode);
                                                    var recCases = item.GetRecommendedCases(_reorderPredictionMode);

                                                    <tr>
                                                        <td class="ps-4">
                                                            <div class="fw-black text-primary cursor-pointer" style="cursor: pointer;" @onclick="() => OpenProductTrendModal(item.Name)" title="Click to view sales trend & 7-day forecast">
                                                                @item.Name.ToUpper() <i class="bi bi-graph-up-arrow ms-1 text-muted extra-small"></i>
                                                            </div>
                                                            @if (netNeeded > 0)
                                                            {
                                                                <span class="badge bg-danger-subtle text-danger fw-black extra-small" style="font-size: 0.68rem; background: #ffebe9 !important; padding: 3px 8px; border-radius: 4px;">REORDER NEEDED</span>
                                                            }
                                                            else
                                                            {
                                                                <span class="badge bg-success-subtle text-success fw-black extra-small" style="font-size: 0.68rem; background: #e6f4ea !important; padding: 3px 8px; border-radius: 4px;">ADEQUATE STOCK</span>
                                                            }
                                                        </td>
                                                        <td class="text-center">
                                                            <div class="d-flex flex-column align-items-center gap-1 py-1">
                                                                <div class="d-flex align-items-baseline gap-1">
                                                                    <span class="fw-black fs-5 text-dark lh-1">@item.CurrentStock</span>
                                                                    <span class="extra-small fw-black text-primary text-uppercase tracking-wider">
                                                                        @(item.IsLiquor ? "SHOTS" : "UNITS")
                                                                    </span>
                                                                </div>
                                                                @if (item.PackSize > 1)
                                                                {
                                                                    var stkCases = item.CurrentStock / item.PackSize;
                                                                    var stkBottles = item.CurrentStock % item.PackSize;
                                                                    var cLabel = stkCases == 1 ? "Case" : "Cases";
                                                                    var bLabel = stkBottles == 1 ? "Bottle" : "Bottles";
                                                                    string stkText = stkCases > 0 && stkBottles > 0 
                                                                        ? $"{stkCases} {cLabel}, {stkBottles} {bLabel}" 
                                                                        : (stkCases > 0 ? $"{stkCases} {cLabel}" : $"{stkBottles} {bLabel}");

                                                                    <div class="badge rounded-pill bg-success-subtle text-success border border-success-subtle fw-black px-2 py-1 d-inline-flex align-items-center gap-1" style="font-size: 0.7rem; background: #e6f4ea !important;">
                                                                        <i class="bi bi-box-seam-fill"></i>
                                                                        <span>@stkText</span>
                                                                    </div>
                                                                }
                                                                else if (item.IsLiquor)
                                                                {
                                                                    var stkBtls = Math.Round((double)item.CurrentStock * (double)item.PourSizeOz / (double)item.BottleVolumeOz, 1);
                                                                    <div class="badge rounded-pill fw-black px-2 py-1 d-inline-flex align-items-center gap-1" style="font-size: 0.7rem; background: #f3e8ff; color: #7e22ce; border: 1px solid #e9d5ff !important;">
                                                                        <i class="bi bi-cup-straw"></i>
                                                                        <span>@stkBtls Bottles</span>
                                                                    </div>
                                                                }
                                                                else
                                                                {
                                                                    <div class="extra-small text-muted fw-bold text-uppercase">Stock On Hand</div>
                                                                }
                                                            </div>
                                                        </td>
                                                        <td class="text-center">
                                                            <div class="fw-black fs-5 text-primary">@projDemand</div>
                                                            <div class="extra-small text-muted fw-bold text-uppercase mb-1">@(item.IsLiquor ? "Projected Shots" : "Projected Units")</div>
                                                            @if (_reorderPredictionMode == "Hybrid")
                                                            {
                                                                <span class="badge rounded-pill bg-light text-dark border extra-small px-2 py-1" style="font-size: 0.65rem;" title="Trailing 30D Demand vs Same Month Last Year">
                                                                    🧠 30D: @item.GetProjected7DayDemand("Recent") | YoY: @item.GetProjected7DayDemand("YoY")
                                                                </span>
                                                            }
                                                            else if (_reorderPredictionMode == "Recent")
                                                            {
                                                                <span class="badge rounded-pill bg-info-subtle text-info-emphasis border border-info-subtle extra-small px-2 py-1" style="font-size: 0.65rem; background: #e0f2fe !important; color: #0369a1 !important;">
                                                                    ⚡ 30D Momentum (@item.GetProjected7DayDemand("Recent"))
                                                                </span>
                                                            }
                                                            else if (_reorderPredictionMode == "YoY")
                                                            {
                                                                <span class="badge rounded-pill extra-small px-2 py-1" style="font-size: 0.65rem; background: #f3e8ff !important; color: #7e22ce !important; border: 1px solid #e9d5ff !important;">
                                                                    🗓️ YoY Seasonality (@item.GetProjected7DayDemand("YoY"))
                                                                </span>
                                                            }
                                                        </td>
                                                        <td class="text-end pe-4">
                                                            @if (netNeeded == 0)
                                                            {
                                                                <div class="badge rounded-pill bg-success-subtle text-success border border-success-subtle fw-black px-3 py-2" style="font-size: 0.75rem; background: #e6f4ea !important;">
                                                                    <i class="bi bi-check-circle-fill me-1"></i>NO ORDER NEEDED
                                                                </div>
                                                            }
                                                            else if (item.PackSize > 1)
                                                            {
                                                                <div class="badge rounded-pill bg-primary-subtle text-primary border border-primary-subtle fw-black px-3 py-2" style="font-size: 0.75rem; background: #e8f0fe !important;">
                                                                    <i class="bi bi-box-seam-fill me-1"></i>ORDER @recCases CASES (@(recCases * item.PackSize) units)
                                                                </div>
                                                            }
                                                            else if (item.IsLiquor)
                                                            {
                                                                var btlToOrder = Math.Max(1, (int)Math.Ceiling((double)netNeeded * (double)item.PourSizeOz / (double)item.BottleVolumeOz));
                                                                <div class="badge rounded-pill fw-black px-3 py-2" style="font-size: 0.75rem; background: #f3e8ff; color: #7e22ce; border: 1px solid #e9d5ff !important;">
                                                                    <i class="bi bi-cup-straw me-1"></i>ORDER @btlToOrder @(btlToOrder == 1 ? "BOTTLE" : "BOTTLES")
                                                                </div>
                                                            }
                                                            else
                                                            {
                                                                <div class="badge rounded-pill bg-danger-subtle text-danger border border-danger-subtle fw-black px-3 py-2" style="font-size: 0.75rem; background: #ffebe9 !important;">
                                                                    <i class="bi bi-cart-plus-fill me-1"></i>ORDER @netNeeded UNITS
                                                                </div>
                                                            }
                                                        </td>
                                                    </tr>
                                                }
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    }
                    else if (_inventorySubTab == "product_trends")
                    {
                        if (!_auditProductMetrics.Any())
                        {
                            BuildProductAuditMetrics();
                        }

                        var activeMetrics = _auditProductMetrics.Where(x => IsItemInSelectedCategory(x)).OrderByDescending(x => x.Quantity).ThenBy(x => x.Name).ToList();
                        if (!activeMetrics.Any())
                        {
                            activeMetrics = _auditProductMetrics.OrderByDescending(x => x.Quantity).ThenBy(x => x.Name).ToList();
                        }

                        if (string.IsNullOrEmpty(_selectedAuditTrendProductName) && activeMetrics.Any())
                        {
                            _selectedAuditTrendProductName = activeMetrics.First().Name;
                        }

                        var cleanTarget = CleanProductName(_selectedAuditTrendProductName ?? "");
                        var trendItem = _auditProductMetrics.FirstOrDefault(x => CleanProductName(x.Name).Equals(cleanTarget, StringComparison.OrdinalIgnoreCase))
                                        ?? _auditProductMetrics.FirstOrDefault(x => x.Name.Contains(cleanTarget, StringComparison.OrdinalIgnoreCase))
                                        ?? new ProductAuditMetric { Name = _selectedAuditTrendProductName ?? "N/A", Category = "POS ITEM" };

                        var trendPoints = GetProductTrendPoints(_selectedAuditTrendProductName ?? "");
                        var svgData = CalculateTrendSvgData(trendPoints);

                        bool isMonthly = ActivePreset == "thisyear" || (EndDate - StartDate).TotalDays > 60;
                        int totalUnitsSold = trendPoints.Sum(p => p.Quantity);
                        decimal totalRevenue = trendPoints.Sum(p => p.Revenue);
                        decimal avgUnits = trendPoints.Any() ? Math.Round((decimal)totalUnitsSold / trendPoints.Count, 1) : 0;
                        var peakDay = trendPoints.OrderByDescending(p => p.Quantity).FirstOrDefault();

                        <div class="px-5 py-4 flex-grow-1 overflow-y-auto h-100">
                            <!-- SUB-VIEW MODE TOGGLE BAR: TRENDS VS LAST SOLD VELOCITY -->
                            <div class="card border rounded-4 shadow-sm p-3 mb-4 bg-white flex-shrink-0">
                                <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                                    <div class="btn-group btn-group-sm p-1 bg-light rounded-pill border" role="group">
                                        <button type="button" class="btn btn-sm rounded-pill fw-black px-4 py-1.5 extra-small @(_productTrendsSubView == "TRENDS" ? "btn-primary shadow-xs text-white" : "btn-light text-muted border-0")" @onclick='() => SetProductTrendsSubView("TRENDS")'>
                                            <i class="bi bi-graph-up-arrow me-1"></i> 📈 SALES TREND & FORECAST
                                        </button>
                                        <button type="button" class="btn btn-sm rounded-pill fw-black px-4 py-1.5 extra-small @(_productTrendsSubView == "VELOCITY" ? "btn-primary shadow-xs text-white" : "btn-light text-muted border-0")" @onclick='() => SetProductTrendsSubView("VELOCITY")'>
                                            <i class="bi bi-clock-history me-1"></i> 🕒 LAST SOLD & MOVEMENT VELOCITY
                                        </button>
                                    </div>

                                    <div class="d-flex align-items-center gap-2">
                                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill fw-black px-3 py-2 extra-small" style="background: #e8f0fe !important;">
                                            <i class="bi bi-calendar-range me-1"></i>DATE RANGE: @StartDate.ToString("MM/dd/yyyy") — @EndDate.ToString("MM/dd/yyyy")
                                        </span>
                                    </div>
                                </div>
                            </div>

                            @if (_productTrendsSubView == "VELOCITY")
                            {
                                <!-- PRODUCT MOVEMENT & LAST SOLD VELOCITY EXPLORER -->
                                <!-- STAT CARDS BANNER -->
                                <div class="row g-3 mb-4 flex-shrink-0">
                                    <div class="col-12 col-md-3">
                                        <div class="card border rounded-4 shadow-sm p-3 bg-white h-100 border-start border-4 border-success">
                                            <div class="text-muted fw-bold extra-small text-uppercase mb-1" style="font-size: 0.65rem;">FAST MOVERS (≤7 DAYS)</div>
                                            <div class="d-flex justify-content-between align-items-baseline">
                                                <span class="fs-3 fw-black text-success">@GetVelocityCount("FAST_MOVER")</span>
                                                <span class="badge bg-success-subtle text-success fw-bold" style="font-size: 0.72rem;">High Turnover</span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-12 col-md-3">
                                        <div class="card border rounded-4 shadow-sm p-3 bg-white h-100 border-start border-4 border-warning">
                                            <div class="text-muted fw-bold extra-small text-uppercase mb-1" style="font-size: 0.65rem;">MODERATE (8-30 DAYS)</div>
                                            <div class="d-flex justify-content-between align-items-baseline">
                                                <span class="fs-3 fw-black text-warning">@GetVelocityCount("MODERATE")</span>
                                                <span class="badge bg-warning-subtle text-warning fw-bold" style="font-size: 0.72rem;">Regular Movement</span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-12 col-md-3">
                                        <div class="card border rounded-4 shadow-sm p-3 bg-white h-100 border-start border-4 border-orange" style="border-color: #fd7e14 !important;">
                                            <div class="text-muted fw-bold extra-small text-uppercase mb-1" style="font-size: 0.65rem;">SLOW MOVERS (31-60 DAYS)</div>
                                            <div class="d-flex justify-content-between align-items-baseline">
                                                <span class="fs-3 fw-black text-orange" style="color: #fd7e14 !important;">@GetVelocityCount("SLOW_MOVER")</span>
                                                <span class="badge bg-warning-subtle text-dark fw-bold" style="font-size: 0.72rem;">Low Turnover</span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-12 col-md-3">
                                        <div class="card border rounded-4 shadow-sm p-3 bg-white h-100 border-start border-4 border-danger">
                                            <div class="text-muted fw-bold extra-small text-uppercase mb-1" style="font-size: 0.65rem;">DEAD STOCK (60+ DAYS / UNSOLD)</div>
                                            <div class="d-flex justify-content-between align-items-baseline">
                                                <span class="fs-3 fw-black text-danger">@GetVelocityCount("DEAD_STOCK")</span>
                                                <span class="badge bg-danger-subtle text-danger fw-bold" style="font-size: 0.72rem;">@GetDeadStockCapital().ToString("C0") Capital Tied Up</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- FILTER & SEARCH TOOLBAR -->
                                <div class="card border rounded-4 shadow-sm p-3 mb-4 bg-white flex-shrink-0">
                                    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                                        <!-- CATEGORY & VELOCITY PILLS -->
                                        <div class="d-flex flex-column gap-2">
                                            <div class="d-flex align-items-center gap-1 overflow-x-auto" style="white-space: nowrap;">
                                                <span class="extra-small fw-black text-muted me-2 text-uppercase">Category:</span>
                                                <button class="btn btn-sm rounded-pill fw-black px-3 py-1 extra-small @(_auditCategoryFilter == "ALL_BEVERAGES" ? "btn-primary shadow-sm" : "btn-white border text-secondary")" @onclick='() => SetVelocityCategoryFilter("ALL_BEVERAGES")'>ALL DRINKS</button>
                                                <button class="btn btn-sm rounded-pill fw-black px-3 py-1 extra-small @(_auditCategoryFilter == "BEER" ? "btn-primary shadow-sm" : "btn-white border text-secondary")" @onclick='() => SetVelocityCategoryFilter("BEER")'>BEER</button>
                                                <button class="btn btn-sm rounded-pill fw-black px-3 py-1 extra-small @(_auditCategoryFilter == "LIQUOR" ? "btn-primary shadow-sm" : "btn-white border text-secondary")" @onclick='() => SetVelocityCategoryFilter("LIQUOR")'>LIQUOR</button>
                                                <button class="btn btn-sm rounded-pill fw-black px-3 py-1 extra-small @(_auditCategoryFilter == "SELTZER" ? "btn-primary shadow-sm" : "btn-white border text-secondary")" @onclick='() => SetVelocityCategoryFilter("SELTZER")'>SELTZER</button>
                                                <button class="btn btn-sm rounded-pill fw-black px-3 py-1 extra-small @(_auditCategoryFilter == "WINE" ? "btn-primary shadow-sm" : "btn-white border text-secondary")" @onclick='() => SetVelocityCategoryFilter("WINE")'>WINE</button>
                                                <button class="btn btn-sm rounded-pill fw-black px-3 py-1 extra-small @(_auditCategoryFilter == "FOOD" ? "btn-primary shadow-sm" : "btn-white border text-secondary")" @onclick='() => SetVelocityCategoryFilter("FOOD")'>FOOD</button>
                                                <button class="btn btn-sm rounded-pill fw-black px-3 py-1 extra-small @(_auditCategoryFilter == "ALL" ? "btn-dark shadow-sm" : "btn-white border text-secondary")" @onclick='() => SetVelocityCategoryFilter("ALL")'>ALL ITEMS</button>
                                            </div>

                                            <div class="d-flex align-items-center gap-1 overflow-x-auto" style="white-space: nowrap;">
                                                <span class="extra-small fw-black text-muted me-2 text-uppercase">Velocity:</span>
                                                <button class="btn btn-sm rounded-pill fw-black px-3 py-1 extra-small @(_velocityStatusFilter == "ALL" ? "btn-dark shadow-sm" : "btn-white border text-secondary")" @onclick='() => SetVelocityStatusFilter("ALL")'>ALL MOVEMENT</button>
                                                <button class="btn btn-sm rounded-pill fw-black px-3 py-1 extra-small @(_velocityStatusFilter == "FAST_MOVER" ? "btn-success shadow-sm text-white" : "btn-white border text-secondary")" @onclick='() => SetVelocityStatusFilter("FAST_MOVER")'>🟢 FAST MOVERS (≤7d)</button>
                                                <button class="btn btn-sm rounded-pill fw-black px-3 py-1 extra-small @(_velocityStatusFilter == "MODERATE" ? "btn-warning shadow-sm text-dark" : "btn-white border text-secondary")" @onclick='() => SetVelocityStatusFilter("MODERATE")'>🟡 MODERATE (8-30d)</button>
                                                <button class="btn btn-sm rounded-pill fw-black px-3 py-1 extra-small @(_velocityStatusFilter == "SLOW_MOVER" ? "btn-danger shadow-sm text-white" : "btn-white border text-secondary")" @onclick='() => SetVelocityStatusFilter("SLOW_MOVER")'>🔴 SLOW MOVERS (31-60d)</button>
                                                <button class="btn btn-sm rounded-pill fw-black px-3 py-1 extra-small @(_velocityStatusFilter == "DEAD_STOCK" ? "btn-danger shadow-sm text-white" : "btn-white border text-secondary")" style="@(_velocityStatusFilter == "DEAD_STOCK" ? "background-color: #881337 !important; border-color: #881337 !important;" : "")" @onclick='() => SetVelocityStatusFilter("DEAD_STOCK")'>⛔ DEAD STOCK (60d+)</button>
                                            </div>
                                        </div>

                                        <div class="d-flex align-items-center gap-2 ms-auto">
                                            <div class="btn-group btn-group-sm rounded-pill p-1 bg-light border me-1" style="font-size: 0.72rem;">
                                                <button class="btn btn-sm rounded-pill px-3 @(_velocityViewMode == "TABLE" ? "btn-primary text-white" : "btn-light text-muted border-0")" style="font-size: 0.75rem;" @onclick='() => SetVelocityViewMode("TABLE")'>TABLE</button>
                                                <button class="btn btn-sm rounded-pill px-3 @(_velocityViewMode == "CHART" ? "btn-primary text-white" : "btn-light text-muted border-0")" style="font-size: 0.75rem;" @onclick='() => SetVelocityViewMode("CHART")'>CHART</button>
                                            </div>

                                            @if (_velocityViewMode == "CHART")
                                            {
                                                <div class="btn-group btn-group-sm rounded-pill p-1 bg-light border me-1" style="font-size: 0.72rem;">
                                                    <button class="btn btn-sm rounded-pill px-2.5 @(_velocityChartMetric == "DAYS" ? "btn-dark text-white" : "btn-light text-muted border-0")" style="font-size: 0.7rem;" @onclick='() => SetVelocityChartMetric("DAYS")'>DAYS</button>
                                                    <button class="btn btn-sm rounded-pill px-2.5 @(_velocityChartMetric == "VALUE" ? "btn-dark text-white" : "btn-light text-muted border-0")" style="font-size: 0.7rem;" @onclick='() => SetVelocityChartMetric("VALUE")'>CAPITAL ($)</button>
                                                </div>

                                                <select class="form-select form-select-sm fw-bold bg-light border-0 me-1" style="max-width: 110px; font-size: 0.75rem;" value="@_velocityChartTopLimit" @onchange='(e) => SetVelocityChartTopLimit(int.Parse(e.Value?.ToString() ?? "15"))'>
                                                    <option value="10">TOP 10</option>
                                                    <option value="15">TOP 15</option>
                                                    <option value="25">TOP 25</option>
                                                    <option value="0">ALL ITEMS</option>
                                                </select>

                                                <button class="btn btn-sm @(_velocityChartHorizontal ? "btn-primary text-white" : "btn-outline-secondary bg-white text-dark") rounded-pill px-2.5 shadow-xs me-1" style="font-size: 0.72rem;" @onclick="ToggleVelocityChartOrientation" title="Toggle Vertical / Horizontal Bar Chart">
                                                    <i class="bi @(_velocityChartHorizontal ? "bi-bar-chart-steps" : "bi-bar-chart-fill")"></i>
                                                </button>
                                            }

                                            <select class="form-select form-select-sm fw-bold border rounded-pill shadow-xs" style="width: 170px; font-size: 0.78rem;" value="@_velocitySortBy" @onchange="OnVelocitySortSelectChanged">
                                                <option value="DAYS_DESC">Sort: Longest Unsold</option>
                                                <option value="DAYS_ASC">Sort: Most Recent Sale</option>
                                                <option value="STOCK_VALUE_DESC">Sort: Stock Value at Risk</option>
                                                <option value="REVENUE_DESC">Sort: Revenue (High to Low)</option>
                                                <option value="NAME">Sort: Product Name A-Z</option>
                                            </select>

                                            <div class="position-relative" style="width: 160px;">
                                                <i class="bi bi-search position-absolute top-50 start-0 translate-middle-y ms-3 text-muted" style="font-size: 0.8rem;"></i>
                                                <input type="text" class="form-select form-select-sm rounded-pill ps-4 pe-3 border shadow-xs" placeholder="Search product..." style="font-size: 0.78rem;" @bind="_velocitySearchTerm" @bind:event="oninput" @bind:after="OnVelocityFiltersChanged" />
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                @if (_velocityViewMode == "CHART")
                                {
                                    <!-- PRODUCT MOVEMENT VELOCITY VISUAL CHART -->
                                    <div class="card border rounded-4 p-4 bg-white mb-4 shadow-sm flex-grow-1">
                                        <div class="d-flex justify-content-between align-items-center mb-3">
                                            <h6 class="fw-black text-dark text-uppercase mb-0 d-flex align-items-center">
                                                <i class="bi bi-bar-chart-line-fill text-primary me-2"></i>MOVEMENT VELOCITY VISUAL RANKING
                                            </h6>
                                            <span class="badge bg-light text-muted border extra-small">
                                                @(_velocityChartMetric == "VALUE" ? "Stock Capital at Risk ($)" : "Days Since Last Sale")
                                            </span>
                                        </div>
                                        <div class="position-relative w-100 flex-grow-1" style="min-height: 420px;">
                                            <canvas id="velocityMovementChart"></canvas>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <!-- PRODUCT LAST SOLD & VELOCITY TABLE -->
                                    <div class="card border rounded-4 shadow-sm bg-white overflow-hidden flex-grow-1">
                                    <div class="table-responsive h-100" style="max-height: 550px;">
                                        <table class="table table-hover align-middle mb-0" style="font-size: 0.82rem;">
                                            <thead class="bg-light sticky-top" style="z-index: 2;">
                                                <tr class="text-muted extra-small text-uppercase">
                                                    <th class="ps-4">PRODUCT / BRAND</th>
                                                    <th class="text-center">LAST SOLD DATE & TIME</th>
                                                    <th class="text-center">TIME SINCE LAST SALE</th>
                                                    <th class="text-center">VELOCITY STATUS</th>
                                                    <th class="text-end">30D REVENUE</th>
                                                    <th class="text-end pe-4">STOCK VALUE AT RISK</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @if (!GetFilteredAuditVelocityMetrics().Any())
                                                {
                                                    <tr>
                                                        <td colspan="6" class="text-center py-5 text-muted fw-bold">
                                                            <i class="bi bi-inbox fs-2 d-block mb-2 text-muted"></i>
                                                            No product movement records found matching filters.
                                                        </td>
                                                    </tr>
                                                }
                                                else
                                                {
                                                    @foreach (var item in GetFilteredAuditVelocityMetrics())
                                                    {
                                                        var stockVal = item.CurrentStock * (item.WholesaleCost > 0 ? item.WholesaleCost : 12.50m);
                                                        <tr>
                                                            <td class="ps-4">
                                                                <div class="fw-black text-primary cursor-pointer" style="cursor: pointer;" @onclick="() => SelectProductTrend(item.Name)" title="Click to view sales trend & 7-day forecast">
                                                                    @item.Name.ToUpper() <i class="bi bi-graph-up-arrow ms-1 text-muted extra-small"></i>
                                                                </div>
                                                                <span class="badge bg-light text-muted border text-uppercase" style="font-size: 0.65rem;">@item.Category</span>
                                                            </td>
                                                            <td class="text-center fw-bold">
                                                                @if (item.LastSoldDate.HasValue)
                                                                {
                                                                    <div class="text-dark">@item.LastSoldDate.Value.ToString("MMM dd, yyyy")</div>
                                                                    <div class="extra-small text-muted">@item.LastSoldDate.Value.ToString("h:mm tt")</div>
                                                                }
                                                                else
                                                                {
                                                                    <span class="badge bg-secondary-subtle text-secondary border">No Sales Recorded</span>
                                                                }
                                                            </td>
                                                            <td class="text-center">
                                                                @if (item.LastSoldDate.HasValue)
                                                                {
                                                                    var days = item.DaysSinceLastSale;
                                                                    <span class="fw-black fs-6 @(days <= 7 ? "text-success" : (days <= 30 ? "text-dark" : "text-danger"))">
                                                                        @(days == 0 ? "Today" : (days == 1 ? "1 day ago" : $"{days} days ago"))
                                                                    </span>
                                                                }
                                                                else
                                                                {
                                                                    <span class="text-muted fw-bold">Dormant</span>
                                                                }
                                                            </td>
                                                            <td class="text-center">
                                                                @if (item.VelocityStatus == "FAST_MOVER")
                                                                {
                                                                    <span class="badge bg-success-subtle text-success border border-success-subtle fw-black px-3 py-1.5 rounded-pill" style="background: #e6f4ea !important;">
                                                                        🟢 FAST MOVER
                                                                    </span>
                                                                }
                                                                else if (item.VelocityStatus == "MODERATE")
                                                                {
                                                                    <span class="badge bg-warning-subtle text-dark border border-warning-subtle fw-black px-3 py-1.5 rounded-pill" style="background: #fef7e0 !important; color: #856404 !important;">
                                                                        🟡 MODERATE
                                                                    </span>
                                                                }
                                                                else if (item.VelocityStatus == "SLOW_MOVER")
                                                                {
                                                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle fw-black px-3 py-1.5 rounded-pill" style="background: #ffebe9 !important;">
                                                                        🔴 SLOW MOVER
                                                                    </span>
                                                                }
                                                                else
                                                                {
                                                                    <span class="badge text-white fw-black px-3 py-1.5 rounded-pill" style="background: #881337 !important;">
                                                                        ⛔ DEAD STOCK
                                                                    </span>
                                                                }
                                                            </td>
                                                            <td class="text-end fw-black text-dark fs-6">@item.Revenue.ToString("C0")</td>
                                                            <td class="text-end pe-4">
                                                                <div class="fw-black @(stockVal > 100 && item.DaysSinceLastSale > 30 ? "text-danger" : "text-dark") fs-6">
                                                                    @stockVal.ToString("C0")
                                                                </div>
                                                                <div class="extra-small text-muted">@item.CurrentStock @(item.IsLiquor ? "shots" : "units") on hand</div>
                                                            </td>
                                                        </tr>
                                                    }
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                                }
                            }
                            else
                            {
                                <!-- TOP TOOLBAR: QUICK TOP 10 PRODUCT BUTTONS & ALL DRINKS SELECTOR -->
                                <div class="card border rounded-4 shadow-sm p-3 mb-4 bg-white flex-shrink-0">
                                    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-3">
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="extra-small fw-black text-muted text-uppercase me-1"><i class="bi bi-trophy-fill text-warning me-1"></i>TOP 10 SELLING PRODUCTS:</span>
                                            <span class="extra-small text-muted d-none d-md-inline">(Click any product to view its sales trend)</span>
                                        </div>
                                    </div>

                                    <!-- QUICK-CLICK TOP 10 PRODUCT BUTTONS ROW -->
                                    <div class="d-flex flex-wrap gap-2 mb-3 pb-3 border-bottom">
                                        @foreach (var (topProd, idx) in activeMetrics.OrderByDescending(x => x.Quantity).Take(10).Select((x, i) => (x, i + 1)))
                                        {
                                            bool isSelected = CleanProductName(topProd.Name).Equals(CleanProductName(_selectedAuditTrendProductName ?? ""), StringComparison.OrdinalIgnoreCase);

                                            <button type="button" class="btn btn-sm rounded-pill extra-small fw-black px-3 py-1.5 transition-all d-flex align-items-center gap-2 shadow-xs"
                                                    style="@(isSelected ? "background: #2563eb !important; color: #ffffff !important; border: 1px solid #2563eb !important;" : "background: #ffffff !important; color: #1e293b !important; border: 1px solid #cbd5e1 !important;")"
                                                    @onclick="() => SelectProductTrend(topProd.Name)">
                                                <span class="badge rounded-circle" style="width: 20px; height: 20px; display: inline-flex; align-items: center; justify-content: center; font-size: 10px; @(isSelected ? "background: #ffffff !important; color: #2563eb !important;" : "background: #2563eb !important; color: #ffffff !important;")">@idx</span>
                                                <span class="fw-black">@topProd.Name.ToUpper()</span>
                                                <span class="badge rounded-pill ms-1 px-2.5 py-1 fw-black" style="@(isSelected ? "background: #ffffff !important; color: #2563eb !important; border: 1px solid #ffffff !important;" : "background: #eff6ff !important; color: #1d4ed8 !important; border: 1px solid #bfdbfe !important;")">@topProd.Quantity sold</span>
                                            </button>
                                        }
                                    </div>

                                    <!-- ALL DRINKS DROPDOWN FALLBACK SELECTOR -->
                                    <div class="d-flex align-items-center gap-2" style="max-width: 600px;">
                                    <label class="extra-small fw-black text-muted text-uppercase mb-0 me-1"><i class="bi bi-search text-primary me-1"></i>Or Select Any Product From List:</label>
                                    <select class="form-select form-select-sm rounded-pill fw-bold border shadow-xs" value="@_selectedAuditTrendProductName" @onchange='(e) => SelectProductTrend(e.Value?.ToString() ?? "")'>
                                        @foreach (var prod in activeMetrics)
                                        {
                                            <option value="@prod.Name">@prod.Name.ToUpper() (@prod.Category) — @prod.Quantity units sold</option>
                                        }
                                    </select>
                                </div>
                            </div>

                            @if (!_multiProductMode)
                            {
                                <!-- SINGLE PRODUCT STAT CARDS BANNER -->
                                <div class="row g-3 mb-4">
                                    <div class="col-12 col-md-3">
                                        <div class="card border rounded-4 shadow-sm p-3 bg-white h-100 text-center">
                                            <div class="text-muted extra-small fw-bold text-uppercase mb-1">TOTAL UNITS SOLD</div>
                                            <div class="fs-4 fw-black text-primary">@totalUnitsSold units</div>
                                            <div class="extra-small text-muted mt-1">In selected filter range</div>
                                        </div>
                                    </div>
                                    <div class="col-12 col-md-3">
                                        <div class="card border rounded-4 shadow-sm p-3 bg-white h-100 text-center">
                                            <div class="text-muted extra-small fw-bold text-uppercase mb-1">TOTAL SALES REVENUE</div>
                                            <div class="fs-4 fw-black text-success">$@totalRevenue.ToString("N2")</div>
                                            <div class="extra-small text-muted mt-1">Earned cash/credit value</div>
                                        </div>
                                    </div>
                                    <div class="col-12 col-md-3">
                                        <div class="card border rounded-4 shadow-sm p-3 bg-white h-100 text-center">
                                            <div class="text-muted extra-small fw-bold text-uppercase mb-1">@(isMonthly ? "PEAK SALES MONTH" : "PEAK SALES DAY")</div>
                                            <div class="fs-4 fw-black text-dark">@(peakDay != null && peakDay.Quantity > 0 ? $"{peakDay.Quantity} units" : "0 units")</div>
                                            <div class="extra-small text-muted mt-1">@(peakDay != null && peakDay.Quantity > 0 ? (isMonthly ? peakDay.Date.ToString("MMMM yyyy") : peakDay.Date.ToString("ddd, MMM dd")) : "No peak")</div>
                                        </div>
                                    </div>
                                    <div class="col-12 col-md-3">
                                        <div class="card border rounded-4 shadow-sm p-3 bg-white h-100 text-center">
                                            <div class="text-muted extra-small fw-bold text-uppercase mb-1">@(isMonthly ? "MONTHLY AVERAGE VOLUME" : "DAILY AVERAGE VOLUME")</div>
                                            <div class="fs-4 fw-black text-dark">@avgUnits units/@(isMonthly ? "mo" : "day")</div>
                                            <div class="extra-small text-muted mt-1">Across @trendPoints.Count @(isMonthly ? "months" : "days")</div>
                                        </div>
                                    </div>
                                </div>

                                <!-- SINGLE PRODUCT VISUAL SALES TREND CHART -->
                                <div class="card border rounded-4 p-4 bg-white mb-4 shadow-sm">
                                    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                                        <div>
                                            <h5 class="fw-black text-dark mb-0 d-flex align-items-center">
                                                <i class="bi bi-graph-up text-primary me-2"></i>@((_selectedAuditTrendProductName ?? "PRODUCT").ToUpper()) — @(isMonthly ? "MONTHLY" : "DAILY") SALES VOLUME TREND
                                            </h5>
                                            <p class="extra-small text-muted mb-0">@(isMonthly ? "Monthly" : "Daily") units sold recorded from POS transactions between @StartDate.ToString("MM/dd/yyyy") and @EndDate.ToString("MM/dd/yyyy")</p>
                                        </div>
                                        <div class="d-flex align-items-center gap-3 extra-small fw-bold">
                                            <span><span class="d-inline-block rounded-circle me-1" style="width: 10px; height: 10px; background: #2563eb;"></span> Actual POS @(isMonthly ? "Monthly" : "Daily") Sales Volume</span>
                                        </div>
                                    </div>
                                    <div class="position-relative w-100 overflow-hidden">
                                        <svg viewBox="0 0 @svgData.width @svgData.height" class="w-100" style="width: 100%; max-width: 100%; height: auto; display: block;">
                                            <defs>
                                                <linearGradient id="trendAreaGradient" x1="0" y1="0" x2="0" y2="1">
                                                    <stop offset="0%" stop-color="#2563eb" stop-opacity="0.25" />
                                                    <stop offset="100%" stop-color="#2563eb" stop-opacity="0.01" />
                                                </linearGradient>
                                            </defs>

                                            <!-- Grid Lines -->
                                            <line x1="55" y1="35" x2="@(svgData.width - 55)" y2="35" stroke="#f1f5f9" stroke-dasharray="4 4" stroke-width="1" />
                                            <line x1="55" y1="107" x2="@(svgData.width - 55)" y2="107" stroke="#f1f5f9" stroke-dasharray="4 4" stroke-width="1" />
                                            <line x1="55" y1="180" x2="@(svgData.width - 55)" y2="180" stroke="#cbd5e1" stroke-width="1.5" />

                                            <!-- Numeric Y-Axis Scale Values -->
                                            @((MarkupString)$"<text x=\"46\" y=\"39\" text-anchor=\"end\" fill=\"#64748b\" font-size=\"11\" font-weight=\"800\">{svgData.maxQty}</text>")
                                            @((MarkupString)$"<text x=\"46\" y=\"111\" text-anchor=\"end\" fill=\"#94a3b8\" font-size=\"10\" font-weight=\"700\">{svgData.maxQty / 2}</text>")
                                            @((MarkupString)$"<text x=\"46\" y=\"184\" text-anchor=\"end\" fill=\"#94a3b8\" font-size=\"10\" font-weight=\"700\">0</text>")

                                            <!-- Gradient Fill Under Sales Curve -->
                                            @if (!string.IsNullOrEmpty(svgData.areaPath))
                                            {
                                                <path d="@svgData.areaPath" fill="url(#trendAreaGradient)" />
                                            }

                                            <!-- Solid Blue Line -->
                                            @if (!string.IsNullOrEmpty(svgData.linePath))
                                            {
                                                <path d="@svgData.linePath" fill="none" stroke="#2563eb" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" />
                                            }

                                            <!-- Markers & X-Axis Date Scale -->
                                            @foreach (var pt in svgData.points)
                                            {
                                                <g class="chart-node">
                                                    <circle cx="@pt.x.ToString("F1")" cy="@pt.y.ToString("F1")" r="4.5" fill="#2563eb" stroke="#ffffff" stroke-width="2.5">
                                                        <title>@(isMonthly ? pt.pt.Date.ToString("MMMM yyyy") : pt.pt.Date.ToString("ddd, MMM dd, yyyy")): @pt.pt.Quantity units sold ($@pt.pt.Revenue.ToString("N2"))</title>
                                                    </circle>

                                                    @if (pt.pt.Quantity > 0)
                                                    {
                                                        @((MarkupString)$"<text x=\"{pt.x:F1}\" y=\"{(pt.y - 8):F1}\" text-anchor=\"middle\" fill=\"#1e3a8a\" font-size=\"10\" font-weight=\"800\">{pt.pt.Quantity}</text>")
                                                    }

                                                    @if (pt.showLabel)
                                                    {
                                                        @((MarkupString)$"<text x=\"{pt.x:F1}\" y=\"214\" text-anchor=\"middle\" fill=\"#334155\" font-size=\"11\" font-weight=\"800\">{pt.pt.Label}</text>")
                                                        @if (!isMonthly)
                                                        {
                                                            @((MarkupString)$"<text x=\"{pt.x:F1}\" y=\"228\" text-anchor=\"middle\" fill=\"#64748b\" font-size=\"9\" font-weight=\"700\">{pt.pt.Date.ToString("ddd").ToUpper()}</text>")
                                                        }
                                                    }
                                                </g>
                                            }
                                        </svg>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <!-- MULTI-PRODUCT COMPARISON VISUAL SALES TREND CHART -->
                                var multiNames = _selectedMultiTrendProducts.ToList();
                                if (!multiNames.Any() && activeMetrics.Any())
                                {
                                    multiNames = activeMetrics.Take(5).Select(x => x.Name).ToList();
                                }

                                var multiData = CalculateMultiTrendSvgData(multiNames);

                                <div class="card border rounded-4 p-4 bg-white mb-4 shadow-sm">
                                    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                                        <div>
                                            <h5 class="fw-black text-dark mb-0 d-flex align-items-center">
                                                <i class="bi bi-bar-chart-line-fill text-primary me-2"></i>MULTI-PRODUCT SALES TREND COMPARISON
                                            </h5>
                                            <p class="extra-small text-muted mb-0">Comparing daily POS volume trends for @multiNames.Count products between @StartDate.ToString("MM/dd/yyyy") and @EndDate.ToString("MM/dd/yyyy")</p>
                                        </div>

                                        <div class="d-flex flex-wrap align-items-center gap-3 extra-small fw-bold">
                                            @foreach (var s in multiData.SeriesList)
                                            {
                                                <span class="d-flex align-items-center gap-1">
                                                    <span class="d-inline-block rounded-circle" style="width: 10px; height: 10px; background: @s.Color;"></span>
                                                    <span>@s.ProductName.ToUpper()</span>
                                                </span>
                                            }
                                        </div>
                                    </div>

                                    <div class="position-relative w-100 overflow-hidden">
                                        <svg viewBox="0 0 @multiData.Width @multiData.Height" class="w-100" style="width: 100%; max-width: 100%; height: auto; display: block;">
                                            <!-- Grid Lines -->
                                            <line x1="55" y1="35" x2="@(multiData.Width - 55)" y2="35" stroke="#f1f5f9" stroke-dasharray="4 4" stroke-width="1" />
                                            <line x1="55" y1="107" x2="@(multiData.Width - 55)" y2="107" stroke="#f1f5f9" stroke-dasharray="4 4" stroke-width="1" />
                                            <line x1="55" y1="180" x2="@(multiData.Width - 55)" y2="180" stroke="#cbd5e1" stroke-width="1.5" />

                                            <!-- Numeric Y-Axis Scale Values -->
                                            @((MarkupString)$"<text x=\"46\" y=\"39\" text-anchor=\"end\" fill=\"#64748b\" font-size=\"11\" font-weight=\"800\">{multiData.MaxQty}</text>")
                                            @((MarkupString)$"<text x=\"46\" y=\"111\" text-anchor=\"end\" fill=\"#94a3b8\" font-size=\"10\" font-weight=\"700\">{multiData.MaxQty / 2}</text>")
                                            @((MarkupString)$"<text x=\"46\" y=\"184\" text-anchor=\"end\" fill=\"#94a3b8\" font-size=\"10\" font-weight=\"700\">0</text>")

                                            <!-- Product Series Lines & Markers -->
                                            @foreach (var series in multiData.SeriesList)
                                            {
                                                @if (!string.IsNullOrEmpty(series.LinePath))
                                                {
                                                    <path d="@series.LinePath" fill="none" stroke="@series.Color" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
                                                }

                                                @foreach (var pt in series.Coords)
                                                {
                                                    <g class="chart-node">
                                                        <circle cx="@pt.x.ToString("F1")" cy="@pt.y.ToString("F1")" r="4.5" fill="@series.Color" stroke="#ffffff" stroke-width="2">
                                                            <title>@series.ProductName: @pt.pt.Date.ToString("ddd, MMM dd"): @pt.pt.Quantity units sold ($@pt.pt.Revenue.ToString("N2"))</title>
                                                        </circle>

                                                        @if (pt.pt.Quantity > 0)
                                                        {
                                                            @((MarkupString)$"<text x=\"{pt.x:F1}\" y=\"{(pt.y - 7):F1}\" text-anchor=\"middle\" fill=\"{series.Color}\" font-size=\"9\" font-weight=\"800\">{pt.pt.Quantity}</text>")
                                                        }
                                                    </g>
                                                }
                                            }

                                            <!-- X-Axis Date Scale -->
                                            @foreach (var d in multiData.Dates)
                                            {
                                                @if (d.showLabel)
                                                {
                                                    @((MarkupString)$"<text x=\"{d.x:F1}\" y=\"214\" text-anchor=\"middle\" fill=\"#334155\" font-size=\"11\" font-weight=\"800\">{d.Label}</text>")
                                                    @((MarkupString)$"<text x=\"{d.x:F1}\" y=\"228\" text-anchor=\"middle\" fill=\"#64748b\" font-size=\"9\" font-weight=\"700\">{d.Date.ToString("ddd").ToUpper()}</text>")
                                                }
                                            }
                                        </svg>
                                    </div>
                                </div>
                            }
                        }
                    </div>
                }
            </div>
        }
            else
            {
                <div class="audit-viewer-panel custom-scrollbar">
                    @if (ActiveTab == "ZREPORTS")
                {
                    @if (SelectedZReport != null)
                    {
                        <div class="w-100 p-4 animate-fade-in" style="max-width: 1100px;">
                            <!-- TOP HEADER & VIEW TOGGLE BAR (STICKY TOP) -->
                            <div class="bg-white rounded-4 border p-3 mb-4 shadow-sm d-flex flex-wrap justify-content-between align-items-center gap-3 sticky-top" style="position: sticky; top: 0; z-index: 100; box-shadow: 0 4px 14px rgba(0,0,0,0.08) !important;">
                                <div>
                                    <div class="text-muted fw-bold small text-uppercase mb-1" style="letter-spacing: 1px;">
                                        @(_zreportShowThermal ? "📄 PRINTED Z-REPORT VIEW (POS 80mm Layout)" : "📊 SUMMARY DASHBOARD VIEW")
                                    </div>
                                    <h4 class="fw-black mb-0 text-primary">@SelectedZReport.TerminalName.ToUpper()</h4>
                                    <small class="text-muted fw-bold">By: @SelectedZReport.BartenderName @@ @SelectedZReport.Timestamp.ToString("f")</small>
                                </div>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="btn-group shadow-sm me-1">
                                        <button class="btn btn-sm @(_zreportShowThermal ? "btn-warning text-dark fw-black" : "btn-outline-secondary bg-white text-dark")" style="font-size: 0.78rem; padding: 7px 16px;" @onclick="() => _zreportShowThermal = true">
                                            <i class="bi @(_zreportShowThermal ? "bi-check-circle-fill" : "bi-receipt") me-1"></i> PRINTED RECEIPT VIEW
                                        </button>
                                        <button class="btn btn-sm @(!_zreportShowThermal ? "btn-warning text-dark fw-black" : "btn-outline-secondary bg-white text-dark")" style="font-size: 0.78rem; padding: 7px 16px;" @onclick="() => _zreportShowThermal = false">
                                            <i class="bi @(!_zreportShowThermal ? "bi-check-circle-fill" : "bi-grid-3x3-gap-fill") me-1"></i> SUMMARY VIEW
                                        </button>
                                    </div>
                                    <button class="btn btn-sm btn-primary fw-bold rounded-pill px-3 shadow-sm" style="font-size: 0.75rem;" @onclick="PrintZReport" title="Print Z-Report">
                                        <i class="bi bi-printer-fill me-1"></i> PRINT REPORT
                                    </button>
                                    @if (_zreportShowThermal)
                                    {
                                        <button class="btn btn-sm btn-outline-dark fw-bold rounded-pill px-3 shadow-sm" style="font-size: 0.75rem;" @onclick="CopyAuditZReportText" title="Copy Receipt Text">
                                            <i class="bi bi-clipboard me-1"></i> COPY TEXT
                                        </button>
                                    }
                                </div>
                            </div>

                            @if (_zreportShowThermal)
                            {
                                <!-- FULL THERMAL PRINTED RECEIPT VIEW -->
                                <div class="thermal-receipt-container bg-dark p-4 rounded-4 text-center shadow-inner my-2">
                                    <div class="thermal-receipt-paper text-start mx-auto p-4 bg-white text-dark shadow-lg rounded-3 border" style="font-family: 'Courier New', Courier, monospace; font-size: 0.82rem; line-height: 1.35; max-width: 460px; white-space: pre-wrap; word-break: break-word; border-top: 8px solid #1e3a8a !important; border-bottom: 8px dashed #cbd5e1 !important; color: #1e293b; background-color: #fafafa;">
                                        @GetThermalZReportText(SelectedZReport)
                                    </div>
                                </div>
                            }
                            else
                            {
                                <!-- SUMMARY DASHBOARD PORTION -->
                                <div class="flex-grow-1">
                                    <!-- Sales Activity -->
                                    <div class="bg-white rounded-4 border p-4 mb-4 shadow-sm">
                                        <div class="d-flex align-items-center gap-2 mb-3">
                                            <i class="bi bi-list-task text-primary fs-5"></i>
                                            <span class="fw-black text-muted" style="font-size: 0.75rem; letter-spacing: 1px;">POS SALES ACTIVITY</span>
                                        </div>
                                        <div class="table-responsive">
                                            <table class="table table-sm table-borderless align-middle mb-0">
                                                <thead>
                                                    <tr class="border-bottom">
                                                        <th class="text-muted small pb-2">ITEM NAME</th>
                                                        <th class="text-center text-muted small pb-2">QTY</th>
                                                        <th class="text-end text-muted small pb-2">REVENUE</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var item in GetItemsList(SelectedZReport.SalesSummaryJson))
                                                    {
                                                        <tr class="border-bottom-faint">
                                                            <td class="fw-bold py-2" style="font-size: 0.85rem;">@item.Name</td>
                                                            <td class="text-center py-2">
                                                                <span class="badge bg-light text-primary rounded-pill fw-black">@item.Quantity</span>
                                                            </td>
                                                            <td class="text-end py-2 fw-black" style="font-size: 0.85rem;">@((item.Price * item.Quantity).ToString("C"))</td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>

                                    <!-- Inventory Pulls -->
                                    <div class="bg-white rounded-4 border p-4 shadow-sm">
                                        <div class="d-flex align-items-center gap-2 mb-3">
                                            <i class="bi bi-box-seam text-primary fs-5"></i>
                                            <span class="fw-black text-muted" style="font-size: 0.75rem; letter-spacing: 1px;">INVENTORY REMOVAL LOG</span>
                                        </div>
                                        <div class="table-responsive">
                                            <table class="table table-sm table-borderless align-middle mb-0">
                                                <thead>
                                                    <tr class="border-bottom">
                                                        <th class="text-muted small pb-2">BOTTLE NAME</th>
                                                        <th class="text-end text-muted small pb-2">PULLED</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @{
                                                        var pulls = GetPullsList(SelectedZReport.InventoryPullsJson);
                                                        if (!pulls.Any())
                                                        {
                                                            <tr><td colspan="2" class="text-center py-3 text-muted small italic">No inventory pulls recorded this shift.</td></tr>
                                                        }
                                                        else
                                                        {
                                                            @foreach (var p in pulls)
                                                            {
                                                                <tr class="border-bottom-faint">
                                                                    <td class="fw-bold py-2" style="font-size: 0.85rem;">@p.Name</td>
                                                                    <td class="text-end py-2">
                                                                        <span class="badge bg-primary text-white rounded-pill fw-black">@p.Quantity</span>
                                                                    </td>
                                                                </tr>
                                                            }
                                                        }
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>

                                    <!-- Event Activity Log -->
                                    @{
                                        var banquets = ParseBanquets(SelectedZReport.BanquetSummaryJson);
                                    }
                                    @if (banquets != null && banquets.Any())
                                    {
                                        <div class="bg-white rounded-4 border p-4 mt-4 shadow-sm animate-fade-in">
                                            <div class="d-flex align-items-center gap-2 mb-3">
                                                <i class="bi bi-calendar-event text-primary fs-5"></i>
                                                <span class="fw-black text-muted" style="font-size: 0.75rem; letter-spacing: 1px;">EVENT ACTIVITY LOG</span>
                                            </div>
                                            @foreach (var b in banquets)
                                            {
                                                <div class="border rounded-4 overflow-hidden mb-3 bg-white shadow-sm">
                                                    <div class="bg-light p-3 border-bottom d-flex justify-content-between align-items-center">
                                                        <span class="fw-black text-primary small">EVENT: @b.EventName.ToUpper()</span>
                                                        <span class="badge bg-primary text-white fw-black">TOTAL SPENT: @b.TotalSpent.ToString("C")</span>
                                                    </div>
                                                    <div class="p-3">
                                                        <div class="row">
                                                            @if (b.EventType != "RunningTab")
                                                            {
                                                                <div class="col-md-6 border-end">
                                                                    <small class="text-muted fw-bold text-uppercase d-block mb-2" style="font-size: 0.7rem;">Deposits Logged</small>
                                                                    @if (b.Deposits == null || !b.Deposits.Any())
                                                                    {
                                                                        <div class="text-muted small italic">No deposits logged.</div>
                                                                    }
                                                                    else
                                                                    {
                                                                        @foreach (var dep in b.Deposits)
                                                                        {
                                                                            <div class="d-flex justify-content-between small mb-1">
                                                                                <span class="fw-bold text-muted">- Add Funds</span>
                                                                                <span class="fw-black">@dep.ToString("C")</span>
                                                                            </div>
                                                                        }
                                                                    }
                                                                </div>
                                                                <div class="col-md-6">
                                                                    <small class="text-muted fw-bold text-uppercase d-block mb-2" style="font-size: 0.7rem;">Tab Purchases Summary</small>
                                                                    @foreach (var item in (b.ItemSummary ?? new Dictionary<string, int>()).OrderByDescending(x => x.Value))
                                                                    {
                                                                        <div class="d-flex justify-content-between small mb-1">
                                                                            <span class="fw-bold">@item.Key.ToUpper()</span>
                                                                            <span class="badge bg-light text-primary border fw-black" style="font-size: 0.7rem;">x @item.Value</span>
                                                                        </div>
                                                                    }
                                                                </div>
                                                            }
                                                            else
                                                            {
                                                                <div class="col-md-12">
                                                                    <small class="text-muted fw-bold text-uppercase d-block mb-2" style="font-size: 0.7rem;">Tab Purchases Summary</small>
                                                                    @foreach (var item in (b.ItemSummary ?? new Dictionary<string, int>()).OrderByDescending(x => x.Value))
                                                                    {
                                                                        <div class="d-flex justify-content-between small mb-1">
                                                                            <span class="fw-bold">@item.Key.ToUpper()</span>
                                                                            <span class="badge bg-light text-primary border fw-black" style="font-size: 0.7rem;">x @item.Value</span>
                                                                        </div>
                                                                    }
                                                                </div>
                                                            }
                                                        </div>
                                                        <div class="mt-3 pt-3 border-top d-flex justify-content-between align-items-center">
                                                            @{
                                                                var isRunningTab = b.EventType == "RunningTab" || b.EventName.EndsWith(" [Direct]") || b.EventName.EndsWith("[Direct]");
                                                                var remaining = (b.Deposits?.Sum() ?? 0) - b.TotalSpent;
                                                            }
                                                            @if (isRunningTab)
                                                            {
                                                                <span class="fw-bold text-muted small">TOTAL DUE</span>
                                                                <span class="fw-black text-dark fs-5">@b.TotalSpent.ToString("C")</span>
                                                            }
                                                            else
                                                            {
                                                                <span class="fw-bold text-muted small">TAB BALANCE</span>
                                                                <span class="fw-black fs-5 @(remaining < 0 ? "text-danger" : "text-success")">@remaining.ToString("C")</span>
                                                            }
                                                        </div>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                }
                else if (ActiveTab == "SALES")
                {
                    @if (SelectedSale != null)
                        {
                            <div class="receipt-stage animate-fade-in">
                                <div class="receipt-paper shadow-lg">
                                    <div class="receipt-header">
                                        <div class="brand">GFC POS</div>
                                        <div class="fw-black text-uppercase">@SelectedSale.TerminalName</div>
                                        <div class="timestamp">@SelectedSale.Timestamp.ToString("f")</div>
                                        <div class="bart">Bartender: @SelectedSale.BartenderName</div>
                                        @{
                                            var selEvName = GetEventNameForSale(SelectedSale);
                                            var isSelDarts = SelectedSale.ItemsJson != null && SelectedSale.ItemsJson.Contains("(DARTS");
                                        }
                                        @if (isSelDarts)
                                        {
                                            <div class="badge text-white fw-bold px-3 py-1 mt-2 rounded-pill shadow-xs d-inline-block" style="font-size: 0.78rem; letter-spacing: 0.5px; background: linear-gradient(135deg, #7c3aed 0%, #6d28d9 100%);">
                                                <i class="bi bi-bullseye me-1"></i>DART ROUND
                                            </div>
                                        }
                                        else if (!string.IsNullOrEmpty(selEvName) || SelectedSale.PaymentType == "TAB" || SelectedSale.ActiveEventId.HasValue)
                                        {
                                            <div class="badge bg-primary text-white fw-bold px-3 py-1 mt-2 rounded-pill shadow-xs d-inline-block" style="font-size: 0.78rem; letter-spacing: 0.5px;">
                                                <i class="bi bi-journal-check me-1"></i>EVENT TAB: @(string.IsNullOrEmpty(selEvName) ? "ACTIVE TAB" : selEvName.ToUpper())
                                            </div>
                                        }
                                    </div>

                                    <div class="receipt-body">
                                        <div class="section-title">ITEMS</div>
                                        @foreach (var item in GetItemsList(SelectedSale.ItemsJson))
                                        {
                                            bool isItemSale = !item.IsTokenApplied && (item.Category == "TOKENS" || item.Category == "TOKEN" || (item.Name ?? "").ToUpper().Contains("TOKEN SALE")) && !(item.Name ?? "").ToUpper().Contains("TOKEN REDEEMED") && !(item.Name ?? "").ToUpper().Contains("(CREDITED");
                                            bool isItemRedeem = item.IsTokenApplied || (item.Name ?? "").ToUpper().Contains("TOKEN REDEEMED") || (item.Name ?? "").ToUpper().Contains("(CREDITED") || item.Category == "TOKEN_CREDIT" || (item.Price == 0 && (item.Name ?? "").ToUpper().Contains("TOKEN") && !(item.Name ?? "").ToUpper().Contains("TOKEN SALE"));

                                            <div class="receipt-item">
                                                <span class="qty">@item.Quantity x</span>
                                                <span class="name">
                                                    @item.Name
                                                    @if (isItemRedeem)
                                                    {
                                                        <span class="badge bg-success-subtle text-success rounded-pill ms-1" style="font-size: 0.6rem; padding: 1px 5px;">REDEEMED</span>
                                                    }
                                                    else if (isItemSale)
                                                    {
                                                        <span class="badge bg-danger-subtle text-danger rounded-pill ms-1" style="font-size: 0.6rem; padding: 1px 5px;">TOKEN SALE</span>
                                                    }
                                                </span>
                                                <span class="price">@((item.Price * item.Quantity).ToString("C"))</span>
                                            </div>
                                            @if (item.Modifiers != null && item.Modifiers.Any())
                                            {
                                                @foreach (var mod in item.Modifiers)
                                                {
                                                    <div class="receipt-item ps-4 text-muted" style="border-bottom: none; padding-top: 1px; padding-bottom: 1px; font-size: 0.8rem;">
                                                        <span class="qty" style="font-weight: normal;">@mod.Quantity x</span>
                                                        <span class="name" style="text-transform: uppercase; font-style: italic; color: #7c3aed; font-weight: normal;">+ @mod.Name</span>
                                                        <span class="price" style="font-weight: normal;">@((mod.Price * mod.Quantity).ToString("C"))</span>
                                                    </div>
                                                }
                                            }
                                        }
                                    </div>

                                    <div class="receipt-footer">
                                        <div class="total-row">
                                            <span>TOTAL AMOUNT</span>
                                            <span>@SelectedSale.TotalAmount.ToString("C")</span>
                                        </div>
                                        <div class="ref-id">TXN ID: @SelectedSale.Id.ToString().ToUpper()</div>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    else if (ActiveTab == "TOKENS")
                    {
                        <!-- MIDDLE (EXPANDED): Token Analysis View (Full Width Non-Scrolling) -->
                        <div class="audit-recon-panel bg-white border-end d-flex flex-column h-100 overflow-hidden">
                            <!-- HEADER -->
                            <div class="px-4 py-3 flex-shrink-0 border-bottom bg-light">
                                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                                    <div>
                                        <h4 class="fw-black mb-1 text-primary">TOKEN FINANCIAL & LIABILITY ANALYSIS</h4>
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="badge bg-primary text-white fw-bold" style="font-size: 0.75rem;">
                                                <i class="bi bi-calendar-check me-1"></i>Tracking Start: @(TokenFilterMode == "SINCE_AUG_1" ? TokenTrackingStartDate.ToString("MMM dd, yyyy") : "All-Time Lifetime")
                                            </span>
                                            <span class="text-muted" style="font-size: 0.75rem;">
                                                @(TokenFilterMode == "SINCE_AUG_1" ? "Showing sales & redemptions logged on or after August 1, 2026." : "Showing all-time historical token records.")
                                            </span>
                                        </div>
                                    </div>
                                    <div class="d-flex gap-2 align-items-center">
                                        <div class="btn-group shadow-sm" role="group">
                                            <button class="btn btn-sm @(TokenFilterMode == "FILTERED_DATES" ? "btn-primary fw-bold" : "btn-outline-secondary bg-white")" @onclick='() => SetTokenFilterMode("FILTERED_DATES")'>
                                                <i class="bi bi-calendar-range me-1"></i>FILTERED DATES (@StartDate.ToString("MMM dd") - @EndDate.ToString("MMM dd"))
                                            </button>
                                            <button class="btn btn-sm @(TokenFilterMode == "SINCE_AUG_1" ? "btn-primary fw-bold" : "btn-outline-secondary bg-white")" @onclick='() => SetTokenFilterMode("SINCE_AUG_1")'>
                                                <i class="bi bi-filter-circle me-1"></i>SINCE AUG 1, 2026
                                            </button>
                                            <button class="btn btn-sm @(TokenFilterMode == "LIFETIME" ? "btn-primary fw-bold" : "btn-outline-secondary bg-white")" @onclick='() => SetTokenFilterMode("LIFETIME")'>
                                                <i class="bi bi-clock-history me-1"></i>ALL-TIME (LIFETIME)
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- COMPACT EXECUTIVE SUMMARY BAR (SINGLE HORIZONTAL ROW) -->
                            @{
                                var totalNetImpact = TokenYields.Sum(x => x.NetFinancialImpact);
                            }
                            <div class="px-4 py-3 bg-white border-bottom flex-shrink-0 shadow-sm">
                                <div class="d-flex align-items-center justify-content-between gap-3 flex-wrap">
                                    <div class="d-flex align-items-center gap-4 flex-wrap">
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="text-muted fw-bold small text-uppercase" style="font-size: 0.7rem;">1. CASH COLLECTED:</span>
                                            <span class="fw-black text-success fs-5">@(TokenYields.Sum(x => x.ActualCashCollected).ToString("C"))</span>
                                            <span class="text-muted small">(@(TokenYields.Sum(x => x.Sold)) sold)</span>
                                        </div>
                                        <div class="border-end py-2"></div>
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="text-muted fw-bold small text-uppercase" style="font-size: 0.7rem;">2. MENU VALUE SERVED:</span>
                                            <span class="fw-black text-danger fs-5">@(TokenYields.Sum(x => x.RedemptionValue).ToString("C"))</span>
                                            <span class="text-muted small">(@(TokenYields.Sum(x => x.Redeemed)) redeemed)</span>
                                        </div>
                                        <div class="border-end py-2"></div>
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="text-muted fw-bold small text-uppercase" style="font-size: 0.7rem;">3. LEGACY ABSORBED:</span>
                                            <span class="fw-black text-warning fs-5">@(TokenYields.Sum(x => x.LegacyRedeemed))</span>
                                            @if (TokenYields.Any(x => x.LegacyRedeemed > 0))
                                            {
                                                <span class="text-muted small" style="font-size: 0.75rem;">
                                                    (@string.Join(", ", TokenYields.Where(x => x.LegacyRedeemed > 0).Select(x => $"{x.LegacyRedeemed} {x.Token.Name.Replace(" Token", "").Replace("Token ", "")}")))
                                                </span>
                                            }
                                        </div>
                                        <div class="border-end py-2"></div>
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="text-muted fw-bold small text-uppercase" style="font-size: 0.7rem;">4. IN CIRCULATION:</span>
                                            <span class="fw-black text-primary fs-5">@(TokenYields.Sum(x => x.InCirculation))</span>
                                            @if (TokenYields.Any(x => x.InCirculation > 0))
                                            {
                                                <span class="text-muted small" style="font-size: 0.75rem;">
                                                    (@string.Join(", ", TokenYields.Where(x => x.InCirculation > 0).Select(x => $"{x.InCirculation} {x.Token.Name.Replace(" Token", "").Replace("Token ", "")}")))
                                                </span>
                                            }
                                        </div>
                                    </div>
                                    <div class="badge @(totalNetImpact >= 0 ? "bg-success text-white" : "bg-danger text-white") px-3 py-2 fs-6 rounded-pill shadow-sm">
                                        <i class="bi @(totalNetImpact >= 0 ? "bi-graph-up-arrow" : "bi-graph-down-arrow") me-1"></i>
                                        @(totalNetImpact >= 0 ? "SURPLUS: " + totalNetImpact.ToString("C") : "DEFICIT: " + Math.Abs(totalNetImpact).ToString("C"))
                                    </div>
                                </div>
                            </div>

                            <!-- STACKED FULL-WIDTH SECTIONS (DISTRIBUTED PROPORTIONATELY) -->
                            <div class="flex-grow-1 p-4 overflow-auto custom-scrollbar d-flex flex-column gap-3" style="min-height: 0;">
                                
                                <!-- VISUAL TOKEN FLOW COMPARISON CHART (TRIPLE MODE: BY TOKEN TYPE / BY BARTENDER / BY PRODUCT) -->
                                <div class="card border shadow-sm rounded-4 p-4 bg-white flex-shrink-0">
                                    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                                        <h6 class="fw-black mb-0 text-dark d-flex align-items-center" style="font-size: 0.88rem;">
                                            <i class="bi bi-bar-chart-line text-success me-2 fs-6"></i>
                                            @(_tokenChartViewMode == "TOKEN_TYPE" ? "TOKEN FLOW VISUAL COMPARISON (BY TOKEN TYPE)" : (_tokenChartViewMode == "BARTENDER" ? "BARTENDER TOKEN FLOW (SOLD VS REDEEMED)" : "TOKENS USED PER PRODUCT (UNITS REDEEMED)"))
                                        </h6>
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="text-muted extra-small fw-bold d-none d-md-inline">View Mode:</span>
                                            <div class="btn-group btn-group-sm shadow-xs rounded-pill border p-0.5 bg-light" role="group">
                                                <button class="btn btn-xs rounded-pill fw-black px-3 @(_tokenChartViewMode == "TOKEN_TYPE" ? "btn-primary shadow-sm" : "btn-light border-0 text-muted")" style="font-size: 0.72rem;" @onclick='() => SetTokenChartViewMode("TOKEN_TYPE")'>
                                                    <i class="bi bi-tag-fill me-1"></i>BY TOKEN TYPE
                                                </button>
                                                <button class="btn btn-xs rounded-pill fw-black px-3 @(_tokenChartViewMode == "BARTENDER" ? "btn-primary shadow-sm" : "btn-light border-0 text-muted")" style="font-size: 0.72rem;" @onclick='() => SetTokenChartViewMode("BARTENDER")'>
                                                    <i class="bi bi-person-badge-fill me-1"></i>BY BARTENDER
                                                </button>
                                                <button class="btn btn-xs rounded-pill fw-black px-3 @(_tokenChartViewMode == "DRINK_SPREAD" ? "btn-primary shadow-sm" : "btn-light border-0 text-muted")" style="font-size: 0.72rem;" @onclick='() => SetTokenChartViewMode("DRINK_SPREAD")'>
                                                    <i class="bi bi-cup-straw me-1"></i>BY PRODUCT
                                                </button>
                                            </div>
                                        </div>
                                    </div>

                                    @if (_tokenChartViewMode == "TOKEN_TYPE")
                                    {
                                        <div class="chart-container" style="position: relative; width: 100%; min-height: 280px; height: 280px;">
                                            <canvas id="tokenFlowChart"></canvas>
                                        </div>
                                    }
                                    else if (_tokenChartViewMode == "BARTENDER")
                                    {
                                        <div class="chart-container" style="position: relative; width: 100%; min-height: 280px; height: 280px;">
                                            <canvas id="bartenderTokenChart"></canvas>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="chart-container" style="position: relative; width: 100%; min-height: 280px; height: 280px;">
                                            <canvas id="productTokenFlowChart"></canvas>
                                        </div>
                                    }
                                </div>

                                @if (_tokenChartViewMode == "DRINK_SPREAD")
                                {
                                    <!-- PRODUCT & GENERIC TOKEN FLOW BREAKDOWN TABLE -->
                                    var pMetrics = GetProductTokenFlowMetrics();
                                    <div class="card border shadow-sm rounded-4 flex-shrink-0">
                                        <div class="card-header bg-white py-3 border-0 d-flex justify-content-between align-items-center flex-wrap gap-2">
                                            <div>
                                                <h6 class="fw-black mb-0 text-dark" style="font-size: 0.88rem;">
                                                    <i class="bi bi-box-seam-fill text-primary me-2 fs-6"></i>TOKENS SOLD VS REDEEMED BY ITEM & PRODUCT
                                                </h6>
                                                <span class="text-muted extra-small">Comparing tokens purchased specifically for drinks, generic beer/liquor tokens, and drinks claimed</span>
                                            </div>
                                            <div class="d-flex align-items-center gap-2">
                                                <span class="badge bg-success-subtle text-success border border-success-subtle px-2.5 py-1" style="font-size: 0.72rem;">@pMetrics.Sum(x => x.TokensSoldQty) Tokens Sold</span>
                                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2.5 py-1" style="font-size: 0.72rem;">@pMetrics.Sum(x => x.TokensRedeemedQty) Tokens Redeemed</span>
                                            </div>
                                        </div>
                                        <div class="card-body p-0">
                                            <div class="table-responsive">
                                                <table class="table table-sm table-hover align-middle mb-0" style="font-size: 0.85rem;">
                                                    <thead class="bg-light">
                                                        <tr>
                                                            <th class="ps-4 py-2">PRODUCT / TOKEN ITEM</th>
                                                            <th class="text-center py-2">CLASSIFICATION</th>
                                                            <th class="text-center py-2">TOKENS SOLD</th>
                                                            <th class="text-center py-2">TOKENS REDEEMED</th>
                                                            <th class="pe-4 text-end py-2">NET FLOW</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @if (!pMetrics.Any(x => x.TokensSoldQty > 0 || x.TokensRedeemedQty > 0))
                                                        {
                                                            <tr>
                                                                <td colspan="5" class="text-center py-4 text-muted fw-bold">
                                                                    No token sales or redemptions recorded in selected timeframe.
                                                                </td>
                                                            </tr>
                                                        }
                                                        else
                                                        {
                                                            @foreach (var pm in pMetrics.Where(x => x.TokensSoldQty > 0 || x.TokensRedeemedQty > 0))
                                                            {
                                                                <tr>
                                                                    <td class="ps-4 py-2.5 fw-black text-dark">
                                                                        @if (pm.IsGenericToken)
                                                                        {
                                                                            <span class="badge bg-warning-subtle text-warning border border-warning-subtle me-1.5 px-2 py-1">
                                                                                <i class="bi bi-coin me-1"></i>GENERIC TOKEN
                                                                            </span>
                                                                        }
                                                                        else
                                                                        {
                                                                            <i class="bi bi-cup-straw text-primary me-2"></i>
                                                                        }
                                                                        @pm.ProductName.ToUpper()
                                                                    </td>
                                                                    <td class="text-center py-2.5 text-muted fw-bold">
                                                                        <span class="badge bg-light text-dark border px-2 py-1" style="font-size: 0.72rem;">
                                                                            @pm.TokenCategory
                                                                        </span>
                                                                    </td>
                                                                    <td class="text-center py-2.5 fw-bold text-success">
                                                                        @(pm.TokensSoldQty > 0 ? $"{pm.TokensSoldQty} sold" : "-")
                                                                    </td>
                                                                    <td class="text-center py-2.5 fw-bold text-primary">
                                                                        @(pm.TokensRedeemedQty > 0 ? $"{pm.TokensRedeemedQty} redeemed" : "-")
                                                                    </td>
                                                                    <td class="pe-4 text-end py-2.5">
                                                                        @if (pm.NetBalance > 0)
                                                                        {
                                                                            <span class="badge bg-success-subtle text-success border border-success-subtle fw-black px-2.5 py-1">
                                                                                +@pm.NetBalance (Sold Surplus)
                                                                            </span>
                                                                        }
                                                                        else if (pm.NetBalance < 0)
                                                                        {
                                                                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle fw-black px-2.5 py-1">
                                                                                @Math.Abs(pm.NetBalance) (Net Redeemed)
                                                                            </span>
                                                                        }
                                                                        else
                                                                        {
                                                                            <span class="badge bg-light text-muted border px-2 py-1">0 (Balanced)</span>
                                                                        }
                                                                    </td>
                                                                </tr>
                                                            }
                                                        }
                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>
                                    </div>
                                }

                                @if (_tokenChartViewMode == "BARTENDER")
                                {
                                    <!-- BARTENDER TOKEN ACTIVITY BREAKDOWN TABLE -->
                                    var bMetrics = GetBartenderTokenMetrics();
                                    <div class="card border shadow-sm rounded-4 flex-shrink-0">
                                        <div class="card-header bg-white py-3 border-0 d-flex justify-content-between align-items-center">
                                            <h6 class="fw-black mb-0 text-dark" style="font-size: 0.88rem;">
                                                <i class="bi bi-people-fill text-primary me-2 fs-6"></i>BARTENDER TOKEN ACTIVITY BREAKDOWN
                                            </h6>
                                            <span class="badge bg-light text-muted border px-2 py-1" style="font-size: 0.7rem;">@bMetrics.Count Bartenders Active</span>
                                        </div>
                                        <div class="card-body p-0">
                                            <div class="table-responsive">
                                                <table class="table table-sm table-hover align-middle mb-0" style="font-size: 0.85rem;">
                                                    <thead class="bg-light">
                                                        <tr>
                                                            <th class="ps-4 py-2">BARTENDER</th>
                                                            <th class="text-center py-2">TOKENS SOLD</th>
                                                            <th class="text-center py-2">CASH COLLECTED</th>
                                                            <th class="text-center py-2">TOKENS REDEEMED</th>
                                                            <th class="text-center py-2">MENU VALUE SERVED</th>
                                                            <th class="pe-4 text-end py-2">NET BALANCE</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @if (!bMetrics.Any())
                                                        {
                                                            <tr>
                                                                <td colspan="6" class="text-center py-4 text-muted fw-bold">
                                                                    No bartender token activity recorded in selected timeframe.
                                                                </td>
                                                            </tr>
                                                        }
                                                        else
                                                        {
                                                            @foreach (var bm in bMetrics)
                                                            {
                                                                <tr>
                                                                    <td class="ps-4 py-2.5 fw-black text-dark">
                                                                        <i class="bi bi-person-circle text-primary me-2"></i>@bm.BartenderName.ToUpper()
                                                                    </td>
                                                                    <td class="text-center py-2.5 fw-bold text-success">
                                                                        +@bm.Sold
                                                                    </td>
                                                                    <td class="text-center py-2.5 text-muted fw-bold">
                                                                        @bm.CashCollected.ToString("C")
                                                                    </td>
                                                                    <td class="text-center py-2.5 fw-bold text-danger">
                                                                        -@bm.Redeemed
                                                                    </td>
                                                                    <td class="text-center py-2.5 text-muted fw-bold">
                                                                        @bm.MenuValueRedeemed.ToString("C")
                                                                    </td>
                                                                    <td class="pe-4 text-end py-2.5">
                                                                        <span class="badge @(bm.NetBalance >= 0 ? "bg-success-subtle text-success border-success-subtle" : "bg-danger-subtle text-danger border-danger-subtle") border fw-black px-2.5 py-1">
                                                                            @(bm.NetBalance > 0 ? $"+{bm.NetBalance}" : $"{bm.NetBalance}")
                                                                        </span>
                                                                    </td>
                                                                </tr>
                                                            }
                                                        }
                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>
                                    </div>
                                }

                                <!-- 1. TOKEN SALES BREAKDOWN TABLE (FULL WIDTH) -->
                                <div class="card border shadow-sm rounded-4 flex-shrink-0">
                                    <div class="card-header bg-white py-3 border-0 d-flex justify-content-between align-items-center">
                                        <h6 class="fw-black mb-0 text-dark" style="font-size: 0.88rem;">
                                            <i class="bi bi-cart-check text-primary me-2 fs-6"></i>WHAT WERE TOKENS BOUGHT FOR? (TOKEN SALES)
                                        </h6>
                                        <span class="badge bg-light text-muted border px-2 py-1" style="font-size: 0.7rem;">@(TokenYields.Sum(x => x.Sold)) Sales</span>
                                    </div>
                                    <div class="card-body p-0">
                                        <div class="table-responsive">
                                            <table class="table table-sm table-hover align-middle mb-0" style="font-size: 0.85rem;">
                                                <thead class="bg-light">
                                                    <tr>
                                                        <th class="ps-4 py-2">TOKEN TYPE</th>
                                                        <th class="text-center py-2">STD UNIT PRICE</th>
                                                        <th class="text-center py-2">ACTUAL SOLD PRICE</th>
                                                        <th class="text-center py-2">QTY SOLD</th>
                                                        <th class="pe-4 text-end py-2">TOTAL CASH COLLECTED</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var y in TokenYields)
                                                    {
                                                        var actualAvgPrice = y.Sold > 0 ? (y.ActualCashCollected / y.Sold) : y.Token.SalePrice;
                                                        <tr>
                                                            <td class="ps-4 py-2.5">
                                                                <div class="d-flex align-items-center gap-2">
                                                                    <div style="background: @y.Token.ColorHex; width: 10px; height: 10px; border-radius: 50%;"></div>
                                                                    <span class="fw-bold">@y.Token.Name</span>
                                                                </div>
                                                            </td>
                                                            <td class="text-center text-muted fw-bold">@y.Token.SalePrice.ToString("C")</td>
                                                            <td class="text-center fw-black text-dark">@actualAvgPrice.ToString("C")</td>
                                                            <td class="text-center fw-black text-primary">@y.Sold</td>
                                                            <td class="pe-4 text-end fw-black text-success">@y.ActualCashCollected.ToString("C")</td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>

                                <!-- 2. PHYSICAL TOKEN INVENTORY AUDIT TABLE (FULL WIDTH, SPACIOUS COLUMNS) -->
                                <div class="card border shadow-sm rounded-4 flex-shrink-0">
                                    <div class="card-header bg-white py-3 border-0 d-flex justify-content-between align-items-center flex-wrap gap-1">
                                        <div>
                                            <h6 class="fw-black mb-0 text-dark" style="font-size: 0.88rem;">
                                                <i class="bi bi-box-seam text-warning me-2 fs-6"></i>PHYSICAL TOKEN INVENTORY AUDIT
                                            </h6>
                                            <span class="text-muted small">Compare physical chip counts vs expected stock</span>
                                        </div>
                                        <button class="btn btn-outline-secondary btn-sm rounded-pill fw-bold" style="font-size: 0.72rem;" @onclick='() => _showHistoryModal = true'>
                                            <i class="bi bi-clock-history me-1"></i>TOKEN HISTORY (@TokenAuditLogs.Count)
                                        </button>
                                    </div>
                                    <div class="card-body p-0">
                                        <div class="table-responsive">
                                            <table class="table table-sm table-hover align-middle mb-0" style="font-size: 0.85rem;">
                                                <thead class="bg-light">
                                                    <tr>
                                                        <th class="ps-4 py-2">TOKEN</th>
                                                        <th class="text-center py-2">SOLD</th>
                                                        <th class="text-center py-2">REDEEMED</th>
                                                        <th class="text-center py-2">EXPECTED STOCK</th>
                                                        <th class="text-center py-2">LEGACY COUNT</th>
                                                        <th class="pe-4 text-end py-2">ACTIONS</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var y in TokenYields)
                                                    {
                                                        <tr>
                                                            <td class="ps-4 py-2.5">
                                                                <div class="d-flex align-items-center gap-2">
                                                                    <div style="background: @y.Token.ColorHex; width: 10px; height: 10px; border-radius: 50%;"></div>
                                                                    <span class="fw-black">@y.Token.Name</span>
                                                                </div>
                                                            </td>
                                                            <td class="text-center fw-bold text-primary">@y.Sold</td>
                                                            <td class="text-center fw-bold text-danger">@y.Redeemed</td>
                                                            <td class="text-center fw-black fs-6 text-dark">@y.ExpectedPhysicalStock</td>
                                                            <td class="text-center fw-bold text-warning">
