    private async Task LoadLedgerData(GfcDbContext db)
    {
        var st = StartDate.Date.AddHours(3);
        var en = EndDate.Date.AddDays(1).AddHours(3);

        var query = db.LiquorTransactions
                      .Include(t => t.Item)
                      .Include(t => t.User)
                      .AsNoTracking();

        // Default exclusions: exclude automatic depletions from sales (e.g. notes containing "POS Sale")
        query = query.Where(t => t.Notes == null || !t.Notes.Contains("POS Sale"));

        // Optional Shift Filter
        if (FilterShiftId.HasValue)
        {
            var selectedShift = ZReports.FirstOrDefault(z => z.Id == FilterShiftId.Value) 
                ?? await db.PosZReports.AsNoTracking().FirstOrDefaultAsync(z => z.Id == FilterShiftId.Value);

            if (selectedShift != null)
            {
                var prevZ = await db.PosZReports.AsNoTracking()
                    .Where(r => r.TerminalName == selectedShift.TerminalName && r.Timestamp < selectedShift.Timestamp)
                    .OrderByDescending(r => r.Timestamp)
                    .FirstOrDefaultAsync();

                var shiftStart = prevZ?.Timestamp ?? DateTime.MinValue;
                var shiftEnd = selectedShift.Timestamp;

                query = query.Where(t => t.Timestamp >= shiftStart && t.Timestamp <= shiftEnd);
            }
        }
        else
        {
            query = query.Where(t => t.Timestamp >= st && t.Timestamp < en);
        }

        // Action Type Filter
        if (!string.IsNullOrEmpty(_ledgerActionType) && _ledgerActionType != "ALL")
        {
            if (_ledgerActionType == "PULL")
            {
                query = query.Where(t => t.TransactionType == "Checkout" && t.Notes != null && t.Notes.Contains("POS End-of-Shift Removal"));
            }
            else if (_ledgerActionType == "RESTOCK")
            {
                query = query.Where(t => t.TransactionType == "Restock");
            }
            else if (_ledgerActionType == "CORRECTION")
            {
                query = query.Where(t => t.TransactionType == "Adjustment" || t.TransactionType == "Update" || t.TransactionType == "Reconcile");
            }
        }

        // Product Search Filter
        if (!string.IsNullOrWhiteSpace(_ledgerSearchText))
        {
            query = query.Where(t => t.Item != null && t.Item.Name.Contains(_ledgerSearchText));
        }

        _ledgerTransactions = await query.OrderByDescending(t => t.Timestamp).Take(10000).ToListAsync();
    }

    private bool IsLiquorInventoryItem(LiquorItem item)
    {
        if (item.ParentItemId.HasValue) return false; // Exclude child glass items

        if (item.InventoryTrackType == 3) return false; // Force Food/General
        if (item.InventoryTrackType == 2) return true;  // Force Liquor
        if (item.InventoryTrackType == 1) return false; // Force None
        
        // Inherit Category
        if (string.IsNullOrEmpty(item.Category)) return true;
        var catUpper = item.Category.ToUpper();
        if (catUpper == "BEER" || catUpper == "LIQUOR" || catUpper == "WINE" || catUpper == "SELTZER" || catUpper == "CIDER")
        {
            return true;
        }
        return false;
    }
