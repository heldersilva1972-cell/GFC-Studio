    private string GetZReportPeriod(PosZReport current)
    {
        var detail = GetShiftDetail(current);
        if (detail.FirstSaleTime.HasValue && detail.LastSaleTime.HasValue)
        {
            var startStr = detail.FirstSaleTime.Value.Date == detail.CloseTime.Date 
                ? detail.FirstSaleTime.Value.ToString("h:mm tt") 
                : detail.FirstSaleTime.Value.ToString("ddd, MMM dd h:mm tt");
                
            var endStr = detail.CloseTime.ToString("h:mm tt");
            return $"{startStr} - {endStr}";
        }
        return $"Ended @ {detail.CloseTime.ToString("h:mm tt")}";
    }

    private ShiftDetailInfo GetShiftDetail(PosZReport current)
    {
        DateTime? firstSaleTime = null;
        string firstSaleBartender = "";
        DateTime? lastSaleTime = null;
        string lastSaleBartender = "";

        if (ZReportWindows.TryGetValue(current.Id, out var bounds))
        {
            firstSaleTime = bounds.FirstSale;
            firstSaleBartender = bounds.FirstBartender;
            lastSaleTime = bounds.LastSale;
            lastSaleBartender = bounds.LastBartender;
        }

        var closeTime = current.Timestamp;
        var closedBy = current.BartenderName ?? "Unknown";

        string durationDisplay = "";
        string badgeText = "";
        string badgeClass = "";

        if (firstSaleTime.HasValue && lastSaleTime.HasValue)
        {
            var duration = lastSaleTime.Value - firstSaleTime.Value;
            if (duration.TotalMinutes < 1)
            {
                durationDisplay = "Under 1 min";
            }
            else if (duration.TotalHours < 1)
            {
                durationDisplay = $"{(int)duration.TotalMinutes}m active sales";
            }
            else
            {
                durationDisplay = $"{(int)duration.TotalHours}h {duration.Minutes}m active sales";
            }

            // Flag overnight/extended registers using full time since previous Z-Report
            var terminalReports = ZReports.Where(r => r.TerminalName == current.TerminalName)
                                          .OrderByDescending(r => r.Timestamp)
                                          .ToList();
            int idx = terminalReports.IndexOf(current);
            if (idx != -1 && idx < terminalReports.Count - 1)
            {
                var prev = terminalReports[idx + 1];
                var fullDuration = closeTime - prev.Timestamp;
                
                if (current.TotalGrossSales == 0 && fullDuration.TotalMinutes <= 10)
                {
                    badgeText = "Quick Reset";
                    badgeClass = "bg-secondary text-white";
                }
                else if (prev.Timestamp.Date != closeTime.Date && fullDuration.TotalHours >= 12)
                {
                    badgeText = "Overnight Shift";
                    badgeClass = "bg-warning text-dark";
                }
                else if (fullDuration.TotalHours >= 12)
                {
                    badgeText = "Extended Shift";
                    badgeClass = "bg-danger text-white";
                }
            }
        }
        else
        {
            durationDisplay = "No transactions";
        }

        return new ShiftDetailInfo
        {
            FirstSaleTime = firstSaleTime,
            FirstSaleBartender = firstSaleBartender,
            LastSaleTime = lastSaleTime,
            LastSaleBartender = lastSaleBartender,
            CloseTime = closeTime,
            ClosedBy = closedBy,
            DurationDisplay = durationDisplay,
            BadgeText = badgeText,
            BadgeClass = badgeClass
        };
    }

