    private async Task CalculateTokenAnalysis(GfcDbContext db)
    {
        TokenAuditLogs = await db.TokenAuditLogs.OrderByDescending(l => l.Timestamp).ToListAsync();
        MasterTokens = await db.PosTokens.AsNoTracking().ToListAsync();
        TokenYields.Clear();
        TokenUsages.Clear();
        TokenSalesList.Clear();

        List<PosSale> allSales;
        if (TokenFilterMode == "SINCE_AUG_1")
        {
            allSales = await db.PosSales.AsNoTracking().Where(s => s.Timestamp >= TokenTrackingStartDate).ToListAsync();
        }
        else if (TokenFilterMode == "LIFETIME")
        {
            allSales = await db.PosSales.AsNoTracking().ToListAsync();
        }
        else
        {
            if (_allSalesForStats != null && _allSalesForStats.Any())
            {
                allSales = _allSalesForStats;
            }
            else
            {
                var st = StartDate.Date.AddHours(3);
                var en = EndDate.Date.AddDays(1).AddHours(3);
                var salesQuery = db.PosSales.AsNoTracking()
                    .Where(s => s.Timestamp >= st && s.Timestamp < en)
                    .Where(s => (!s.ActiveEventId.HasValue || s.ActiveEventId.Value <= 0) &&
                                !s.PaymentType.Contains("EVENT SETTLEMENT") &&
                                s.PaymentType != "DEPOSIT");
                if (!string.IsNullOrEmpty(FilterTerminal))
                {
                    salesQuery = salesQuery.Where(s => s.TerminalName == FilterTerminal);
                }
                allSales = await salesQuery.ToListAsync();
            }
        }
        
        bool isLifetime = TokenFilterMode == "LIFETIME";
        var stats = MasterTokens.Where(t => t.Name != null)
                                .GroupBy(t => t.Name)
                                .ToDictionary(g => g.Key, g => new TokenYieldEntry { Token = g.First(), IsLifetimeMode = isLifetime });

        foreach (var sale in allSales)
        {
            var items = GetItemsList(sale.ItemsJson);
            foreach (var item in items)
            {
                // SALE
                bool isTokenSale = !item.IsTokenApplied && 
                                   (item.Category == "TOKENS" || item.Category == "TOKEN" || (item.Name ?? "").ToUpper().Contains("TOKEN SALE")) && 
                                   !(item.Name ?? "").ToUpper().Contains("TOKEN REDEEMED") && 
                                   !(item.Name ?? "").ToUpper().Contains("(CREDITED");

                if (isTokenSale)
                {
                    var match = MasterTokens.OrderByDescending(t => t.Name.Length).FirstOrDefault(t => (item.Name ?? "").ToUpper().Contains(t.Name.ToUpper()));
                    if (match != null && stats.ContainsKey(match.Name)) 
                    {
                        stats[match.Name].Sold += item.Quantity;
                        stats[match.Name].ActualCashCollected += item.Price * item.Quantity;
                    }

                    string rawName = item.Name ?? "";
                    if (rawName.StartsWith("> ")) rawName = rawName.Substring(2).Trim();

                    TokenSalesList.Add(new TokenSaleRecord {
                        ItemName = rawName,
                        TerminalName = sale.TerminalName ?? "POS Station",
                        BartenderName = string.IsNullOrWhiteSpace(sale.BartenderName) ? "Unassigned" : sale.BartenderName.Trim(),
                        Quantity = item.Quantity,
                        UnitPrice = item.Price,
                        Timestamp = sale.Timestamp
                    });
                }

                // REDEMPTION or CREDIT
                bool isRedem = item.IsTokenApplied || 
                               (item.Name ?? "").ToUpper().Contains("TOKEN REDEEMED") || 
                               (item.Name ?? "").ToUpper().Contains("(CREDITED") || 
                               item.Category == "TOKEN_CREDIT" ||
                               (item.Price == 0 && (item.Name ?? "").ToUpper().Contains("TOKEN") && !(item.Name ?? "").ToUpper().Contains("TOKEN SALE"));
                
                if (isRedem)
                {
                    var drinkName = CleanProductName(item.Name);
                    if (item.Category == "TOKEN_CREDIT")
                    {
                        var target = items.FirstOrDefault(i => i.IsTokenApplied && i.Category != "TOKEN_CREDIT" && i.Quantity == item.Quantity);
                        if (target != null) 
                        {
                            string raw = target.Name ?? "";
                            drinkName = CleanProductName(raw);
                        }
                        else
                        {
                            drinkName = "Unknown Item (Credit Applied)";
                        }
                    }

                    var dbItem = DbItems.FirstOrDefault(di => di.Name != null && di.Name.Equals(drinkName, StringComparison.OrdinalIgnoreCase));
                    var menuPrice = dbItem?.Price ?? (item.Category == "TOKEN_CREDIT" ? 0 : 0);
                    
                    if (item.Category == "TOKEN_CREDIT" && drinkName != "Unknown Item (Credit Applied)")
                    {
                        menuPrice = dbItem?.Price ?? 0;
                    }
                    
                    PosToken? match = null;
                    if (item.AppliedTokenId.HasValue && item.AppliedTokenId.Value > 0)
                    {
                        match = MasterTokens.FirstOrDefault(t => t.Id == item.AppliedTokenId.Value);
                    }
                    if (match == null)
                    {
                        var nameUpper = (item.Name ?? "").ToUpper();
                        if (nameUpper.Contains("BEER") || nameUpper.Contains("SELTZER") || nameUpper.Contains("CIDER")) match = MasterTokens.OrderByDescending(t => t.Name.Length).FirstOrDefault(t => t.Name?.ToUpper().Contains("BEER") == true || t.Name?.ToUpper().Contains("SELTZER") == true);
                        else match = MasterTokens.OrderByDescending(t => t.Name.Length).FirstOrDefault(t => t.Name?.ToUpper().Contains("BEER") == false && t.Name?.ToUpper().Contains("SELTZER") == false);
                    }

                    if (match != null && match.Name != null)
                    {
                        if (stats.ContainsKey(match.Name))
                        {
                            bool isTrigger = item.Category == "TOKEN_CREDIT" || 
                                             item.IsTokenApplied || 
                                             (item.Price == 0 && ((item.Name ?? "").ToUpper().Contains("TOKEN") || (item.Name ?? "").Contains("(CREDITED")));
                            
                            if (isTrigger)
                            {
                                stats[match.Name].Redeemed += item.Quantity;
                                
                                decimal valueOfRedemption = item.Category == "TOKEN_CREDIT" ? Math.Abs(item.Price) : (menuPrice > 0 ? menuPrice : match.SalePrice);
                                
                                stats[match.Name].RedemptionValue += valueOfRedemption * item.Quantity;
                                
                                decimal exactTokenPrice = match.SalePrice;
                                if (stats[match.Name].Sold > 0 && stats[match.Name].ActualCashCollected > 0)
                                {
                                    decimal avg = stats[match.Name].ActualCashCollected / stats[match.Name].Sold;
                                    // If token was sold at standard catalog price, use exact catalog price to eliminate floating average decimals
                                    if (Math.Abs(avg - match.SalePrice) <= 0.20m)
                                    {
                                        exactTokenPrice = match.SalePrice;
                                    }
                                    else
                                    {
                                        exactTokenPrice = Math.Round(avg, 2);
                                    }
                                }

                                var usage = new TokenUsageEntry {
                                    DrinkName = drinkName,
                                    TokenName = match.Name,
                                    BartenderName = string.IsNullOrWhiteSpace(sale.BartenderName) ? "Unassigned" : sale.BartenderName.Trim(),
                                    MenuPrice = item.Category == "TOKEN_CREDIT" ? valueOfRedemption : menuPrice,
                                    TokenSalePrice = exactTokenPrice,
                                    IsUpgrade = item.Category == "TOKEN_CREDIT",
                                    Quantity = item.Quantity,
                                    Timestamp = sale.Timestamp
                                };
                                TokenUsages.Add(usage);
                            }
                        }
                    }
                }
            }
        }

        // Query real-time sales since earliest audit/reset timestamp to calculate latest remaining stock & legacy counts regardless of active date filter
        var minAuditCutoff = stats.Values
            .Select(v => {
                var tokenLogs = TokenAuditLogs.Where(l => string.Equals(l.TokenName?.Trim(), v.Token.Name?.Trim(), StringComparison.OrdinalIgnoreCase)).ToList();
                var lastAudit = tokenLogs.LastOrDefault(l => l.Status == "AUDIT_BASELINE_SET" || l.Status == "BALANCED" || l.Status == "LEGACY_INFLOW" || l.Status == "SHRINKAGE")?.Timestamp;
                var lastReset = tokenLogs.LastOrDefault(l => l.Status == "LEGACY_RESET")?.Timestamp;
                if (lastAudit.HasValue && lastReset.HasValue) return (lastAudit.Value < lastReset.Value ? lastAudit : lastReset);
                return lastAudit ?? lastReset;
            })
            .Where(t => t.HasValue)
            .Select(t => t.Value)
            .DefaultIfEmpty(DateTime.Today.AddDays(-30))
            .Min();

        var globalSalesSinceAudit = (TokenFilterMode == "LIFETIME")
            ? allSales
            : await db.PosSales.AsNoTracking().Where(s => s.Timestamp >= minAuditCutoff && !s.IsVoided).ToListAsync();

        var allZReportsSinceAudit = (TokenFilterMode == "LIFETIME")
            ? await db.PosZReports.AsNoTracking().ToListAsync()
            : await db.PosZReports.AsNoTracking().Where(z => z.Timestamp >= minAuditCutoff).ToListAsync();

        foreach (var entry in stats.Values)
        {
            var tokenLogs = TokenAuditLogs.Where(l => string.Equals(l.TokenName?.Trim(), entry.Token.Name?.Trim(), StringComparison.OrdinalIgnoreCase) || (l.TokenName != null && entry.Token.Name != null && (l.TokenName.Contains(entry.Token.Name) || entry.Token.Name.Contains(l.TokenName)))).OrderBy(l => l.Timestamp).ToList();
            
            // Check for latest Audit Baseline Set log
            var lastAuditLog = tokenLogs.LastOrDefault(l => l.Status == "AUDIT_BASELINE_SET" || l.Status == "BALANCED" || l.Status == "LEGACY_INFLOW" || l.Status == "SHRINKAGE");
            if (lastAuditLog != null)
            {
                entry.AuditedBaselineStock = lastAuditLog.ActualCount;
                var cutoffTime = lastAuditLog.Timestamp;

                // Calculate real-time sales, redemptions, and replenishments since audit timestamp
                int soldSince = 0;
                int redeemedSince = 0;
                foreach (var sale in globalSalesSinceAudit.Where(s => s.Timestamp >= cutoffTime))
                {
                    var items = GetItemsList(sale.ItemsJson);
                    foreach (var item in items)
                    {
                        bool isSale = !item.IsTokenApplied && 
                                      (item.Category == "TOKENS" || item.Category == "TOKEN" || (item.Name ?? "").ToUpper().Contains("TOKEN SALE")) && 
                                      !(item.Name ?? "").ToUpper().Contains("TOKEN REDEEMED") && 
                                      !(item.Name ?? "").ToUpper().Contains("(CREDITED");

                        if (isSale)
                        {
                            var match = MasterTokens.OrderByDescending(t => t.Name.Length).FirstOrDefault(t => (item.Name ?? "").ToUpper().Contains(t.Name.ToUpper()));
                            if (match != null && string.Equals(match.Name, entry.Token.Name, StringComparison.OrdinalIgnoreCase))
                            {
                                soldSince += item.Quantity;
                            }
                        }
                        
                        bool isRedeem = item.IsTokenApplied || 
                                        (item.Name ?? "").ToUpper().Contains("TOKEN REDEEMED") || 
                                        (item.Name ?? "").ToUpper().Contains("(CREDITED") || 
                                        item.Category == "TOKEN_CREDIT" || 
                                        (item.Price == 0 && (item.Name ?? "").ToUpper().Contains("TOKEN") && !(item.Name ?? "").ToUpper().Contains("TOKEN SALE"));

                        if (isRedeem)
                        {
                            PosToken? match = null;
                            if (item.AppliedTokenId.HasValue && item.AppliedTokenId.Value > 0) match = MasterTokens.FirstOrDefault(t => t.Id == item.AppliedTokenId.Value);
                            if (match == null)
                            {
                                var nameUpper = (item.Name ?? "").ToUpper();
                                if (nameUpper.Contains("BEER") || nameUpper.Contains("SELTZER") || nameUpper.Contains("CIDER")) match = MasterTokens.OrderByDescending(t => t.Name.Length).FirstOrDefault(t => t.Name?.ToUpper().Contains("BEER") == true || t.Name?.ToUpper().Contains("SELTZER") == true);
                                else match = MasterTokens.OrderByDescending(t => t.Name.Length).FirstOrDefault(t => t.Name?.ToUpper().Contains("BEER") == false && t.Name?.ToUpper().Contains("SELTZER") == false);
                            }
                            if (match != null && string.Equals(match.Name, entry.Token.Name, StringComparison.OrdinalIgnoreCase))
                            {
                                redeemedSince += item.Quantity;
                            }
                        }
                    }
                }

                int replenishedSince = tokenLogs.Where(l => l.Timestamp >= cutoffTime && l.Status == "STOCK_REPLENISHED").Sum(l => l.Variance);

                entry.SalesSinceAudit = soldSince;
                entry.RedemptionsSinceAudit = redeemedSince;
                entry.ReplenishedSinceAudit = replenishedSince;
                entry.LastAuditStatus = $"Baseline {lastAuditLog.ActualCount} ({lastAuditLog.Timestamp:MMM dd, h:mm tt})";
            }
            else
            {
                entry.LastAuditStatus = "Never";
            }

            // Check for latest Legacy Reset log
            var lastLegacyResetLog = tokenLogs.LastOrDefault(l => l.Status == "LEGACY_RESET");
            if (lastLegacyResetLog != null)
            {
                entry.LegacyResetBaseline = lastLegacyResetLog.ActualCount;
                var resetTime = lastLegacyResetLog.Timestamp;

                int soldSinceReset = 0;
                int redeemedSinceReset = 0;

                foreach (var sale in globalSalesSinceAudit.Where(s => s.Timestamp >= resetTime))
                {
                    var items = GetItemsList(sale.ItemsJson);
                    foreach (var item in items)
                    {
                        bool isSale = !item.IsTokenApplied && 
                                      (item.Category == "TOKENS" || item.Category == "TOKEN" || (item.Name ?? "").ToUpper().Contains("TOKEN SALE")) && 
                                      !(item.Name ?? "").ToUpper().Contains("TOKEN REDEEMED") && 
                                      !(item.Name ?? "").ToUpper().Contains("(CREDITED");

                        if (isSale)
                        {
                            var match = MasterTokens.OrderByDescending(t => t.Name.Length).FirstOrDefault(t => (item.Name ?? "").ToUpper().Contains(t.Name.ToUpper()));
                            if (match != null && string.Equals(match.Name, entry.Token.Name, StringComparison.OrdinalIgnoreCase))
                            {
                                soldSinceReset += item.Quantity;
                            }
                        }
                        
                        bool isRedeem = item.IsTokenApplied || 
                                        (item.Name ?? "").ToUpper().Contains("TOKEN REDEEMED") || 
                                        (item.Name ?? "").ToUpper().Contains("(CREDITED") || 
                                        item.Category == "TOKEN_CREDIT" || 
                                        (item.Price == 0 && (item.Name ?? "").ToUpper().Contains("TOKEN") && !(item.Name ?? "").ToUpper().Contains("TOKEN SALE"));

                        if (isRedeem)
                        {
                            PosToken? match = null;
                            if (item.AppliedTokenId.HasValue && item.AppliedTokenId.Value > 0) match = MasterTokens.FirstOrDefault(t => t.Id == item.AppliedTokenId.Value);
                            if (match == null)
                            {
                                var nameUpper = (item.Name ?? "").ToUpper();
                                if (nameUpper.Contains("BEER") || nameUpper.Contains("SELTZER") || nameUpper.Contains("CIDER")) match = MasterTokens.OrderByDescending(t => t.Name.Length).FirstOrDefault(t => t.Name?.ToUpper().Contains("BEER") == true || t.Name?.ToUpper().Contains("SELTZER") == true);
                                else match = MasterTokens.OrderByDescending(t => t.Name.Length).FirstOrDefault(t => t.Name?.ToUpper().Contains("BEER") == false && t.Name?.ToUpper().Contains("SELTZER") == false);
                            }
                            if (match != null && string.Equals(match.Name, entry.Token.Name, StringComparison.OrdinalIgnoreCase))
                            {
                                redeemedSinceReset += item.Quantity;
                            }
                        }
                    }
                }

                entry.SoldSinceReset = soldSinceReset;
                entry.RedeemedSinceReset = redeemedSinceReset;
            }
        }

        TokenYields = stats.Values.Where(y => y.Token.AllowCreditUpgrade != true).ToList();

        BuildTokenShiftLedger(globalSalesSinceAudit, allZReportsSinceAudit, stats);
        BuildCombinedTokenActivity();
    }

    private void BuildTokenShiftLedger(List<PosSale> globalSalesSinceAudit, List<PosZReport> allZReportsSinceAudit, Dictionary<string, TokenYieldEntry> stats)
    {
        TokenShiftLedger.Clear();
        
        // Get latest audit logs for Beer and Mixed Drink
        var beerLogs = TokenAuditLogs.Where(l => (l.TokenName ?? "").ToUpper().Contains("BEER")).OrderBy(l => l.Timestamp).ToList();
        var mixedLogs = TokenAuditLogs.Where(l => (l.TokenName ?? "").ToUpper().Contains("MIXED") || (l.TokenName ?? "").ToUpper().Contains("DRINK")).OrderBy(l => l.Timestamp).ToList();

        var lastBeerAudit = beerLogs.LastOrDefault(l => l.Status == "AUDIT_BASELINE_SET" || l.Status == "BALANCED" || l.Status == "LEGACY_INFLOW" || l.Status == "SHRINKAGE");
        var lastMixedAudit = mixedLogs.LastOrDefault(l => l.Status == "AUDIT_BASELINE_SET" || l.Status == "BALANCED" || l.Status == "LEGACY_INFLOW" || l.Status == "SHRINKAGE");

        DateTime cutoff = DateTime.MinValue;
        if (lastBeerAudit != null && lastMixedAudit != null) cutoff = lastBeerAudit.Timestamp < lastMixedAudit.Timestamp ? lastBeerAudit.Timestamp : lastMixedAudit.Timestamp;
        else if (lastBeerAudit != null) cutoff = lastBeerAudit.Timestamp;
        else if (lastMixedAudit != null) cutoff = lastMixedAudit.Timestamp;

        var timelineEvents = new List<TokenShiftLedgerEntry>();

        // 1. Initial baseline audit event
        if (lastBeerAudit != null || lastMixedAudit != null)
        {
            timelineEvents.Add(new TokenShiftLedgerEntry
            {
                Timestamp = cutoff,
                EventType = "AUDIT_BASELINE_SET",
                ShiftLabel = "Physical Count Baseline",
                ShiftType = "Day",
                BartenderName = "Manager",
                BeerAuditCount = lastBeerAudit?.ActualCount ?? 0,
                MixedAuditCount = lastMixedAudit?.ActualCount ?? 0,
                Notes = $"Baseline Audit Count: {lastBeerAudit?.ActualCount ?? 0} Beer / {lastMixedAudit?.ActualCount ?? 0} Mixed Drink"
            });
        }

        // 2. Subsequent audit logs (replenishments, adjustments)
        var allSubsequentLogs = TokenAuditLogs.Where(l => l.Timestamp > cutoff).OrderBy(l => l.Timestamp).ToList();
        foreach (var l in allSubsequentLogs)
        {
            bool isBeer = (l.TokenName ?? "").ToUpper().Contains("BEER");
            bool isMixed = (l.TokenName ?? "").ToUpper().Contains("MIXED") || (l.TokenName ?? "").ToUpper().Contains("DRINK");

            timelineEvents.Add(new TokenShiftLedgerEntry
            {
                Timestamp = l.Timestamp,
                EventType = l.Status ?? "AUDIT",
                ShiftLabel = l.Status == "STOCK_REPLENISHED" ? "Stock Replenishment" : (l.Status == "LEGACY_RESET" ? "Legacy Reset" : "Audit Adjustment"),
                ShiftType = "Day",
                BartenderName = string.IsNullOrWhiteSpace(l.PerformedBy) ? "Manager" : l.PerformedBy.Trim(),
                BeerReplenished = (isBeer && l.Status == "STOCK_REPLENISHED") ? l.Variance : 0,
                MixedReplenished = (isMixed && l.Status == "STOCK_REPLENISHED") ? l.Variance : 0,
                BeerAuditCount = isBeer ? l.ActualCount : 0,
                MixedAuditCount = isMixed ? l.ActualCount : 0,
                Notes = l.Notes ?? (l.Status == "STOCK_REPLENISHED" ? $"+{l.Variance} {(isBeer ? "Beer" : "Mixed")} chips replenished" : "")
            });
        }

        // 3. Shift activities from official Z-Reports
        var zReportsSince = allZReportsSinceAudit.Where(z => z.Timestamp >= cutoff).OrderBy(z => z.Timestamp).ToList();
        var salesSince = globalSalesSinceAudit.Where(s => s.Timestamp >= cutoff).OrderBy(s => s.Timestamp).ToList();
        var processedSaleIds = new HashSet<Guid>();

        foreach (var z in zReportsSince)
        {
            // Find sales within this Z-Report's window
            var prevZ = allZReportsSinceAudit.Where(prev => prev.TerminalName == z.TerminalName && prev.Timestamp < z.Timestamp)
                                             .OrderByDescending(prev => prev.Timestamp)
                                             .FirstOrDefault();
            var windowStart = prevZ != null ? prevZ.Timestamp : z.Timestamp.Date;

            var zSales = salesSince.Where(s => s.Timestamp > windowStart && s.Timestamp <= z.Timestamp && !processedSaleIds.Contains(s.Id) &&
                                               (string.IsNullOrEmpty(z.TerminalName) || string.IsNullOrEmpty(s.TerminalName) || string.Equals(s.TerminalName, z.TerminalName, StringComparison.OrdinalIgnoreCase)))
                                   .ToList();

            foreach (var s in zSales) processedSaleIds.Add(s.Id);

            if (z.TotalGrossSales == 0) continue; // Skip creating a card for zero-dollar quick resets, but sales are marked processed

            int beerSold = 0, beerRedeemed = 0, mixedSold = 0, mixedRedeemed = 0;
            foreach (var s in zSales)
            {
                var items = GetItemsList(s.ItemsJson);
                foreach (var item in items)
                {
                    bool isSale = !item.IsTokenApplied && 
                                  (item.Category == "TOKENS" || item.Category == "TOKEN" || (item.Name ?? "").ToUpper().Contains("TOKEN SALE")) && 
                                  !(item.Name ?? "").ToUpper().Contains("TOKEN REDEEMED") && 
                                  !(item.Name ?? "").ToUpper().Contains("(CREDITED");

                    if (isSale)
                    {
                        var nameUpper = (item.Name ?? "").ToUpper();
                        if (nameUpper.Contains("BEER") || nameUpper.Contains("SELTZER") || nameUpper.Contains("CIDER")) beerSold += item.Quantity;
                        else mixedSold += item.Quantity;
                    }

                    bool isRedeem = item.IsTokenApplied || 
                                    (item.Name ?? "").ToUpper().Contains("TOKEN REDEEMED") || 
                                    (item.Name ?? "").ToUpper().Contains("(CREDITED") || 
                                    item.Category == "TOKEN_CREDIT" || 
                                    (item.Price == 0 && (item.Name ?? "").ToUpper().Contains("TOKEN") && !(item.Name ?? "").ToUpper().Contains("TOKEN SALE"));

                    if (isRedeem)
                    {
                        var nameUpper = (item.Name ?? "").ToUpper();
                        if (nameUpper.Contains("BEER") || nameUpper.Contains("SELTZER") || nameUpper.Contains("CIDER")) beerRedeemed += item.Quantity;
                        else mixedRedeemed += item.Quantity;
                    }
                }
            }

            int closeHour = z.Timestamp.Hour;
            bool isNight = closeHour >= 18 || closeHour < 4;
            string shiftType = isNight ? "Night" : "Day";
            var bName = string.IsNullOrWhiteSpace(z.BartenderName) ? "Staff" : z.BartenderName;

            timelineEvents.Add(new TokenShiftLedgerEntry
            {
                Timestamp = z.Timestamp,
                EventType = "SHIFT_ACTIVITY",
                ShiftType = shiftType,
                ShiftLabel = $"{z.Timestamp.Date:ddd, MMM dd}",
                BartenderName = bName,
                TerminalName = z.TerminalName ?? "POS Station",
                BeerSold = beerSold,
                BeerRedeemed = beerRedeemed,
                MixedSold = mixedSold,
                MixedRedeemed = mixedRedeemed
            });
        }

        // 4. Open / Active Live Shift (ONLY for sales occurring after the latest Z-Report on each station)
        var terminalLatestZ = allZReportsSinceAudit.GroupBy(z => z.TerminalName ?? "POS Station")
                                                   .ToDictionary(g => g.Key, g => g.Max(z => z.Timestamp));

        var unassignedSales = salesSince.Where(s => !processedSaleIds.Contains(s.Id)).ToList();
        var trueLiveSales = unassignedSales.Where(s => {
            var term = s.TerminalName ?? "POS Station";
            return !terminalLatestZ.TryGetValue(term, out var latestZ) || s.Timestamp > latestZ;
        }).ToList();

        if (trueLiveSales.Any())
        {
            var openGroups = trueLiveSales.GroupBy(s => new { s.Timestamp.Date, s.TerminalName });
            foreach (var grp in openGroups)
            {
                int beerSold = 0, beerRedeemed = 0, mixedSold = 0, mixedRedeemed = 0;
                var lastSale = grp.OrderByDescending(s => s.Timestamp).First();
                var bName = string.IsNullOrWhiteSpace(lastSale.BartenderName) ? "Active Staff" : lastSale.BartenderName;

                foreach (var s in grp)
                {
                    var items = GetItemsList(s.ItemsJson);
                    foreach (var item in items)
                    {
                        bool isSale = !item.IsTokenApplied && 
                                      (item.Category == "TOKENS" || item.Category == "TOKEN" || (item.Name ?? "").ToUpper().Contains("TOKEN SALE")) && 
                                      !(item.Name ?? "").ToUpper().Contains("TOKEN REDEEMED") && 
                                      !(item.Name ?? "").ToUpper().Contains("(CREDITED");

                        if (isSale)
                        {
                            var nameUpper = (item.Name ?? "").ToUpper();
                            if (nameUpper.Contains("BEER") || nameUpper.Contains("SELTZER") || nameUpper.Contains("CIDER")) beerSold += item.Quantity;
                            else mixedSold += item.Quantity;
                        }

                        bool isRedeem = item.IsTokenApplied || 
                                        (item.Name ?? "").ToUpper().Contains("TOKEN REDEEMED") || 
                                        (item.Name ?? "").ToUpper().Contains("(CREDITED") || 
                                        item.Category == "TOKEN_CREDIT" || 
                                        (item.Price == 0 && (item.Name ?? "").ToUpper().Contains("TOKEN") && !(item.Name ?? "").ToUpper().Contains("TOKEN SALE"));

                        if (isRedeem)
                        {
                            var nameUpper = (item.Name ?? "").ToUpper();
                            if (nameUpper.Contains("BEER") || nameUpper.Contains("SELTZER") || nameUpper.Contains("CIDER")) beerRedeemed += item.Quantity;
                            else mixedRedeemed += item.Quantity;
                        }
                    }
                }

                // Do not display empty phantom cards with 0 movement on past dates
                if (beerSold == 0 && beerRedeemed == 0 && mixedSold == 0 && mixedRedeemed == 0 && grp.Key.Date != DateTime.Today) continue;

                bool isNight = lastSale.Timestamp.Hour >= 18 || lastSale.Timestamp.Hour < 4;
                timelineEvents.Add(new TokenShiftLedgerEntry
                {
                    Timestamp = lastSale.Timestamp,
                    EventType = "SHIFT_ACTIVITY",
                    ShiftType = isNight ? "Night" : "Day",
                    ShiftLabel = $"{grp.Key.Date:ddd, MMM dd} (LIVE)",
                    BartenderName = $"{bName} ⚡",
                    TerminalName = grp.Key.TerminalName ?? "POS Station",
                    BeerSold = beerSold,
                    BeerRedeemed = beerRedeemed,
                    MixedSold = mixedSold,
                    MixedRedeemed = mixedRedeemed
                });
            }
        }

        // Sort chronologically to compute running balances
        var chronological = timelineEvents.OrderBy(e => e.Timestamp).ToList();
        int runningBeer = 0;
        int runningMixed = 0;

        foreach (var ev in chronological)
        {
            ev.BeerStartingStock = runningBeer;
            ev.MixedStartingStock = runningMixed;

            if (ev.EventType == "AUDIT_BASELINE_SET" || ev.EventType == "BALANCED" || ev.EventType == "LEGACY_INFLOW" || ev.EventType == "SHRINKAGE")
            {
                if (ev.BeerAuditCount > 0) runningBeer = ev.BeerAuditCount;
                if (ev.MixedAuditCount > 0) runningMixed = ev.MixedAuditCount;
            }
            else if (ev.EventType == "STOCK_REPLENISHED")
            {
                runningBeer += ev.BeerReplenished;
                runningMixed += ev.MixedReplenished;
            }
            else
            {
                runningBeer = Math.Max(0, runningBeer - ev.BeerSold + ev.BeerRedeemed);
                runningMixed = Math.Max(0, runningMixed - ev.MixedSold + ev.MixedRedeemed);
            }

            ev.BeerEndingStock = runningBeer;
            ev.MixedEndingStock = runningMixed;
        }

        TokenShiftLedger = chronological.OrderByDescending(e => e.Timestamp).ToList();
    }

    private void BuildCombinedTokenActivity()
    {
        CombinedTokenActivity.Clear();
        var list = new List<CombinedTokenActivityEntry>();

        foreach (var r in TokenUsages)
        {
            list.Add(new CombinedTokenActivityEntry
            {
                Timestamp = r.Timestamp ?? DateTime.Now,
                ActivityType = "REDEEMED",
                ItemName = r.DrinkName,
                TokenName = r.TokenName,
                BartenderName = r.BartenderName,
                Quantity = r.Quantity,
                PriceOrValue = r.MenuPrice,
                IsUpgrade = r.IsUpgrade,
                ProfitLoss = r.ProfitLossPerUnit
            });
        }

        foreach (var s in TokenSalesList)
        {
            list.Add(new CombinedTokenActivityEntry
            {
                Timestamp = s.Timestamp,
                ActivityType = "SOLD",
                ItemName = s.ItemName,
                TokenName = s.ItemName.ToUpper().Contains("MIXED") ? "Mixed Drink" : "Beer",
                BartenderName = s.BartenderName,
                TerminalName = s.TerminalName,
                Quantity = s.Quantity,
                PriceOrValue = s.UnitPrice,
                ProfitLoss = 0
            });
        }

        CombinedTokenActivity = list.OrderByDescending(x => x.Timestamp).ToList();
    }

    private void OpenAdjustmentModal(PosToken token)
    {
        _currentTokenToAdjust = token;
        _adjustmentValue = token.StartingLiabilityBalance;
        _showAdjustmentModal = true;
    }

    private async Task SaveAdjustment()
    {
        if (_currentTokenToAdjust == null) return;

        using var db = DbFactory.CreateDbContext();
        var token = await db.PosTokens.FindAsync(_currentTokenToAdjust.Id);
        if (token != null)
        {
            int oldVal = token.StartingLiabilityBalance;
            token.StartingLiabilityBalance = _adjustmentValue;

            var log = new TokenAuditLogEntry
            {
                Timestamp = DateTime.Now,
                TokenName = token.Name ?? "Token",
                ExpectedStock = 0,
                ActualCount = 0,
                Variance = _adjustmentValue - oldVal,
                Status = "LIABILITY_ADJUSTED",
                Notes = $"Starting liability balance adjusted from {oldVal} to {_adjustmentValue}.",
                PerformedBy = _currentUser?.Username ?? "Manager"
            };
            db.TokenAuditLogs.Add(log);

            await db.SaveChangesAsync();
            
            await CalculateLifetimeTokens(db);
            await CalculateTokenAnalysis(db);
            _showAdjustmentModal = false;
        }
    }

