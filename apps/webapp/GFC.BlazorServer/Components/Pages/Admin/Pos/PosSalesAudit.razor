    private void UpdateWeeklyBreakdown()
    {
        _weeklyBreakdownItems.Clear();
        _selectedWeekStart = null;
        _selectedWeekEnd = null;
        if (string.IsNullOrEmpty(_selectedTrendWeek)) return;

        var parts = _selectedTrendWeek.Split(' ');
        if (parts.Length < 2) return;
        var datePart = parts[1]; // e.g. "07/06"
        
        if (!DateTime.TryParseExact(datePart, "MM/dd", global::System.Globalization.CultureInfo.InvariantCulture, global::System.Globalization.DateTimeStyles.None, out var tempDate))
            return;
            
        var weekStart = new DateTime(StartDate.Year, tempDate.Month, tempDate.Day);
        var weekEnd = weekStart.AddDays(7);
        
        _selectedWeekStart = weekStart;
        _selectedWeekEnd = weekEnd;

        var pullList = _ledgerTransactions
            .Where(t => t.TransactionType == "Checkout" && t.Notes != null && t.Notes.Contains("POS End-of-Shift Removal"))
            .Where(t => t.Timestamp.ToLocalTime().Date >= weekStart && t.Timestamp.ToLocalTime().Date < weekEnd)
            .ToList();

        _weeklyBreakdownItems = pullList
            .GroupBy(t => t.Item)
            .Where(g => g.Key != null)
            .Select(g => new WeeklyBreakdownItem
            {
                Name = g.Key.Name,
                Size = g.Key.BottleSize ?? "1L",
                Category = g.Key.Category ?? "LIQUOR",
                Quantity = g.Sum(t => (int)Math.Abs(t.ChangeAmount)),
                UnitCost = g.Key.CurrentPrice
            })
            .OrderByDescending(b => b.Quantity)
            .ToList();
    }

    private string GetBrandStatus(BrandRevenueDetail brand, out string bgColor, out string borderColor, out string textColor, out string icon)
    {
        if (brand.PullsCount == 0)
        {
            bgColor = "#ffffff";
            borderColor = "#e2e8f0";
            textColor = "text-muted";
            icon = "bi-dash-circle-fill text-muted";
            return "No Pulls";
        }

        var ratio = brand.ActualPerBottle / brand.ExpectedPerBottle;

        if (ratio < 0.90m) // More than 10% below target
        {
            bgColor = "#fff5f5"; // Red
            borderColor = "#fecaca";
            textColor = "text-danger";
            icon = "bi-exclamation-triangle-fill text-danger";
            return "Yield Deficit (Overpour/Loss)";
        }
        else if (ratio > 1.15m) // More than 15% above target
        {
            bgColor = "#fefcf0"; // Yellow warning
            borderColor = "#fef08a";
            textColor = "text-warning text-dark";
            icon = "bi-exclamation-circle-fill text-warning text-dark";
            return "Unrecorded Pulls (Missing Logs)";
        }
        else
        {
            bgColor = "#f0fdf4"; // Green
            borderColor = "#bbf7d0";
            textColor = "text-success";
            icon = "bi-check-circle-fill text-success";
            return "Healthy";
        }
    }

