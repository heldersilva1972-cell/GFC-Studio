    private List<ProductAuditMetric> GetFilteredAuditReorderMetrics()
    {
        var query = _auditProductMetrics.Where(x => IsItemInSelectedCategory(x));

        if (_reorderUrgentOnly)
        {
            query = query.Where(x => x.GetNetUnitsNeeded(_reorderPredictionMode) > 0);
        }

        if (!string.IsNullOrWhiteSpace(_reorderSearchTerm))
        {
            query = query.Where(x => x.Name.Contains(_reorderSearchTerm, StringComparison.OrdinalIgnoreCase) || x.Category.Contains(_reorderSearchTerm, StringComparison.OrdinalIgnoreCase));
        }

        return query.OrderByDescending(x => x.GetNetUnitsNeeded(_reorderPredictionMode))
                    .ThenByDescending(x => x.Quantity30D)
                    .ToList();
    }

