    private DateTime GetStartOfWeek(DateTime dt)
    {
        int diff = (7 + (dt.DayOfWeek - DayOfWeek.Monday)) % 7;
        return dt.AddDays(-1 * diff).Date;
    }

    private async Task RenderPullsChart()
    {
        if (ActiveTab != "INVENTORY") return;

        using var db = DbFactory.CreateDbContext();
        var st = StartDate.Date;
        var en = EndDate.Date.AddDays(1);

        var query = db.LiquorTransactions.AsNoTracking()
            .Include(t => t.Item)
            .Where(t => t.TransactionType == "Checkout" && t.Item != null && t.Notes != null && t.Notes.Contains("POS End-of-Shift Removal"));

        // Apply Shift Filter
        if (FilterShiftId.HasValue)
        {
            var selectedShift = ZReports.FirstOrDefault(z => z.Id == FilterShiftId.Value) 
                ?? await db.PosZReports.AsNoTracking().FirstOrDefaultAsync(z => z.Id == FilterShiftId.Value);

            if (selectedShift != null)
            {
                var prevZ = await db.PosZReports.AsNoTracking()
                    .Where(r => r.TerminalName == selectedShift.TerminalName && r.Timestamp < selectedShift.Timestamp)
                    .OrderByDescending(r => r.Timestamp)
                    .FirstOrDefaultAsync();

                var shiftStart = prevZ?.Timestamp ?? DateTime.MinValue;
                var shiftEnd = selectedShift.Timestamp;

                query = query.Where(t => t.Timestamp >= shiftStart && t.Timestamp <= shiftEnd);
            }
        }
        else
        {
            query = query.Where(t => t.Timestamp >= st && t.Timestamp < en);
        }

        // Apply Terminal Filter
        if (!string.IsNullOrEmpty(FilterTerminal))
        {
            query = query.Where(t => t.Notes.Contains($"[{FilterTerminal}]"));
        }

        var pullList = await query.ToListAsync();

        // Group pulls by product name string to avoid duplicate key crash
        var productPullsMap = pullList
            .GroupBy(t => t.Item.Name.ToUpper())
            .ToDictionary(g => g.Key, g => g.Sum(t => (int)Math.Abs(t.ChangeAmount)));

        // Sort products by quantity pulled (high to low)
        var sortedProducts = productPullsMap.OrderByDescending(p => p.Value).ToList();
        var productLabels = sortedProducts.Select(p => p.Key).ToArray();
        var productValues = sortedProducts.Select(p => p.Value).ToArray();

        // Populate breakdown items directly
        _weeklyBreakdownItems = pullList
            .GroupBy(t => t.Item)
            .Select(g => new WeeklyBreakdownItem
            {
                Name = g.Key.Name,
                Size = g.Key.BottleSize ?? "1L",
                Category = g.Key.Category ?? "LIQUOR",
                Quantity = g.Sum(t => (int)Math.Abs(t.ChangeAmount)),
                UnitCost = g.Key.CurrentPrice
            })
            .OrderByDescending(b => b.Quantity)
            .ToList();

        var chartConfig = new
        {
            type = "bar",
            data = new
            {
                labels = productLabels,
                datasets = new[]
                {
                    new
                    {
                        label = "Bottles Pulled",
                        data = productValues,
                        backgroundColor = "rgba(109, 40, 217, 0.75)",
                        borderColor = "rgb(109, 40, 217)",
                        borderWidth = 1,
                        borderRadius = 4
                    }
                }
            },
            options = new
            {
                responsive = true,
                maintainAspectRatio = false,
                plugins = new
                {
                    legend = new { display = false }
                },
                scales = new
                {
                    y = new
                    {
                        beginAtZero = true,
                        ticks = new { stepSize = 1, color = "#64748b" }
                    },
                    x = new
                    {
                        ticks = new { color = "#64748b" }
                    }
                }
            }
        };

        try
        {
            await JSRuntime.InvokeVoidAsync("renderChart", "pullTrendsChart", chartConfig, _objRef);
        }
        catch (Exception ex)
        {
            Console.WriteLine("Error rendering pulls chart: " + ex.Message);
        }
    }

    private async Task RenderInsightsCharts()
    {
        if (ActiveTab != "INVENTORY" || _inventorySubTab != "insights") return;

        try
        {
            // 1. Stock vs. Usage Data
            var st = StartDate.Date.AddHours(3);
            var en = EndDate.Date.AddDays(1).AddHours(3);
            
            using var db = DbFactory.CreateDbContext();
            var pullsInPeriodList = await db.LiquorTransactions.AsNoTracking()
                .Include(t => t.Item)
                .Where(t => t.ChangeAmount < 0 && t.Timestamp >= st && t.Timestamp < en && t.Item != null && t.Notes != null)
                .ToListAsync();

            var pullsInPeriod = pullsInPeriodList
                .Where(t => {
                    var cat = t.Item.Category?.ToUpper() ?? "";
                    return ((cat == "BEER" || cat == "SELTZER" || cat == "CIDER") && t.Notes.Contains("POS Sale")) ||
                           ((cat == "LIQUOR" || cat == "WINE") && (t.Notes.Contains("POS End-of-Shift Removal") || t.TransactionType == "Checkout"));
                })
                .GroupBy(t => t.ItemId)
                .ToDictionary(g => g.Key, g => g.Sum(t => (int)Math.Abs(t.ChangeAmount)));

            // Compute POS sales count per item for pre-August and active filter periods
            var posSalesInPeriod = SummaryResults
                .GroupBy(r => CleanProductName(r.Name), StringComparer.OrdinalIgnoreCase)
                .ToDictionary(g => g.Key, g => g.Sum(r => r.Quantity), StringComparer.OrdinalIgnoreCase);

            var topItemsQuery = DbLiquorItems.Where(i => i.IsActive && IsLiquorInventoryItem(i));
            if (_insightsChartFilter == "LIQUOR")
            {
                topItemsQuery = topItemsQuery.Where(i => i.Category != null && i.Category.ToUpper() == "LIQUOR");
            }
            else if (_insightsChartFilter == "BEER")
            {
                topItemsQuery = topItemsQuery.Where(i => i.Category != null && (i.Category.ToUpper() == "BEER" || i.Category.ToUpper() == "CIDER"));
            }
            else if (_insightsChartFilter == "SELTZER")
            {
                topItemsQuery = topItemsQuery.Where(i => i.Category != null && i.Category.ToUpper() == "SELTZER");
            }

            var topItems = topItemsQuery
                .Select(i => {
                    var cleanName = CleanProductName(i.Name);
                    int pullCount = pullsInPeriod.ContainsKey(i.Id) ? pullsInPeriod[i.Id] : 0;
                    int posCount = posSalesInPeriod.ContainsKey(cleanName) ? posSalesInPeriod[cleanName] : 0;
                    int totalUsed = Math.Max(pullCount, posCount);

                    return new {
                        Item = i,
                        Used = totalUsed,
                        Stock = GetEffectiveStock(i)
                    };
                })
                .Where(x => x.Used > 0 || x.Stock > 0)
                .OrderByDescending(x => x.Used)
                .ThenByDescending(x => x.Stock)
                .Take(10)
                .ToList();

            var labels = topItems.Select(x => x.Item.Name.ToUpper()).ToArray();
            var stockData = topItems.Select(x => x.Stock).ToArray();
            var usedData = topItems.Select(x => x.Used).ToArray();

            await JSRuntime.InvokeVoidAsync("inventoryCharts.renderStockVsUsage", "stockVsUsageChart", new {
                labels,
                stockData,
                usedData,
                yAxisTitle = "Bottles Amount"
            });

            // 2. Category Share Data
            var categorySales = SummaryResults
                .GroupBy(r => r.Category)
                .Select(g => new { Category = g.Key.ToUpper(), Revenue = g.Sum(r => r.Revenue) })
                .OrderByDescending(x => x.Revenue)
                .ToList();

            var catLabels = categorySales.Select(x => x.Category).ToArray();
            var catData = categorySales.Select(x => x.Revenue).ToArray();

            await JSRuntime.InvokeVoidAsync("inventoryCharts.renderCategoryShare", "categoryShareChart", new {
                labels = catLabels,
                data = catData
            });

            // 2.5 Top 10 Products Revenue Share Data
            var productSales = SummaryResults
                .Select(r => new { Name = r.Name.ToUpper(), Revenue = r.Revenue })
                .OrderByDescending(x => x.Revenue)
                .Take(10)
                .ToList();

            var prodLabels = productSales.Select(x => x.Name).ToArray();
            var prodData = productSales.Select(x => x.Revenue).ToArray();

            await JSRuntime.InvokeVoidAsync("inventoryCharts.renderCategoryShare", "productShareChart", new {
                labels = prodLabels,
                data = prodData
            });

            // 3. Trend Line Chart (Last 6 months)
            var monthsList = new List<string>();
            var salesTrend = new List<decimal>();
            var costTrend = new List<decimal>();

            for (int i = 5; i >= 0; i--)
            {
                var date = DateTime.Today.AddMonths(-i);
                var monthLabel = date.ToString("MMM yyyy").ToUpper();
                monthsList.Add(monthLabel);

                // Use the loaded monthly analytics or query sales for this specific month range
                using var db2 = DbFactory.CreateDbContext();
                var mStart = new DateTime(date.Year, date.Month, 1);
                var mEnd = mStart.AddMonths(1);

                var mSales = await db2.PosSales.AsNoTracking()
                    .Where(s => s.Timestamp >= mStart && s.Timestamp < mEnd && !s.IsVoided)
                    .SumAsync(s => s.TotalAmount);
                salesTrend.Add(mSales);

                var mPulls = await db2.LiquorTransactions.AsNoTracking()
                    .Include(t => t.Item)
                    .Where(t => t.TransactionType == "Checkout" && t.Timestamp >= mStart && t.Timestamp < mEnd && t.Item != null && t.Notes != null && t.Notes.Contains("POS End-of-Shift Removal"))
                    .ToListAsync();
                var mPullsCost = mPulls.Sum(t => Math.Abs(t.ChangeAmount) * (t.Item.PackSize > 1 ? t.Item.CurrentPrice / t.Item.PackSize : t.Item.CurrentPrice));
                costTrend.Add(mPullsCost);
            }

            await JSRuntime.InvokeVoidAsync("inventoryCharts.renderTrendLine", "insightsTrendChart", new {
                labels = monthsList.ToArray(),
                salesData = salesTrend.ToArray(),
                costData = costTrend.ToArray()
            });
        }
        catch (Exception ex)
        {
            Console.WriteLine("Error rendering insights charts: " + ex.Message);
        }
    }

    private async Task CalculateVisualInsightsStats()
    {
        try
        {
            var st = StartDate.Date.AddHours(3);
            var en = EndDate.Date.AddDays(1).AddHours(3);
            var duration = en - st;
            
            var priorSt = st - duration;
            var priorEn = st;

            // Current period calculations
            InsightsTotalSales = TodayTotal; // TodayTotal contains the filtered sales total
            InsightsTotalTickets = _allSalesForStats.Count;
            InsightsAverageTicket = InsightsTotalTickets > 0 ? InsightsTotalSales / InsightsTotalTickets : 0;

            using var db = DbFactory.CreateDbContext();
            
            var pullsList = await db.LiquorTransactions.AsNoTracking()
                .Include(t => t.Item)
                .Where(t => t.ChangeAmount < 0 && t.Timestamp >= st && t.Timestamp < en && t.Item != null && t.Notes != null &&
                            (t.Notes.Contains("POS Sale") || t.Notes.Contains("POS End-of-Shift Removal") || t.TransactionType == "Checkout"))
                .ToListAsync();

            var filteredPulls = pullsList.Where(t => {
                var cat = t.Item.Category?.ToUpper() ?? "";
                return ((cat == "BEER" || cat == "SELTZER" || cat == "CIDER") && t.Notes.Contains("POS Sale")) ||
                       ((cat == "LIQUOR" || cat == "WINE") && (t.Notes.Contains("POS End-of-Shift Removal") || t.TransactionType == "Checkout"));
            }).ToList();

            InsightsPourCostCost = filteredPulls.Sum(t => Math.Abs(t.ChangeAmount) * (t.Item.PackSize > 1 ? t.Item.CurrentPrice / t.Item.PackSize : t.Item.CurrentPrice));
                
            InsightsPourCostSales = _allSalesForStats.SelectMany(s => GetItemsList(s.ItemsJson))
                .Where(i => i != null && (i.Category == "LIQUOR" || i.Category == "BEER" || i.Category == "WINE" || i.Category == "TOKENS"))
                .Sum(i => i.Price * i.Quantity);

            InsightsTokenYield = TokenYields.Sum(y => y.NetFinancialImpact);
            InsightsStockValue = DbLiquorItems.Where(i => i.IsActive && IsLiquorInventoryItem(i)).Sum(i => GetEffectiveStock(i) * (i.PackSize > 1 ? i.CurrentPrice / i.PackSize : i.CurrentPrice));

            // Prior period calculations
            var priorSales = await db.PosSales.AsNoTracking()
                .Where(s => s.Timestamp >= priorSt && s.Timestamp < priorEn && !s.IsVoided)
                .ToListAsync();
                
            decimal priorSalesVal = priorSales.Sum(s => s.TotalAmount);
            int priorTicketsVal = priorSales.Count;
            decimal priorAvgTicket = priorTicketsVal > 0 ? priorSalesVal / priorTicketsVal : 0;

            var rawPriorPulls = await db.LiquorTransactions.AsNoTracking()
                .Include(t => t.Item)
                .Where(t => t.ChangeAmount < 0 && t.Timestamp >= priorSt && t.Timestamp < priorEn && t.Item != null && t.Notes != null)
                .ToListAsync();

            var priorPulls = rawPriorPulls.Where(t => {
                var cat = t.Item.Category?.ToUpper() ?? "";
                return ((cat == "BEER" || cat == "SELTZER" || cat == "CIDER") && t.Notes.Contains("POS Sale")) ||
                       ((cat == "LIQUOR" || cat == "WINE") && (t.Notes.Contains("POS End-of-Shift Removal") || t.TransactionType == "Checkout"));
            }).ToList();

            decimal priorPullsCost = priorPulls.Sum(t => Math.Abs(t.ChangeAmount) * (t.Item.PackSize > 1 ? t.Item.CurrentPrice / t.Item.PackSize : t.Item.CurrentPrice));

            decimal priorPourCostSales = priorSales.SelectMany(s => GetItemsList(s.ItemsJson))
                .Where(i => i != null && (i.Category == "LIQUOR" || i.Category == "BEER" || i.Category == "WINE" || i.Category == "TOKENS"))
                .Sum(i => i.Price * i.Quantity);
                
            decimal priorPourCostPercent = priorPourCostSales > 0 ? (priorPullsCost / priorPourCostSales) * 100 : 0;

            // Calculate differences
            InsightsSalesDiffPercent = priorSalesVal > 0 ? ((InsightsTotalSales - priorSalesVal) / priorSalesVal) * 100 : 0;
            InsightsTicketDiffPercent = priorTicketsVal > 0 ? ((decimal)(InsightsTotalTickets - priorTicketsVal) / priorTicketsVal) * 100 : 0;
            InsightsAvgTicketDiffPercent = priorAvgTicket > 0 ? ((InsightsAverageTicket - priorAvgTicket) / priorAvgTicket) * 100 : 0;
            InsightsPourCostDiffPercent = InsightsPourCostPercent - priorPourCostPercent;
        }
        catch (Exception ex)
        {
            Console.WriteLine("Error calculating visual insights: " + ex.Message);
        }
    }

