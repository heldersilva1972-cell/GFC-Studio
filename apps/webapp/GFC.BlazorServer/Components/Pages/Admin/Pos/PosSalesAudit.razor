    private async Task RenderStockLevelsChart()
    {
        if (ActiveTab != "INVENTORY" || _inventorySubTab != "stock" || _stockViewMode != "VISUAL") return;

        var st = StartDate.Date.AddHours(3);
        var en = EndDate.Date.AddDays(1).AddHours(3);

        using var db = DbFactory.CreateDbContext();

        // 1. Fetch period transactions for additions and audits
        var periodTx = await db.LiquorTransactions.AsNoTracking()
            .Where(t => t.Timestamp >= st && t.Timestamp < en)
            .ToListAsync();

        var restocksInPeriod = periodTx
            .Where(t => t.TransactionType == "Restock" || (t.Notes != null && t.Notes.Contains("Restock")) || (t.ChangeAmount > 0 && t.TransactionType != "Creation"))
            .GroupBy(t => t.ItemId)
            .ToDictionary(g => g.Key, g => g.Sum(t => Math.Abs(t.ChangeAmount)));

        var auditsInPeriod = periodTx
            .Where(t => t.TransactionType == "Reconcile" || t.TransactionType == "Audit" || (t.Notes != null && (t.Notes.Contains("Reconcile") || t.Notes.Contains("Audit"))))
            .GroupBy(t => t.ItemId)
            .ToDictionary(g => g.Key, g => g.Sum(t => t.ChangeAmount));

        // 2. Fetch last restock and last audit per item across entire history
        var allRestocks = await db.LiquorTransactions.AsNoTracking()
            .Where(t => t.TransactionType == "Restock" || (t.Notes != null && t.Notes.Contains("Restock")) || (t.ChangeAmount > 0 && t.TransactionType != "Creation"))
            .OrderByDescending(t => t.Timestamp)
            .ToListAsync();

        var allAudits = await db.LiquorTransactions.AsNoTracking()
            .Where(t => t.TransactionType == "Reconcile" || t.TransactionType == "Audit" || (t.Notes != null && (t.Notes.Contains("Reconcile") || t.Notes.Contains("Audit"))))
            .OrderByDescending(t => t.Timestamp)
            .ToListAsync();

        var itemLastRestockMap = allRestocks.GroupBy(t => t.ItemId).ToDictionary(g => g.Key, g => g.First().Timestamp.ToString("MM/dd/yy"));
        var itemLastAuditMap = allAudits.GroupBy(t => t.ItemId).ToDictionary(g => g.Key, g => g.First().Timestamp.ToString("MM/dd/yy"));

        // Global activity dates
        if (allRestocks.Any()) _lastInventoryRestockDate = allRestocks.First().Timestamp;
        if (allAudits.Any()) _lastInventoryAuditDate = allAudits.First().Timestamp;

        var stockUsageMap = new Dictionary<int, int>();

        // Build usage entirely from actual POS sales (SummaryResults) for all categories
        foreach (var sale in SummaryResults)
        {
            var item = DbLiquorItems.FirstOrDefault(i => 
                i.Name.Equals(sale.Name, StringComparison.OrdinalIgnoreCase) ||
                CleanProductName(i.Name).Equals(CleanProductName(sale.Name), StringComparison.OrdinalIgnoreCase));
            if (item != null)
            {
                if (stockUsageMap.ContainsKey(item.Id))
                    stockUsageMap[item.Id] += sale.Quantity;
                else
                    stockUsageMap[item.Id] = sale.Quantity;
            }
        }

        _stockPullsInPeriod = stockUsageMap;

        var filteredItems = GetSortedStockItems(stockUsageMap);

        var labels = filteredItems.Select(x => x.Name.ToUpper()).ToArray();
        var stockData = filteredItems.Select(x => (double)GetEffectiveStock(x)).ToArray();
        var rawUsedData = filteredItems.Select(x => stockUsageMap.ContainsKey(x.Id) ? stockUsageMap[x.Id] : 0).ToArray();
        var usedData = filteredItems.Select(x => {
            int soldQty = stockUsageMap.ContainsKey(x.Id) ? stockUsageMap[x.Id] : 0;
            return GetBottleEquivalent(x, soldQty);
        }).ToArray();

        var addedData = _stockChartMode == "COMPARISON"
            ? filteredItems.Select(x => restocksInPeriod.ContainsKey(x.Id) ? (double)restocksInPeriod[x.Id] : 0.0).ToArray()
            : null;
        
        // Calculate Starting Stock (stock at start of period)
        var startingStockData = _stockChartMode == "COMPARISON"
            ? filteredItems.Select((x, idx) => {
                double current = stockData[idx];
                double used = usedData[idx];
                double added = restocksInPeriod.ContainsKey(x.Id) ? (double)restocksInPeriod[x.Id] : 0.0;
                double auditDelta = auditsInPeriod.ContainsKey(x.Id) ? (double)auditsInPeriod[x.Id] : 0.0;
                double starting = current + used - added - auditDelta;
                return Math.Max(0, Math.Round(starting, 2));
            }).ToArray()
            : null;

        var pourSizes = filteredItems.Select(x => $"{GetItemPourSize(x):F2} oz").ToArray();
        var lastRestocked = filteredItems.Select(x => itemLastRestockMap.ContainsKey(x.Id) ? itemLastRestockMap[x.Id] : "-").ToArray();
        var lastAudited = filteredItems.Select(x => itemLastAuditMap.ContainsKey(x.Id) ? itemLastAuditMap[x.Id] : "-").ToArray();

        try
        {
            await JSRuntime.InvokeVoidAsync("inventoryCharts.renderStockLevels", "currentStockLevelsChart", new {
                labels,
                startingStockData,
                stockData,
                addedData,
                usedData,
                rawUsedData,
                pourSizes,
                lastRestocked,
                lastAudited,
                yAxisTitle = "Bottles Amount"
            });
        }
        catch (Exception ex)
        {
            Console.WriteLine("Error rendering stock levels chart: " + ex.Message);
        }
    }

    public class CategoryRemovalMetric
    {
        public string Category { get; set; } = "";
        public decimal WholesaleCost { get; set; }
        public decimal SalesRevenue { get; set; }
        public decimal NetProfit => SalesRevenue - WholesaleCost;
        public decimal MarginPercent => SalesRevenue > 0 ? ((SalesRevenue - WholesaleCost) / SalesRevenue) * 100 : 0;
    }

    private (decimal TotalCost, decimal TotalRevenue, List<CategoryRemovalMetric> ByCategory) GetInventoryRemovalBreakdown()
    {
        var categoryMap = new Dictionary<string, CategoryRemovalMetric>(StringComparer.OrdinalIgnoreCase);
        decimal totalCost = 0m;
        decimal totalRevenue = 0m;

        foreach (var s in SummaryResults)
        {
            if (s == null || s.Quantity <= 0) continue;

            var cleanName = CleanProductName(s.Name);
            var matched = DbLiquorItems.FirstOrDefault(i =>
                (i.Name != null && i.Name.Equals(s.Name, StringComparison.OrdinalIgnoreCase)) ||
                (i.Name != null && CleanProductName(i.Name).Equals(cleanName, StringComparison.OrdinalIgnoreCase)));

            var parentItem = (matched != null && matched.ParentItemId.HasValue && matched.ParentItemId.Value > 0)
                ? (DbLiquorItems.FirstOrDefault(p => p.Id == matched.ParentItemId.Value) ?? matched)
                : matched;

            // Determine Normalized Category
            string normalizedCat = "MISC";
            if (matched != null)
            {
                var catUpper = (matched.Category ?? "").ToUpper();
                if (matched.IsBeer || catUpper == "BEER")
                {
                    normalizedCat = "BEER";
                }
                else if (catUpper == "SELTZER")
                {
                    normalizedCat = "SELTZER";
                }
                else if (catUpper == "CIDER")
                {
                    normalizedCat = "CIDER";
                }
                else if (catUpper == "WINE" || catUpper == "CHAMPAGNE")
                {
                    normalizedCat = "WINE";
                }
                else if (matched.InventoryTrackType == 2 || !matched.IsUnitBased ||
                         catUpper.Contains("LIQUOR") || catUpper.Contains("SPIRIT") || catUpper.Contains("VODKA") ||
                         catUpper.Contains("RUM") || catUpper.Contains("TEQUILA") || catUpper.Contains("WHISKEY") ||
                         catUpper.Contains("GIN") || catUpper.Contains("BOURBON") || catUpper.Contains("SCOTCH") ||
                         catUpper.Contains("CORDIAL") || catUpper.Contains("SHOT") || catUpper.Contains("MIXED"))
                {
                    normalizedCat = "LIQUOR";
                }
                else if (!string.IsNullOrEmpty(matched.Category))
                {
                    normalizedCat = matched.Category.ToUpper();
                }
            }
            else
            {
                var sCatUpper = (s.Category ?? "").ToUpper();
                if (sCatUpper.Contains("BEER")) normalizedCat = "BEER";
                else if (sCatUpper.Contains("SELTZ")) normalizedCat = "SELTZER";
                else if (sCatUpper.Contains("CIDER")) normalizedCat = "CIDER";
                else if (sCatUpper.Contains("WINE")) normalizedCat = "WINE";
                else if (sCatUpper.Contains("LIQUOR") || sCatUpper.Contains("SPIRIT") || sCatUpper.Contains("VODKA") ||
                         sCatUpper.Contains("RUM") || sCatUpper.Contains("TEQUILA") || sCatUpper.Contains("WHISKEY") ||
                         sCatUpper.Contains("GIN") || sCatUpper.Contains("BOURBON") || sCatUpper.Contains("SCOTCH") ||
                         sCatUpper.Contains("SHOT") || sCatUpper.Contains("MIXED") || sCatUpper.Contains("COCKTAIL"))
                {
                    normalizedCat = "LIQUOR";
                }
                else if (!string.IsNullOrEmpty(s.Category))
                {
                    normalizedCat = s.Category.ToUpper();
                }
            }

            if (normalizedCat != "BEER" && normalizedCat != "SELTZER" && normalizedCat != "CIDER" &&
                normalizedCat != "LIQUOR" && normalizedCat != "WINE")
            {
                continue;
            }

            // Calculate Unit Cost
            decimal unitCost = 0m;
            if (matched != null)
            {
                if (matched.IsUnitBased || matched.IsBeer || string.Equals(matched.Category, "BEER", StringComparison.OrdinalIgnoreCase))
                {
                    var costSource = matched.CurrentPrice > 0 ? matched : (parentItem ?? matched);
                    decimal price = costSource.CasePrice.HasValue && costSource.PackSize > 1 && (costSource.CurrentPrice == 0 || costSource.CurrentPrice == costSource.CasePrice.Value)
                        ? costSource.CasePrice.Value
                        : costSource.CurrentPrice;

                    unitCost = costSource.PackSize > 1 ? price / costSource.PackSize : price;
                }
                else
                {
                    // Liquor / Wine / Pour-based items
                    var costSource = (parentItem != null && parentItem.CurrentPrice > 0) ? parentItem : matched;
                    decimal bottlePrice = costSource.CasePrice.HasValue && costSource.PackSize > 1 && (costSource.CurrentPrice == 0 || costSource.CurrentPrice == costSource.CasePrice.Value)
                        ? costSource.CasePrice.Value / costSource.PackSize
                        : costSource.CurrentPrice;

                    decimal bottleOz = costSource.BottleVolumeOunces ?? 0m;
                    if (bottleOz <= 0)
                    {
                        string bSize = (costSource.BottleSize ?? "1L").ToLower();
                        if (bSize.Contains("750")) bottleOz = 25.36m;
                        else if (bSize.Contains("1.75")) bottleOz = 59.17m;
                        else if (bSize.Contains("375")) bottleOz = 12.68m;
                        else if (bSize.Contains("50")) bottleOz = 1.69m;
                        else bottleOz = 33.81m; // default 1L
                    }

                    decimal pourOz = matched.PourVolumeOunces ?? (matched.PourSize > 0 ? matched.PourSize : 0m);
                    if (pourOz <= 0)
                    {
                        pourOz = costSource.PourVolumeOunces ?? (costSource.PourSize > 0 ? costSource.PourSize : 0m);
                    }
                    if (pourOz <= 0)
                    {
                        pourOz = (normalizedCat == "WINE") ? 5.0m : (_settings?.GlobalLiquorPourSize > 0 ? _settings.GlobalLiquorPourSize : 1.5m);
                    }

                    if (bottleOz > 0)
                    {
                        unitCost = (bottlePrice / bottleOz) * pourOz;
                    }
                    else
                    {
                        unitCost = costSource.PackSize > 1 ? bottlePrice / costSource.PackSize : bottlePrice;
                    }
                }
            }

            decimal lineCost = s.Quantity * unitCost;
            decimal lineRevenue = s.Revenue;

            totalCost += lineCost;
            totalRevenue += lineRevenue;

            if (!categoryMap.TryGetValue(normalizedCat, out var metric))
            {
                metric = new CategoryRemovalMetric { Category = normalizedCat };
                categoryMap[normalizedCat] = metric;
            }
            metric.WholesaleCost += lineCost;
            metric.SalesRevenue += lineRevenue;
        }

        return (totalCost, totalRevenue, categoryMap.Values.OrderByDescending(c => c.SalesRevenue).ToList());
    }

    private decimal GetItemPourSize(LiquorItem item)
    {
        var cat = (item.Category ?? "").ToUpper();
        decimal itemPour = item.PourVolumeOunces ?? item.PourSize;
        if (itemPour > 0) return itemPour;
        if (cat == "WINE" || cat == "CHAMPAGNE") return 5.0m;
        return _settings?.GlobalLiquorPourSize > 0 ? _settings.GlobalLiquorPourSize : 1.5m;
    }

    private double GetBottleEquivalent(LiquorItem item, int quantitySold)
    {
        if (quantitySold <= 0) return 0;

        var cat = (item.Category ?? "").ToUpper();
        if (cat == "BEER" || cat == "SELTZER" || cat == "CIDER" || item.IsUnitBased)
        {
            return quantitySold;
        }

        decimal pourSize = GetItemPourSize(item);

        string bSize = item.BottleSize ?? "";
        decimal ounces = 33.8m;
        if (bSize.Contains("750")) ounces = 25.4m;
        else if (bSize.Contains("1.75")) ounces = 59.2m;

        decimal shotsPerBottle = ounces / (pourSize > 0 ? pourSize : 1.5m);
        if (shotsPerBottle <= 0) shotsPerBottle = 22.5m;

        double bottles = (double)(quantitySold / shotsPerBottle);
        return Math.Round(bottles, 2);
    }

    private List<LiquorItem> GetSortedStockItems(Dictionary<int, int> pullsInPeriod)
    {
        var filtered = DbLiquorItems
            .Where(i => i.IsActive && IsLiquorInventoryItem(i) && 
                        (_stockCategoryFilter == "ALL" || (i.Category ?? "").ToUpper() == _stockCategoryFilter) && 
                        (string.IsNullOrEmpty(_stockSearchText) || i.Name.Contains(_stockSearchText, StringComparison.OrdinalIgnoreCase)))
            .ToList();

        if (_stockSortOption == "STOCK_DESC")
        {
            return filtered.OrderByDescending(x => GetEffectiveStock(x)).ThenBy(x => x.Name).ToList();
        }
        else if (_stockSortOption == "STOCK_ASC")
        {
            return filtered.OrderBy(x => GetEffectiveStock(x)).ThenBy(x => x.Name).ToList();
        }
        else if (_stockSortOption == "USAGE_DESC")
        {
            return filtered.OrderByDescending(x => pullsInPeriod.ContainsKey(x.Id) ? pullsInPeriod[x.Id] : 0).ThenBy(x => x.Name).ToList();
        }
        else // NAME_ASC
        {
            return filtered.OrderBy(x => x.Name).ToList();
        }
    }

