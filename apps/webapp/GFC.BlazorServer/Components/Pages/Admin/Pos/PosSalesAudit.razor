@page "/admin/pos-audit"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using GFC.BlazorServer.Data
@using GFC.BlazorServer.Data.Entities
@using global::System.Text.Json
@inject IDbContextFactory<GfcDbContext> DbFactory
@inject NavigationManager Navigation
@inject GFC.BlazorServer.Services.IBlazorSystemSettingsService SystemSettingsService
@attribute [Authorize]

<PageTitle>POS Sales Audit</PageTitle>

<div class="audit-page-wrapper">
    <!-- STICKY TOP SECTION -->
    <div class="sticky-top-section bg-light p-4 pt-4">
        <!-- Header -->
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2 class="fw-black mb-1">POS TRANSACTION AUDIT</h2>
                <p class="text-muted small mb-0">Live feed of all bar station activity</p>
            </div>
            <div class="d-flex gap-2">
                <button class="btn btn-outline-secondary rounded-pill fw-bold bg-white" @onclick="LoadSales">
                    <i class="bi bi-arrow-clockwise me-2"></i>REFRESH
                </button>
                <button class="btn btn-navy rounded-pill fw-bold" @onclick='() => Navigation.NavigateTo("/admin/pos-terminal")'>
                    OPEN POS TERMINAL
                </button>
            </div>
        </div>

        <!-- Summary Cards -->
        <div class="d-flex gap-3 mb-4 overflow-x-auto pb-2">
            <div style="min-width: 200px;">
                <div class="stat-card">
                    <div class="label">TOTAL REVENUE</div>
                    <div class="value">@TodayTotal.ToString("C")</div>
                    <div class="footer text-success fw-bold">Live Combined Feed</div>
                </div>
            </div>
            @foreach (var station in StationTotals)
            {
                <div style="min-width: 160px;">
                    <div class="stat-card station-stat">
                        <div class="label">@station.Key</div>
                        <div class="value">@station.Value.ToString("C")</div>
                        <div class="footer">@(station.Value > 0 ? "Active" : "Closed")</div>
                    </div>
                </div>
            }
            <div style="min-width: 420px; margin-left: auto;">
                <div class="stat-card" style="border-left: 8px solid #3b82f6;">
                    <div class="label">LIFETIME TOKEN TRACKER</div>
                    <div class="d-flex align-items-center gap-4">
                        <div>
                            <div class="fw-black text-muted mb-1" style="font-size: 0.6rem; letter-spacing: 0.5px;">BEER TOKENS</div>
                            <div class="value" style="font-size: 1.1rem !important;">@LifetimeBeerSold <span class="fs-6 text-muted" style="font-size: 0.65rem !important; vertical-align: middle;">SOLD</span> / @LifetimeBeerUsed <span class="fs-6 text-muted" style="font-size: 0.65rem !important; vertical-align: middle;">USED</span></div>
                            <div class="footer fw-bold @(LifetimeBeerSold > LifetimeBeerUsed ? "text-primary" : "text-success")">
                                @(LifetimeBeerSold - LifetimeBeerUsed) In Wild
                            </div>
                        </div>
                        <div style="width: 1.5px; height: 40px; background: #e2e8f0;"></div>
                        <div>
                            <div class="fw-black text-muted mb-1" style="font-size: 0.6rem; letter-spacing: 0.5px;">MIXED DRINKS</div>
                            <div class="value" style="font-size: 1.1rem !important;">@LifetimeMixedSold <span class="fs-6 text-muted" style="font-size: 0.65rem !important; vertical-align: middle;">SOLD</span> / @LifetimeMixedUsed <span class="fs-6 text-muted" style="font-size: 0.65rem !important; vertical-align: middle;">USED</span></div>
                            <div class="footer fw-bold @(LifetimeMixedSold > LifetimeMixedUsed ? "text-primary" : "text-success")">
                                @(LifetimeMixedSold - LifetimeMixedUsed) In Wild
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Filters -->
        <div class="filter-bar p-3 bg-white rounded-4 shadow-sm">
            <div class="row g-3 align-items-center">
                <div class="col-md-3">
                    <label class="small fw-bold text-muted mb-1 d-block">DATE RANGE</label>
                    <div class="d-flex gap-2 align-items-center">
                        <input type="date" class="form-control rounded-pill border-0 bg-light fw-bold" @bind="StartDate" @bind:after="OnDateManualChanged">
                        <span class="text-muted small fw-bold">TO</span>
                        <input type="date" class="form-control rounded-pill border-0 bg-light fw-bold" @bind="EndDate" @bind:after="OnDateManualChanged">
                    </div>
                </div>
                <div class="col-md-5">
                    <label class="small fw-bold text-muted mb-1 d-block">QUICK PRESETS</label>
                    <div class="d-flex gap-2">
                        <button class="btn btn-xs rounded-pill px-3 fw-bold @(ActivePreset == "today" ? "btn-navy" : "btn-light")" @onclick='() => SetPreset("today")'>TODAY</button>
                        <button class="btn btn-xs rounded-pill px-3 fw-bold @(ActivePreset == "yesterday" ? "btn-navy" : "btn-light")" @onclick='() => SetPreset("yesterday")'>YESTERDAY</button>
                        <button class="btn btn-xs rounded-pill px-3 fw-bold @(ActivePreset == "thisweek" ? "btn-navy" : "btn-light")" @onclick='() => SetPreset("thisweek")'>THIS WEEK</button>
                        <button class="btn btn-xs rounded-pill px-3 fw-bold @(ActivePreset == "lastweek" ? "btn-navy" : "btn-light")" @onclick='() => SetPreset("lastweek")'>LAST WEEK</button>
                    </div>
                </div>
                <div class="col-md-2">
                    <label class="small fw-bold text-muted mb-1 d-block">STATION</label>
                    <select class="form-select rounded-pill border-0 bg-light fw-bold" @bind="FilterTerminal" @bind:after="LoadSales">
                        <option value="">ALL</option>
                        @foreach (var terminal in TerminalList)
                        {
                            <option value="@terminal">@terminal</option>
                        }
                    </select>
                </div>
                <div class="col-md-2 text-end pt-3">
                    <button class="btn btn-primary rounded-pill fw-black w-100" @onclick="GenerateSummary">
                        <i class="bi bi-file-earmark-bar-graph me-2"></i>SUMMARY
                    </button>
                </div>
                <div class="col-md-6 pt-3 text-end">
                    <div class="btn-group p-1 bg-light rounded-pill">
                        <button class="btn @(ActiveTab == "SALES" ? "btn-navy shadow-sm" : "btn-link text-muted fw-bold") rounded-pill px-4" @onclick='() => ActiveTab = "SALES"'>SALES FEED</button>
                        <button class="btn @(ActiveTab == "INVENTORY" ? "btn-navy shadow-sm" : "btn-link text-muted fw-bold") rounded-pill px-4" @onclick='() => ActiveTab = "INVENTORY"'>RECONCILIATION AUDIT</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- SCROLLABLE WORKSPACE -->
    <div class="audit-workspace-wrapper px-4 pb-4">
        <div class="audit-workspace shadow-sm rounded-4 overflow-hidden">
            @if (ActiveTab == "SALES")
            {
                <!-- LEFT: Transaction List -->
                <div class="audit-list-panel">
                    <div class="panel-header">
                        <span>RECENT TRANSACTIONS</span>
                        <span class="badge bg-navy text-white rounded-pill">@Sales.Count</span>
                    </div>
                    <div class="scroll-container">
                        @if (Sales == null || !Sales.Any())
                        {
                            <div class="text-center p-5 text-muted">No sales found.</div>
                        }
                        else
                        {
                            @foreach (var sale in Sales)
                            {
                                <div class="sale-item @(SelectedSale?.Id == sale.Id ? "active" : "")" @onclick="() => SelectSale(sale)">
                                    <div class="sale-info">
                                        <div class="time">@sale.Timestamp.ToString("h:mm tt")</div>
                                        <div class="terminal">@sale.TerminalName</div>
                                        <div class="bartender">by @sale.BartenderName</div>
                                    </div>
                                    <div class="sale-amount">@sale.TotalAmount.ToString("C")</div>
                                </div>
                            }
                        }
                    </div>
                </div>

                <!-- RIGHT: Receipt Viewer -->
                <div class="audit-viewer-panel">
                    @if (SelectedSale == null)
                    {
                        <div class="empty-state">
                            <i class="bi bi-arrow-left-circle mb-3"></i>
                            <h5>SELECT A TRANSACTION</h5>
                            <p class="text-muted">Choose a sale from the left to view the receipt details.</p>
                        </div>
                    }
                    else
                    {
                        <div class="receipt-stage animate-fade-in">
                            <div class="receipt-paper shadow-lg">
                                <div class="receipt-header">
                                    <div class="brand">GFC POS</div>
                                    <h6>@SelectedSale.TerminalName</h6>
                                    <div class="timestamp">@SelectedSale.Timestamp.ToString("MMMM dd, yyyy @ h:mm tt")</div>
                                    <div class=" bart">Bartender: @SelectedSale.BartenderName</div>
                                </div>
                                
                                <div class="receipt-body">
                                    <div class="section-title">ITEMS</div>
                                    @foreach (var item in GetItemsList(SelectedSale.ItemsJson))
                                    {
                                        <div class="receipt-item">
                                            <span class="qty">@item.Quantity x</span>
                                            <span class="name">@item.Name</span>
                                            <span class="price">@((item.Price * item.Quantity).ToString("C"))</span>
                                        </div>
                                    }
                                </div>

                                <div class="receipt-footer">
                                    <div class="total-row">
                                        <span>TOTAL AMOUNT</span>
                                        <span>@SelectedSale.TotalAmount.ToString("C")</span>
                                    </div>
                                    <div class="ref-id">TXN ID: @SelectedSale.Id</div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <!-- RECONCILIATION VIEW -->
                <div class="p-5 flex-grow-1 bg-white overflow-y-auto">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h4 class="fw-black mb-0">STATION YIELD ANALYSIS: @(string.IsNullOrEmpty(FilterTerminal) ? "ALL STATIONS" : FilterTerminal.ToUpper())</h4>
                        <div class="badge bg-navy-light text-navy p-2 rounded-pill px-3 fw-bold border">
                            @{
                                decimal pour = _settings?.GlobalLiquorPourSize ?? 1.5m;
                                int shotsPerL = (int)(33.8m / (pour > 0 ? pour : 1.5m));
                            }
                            <i class="bi bi-info-circle me-2"></i>Yield is calculated at @shotsPerL shots (@pour.ToString("F2")oz) per 1L bottle pulled.
                        </div>
                    </div>

                    <table class="table table-hover align-middle border">
                        <thead class="bg-light">
                            <tr>
                                <th class="ps-4">LIQUOR PRODUCT</th>
                                <th class="text-center">DRINKS SOLD (POS)</th>
                                <th class="text-center">BOTTLES PULLED</th>
                                <th class="text-center">EXPECTED YIELD</th>
                                <th class="pe-4 text-end">VARIANCE / LOSS</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!ReconResults.Any())
                            {
                                <tr>
                                    <td colspan="5" class="text-center py-5 text-muted">No inventory pulls recorded for this period.</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var r in ReconResults.OrderBy(x => x.ItemName))
                                {
                                    var variance = r.ExpectedYield - r.DrinksSold;
                                    var yieldPercent = r.ExpectedYield > 0 ? (r.DrinksSold / (decimal)r.ExpectedYield * 100) : 100;
                                    
                                    <tr>
                                        <td class="ps-4 fw-black">@r.ItemName <span class="text-muted small fw-normal ms-2">(@r.BottleSize, @r.PourSize.ToString("F2")oz)</span></td>
                                        <td class="text-center fw-bold">@r.DrinksSold</td>
                                        <td class="text-center fw-bold">@r.BottlesPulled BOTTLES</td>
                                        <td class="text-center text-muted">@r.ExpectedYield SHOTS</td>
                                        <td class="pe-4 text-end">
                                            @if (variance > 2)
                                            {
                                                <span class="text-danger fw-black">-@variance.ToString("F0") SHOTS (@yieldPercent.ToString("F1")%)</span>
                                            }
                                            else
                                            {
                                                <span class="text-success fw-bold">TIGHT (@yieldPercent.ToString("F1")%)</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

<style>
    .audit-page-wrapper { 
        height: 100vh; display: flex; flex-direction: column; overflow: hidden; BACKGROUND: #f8fafc;
    }
    
    .sticky-top-section { flex: 0 0 auto; border-bottom: 1.5px solid #e2e8f0; }

    .audit-workspace-wrapper { flex: 1; overflow: hidden; min-height: 0; }
    .audit-workspace { display: flex; height: 100%; background: white; border: 1.5px solid #e2e8f0; }
    
    /* LEFT PANEL */
    .audit-list-panel { width: 380px; display: flex; flex-direction: column; border-right: 1.5px solid #e2e8f0; background: #f8fafc; }
    .audit-list-panel .panel-header { padding: 1.25rem; background: white; border-bottom: 1.5px solid #e2e8f0; font-weight: 900; font-size: 0.75rem; color: #64748b; display: flex; justify-content: space-between; align-items: center; letter-spacing: 0.5px; }
    
    .scroll-container { flex: 1; overflow-y: auto; }
    .sale-item { 
        padding: 1.25rem; display: flex; justify-content: space-between; align-items: center; 
