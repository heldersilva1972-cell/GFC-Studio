    .sale-item .time { font-weight: 900; font-size: 0.95rem; color: #1e293b; margin-bottom: 2px; }
    .sale-item .terminal { font-size: 0.7rem; font-weight: 800; color: #3730a3; text-transform: uppercase; }
    .sale-item .bartender { font-size: 0.7rem; color: #94a3b8; font-weight: 600; }
    .sale-item .sale-amount { font-weight: 900; font-size: 1.1rem; color: #1e293b; }

    /* RIGHT PANEL */
    .audit-viewer-panel { flex: 1; display: flex; justify-content: center; align-items: flex-start; padding-top: 3rem; background: #f1f5f9; overflow-y: auto; }
    
    .empty-state { text-align: center; color: #94a3b8; margin-top: 5rem; }
    .empty-state i { font-size: 4rem; }
    
    .receipt-stage { padding-bottom: 5rem; width: 100%; display: flex; justify-content: center; }
