    private bool IsFoodItem(ProductItem item)
    {
        if (item == null || string.IsNullOrWhiteSpace(item.Name)) return false;
        if (item.Name.Contains("(TOKEN REDEEMED)", StringComparison.OrdinalIgnoreCase) || 
            item.Name.Contains("TOKEN REDEEMED", StringComparison.OrdinalIgnoreCase) ||
            item.Name.Contains("DEPOSIT", StringComparison.OrdinalIgnoreCase) ||
            item.Name.Contains("CORRECTION", StringComparison.OrdinalIgnoreCase) ||
            item.Name.Contains("NO SALE", StringComparison.OrdinalIgnoreCase) ||
            item.Name.Contains("CREDIT", StringComparison.OrdinalIgnoreCase) ||
            item.Category == "TOKEN_CREDIT")
            return false;

        var cleanName = CleanProductName(item.Name);
        var product = DbLiquorItems.FirstOrDefault(i => i != null && i.Name != null && i.Name.Equals(cleanName, StringComparison.OrdinalIgnoreCase));
        var category = GetFoodItemCategory(item);
        var catUpper = category.ToUpper().Trim();
        var nameLower = item.Name.ToLower().Trim();

        int effectiveGroup = (product != null && product.ZReportGroup > 0) ? product.ZReportGroup : item.ZReportGroup;
        if (effectiveGroup == 0 && !string.IsNullOrEmpty(category))
        {
            var catModel = DbPosCategories.FirstOrDefault(c => c.Name.Equals(category, StringComparison.OrdinalIgnoreCase));
            if (catModel != null && catModel.ZReportGroup > 0)
            {
                effectiveGroup = catModel.ZReportGroup;
            }
        }

        if (effectiveGroup == 1) return true;
        if (effectiveGroup == 2 || effectiveGroup == 3) return false;

        if (product != null && product.InventoryTrackType == 3) return true;
        var cat = DbPosCategories.FirstOrDefault(c => c.Name.Equals(category, StringComparison.OrdinalIgnoreCase));
        if (cat != null && cat.InventoryTrackType == 2) return true;

        return catUpper == "FOOD" || catUpper == "CANDY" || catUpper == "SNACK" || catUpper == "SNACKS" || 
               catUpper == "NON-ALCOHOLIC" || catUpper == "BEVERAGE" || catUpper == "BEVERAGES" || 
               catUpper == "SODA" || catUpper == "WATER" || catUpper == "PIZZA" || catUpper == "KITCHEN" || 
               catUpper == "CHIPS" || catUpper == "FOOD & SNACKS" ||
               nameLower.Contains("soda") || nameLower.Contains("water") || nameLower.Contains("redbull") || 
               nameLower.Contains("red bull") || nameLower.Contains("candy") || nameLower.Contains("chips") || 
               nameLower.Contains("pizza") || nameLower.Contains("snack") || nameLower.Contains("pepsi") || 
               nameLower.Contains("coke") || nameLower.Contains("sprite") || nameLower.Contains("ginger ale");
    }

    private List<FoodItemSummary> GetFoodSummaryResults()
    {
        var salesToProcess = _allSalesForStats ?? new();
        var foodItems = salesToProcess.SelectMany(s => GetItemsList(s.ItemsJson))
                                      .Where(i => i != null && IsFoodItem(i))
                                      .ToList();

        var grouped = foodItems.GroupBy(i => new { 
                                   Name = CleanProductName(i.Name), 
                                   Category = GetFoodItemCategory(i) 
                               })
                               .Select(g => {
                                   var clean = g.Key.Name;
                                   var dbItem = DbLiquorItems.FirstOrDefault(i => i != null && i.Name != null && (i.Name.Equals(clean, StringComparison.OrdinalIgnoreCase) || CleanProductName(i.Name).Equals(clean, StringComparison.OrdinalIgnoreCase)));
                                   var unitPrice = g.Any() && g.Sum(x => x.Quantity) > 0 ? (g.Sum(x => x.Price * x.Quantity) / g.Sum(x => x.Quantity)) : (dbItem?.RetailPrice ?? 0);
                                   return new FoodItemSummary
                                   {
                                       Name = clean,
                                       Category = g.Key.Category,
                                       Description = dbItem?.Description ?? "",
                                       UnitPrice = unitPrice,
                                       Quantity = g.Sum(x => x.Quantity),
                                       Revenue = g.Sum(x => x.Price * x.Quantity)
                                   };
                               })
                               .ToList();

        return grouped;
    }

    private List<string> GetFoodCategories()
    {
        var foodSummary = GetFoodSummaryResults();
        return foodSummary.Select(x => x.Category)
                          .Where(c => !string.IsNullOrEmpty(c))
                          .Distinct(StringComparer.OrdinalIgnoreCase)
                          .OrderBy(c => c)
                          .ToList();
    }

    private List<FoodItemSummary> GetFilteredFoodSummaryList()
    {
        var query = GetFoodSummaryResults().AsEnumerable();

        if (_foodCategoryFilter != "ALL")
        {
            query = query.Where(x => x.Category.Equals(_foodCategoryFilter, StringComparison.OrdinalIgnoreCase));
        }

        if (!string.IsNullOrWhiteSpace(_foodSearchText))
        {
            var search = _foodSearchText.Trim();
            query = query.Where(x => x.Name.Contains(search, StringComparison.OrdinalIgnoreCase) ||
                                     x.Category.Contains(search, StringComparison.OrdinalIgnoreCase) ||
                                     x.Description.Contains(search, StringComparison.OrdinalIgnoreCase));
        }

        switch (_foodSortOption)
        {
            case "QTY_DESC":
                query = query.OrderByDescending(x => x.Quantity).ThenByDescending(x => x.Revenue);
                break;
            case "NAME_ASC":
                query = query.OrderBy(x => x.Name);
                break;
            case "PRICE_DESC":
                query = query.OrderByDescending(x => x.UnitPrice).ThenByDescending(x => x.Revenue);
                break;
            case "REV_DESC":
            default:
                query = query.OrderByDescending(x => x.Revenue).ThenByDescending(x => x.Quantity);
                break;
        }

        return query.ToList();
    }

    private List<FoodTransactionRow> GetFoodTransactionsList()
    {
        var result = new List<FoodTransactionRow>();
        var salesToProcess = _allSalesForStats ?? new();

        foreach (var sale in salesToProcess.OrderByDescending(s => s.Timestamp))
        {
            var items = GetItemsList(sale.ItemsJson);
            if (items == null || !items.Any()) continue;

            var foodItems = items.Where(i => i != null && IsFoodItem(i)).ToList();
            if (!foodItems.Any()) continue;

            if (_foodCategoryFilter != "ALL")
            {
                foodItems = foodItems.Where(i => GetFoodItemCategory(i).Equals(_foodCategoryFilter, StringComparison.OrdinalIgnoreCase)).ToList();
                if (!foodItems.Any()) continue;
            }

            if (!string.IsNullOrWhiteSpace(_foodSearchText))
            {
                var search = _foodSearchText.Trim();
                foodItems = foodItems.Where(i => i.Name.Contains(search, StringComparison.OrdinalIgnoreCase) || 
                                                 (GetFoodItemCategory(i).Contains(search, StringComparison.OrdinalIgnoreCase))).ToList();
                if (!foodItems.Any()) continue;
            }

            var foodTotal = foodItems.Sum(i => i.Price * i.Quantity);
            var foodUnits = foodItems.Sum(i => i.Quantity);

            result.Add(new FoodTransactionRow
            {
                SaleId = sale.Id,
                ReceiptNumber = sale.Id.ToString().Substring(0, 8).ToUpper(),
                Timestamp = sale.Timestamp,
                BartenderName = sale.BartenderName ?? "",
                TerminalName = sale.TerminalName ?? "",
                PaymentMethod = sale.PaymentType ?? "CASH",
                OrderTotal = sale.TotalAmount,
                FoodTotal = foodTotal,
                FoodUnits = foodUnits,
                FoodItems = foodItems
            });
        }

        return result;
    }

