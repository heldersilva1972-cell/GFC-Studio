    private void GenerateSummary()
    {
        var allItems = Sales.SelectMany(s => GetItemsList(s.ItemsJson)).Where(i => i != null).ToList();
        SummaryResults = allItems.GroupBy(i => i.Name ?? "UNKNOWN ITEM")
                                .Select(g => new SummaryResult 
                                { 
                                    Name = g.Key, 
                                    Quantity = g.Sum(i => i.Quantity),
                                    Revenue = g.Sum(i => i.Price * i.Quantity)
                                }).ToList();
        _showSummaryModal = true;
    }

    public class ReconEntry {
        public string ItemName { get; set; } = "";
        public string BottleSize { get; set; } = "1L";
        public decimal PourSize { get; set; } = 1.5m;
        public int DrinksSold { get; set; }
        public int BottlesPulled { get; set; }
        public int ExpectedYield { get; set; }
    }

    public class TokenYieldEntry {
        public PosToken Token { get; set; } = new();
        public int Sold { get; set; }
        public int Redeemed { get; set; }
        public int StartingBalance => Token.StartingLiabilityBalance;
        public int TotalSold => Sold + StartingBalance;
        public int InCirculation => TotalSold - Redeemed;
        public decimal TotalRevenue => TotalSold * Token.SalePrice;
        public decimal RedemptionValue { get; set; } // Menu price of items redeemed
        public decimal NetFinancialImpact => TotalRevenue - RedemptionValue;
    }

    public class TokenUsageEntry {
        public string DrinkName { get; set; } = "";
        public string TokenName { get; set; } = "";
        public int Quantity { get; set; }
        public decimal MenuPrice { get; set; }
        public decimal TokenSalePrice { get; set; }
        public bool IsUpgrade { get; set; }
        public decimal ProfitLossPerUnit => TokenSalePrice - MenuPrice;
        public decimal TotalProfitLoss => ProfitLossPerUnit * Quantity;
    }

