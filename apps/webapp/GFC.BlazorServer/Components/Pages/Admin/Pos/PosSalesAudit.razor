                                                            </td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>

                                <!-- 3. REDEMPTION BREAKDOWN SUMMARY CARD (FULL WIDTH) -->
                                <div class="card border shadow-sm rounded-4 flex-shrink-0">
                                    <div class="card-body p-3 px-4 d-flex align-items-center justify-content-between flex-wrap gap-2">
                                        <div class="d-flex align-items-center gap-4">
                                            <div>
                                                <span class="text-muted fw-bold text-uppercase d-block" style="font-size: 0.6rem;">TOTAL DRINKS CLAIMED:</span>
                                                <span class="fw-black text-danger fs-5">@TokenUsages.Sum(x => x.Quantity)</span>
                                            </div>
                                            <div class="border-end py-2"></div>
                                            <div>
                                                <span class="text-muted fw-bold text-uppercase d-block" style="font-size: 0.6rem;">TOTAL MENU VALUE SERVED:</span>
                                                <span class="fw-black text-dark fs-5">@(TokenUsages.Sum(x => x.MenuPrice * x.Quantity).ToString("C"))</span>
                                            </div>
                                            @{
                                                var topItems = TokenUsages.GroupBy(u => u.DrinkName).OrderByDescending(g => g.Sum(x => x.Quantity)).Take(3).ToList();
                                            }
                                            @if (topItems.Any())
                                            {
                                                <div class="border-end py-2 d-none d-lg-block"></div>
                                                <div class="d-none d-lg-block">
                                                    <span class="text-muted fw-bold text-uppercase d-block mb-1" style="font-size: 0.6rem;">TOP CLAIMED ITEMS:</span>
                                                    <div class="d-flex gap-1.5">
                                                        @foreach (var top in topItems)
                                                        {
                                                            <span class="badge bg-white text-dark border px-2.5 py-1 fw-bold rounded-pill shadow-sm" style="font-size: 0.7rem;">
                                                                <i class="bi bi-star-fill text-warning me-1"></i>@top.Key (@top.Sum(x => x.Quantity))
                                                            </span>
                                                        }
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                        <button class="btn btn-outline-danger rounded-pill px-4 py-2 fw-bold" style="font-size: 0.78rem;" @onclick='() => _showRedemptionListModal = true'>
                                            <i class="bi bi-list-stars me-1"></i>VIEW FULL REDEMPTION BREAKDOWN LIST
                                        </button>
                                    </div>
                                </div>

                            </div>
                        </div>
                    }
                    else if (ActiveTab == "YIELDS")
                    {
                        <!-- MIDDLE (EXPANDED): Reconciliation View -->
                        <div class="audit-recon-panel bg-white border-end">
                            <div class="px-5 pt-4 pb-3 flex-shrink-0">
                                <div class="d-flex justify-content-between align-items-center">
                                    <h4 class="fw-black mb-0 text-primary">BOTTLE YIELD ANALYSIS</h4>
                                    <div class="badge bg-light text-primary p-2 rounded-pill px-3 fw-bold border">
                                        @{
                                            decimal pourSize = _settings?.GlobalLiquorPourSize ?? 1.5m;
                                            int shotsPerLtr = (int)(33.8m / (pourSize > 0 ? pourSize : 1.5m));
                                        }
                                        <i class="bi bi-info-circle me-2"></i>Yield: @shotsPerLtr shots (@pourSize.ToString("F2")oz) / 1L
                                    </div>
                                </div>
                            </div>

                            <div class="flex-grow-1 custom-scrollbar px-5 pb-5" style="overflow-y: auto;">
                                <table class="table table-hover align-middle border mb-0">
                                    <thead class="bg-light sticky-top">
                                        <tr>
                                            <th class="ps-4">LIQUOR PRODUCT</th>
                                            <th class="text-center">DRINKS SOLD</th>
                                            <th class="text-center">BOTTLES REMOVED</th>
                                            <th class="text-center">EXPECTED SHOTS</th>
                                            <th class="pe-4 text-end">VARIANCE</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (!ReconResults.Any())
                                        {
                                            <tr><td colspan="5" class="text-center py-5 text-muted">No inventory pulls recorded.</td></tr>
                                        }
                                        else
                                        {
                                            @foreach (var r in ReconResults.OrderBy(x => x.ItemName))
                                            {
                                                var variance = r.ExpectedYield - r.DrinksSold;
                                                var yieldPercent = r.ExpectedYield > 0 ? (r.DrinksSold / (decimal)r.ExpectedYield * 100) : 100;
                                                <tr>
                                                    <td class="ps-4 fw-black">@r.ItemName</td>
                                                    <td class="text-center fw-bold">@r.DrinksSold</td>
                                                    <td class="text-center fw-bold">@r.BottlesPulled</td>
                                                    <td class="text-center text-muted">@r.ExpectedYield</td>
                                                    <td class="pe-4 text-end">
                                                        @if (variance > 2) { <span class="text-danger fw-black">-@variance.ToString("F0") SHOTS</span> }
                                                        else { <span class="text-success fw-bold">TIGHT</span> }
                                                    </td>
                                                </tr>
                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    }

                    else if (ActiveTab == "ITEMS")
                    {
                        <!-- MIDDLE (EXPANDED): Item Sales Summary View -->
                        <div class="audit-recon-panel bg-white border-end">
