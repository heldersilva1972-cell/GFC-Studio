                                                        </div>
                                                        <hr class="my-2" style="opacity: 0.1;" />
                                                        <div style="max-height: 150px; overflow-y: auto; scrollbar-width: thin;" class="custom-scrollbar ps-1">
                                                            @foreach (var item in DbLiquorItems.Where(i => !i.IsUnitBased && !i.IsBeer && (i.Category ?? "MISC").ToUpper() == cat).OrderBy(i => i.Name))
                                                            {
                                                                <div class="form-check">
                                                                    <input class="form-check-input" type="checkbox" id="item-@item.Id" checked="@_itemOptions.GetValueOrDefault(item.Name, true)" @onchange="@((e) => ToggleItem(item.Name, (bool)(e.Value ?? true)))" />
                                                                    <label class="form-check-label text-muted small" style="font-size: 0.75rem;" for="item-@item.Id">@item.Name</label>
                                                                </div>
                                                            }
                                                        </div>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }

                                @{
                                    var displayedRevenueMonths = _revenueAnalysisMonths.Where(m => m.Date >= new DateTime(2026, 8, 1));
                                    if (SelectedYear > 0)
                                    {
                                        displayedRevenueMonths = displayedRevenueMonths.Where(m => m.Date.Year == SelectedYear);
                                    }
                                    if (SelectedMonth > 0)
                                    {
                                        displayedRevenueMonths = displayedRevenueMonths.Where(m => m.Date.Month == SelectedMonth);
                                    }
                                    var dispList = displayedRevenueMonths.OrderBy(m => m.Date).ToList();
                                    var cumulativeAllBrands = GetCumulativeBrandDetails(dispList);
                                    var filteredBrands = GetFilteredAndSortedBrands(cumulativeAllBrands);
                                    var deficitCount = cumulativeAllBrands.Count(b => (b.ActualRevenue - b.ExpectedRevenue) < 0 || (b.PullsCount > 0 && ((double)b.ShotsSold / (b.PullsCount * (b.ExpectedShotsPerBottle > 0 ? b.ExpectedShotsPerBottle : 22))) < 0.90));
                                    var healthyCount = cumulativeAllBrands.Count(b => {
                                        var target = b.ExpectedShotsPerBottle > 0 ? b.ExpectedShotsPerBottle : 22;
                                        var exp = b.PullsCount * target;
                                        var pct = exp > 0 ? (double)b.ShotsSold / exp : 0;
                                        return pct >= 0.90 && pct <= 1.12;
                                    });
                                    var chronicDeficitCount = cumulativeAllBrands.Count(b => GetBrandTrendInfo(b).IsChronicDeficit);
                                    var repeatSurplusCount = cumulativeAllBrands.Count(b => GetBrandTrendInfo(b).IsRepeatSurplus || (b.PullsCount > 0 && ((double)b.ShotsSold / (b.PullsCount * (b.ExpectedShotsPerBottle > 0 ? b.ExpectedShotsPerBottle : 22))) > 1.12));
                                    var highVolCount = cumulativeAllBrands.Count(b => b.PullsCount >= 5);
                                }

                                <!-- View Mode Switcher Header -->
                                <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-3">
                                    <div>
                                        <h5 class="fw-bold text-dark mb-0">
                                            @if (_revenueViewTab == "CHART")
                                            {
                                                <span><i class="bi bi-bar-chart-fill me-2 text-primary"></i>All Spirits Net Yield Gap Chart</span>
                                            }
                                            else if (_revenueViewTab == "LIST")
                                            {
                                                <span><i class="bi bi-layers-fill me-2 text-primary"></i>All Spirits Master Performance List</span>
                                            }
                                            else
                                            {
                                                <span><i class="bi bi-calendar3 me-2 text-primary"></i>Monthly Calendar Performance Summary</span>
                                            }
                                        </h5>
                                        <span class="text-muted extra-small" style="font-size: 0.75rem;">
                                            @if (_revenueViewTab == "CHART")
                                            {
                                                <span>All @cumulativeAllBrands.Count spirits (healthy surplus & deficits) combined across all active months</span>
                                            }
                                            else if (_revenueViewTab == "LIST")
                                            {
                                                <span>Every bottle brand listed individually with full math, shots breakdown, and monthly history</span>
                                            }
                                            else
                                            {
                                                <span>Actual POS liquor sales vs. target expectations from bottle pulls per calendar month</span>
                                            }
                                        </span>
                                    </div>

                                    <div class="btn-group btn-group-sm rounded-pill p-1 bg-light border shadow-xs">
                                        <button type="button" class="btn btn-sm rounded-pill px-3 fw-bold @(_revenueViewTab == "CHART" ? "btn-primary shadow-xs" : "btn-light text-muted")" @onclick='() => SwitchRevenueViewTab("CHART")'>
                                            <i class="bi bi-bar-chart-line-fill me-1"></i> Visual Chart
                                        </button>
                                        <button type="button" class="btn btn-sm rounded-pill px-3 fw-bold @(_revenueViewTab == "LIST" ? "btn-primary shadow-xs" : "btn-light text-muted")" @onclick='() => SwitchRevenueViewTab("LIST")'>
                                            <i class="bi bi-table me-1"></i> Master Spirits List (@cumulativeAllBrands.Count)
                                        </button>
                                        <button type="button" class="btn btn-sm rounded-pill px-3 fw-bold @(_revenueViewTab == "MONTHLY" ? "btn-primary shadow-xs" : "btn-light text-muted")" @onclick='() => SwitchRevenueViewTab("MONTHLY")'>
                                            <i class="bi bi-calendar3 me-1"></i> Monthly Calendar (@dispList.Count)
                                        </button>
                                    </div>
                                </div>

                                @if (_revenueViewTab == "CHART")
                                {
                                    <!-- Visual Product Variance Chart (Compact Fixed Viewport) -->
                                    <div class="card border rounded-4 p-3 bg-white shadow-xs mb-4">
                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                            <div class="d-flex align-items-center gap-3">
                                                <span class="badge bg-primary text-white rounded-pill px-2.5 py-1 fw-bold" style="font-size: 0.72rem;">
                                                    @cumulativeAllBrands.Count Spirits Audited
                                                </span>
                                                <span class="text-muted extra-small fw-bold d-flex flex-wrap align-items-center gap-2" style="font-size: 0.7rem;">
                                                    <span class="text-success"><i class="bi bi-square-fill me-1"></i>Green: Healthy (90–112%)</span>
                                                    <span class="text-warning"><i class="bi bi-square-fill me-1"></i>Yellow: Watchlist (80–89%)</span>
                                                    <span class="text-danger"><i class="bi bi-square-fill me-1"></i>Red: Deficit (&lt;80%)</span>
                                                    <span style="color: #9333ea;"><i class="bi bi-square-fill me-1"></i>Purple: Unrecorded Pull (&gt;112%)</span>
                                                    <span class="text-primary"><i class="bi bi-dash-lg me-1"></i>Blue Line: 100% Target</span>
                                                </span>
                                            </div>
                                            <span class="text-muted extra-small" style="font-size: 0.68rem;">Hover bars for detailed bottle & shot breakdown</span>
                                        </div>
                                        <div style="position: relative; min-height: 480px; width: 100%;">
                                            <canvas id="chart-product-variance"></canvas>
                                        </div>
                                    </div>
                                }
                                else if (_revenueViewTab == "LIST")
                                {
                                    <!-- Master Spirit Inventory Audit Toolbar & Content -->
                                    <div class="card border rounded-4 p-4 bg-white shadow-xs mb-4">
                                    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4 pb-3 border-bottom">
                                        <div>
                                            <div class="d-flex align-items-center gap-2">
                                                <h5 class="fw-bold text-dark mb-0">
                                                    <i class="bi bi-layers-fill me-2 text-primary"></i>All Spirits Master Performance
                                                </h5>
                                                <span class="badge bg-primary text-white rounded-pill px-2.5 py-1 fw-bold" style="font-size: 0.72rem;">
                                                    @filteredBrands.Count of @cumulativeAllBrands.Count Products
                                                </span>
                                            </div>
                                            <div class="text-muted extra-small mt-1" style="font-size: 0.75rem;">
                                                Every bottle brand listed individually with combined totals across all active months (eliminates monthly rollover noise)
                                            </div>
                                        </div>

                                        <!-- Filter, Sort & View Controls -->
                                        <div class="d-flex flex-wrap align-items-center gap-2">
                                            <!-- Search -->
                                            <div class="input-group input-group-sm" style="width: 200px;">
                                                <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
                                                <input type="text" class="form-control bg-light border-start-0" placeholder="Search spirit..." @bind="_revenueBrandSearch" @bind:event="oninput" />
                                            </div>

                                            <!-- Status & Pattern Filters -->
                                            <div class="btn-group btn-group-sm rounded-pill p-1 bg-light border flex-wrap">
                                                <button type="button" class="btn btn-sm rounded-pill px-2.5 fw-bold @(_revenueStatusFilter == "ALL" ? "btn-primary shadow-xs" : "btn-light text-muted")" @onclick='() => _revenueStatusFilter = "ALL"'>
                                                    All (@cumulativeAllBrands.Count)
                                                </button>
                                                <button type="button" class="btn btn-sm rounded-pill px-2.5 fw-bold @(_revenueStatusFilter == "DEFICIT" ? "btn-danger shadow-xs text-white" : "btn-light text-danger")" @onclick='() => _revenueStatusFilter = "DEFICIT"'>
                                                    🔴 Deficits (@deficitCount)
                                                </button>
                                                @if (chronicDeficitCount > 0)
                                                {
                                                    <button type="button" class="btn btn-sm rounded-pill px-2.5 fw-bold @(_revenueStatusFilter == "CHRONIC_DEFICIT" ? "btn-danger shadow-xs text-white" : "btn-light text-danger")" @onclick='() => _revenueStatusFilter = "CHRONIC_DEFICIT"' title="Spirits with 2+ consecutive months under 85% yield">
                                                        ⚠️ Chronic Deficits (@chronicDeficitCount)
                                                    </button>
                                                }
                                                @if (repeatSurplusCount > 0)
                                                {
                                                    <button type="button" class="btn btn-sm rounded-pill px-2.5 fw-bold @(_revenueStatusFilter == "REPEAT_SURPLUS" ? "text-white shadow-xs" : "btn-light")" 
                                                            style="@(_revenueStatusFilter == "REPEAT_SURPLUS" ? "background-color: #9333ea;" : "color: #9333ea;")" 
                                                            @onclick='() => _revenueStatusFilter = "REPEAT_SURPLUS"' title="Spirits with > 112% yield (suspected missed pull)">
                                                        🟣 Unrecorded Pulls (@repeatSurplusCount)
                                                    </button>
                                                }
                                                <button type="button" class="btn btn-sm rounded-pill px-2.5 fw-bold @(_revenueStatusFilter == "HIGH_VOL" ? "btn-dark shadow-xs text-white" : "btn-light text-dark")" @onclick='() => _revenueStatusFilter = "HIGH_VOL"' title="Spirits with 5+ bottles pulled">
                                                    🏆 High Volume (@highVolCount)
                                                </button>
                                                <button type="button" class="btn btn-sm rounded-pill px-2.5 fw-bold @(_revenueStatusFilter == "HEALTHY" ? "btn-success shadow-xs text-white" : "btn-light text-success")" @onclick='() => _revenueStatusFilter = "HEALTHY"'>
                                                    🟢 Healthy (@healthyCount)
                                                </button>
                                            </div>

                                            <!-- Sort Dropdown -->
                                            <select class="form-select form-select-sm rounded-pill bg-light border fw-bold text-secondary" style="width: auto;" @bind="_revenueBrandSort">
                                                <option value="DEFICIT">Sort: Largest $ Deficit</option>
                                                <option value="PULLS">Sort: Most Bottles Pulled</option>
                                                <option value="YIELD">Sort: Lowest Yield %</option>
                                                <option value="NAME">Sort: Alphabetical (A-Z)</option>
                                            </select>

                                            <!-- View Toggle -->
                                            <div class="btn-group btn-group-sm rounded-pill p-1 bg-light border">
                                                <button type="button" class="btn btn-sm rounded-pill px-2.5 fw-bold @(_revenueViewMode == "TABLE" ? "btn-primary shadow-xs" : "btn-light text-muted")" @onclick='() => _revenueViewMode = "TABLE"' title="Table View">
                                                    <i class="bi bi-table"></i>
                                                </button>
                                                <button type="button" class="btn btn-sm rounded-pill px-2.5 fw-bold @(_revenueViewMode == "CARDS" ? "btn-primary shadow-xs" : "btn-light text-muted")" @onclick='() => _revenueViewMode = "CARDS"' title="Card Grid View">
                                                    <i class="bi bi-grid-fill"></i>
                                                </button>
                                            </div>
                                        </div>
                                    </div>

                                    @if (!filteredBrands.Any())
                                    {
                                        <div class="text-center py-5 text-muted">
                                            <i class="bi bi-search fs-1 d-block mb-2 text-secondary opacity-50"></i>
                                            <h6 class="fw-bold">No spirit products found</h6>
                                            <p class="small mb-0">Try changing your search text or status filter.</p>
                                        </div>
                                    }
                                    else if (_revenueViewMode == "TABLE")
                                    {
                                        <!-- Master Product Table -->
                                        <div class="table-responsive rounded-4 border" style="max-height: 620px; overflow-y: auto; border-radius: 12px; position: relative;">
                                            <table class="table table-hover align-middle mb-0">
                                                <thead class="bg-light sticky-top shadow-xs" style="position: sticky; top: 0; z-index: 10; background-color: #f8fafc;">
                                                    <tr class="text-muted text-uppercase extra-small" style="font-size: 0.72rem;">
                                                        <th class="py-3 ps-3">Spirit Brand</th>
                                                        <th>Specs & Price</th>
                                                        <th class="text-center">Bottles (Total)</th>
                                                        <th class="text-center">Shots Sold</th>
                                                        <th class="text-center">Avg Shots / Btl</th>
                                                        <th class="text-end">Actual Sales</th>
                                                        <th class="text-end text-muted">Target Yield</th>
                                                        <th class="text-end">Net $ Gap</th>
                                                        <th style="min-width: 140px;">Target Met</th>
                                                        <th class="text-center pe-3">Status</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var brand in filteredBrands)
                                                    {
                                                        string bg, border, textCol, icon;
                                                        var statusText = GetBrandStatus(brand, out bg, out border, out textCol, out icon);
                                                        var trendInfo = GetBrandTrendInfo(brand);
                                                        var totalExpectedShots = brand.PullsCount * brand.ExpectedShotsPerBottle;
                                                        var yieldPct = totalExpectedShots > 0 ? (int)Math.Round((double)brand.ShotsSold / totalExpectedShots * 100) : 0;
                                                        var pctBarWidth = Math.Min(100, Math.Max(5, yieldPct));
                                                        var netGap = brand.ActualRevenue - brand.ExpectedRevenue;
                                                        var avgShots = brand.PullsCount > 0 ? (double)brand.ShotsSold / brand.PullsCount : 0;

                                                        <tr class="bg-white" style="cursor: pointer;" @onclick="() => brand.IsExpanded = !brand.IsExpanded">
                                                            <td class="ps-3 py-3">
                                                                <div class="d-flex align-items-center">
                                                                    <i class="bi bi-chevron-@(brand.IsExpanded ? "down" : "right") me-2 text-muted small"></i>
                                                                    <div>
                                                                        <div class="d-flex align-items-center gap-1.5 flex-wrap">
                                                                            <span class="fw-bold text-dark" style="font-size: 0.9rem;">@brand.Name</span>
                                                                            @if (!string.IsNullOrEmpty(trendInfo.VolumeBadgeText))
                                                                            {
                                                                                <span class="@trendInfo.VolumeBadgeClass" style="font-size: 0.6rem; padding: 1px 5px;">@trendInfo.VolumeBadgeText</span>
                                                                            }
                                                                            @if (!string.IsNullOrEmpty(trendInfo.TrendBadgeText))
                                                                            {
                                                                                <span class="@trendInfo.TrendBadgeClass" style="font-size: 0.6rem; padding: 1px 5px; @(trendInfo.TrendStatus == "RISING_SURPLUS" ? "background-color: #9333ea;" : "")">
                                                                                    <i class="bi @trendInfo.TrendIcon me-0.5"></i>@trendInfo.TrendBadgeText
                                                                                </span>
                                                                            }
                                                                        </div>
                                                                        <div class="extra-small text-muted d-flex align-items-center gap-2 mt-0.5" style="font-size: 0.68rem;">
                                                                            @if (!string.IsNullOrEmpty(trendInfo.TrajectoryText))
                                                                            {
                                                                                <span><strong>Trajectory:</strong> @trendInfo.TrajectoryText</span>
                                                                            }
                                                                            else
                                                                            {
                                                                                <span>Click to view monthly history</span>
                                                                            }
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            </td>
                                                            <td>
                                                                <div class="extra-small" style="font-size: 0.72rem;">
                                                                    <span class="badge bg-light text-dark border px-2 py-0.5">@brand.BottleSize</span>
                                                                    <span class="text-muted ms-1">@brand.PourSize.ToString("F2") oz pour</span>
                                                                    <div class="text-muted mt-0.5">@brand.RetailPrice.ToString("C") / shot</div>
                                                                </div>
                                                            </td>
                                                            <td class="text-center">
                                                                <span class="badge bg-dark text-white rounded-pill px-2.5 py-1">@brand.PullsCount</span>
                                                            </td>
                                                            <td class="text-center fw-bold text-dark">
                                                                @brand.ShotsSold
                                                            </td>
                                                            <td class="text-center">
                                                                <span class="fw-black @(avgShots >= brand.ExpectedShotsPerBottle ? "text-success" : "text-danger")">
                                                                    @avgShots.ToString("F1")
                                                                </span>
                                                                <span class="text-muted extra-small">/ @brand.ExpectedShotsPerBottle</span>
                                                            </td>
                                                            <td class="text-end fw-black text-dark">
                                                                @brand.ActualRevenue.ToString("C0")
                                                            </td>
                                                            <td class="text-end text-muted small">
                                                                @brand.ExpectedRevenue.ToString("C0")
                                                            </td>
                                                            <td class="text-end fw-black @(netGap >= 0 ? "text-success" : "text-danger")">
                                                                @(netGap >= 0 ? "+" : "")@netGap.ToString("C0")
                                                            </td>
                                                            <td>
                                                                <div class="d-flex justify-content-between align-items-center mb-1">
                                                                    <span class="fw-black @(yieldPct >= 90 && yieldPct <= 115 ? "text-success" : yieldPct > 115 ? "text-warning text-dark" : "text-danger")" style="font-size: 0.75rem;">
                                                                        @yieldPct%
                                                                    </span>
                                                                </div>
                                                                <div class="progress" style="height: 6px; background-color: #e2e8f0; border-radius: 6px;">
                                                                    <div class="progress-bar @(yieldPct >= 90 && yieldPct <= 115 ? "bg-success" : yieldPct > 115 ? "bg-warning" : "bg-danger")" 
                                                                         role="progressbar" 
                                                                         style="width: @pctBarWidth%; border-radius: 6px;">
                                                                    </div>
                                                                </div>
                                                            </td>
                                                            <td class="text-center pe-3">
                                                                <div class="d-flex flex-column align-items-center gap-1">
                                                                    <span class="badge @(statusText == "Healthy" ? "bg-success text-white" : statusText.Contains("Unrecorded") ? "text-white" : "bg-danger text-white")" 
                                                                          style="font-size: 0.65rem; padding: 4px 8px; @(statusText.Contains("Unrecorded") ? "background-color: #9333ea !important;" : "")">
                                                                        <i class="bi @icon me-1"></i>@statusText.ToUpper()
                                                                    </span>
                                                                    <button type="button" class="btn btn-xs rounded-pill py-0.5 px-2 fw-bold @(yieldPct > 112 ? "text-white shadow-xs" : "btn-light border text-muted")" 
                                                                            style="font-size: 0.62rem; @(yieldPct > 112 ? "background-color: #9333ea; border-color: #7e22ce;" : "")" 
                                                                            @onclick:stopPropagation="true"
                                                                            @onclick="() => OpenMissedPullModal(brand)"
                                                                            title="Record a missed bottle pull for this spirit">
                                                                        <i class="bi bi-plus-circle me-1"></i>Missed Pull
                                                                    </button>
                                                                </div>
                                                            </td>
                                                        </tr>

                                                        @if (brand.IsExpanded)
                                                        {
                                                            <tr class="bg-light bg-opacity-50">
                                                                <td colspan="10" class="p-3">
                                                                    <div class="rounded-3 bg-white p-3 border shadow-xs">
                                                                        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2 mb-3 pb-2 border-bottom">
                                                                            <div>
                                                                                <span class="fw-bold text-dark small text-uppercase">
                                                                                    <i class="bi bi-calendar-range me-1 text-primary"></i> Monthly History for @brand.Name
                                                                                </span>
                                                                                <span class="text-muted extra-small ms-2">Performance broken down across each active month</span>
                                                                            </div>
                                                                            <div class="extra-small font-monospace text-muted bg-light px-2.5 py-1 rounded border">
                                                                                Target Math: @brand.ExpectedShotsPerBottle shots × @brand.RetailPrice.ToString("C") = <strong>@brand.ExpectedPerBottle.ToString("C")</strong> / btl
                                                                            </div>
                                                                        </div>

                                                                        @if (brand.MonthlyBreakdown.Any())
                                                                        {
                                                                            <div class="table-responsive">
                                                                                <table class="table table-sm table-bordered align-middle mb-0 extra-small" style="font-size: 0.75rem;">
                                                                                    <thead class="bg-light text-muted">
                                                                                        <tr>
                                                                                            <th class="ps-2">Month</th>
                                                                                            <th class="text-center">Bottles Pulled</th>
                                                                                            <th class="text-center">Shots Sold</th>
                                                                                            <th class="text-center">Shots / Bottle</th>
                                                                                            <th class="text-end">Actual Revenue</th>
                                                                                            <th class="text-end">Target Yield</th>
                                                                                            <th class="text-end">Net Gap</th>
                                                                                            <th class="text-center">Status</th>
                                                                                        </tr>
                                                                                    </thead>
                                                                                    <tbody>
                                                                                        @foreach (var mBreakdown in brand.MonthlyBreakdown)
                                                                                        {
                                                                                            var mExpectedShots = mBreakdown.PullsCount * brand.ExpectedShotsPerBottle;
                                                                                            var mYieldPct = mExpectedShots > 0 ? (int)Math.Round((double)mBreakdown.ShotsSold / mExpectedShots * 100) : 0;
                                                                                            var mNetGap = mBreakdown.ActualRevenue - mBreakdown.ExpectedRevenue;
                                                                                            var mAvgShots = mBreakdown.PullsCount > 0 ? (double)mBreakdown.ShotsSold / mBreakdown.PullsCount : 0;
                                                                                            var mTargetShots = brand.ExpectedShotsPerBottle > 0 ? brand.ExpectedShotsPerBottle : 22;
                                                                                            var mExtraShots = mBreakdown.ShotsSold - mExpectedShots;
                                                                                            var mEstMissing = Math.Max(1, (int)Math.Ceiling((double)mExtraShots / mTargetShots));
                                                                                            var mMissingText = mEstMissing == 1 ? "1 btl missing" : $"{mEstMissing} btls missing";

                                                                                            <tr>
                                                                                                <td class="ps-2 fw-bold text-dark">@mBreakdown.Month.ToString("MMMM yyyy")</td>
                                                                                                <td class="text-center">
                                                                                                    <span class="badge bg-secondary text-white">@mBreakdown.PullsCount</span>
                                                                                                </td>
                                                                                                <td class="text-center">@mBreakdown.ShotsSold</td>
                                                                                                <td class="text-center fw-bold @(mAvgShots >= brand.ExpectedShotsPerBottle ? "text-success" : "text-danger")">
                                                                                                    @mAvgShots.ToString("F1") / @brand.ExpectedShotsPerBottle
                                                                                                </td>
                                                                                                <td class="text-end fw-bold text-dark">@mBreakdown.ActualRevenue.ToString("C0")</td>
                                                                                                <td class="text-end text-muted">@mBreakdown.ExpectedRevenue.ToString("C0")</td>
                                                                                                <td class="text-end fw-bold @(mNetGap >= 0 ? "text-success" : "text-danger")">
                                                                                                    @(mNetGap >= 0 ? "+" : "")@mNetGap.ToString("C0")
                                                                                                </td>
                                                                                                <td class="text-center">
                                                                                                    <div class="d-flex align-items-center justify-content-center gap-1">
                                                                                                        <span class="badge @(mYieldPct >= 90 && mYieldPct <= 112 ? "bg-success text-white" : mYieldPct > 112 ? "text-white" : "bg-danger text-white")" 
                                                                                                              style="font-size: 0.6rem; @(mYieldPct > 112 ? "background-color: #9333ea;" : "")">
                                                                                                            @mYieldPct% Yield@(mYieldPct > 112 ? $" (~{mMissingText})" : "")
                                                                                                        </span>
                                                                                                        <button type="button" class="btn btn-xs rounded-pill py-0 px-1.5 fw-bold @(mYieldPct > 112 ? "text-white" : "btn-light border text-muted")" 
                                                                                                                style="font-size: 0.58rem; @(mYieldPct > 112 ? "background-color: #9333ea; border-color: #7e22ce;" : "")" 
                                                                                                                @onclick:stopPropagation="true"
                                                                                                                @onclick="() => OpenMissedPullModal(brand, mBreakdown.Month)" 
                                                                                                                title="Record missed pull in @mBreakdown.Month.ToString("MMM yyyy")">
                                                                                                            + Pull
                                                                                                        </button>
                                                                                                    </div>
                                                                                                </td>
                                                                                            </tr>
                                                                                        }
                                                                                    </tbody>
                                                                                </table>
                                                                            </div>
                                                                        }
                                                                        else
                                                                        {
                                                                            <div class="text-muted extra-small fst-italic">No monthly breakdown available.</div>
                                                                        }
                                                                    </div>
                                                                </td>
                                                            </tr>
                                                        }
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    }
                                    else
                                    {
                                        <!-- Master Product Card Grid -->
                                        <div style="max-height: 620px; overflow-y: auto; padding-right: 4px;">
                                            <div class="row g-3">
                                                @foreach (var brand in filteredBrands)
                                                {
                                                    string bg, border, textCol, icon;
                                                    var statusText = GetBrandStatus(brand, out bg, out border, out textCol, out icon);
                                                    var trendInfo = GetBrandTrendInfo(brand);
                                                    var totalExpectedShots = brand.PullsCount * brand.ExpectedShotsPerBottle;
                                                    var yieldPct = totalExpectedShots > 0 ? (int)Math.Round((double)brand.ShotsSold / totalExpectedShots * 100) : 0;
                                                    var pctBarWidth = Math.Min(100, Math.Max(5, yieldPct));
                                                    var netGap = brand.ActualRevenue - brand.ExpectedRevenue;

                                                    <div class="col-xl-4 col-md-6 col-12">
                                                        <div class="card border rounded-4 h-100 shadow-xs overflow-hidden" 
                                                             style="border-color: @border !important; background-color: @bg; transition: all 0.2s;">
                                                             
                                                            <!-- Card Header -->
                                                            <div class="p-3 pb-2 border-bottom d-flex justify-content-between align-items-start gap-2" style="background-color: rgba(0,0,0,0.015); border-color: @border !important;">
                                                                <div class="flex-grow-1">
                                                                    <div class="fw-black text-dark pe-1" title="@brand.Name" style="font-size: 0.95rem; line-height: 1.25; word-break: break-word;">
                                                                        <i class="bi @icon me-1"></i>
                                                                        @brand.Name.ToUpper()
                                                                    </div>
                                                                    <div class="d-flex align-items-center gap-1 flex-wrap mt-1">
                                                                        <span class="badge @(statusText == "Healthy" ? "bg-success text-white" : statusText.Contains("Unrecorded") ? "text-white" : "bg-danger text-white")" 
                                                                              style="font-size: 0.62rem; letter-spacing: 0.3px; padding: 3px 6px; @(statusText.Contains("Unrecorded") ? "background-color: #9333ea !important;" : "")">
                                                                            @statusText.ToUpper()
                                                                        </span>
                                                                        @if (!string.IsNullOrEmpty(trendInfo.VolumeBadgeText))
                                                                        {
                                                                            <span class="@trendInfo.VolumeBadgeClass" style="font-size: 0.58rem; padding: 2px 5px;">@trendInfo.VolumeBadgeText</span>
                                                                        }
                                                                        @if (!string.IsNullOrEmpty(trendInfo.TrendBadgeText))
                                                                        {
                                                                            <span class="@trendInfo.TrendBadgeClass" style="font-size: 0.58rem; padding: 2px 5px; @(trendInfo.TrendStatus == "RISING_SURPLUS" ? "background-color: #9333ea;" : "")">
                                                                                <i class="bi @trendInfo.TrendIcon me-0.5"></i>@trendInfo.TrendBadgeText
                                                                            </span>
                                                                        }
                                                                    </div>
                                                                </div>
                                                                <div class="d-flex flex-column align-items-end gap-1 flex-shrink-0">
                                                                    <span class="badge bg-secondary text-white rounded-pill px-2.5 py-1 fw-bold text-nowrap" style="font-size: 0.72rem;">
                                                                        @brand.PullsCount @(brand.PullsCount == 1 ? "bottle" : "bottles")
                                                                    </span>
                                                                    <button type="button" class="btn btn-xs rounded-pill py-0.5 px-2 fw-bold @(yieldPct > 112 ? "text-white shadow-xs" : "btn-light border text-muted")" 
                                                                            style="font-size: 0.62rem; @(yieldPct > 112 ? "background-color: #9333ea; border-color: #7e22ce;" : "")" 
                                                                            @onclick:stopPropagation="true"
                                                                            @onclick="() => OpenMissedPullModal(brand)" 
                                                                            title="Record a missed bottle pull for this spirit">
                                                                        <i class="bi bi-plus-circle me-1"></i>Missed Pull
                                                                    </button>
                                                                </div>
                                                            </div>

                                                            <!-- Card Body -->
                                                            <div class="p-3 d-flex flex-column gap-2">
                                                                <!-- Yield Health Progress Meter -->
                                                                <div class="mt-1 mb-1">
                                                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                                                        <span class="text-secondary fw-bold" style="font-size: 0.72rem;">Target Yield Met:</span>
                                                                        <span class="fw-black @(yieldPct >= 90 && yieldPct <= 115 ? "text-success" : yieldPct > 115 ? "text-warning text-dark" : "text-danger")" style="font-size: 0.75rem;">
                                                                            @yieldPct% (@((brand.PullsCount > 0 ? (double)brand.ShotsSold / brand.PullsCount : 0).ToString("F1")) / @brand.ExpectedShotsPerBottle shots)
                                                                        </span>
                                                                    </div>
                                                                    <div class="progress" style="height: 6px; background-color: #e2e8f0; border-radius: 6px;">
                                                                        <div class="progress-bar @(yieldPct >= 90 && yieldPct <= 115 ? "bg-success" : yieldPct > 115 ? "bg-warning" : "bg-danger")" 
                                                                             role="progressbar" 
                                                                             style="width: @pctBarWidth%; border-radius: 6px;">
                                                                        </div>
                                                                    </div>
                                                                </div>

                                                                <!-- Actual Sales -->
                                                                <div class="d-flex justify-content-between align-items-center">
                                                                    <span class="text-secondary fw-bold" style="font-size: 0.78rem;">Cumulative Sales:</span>
                                                                    <span class="fw-black text-dark" style="font-size: 0.88rem;">
                                                                        @brand.ActualRevenue.ToString("C0") 
                                                                        <span class="text-muted fw-normal" style="font-size: 0.7rem;">(@brand.ShotsSold shots)</span>
                                                                    </span>
                                                                </div>

                                                                <!-- Net Gap -->
                                                                <div class="d-flex justify-content-between align-items-center">
                                                                    <span class="text-secondary fw-bold" style="font-size: 0.78rem;">Net Dollar Gap:</span>
                                                                    <span class="fw-black @(netGap >= 0 ? "text-success" : "text-danger")" style="font-size: 0.88rem;">
                                                                        @(netGap >= 0 ? "+" : "")@netGap.ToString("C0")
                                                                        <span class="text-muted fw-normal" style="font-size: 0.7rem;">/ target @brand.ExpectedRevenue.ToString("C0")</span>
                                                                    </span>
                                                                </div>

                                                                <!-- Shots / Bottle -->
                                                                <div class="d-flex justify-content-between align-items-center">
                                                                    <span class="text-secondary fw-bold" style="font-size: 0.78rem;">Avg Shots / Bottle:</span>
                                                                    <span class="fw-black text-dark" style="font-size: 0.88rem;">
                                                                        @((brand.PullsCount > 0 ? (double)brand.ShotsSold / brand.PullsCount : 0).ToString("F1")) shots
                                                                        <span class="text-muted fw-normal" style="font-size: 0.7rem;">/ target @brand.ExpectedShotsPerBottle</span>
                                                                    </span>
                                                                </div>

                                                                <!-- Target Calculation Math -->
                                                                <div class="mt-2 pt-2 border-top extra-small text-muted" style="font-size: 0.68rem; line-height: 1.45;">
                                                                    <div class="d-flex justify-content-between"><span>Specs:</span> <strong>@brand.BottleSize (@brand.PourSize.ToString("F2") oz pour)</strong></div>
                                                                    <div class="d-flex justify-content-between"><span>Menu Price:</span> <strong>@brand.RetailPrice.ToString("C") / shot</strong></div>
                                                                    <div class="mt-1.5 bg-light p-1.5 rounded border text-center font-monospace" style="font-size: 0.65rem; color: #334155; background-color: rgba(0,0,0,0.015) !important;">
                                                                        @brand.ExpectedShotsPerBottle shots × @brand.RetailPrice.ToString("C") = <strong>@brand.ExpectedPerBottle.ToString("C")</strong> target yield / btl
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                            else if (_revenueViewTab == "MONTHLY")
                            {
                                <!-- Calendar Month-by-Month Summary Card -->
                                <div class="card border rounded-4 p-4 bg-white shadow-xs mb-4">
                                    <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
                                        <div>
                                            <h5 class="fw-bold text-dark mb-0">
                                                <i class="bi bi-calendar3 me-2 text-primary"></i>Calendar Month-by-Month Performance
                                            </h5>
                                            <span class="text-muted extra-small" style="font-size: 0.75rem;">
                                                Actual POS liquor sales vs. target expectations from bottle pulls per calendar month
                                            </span>
                                        </div>
                                        <span class="badge bg-secondary text-white rounded-pill px-3 py-1 fw-bold">@dispList.Count Months Active</span>
                                    </div>

                                    <div class="table-responsive rounded-3 border" style="max-height: 620px; overflow-y: auto;">
                                        <table class="table table-hover align-middle mb-0">
                                            <thead class="bg-light text-muted text-uppercase extra-small sticky-top shadow-xs" style="position: sticky; top: 0; z-index: 10; background-color: #f8fafc; font-size: 0.72rem;">
                                                <tr>
                                                    <th class="py-3 ps-3">Month</th>
                                                    <th class="text-end">Total POS Sales</th>
                                                    <th class="text-end text-primary">Literal Liquor Sales</th>
                                                    <th class="text-center">Bottles Used</th>
                                                    <th class="text-end fw-bold">Actual / Bottle</th>
                                                    <th class="text-end text-muted">Expected / Bottle</th>
                                                    <th class="text-center pe-3">Status</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var m in dispList)
                                                {
                                                    var actualPerBottle = m.ActualRevPerBottle;
                                                    var expectedPerBottle = m.ExpectedRevPerBottle;
                                                    var isHealthy = actualPerBottle >= expectedPerBottle;

                                                    <tr>
                                                        <td class="ps-3 fw-bold text-dark">@m.Date.ToString("MMMM yyyy")</td>
                                                        <td class="text-end text-muted">@m.TotalPosSales.ToString("C0")</td>
                                                        <td class="text-end fw-bold text-primary">@m.LiteralLiquorSales.ToString("C0")</td>
                                                        <td class="text-center">
                                                            <span class="badge bg-light text-dark border">@m.BottlesUsed</span>
                                                        </td>
                                                        <td class="text-end fw-bold fs-6">@actualPerBottle.ToString("C0")</td>
                                                        <td class="text-end text-muted small">@expectedPerBottle.ToString("C0")</td>
                                                        <td class="text-center pe-3">
                                                            @if (m.BottlesUsed == 0)
                                                            {
                                                                <span class="badge rounded-pill bg-light text-muted border px-3">No Data</span>
                                                            }
                                                            else if (isHealthy)
                                                            {
                                                                <span class="badge rounded-pill bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-3">
                                                                    <i class="bi bi-check-circle-fill me-1"></i> Healthy
                                                                </span>
                                                            }
                                                            else
                                                            {
                                                                <span class="badge rounded-pill bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 px-3">
                                                                    <i class="bi bi-exclamation-triangle-fill me-1"></i> Check
                                                                </span>
                                                            }
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            }
                            </div>
                        </div>
                    }
                    else if (ActiveTab == "DARTS")
                    {
                        var dartsAudit = GetDartsRoundsAudit();
                        var totalRounds = dartsAudit.Count;
                        var totalDrinks = dartsAudit.Sum(d => d.Items.Sum(i => i.Quantity));
                        var totalWholesaleCost = dartsAudit.Sum(d => d.WholesaleCost);
                        var totalRetailValue = dartsAudit.Sum(d => d.RetailValue);

                        <div class="audit-recon-panel bg-white border-end d-flex flex-column h-100">
                            <div class="px-5 pt-4 pb-3 flex-shrink-0 bg-white border-bottom shadow-xs">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <div>
                                        <h4 class="fw-black mb-0" style="color: #6d28d9;">🎯 DARTS MATCH NIGHT ROUNDS AUDIT</h4>
                                        <span class="text-muted" style="font-size: 0.75rem;">Tracking free team rounds and wholesale cost expense to club</span>
                                    </div>
                                    <div class="badge p-2 rounded-pill px-3 fw-bold border" style="background-color: #f5f3ff; color: #6d28d9; border-color: #ddd6fe !important; font-size: 0.75rem;">
                                        <i class="bi bi-info-circle me-1"></i> Cost calculated from per-drink wholesale cost
                                    </div>
                                </div>

                                <div class="row g-3">
                                    <div class="col-md-3">
                                        <div class="stat-card p-3 bg-light border rounded-4">
                                            <div class="text-muted fw-bold extra-small text-uppercase mb-1" style="font-size: 0.65rem;">FREE ROUNDS GIVEN</div>
                                            <div class="fs-3 fw-black text-dark">@totalRounds <span class="fs-6 fw-bold text-muted">rounds</span></div>
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <div class="stat-card p-3 bg-light border rounded-4">
                                            <div class="text-muted fw-bold extra-small text-uppercase mb-1" style="font-size: 0.65rem;">TOTAL DRINKS COMPED</div>
                                            <div class="fs-3 fw-black text-dark">@totalDrinks <span class="fs-6 fw-bold text-muted">drinks</span></div>
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <div class="stat-card p-3 rounded-4 border shadow-sm" style="background: linear-gradient(135deg, #f5f3ff 0%, #ede9fe 100%); border-color: #a78bfa !important;">
                                            <div class="fw-black extra-small text-uppercase mb-1" style="font-size: 0.65rem; color: #5b21b6;">WHOLESALE COST (CLUB EXPENSE)</div>
                                            <div class="fs-3 fw-black" style="color: #6d28d9;">@totalWholesaleCost.ToString("C")</div>
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <div class="stat-card p-3 bg-light border rounded-4">
                                            <div class="text-muted fw-bold extra-small text-uppercase mb-1" style="font-size: 0.65rem;">RETAIL VALUE EQUIVALENT</div>
                                            <div class="fs-3 fw-black text-secondary">@totalRetailValue.ToString("C")</div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="flex-grow-1 custom-scrollbar px-5 py-4" style="overflow-y: auto;">
                                <!-- DARTS ROUNDS TREND GRAPH CHART -->
                                <div class="chart-container bg-light rounded-4 border p-4 mb-4" style="position: relative; width: 100%; min-height: 260px; height: 260px; flex-shrink: 0;">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <h6 class="fw-black mb-0 text-dark" style="font-size: 0.85rem;">
                                            <i class="bi bi-graph-up me-2" style="color: #6d28d9;"></i>DARTS ROUND EXPENSE & DRINK VOLUME OVER TIME
                                        </h6>
                                        <span class="text-muted small fw-bold" style="font-size: 0.7rem;">Wholesale Cost ($) vs Comped Drink Count</span>
                                    </div>
                                    <div style="position: relative; width: 100%; height: 210px;">
                                        <canvas id="dartsTrendsChart"></canvas>
                                    </div>
                                </div>

                                <h6 class="fw-black mb-3 text-dark" style="font-size: 0.9rem;">
                                    <i class="bi bi-list-task me-2" style="color: #6d28d9;"></i>ITEMIZED DARTS ROUNDS AUDIT LOG
                                </h6>

                                <table class="table table-hover align-middle border mb-0 rounded-4 overflow-hidden shadow-xs">
                                    <thead class="bg-light sticky-top">
                                        <tr>
                                            <th class="ps-4">DATE / TIME</th>
                                            <th class="text-center">TEAM</th>
                                            <th class="text-center">BARTENDER / STATION</th>
                                            <th>ITEMIZED BEVERAGES COMPED</th>
                                            <th class="text-center">RETAIL VALUE</th>
                                            <th class="pe-4 text-end">WHOLESALE COST</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (!dartsAudit.Any())
                                        {
                                            <tr>
                                                <td colspan="6" class="text-center py-5 text-muted fw-bold">
                                                    No Darts Round transactions recorded for the selected filter range.
                                                </td>
                                            </tr>
                                        }
                                        else
                                        {
                                            @foreach (var d in dartsAudit)
                                            {
                                                <tr>
                                                    <td class="ps-4 fw-bold text-dark" style="font-size: 0.85rem;">
                                                        <div>@d.Timestamp.ToString("ddd, MMM dd, yyyy")</div>
                                                        <div class="text-muted small">@d.Timestamp.ToString("h:mm tt")</div>
                                                    </td>
                                                    <td class="text-center">
                                                        <span class="badge fw-black px-3 py-1.5 rounded-pill" style="font-size: 0.8rem; background-color: #ede9fe; color: #6d28d9; border: 1px solid #c4b5fd;">
                                                            🎯 @d.TeamName
                                                        </span>
                                                    </td>
                                                    <td class="text-center small">
                                                        <div class="fw-bold text-dark">@d.BartenderName</div>
                                                        <div class="text-muted">@d.TerminalName</div>
                                                    </td>
                                                    <td>
                                                        <div class="d-flex flex-column gap-1">
                                                            @foreach (var item in d.Items)
                                                            {
                                                                var cleanName = item.Name ?? "";
                                                                if (cleanName.Contains(" (")) cleanName = cleanName.Substring(0, cleanName.IndexOf(" (")).Trim();
                                                                <div class="small fw-bold text-dark">
                                                                    • @cleanName <span class="badge bg-secondary rounded-pill">x@(item.Quantity)</span>
                                                                </div>
                                                            }
                                                        </div>
                                                    </td>
                                                    <td class="text-center text-muted fw-bold" style="font-size: 0.85rem;">
                                                        @d.RetailValue.ToString("C")
                                                    </td>
                                                    <td class="pe-4 text-end">
                                                        <span class="fs-6 fw-black" style="color: #6d28d9;">
                                                            @d.WholesaleCost.ToString("C")
                                                        </span>
                                                    </td>
                                                </tr>
                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    }
                    else if (ActiveTab == "EVENTS")
                    {
                        var selectedGrp = CurrentSelectedEventGroup;
                        <div class="d-flex flex-column w-100 h-100 overflow-hidden" style="background: #f8fafc;">
                            <!-- TOP EVENT SELECTION TABS -->
                            <div class="px-4 py-3 bg-white border-bottom flex-shrink-0 shadow-xs">
                                <div class="d-flex align-items-center justify-content-between mb-2">
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="text-uppercase fw-black small text-dark" style="font-size: 0.72rem; letter-spacing: 0.5px;">
                                            <i class="bi bi-calendar-event me-1 text-primary"></i>SELECT EVENT:
                                        </span>
                                        <span class="text-muted" style="font-size: 0.7rem;">Click an event tab to view its metrics & transactions</span>
                                    </div>
                                    <div class="btn-group btn-group-sm" role="group">
                                        <button class="btn btn-sm @(EventStatusFilter == "ALL" ? "btn-primary fw-bold text-white shadow-sm" : "btn-outline-secondary bg-white text-muted")" style="font-size: 0.68rem; padding: 2px 8px;" @onclick='() => EventStatusFilter = "ALL"'>
                                            ALL (@BuildEventGroups().Count)
                                        </button>
                                        <button class="btn btn-sm @(EventStatusFilter == "OPEN" ? "btn-success fw-bold text-white shadow-sm" : "btn-outline-secondary bg-white text-muted")" style="font-size: 0.68rem; padding: 2px 8px;" @onclick='() => EventStatusFilter = "OPEN"'>
                                            OPEN (@BuildEventGroups().Count(g => g.Status == GFC.Core.Enums.EventTabStatus.Open))
                                        </button>
                                        <button class="btn btn-sm @(EventStatusFilter == "CLOSED" ? "btn-secondary fw-bold text-white shadow-sm" : "btn-outline-secondary bg-white text-muted")" style="font-size: 0.68rem; padding: 2px 8px;" @onclick='() => EventStatusFilter = "CLOSED"'>
                                            CLOSED (@BuildEventGroups().Count(g => g.Status == GFC.Core.Enums.EventTabStatus.Closed))
                                        </button>
                                    </div>
                                </div>
                                <div class="d-flex gap-2 flex-wrap align-items-center">
                                    @if (!FilteredEventGroups.Any())
                                    {
                                        <div class="text-muted small py-1"><i class="bi bi-info-circle me-1"></i>No events found for this filter.</div>
                                    }
                                    else
                                    {
                                        @foreach (var grp in FilteredEventGroups)
                                        {
                                            var isSelected = selectedGrp?.Name == grp.Name;
                                            <button class="btn btn-sm rounded-pill px-4 py-1.5 @(isSelected ? "btn-primary text-white shadow-sm fw-bold" : "btn-light text-dark border fw-bold")"
                                                    style="font-size: 0.85rem; cursor: pointer; transition: all 0.15s ease-in-out;"
                                                    @onclick="() => SelectEventGroup(grp)">
                                                @grp.Name
                                            </button>
                                        }
                                    }
                                </div>
                            </div>

                            <!-- SCROLLABLE CONTENT FOR SELECTED EVENT -->
                            <div class="flex-grow-1 custom-scrollbar overflow-auto p-4 d-flex justify-content-center">
                                @if (selectedGrp != null)
                                {
                                    var evSales = selectedGrp.Sales;
                                    var latestEv = selectedGrp.LatestEvent;
                                    
                                    <div class="w-100 animate-fade-in" style="max-width: 1200px;">
                                        @if (selectedGrp.IsDonorEvent)
                                        {
                                            <!-- DONOR EVENT: PRIZES & REDONATED BEERS (NO BAR TAB BOXES, NO REMAINING STOCK PANEL) -->
                                            <div class="bg-white rounded-4 border p-4 mb-4 shadow-sm">
                                                <div class="d-flex justify-content-between align-items-start">
                                                    <div>
                                                        <div class="d-flex align-items-center gap-2 mb-1">
                                                            <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-1 fw-bold" style="font-size: 0.75rem;">
                                                                <i class="bi bi-gift-fill me-1"></i>DONOR EVENT
                                                            </span>
                                                            <span class="badge bg-secondary-subtle text-dark border px-3 py-1 fw-bold" style="font-size: 0.75rem;">
                                                                PRIZES &amp; BEER DONATIONS
                                                            </span>
                                                        </div>
                                                        <h2 class="fw-black mb-1 text-dark">@selectedGrp.Name</h2>
                                                        <div class="text-muted small">
                                                            Total of <strong class="text-success">@selectedGrp.TotalDonatedDistributed bottles (@(selectedGrp.TotalDonatedDistributed / 24) cases)</strong> distributed across <strong class="text-dark">@selectedGrp.Distributions.Count</strong> action(s).
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>

                                            <!-- PRIZES & BEER DISTRIBUTIONS TABLE -->
                                            <div class="bg-white rounded-4 border shadow-sm overflow-hidden mb-4">
                                                <div class="px-4 py-3 bg-light border-bottom d-flex justify-content-between align-items-center">
                                                    <h5 class="fw-black mb-0 text-dark" style="font-size: 0.95rem;">
                                                        <i class="bi bi-gift-fill me-2 text-success"></i>PRIZES &amp; RE-DONATED BEER DISTRIBUTION LOG
                                                    </h5>
                                                    <span class="badge bg-success-subtle text-success border border-success-subtle fw-bold px-3 py-1.5" style="font-size: 0.75rem;">
                                                        @selectedGrp.TotalDonatedDistributed total bottles distributed
                                                    </span>
                                                </div>
                                                <div class="table-responsive">
                                                    <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
                                                        <thead class="bg-light text-muted fw-bold" style="font-size: 0.72rem; letter-spacing: 0.5px;">
                                                            <tr>
                                                                <th class="ps-4 py-3">DATE / TIME</th>
                                                                <th class="py-3">ACTION TYPE</th>
                                                                <th class="py-3">BEER BRAND</th>
                                                                <th class="py-3 text-center">QUANTITY</th>
                                                                <th class="py-3">RECIPIENT / BENEFICIARY</th>
                                                                <th class="pe-4 py-3 text-center">INVENTORY STATUS</th>
                                                            </tr>
                                                        </thead>
                                                        <tbody>
                                                            @foreach (var dist in selectedGrp.Distributions)
                                                            {
                                                                var isPrize = dist.ActionType == "prize";
