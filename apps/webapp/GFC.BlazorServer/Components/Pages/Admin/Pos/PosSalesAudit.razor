        public bool IsChronicDeficit { get; set; } = false;
        public bool IsRepeatSurplus { get; set; } = false;
        public string VolumeConfidence { get; set; } = "NORMAL";
        public string VolumeBadgeText { get; set; } = "";
        public string VolumeBadgeClass { get; set; } = "";
