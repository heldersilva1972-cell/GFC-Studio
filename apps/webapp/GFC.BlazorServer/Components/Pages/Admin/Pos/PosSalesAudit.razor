    private bool _showMissedPullModal = false;
    private BrandRevenueDetail? _missedPullTargetBrand = null;
    private int _missedPullCount = 1;
    private DateTime _missedPullDate = DateTime.Today;
    private string _missedPullNotes = "";
    private string _missedPullLocation = "MAIN_STORAGE";
    private bool _isSavingMissedPull = false;

    private void OpenMissedPullModal(BrandRevenueDetail brand, DateTime? monthDate = null)
    {
        _missedPullTargetBrand = brand;
        
        int defaultCount = 1;
        var targetPerBottle = brand.ExpectedShotsPerBottle > 0 ? brand.ExpectedShotsPerBottle : 22;
        if (monthDate.HasValue)
        {
            var mBreakdown = brand.MonthlyBreakdown.FirstOrDefault(m => m.Month.Year == monthDate.Value.Year && m.Month.Month == monthDate.Value.Month);
            if (mBreakdown != null)
            {
                var mExpected = mBreakdown.PullsCount * targetPerBottle;
                if (mBreakdown.ShotsSold > mExpected)
                {
                    defaultCount = Math.Max(1, (int)Math.Ceiling((double)(mBreakdown.ShotsSold - mExpected) / targetPerBottle));
                }
            }
        }
        else
        {
            var expected = brand.PullsCount * targetPerBottle;
            if (brand.ShotsSold > expected)
            {
                defaultCount = Math.Max(1, (int)Math.Ceiling((double)(brand.ShotsSold - expected) / targetPerBottle));
            }
        }

        _missedPullCount = defaultCount;
        _missedPullDate = monthDate ?? (SelectedYear > 0 && SelectedMonth > 0 ? new DateTime(SelectedYear, SelectedMonth, 15) : DateTime.Today);
        _missedPullNotes = "";
        _missedPullLocation = "MAIN_STORAGE";
        _showMissedPullModal = true;
    }

    private async Task ExecuteSaveMissedPull()
    {
        if (_missedPullTargetBrand == null || _missedPullCount <= 0 || _isSavingMissedPull) return;
        _isSavingMissedPull = true;

        try
        {
            using var db = DbFactory.CreateDbContext();
            var brandName = _missedPullTargetBrand.Name;
            
            // Find matching liquor item
            var liquorItem = await db.LiquorItems.FirstOrDefaultAsync(i => i.Name == brandName || i.Name == CleanProductName(brandName));
            if (liquorItem == null)
            {
                liquorItem = await db.LiquorItems.FirstOrDefaultAsync(i => i.Name.Contains(brandName));
            }

            if (liquorItem == null)
            {
                await JSRuntime.InvokeVoidAsync("alert", $"Could not find inventory item '{brandName}' in database.");
                return;
            }

            var username = _currentUser?.Username ?? "Manager";
            var noteText = $"[{_missedPullLocation}] POS End-of-Shift Removal (Missed Pull Audit correction recorded by {username}). {(_missedPullNotes)}".Trim();

            var tx = new LiquorTransaction
            {
                ItemId = liquorItem.Id,
                UserId = _currentUser?.UserId ?? 1,
                ChangeAmount = -_missedPullCount,
                TransactionType = "Checkout",
                Timestamp = _missedPullDate.Date.AddHours(23).AddMinutes(59),
                Notes = noteText
            };

            db.LiquorTransactions.Add(tx);

            // Update stock
            liquorItem.CurrentStock = Math.Max(0, liquorItem.CurrentStock - _missedPullCount);
            var locStock = await db.LiquorLocationStocks.FirstOrDefaultAsync(ls => ls.ItemId == liquorItem.Id && ls.LocationName == _missedPullLocation);
            if (locStock != null)
            {
                locStock.Stock = Math.Max(0, locStock.Stock - _missedPullCount);
            }

            await db.SaveChangesAsync();

            _showMissedPullModal = false;
            await LoadRevenueAnalysisData();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Error saving missed pull: {ex.Message}");
        }
        finally
        {
            _isSavingMissedPull = false;
        }
    }

    private List<BrandRevenueDetail> GetCumulativeBrandDetails(IEnumerable<RevenueAnalysisMonth> months)
    {
        if (months == null || !months.Any()) return new List<BrandRevenueDetail>();
        var brandGroups = months
            .SelectMany(m => m.TopBrands.Select(b => new { Month = m.Date, Brand = b }))
            .GroupBy(x => x.Brand.Name)
            .ToList();

        var result = new List<BrandRevenueDetail>();
        foreach (var g in brandGroups)
        {
            var firstBrand = g.First().Brand;
            var totalPulls = g.Sum(x => x.Brand.PullsCount);
            var totalActual = g.Sum(x => x.Brand.ActualRevenue);
            var totalExpected = g.Sum(x => x.Brand.ExpectedRevenue);
            var totalShots = g.Sum(x => x.Brand.ShotsSold);

            var monthlyBreakdowns = g
                .OrderBy(x => x.Month)
                .Select(x => new BrandMonthlyBreakdown
                {
                    Month = x.Month,
                    PullsCount = x.Brand.PullsCount,
                    ShotsSold = x.Brand.ShotsSold,
                    ActualRevenue = x.Brand.ActualRevenue,
                    ExpectedRevenue = x.Brand.ExpectedRevenue
                })
                .Where(x => x.PullsCount > 0 || x.ShotsSold > 0 || x.ActualRevenue > 0)
                .ToList();

            result.Add(new BrandRevenueDetail
            {
                Name = g.Key,
                PullsCount = totalPulls,
                ActualRevenue = totalActual,
                ExpectedRevenue = totalExpected,
                BottleSize = firstBrand.BottleSize,
                RetailPrice = firstBrand.RetailPrice,
                ExpectedShotsPerBottle = firstBrand.ExpectedShotsPerBottle,
                PourSize = firstBrand.PourSize,
                ShotsSold = totalShots,
                MonthlyBreakdown = monthlyBreakdowns
            });
        }

        return result.Where(b => b.PullsCount > 0 || b.ActualRevenue > 0).ToList();
    }

    private List<BrandRevenueDetail> GetFilteredAndSortedBrands(List<BrandRevenueDetail> allBrands)
    {
        var query = allBrands.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(_revenueBrandSearch))
        {
            query = query.Where(b => b.Name.Contains(_revenueBrandSearch, StringComparison.OrdinalIgnoreCase));
        }

        if (_revenueStatusFilter == "DEFICIT")
        {
            query = query.Where(b => (b.ActualRevenue - b.ExpectedRevenue) < 0 || (b.PullsCount > 0 && ((double)b.ShotsSold / (b.PullsCount * (b.ExpectedShotsPerBottle > 0 ? b.ExpectedShotsPerBottle : 22))) < 0.90));
        }
        else if (_revenueStatusFilter == "CHRONIC_DEFICIT")
        {
            query = query.Where(b => GetBrandTrendInfo(b).IsChronicDeficit);
        }
        else if (_revenueStatusFilter == "REPEAT_SURPLUS")
        {
            query = query.Where(b => GetBrandTrendInfo(b).IsRepeatSurplus || (b.PullsCount > 0 && ((double)b.ShotsSold / (b.PullsCount * (b.ExpectedShotsPerBottle > 0 ? b.ExpectedShotsPerBottle : 22))) > 1.12));
        }
        else if (_revenueStatusFilter == "HIGH_VOL")
        {
            query = query.Where(b => b.PullsCount >= 5);
        }
        else if (_revenueStatusFilter == "HEALTHY")
        {
            query = query.Where(b => {
                var target = b.ExpectedShotsPerBottle > 0 ? b.ExpectedShotsPerBottle : 22;
                var exp = b.PullsCount * target;
                var pct = exp > 0 ? (double)b.ShotsSold / exp : 0;
                return pct >= 0.90 && pct <= 1.12;
            });
        }

        query = _revenueBrandSort switch
        {
            "PULLS" => query.OrderByDescending(b => b.PullsCount).ThenBy(b => b.Name),
            "YIELD" => query.OrderBy(b => b.PullsCount == 0 ? 0 : (double)b.ShotsSold / (b.PullsCount * (b.ExpectedShotsPerBottle > 0 ? b.ExpectedShotsPerBottle : 22))),
            "NAME" => query.OrderBy(b => b.Name),
            _ => query.OrderBy(b => b.ActualRevenue - b.ExpectedRevenue) // Largest deficit first
        };

        return query.ToList();
    }

    private async Task RenderRevenueChartsAsync()
    {
        if (ActiveTab != "REVENUE" || _revenueViewTab != "CHART") return;

        try
        {
            var displayedRevenueMonths = _revenueAnalysisMonths.Where(m => m.Date >= new DateTime(2026, 8, 1));
            if (SelectedYear > 0)
            {
                displayedRevenueMonths = displayedRevenueMonths.Where(m => m.Date.Year == SelectedYear);
            }
            if (SelectedMonth > 0)
            {
                displayedRevenueMonths = displayedRevenueMonths.Where(m => m.Date.Month == SelectedMonth);
            }
            var dispList = displayedRevenueMonths.OrderBy(m => m.Date).ToList();

            var cumulativeBrands = GetCumulativeBrandDetails(dispList);
            if (cumulativeBrands.Any())
            {
                // Include ALL spirits with activity (both healthy and deficits)
                // Ordered by variance (largest deficit first, through to surplus)
                var sortedBrands = cumulativeBrands
                    .OrderBy(b => b.ActualRevenue - b.ExpectedRevenue)
                    .ToList();

                var varianceConfig = new
                {
                    labels = sortedBrands.Select(b => {
                        var totalExpShots = b.PullsCount * (b.ExpectedShotsPerBottle > 0 ? b.ExpectedShotsPerBottle : 22);
                        var pct = totalExpShots > 0 ? (int)Math.Round((double)b.ShotsSold / totalExpShots * 100) : 0;
                        return $"{b.Name} ({pct}%)";
                    }).ToArray(),
                    names = sortedBrands.Select(b => b.Name).ToArray(),
                    percentages = sortedBrands.Select(b => {
                        var totalExpShots = b.PullsCount * (b.ExpectedShotsPerBottle > 0 ? b.ExpectedShotsPerBottle : 22);
                        return totalExpShots > 0 ? (int)Math.Round((double)b.ShotsSold / totalExpShots * 100) : 0;
                    }).ToArray(),
                    data = sortedBrands.Select(b => (double)(b.ActualRevenue - b.ExpectedRevenue)).ToArray(),
                    pulls = sortedBrands.Select(b => b.PullsCount).ToArray(),
                    shots = sortedBrands.Select(b => b.ShotsSold).ToArray(),
                    avgShots = sortedBrands.Select(b => b.PullsCount > 0 ? Math.Round((double)b.ShotsSold / b.PullsCount, 1) : 0).ToArray(),
                    targetShots = sortedBrands.Select(b => b.ExpectedShotsPerBottle).ToArray(),
                    actual = sortedBrands.Select(b => (double)b.ActualRevenue).ToArray(),
                    expected = sortedBrands.Select(b => (double)b.ExpectedRevenue).ToArray(),
                    trajectories = sortedBrands.Select(b => GetBrandTrendInfo(b).TrajectoryText).ToArray(),
                    trendBadges = sortedBrands.Select(b => GetBrandTrendInfo(b).TrendBadgeText).ToArray(),
                    confidenceBadges = sortedBrands.Select(b => GetBrandTrendInfo(b).VolumeBadgeText).ToArray()
                };

                await JSRuntime.InvokeVoidAsync("inventoryCharts.renderProductVarianceChart", "chart-product-variance", varianceConfig);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[RevenueChart] Error rendering charts: {ex.Message}");
        }
    }

