                                <div class="d-flex justify-content-between align-items-center pt-2 border-top flex-wrap gap-2">
                                    <div class="d-flex align-items-center gap-2 flex-wrap">
                                        <label class="small fw-black text-muted text-uppercase mb-0 me-1" style="font-size: 0.65rem; letter-spacing: 0.5px;">CATEGORY:</label>
                                        <div class="btn-group border bg-light p-1 rounded-pill" style="font-size: 0.65rem; display: inline-flex;">
                                            <button class="btn btn-xs rounded-pill px-3 py-1 @(_foodCategoryFilter == "ALL" ? "btn-primary shadow-sm text-white fw-bold" : "btn-link text-muted fw-bold text-decoration-none")"
                                                    @onclick='() => SetFoodCategoryFilter("ALL")'>
