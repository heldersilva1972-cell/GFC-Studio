@code {
    private string CleanProductName(string rawName)
    {
        if (string.IsNullOrEmpty(rawName)) return "";
        var name = rawName.Trim();
        if (name.StartsWith("> ")) name = name.Substring(2).Trim();
        if (name.StartsWith("PRIZE:", StringComparison.OrdinalIgnoreCase)) name = name.Substring(6).Trim();
        if (name.StartsWith("TALLY:", StringComparison.OrdinalIgnoreCase)) name = name.Substring(6).Trim();
        if (name.StartsWith("TALLY -", StringComparison.OrdinalIgnoreCase)) name = name.Substring(7).Trim();
        if (name.StartsWith("TALLY", StringComparison.OrdinalIgnoreCase) && name.Length > 5 && !char.IsLetter(name[5])) name = name.Substring(5).Trim(' ', ':', '-');

        if (name.Contains("(TOKEN SALE)", StringComparison.OrdinalIgnoreCase))
        {
            name = name.Replace("(TOKEN SALE)", "", StringComparison.OrdinalIgnoreCase).Trim();
        }
        if (name.Contains("(TALLY)", StringComparison.OrdinalIgnoreCase))
        {
            name = name.Replace("(TALLY)", "", StringComparison.OrdinalIgnoreCase).Trim();
        }
        if (name.Contains("[TALLY]", StringComparison.OrdinalIgnoreCase))
        {
            name = name.Replace("[TALLY]", "", StringComparison.OrdinalIgnoreCase).Trim();
        }

        int parenIndex = name.IndexOf('(');
        if (parenIndex != -1)
        {
            name = name.Substring(0, parenIndex).Trim();
        }
        return name.Trim();
    }

