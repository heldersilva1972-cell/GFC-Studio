    private async Task RenderTokenFlowChart()
    {
        if (ActiveTab != "TOKENS") return;

        var labels = TokenYields.Select(x => x.Token.Name.Replace(" Token", "").Replace("Token ", "").ToUpper()).ToArray();
        var soldData = TokenYields.Select(x => x.Sold).ToArray();
        var redeemedData = TokenYields.Select(x => x.Redeemed).ToArray();
        var legacyData = TokenYields.Select(x => x.LegacyRedeemed).ToArray();

        try
        {
            await JSRuntime.InvokeVoidAsync("eval", @"
                (function() {
                    var el = document.getElementById('tokenFlowChart');
                    if (el && window.Chart) {
                        var chart = window.Chart.getChart(el);
                        if (chart) { try { chart.destroy(); } catch(e){} }
                    }
                })()
            ");
            await Task.Delay(20);
            await JSRuntime.InvokeVoidAsync("inventoryCharts.renderTokenFlowChart", "tokenFlowChart", new {
                labels,
                soldData,
                redeemedData,
                legacyData
            });
        }
        catch (Exception ex)
        {
            Console.WriteLine("Error rendering token flow chart: " + ex.Message);
        }
    }

