                                        <div class="badge bg-light text-primary p-2 rounded-pill px-3 fw-bold border">
                                            <i class="bi bi-info-circle me-2"></i>Total Volume: @GetFilteredSummaryResults().Sum(x => x.Quantity)
                                        </div>
                                    </div>
                                </div>
                                
                                <!-- Filters & Sorting Strip -->
                                <div class="d-flex justify-content-between align-items-center py-2 border-top border-bottom mb-2 flex-wrap gap-2">
                                    <div class="d-flex align-items-center gap-2">
                                        <label class="small fw-black text-muted text-uppercase mb-0 me-2" style="font-size: 0.65rem; letter-spacing: 0.5px;">CATEGORY:</label>
                                        <div class="btn-group border bg-light p-1 rounded-pill" style="font-size: 0.65rem; display: inline-flex;">
                                            <button class="btn btn-xs rounded-pill px-3 py-1 @(SelectedCategoryFilter == "ALL" ? "btn-primary shadow-sm text-white" : "btn-link text-muted fw-bold text-decoration-none")" @onclick='() => SetCategoryFilter("ALL")'>ALL</button>
                                            @foreach (var cat in MenuCategories)
                                            {
                                                <button class="btn btn-xs rounded-pill px-3 py-1 @(SelectedCategoryFilter == cat ? "btn-primary shadow-sm text-white" : "btn-link text-muted fw-bold text-decoration-none")" @onclick='() => SetCategoryFilter(cat)'>@cat</button>
                                            }
                                        </div>
                                    </div>
                                    
                                    <div class="d-flex align-items-center gap-2">
                                        <label class="small fw-black text-muted text-uppercase mb-0" style="font-size: 0.65rem; letter-spacing: 0.5px;">SORT BY:</label>
                                        <select class="form-select form-select-sm border bg-light rounded-pill py-1 px-3 fw-bold" @bind="ItemSortOption" style="font-size: 0.7rem; width: auto; cursor: pointer;">
                                            <option value="QTY_DESC">QTY: HIGH TO LOW</option>
                                            <option value="QTY_ASC">QTY: LOW TO HIGH</option>
                                            <option value="REV_DESC">REVENUE: HIGH TO LOW</option>
                                            <option value="NAME_ASC">NAME: A-Z</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
 
                            <div class="flex-grow-1 custom-scrollbar px-5 pb-5" style="overflow-y: auto;">
                                <table class="table table-hover align-middle border mb-0">
                                    <thead class="bg-light sticky-top">
                                        <tr>
                                            <th class="ps-4">PRODUCT</th>
                                            <th class="text-center">CATEGORY</th>
                                            <th class="text-center">QTY SOLD</th>
                                            <th class="text-center">TOKENS USED</th>
                                            <th class="pe-4 text-end">REVENUE</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @{
                                            var filtered = GetFilteredSummaryResults().ToList();
                                        }
                                        @if (!filtered.Any())
                                        {
                                            <tr><td colspan="5" class="text-center py-5 text-muted">No sales items found in this period.</td></tr>
                                        }
                                        else
                                        {
                                            @foreach (var item in filtered)
                                            {
                                                <tr>
                                                    <td class="ps-4 fw-black">@item.Name</td>
                                                    <td class="text-center"><span class="badge bg-light text-secondary border rounded-pill px-3 fw-bold small">@item.Category</span></td>
                                                    <td class="text-center fw-bold">@item.Quantity</td>
                                                    <td class="text-center">
                                                        @if (item.TokensRedeemed > 0)
                                                        {
                                                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-3 fw-black" style="font-size: 0.72rem;">
                                                                <i class="bi bi-coin me-1"></i>@item.TokensRedeemed
                                                            </span>
                                                        }
                                                        else
                                                        {
                                                            <span class="text-muted opacity-50">-</span>
                                                        }
                                                    </td>
                                                    <td class="pe-4 text-end fw-bold text-success">@item.Revenue.ToString("C")</td>
                                                </tr>
                                            }
                                        }
                                    </tbody>
                                    @if (filtered.Any())
                                    {
                                        <tfoot class="bg-light fw-black border-top sticky-bottom">
                                            <tr>
                                                <td class="ps-4 py-3">TOTAL VOLUME</td>
                                                <td class="text-center"></td>
                                                <td class="text-center py-3">@filtered.Sum(x => x.Quantity)</td>
                                                <td class="text-center py-3 text-primary">
                                                    @if (filtered.Sum(x => x.TokensRedeemed) > 0)
                                                    {
                                                        <span class="fw-black"><i class="bi bi-coin me-1"></i>@filtered.Sum(x => x.TokensRedeemed)</span>
                                                    }
                                                    else
                                                    {
                                                        <span>-</span>
                                                    }
                                                </td>
                                                <td class="pe-4 text-end py-3 text-success">@filtered.Sum(x => x.Revenue).ToString("C")</td>
                                            </tr>
                                        </tfoot>
                                    }
                                </table>
                            </div>
                        </div>
                    }
                    else if (ActiveTab == "REVENUE")
                    {
                        <!-- MIDDLE (EXPANDED): Bar Revenue Analysis View -->
                        <div class="audit-recon-panel bg-white border-end d-flex flex-column h-100">
                            <!-- Locked Header (Non-Scrollable) -->
                            <div class="px-5 pt-4 pb-3 flex-shrink-0 bg-white border-bottom shadow-xs">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <div>
                                        <h4 class="fw-black mb-0 text-primary">BAR REVENUE ANALYSIS</h4>
                                        <span class="text-muted" style="font-size: 0.72rem;">Exact transaction yield tracking & inventory audit</span>
                                    </div>
                                    <div class="d-flex gap-2">
                                        <button class="btn btn-outline-secondary btn-sm rounded-pill fw-bold bg-white" @onclick="ToggleOptionsPanel">
                                            <i class="bi bi-sliders me-1"></i> OPTIONS / FILTERS
                                        </button>
                                        <div class="badge bg-light text-primary p-2 rounded-pill px-3 fw-bold border" style="font-size: 0.75rem;">
                                            <i class="bi bi-info-circle me-2"></i>Formula: Expected = Pulls * Expected Shots * Drink Retail Price
                                        </div>
                                    </div>
                                </div>

                                <!-- TOP OVERVIEW CARDS (Compressed & Locked) -->
                                @{
                                    var trackingMonths = _revenueAnalysisMonths.Where(x => x.Date >= new DateTime(2026, 8, 1)).ToList();
                                    if (SelectedYear > 0)
                                    {
                                        trackingMonths = trackingMonths.Where(x => x.Date.Year == SelectedYear).ToList();
                                    }
                                    if (SelectedMonth > 0)
                                    {
                                        trackingMonths = trackingMonths.Where(x => x.Date.Month == SelectedMonth).ToList();
                                    }
                                    var totalSales24 = trackingMonths.Sum(x => x.TotalPosSales);
                                    var literalSales24 = trackingMonths.Sum(x => x.LiteralLiquorSales);
                                    var bottlesUsed24 = trackingMonths.Sum(x => x.BottlesUsed);
                                    var expected24 = trackingMonths.Sum(x => x.ExpectedRevenue);
                                    var netGap24 = literalSales24 - expected24;
                                    var actualPerBottle24 = bottlesUsed24 == 0 ? 0 : literalSales24 / bottlesUsed24;
                                    var expectedPerBottle24 = bottlesUsed24 == 0 ? 0 : expected24 / bottlesUsed24;
                                }
                                <div class="row g-2">
                                    <div class="col-md-3">
                                        <div class="stat-card p-2 px-3 bg-light border d-flex flex-column justify-content-center" style="border-radius: 12px; height: 60px;">
                                            <div class="label m-0 text-uppercase text-secondary fw-bold" style="font-size: 0.58rem; letter-spacing: 0.3px;">LITERAL LIQUOR SALES</div>
                                            <div class="value m-0 fw-black text-dark" style="font-size: 1.15rem; line-height: 1.2;">@literalSales24.ToString("C0")</div>
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <div class="stat-card p-2 px-3 bg-light border d-flex flex-column justify-content-center" style="border-radius: 12px; height: 60px;">
                                            <div class="label m-0 text-uppercase text-secondary fw-bold" style="font-size: 0.58rem; letter-spacing: 0.3px;">BOTTLES EMPTY</div>
                                            <div class="value m-0 fw-black text-dark" style="font-size: 1.15rem; line-height: 1.2;">@bottlesUsed24</div>
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <div class="stat-card p-2 px-3 bg-light border d-flex flex-column justify-content-center" style="border-radius: 12px; height: 60px;">
                                            <div class="label m-0 text-uppercase text-secondary fw-bold" style="font-size: 0.58rem; letter-spacing: 0.3px;">ACTUAL / BOTTLE</div>
                                            <div class="value m-0 fw-black text-dark" style="font-size: 1.15rem; line-height: 1.2;">
                                                @actualPerBottle24.ToString("C0")
                                                <span class="text-muted fw-bold" style="font-size: 0.65rem;">(target @expectedPerBottle24.ToString("C0"))</span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <div class="stat-card p-2 px-3 @(netGap24 >= 0 ? "bg-success-subtle border-success-subtle text-success" : "bg-danger-subtle border-danger-subtle text-danger") border d-flex flex-column justify-content-center" style="border-radius: 12px; height: 60px;">
                                            <div class="label m-0 text-uppercase fw-bold opacity-75" style="font-size: 0.58rem; letter-spacing: 0.3px;">NET YIELD GAP</div>
                                            <div class="value m-0 fw-black" style="font-size: 1.15rem; line-height: 1.2;">
                                                @(netGap24 >= 0 ? "+" : "")@netGap24.ToString("C0")
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Scrollable Area -->
                            <div class="flex-grow-1 custom-scrollbar px-5 py-4" style="overflow-y: auto;">
                                <!-- Collapsible Options settings panel -->
                                @if (_showOptionsPanel)
                                {
                                    <div class="options-panel border rounded-4 p-4 mb-4 bg-light animate-fade-in" style="border-radius: 20px; box-shadow: 0 10px 15px -3px rgba(0,0,0,0.05);">
                                        <div class="d-flex justify-content-between align-items-center mb-3">
                                            <h6 class="fw-black mb-0 text-secondary"><i class="bi bi-gear-fill me-2"></i>AUDIT & DATA SELECTION SETTINGS</h6>
                                            <button class="btn btn-link btn-sm text-decoration-none fw-bold p-0 text-secondary" @onclick="ToggleOptionsPanel">Close <i class="bi bi-x-lg"></i></button>
                                        </div>

                                        <!-- Shot / Pour Size Settings Card -->
                                        <div class="card border rounded-3 p-3 bg-white shadow-xs mb-4" style="border-radius: 14px; border-color: #e2e8f0 !important;">
                                            <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3">
                                                <div>
                                                    <div class="d-flex align-items-center gap-2">
                                                        <span class="fw-black text-dark" style="font-size: 0.95rem;">
                                                            <i class="bi bi-cup-straw text-primary me-1"></i>STANDARD SHOT / POUR SIZE CALCULATION
                                                        </span>
                                                        <span class="badge bg-primary text-white rounded-pill px-2.5 py-1 fw-bold" style="font-size: 0.72rem;">
                                                            Active: @_auditShotSize.ToString("F2") oz
                                                        </span>
                                                    </div>
                                                    <div class="text-muted extra-small mt-1" style="font-size: 0.75rem;">
                                                        Sets the standard shot size used to calculate target shots per bottle and expected dollar revenue across all views.
                                                    </div>
