                                                                    </button>
                                                                    <button class="btn btn-outline-warning btn-sm rounded-pill fw-bold text-dark px-2.5 py-1" style="font-size: 0.72rem; white-space: nowrap;" @onclick="() => OpenResetLegacyModal(y)" title="Reset Legacy Count to 0 or baseline">
                                                                        <i class="bi bi-arrow-counterclockwise me-1"></i> RESET LEGACY
                                                                    </button>
