                        <i class="bi bi-clock-history text-primary fs-4"></i>
                        <div>
                            <h5 class="modal-title fw-black text-dark mb-0">TOKEN TRANSACTION & LIABILITY HISTORY LOG</h5>
                            <div class="small text-muted">Complete audit trail of physical chip counts, legacy adjustments, stock replenishments, and how they modified drawer balances</div>
                        </div>
                    </div>
                    <button type="button" class="btn-close" @onclick='() => _showHistoryModal = false'></button>
                </div>
