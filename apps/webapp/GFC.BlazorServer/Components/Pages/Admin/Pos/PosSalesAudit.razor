    private BrandTrendInfo GetBrandTrendInfo(BrandRevenueDetail brand)
    {
        var info = new BrandTrendInfo();
        var targetShots = brand.ExpectedShotsPerBottle > 0 ? brand.ExpectedShotsPerBottle : 22;

        // 1. Volume Confidence
        if (brand.PullsCount <= 2)
        {
            info.VolumeConfidence = "LOW_VOL";
            info.VolumeBadgeText = "🧪 Low Vol";
            info.VolumeBadgeClass = "badge bg-light text-muted border";
        }
        else if (brand.PullsCount >= 5)
        {
            info.VolumeConfidence = "HIGH_VOL";
            info.VolumeBadgeText = "🏆 High Volume";
            info.VolumeBadgeClass = "badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25";
        }

        // 2. Trajectory & Pattern Analysis across monthly breakdowns
        if (brand.MonthlyBreakdown != null && brand.MonthlyBreakdown.Any())
        {
            var activeMonths = brand.MonthlyBreakdown
                .Where(m => m.PullsCount > 0 || m.ShotsSold > 0)
                .OrderBy(m => m.Month)
                .ToList();

            var recentMonths = activeMonths.TakeLast(3).ToList();
            if (recentMonths.Any())
            {
                var pcts = recentMonths.Select(m => {
                    var exp = m.PullsCount * targetShots;
                    var pct = exp > 0 ? (int)Math.Round((double)m.ShotsSold / exp * 100) : 0;
                    return (Month: m.Month, Pct: pct, Pulls: m.PullsCount);
                }).ToList();

                info.TrajectoryText = string.Join(" ➔ ", pcts.Select(p => $"{p.Month:MMM} ({p.Pct}%)"));

                if (pcts.Count >= 2)
                {
                    var lastTwo = pcts.TakeLast(2).ToList();
                    if (lastTwo.All(p => p.Pct < 85 && p.Pulls > 0))
                    {
                        info.IsChronicDeficit = true;
                    }
                    else if (lastTwo.All(p => p.Pct > 112))
                    {
                        info.IsRepeatSurplus = true;
                    }

                    var lastPct = pcts.Last().Pct;
                    var prevPct = pcts[pcts.Count - 2].Pct;

                    if (info.IsRepeatSurplus || lastPct > 112)
                    {
                        info.TrendStatus = "RISING_SURPLUS";
                        info.TrendBadgeText = info.IsRepeatSurplus ? "Chronic Unrecorded" : "Surplus Spike";
                        info.TrendBadgeClass = "badge text-white";
                        info.TrendIcon = "bi-arrow-up-right";
                    }
                    else if (info.IsChronicDeficit)
                    {
                        info.TrendStatus = "CHRONIC_DEFICIT";
                        info.TrendBadgeText = "Chronic Deficit";
                        info.TrendBadgeClass = "badge bg-danger text-white";
                        info.TrendIcon = "bi-arrow-down-right";
                    }
                    else if (Math.Abs(lastPct - 100) < Math.Abs(prevPct - 100))
                    {
                        info.TrendStatus = "IMPROVING";
                        info.TrendBadgeText = "Improving";
                        info.TrendBadgeClass = "badge bg-success bg-opacity-10 text-success border border-success border-opacity-25";
                        info.TrendIcon = "bi-arrow-up-right";
                    }
                    else if (lastPct < prevPct && lastPct < 90)
                    {
                        info.TrendStatus = "DETERIORATING";
                        info.TrendBadgeText = "Declining";
                        info.TrendBadgeClass = "badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25";
                        info.TrendIcon = "bi-arrow-down-right";
                    }
                    else
                    {
                        info.TrendStatus = "STABLE";
                        info.TrendBadgeText = "Stable";
                        info.TrendBadgeClass = "badge bg-light text-secondary border";
                        info.TrendIcon = "bi-arrow-right";
                    }
                }
            }
        }

        return info;
    }

