    private async Task RenderRankingPerformanceChart()
    {
        if (ActiveTab != "INVENTORY" || _inventorySubTab != "ranking" || _rankingViewMode != "CHART") return;

        try
        {
            var filteredRankingMetrics = GetFilteredAuditRankingMetrics();
            var totalAuditRev = _auditProductMetrics.Where(x => x.Quantity > 0 && IsItemInSelectedCategory(x)).Sum(m => m.Revenue);

            IEnumerable<ProductAuditMetric> sorted = _rankingChartMetric switch
            {
                "VOLUME" => filteredRankingMetrics.OrderByDescending(x => x.Quantity).ThenBy(x => x.Name),
                "SHARE" => filteredRankingMetrics.OrderByDescending(x => x.Revenue).ThenBy(x => x.Name),
                _ => filteredRankingMetrics.OrderByDescending(x => x.Revenue).ThenBy(x => x.Name)
            };

            if (_rankingChartTopLimit > 0)
            {
                sorted = sorted.Take(_rankingChartTopLimit);
            }

            var itemList = sorted.ToList();
            var labels = itemList.Select(x => x.Name.ToUpper()).ToArray();
            var units = itemList.Select(x => x.IsLiquor ? "shots" : "units").ToArray();

            double[] data;
            string datasetLabel;

            if (_rankingChartMetric == "VOLUME")
            {
                data = itemList.Select(x => (double)x.Quantity).ToArray();
                datasetLabel = "Volume Sold (Units/Shots)";
            }
            else if (_rankingChartMetric == "SHARE")
            {
                data = itemList.Select(x => totalAuditRev > 0 ? Math.Round((double)(x.Revenue / totalAuditRev * 100m), 1) : 0).ToArray();
                datasetLabel = "Market Share (%)";
            }
            else
            {
                data = itemList.Select(x => (double)x.Revenue).ToArray();
                datasetLabel = "Gross Revenue ($)";
            }

            await JSRuntime.InvokeVoidAsync("inventoryCharts.renderRankingPerformanceChart", "rankingPerformanceChart", new {
                labels,
                data,
                units,
                datasetLabel,
                metricType = _rankingChartMetric,
                horizontal = _rankingChartHorizontal
            });

            var shareDonutList = filteredRankingMetrics
                .OrderByDescending(x => x.Revenue)
                .Take(7)
                .ToList();

            if (shareDonutList.Any())
            {
                var donutLabels = shareDonutList.Select(x => x.Name.ToUpper()).ToArray();
                var donutData = shareDonutList.Select(x => (double)x.Revenue).ToArray();

                await JSRuntime.InvokeVoidAsync("inventoryCharts.renderRankingShareDonut", "rankingShareDonutChart", new {
                    labels = donutLabels,
                    data = donutData
                });
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine("Error rendering performance ranking chart: " + ex.Message);
        }
    }

