    private string CleanProductName(string rawName)
    {
        if (string.IsNullOrEmpty(rawName)) return "";
        var name = rawName.Trim();
        if (name.StartsWith("> ")) name = name.Substring(2).Trim();
        
        // Preserve Gift Box Token Sale details (e.g. "Mixed Drink Token (Tito's) (TOKEN SALE)")
        if (name.Contains("(TOKEN SALE)"))
        {
            return name.Replace("(TOKEN SALE)", "").Trim();
        }

        int parenIndex = name.IndexOf('(');
        if (parenIndex != -1)
        {
            name = name.Substring(0, parenIndex).Trim();
        }
        return name;
    }

