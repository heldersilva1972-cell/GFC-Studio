                                            {
                                                <div class="bg-white rounded-4 border shadow-sm p-4 mb-4">
                                                    <div class="d-flex align-items-center justify-content-between mb-3">
                                                        <h5 class="fw-black mb-0 text-dark" style="font-size: 0.95rem;">
                                                            <i class="bi bi-gift-fill me-2 text-success"></i>DONATED BEER INVENTORY — REMAINING STOCK
                                                        </h5>
                                                        <span class="badge bg-success-subtle text-success border border-success-subtle fw-bold px-3 py-2" style="font-size: 0.75rem;">
                                                            @selectedGrp.TotalDonatedRemaining total bottles remaining
                                                        </span>
                                                    </div>
                                                    <div class="row g-3">
                                                        @foreach (var stock in selectedGrp.DonatedStock.OrderByDescending(s => s.Remaining))
                                                        {
                                                            var _pct = stock.InitialAvailable > 0 ? (int)Math.Round((double)stock.Remaining / stock.InitialAvailable * 100) : 0;
                                                            <div class="col-md-4 col-sm-6">
                                                                <div class="p-3 rounded-3 border @(stock.Remaining == 0 ? "bg-light opacity-60" : "bg-success-subtle border-success-subtle")">
                                                                    <div class="d-flex justify-content-between align-items-start mb-1">
                                                                        <span class="fw-bold text-dark" style="font-size: 0.88rem;">@stock.BrandName</span>
                                                                        <span class="badge @(stock.Remaining == 0 ? "bg-secondary" : "bg-success") rounded-pill fw-bold" style="font-size: 0.8rem;">
                                                                            @stock.Remaining Left
                                                                        </span>
                                                                    </div>
                                                                    <div class="d-flex justify-content-between text-muted mt-2" style="font-size: 0.75rem;">
                                                                        <span>Total Donated: <strong>@stock.InitialAvailable</strong></span>
                                                                        <span>Consumed: <strong>@stock.Consumed</strong></span>
                                                                    </div>
                                                                    <div class="progress mt-2" style="height: 5px;">
                                                                        <div class="progress-bar @(stock.Remaining == 0 ? "bg-secondary" : "bg-success")" style="width: @_pct%"></div>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        }
                                                    </div>
                                                </div>
                                            }

                                            <!-- BUTTON ACTIONS TO OPEN MODAL WINDOWS -->
                                            <div class="d-flex align-items-center gap-3 flex-wrap my-4">
                                                <button type="button" class="btn btn-primary rounded-pill px-4 py-2.5 fw-bold shadow-sm d-flex align-items-center gap-2" @onclick="() => showTransactionsModal = true">
                                                    <i class="bi bi-receipt fs-5"></i>
                                                    <span>VIEW ASSOCIATED POS TRANSACTIONS</span>
                                                    <span class="badge bg-white text-primary ms-1 rounded-pill">@evSales.Count Sales</span>
                                                </button>

                                                <button type="button" class="btn btn-info text-white rounded-pill px-4 py-2.5 fw-bold shadow-sm d-flex align-items-center gap-2" style="background-color: #0284c7; border-color: #0284c7;" @onclick="() => showDailyUsageModal = true">
                                                    <i class="bi bi-bar-chart-line-fill fs-5"></i>
                                                    <span>VIEW DAILY BOTTLE USAGE GRAPH</span>
                                                    <span class="badge bg-white text-dark ms-1 rounded-pill">@selectedGrp.TotalDonatedConsumed Consumed</span>
                                                </button>

                                                @if (selectedGrp.Distributions.Any())
                                                {
                                                    <button type="button" class="btn btn-success rounded-pill px-4 py-2.5 fw-bold shadow-sm d-flex align-items-center gap-2" @onclick="() => showDistributionsModal = true">
                                                        <i class="bi bi-gift-fill fs-5"></i>
                                                        <span>VIEW PRIZES &amp; DISTRIBUTION LOG</span>
                                                        <span class="badge bg-white text-success ms-1 rounded-pill">@selectedGrp.TotalDonatedDistributed Bottles</span>
                                                    </button>
                                                }
                                            </div>
                                        }
                                        else
                                        {
                                            <!-- STANDARD BAR TAB EVENT (PRE-PAID OR RUNNING TAB WITH CASH/CARD SPEND) -->
                                            <div class="bg-white rounded-4 border p-4 mb-4 shadow-sm">
                                                <div class="d-flex justify-content-between align-items-start mb-3">
                                                    <div>
                                                        <div class="d-flex align-items-center gap-2 mb-1">
                                                            <span class="badge @(selectedGrp.Status == GFC.Core.Enums.EventTabStatus.Open ? "bg-success text-white" : "bg-secondary text-white") rounded-pill px-3 py-1 fw-bold" style="font-size: 0.75rem;">
                                                                @selectedGrp.Status.ToString().ToUpper()
                                                            </span>
                                                            <span class="badge bg-primary-subtle text-primary fw-bold border border-primary-subtle px-3 py-1" style="font-size: 0.75rem;">
                                                                @selectedGrp.Type.ToString().ToUpper()
                                                            </span>
                                                            @if (selectedGrp.IsRecurring)
                                                            {
                                                                <span class="badge bg-info text-white rounded-pill px-2 py-1" style="font-size: 0.7rem;">RECURRING</span>
                                                            }
                                                        </div>
                                                        <h2 class="fw-black mb-1 text-dark">@selectedGrp.Name</h2>
                                                        @if (!string.IsNullOrEmpty(selectedGrp.RecipientName))
                                                        {
                                                            <div class="text-muted fw-bold mb-1" style="font-size: 0.88rem;">
                                                                <i class="bi bi-person-fill me-1 text-primary"></i>Recipient: @selectedGrp.RecipientName
                                                            </div>
                                                        }
                                                    </div>
                                                </div>
                                                
                                                @if (selectedGrp.Type == GFC.Core.Enums.EventTabType.PrePaid)
                                                {
                                                    <div class="row g-3">
                                                        <!-- ACCOUNT FUNDING -->
                                                        <div class="col-md-4">
                                                            <div class="p-3 bg-light rounded-4 border h-100 shadow-xs">
                                                                <div class="d-flex align-items-center justify-content-between mb-2">
                                                                    <span class="text-uppercase fw-black small text-primary" style="font-size: 0.7rem; letter-spacing: 0.5px;">
                                                                        <i class="bi bi-wallet2 me-1"></i>ACCOUNT FUNDING
                                                                    </span>
                                                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle fw-bold" style="font-size: 0.72rem;">
                                                                        TOTAL: @selectedGrp.TotalFunding.ToString("C")
                                                                    </span>
                                                                </div>
                                                                <div class="row g-2 pt-1">
                                                                    <div class="col-6">
                                                                        <div class="bg-white p-2.5 rounded-3 border">
                                                                            <div class="text-muted fw-bold" style="font-size: 0.65rem;">INITIAL DEPOSIT</div>
                                                                            <div class="fs-5 fw-black text-dark">@selectedGrp.InitialPrepaid.ToString("C")</div>
                                                                        </div>
                                                                    </div>
                                                                    <div class="col-6">
                                                                        <div class="bg-white p-2.5 rounded-3 border">
                                                                            <div class="text-muted fw-bold" style="font-size: 0.65rem;">ADDED TOP-UPS</div>
                                                                            <div class="fs-5 fw-black text-success">@(selectedGrp.AddedFunds > 0 ? $"+{selectedGrp.AddedFunds:C}" : "$0.00")</div>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>

                                                        <!-- SPEND & BALANCE -->
                                                        <div class="col-md-4">
                                                            <div class="p-3 bg-light rounded-4 border h-100 shadow-xs">
                                                                <div class="d-flex align-items-center justify-content-between mb-2">
                                                                    <span class="text-uppercase fw-black small text-dark" style="font-size: 0.7rem; letter-spacing: 0.5px;">
                                                                        <i class="bi bi-pie-chart-fill me-1 text-warning"></i>SPEND &amp; BALANCE
                                                                    </span>
                                                                </div>
                                                                <div class="row g-2 pt-1">
                                                                    <div class="col-6">
                                                                        <div class="bg-white p-2.5 rounded-3 border">
                                                                            <div class="text-muted fw-bold" style="font-size: 0.65rem;">PREPAID USED</div>
                                                                            <div class="fs-5 fw-black text-dark">@selectedGrp.NetSpend.ToString("C")</div>
                                                                        </div>
                                                                    </div>
                                                                    <div class="col-6">
                                                                        <div class="bg-white p-2.5 rounded-3 border">
                                                                            <div class="text-muted fw-bold" style="font-size: 0.65rem;">REMAINING BAL</div>
                                                                            <div class="fs-5 fw-black @(selectedGrp.RemainingBalance <= 0 ? "text-danger" : "text-success")">
                                                                                @selectedGrp.RemainingBalance.ToString("C")
                                                                            </div>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>

                                                        <!-- ACTIVITY & VOLUME -->
                                                        <div class="col-md-4">
                                                            <div class="p-3 bg-light rounded-4 border h-100 shadow-xs">
                                                                <div class="d-flex align-items-center justify-content-between mb-2">
                                                                    <span class="text-uppercase fw-black small text-secondary" style="font-size: 0.7rem; letter-spacing: 0.5px;">
                                                                        <i class="bi bi-receipt me-1"></i>ACTIVITY &amp; VOLUME
                                                                    </span>
                                                                </div>
                                                                <div class="row g-2 pt-1">
                                                                    <div class="col-6">
                                                                        <div class="bg-white p-2.5 rounded-3 border">
                                                                            <div class="text-muted fw-bold" style="font-size: 0.65rem;">SALES ORDERS</div>
                                                                            <div class="fs-5 fw-black text-dark">@selectedGrp.DrinkSalesCount</div>
                                                                        </div>
                                                                    </div>
                                                                    <div class="col-6">
                                                                        <div class="bg-white p-2.5 rounded-3 border">
                                                                            <div class="text-muted fw-bold" style="font-size: 0.65rem;">DRINKS SOLD</div>
                                                                            <div class="fs-5 fw-black text-primary">@selectedGrp.TotalDrinksCount</div>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                }
                                                else if (selectedGrp.Type == GFC.Core.Enums.EventTabType.RunningTab)
                                                {
                                                    <div class="row g-3">
                                                        <div class="col-md-6">
                                                            <div class="p-3 bg-primary-subtle rounded-3 border border-primary-subtle">
                                                                <div class="text-primary fw-bold small text-uppercase mb-1" style="font-size: 0.68rem;">
                                                                    <i class="bi bi-journal-check me-1"></i>TOTAL TAB SALES (ACCUMULATED)
                                                                </div>
                                                                <div class="fs-3 fw-black text-primary">@selectedGrp.TotalSpent.ToString("C")</div>
                                                                <div class="small text-muted" style="font-size: 0.65rem;">Total charges on running tab</div>
                                                            </div>
                                                        </div>
                                                        <div class="col-md-6">
                                                            <div class="p-3 bg-light rounded-3 border">
                                                                <div class="text-muted fw-bold small text-uppercase mb-1" style="font-size: 0.68rem;">
                                                                    <i class="bi bi-receipt me-1 text-secondary"></i>TRANSACTIONS &amp; DRINKS
                                                                </div>
                                                                <div class="fs-3 fw-black text-dark mb-0">@evSales.Count <span class="fs-6 fw-normal text-muted">orders</span></div>
                                                                <div class="small text-primary fw-bold mt-1" style="font-size: 0.72rem;">
                                                                    <i class="bi bi-cup-straw me-1"></i>@selectedGrp.TotalDrinksCount total drinks/items sold
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                }
                                            </div>

                                            <!-- BUTTON ACTIONS TO OPEN MODAL WINDOWS -->
                                            <div class="d-flex align-items-center gap-3 flex-wrap my-4">
                                                <button type="button" class="btn btn-primary rounded-pill px-4 py-2.5 fw-bold shadow-sm d-flex align-items-center gap-2" @onclick="() => showTransactionsModal = true">
                                                    <i class="bi bi-receipt fs-5"></i>
                                                    <span>VIEW ASSOCIATED POS TRANSACTIONS</span>
                                                    <span class="badge bg-white text-primary ms-1 rounded-pill">@evSales.Count Sales</span>
                                                </button>

                                                <button type="button" class="btn btn-info text-white rounded-pill px-4 py-2.5 fw-bold shadow-sm d-flex align-items-center gap-2" style="background-color: #0284c7; border-color: #0284c7;" @onclick="() => showDailyUsageModal = true">
                                                    <i class="bi bi-bar-chart-line-fill fs-5"></i>
                                                    <span>VIEW DAILY BOTTLE USAGE GRAPH</span>
                                                    <span class="badge bg-white text-dark ms-1 rounded-pill">@selectedGrp.TotalDonatedConsumed Consumed</span>
                                                </button>

                                                @if (selectedGrp.Distributions.Any())
                                                {
                                                    <button type="button" class="btn btn-success rounded-pill px-4 py-2.5 fw-bold shadow-sm d-flex align-items-center gap-2" @onclick="() => showDistributionsModal = true">
                                                        <i class="bi bi-gift-fill fs-5"></i>
                                                        <span>VIEW PRIZES &amp; DISTRIBUTION LOG</span>
                                                        <span class="badge bg-white text-success ms-1 rounded-pill">@selectedGrp.TotalDonatedDistributed Bottles</span>
                                                    </button>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <div class="d-flex flex-column align-items-center justify-content-center h-100 p-5 text-center text-muted">
                                        <div class="p-4 bg-light rounded-circle mb-3">
                                            <i class="bi bi-calendar-event text-primary opacity-75" style="font-size: 3rem;"></i>
                                        </div>
                                        <h4 class="fw-black text-dark mb-2">POS Event Audit Workspace</h4>
                                        <p class="text-muted" style="max-width: 450px;">Select an event tab above to view its financial summary, budget breakdown, and complete list of POS sales transactions.</p>
                                    </div>
                                }
                            </div>
                        </div>

                        @if (showTransactionsModal && selectedGrp != null)
                        {
                            var evSales = selectedGrp.Sales;
                            var latestEv = selectedGrp.LatestEvent;

                            <!-- MODAL WINDOW: ASSOCIATED POS TRANSACTIONS -->
                            <div class="modal fade show" tabindex="-1" style="display: block; background: rgba(15, 23, 42, 0.6); backdrop-filter: blur(4px); z-index: 1060;" role="dialog">
                                <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
                                    <div class="modal-content rounded-4 border-0 shadow-lg overflow-hidden">
                                        <div class="modal-header bg-light border-bottom px-4 py-3">
                                            <div class="d-flex align-items-center gap-2">
                                                <div class="p-2 bg-primary text-white rounded-3">
                                                    <i class="bi bi-receipt fs-5"></i>
                                                </div>
                                                <div>
                                                    <h5 class="modal-title fw-black text-dark mb-0" style="font-size: 1.05rem;">
                                                        ASSOCIATED POS TRANSACTIONS — @selectedGrp.Name.ToUpper()
                                                    </h5>
                                                    <span class="small text-muted fw-bold">@evSales.Count Total Transactions Recorded</span>
                                                </div>
                                            </div>
                                            <button type="button" class="btn-close" @onclick="() => showTransactionsModal = false"></button>
                                        </div>
                                        <div class="modal-body p-0">
                                            <div class="table-responsive">
                                                <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
                                                    <thead class="bg-light text-muted fw-bold sticky-top" style="font-size: 0.72rem; letter-spacing: 0.5px;">
                                                        <tr>
                                                            <th class="ps-4 py-3">DATE / TIME</th>
                                                            <th class="py-3">EVENT NAME</th>
                                                            <th class="py-3">ITEMS / QUANTITY REMOVED</th>
                                                            <th class="py-3">BARTENDER</th>
                                                            <th class="py-3">TERMINAL</th>
                                                            <th class="py-3 text-end">CLUB PORTION</th>
                                                            <th class="py-3 text-end">EVENT PORTION</th>
                                                            <th class="py-3 text-end">TOTAL AMOUNT</th>
                                                            <th class="pe-4 py-3 text-center">ACTION</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @if (!evSales.Any())
                                                        {
                                                            <tr>
                                                                <td colspan="9" class="text-center py-5 text-muted">
                                                                    <i class="bi bi-inbox fs-2 opacity-50 d-block mb-2"></i>
                                                                    <div>No sales recorded for this event yet.</div>
                                                                </td>
                                                            </tr>
                                                        }
                                                        else
                                                        {
                                                            @foreach (var sale in evSales)
                                                            {
                                                                var isDepositSale = sale.PaymentType == "DEPOSIT" || (!string.IsNullOrEmpty(sale.ItemsJson) && (sale.ItemsJson.Contains("INITIAL DEPOSIT") || sale.ItemsJson.Contains("TAB DEPOSIT") || sale.ItemsJson.Contains("ADDED FUNDS")));
                                                                var (clubPart, eventPart) = GetSalePortions(sale, latestEv);
                                                                var totalRow = isDepositSale ? sale.TotalAmount : (clubPart + eventPart);
                                                                <tr>
                                                                    <td class="ps-4 py-3">
                                                                        <div class="fw-bold text-dark">@sale.Timestamp.ToString("ddd, MMM dd, yyyy")</div>
                                                                        <div class="small text-muted">@sale.Timestamp.ToString("h:mm:ss tt")</div>
                                                                    </td>
                                                                    <td class="py-3">
                                                                        <span class="badge bg-primary text-white fw-bold px-2.5 py-1 rounded-pill" style="font-size: 0.72rem; letter-spacing: 0.3px;">
                                                                            <i class="bi bi-journal-check me-1"></i>@(GetEventNameForSale(sale))
                                                                        </span>
                                                                    </td>
                                                                    <td class="py-3">
                                                                        @{
                                                                            var items = GetItemsList(sale.ItemsJson);
                                                                            if (items != null && items.Any())
                                                                            {
                                                                                <div class="d-flex flex-column gap-1">
                                                                                    @foreach (var item in items.Where(i => i != null && !string.IsNullOrEmpty(i.Name)))
                                                                                    {
                                                                                        var isDonatedPrefix = item.Name.StartsWith("DONATED:", StringComparison.OrdinalIgnoreCase);
                                                                                        var isTally = item.Name.StartsWith("TALLY:", StringComparison.OrdinalIgnoreCase);
                                                                                        var cleanName = isTally ? item.Name.Substring(6).Trim() : (isDonatedPrefix ? item.Name.Substring(8).Trim() : item.Name);
                                                                                        
                                                                                        <div class="d-flex align-items-center gap-1.5 flex-wrap">
                                                                                            <span class="badge bg-light text-dark border fw-bold px-2 py-0.5 rounded-pill" style="font-size: 0.75rem;">
                                                                                                @(item.Quantity)x @cleanName
                                                                                            </span>
                                                                                            @if (clubPart == 0 && eventPart == 0 && item.Price == 0)
                                                                                            {
                                                                                                <span class="badge bg-warning text-dark border border-warning fw-bold px-2 py-0.5 rounded-pill" style="font-size: 0.68rem;">
                                                                                                    <i class="bi bi-gift-fill me-1 text-dark"></i>Donated Prize ($0.00)
                                                                                                </span>
                                                                                            }
                                                                                        </div>
                                                                                    }
                                                                                </div>
                                                                            }
                                                                            else
                                                                            {
                                                                                <span class="text-muted small">General Sale</span>
                                                                            }
                                                                        }
                                                                    </td>
                                                                    <td class="py-3 fw-bold text-dark">@sale.BartenderName</td>
                                                                    <td class="py-3 text-muted">@sale.TerminalName</td>
                                                                    <td class="py-3 text-end fw-bold text-dark" style="font-size: 0.85rem;">
                                                                        @(isDepositSale ? "+" : "")@clubPart.ToString("C")
                                                                    </td>
                                                                    <td class="py-3 text-end fw-bold text-success" style="font-size: 0.85rem;">
                                                                        @(eventPart > 0 ? $"+{eventPart:C}" : "$0.00")
                                                                    </td>
                                                                    <td class="py-3 text-end fw-black @(isDepositSale ? "text-success" : "text-primary") fs-6">
                                                                        @(isDepositSale ? "+" : "")@totalRow.ToString("C")
                                                                    </td>
                                                                    <td class="pe-4 py-3 text-center">
                                                                        <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-3 fw-bold" style="font-size: 0.72rem;" @onclick="() => SelectedSale = sale">
                                                                            <i class="bi bi-eye me-1"></i> VIEW RECEIPT
                                                                        </button>
                                                                    </td>
                                                                </tr>
                                                            }
                                                        }
                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>
                                        <div class="modal-footer bg-light border-top px-4 py-2.5 d-flex justify-content-between">
                                            <div class="small text-muted fw-bold">
                                                Total Sales Value: <strong class="text-primary fs-6">@evSales.Sum(s => s.TotalAmount).ToString("C")</strong>
                                            </div>
                                            <button type="button" class="btn btn-secondary rounded-pill px-4 fw-bold" @onclick="() => showTransactionsModal = false">Close</button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }

                        @if (showDistributionsModal && selectedGrp != null)
                        {
                            <!-- MODAL WINDOW: PRIZES & RE-DONATED BEER DISTRIBUTION LOG -->
                            <div class="modal fade show" tabindex="-1" style="display: block; background: rgba(15, 23, 42, 0.6); backdrop-filter: blur(4px); z-index: 1060;" role="dialog">
                                <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
                                    <div class="modal-content rounded-4 border-0 shadow-lg overflow-hidden">
                                        <div class="modal-header bg-light border-bottom px-4 py-3">
                                            <div class="d-flex align-items-center gap-2">
                                                <div class="p-2 bg-success text-white rounded-3">
                                                    <i class="bi bi-gift-fill fs-5"></i>
                                                </div>
                                                <div>
                                                    <h5 class="modal-title fw-black text-dark mb-0" style="font-size: 1.05rem;">
                                                        PRIZES &amp; RE-DONATED BEER DISTRIBUTION LOG — @selectedGrp.Name.ToUpper()
                                                    </h5>
                                                    <span class="small text-muted fw-bold">@selectedGrp.TotalDonatedDistributed Total Bottles Distributed</span>
                                                </div>
                                            </div>
                                            <button type="button" class="btn-close" @onclick="() => showDistributionsModal = false"></button>
                                        </div>
                                        <div class="modal-body p-0">
                                            <div class="table-responsive">
                                                <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
                                                    <thead class="bg-light text-muted fw-bold sticky-top" style="font-size: 0.72rem; letter-spacing: 0.5px;">
                                                        <tr>
                                                            <th class="ps-4 py-3">DATE / TIME</th>
                                                            <th class="py-3">ACTION TYPE</th>
                                                            <th class="py-3">BEER BRAND</th>
                                                            <th class="py-3 text-center">QUANTITY</th>
                                                            <th class="py-3">RECIPIENT / BENEFICIARY</th>
                                                            <th class="pe-4 py-3 text-center">INVENTORY STATUS</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @if (!selectedGrp.Distributions.Any())
                                                        {
                                                            <tr>
                                                                <td colspan="6" class="text-center py-5 text-muted">
                                                                    <i class="bi bi-gift fs-2 opacity-50 d-block mb-2"></i>
                                                                    <div>No prize checkout or re-donation records found for this event.</div>
                                                                </td>
                                                            </tr>
                                                        }
                                                        else
                                                        {
                                                            @foreach (var dist in selectedGrp.Distributions)
                                                            {
                                                                var isPrize = dist.ActionType == "prize";
                                                                <tr>
                                                                    <td class="ps-4 py-3">
                                                                        <div class="fw-bold text-dark">@dist.Timestamp.ToString("ddd, MMM dd, yyyy")</div>
                                                                        <div class="small text-muted">@dist.Timestamp.ToString("h:mm:ss tt")</div>
                                                                    </td>
                                                                    <td class="py-3">
                                                                        @if (isPrize)
                                                                        {
                                                                            <span class="badge bg-warning text-dark border border-warning fw-bold px-2.5 py-1 rounded-pill" style="font-size: 0.72rem;">
                                                                                <i class="bi bi-trophy-fill me-1 text-dark"></i>Winner Prize
                                                                            </span>
                                                                        }
                                                                        else
                                                                        {
                                                                            <span class="badge bg-success text-white fw-bold px-2.5 py-1 rounded-pill" style="font-size: 0.72rem;">
                                                                                <i class="bi bi-gift-fill me-1"></i>Re-Donated to Event
                                                                            </span>
                                                                        }
                                                                    </td>
                                                                    <td class="py-3 fw-bold text-dark">@dist.BeerName</td>
                                                                    <td class="py-3 text-center fw-black text-primary">
                                                                        @dist.Cans bottles <span class="text-muted fw-normal small">(@dist.Cases @(dist.Cases == 1 ? "case" : "cases"))</span>
                                                                    </td>
                                                                    <td class="py-3">
                                                                        @if (!string.IsNullOrEmpty(dist.RecipientEventName))
                                                                        {
                                                                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle fw-bold">
                                                                                <i class="bi bi-calendar-event me-1"></i>@dist.RecipientEventName
                                                                            </span>
                                                                        }
                                                                        else
                                                                        {
                                                                            <span class="text-muted small">Tournament Winner</span>
                                                                        }
                                                                    </td>
                                                                    <td class="pe-4 py-3 text-center">
                                                                        <span class="badge bg-light text-muted border fw-bold">
                                                                            @(isPrize ? $"Checked Out (-{dist.Cans} btls)" : "Transferred to Recipient")
                                                                        </span>
                                                                    </td>
                                                                </tr>
                                                            }
                                                        }
                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>
                                        <div class="modal-footer bg-light border-top px-4 py-2.5 d-flex justify-content-between">
                                            <div class="small text-muted fw-bold">
                                                Total Distributed: <strong class="text-success fs-6">@selectedGrp.TotalDonatedDistributed bottles</strong>
                                            </div>
                                            <button type="button" class="btn btn-secondary rounded-pill px-4 fw-bold" @onclick="() => showDistributionsModal = false">Close</button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }

                        @if (showDailyUsageModal && selectedGrp != null)
                        {
                            <!-- MODAL WINDOW: DAILY BOTTLE USAGE GRAPH -->
                            var dailyUsages = GetDailyBottleUsage(selectedGrp);
                            var maxUsageDay = dailyUsages.Any() ? Math.Max(1, dailyUsages.Max(d => d.TotalBottles)) : 1;
                            var totalUsageAllDays = dailyUsages.Sum(d => d.TotalBottles);

                            <div class="modal fade show" tabindex="-1" style="display: block; background: rgba(15, 23, 42, 0.6); backdrop-filter: blur(4px); z-index: 1060;" role="dialog">
                                <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
                                    <div class="modal-content rounded-4 border-0 shadow-lg overflow-hidden">
                                        <div class="modal-header bg-light border-bottom px-4 py-3">
                                            <div class="d-flex align-items-center gap-2">
                                                <div class="p-2 text-white rounded-3" style="background-color: #0284c7;">
                                                    <i class="bi bi-bar-chart-line-fill fs-5"></i>
                                                </div>
                                                <div>
                                                    <h5 class="modal-title fw-black text-dark mb-0" style="font-size: 1.05rem;">
                                                        DAILY BOTTLE USAGE GRAPH — @selectedGrp.Name.ToUpper()
                                                    </h5>
                                                    <span class="small text-muted fw-bold">Showing only active days with recorded consumption (@dailyUsages.Count active days)</span>
                                                </div>
                                            </div>
                                            <button type="button" class="btn-close" @onclick="() => showDailyUsageModal = false"></button>
                                        </div>
                                        <div class="modal-body p-4 bg-light">
                                            @if (!dailyUsages.Any())
                                            {
                                                <div class="text-center py-5 text-muted bg-white rounded-4 border p-4">
                                                    <i class="bi bi-bar-chart fs-1 opacity-50 d-block mb-2 text-primary"></i>
                                                    <h6 class="fw-bold text-dark">No Bottle Consumption Found</h6>
                                                    <p class="small text-muted mb-0">There are no daily bottle tally deductions or sales recorded for this event yet.</p>
                                                </div>
                                            }
                                            else
                                            {
                                                <!-- TOP METRICS SUMMARY -->
                                                <div class="row g-3 mb-4">
                                                    <div class="col-sm-3">
                                                        <div class="p-3 bg-white rounded-3 border text-center shadow-xs">
                                                            <div class="text-muted fw-bold small text-uppercase" style="font-size: 0.65rem;">Active Days</div>
                                                            <div class="fs-4 fw-black text-dark">@dailyUsages.Count</div>
                                                            <div class="small text-muted" style="font-size: 0.65rem;">Days with usage</div>
                                                        </div>
                                                    </div>
                                                    <div class="col-sm-3">
                                                        <div class="p-3 bg-white rounded-3 border text-center shadow-xs">
                                                            <div class="text-muted fw-bold small text-uppercase" style="font-size: 0.65rem;">Total Consumed</div>
                                                            <div class="fs-4 fw-black text-primary">@totalUsageAllDays</div>
                                                            <div class="small text-muted" style="font-size: 0.65rem;">@((totalUsageAllDays / 24.0).ToString("0.0")) cases</div>
                                                        </div>
                                                    </div>
                                                    <div class="col-sm-3">
                                                        <div class="p-3 bg-white rounded-3 border text-center shadow-xs">
                                                            <div class="text-muted fw-bold small text-uppercase" style="font-size: 0.65rem;">Daily Average</div>
                                                            <div class="fs-4 fw-black text-success">@((dailyUsages.Count > 0 ? (totalUsageAllDays / (double)dailyUsages.Count) : 0).ToString("0.0"))</div>
                                                            <div class="small text-muted" style="font-size: 0.65rem;">Bottles / active day</div>
                                                        </div>
                                                    </div>
                                                    <div class="col-sm-3">
                                                        <div class="p-3 bg-white rounded-3 border text-center shadow-xs">
                                                            <div class="text-muted fw-bold small text-uppercase" style="font-size: 0.65rem;">Peak Day Volume</div>
                                                            <div class="fs-4 fw-black text-danger">@maxUsageDay</div>
                                                            <div class="small text-muted" style="font-size: 0.65rem;">Highest single day</div>
                                                        </div>
                                                    </div>
                                                </div>

                                                <!-- DAILY VISUAL BAR GRAPH -->
                                                <div class="d-flex flex-column gap-3">
                                                    @foreach (var day in dailyUsages)
                                                    {
                                                        var percentOfMax = Math.Max(6, (int)Math.Round((double)day.TotalBottles / maxUsageDay * 100.0));
                                                        var percentOfTotal = totalUsageAllDays > 0 ? (day.TotalBottles / (double)totalUsageAllDays * 100.0) : 0;

                                                        <div class="p-3 bg-white rounded-4 border shadow-xs">
                                                            <div class="d-flex justify-content-between align-items-center mb-2">
                                                                <div class="d-flex align-items-center gap-2">
                                                                    <span class="badge px-3 py-1.5 rounded-pill fw-bold text-white shadow-xs" style="font-size: 0.8rem; background-color: #0284c7;">
                                                                        <i class="bi bi-calendar-check me-1"></i>@day.Date.ToString("dddd, MMM dd, yyyy")
                                                                    </span>
                                                                    <span class="text-muted small">(@percentOfTotal.ToString("0.0")% of event volume)</span>
                                                                </div>
                                                                <div class="d-flex align-items-baseline gap-1">
                                                                    <span class="fs-4 fw-black text-primary">@day.TotalBottles</span>
                                                                    <span class="fw-bold text-muted small">bottles</span>
                                                                    <span class="text-muted small ms-1">(@((day.TotalBottles / 24.0).ToString("0.0")) cs)</span>
                                                                </div>
                                                            </div>

                                                            <!-- Bar Visualizer -->
                                                            <div class="progress mb-2.5" style="height: 14px; border-radius: 8px; background-color: #e2e8f0;">
                                                                <div class="progress-bar progress-bar-striped progress-bar-animated" 
                                                                     role="progressbar" 
                                                                     style="width: @percentOfMax%; background-color: #0284c7;">
                                                                </div>
                                                            </div>

                                                            <!-- Brand Item Breakdown -->
                                                            <div class="d-flex align-items-center gap-2 flex-wrap pt-2 border-top">
                                                                <span class="text-muted fw-bold text-uppercase" style="font-size: 0.68rem; letter-spacing: 0.3px;">Brands Consumed:</span>
                                                                @foreach (var (brand, count) in day.BrandBreakdown.OrderByDescending(b => b.Value))
                                                                {
                                                                    <span class="badge bg-light text-dark border px-2.5 py-1 rounded-pill fw-bold" style="font-size: 0.75rem;">
                                                                        @brand: <strong class="text-primary">@count</strong> btls
                                                                    </span>
                                                                }
                                                            </div>
                                                        </div>
                                                    }
                                                </div>
                                            }
                                        </div>
                                        <div class="modal-footer bg-light border-top px-4 py-2.5 d-flex justify-content-between">
                                            <div class="small text-muted fw-bold">
                                                Total Days Shown: <strong class="text-dark">@dailyUsages.Count days</strong> (<strong class="text-primary">@totalUsageAllDays bottles total</strong>)
                                            </div>
                                            <button type="button" class="btn btn-secondary rounded-pill px-4 fw-bold" @onclick="() => showDailyUsageModal = false">Close</button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    else if (ActiveTab == "FOOD")
                    {
                        var allFoodSummary = GetFoodSummaryResults().ToList();
                        var filteredFoodSummary = GetFilteredFoodSummaryList();
                        var isFoodFiltered = _foodCategoryFilter != "ALL" || !string.IsNullOrWhiteSpace(_foodSearchText);

                        var totalFoodRev = isFoodFiltered ? filteredFoodSummary.Sum(x => x.Revenue) : allFoodSummary.Sum(x => x.Revenue);
                        var totalFoodQty = isFoodFiltered ? filteredFoodSummary.Sum(x => x.Quantity) : allFoodSummary.Sum(x => x.Quantity);
                        var totalAllRev = _allSalesForStats.Sum(s => s.TotalAmount);
                        var foodPercentOfTotal = totalAllRev > 0 ? (totalFoodRev / totalAllRev) * 100 : 0;
                        var distinctItemsCount = isFoodFiltered ? filteredFoodSummary.Count : allFoodSummary.Count;

                        <div class="d-flex flex-column w-100 h-100 overflow-hidden" style="background: #f8fafc;">
                            <!-- Header & Filter Strip -->
                            <div class="px-4 py-3 bg-white border-bottom flex-shrink-0 shadow-xs">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="p-2 rounded-3 border" style="background-color: #fffbeb; border-color: #fde68a !important; color: #b45309;">
                                            <i class="bi bi-egg-fried fs-4"></i>
                                        </div>
                                        <div>
                                            <h4 class="fw-black mb-0 text-dark" style="letter-spacing: -0.5px;">FOOD &amp; SNACKS AUDIT</h4>
