        else if (tab == "stock" || tab == "ledger")
        {
            if (ActivePreset == "thismonth")
            {
                await SetPreset("today");
            }
            else
            {
                if (tab == "stock" && _stockViewMode == "VISUAL")
                {
                    await Task.Delay(100);
                    await RenderStockLevelsChart();
                }
                StateHasChanged();
            }
        }
