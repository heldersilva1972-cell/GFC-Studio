    {
        get
        {
            var groups = BuildEventGroups().AsEnumerable();
            if (EventStatusFilter == "OPEN")
            {
                groups = groups.Where(g => g.Status == GFC.Core.Enums.EventTabStatus.Open);
            }
            else if (EventStatusFilter == "CLOSED")
            {
                groups = groups.Where(g => g.Status == GFC.Core.Enums.EventTabStatus.Closed);
            }

            if (!string.IsNullOrWhiteSpace(EventSearchQuery))
            {
                groups = groups.Where(g => g.Name.Contains(EventSearchQuery, StringComparison.OrdinalIgnoreCase) ||
                                           (!string.IsNullOrEmpty(g.RecipientName) && g.RecipientName.Contains(EventSearchQuery, StringComparison.OrdinalIgnoreCase)));
            }

            return groups;
        }
    }

