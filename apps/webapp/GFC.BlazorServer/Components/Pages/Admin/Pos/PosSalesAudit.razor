    private async Task SaveReclaimAction()
    {
        if (_reclaimTargetEntry == null || _reclaimQuantityInput <= 0) return;
        
        int qty = Math.Min(_reclaimQuantityInput, _reclaimTargetEntry.LegacyRedeemed);
        if (qty <= 0) return;

        string status = "";
        string note = "";

        if (_reclaimOption == "RECLAIM_TO_STOCK")
        {
            status = "LEGACY_RECLAIMED";
            note = $"Reclaimed {qty} returned legacy chips into active re-sellable stock. {(_reclaimNotesInput)}".Trim();
        }
        else
        {
            status = "LEGACY_RETIRED";
            note = $"Permanently retired/disposed of {qty} old legacy chips, removing them from circulation. {(_reclaimNotesInput)}".Trim();
        }

        using var db = DbFactory.CreateDbContext();
        var log = new TokenAuditLogEntry
        {
            Timestamp = DateTime.Now,
            TokenName = _reclaimTargetEntry.Token.Name ?? "Token",
            ExpectedStock = _reclaimTargetEntry.ExpectedPhysicalStock,
            ActualCount = _reclaimTargetEntry.ExpectedPhysicalStock,
            Variance = qty,
            Status = status,
            Notes = note,
            PerformedBy = _currentUser?.Username ?? "Manager"
        };
        db.TokenAuditLogs.Add(log);
        await db.SaveChangesAsync();
        
        await CalculateLifetimeTokens(db);
        await CalculateTokenAnalysis(db);
        _showReclaimModal = false;
        StateHasChanged();
    }

    private async Task CalculateTokenAnalysis(GfcDbContext db)
    {
        TokenAuditLogs = await db.TokenAuditLogs.OrderByDescending(l => l.Timestamp).ToListAsync();
        MasterTokens = await db.PosTokens.AsNoTracking().ToListAsync();
        TokenYields.Clear();
        TokenUsages.Clear();
        TokenSalesList.Clear();

        List<PosSale> allSales;
        if (TokenFilterMode == "SINCE_AUG_1")
        {
            allSales = await db.PosSales.AsNoTracking().Where(s => s.Timestamp >= TokenTrackingStartDate).ToListAsync();
        }
        else if (TokenFilterMode == "LIFETIME")
        {
            allSales = await db.PosSales.AsNoTracking().ToListAsync();
        }
        else
        {
            if (_allSalesForStats != null && _allSalesForStats.Any())
            {
                allSales = _allSalesForStats;
            }
            else
            {
                var st = StartDate.Date.AddHours(3);
                var en = EndDate.Date.AddDays(1).AddHours(3);
                var salesQuery = db.PosSales.AsNoTracking().Where(s => s.Timestamp >= st && s.Timestamp < en);
                if (!string.IsNullOrEmpty(FilterTerminal))
                {
                    salesQuery = salesQuery.Where(s => s.TerminalName == FilterTerminal);
                }
                allSales = await salesQuery.ToListAsync();
            }
        }
        
        bool isLifetime = TokenFilterMode == "LIFETIME";
        var stats = MasterTokens.Where(t => t.Name != null)
                                .GroupBy(t => t.Name)
                                .ToDictionary(g => g.Key, g => new TokenYieldEntry { Token = g.First(), IsLifetimeMode = isLifetime });

        foreach (var sale in allSales)
        {
            var items = GetItemsList(sale.ItemsJson);
            foreach (var item in items)
            {
                // SALE
                bool isTokenSale = item.Category == "TOKENS" || 
                                   item.Category == "TOKEN" || 
                                   (item.Name ?? "").ToUpper().Contains("TOKEN SALE") || 
                                   (MasterTokens.Any(t => t.Name != null && (item.Name ?? "").ToUpper().Contains(t.Name.ToUpper())) && !item.IsTokenApplied && !(item.Name ?? "").Contains("(TOKEN") && !(item.Name ?? "").Contains("(CREDITED"));

                if (isTokenSale)
                {
                    var match = MasterTokens.OrderByDescending(t => t.Name.Length).FirstOrDefault(t => (item.Name ?? "").ToUpper().Contains(t.Name.ToUpper()));
                    if (match != null && stats.ContainsKey(match.Name)) 
                    {
                        stats[match.Name].Sold += item.Quantity;
                        stats[match.Name].ActualCashCollected += item.Price * item.Quantity;
                    }

                    string rawName = item.Name ?? "";
                    if (rawName.StartsWith("> ")) rawName = rawName.Substring(2).Trim();
                    string cleanSaleName = rawName.Contains("(TOKEN SALE)") ? rawName.Replace("(TOKEN SALE)", "").Trim() : CleanProductName(rawName);

                    TokenSalesList.Add(new TokenSaleRecord {
                        ItemName = cleanSaleName,
                        TerminalName = sale.TerminalName ?? "POS Station",
                        Quantity = item.Quantity,
                        UnitPrice = item.Price,
                        Timestamp = sale.Timestamp
                    });
                }

                // REDEMPTION or CREDIT
                bool isRedem = item.IsTokenApplied || 
                               (item.Name ?? "").Contains("(TOKEN") || 
                               (item.Name ?? "").Contains("(CREDITED") || 
                               item.Category == "TOKEN_CREDIT";
                
                if (isRedem)
                {
                    var drinkName = CleanProductName(item.Name);
                    if (item.Category == "TOKEN_CREDIT")
                    {
                        var target = items.FirstOrDefault(i => i.IsTokenApplied && i.Category != "TOKEN_CREDIT" && i.Quantity == item.Quantity);
                        if (target != null) 
                        {
                            string raw = target.Name ?? "";
                            drinkName = CleanProductName(raw);
                        }
                        else
                        {
                            drinkName = "Unknown Item (Credit Applied)";
                        }
                    }

                    var dbItem = DbItems.FirstOrDefault(di => di.Name != null && di.Name.Equals(drinkName, StringComparison.OrdinalIgnoreCase));
                    var menuPrice = dbItem?.Price ?? (item.Category == "TOKEN_CREDIT" ? 0 : 0);
                    
                    if (item.Category == "TOKEN_CREDIT" && drinkName != "Unknown Item (Credit Applied)")
                    {
                        menuPrice = dbItem?.Price ?? 0;
                    }
                    
                    PosToken? match = null;
                    if (item.AppliedTokenId.HasValue && item.AppliedTokenId.Value > 0)
                    {
                        match = MasterTokens.FirstOrDefault(t => t.Id == item.AppliedTokenId.Value);
                    }
                    if (match == null)
                    {
                        var nameUpper = (item.Name ?? "").ToUpper();
                        if (nameUpper.Contains("BEER") || nameUpper.Contains("SELTZER") || nameUpper.Contains("CIDER")) match = MasterTokens.OrderByDescending(t => t.Name.Length).FirstOrDefault(t => t.Name?.ToUpper().Contains("BEER") == true || t.Name?.ToUpper().Contains("SELTZER") == true);
                        else match = MasterTokens.OrderByDescending(t => t.Name.Length).FirstOrDefault(t => t.Name?.ToUpper().Contains("BEER") == false && t.Name?.ToUpper().Contains("SELTZER") == false);
                    }

                    if (match != null && match.Name != null)
                    {
                        if (stats.ContainsKey(match.Name))
                        {
                            bool isTrigger = item.Category == "TOKEN_CREDIT" || 
                                             item.IsTokenApplied || 
                                             (item.Price == 0 && ((item.Name ?? "").Contains("(TOKEN") || (item.Name ?? "").Contains("(CREDITED")));
                            
                            if (isTrigger)
                            {
                                stats[match.Name].Redeemed += item.Quantity;
                                
                                decimal valueOfRedemption = item.Category == "TOKEN_CREDIT" ? Math.Abs(item.Price) : (menuPrice > 0 ? menuPrice : match.SalePrice);
                                
                                stats[match.Name].RedemptionValue += valueOfRedemption * item.Quantity;
                                
                                decimal exactTokenPrice = match.SalePrice;
                                if (stats[match.Name].Sold > 0 && stats[match.Name].ActualCashCollected > 0)
                                {
                                    decimal avg = stats[match.Name].ActualCashCollected / stats[match.Name].Sold;
                                    // If token was sold at standard catalog price, use exact catalog price to eliminate floating average decimals
                                    if (Math.Abs(avg - match.SalePrice) <= 0.20m)
                                    {
                                        exactTokenPrice = match.SalePrice;
                                    }
                                    else
                                    {
                                        exactTokenPrice = Math.Round(avg, 2);
                                    }
                                }

                                var usage = new TokenUsageEntry {
                                    DrinkName = drinkName,
                                    TokenName = match.Name,
                                    MenuPrice = item.Category == "TOKEN_CREDIT" ? valueOfRedemption : menuPrice,
                                    TokenSalePrice = exactTokenPrice,
                                    IsUpgrade = item.Category == "TOKEN_CREDIT",
                                    Quantity = item.Quantity,
                                    Timestamp = sale.Timestamp
                                };
                                TokenUsages.Add(usage);
                            }
                        }
                    }
                }
            }
        }

        foreach (var entry in stats.Values)
        {
            var tokenLogs = TokenAuditLogs.Where(l => l.TokenName == entry.Token.Name).OrderBy(l => l.Timestamp).ToList();
            
            // Check for latest Audit Baseline Set log
            var lastAuditLog = tokenLogs.LastOrDefault(l => l.Status == "AUDIT_BASELINE_SET" || l.Status == "BALANCED" || l.Status == "LEGACY_INFLOW" || l.Status == "SHRINKAGE");
            if (lastAuditLog != null)
            {
                entry.AuditedBaselineStock = lastAuditLog.ActualCount;
                var cutoffTime = lastAuditLog.Timestamp;

                // Calculate sales, redemptions, and replenishments since audit timestamp
                int soldSince = 0;
                int redeemedSince = 0;
                foreach (var sale in allSales.Where(s => s.Timestamp >= cutoffTime))
                {
                    var items = GetItemsList(sale.ItemsJson);
                    foreach (var item in items)
                    {
                        if (item.Category == "TOKENS")
                        {
                            var match = MasterTokens.OrderByDescending(t => t.Name.Length).FirstOrDefault(t => (item.Name ?? "").ToUpper().Contains(t.Name.ToUpper()));
                            if (match != null && match.Name == entry.Token.Name) soldSince += item.Quantity;
                        }
                        
                        bool isRedem = item.IsTokenApplied || (item.Name ?? "").Contains("(TOKEN") || (item.Name ?? "").Contains("(CREDITED") || item.Category == "TOKEN_CREDIT";
                        if (isRedem)
                        {
                            PosToken? match = null;
                            if (item.AppliedTokenId.HasValue && item.AppliedTokenId.Value > 0) match = MasterTokens.FirstOrDefault(t => t.Id == item.AppliedTokenId.Value);
                            if (match == null)
                            {
                                var nameUpper = (item.Name ?? "").ToUpper();
                                if (nameUpper.Contains("BEER") || nameUpper.Contains("SELTZER") || nameUpper.Contains("CIDER")) match = MasterTokens.OrderByDescending(t => t.Name.Length).FirstOrDefault(t => t.Name?.ToUpper().Contains("BEER") == true || t.Name?.ToUpper().Contains("SELTZER") == true);
                                else match = MasterTokens.OrderByDescending(t => t.Name.Length).FirstOrDefault(t => t.Name?.ToUpper().Contains("BEER") == false && t.Name?.ToUpper().Contains("SELTZER") == false);
                            }
                            if (match != null && match.Name == entry.Token.Name) redeemedSince += item.Quantity;
                        }
                    }
                }

                int replenishedSince = tokenLogs.Where(l => l.Timestamp >= cutoffTime && l.Status == "STOCK_REPLENISHED").Sum(l => l.Variance);

                entry.SalesSinceAudit = soldSince;
                entry.RedemptionsSinceAudit = redeemedSince;
                entry.ReplenishedSinceAudit = replenishedSince;
                entry.LastAuditStatus = $"Baseline {lastAuditLog.ActualCount} ({lastAuditLog.Timestamp:MMM dd, h:mm tt})";
            }
            else
            {
                entry.LastAuditStatus = "Never";
            }

            // Check for latest Legacy Reset log
            var lastLegacyResetLog = tokenLogs.LastOrDefault(l => l.Status == "LEGACY_RESET");
            if (lastLegacyResetLog != null)
            {
                entry.LegacyResetBaseline = lastLegacyResetLog.ActualCount;
                var resetTime = lastLegacyResetLog.Timestamp;

                int soldSinceReset = 0;
                int redeemedSinceReset = 0;

                foreach (var sale in allSales.Where(s => s.Timestamp >= resetTime))
                {
                    var items = GetItemsList(sale.ItemsJson);
                    foreach (var item in items)
                    {
                        if (item.Category == "TOKENS")
                        {
                            var match = MasterTokens.OrderByDescending(t => t.Name.Length).FirstOrDefault(t => (item.Name ?? "").ToUpper().Contains(t.Name.ToUpper()));
                            if (match != null && match.Name == entry.Token.Name) soldSinceReset += item.Quantity;
                        }
                        
                        bool isRedem = item.IsTokenApplied || (item.Name ?? "").Contains("(TOKEN") || (item.Name ?? "").Contains("(CREDITED") || item.Category == "TOKEN_CREDIT";
                        if (isRedem)
                        {
                            PosToken? match = null;
                            if (item.AppliedTokenId.HasValue && item.AppliedTokenId.Value > 0) match = MasterTokens.FirstOrDefault(t => t.Id == item.AppliedTokenId.Value);
                            if (match == null)
                            {
                                var nameUpper = (item.Name ?? "").ToUpper();
                                if (nameUpper.Contains("BEER") || nameUpper.Contains("SELTZER") || nameUpper.Contains("CIDER")) match = MasterTokens.OrderByDescending(t => t.Name.Length).FirstOrDefault(t => t.Name?.ToUpper().Contains("BEER") == true || t.Name?.ToUpper().Contains("SELTZER") == true);
                                else match = MasterTokens.OrderByDescending(t => t.Name.Length).FirstOrDefault(t => t.Name?.ToUpper().Contains("BEER") == false && t.Name?.ToUpper().Contains("SELTZER") == false);
                            }
                            if (match != null && match.Name == entry.Token.Name) redeemedSinceReset += item.Quantity;
                        }
                    }
                }

                entry.SoldSinceReset = soldSinceReset;
                entry.RedeemedSinceReset = redeemedSinceReset;
            }
        }

        TokenYields = stats.Values.Where(y => y.Token.AllowCreditUpgrade != true).ToList();
    }

