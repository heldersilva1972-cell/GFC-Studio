                                        <th class="pe-4 text-end py-3">TOTAL MENU VALUE</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var group in TokenUsages.GroupBy(u => new { u.DrinkName, u.TokenName, u.MenuPrice }).OrderByDescending(g => g.Sum(x => x.Quantity)))
                                    {
                                        var totalQty = group.Sum(x => x.Quantity);
                                        var totalVal = group.Key.MenuPrice * totalQty;
                                        <tr>
                                            <td class="ps-4 py-3 fw-bold text-dark fs-6">@group.Key.DrinkName</td>
                                            <td class="text-center py-3"><span class="badge bg-light text-dark border">@group.Key.TokenName</span></td>
                                            <td class="text-center py-3 fw-black fs-6">@totalQty</td>
                                            <td class="text-center py-3 fw-bold text-muted">@group.Key.MenuPrice.ToString("C")</td>
                                            <td class="pe-4 text-end py-3 fw-black text-danger fs-6">@totalVal.ToString("C")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
                <div class="modal-footer border-top py-3">
                    <button class="btn btn-secondary rounded-pill fw-bold px-4" @onclick='() => _showRedemptionListModal = false'>CLOSE WINDOW</button>
                </div>
            </div>
        </div>
    </div>
}

@if (_showHistoryModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5); z-index: 10500;">
        <div class="modal-dialog modal-dialog-centered modal-xl">
            <div class="modal-content rounded-4 shadow border-0">
