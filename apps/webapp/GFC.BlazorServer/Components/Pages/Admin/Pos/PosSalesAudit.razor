                                        {
                                            <div class="badge bg-primary text-white p-2 rounded-pill px-3 fw-bold border shadow-sm">
                                                <i class="bi bi-funnel-fill me-1"></i>Shift: @SelectedZReport.BartenderName (@SelectedZReport.TerminalName @@ @SelectedZReport.Timestamp.ToString("MM/dd h:mm tt"))
                                                <i class="bi bi-x-circle-fill ms-2" @onclick="ClearShiftFilter" style="cursor: pointer;" title="Clear Shift Filter"></i>
                                            </div>
                                        }
                                        <div class="btn-group p-1 bg-light rounded-pill border shadow-xs" role="group">
                                            <button class="btn btn-xs rounded-pill px-3 py-1 @(_foodViewMode == "CHART" ? "btn-primary text-white fw-bold shadow-xs" : "btn-light text-muted fw-bold border-0")"
                                                    @onclick='() => SetFoodViewMode("CHART")'>
                                                <i class="bi bi-bar-chart-fill me-1"></i>CHARTS
                                            </button>
                                            <button class="btn btn-xs rounded-pill px-3 py-1 @(_foodViewMode == "SUMMARY" ? "btn-primary text-white fw-bold shadow-xs" : "btn-light text-muted fw-bold border-0")"
                                                    @onclick='() => SetFoodViewMode("SUMMARY")'>
                                                <i class="bi bi-grid-fill me-1"></i>PRODUCT SUMMARY
                                            </button>
                                            <button class="btn btn-xs rounded-pill px-3 py-1 @(_foodViewMode == "TRANSACTIONS" ? "btn-primary text-white fw-bold shadow-xs" : "btn-light text-muted fw-bold border-0")"
                                                    @onclick='() => SetFoodViewMode("TRANSACTIONS")'>
                                                <i class="bi bi-receipt me-1"></i>TRANSACTION LOG
                                            </button>
                                        </div>
                                    </div>
                                </div>

                                <!-- KPI Summary Cards Row -->
                                <div class="row g-3 mb-2">
                                    <div class="col-md-3">
                                        <div class="p-3 bg-light rounded-4 border h-100 shadow-xs">
                                            <div class="text-muted fw-bold small text-uppercase" style="font-size: 0.68rem; letter-spacing: 0.5px;">
                                                <i class="bi bi-cash-stack text-success me-1"></i>@(isFoodFiltered ? $"{_foodCategoryFilter} REVENUE" : "TOTAL FOOD REVENUE")
                                            </div>
                                            <div class="fs-3 fw-black text-dark mt-1">@totalFoodRev.ToString("C")</div>
                                            <div class="small text-muted" style="font-size: 0.72rem;">
                                                <strong class="text-success">@foodPercentOfTotal.ToString("F1")%</strong> of total POS volume
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <div class="p-3 bg-light rounded-4 border h-100 shadow-xs">
                                            <div class="text-muted fw-bold small text-uppercase" style="font-size: 0.68rem; letter-spacing: 0.5px;">
                                                <i class="bi bi-box-seam text-primary me-1"></i>UNITS SOLD
                                            </div>
                                            <div class="fs-3 fw-black text-primary mt-1">@totalFoodQty <span class="fs-6 text-muted fw-normal">items</span></div>
                                            <div class="small text-muted" style="font-size: 0.72rem;">
                                                @(isFoodFiltered ? $"Units in {_foodCategoryFilter}" : $"Across {_allSalesForStats.Count(s => GetItemsList(s.ItemsJson).Any(i => IsFoodItem(i)))} food orders")
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <div class="p-3 bg-light rounded-4 border h-100 shadow-xs">
                                            <div class="text-muted fw-bold small text-uppercase" style="font-size: 0.68rem; letter-spacing: 0.5px;">
                                                <i class="bi bi-tags text-warning me-1"></i>ACTIVE FOOD PRODUCTS
                                            </div>
                                            <div class="fs-3 fw-black text-dark mt-1">@distinctItemsCount <span class="fs-6 text-muted fw-normal">distinct</span></div>
                                            <div class="small text-muted" style="font-size: 0.72rem;">
                                                @(isFoodFiltered ? $"Products in {_foodCategoryFilter}" : "Items ordered in selected range")
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <div class="p-3 bg-light rounded-4 border h-100 shadow-xs">
                                            <div class="text-muted fw-bold small text-uppercase" style="font-size: 0.68rem; letter-spacing: 0.5px;">
                                                <i class="bi bi-calculator text-info me-1"></i>AVG SPEND / ITEM
                                            </div>
                                            <div class="fs-3 fw-black text-dark mt-1">
                                                @(totalFoodQty > 0 ? (totalFoodRev / totalFoodQty).ToString("C") : "$0.00")
                                            </div>
                                            <div class="small text-muted" style="font-size: 0.72rem;">
                                                Average unit realized price
                                            </div>
                                        </div>
                                    </div>
                                </div>

