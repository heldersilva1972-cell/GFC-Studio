                                                    <div class="fw-bold text-dark">@log.Notes</div>
                                                }
                                            </td>
                                            <td class="pe-4 py-3">
                                                @if (!string.IsNullOrWhiteSpace(log.Notes))
                                                {
                                                    <div class="text-dark small mb-0.5">@log.Notes</div>
                                                }
                                                <div class="small text-muted d-flex align-items-center gap-1" style="font-size: 0.72rem;">
                                                    <i class="bi bi-person text-secondary"></i>
                                                    <span>By @(string.IsNullOrWhiteSpace(log.PerformedBy) ? "Manager" : log.PerformedBy)</span>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
                <div class="modal-footer border-top py-3 bg-light">
                    <button class="btn btn-secondary rounded-pill fw-bold px-4" @onclick='() => _showHistoryModal = false'>CLOSE HISTORY WINDOW</button>
                </div>
            </div>
        </div>
    </div>
}

