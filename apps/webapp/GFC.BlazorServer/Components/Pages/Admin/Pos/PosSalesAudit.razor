    .text-navy { color: #3730a3; }
    .bg-success-light { background: #f0fdf4; }
    .bg-warning-light { background: #fffbeb; }
    .text-orange { color: #b45309; }
    .fw-black { font-weight: 900; }
    .btn-navy { background: #3730a3; color: white; }
    .btn-navy:hover { background: #312e81; color: white; }

    .items-list { color: #475569; max-width: 300px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

    .table thead th { font-size: 0.7rem; font-weight: 950; text-transform: uppercase; color: #64748b; letter-spacing: 1px; padding: 1rem 0.5rem; border: none; }
    .table tbody td { vertical-align: middle; padding: 1.25rem 0.5rem; border-color: #f1f5f9; }

    .btn-xs { padding: 0.25rem 0.75rem; font-size: 0.65rem; }
    .summary-table-wrapper { max-height: 400px; overflow-y: auto; }
    .table-sm td, .table-sm th { padding: 0.5rem; }

    /* OVERLAY & MODAL FIXES */
    .shift-overlay {
        position: fixed; top: 0; left: 0; right: 0; bottom: 0;
        background: rgba(15, 23, 42, 0.4); backdrop-filter: blur(8px);
        display: flex; align-items: center; justify-content: center; z-index: 10000;
        animation: fadeIn 0.2s ease-out;
    }
    .notice-modal {
        background: white; padding: 2.5rem; border-radius: 40px; text-align: center;
        max-width: 650px; width: 95%; border: 6px solid #f1f5f9; box-shadow: 0 40px 80px rgba(0,0,0,0.3);
        position: relative;
    }
    .btn-close-modal {
        position: absolute; top: 25px; right: 25px; background: #f1f5f9; border: none;
        width: 45px; height: 45px; border-radius: 50%; font-size: 1.4rem; color: #64748b;
        display: flex; align-items: center; justify-content: center; transition: all 0.2s;
    }
    .btn-close-modal:hover { background: #e2e8f0; color: #0f172a; transform: scale(1.1); }
</style>

@if (_showSummaryModal)
{
    <div class="shift-overlay">
        <div class="notice-modal animate__animated animate__zoomIn">
            <button class="btn-close-modal shadow-sm" @onclick="() => _showSummaryModal = false">
                <i class="bi bi-x-lg"></i>
            </button>
            <div class="notice-icon-circle bg-blue mb-3">
                <i class="bi bi-graph-up"></i>
            </div>
            <h3 class="fw-black text-uppercase">SALES SUMMARY</h3>
            <p class="text-muted fw-bold small mb-4">@StartDate.ToShortDateString() - @EndDate.ToShortDateString() (@(string.IsNullOrEmpty(FilterTerminal) ? "ALL STATIONS" : FilterTerminal))</p>
            
            <div class="summary-table-wrapper border rounded-4 overflow-hidden mb-4 scrollbar-thin">
                <table class="table table-sm table-hover mb-0" style="font-size: 0.9rem;">
                    <thead class="bg-light">
                        <tr>
                            <th class="ps-3 py-3 text-start">PRODUCT</th>
                            <th class="text-center py-3">QTY</th>
                            <th class="text-end pe-3 py-3">REVENUE</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in SummaryResults.OrderByDescending(x => x.Revenue))
                        {
                            <tr class="align-middle">
                                <td class="ps-3 fw-bold text-start py-3">@item.Name</td>
                                <td class="text-center fw-black py-3">@item.Quantity</td>
                                <td class="text-end pe-3 fw-bold py-3">@item.Revenue.ToString("C")</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="bg-light fw-black border-top">
                        <tr>
                            <td class="ps-3 py-3 text-start">TOTAL VOLUME</td>
                            <td class="text-center py-3">@SummaryResults.Sum(x => x.Quantity)</td>
                            <td class="text-end pe-3 py-3">@SummaryResults.Sum(x => x.Revenue).ToString("C")</td>
                        </tr>
                    </tfoot>
                </table>
            </div>

            <button class="btn btn-navy w-100 py-3 rounded-pill fw-black shadow-sm" @onclick="() => _showSummaryModal = false">
                CLOSE REPORT
            </button>
        </div>
    </div>
}

@code {
    private string ActiveTab = "SALES";
    private List<PosSale> Sales = new();
    private string FilterTerminal = "";
    private List<string> TerminalList = new();
    private decimal TodayTotal = 0;
    private Dictionary<string, decimal> StationTotals = new();
    private PosSale? SelectedSale = null;
    private List<ReconEntry> ReconResults = new();
    private SystemSettings? _settings;
    private int TotalTokensSold = 0;
    private int TotalTokensRedeemed = 0;
    private int LifetimeBeerSold = 0;
    private int LifetimeBeerUsed = 0;
    private int LifetimeMixedSold = 0;
    private int LifetimeMixedUsed = 0;

    private DateTime StartDate = DateTime.Today;
    private DateTime EndDate = DateTime.Today;
    private string ActivePreset = "today";
    private bool _showSummaryModal = false;
    private List<SummaryResult> SummaryResults = new();

    public class SummaryResult
    {
        public string Name { get; set; } = "";
        public int Quantity { get; set; }
        public decimal Revenue { get; set; }
    }

    private async Task SetPreset(string preset)
    {
        ActivePreset = preset;
        var today = DateTime.Today;

        switch (preset)
        {
            case "today":
                StartDate = today;
                EndDate = today;
                break;
            case "yesterday":
                StartDate = today.AddDays(-1);
                EndDate = today.AddDays(-1);
                break;
            case "thisweek":
                int diff = (7 + (today.DayOfWeek - DayOfWeek.Monday)) % 7;
                StartDate = today.AddDays(-1 * diff).Date;
                EndDate = today;
                break;
            case "lastweek":
                int lastWeekDiff = (7 + (today.DayOfWeek - DayOfWeek.Monday)) % 7 + 7;
                StartDate = today.AddDays(-1 * lastWeekDiff).Date;
                EndDate = StartDate.AddDays(6);
                break;
        }
        await LoadSales();
    }

    private async Task OnDateManualChanged()
    {
        ActivePreset = ""; // Clear highlighted preset if user touches dates
        await LoadSales();
    }

    private void GenerateSummary()
    {
        var allItems = Sales.SelectMany(s => GetItemsList(s.ItemsJson)).ToList();
        SummaryResults = allItems.GroupBy(i => i.Name)
                                .Select(g => new SummaryResult 
                                { 
                                    Name = g.Key, 
                                    Quantity = g.Sum(i => i.Quantity),
                                    Revenue = g.Sum(i => i.Price * i.Quantity)
                                }).ToList();
        _showSummaryModal = true;
    }

    public class ReconEntry {
        public string ItemName { get; set; } = "";
        public string BottleSize { get; set; } = "1L";
        public decimal PourSize { get; set; } = 1.5m;
        public int DrinksSold { get; set; }
        public int BottlesPulled { get; set; }
        public int ExpectedYield { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        using var db = DbFactory.CreateDbContext();
        await CalculateLifetimeTokens(db);
        await LoadSales();
    }

    private async Task LoadSales()
    {
        using var db = DbFactory.CreateDbContext();
        
        var query = db.PosSales.AsQueryable();

        // Date Range Filter
        query = query.Where(s => s.Timestamp.Date >= StartDate.Date && s.Timestamp.Date <= EndDate.Date);

        if (!string.IsNullOrEmpty(FilterTerminal))
        {
            query = query.Where(s => s.TerminalName == FilterTerminal);
        }

        Sales = await query.OrderByDescending(s => s.Timestamp).ToListAsync();

        // Calculate Totals for cards
        TodayTotal = Sales.Sum(s => s.TotalAmount);
        
        StationTotals = Sales.GroupBy(s => s.TerminalName)
                            .ToDictionary(g => g.Key, g => g.Sum(s => s.TotalAmount));

        // Token Tracking (Daily)
        var allItems = Sales.SelectMany(s => GetItemsList(s.ItemsJson)).ToList();
        TotalTokensSold = allItems.Where(i => i.Category == "TOKENS").Sum(i => i.Quantity);
        TotalTokensRedeemed = allItems.Where(i => i.Name.Contains("(TOKEN)") && i.Price == 0).Sum(i => i.Quantity);

        // 1. Calculate Reconciliation Data
        await CalculateReconciliation(db);

        // Get unique terminal names for the dropdown
        TerminalList = await db.PosSales.Select(s => s.TerminalName).Distinct().ToListAsync();

        // Select the first one by default if any
        if (Sales.Any() && SelectedSale == null)
        {
            SelectedSale = Sales.First();
        }
    }

    private async Task CalculateReconciliation(GfcDbContext db)
    {
        ReconResults.Clear();
        _settings = await SystemSettingsService.GetAsync();

        // A. Get all drinks sold in this period from POS
        var allSalesItems = Sales.SelectMany(s => GetItemsList(s.ItemsJson));
        var posGrouped = allSalesItems.GroupBy(i => i.Name)
                                      .ToDictionary(g => g.Key, g => g.Sum(i => i.Quantity));

        // B. Get all bottles pulled from Inventory for this station/period
        var inventoryQuery = db.LiquorTransactions.Where(t => t.Timestamp.Date >= StartDate.Date && t.Timestamp.Date <= EndDate.Date && 
                                                             (t.Notes ?? "").Contains("POS End-of-Shift Removal"));
        
        if (!string.IsNullOrEmpty(FilterTerminal))
        {
            inventoryQuery = inventoryQuery.Where(t => (t.Notes ?? "").Contains($"[{FilterTerminal}]"));
        }

        var inventoryTransactions = await inventoryQuery.Include(t => t.Item).ToListAsync();
        
        // C. Process each distinct liquor involved
        var allItemNames = posGrouped.Keys.Union(inventoryTransactions.Select(t => t.Item?.Name ?? "Unknown")).Distinct();

        foreach(var name in allItemNames)
        {
            var drinksSold = posGrouped.ContainsKey(name) ? posGrouped[name] : 0;
            var pulls = inventoryTransactions.Where(t => t.Item?.Name == name).ToList();
            var bottlesPulled = pulls.Sum(t => Math.Abs(t.ChangeAmount));
            
            // Get item metadata (size/shot)
            var itemMeta = pulls.FirstOrDefault()?.Item;
            if (itemMeta == null) {
                // Try and find from db if no pull happened but sales did
                itemMeta = await db.LiquorItems.FirstOrDefaultAsync(i => i.Name == name);
            }

            decimal ounces = 33.8m; // Default 1L
            decimal pour = _settings?.GlobalLiquorPourSize ?? 1.5m; // Use GLOBAL setting per user request
            string bSize = itemMeta?.BottleSize ?? "1L";

            if (bSize.Contains("750")) ounces = 25.4m;
            if (bSize.Contains("1.75")) ounces = 59.2m;
            
            // Override global pour IF it is explicitly unit based (Beer/Cans)
            if (itemMeta?.IsUnitBased == true) {
                ounces = 1;
                pour = 1;
            }

            int expectedShots = (int)(Math.Floor(ounces / (pour > 0 ? pour : 1)) * bottlesPulled);

            ReconResults.Add(new ReconEntry {
                ItemName = name,
                BottleSize = bSize,
                PourSize = pour,
                DrinksSold = drinksSold,
                BottlesPulled = bottlesPulled,
                ExpectedYield = expectedShots
            });
        }
    }

    private async Task CalculateLifetimeTokens(GfcDbContext db)
    {
        // Scan all sales for absolute liability
        var allSales = await db.PosSales.Select(s => new { s.ItemsJson, s.PaymentType }).ToListAsync();
        
        LifetimeBeerSold = 0; LifetimeBeerUsed = 0;
        LifetimeMixedSold = 0; LifetimeMixedUsed = 0;

        foreach (var sale in allSales)
        {
            var items = GetItemsList(sale.ItemsJson);
            
            // BEER Tracking
            LifetimeBeerSold += items.Where(i => i.Category == "TOKENS" && i.Name.ToUpper().Contains("BEER")).Sum(i => i.Quantity);
            LifetimeBeerUsed += items.Where(i => i.Name.ToUpper().Contains("BEER") && i.Name.Contains("(TOKEN)") && i.Price == 0).Sum(i => i.Quantity);

            // MIXED DRINK Tracking
            LifetimeMixedSold += items.Where(i => (i.Category == "TOKENS" && !i.Name.ToUpper().Contains("BEER"))).Sum(i => i.Quantity);
            LifetimeMixedUsed += items.Where(i => (i.Name.Contains("(TOKEN)") && !i.Name.ToUpper().Contains("BEER") && i.Price == 0)).Sum(i => i.Quantity);
        }
    }

    private void SelectSale(PosSale sale)
    {
        SelectedSale = sale;
    }

    private List<PosTerminal.ProductItem> GetItemsList(string json)
    {
        try 
        {
            if (string.IsNullOrEmpty(json)) return new();
            var items = JsonSerializer.Deserialize<List<PosTerminal.ProductItem>>(json);
            return items ?? new();
        }
        catch { return new(); }
    }
}
