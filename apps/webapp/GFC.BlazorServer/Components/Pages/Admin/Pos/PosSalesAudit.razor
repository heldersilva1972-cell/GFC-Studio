    private DateTime GetStartOfWeek(DateTime dt)
    {
        int diff = (7 + (dt.DayOfWeek - DayOfWeek.Monday)) % 7;
        return dt.AddDays(-1 * diff).Date;
    }

    private async Task RenderPullsChart()
    {
        if (ActiveTab != "INVENTORY") return;

        var pullList = _ledgerTransactions
            .Where(t => t.TransactionType == "Checkout" && t.Notes != null && t.Notes.Contains("POS End-of-Shift Removal"))
            .ToList();

        // Generate all weeks in the selected date range to ensure a continuous weekly timeline
        var dateMap = new Dictionary<string, int>();
        var currentDate = GetStartOfWeek(StartDate.Date);
        var lastDate = GetStartOfWeek(EndDate.Date);
        
        while (currentDate <= lastDate)
        {
            dateMap[$"Wk {currentDate:MM/dd}"] = 0;
            currentDate = currentDate.AddDays(7);
        }

        // Overlay actual pull values
        foreach (var pull in pullList)
        {
            var weekStart = GetStartOfWeek(pull.Timestamp.ToLocalTime().Date);
            var label = $"Wk {weekStart:MM/dd}";
            if (dateMap.ContainsKey(label))
            {
                dateMap[label] += (int)Math.Abs(pull.ChangeAmount);
            }
            else
            {
                dateMap[label] = (int)Math.Abs(pull.ChangeAmount);
            }
        }

        var sortedKeys = dateMap.Keys.OrderBy(k => k).ToArray();
        var sortedValues = sortedKeys.Select(k => dateMap[k]).ToArray();

        _trendWeeksList = sortedKeys.ToList();
        if (string.IsNullOrEmpty(_selectedTrendWeek) || !_trendWeeksList.Contains(_selectedTrendWeek))
        {
            _selectedTrendWeek = _trendWeeksList.LastOrDefault() ?? "";
        }
        UpdateWeeklyBreakdown();

        var chartConfig = new
        {
            type = "bar",
            data = new
            {
                labels = sortedKeys,
                datasets = new[]
                {
                    new
                    {
                        label = "Bottles Pulled",
                        data = sortedValues,
                        backgroundColor = "rgba(109, 40, 217, 0.75)",
                        borderColor = "rgb(109, 40, 217)",
                        borderWidth = 1,
                        borderRadius = 4
                    }
                }
            },
            options = new
            {
                responsive = true,
                maintainAspectRatio = false,
                plugins = new
                {
                    legend = new { display = false }
                },
                scales = new
                {
                    y = new
                    {
                        beginAtZero = true,
                        ticks = new { stepSize = 1, color = "#64748b" }
                    },
                    x = new
                    {
                        ticks = new { color = "#64748b" }
                    }
                }
            }
        };

        try
        {
            await JSRuntime.InvokeVoidAsync("renderChart", "pullTrendsChart", chartConfig, _objRef);
        }
        catch (Exception ex)
        {
            Console.WriteLine("Error rendering pulls chart: " + ex.Message);
        }
    }

