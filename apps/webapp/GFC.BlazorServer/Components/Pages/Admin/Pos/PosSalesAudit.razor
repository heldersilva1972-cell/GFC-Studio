    private void SelectTopProducts(int count)
    {
        _multiProductMode = true;
        _selectedMultiTrendProducts.Clear();
        var active = _auditProductMetrics.Where(x => IsItemInSelectedCategory(x)).OrderByDescending(p => p.Quantity).Take(count).ToList();
        if (!active.Any())
        {
            active = _auditProductMetrics.OrderByDescending(p => p.Quantity).Take(count).ToList();
        }

        foreach (var p in active)
        {
            _selectedMultiTrendProducts.Add(p.Name);
        }
        if (active.Any())
        {
            _selectedAuditTrendProductName = active.First().Name;
        }
        StateHasChanged();
    }

    private void ToggleMultiProductSelection(string productName)
    {
        _multiProductMode = true;
        if (_selectedMultiTrendProducts.Contains(productName))
        {
            _selectedMultiTrendProducts.Remove(productName);
        }
        else
        {
            if (_selectedMultiTrendProducts.Count < 15)
            {
                _selectedMultiTrendProducts.Add(productName);
            }
        }
        StateHasChanged();
    }

    public class MultiProductSeriesData
    {
        public string ProductName { get; set; } = "";
        public string Color { get; set; } = "#2563eb";
        public string LinePath { get; set; } = "";
        public List<(double x, double y, AuditTrendPoint pt, bool showLabel)> Coords { get; set; } = new();
    }

    private (List<MultiProductSeriesData> SeriesList, int MaxQty, double Width, double Height, List<(double x, string Label, DateTime Date, bool showLabel)> Dates) CalculateMultiTrendSvgData(List<string> productNames)
    {
        double width = 1000;
        double height = 250;
        double paddingLeft = 55;
        double paddingRight = 55;
        double paddingTop = 35;
        double paddingBottom = 70;

        var result = new List<MultiProductSeriesData>();
        var allProductPoints = new Dictionary<string, List<AuditTrendPoint>>();

        foreach (var name in productNames)
        {
            allProductPoints[name] = GetProductTrendPoints(name);
        }

        int overallMaxQty = 5;
        foreach (var pts in allProductPoints.Values)
        {
            if (pts.Any())
            {
                int maxP = pts.Max(p => p.Quantity);
                if (maxP > overallMaxQty) overallMaxQty = maxP;
            }
        }

        var sampleList = allProductPoints.Values.FirstOrDefault() ?? new();
        int dayCount = sampleList.Count;

        double usableWidth = width - paddingLeft - paddingRight;
        double usableHeight = height - paddingTop - paddingBottom;

        int labelInterval = 1;
        if (dayCount > 40) labelInterval = 4;
        else if (dayCount > 25) labelInterval = 3;
        else if (dayCount > 15) labelInterval = 2;

        var dates = new List<(double x, string Label, DateTime Date, bool showLabel)>();
        double step = usableWidth / Math.Max(1, dayCount - 1);

        for (int i = 0; i < dayCount; i++)
        {
            double x = paddingLeft + (i * step);
            string lbl = sampleList.Any() && i < sampleList.Count ? sampleList[i].Label : "";
            DateTime dt = sampleList.Any() && i < sampleList.Count ? sampleList[i].Date : DateTime.Today;
            bool showLabel = (i == 0) || (i == dayCount - 1) || (i % labelInterval == 0);
            dates.Add((x, lbl, dt, showLabel));
        }

        int colorIdx = 0;
        foreach (var kvp in allProductPoints)
        {
            string pName = kvp.Key;
            var pts = kvp.Value;
            string color = MultiProductColors[colorIdx % MultiProductColors.Length];
            colorIdx++;

            var coords = new List<(double x, double y, AuditTrendPoint pt, bool showLabel)>();
            for (int i = 0; i < pts.Count; i++)
            {
                var pt = pts[i];
                double x = paddingLeft + (i * step);
                double y = (height - paddingBottom) - ((double)pt.Quantity / overallMaxQty * usableHeight);
                bool showLabel = (i == 0) || (i == dayCount - 1) || (i % labelInterval == 0);
                coords.Add((x, y, pt, showLabel));
            }

            string linePath = "M " + string.Join(" L ", coords.Select(c => $"{c.x:F1},{c.y:F1}"));
            result.Add(new MultiProductSeriesData
            {
                ProductName = pName,
                Color = color,
                LinePath = linePath,
                Coords = coords
            });
        }

        return (result, overallMaxQty, width, height, dates);
    }

