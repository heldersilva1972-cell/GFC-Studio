                                                <div class="d-flex justify-content-between align-items-start mb-3">
                                                    <div>
                                                        <div class="d-flex align-items-center gap-2 mb-1">
                                                            <span class="badge bg-success text-white px-3 py-1 rounded-pill fw-bold" style="font-size: 0.75rem;">
                                                                <i class="bi bi-gift-fill me-1"></i>DONATED BEER EVENT
                                                            </span>
                                                        </div>
                                                        <h2 class="fw-black mb-1 text-dark">@selectedGrp.Name</h2>
                                                    </div>
                                                </div>
                                                <div class="row g-3">
                                                    <!-- TOTAL DONATED RECEIVED -->
                                                    <div class="col-md-3">
                                                        <div class="p-3 bg-primary-subtle rounded-4 border border-primary-subtle h-100 shadow-xs">
                                                            <div class="text-primary fw-black small text-uppercase mb-1" style="font-size: 0.7rem; letter-spacing: 0.5px;">
                                                                <i class="bi bi-box-seam me-1"></i>TOTAL DONATED RECEIVED
                                                            </div>
                                                            <div class="fs-3 fw-black text-primary">@selectedGrp.TotalDonatedAvailable <span class="fs-6 fw-normal text-muted">bottles</span></div>
                                                            <div class="small text-muted" style="font-size: 0.68rem;">Cumulative initial donations</div>
                                                        </div>
                                                    </div>
                                                    <!-- BOTTLES CONSUMED -->
                                                    <div class="col-md-3">
                                                        <div class="p-3 bg-light rounded-4 border h-100 shadow-xs">
                                                            <div class="text-muted fw-bold small text-uppercase mb-1" style="font-size: 0.7rem; letter-spacing: 0.5px;">
                                                                <i class="bi bi-cup-straw me-1 text-secondary"></i>BOTTLES CONSUMED
                                                            </div>
                                                            <div class="fs-3 fw-black text-dark">@selectedGrp.TotalAllConsumed <span class="fs-6 fw-normal text-muted">bottles</span></div>
                                                            <div class="d-flex justify-content-between mt-1 pt-1 border-top text-muted" style="font-size: 0.72rem;">
                                                                <span>Donated: <strong class="text-success">@selectedGrp.TotalDonatedConsumed</strong></span>
                                                                <span>Regular: <strong class="text-primary">@selectedGrp.TotalRegularConsumed</strong></span>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <!-- REMAINING BOTTLES -->
                                                    <div class="col-md-3">
                                                        <div class="p-3 bg-success-subtle rounded-4 border border-success-subtle h-100 shadow-xs">
                                                            <div class="text-success fw-black small text-uppercase mb-1" style="font-size: 0.7rem; letter-spacing: 0.5px;">
                                                                <i class="bi bi-check-circle-fill me-1"></i>REMAINING BOTTLES
                                                            </div>
                                                            <div class="fs-3 fw-black text-success">@selectedGrp.TotalDonatedRemaining <span class="fs-6 fw-normal text-muted">bottles left</span></div>
                                                            <div class="small text-muted" style="font-size: 0.68rem;">Available to be served</div>
                                                        </div>
                                                    </div>
                                                    <!-- CLUB & EVENT AMOUNTS -->
                                                    @{
                                                        var evClubTotal = evSales.Sum(s => GetSalePortions(s, latestEv).ClubPortion);
                                                        var evEventTotal = evSales.Sum(s => GetSalePortions(s, latestEv).EventPortion);
                                                    }
                                                    <div class="col-md-3">
                                                        <div class="p-3 bg-light rounded-4 border h-100 shadow-xs d-flex flex-column justify-content-between">
                                                            <div class="text-muted fw-bold small text-uppercase mb-2" style="font-size: 0.7rem; letter-spacing: 0.5px;">
                                                                <i class="bi bi-cash-stack me-1 text-primary"></i>CLUB & EVENT AMOUNTS
                                                            </div>
                                                            <div class="row g-2 align-items-center text-center">
                                                                <div class="col-6 border-end pe-2">
                                                                    <div class="text-muted small fw-bold" style="font-size: 0.68rem; text-transform: uppercase;">Club Portion</div>
                                                                    <div class="fs-4 fw-black text-dark">@evClubTotal.ToString("C")</div>
                                                                </div>
                                                                <div class="col-6 ps-2">
                                                                    <div class="text-muted small fw-bold" style="font-size: 0.68rem; text-transform: uppercase;">Event Portion</div>
                                                                    <div class="fs-4 fw-black text-success">+@evEventTotal.ToString("C")</div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>

                                            <!-- DONATED BEER INVENTORY — REMAINING STOCK -->
