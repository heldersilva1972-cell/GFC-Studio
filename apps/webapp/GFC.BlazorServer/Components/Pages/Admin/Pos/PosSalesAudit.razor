    public class DailyBottleUsage
    {
        public DateTime Date { get; set; }
        public int TotalBottles { get; set; }
        public Dictionary<string, int> BrandBreakdown { get; set; } = new(StringComparer.OrdinalIgnoreCase);
    }

    private List<DailyBottleUsage> GetDailyBottleUsage(AuditEventGroup grp)
    {
        var map = new Dictionary<DateTime, DailyBottleUsage>();
        if (grp == null || grp.Sales == null) return new();

        foreach (var sale in grp.Sales)
        {
            var items = GetItemsList(sale.ItemsJson);
            if (items == null || !items.Any()) continue;

            var dateKey = sale.Timestamp.Date;

            foreach (var item in items.Where(i => i != null && !string.IsNullOrEmpty(i.Name) && i.Quantity > 0))
            {
                var isDonatedPrefix = item.Name.StartsWith("DONATED:", StringComparison.OrdinalIgnoreCase);
                var isTally = item.Name.StartsWith("TALLY:", StringComparison.OrdinalIgnoreCase);
                var cleanName = isTally ? item.Name.Substring(6).Trim() : (isDonatedPrefix ? item.Name.Substring(8).Trim() : item.Name);
                cleanName = CleanProductName(cleanName);
                if (string.IsNullOrEmpty(cleanName)) continue;

                if (!map.TryGetValue(dateKey, out var daily))
                {
                    daily = new DailyBottleUsage { Date = dateKey };
                    map[dateKey] = daily;
                }

                daily.TotalBottles += item.Quantity;
                if (!daily.BrandBreakdown.ContainsKey(cleanName))
                    daily.BrandBreakdown[cleanName] = 0;
                daily.BrandBreakdown[cleanName] += item.Quantity;
            }
        }

        return map.Values
                  .Where(d => d.TotalBottles > 0)
                  .OrderBy(d => d.Date)
                  .ToList();
    }

