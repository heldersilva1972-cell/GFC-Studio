    private bool IsValidAuditEvent(ActiveEvent e)
    {
        return !e.IsDeleted;
    }

    private List<AuditEventGroup> BuildEventGroups()
    {
        var groups = new List<AuditEventGroup>();

        // 1. Gather all distributions across non-deleted active events
        var allDistributions = new List<DonatedDistributionRecord>();
        foreach (var ev in DbActiveEvents.Where(e => !e.IsDeleted))
        {
            allDistributions.AddRange(GetEventDistributions(ev));
        }

        // 2. Gather all distinct event names (Active Events + Designated Recipient Events)
        var allEventNames = DbActiveEvents.Where(IsValidAuditEvent)
                                          .Select(e => GetEventDisplayName(e.Name))
                                          .Concat(allDistributions.Where(d => d.ActionType == "redonate" && !string.IsNullOrWhiteSpace(d.RecipientEventName))
                                                                  .Select(d => GetEventDisplayName(d.RecipientEventName!)))
                                          .Concat(DbActiveEvents.Where(e => !string.IsNullOrWhiteSpace(e.RecipientEventName))
                                                                .Select(e => GetEventDisplayName(e.RecipientEventName!)))
                                          .Distinct(StringComparer.OrdinalIgnoreCase)
                                          .Where(n => !string.IsNullOrWhiteSpace(n))
                                          .ToList();

        foreach (var eventName in allEventNames)
        {
            var eventList = DbActiveEvents.Where(e => GetEventDisplayName(e.Name).Equals(eventName, StringComparison.OrdinalIgnoreCase))
                                          .OrderByDescending(e => e.Id)
                                          .ToList();
            var latest = eventList.FirstOrDefault();
            if (latest == null)
            {
                var tmpl = DbEventTemplates.FirstOrDefault(t => GetEventDisplayName(t.Name).Equals(eventName, StringComparison.OrdinalIgnoreCase));
                latest = new ActiveEvent
                {
                    Name = eventName,
                    Status = GFC.Core.Enums.EventTabStatus.Open,
                    Type = tmpl?.DefaultType ?? GFC.Core.Enums.EventTabType.PrePaid,
                    TemplateId = tmpl?.Id,
                    DonatedItemIdsJson = null
                };
            }

            var allSales = eventList.SelectMany(e => EventSalesMap.TryGetValue(e.Id, out var sList) ? sList : new List<PosSale>())
                                    .DistinctBy(s => s.Id)
                                    .OrderByDescending(s => s.Timestamp)
                                    .ToList();

            // Add all tallies recorded across all sessions (both open and closed) that have not posted a separate finalized POS sale
            foreach (var ae in eventList)
            {
                var activeTallies = GetActiveEventTallies(ae).Where(t => t.Consumed > 0).ToList();
                if (activeTallies.Any() && !allSales.Any(s => s.ActiveEventId == ae.Id && s.PaymentType != "EVENT TALLY"))
                {
                    var itemsForSale = activeTallies.Select(t => new ProductItem {
                        Name = $"TALLY: {t.Name}",
                        Quantity = t.Consumed,
                        Price = t.Price,
                        Category = "BEER"
                    }).ToList();

                    decimal liveClub = activeTallies.Sum(t => t.ClubSubtotal);
                    decimal liveEvent = activeTallies.Sum(t => t.EventSubtotal);
                    decimal liveTotal = liveClub + liveEvent;

                    var liveSale = new PosSale
                    {
                        Id = Guid.NewGuid(),
                        ActiveEventId = ae.Id,
                        PaymentType = "EVENT TALLY",
                        BartenderName = ae.Status == GFC.Core.Enums.EventTabStatus.Open ? "Live Tally" : "Settled Tally",
                        TerminalName = "POS Terminal",
                        Timestamp = ae.CreatedAt,
                        TotalAmount = liveTotal,
                        ItemsJson = JsonSerializer.Serialize(itemsForSale)
                    };
                    allSales.Add(liveSale);
                }
            }

            var depSales = allSales.Where(s => s.PaymentType == "DEPOSIT" || (!string.IsNullOrEmpty(s.ItemsJson) && (s.ItemsJson.Contains("INITIAL DEPOSIT") || s.ItemsJson.Contains("TAB DEPOSIT") || s.ItemsJson.Contains("ADDED FUNDS")))).ToList();
            var drinkSales = allSales.Where(s => !depSales.Contains(s)).ToList();

            decimal initialPrepaid = eventList.Sum(e => e.InitialAmount);
            decimal addedFunds = depSales.Where(s => string.IsNullOrEmpty(s.ItemsJson) || !s.ItemsJson.Contains("INITIAL DEPOSIT")).Sum(s => s.TotalAmount);
            decimal totalFunding = initialPrepaid + addedFunds;
            decimal netSpend = drinkSales.Sum(s => GetCorrectedEventSettlementAmount(s, latest));
            decimal totalSpent = allSales.Sum(s => s.TotalAmount);
            decimal calculatedBalance = latest.Type == GFC.Core.Enums.EventTabType.PrePaid ? (totalFunding - netSpend) : latest.CurrentBalance;

            // Distributions made BY this event (donor actions)
            var myDistributions = eventList.SelectMany(GetEventDistributions)
                                         .DistinctBy(d => d.RecordId)
                                         .OrderByDescending(d => d.Timestamp)
                                         .ToList();

            // Donations received FOR this event (recipient actions)
            var cleanGrpName = eventName.Trim();
            var received = allDistributions.Where(d => d.ActionType == "redonate" &&
                                                      !string.IsNullOrEmpty(d.RecipientEventName) &&
                                                      (d.RecipientEventName.Equals(cleanGrpName, StringComparison.OrdinalIgnoreCase) ||
                                                       GetEventDisplayName(d.RecipientEventName).Equals(cleanGrpName, StringComparison.OrdinalIgnoreCase)))
                                          .DistinctBy(d => d.RecordId)
                                          .ToList();

            // Base pool for this event (from DonatedItemIdsJson)
            var basePool = GetBaseDonatedItemPool(latest);

            // Build brand stock tracking (prioritize true initial donations from received log, and fallback to direct base pool)
            var stockMap = new Dictionary<string, DonatedBrandStock>(StringComparer.OrdinalIgnoreCase);

            // 1. Add all received donations from external donor distribution logs (true historical baseline)
            foreach (var rec in received)
            {
                if (rec.Cans <= 0) continue;
                var rawName = !string.IsNullOrEmpty(rec.BeerName) ? rec.BeerName : (DbLiquorItems.FirstOrDefault(i => i.Id == rec.ItemId)?.Name ?? $"Item #{rec.ItemId}");
                var cleanBrand = CleanProductName(rawName);
                if (string.IsNullOrEmpty(cleanBrand)) cleanBrand = rawName;

                if (!stockMap.ContainsKey(cleanBrand))
                {
                    stockMap[cleanBrand] = new DonatedBrandStock { ItemId = rec.ItemId, BrandName = cleanBrand, InitialAvailable = rec.Cans };
                }
                else
                {
                    stockMap[cleanBrand].InitialAvailable += rec.Cans;
                }
            }

            // 2. Add any direct base pool from active event template that was not generated via received distribution logs
            foreach (var kvp in basePool)
            {
                if (kvp.Value <= 0) continue;
                var rawName = DbLiquorItems.FirstOrDefault(i => i.Id == kvp.Key)?.Name ?? $"Item #{kvp.Key}";
                var cleanBrand = CleanProductName(rawName);
                if (string.IsNullOrEmpty(cleanBrand)) cleanBrand = rawName;

                if (!received.Any(r => r.ItemId == kvp.Key || CleanProductName(r.BeerName).Equals(cleanBrand, StringComparison.OrdinalIgnoreCase)))
                {
                    if (!stockMap.ContainsKey(cleanBrand))
                    {
                        stockMap[cleanBrand] = new DonatedBrandStock { ItemId = kvp.Key, BrandName = cleanBrand, InitialAvailable = kvp.Value };
                    }
                    else
                    {
                        stockMap[cleanBrand].InitialAvailable += kvp.Value;
                    }
                }
            }

            int totalRegularConsumed = 0;
            // Compute consumption from drink sales
            foreach (var sale in drinkSales)
            {
                var items = GetItemsList(sale.ItemsJson);
                if (items == null) continue;
                foreach (var item in items.Where(i => i != null && !string.IsNullOrEmpty(i.Name)))
                {
                    var cleanName = CleanProductName(item.Name);
                    if (string.IsNullOrEmpty(cleanName)) continue;

                    if (stockMap.TryGetValue(cleanName, out var st))
                    {
                        st.Consumed += item.Quantity;
                    }
                    else
                    {
                        var match = stockMap.Values.FirstOrDefault(v => v.BrandName.Equals(cleanName, StringComparison.OrdinalIgnoreCase) ||
                                                                        CleanProductName(v.BrandName).Equals(cleanName, StringComparison.OrdinalIgnoreCase));
                        if (match != null)
                        {
                            match.Consumed += item.Quantity;
                        }
                        else
                        {
                            totalRegularConsumed += item.Quantity;
                        }
                    }
                }
            }

            var donatedStockList = stockMap.Values.Where(s => s.Remaining > 0 || s.Consumed > 0).ToList();

            groups.Add(new AuditEventGroup
            {
                Name = eventName,
                RecipientName = latest.RecipientEventName ?? "",
                Status = eventList.Any(e => e.Status == GFC.Core.Enums.EventTabStatus.Open) ? GFC.Core.Enums.EventTabStatus.Open : GFC.Core.Enums.EventTabStatus.Closed,
                Type = latest.Type,
