@code {
    private string ActiveTab = "SALES";
    private List<PosSale> Sales = new();
    private List<PosZReport> ZReports = new();
    private string FilterTerminal = "";
    private List<string> TerminalList = new();
    private decimal TodayTotal = 0;
    private Dictionary<string, decimal> StationTotals = new();
    private PosSale? SelectedSale = null;
    private PosZReport? SelectedZReport = null;
    private List<ReconEntry> ReconResults = new();
    private SystemSettings? _settings;
    private int TotalTokensSold = 0;
    private int TotalTokensRedeemed = 0;
    private int LifetimeBeerSold = 0;
    private int LifetimeBeerUsed = 0;
    private int LifetimeMixedSold = 0;
    private int LifetimeMixedUsed = 0;
    private List<PosTerminal.ProductItem> DbItems = new();
    private List<PosToken> MasterTokens = new();
    private List<TokenYieldEntry> TokenYields = new();
    private List<TokenUsageEntry> TokenUsages = new();
    private bool _showAdjustmentModal = false;
    private PosToken? _currentTokenToAdjust = null;
    private int _adjustmentValue = 0;

    private DateTime StartDate = DateTime.Today;
    private DateTime EndDate = DateTime.Today;
    private string ActivePreset = "today";
    private bool _showSummaryModal = false;
    private List<SummaryResult> SummaryResults = new();
    private int SelectedMonth = 0;
    private int SelectedYear = DateTime.Today.Year;

    private async Task OnMonthYearChanged()
    {
        if (SelectedMonth > 0)
        {
            ActivePreset = "";
            StartDate = new DateTime(SelectedYear, SelectedMonth, 1);
            EndDate = StartDate.AddMonths(1).AddDays(-1);
            await LoadSales();
        }
    }


    private string GetZReportPeriod(PosZReport current)
    {
        var terminalReports = ZReports.Where(r => r.TerminalName == current.TerminalName)
                                      .OrderByDescending(r => r.Timestamp)
                                      .ToList();
        
        int idx = terminalReports.IndexOf(current);
        if (idx != -1 && idx < terminalReports.Count - 1)
        {
            var prev = terminalReports[idx + 1];
            return $"{prev.Timestamp.ToString("h:mm tt")} - {current.Timestamp.ToString("h:mm tt")}";
        }
        
        return $"SHIFT ENDED @ {current.Timestamp.ToString("h:mm tt")}";
    }

    private List<ZReportPull> GetPullsList(string json)
    {
        try { return JsonSerializer.Deserialize<List<ZReportPull>>(json, new JsonSerializerOptions { PropertyNameCaseInsensitive = true }) ?? new(); }
        catch { return new(); }
    }


    public class ZReportPull {
        public string Name { get; set; } = "";
        public int Quantity { get; set; }
    }

    private List<BanquetShiftReportDto> ParseBanquets(string json)
    {
        try { return JsonSerializer.Deserialize<List<BanquetShiftReportDto>>(json) ?? new(); }
        catch { return new(); }
    }

    public class BanquetShiftReportDto
    {
        public int? ActiveEventId { get; set; }
        public string EventName { get; set; } = "";
        public List<decimal> Deposits { get; set; } = new();
        public decimal TotalSpent { get; set; }
        public Dictionary<string, int> ItemSummary { get; set; } = new();
        public string EventType { get; set; } = "RunningTab";
    }

    public class SummaryResult
    {
        public string Name { get; set; } = "";
        public int Quantity { get; set; }
        public decimal Revenue { get; set; }
    }

    private async Task SetPreset(string preset)
    {
        ActivePreset = preset;
        var today = DateTime.Today;
        
        // Reset dropdowns to neutral for non-monthly presets
        SelectedMonth = 0;
        SelectedYear = today.Year;

        switch (preset)
        {
            case "today":
                StartDate = today;
                EndDate = today;
                break;
            case "yesterday":
                StartDate = today.AddDays(-1);
                EndDate = today.AddDays(-1);
                break;
            case "thisweek":
                int diff = (7 + (today.DayOfWeek - DayOfWeek.Monday)) % 7;
                StartDate = today.AddDays(-1 * diff).Date;
                EndDate = today;
                break;
            case "lastweek":
                int lastWeekDiff = (7 + (today.DayOfWeek - DayOfWeek.Monday)) % 7 + 7;
                StartDate = today.AddDays(-1 * lastWeekDiff).Date;
                EndDate = StartDate.AddDays(6);
                break;
            case "thismonth":
                StartDate = new DateTime(today.Year, today.Month, 1);
                EndDate = today;
                SelectedMonth = today.Month;
                SelectedYear = today.Year;
                break;
            case "lastmonth":
                var lastM = today.AddMonths(-1);
                StartDate = new DateTime(lastM.Year, lastM.Month, 1);
                EndDate = StartDate.AddMonths(1).AddDays(-1);
                SelectedMonth = lastM.Month;
                SelectedYear = lastM.Year;
                break;
        }
        await LoadSales();
    }

