    private void GenerateSummary()
    {
        var allItems = _allSalesForStats.SelectMany(s => GetItemsList(s.ItemsJson)).Where(i => i != null).ToList();
        
        var cleanItems = allItems.Select(i => {
            var cleanName = CleanProductName(i.Name);
            
            var dbLiq = DbLiquorItems.FirstOrDefault(di => di.Name != null && (di.Name.Equals(cleanName, StringComparison.OrdinalIgnoreCase) || CleanProductName(di.Name).Equals(cleanName, StringComparison.OrdinalIgnoreCase)));
            var dbItem = DbItems.FirstOrDefault(di => di.Name != null && (di.Name.Equals(cleanName, StringComparison.OrdinalIgnoreCase) || CleanProductName(di.Name).Equals(cleanName, StringComparison.OrdinalIgnoreCase)));
            
            string itemCategory = "MISC";
            if (dbLiq != null && !string.IsNullOrWhiteSpace(dbLiq.Category) && !dbLiq.Category.Equals("MISC", StringComparison.OrdinalIgnoreCase) && !dbLiq.Category.Equals("INHERITED", StringComparison.OrdinalIgnoreCase))
            {
                itemCategory = dbLiq.Category;
            }
            else if (dbItem != null && !string.IsNullOrWhiteSpace(dbItem.Category) && !dbItem.Category.Equals("MISC", StringComparison.OrdinalIgnoreCase) && !dbItem.Category.Equals("INHERITED", StringComparison.OrdinalIgnoreCase))
            {
                itemCategory = dbItem.Category;
            }
            else if (!string.IsNullOrWhiteSpace(i.Category) && !i.Category.Equals("SHIFT TOTAL", StringComparison.OrdinalIgnoreCase) && !i.Category.Equals("MISC", StringComparison.OrdinalIgnoreCase))
            {
                itemCategory = i.Category;
            }

            return new ProductItem {
                Name = cleanName,
                Quantity = i.Quantity,
                Price = i.Price,
                Category = itemCategory.ToUpper(),
                IsTokenApplied = i.IsTokenApplied || (i.Name ?? "").Contains("(TOKEN)") || (i.Name ?? "").Contains("(CREDITED)")
            };
        })
        .Where(i => !string.IsNullOrEmpty(i.Name) && 
                    !i.Name.Contains("DEPOSIT", StringComparison.OrdinalIgnoreCase) && 
                    !i.Name.Contains("CORRECTION", StringComparison.OrdinalIgnoreCase) && 
                    !i.Name.Contains("NO SALE", StringComparison.OrdinalIgnoreCase) && 
                    !i.Name.Contains("CREDIT", StringComparison.OrdinalIgnoreCase) && 
                    i.Category != "TOKEN_CREDIT")
        .ToList();
 
        SummaryResults = cleanItems.GroupBy(i => new { Name = i.Name, Category = i.Category })
                                .Select(g => new SummaryResult 
                                { 
                                    Name = g.Key.Name, 
                                    Category = g.Key.Category,
                                    Quantity = g.Sum(i => i.Quantity),
                                    Revenue = g.Sum(i => i.Price * i.Quantity),
                                    TokensRedeemed = g.Where(i => i.IsTokenApplied).Sum(i => i.Quantity)
                                }).ToList();
        _showSummaryModal = true;
    }

