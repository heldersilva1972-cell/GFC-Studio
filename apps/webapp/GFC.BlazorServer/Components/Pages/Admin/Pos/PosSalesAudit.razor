                                                        <i class="bi bi-plus-circle me-1"></i>STOCK REPLENISHED
                                                    </span>
                                                }
                                                else if (log.Status == "LEGACY_RESET")
                                                {
                                                    <span class="badge bg-warning text-dark fw-bold" style="font-size: 0.72rem; padding: 4px 8px;">
                                                        <i class="bi bi-arrow-counterclockwise me-1"></i>LEGACY RESET
                                                    </span>
                                                }
                                                else if (log.Status == "SHRINKAGE")
                                                {
