    private List<ProductAuditMetric> GetFilteredAuditVelocityMetrics()
    {
        var query = _auditProductMetrics.Where(x => IsItemInSelectedCategory(x));

        if (_velocityStatusFilter != "ALL")
        {
            query = query.Where(x => x.VelocityStatus == _velocityStatusFilter);
        }

        if (!string.IsNullOrWhiteSpace(_velocitySearchTerm))
        {
            query = query.Where(x => x.Name.Contains(_velocitySearchTerm, StringComparison.OrdinalIgnoreCase) || x.Category.Contains(_velocitySearchTerm, StringComparison.OrdinalIgnoreCase));
        }

        query = _velocitySortBy switch
        {
            "DAYS_ASC" => query.OrderBy(x => x.DaysSinceLastSale).ThenBy(x => x.Name),
            "REVENUE_DESC" => query.OrderByDescending(x => x.Revenue).ThenBy(x => x.Name),
            "STOCK_VALUE_DESC" => query.OrderByDescending(x => x.CurrentStock * (x.WholesaleCost > 0 ? x.WholesaleCost : 12.50m)).ThenBy(x => x.Name),
            "NAME" => query.OrderBy(x => x.Name),
            _ => query.OrderByDescending(x => x.DaysSinceLastSale).ThenBy(x => x.Name)
        };

        return query.ToList();
    }

