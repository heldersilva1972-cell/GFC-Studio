@code {
    private string CleanProductName(string rawName)
    {
        if (string.IsNullOrEmpty(rawName)) return "";
        var name = rawName.Trim();
        if (name.StartsWith("> ")) name = name.Substring(2).Trim();
        if (name.StartsWith("PRIZE:", StringComparison.OrdinalIgnoreCase)) name = name.Substring(6).Trim();
        if (name.StartsWith("TALLY:", StringComparison.OrdinalIgnoreCase)) name = name.Substring(6).Trim();
        if (name.StartsWith("TALLY -", StringComparison.OrdinalIgnoreCase)) name = name.Substring(7).Trim();
        if (name.StartsWith("TALLY", StringComparison.OrdinalIgnoreCase) && name.Length > 5 && !char.IsLetter(name[5])) name = name.Substring(5).Trim(' ', ':', '-');

        if (name.Contains("(TOKEN SALE)", StringComparison.OrdinalIgnoreCase))
        {
            name = name.Replace("(TOKEN SALE)", "", StringComparison.OrdinalIgnoreCase).Trim();
        }
        if (name.Contains("(TALLY)", StringComparison.OrdinalIgnoreCase))
        {
            name = name.Replace("(TALLY)", "", StringComparison.OrdinalIgnoreCase).Trim();
        }
        if (name.Contains("[TALLY]", StringComparison.OrdinalIgnoreCase))
        {
            name = name.Replace("[TALLY]", "", StringComparison.OrdinalIgnoreCase).Trim();
        }

        int parenIndex = name.IndexOf('(');
        if (parenIndex != -1)
        {
            name = name.Substring(0, parenIndex).Trim();
        }
        return name.Trim();
    }

    private List<string> MenuCategories = new();
    private string SelectedCategoryFilter = "ALL";
    private string ItemSortOption = "QTY_DESC";

    private void SetCategoryFilter(string cat)
    {
        SelectedCategoryFilter = cat;
        StateHasChanged();
    }

    private IEnumerable<SummaryResult> GetFilteredSummaryResults()
    {
        var query = SummaryResults.AsEnumerable();
        
        if (SelectedCategoryFilter != "ALL")
        {
            query = query.Where(x => x.Category.Equals(SelectedCategoryFilter, StringComparison.OrdinalIgnoreCase));
        }

        switch (ItemSortOption)
        {
            case "QTY_ASC":
                query = query.OrderBy(x => x.Quantity);
                break;
            case "REV_DESC":
                query = query.OrderByDescending(x => x.Revenue);
                break;
            case "NAME_ASC":
                query = query.OrderBy(x => x.Name);
                break;
            case "QTY_DESC":
            default:
                query = query.OrderByDescending(x => x.Quantity);
                break;
        }

        return query;
    }

    // FOOD & SNACKS AUDIT STATE & MODELS
    private string _foodViewMode = "CHART";
    private string _foodCategoryFilter = "ALL";
    private string _foodSearchText = "";
    private string _foodSortOption = "REV_DESC";

    private async Task SetFoodViewMode(string mode)
    {
        _foodViewMode = mode;
        StateHasChanged();
        if (mode == "CHART")
        {
            await Task.Delay(150);
            await RenderFoodCharts();
        }
    }

    private async Task SetFoodCategoryFilter(string cat)
    {
        _foodCategoryFilter = cat;
        StateHasChanged();
        if (_foodViewMode == "CHART")
        {
            await Task.Delay(50);
            await RenderFoodCharts();
        }
    }

    private async Task OnFoodSearchChanged(ChangeEventArgs e)
    {
        _foodSearchText = e.Value?.ToString() ?? "";
        StateHasChanged();
        if (_foodViewMode == "CHART")
        {
            await Task.Delay(100);
            await RenderFoodCharts();
        }
    }

    private async Task OnFoodSortChanged(ChangeEventArgs e)
    {
        _foodSortOption = e.Value?.ToString() ?? "REV_DESC";
        StateHasChanged();
        if (_foodViewMode == "CHART")
        {
            await Task.Delay(50);
            await RenderFoodCharts();
        }
    }

    private string NormalizeFoodCategory(string cat)
    {
        if (string.IsNullOrWhiteSpace(cat)) return "FOOD & SNACKS";
        var c = cat.Trim().ToUpper();
        if (c == "FOOD" || c == "SNACK" || c == "SNACKS" || c == "CANDY" || c == "CHIPS" || 
            c == "KITCHEN" || c == "PIZZA" || c == "FOOD & SNACKS" || c == "FOOD AND SNACKS" ||
            c == "FOOD & SNACK" || c == "BAKERY" || c == "ICE CREAM")
        {
            return "FOOD & SNACKS";
        }
        if (c == "BEVERAGE" || c == "BEVERAGES" || c == "SODA" || c == "DRINKS" || 
            c == "NON-ALCOHOLIC" || c == "JUICE" || c == "WATER" || c == "COFFEE")
        {
            return "BEVERAGES";
        }
        return c;
    }

    private string GetFoodItemCategory(ProductItem item)
    {
        if (item == null) return "FOOD & SNACKS";
        var cleanName = CleanProductName(item.Name);
        
        // 1. Look up in DbLiquorItems master FIRST (source of truth for catalog categories)
        var liqItem = DbLiquorItems.FirstOrDefault(di => di.Name != null && di.Name.Equals(cleanName, StringComparison.OrdinalIgnoreCase))
                   ?? DbLiquorItems.FirstOrDefault(di => di.Name != null && CleanProductName(di.Name).Equals(cleanName, StringComparison.OrdinalIgnoreCase));
        if (liqItem != null && !string.IsNullOrWhiteSpace(liqItem.Category) && 
            !liqItem.Category.Equals("MISC", StringComparison.OrdinalIgnoreCase) &&
            !liqItem.Category.Equals("INHERITED", StringComparison.OrdinalIgnoreCase) &&
            !liqItem.Category.Equals("GENERAL", StringComparison.OrdinalIgnoreCase))
        {
            return NormalizeFoodCategory(liqItem.Category);
        }

        // 2. Look up in DbItems master
        var dbItem = DbItems.FirstOrDefault(di => di.Name != null && di.Name.Equals(cleanName, StringComparison.OrdinalIgnoreCase))
                  ?? DbItems.FirstOrDefault(di => di.Name != null && CleanProductName(di.Name).Equals(cleanName, StringComparison.OrdinalIgnoreCase));
        if (dbItem != null && !string.IsNullOrWhiteSpace(dbItem.Category) && 
            !dbItem.Category.Equals("MISC", StringComparison.OrdinalIgnoreCase) &&
            !dbItem.Category.Equals("INHERITED", StringComparison.OrdinalIgnoreCase) &&
            !dbItem.Category.Equals("GENERAL", StringComparison.OrdinalIgnoreCase) &&
            !dbItem.Category.Equals("SHIFT TOTAL", StringComparison.OrdinalIgnoreCase))
        {
            return NormalizeFoodCategory(dbItem.Category);
        }

        // 3. Fallback keyword heuristics for standard food categories
        var nameLower = (item.Name ?? "").ToLower().Trim();
        if (nameLower.Contains("soda") || nameLower.Contains("pepsi") || nameLower.Contains("coke") || 
            nameLower.Contains("sprite") || nameLower.Contains("water") || nameLower.Contains("redbull") || 
            nameLower.Contains("red bull") || nameLower.Contains("ginger ale") || nameLower.Contains("tea") ||
            nameLower.Contains("coffee") || nameLower.Contains("juice") || nameLower.Contains("gatorade") ||
            nameLower.Contains("monster") || nameLower.Contains("beverage"))
            return "BEVERAGES";

        // 4. Check explicit category on the item itself if specific
        if (!string.IsNullOrWhiteSpace(item.Category) && 
            !item.Category.Equals("MISC", StringComparison.OrdinalIgnoreCase) && 
            !item.Category.Equals("INHERITED", StringComparison.OrdinalIgnoreCase) && 
            !item.Category.Equals("GENERAL", StringComparison.OrdinalIgnoreCase) && 
            !item.Category.Equals("SHIFT TOTAL", StringComparison.OrdinalIgnoreCase) &&
            !item.Category.Equals("LIQUOR", StringComparison.OrdinalIgnoreCase) &&
            !item.Category.Equals("BAR", StringComparison.OrdinalIgnoreCase))
        {
            return NormalizeFoodCategory(item.Category);
        }

        return "FOOD & SNACKS";
    }

    private async Task RenderFoodCharts()
    {
        if (ActiveTab != "FOOD" || _foodViewMode != "CHART") return;

        try
        {
            var filteredSummary = GetFilteredFoodSummaryList();

            if (!filteredSummary.Any())
            {
                await JSRuntime.InvokeVoidAsync("eval", @"
                    (function() {
                        var el = document.getElementById('foodTopItemsChart');
                        if (el && window.Chart) {
