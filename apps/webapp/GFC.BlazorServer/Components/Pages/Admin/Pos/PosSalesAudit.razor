    private async Task UpdateWeeklyBreakdown()
    {
        _weeklyBreakdownItems.Clear();
        _selectedWeekStart = null;
        _selectedWeekEnd = null;
        if (string.IsNullOrEmpty(_selectedTrendWeek)) return;

        var parts = _selectedTrendWeek.Split(' ');
        if (parts.Length < 2) return;
        var datePart = parts[1]; // e.g. "07/06"
        
        if (!DateTime.TryParseExact(datePart, "MM/dd", global::System.Globalization.CultureInfo.InvariantCulture, global::System.Globalization.DateTimeStyles.None, out var tempDate))
            return;
            
        var weekStart = new DateTime(StartDate.Year, tempDate.Month, tempDate.Day);
        var weekEnd = weekStart.AddDays(7);
        
        _selectedWeekStart = weekStart;
        _selectedWeekEnd = weekEnd;

        using var db = DbFactory.CreateDbContext();
        var query = db.LiquorTransactions.AsNoTracking()
            .Include(t => t.Item)
            .Where(t => t.TransactionType == "Checkout" && t.Item != null && t.Notes != null && t.Notes.Contains("POS End-of-Shift Removal"));

        // Apply Shift Filter
        if (FilterShiftId.HasValue)
        {
            var selectedShift = ZReports.FirstOrDefault(z => z.Id == FilterShiftId.Value) 
                ?? await db.PosZReports.AsNoTracking().FirstOrDefaultAsync(z => z.Id == FilterShiftId.Value);

            if (selectedShift != null)
            {
                var prevZ = await db.PosZReports.AsNoTracking()
                    .Where(r => r.TerminalName == selectedShift.TerminalName && r.Timestamp < selectedShift.Timestamp)
                    .OrderByDescending(r => r.Timestamp)
                    .FirstOrDefaultAsync();

                var shiftStart = prevZ?.Timestamp ?? DateTime.MinValue;
                var shiftEnd = selectedShift.Timestamp;

                query = query.Where(t => t.Timestamp >= shiftStart && t.Timestamp <= shiftEnd);
            }
        }
        else
        {
            query = query.Where(t => t.Timestamp >= weekStart && t.Timestamp < weekEnd);
        }

        // Apply Terminal Filter
        if (!string.IsNullOrEmpty(FilterTerminal))
        {
            query = query.Where(t => t.Notes.Contains($"[{FilterTerminal}]"));
        }

        var pullList = await query.ToListAsync();

        _weeklyBreakdownItems = pullList
            .GroupBy(t => t.Item)
            .Select(g => new WeeklyBreakdownItem
            {
                Name = g.Key.Name,
                Size = g.Key.BottleSize ?? "1L",
                Category = g.Key.Category ?? "LIQUOR",
                Quantity = g.Sum(t => (int)Math.Abs(t.ChangeAmount)),
                UnitCost = g.Key.CurrentPrice
            })
            .OrderByDescending(b => b.Quantity)
            .ToList();
    }

    private string GetBrandStatus(BrandRevenueDetail brand, out string bgColor, out string borderColor, out string textColor, out string icon)
    {
        if (brand.PullsCount == 0)
        {
            if (brand.ShotsSold > 0 || brand.ActualRevenue > 0)
            {
                // Bottle opened in prior month, still pouring on the speed rail
                bgColor = "#eff6ff"; // Soft blue
                borderColor = "#bfdbfe";
                textColor = "text-primary";
                icon = "bi-arrow-repeat text-primary";
                return "Active Rail Depletion (Prior Month Pull)";
            }

            bgColor = "#ffffff";
            borderColor = "#e2e8f0";
            textColor = "text-muted";
            icon = "bi-dash-circle-fill text-muted";
            return "No Pulls";
        }

        var ratio = brand.ActualPerBottle / brand.ExpectedPerBottle;

        if (ratio < 0.90m) // More than 10% below target
        {
            bgColor = "#fff5f5"; // Red
            borderColor = "#fecaca";
            textColor = "text-danger";
            icon = "bi-exclamation-triangle-fill text-danger";
            return "Yield Deficit (Overpour/Loss)";
        }
        else if (ratio > 1.12m) // More than 12% above target (Unrecorded pull suspected)
        {
            var targetPerBottle = brand.ExpectedShotsPerBottle > 0 ? brand.ExpectedShotsPerBottle : 22;
            var expectedShots = brand.PullsCount * targetPerBottle;
            var extraShots = brand.ShotsSold - expectedShots;
            var estMissing = Math.Max(1, (int)Math.Ceiling((double)extraShots / targetPerBottle));
            var btlWord = estMissing == 1 ? "bottle" : "bottles";

            bgColor = "#faf5ff"; // Purple tint
            borderColor = "#d8b4fe";
            textColor = "text-purple";
            icon = "bi-exclamation-circle-fill text-purple";
            return $"Unrecorded Pulls (~{estMissing} {btlWord} missing)";
        }
        else
        {
            bgColor = "#f0fdf4"; // Green
            borderColor = "#bbf7d0";
            textColor = "text-success";
            icon = "bi-check-circle-fill text-success";
            return "Healthy";
        }
    }

