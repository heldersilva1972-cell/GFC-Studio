    private (decimal foodTotal, decimal liquorTotal) GetZReportCategorySummaries(PosZReport z)
    {
        decimal foodTotal = 0;
        decimal liquorTotal = 0;
        var items = GetItemsList(z.SalesSummaryJson);
        foreach (var item in items)
        {
            // (CREDITED) items and TOKEN CREDIT lines were sold/applied as discounts.
            // Skip them here so category sums match TotalGrossSales without artificial inflation.
            if (item.Name.EndsWith(" (CREDITED)") || item.Name.StartsWith("> ") || item.Name.Contains("TOKEN CREDIT"))
                continue;

            var cleanKey = item.Name;
            if (cleanKey.Contains(" (TOKEN SALE)")) cleanKey = cleanKey.Replace(" (TOKEN SALE)", "");
            if (cleanKey.Contains(" (TOKEN REDEEMED)")) cleanKey = cleanKey.Replace(" (TOKEN REDEEMED)", "");

            var product = DbLiquorItems.FirstOrDefault(i => i.Name != null && i.Name.Equals(cleanKey, StringComparison.OrdinalIgnoreCase));
            if (product == null && cleanKey.Contains(" (") && cleanKey.EndsWith(")"))
            {
                int openIdx = cleanKey.IndexOf(" (");
                string innerName = cleanKey.Substring(openIdx + 2, cleanKey.Length - openIdx - 3).Trim();
                product = DbLiquorItems.FirstOrDefault(i => i.Name != null && i.Name.Equals(innerName, StringComparison.OrdinalIgnoreCase));
            }

            var category = !string.IsNullOrEmpty(product?.Category) ? product.Category : (item.Category ?? "");
            if ((string.Equals(category, "TOKENS", StringComparison.OrdinalIgnoreCase) || string.IsNullOrEmpty(category)) && (item.Name.Contains("TOKEN") || item.Name.Contains("Token")))
            {
                category = "LIQUOR";
            }

            var catUpper = category.ToUpper();
            var itemNameLower = item.Name.ToLower();
            decimal price = item.Price > 0 ? item.Price : (product?.RetailPrice ?? 0);
            if (price == 0 && (item.Name.Contains("TOKEN") || item.Name.Contains("Token")))
            {
                var token = MasterTokens.FirstOrDefault(t => t.Name.Equals(cleanKey, StringComparison.OrdinalIgnoreCase));
                if (token != null) price = token.SalePrice;
            }
            // TOKEN REDEEMED items have no cash value — skip them
            if (item.Name.Contains("(TOKEN REDEEMED)") || item.Name.Contains("TOKEN REDEEMED"))
                continue;

            decimal total = price * item.Quantity;

            // 1. Evaluate Item-level ZReportGroup override
            int effectiveGroup = (product != null && product.ZReportGroup > 0) ? product.ZReportGroup : item.ZReportGroup;

            // 2. If Item-level is 0 (Inherit), evaluate Category-level ZReportGroup
            if (effectiveGroup == 0 && !string.IsNullOrEmpty(category))
            {
                var catModel = DbPosCategories.FirstOrDefault(c => c.Name.Equals(category, StringComparison.OrdinalIgnoreCase));
                if (catModel != null && catModel.ZReportGroup > 0)
                {
                    effectiveGroup = catModel.ZReportGroup;
                }
            }

            // 3. Category Group Tally
            if (effectiveGroup == 1) // Explicit Food & Non-Alcoholic
            {
                foodTotal += total;
            }
            else if (effectiveGroup == 2) // Explicit Liquor & Alcohol
            {
                liquorTotal += total;
            }
            else if (effectiveGroup == 3) // Excluded / Non-Sales
            {
                // Skip
            }
            else // Default System Rules (Group == 0)
            {
                if (catUpper == "FOOD" || catUpper == "CANDY" || catUpper == "SNACK" || catUpper == "SNACKS" || catUpper == "NON-ALCOHOLIC" || catUpper == "BEVERAGE" || catUpper == "BEVERAGES" || catUpper == "SODA" || catUpper == "WATER" || itemNameLower.Contains("soda") || itemNameLower.Contains("water") || itemNameLower.Contains("redbull") || itemNameLower.Contains("red bull"))
                {
                    foodTotal += total;
                }
                else
                {
                    liquorTotal += total;
                }
            }
        }

        return (foodTotal, liquorTotal);
    }

    private List<PosTerminal.ProductItem> GetItemsList(string json)
    {
        try 
        {
            if (string.IsNullOrEmpty(json)) return new();
            
            var options = new JsonSerializerOptions { PropertyNameCaseInsensitive = true };

            // 1. Try List format (Direct Sales)
            try {
                var list = JsonSerializer.Deserialize<List<PosTerminal.ProductItem>>(json, options);
                if (list != null && list.Any(x => x != null && !string.IsNullOrEmpty(x.Name))) return list;
            } catch { }

            // 2. Try Dictionary format (Shift Audit / Z-Reports)
            try {
                var dict = JsonSerializer.Deserialize<Dictionary<string, int>>(json, options);
                if (dict != null) {
                    return dict.Select(kvp => {
                        // Attempt to find the price from our loaded master list
                        var dbItem = DbItems.FirstOrDefault(i => i != null && i.Name != null && i.Name.Equals(kvp.Key, StringComparison.OrdinalIgnoreCase));
                        decimal price = dbItem?.Price ?? 0;
                        if (price == 0 && kvp.Key.Contains(" (TOKEN SALE)"))
                        {
                            var tokenMatch = MasterTokens.OrderByDescending(t => t.Name.Length)
                                .FirstOrDefault(t => kvp.Key.StartsWith(t.Name, StringComparison.OrdinalIgnoreCase));
                            if (tokenMatch != null)
                            {
                                price = tokenMatch.SalePrice;
                            }
                        }
                        return new PosTerminal.ProductItem { 
                            Name = kvp.Key, 
                            Quantity = kvp.Value,
                            Price = price,
                            Category = dbItem?.Category ?? (kvp.Key.Contains("TOKEN") ? "TOKENS" : "SHIFT TOTAL"),
                            ZReportGroup = dbItem?.ZReportGroup ?? 0
                        };
                    }).ToList();
                }
            } catch { }

            return new();
        }
        catch { return new(); }
    }

