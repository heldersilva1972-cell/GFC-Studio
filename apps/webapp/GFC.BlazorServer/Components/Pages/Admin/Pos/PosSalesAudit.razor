    public class ProductAuditMetric
    {
        public string Name { get; set; } = "";
        public string Category { get; set; } = "UNCATEGORIZED";
        public int Quantity { get; set; }
        public decimal Revenue { get; set; }
        public int CurrentStock { get; set; }
        public int MinStockLimit { get; set; }
        public int PackSize { get; set; } = 1;
        public decimal WholesaleCost { get; set; } = 12.50m;
        public int Quantity30D { get; set; }
        public int QuantityYoY { get; set; }
        public bool IsLiquor { get; set; } = false;
        public decimal PourSizeOz { get; set; } = 1.5m;
        public decimal BottleVolumeOz { get; set; } = 25.36m;

        public DateTime? LastSoldDate { get; set; }
        public int DaysSinceLastSale => LastSoldDate.HasValue ? (int)Math.Max(0, Math.Floor((DateTime.Now - LastSoldDate.Value).TotalDays)) : 999;
        public string VelocityStatus => DaysSinceLastSale switch
        {
            <= 7 => "FAST_MOVER",
            <= 30 => "MODERATE",
            <= 60 => "SLOW_MOVER",
            _ => "DEAD_STOCK"
        };

        public double TotalOuncesPoured => (double)(Quantity * PourSizeOz);
        public double LiquorBottlesUsed => BottleVolumeOz > 0 ? TotalOuncesPoured / (double)BottleVolumeOz : 0;

        public int GetProjected7DayDemand(string mode)
        {
            double daily30D = Quantity30D > 0 ? (double)Quantity30D / 30.0 : (double)Quantity / 30.0;
            double dailyYoY = (double)QuantityYoY / 30.0;

            double blendedDailyRate = mode switch
            {
                "Recent" => daily30D,
                "YoY" => dailyYoY,
                _ => (daily30D * 0.60) + (dailyYoY * 0.40)
            };

            return (int)Math.Ceiling(blendedDailyRate * 7.0);
        }

        public int GetTargetStock(string mode) => Math.Max(GetProjected7DayDemand(mode), MinStockLimit > 0 ? MinStockLimit : 2);
        public int GetNetUnitsNeeded(string mode) => Math.Max(0, GetTargetStock(mode) - CurrentStock);
        public int GetRecommendedCases(string mode) => PackSize > 1 ? (int)Math.Ceiling((double)GetNetUnitsNeeded(mode) / PackSize) : 0;

        public int GetStockRunwayDays(string mode)
        {
            int projected7D = GetProjected7DayDemand(mode);
            if (projected7D <= 0) return 99;
            double burnPerDay = projected7D / 7.0;
            return (int)Math.Floor(CurrentStock / burnPerDay);
        }
    }

    private bool IsItemInSelectedCategory(ProductAuditMetric item)
    {
        var nameUpper = item.Name?.ToUpper() ?? "";
        var cat = item.Category?.ToUpper() ?? "";

        // Strictly exclude tokens, prizes, deposits, corrections, payouts, NO SALE, drawer open events
        if (nameUpper.Contains("TOKEN") || nameUpper.Contains("PRIZE") || nameUpper.Contains("DEPOSIT") || 
            nameUpper.Contains("CORRECTION") || nameUpper.Contains("PAYOUT") || nameUpper.Contains("CREDIT") ||
            nameUpper.Contains("NO SALE") || nameUpper.Contains("NO_SALE") || nameUpper.Contains("DRAWER") ||
            cat.Contains("TOKEN") || cat.Contains("DEPOSIT") || cat.Contains("PAYOUT") || cat.Contains("CORRECTION") || cat.Contains("CREDIT") || cat.Contains("NO SALE"))
        {
            return false;
        }

        if (_auditCategoryFilter == "ALL") return true;

        if (_auditCategoryFilter == "ALL_BEVERAGES")
        {
            return cat != "FOOD" && cat != "FOODS" && cat != "SNACKS" && cat != "SNACK" && cat != "NON-ALCHOHOLIC" && cat != "NON-ALCOHOLIC";
        }

        if (_auditCategoryFilter == "FOOD")
        {
            return cat == "FOOD" || cat == "FOODS" || cat == "SNACKS" || cat == "SNACK";
        }

        return cat.Contains(_auditCategoryFilter, StringComparison.OrdinalIgnoreCase);
    }

    private List<ProductAuditMetric> _auditProductMetrics = new();

    private void BuildProductAuditMetrics()
    {
        var dict = new Dictionary<string, ProductAuditMetric>(StringComparer.OrdinalIgnoreCase);

        // Populate baseline from active master inventory items (Exclude child items like Glasses of Wine with ParentItemId and ExcludeFromPredictions)
        foreach (var item in DbLiquorItems.Where(i => i.IsActive && !i.ParentItemId.HasValue && !i.ExcludeFromPredictions))
        {
            var key = item.Name?.Trim() ?? "";
            if (string.IsNullOrEmpty(key)) continue;

            var upperKey = key.ToUpper();
            var catUpper = (item.Category ?? "").ToUpper();

            // Skip token items, deposits, corrections, prizes, NO SALE, drawer kick events, etc.
            if (upperKey.Contains("TOKEN") || upperKey.Contains("PRIZE") || upperKey.Contains("DEPOSIT") || 
                upperKey.Contains("CORRECTION") || upperKey.Contains("PAYOUT") || upperKey.Contains("NO SALE") || 
                upperKey.Contains("NO_SALE") || upperKey.Contains("DRAWER") ||
                catUpper.Contains("TOKEN") || catUpper.Contains("DEPOSIT") || catUpper.Contains("CORRECTION") || catUpper.Contains("NO SALE"))
            {
                continue;
            }

            var cleanName = CleanProductName(item.Name);
            if (!dict.ContainsKey(cleanName))
            {
                dict[cleanName] = new ProductAuditMetric
                {
                    Name = cleanName,
                    Category = !string.IsNullOrEmpty(item.Category) ? item.Category.ToUpper() : "UNCATEGORIZED",
                    CurrentStock = (int)GetEffectiveStock(item),
                    MinStockLimit = item.MinStockLimit,
                    PackSize = item.PackSize > 0 ? item.PackSize : 1,
                    WholesaleCost = (item.CasePrice.HasValue && item.PackSize > 1 ? item.CasePrice.Value / item.PackSize : (item.CurrentPrice > 0 ? item.CurrentPrice : 12.50m)),
                    IsLiquor = IsLiquorInventoryItem(item),
                    PourSizeOz = item.PourSize > 0 ? item.PourSize : 1.5m,
                    BottleVolumeOz = item.BottleVolumeOunces.HasValue && item.BottleVolumeOunces > 0 ? item.BottleVolumeOunces.Value : 25.36m
                };
            }
        }

        var salesToProcess = (_allSalesForStats != null && _allSalesForStats.Any()) ? _allSalesForStats : Sales;
        _cachedSalesItems = new List<CachedSaleItem>();

        // Pre-build fast O(1) dictionaries to eliminate 7+ million linear searches on month filters
        var liquorByName = DbLiquorItems
            .Where(i => !string.IsNullOrEmpty(i.Name))
            .GroupBy(i => CleanProductName(i.Name), StringComparer.OrdinalIgnoreCase)
            .ToDictionary(g => g.Key, g => g.First(), StringComparer.OrdinalIgnoreCase);

        var liquorById = DbLiquorItems.ToDictionary(i => i.Id, i => i);

        var terminalByName = DbItems
            .Where(i => i != null && !string.IsNullOrEmpty(i.Name))
            .GroupBy(i => CleanProductName(i.Name), StringComparer.OrdinalIgnoreCase)
            .ToDictionary(g => g.Key, g => g.First(), StringComparer.OrdinalIgnoreCase);

        var tokenUsageByName = TokenUsages
            .Where(u => u != null && u.DrinkName != null && u.MenuPrice > 0)
            .GroupBy(u => CleanProductName(u.DrinkName), StringComparer.OrdinalIgnoreCase)
            .ToDictionary(g => g.Key, g => g.First().MenuPrice, StringComparer.OrdinalIgnoreCase);

        // Aggregate actual POS sales (CASH, TAB, and TOKEN/COMP transactions)
        foreach (var sale in salesToProcess)
        {
            if (sale.IsVoided) continue;

            var items = GetItemsList(sale.ItemsJson);
            foreach (var sItem in items)
            {
                var cleanName = CleanProductName(sItem.Name);
                if (string.IsNullOrEmpty(cleanName)) continue;

                var upperClean = cleanName.ToUpper();
                if (upperClean.Contains("TOKEN") || upperClean.Contains("PRIZE") || upperClean.Contains("DEPOSIT") || 
                    upperClean.Contains("CORRECTION") || upperClean.Contains("PAYOUT") || upperClean.Contains("CREDIT") ||
                    upperClean.Contains("NO SALE") || upperClean.Contains("NO_SALE") || upperClean.Contains("DRAWER"))
                {
                    continue;
                }

                // If sale item corresponds to a child item (e.g. Glass of Wine), map sales volume/revenue to parent item
                liquorByName.TryGetValue(cleanName, out var matchedDbItem);
                if (matchedDbItem != null && matchedDbItem.ParentItemId.HasValue)
                {
                    if (liquorById.TryGetValue(matchedDbItem.ParentItemId.Value, out var parentItem))
                    {
                        cleanName = parentItem.Name.Trim();
                        matchedDbItem = parentItem;
                    }
                }

                decimal price = sItem.Price;
                if (price == 0)
                {
                    if (matchedDbItem != null && (matchedDbItem.CurrentPrice > 0 || matchedDbItem.RetailPrice > 0))
                    {
                        price = matchedDbItem.CurrentPrice > 0 ? matchedDbItem.CurrentPrice : matchedDbItem.RetailPrice;
                    }
                    else if (terminalByName.TryGetValue(cleanName, out var dbTermItem) && dbTermItem.Price > 0)
                    {
                        price = dbTermItem.Price;
                    }
                    else if (tokenUsageByName.TryGetValue(cleanName, out var uPrice))
                    {
                        price = uPrice;
                    }
                }

                _cachedSalesItems.Add(new CachedSaleItem
                {
                    Timestamp = sale.Timestamp,
                    CleanName = cleanName,
                    Quantity = sItem.Quantity,
                    Price = price,
                    IsVoided = sale.IsVoided
                });

                if (!dict.TryGetValue(cleanName, out var metric))
                {
                    var checkCat = (sItem.Category ?? "").ToUpper();
                    if (checkCat.Contains("TOKEN") || checkCat.Contains("DEPOSIT")) continue;

                    metric = new ProductAuditMetric
                    {
                        Name = cleanName,
                        Category = !string.IsNullOrEmpty(sItem.Category) ? sItem.Category.ToUpper() : (matchedDbItem?.Category?.ToUpper() ?? "POS ITEM"),
                        WholesaleCost = (matchedDbItem?.CasePrice.HasValue == true && matchedDbItem.PackSize > 1 ? matchedDbItem.CasePrice.Value / matchedDbItem.PackSize : 12.50m),
                        IsLiquor = matchedDbItem != null ? IsLiquorInventoryItem(matchedDbItem) : false
                    };
                    dict[cleanName] = metric;
                }

                metric.Quantity += sItem.Quantity;
                metric.Revenue += price * sItem.Quantity;
            }
        }

        // Calculate Trailing 30D, YoY Sales, and Extended 180-day History for accurate LastSoldDate
        try
        {
            using var db = DbFactory.CreateDbContext();
            var thirtyDaysAgo = DateTime.Today.AddDays(-30);
            var historySales = db.PosSales.AsNoTracking()
                .Where(s => s.Timestamp >= DateTime.Today.AddDays(-180) && !s.IsVoided && (!s.ActiveEventId.HasValue || s.ActiveEventId.Value <= 0) && s.PaymentType != "DEPOSIT")
                .Select(s => new { s.Timestamp, s.ItemsJson })
                .ToList();

            foreach (var saleRecord in historySales)
            {
                var items = GetItemsList(saleRecord.ItemsJson);
                foreach (var sItem in items)
                {
                    var cleanName = CleanProductName(sItem.Name);
                    if (liquorByName.TryGetValue(cleanName, out var matchedDbItem) && matchedDbItem.ParentItemId.HasValue)
                    {
                        if (liquorById.TryGetValue(matchedDbItem.ParentItemId.Value, out var parentItem))
                        {
                            cleanName = parentItem.Name.Trim();
                        }
                    }

                    if (dict.TryGetValue(cleanName, out var metric))
                    {
                        if (saleRecord.Timestamp >= thirtyDaysAgo)
                        {
                            metric.Quantity30D += sItem.Quantity;
                        }

                        if (!metric.LastSoldDate.HasValue || saleRecord.Timestamp > metric.LastSoldDate.Value)
                        {
                            metric.LastSoldDate = saleRecord.Timestamp;
                        }
                    }
                }
            }

            var lastYearStart = new DateTime(DateTime.Today.Year - 1, DateTime.Today.Month, 1);
            var lastYearEnd = lastYearStart.AddMonths(1).AddDays(-1);
            var yoySales = db.PosSales.AsNoTracking()
                .Where(s => s.Timestamp >= lastYearStart && s.Timestamp <= lastYearEnd && !s.IsVoided && (!s.ActiveEventId.HasValue || s.ActiveEventId.Value <= 0) && s.PaymentType != "DEPOSIT")
                .Select(s => s.ItemsJson)
                .ToList();

            foreach (var itemsJson in yoySales)
            {
                var items = GetItemsList(itemsJson);
                foreach (var sItem in items)
                {
                    var cleanName = CleanProductName(sItem.Name);
                    if (liquorByName.TryGetValue(cleanName, out var matchedDbItem) && matchedDbItem.ParentItemId.HasValue)
                    {
                        if (liquorById.TryGetValue(matchedDbItem.ParentItemId.Value, out var parentItem))
                        {
                            cleanName = parentItem.Name.Trim();
                        }
                    }

                    if (dict.TryGetValue(cleanName, out var metric))
                    {
                        metric.QuantityYoY += sItem.Quantity;
                    }
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error computing historical sales in BuildProductAuditMetrics: {ex.Message}");
        }

        // Include current in-memory shift sales for up-to-the-minute LastSoldDate
        if (_cachedSalesItems != null && _cachedSalesItems.Any())
        {
            foreach (var saleItem in _cachedSalesItems)
            {
                if (saleItem.IsVoided) continue;
                var cleanName = saleItem.CleanName;
                var matchedDbItem = DbLiquorItems.FirstOrDefault(i => i.Name != null && i.Name.Equals(cleanName, StringComparison.OrdinalIgnoreCase));
                if (matchedDbItem != null && matchedDbItem.ParentItemId.HasValue)
                {
                    var parentItem = DbLiquorItems.FirstOrDefault(p => p.Id == matchedDbItem.ParentItemId.Value);
                    if (parentItem != null) cleanName = parentItem.Name.Trim();
                }

                if (dict.TryGetValue(cleanName, out var metric))
                {
                    if (!metric.LastSoldDate.HasValue || saleItem.Timestamp > metric.LastSoldDate.Value)
                    {
                        metric.LastSoldDate = saleItem.Timestamp;
                    }
                }
            }
        }

        _auditProductMetrics = dict.Values.ToList();
    }

    private string _productTrendsSubView = "TRENDS"; // "TRENDS" or "VELOCITY"
    private string _velocityStatusFilter = "ALL"; // "ALL", "FAST_MOVER", "MODERATE", "SLOW_MOVER", "DEAD_STOCK"
    private string _velocitySortBy = "DAYS_ASC"; // Default to Most Recent Sale first!
    private string _velocitySearchTerm = "";

    private List<ProductAuditMetric> GetFilteredAuditVelocityMetrics()
    {
        var query = _auditProductMetrics.Where(x => IsItemInSelectedCategory(x));

        if (_velocityStatusFilter == "FAST_MOVER")
        {
            query = query.Where(x => x.LastSoldDate.HasValue && x.DaysSinceLastSale <= 7);
        }
        else if (_velocityStatusFilter == "MODERATE")
        {
            query = query.Where(x => x.LastSoldDate.HasValue && x.DaysSinceLastSale > 7 && x.DaysSinceLastSale <= 30);
        }
        else if (_velocityStatusFilter == "SLOW_MOVER")
        {
            query = query.Where(x => x.LastSoldDate.HasValue && x.DaysSinceLastSale > 30 && x.DaysSinceLastSale <= 60);
        }
        else if (_velocityStatusFilter == "DEAD_STOCK")
        {
            query = query.Where(x => !x.LastSoldDate.HasValue || x.DaysSinceLastSale > 60);
        }

        if (!string.IsNullOrWhiteSpace(_velocitySearchTerm))
        {
            query = query.Where(x => x.Name.Contains(_velocitySearchTerm, StringComparison.OrdinalIgnoreCase) || x.Category.Contains(_velocitySearchTerm, StringComparison.OrdinalIgnoreCase));
        }

        query = _velocitySortBy switch
        {
            "DAYS_ASC" => query.OrderBy(x => !x.LastSoldDate.HasValue).ThenBy(x => x.DaysSinceLastSale).ThenBy(x => x.Name),
            "REVENUE_DESC" => query.OrderByDescending(x => x.Revenue).ThenBy(x => x.Name),
            "STOCK_VALUE_DESC" => query.OrderByDescending(x => x.CurrentStock * (x.WholesaleCost > 0 ? x.WholesaleCost : 12.50m)).ThenBy(x => x.Name),
            "NAME" => query.OrderBy(x => x.Name),
            _ => query.OrderByDescending(x => x.DaysSinceLastSale).ThenBy(x => x.Name)
        };

        return query.ToList();
    }

