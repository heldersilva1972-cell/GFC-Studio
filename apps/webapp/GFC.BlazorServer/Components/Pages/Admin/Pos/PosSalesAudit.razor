    private async Task SaveAdjustment()
    {
        if (_currentTokenToAdjust == null) return;

        using var db = DbFactory.CreateDbContext();
        var token = await db.PosTokens.FindAsync(_currentTokenToAdjust.Id);
        if (token != null)
        {
            token.StartingLiabilityBalance = _adjustmentValue;
            await db.SaveChangesAsync();
            _showAdjustmentModal = false;
            await LoadSales(); // Refresh everything
        }
    }

