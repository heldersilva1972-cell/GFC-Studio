    private async Task RenderVelocityMovementChart()
    {
        try
        {
            IEnumerable<ProductAuditMetric> sorted = GetFilteredAuditVelocityMetrics();

            if (_velocityChartTopLimit > 0)
            {
                sorted = sorted.Take(_velocityChartTopLimit);
            }

            var itemList = sorted.ToList();
            if (!itemList.Any())
            {
                itemList = _auditProductMetrics.Take(15).ToList();
            }

            var labels = itemList.Select(x => x.Name.ToUpper()).ToArray();

            double[] data;
            string datasetLabel;
            string[] colors;
            string[] displayTexts;
            string[] tooltipDetails;

            if (_velocityChartMetric == "VALUE")
            {
                data = itemList.Select(x => {
                    decimal val = x.CurrentStock * (x.WholesaleCost > 0 ? x.WholesaleCost : 12.50m);
                    if (val == 0 && x.Revenue > 0) val = x.Revenue;
                    return (double)val;
                }).ToArray();
                datasetLabel = "Stock Capital at Risk ($)";
                displayTexts = itemList.Select(x => {
                    decimal val = x.CurrentStock * (x.WholesaleCost > 0 ? x.WholesaleCost : 12.50m);
                    if (val == 0 && x.Revenue > 0) val = x.Revenue;
                    return "$" + val.ToString("N0");
                }).ToArray();
                tooltipDetails = itemList.Select(x => {
                    decimal val = x.CurrentStock * (x.WholesaleCost > 0 ? x.WholesaleCost : 12.50m);
                    return $" Stock Capital at Risk: ${val:N2} ({x.CurrentStock} units on hand)";
                }).ToArray();
            }
            else
            {
                // Cap visual bar height at 60 for clean readable scaling (prevents 999 skew on axis)
                data = itemList.Select(x => {
                    if (!x.LastSoldDate.HasValue) return 60.0;
                    if (x.DaysSinceLastSale <= 0) return 0.4;
                    if (x.DaysSinceLastSale > 60) return 60.0;
                    return (double)x.DaysSinceLastSale;
                }).ToArray();
                datasetLabel = "Days Since Last Sale";
                displayTexts = itemList.Select(x => {
                    if (!x.LastSoldDate.HasValue) return "Never";
                    if (x.DaysSinceLastSale <= 0) return "Today";
                    if (x.DaysSinceLastSale >= 60) return $"{x.DaysSinceLastSale}d (60+)";
                    return $"{x.DaysSinceLastSale}d";
                }).ToArray();
                tooltipDetails = itemList.Select(x => {
                    if (!x.LastSoldDate.HasValue) return " Last Sold: Never / No sales on record (Dormant)";
                    return $" Last Sold: {x.LastSoldDate.Value:MMM dd, yyyy h:mm tt} ({x.DaysSinceLastSale} days ago)";
                }).ToArray();
            }

            colors = itemList.Select(x => x.VelocityStatus switch
            {
                "FAST_MOVER" => "rgba(34, 197, 94, 0.85)",
                "MODERATE" => "rgba(234, 179, 8, 0.85)",
                "SLOW_MOVER" => "rgba(249, 115, 22, 0.85)",
                _ => "rgba(190, 18, 60, 0.85)"
            }).ToArray();

            await Task.Delay(50);
            await JSRuntime.InvokeVoidAsync("inventoryCharts.renderVelocityMovementChart", "velocityMovementChart", new {
                labels,
                data,
                colors,
                displayTexts,
                tooltipDetails,
                datasetLabel,
                metricType = _velocityChartMetric,
                horizontal = _velocityChartHorizontal
            });
        }
        catch (Exception ex)
        {
            Console.WriteLine("Error rendering velocity movement chart: " + ex.Message);
        }
    }

