    private async Task RenderVelocityMovementChart()
    {
        try
        {
            IEnumerable<ProductAuditMetric> sorted = GetFilteredAuditVelocityMetrics();

            if (_velocityChartTopLimit > 0)
            {
                sorted = sorted.Take(_velocityChartTopLimit);
            }

            var itemList = sorted.ToList();
            if (!itemList.Any())
            {
                itemList = _auditProductMetrics.Take(15).ToList();
            }

            var labels = itemList.Select(x => x.Name.ToUpper()).ToArray();

            double[] data;
            string datasetLabel;
            string[] colors;

            if (_velocityChartMetric == "VALUE")
            {
                data = itemList.Select(x => {
                    decimal val = x.CurrentStock * (x.WholesaleCost > 0 ? x.WholesaleCost : 12.50m);
                    if (val == 0 && x.Revenue > 0) val = x.Revenue;
                    return (double)val;
                }).ToArray();
                datasetLabel = "Stock Capital at Risk ($)";
            }
            else
            {
                data = itemList.Select(x => x.DaysSinceLastSale <= 0 ? 0.4 : (double)x.DaysSinceLastSale).ToArray();
                datasetLabel = "Days Since Last Sale";
            }

            colors = itemList.Select(x => x.VelocityStatus switch
            {
                "FAST_MOVER" => "rgba(34, 197, 94, 0.85)",
                "MODERATE" => "rgba(234, 179, 8, 0.85)",
                "SLOW_MOVER" => "rgba(249, 115, 22, 0.85)",
                _ => "rgba(190, 18, 60, 0.85)"
            }).ToArray();

            await Task.Delay(50);
            await JSRuntime.InvokeVoidAsync("inventoryCharts.renderVelocityMovementChart", "velocityMovementChart", new {
                labels,
                data,
                colors,
                datasetLabel,
                metricType = _velocityChartMetric,
                horizontal = _velocityChartHorizontal
            });
        }
        catch (Exception ex)
        {
            Console.WriteLine("Error rendering velocity movement chart: " + ex.Message);
        }
    }

