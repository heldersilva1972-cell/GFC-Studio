    protected override async Task OnInitializedAsync()
    {
        _objRef = DotNetObjectReference.Create(this);
        try {
            _settings = await SystemSettingsService.GetAsync();
            using var db = DbFactory.CreateDbContext();
            
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            if (user.Identity?.IsAuthenticated == true)
            {
                _currentUser = await db.AppUsers.FirstOrDefaultAsync(u => u.Username == user.Identity.Name);
            }
            
            // Load master price list for Z-Report lookups
            List<LiquorItem> items;
            try {
                items = await db.LiquorItems.AsNoTracking().ToListAsync();
                DbLocationStocks = await db.LiquorLocationStocks.AsNoTracking().ToListAsync();
            } catch (global::System.Exception ex) {
                throw new global::System.Exception("Error loading LiquorItems in OnInitializedAsync: " + ex.Message, ex);
            }
            var overrides = await db.PosMenuOverrides.AsNoTracking().ToListAsync();
            DbPosCategories = await db.PosCategories.AsNoTracking().ToListAsync();
            MasterTokens = await db.PosTokens.AsNoTracking().ToListAsync();

            // Apply POS Menu Manager price/category overrides to raw items
            foreach (var item in items)
            {
                var ovr = overrides.FirstOrDefault(o => o.LiquorItemId == item.Id);
                if (ovr != null)
                {
                    if (ovr.OverridePrice.HasValue)
                    {
                        item.RetailPrice = ovr.OverridePrice.Value;
                    }
                    if (!string.IsNullOrEmpty(ovr.OverrideCategory))
                    {
                        item.Category = ovr.OverrideCategory;
                    }
                }
            }

            DbItems = items.Select(i => {
                var price = i.RetailPrice;
                var category = i.Category ?? "MISC";
                
                if (price == 0)
                {
                    var ovr = overrides.FirstOrDefault(o => o.LiquorItemId == i.Id && o.OverridePrice.HasValue);
                    if (ovr != null) price = ovr.OverridePrice.Value;
                }

                if (string.IsNullOrEmpty(i.Category))
                {
                    var ovr = overrides.FirstOrDefault(o => o.LiquorItemId == i.Id && !string.IsNullOrEmpty(o.OverrideCategory));
                    if (ovr != null) category = ovr.OverrideCategory;
                }

                return new ProductItem { 
                    Name = i.Name, 
                    Price = price, 
                    Category = category,
                    ZReportGroup = i.ZReportGroup
                };
            }).ToList();

            // Populate menu categories directly from database LiquorItems (excluding TOKENS & SHIFT TOTAL)
            MenuCategories = items.Where(i => !string.IsNullOrEmpty(i.Category) && 
                                              i.Category.ToUpper() != "TOKENS" && 
                                              i.Category.ToUpper() != "SHIFT TOTAL")
                                  .Select(i => i.Category.ToUpper())
                                  .Distinct()
                                  .OrderBy(c => c)
                                  .ToList();

            DbLiquorItems = items;
            try {
                DbPosCategories = await db.PosCategories.AsNoTracking().ToListAsync();
            } catch {}

            // Initialize Category and Item Selection Options
            var allLiquor = items.Where(i => !i.IsUnitBased && !i.IsBeer).ToList();
            foreach (var item in allLiquor)
            {
                var cat = (item.Category ?? "MISC").ToUpper();
                if (!_categoryOptions.ContainsKey(cat))
                {
                    _categoryOptions[cat] = true; // Enabled by default
                }
                _itemOptions[item.Name] = true; // Enabled by default
                var cleaned = CleanProductName(item.Name);
                if (!string.IsNullOrEmpty(cleaned))
                {
                    _itemOptions[cleaned] = true;
                }

                _itemLookup[item.Name] = item; // Quick lookup
                if (!string.IsNullOrEmpty(cleaned))
                {
                    _itemLookup[cleaned] = item;
                }
            }

            try {
                await CalculateLifetimeTokens(db);
            } catch (global::System.Exception ex) {
                throw new global::System.Exception("Error in CalculateLifetimeTokens: " + ex.Message, ex);
            }
            await LoadSales();
            
            try {
                await LoadRevenueAnalysisData();
            } catch (global::System.Exception ex) {
                // Fail silently or log
            }
        } catch (global::System.Exception ex) {
            global::System.IO.File.WriteAllText(@"C:\Users\hnsil\Desktop\PosAuditError.txt", ex.ToString());
            throw;
        }
    }

