    private List<BartenderTokenMetric> GetBartenderTokenMetrics()
    {
        var dict = new Dictionary<string, BartenderTokenMetric>(StringComparer.OrdinalIgnoreCase);

        foreach (var s in TokenSalesList)
        {
            var name = string.IsNullOrWhiteSpace(s.BartenderName) ? "Unassigned" : s.BartenderName.Trim();
            if (!dict.TryGetValue(name, out var metric))
            {
                metric = new BartenderTokenMetric { BartenderName = name };
                dict[name] = metric;
            }
            metric.Sold += s.Quantity;
            metric.CashCollected += s.TotalCash;
        }

        foreach (var u in TokenUsages)
        {
            var name = string.IsNullOrWhiteSpace(u.BartenderName) ? "Unassigned" : u.BartenderName.Trim();
            if (!dict.TryGetValue(name, out var metric))
            {
                metric = new BartenderTokenMetric { BartenderName = name };
                dict[name] = metric;
            }
            metric.Redeemed += u.Quantity;
            metric.MenuValueRedeemed += u.MenuPrice * u.Quantity;
        }

        return dict.Values
            .Where(x => x.Sold > 0 || x.Redeemed > 0)
            .OrderByDescending(x => x.Sold + x.Redeemed)
            .ThenBy(x => x.BartenderName)
            .ToList();
    }

    private (string ProductName, string TokenCategory, bool IsGeneric) ParseTokenSaleItem(string rawName)
    {
        if (string.IsNullOrWhiteSpace(rawName)) return ("Generic Token", "Generic Token", true);
        
        string clean = rawName.Trim();
        if (clean.StartsWith("> ")) clean = clean.Substring(2).Trim();
        
        clean = clean.Replace("(TOKEN SALE)", "", StringComparison.OrdinalIgnoreCase)
                     .Replace("(DARTS)", "", StringComparison.OrdinalIgnoreCase)
                     .Trim();

        int firstParen = clean.IndexOf('(');
        int lastParen = clean.LastIndexOf(')');
        if (firstParen != -1 && lastParen > firstParen)
        {
            string tokenPart = clean.Substring(0, firstParen).Trim();
            string drinkPart = clean.Substring(firstParen + 1, lastParen - firstParen - 1).Trim();
            
            if (!string.IsNullOrWhiteSpace(drinkPart))
            {
                return (CleanProductName(drinkPart), string.IsNullOrWhiteSpace(tokenPart) ? "Specific Drink Token" : tokenPart, false);
            }
        }

        var upper = clean.ToUpper();
        bool isGeneric = upper.Contains("BEER TOKEN") || upper.Contains("DRINK TOKEN") || upper.Contains("LIQUOR TOKEN") || upper == "TOKEN" || upper == "TOKENS";
        string category = isGeneric ? (upper.Contains("BEER") ? "Generic Beer Token" : "Generic Mixed Drink Token") : "Specific Drink Token";
        
        return (clean, category, isGeneric);
    }

    private List<ProductTokenFlowMetric> GetProductTokenFlowMetrics()
    {
        var dict = new Dictionary<string, ProductTokenFlowMetric>(StringComparer.OrdinalIgnoreCase);

        // 1. Tokens Sold (Generic Beer / Mixed Drink tokens + Tokens sold for specific drinks)
        foreach (var s in TokenSalesList)
        {
            var (prodName, catName, isGen) = ParseTokenSaleItem(s.ItemName);

            if (!dict.TryGetValue(prodName, out var metric))
            {
                metric = new ProductTokenFlowMetric
                {
                    ProductName = prodName,
                    IsGenericToken = isGen,
                    TokenCategory = catName
                };
                dict[prodName] = metric;
            }
            metric.TokensSoldQty += s.Quantity;
            metric.CashCollected += s.TotalCash;
        }

        // 2. Tokens Redeemed per Product (which drink was handed out for a token)
        foreach (var u in TokenUsages)
        {
            var dName = CleanProductName(u.DrinkName);
            if (string.IsNullOrWhiteSpace(dName)) continue;

            var upper = dName.ToUpper();
            bool isGeneric = upper.Contains("BEER TOKEN") || upper.Contains("DRINK TOKEN") || upper.Contains("LIQUOR TOKEN") || upper == "TOKEN" || upper == "TOKENS";
            string category = isGeneric ? (upper.Contains("BEER") ? "Generic Beer Token" : "Generic Mixed Drink Token") : "Specific Drink";

            if (!dict.TryGetValue(dName, out var metric))
            {
                metric = new ProductTokenFlowMetric
                {
                    ProductName = dName,
                    IsGenericToken = isGeneric,
                    TokenCategory = category
                };
                dict[dName] = metric;
            }
            metric.TokensRedeemedQty += u.Quantity;
        }

        return dict.Values
            .OrderByDescending(x => x.TokensSoldQty + x.TokensRedeemedQty)
            .ThenBy(x => x.ProductName)
            .ToList();
    }

