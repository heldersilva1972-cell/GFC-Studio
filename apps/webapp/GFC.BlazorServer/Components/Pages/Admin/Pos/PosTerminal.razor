        background: white; border: 1px solid #e2e8f0; border-radius: 4px; padding: 12px 16px;
        display: flex; justify-content: space-between; align-items: center; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.03);
    }
    .total-items-pill {
        background: #f8fafc; border: 2px solid var(--pos-border); display: flex; justify-content: space-between;
        align-items: center; padding: 0.75rem 1.5rem; border-radius: 16px;
    }
    .total-items-pill .label { font-weight: 900; color: #64748b; font-size: 0.75rem; text-transform: uppercase; }
    .total-items-pill .value { font-size: 1.5rem; font-weight: 950; color: #1e3a8a; }

    .qty-badge { background: #eff6ff; color: #1d4ed8; font-weight: 950; font-size: 1.1rem; padding: 6px 12px; border-radius: 12px; min-width: 55px; text-align: center; border: 1.5px solid #dbeafe; }
    .qty-badge small { font-size: 0.7rem; margin-left: 2px; color: #94a3b8; }

