    }

    /* FULL REMOVAL OF UNUSED BLACK */
    /* GLOBAL INDUSTRIAL OVERRIDES */
    .btn-no-sale {
        background: #f59e0b; border: none; color: white; padding: 10px 24px; border-radius: 50px;
        font-weight: 950; font-size: 0.85rem; transition: all 0.1s; display: flex; 
