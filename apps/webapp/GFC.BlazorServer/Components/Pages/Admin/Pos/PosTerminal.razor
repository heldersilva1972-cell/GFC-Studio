@code {
    private string CurrentUserName = "BARTENDER";

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        if (user.Identity?.IsAuthenticated == true)
        {
            CurrentUserName = user.Identity.Name ?? "BARTENDER";
        }

        // Initialize local persistence (Load from browser memory)
        await LoadPendingSales();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Register JS event listeners for connectivity
            await JSRuntime.InvokeVoidAsync("registerConnectivityListener", DotNetObjectReference.Create(this));
        }
    }

    [JSInvokable]
    public async Task UpdateConnectivityStatus(bool online)
    {
        IsOnline = online;
        if (IsOnline && PendingSyncSales.Any())
        {
            await SyncSales();
        }
        StateHasChanged();
    }

    private bool ShowShiftControls = false;
    private string PrinterIpAddress = "192.168.1.100";
    private bool AutoPrintReceipt = true;
    private bool AutoOpenDrawer = true;

    private decimal ShiftCashTotal = 120.50m;
    private decimal ShiftCardTotal = 450.25m;
    private decimal ShiftTabTotal = 75.00m;

    private bool IsOnline = true;
    private List<SaleRecord> PendingSyncSales = new();
    private List<ProductItem> CartItems = new();
    private decimal Subtotal => CartItems.Sum(x => x.Price * x.Quantity);

    private string ActiveCategory = "ALL";
    private List<string> Categories = new() { "ALL", "BEER", "WINE", "LIQUOR", "CIGS" };
    
    private IEnumerable<ProductItem> FilteredItems => ActiveCategory == "ALL" 
        ? MockItems 
        : MockItems.Where(x => x.Category == ActiveCategory);

    private List<ProductItem> MockItems = new()
    {
        new() { Id = 1, Name = "BUD LIGHT", Price = 4.50m, Category = "BEER" },
        new() { Id = 2, Name = "BUDWEISER", Price = 4.50m, Category = "BEER" },
        new() { Id = 3, Name = "HEINEKEN", Price = 5.50m, Category = "BEER" },
        new() { Id = 4, Name = "GUINNESS", Price = 6.00m, Category = "BEER" },
        new() { Id = 5, Name = "WHISKEY SHOT", Price = 7.00m, Category = "LIQUOR" },
        new() { Id = 6, Name = "VODKA SODA", Price = 8.50m, Category = "LIQUOR" },
        new() { Id = 7, Name = "MALBEC GLASS", Price = 9.00m, Category = "WINE" },
        new() { Id = 8, Name = "CHARDONNAY", Price = 9.00m, Category = "WINE" },
        new() { Id = 9, Name = "COKE / SODA", Price = 2.50m, Category = "MISC" },
        new() { Id = 10, Name = "RED BULL", Price = 4.00m, Category = "MISC" }
    };

    private void AddToCart(ProductItem item)
    {
        var existing = CartItems.FirstOrDefault(x => x.Id == item.Id);
        if (existing != null) existing.Quantity++;
        else CartItems.Add(new ProductItem { Id = item.Id, Name = item.Name, Price = item.Price, Category = item.Category, Quantity = 1 });
        StateHasChanged();
    }

    private void RemoveItem(ProductItem item)
    {
        if (item.Quantity > 1) item.Quantity--;
        else CartItems.Remove(item);
    }

    private void ClearCart() => CartItems.Clear();

    private bool ShowCheckoutOverlay = false;
    private decimal? CashReceived = null;
    private string CashInputString = "";
    private decimal ChangeDue => (CashReceived ?? 0) - Subtotal;

    private void HandleNumPad(string key)
    {
        if (key == "CLEAR")
        {
            CashInputString = "";
        }
        else if (key == "BACK")
        {
            if (CashInputString.Length > 0) 
                CashInputString = CashInputString.Substring(0, CashInputString.Length - 1);
        }
        else if (key == ".")
        {
            if (!CashInputString.Contains("."))
                CashInputString += ".";
        }
        else
        {
            // Limit to 2 decimal places
            if (CashInputString.Contains(".") && CashInputString.Split('.')[1].Length >= 2) return;
            CashInputString += key;
        }

        if (decimal.TryParse(CashInputString, out var val))
            CashReceived = val;
        else
            CashReceived = null;
    }

    private void SetCashReceived(decimal amount)
    {
        CashReceived = Math.Round(amount, 2);
        CashInputString = CashReceived.Value.ToString("F2");
    }

    private void Checkout()
    {
        CashInputString = "";
        CashReceived = null;
        ShowCheckoutOverlay = true;
    }

    private async Task FinalizeSale()
    {
        var sale = new SaleRecord 
        { 
            Id = Guid.NewGuid(), 
            Timestamp = DateTime.Now, 
            Total = Subtotal,
            Bartender = CurrentUserName,
            // Capture payment type (simulated)
            PaymentType = CashReceived.HasValue ? "CASH" : "OTHER",
            // Simple serialization for demo
            ItemsJson = string.Join(",", CartItems.Select(i => $"{i.Quantity}x {i.Name}"))
        };

        // 1. Hardware Commands (Printer & Drawer)
        if (AutoOpenDrawer && sale.PaymentType == "CASH")
        {
            await KickDrawer();
        }
        
        if (AutoPrintReceipt)
        {
            await PrintReceipt(sale);
        }

        // 2. Persistence Logic
        if (IsOnline)
        {
            Toast.ShowSuccess($"Sale Complete: ${Subtotal:F2}");
        }
        else
        {
            PendingSyncSales.Add(sale);
            await SavePendingSales();
            Toast.ShowWarning($"Offline: Sale saved to tablet memory.");
        }

        CartItems.Clear();
        ShowCheckoutOverlay = false;
        CashReceived = null;
        CashInputString = "";
    }

    private async Task KickDrawer()
    {
        // Simulate ESC/POS command to DK (Drawer Kick) port
        try {
            await JSRuntime.InvokeVoidAsync("console.log", $"HARDWARE: Kicking Drawer via {PrinterIpAddress}");
        } catch {}
    }

    private async Task PrintReceipt(SaleRecord sale)
    {
        // Simulate thermal print job
        try {
            await JSRuntime.InvokeVoidAsync("console.log", $"HARDWARE: Printing Receipt to {PrinterIpAddress}", sale);
        } catch {}
    }

    private async Task SavePendingSales()
    {
        try {
            var json = JsonSerializer.Serialize(PendingSyncSales);
            await JSRuntime.InvokeVoidAsync("localStorage.setItem", "gfc_pending_sales", json);
        } catch {}
    }

    private async Task LoadPendingSales()
    {
        try {
            var json = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "gfc_pending_sales");
            if (!string.IsNullOrEmpty(json))
            {
                PendingSyncSales = JsonSerializer.Deserialize<List<SaleRecord>>(json) ?? new();
            }
        } catch {}
    }

    private async Task SyncSales()
    {
        // Simulate syncing logic
        await Task.Delay(2000); // Simulate network delay
        PendingSyncSales.Clear();
        await SavePendingSales();
        Toast.ShowSuccess("All pending sales synced successfully!");
    }

    private void ToggleShiftControls() => ShowShiftControls = !ShowShiftControls;

    private void ProcessZOut()
    {
        Toast.ShowSuccess("Z-Tape Generated! Shift successfully closed.");
        ShowShiftControls = false;
        ShiftCashTotal = 0; ShiftCardTotal = 0; ShiftTabTotal = 0;
        StateHasChanged();
    }

    private void GoBack() => Navigation.NavigateTo("/admin");

    public class ProductItem
    {
        public int Id { get; set; }
        public string Name { get; set; } = "";
        public decimal Price { get; set; }
        public string Category { get; set; } = "ALL";
        public int Quantity { get; set; }
    }

    public class SaleRecord
    {
        public Guid Id { get; set; }
        public DateTime Timestamp { get; set; }
        public decimal Total { get; set; }
        public string Bartender { get; set; } = "";
        public string PaymentType { get; set; } = "CASH";
        public string ItemsJson { get; set; } = "";
    }
}
