    private enum CloseOutStep { None, PromptInventory, ReviewDraft, Selection, PromptZ }
    private CloseOutStep _currentCloseOutStep = CloseOutStep.None;
    private Dictionary<int, int> _inventoryPullDraft = new();

    private void StartCloseOutWorkflow()
    {
        if (_inventoryPullDraft.Any())
            _currentCloseOutStep = CloseOutStep.ReviewDraft;
        else
            _currentCloseOutStep = CloseOutStep.PromptInventory;
    }

    private void GoToSelection()
    {
        _currentCloseOutStep = CloseOutStep.Selection;
    }

    private void AddToDraft(int itemId)
    {
        if (_inventoryPullDraft.ContainsKey(itemId))
            _inventoryPullDraft[itemId]++;
        else
            _inventoryPullDraft[itemId] = 1;
    }

    private void RemoveFromDraft(int itemId)
    {
        if (_inventoryPullDraft.ContainsKey(itemId))
        {
            if (_inventoryPullDraft[itemId] > 1)
                _inventoryPullDraft[itemId]--;
            else
                _inventoryPullDraft.Remove(itemId);
        }
    }

    private void RemoveDraft()
    {
        _inventoryPullDraft.Clear();
        _currentCloseOutStep = CloseOutStep.PromptInventory;
    }

    private async Task ProcessZOut(bool printTape)
    {
        // 0. Training Mode Guard
        if (forceTrainingMode)
        {
            if (allowHardwareInTraining && printTape)
            {
                await JSRuntime.InvokeVoidAsync("console.log", "TRAINING: Printing Mock Z-Tape...");
            }
            
            _currentCloseOutStep = CloseOutStep.None;
            _inventoryPullDraft.Clear();
            ShiftCashTotal = 0; ShiftCardTotal = 0; ShiftTabTotal = 0;
            CartItems.Clear();
            
            showCloseOutSuccessOverlay = true;
            StateHasChanged();
            await Task.Delay(1500);
            showCloseOutSuccessOverlay = false;
            Toast.ShowInfo("Training Shift Reset (No Record Created)");
            StateHasChanged();
            return;
        }

        // 1. Commit Inventory Pulls
        if (_inventoryPullDraft.Any())
        {
            try 
            {
                var authState = await AuthStateProvider.GetAuthenticationStateAsync();
                var userIdString = authState.User.FindFirst("UserId")?.Value;
                int currentUserId = int.TryParse(userIdString, out var uid) ? uid : 0;

                foreach (var draft in _inventoryPullDraft)
                {
                    for (int i = 0; i < draft.Value; i++)
                    {
                        // Record as "Manual Swap (End of Shift)"
                        await LiquorService.CheckoutBottleAsync(draft.Key, currentUserId, $"[{TerminalName}] POS End-of-Shift Removal");
                    }
                }
            }
            catch (Exception ex)
            {
                Toast.ShowError($"Inventory Commit Error: {ex.Message}");
            }
        }

        // 1.5 Record the permanent Z-Report
        try 
        {
            using var db = await DbFactory.CreateDbContextAsync();
            
            // A. Get last Z-report timestamp for this terminal
            var lastZ = await db.PosZReports
                .Where(z => z.TerminalName == TerminalName)
                .OrderByDescending(z => z.Timestamp)
                .FirstOrDefaultAsync();
            
            // If no previous Z-report, default to start of current day
            var lastTime = lastZ?.Timestamp ?? DateTime.Today;

            // B. Get all shift sales
            var shiftSales = await db.PosSales
                .Where(s => s.TerminalName == TerminalName && s.Timestamp > lastTime)
                .ToListAsync();

            decimal totalGross = shiftSales.Sum(s => s.TotalAmount);
            
            // C. Consolidate Items (Item Name -> Total Quantity)
            var summary = new Dictionary<string, int>();
            foreach (var sale in shiftSales)
            {
                try 
                {
                    var items = JsonSerializer.Deserialize<List<ProductItem>>(sale.ItemsJson) ?? new();
                    foreach (var item in items)
                    {
                        if (summary.ContainsKey(item.Name))
                            summary[item.Name] += item.Quantity;
                        else
                            summary[item.Name] = item.Quantity;
                    }
                }
                catch { /* Ignore corrupt JSON */ }
            }

            var zReport = new GFC.BlazorServer.Data.Entities.PosZReport
            {
                Id = Guid.NewGuid(),
                Timestamp = DateTime.Now,
                TerminalName = TerminalName,
                BartenderName = CurrentUserName,
                CashTotal = ShiftCashTotal,
                TotalGrossSales = totalGross,
                InventoryPullsJson = JsonSerializer.Serialize(_inventoryPullDraft),
                SalesSummaryJson = JsonSerializer.Serialize(summary),
                IsSynced = true
            };
            db.PosZReports.Add(zReport);
            await db.SaveChangesAsync();
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Database Record Error: {ex.Message}");
        }

        // 2. Print Z-Tape (Logic already exists or simulated)
        if (printTape)
        {
            await JSRuntime.InvokeVoidAsync("console.log", "HARDWARE: Printing Z-Tape...");
        }

        // 3. Finalize
        _currentCloseOutStep = CloseOutStep.None;
        _inventoryPullDraft.Clear();
        ShiftCashTotal = 0; ShiftCardTotal = 0; ShiftTabTotal = 0;
        CartItems.Clear();
        
        // 4. Success Splash
        showCloseOutSuccessOverlay = true;
        StateHasChanged();
        await Task.Delay(1500);
        showCloseOutSuccessOverlay = false;
        StateHasChanged();
    }

