    .btn-clear-header:active { transform: translateY(4px); box-shadow: none; }

    .btn-primary { transition: all 0.2s; }
    .btn-primary:hover { transform: translateY(-1px); box-shadow: 0 4px 12px rgba(13, 110, 253, 0.2) !important; }

    .pos-container {
        position: fixed;
