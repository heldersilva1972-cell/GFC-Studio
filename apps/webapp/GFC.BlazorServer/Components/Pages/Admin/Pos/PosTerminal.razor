@code {
    private string CurrentUserName = "BARTENDER";

    private bool IsOnline = true;
    private List<SaleRecord> PendingSyncSales = new();
    private List<ProductItem> CartItems = new();
    private decimal Subtotal => CartItems.Sum(x => x.Price * x.Quantity);

    private string ActiveCategory = "BEER";
    private List<string> Categories = new();
    private List<ProductItem> DbItems = new();
    private Dictionary<int, int> ItemFrequency = new();
    private List<int> SpeedBarItemIds = new();

    private IEnumerable<ProductItem> PopularItems => 
        SpeedBarItemIds.Select(id => DbItems.FirstOrDefault(x => x.Id == id)).Where(x => x != null);

    private void UpdateSpeedBar()
    {
        // Calculate the top items based on session frequency
        SpeedBarItemIds = ItemFrequency.OrderByDescending(x => x.Value)
                                       .Select(x => x.Key)
                                       .Take(8)
                                       .ToList();
        StateHasChanged();
    }
    
    private IEnumerable<ProductItem> FilteredItems => (ActiveCategory == "DARTS CLUB ROUND"
        ? DbItems.Where(i => i.Category == "BEER" || i.Category == "LIQUOR")
        : DbItems.Where(x => !string.IsNullOrWhiteSpace(x.Category) && x.Category.Trim().Equals(ActiveCategory.Trim(), StringComparison.OrdinalIgnoreCase)))
        .GroupBy(x => x.Name).Select(g => g.First())
        .OrderBy(x => x.Name);

    private async Task HandleCategoryClick(string cat)
    {
        if (cat == "DARTS CLUB ROUND")
        {
            if (isDartsModeActive)
            {
                // Toggle OFF and WIPE CART (Hard Reset)
                ClearCart();
            }
            else
            {
                // CHECK FOR DUPLICATES TODAY
                var existing = await GetLatestDartsRoundToday();
                if (existing != null)
                {
                    ShowNotice("Round Already Submitted", "A club round has already been submitted today. Do you need to make a correction?", "dual", () => {
                        LoadDartsRoundForCorrection(existing);
                    });
                }
                else
                {
                    ActivateDartsMode();
                }
            }
        }
        else
        {
            ActiveCategory = cat;
        }
    }

    private void ActivateDartsMode()
    {
        isDartsModeActive = true;
        
        // Handle existing cart items
        if (CartItems.Any())
        {
            // 1. Remove food items (strictly prohibited)
            int removedFood = CartItems.RemoveAll(i => i.Category == "FOOD");
            if (removedFood > 0)
            {
                ShowNotice("Items Removed", "Food items were removed because they are not allowed during Darts Club Rounds.", "warning");
            }

            // 2. Zero out eligible items
            foreach (var item in CartItems.Where(i => i.Price > 0))
            {
                if (item.Category == "BEER" || item.Category == "LIQUOR" || item.Category == "TOKENS")
                {
                    item.Name = item.Name.Contains("(DARTS)") ? item.Name : $"{item.Name} (DARTS)";
                    item.Price = 0;
                }
            }
        }
        StateHasChanged();
    }

    private Guid? _correctingSaleId = null;
    private void LoadDartsRoundForCorrection(GFC.BlazorServer.Data.Entities.PosSale sale)
    {
        _correctingSaleId = sale.Id;
        isDartsModeActive = true;
        CartItems = JsonSerializer.Deserialize<List<ProductItem>>(sale.ItemsJson) ?? new();
        StateHasChanged();
    }

    private async Task<GFC.BlazorServer.Data.Entities.PosSale?> GetLatestDartsRoundToday()
    {
        try 
        {
            using var db = DbFactory.CreateDbContext();
            var today = DateTime.Today;
            // A Darts Round sale is marked as TOKEN/COMP and contains (DARTS) items
            return await db.PosSales
                .OrderByDescending(s => s.Timestamp)
                .FirstOrDefaultAsync(s => s.Timestamp >= today && 
                                         s.PaymentType == "TOKEN/COMP" && 
                                         s.ItemsJson.Contains("(DARTS)"));
        }
        catch { return null; }
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        if (user.Identity?.IsAuthenticated == true)
        {
            CurrentUserName = user.Identity.Name ?? "BARTENDER";
        }

        // Initialize local persistence (Load from browser memory)
        await LoadPendingSales();
        await LoadTerminalName();
        
        // Load Real Data from DB
        await LoadLiveData();

        // 3. Load Training Mode Persistence
        try {
            var trainingStored = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "gfc_pos_training_mode");
            if (!string.IsNullOrEmpty(trainingStored)) forceTrainingMode = bool.Parse(trainingStored);
            
            var hardwareStored = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "gfc_pos_hardware_practice");
            if (!string.IsNullOrEmpty(hardwareStored)) allowHardwareInTraining = bool.Parse(hardwareStored);
        } catch {}

        UpdateSpeedBar();
        
        // Auto-Sync any legacy local sales to the new DB
        await SyncLocalSales();
    }

    private async Task SyncLocalSales()
    {
        if (!IsOnline || !PendingSyncSales.Any()) return;

        try 
        {
            using var db = DbFactory.CreateDbContext();
            var salesToSync = PendingSyncSales.ToList(); // Copy
            
            foreach (var sale in salesToSync)
            {
                db.PosSales.Add(new GFC.BlazorServer.Data.Entities.PosSale 
                {
                    Id = sale.Id,
                    Timestamp = sale.Timestamp,
                    TerminalName = string.IsNullOrEmpty(sale.TerminalName) ? "TERMINAL 1 (LEGACY)" : sale.TerminalName,
                    BartenderName = sale.Bartender,
                    TotalAmount = sale.Total,
                    PaymentType = sale.PaymentType,
                    ItemsJson = sale.ItemsJson,
                    IsSynced = true
                });
            }

            await db.SaveChangesAsync();
            PendingSyncSales.Clear();
            await SavePendingSales(); // Clear from browser memory
            Toast.ShowSuccess($"Synced {salesToSync.Count} legacy sales to database!");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Sync Error: {ex.Message}");
        }
    }

    private List<PosToken>? DbTokens;
    private bool showRedeemOverlay = false;
    private bool showSuccessOverlay = false;
    private bool showCloseOutSuccessOverlay = false;
    private bool showSettingsModal = false;
    private bool forceTrainingMode = false;
    private bool allowHardwareInTraining = false;
    private bool isDartsModeActive = false;
    private string TerminalName = "TERMINAL 1";

    private async Task LoadLiveData()
    {
        using var db = await DbFactory.CreateDbContextAsync();
        
        // 1. Load Categories
        Categories = new List<string>();
        var dbCats = await db.PosCategories.Where(c => c.IsActive).OrderBy(c => c.DisplayOrder).Select(c => c.Name).ToListAsync();
        Categories.AddRange(dbCats);
        Categories.Add("TOKENS");
        
        // Add Dart Team tab if it's Thursday OR training mode is on
        if (DateTime.Now.DayOfWeek == DayOfWeek.Thursday || forceTrainingMode)
        {
            if (!Categories.Contains("DARTS CLUB ROUND"))
                Categories.Add("DARTS CLUB ROUND");
        }
        
        // 2. Load Items
        var liquorItems = await db.LiquorItems
            .Where(i => i.ShowInPos)
            .OrderBy(i => i.DisplayOrder)
            .ThenBy(i => i.Name)
            .ToListAsync();

        DbItems = liquorItems.Select(i => new ProductItem 
        { 
            Id = i.Id, 
            Name = i.Name, 
            Price = i.RetailPrice,
            Category = i.Category ?? "MISC",
            DisplayOrder = i.DisplayOrder
        }).ToList();

        // 3. Load Tokens
        DbTokens = await db.PosTokens.Where(t => t.IsActive).ToListAsync();
        
        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Register JS event listeners for connectivity
            await JSRuntime.InvokeVoidAsync("registerConnectivityListener", DotNetObjectReference.Create(this));
            
            // Load persistent terminal name
            await LoadTerminalName();
            StateHasChanged();
        }
    }

    [JSInvokable]
    public async Task UpdateConnectivityStatus(bool online)
    {
        IsOnline = online;
        if (IsOnline && PendingSyncSales.Any())
        {
            await SyncSales();
        }
        StateHasChanged();
    }

    private bool ShowShiftControls = false;
    private string PrinterIpAddress = "192.168.1.100";
    private bool AutoPrintReceipt = true;
    private bool AutoOpenDrawer = true;

    private decimal ShiftCashTotal = 0;
    private decimal ShiftCardTotal = 0;
    private decimal ShiftTabTotal = 0;

    private async Task AddToCart(ProductItem item)
    {
        if (isDartsModeActive && item.Category == "FOOD")
        {
             ShowNotice("Not Allowed", "Food items cannot be added during Darts Club Rounds.", "warning");
             return;
        }

        var isDartComp = isDartsModeActive;
        var price = isDartComp ? 0 : item.Price;
        var name = isDartComp && !item.Name.Contains("(DARTS)") ? $"{item.Name} (DARTS)" : item.Name;

        var existing = CartItems.FirstOrDefault(x => x.Id == item.Id && x.Price == price && x.Name == name);
        if (existing != null) existing.Quantity++;
        else CartItems.Add(new ProductItem { Id = item.Id, Name = name, Price = price, Category = item.Category, Quantity = 1 });
        
        StateHasChanged();
        await JSRuntime.InvokeVoidAsync("eval", "document.getElementById('cartItemsList').scrollTop = 100000;");
    }

    private void AddTokenToCart(PosToken token)
    {
        int tokenId = -token.Id;
        
        var price = isDartsModeActive ? 0 : token.SalePrice;
        var name = isDartsModeActive ? $"{token.Name} (TOKEN) (DARTS)" : $"{token.Name} (TOKEN)";

        var existing = CartItems.FirstOrDefault(x => x.Id == tokenId && x.Price == price);
        
        if (existing != null)
        {
            existing.Quantity++;
        }
        else
        {
            CartItems.Add(new ProductItem 
            { 
                Id = tokenId, // Use negative IDs for tokens to avoid collisions
                Name = name,
                Price = price,
                Category = "TOKENS",
                Quantity = 1
            });
        }
        StateHasChanged();
    }

    private void ApplyTokenRedemption(PosToken token)
    {
        // Find an item in the cart that is eligible for this token and not already zeroed
        var eligibleIds = token.EligibleItemIds.Split(',', StringSplitOptions.RemoveEmptyEntries).Select(int.Parse).ToList();
        var itemToZero = CartItems.FirstOrDefault(i => eligibleIds.Contains(i.Id) && i.Price > 0);
        
        if (itemToZero != null)
        {
            // If quantity > 1, we only zero out one instance
            if (itemToZero.Quantity > 1)
            {
                itemToZero.Quantity--;
                CartItems.Add(new ProductItem 
                { 
                    Id = itemToZero.Id, 
                    Name = $"{itemToZero.Name} (TOKEN)", 
                    Price = 0, 
                    Category = itemToZero.Category, 
                    Quantity = 1 
                });
            }
            else
            {
                itemToZero.Name = $"{itemToZero.Name} (TOKEN)";
                itemToZero.Price = 0;
            }
            showRedeemOverlay = false;
        }
        else
        {
            ShowNotice("Missing Item", $"No qualifying items for '{token.Name}' found in the cart to redeem.", "warning");
        }
    }

    private void RemoveItem(ProductItem item)
    {
        if (item.Quantity > 1) item.Quantity--;
        else CartItems.Remove(item);
    }

    private void ClearCart()
    {
        CartItems.Clear();
        isDartsModeActive = false;
        UpdateSpeedBar(); // Update ranks on clear as well
    }

    private bool _showNoticeModal = false;
    private string _noticeTitle = "";
    private string _noticeMessage = "";
    private string _noticeType = "info"; // info or warning

    private void ShowNotice(string title, string message, string type = "info", Action onConfirm = null)
    {
        _noticeTitle = title;
        _noticeMessage = message;
        _noticeType = type;
        _onConfirm = onConfirm;
        _showNoticeModal = true;
        StateHasChanged();
    }

    private Action? _onConfirm;
    private void OnNoticeConfirm()
    {
        _showNoticeModal = false;
        _onConfirm?.Invoke();
    }

    private bool ShowCheckoutOverlay = false;
    private decimal? CashReceived = null;
    private string CashInputString = "";
    private decimal ChangeDue => (CashReceived ?? 0) - Subtotal;

    private void HandleNumPad(string key)
    {
        if (key == "CLEAR")
        {
            CashInputString = "";
        }
        else if (key == "BACK")
        {
            if (CashInputString.Length > 0) 
                CashInputString = CashInputString.Substring(0, CashInputString.Length - 1);
        }
        else if (key == ".")
        {
            if (!CashInputString.Contains("."))
                CashInputString += ".";
        }
        else
        {
            // Limit to 2 decimal places
            if (CashInputString.Contains(".") && CashInputString.Split('.')[1].Length >= 2) return;
            CashInputString += key;
        }

        if (decimal.TryParse(CashInputString, out var val))
            CashReceived = val;
        else
            CashReceived = null;
    }

    private void SetCashReceived(decimal amount)
    {
        CashReceived = Math.Round(amount, 2);
        CashInputString = CashReceived.Value.ToString("F2");
    }

    private async Task Checkout()
    {
        if (CartItems.Count == 0) return;
        
        if (Subtotal == 0)
        {
            await FinalizeSale();
        }
        else
        {
            CashInputString = "";
            CashReceived = null;
            ShowCheckoutOverlay = true;
        }
    }

    private async Task FinalizeSale()
    {
        var paymentType = CashReceived.HasValue ? "CASH" : (Subtotal == 0 ? "TOKEN/COMP" : "OTHER");
        
        var sale = new SaleRecord 
        { 
            Id = Guid.NewGuid(), 
            Timestamp = DateTime.Now, 
            TerminalName = forceTrainingMode ? $"{TerminalName} (TRAINING)" : TerminalName,
            Total = Subtotal,
            Bartender = CurrentUserName,
            PaymentType = paymentType,
            ItemsJson = JsonSerializer.Serialize(CartItems)
        };

        // 0. Training Mode Early Exit Check
        bool isTraining = forceTrainingMode;

        // 1. Hardware Commands (Printer & Drawer)
        if ((!isTraining || allowHardwareInTraining) && AutoOpenDrawer && sale.PaymentType == "CASH")
        {
            await KickDrawer();
        }
        
        if ((!isTraining || allowHardwareInTraining) && AutoPrintReceipt)
        {
            await PrintReceipt(sale);
        }

        if (isTraining)
        {
            // Update local shift counters temporarily for the UI, but DO NOT save to DB
            if (sale.PaymentType == "CASH") ShiftCashTotal += sale.Total;
            
            CartItems.Clear();
            ShowCheckoutOverlay = false;
            CashReceived = null;
            CashInputString = "";
            isDartsModeActive = false; 
            UpdateSpeedBar();

            showSuccessOverlay = true;
            StateHasChanged();
            await Task.Delay(1000);
            showSuccessOverlay = false;
            Toast.ShowInfo("Training Sale Complete (Not Persisted)");
            StateHasChanged();
            return;
        }

        // 1. Inventory Logic
        try 
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var userIdString = authState.User.FindFirst("UserId")?.Value;
            int currentUserId = int.TryParse(userIdString, out var uid) ? uid : 0;

            foreach (var item in CartItems.Where(i => i.Id > 0)) // Positive IDs are LiquorItems
            {
                // We don't wait for internal history logging to finish to keep UI fast
                _ = LiquorService.AdjustStockAsync(item.Id, currentUserId, -item.Quantity, $"POS Bar Sale: {item.Name}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Inventory Sync Error: {ex.Message}");
        }

        // 2. Persistence Logic
        if (IsOnline)
        {
            try 
            {
                using var db = DbFactory.CreateDbContext();
                
                if (_correctingSaleId != null)
                {
                    var existing = await db.PosSales.FindAsync(_correctingSaleId);
                    if (existing != null)
                    {
                        existing.ItemsJson = sale.ItemsJson;
                        existing.TotalAmount = sale.Total;
                        existing.Timestamp = DateTime.Now; // Update to latest correction time
                        await db.SaveChangesAsync();
                        ShowNotice("Correction Complete", "The club round correction has been successfully submitted.", "info");
                    }

                    // Update local shift counters for the correction
                    if (sale.PaymentType == "CASH") ShiftCashTotal += sale.Total;
                    else if (sale.PaymentType == "CARD") ShiftCardTotal += sale.Total;
                    else if (sale.PaymentType == "TAB") ShiftTabTotal += sale.Total;

                    _correctingSaleId = null;
                }
                else
                {
                    db.PosSales.Add(new GFC.BlazorServer.Data.Entities.PosSale 
                    {
                        Id = sale.Id,
                        Timestamp = sale.Timestamp,
                        TerminalName = sale.TerminalName,
                        BartenderName = sale.Bartender,
                        TotalAmount = sale.Total,
                        PaymentType = sale.PaymentType,
                        ItemsJson = sale.ItemsJson,
                        IsSynced = true
                    });

                    // Track financials for Z-Report
                    if (sale.PaymentType == "CASH") ShiftCashTotal += sale.Total;
                    else if (sale.PaymentType == "CARD") ShiftCardTotal += sale.Total;
                    else if (sale.PaymentType == "TAB") ShiftTabTotal += sale.Total;

                    await db.SaveChangesAsync();
                    Toast.ShowSuccess($"Sale Complete: {Subtotal.ToString("C")}");
                }
            }
            catch
            {
                if (_correctingSaleId == null)
                {
                    PendingSyncSales.Add(sale);
                    await SavePendingSales();
                    Toast.ShowInfo("Sync Pending (Saved Locally)");
                }
            }
        }
        else
        {
            if (_correctingSaleId == null)
            {
                PendingSyncSales.Add(sale);
                await SavePendingSales();
                Toast.ShowWarning($"Offline: Sale saved to tablet memory.");
            }
        }

        // 4. Update Frequency for Speed Bar (Popular Items) - Skip Food and Tokens
        foreach (var cartItem in CartItems.Where(i => i.Category != "TOKENS" && i.Category != "FOOD"))
        {
            if (!ItemFrequency.ContainsKey(cartItem.Id)) ItemFrequency[cartItem.Id] = 0;
            ItemFrequency[cartItem.Id] += cartItem.Quantity;
        }

        CartItems.Clear();
        ShowCheckoutOverlay = false;
        CashReceived = null;
        CashInputString = "";
        isDartsModeActive = false; // Reset mode after sale

        UpdateSpeedBar(); // Update popular ranks AFTER the sale is done

        // Show success splash for 1 second
        showSuccessOverlay = true;
        StateHasChanged();
        await Task.Delay(1000);
        showSuccessOverlay = false;
        StateHasChanged();
    }

    private async Task KickDrawer()
    {
        // Simulate ESC/POS command to DK (Drawer Kick) port
        try {
            await JSRuntime.InvokeVoidAsync("console.log", $"HARDWARE: Kicking Drawer via {PrinterIpAddress}");
        } catch {}
    }

    private async Task PrintReceipt(SaleRecord sale)
    {
        // Simulate thermal print job
        try {
