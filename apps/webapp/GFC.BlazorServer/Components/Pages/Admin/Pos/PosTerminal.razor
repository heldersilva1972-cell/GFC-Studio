    .speed-bar-header { display: flex; flex-direction: column; align-items: center; gap: 4px; border-bottom: 2px solid #e2e8f0; padding-bottom: 0.75rem; margin-bottom: 0.5rem; }
    .speed-bar-header span { font-size: 0.7rem; font-weight: 900; color: #64748b; letter-spacing: 1px; }
