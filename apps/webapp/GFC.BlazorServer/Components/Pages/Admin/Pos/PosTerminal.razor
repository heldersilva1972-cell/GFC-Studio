    .user-pill i { color: #94a3b8; font-size: 1.1rem; }

    /* WORKSPACE & CATALOG */
    .pos-workspace { flex: 1; display: flex; overflow: hidden; background: #f1f5f9; }
    .pos-catalog { flex: 1; padding: 1.5rem; overflow-y: auto; background: white; }

    /* SPEED BAR */
    .pos-speed-bar { 
        width: 130px; background: #f1f5f9; border-left: 1px solid #e2e8f0; border-right: 1px solid #e2e8f0;
        display: flex; flex-direction: column; padding: 1rem 0.5rem; gap: 0.75rem; 
        overflow-y: auto; overflow-x: hidden;
    }
    .pos-speed-bar::-webkit-scrollbar { display: none; }
