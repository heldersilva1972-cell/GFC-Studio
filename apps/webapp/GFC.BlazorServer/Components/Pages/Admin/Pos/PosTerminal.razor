@page "/admin/pos-terminal"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using GFC.BlazorServer.Data
@using GFC.Core.Models
@using GFC.Core.DTOs
@using GFC.Core.Interfaces
@using GFC.BlazorServer.Services
@using global::System.Text.Json
@using Microsoft.AspNetCore.Components
@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation
@inject IToastService Toast
@inject GFC.BlazorServer.Services.CustomAuthenticationStateProvider AuthStateProvider
@inject IDbContextFactory<GfcDbContext> DbFactory
@inject ILiquorService LiquorService
@inject GFC.BlazorServer.Services.IBlazorSystemSettingsService SystemSettingsService
@attribute [Authorize]

<PageTitle>GFC - @TerminalName.ToUpper()</PageTitle>

<div class="pos-container">
    <!-- Header with Navy Border and Rounded IDs -->
    <header class="pos-header">
        <div class="pos-header__left">
            <button class="btn-back" @onclick="GoBack">
                <i class="bi bi-chevron-left"></i>
            </button>
            <span class="brand-text">GFC</span>
            <span class="terminal-id">@TerminalName.ToUpper()</span>
        </div>
        
        <div class="pos-status">
            <div class="status-pill @(IsOnline ? "online" : "offline")">
                <i class="bi @(IsOnline ? "bi-wifi" : "bi-wifi-off")"></i>
                <span>@(IsOnline ? "ONLINE" : "OFFLINE")</span>
            </div>

            @if (PendingSyncSales.Any())
            {
                <div class="sync-pill warning pulse">
                    <i class="bi bi-cloud-arrow-up-fill"></i>
                    <span>@PendingSyncSales.Count PENDING SYNC</span>
                </div>
            }
            else
            {
                <div class="sync-pill success">
                    <i class="bi bi-cloud-check-fill"></i>
                    <span>SYNCED</span>
                </div>
            }
            
            <button class="btn-settings-icon ms-2" 
                    @onclick="() => showSettingsModal = true" 
                    title="POS Settings">
                <i class="bi bi-gear-fill @(forceTrainingMode ? "text-danger" : "text-muted")"></i>
            </button>

            @if (forceTrainingMode)
            {
                <div class="status-pill training ms-2 pulse-red">
                    <i class="bi bi-lightning-fill"></i>
                    <span>TRAINING MODE</span>
                </div>
            }
        </div>
        
        <script>
            window.registerConnectivityListener = (dotnetObj) => {
                window.addEventListener('online', () => dotnetObj.invokeMethodAsync('UpdateConnectivityStatus', true));
                window.addEventListener('offline', () => dotnetObj.invokeMethodAsync('UpdateConnectivityStatus', false));
                // Initial check
                dotnetObj.invokeMethodAsync('UpdateConnectivityStatus', window.navigator.onLine);
            }
        </script>

        <div class="pos-header__right">
            <div class="user-pill">
                <i class="bi bi-person-circle-fill"></i>
                <div class="d-flex flex-column text-start" style="line-height: 1">
                    <span style="font-size: 0.85rem; font-weight: 900;">@CurrentUserName.ToUpper()</span>
                    <span style="font-size: 0.6rem; color: #64748b; font-weight: 800;">@TerminalName</span>
                </div>
            </div>
            <button class="btn-shift bg-warning text-dark border-0 ms-2" style="background-color: #ffc107 !important; font-weight: 800;" @onclick="() => showBanquetsModal = true">
                <i class="bi bi-calendar-event-fill me-1"></i>
                EVENT MGR
            </button>
            <button class="btn-shift" @onclick="StartCloseOutWorkflow">
                <i class="bi bi-box-arrow-right"></i>
                CLOSE SHIFT OUT
            </button>
        </div>
    </header>

    @* Event Manager Modal *@
    @if (showBanquetsModal)
    {
        <div class="shift-overlay" style="z-index: 1055;">
            @if (DbActiveEvents.Any())
            {
                <!-- Compact Active Banquet Control Card (No Wasted Space, Premium Dashboard Aesthetic) -->
                <div class="banquet-manager-card active-control-card animate__animated animate__zoomIn" style="width: 550px !important; border-radius: 32px !important; padding: 2.5rem !important; background: white; max-height: 85vh; display: flex; flex-direction: column; box-shadow: 0 50px 100px -20px rgba(0,0,0,0.3) !important;">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div class="d-flex align-items-center gap-2">
                            <span class="d-inline-block rounded-circle bg-warning text-dark d-flex align-items-center justify-content-center" style="width: 28px; height: 28px; font-size: 0.9rem;">
                                <i class="bi bi-exclamation-triangle-fill"></i>
                            </span>
                            <h4 class="fw-black m-0 text-dark" style="letter-spacing: -0.5px;">ACTIVE EVENT DETECTED</h4>
                        </div>
                        <button class="btn btn-light rounded-circle p-2 d-flex align-items-center justify-content-center" style="width: 38px; height: 38px;" @onclick="() => showBanquetsModal = false">
                            <i class="bi bi-x-lg"></i>
                        </button>
                    </div>

                    @foreach (var ev in DbActiveEvents)
                    {
                        var isPrePaid = ev.Type == GFC.Core.Enums.EventTabType.PrePaid;
                        <div class="active-banquet-info-card p-4 rounded-4 text-center mb-4 shadow-sm border" style="background: linear-gradient(135deg, #eff6ff 0%, #dbeafe 100%); border-color: #bfdbfe !important;">
                            <span class="badge bg-primary text-uppercase px-3 py-1.5 rounded-pill fw-black mb-2" style="font-size: 0.7rem; letter-spacing: 1px;">
                                @(isPrePaid ? "PREPAID TAB" : "RUNNING TAB") EVENT ACTIVE
                            </span>
                            <h2 class="fw-black text-dark m-0 mb-1" style="font-size: 2.2rem; letter-spacing: -1px; text-transform: uppercase;">@GetEventDisplayName(ev.Name)</h2>
                            <p class="text-muted small fw-bold mb-3">Started: @ev.CreatedAt.ToLocalTime().ToString("g")</p>
                            
                            <div class="bg-white rounded-4 p-3 border d-inline-flex flex-column align-items-center justify-content-center shadow-sm w-100" style="border-color: #93c5fd !important;">
                                <span class="text-muted small fw-bold text-uppercase tracking-wider" style="font-size: 0.75rem; letter-spacing: 0.5px;">
                                    @(isPrePaid ? "AVAILABLE PREPAID BALANCE" : "TOTAL ACCUMULATED SALES")
                                </span>
                                <h1 class="fw-black text-primary m-0 mt-1" style="font-size: 3.2rem; letter-spacing: -2px; line-height: 1;">
                                    @(isPrePaid ? ev.CurrentBalance.ToString("C") : Math.Abs(ev.CurrentBalance).ToString("C"))
                                </h1>
                            </div>
                        </div>

                        <div class="row g-3 mt-auto">
                            @if (isPrePaid)
                            {
                                <div class="col-6">
                                    <button type="button" class="btn btn-success w-100 rounded-4 py-3 fw-black d-flex flex-column align-items-center justify-content-center gap-2 shadow-sm text-white border-0 transition-all"
                                            style="background: #16a34a;"
                                            @onclick='() => { _selectedBanquetToAddFunds = ev; _addFundsAmount = 0; _banquetNumpadValue = "0"; _isFirstKeyAfterFocus = true; }'>
                                        <i class="bi bi-plus-circle-fill fs-3 text-white"></i>
                                        <span style="font-size: 0.85rem; letter-spacing: 0.5px;">ADD CASH DEPOSIT</span>
                                    </button>
                                </div>
                                <div class="col-6">
                                    <button type="button" class="btn btn-danger w-100 rounded-4 py-3 fw-black d-flex flex-column align-items-center justify-content-center gap-2 shadow-sm text-white border-0 transition-all"
                                            style="background: #dc2626;"
                                            @onclick="() => CloseBanquet(ev)">
                                        <i class="bi bi-shield-lock-fill fs-3 text-white"></i>
                                        <span style="font-size: 0.85rem; letter-spacing: 0.5px;">CLOSE BANQUET</span>
                                    </button>
                                </div>
                            }
                            else
                            {
                                <div class="col-12">
                                    <button type="button" class="btn btn-danger w-100 rounded-4 py-3 fw-black d-flex flex-column align-items-center justify-content-center gap-2 shadow-sm text-white border-0 transition-all"
                                            style="background: #dc2626;"
                                            @onclick="() => CloseBanquet(ev)">
                                        <i class="bi bi-shield-lock-fill fs-3 text-white"></i>
                                        <span style="font-size: 0.85rem; letter-spacing: 0.5px;">CLOSE BANQUET</span>
                                    </button>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
            else
            {
                <!-- Creator Card (No active banquet) -->
                <div class="banquet-manager-card no-active-banquets animate__animated animate__zoomIn">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h2 class="fw-black m-0" style="color: #1e3a8a; letter-spacing: -1.5px;">EVENT MANAGER</h2>
                        <button class="btn btn-light rounded-pill px-4 fw-bold" @onclick="() => showBanquetsModal = false">
                            <i class="bi bi-x-lg me-2"></i> CLOSE
                        </button>
                    </div>

                    <div class="banquet-grid">
                        <div class="d-flex flex-column">
                            <div class="banquet-section-title">Start New Event</div>
                            <div class="bg-light p-4 rounded-4 border-2 border border-white shadow-sm flex-grow-1">
                                <div class="new-banquet-inner-layout">
                                    <!-- LEFT SIDE: SELECT EVENT TEMPLATE -->
                                    <div class="new-banquet-templates-side">
                                        <label class="form-label small fw-black text-muted text-uppercase tracking-wider mb-2" style="font-size: 0.75rem;">Select Event Template</label>
                                        <div class="d-flex flex-column gap-2" style="max-height: 400px; overflow-y: auto; padding-right: 4px;">
                                            @if (DbEventTemplates != null)
                                            {
                                                @foreach (var t in DbEventTemplates)
                                                {
                                                    var isSelected = _newBanquetTemplateId == t.Id;
                                                    var iconClass = (t.Name ?? "").ToUpper().Contains("DART") ? "bi-bullseye" :
                                                                    (t.Name ?? "").ToUpper().Contains("SPECIAL") ? "bi-heart-fill" :
                                                                    (t.Name ?? "").ToUpper().Contains("PARTY") ? "bi-balloon-fill" : "bi-calendar-event";
                                                                    
                                                    var themeColor = (t.Name ?? "").ToUpper().Contains("DART") ? "#7c3aed" :
                                                                     (t.Name ?? "").ToUpper().Contains("SPECIAL") ? "#ec4899" : "#3b82f6";
                                                                     
                                                    <button type="button" class="btn text-start p-3 rounded-4 border-2 d-flex align-items-center justify-content-between transition-all"
                                                            style="background: @(isSelected ? "rgba(30, 58, 138, 0.05)" : "white"); 
                                                                   border-color: @(isSelected ? "rgba(30, 58, 138, 0.5)" : "#e2e8f0");
                                                                   color: #1e3a8a;
                                                                   transition: all 0.2s ease-in-out;
                                                                   box-shadow: @(isSelected ? "0 4px 12px rgba(30, 58, 138, 0.08)" : "none");"
                                                            @onclick="() => SelectTemplate(t.Id)">
                                                        <div class="d-flex align-items-center gap-3">
                                                            <div class="d-flex align-items-center justify-content-center rounded-circle" 
                                                                 style="width: 44px; height: 44px; background: @(isSelected ? themeColor : "#f1f5f9"); color: @(isSelected ? "white" : "#64748b"); transition: all 0.2s;">
                                                                <i class="bi @iconClass fs-5"></i>
                                                            </div>
                                                            <div>
                                                                <div class="fw-black" style="font-size: 0.95rem;">@GetEventDisplayName(t.Name)</div>
                                                                <div class="small text-muted fw-bold" style="font-size: 0.75rem;">
                                                                    @(t.DefaultType == GFC.Core.Enums.EventTabType.PrePaid ? "PREPAID TAB" : "RUNNING TAB")
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div>
                                                            @if (isSelected)
                                                            {
                                                                <span class="badge bg-success rounded-circle p-2 d-flex align-items-center justify-content-center" style="width: 24px; height: 24px;">
                                                                    <i class="bi bi-check-lg text-white" style="font-size: 0.8rem;"></i>
                                                                </span>
                                                            }
                                                            else
                                                            {
                                                                <i class="bi bi-chevron-right text-muted opacity-50"></i>
                                                            }
                                                        </div>
                                                    </button>
                                                }
                                            }
                                        </div>
                                    </div>

                                    <!-- RIGHT SIDE: KEYPAD OR INFO -->
                                    <div class="new-banquet-action-side">
                                        @if (IsPrePaidSelected)
                                        {
                                            <div class="mb-3 animate__animated animate__fadeIn flex-grow-1 d-flex flex-column">
                                                <label class="form-label small fw-bold mb-1">Starting Cash Deposit</label>
                                                <div class="input-group mb-2">
                                                    <span class="input-group-text bg-white border-2 fw-bold">$</span>
                                                    <input type="text" class="form-control border-2 fw-black text-primary" value="@_newBanquetAmount.ToString("F2")" readonly />
                                                </div>
                                                <div class="banquet-numpad flex-grow-1">
                                                    @foreach (var n in new[] { "1", "2", "3", "4", "5", "6", "7", "8", "9", ".", "0", "C" })
                                                    {
                                                        <div class="numpad-key @(n == "C" ? "key-clear" : "")" @onclick="() => HandleBanquetNumpad(n)">
                                                            @if (n == "C")
                                                            {
                                                                <span style="font-size: 0.9rem; font-weight: 800; text-transform: lowercase;">clear</span>
                                                            }
                                                            else
                                                            {
                                                                @n
                                                            }
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                        }
                                        else if (_newBanquetTemplateId > 0)
                                        {
                                            <div class="alert alert-info border-0 rounded-4 small fw-bold mb-3 animate__animated animate__fadeIn" style="background-color: #cff4fc; color: #055160;">
                                                <i class="bi bi-info-circle me-2"></i> This is a RUNNING TAB. No starting deposit required.
                                            </div>
                                        }

                                        @if (_newBanquetTemplateId > 0)
                                        {
                                            <div class="mb-3 p-3 bg-light rounded-4 border animate__animated animate__fadeIn text-dark" style="background-color: #f8fafc !important;">
                                                <div class="form-check form-switch d-flex align-items-center justify-content-between p-0 m-0">
                                                    <div>
                                                        <label class="form-check-label fw-bold mb-0 text-dark" for="directCheckoutSwitchWeb" style="font-size: 0.9rem; cursor: pointer;">
                                                            Direct Tab Checkout
                                                        </label>
                                                        <div class="small text-muted fw-bold" style="font-size: 0.75rem;">Shows TAB button side-by-side with PAY</div>
                                                    </div>
                                                    <input class="form-check-input ms-2" type="checkbox" role="switch" id="directCheckoutSwitchWeb" @bind="_newEventDirectCheckout" style="width: 2.5em; height: 1.25em; cursor: pointer;" />
                                                </div>
                                            </div>

                                            <button class="btn btn-success w-100 rounded-pill fw-bold py-3 shadow-sm mt-auto animate__animated animate__fadeIn text-white" style="background-color: #198754; border-color: #198754;" @onclick="StartBanquet" 
                                                    disabled="@(IsPrePaidSelected && _newBanquetAmount <= 0)">
                                                <i class="bi bi-play-circle-fill me-2"></i> START EVENT
                                            </button>
                                        }
                                        else
                                        {
                                            <div class="d-flex flex-column align-items-center justify-content-center h-100 text-muted opacity-50 py-5">
                                                <i class="bi bi-arrow-left-circle fs-2 mb-2"></i>
                                                <span class="small fw-bold text-center">Select template to begin</span>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    @* Add Funds Numpad Overlay Modal *@
    @if (_selectedBanquetToAddFunds != null)
    {
        <div class="shift-overlay" style="z-index: 1070; background: rgba(0,0,0,0.4);">
            <div class="banquet-modal-compact animate__animated animate__zoomIn animate__faster mx-auto" style="background: white; border-radius: 2rem; padding: 2.5rem; width: 400px; box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5); margin: auto;">
                <div class="text-center mb-4">
                    <h2 class="fw-black m-0" style="color: #1e3a8a; letter-spacing: -1.5px;">ADD FUNDS</h2>
                    <div class="small fw-bold text-muted text-uppercase">@_selectedBanquetToAddFunds.Name</div>
                </div>

                <div class="mb-4">
                    <div class="input-group">
                        <span class="input-group-text bg-white border-2 fw-bold fs-4">$</span>
                        <input type="text" class="form-control border-2 fs-4 fw-black text-success" value="@_addFundsAmount.ToString("F2")" readonly />
                    </div>
                </div>

                <div class="banquet-numpad mb-4">
                    @foreach (var n in new[] { "1", "2", "3", "4", "5", "6", "7", "8", "9", ".", "0", "C" })
                    {
                        <div class="numpad-key @(n == "C" ? "key-clear" : "")" @onclick="() => HandleBanquetNumpad(n)">
                            @if (n == "C")
                            {
                                <span style="font-size: 0.9rem; font-weight: 800; text-transform: lowercase;">clear</span>
                            }
                            else
                            {
                                @n
                            }
                        </div>
                    }
                </div>

                <div class="d-grid gap-2">
                    <button class="btn btn-success py-3 rounded-pill fw-black shadow-sm text-white" style="background-color: #198754; border-color: #198754;" @onclick="ConfirmAddFunds" disabled="@(_addFundsAmount <= 0)">
                        <i class="bi bi-plus-circle-fill me-2"></i> COLLECT CASH &amp; ADD
                    </button>
                    <button class="btn btn-light py-3 rounded-pill fw-bold" @onclick="() => _selectedBanquetToAddFunds = null">CANCEL</button>
                </div>
            </div>
        </div>
    }

    @* Training Settings Modal *@
    @if (showSettingsModal)
    {
        <div class="shift-overlay">
            <div class="settings-card shadow-lg">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h3 class="fw-black mb-0">POS SETTINGS</h3>
                    <button class="btn btn-light rounded-circle" @onclick="() => showSettingsModal = false">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>
                
                <div class="mb-4">
                    <h6 class="text-muted small fw-bold text-uppercase mb-3">Unit Configuration</h6>
                    <div class="p-3 bg-light rounded-4 mb-3">
                        <label class="small text-muted mb-2 d-block ms-1">Station Name</label>
                        <input type="text" class="form-control form-control-lg border-0 shadow-sm rounded-3 mb-3" 
                               @bind="TerminalName" @bind:after="SaveTerminalName" 
                               placeholder="e.g. Main Bar" />
                        <label class="small text-muted mb-1 d-block ms-1">Assigned Menu Profile</label>
                        <div class="fw-black text-primary ms-1" style="font-size: 1.15rem; letter-spacing: -0.5px;">
                            <i class="bi bi-tags-fill me-2"></i> @AssignedProfileName
                        </div>
                    </div>

                    <h6 class="text-muted small fw-bold text-uppercase mb-3">Operational Training Mode</h6>
                    <div class="p-3 bg-light rounded-4 mb-2">
                        <div class="form-check form-switch d-flex justify-content-between align-items-center">
                            <label class="form-check-label fw-bold mb-0" for="forceTrainingSwitch">
                                Enable Training Mode
                            </label>
                            <input class="form-check-input ms-0" type="checkbox" id="forceTrainingSwitch" 
                                   checked="@forceTrainingMode" 
                                   @onchange="(e) => ToggleTrainingMode(e.Value)" 
                                   style="width: 3.5rem; height: 1.75rem;">
                        </div>
                        <p class="text-muted small mt-2 mb-0" style="line-height: 1.2;">
                            <i class="bi bi-info-circle me-1"></i>
                            When ON, transactions are simulated and **NOT** saved to the database. Inventory is not affected.
                        </p>
                    </div>

                    @if (forceTrainingMode)
                    {
                        <div class="p-3 bg-light rounded-4 mb-2 animate__animated animate__fadeIn">
                            <div class="form-check form-switch d-flex justify-content-between align-items-center">
                                <label class="form-check-label fw-bold mb-0" for="allowHardwareSwitch">
                                    Allow Hardware Practice
                                </label>
                                <input class="form-check-input ms-0" type="checkbox" id="allowHardwareSwitch" 
                                       checked="@allowHardwareInTraining"
                                       @onchange="(e) => ToggleHardwarePractice(e.Value)"
                                       style="width: 3.5rem; height: 1.75rem;">
                            </div>
                            <p class="text-muted small mt-2 mb-0" style="line-height: 1.2;">
                                <i class="bi bi-printer me-1"></i>
                                Allow the Cash Drawer and Printer to operate during training sessions.
                            </p>
                        </div>
                    }
                    <p class="text-muted small mt-1 ms-2" style="font-size: 0.7rem;">DARTS CLUB ROUND category is forced visible while in Training Mode.</p>


                </div>



                <button class="btn btn-primary w-100 rounded-pill py-3 fw-black" @onclick="() => showSettingsModal = false">
                    CLOSE SETTINGS
                </button>
            </div>
        </div>
    }

    @if (_currentCloseOutStep != CloseOutStep.None)
    {
        <div class="shift-overlay">
            <div class="shift-card @(_currentCloseOutStep == CloseOutStep.Selection ? "shift-card--wide" : "")" style="background: white; border-radius: 30px; border-top: 8px solid #1e3a8a; box-shadow: 0 20px 50px rgba(0,0,0,0.3); overflow: hidden;">
                <header class="d-flex align-items-center justify-content-between py-4 px-5 border-bottom bg-white">
                    <h2 class="fw-black mb-0" style="color: #1e3a8a; font-size: 1.8rem; white-space: nowrap;">SHIFT CLOSE-OUT</h2>
                    <button class="btn btn-outline-danger rounded-pill fw-black px-4 py-2" style="font-size: 0.9rem; border-width: 2px;" @onclick="() => _currentCloseOutStep = CloseOutStep.None">
                        CANCEL
                    </button>
                </header>
                
                <div class="card-body p-0">
                    @if (_currentCloseOutStep == CloseOutStep.PromptInventory)
                    {
                        <div class="text-center py-5">
                            <h3 class="display-6 fw-black mb-5">Was any liquor taken from inventory?</h3>
                            <div class="d-grid gap-3 d-sm-flex justify-content-center">
                                <button class="btn btn-light btn-lg px-5 py-4 rounded-4 fw-black flex-grow-1" style="font-size: 1.5rem;" @onclick="() => _currentCloseOutStep = CloseOutStep.PromptZ">NO</button>
                                <button class="btn btn-primary btn-lg px-5 py-4 rounded-4 fw-black flex-grow-1" style="font-size: 1.5rem; background: #1e3a8a;" @onclick="GoToSelection">YES</button>
                            </div>
                        </div>
                    }
                    else if (_currentCloseOutStep == CloseOutStep.ReviewDraft)
                    {
                        <div class="text-center py-4">
                            <h3 class="fw-black mb-3">REVIEW PREVIOUS SELECTION</h3>
                            <p class="text-muted fw-bold small text-uppercase mb-4">You previously selected bottles but did not finish close-out.</p>
                            
                            <div class="bg-light p-3 rounded-4 mb-4 text-start" style="max-height: 200px; overflow-y: auto;">
                                @foreach (var draft in _inventoryPullDraft)
                                {
                                    var item = DbItems.FirstOrDefault(i => i.Id == draft.Key);
                                    <div class="d-flex justify-content-between align-items-center py-3 border-bottom border-2">
                                        <span class="fw-bold" style="font-size: 1.1rem;">@item?.Name</span>
                                        <span class="badge bg-primary px-4 py-2 rounded-pill" style="font-size: 1rem;">x@(draft.Value)</span>
                                    </div>
                                }
                            </div>

                            <p class="fw-black mb-4">Is this selection still correct?</p>
                            <div class="d-grid gap-2">
                                <button class="btn btn-primary btn-lg rounded-pill py-3 fw-black" style="background: #1e3a8a;" @onclick="() => _currentCloseOutStep = CloseOutStep.PromptZ">YES, CORRECT</button>
                                <div class="d-flex gap-2">
                                    <button class="btn btn-outline-secondary flex-grow-1 rounded-pill fw-bold" @onclick="() => _currentCloseOutStep = CloseOutStep.Selection">NO, CORRECT IT</button>
                                    <button class="btn btn-outline-danger flex-grow-1 rounded-pill fw-bold" @onclick="RemoveDraft">REMOVE ALL</button>
                                </div>
                            </div>
                        </div>
                    }
                    else if (_currentCloseOutStep == CloseOutStep.Selection)
                    {
                        <div class="inventory-selection-area">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h4 class="fw-black mb-0">SELECT BOTTLES REMOVED</h4>
                                <span class="badge bg-primary border fw-bold">@_inventoryPullDraft.Values.Sum() ITEMS SELECTED</span>
                            </div>
                            
                            <div class="selection-grid mb-4">
                                @foreach (var item in DbItems.Where(i => i.Category == "LIQUOR").OrderBy(i => i.Name))
                                {
                                    bool isSelected = _inventoryPullDraft.ContainsKey(item.Id);
                                    <div class="selection-tile @(isSelected ? "active" : "")" @onclick="() => AddToDraft(item.Id)">
                                        <div class="tile-name">@item.Name</div>
                                        @if (isSelected)
                                        {
                                            <div class="tile-count">@_inventoryPullDraft[item.Id]</div>
                                            <button class="btn-tile-minus" @onclick:stopPropagation="true" @onclick="() => RemoveFromDraft(item.Id)">
                                                <i class="bi bi-dash-circle-fill"></i>
                                            </button>
                                        }
                                    </div>
                                }
                            </div>

                            <button class="btn btn-primary w-100 py-3 rounded-pill fw-black" style="background: #1e3a8a; font-size: 1.5rem;" @onclick="() => _currentCloseOutStep = CloseOutStep.PromptZ">
                                SAVE SELECTION
                            </button>
                        </div>
                    }
                    else if (_currentCloseOutStep == CloseOutStep.PromptZ)
                    {
                        <div class="text-center py-5">
                            <h3 class="display-6 fw-black mb-2">Would you like to print the Z-Report?</h3>
                            <p class="text-muted fw-bold small text-uppercase mb-5">Finalizing totals and inventory deductions...</p>
                            
                            <div class="d-grid gap-3">
                                <button class="btn btn-primary btn-lg py-4 rounded-4 fw-black d-flex align-items-center justify-content-center gap-3" 
                                        style="font-size: 1.5rem; background: #166534; border-color: #166534;" 
                                        @onclick="() => ProcessZOut(true)">
                                    <i class="bi bi-printer-fill"></i>
                                    YES, PRINT & CLOSE
                                </button>
                                <button class="btn btn-light btn-lg py-3 rounded-4 fw-bold" style="color: #991b1b;" @onclick="() => _currentCloseOutStep = CloseOutStep.None">
                                    NO, CANCEL CLOSE OUT
                                </button>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <style>
            .shift-card--wide { width: 900px !important; max-height: 95vh; }
            .btn-close-modal-top {
                position: absolute;
                top: 20px;
                right: 25px;
                background: none;
                border: none;
                font-size: 1.8rem;
                color: #e2e8f0;
                cursor: pointer;
                transition: color 0.2s;
            }
            .btn-close-modal-top:hover { color: #f87171; }
            .selection-grid { 
                display: grid; 
                grid-template-columns: repeat(auto-fill, minmax(120px, 1fr)); 
                gap: 10px; 
                max-height: 60vh; 
                overflow-y: auto; 
                padding: 10px;
                background: #f1f5f9;
                border-radius: 20px;
            }
            .selection-tile { 
                height: 90px;
                background: white; border: 2px solid #e2e8f0; border-radius: 16px; padding: 10px 8px; 
                display: flex; flex-direction: column; align-items: center; justify-content: center; cursor: pointer;
                transition: all 0.2s; position: relative;
            }
            .selection-tile.active { border-color: #1e3a8a; background: #eff6ff; box-shadow: 0 8px 15px rgba(30, 58, 138, 0.1); }
            .selection-tile .tile-name { font-size: 0.9rem; font-weight: 900; text-align: center; color: #1e293b; line-height: 1.1; text-transform: uppercase; }
            .selection-tile.active .tile-name { color: #1e3a8a; }
            .selection-tile .tile-count { position: absolute; top: -10px; right: -10px; background: #1e3a8a; color: white; width: 32px; height: 32px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 1.1rem; font-weight: 900; border: 3px solid white; box-shadow: 0 4px 6px rgba(0,0,0,0.1); }
            .btn-tile-minus { 
                position: absolute; bottom: 8px; right: 8px; 
                background: none; border: none; color: #ef4444; 
                font-size: 1.4rem; cursor: pointer; transition: transform 0.1s; 
                display: flex; align-items: center; justify-content: center;
            }
            .btn-tile-minus:active { transform: scale(0.9); opacity: 0.8; }
        </style>
    }

    @if (ShowCheckoutOverlay)
    {
        <div class="shift-overlay">
            <div class="checkout-card">
                <button class="btn-close-modal" @onclick="() => ShowCheckoutOverlay = false"><i class="bi bi-x-circle"></i></button>
                <div class="card-body">
                    <div class="checkout-summary-grid">
                        <div class="summary-pill total">
                            <span class="label">TOTAL DUE</span>
                            <span class="value">$@Subtotal.ToString("F2")</span>
                        </div>
                        <div class="summary-pill change @(CashReceived.HasValue && CashReceived.Value >= Subtotal ? "visible" : "")">
                            <span class="label">CHANGE DUE</span>
                            <span class="value">$@ChangeDue.ToString("F2")</span>
                        </div>
                    </div>

                    <div class="cash-input-display">
                        <div class="display-header">
                            <div class="label">CASH RECEIVED</div>
                            <button class="btn-clear-input" @onclick='() => HandleNumPad("CLEAR")'>CLEAR</button>
                        </div>
                        <div class="cash-display-pill">
                            <span class="currency">$</span>
                            <span class="amount">@(string.IsNullOrWhiteSpace(CashInputString) ? "0.00" : CashInputString)</span>
                        </div>
                    </div>

                    <div class="checkout-grid">
                        <!-- Number Pad -->
                        <div class="numpad-container">
                            <div class="numpad-grid">
                                <button class="numpad-btn" @onclick='() => HandleNumPad("7")'>7</button>
                                <button class="numpad-btn" @onclick='() => HandleNumPad("8")'>8</button>
                                <button class="numpad-btn" @onclick='() => HandleNumPad("9")'>9</button>
                                <button class="numpad-btn" @onclick='() => HandleNumPad("4")'>4</button>
                                <button class="numpad-btn" @onclick='() => HandleNumPad("5")'>5</button>
                                <button class="numpad-btn" @onclick='() => HandleNumPad("6")'>6</button>
                                <button class="numpad-btn" @onclick='() => HandleNumPad("1")'>1</button>
                                <button class="numpad-btn" @onclick='() => HandleNumPad("2")'>2</button>
                                <button class="numpad-btn" @onclick='() => HandleNumPad("3")'>3</button>
                                <button class="numpad-btn" @onclick='() => HandleNumPad(".")'>.</button>
                                <button class="numpad-btn" @onclick='() => HandleNumPad("0")'>0</button>
                                <button class="numpad-btn btn-backspace" @onclick='() => HandleNumPad("BACK")'>
                                    <i class="bi bi-backspace-fill"></i>
                                </button>
                            </div>
                        </div>

                        <!-- Quick Cash Vertical Column -->
                        <div class="quick-cash-grid-vertical">
                            <button class="btn-quick-cash" @onclick="() => SetCashReceived(Subtotal)">EXACT</button>
                            <button class="btn-quick-cash" @onclick="() => SetCashReceived(5)">$5</button>
                            <button class="btn-quick-cash" @onclick="() => SetCashReceived(10)">$10</button>
                            <button class="btn-quick-cash" @onclick="() => SetCashReceived(20)">$20</button>
                            <button class="btn-quick-cash" @onclick="() => SetCashReceived(50)">$50</button>
                            <button class="btn-quick-cash" @onclick="() => SetCashReceived(100)">$100</button>
                        </div>
                    </div>

                    <div class="checkout-actions">
                        <button class="btn-add-more" @onclick="() => ShowCheckoutOverlay = false">UPDATE ORDER</button>
                        <button class="btn-complete" @onclick="FinalizeSale">COMPLETE TRANSACTION</button>
                    </div>
                </div>
            </div>
        </div>
    }

    <main class="pos-workspace">
        <!-- LEFT: Product Grid with Rounded Cards -->
        <section class="pos-catalog">
            <!-- Active Event Banner (Visible ONLY when Banquet or Darts Mode is Active) -->
            @if ((DbActiveEvents != null && DbActiveEvents.Any()) || isDartsModeActive)
            {
                <div class="active-event-banner d-flex align-items-center justify-content-between p-3 mb-4 rounded-4 shadow-sm border border-warning" style="background: linear-gradient(135deg, #fffbeb 0%, #fef3c7 100%); border-width: 2px !important; border-color: #f59e0b !important;">
                    <div class="d-flex align-items-center gap-3">
                        <div class="d-flex align-items-center justify-content-center bg-warning text-dark rounded-circle" style="width: 48px; height: 48px; min-width: 48px;">
                            @if (isDartsModeActive)
                            {
                                <i class="bi bi-bullseye fs-4 text-dark"></i>
                            }
                            else
                            {
                                <i class="bi bi-calendar-check-fill fs-4 text-dark"></i>
                            }
                        </div>
                        <div>
                            @if (isDartsModeActive)
                            {
                                <h5 class="fw-black m-0 text-dark" style="letter-spacing: -0.5px; font-size: 1.1rem;">DARTS CLUB ACTIVE MODE</h5>
                                <p class="small text-muted fw-bold mb-0">Running under Darts Club automatic round rewards.</p>
                            }
                            else
                            {
                                var ev = DbActiveEvents.First();
                                var isPrePaid = ev.Type == GFC.Core.Enums.EventTabType.PrePaid;
                                var isSelected = _selectedActiveEvent?.Id == ev.Id;
                                
                                <h5 class="fw-black m-0 text-dark" style="letter-spacing: -0.5px; font-size: 1.1rem;">ACTIVE BANQUET: @GetEventDisplayName(ev.Name).ToUpper()</h5>
                                <div class="d-flex align-items-center gap-3 mt-1">
                                    <p class="small text-muted fw-bold mb-0">@(isPrePaid ? "PREPAID" : "RUNNING TAB")</p>
                                    @if (isPrePaid)
                                    {
                                        var displayBal = isSelected ? (ev.CurrentBalance - Subtotal) : ev.CurrentBalance;
                                        <span class="fw-black rounded-pill px-3 py-1 @(displayBal < 0 ? "bg-danger" : "bg-success") text-white"
                                              style="font-size: 0.9rem; letter-spacing: 0.5px; box-shadow: 0 2px 8px rgba(0,0,0,0.15);">
                                            BAL: @displayBal.ToString("C")
                                        </span>
                                    }
                                    else
                                    {
                                        var displayTab = isSelected ? Math.Abs(ev.CurrentBalance - Subtotal) : Math.Abs(ev.CurrentBalance);
                                        <span class="fw-black rounded-pill px-3 py-1 bg-primary text-white"
                                              style="font-size: 0.9rem; letter-spacing: 0.5px; box-shadow: 0 2px 8px rgba(0,0,0,0.15);">
                                            TAB: @displayTab.ToString("C")
                                        </span>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                    
                    <div class="d-flex align-items-center gap-2">
                        @if (isDartsModeActive)
                        {
                            <span class="badge bg-danger px-4 py-2.5 rounded-pill fw-black text-white" style="font-size: 0.85rem; letter-spacing: 0.5px; animation: pulse-red 2s infinite;">
                                DARTS ACTIVE
                            </span>
                        }
                        else
                        {
                            var ev = DbActiveEvents.First();
                            var isSelected = _selectedActiveEvent?.Id == ev.Id;
                            
                            @if (IsEventDirect(ev))
                            {
                                <span class="badge bg-success px-4 py-2.5 rounded-pill fw-black text-white" 
                                      style="border-radius: 50px !important; font-size: 0.85rem !important; letter-spacing: 0.5px !important; font-weight: 900 !important;
                                             box-shadow: 0 4px 12px rgba(16, 185, 129, 0.2) !important;">
                                    <i class="bi bi-journal-check me-1"></i> DIRECT TAB ACTIVE
                                </span>
                            }
                            else
                            {
                                <button type="button" class="btn rounded-pill fw-black transition-all"
                                    style="border-radius: 50px !important; font-size: 0.85rem !important; letter-spacing: 0.5px !important; font-weight: 900 !important; transition: all 0.2s ease-in-out !important;
                                           background: @(isSelected ? "#10b981" : "white") !important;
                                           color: @(isSelected ? "white" : "#334155") !important;
                                           border: 2px solid @(isSelected ? "#10b981" : "#94a3b8") !important;
                                           box-shadow: @(isSelected ? "0 4px 12px rgba(16, 185, 129, 0.2)" : "none") !important;"
                                    @onclick="async () => await SetOrderMode(isSelected ? null : ev)">
                                @if (isSelected)
                                {
                                    <i class="bi bi-check-circle-fill me-1"></i> @("BANQUET SALES ACTIVE")
                                }
                                else
                                {
                                    <i class="bi bi-lightning-charge me-1"></i> @("SWITCH TO BANQUET SALES")
                                }
                            </button>
                            }
                            
                            <button type="button" class="btn btn-danger rounded-pill fw-black transition-all ms-2"
                                    style="border-radius: 50px !important; font-size: 0.85rem !important; letter-spacing: 0.5px !important; font-weight: 900 !important; transition: all 0.2s ease-in-out !important;
                                           background: #ef4444 !important; color: white !important; border: 2px solid #ef4444 !important;
                                           box-shadow: 0 4px 12px rgba(239, 68, 68, 0.2) !important;"
                                    @onclick="() => CloseBanquet(ev)">
                                <i class="bi bi-x-circle-fill me-1"></i> CLOSE EVENT
                            </button>
                        }
                    </div>
                </div>
            }

            <div class="catalog-filters d-flex justify-content-between align-items-center w-100 mb-4 pe-2">
                <div class="d-flex gap-2 flex-wrap">
                    @foreach (var cat in DisplayCategories)
                    {
                        var isDarts = cat == "DARTS CLUB ROUND";
                        var shouldHighlightDarts = isDarts && isDartsModeActive;
                        
                        <button class="filter-pill @(ActiveCategory == cat || shouldHighlightDarts ? "active" : "") @(isDarts ? "filter-pill--darts" : "")" 
                                @onclick='async () => await HandleCategoryClick(cat)'>@cat</button>
                    }
                </div>
                <button class="btn-no-sale shadow-sm" @onclick="HandleNoSale">
                    <i class="bi bi-unlock-fill"></i> NO SALE
                </button>
            </div>

            <div class="product-grid">
                @if (ActiveCategory == "TOKENS")
                {
                    @if (DbTokens != null)
                    {
                        @foreach (var token in DbTokens)
                        {
                            <button class="product-card token-card" @onclick="() => AddTokenToCart(token)" style="border-left: 10px solid @token.ColorHex">
                                <span class="item-name">@token.Name</span>
                                <span class="item-price">BUY @token.SalePrice.ToString("C")</span>
                            </button>
                        }
                    }
                }
                else
                {
                    @foreach (var item in FilteredItems)
                    {
                        <button class="product-card" @onclick="async () => await AddToCart(item)">
                            <span class="item-name">@item.Name</span>
                            <span class="item-price">$@item.Price.ToString("F2")</span>
                        </button>
                    }
                }
            </div>
        </section>

        <!-- MIDDLE: Speed Bar (Popular Items) -->
        <aside class="pos-speed-bar">
            <div class="speed-bar-header">
                <i class="bi bi-fire text-orange"></i>
                <span>POPULAR</span>
            </div>
            <div class="speed-items">
                @{
                    int rank = 1;
                    @foreach (var item in PopularItems.Take(8))
                    {
                        var currentRank = rank++;
                        <button class="speed-pill rank-@currentRank" @onclick="async () => await AddToCart(item)" style="--rank-delay: @(currentRank * 0.05)s">
                            <div class="pill-name">@item.Name</div>
                        </button>
                    }
                }
            </div>
        </aside>

        <!-- RIGHT: Rounded Active Order Panel -->
        <aside class="pos-cart @(isDartsModeActive ? "darts-mode-active" : "")">
            <div class="cart-header d-flex align-items-center justify-content-between px-3">
                <h3 class="mb-0 fw-black text-start" style="line-height: 0.95; font-size: 1.25rem;">
                    @(isDartsModeActive ? "DARTS" : "ACTIVE")<br/>ORDER
                </h3>
                
                <div class="header-items-badge">
                    <span class="label">ITEMS</span>
                    <span class="count">@CartItems.Sum(x => x.Quantity)</span>
                </div>

                <button class="btn-clear-header" @onclick="ClearCart">
                    <i class="bi bi-trash3 me-1"></i> CLEAR
                </button>
            </div>

            @if (_showBanquetCloseModal && _closingBanquet != null)
            {
                <div class="shift-overlay" style="z-index: 9999;">
                    <div class="notice-modal shadow-lg border border-2 animate__animated animate__fadeInUp" style="max-width: 450px; background-color: #ffffff; color: #1f2937; border-radius: 1.5rem; padding: 2rem; margin: auto;">
                        <div class="notice-icon-circle bg-warning text-dark mb-3 mx-auto" style="width: 60px; height: 60px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 1.75rem; background-color: #fef3c7 !important; color: #d97706 !important;">
                            <i class="bi bi-printer-fill"></i>
                        </div>
                        <h3 class="fw-black text-center mb-2" style="color: #111827;">Close Banquet Tab?</h3>
                        <p class="text-muted text-center mb-4 small">
                            Would you like to print a copy of the banquet aggregated summary report for the host before closing out event <strong>@_closingBanquet.Name</strong>?
                        </p>

                        <div class="d-flex flex-column gap-2">
                            <button class="btn btn-warning w-100 py-3 rounded-pill fw-black shadow-sm text-white" style="background-color: #d97706; border-color: #d97706;" @onclick="() => ExecuteCloseBanquet(true)">
                                <i class="bi bi-printer-fill me-1"></i> YES, PRINT &amp; CLOSE
                            </button>
                            <button class="btn btn-primary w-100 py-3 rounded-pill fw-bold shadow-sm" @onclick="() => ExecuteCloseBanquet(false)">
                                YES, CLOSE ONLY
                            </button>
                            <button class="btn btn-outline-secondary w-100 py-3 rounded-pill fw-bold" @onclick="() => { _showBanquetCloseModal = false; _closingBanquet = null; }">
                                CANCEL
                            </button>
                        </div>
                    </div>
                </div>
            }

            @if (_showOpenBanquetsZOutWarning)
            {
                <div class="shift-overlay no-backdrop" style="z-index: 9999;">
                    <div class="notice-modal animate__animated animate__fadeInUp" style="max-width: 480px; border: 3px solid #ef4444; background-color: #ffffff; color: #1f2937; border-radius: 1.5rem; padding: 2rem; margin: auto;">
                        <div class="notice-icon-circle bg-danger text-white mb-3 mx-auto" style="width: 60px; height: 60px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 1.75rem; background-color: #ef4444 !important;">
                            <i class="bi bi-exclamation-octagon-fill"></i>
                        </div>
                        <h3 class="text-danger fw-black text-center mb-2">Open Events Detected!</h3>
                        <p class="mb-3 text-center small text-muted">
                            There are currently <strong>@DbActiveEvents.Count</strong> active event(s) open:
                        </p>
                        <div class="bg-light p-3 rounded-3 mb-4 text-start" style="max-height: 150px; overflow-y: auto; border: 1px solid #e5e7eb; background-color: #f3f4f6 !important; color: #374151 !important;">
                            @foreach (var ev in DbActiveEvents)
                            {
                                <div class="d-flex justify-content-between align-items-center mb-2 pb-2 border-bottom">
                                    <span class="fw-bold">@GetEventDisplayName(ev.Name)</span>
                                    <span class="badge bg-danger rounded-pill px-2.5 py-1" style="background-color: #ef4444 !important; color: white;">OPEN TAB</span>
                                </div>
                            }
                        </div>
                        <p class="small text-muted mb-4 text-center">
                            Bartender shift close-out (Z-Report) can proceed with open events remaining open for subsequent shifts, but please verify before continuing.
                        </p>
                        <div class="d-flex flex-column gap-2">
                            <button class="btn btn-danger w-100 py-3 rounded-pill fw-black shadow-sm text-white" style="background-color: #ef4444; border-color: #ef4444;" @onclick="ProceedToCloseOut">
                                <i class="bi bi-arrow-right-circle-fill me-1"></i> PROCEED WITH CLOSE-OUT ANYWAY
                            </button>
                            <button class="btn btn-outline-secondary w-100 py-3 rounded-pill fw-bold" @onclick="() => _showOpenBanquetsZOutWarning = false">
                                GO BACK TO CLOSE/MANAGE EVENTS
                            </button>
                        </div>
                    </div>
                </div>
            }

            @if (showRedeemOverlay)
            {
                <div class="shift-overlay">
                    <div class="redeem-modal shadow-lg border border-2">
                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <h2 class="fw-black mb-0">REDEEM TOKENS</h2>
                            <button class="btn btn-light rounded-circle p-2" @onclick="() => showRedeemOverlay = false">
                                <i class="bi bi-x-lg"></i>
                            </button>
                        </div>
                        <p class="text-muted fw-bold mb-4">Select a token type to cover a qualifying item in the cart.</p>
                        
                        <div class="row row-cols-2 g-3 mb-4">
                            @if (DbTokens != null && DbTokens.Any())
                            {
                                @foreach (var token in DbTokens)
                                {
                                    <div class="col">
                                        <button class="token-redeem-btn w-100 h-100" @onclick="() => ApplyTokenRedemption(token)" style="border-top: 8px solid @token.ColorHex">
                                            <span class="fw-black">@token.Name</span>
                                            <span class="badge bg-light text-primary border">Redeem One</span>
                                        </button>
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="col-12 text-center py-4">
                                    <p class="text-danger fw-bold">No token types configured in Menu Manager.</p>
                                </div>
                            }
                        </div>

                        <button class="btn btn-secondary w-100 rounded-pill py-3 fw-black" @onclick="() => showRedeemOverlay = false">
                            CANCEL / GO BACK
                        </button>
                    </div>
                </div>
            }

            @if (showSuccessOverlay)
            {
                <div class="shift-overlay no-backdrop">
                    <div class="success-splash animate__animated animate__zoomIn">
                        <div class="icon-circle">
                            <i class="bi bi-check-lg"></i>
                        </div>
                        <h2 class="fw-black mt-3">TRANSACTION COMPLETE</h2>
                    </div>
                </div>
            }

            @if (showCloseOutSuccessOverlay)
            {
                <div class="shift-overlay no-backdrop" style="z-index: 5000;">
                    <div class="success-splash animate__animated animate__zoomIn" style="border-color: #1e3a8a;">
                        <div class="icon-circle" style="background: #1e3a8a;">
                            <i class="bi bi-shield-check"></i>
                        </div>
                        <h2 class="fw-black mt-3" style="color: #1e3a8a;">SHIFT SUCCESSFULLY CLOSED</h2>
                        <p class="text-muted fw-bold">Z-REPORT GENERATED</p>
                    </div>
                </div>
            }
            @if (_showNoticeModal)
            {
                <div class="shift-overlay no-backdrop" style="z-index: 9999;">
                    <div class="notice-modal animate__animated animate__fadeInUp">
                        <div class="notice-icon-circle @(_noticeType == "warning" ? "bg-amber" : "bg-blue")">
                            <i class="bi @(_noticeType == "warning" ? "bi-exclamation-triangle-fill" : "bi-info-circle-fill")"></i>
                        </div>
                        <h3 class="fw-black mt-3 text-uppercase">@_noticeTitle</h3>
                        <p class="text-muted fw-bold mb-4 px-3">@_noticeMessage</p>
                        
                        <div class="d-flex gap-3 w-100 px-2 mt-2">
                            @if (_noticeType == "dual")
                            {
                                <button class="btn btn-outline-secondary w-50 py-3 rounded-pill fw-bold" @onclick="() => _showNoticeModal = false">CANCEL</button>
                                <button class="btn btn-primary w-50 py-3 rounded-pill fw-bold shadow-sm" @onclick="OnNoticeConfirm">YES, PROCEED</button>
                            }
                            else
                            {
                                <button class="btn btn-primary w-100 py-3 rounded-pill fw-bold shadow-sm" @onclick="() => _showNoticeModal = false">OK, GOT IT</button>
                            }
                        </div>
                    </div>
                </div>
            }
            
            <div id="cartItemsList" class="cart-items">
                @if (CartItems.Count == 0)
                {
                    <div class="cart-empty">
                        <i class="bi bi-cart"></i>
                        <p>No Items Selected</p>
                    </div>
                }
                else
                {
                    @foreach (var item in CartItems)
                    {
                        <div class="cart-item-pill">
                            <div class="item-info">
                                <span class="qty-badge">@item.Quantity<small>x</small></span>
                                <span class="name">@item.Name</span>
                            </div>
                            <div class="item-actions">
                                <span class="price">$@((item.Price * item.Quantity).ToString("F2"))</span>
                                <button class="btn-remove" @onclick="() => RemoveItem(item)"><i class="bi bi-dash-circle-fill"></i></button>
                            </div>
                        </div>
                    }
                }
            </div>

            <div class="cart-footer">
                <div class="total-summary">
                    <div class="grand-total-pill">
                        <span class="label">TOTAL DUE</span>
                        <span class="value">$@Subtotal.ToString("F2")</span>
                    </div>
                </div>
                
                <div class="checkout-btns-group" style="display: flex; gap: 8px;">
                    @if (_selectedActiveEvent != null && !IsEventDirect(_selectedActiveEvent))
                    {
                        <button class="btn-checkout bg-primary text-white border-0 shadow-sm @(CartItems.Count == 0 ? "disabled" : "")" 
                                disabled="@(CartItems.Count == 0)"
                                style="flex: 1; padding: 0.5rem;"
                                @onclick="ChargeToTab">
                            <i class="bi bi-journal-check d-block mb-1"></i> TAB
                        </button>
                    }
                    else
                    {
                        <button class="btn-redeem @(CartItems.Count == 0 ? "disabled" : "")" 
                                disabled="@(CartItems.Count == 0)"
                                style="flex: 2;"
                                @onclick="() => showRedeemOverlay = true">
                            <i class="bi bi-ticket-perforated me-2"></i> REDEEM TOKEN
                        </button>
                        @if (_selectedActiveEvent != null || HasDirectEventActive)
                        {
                            <button class="btn-checkout bg-primary text-white border-0 shadow-sm @(CartItems.Count == 0 ? "disabled" : "")" 
                                    disabled="@(CartItems.Count == 0)"
                                    style="flex: 1.5; padding: 0.5rem;"
                                    @onclick="ChargeToTab">
                                <i class="bi bi-journal-check d-block mb-1"></i> TAB
                            </button>
                        }
                        <button class="btn-checkout @(CartItems.Count == 0 ? "disabled" : "")" 
                                disabled="@(CartItems.Count == 0)"
                                style="flex: 2;"
                                @onclick="Checkout">
                            <i class="bi bi-wallet2 me-2"></i> PAY
                        </button>
                    }
                </div>
            </div>
        </aside>
    </main>
</div>

<style>
    :root {
