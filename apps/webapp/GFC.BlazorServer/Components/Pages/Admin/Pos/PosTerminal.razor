    .item-info .name { font-weight: 850; color: #1e293b; font-size: 0.95rem; line-height: 1.2; word-break: break-word; }

    .item-actions { display: flex; align-items: center; gap: 0.8rem; }
    .item-actions .price { font-weight: 850; color: #475569; font-size: 0.95rem; }
    .btn-remove { background: none; border: none; font-size: 1.5rem; color: #f87171; cursor: pointer; line-height: 1; display: flex; align-items: center; transition: 0.1s; }
    .btn-remove:active { transform: scale(0.85); color: #dc2626; }

    .cart-footer { padding: 1.25rem 1.5rem; background: white; border-top: 4px solid var(--pos-navy); border-radius: 40px 40px 0 0; box-shadow: 0 -10px 30px rgba(0,0,0,0.05); }
