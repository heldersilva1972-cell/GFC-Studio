            forceTrainingMode = isChecked;
            if (!forceTrainingMode)
            {
                allowHardwareInTraining = false;
                await JSRuntime.InvokeVoidAsync("localStorage.removeItem", "gfc_pos_hardware_practice");
            }
            
            await JSRuntime.InvokeVoidAsync("localStorage.setItem", "gfc_pos_training_mode", forceTrainingMode.ToString().ToLower());
            await LoadLiveData(); // Refresh categories
        }
    }

    private async Task ToggleHardwarePractice(object? val)
    {
