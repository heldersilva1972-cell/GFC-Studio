        public int Quantity { get; set; } = 1;
        public string Category { get; set; } = "MISC";
        public int DisplayOrder { get; set; } = 0;
        public bool IsTokenApplied { get; set; } = false;
        public bool IsDiscounted { get; set; } = false;
        public List<ProductItem> Modifiers { get; set; } = new();
    }

    public class SaleRecord
    {
        public Guid Id { get; set; }
        public DateTime Timestamp { get; set; }
        public string TerminalName { get; set; } = "";
        public decimal Total { get; set; }
        public string Bartender { get; set; } = "";
        public string PaymentType { get; set; } = "CASH";
        public string ItemsJson { get; set; } = "";
        public int? ActiveEventId { get; set; }
    }
    private async Task SaveTerminalName()
    {
        await JSRuntime.InvokeVoidAsync("localStorage.setItem", "GfcPos_TerminalName", TerminalName);
        await LoadLiveData();
    }

    private SystemSettings _sysSettings = new();
    private async Task LoadTerminalName()
    {
        var name = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "GfcPos_TerminalName");
        if (!string.IsNullOrEmpty(name)) TerminalName = name;
        
        // Also load sys settings for the modal
        try {
            _sysSettings = await SystemSettingsService.GetAsync();
            StateHasChanged();
        } catch (Exception ex) {
            Console.WriteLine($"Settings load error: {ex.Message}");
        }
    }


    private async Task HandleNoSale()
    {
        // 1. Send "Open Drawer" signal (Mock for now, but logs to history)
        // In local production, this would send ESC/POS command to the printer.
        
        using var db = DbFactory.CreateDbContext();
        
        var noSale = new PosSale
        {
            TerminalName = TerminalName,
            TotalAmount = 0,
            Timestamp = DateTime.Now,
            ItemsJson = "[{\"Name\": \"NO SALE (Drawer Open)\", \"Quantity\": 1, \"Price\": 0}]",
            PaymentType = "NO SALE"
        };

        if (forceTrainingMode)
        {
            if (allowHardwareInTraining)
            {
                Console.WriteLine($"[TRAINING] NO SALE - Drawer Open at {DateTime.Now}");
            }
            ClearCart();
            await Toast.ShowInfo("Training No-Sale (Not Persisted)");
            return;
        }

        db.PosSales.Add(noSale);
        await db.SaveChangesAsync();

        // 2. Clear current cart for safety
        ClearCart();

        // 3. Optional: Print a single index slip to physically confirm the opening
        Console.WriteLine($"[CASH DRAWER] Opened at {DateTime.Now} on {TerminalName}");
    }
    }
