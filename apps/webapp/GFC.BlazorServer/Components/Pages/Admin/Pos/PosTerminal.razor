    private void CloseBanquet(ActiveEvent ev)
    {
        _closingBanquet = ev;
        _showBanquetCloseModal = true;
        StateHasChanged();
    }

    private async Task ExecuteCloseBanquet(bool print)
    {
        var ev = _closingBanquet;
        _showBanquetCloseModal = false;
        _closingBanquet = null;
        if (ev == null) return;

        if (print)
        {
            await PrintBanquetMasterSummary(ev);
        }

        // 1. Database Update (Close Banquet on Server)
        try
        {
            using var db = await DbFactory.CreateDbContextAsync();
            var activeEvent = await db.ActiveEvents.FindAsync(ev.Id);
            if (activeEvent != null)
            {
                activeEvent.Status = GFC.Core.Enums.EventTabStatus.Closed; // Mark closed!
                await db.SaveChangesAsync();
                
                await Toast.ShowSuccess("Banquet event successfully closed");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[POS] CloseBanquet failed: {ex.Message}");
            await Toast.ShowError("Failed to close banquet event in database.");
        }

        // 2. Reload local event collections
        DbActiveEvents.RemoveAll(x => x.Id == ev.Id);

        // Auto reset selected active event if it was the one closed
        if (_selectedActiveEvent?.Id == ev.Id)
        {
            _selectedActiveEvent = null;
            ActiveCategory = "BEER";
        }
        showBanquetsModal = false; // Close the banquet manager modal
        StateHasChanged();
    }

    private async Task PrintBanquetMasterSummary(ActiveEvent ev)
    {
        try
        {
            BanquetMasterSummaryDto? master = null;
            try
            {
                using var db = await DbFactory.CreateDbContextAsync();
                var activeEvent = await db.ActiveEvents.FindAsync(ev.Id);
                if (activeEvent != null)
                {
                    master = new BanquetMasterSummaryDto
                    {
                        EventName = activeEvent.Name,
                        TotalSpent = 0,
                        TotalDeposited = activeEvent.InitialAmount
                    };

                    if (activeEvent.InitialAmount > 0)
                    {
                        master.Deposits.Add(new BanquetDepositDetailDto
                        {
                            Timestamp = activeEvent.CreatedAt,
                            Amount = activeEvent.InitialAmount,
                            IsInitial = true
                        });
                    }

                    var sales = await db.PosSales
                        .Where(s => s.ActiveEventId == ev.Id && !s.IsVoided)
                        .ToListAsync();

                    var jsonOptions = new JsonSerializerOptions { PropertyNameCaseInsensitive = true };

                    foreach (var sale in sales)
                    {
                        if (string.IsNullOrEmpty(sale.ItemsJson)) continue;
                        try
                        {
                            var items = JsonSerializer.Deserialize<List<ProductItem>>(sale.ItemsJson, jsonOptions);
                            if (items != null)
                            {
                                foreach (var i in items)
                                {
                                    if (i.Name.StartsWith("TAB DEPOSIT:"))
                                    {
                                        master.TotalDeposited += i.Price;
                                        master.Deposits.Add(new BanquetDepositDetailDto
                                        {
                                            Timestamp = sale.Timestamp,
                                            Amount = i.Price,
                                            IsInitial = false
                                        });
                                    }
                                    else if (sale.PaymentType == "TAB")
                                    {
                                        if (!master.ItemQuantities.ContainsKey(i.Name))
                                        {
                                            master.ItemQuantities[i.Name] = 0;
                                            master.ItemTotals[i.Name] = 0;
                                        }
                                        master.ItemQuantities[i.Name] += i.Quantity;
                                        master.ItemTotals[i.Name] += (i.Price * i.Quantity);
                                        master.TotalSpent += (i.Price * i.Quantity);
                                    }
                                }
                            }
                        }
                        catch {}
                    }
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"[POS] Error loading banquet summary: {ex.Message}");
            }

            string eventName = GetEventDisplayName(ev.Name);
            decimal totalDeposited = ev.InitialAmount;
            decimal totalSpent = 0;
            var itemsSummary = new Dictionary<string, int>();
            var totalsSummary = new Dictionary<string, decimal>();

            if (master != null)
            {
                eventName = master.EventName;
                totalDeposited = master.TotalDeposited;
                totalSpent = master.TotalSpent;
                itemsSummary = master.ItemQuantities;
                totalsSummary = master.ItemTotals;
            }

            var isRunningTab = ev.Type == GFC.Core.Enums.EventTabType.RunningTab;
            var html = $@"
                <div style='font-family:monospace; width:280px; font-size:12px; line-height:1.4;'>
                    <div style='text-align:center; font-weight:bold; font-size:16px; margin-bottom:4px;'>GFC BANQUET RECEIPT</div>
                    <div style='text-align:center; border-bottom:1px dashed #000; padding-bottom:8px; margin-bottom:8px;'>
                        EVENT: {eventName.ToUpper()}<br/>
                        DATE: {DateTime.Now:MM/dd/yyyy h:mm tt}
                    </div>";

            if (!isRunningTab)
            {
                html += $@"
                    <div style='border-bottom:1px dashed #000; padding-bottom:6px; margin-bottom:8px;'>
                        <div style='font-weight:bold; margin-bottom:4px;'>FUNDS & DEPOSITS LOG</div>";

                if (master != null && master.Deposits.Any())
                {
                    foreach (var dep in master.Deposits)
                    {
                        var label = dep.IsInitial ? "INITIAL DEPOSIT" : "ADDED FUNDS";
                        html += $@"
                            <div style='display:flex; justify-content:space-between; font-size:11px;'>
                                <span>- {label} ({dep.Timestamp.ToLocalTime():MM/dd h:mm tt})</span>
                                <span>{dep.Amount:C}</span>
                            </div>";
                    }
                }
                else
                {
                    html += $@"
                        <div style='display:flex; justify-content:space-between; font-size:11px;'>
                            <span>- INITIAL DEPOSIT</span>
                            <span>{ev.InitialAmount:C}</span>
                        </div>";
                }

                html += $@"
                        <div style='display:flex; justify-content:space-between; font-weight:bold; font-size:13px; border-top:1px solid #000; margin-top:4px; padding-top:4px;'>
                            <span>TOTAL FUNDS ADDED:</span>
                            <span>{totalDeposited:C}</span>
                        </div>
                    </div>";
            }

            html += $@"
                    <div style='font-weight:bold; text-transform:uppercase; margin-bottom:4px;'>TAB ITEM SUMMARY</div>";

            if (itemsSummary.Any())
            {
                foreach (var item in itemsSummary.OrderByDescending(x => x.Value))
                {
                    var itemTotal = totalsSummary.ContainsKey(item.Key) ? totalsSummary[item.Key] : 0;
                    html += $@"<div style='display:flex; justify-content:space-between; font-size:11px;'>
                        <span>{item.Key} (x{item.Value})</span>
                        <span>{itemTotal:C}</span>
                    </div>";
                }
            }
            else
            {
                html += "<div style='font-style:italic; text-align:center; margin:8px 0;'>No purchases recorded on tab.</div>";
            }

            var remaining = totalDeposited - totalSpent;
            html += $@"
                    <div style='border-top:1px dashed #000; margin-top:8px; padding-top:4px;'>";

            if (!isRunningTab)
            {
                html += $@"
                        <div style='display:flex; justify-content:space-between; font-weight:bold; font-size:13px;'>
                            <span>TOTAL SPENT:</span>
                            <span>{totalSpent:C}</span>
                        </div>
                        <div style='display:flex; justify-content:space-between; font-weight:bold; font-size:14px; margin-top:4px; border-top:1px solid #000; padding-top:4px;'>
                            <span>TAB BALANCE:</span>
                            <span>{remaining:C}</span>
                        </div>";
            }
            else
            {
                html += $@"
                        <div style='display:flex; justify-content:space-between; font-weight:bold; font-size:14px; margin-top:4px; border-top:1px solid #000; padding-top:4px;'>
                            <span>TOTAL DUE:</span>
                            <span>{totalSpent:C}</span>
                        </div>";
            }
            html += "</div>";

            html += $@"
                    <div style='text-align:center; margin-top:20px; border-top:1px dashed #000; padding-top:8px; font-size:10px; color:#555;'>
                        Thank you for hosting your event with GFC!
                    </div>
                </div>";

            await PrintReceiptHtml(html);
        }
        catch (Exception ex)
        {
            Console.WriteLine($@"[POS] Error printing banquet summary: {ex.Message}");
            await Toast.ShowError("Failed to print banquet summary.");
        }
    }

    private async Task PrintReceiptHtml(string html)
    {
        try {
            await JSRuntime.InvokeVoidAsync("console.log", $"HARDWARE: Printing HTML Receipt to {PrinterIpAddress}", html);
        } catch {}
    }

    private void HandleBanquetNumpad(string key)
    {
        if (key == "C")
        {
            _banquetNumpadValue = "0";
            _isFirstKeyAfterFocus = true;
        }
        else if (key == ".")
        {
            if (!_banquetNumpadValue.Contains("."))
                _banquetNumpadValue += ".";
            _isFirstKeyAfterFocus = false;
        }
        else
        {
            if (_isFirstKeyAfterFocus || _banquetNumpadValue == "0")
            {
                _banquetNumpadValue = key;
                _isFirstKeyAfterFocus = false;
            }
            else
            {
                if (_banquetNumpadValue.Contains(".") && _banquetNumpadValue.Split('.')[1].Length >= 2) return;
                _banquetNumpadValue += key;
            }
        }

        if (decimal.TryParse(_banquetNumpadValue, out var val))
        {
            if (_selectedBanquetToAddFunds != null)
                _addFundsAmount = val;
            else
                _newBanquetAmount = val;
        }
    }

    private void SelectTemplate(int id)
    {
        _newBanquetTemplateId = id;
        var template = DbEventTemplates?.FirstOrDefault(t => t.Id == id);
        if (template != null)
        {
            _newEventDirectCheckout = template.Name.EndsWith(" [Direct]") || template.Name.EndsWith("[Direct]");
        }
        if (template?.DefaultType == GFC.Core.Enums.EventTabType.RunningTab)
        {
            _newBanquetAmount = 0;
        }
    }

    private async Task StartBanquet()
    {
        if (_newBanquetTemplateId == 0) return;
        var template = DbEventTemplates?.FirstOrDefault(t => t.Id == _newBanquetTemplateId);
        if (template == null) return;
        if (template.DefaultType == GFC.Core.Enums.EventTabType.PrePaid && _newBanquetAmount <= 0) return;

        try
        {
            using var db = await DbFactory.CreateDbContextAsync();
            var cleanName = template.Name;
            if (cleanName.EndsWith(" [Direct]")) cleanName = cleanName.Substring(0, cleanName.Length - 9);
            else if (cleanName.EndsWith("[Direct]")) cleanName = cleanName.Substring(0, cleanName.Length - 8);

            var newEvent = new ActiveEvent
            {
                Name = cleanName + (_newEventDirectCheckout ? " [Direct]" : ""),
                Type = template.DefaultType,
                CurrentBalance = _newBanquetAmount,
                Status = GFC.Core.Enums.EventTabStatus.Open,
                TemplateId = template.Id,
                InitialAmount = _newBanquetAmount,
                CreatedAt = DateTime.UtcNow
            };
            
            db.ActiveEvents.Add(newEvent);
            await db.SaveChangesAsync();

            if (_newBanquetAmount > 0)
            {
                await LogTabDeposit(template.Name, _newBanquetAmount, newEvent.Id, isInitial: true);
            }

            await Toast.ShowSuccess("Banquet started!");
            _newBanquetTemplateId = 0;
            _newBanquetAmount = 0;
            _newEventDirectCheckout = false;
            _banquetNumpadValue = "0";
            _isFirstKeyAfterFocus = true;
            showBanquetsModal = false;
            
            // Reload
            await LoadLiveData();
        }
        catch (Exception ex)
        {
            await Toast.ShowError($"Error starting banquet: {ex.Message}");
        }
    }

    private async Task ConfirmAddFunds()
    {
        if (_selectedBanquetToAddFunds == null || _addFundsAmount <= 0) return;

        try
        {
            using var db = await DbFactory.CreateDbContextAsync();
            var ev = await db.ActiveEvents.FindAsync(_selectedBanquetToAddFunds.Id);
            if (ev != null)
            {
                ev.CurrentBalance += _addFundsAmount;
                await db.SaveChangesAsync();
                
                await LogTabDeposit(ev.Name, _addFundsAmount, ev.Id);
                await Toast.ShowSuccess("Funds successfully added to tab");
            }
            
            _selectedBanquetToAddFunds = null;
            _addFundsAmount = 0;
            _banquetNumpadValue = "0";
            _isFirstKeyAfterFocus = true;
            showBanquetsModal = false; // Close the entire modal after funds are added
            
            // Reload
            await LoadLiveData();
        }
        catch (Exception ex)
        {
            await Toast.ShowError($"Error adding funds: {ex.Message}");
        }
    }

    private async Task LogTabDeposit(string eventName, decimal amount, int? eventId, bool isInitial = false)
    {
        var label = isInitial ? "INITIAL DEPOSIT" : "TAB DEPOSIT";
        try
        {
            using var db = await DbFactory.CreateDbContextAsync();
            var depositSale = new GFC.BlazorServer.Data.Entities.PosSale
            {
                Id = Guid.NewGuid(),
                Timestamp = DateTime.Now,
                TerminalName = forceTrainingMode ? $"{TerminalName} (TRAINING)" : TerminalName,
                BartenderName = CurrentUserName,
                TotalAmount = amount,
                PaymentType = "CASH",
                ActiveEventId = eventId,
                IsSynced = true,
                ItemsJson = JsonSerializer.Serialize(new List<ProductItem>
                {
                    new ProductItem { 
                        Id = 0, 
                        Name = $"{label}: {eventName}", 
                        Price = amount, 
                        Quantity = 1, 
                        Category = "MISC" 
                    }
                })
            };

            db.PosSales.Add(depositSale);
            await db.SaveChangesAsync();

            // Also update shift cash total for Z-Report if not in training mode
            if (!forceTrainingMode)
            {
                ShiftCashTotal += amount;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[POS] Error logging tab deposit: {ex.Message}");
        }
    }

