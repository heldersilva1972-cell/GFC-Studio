@page "/admin/security-settings"
@using GFC.Core.Enums
@using GFC.Core.Models
@using GFC.Core.DTOs
@using GFC.Core.Interfaces
@using GFC.BlazorServer.Services
@using GFC.BlazorServer.Data.Entities
@using GFC.BlazorServer.Services.Vpn
@using Microsoft.AspNetCore.Components.Authorization
@inject IBlazorSystemSettingsService SystemSettingsService
@inject IAuthorizedUserService AuthorizedUserService
@inject IJSRuntime JSRuntime
@inject IUserManagementService UserManagementService
@inject IVpnConfigurationService VpnConfigurationService
@inject IAuthenticationService AuthenticationService
@inject IUrlHelperService UrlHelper
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ILogger<SecuritySettings> Logger

<PageTitle>Security & Access Hub - GFC</PageTitle>

<div class="admin-security-hub p-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-5">
        <div>
            <h1 class="fw-bold text-dark mb-1"><i class="bi bi-shield-lock-fill text-primary me-3"></i>Security & Access Hub</h1>
            <p class="text-muted lead">Control system permissions, user onboarding, and core security policies.</p>
        </div>
        <button class="btn btn-primary rounded-pill px-4 shadow-sm" @onclick="SaveChanges">
            <i class="bi bi-save me-2"></i> Save All Policies
        </button>
    </div>

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="alert alert-danger border-0 shadow-sm rounded-4 mb-4">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @_errorMessage
        </div>
    }
    @if (!string.IsNullOrEmpty(_successMessage))
    {
        <div class="alert alert-success border-0 shadow-sm rounded-4 mb-4">
            <i class="bi bi-check-circle-fill me-2"></i> @_successMessage
        </div>
    }

    <!-- Main Navigation Tabs -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-5">
        <div class="card-header bg-white border-0 p-0">
            <ul class="nav nav-tabs admin-nav-tabs border-0" role="tablist">
                <li class="nav-item flex-fill">
                    <button class="nav-link w-100 py-3 @(_activeTab == "server" ? "active border-primary border-bottom border-3" : "")" @onclick="@(() => _activeTab = "server")">
                        <i class="bi bi-gear-fill me-2"></i>Server Identity
                    </button>
                </li>
                <li class="nav-item flex-fill">
                    <button class="nav-link w-100 py-3 @(_activeTab == "alerts" ? "active border-primary border-bottom border-3" : "")" @onclick="@(() => _activeTab = "alerts")">
                        <i class="bi bi-bell-fill me-2"></i>System Alerts
                    </button>
                </li>
            </ul>
        </div>
        <div class="card-body p-4 min-vh-50">
            


            <!-- TAB 3: SERVER IDENTITY -->
            @if (_activeTab == "server")
            {
                <div class="row g-4">
                    <div class="col-md-6">
                        <div class="policy-card p-4 rounded-4 border @(_settings?.AccessMode != AccessMode.Open ? "border-primary bg-primary bg-opacity-10" : "bg-light") mb-4">
                            <h6 class="fw-bold mb-3 text-uppercase small text-muted">Access Shield Protocol</h6>
                            <label class="fw-bold mb-2">Network Guard Mode</label>
                            <select class="form-select border-0 shadow-sm mb-3" @bind="_settings.AccessMode">
                                <option value="@AccessMode.Open">Open Access (Internal/Home Use)</option>
                                <option value="@AccessMode.LanOrVpn">Zero-Trust LAN/VPN (Secure Mode)</option>
                                <option value="@AccessMode.VpnOnly">VPN Only (Hardened Mode)</option>
                            </select>
                            <div class="small @(_settings?.AccessMode == AccessMode.Open ? "text-danger" : "text-success")">
                                <i class="bi @(_settings?.AccessMode == AccessMode.Open ? "bi-exclamation-triangle-fill" : "bi-shield-fill-check") me-1"></i>
                                @if (_settings?.AccessMode == AccessMode.Open) 
                                {
                                    <span>Warning: Any device on the same Wi-Fi can see the login screen. Device Trust is disabled.</span>
                                }
                                else 
                                {
                                    <span>Protected: Devices MUST use an onboarding link before they can even see the login screen.</span>
                                }
                            </div>
                        </div>

                        <div class="policy-card p-4 rounded-4 border @(_settings?.EnableTwoFactorAuth == true ? "border-primary bg-primary bg-opacity-10" : "bg-light")">
                            <div class="form-check form-switch custom-switch-lg mb-3">
                                <input class="form-check-input" type="checkbox" id="e2fa" @bind="_settings.EnableTwoFactorAuth" />
                                <label for="e2fa" class="form-check-label fw-bold h5 mb-0">Enforce Multi-Factor Access</label>
                            </div>
                            <p class="text-muted small">When on, every user MUST register a device/passkey to access the system.</p>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="bg-light p-4 rounded-4 border mb-4">
                            <h6 class="fw-bold mb-3 text-uppercase small text-muted">Session Policy</h6>
                            <div class="row g-3">
                                <div class="col-6">
                                    <label class="x-small fw-bold">Idle Timeout (m)</label>
                                    <input type="number" class="form-control" @bind="_settings.IdleTimeoutMinutes" />
                                </div>
                                <div class="col-6">
                                    <label class="x-small fw-bold">Device Trust (Days)</label>
                                    <input type="number" class="form-control" @bind="_settings.TrustedDeviceDurationDays" />
                                </div>
                            </div>
                        </div>

                        <div class="alert alert-warning border-0 rounded-4">
                            <h6 class="fw-bold"><i class="bi bi-shield-lock-fill me-2"></i>Under the Hood</h6>
                            <p class="small mb-0">The <strong>Access Shield</strong> blocks untrusted devices at the network level. If a device hasn't used a <em>Secure Setup Link</em>, it will see a blocked screen instead of your system login.</p>
                        </div>
                    </div>
                </div>
            }

            <!-- TAB 4: SYSTEM ALERTS -->
            @if (_activeTab == "alerts")
            {
                 <div class="table-responsive">
                    <h6 class="fw-bold mb-3 ms-1 text-primary">Notification Distribution Matrix</h6>
                    <table class="table table-hover border rounded-4 overflow-hidden">
                        <thead class="bg-light">
                            <tr><th class="ps-4">User</th><th class="text-center small">Member Setup</th><th class="text-center small">Payments</th><th class="text-center small">System Alerts</th><th class="text-center small">Push Enabled</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var user in _allAppUsers)
                            {
                                var pref = GetUserPref(user.UserId);
                                <tr>
                                    <td class="ps-4 py-3">
                                        <div class="fw-bold text-dark">@user.Username</div>
                                        <div class="x-small text-muted">@user.Email</div>
                                    </td>
                                    <td class="text-center"><input type="checkbox" class="form-check-input" @bind="pref.MemberSignupNotifyEmail" /></td>
                                    <td class="text-center"><input type="checkbox" class="form-check-input" @bind="pref.DuesPaymentNotifyEmail" /></td>
                                    <td class="text-center"><input type="checkbox" class="form-check-input" @bind="pref.SystemAlertNotifyEmail" /></td>
                                    <td class="text-center"><input type="checkbox" class="form-check-input" @bind="pref.MemberSignupNotifyPush" /></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                 </div>
            }

        </div>
    </div>
</div>

<style>
    .admin-security-hub { max-width: 1200px; margin: 0 auto; }
    .admin-nav-tabs .nav-link { color: #6c757d; font-weight: 600; font-size: 0.95rem; border: none; background: none; }
    .admin-nav-tabs .nav-link.active { color: #0d6efd; background-color: #f8f9fa; }
    .custom-switch-lg .form-check-input { width: 3.5rem; height: 1.75rem; cursor: pointer; }
    .x-small { font-size: 0.75rem; }
</style>

@using GFC.Core.DTOs
@code {
    private string _activeTab = "server";
    private SystemSettings _settings;
    private List<UserListItemDto> _allAppUsers = new();
    private List<UserNotificationPreferences> _allPreferences = new();
    
    private string _errorMessage;
    private string _successMessage;
    private bool _showAddUser = false;

    [Inject] private INotificationService NotificationService { get; set; }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _settings = await SystemSettingsService.GetAsync();
            _allAppUsers = UserManagementService.GetAllUsers();
            
            _allPreferences = await NotificationService.GetAllPreferencesAsync();
        }
        catch (Exception ex) { _errorMessage = "Initialization Error: " + ex.Message; }
    }

    private UserNotificationPreferences GetUserPref(int userId)
    {
        var existing = _allPreferences.FirstOrDefault(p => p.UserId == userId);
        if (existing == null)
        {
            existing = new UserNotificationPreferences { UserId = userId, MemberSignupNotifyEmail = true, SystemAlertNotifyEmail = true };
            _allPreferences.Add(existing);
        }
        return existing;
    }

    private async Task SaveChanges()
    {
        _errorMessage = null; _successMessage = null;
        try
        {
            await SystemSettingsService.UpdateAsync(_settings);
            
            // Save preferences for all users
            foreach (var pref in _allPreferences)
            {
                await NotificationService.SaveUserPreferencesAsync(pref);
            }

            _successMessage = "System security and notification policies synchronized.";
        }
        catch (Exception ex) { _errorMessage = "Save Error: " + ex.Message; }
    }


    [Inject] private NavigationManager NavigationManager { get; set; }
}
