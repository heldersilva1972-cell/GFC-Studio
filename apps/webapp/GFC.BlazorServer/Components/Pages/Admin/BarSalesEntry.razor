    private async Task HandleLotterySubmit()
    {
        _isSaving = true;
        _showSuccess = false;
        try
        {
            int maxDays = DateTime.DaysInMonth(_selectedEntryYear, _selectedMonth);
            if (_selectedDay > maxDays) _selectedDay = maxDays;

            var enteredDate = new DateTime(_selectedEntryYear, _selectedMonth, _selectedDay, _selectedHour, _selectedMinute, 0);
            _lotteryModel.ShiftDate = enteredDate;
            
            Logger.LogInformation($"Submitting Lottery Entry (Direct SQL): Commission={_lotteryModel.Commission}, Cash={_lotteryModel.CashBonus}, Claims={_lotteryModel.ClaimsBonus}, NetDue={_lotteryModel.NetDue}");

            // DIRECT SQL INSERT to bypass potential repository caching issues
            using var db = await DbFactory.CreateDbContextAsync();
            using var connection = new Microsoft.Data.SqlClient.SqlConnection(db.Database.GetConnectionString());
            await connection.OpenAsync();
            
            var sql = @"
                INSERT INTO LotteryShifts (
                    ShiftDate, EmployeeName, ShiftType, MachineId,
                    StartingCash, EndingCash, TotalSales, TotalPayouts, TotalCancels,
                    Commission, CashBonus, ClaimsBonus, NetDue,
                    Notes, Status, IsReconciled, CreatedBy, CreatedDate, ModifiedBy, ModifiedDate
                )
                VALUES (
                    @ShiftDate, @EmployeeName, @ShiftType, @MachineId,
                    @StartingCash, @EndingCash, @TotalSales, @TotalPayouts, @TotalCancels,
                    @Commission, @CashBonus, @ClaimsBonus, @NetDue,
                    @Notes, @Status, @IsReconciled, @CreatedBy, @CreatedDate, @ModifiedBy, @ModifiedDate
                );";

            using var command = new Microsoft.Data.SqlClient.SqlCommand(sql, connection);
            command.Parameters.AddWithValue("@ShiftDate", _lotteryModel.ShiftDate);
            command.Parameters.AddWithValue("@EmployeeName", _lotteryModel.EmployeeName ?? "");
            command.Parameters.AddWithValue("@ShiftType", (object)_lotteryModel.ShiftType ?? DBNull.Value);
            command.Parameters.AddWithValue("@MachineId", (object)_lotteryModel.MachineId ?? DBNull.Value);
            command.Parameters.AddWithValue("@StartingCash", _lotteryModel.StartingCash);
            command.Parameters.AddWithValue("@EndingCash", _lotteryModel.EndingCash);
            command.Parameters.AddWithValue("@TotalSales", _lotteryModel.TotalSales);
            command.Parameters.AddWithValue("@TotalPayouts", _lotteryModel.TotalPayouts);
            command.Parameters.AddWithValue("@TotalCancels", _lotteryModel.TotalCancels);
            command.Parameters.AddWithValue("@Commission", _lotteryModel.Commission);
            command.Parameters.AddWithValue("@CashBonus", _lotteryModel.CashBonus);
            command.Parameters.AddWithValue("@ClaimsBonus", _lotteryModel.ClaimsBonus);
            command.Parameters.AddWithValue("@NetDue", _lotteryModel.NetDue);
            command.Parameters.AddWithValue("@Notes", (object)_lotteryModel.Notes ?? DBNull.Value);
            command.Parameters.AddWithValue("@Status", "Submitted");
            command.Parameters.AddWithValue("@IsReconciled", false);
            command.Parameters.AddWithValue("@CreatedBy", "Admin");
            command.Parameters.AddWithValue("@CreatedDate", DateTime.Now);
            command.Parameters.AddWithValue("@ModifiedBy", DBNull.Value);
            command.Parameters.AddWithValue("@ModifiedDate", DBNull.Value);

            await command.ExecuteNonQueryAsync();

            _showSuccess = true;
            
            // Reset form
            _lotteryModel = new LotteryShift 
            { 
                 ShiftDate = DateTime.Now, 
                 ShiftType = "Day",
                 Commission = 0, 
                 CashBonus = 0, 
                 ClaimsBonus = 0, 
                 NetDue = 0,
                 TotalSales = 0, 
                 TotalPayouts = 0, 
                 TotalCancels = 0 
            };
            _selectedHour = DateTime.Now.Hour;
            _selectedMinute = DateTime.Now.Minute;
            
            await Task.Delay(1500);
            _showSuccess = false;
        }
        catch (Exception ex)
        {
            _errorDetails = $"Lottery Submit Failed: {ex.Message}";
            Logger.LogError(ex, "Error committing lottery entry");
        }
        finally
        {
            _isSaving = false;
            StateHasChanged();
        }
    }



