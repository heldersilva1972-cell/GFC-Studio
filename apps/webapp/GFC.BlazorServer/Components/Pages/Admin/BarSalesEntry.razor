    private async Task LoadAnalysisData()
    {
        if (_isLoadingAnalysis) return;
        await _dataLock.WaitAsync();
        _isLoadingAnalysis = true;
        StateHasChanged();

        try 
        {
            using var db = await DbFactory.CreateDbContextAsync();
            
            // 1. Fetch Bar Sales Grouped by Month
            var salesData = await db.BarSaleEntries.AsNoTracking()
                .GroupBy(x => new { Year = (x.AdjustedSaleDate ?? x.SaleDate).Year, Month = (x.AdjustedSaleDate ?? x.SaleDate).Month })
                .Select(g => new { g.Key.Year, g.Key.Month, Total = g.Sum(x => x.TotalSales) })
                .ToListAsync();

            // 2. Fetch Usage Data (Items removed)
            var usageTransactions = await db.LiquorTransactions.AsNoTracking()
                .Include(t => t.Item)
                .Where(t => t.ChangeAmount < 0)
                .ToListAsync();

            // Group usage in memory to handle complex object tracking
            var usageGrouped = usageTransactions
                .GroupBy(t => new { t.Timestamp.Year, t.Timestamp.Month })
                .Select(g => new { 
                    g.Key.Year, 
                    g.Key.Month, 
                    TotalBottles = g.Sum(t => Math.Abs(t.ChangeAmount)),
                    Brands = g.GroupBy(t => t.Item != null ? t.Item.Name : "Unknown")
                              .Select(b => (Name: b.Key, Count: b.Sum(t => Math.Abs(t.ChangeAmount))))
                              .OrderByDescending(b => b.Count)
                              .ToList()
                })
                .ToList();

            // 3. Merge Data
            _analysisMonths = new List<RevenueAnalysisMonth>();
            
            // Get all unique year/months from both sets
            var allDates = salesData.Select(x => new DateTime(x.Year, x.Month, 1))
                .Union(usageGrouped.Select(x => new DateTime(x.Year, x.Month, 1)))
                .Distinct()
                .OrderByDescending(d => d)
                .Take(24) // Limit to last 2 years
                .ToList();

            foreach(var date in allDates)
            {
                var sales = salesData.FirstOrDefault(x => x.Year == date.Year && x.Month == date.Month)?.Total ?? 0;
                var usage = usageGrouped.FirstOrDefault(x => x.Year == date.Year && x.Month == date.Month);
                
                _analysisMonths.Add(new RevenueAnalysisMonth
                {
                    Date = date,
                    TotalBarSales = sales,
                    BottlesUsed = usage?.TotalBottles ?? 0,
                    TopBrands = usage?.Brands ?? new List<(string, int)>()
                });
            }
        }
        catch(Exception ex)
        {
            Console.WriteLine($"Error loading analysis: {ex.Message}");
            _errorDetails = ex.Message;
        }
        finally
        {
            _isLoadingAnalysis = false;
            _dataLock.Release();
            StateHasChanged();
        }
    }
