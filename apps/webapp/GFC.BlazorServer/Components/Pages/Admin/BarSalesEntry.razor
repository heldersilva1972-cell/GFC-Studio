@page "/admin/bar-sales"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using GFC.BlazorServer.Data
@using GFC.Core.Models
@inject IDbContextFactory<GfcDbContext> DbFactory
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject GFC.BlazorServer.Services.BarSalesStateContainer StateCache
@attribute [Authorize]

<PageTitle>Bar Sales Entry | GFC Admin</PageTitle>

<style>
    /* Hide number input spinners */
    input[type="number"]::-webkit-inner-spin-button,
    input[type="number"]::-webkit-outer-spin-button {
        -webkit-appearance: none;
        margin: 0;
    }
    input[type="number"] {
        -moz-appearance: textfield;
    }

    .bar-sales-page {
        min-height: 100vh;
        background: radial-gradient(circle at top right, #f8fafc, #ebf8ff);
        padding-bottom: 5rem;
    }

    .bar-sales-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 2rem;
    }

    .hero-section {
        background: linear-gradient(135deg, #1A365D 0%, #2B6CB0 100%);
        border-radius: 20px;
        padding: 1.5rem 2rem;
        color: white;
        margin-bottom: 2rem;
        position: relative;
        overflow: hidden;
        box-shadow: 0 10px 25px rgba(26, 54, 93, 0.15);
        z-index: 1;
    }

    .nav-btn-group {
        display: flex;
        justify-content: center;
        gap: 0.75rem;
        margin-bottom: 2.5rem;
        flex-wrap: wrap;
    }

    .nav-tab-btn {
        background: white;
        border: 2px solid transparent;
        border-radius: 14px;
        padding: 0.75rem 1.5rem;
        font-weight: 700;
        color: #64748b;
        transition: all 0.2s ease;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .nav-tab-btn:hover {
        background: #f8fafc;
        color: #1a365d;
        transform: translateY(-2px);
    }

    .nav-tab-btn.active {
        background: #fff;
        color: #2b6cb0;
        border-color: #2b6cb0;
        box-shadow: 0 10px 15px -3px rgba(43, 108, 176, 0.15);
    }

    .main-form-card {
        background: white;
        border: 1px solid #e2e8f0;
        border-radius: 24px;
        padding: 2.5rem;
        box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.05);
        margin-bottom: 2rem;
    }

    .analytics-card {
        background: white;
        border-radius: 24px;
        padding: 2rem;
        box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.05);
        margin-bottom: 2rem;
        border: 1px solid #e2e8f0;
    }

    .chart-controls-panel {
        background: #f8fafc;
        padding: 1.5rem;
        border-radius: 16px;
        border: 1px solid #e2e8f0;
    }

    .chart-select {
        border: 2px solid #e2e8f0;
        border-radius: 12px;
        padding: 0.75rem 1rem;
        font-weight: 600;
        font-size: 0.95rem;
        transition: all 0.2s ease;
    }

    .chart-select:focus {
        border-color: #3b82f6;
        box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
        outline: none;
    }

    .form-label-premium {
        font-size: 0.9rem;
        font-weight: 700;
        text-transform: uppercase;
        color: #64748b;
        margin-bottom: 0.75rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .input-premium {
        background: #f8fafc;
        border: 2px solid #f1f5f9;
        border-radius: 16px;
        padding: 1rem 1.25rem;
        font-size: 1.1rem;
        font-weight: 500;
        transition: all 0.2s ease;
    }

    .entry-row {
        background: white;
        border-radius: 20px;
        padding: 1.5rem;
        margin-bottom: 1rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        border: 1px solid #f1f5f9;
    }
</style>

<div class="bar-sales-page">
    <div class="bar-sales-container">
        <div class="hero-section text-center">
            <div>
                <h2 class="fw-bold mb-1">Bar Revenue Analytics</h2>
                <p class="opacity-75 small mb-0">Financial tracking and inventory movement</p>
            </div>
        </div>

        <div class="nav-btn-group">
            <button class="nav-tab-btn @(_activeView == "performance" ? "active" : "")" @onclick='() => _activeView = "performance"'>
                <i class="bi bi-speedometer2"></i> Financial Performance
            </button>
            <button class="nav-tab-btn @(_activeView == "graph" ? "active" : "")" @onclick='() => _activeView = "graph"'>
                <i class="bi bi-graph-up"></i> Sales Graph
            </button>
            <button class="nav-tab-btn @(_activeView == "entry" ? "active" : "")" @onclick='() => SwitchToEntry()'>
                <i class="bi bi-plus-circle"></i> New Entry
            </button>
            <button class="nav-tab-btn @(_activeView == "log" ? "active" : "")" @onclick='() => _activeView = "log"'>
                <i class="bi bi-journal-text"></i> Activity Log
            </button>
        </div>

        <!-- Error Alert -->
        @if (!string.IsNullOrEmpty(_errorDetails))
        {
            <div class="alert alert-danger shadow-sm mb-4" role="alert">
                <h4 class="alert-heading"><i class="bi bi-exclamation-triangle-fill me-2"></i>Error Loading Page</h4>
                <p>@_errorDetails</p>
                <hr>
                <p class="mb-0 small">Please check the database columns "Shift" and "AdjustedSaleDate" exist.</p>
            </div>
        }

        @if (_activeView == "performance")
        {
            <div class="analytics-card animate-entrance">
                <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
                    <div>
                        <h3 class="fw-bold mb-1">Financial Summary</h3>
                        <p class="text-muted small mb-0">Overview of club bar revenue</p>
                    </div>
                    
                    <div class="d-flex gap-4 align-items-center bg-light rounded-4 px-4 py-2 border">
                        <div>
                            <div class="small fw-bold text-muted text-uppercase" style="font-size: 0.7rem;">Lifetime Revenue</div>
                            <div class="h3 fw-bold text-success mb-0">@_grandTotalRevenue.ToString("C")</div>
                        </div>
                        <div class="vr opacity-25"></div>
                        <div>
                            <div class="small fw-bold text-muted text-uppercase" style="font-size: 0.7rem;">Items Sold</div>
                            <div class="h3 fw-bold text-dark mb-0">@_grandTotalItemsSold.ToString("N0")</div>
                        </div>
                    </div>
                </div>
            </div>
        }

        @if (_activeView == "graph")
        {
            <div class="analytics-card animate-entrance">
                <div class="mb-4">
                    <div class="d-flex justify-content-between align-items-end mb-4">
                        <div>
                            <h3 class="fw-bold mb-1">Sales Trends</h3>
                            <p class="text-muted small mb-0">Visual analysis of revenue over time</p>
                        </div>
                    </div>

                <!-- Advanced Controls -->
                <div class="chart-controls-panel">
                    <div class="row g-3">
                        <!-- Row 1: Main Filters -->
                        <div class="col-md-3">
                            <label class="small fw-bold text-muted mb-2">TIME PERIOD</label>
                            <select class="form-select chart-select" @bind="_selectedPeriod" @bind:after="UpdateChart">
                                <option value="year">Full Year Comparison</option>
                                <option value="week">Last 7 Days</option>
                                <option value="month">Last 30 Days</option>
                                <option value="thisMonth">This Month</option>
                                <option value="lastMonth">Last Month</option>
                                <option value="custom">Custom Range</option>
                            </select>
                        </div>
                        
                        <div class="col-md-3">
                            <label class="small fw-bold text-muted mb-2">GROUP BY</label>
                            <select class="form-select chart-select" @bind="_groupBy" @bind:after="UpdateChart">
                                <option value="day">Daily</option>
                                <option value="week">Weekly</option>
                                <option value="month">Monthly</option>
                            </select>
                        </div>

                        <div class="col-md-3">
                            <label class="small fw-bold text-muted mb-2">FILTER DAYS</label>
                            <select class="form-select chart-select" @bind="_chartDayFilter" @bind:after="UpdateChart">
                                <option value="">All Days</option>
                                <option value="Sunday">Sundays</option>
                                <option value="Monday">Mondays</option>
                                <option value="Tuesday">Tuesdays</option>
                                <option value="Wednesday">Wednesdays</option>
                                <option value="Thursday">Thursdays</option>
                                <option value="Friday">Fridays</option>
                                <option value="Saturday">Saturdays</option>
                            </select>
                        </div>
                        
                        <div class="col-md-3">
                            <label class="small fw-bold text-muted mb-2">FILTER SHIFT</label>
                            <select class="form-select chart-select" @bind="_chartShiftFilter" @bind:after="UpdateChart">
                                <option value="">All Shifts</option>
                                <option value="Day">Day Shift</option>
                                <option value="Night">Night Shift</option>
                            </select>
                        </div>

                        @if (_selectedPeriod == "custom")
                        {
                            <div class="col-md-3">
                                <label class="small fw-bold text-muted mb-2">START DATE</label>
                                <input type="date" class="form-control chart-select" @bind="_customStartDate" @bind:after="UpdateChart" />
                            </div>
                            <div class="col-md-3">
                                <label class="small fw-bold text-muted mb-2">END DATE</label>
                                <input type="date" class="form-control chart-select" @bind="_customEndDate" @bind:after="UpdateChart" />
                            </div>
                        }
                    </div>

                    <!-- Row 2: Year Selection (Visible for Full Year View) -->
                    @if (_selectedPeriod == "year")
                    {
                        <div class="mt-3 pt-3 border-top">
                            <label class="small fw-bold text-muted mb-2 d-block">COMPARE YEARS</label>
                            <div class="d-flex flex-wrap gap-3">
                                @foreach (var year in _availableYears)
                                {
                                    <label class="year-checkbox-label">
                                        <input type="checkbox" checked="@(_selectedComparisonYears.Contains(year))" 
                                               @onchange="@(e => ToggleYearComparison(year, (bool)e.Value))" />
                                        <span>@year</span>
                                    </label>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
            </div>
            <div class="chart-container mt-4">
                <canvas id="barSalesChart"></canvas>
            </div>
        }

        @if (!string.IsNullOrEmpty(_successMessage))
        {
            <div class="alert alert-success alert-dismissible fade show mb-4 border-0 shadow-sm rounded-4" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i> @_successMessage
                <button type="button" class="btn-close" @onclick="() => _successMessage = null"></button>
            </div>
        }

        @if (_activeView == "entry")
        {
            <div class="main-form-card animate-entrance">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h3 class="fw-bold mb-0">@(_isEditing ? "Edit Entry" : "New Sales Entry")</h3>
                    @if (_isEditing)
                    {
                        <button class="btn btn-sm btn-outline-danger rounded-pill" @onclick="SwitchToEntry">
                            <i class="bi bi-x-circle me-1"></i> Cancel Edit
                        </button>
                    }
                </div>
                
                <EditForm Model="@_model" OnValidSubmit="HandleSubmit">
                    <DataAnnotationsValidator />
                    
                    <div class="row g-4">
                        <div class="col-md-3">
                            <label class="form-label-premium">Month</label>
                            <select class="form-control input-premium w-100" @bind="_selectedMonth">
                                @for (int i = 1; i <= 12; i++)
                                {
                                    <option value="@i">@(new DateTime(2000, i, 1).ToString("MMMM"))</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label-premium">Day</label>
                            <select class="form-control input-premium w-100" @bind="_selectedDay">
                                @for (int i = 1; i <= DateTime.DaysInMonth(_selectedEntryYear, _selectedMonth); i++)
                                {
                                    <option value="@i">@i</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label-premium">Year</label>
                            <select class="form-control input-premium w-100" @bind="_selectedEntryYear">
                                @for (int i = DateTime.Now.Year; i >= DateTime.Now.Year - 5; i--)
                                {
                                    <option value="@i">@i</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label-premium">Hour</label>
                            <select class="form-control input-premium w-100" @bind="_selectedHour">
                                @for (int i = 0; i <= 23; i++)
                                {
                                    <option value="@i">@i.ToString("D2")</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label-premium">Minute</label>
                            <select class="form-control input-premium w-100" @bind="_selectedMinute">
                                @for (int i = 0; i <= 59; i++)
                                {
                                    <option value="@i">@i.ToString("D2")</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label-premium text-success">Gross Revenue</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-0" style="border-radius: 16px 0 0 16px;">$</span>
                                <InputNumber class="form-control input-premium" style="border-radius: 0 16px 16px 0;" @bind-Value="_model.TotalSales" onfocus="this.select()" />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label-premium text-warning">Items Sold</label>
                            <InputNumber class="form-control input-premium w-100" @bind-Value="_model.TotalItemsSold" onfocus="this.select()" />
                        </div>
                        <div class="col-md-12">
                            <label class="form-label-premium text-info">Notes</label>
                            <InputText class="form-control input-premium w-100" @bind-Value="_model.Notes" placeholder="Context (e.g. Member Event)..." />
                        </div>
                        <div class="col-md-12">
                            <label class="form-label-premium">Shift Type</label>
                            <div class="d-flex gap-4 p-3 rounded-3" style="background: #f8fafc; border: 2px solid #f1f5f9;">
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="shiftType" id="shiftDay" value="Day" 
                                        checked="@(_model.Shift == "Day")" 
                                        @onchange="@(() => _model.Shift = "Day")">
                                    <label class="form-check-label fw-bold" for="shiftDay">
                                        <i class="bi bi-sun-fill text-warning me-2"></i>Day Shift
                                    </label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="shiftType" id="shiftNight" value="Night" 
                                        checked="@(_model.Shift == "Night")" 
                                        @onchange="@(() => _model.Shift = "Night")">
                                    <label class="form-check-label fw-bold" for="shiftNight">
                                        <i class="bi bi-moon-stars-fill text-info me-2"></i>Night Shift
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="mt-5 text-end d-flex justify-content-end gap-2">
                        <button type="submit" class="btn btn-lg px-5 save-btn @GetButtonClass()" disabled="@_isSaving">
                            <span class="shockwave"></span>
                            @if (_isSaving)
                            {
                                <i class="bi bi-arrow-repeat me-2"></i>
                                <span>Processing...</span>
                            }
                            else if (_showSuccess)
                            {
                                <i class="bi bi-check-all me-2"></i>
                                <span>@(_isEditing ? "Updated!" : "Recorded!")</span>
                            }
                            else
                            {
                                <i class="bi bi-plus-circle-fill me-2"></i>
                                <span>@(_isEditing ? "Update Entry" : "Commit Entry")</span>
                            }
                        </button>
                    </div>
                </EditForm>
            </div>
        }

        @if (_activeView == "log")
        {
            @if (!string.IsNullOrEmpty(_successMessage))
            {
                <div class="alert alert-success alert-dismissible fade show mb-4 border-0 shadow-sm rounded-4" role="alert">
                    <i class="bi bi-check-circle-fill me-2"></i> @_successMessage
                    <button type="button" class="btn-close" @onclick="() => _successMessage = null"></button>
                </div>
            }

            <div class="col-12 animate-entrance">
                <div class="bg-white rounded-5 border shadow-sm h-100 overflow-hidden d-flex flex-column">
                    <div class="p-4 border-bottom bg-light bg-opacity-50">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <div>
                                <h4 class="fw-bold mb-1">Activity Log</h4>
                                <div class="text-muted small">Recent transactions</div>
                            </div>
                            <button class="btn btn-sm btn-light border rounded-pill px-3" @onclick="() => LoadData()">
                                <i class="bi bi-arrow-clockwise me-1"></i> Sync
                            </button>
                        </div>
                        
                        <!-- Day Filter -->
                        <select class="form-select form-select-sm border-0 bg-white shadow-sm rounded-pill" 
                                @bind="_selectedDayFilter" @bind:after="() => LoadData()">
                            <option value="">All Days</option>
                            <option value="Sunday">Sundays</option>
                            <option value="Monday">Mondays</option>
                            <option value="Tuesday">Tuesdays</option>
                            <option value="Wednesday">Wednesdays</option>
                            <option value="Thursday">Thursdays</option>
                            <option value="Friday">Fridays</option>
                            <option value="Saturday">Saturdays</option>
                        </select>
                    </div>
                    
                    <div class="flex-grow-1 overflow-auto">
                        @if (_entries == null)
                        {
                            <div class="text-center py-5">
                                <div class="spinner-border text-primary" role="status"></div>
                            </div>
                        }
                        else if (!_entries.Any())
                        {
                            <div class="text-center py-5">
                                <i class="bi bi-journal-x fs-1 text-muted opacity-50"></i>
                                <p class="mt-3 text-muted">No sales recordings yet.</p>
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="bg-light sticky-top">
                                        <tr>
                                            <th class="ps-4 py-3 text-uppercase text-muted small fw-bold border-0">Date</th>
                                            <th class="py-3 text-uppercase text-muted small fw-bold border-0">Details</th>
                                            <th class="pe-4 py-3 text-end text-uppercase text-muted small fw-bold border-0">Revenue</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var entry in _entries)
                                        {
                                            <tr>
                                                <td class="ps-4 border-bottom-0">
                                                    <div class="d-flex align-items-center gap-2">
                                                        <button class="btn btn-sm btn-link p-0 text-dark hover-primary" 
                                                                style="text-decoration: none;"
                                                                @onclick="() => AdjustDate(entry, -1)"
                                                                title="Move back 1 day"
                                                                disabled="@(_updatingEntryId == entry.Id)">
                                                            <i class="bi bi-chevron-left"></i>
                                                        </button>
                                                        <div class="text-center" style="min-width: 90px;">
                                                            <div class="fw-bold text-dark">@GetEffectiveDate(entry).ToString("ddd, MMM dd, yyyy")</div>
                                                            <div class="small text-secondary fw-semibold">@GetEffectiveDate(entry).ToString("hh:mm tt")</div>
                                                            @if (entry.AdjustedSaleDate.HasValue)
                                                            {
                                                                <div class="badge bg-white text-danger border border-danger mt-1 shadow-sm" style="font-size: 0.65rem;" title="Original: @entry.SaleDate.ToString("MMM dd")">
                                                                    Adj from @entry.SaleDate.ToString("MMM dd")
                                                                </div>
                                                            }
                                                        </div>
                                                        <button class="btn btn-sm btn-link p-0 text-dark hover-primary" 
                                                                style="text-decoration: none;"
                                                                @onclick="() => AdjustDate(entry, 1)" 
                                                                title="Move forward 1 day"
                                                                disabled="@(_updatingEntryId == entry.Id)">
                                                            <i class="bi bi-chevron-right"></i>
                                                        </button>
                                                    </div>
                                                </td>
                                                <td class="border-bottom-0">
                                                    <div class="text-dark">
                                                        @(string.IsNullOrEmpty(entry.Notes) ? "Standard Sale" : entry.Notes)
                                                        <button class="btn btn-sm badge rounded-pill bg-light text-dark border ms-2" 
                                                                style="font-weight: 500; cursor: pointer; transition: all 0.2s ease;"
                                                                @onclick="() => ToggleShift(entry)"
                                                                title="Click to switch shift (Day/Night)"
                                                                disabled="@(_updatingEntryId == entry.Id)">
                                                            @if (_updatingEntryId == entry.Id)
                                                            {
                                                                <span class="spinner-border spinner-border-sm me-1 text-primary" role="status" aria-hidden="true" style="width: 0.7em; height: 0.7em;"></span>
                                                            }
                                                            else
                                                            {
                                                                <i class="bi @(entry.Shift == "Night" ? "bi-moon-stars-fill text-info" : "bi-sun-fill text-warning") me-1"></i>
                                                            }
                                                            @entry.Shift
                                                        </button>
                                                    </div>
                                                    <div class="small text-muted">@entry.TotalItemsSold items</div>
                                                </td>
                                                <td class="pe-4 text-end border-bottom-0">
                                                    <div class="d-flex align-items-center justify-content-end gap-3">
                                                        <span class="fw-bold text-success bg-success bg-opacity-10 px-2 py-1 rounded">
                                                            @entry.TotalSales.ToString("C")
                                                        </span>
                                                        <button class="btn btn-sm btn-outline-primary rounded-circle" 
                                                                style="width: 32px; height: 32px; padding: 0;"
                                                                @onclick="() => EditEntry(entry)"
                                                                title="Edit Entry">
                                                            <i class="bi bi-pencil"></i>
                                                        </button>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>

                    <!-- Pagination -->
                    @if (_totalPages > 1)
                    {
                        <div class="p-3 border-top bg-light bg-opacity-50 d-flex justify-content-between align-items-center">
                            <button class="btn btn-sm btn-outline-secondary rounded-pill px-3" 
                                    disabled="@(_currentPage == 1)" 
                                    @onclick="PrevPage">
                                Previous
                            </button>
                            <span class="text-muted small fw-bold">Page @_currentPage of @_totalPages</span>
                            <button class="btn btn-sm btn-outline-secondary rounded-pill px-3" 
                                    disabled="@(_currentPage == _totalPages)" 
                                    @onclick="NextPage">
                                Next
                            </button>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</div>

@code {
    private BarSaleEntry _model = new();
    private List<BarSaleEntry> _entries;
    private string _activeView = "performance";
    private bool _isSaving = false;
    private bool _showSuccess = false;
    private bool _isEditing = false;
    private string _successMessage;
    private string _errorDetails;

    // Pagination & Filters
    private int _currentPage = 1;
    private int _pageSize = 10;
    private int _totalEntries = 0;
    private string _selectedDayFilter = ""; // Empty = All
    private int _totalPages => (int)Math.Ceiling((double)_totalEntries / _pageSize);

    // Persistent date components
    private int _selectedMonth = DateTime.Now.Month;
    private int _selectedDay = DateTime.Now.Day;
    private int _selectedEntryYear = DateTime.Now.Year;
    
    // Time components (24-hour format for entry)
    private int _selectedHour = DateTime.Now.Hour;
    private int _selectedMinute = DateTime.Now.Minute;

    private decimal _grandTotalRevenue = 0;
    private int _grandTotalItemsSold = 0;

    private List<int> _availableYears = new();
    private List<int> _selectedComparisonYears = new();

    // Chart controls
    private string _selectedPeriod = "year";
    private string _groupBy = "month";
    private string _chartDayFilter = ""; // Empty = All Days
    private string _chartShiftFilter = ""; // Empty = All Shifts
    private DateTime _customStartDate = DateTime.Now.AddDays(-30);
    private DateTime _customEndDate = DateTime.Now;

    private bool _isLoadingData = false;
    private bool _isFirstRender = true;

    protected override async Task OnInitializedAsync()
    {
        // 1. INSTANT RESTORE: Load from memory immediately
        if (StateCache.HasData)
        {
            _entries = StateCache.Entries;
            _grandTotalRevenue = StateCache.GrandTotalRevenue;
            _grandTotalItemsSold = StateCache.GrandTotalItemsSold;
            _availableYears = StateCache.AvailableYears;
            _totalEntries = StateCache.TotalEntries;
            
            // Background refresh without blocking UI
            _ = Task.Run(async () => await LoadData(false));
        }
        else
        {
            // First time ever: show skeletons/spinner
            _ = LoadData();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender || (_activeView == "graph" && _isFirstRender))
        {
            if (_activeView == "graph") _isFirstRender = false;
            await UpdateChart();
        }
    }

    private async Task SwitchToEntry()
    {
        _isEditing = false;
        _model = new BarSaleEntry();
        _selectedMonth = DateTime.Now.Month;
        _selectedDay = DateTime.Now.Day;
        _selectedEntryYear = DateTime.Now.Year;
        _selectedHour = DateTime.Now.Hour;
        _selectedMinute = DateTime.Now.Minute;
        _activeView = "entry";
    }

    private void EditEntry(BarSaleEntry entry)
    {
        _isEditing = true;
        _model = new BarSaleEntry
        {
            Id = entry.Id,
            TotalSales = entry.TotalSales,
            TotalItemsSold = entry.TotalItemsSold,
            Notes = entry.Notes,
            Shift = entry.Shift,
            SaleDate = entry.SaleDate,
            AdjustedSaleDate = entry.AdjustedSaleDate,
            CreatedAt = entry.CreatedAt
        };

        var effDate = entry.AdjustedSaleDate ?? entry.SaleDate;
        _selectedMonth = effDate.Month;
        _selectedDay = effDate.Day;
        _selectedEntryYear = effDate.Year;
        _selectedHour = effDate.Hour;
        _selectedMinute = effDate.Minute;

        _activeView = "entry";
    }

    private async Task NextPage()
    {
        if (_currentPage < _totalPages)
        {
            _currentPage++;
            
            // OPTIMISTIC UI: If we have the page in cache, show it INSTANTLY
            if (StateCache.PageCache.TryGetValue(_currentPage, out var cachedPage))
            {
                _entries = cachedPage;
                _ = LoadData(false); // Background refresh
            }
            else
            {
                await LoadData(false);
            }
        }
    }

    private async Task PrevPage()
    {
        if (_currentPage > 1)
        {
            _currentPage--;
            
            if (StateCache.PageCache.TryGetValue(_currentPage, out var cachedPage))
            {
                _entries = cachedPage;
                _ = LoadData(false);
            }
            else
            {
                await LoadData(false);
            }
        }
    }

    private async Task LoadData(bool recalculateStats = true)
    {
        if (_isLoadingData) return;
        
        try
        {
            _isLoadingData = true;
            // Don't set _entries to null if we already have data to show (optimistic/background)
            if (_entries == null) StateHasChanged();

            using var db = await DbFactory.CreateDbContextAsync();
            
            // Base Query - ALWAYS use AsNoTracking for read-only performance
            var query = db.BarSaleEntries.AsNoTracking().AsQueryable();

            if (!string.IsNullOrEmpty(_selectedDayFilter))
            {
                var targetDay = (DayOfWeek)Enum.Parse(typeof(DayOfWeek), _selectedDayFilter);
                // Optimized Day Filter
                query = query.Where(e => (e.AdjustedSaleDate ?? e.SaleDate).DayOfWeek == targetDay);
            }

            // 1. Fetch total count
            _totalEntries = await query.CountAsync();

            // 2. Fetch Lifetime Stats only if requested or missing
            if (recalculateStats || _grandTotalRevenue == 0)
            {
                // Heuristic: If we have cached stats and aren't forcing a refresh, skip the heavy sum
                if (_grandTotalRevenue == 0 || recalculateStats)
                {
                    var stats = await db.BarSaleEntries.AsNoTracking()
                        .GroupBy(x => 1)
                        .Select(g => new { 
                            Revenue = g.Sum(x => (decimal?)x.TotalSales) ?? 0, 
                            Items = g.Sum(x => (int?)x.TotalItemsSold) ?? 0 
                        })
                        .FirstOrDefaultAsync();

                    _grandTotalRevenue = stats?.Revenue ?? 0;
                    _grandTotalItemsSold = stats?.Items ?? 0;
                }
            }

            // 3. Load Page Data
            // PERF CRITICAL: Sorting by SaleDate is INDEXED. ISNULL/COALESCE sorting is NOT.
            // We sort by SaleDate first for speed, then do a minor secondary sort.
            _entries = await query
                .OrderByDescending(e => e.SaleDate)
                .Skip((_currentPage - 1) * _pageSize)
                .Take(_pageSize)
                .ToListAsync();

            // Fetch available years once
            if (!_availableYears.Any())
            {
                // Fast year fetch
                var years = await db.BarSaleEntries.AsNoTracking()
                    .Select(e => e.SaleDate.Year)
                    .Distinct()
                    .ToListAsync();
                
                _availableYears = years.OrderByDescending(y => y).ToList();

                if (!_availableYears.Any()) _availableYears.Add(DateTime.Now.Year);
                if (!_selectedComparisonYears.Any()) _selectedComparisonYears = new List<int>(_availableYears);
            }

            // Update Caches
            StateCache.Entries = _entries;
            StateCache.GrandTotalRevenue = _grandTotalRevenue;
            StateCache.GrandTotalItemsSold = _grandTotalItemsSold;
            StateCache.AvailableYears = _availableYears;
            StateCache.TotalEntries = _totalEntries;
            StateCache.PageCache[_currentPage] = _entries;
            StateCache.LastRefresh = DateTime.Now;
            
            _isLoadingData = false;
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            _isLoadingData = false;
            Console.WriteLine($"Error loading data: {ex}");
            _errorDetails = $"Error loading data: {ex.Message}";
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task ToggleYearComparison(int year, bool isChecked)
    {
        if (isChecked && !_selectedComparisonYears.Contains(year))
        {
            _selectedComparisonYears.Add(year);
        }
        else if (!isChecked && _selectedComparisonYears.Contains(year))
        {
            _selectedComparisonYears.Remove(year);
        }
        
        // Prevent empty selection
        if (!_selectedComparisonYears.Any() && _availableYears.Any())
        {
            _selectedComparisonYears.Add(year); // Keep the last one unchecked
        }

        await UpdateChart();
    }

    private async Task UpdateChart()
    {
        try
        {
            using var db = await DbFactory.CreateDbContextAsync();
            var now = DateTime.Now;
            
            // 1. SELECTIVE DATA FETCHING (Don't load everything!)
            var query = db.BarSaleEntries.AsQueryable();

            // Apply Period and Filter logic at the Database Level
            if (_selectedPeriod != "year")
            {
                DateTime startDate = now, endDate = now;
                if (_selectedPeriod == "week") { startDate = now.AddDays(-6).Date; endDate = now.Date; }
                else if (_selectedPeriod == "month") { startDate = now.AddDays(-29).Date; endDate = now.Date; }
                else if (_selectedPeriod == "thisMonth") { startDate = new DateTime(now.Year, now.Month, 1); endDate = now.Date; }
                else if (_selectedPeriod == "lastMonth") { 
                    var last = now.AddMonths(-1); 
                    startDate = new DateTime(last.Year, last.Month, 1); 
                    endDate = new DateTime(last.Year, last.Month, DateTime.DaysInMonth(last.Year, last.Month)); 
                }
                else if (_selectedPeriod == "custom") { startDate = _customStartDate.Date; endDate = _customEndDate.Date; }

                query = query.Where(e => (e.AdjustedSaleDate ?? e.SaleDate).Date >= startDate && (e.AdjustedSaleDate ?? e.SaleDate).Date <= endDate);
            }
            else if (_selectedComparisonYears.Any())
            {
                var minYear = _selectedComparisonYears.Min();
                var maxYear = _selectedComparisonYears.Max();
                query = query.Where(e => (e.AdjustedSaleDate ?? e.SaleDate).Year >= minYear && (e.AdjustedSaleDate ?? e.SaleDate).Year <= maxYear);
            }

            if (!string.IsNullOrEmpty(_chartDayFilter))
            {
                var targetDay = (DayOfWeek)Enum.Parse(typeof(DayOfWeek), _chartDayFilter);
                query = query.Where(e => (e.AdjustedSaleDate ?? e.SaleDate).DayOfWeek == targetDay);
            }

            if (!string.IsNullOrEmpty(_chartShiftFilter))
            {
                 query = query.Where(e => e.Shift == _chartShiftFilter);
            }

            // Fetch only what's needed for the current chart view
            // (Removed redundant ToListAsync that was fetching the entire table)
            
            List<string> labels = new();
            var datasets = new List<object>();

            // LOGIC A: Full Year Comparison View
            if (_selectedPeriod == "year")
            {
                // Optimization: Group by Month in SQL for ALL selected years at once
                var yearData = await query
                    .GroupBy(e => new { 
                        Year = (e.AdjustedSaleDate ?? e.SaleDate).Year, 
                        Month = (e.AdjustedSaleDate ?? e.SaleDate).Month 
                    })
                    .Select(g => new { g.Key.Year, g.Key.Month, Total = g.Sum(x => x.TotalSales) })
                    .ToListAsync();

                // Setup Month Labels
                for (int i = 1; i <= 12; i++)
                {
                    labels.Add(new DateTime(2000, i, 1).ToString("MMM"));
                }

                // Create a dataset for EACH selected year from the aggregated data
                foreach (var year in _selectedComparisonYears.OrderByDescending(y => y))
                {
                    var yearValues = new List<decimal>();
                    for (int month = 1; month <= 12; month++)
                    {
                        var total = yearData
                            .Where(d => d.Year == year && d.Month == month)
                            .Sum(d => d.Total);
                        yearValues.Add(total);
                    }
                    datasets.Add(new { label = year.ToString(), data = yearValues });
                }
            }
            // LOGIC B: Standard Time Periods
            else
            {
                // Optimization: Only fetch the 2 columns we need for standard period views
                var periodData = await query
                    .Select(e => new { 
                        Date = (e.AdjustedSaleDate ?? e.SaleDate).Date,
                        TotalSales = e.TotalSales
                    })
                    .ToListAsync();

                // Define Date Range for filtering in-memory
                DateTime startDate = now, endDate = now;
                if (_selectedPeriod == "week") { startDate = now.AddDays(-6).Date; endDate = now.Date; }
                else if (_selectedPeriod == "month") { startDate = now.AddDays(-29).Date; endDate = now.Date; }
                else if (_selectedPeriod == "thisMonth") { startDate = new DateTime(now.Year, now.Month, 1); endDate = now.Date; }
                else if (_selectedPeriod == "lastMonth") { 
                    var last = now.AddMonths(-1); 
                    startDate = new DateTime(last.Year, last.Month, 1); 
                    endDate = new DateTime(last.Year, last.Month, DateTime.DaysInMonth(last.Year, last.Month)); 
                }
                else if (_selectedPeriod == "custom") { startDate = _customStartDate.Date; endDate = _customEndDate.Date; }

                var periodValues = new List<decimal>();

                if (_groupBy == "day")
                {
                    var days = (endDate - startDate).Days;
                    for (int i = 0; i <= days; i++)
                    {
                        var d = startDate.AddDays(i);
                        labels.Add(d.ToString("MMM d"));
                        periodValues.Add(periodData.Where(e => e.Date == d).Sum(e => e.TotalSales));
                    }
                }
                else if (_groupBy == "week")
                {
                     var current = startDate;
                     while(current <= endDate) {
                         var next = current.AddDays(6);
                         if(next > endDate) next = endDate;
                         labels.Add($"{current:MMM d}-{next:dd}");
                         periodValues.Add(periodData.Where(e => e.Date >= current && e.Date <= next).Sum(e => e.TotalSales));
                         current = next.AddDays(1);
                     }
                }
                else if (_groupBy == "month")
                {
                    var current = new DateTime(startDate.Year, startDate.Month, 1);
                    var endMonth = new DateTime(endDate.Year, endDate.Month, 1);
                    while(current <= endMonth)
                    {
                         labels.Add(current.ToString("MMM yyyy"));
                         periodValues.Add(periodData.Where(e => e.Date.Year == current.Year && e.Date.Month == current.Month).Sum(e => e.TotalSales));
                         current = current.AddMonths(1);
                    }
                }

                datasets.Add(new { label = "Revenue", data = periodValues });
            }
            
            await JS.InvokeVoidAsync("barSalesCharts.renderChart", "barSalesChart", new { labels, datasets });
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("console.error", "UpdateChart Error:", ex.Message);
        }
    }

    private async Task HandleSubmit()
    {
        _isSaving = true;
        _showSuccess = false;
        StateHasChanged();

        try
        {
            // Validate and adjust day if needed (e.g., if month changed to one with fewer days)
            int maxDays = DateTime.DaysInMonth(_selectedEntryYear, _selectedMonth);
            if (_selectedDay > maxDays)
            {
                _selectedDay = maxDays;
            }

            _model.SaleDate = new DateTime(
                _selectedEntryYear, 
                _selectedMonth, 
                _selectedDay, 
                _selectedHour,
                _selectedMinute, 
                0);

            using var db = await DbFactory.CreateDbContextAsync();
            
            if (_isEditing)
            {
                db.BarSaleEntries.Update(_model);
            }
            else
            {
                _model.CreatedAt = DateTime.UtcNow;
                db.BarSaleEntries.Add(_model);
            }
            await db.SaveChangesAsync();

            _isSaving = false;
            _showSuccess = true;
            _successMessage = $"Recorded: {_model.TotalSales:C} at {_model.SaleDate:hh:mm tt}";
            
            // Reset form but keep month, day, and year selections
            _model = new BarSaleEntry();
            _selectedHour = DateTime.Now.Hour;
            _selectedMinute = DateTime.Now.Minute;
            
            // IMPORTANT: Update UI state IMMEDIATELY so "Processing..." disappears
            StateHasChanged();
            
            // Now do the heavier background work to refresh the view
            await LoadData();
            await UpdateChart();
            StateHasChanged();

            await Task.Delay(1500); // Short delay for "Recorded!" feedback
            _showSuccess = false;
            // _showEntryForm = false; // Kept open per user request
            StateHasChanged();
        }
        catch (Exception ex)
        {
            _isSaving = false;
            StateHasChanged();
        }
    }

    private string GetButtonClass()
    {
        if (_isSaving) return "is-saving btn-success";
        if (_showSuccess) return "is-success btn-success";
        return "btn-primary";
    }

    private int? _updatingEntryId;

    private async Task AdjustDate(BarSaleEntry entry, int days)
    {
        if (_updatingEntryId.HasValue) return;

        _updatingEntryId = entry.Id;
        StateHasChanged();

        try
        {
            using var db = await DbFactory.CreateDbContextAsync();
            var dbEntry = await db.BarSaleEntries.FindAsync(entry.Id);
            
            if (dbEntry != null)
            {
                // Logic: 
                // 1. Determine current effective date FROM LOCAL ENTRY to match UI state
                var currentEffective = entry.AdjustedSaleDate ?? entry.SaleDate;
                
                // 2. Calculate new effective date
                var newEffective = currentEffective.AddDays(days);
                
                // 3. Set AdjustedSaleDate (or clear if back to original)
                // Use robust comparison (1 minute tolerance) against LOCAL SaleDate
                if ((newEffective - entry.SaleDate).Duration().TotalMinutes < 1.0)
                {
                    dbEntry.AdjustedSaleDate = null;
                    entry.AdjustedSaleDate = null;
                }
                else
                {
                    dbEntry.AdjustedSaleDate = newEffective;
                    entry.AdjustedSaleDate = newEffective;
                }
                
                // Refresh charts
                await UpdateChart();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error adjusting date: {ex.Message}");
        }
        finally
        {
            _updatingEntryId = null;
            StateHasChanged();
        }
    }

    private DateTime GetEffectiveDate(BarSaleEntry entry)
    {
        return entry.AdjustedSaleDate ?? entry.SaleDate;
    }

    private async Task ToggleShift(BarSaleEntry entry)
    {
        if (_updatingEntryId.HasValue) return;

        _updatingEntryId = entry.Id;
        StateHasChanged();

        try
        {
            var newShift = entry.Shift == "Day" ? "Night" : "Day";
            
            using var db = await DbFactory.CreateDbContextAsync();
            var dbEntry = await db.BarSaleEntries.FindAsync(entry.Id);
            
            if (dbEntry != null)
            {
                dbEntry.Shift = newShift;
                await db.SaveChangesAsync();

                // Update local model
                entry.Shift = newShift;
                
                // Refresh charts
                await UpdateChart();
                
                // Optional: Show brief success feedback?
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error toggling shift: {ex.Message}");
        }
        finally
        {
            _updatingEntryId = null;
            StateHasChanged();
        }
    }
