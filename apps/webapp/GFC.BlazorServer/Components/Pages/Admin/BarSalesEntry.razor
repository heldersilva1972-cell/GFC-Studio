    private int? _updatingEntryId;

    private async Task AdjustDate(BarSaleEntry entry, int days)
    {
        if (_updatingEntryId.HasValue) return;

        await _dataLock.WaitAsync();
        _updatingEntryId = entry.Id;
        StateHasChanged();

        try
        {
            using var db = await DbFactory.CreateDbContextAsync();
            var dbEntry = await db.BarSaleEntries.FindAsync(entry.Id);
            
            if (dbEntry != null)
            {
                var currentEffective = entry.AdjustedSaleDate ?? entry.SaleDate;
                var newEffective = currentEffective.AddDays(days);
                
                if ((newEffective - entry.SaleDate).Duration().TotalMinutes < 1.0)
                {
                    dbEntry.AdjustedSaleDate = null;
                    entry.AdjustedSaleDate = null;
                }
                else
                {
                    dbEntry.AdjustedSaleDate = newEffective;
                    entry.AdjustedSaleDate = newEffective;
                }
                
                await db.SaveChangesAsync();
                await UpdateChartInternal();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error adjusting date: {ex.Message}");
        }
        finally
        {
            _updatingEntryId = null;
            _dataLock.Release();
            StateHasChanged();
        }
    }

    private DateTime GetEffectiveDate(BarSaleEntry entry)
    {
        return entry.AdjustedSaleDate ?? entry.SaleDate;
    }

    private async Task ToggleShift(BarSaleEntry entry)
    {
        if (_updatingEntryId.HasValue) return;

        await _dataLock.WaitAsync();
        _updatingEntryId = entry.Id;
        StateHasChanged();

        try
        {
            var newShift = entry.Shift == "Day" ? "Night" : "Day";
            
            using var db = await DbFactory.CreateDbContextAsync();
            var dbEntry = await db.BarSaleEntries.FindAsync(entry.Id);
            
            if (dbEntry != null)
            {
                dbEntry.Shift = newShift;
                await db.SaveChangesAsync();
                entry.Shift = newShift;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error toggling shift: {ex.Message}");
        }
        finally
        {
            _updatingEntryId = null;
            _dataLock.Release();
            StateHasChanged();
        }
    }
    private async Task ToggleVerify(BarSaleEntry entry)
    {
        if (_updatingEntryId.HasValue) return;

        await _dataLock.WaitAsync();
        _updatingEntryId = entry.Id;
        StateHasChanged();

        try 
        {
            using var db = await DbFactory.CreateDbContextAsync();
            var dbEntry = await db.BarSaleEntries.FindAsync(entry.Id);
            if(dbEntry != null)
            {
                dbEntry.IsAudited = !dbEntry.IsAudited;
                entry.IsAudited = dbEntry.IsAudited;
                await db.SaveChangesAsync();
            }
        }
        catch(Exception ex)
        {
             Console.WriteLine($"Error verifying entry: {ex.Message}");
        }
        finally
        {
            _updatingEntryId = null;
            _dataLock.Release();
            StateHasChanged();
        }
    }

    private bool IsLikelyMisdated(BarSaleEntry entry)
    {
        // Warn if:
        // 1. It's marked as NIGHT shift
        // 2. The recorded hour is between midnight and 5am
        // 3. BUT the effective date is the SAME as the recording date (meaning it hasn't been shifted back)
        if (entry.Shift == "Night" && 
            entry.SaleDate.Hour < 5 && 
            (!entry.AdjustedSaleDate.HasValue || entry.AdjustedSaleDate.Value.Date == entry.SaleDate.Date))
        {
            return true;
        }
        return false;
    }

