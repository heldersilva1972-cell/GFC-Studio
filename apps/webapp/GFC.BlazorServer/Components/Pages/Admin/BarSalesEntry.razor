    private async Task LoadData(bool recalculateStats = true, bool force = false)
    {
        if (_isLoadingData && !force) return;
        _isLoadingData = true;
        
        await _dataLock.WaitAsync();
        try
        {
            _errorDetails = null; // Clear previous errors
            await LoadDataInternal(recalculateStats);
        }
        catch (Exception ex)
        {
            _errorDetails = $"Data Load Error: {ex.Message}";
            Logger.LogError(ex, "Failed to load bar sales data");
        }
        finally
        {
            _isLoadingData = false;
            _dataLock.Release();
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task LoadDataInternal(bool recalculateStats = true)
    {
        StateHasChanged(); 
        using var db = await DbFactory.CreateDbContextAsync();
        
        // Base Query - ALWAYS use AsNoTracking for read-only performance
        var query = db.BarSaleEntries.AsNoTracking().AsQueryable();

        // Base Query - Apply SQL-translatable filters first
        if (!string.IsNullOrEmpty(_jumpShiftFilter))
        {
            query = query.Where(e => e.Shift == _jumpShiftFilter);
        }

        if (_selectedPeriod == "custom")
        {
            var start = _customStartDate.Date;
            var end = _customEndDate.Date.AddDays(1);
            
            query = query.Where(e => 
                (e.AdjustedSaleDate != null && e.AdjustedSaleDate >= start && e.AdjustedSaleDate < end) || 
                (e.AdjustedSaleDate == null && e.SaleDate >= start && e.SaleDate < end));
        }

        // FETCH DATA: Execute SQL now to bring data into memory
        // This is necessary because EF Core cannot translate complex date math (DayOfWeek) reliably on all providers
        var dbData = await query.ToListAsync();

        // IN-MEMORY FILTERING
        var filteredData = dbData.AsEnumerable();

        if (!string.IsNullOrEmpty(_selectedDayFilter) && Enum.TryParse<DayOfWeek>(_selectedDayFilter, out var targetDay))
        {
            filteredData = filteredData.Where(e => (e.AdjustedSaleDate ?? e.SaleDate).DayOfWeek == targetDay);
        }

        var finalList = filteredData.ToList();
        _totalEntries = finalList.Count;

        if (recalculateStats || _grandTotalRevenue == 0)
        {
             // For stats, we usually want the total of the CURRENT VIEW or ALL TIME?
             // Usually dashboard totals are "All Time", but usage varies. 
             // Existing code calculated grand total on the DATABASE (all time). 
             // If we just fetched all matching rows above, we can just sum them if filters are active.
             // BUT, _grandTotalRevenue usually implies "lifetime".
             // Let's keep lifetime stats calculation separate as a DB call if needed, or just sum what we have if no filters.
             // ACTUALLY, checking previous code: it recalculated based on "db.BarSaleEntries" directly for grand total.
             // We'll leave the stats calculation block below alone as it accesses 'db' directly, 
             // BUT we must ensure we aren't using the filtered query if we want global stats.
             
             if (_grandTotalRevenue == 0 || recalculateStats)
             {
                _grandTotalRevenue = await db.BarSaleEntries.AsNoTracking().SumAsync(x => (decimal?)x.TotalSales) ?? 0;
                _grandTotalItemsSold = await db.BarSaleEntries.AsNoTracking().SumAsync(x => (int?)x.TotalItemsSold) ?? 0;
                
                var annualStats = await db.BarSaleEntries.AsNoTracking()
                    .GroupBy(x => (x.AdjustedSaleDate ?? x.SaleDate).Year)
                    .Select(g => new { Year = g.Key, Total = g.Sum(x => (decimal?)x.TotalSales) ?? 0 })
                    .ToListAsync();
                
                // Lottery Stats
                var lotteryStats = await db.LotteryWeeklyStats.AsNoTracking().ToListAsync();
                
                decimal GetLottoEarnings(LotteryWeeklyStat s) => 
                     Math.Abs(s.OnlineCommission) + Math.Abs(s.InstantCommission) + 
                     Math.Abs(s.OnlineCashBonus) + Math.Abs(s.InstantCashBonus) + 
                     Math.Abs(s.OnlineClaimsBonus) + Math.Abs(s.InstantClaimsBonus);

                _grandTotalLotteryRevenue = lotteryStats.Sum(s => GetLottoEarnings(s));

                _annualLotteryRevenue = lotteryStats
                    .GroupBy(s => s.WeekEndingDate.Year)
                    .ToDictionary(g => g.Key, g => g.Sum(s => GetLottoEarnings(s)));

                _annualRevenue = annualStats.ToDictionary(k => k.Year, v => v.Total);

                StateCache.GrandTotalRevenue = _grandTotalRevenue;
                StateCache.GrandTotalItemsSold = _grandTotalItemsSold;
             }
        }

        // Apply Ordering and Pagination in Memory
        _entries = finalList
            .OrderByDescending(e => e.SaleDate)
            .Skip((_currentPage - 1) * _pageSize)
            .Take(_pageSize)
            .ToList();

        if (!_availableYears.Any())
        {
            var years = finalList.Select(e => e.SaleDate.Year).Distinct().ToList();
             // Consolidate with DB if list is filtered? 
             // Actually, available years should usually be all years.
             // Let's just fallback to the existing logic if list is empty, or query DB unique years.
             // The previous logic queried DB. Let's keep it robust.
             if (!years.Any()) 
             {
                 years = await db.BarSaleEntries.AsNoTracking().Select(e => e.SaleDate.Year).Distinct().ToListAsync();
             }
            
            _availableYears = years.OrderByDescending(y => y).ToList();

            if (!_availableYears.Contains(DateTime.Now.Year))
            {
                _availableYears.Insert(0, DateTime.Now.Year);
            }

            if (!_selectedComparisonYears.Any()) _selectedComparisonYears = new List<int>(_availableYears);
        }

        StateCache.Entries = _entries;
        StateCache.GrandTotalRevenue = _grandTotalRevenue;
        StateCache.GrandTotalItemsSold = _grandTotalItemsSold;
        StateCache.AnnualRevenue = _annualRevenue;
        StateCache.AvailableYears = _availableYears;
        StateCache.TotalEntries = _totalEntries;
        StateCache.PageCache[_currentPage] = _entries;
        StateCache.LastRefresh = DateTime.Now;
    }

    private async Task ToggleYearComparison(int year, bool isChecked)
    {
        if (isChecked && !_selectedComparisonYears.Contains(year))
        {
            _selectedComparisonYears.Add(year);
        }
        else if (!isChecked && _selectedComparisonYears.Contains(year))
        {
            _selectedComparisonYears.Remove(year);
        }
        
        // Prevent empty selection
        if (!_selectedComparisonYears.Any() && _availableYears.Any())
        {
            _selectedComparisonYears.Add(year); // Keep the last one unchecked
        }

        await UpdateChart();
    }

