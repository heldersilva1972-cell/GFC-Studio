    private async Task LoadComplianceData()
    {
        if (_isLoadingCompliance) return;

        await _dataLock.WaitAsync();
        _isLoadingCompliance = true;
        _complianceGrid = new Dictionary<(int, int), (string, string, int, int, bool, bool)>();
        StateHasChanged();

        try 
        {
            if (_complianceSource == "Lottery")
            {
                // LOAD LOTTERY COMPLIANCE
                var startDate = new DateTime(_complianceYear, 1, 1);
                var endDate = new DateTime(_complianceYear, 12, 31);
                
                // Fetch using service
                var allShifts = await Task.Run(() => LotteryService.GetShiftsByDateRange(startDate, endDate));

                foreach(var shift in allShifts)
                {
                    var date = shift.ShiftDate.Date;
                    var day = date.Day;
                    var month = date.Month;
                    
                    var key = (month, day);
                    var current = _complianceGrid.ContainsKey(key) 
                        ? _complianceGrid[key] 
                        : (DayStatus: "Missing", NightStatus: "Missing", DayCount: 0, NightCount: 0, DayAudited: false, NightAudited: false);
                    
                    bool isNight = shift.ShiftType?.Equals("Night", StringComparison.OrdinalIgnoreCase) == true;
                    
                    if (isNight)
                    {
                        current.NightCount++;
                        current.NightStatus = current.NightCount > 0 ? "Entered" : "Missing";
                        if (shift.IsReconciled) current.NightAudited = true;
                    }
                    else
                    {
                        current.DayCount++;
                        current.DayStatus = current.DayCount > 0 ? "Entered" : "Missing";
                        if (shift.IsReconciled) current.DayAudited = true;
                    }

                    _complianceGrid[key] = current;
                }
            }
            else 
            {
                // LOAD BAR COMPLIANCE (Existing Logic)
                using var db = await DbFactory.CreateDbContextAsync();
                
                // SQL RANGE: Optimization for SQL Index usage
                var startOfYear = new DateTime(_complianceYear, 1, 1);
                var endOfYear = new DateTime(_complianceYear, 12, 31);
    
                // Fetch daily counts efficiently
                var complianceData = await db.BarSaleEntries.AsNoTracking()
                    .Where(e => e.SaleDate >= startOfYear && e.SaleDate <= endOfYear)
                    .GroupBy(e => new { 
                        Date = (e.AdjustedSaleDate ?? e.SaleDate).Date, 
                        Shift = e.Shift 
                    })
                    .Select(g => new { 
                        g.Key.Date, 
                        g.Key.Shift, 
                        Count = g.Count(), 
                        HasVerified = g.Any(x => x.IsAudited) 
                    })
                    .ToListAsync();
    
                foreach(var entry in complianceData)
                {
                    var day = entry.Date.Day;
                    var month = entry.Date.Month;
                    
                    // Get or create existing status for this coordinate
                    var key = (month, day);
                    var current = _complianceGrid.ContainsKey(key) ? _complianceGrid[key] : (DayStatus: "Missing", NightStatus: "Missing", DayCount: 0, NightCount: 0, DayAudited: false, NightAudited: false);
    
                    if (entry.Shift == "Day")
                    {
                        current.DayStatus = entry.Count > 0 ? "Entered" : "Missing";
                        current.DayCount = entry.Count;
                        current.DayAudited = entry.HasVerified;
                    }
                    else
                    {
                        current.NightStatus = entry.Count > 0 ? "Entered" : "Missing";
                        current.NightCount = entry.Count;
                        current.NightAudited = entry.HasVerified;
                    }
                    
                    _complianceGrid[key] = current;
                }
            }
        }
        catch(Exception ex)
        {
            Console.WriteLine($"Error loading compliance: {ex.Message}");
        }
        finally
        {
            _isLoadingCompliance = false;
            _dataLock.Release();
            StateHasChanged();
        }
    }

