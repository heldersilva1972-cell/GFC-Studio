@page "/admin/bar-sales"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using GFC.BlazorServer.Data
@using GFC.Core.Models
@using GFC.Core.Interfaces
@inject IDbContextFactory<GfcDbContext> DbFactory
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject GFC.BlazorServer.Services.BarSalesStateContainer StateCache
@inject ILogger<BarSalesEntry> Logger
@inject ILotteryShiftService LotteryService
@attribute [Authorize]

<PageTitle>Bar/Lottery Sales | GFC Admin</PageTitle>

<style>
    /* Hide number input spinners */
    input[type="number"]::-webkit-inner-spin-button,
    input[type="number"]::-webkit-outer-spin-button {
        -webkit-appearance: none;
        margin: 0;
    }
    input[type="number"] {
        -moz-appearance: textfield;
    }

    .bar-sales-page {
        min-height: 100vh;
        background: radial-gradient(circle at top right, #f8fafc, #ebf8ff);
        padding-bottom: 5rem;
    }

    .bar-sales-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 2rem;
    }

    .hero-section {
        background: linear-gradient(135deg, #1A365D 0%, #2B6CB0 100%);
        border-radius: 20px;
        padding: 1.5rem 2rem;
        color: white;
        margin-bottom: 2rem;
        position: relative;
        overflow: hidden;
        box-shadow: 0 10px 25px rgba(26, 54, 93, 0.15);
        z-index: 1;
    }

    .nav-btn-group {
        display: flex;
        justify-content: center;
        gap: 0.75rem;
        margin-bottom: 2.5rem;
        flex-wrap: wrap;
    }

    .nav-tab-btn {
        background: white;
        border: 2px solid transparent;
        border-radius: 14px;
        padding: 0.75rem 1.5rem;
        font-weight: 700;
        color: #64748b;
        transition: all 0.2s ease;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .nav-tab-btn:hover {
        background: #f8fafc;
        color: #1a365d;
        transform: translateY(-2px);
    }

    .nav-tab-btn.active {
        background: #fff;
        color: #2b6cb0;
        border-color: #2b6cb0;
        box-shadow: 0 10px 15px -3px rgba(43, 108, 176, 0.15);
    }

    .main-form-card {
        background: white;
        border: 1px solid #e2e8f0;
        border-radius: 24px;
        padding: 2.5rem;
        box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.05);
        margin-bottom: 2rem;
    }

    .analytics-card {
        background: white;
        border-radius: 24px;
        padding: 2rem;
        box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.05);
        margin-bottom: 2rem;
        border: 1px solid #e2e8f0;
    }

    .chart-controls-panel {
        background: #f8fafc;
        padding: 1.5rem;
        border-radius: 16px;
        border: 1px solid #e2e8f0;
    }

    .chart-select {
        border: 2px solid #e2e8f0;
        border-radius: 12px;
        padding: 0.75rem 1rem;
        font-weight: 600;
        font-size: 0.95rem;
        transition: all 0.2s ease;
    }

    .chart-select:focus {
        border-color: #3b82f6;
        box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
        outline: none;
    }

    .form-label-premium {
        font-size: 0.9rem;
        font-weight: 700;
        text-transform: uppercase;
        color: #64748b;
        margin-bottom: 0.75rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .input-premium {
        background: #f8fafc;
        border: 2px solid #f1f5f9;
        border-radius: 16px;
        padding: 1rem 1.25rem;
        font-size: 1.1rem;
        font-weight: 500;
        transition: all 0.2s ease;
    }

    .entry-row {
        background: white;
        border-radius: 20px;
        padding: 1.5rem;
        margin-bottom: 1rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        border: 1px solid #f1f5f9;
    }
    
    .bg-verified-bright {
        background-color: #00e676 !important; /* Brighter Material Green */
        box-shadow: 0 0 6px rgba(0, 230, 118, 0.6);
    }
</style>

<div class="bar-sales-page">
    <div class="bar-sales-container">
        <div class="hero-section text-center">
            <div>
                <h2 class="fw-bold mb-1">Bar/Lottery Sales</h2>
                <p class="opacity-75 small mb-0">Financial tracking and inventory movement</p>
            </div>
        </div>

        <div class="nav-btn-group">
            <button class="nav-tab-btn @(_activeView == "performance" ? "active" : "")" @onclick='() => _activeView = "performance"'>
                <i class="bi bi-speedometer2"></i> Financial Performance
            </button>
            <button class="nav-tab-btn @(_activeView == "graph" ? "active" : "")" @onclick='() => _activeView = "graph"'>
                <i class="bi bi-graph-up"></i> Sales Graph
            </button>
            <button class="nav-tab-btn @(_activeView == "entry" ? "active" : "")" @onclick="SwitchToEntry">
                <i class="bi bi-plus-circle"></i> Bar Sales Entry
            </button>
            <button class="nav-tab-btn @(_activeView == "lotteryEntry" ? "active" : "")" @onclick="SwitchToLotteryEntry">
                <i class="bi bi-ticket-detailed"></i> Lottery Entry
            </button>
            <button class="nav-tab-btn @(_activeView == "log" ? "active" : "")" @onclick="SwitchToLog">
                <i class="bi bi-journal-text"></i> Bar Sales
            </button>
            <button class="nav-tab-btn @(_activeView == "compliance" ? "active" : "")" @onclick="LoadComplianceView">
                <i class="bi bi-calendar-check"></i> Data Entry Compliance
            </button>
            <button class="nav-tab-btn @(_activeView == "analysis" ? "active" : "")" @onclick="LoadAnalysisView">
                <i class="bi bi-calculator"></i> Bar Revenue Analysis
            </button>
            <button class="nav-tab-btn @(_activeView == "lottery" ? "active" : "")" @onclick="LoadLotteryView">
                <i class="bi bi-ticket-perforated"></i> Lottery Sales
            </button>
            <button class="nav-tab-btn @(_activeView == "lotteryUpload" ? "active" : "")" @onclick='() => _activeView = "lotteryUpload"'>
                <i class="bi bi-cloud-upload"></i> Upload Report
            </button>
        </div>

        <!-- Error Alert -->
        @if (!string.IsNullOrEmpty(_errorDetails))
        {
            <div class="alert alert-danger shadow-sm mb-4" role="alert">
                <h4 class="alert-heading"><i class="bi bi-exclamation-triangle-fill me-2"></i>Error Loading Page</h4>
                <p>@_errorDetails</p>
                <hr>
                <p class="mb-0 small">Please check the database columns "Shift" and "AdjustedSaleDate" exist.</p>
            </div>
        }

        @if (_activeView == "performance")
        {
            <div class="analytics-card animate-entrance">
                <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
                    <div>
                        <h3 class="fw-bold mb-1">Financial Summary</h3>
                        <p class="text-muted small mb-0">Overview of club bar and lottery revenue</p>
                    </div>
                    
                    <div class="d-flex gap-4 align-items-center bg-light rounded-4 px-4 py-2 border">
                        <div class="pe-3 border-end">
                            <div class="small fw-bold text-muted text-uppercase" style="font-size: 0.7rem;">Lifetime Bar Sales</div>
                            <div class="h3 fw-bold text-dark mb-0">@_grandTotalRevenue.ToString("C0")</div>
                        </div>
                        <div class="pe-3 border-end">
                            <div class="small fw-bold text-muted text-uppercase" style="font-size: 0.7rem;">Lifetime Lottery</div>
                            <div class="h3 fw-bold text-primary mb-0">@_grandTotalLotteryRevenue.ToString("C0")</div>
                        </div>
                        <div>
                            <div class="small fw-bold text-muted text-uppercase" style="font-size: 0.7rem;">Total Revenue</div>
                            <div class="h3 fw-bold text-success mb-0">@((_grandTotalRevenue + _grandTotalLotteryRevenue).ToString("C0"))</div>
                        </div>
                    </div>
                </div>

                @if (_annualRevenue != null && _annualRevenue.Any())
                {
                    <hr class="my-4 opacity-10" />
                    <h5 class="fw-bold text-secondary mb-3">Annual Performance</h5>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead class="bg-light text-uppercase small text-muted">
                                <tr>
                                    <th class="ps-4">Year</th>
                                    <th class="text-end">Bar Sales</th>
                                    <th class="text-end">Lottery Earnings</th>
                                    <th class="text-end pe-4">Total Revenue</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    var allYears = _annualRevenue.Keys.Union(_annualLotteryRevenue.Keys).OrderByDescending(y => y);
                                }
                                @foreach (var year in allYears)
                                {
                                    var bar = _annualRevenue.ContainsKey(year) ? _annualRevenue[year] : 0;
                                    var lotto = _annualLotteryRevenue.ContainsKey(year) ? _annualLotteryRevenue[year] : 0;
                                    
                                    <tr>
                                        <td class="ps-4 fw-bold">@year</td>
                                        <td class="text-end">@bar.ToString("C0")</td>
                                        <td class="text-end text-primary">@lotto.ToString("C0")</td>
                                        <td class="text-end fw-bold text-success pe-4">@((bar + lotto).ToString("C0"))</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        }

        @if (_activeView == "graph")
        {
            <div class="analytics-card animate-entrance">
                <div class="mb-4">
                    <div class="d-flex justify-content-between align-items-end mb-4">
                        <div>
                            <h3 class="fw-bold mb-1">Sales Trends</h3>
                            <p class="text-muted small mb-0">Visual analysis of revenue over time</p>
                        </div>
                    </div>

                <!-- Advanced Controls -->
                <div class="chart-controls-panel">
                    <div class="row g-3">
                        <!-- Row 1: Main Filters -->
                        <div class="col-md-3">
                            <label class="small fw-bold text-muted mb-2">TIME PERIOD</label>
                            <select class="form-select chart-select" @bind="_selectedPeriod" @bind:after="UpdateChart">
                                <option value="year">Full Year Comparison</option>
                                <option value="week">Last 7 Days</option>
                                <option value="month">Last 30 Days</option>
                                <option value="thisMonth">This Month</option>
                                <option value="lastMonth">Last Month</option>
                                <option value="custom">Custom Range</option>
                            </select>
                        </div>
                        
                        <div class="col-md-3">
                            <label class="small fw-bold text-muted mb-2">GROUP BY</label>
                            <select class="form-select chart-select" @bind="_groupBy" @bind:after="UpdateChart">
                                <option value="day">Daily</option>
                                <option value="week">Weekly</option>
                                <option value="month">Monthly</option>
                            </select>
                        </div>

                        <div class="col-md-3">
                            <label class="small fw-bold text-muted mb-2">FILTER DAYS</label>
                            <select class="form-select chart-select" @bind="_chartDayFilter" @bind:after="UpdateChart">
                                <option value="">All Days</option>
                                <option value="Sunday">Sundays</option>
                                <option value="Monday">Mondays</option>
                                <option value="Tuesday">Tuesdays</option>
                                <option value="Wednesday">Wednesdays</option>
                                <option value="Thursday">Thursdays</option>
                                <option value="Friday">Fridays</option>
                                <option value="Saturday">Saturdays</option>
                            </select>
                        </div>
                        
                        <div class="col-md-3">
                            <label class="small fw-bold text-muted mb-2">FILTER SHIFT</label>
                            <select class="form-select chart-select" @bind="_chartShiftFilter" @bind:after="UpdateChart">
                                <option value="">All Shifts</option>
                                <option value="Day">Day Shift</option>
                                <option value="Night">Night Shift</option>
                            </select>
                        </div>

                        @if (_selectedPeriod == "custom")
                        {
                            <div class="col-md-3">
                                <label class="small fw-bold text-muted mb-2">START DATE</label>
                                <input type="date" class="form-control chart-select" @bind="_customStartDate" @bind:after="UpdateChart" />
                            </div>
                            <div class="col-md-3">
                                <label class="small fw-bold text-muted mb-2">END DATE</label>
                                <input type="date" class="form-control chart-select" @bind="_customEndDate" @bind:after="UpdateChart" />
                            </div>
                        }
                    </div>

                    <!-- Row 2: Year Selection (Visible for Full Year View) -->
                    @if (_selectedPeriod == "year")
                    {
                        <div class="mt-3 pt-3 border-top">
                            <label class="small fw-bold text-muted mb-2 d-block">COMPARE YEARS</label>
                            <div class="d-flex flex-wrap gap-3">
                                @foreach (var year in _availableYears)
                                {
                                    <label class="year-checkbox-label">
                                        <input type="checkbox" checked="@(_selectedComparisonYears.Contains(year))" 
                                               @onchange="@(e => ToggleYearComparison(year, (bool)e.Value))" />
                                        <span>@year</span>
                                    </label>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
            </div>
            <div class="chart-container mt-4">
                <canvas id="barSalesChart"></canvas>
            </div>
        }

        @if (!string.IsNullOrEmpty(_successMessage))
        {
            <div class="alert alert-success alert-dismissible fade show mb-4 border-0 shadow-sm rounded-4" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i> @_successMessage
                <button type="button" class="btn-close" @onclick="() => _successMessage = null"></button>
            </div>
        }

        @if (_activeView == "entry")
        {
            <div class="main-form-card animate-entrance">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h3 class="fw-bold mb-0">@(_isEditing ? "Edit Entry" : "New Sales Entry")</h3>
                    @if (_isEditing)
                    {
                        <button class="btn btn-sm btn-outline-danger rounded-pill" @onclick="SwitchToEntry">
                            <i class="bi bi-x-circle me-1"></i> Cancel Edit
                        </button>
                    }
                </div>
                
                <EditForm Model="@_model" OnValidSubmit="HandleSubmit">
                    <DataAnnotationsValidator />
                    
                    <div class="row g-4">
                        <div class="col-md-3">
                            <label class="form-label-premium">Month</label>
                            <select class="form-control input-premium w-100" @bind="_selectedMonth">
                                @for (int i = 1; i <= 12; i++)
                                {
                                    <option value="@i">@(new DateTime(2000, i, 1).ToString("MMMM"))</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label-premium">Day</label>
                            <select class="form-control input-premium w-100" @bind="_selectedDay">
                                @for (int i = 1; i <= DateTime.DaysInMonth(_selectedEntryYear, _selectedMonth); i++)
                                {
                                    <option value="@i">@i</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label-premium">Year</label>
                            <select class="form-control input-premium w-100" @bind="_selectedEntryYear">
                                @for (int i = DateTime.Now.Year; i >= DateTime.Now.Year - 5; i--)
                                {
                                    <option value="@i">@i</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label-premium">Hour</label>
                            <select class="form-control input-premium w-100" @bind="_selectedHour">
                                @for (int i = 0; i <= 23; i++)
                                {
                                    <option value="@i">@i.ToString("D2")</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label-premium">Minute</label>
                            <select class="form-control input-premium w-100" @bind="_selectedMinute">
                                @for (int i = 0; i <= 59; i++)
                                {
                                    <option value="@i">@i.ToString("D2")</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label-premium text-success">Gross Revenue</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-0" style="border-radius: 16px 0 0 16px;">$</span>
                                <InputNumber class="form-control input-premium" style="border-radius: 0 16px 16px 0;" @bind-Value="_model.TotalSales" onfocus="this.select()" />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label-premium text-warning">Items Sold</label>
                            <InputNumber class="form-control input-premium w-100" @bind-Value="_model.TotalItemsSold" onfocus="this.select()" />
                        </div>
                        <div class="col-md-12">
                             <label class="form-label-premium">Notes</label>
                             <InputText class="form-control input-premium w-100" @bind-Value="_model.Notes" placeholder="Context (e.g. Member Event)..." />
                        </div>

                        <!-- Manual Accounting Date Override (Visible when editing or optional) -->
                        <div class="col-md-12">
                            <label class="form-label-premium text-danger">Accounting Date (Business Day)</label>
                            <div class="p-3 rounded-3" style="background: #fff5f5; border: 2px solid #fee2e2;">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="flex-grow-1">
                                        <InputDate class="form-control input-premium w-100" @bind-Value="_manualAdjustedDate" />
                                    </div>
                                    <div class="text-muted small">
                                        <i class="bi bi-info-circle me-1"></i>
                                        Overrides the auto-calculated date based on time. Leave empty to use auto-logic.
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-12">
                            <label class="form-label-premium">Shift Type</label>
                            <div class="d-flex gap-4 p-3 rounded-3" style="background: #f8fafc; border: 2px solid #f1f5f9;">
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="shiftType" id="shiftDay" value="Day" 
                                        checked="@(_model.Shift == "Day")" 
                                        @onchange="@(() => _model.Shift = "Day")">
                                    <label class="form-check-label fw-bold" for="shiftDay">
                                        <i class="bi bi-sun-fill text-warning me-2"></i>Day Shift
                                    </label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="shiftType" id="shiftNight" value="Night" 
                                        checked="@(_model.Shift == "Night")" 
                                        @onchange="@(() => _model.Shift = "Night")">
                                    <label class="form-check-label fw-bold" for="shiftNight">
                                        <i class="bi bi-moon-stars-fill text-info me-2"></i>Night Shift
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="mt-5 text-end d-flex justify-content-end gap-2">
                        <button type="submit" class="btn btn-lg px-5 save-btn @GetButtonClass()" disabled="@_isSaving">
                            <span class="shockwave"></span>
                            @if (_isSaving)
                            {
                                <i class="bi bi-arrow-repeat me-2"></i>
                                <span>Processing...</span>
                            }
                            else if (_showSuccess)
                            {
                                <i class="bi bi-check-all me-2"></i>
                                <span>@(_isEditing ? "Updated!" : "Recorded!")</span>
                            }
                            else
                            {
                                <i class="bi bi-plus-circle-fill me-2"></i>
                                <span>@(_isEditing ? "Update Entry" : "Commit Entry")</span>
                            }
                        </button>
                    </div>
                </EditForm>
            </div>
        }

        @if (_activeView == "lotteryEntry")
        {
            <div class="main-form-card animate-entrance">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h3 class="fw-bold mb-0">New Lottery Entry</h3>
                </div>
                
                <EditForm Model="@_lotteryModel" OnValidSubmit="HandleLotterySubmit">
                    <DataAnnotationsValidator />
                    
                    <div class="row g-4">
                        <div class="col-md-3">
                            <label class="form-label-premium">Month</label>
                            <select class="form-control input-premium w-100" @bind="_selectedMonth">
                                @for (int i = 1; i <= 12; i++)
                                {
                                    <option value="@i">@(new DateTime(2000, i, 1).ToString("MMMM"))</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label-premium">Day</label>
                            <select class="form-control input-premium w-100" @bind="_selectedDay">
                                @for (int i = 1; i <= DateTime.DaysInMonth(_selectedEntryYear, _selectedMonth); i++)
                                {
                                    <option value="@i">@i</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label-premium">Year</label>
                            <select class="form-control input-premium w-100" @bind="_selectedEntryYear">
                                @for (int i = DateTime.Now.Year; i >= DateTime.Now.Year - 5; i--)
                                {
                                    <option value="@i">@i</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label-premium">Hour</label>
                            <select class="form-control input-premium w-100" @bind="_selectedHour">
                                @for (int i = 0; i <= 23; i++)
                                {
                                    <option value="@i">@i.ToString("D2")</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label-premium">Minute</label>
                            <select class="form-control input-premium w-100" @bind="_selectedMinute">
                                @for (int i = 0; i <= 59; i++)
                                {
                                    <option value="@i">@i.ToString("D2")</option>
                                }
                            </select>
                        </div>

                        <!-- NEW LOTTERY FIELDS -->
                        <div class="col-md-3">
                            <label class="form-label-premium text-success">Commission</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-0" style="border-radius: 16px 0 0 16px;">$</span>
                                <InputNumber class="form-control input-premium" style="border-radius: 0 16px 16px 0;" @bind-Value="_lotteryModel.Commission" onfocus="this.select()" />
                            </div>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label-premium text-info">Cash Bonus</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-0" style="border-radius: 16px 0 0 16px;">$</span>
                                <InputNumber class="form-control input-premium" style="border-radius: 0 16px 16px 0;" @bind-Value="_lotteryModel.CashBonus" onfocus="this.select()" />
                            </div>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label-premium text-primary">Claims Bonus</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-0" style="border-radius: 16px 0 0 16px;">$</span>
                                <InputNumber class="form-control input-premium" style="border-radius: 0 16px 16px 0;" @bind-Value="_lotteryModel.ClaimsBonus" onfocus="this.select()" />
                            </div>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label-premium text-danger">Net Due</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-0" style="border-radius: 16px 0 0 16px;">$</span>
                                <InputNumber class="form-control input-premium" style="border-radius: 0 16px 16px 0;" @bind-Value="_lotteryModel.NetDue" onfocus="this.select()" />
                            </div>
                        </div>

                        <div class="col-md-12">
                             <label class="form-label-premium">Notes</label>
                             <InputText class="form-control input-premium w-100" @bind-Value="_lotteryModel.Notes" placeholder="Context..." />
                        </div>

                        <!-- Manual Accounting Date Override -->
                        <div class="col-md-12">
                            <label class="form-label-premium text-danger">Accounting Date (Business Day)</label>
                            <div class="p-3 rounded-3" style="background: #fff5f5; border: 2px solid #fee2e2;">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="flex-grow-1">
                                        <InputDate class="form-control input-premium w-100" @bind-Value="_manualAdjustedDate" />
                                    </div>
                                    <div class="text-muted small">
                                        <i class="bi bi-info-circle me-1"></i>
                                        Leave empty to use auto-logic.
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-12">
                            <label class="form-label-premium">Shift Type</label>
                            <div class="d-flex gap-4 p-3 rounded-3" style="background: #f8fafc; border: 2px solid #f1f5f9;">
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="lotteryShiftType" id="lotteryShiftDay" value="Day" 
                                        checked="@(_lotteryModel.ShiftType == "Day")" 
                                        @onchange="@(() => _lotteryModel.ShiftType = "Day")">
                                    <label class="form-check-label fw-bold" for="lotteryShiftDay">
                                        <i class="bi bi-sun-fill text-warning me-2"></i>Day Shift
                                    </label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="lotteryShiftType" id="lotteryShiftNight" value="Night" 
                                        checked="@(_lotteryModel.ShiftType == "Night")" 
                                        @onchange="@(() => _lotteryModel.ShiftType = "Night")">
                                    <label class="form-check-label fw-bold" for="lotteryShiftNight">
                                        <i class="bi bi-moon-stars-fill text-info me-2"></i>Night Shift
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="mt-5 text-end d-flex justify-content-end gap-2">
                        <button type="submit" class="btn btn-lg px-5 save-btn @GetButtonClass()" disabled="@_isSaving">
                            <span class="shockwave"></span>
                            @if (_isSaving)
                            {
                                <i class="bi bi-arrow-repeat me-2"></i>
                                <span>Processing...</span>
                            }
                            else if (_showSuccess)
                            {
                                <i class="bi bi-check-all me-2"></i>
                                <span>Recorded!</span>
                            }
                            else
                            {
                                <i class="bi bi-plus-circle-fill me-2"></i>
                                <span>Commit Lottery Entry</span>
                            }
                        </button>
                    </div>
                </EditForm>
            </div>
        }

        @if (_activeView == "log")
        {
            @if (!string.IsNullOrEmpty(_successMessage))
            {
                <div class="alert alert-success alert-dismissible fade show mb-4 border-0 shadow-sm rounded-4" role="alert">
                    <i class="bi bi-check-circle-fill me-2"></i> @_successMessage
                    <button type="button" class="btn-close" @onclick="() => _successMessage = null"></button>
                </div>
            }

            <div class="col-12 animate-entrance">
                <div class="bg-white rounded-5 border shadow-sm h-100 overflow-hidden d-flex flex-column">
                    <div class="p-4 border-bottom bg-light bg-opacity-50">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <div>
                                <h4 class="fw-bold mb-1">Bar Sales</h4>
                                <div class="text-muted small">Recent transactions</div>
                            </div>
                            <button class="btn btn-sm btn-light border rounded-pill px-3" @onclick="() => LoadData()">
                                <i class="bi bi-arrow-clockwise me-1"></i> Sync
                            </button>
                        </div>
                        
                        <!-- Day Filter -->
                        <select class="form-select form-select-sm border-0 bg-white shadow-sm rounded-pill" 
                                @bind="_selectedDayFilter" @bind:after="() => LoadData()">
                            <option value="">All Days</option>
                            <option value="Sunday">Sundays</option>
                            <option value="Monday">Mondays</option>
                            <option value="Tuesday">Tuesdays</option>
                            <option value="Wednesday">Wednesdays</option>
                            <option value="Thursday">Thursdays</option>
                            <option value="Friday">Fridays</option>
                            <option value="Saturday">Saturdays</option>
                        </select>
                    </div>
                    
                    <div class="flex-grow-1 overflow-auto p-4" style="background: #f8fafc;">
                        @if (_entries == null)
                        {
                            <div class="text-center py-5">
                                <div class="spinner-border text-primary" role="status"></div>
                            </div>
                        }
                        else if (!_entries.Any())
                        {
                            <div class="text-center py-5">
                                <i class="bi bi-journal-x fs-1 text-muted opacity-50"></i>
                                <p class="mt-3 text-muted">No sales recordings yet.</p>
                            </div>
                        }
                        else
                        {
                            <div class="d-flex flex-column gap-3">
                                @foreach (var entry in _entries)
                                {
                                    var isDay = entry.Shift == "Day";
                                    var shiftColor = isDay ? "warning" : "info";
                                    var shiftIcon = isDay ? "bi-sun-fill" : "bi-moon-stars-fill";
                                    var isLocked = entry.IsAudited; // Locked status alias
                                    
                                    <div class="card border-0 shadow-sm animate-entrance @(entry.IsAudited ? "border-success border-start border-4" : "")">
                                        <div class="card-body d-flex align-items-center p-3">
                                            
                                            <!-- LEFT: DATE & NAV -->
                                            <div class="d-flex align-items-center gap-3 pe-4 border-end" style="min-width: 220px;">
                                                <button class="btn btn-link link-dark p-0 opacity-50 hover-opacity-100" 
                                                        style="visibility: @(isLocked ? "hidden" : "visible");"
                                                        @onclick="() => AdjustDate(entry, -1)" 
                                                        disabled="@(_updatingEntryId == entry.Id || isLocked)">
                                                    <i class="bi bi-chevron-left fs-5"></i>
                                                </button>
                                                
                                                <div class="text-center flex-grow-1">
                                                    <div class="small text-uppercase text-muted fw-bold">@GetEffectiveDate(entry).ToString("yyyy")</div>
                                                    <div class="h4 fw-bold mb-0 text-dark">@GetEffectiveDate(entry).ToString("ddd")</div>
                                                    <div class="text-secondary fw-semibold">@GetEffectiveDate(entry).ToString("MMM dd")</div>
                                                </div>

                                                <button class="btn btn-link link-dark p-0 opacity-50 hover-opacity-100" 
                                                        style="visibility: @(isLocked ? "hidden" : "visible");"
                                                        @onclick="() => AdjustDate(entry, 1)" 
                                                        disabled="@(_updatingEntryId == entry.Id || isLocked)">
                                                    <i class="bi bi-chevron-right fs-5"></i>
                                                </button>
                                            </div>

                                            <!-- MIDDLE: INFO -->
                                            <div class="flex-grow-1 px-4">
                                                <div class="d-flex align-items-center gap-2 mb-1">
                                                    <!-- Shift Badge: Clickable ONLY if NOT locked -->
                                                    <button class="badge rounded-pill border-0 bg-@shiftColor bg-opacity-10 text-@shiftColor text-uppercase px-2 py-1"
                                                            style="@(isLocked ? "cursor: default; opacity: 0.8;" : "cursor: pointer;")"
                                                            @onclick="() => { if(!isLocked) ToggleShift(entry); }"
                                                            title="@(isLocked ? "Verified - Unlock to change" : "Click to toggle shift")"
                                                            disabled="@(_updatingEntryId == entry.Id)">
                                                        <i class="bi @shiftIcon me-1"></i> @entry.Shift
                                                        @if (isLocked) { <i class="bi bi-lock-fill ms-1" style="font-size: 0.8em;"></i> }
                                                    </button>
                                                    
                                                    @if (entry.AdjustedSaleDate.HasValue)
                                                    {
                                                        <span class="badge rounded-pill bg-danger bg-opacity-10 text-danger">
                                                            Adj from @entry.SaleDate.ToString("ddd, MMM dd")
                                                        </span>
                                                    }
                                                </div>
                                                
                                                <div class="fw-bold text-dark fs-5">
                                                    @(string.IsNullOrEmpty(entry.Notes) ? "Standard Sale" : entry.Notes)
                                                </div>
                                                <div class="small text-muted">
                                                     Recorded: @entry.SaleDate.ToString("hh:mm tt") • @entry.TotalItemsSold items
                                                </div>
                                            </div>

                                            <!-- RIGHT: ACTION -->
                                            <div class="text-end ps-4 border-start">
                                                <div class="h3 fw-bold text-success mb-2">@entry.TotalSales.ToString("C")</div>
                                                
                                                <div class="d-flex justify-content-end gap-2">
                                                    <button class="btn btn-sm rounded-pill px-3 fw-bold @(entry.IsAudited ? "btn-success" : "btn-outline-success")"
                                                            @onclick="() => ToggleVerify(entry)"
                                                            disabled="@(_updatingEntryId == entry.Id)">
                                                        @if (entry.IsAudited)
                                                        {
                                                            <span><i class="bi bi-check-lg me-1"></i> Verified</span>
                                                        }
                                                        else
                                                        {
                                                            <span>Verify</span>
                                                        }
                                                    </button>
                                                    
                                                    @if (!isLocked)
                                                    {
                                                        <button class="btn btn-sm btn-light border rounded-circle text-muted" 
                                                                style="width: 32px; height: 32px; padding: 0;"
                                                                @onclick="() => EditEntry(entry)" 
                                                                title="Edit">
                                                            <i class="bi bi-pencil-fill small"></i>
                                                        </button>
                                                    }
                                                </div>
                                            </div>

                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>

                    <!-- Pagination -->
                    @if (_totalPages > 1)
                    {
                        <div class="p-3 border-top bg-light bg-opacity-50 d-flex justify-content-between align-items-center">
                            <button class="btn btn-sm btn-outline-secondary rounded-pill px-3" 
                                    disabled="@(_currentPage == 1)" 
                                    @onclick="PrevPage">
                                Previous
                            </button>
                            <span class="text-muted small fw-bold">Page @_currentPage of @_totalPages</span>
                            <button class="btn btn-sm btn-outline-secondary rounded-pill px-3" 
                                    disabled="@(_currentPage == _totalPages)" 
                                    @onclick="NextPage">
                                Next
                            </button>
                        </div>
                    }
                </div>
            </div>
        }
        
        @if (_activeView == "compliance")
        {
            <div class="analytics-card animate-entrance">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div>
                        <h3 class="fw-bold mb-1">Compliance Audit</h3>
                        <p class="text-muted small mb-0">Year-at-a-glance shift verification</p>
                    </div>
                    <div class="d-flex align-items-center gap-4">
                        <!-- Enhanced Visual Legend -->
                        <div class="d-flex gap-3 align-items-center bg-light px-3 py-2 rounded-pill border">
                            <div class="d-flex align-items-center gap-1 small fw-bold">
                                <div class="rounded-circle bg-secondary bg-opacity-10 border" style="width: 10px; height: 10px;"></div>
                                <span class="text-muted" style="font-size: 0.75rem;">MISSING</span>
                            </div>
                            <div class="d-flex align-items-center gap-1 small fw-bold">
                                <div class="rounded-circle bg-warning" style="width: 10px; height: 10px;"></div>
                                <span class="text-dark" style="font-size: 0.75rem;">ENTERED</span>
                            </div>
                            <div class="d-flex align-items-center gap-1 small fw-bold">
                                <div class="rounded-circle bg-verified-bright" style="width: 10px; height: 10px;"></div>
                                <span class="text-dark" style="font-size: 0.75rem;">VERIFIED</span>
                            </div>
                            <div class="d-flex align-items-center gap-1 small fw-bold">
                                <div class="rounded-circle bg-danger" style="width: 10px; height: 10px;"></div>
                                <span class="text-danger" style="font-size: 0.75rem;">DUPLICATE</span>
                            </div>
                        </div>

                        <div class="d-flex align-items-center gap-2">
                            <label class="small fw-bold text-muted text-uppercase mb-0" style="white-space: nowrap;">Audit Year:</label>
                            <select class="form-select form-select-sm w-auto fw-bold" @bind="_complianceYear" @bind:after="LoadComplianceData">
                                @foreach(var year in _availableYears.OrderByDescending(y => y))
                                {
                                    <option value="@year">@year</option>
                                }
                                @if(!_availableYears.Any())
                                {
                                    <option value="@DateTime.Now.Year">@DateTime.Now.Year</option>
                                }
                            </select>
                        </div>
                    </div>
                </div>

                <!-- Source Toggle -->
                <div class="d-flex justify-content-center mb-4">
                    <div class="btn-group" role="group">
                        <input type="radio" class="btn-check" name="complianceSource" id="sourceBar" 
                               value="Bar" checked="@(_complianceSource == "Bar")" 
                               @onchange="@(e => ChangeComplianceSource("Bar"))">
                        <label class="btn btn-outline-primary" for="sourceBar">
                            <i class="bi bi-cup-straw me-2"></i>Bar Sales
                        </label>

                        <input type="radio" class="btn-check" name="complianceSource" id="sourceLottery" 
                               value="Lottery" checked="@(_complianceSource == "Lottery")" 
                               @onchange="@(e => ChangeComplianceSource("Lottery"))">
                        <label class="btn btn-outline-primary" for="sourceLottery">
                            <i class="bi bi-ticket-perforated me-2"></i>Lottery Sales
                        </label>
                    </div>
                </div>

                @if (_isLoadingCompliance)
                {
                     <div class="text-center py-5">
                        <div class="spinner-border text-primary" role="status"></div>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                       <table class="table table-bordered text-center align-middle" style="font-size: 0.8rem;">
                           <thead class="bg-light">
                               <tr>
                                   <th class="text-start ps-3" style="width: 80px;">Month</th>
                                   @for(int d=1; d<=31; d++) { <th style="width: 30px; padding: 4px;">@d</th> }
                               </tr>
                           </thead>
                           <tbody>
                               @for(int m=1; m<=12; m++)
                               {
                                   <tr>
                                       <td class="text-start fw-bold ps-3">@GetMonthAbbreviation(m)</td>
                                       @for(int d=1; d<=31; d++)
                                       {
                                                                                       var localMonth = m;
                                            var localDay = d;
                                            var daysInMonth = DateTime.DaysInMonth(_complianceYear, localMonth);
                                           if (d > daysInMonth)
                                           {
                                               <td class="bg-light"></td>
                                           }
                                           else
                                           {
                                                                                               var status = _complianceGrid.ContainsKey((localMonth, localDay)) ? _complianceGrid[(localMonth, localDay)] : (DayStatus: "Missing", NightStatus: "Missing", DayCount: 0, NightCount: 0, DayAudited: false, NightAudited: false);
                                               
                                               <td class="p-1">
                                                   <div class="d-flex flex-column gap-1 align-items-center">
                                                       <!-- DAY SHIFT DOT -->
                                                        @{
                                                            string dayColor = "bg-secondary bg-opacity-10 border"; // Missing
                                                            if (status.DayCount == 1) dayColor = status.DayAudited ? "bg-verified-bright" : "bg-warning";
                                                            else if (status.DayCount > 1) dayColor = "bg-danger";
                                                        }
                                                       <div title="Day Shift: @(status.DayCount > 0 ? (status.DayAudited ? "Verified" : "Unverified") : "Missing")" 
                                                            class="rounded-circle @dayColor" 
                                                            style="width: 10px; height: 10px; cursor: @(status.DayCount > 0 ? "pointer" : "default")"
                                                            @onclick='() => { if(status.DayCount > 0) JumpToLog(localMonth, localDay, "Day"); }'></div>

                                                       <!-- NIGHT SHIFT DOT -->
                                                        @{
                                                            string nightColor = "bg-secondary bg-opacity-10 border"; // Missing
                                                            if (status.NightCount == 1) nightColor = status.NightAudited ? "bg-verified-bright" : "bg-warning";
                                                            else if (status.NightCount > 1) nightColor = "bg-danger";
                                                        }
                                                       <div title="Night Shift: @(status.NightCount > 0 ? (status.NightAudited ? "Verified" : "Unverified") : "Missing")"
                                                            class="rounded-circle @nightColor" 
                                                            style="width: 10px; height: 10px; cursor: @(status.NightCount > 0 ? "pointer" : "default")"
                                                            @onclick='() => { if(status.NightCount > 0) JumpToLog(localMonth, localDay, "Night"); }'></div>
                                                   </div>
                                               </td>
                                           }
                                       }
                                   </tr>
                               }
                           </tbody>
                       </table>
                    </div>
                }
            </div>
        }

        @if (_activeView == "lottery")
        {
            <div class="analytics-card animate-entrance">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div>
                        <h3 class="fw-bold mb-1">Lottery Sales</h3>
                        <p class="text-muted small mb-0">Recent lottery shift reports</p>
                    </div>
                     <div class="btn-group" role="group">
                        <input type="radio" class="btn-check" name="lotteryViewMode" id="viewDaily" 
                               value="daily" checked="@(_lotteryViewMode == "daily")" 
                               @onchange="@(e => _lotteryViewMode = "daily")">
                        <label class="btn btn-outline-primary" for="viewDaily">
                            Daily Shifts
                        </label>

                        <input type="radio" class="btn-check" name="lotteryViewMode" id="viewWeekly" 
                               value="weekly" checked="@(_lotteryViewMode == "weekly")" 
                               @onchange="@(e => { _lotteryViewMode = "weekly"; LoadWeeklyStats(); })">
                        <label class="btn btn-outline-primary" for="viewWeekly">
                            Weekly Summaries
                        </label>
                    </div>
                </div>

                @if (_lotteryViewMode == "daily")
                {

                @if (_isLoadingLottery)
                {
                    <div class="text-center py-5">
                        <div class="spinner-border text-primary" role="status"></div>
                    </div>
                }
                else if (_lotteryEntries == null || !_lotteryEntries.Any())
                {
                    <div class="text-center py-5">
                        <i class="bi bi-ticket-perforated fs-1 text-muted opacity-50"></i>
                        <p class="mt-3 text-muted">No lottery records found.</p>
                    </div>
                }
                else
                {
                    <div class="d-flex flex-column gap-3">
                        @foreach (var entry in _lotteryEntries)
                        {
                            var isDay = entry.ShiftType == "Day";
                            var shiftColor = isDay ? "warning" : "info";
                            var shiftIcon = isDay ? "bi-sun-fill" : "bi-moon-stars-fill";

                            <div class="card border-0 shadow-sm">
                                <div class="card-body d-flex align-items-center p-3">
                                    <!-- LEFT: DATE & NAV -->
                                    <div class="d-flex align-items-center gap-3 pe-4 border-end" style="min-width: 220px;">
                                        <button class="btn btn-link link-dark p-0 opacity-50 hover-opacity-100" 
                                                @onclick="() => AdjustLotteryDate(entry, -1)" 
                                                disabled="@(_isLotterySaving)">
                                            <i class="bi bi-chevron-left fs-5"></i>
                                        </button>
                                        
                                        <div class="text-center flex-grow-1">
                                            <div class="small text-uppercase text-muted fw-bold">@entry.ShiftDate.ToString("yyyy")</div>
                                            <div class="h4 fw-bold mb-0 text-dark">@entry.ShiftDate.ToString("ddd")</div>
                                            <div class="text-secondary fw-semibold">@entry.ShiftDate.ToString("MMM dd")</div>
                                        </div>

                                        <button class="btn btn-link link-dark p-0 opacity-50 hover-opacity-100" 
                                                @onclick="() => AdjustLotteryDate(entry, 1)" 
                                                disabled="@(_isLotterySaving)">
                                            <i class="bi bi-chevron-right fs-5"></i>
                                        </button>
                                    </div>

                                    <!-- INFO -->
                                    <div class="flex-grow-1 px-4">
                                        <div class="d-flex align-items-center gap-2 mb-1">
                                            <!-- Shift Badge: Clickable ONLY if NOT locked -->
                                            <button class="badge rounded-pill border-0 bg-@shiftColor bg-opacity-10 text-@shiftColor text-uppercase px-2 py-1"
                                                    style="@(entry.IsReconciled ? "cursor: default; opacity: 0.8;" : "cursor: pointer;")"
                                                    @onclick="() => { if(!entry.IsReconciled) ToggleLotteryShift(entry); }"
                                                    title="@(entry.IsReconciled ? "Verified - Unlock to change" : "Click to toggle shift")"
                                                    disabled="@(_isLotterySaving)">
                                                <i class="bi @shiftIcon me-1"></i> @entry.ShiftType
                                                @if (entry.IsReconciled) { <i class="bi bi-lock-fill ms-1" style="font-size: 0.8em;"></i> }
                                            </button>
                                            
                                            <span class="text-muted small">@entry.EmployeeName</span>
                                        </div>
                                        
                                        <div class="fw-bold text-dark fs-5">
                                            @(string.IsNullOrEmpty(entry.Notes) ? "Standard Entry" : entry.Notes)
                                        </div>
                                        <div class="small text-muted">
                                             Recorded: @entry.ShiftDate.ToString("hh:mm tt")
                                        </div>
                                        @if (!string.IsNullOrEmpty(entry.TicketImageUrl))
                                        {
                                            <div class="mt-1">
                                            <div class="mt-1">
                                                <div @onclick="() => { _viewingImageUrl = entry.TicketImageUrl; _viewingImage = true; }" class="text-decoration-none small fw-bold text-primary" style="cursor: pointer;">
                                                    <i class="bi bi-card-image me-1"></i> View Ticket
                                                </div>
                                            </div>
                                            </div>
                                        }
                                    </div>

                                    <!-- SALES & ACTIONS -->
                                    <div class="text-end ps-4 border-start">
                                        @{
                                            var totalEarnings = entry.Commission + entry.CashBonus + entry.ClaimsBonus;
                                        }
                                        <div class="d-flex gap-4 justify-content-end mb-2">
                                            <div>
                                                <div class="h4 fw-bold text-success mb-0">@totalEarnings.ToString("C")</div>
                                                <div class="small text-muted">Earnings</div>
                                            </div>
                                            <div>
                                                <div class="h4 fw-bold text-danger mb-0">@entry.NetDue.ToString("C")</div>
                                                <div class="small text-muted">Net Due</div>
                                            </div>
                                        </div>
                                        
                                        <div class="d-flex justify-content-end gap-2">
                                            <button class="btn btn-sm rounded-pill px-3 fw-bold @(entry.IsReconciled ? "btn-success" : "btn-outline-success")"
                                                    @onclick="() => ToggleLotteryVerify(entry)"
                                                    disabled="@(_isLotterySaving)">
                                                @if (entry.IsReconciled)
                                                {
                                                    <span><i class="bi bi-check-lg me-1"></i> Verified</span>
                                                }
                                                else
                                                {
                                                    <span>Verify</span>
                                                }
                                            </button>
                                            
                                            @if (!entry.IsReconciled)
                                            {
                                                <button class="btn btn-sm btn-light border rounded-circle text-muted" 
                                                        style="width: 32px; height: 32px; padding: 0;"
                                                        title="Edit - coming soon"
                                                        disabled>
                                                    <i class="bi bi-pencil-fill small"></i>
                                                </button>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                }
                else if (_lotteryViewMode == "weekly")
                {
                    @if (_weeklyStats == null || !_weeklyStats.Any())
                    {
                         <div class="text-center py-5">
                            <i class="bi bi-calendar-range fs-1 text-muted opacity-50"></i>
                            <p class="mt-3 text-muted">No weekly reports found. Upload a CSV to get started.</p>
                             <button class="btn btn-primary rounded-pill mt-2" @onclick='() => _activeView = "lotteryUpload"'>
                                Upload Report
                            </button>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle">
                                <thead class="bg-light">
                                    <tr>
