                            var recent = _analysisMonths.FirstOrDefault();
                            double gapPercent = 0;
                            double requiredNonLiquor = 0;
                            if (recent != null)
                            {
                                requiredNonLiquor = recent.RequiredNonLiquorPercent(_targetRevPerBottle);
                                var currentConfig = _calibratedBeerPercent + _calibratedFoodPercent;
                                gapPercent = requiredNonLiquor - currentConfig;
                            }
                        }
                        <div class="p-4 rounded-4 border h-100 position-relative overflow-hidden" 
                             style="background: #f8fafc; box-shadow: 0 4px 6px rgba(0,0,0,0.05);">
                            
                            <div class="d-flex justify-content-between align-items-start mb-3 position-relative" style="z-index: 2;">
                                <div>
                                    <h5 class="fw-bold mb-1 text-dark">Gap Analysis</h5>
                                    <div class="small text-muted">Recent Month Health Check</div>
                                </div>
                                <i class="bi bi-pie-chart-fill fs-3 text-secondary opacity-50"></i>
                            </div>

                            @if (recent != null)
                            {
                                <div class="mb-3 position-relative" style="z-index: 2;">
                                    @{
                                        // Standard Bootstrap colors work well on light background
                                        var valueClass = gapPercent > 0 ? "text-danger" : "text-success"; 
                                    }
                                    <div class="display-6 fw-bold @valueClass">
                                        @(gapPercent > 0 ? "+" : "")@gapPercent.ToString("0.0")%
                                    </div>
                                    <div class="small text-muted">
                                        @(gapPercent > 0 ? "Extra non-liquor sales needed to justify usage" : "Surplus! Revenue exceeds liquor cost expectations")
                                    </div>
                                </div>

                                <div class="pt-3 border-top border-secondary border-opacity-10 position-relative" style="z-index: 2;">
                                    <div class="d-flex justify-content-between small mb-1">
                                        <span class="text-muted">Required Variance:</span>
                                        <span class="fw-bold text-dark">@requiredNonLiquor.ToString("0.0")%</span>
                                    </div>
                                    <div class="d-flex justify-content-between small">
                                        <span class="text-muted">Your Config:</span>
                                        <span class="fw-bold text-dark">@((_calibratedBeerPercent + _calibratedFoodPercent).ToString("0.0"))%</span>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="text-center py-4 text-muted opacity-50">No Data</div>
                            }
                        </div>
                    </div>
                </div>

                <!-- MAIN TABLE -->
                <h5 class="fw-bold text-dark mb-3">Monthly Breakdown</h5>
                <div class="table-responsive rounded-4 border mb-5">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light">
                            <tr class="text-muted text-uppercase small" style="font-size: 0.75rem;">
                                <th class="py-3 ps-4">Month</th>
                                <th class="text-end">Total Sales</th>
                                <th class="text-end text-primary">Adj. Liquor Sales</th>
                                <th class="text-center">Bottles Used</th>
                                <th class="text-end fw-bold">Actual / Bottle</th>
                                <th class="text-end text-muted">Target</th>
                                <th class="text-center pe-4">Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var m in _analysisMonths)
                            {
                                var adjSales = m.AdjustedLiquorSales(_calibratedBeerPercent, _calibratedFoodPercent);
                                var actualPerBottle = m.ActualRevPerBottle(_calibratedBeerPercent, _calibratedFoodPercent);
                                var isHealthy = actualPerBottle >= _targetRevPerBottle;
                                var variance = _targetRevPerBottle > 0 ? (actualPerBottle - _targetRevPerBottle) / _targetRevPerBottle : 0;
                                
                                <tr class="bg-white" @onclick="() => m.IsExpanded = !m.IsExpanded" style="cursor: pointer;">
                                    <td class="ps-4 fw-bold text-dark">
                                        <i class="bi bi-chevron-@(m.IsExpanded ? "down" : "right") me-2 text-muted small"></i>
                                        @m.Date.ToString("MMMM yyyy")
                                    </td>
                                    <td class="text-end text-muted">@m.TotalBarSales.ToString("C0")</td>
                                    <td class="text-end fw-bold text-primary">@adjSales.ToString("C0")</td>
                                    <td class="text-center">
                                        <span class="badge bg-light text-dark border">@m.BottlesUsed</span>
                                    </td>
                                    <td class="text-end fw-bold fs-6">@actualPerBottle.ToString("C0")</td>
                                    <td class="text-end text-muted small">@_targetRevPerBottle.ToString("C0")</td>
                                    <td class="text-center pe-4">
                                        @if (isHealthy)
                                        {
                                            <span class="badge rounded-pill bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-3">
                                                <i class="bi bi-check-circle-fill me-1"></i> Healthy
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge rounded-pill bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 px-3">
                                                <i class="bi bi-exclamation-triangle-fill me-1"></i> Check
                                            </span>
                                        }
                                    </td>
                                </tr>
                                if (m.IsExpanded)
                                {
                                    <tr class="bg-light bg-opacity-50">
                                        <td colspan="7" class="p-4">
                                            <div class="rounded-4 bg-white p-3 border shadow-sm">
                                                <h6 class="fw-bold text-muted text-uppercase small mb-3">Inventory Usage Detail - @m.Date.ToString("MMMM")</h6>
                                                
                                                @if (m.TopBrands.Any())
                                                {
                                                    <div class="row g-2">
                                                        @foreach(var brand in m.TopBrands)
                                                        {
                                                            <div class="col-md-3 col-6">
                                                                <div class="d-flex justify-content-between align-items-center p-2 border rounded-3 h-100">
                                                                    <div class="fw-bold text-dark text-truncate pe-2" title="@brand.Name">@brand.Name</div>
                                                                    <span class="badge bg-secondary text-white rounded-pill">@brand.Count</span>
                                                                </div>
                                                            </div>
                                                        }
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div class="text-muted small fst-italic">No bottle usage recorded for this month.</div>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </div>
</div>

<!-- IMAGE PREVIEW OVERLAY -->
@if (_viewingImage && !string.IsNullOrEmpty(_viewingImageUrl))
{
    <div class="image-viewer-overlay animate-entrance" @onclick="() => _viewingImage = false" style="position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.95); z-index: 2000; display: flex; flex-direction: column; backdrop-filter: blur(5px);">
        <div class="d-flex flex-column h-100 p-4">
