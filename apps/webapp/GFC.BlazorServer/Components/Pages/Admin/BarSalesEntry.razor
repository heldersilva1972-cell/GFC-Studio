    private async Task LoadLotteryData()
    {
        if (_isLoadingLottery) return;

        await _dataLock.WaitAsync();
        _isLoadingLottery = true;
        StateHasChanged();

        try
        {
            using var db = await DbFactory.CreateDbContextAsync();
            
            _lotteryEntries = new List<LotteryShift>();
            
            using var connection = new Microsoft.Data.SqlClient.SqlConnection(db.Database.GetConnectionString());
            await connection.OpenAsync();
            
            var sql = @"
                SELECT ShiftId, ShiftDate, EmployeeName, ShiftType, TotalSales, Notes, Commission, CashBonus, ClaimsBonus, NetDue, TicketImageUrl
                FROM LotteryShifts 
                WHERE (@DateFilter IS NULL OR CAST(ShiftDate AS DATE) = CAST(@DateFilter AS DATE))
                ORDER BY ShiftDate DESC";
                
            using var command = new Microsoft.Data.SqlClient.SqlCommand(sql, connection);
            command.Parameters.AddWithValue("@DateFilter", (object)_lotteryDateFilter ?? DBNull.Value);
            using var reader = await command.ExecuteReaderAsync();
            
            while(await reader.ReadAsync())
            {
                _lotteryEntries.Add(new LotteryShift
                {
                    ShiftId = reader.GetInt32(0),
                    ShiftDate = reader.GetDateTime(1),
                    EmployeeName = reader.IsDBNull(2) ? "" : reader.GetString(2),
                    ShiftType = reader.IsDBNull(3) ? "Day" : reader.GetString(3),
                    TotalSales = reader.GetDecimal(4),
                    Notes = reader.IsDBNull(5) ? null : reader.GetString(5),
                    Commission = reader.IsDBNull(6) ? 0 : reader.GetDecimal(6),
                    CashBonus = reader.IsDBNull(7) ? 0 : reader.GetDecimal(7),
                    ClaimsBonus = reader.IsDBNull(8) ? 0 : reader.GetDecimal(8),
                    NetDue = reader.IsDBNull(9) ? 0 : reader.GetDecimal(9),
                    TicketImageUrl = reader.IsDBNull(10) ? null : reader.GetString(10)
                });
            }
        }
        catch(Exception ex)
        {
            Console.WriteLine($"Error loading lottery: {ex.Message}");
        }
        finally
        {
            _isLoadingLottery = false;
            _dataLock.Release();
            StateHasChanged();
        }
    }

