    private async Task UpdateChartInternal()
    {
        using var db = await DbFactory.CreateDbContextAsync();
        var now = DateTime.Now;
        var query = db.BarSaleEntries.AsQueryable();

        if (_selectedPeriod != "year")
        {
            DateTime startDate = now, endDate = now;
            if (_selectedPeriod == "week") { startDate = now.AddDays(-6).Date; endDate = now.Date; }
            else if (_selectedPeriod == "month") { startDate = now.AddDays(-29).Date; endDate = now.Date; }
            else if (_selectedPeriod == "thisMonth") { startDate = new DateTime(now.Year, now.Month, 1); endDate = now.Date; }
            else if (_selectedPeriod == "lastMonth") { 
                var last = now.AddMonths(-1); 
                startDate = new DateTime(last.Year, last.Month, 1); 
                endDate = new DateTime(last.Year, last.Month, DateTime.DaysInMonth(last.Year, last.Month)); 
            }
            else if (_selectedPeriod == "custom") { startDate = _customStartDate.Date; endDate = _customEndDate.Date; }

            query = query.Where(e => (e.AdjustedSaleDate ?? e.SaleDate).Date >= startDate && (e.AdjustedSaleDate ?? e.SaleDate).Date <= endDate);
        }
        else if (_selectedComparisonYears.Any())
        {
            var minYear = _selectedComparisonYears.Min();
            var maxYear = _selectedComparisonYears.Max();
            query = query.Where(e => (e.AdjustedSaleDate ?? e.SaleDate).Year >= minYear && (e.AdjustedSaleDate ?? e.SaleDate).Year <= maxYear);
        }

        if (_availableYears == null || !_availableYears.Any())
        {
             _availableYears = new List<int> { DateTime.Now.Year };
        }
        else if (!_availableYears.Contains(DateTime.Now.Year))
        {
             _availableYears.Add(DateTime.Now.Year);
             _availableYears = _availableYears.OrderByDescending(y => y).ToList();
        }

        if (!string.IsNullOrEmpty(_chartDayFilter))
        {
            var targetDay = (DayOfWeek)Enum.Parse(typeof(DayOfWeek), _chartDayFilter);
            query = query.Where(e => (e.AdjustedSaleDate ?? e.SaleDate).DayOfWeek == targetDay);
        }


        if (!string.IsNullOrEmpty(_chartShiftFilter))
        {
             query = query.Where(e => e.Shift == _chartShiftFilter);
        }

        List<string> labels = new();
        var datasets = new List<object>();

        if (_selectedPeriod == "year")
        {
            var yearData = await query
                .GroupBy(e => new { 
                    Year = (e.AdjustedSaleDate ?? e.SaleDate).Year, 
                    Month = (e.AdjustedSaleDate ?? e.SaleDate).Month 
                })
                .Select(g => new { g.Key.Year, g.Key.Month, Total = g.Sum(x => x.TotalSales) })
                .ToListAsync();

            for (int i = 1; i <= 12; i++)
            {
                labels.Add(new DateTime(2000, i, 1).ToString("MMM"));
            }

            foreach (var year in _selectedComparisonYears.OrderByDescending(y => y))
            {
                var yearValues = new List<decimal>();
                for (int month = 1; month <= 12; month++)
                {
                    var total = yearData
                        .Where(d => d.Year == year && d.Month == month)
                        .Sum(d => d.Total);
                    yearValues.Add(total);
                }
                datasets.Add(new { label = year.ToString(), data = yearValues });
            }
        }
        else
        {
            var periodData = await query
                .Select(e => new { 
                    Date = (e.AdjustedSaleDate ?? e.SaleDate).Date,
                    TotalSales = e.TotalSales
                })
                .ToListAsync();

            DateTime startDate = now, endDate = now;
            if (_selectedPeriod == "week") { startDate = now.AddDays(-6).Date; endDate = now.Date; }
            else if (_selectedPeriod == "month") { startDate = now.AddDays(-29).Date; endDate = now.Date; }
            else if (_selectedPeriod == "thisMonth") { startDate = new DateTime(now.Year, now.Month, 1); endDate = now.Date; }
            else if (_selectedPeriod == "lastMonth") { 
                var last = now.AddMonths(-1); 
                startDate = new DateTime(last.Year, last.Month, 1); 
                endDate = new DateTime(last.Year, last.Month, DateTime.DaysInMonth(last.Year, last.Month)); 
            }
            else if (_selectedPeriod == "custom") { startDate = _customStartDate.Date; endDate = _customEndDate.Date; }

            var periodValues = new List<decimal>();

            if (_groupBy == "day")
            {
                var days = (endDate - startDate).Days;
                for (int i = 0; i <= days; i++)
                {
                    var d = startDate.AddDays(i);
                    labels.Add(d.ToString("MMM d"));
                    periodValues.Add(periodData.Where(e => e.Date == d).Sum(e => e.TotalSales));
                }
            }
            else if (_groupBy == "week")
            {
                 var current = startDate;
                 while(current <= endDate) {
                     var next = current.AddDays(6);
                     if(next > endDate) next = endDate;
                     labels.Add($"{current:MMM d}-{next:dd}");
                     periodValues.Add(periodData.Where(e => e.Date >= current && e.Date <= next).Sum(e => e.TotalSales));
                     current = next.AddDays(1);
                 }
            }
            else if (_groupBy == "month")
            {
                var current = new DateTime(startDate.Year, startDate.Month, 1);
                var endMonth = new DateTime(endDate.Year, endDate.Month, 1);
                while(current <= endMonth)
                {
                     labels.Add(current.ToString("MMM yyyy"));
                     periodValues.Add(periodData.Where(e => e.Date.Year == current.Year && e.Date.Month == current.Month).Sum(e => e.TotalSales));
                     current = current.AddMonths(1);
                }
            }

            datasets.Add(new { label = "Revenue", data = periodValues });
        }
        
        await JS.InvokeVoidAsync("barSalesCharts.renderChart", "barSalesChart", new { labels, datasets });
    }

    private async Task HandleSubmit()
    {
        await _dataLock.WaitAsync();
        _isSaving = true;
        _showSuccess = false;
        _successMessage = null;
        _errorDetails = null;
        StateHasChanged();

        try
        {
            int maxDays = DateTime.DaysInMonth(_selectedEntryYear, _selectedMonth);
            if (_selectedDay > maxDays) _selectedDay = maxDays;

            var enteredDate = new DateTime(_selectedEntryYear, _selectedMonth, _selectedDay, _selectedHour, _selectedMinute, 0);
            _model.SaleDate = enteredDate;

            // AUTO-ADJUST LOGIC
            var totalMinutes = enteredDate.Hour * 60 + enteredDate.Minute;
            if (totalMinutes < 300) { _model.AdjustedSaleDate = enteredDate.Date.AddDays(-1); _model.Shift = "Night"; }
            else if (totalMinutes < 1170) { _model.AdjustedSaleDate = enteredDate.Date; if (!_isEditing) _model.Shift = "Day"; }
            else { _model.AdjustedSaleDate = enteredDate.Date; if (!_isEditing) _model.Shift = "Night"; }

            if (_manualAdjustedDate.HasValue) _model.AdjustedSaleDate = _manualAdjustedDate.Value.Date;

            using var db = await DbFactory.CreateDbContextAsync();
            if (_isEditing) db.BarSaleEntries.Update(_model);
            else { _model.CreatedAt = DateTime.UtcNow; db.BarSaleEntries.Add(_model); }
            await db.SaveChangesAsync();

            _showSuccess = true;
            _successMessage = $"Recorded: {_model.TotalSales:C} at {_model.SaleDate:hh:mm tt}";
            
            _model = new BarSaleEntry();
            _selectedHour = DateTime.Now.Hour;
            _selectedMinute = DateTime.Now.Minute;
            _manualAdjustedDate = null;

            await LoadDataInternal(recalculateStats: true);

            await Task.Delay(1500);
            _showSuccess = false;
        }
        catch (Exception ex)
        {
            _errorDetails = $"Submit Failed: {ex.Message}";
            Logger.LogError(ex, "Error committing bar sales entry");
        }
        finally
        {
            _isSaving = false;
            _dataLock.Release();
            StateHasChanged();
        }
    }

