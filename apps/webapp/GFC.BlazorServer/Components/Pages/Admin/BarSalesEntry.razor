}

@code {
    private BarSaleEntry _model = new();
    private List<BarSaleEntry> _entries;

    // Compliance View State
    private int _complianceYear = DateTime.Now.Year;
    private Dictionary<(int Month, int Day), (string DayStatus, string NightStatus, int DayCount, int NightCount, bool DayAudited, bool NightAudited)> _complianceGrid;
    private bool _isLoadingCompliance = false;

    // Lottery View State
    private List<LotteryShift> _lotteryEntries;
    private bool _isLoadingLottery = false;
    private DateTime? _lotteryDateFilter; // Added for compliance jumping
    private LotteryShift _lotteryModel = new() { ShiftDate = DateTime.Now, Commission = 0, CashBonus = 0, ClaimsBonus = 0, NetDue = 0, TotalSales = 0, TotalPayouts = 0, TotalCancels = 0 };

    private bool _isLotterySaving = false;
    
    // Lottery Weekly Stats
    private string _lotteryViewMode = "daily"; // "daily" or "weekly"
    private List<LotteryWeeklyStat> _weeklyStats = new();
    private LotteryWeeklyStat _selectedWeeklyStat;
    private List<LotteryWeeklyStat> _uploadPreviewStats = new();
    private bool _isProcessingUpload = false;
    private string _uploadMessage = "";
    
    // Revenue Analysis State
    private List<RevenueAnalysisMonth> _analysisMonths = new();
    private bool _isLoadingAnalysis = false;
    private double _calibratedBeerPercent = 15;
    private double _calibratedFoodPercent = 5;
    private decimal _targetRevPerBottle = 110;

    public class RevenueAnalysisMonth
    {
        public DateTime Date { get; set; }
        public decimal TotalBarSales { get; set; }
        public int BottlesUsed { get; set; }
        public bool IsExpanded { get; set; }
        public List<(string Name, int Count)> TopBrands { get; set; } = new();
        
        // Calculated Properties
        public decimal AdjustedLiquorSales(double beerPct, double foodPct) => 
            TotalBarSales * (decimal)(1 - ((beerPct + foodPct) / 100.0));
            
        public decimal ActualRevPerBottle(double beerPct, double foodPct) => 
            BottlesUsed == 0 ? 0 : AdjustedLiquorSales(beerPct, foodPct) / BottlesUsed;

        public double RequiredNonLiquorPercent(decimal targetPerBottle) 
        {
             // Target Liquor Revenue needed
             decimal neededLiquor = BottlesUsed * targetPerBottle;
             if (TotalBarSales == 0) return 0;
             if (neededLiquor > TotalBarSales) return 0; // Impossible case, implies 100% liquor isn't enough
             
             decimal surplusCheck = TotalBarSales - neededLiquor;
             return (double)(surplusCheck / TotalBarSales) * 100.0;
        }
    }
    private string _activeView = "performance";
    private bool _isSaving = false;
    private bool _showSuccess = false;
    private bool _isEditing = false;
    private string _jumpShiftFilter = ""; // Filter by specific shift when jumping from compliance
    private string _successMessage;
    private string _errorDetails;
    
    // Image Viewer State
    private bool _viewingImage = false;
    private string _viewingImageUrl = null;

    // Pagination & Filters
    private int _currentPage = 1;
    private int _pageSize = 10;
    private int _totalEntries = 0;
    private string _selectedDayFilter = ""; // Empty = All
    private int _totalPages => (int)Math.Ceiling((double)_totalEntries / _pageSize);

    // Persistent date components
    private int _selectedMonth = DateTime.Now.Month;
    private int _selectedDay = DateTime.Now.Day;
    private int _selectedEntryYear = DateTime.Now.Year;
    
    // Time components (24-hour format for entry)
    private int _selectedHour = DateTime.Now.Hour;
    private int _selectedMinute = DateTime.Now.Minute;

    private decimal _grandTotalRevenue = 0;
    private int _grandTotalItemsSold = 0;
    private Dictionary<int, decimal> _annualRevenue = new();
    
    // Lottery Stats
    private decimal _grandTotalLotteryRevenue = 0;
    private Dictionary<int, decimal> _annualLotteryRevenue = new();

    private List<int> _availableYears = new();
    private List<int> _selectedComparisonYears = new();

    // Chart controls
    private string _selectedPeriod = "year";
    private string _groupBy = "month";
    private string _chartDayFilter = ""; // Empty = All Days
    private string _chartShiftFilter = ""; // Empty = All Shifts
    private DateTime _customStartDate = DateTime.Now.AddDays(-30);
    private DateTime _customEndDate = DateTime.Now;
    
    private DateTime? _manualAdjustedDate; // For explicit overrides in Edit Form

    private bool _isLoadingData = false;
    private bool _isFirstRender = true;
    private global::System.Threading.SemaphoreSlim _dataLock = new(1, 1);

    protected override async Task OnInitializedAsync()
    {
        // 1. INSTANT RESTORE: Load from memory immediately
        if (StateCache.HasData)
        {
            _entries = StateCache.Entries;
            _grandTotalRevenue = StateCache.GrandTotalRevenue;
            _grandTotalItemsSold = StateCache.GrandTotalItemsSold;
            _annualRevenue = StateCache.AnnualRevenue;
            _availableYears = StateCache.AvailableYears;
            _totalEntries = StateCache.TotalEntries;
        }

        // CONTROLLED LOAD: Await the first load to ensure context is stable
        await LoadData(recalculateStats: !StateCache.HasData);
    }

