    private async Task HandleFileUpload(InputFileChangeEventArgs e)
    {
        _isProcessingUpload = true;
        _uploadMessage = "";
        _uploadPreviewStats = new List<LotteryWeeklyStat>();

        try
        {
            // Limit to 512KB - these files are small
            using var stream = e.File.OpenReadStream(maxAllowedSize: 512000);
            using var reader = new global::System.IO.StreamReader(stream);
            var content = await reader.ReadToEndAsync();
            
            var parsedStats = ParseLotteryCsv(content);
            
            // Check against existing database records
            using var db = await DbFactory.CreateDbContextAsync();
            var existingStats = await db.LotteryWeeklyStats.ToListAsync();
            
            // Normalize existing dates for easy lookup
            var existingMap = existingStats.ToDictionary(s => s.WeekEndingDate.Date, s => s);

            var newStats = new List<LotteryWeeklyStat>();
            int skippedCount = 0;
            int updateCount = 0;

            foreach (var stat in parsedStats)
            {
                // Ensure parsed stat is also just Date
                stat.WeekEndingDate = stat.WeekEndingDate.Date;
                
                if (existingMap.TryGetValue(stat.WeekEndingDate, out var existing))
                {
                    // Check if existing is "empty" (TotalDue == 0) and new one has data
                    // This allows re-uploading to fix missing data
                    if (existing.TotalDue == 0 && stat.TotalDue != 0)
                    {
                        newStats.Add(stat);
                        updateCount++;
                    }
                    else
                    {
                        skippedCount++;
                    }
                }
                else
                {
                    newStats.Add(stat);
                }
            }

            _uploadPreviewStats = newStats;

            if (_uploadPreviewStats.Any())
            {
                _uploadMessage = $"Found {_uploadPreviewStats.Count} records to import.";
                if (updateCount > 0)
                {
                    _uploadMessage += $" ({updateCount} updates to incomplete records)";
                }
                if (skippedCount > 0)
                {
                    _uploadMessage += $" ({skippedCount} skipped as already complete)";
                }
            }
            else
            {
                if (skippedCount > 0)
                {
                    _uploadMessage = $"All {skippedCount} weeks in this file have already been imported.";
                }
                else
                {
                    _uploadMessage = "No valid data found. Please check the file format.";
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error uploading file");
            _uploadMessage = $"Error reading file: {ex.Message}";
        }
        finally
        {
            _isProcessingUpload = false;
        }
    }

    private List<LotteryWeeklyStat> ParseLotteryCsv(string csvContent)
    {
        var stats = new List<LotteryWeeklyStat>();
        
        // Split lines and simple parsing
        var lines = csvContent.Split(new[] { '\r', '\n' }, StringSplitOptions.RemoveEmptyEntries);
        if (lines.Length < 2) return stats;

        // 1. Identify Dates from Header (Row 0)
        var headerCols = ParseCsvLine(lines[0]);
        var dateMap = new Dictionary<int, DateTime>(); // colIndex -> Date

        for (int i = 1; i < headerCols.Count; i++) // Skip first col "Week Ending"
        {
            if (DateTime.TryParse(headerCols[i], out var date))
            {
                dateMap[i] = date;
                // Init statistic object for this date
                if (!stats.Any(s => s.WeekEndingDate == date))
                {
                    stats.Add(new LotteryWeeklyStat { WeekEndingDate = date });
                }
            }
        }

        // 2. Parse Rows
        string currentSection = ""; // "Online" or "Instant"

        for (int i = 1; i < lines.Length; i++)
        {
            var cols = ParseCsvLine(lines[i]);
            if (cols.Count == 0) continue;

            var label = cols[0].Trim();
            
            // Detect Section Headers (usually just the word "Online" or "Instant" in first col)
            if (label.Equals("Online", StringComparison.OrdinalIgnoreCase)) { currentSection = "Online"; continue; }
            if (label.Equals("Instant", StringComparison.OrdinalIgnoreCase)) { currentSection = "Instant"; continue; }

            // Map values
            foreach (var kvp in dateMap)
            {
                int colIndex = kvp.Key;
                if (colIndex >= cols.Count) continue;

                var stat = stats.FirstOrDefault(s => s.WeekEndingDate == kvp.Value);
                if (stat == null) continue;

                decimal val = ParseCurrency(cols[colIndex]);

                if (currentSection == "Online")
                {
                    if (label.Contains("Net Sales")) stat.OnlineNetSales = val;
                    else if (label.Contains("Commission")) stat.OnlineCommission = val;
                    else if (label.Contains("Cashes")) stat.OnlineCashes = val;
                    else if (label.Contains("Cash Bonus")) stat.OnlineCashBonus = val;
                    else if (label.Contains("Claims Bonus")) stat.OnlineClaimsBonus = val;
                    else if (label.Contains("Adjustments")) stat.OnlineAdjustments = val;
                    else if (label.Contains("Service Fee")) stat.OnlineServiceFee = val;
                    else if (label.Contains("Bonding Fee")) stat.OnlineBondingFee = val;
                    else if (label.Contains("Online Due") || label.Contains("Total Online Due")) stat.OnlineDue = val;
                }
                else if (currentSection == "Instant")
                {
                    if (label.Contains("Gross Sales")) stat.InstantGrossSales = val;
                    else if (label.Contains("Return Sales")) stat.InstantReturnSales = val;
                    else if (label.Contains("Commission")) stat.InstantCommission = val; // Context is Instant because of section
                    else if (label.Contains("Cashes")) stat.InstantCashes = val;
                    else if (label.Contains("Cash Bonus")) stat.InstantCashBonus = val;
                    else if (label.Contains("Claims Bonus")) stat.InstantClaimsBonus = val;
                    else if (label.Contains("Adjustments")) stat.InstantAdjustments = val;
                    else if (label.Contains("Instant Due") || label.Contains("Total Instant Due")) stat.InstantDue = val;
                }
                
                if (label.Equals("Total Due", StringComparison.OrdinalIgnoreCase))
                {
                    stat.TotalDue = val;
                }
            }
        }

        return stats;
    }

    private List<string> ParseCsvLine(string line)
    {
        // Simple CSV splitter handling quotes
        var result = new List<string>();
        bool inQuotes = false;
        string current = "";
        
        foreach (char c in line)
        {
            if (c == '"') inQuotes = !inQuotes;
            else if (c == ',' && !inQuotes)
            {
                result.Add(current);
                current = "";
            }
            else current += c;
        }
        result.Add(current);
        return result;
    }

    private decimal ParseCurrency(string input)
    {
        if (string.IsNullOrWhiteSpace(input)) return 0;
        // Clean string: remove $, (, ), and treat () as negative
        input = input.Trim();
        bool isNegative = input.Contains("(") && input.Contains(")");
        
        string clean = new string(input.Where(c => char.IsDigit(c) || c == '.').ToArray());
        if (decimal.TryParse(clean, out decimal val))
        {
            return isNegative ? -val : val;
        }
        return 0;
    }

    private async Task SaveWeeklyStats()
    {
        if (!_uploadPreviewStats.Any()) return;

        try
        {
            using var db = await DbFactory.CreateDbContextAsync();
            
            // Upsert logic: Check if date exists
            foreach (var stat in _uploadPreviewStats)
            {
                var existing = await db.LotteryWeeklyStats
                    .FirstOrDefaultAsync(s => s.WeekEndingDate == stat.WeekEndingDate);

                if (existing != null)
                {
                    // Update existing
                    existing.OnlineNetSales = stat.OnlineNetSales;
                    existing.OnlineCommission = stat.OnlineCommission;
                    existing.OnlineCashes = stat.OnlineCashes;
                    existing.OnlineCashBonus = stat.OnlineCashBonus;
                    existing.OnlineClaimsBonus = stat.OnlineClaimsBonus;
                    existing.OnlineDue = stat.OnlineDue;
                    
                    existing.InstantGrossSales = stat.InstantGrossSales;
                    existing.InstantDue = stat.InstantDue;
                    existing.TotalDue = stat.TotalDue;
                    // ... (Update other fields as needed, simplifying here)
                }
                else
                {
                    db.LotteryWeeklyStats.Add(stat);
                }
            }
            
            await db.SaveChangesAsync();
            
            _uploadMessage = "Import successful!";
            _uploadPreviewStats.Clear();
            await LoadWeeklyStats();
            
            // Return to list view
            _activeView = "lottery";
            _lotteryViewMode = "weekly";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error saving weekly stats");
            _uploadMessage = "Error saving data. Please check logs.";
        }
    }
