@page "/admin/notification-preferences"
@attribute [Authorize(Policy = AppPolicies.RequireAdmin)]
@using GFC.BlazorServer.Data.Entities
@using GFC.BlazorServer.Services
@using GFC.Core.Interfaces
@using Microsoft.AspNetCore.Authorization
@inject IUserRepository UserRepository
@inject ILogger<NotificationPreferences> Logger
@inject NavigationManager Navigation
@inject INotificationService NotificationService
@inject IAuthorizedUserService AuthorizedUserService

<PageTitle>Notification Preferences - GFC</PageTitle>

<div class="page-header">
    <div>
        <h1 class="h3 mb-1">Notification Preferences</h1>
        <p class="text-muted mb-0">Configure email and SMS notifications for users</p>
    </div>
</div>

@if (_errorMessage != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @_errorMessage
        <button type="button" class="btn-close" @onclick="() => _errorMessage = null"></button>
    </div>
}

@if (_successMessage != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @_successMessage
        <button type="button" class="btn-close" @onclick="() => _successMessage = null"></button>
    </div>
}

@if (_isLoading)
{
    <div class="text-center my-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
}
else
{
    <!-- Filter Section -->
    <div class="card shadow-sm mb-3">
        <div class="card-body">
            <div class="row g-3 align-items-center">
                <div class="col-md-4">
                    <label class="form-label small mb-1">Filter by Role</label>
                    <select class="form-select form-select-sm" @bind="_roleFilter" @bind:after="ApplyFilter">
                        <option value="all">All Users</option>
                        <option value="directors">Directors Only</option>
                        <option value="admins">Admins Only</option>
                        <option value="board">Board Members</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label small mb-1">Search</label>
                    <input type="text" class="form-control form-control-sm" placeholder="Search by name..." 
                           @bind="_searchText" @bind:event="oninput" @bind:after="ApplyFilter" />
                </div>
                <div class="col-md-4 text-end">
                    <label class="form-label small mb-1 d-block">&nbsp;</label>
                    <span class="badge bg-info">@_filteredUsers.Count user(s)</span>
                </div>
            </div>
        </div>
    </div>

    <!-- User Notification Preferences -->
    @if (!_filteredUsers.Any())
    {
        <div class="card shadow-sm">
            <div class="card-body text-center py-5">
                <i class="bi bi-inbox text-muted" style="font-size: 3rem;"></i>
                <h5 class="mt-3 text-muted">No users found</h5>
                <p class="text-muted">Try adjusting your filters</p>
            </div>
        </div>
    }
    else
    {
        @foreach (var userPref in _filteredUsers)
        {
            <div class="card shadow-sm mb-3">
                <div class="card-header bg-light">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="mb-0">
                                @userPref.UserName
                                @if (userPref.IsDirector)
                                {
                                    <span class="badge bg-primary ms-2">Director</span>
                                }
                                @if (userPref.IsAdmin)
                                {
                                    <span class="badge bg-danger ms-1">Admin</span>
                                }
                            </h6>
                        </div>
                        <button class="btn btn-sm btn-outline-primary" @onclick="() => ToggleExpanded(userPref.UserId)">
                            <i class="bi @(IsExpanded(userPref.UserId) ? "bi-chevron-up" : "bi-chevron-down")"></i>
                        </button>
                    </div>
                </div>
                
                @if (IsExpanded(userPref.UserId))
                {
                    <div class="card-body">
                        <!-- Contact Information -->
                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label class="form-label small">Email Address</label>
                                <input type="email" class="form-control form-control-sm" 
                                       @bind="userPref.Email" placeholder="user@example.com" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small">Phone Number</label>
                                <input type="tel" class="form-control form-control-sm" 
                                       @bind="userPref.Phone" placeholder="(555) 123-4567" />
                            </div>
                        </div>

                        <!-- Notification Preferences Table -->
                        <h6 class="mb-3">Notification Events</h6>
                        <div class="table-responsive">
                            <table class="table table-sm table-bordered">
                                <thead class="table-light">
                                    <tr>
                                        <th>Event Type</th>
                                        <th class="text-center" style="width: 100px;">Email</th>
                                        <th class="text-center" style="width: 100px;">SMS</th>
                                        <th class="text-center" style="width: 100px;">Push</th>
                                        <th class="text-center" style="width: 100px;">All</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td><i class="bi bi-receipt text-primary"></i> Reimbursement Requests</td>
                                        <td class="text-center">
                                            <input type="checkbox" @bind="userPref.ReimbursementNotifyEmail" />
                                        </td>
                                        <td class="text-center">
                                            <input type="checkbox" @bind="userPref.ReimbursementNotifySMS" />
                                        </td>
                                        <td class="text-center">
                                            <input type="checkbox" @bind="userPref.ReimbursementNotifyPush" />
                                        </td>
                                        <td class="text-center">
                                            <button class="btn btn-link btn-sm p-0" @onclick="() => SetAll(userPref, NotificationType.Reimbursement, true)">All</button>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td><i class="bi bi-person-plus text-success"></i> New Member Signups</td>
                                        <td class="text-center">
                                            <input type="checkbox" @bind="userPref.MemberSignupNotifyEmail" />
                                        </td>
                                        <td class="text-center">
                                            <input type="checkbox" @bind="userPref.MemberSignupNotifySMS" />
                                        </td>
                                        <td class="text-center">
                                            <input type="checkbox" @bind="userPref.MemberSignupNotifyPush" />
                                        </td>
                                        <td class="text-center">
                                             <button class="btn btn-link btn-sm p-0" @onclick="() => SetAll(userPref, NotificationType.MemberSignup, true)">All</button>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td><i class="bi bi-wallet2 text-warning"></i> Dues Payments</td>
                                        <td class="text-center">
                                            <input type="checkbox" @bind="userPref.DuesPaymentNotifyEmail" />
                                        </td>
                                        <td class="text-center">
                                            <input type="checkbox" @bind="userPref.DuesPaymentNotifySMS" />
                                        </td>
                                        <td class="text-center">
                                            <input type="checkbox" @bind="userPref.DuesPaymentNotifyPush" />
                                        </td>
                                        <td class="text-center">
                                             <button class="btn btn-link btn-sm p-0" @onclick="() => SetAll(userPref, NotificationType.DuesPayment, true)">All</button>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td><i class="bi bi-exclamation-triangle text-danger"></i> System Alerts</td>
                                        <td class="text-center">
                                            <input type="checkbox" @bind="userPref.SystemAlertNotifyEmail" />
                                        </td>
                                        <td class="text-center">
                                            <input type="checkbox" @bind="userPref.SystemAlertNotifySMS" />
                                        </td>
                                        <td class="text-center">
                                            <input type="checkbox" @bind="userPref.SystemAlertNotifyPush" />
                                        </td>
                                        <td class="text-center">
                                             <button class="btn btn-link btn-sm p-0" @onclick="() => SetAll(userPref, NotificationType.SystemAlert, true)">All</button>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td><i class="bi bi-ticket-perforated text-info"></i> Lottery Sales</td>
                                        <td class="text-center">
                                            <input type="checkbox" @bind="userPref.LotterySalesNotifyEmail" />
                                        </td>
                                        <td class="text-center">
                                            <input type="checkbox" @bind="userPref.LotterySalesNotifySMS" />
                                        </td>
                                        <td class="text-center">
                                            <input type="checkbox" @bind="userPref.LotterySalesNotifyPush" />
                                        </td>
                                        <td class="text-center">
                                             <button class="btn btn-link btn-sm p-0" @onclick="() => SetAll(userPref, NotificationType.LotterySales, true)">All</button>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td><i class="bi bi-door-open text-secondary"></i> Controller Events</td>
                                        <td class="text-center">
                                            <input type="checkbox" @bind="userPref.ControllerEventNotifyEmail" />
                                        </td>
                                        <td class="text-center">
                                            <input type="checkbox" @bind="userPref.ControllerEventNotifySMS" />
                                        </td>
                                        <td class="text-center">
                                            <input type="checkbox" @bind="userPref.ControllerEventNotifyPush" />
                                        </td>
                                        <td class="text-center">
                                             <button class="btn btn-link btn-sm p-0" @onclick="() => SetAll(userPref, NotificationType.ControllerEvent, true)">All</button>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        <div class="mt-3">
                            <button class="btn btn-primary btn-sm" @onclick="() => SaveUserPreferences(userPref)" disabled="@_isSaving">
                                <span class="spinner-border spinner-border-sm me-1" hidden="@(!_isSaving)"></span>
                                <i class="bi bi-save"></i> Save Preferences
                            </button>
                        </div>
                    </div>
                }
            </div>
        }
    }

    <!-- Save All Button -->
    @if (_filteredUsers.Any())
    {
        <div class="card shadow-sm mt-3">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <strong>Save all changes</strong>
                        <div class="small text-muted">Save notification preferences for all users</div>
                    </div>
                    <button class="btn btn-success" @onclick="SaveAllPreferences" disabled="@_isSaving">
                        <span class="spinner-border spinner-border-sm me-1" hidden="@(!_isSaving)"></span>
                        <i class="bi bi-save-fill"></i> Save All
                    </button>
                </div>
            </div>
        </div>
    }
}

@code {
    private bool _isLoading = true;
    private bool _isSaving = false;
    private string? _errorMessage;
    private string? _successMessage;
    private string _roleFilter = "directors";
    private string _searchText = "";
    
    private List<UserNotificationPreferencesModel> _allUsers = new();
    private List<UserNotificationPreferencesModel> _filteredUsers = new();
    private HashSet<int> _expandedUserIds = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadUsers();
    }

    private async Task LoadUsers()
    {
        try
        {
            _isLoading = true;
            
            var users = await AuthorizedUserService.GetAuthorizedUsersAsync();
            var allPrefs = await NotificationService.GetAllPreferencesAsync();

            _allUsers = users.Select(u => {
                var pref = allPrefs.FirstOrDefault(p => p.UserId == u.UserId) ?? new UserNotificationPreferences { UserId = u.UserId };
                var username = u.User?.Username ?? "Unknown";
                return new UserNotificationPreferencesModel 
                { 
                    UserId = u.UserId, 
                    UserName = username, 
                    IsDirector = username.Contains("Director", StringComparison.OrdinalIgnoreCase),
                    IsAdmin = u.AccessLevel == "Admin" || u.AccessLevel == "Full Access",
                    Email = pref.Email,
                    Phone = pref.Phone,
                    ReimbursementNotifyEmail = pref.ReimbursementNotifyEmail,
                    ReimbursementNotifySMS = pref.ReimbursementNotifySMS,
                    ReimbursementNotifyPush = pref.ReimbursementNotifyPush,
                    MemberSignupNotifyEmail = pref.MemberSignupNotifyEmail,
                    MemberSignupNotifySMS = pref.MemberSignupNotifySMS,
                    MemberSignupNotifyPush = pref.MemberSignupNotifyPush,
                    DuesPaymentNotifyEmail = pref.DuesPaymentNotifyEmail,
                    DuesPaymentNotifySMS = pref.DuesPaymentNotifySMS,
                    DuesPaymentNotifyPush = pref.DuesPaymentNotifyPush,
                    SystemAlertNotifyEmail = pref.SystemAlertNotifyEmail,
                    SystemAlertNotifySMS = pref.SystemAlertNotifySMS,
                    SystemAlertNotifyPush = pref.SystemAlertNotifyPush,
                    LotterySalesNotifyEmail = pref.LotterySalesNotifyEmail,
                    LotterySalesNotifySMS = pref.LotterySalesNotifySMS,
                    LotterySalesNotifyPush = pref.LotterySalesNotifyPush,
                    ControllerEventNotifyEmail = pref.ControllerEventNotifyEmail,
                    ControllerEventNotifySMS = pref.ControllerEventNotifySMS,
                    ControllerEventNotifyPush = pref.ControllerEventNotifyPush
                };
            }).ToList();
            
            ApplyFilter();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load users");
            _errorMessage = "Failed to load users: " + ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void ApplyFilter()
    {
        var filtered = _allUsers.AsEnumerable();

        // Role filter
        filtered = _roleFilter switch
        {
            "directors" => filtered.Where(u => u.IsDirector),
            "admins" => filtered.Where(u => u.IsAdmin),
            "board" => filtered.Where(u => u.IsDirector || u.IsAdmin),
            _ => filtered
        };

        // Search filter
        if (!string.IsNullOrWhiteSpace(_searchText))
        {
            filtered = filtered.Where(u => u.UserName.Contains(_searchText, StringComparison.OrdinalIgnoreCase));
        }

        _filteredUsers = filtered.ToList();
        StateHasChanged();
    }

    private bool IsExpanded(int userId) => _expandedUserIds.Contains(userId);

    private void ToggleExpanded(int userId)
    {
        if (_expandedUserIds.Contains(userId))
            _expandedUserIds.Remove(userId);
        else
            _expandedUserIds.Add(userId);
    }

    private void SetAll(UserNotificationPreferencesModel user, NotificationType type, bool enabled)
    {
        switch (type)
        {
            case NotificationType.Reimbursement:
                user.ReimbursementNotifyEmail = user.ReimbursementNotifySMS = user.ReimbursementNotifyPush = enabled;
                break;
            case NotificationType.MemberSignup:
                user.MemberSignupNotifyEmail = user.MemberSignupNotifySMS = user.MemberSignupNotifyPush = enabled;
                break;
            case NotificationType.DuesPayment:
                user.DuesPaymentNotifyEmail = user.DuesPaymentNotifySMS = user.DuesPaymentNotifyPush = enabled;
                break;
            case NotificationType.SystemAlert:
                user.SystemAlertNotifyEmail = user.SystemAlertNotifySMS = user.SystemAlertNotifyPush = enabled;
                break;
            case NotificationType.LotterySales:
                user.LotterySalesNotifyEmail = user.LotterySalesNotifySMS = user.LotterySalesNotifyPush = enabled;
                break;
            case NotificationType.ControllerEvent:
                user.ControllerEventNotifyEmail = user.ControllerEventNotifySMS = user.ControllerEventNotifyPush = enabled;
                break;
        }
    }

    private async Task SaveUserPreferences(UserNotificationPreferencesModel model)
    {
        _isSaving = true;
        try
        {
            var pref = new UserNotificationPreferences
            {
                UserId = model.UserId,
                Email = model.Email,
                Phone = model.Phone,
                ReimbursementNotifyEmail = model.ReimbursementNotifyEmail,
                ReimbursementNotifySMS = model.ReimbursementNotifySMS,
                ReimbursementNotifyPush = model.ReimbursementNotifyPush,
                MemberSignupNotifyEmail = model.MemberSignupNotifyEmail,
                MemberSignupNotifySMS = model.MemberSignupNotifySMS,
                MemberSignupNotifyPush = model.MemberSignupNotifyPush,
                DuesPaymentNotifyEmail = model.DuesPaymentNotifyEmail,
                DuesPaymentNotifySMS = model.DuesPaymentNotifySMS,
                DuesPaymentNotifyPush = model.DuesPaymentNotifyPush,
                SystemAlertNotifyEmail = model.SystemAlertNotifyEmail,
                SystemAlertNotifySMS = model.SystemAlertNotifySMS,
                SystemAlertNotifyPush = model.SystemAlertNotifyPush,
                LotterySalesNotifyEmail = model.LotterySalesNotifyEmail,
                LotterySalesNotifySMS = model.LotterySalesNotifySMS,
                LotterySalesNotifyPush = model.LotterySalesNotifyPush,
                ControllerEventNotifyEmail = model.ControllerEventNotifyEmail,
                ControllerEventNotifySMS = model.ControllerEventNotifySMS,
                ControllerEventNotifyPush = model.ControllerEventNotifyPush,
                UpdatedAt = DateTime.UtcNow
            };

            await NotificationService.SaveUserPreferencesAsync(pref);
            _successMessage = $"Preferences saved for {model.UserName}";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to save preferences");
            _errorMessage = $"Failed to save preferences: {ex.Message}";
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task SaveAllPreferences()
    {
        foreach (var user in _filteredUsers)
        {
            await SaveUserPreferences(user);
        }
        _successMessage = $"All filtered preferences saved successfully.";
    }

    private enum NotificationType
    {
        Reimbursement,
        MemberSignup,
        DuesPayment,
        SystemAlert,
        LotterySales,
        ControllerEvent
    }

    private enum NotificationMethod
    {
        None,
        Email,
        SMS,
        Both
    }

    private class UserNotificationPreferencesModel
    {
        public int UserId { get; set; }
        public string UserName { get; set; } = "";
        public bool IsDirector { get; set; }
        public bool IsAdmin { get; set; }
        public string? Email { get; set; }
        public string? Phone { get; set; }
        
        public bool ReimbursementNotifyEmail { get; set; }
        public bool ReimbursementNotifySMS { get; set; }
        public bool ReimbursementNotifyPush { get; set; }
        public bool MemberSignupNotifyEmail { get; set; }
        public bool MemberSignupNotifySMS { get; set; }
        public bool MemberSignupNotifyPush { get; set; }
        public bool DuesPaymentNotifyEmail { get; set; }
        public bool DuesPaymentNotifySMS { get; set; }
        public bool DuesPaymentNotifyPush { get; set; }
        public bool SystemAlertNotifyEmail { get; set; }
        public bool SystemAlertNotifySMS { get; set; }
        public bool SystemAlertNotifyPush { get; set; }
        public bool LotterySalesNotifyEmail { get; set; }
        public bool LotterySalesNotifySMS { get; set; }
        public bool LotterySalesNotifyPush { get; set; }
        public bool ControllerEventNotifyEmail { get; set; }
        public bool ControllerEventNotifySMS { get; set; }
        public bool ControllerEventNotifyPush { get; set; }
    }
}
