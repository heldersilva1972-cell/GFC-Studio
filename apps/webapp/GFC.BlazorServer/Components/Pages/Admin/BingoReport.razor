@page "/admin/bingo"
@using GFC.Core.Models
@using GFC.BlazorServer.Data
@using Microsoft.EntityFrameworkCore
@using global::System.Security.Claims
@using global::System.Globalization
@inject GfcDbContext DbContext
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject GFC.Core.Interfaces.IUserManagementService UserService
@inject GFC.BlazorServer.Services.CustomAuthenticationStateProvider AuthStateProvider
@attribute [Authorize]

<PageTitle>Bingo Reports | GFC Admin</PageTitle>

<div class="admin-container p-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <div class="d-flex align-items-center gap-3">
                <h1 class="fw-black text-dark mb-1">BINGO REPORTS</h1>
                @if (TotalDbCount > 0)
                {
                    <span class="badge bg-light text-muted border fw-normal" style="font-size: 0.65rem;">@TotalDbCount TOTAL SESSIONS IN DB</span>
                }
            </div>
            <p class="text-muted">Financial audit and analysis for Bingo sessions.</p>
        </div>
        <div class="d-flex gap-2 align-items-center">
            <div class="input-group shadow-sm" style="width: 200px;">
                <span class="input-group-text bg-white border-end-0"><i class="bi bi-calendar-month"></i></span>
                <select class="form-select border-start-0 fw-bold" value="@SelectedMonth" @onchange="OnMonthChanged">
                    @for (int i = 1; i <= 12; i++)
                    {
                        <option value="@i">@DateTimeFormatInfo.CurrentInfo.GetMonthName(i)</option>
                    }
                </select>
            </div>
            <div class="input-group shadow-sm" style="width: 150px;">
                <select class="form-select fw-bold" value="@SelectedYear" @onchange="OnYearChanged">
                    @for (int y = DateTime.Now.Year; y >= DateTime.Now.Year - 5; y--)
                    {
                        <option value="@y">@y</option>
                    }
                </select>
            </div>
            <button class="btn btn-primary px-4 fw-black shadow-sm" @onclick="LoadData">REFRESH</button>
        </div>
    </div>

    <div class="d-flex gap-2 mb-4">
        <button class="btn @(ActiveTab == "Sessions" ? "btn-dark" : "btn-light") rounded-pill px-4 fw-bold" @onclick='() => ActiveTab = "Sessions"'>
            SESSION REPORTS
        </button>
        <button class="btn @(ActiveTab == "Audit" ? "btn-dark" : "btn-light") rounded-pill px-4 fw-bold" @onclick='() => ActiveTab = "Audit"'>
            FINANCIAL AUDIT
        </button>
        <button class="btn btn-primary rounded-pill px-4 fw-bold shadow-sm ms-2" @onclick='() => Navigation.NavigateTo("/admin/bingo/expenses")'>
            <i class="bi bi-cash-coin me-2"></i> RECORD EXPENSES
        </button>
    </div>

    <!-- STATS CARDS -->
    <div class="row g-3 mb-4">
        <div class="col-md-2">
            <div class="stat-card glass-card p-3 shadow-sm border-start border-primary border-4">
                <div class="text-muted extra-small fw-black text-uppercase">Total Gross</div>
                <div class="fs-4 fw-black text-dark">@TotalGross.ToString("C2")</div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="stat-card glass-card p-3 shadow-sm border-start border-danger border-4">
                <div class="text-muted extra-small fw-black text-uppercase">Prizes Paid</div>
                <div class="fs-4 fw-black text-dark">@TotalPrizes.ToString("C2")</div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="stat-card glass-card p-3 shadow-sm border-start border-warning border-4">
                <div class="text-muted extra-small fw-black text-uppercase">Lottery Tax</div>
                <div class="fs-4 fw-black text-dark">@TotalLottery.ToString("C2")</div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="stat-card glass-card p-3 shadow-sm border-start border-info border-4">
                <div class="text-muted extra-small fw-black text-uppercase">Rounding Adj.</div>
                <div class="fs-4 fw-black @(TotalRounding != 0 ? "text-primary" : "text-dark")">@TotalRounding.ToString("C2")</div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="stat-card glass-card p-3 shadow-sm border-start border-secondary border-4">
                <div class="text-muted extra-small fw-black text-uppercase">Expenses</div>
                <div class="fs-4 fw-black text-danger">@TotalExpenses.ToString("C2")</div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="stat-card glass-card p-3 shadow-sm border-start border-success border-4">
                <div class="text-muted extra-small fw-black text-uppercase">Net Account</div>
                <div class="fs-4 fw-black text-success">@NetAccount.ToString("C2")</div>
            </div>
        </div>
    </div>

    @if (Loading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-2 text-muted">Calculating Financials...</p>
        </div>
    }
    else if (ActiveTab == "Sessions")
    {
        if (!Sessions.Any())
        {
            <div class="text-center py-5 glass-card">
                <i class="bi bi-inbox text-muted fs-1"></i>
                <p class="mt-2 text-muted fw-bold">No Bingo sessions found for this period.</p>
                <div class="small text-muted">Checked @StartDate.ToString("MMMM yyyy") (@StartDate.ToString("d") - @EndDate.ToString("d"))</div>
                <div class="small text-muted">Total sessions in database: @TotalDbCount</div>
                <button class="btn btn-sm btn-dark mt-2" @onclick="LoadData">REFRESH DATA</button>
            </div>
        }
        else
        {
            <div class="glass-card shadow-sm overflow-hidden">
                <div class="table-responsive">
                    <table class="table table-hover mb-0 align-middle">
                        <thead class="bg-light">
                            <tr class="extra-small fw-black text-muted text-uppercase">
                                <th class="ps-4">Date</th>
                                <th>Admission</th>
                                <th>Gross Receipts</th>
                                <th>Prizes Paid</th>
                                <th>Lottery (5%)</th>
                                <th>Rounding</th>
                                <th>Club Take</th>
                                <th>Net Session</th>
                                <th class="pe-4 text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var session in Sessions)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <div class="fw-black text-dark">@session.SessionDate.ToShortDateString()</div>
                                        <div class="extra-small text-muted">@session.SessionDate.DayOfWeek</div>
                                    </td>
                                    <td><span class="badge bg-light text-dark border">@session.AdmissionCount</span></td>
                                    <td class="fw-bold">@session.TotalGrossReceipts.ToString("C2")</td>
                                    <td class="text-danger">@session.TotalPrizesPaid.ToString("C2")</td>
                                    <td class="text-warning fw-bold">@session.TotalLotteryTake.ToString("C2")</td>
                                    <td><span class="badge @(session.RoundingAdjustment != 0 ? "bg-info-subtle text-info" : "bg-light text-muted") border">@session.RoundingAdjustment.ToString("C2")</span></td>
                                    <td class="text-indigo fw-bold">@session.TotalClubTake.ToString("C2")</td>
                                    <td class="fw-black text-success">@((session.TotalGrossReceipts - session.TotalPrizesPaid - session.TotalLotteryTake - session.RoundingAdjustment).ToString("C2"))</td>
                                    <td class="pe-4 text-end">
                                        <button class="btn btn-sm btn-light rounded-pill px-3" @onclick="() => OpenDetail(session)">
                                            <i class="bi bi-eye me-1"></i> VIEW
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    }
    else if (ActiveTab == "Audit")
    {
        @if (!Transactions.Any())
        {
            <div class="text-center py-5 glass-card">
                <i class="bi bi-file-earmark-diff text-muted fs-1"></i>
                <p class="mt-2 text-muted fw-bold">No financial history found for this period.</p>
            </div>
        }
        else
        {
            @foreach (var dayGroup in Transactions.GroupBy(t => t.Date.Date).OrderByDescending(g => g.Key))
            {
                var dayProfit = dayGroup.Sum(t => t.Amount);
                var isExpanded = ExpandedDates.Contains(dayGroup.Key);

                <div class="glass-card shadow-sm border mb-3 overflow-hidden">
                    <!-- Day Header -->
                    <div class="p-3 d-flex justify-content-between align-items-center bg-light bg-opacity-25 cursor-pointer" 
                         @onclick="() => ToggleDate(dayGroup.Key)" style="cursor: pointer;">
                        <div class="d-flex align-items-center gap-3">
                            <div class="rounded-circle bg-white shadow-sm d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                                <i class="bi bi-calendar-event text-primary"></i>
                            </div>
                            <div>
                                <div class="fw-black text-dark fs-5">@dayGroup.Key.ToString("MMMM dd, yyyy")</div>
                                <div class="extra-small text-muted fw-bold text-uppercase">@dayGroup.Key.DayOfWeek • @dayGroup.Count() ENTRIES</div>
                            </div>
                        </div>
                        <div class="text-end d-flex align-items-center gap-4">
                            <div>
                                <div class="extra-small text-muted fw-black text-uppercase">Daily Net Result</div>
                                <div class="fw-black fs-4 @(dayProfit >= 0 ? "text-success" : "text-danger")">
                                    @(dayProfit >= 0 ? "+" : "")@dayProfit.ToString("C2")
                                </div>
                            </div>
                            <i class="bi @(isExpanded ? "bi-chevron-up" : "bi-chevron-down") text-muted"></i>
                        </div>
                    </div>

                    <!-- Collapsible Ledger -->
                    @if (isExpanded)
                    {
                        <div class="border-top bg-white">
                            <table class="table table-sm table-hover align-middle mb-0">
                                <thead class="bg-light">
                                    <tr class="extra-small text-muted fw-black text-uppercase">
                                        <th class="ps-4 py-2">Transaction Type</th>
                                        <th class="py-2">Source / Category</th>
                                        <th class="py-2">Description</th>
                                        <th class="text-end pe-4 py-2">Net Change</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var tx in dayGroup.OrderByDescending(t => t.Id))
                                    {
                                        <tr>
                                            <td class="ps-4">
                                                <div class="d-flex align-items-center gap-2">
                                                    @if (tx.Type == "Income") { <i class="bi bi-arrow-down-left-circle-fill text-success fs-5"></i> }
                                                    else if (tx.Type == "Prize") { <i class="bi bi-arrow-up-right-circle-fill text-danger fs-5"></i> }
                                                    else if (tx.Type == "Rounding") { <i class="bi bi-plus-slash-minus text-info fs-5"></i> }
                                                    else { <i class="bi bi-bank text-dark fs-5"></i> }
                                                    
                                                    <span class="fw-bold">
                                                        @(tx.Type == "Income" ? "Revenue Received" : 
                                                          tx.Type == "Prize" ? "Prizes Distributed" : 
                                                          tx.Type == "LotteryFee" ? "State Tax (Lottery)" : 
                                                          tx.Type == "Rounding" ? "Cash Adjustment" : "Expense")
                                                    </span>
                                                </div>
                                            </td>
                                            <td>
                                                @if (tx.CategoryId.HasValue && tx.Category != null)
                                                {
                                                    <span class="badge rounded-pill px-3" style="background-color: @(tx.Category.Color)20; color: @tx.Category.Color; border: 1px solid @(tx.Category.Color)40;">
                                                        <i class="bi @tx.Category.Icon me-1"></i> @tx.Category.Name
                                                    </span>
                                                }
                                                else if (tx.SessionId.HasValue)
                                                {
                                                    <span class="badge bg-primary-subtle text-primary border border-primary border-opacity-10 rounded-pill px-3">
                                                        <i class="bi bi-controller me-1"></i> BINGO SESSION #@tx.SessionId
                                                    </span>
                                                }
                                            </td>
                                            <td class="text-muted small">@tx.Description</td>
                                            <td class="text-end pe-4 fw-black @(tx.Amount >= 0 ? "text-success" : "text-danger")">
                                                @tx.Amount.ToString("C2")
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            }
        }
    }
    // Finance Logic removal - tab moved to dedicated page

</div>

@if (SelectedSession != null)
{
    <div class="modal fade show d-block" style="background: rgba(0,0,0,0.5); z-index: 1050;">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg" style="border-radius: 24px;">
                <div class="modal-header border-0 p-4 pb-0">
                    <div>
                        <h5 class="modal-title fw-black">BINGO SESSION DETAIL</h5>
                        <p class="text-muted small mb-0">@SelectedSession.SessionDate.ToLongDateString()</p>
                    </div>
                    <button type="button" class="btn-close" @onclick="() => SelectedSession = null"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="row g-3 mb-4">
                        <div class="col-md-7">
                            <h6 class="extra-small fw-black text-muted text-uppercase mb-2">Admission Breakdown</h6>
                            <div class="d-flex flex-wrap gap-2">
                                @if (SelectedSession.AdmissionEntries != null && SelectedSession.AdmissionEntries.Any())
                                {
                                    @foreach (var ae in SelectedSession.AdmissionEntries)
                                    {
                                        <div class="p-2 rounded-3 border bg-light d-flex align-items-center gap-2" style="min-width: 120px;">
                                            <div class="rounded-circle" style="width: 10px; height: 10px; background: @(ae.Definition?.DisplayColor ?? "#ccc")"></div>
                                            <div class="flex-grow-1">
                                                <div class="extra-small fw-bold text-muted line-height-1">@(ae.Definition?.Name ?? "Pack")</div>
                                                <div class="fw-black">@ae.Quantity <span class="extra-small text-muted fw-normal">@@ @ae.PriceAtTime.ToString("C0")</span></div>
                                            </div>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <div class="text-muted small italic">No admission details recorded.</div>
                                }
                            </div>
                        </div>
                        <div class="col-md-5">
                            <h6 class="extra-small fw-black text-muted text-uppercase mb-2">Financial Summary</h6>
                            <div class="glass-card p-4 border-0 shadow-sm position-relative overflow-hidden" style="background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);">
                                <!-- Subtle background decoration -->
                                <div class="position-absolute" style="top: -20px; right: -20px; width: 100px; height: 100px; background: rgba(13, 110, 253, 0.05); border-radius: 50%;"></div>
                                
                                <div class="d-flex justify-content-between mb-2">
                                    <span class="small text-muted">Admission Packs</span>
                                    <span class="fw-bold text-dark">@SelectedSession.AdmissionEntries.Sum(ae => ae.Quantity * ae.PriceAtTime).ToString("C2")</span>
                                </div>
                                <div class="d-flex justify-content-between mb-3 pb-2 border-bottom border-white border-opacity-50">
                                    <span class="small text-muted">Extra Sheets Sold</span>
                                    <span class="fw-bold text-dark">@SelectedSession.GameEntries.Where(ge => ge.PricePerSheet > 0).Sum(ge => ge.GrossReceipts).ToString("C2")</span>
                                </div>

                                <div class="d-flex justify-content-between mb-1">
                                    <span class="extra-small text-uppercase fw-black text-primary opacity-75">Gross Revenue</span>
                                    <span class="fw-black text-primary">@SelectedSession.TotalGrossReceipts.ToString("C2")</span>
                                </div>
                                <div class="d-flex justify-content-between mb-1">
                                    <span class="extra-small text-uppercase fw-black text-danger opacity-75">Prizes Paid</span>
                                    <span class="fw-bold text-danger">-@SelectedSession.TotalPrizesPaid.ToString("C2")</span>
                                </div>
                                <div class="d-flex justify-content-between mb-1">
                                    <span class="extra-small text-uppercase fw-black text-muted opacity-75">Lottery Tax (5%)</span>
                                    <span class="fw-bold text-muted">-@SelectedSession.TotalLotteryTake.ToString("C2")</span>
                                </div>
                                @if (SelectedSession.RoundingAdjustment != 0)
                                {
                                    <div class="d-flex justify-content-between mb-1">
                                        <span class="extra-small text-uppercase fw-black text-info opacity-75">Rounding Adj.</span>
                                        <span class="fw-bold text-info">@((-SelectedSession.RoundingAdjustment).ToString("C2"))</span>
                                    </div>
                                }
                                <div class="mt-3 pt-3 border-top border-white border-opacity-50 d-flex justify-content-between align-items-end">
                                    <div>
                                        <div class="extra-small fw-black text-muted text-uppercase mb-0">Net Profit</div>
                                        <div class="fw-black fs-4 text-success line-height-1">
                                            @((SelectedSession.TotalGrossReceipts - SelectedSession.TotalPrizesPaid - SelectedSession.TotalLotteryTake - SelectedSession.RoundingAdjustment).ToString("C2"))
                                        </div>
                                    </div>
                                    <i class="bi bi-graph-up-arrow text-success fs-3 opacity-25"></i>
                                </div>
                            </div>
                        </div>
                    </div>

                    <h6 class="extra-small fw-black text-muted text-uppercase mb-2">Game & Sheet Performance</h6>
                    <div class="table-responsive rounded-4 border overflow-hidden shadow-sm">
                        <table class="table table-hover table-sm mb-0 align-middle">
                            <thead class="bg-light">
                                <tr class="extra-small fw-black text-muted text-uppercase">
                                    <th class="ps-3">Sheet Color / Game</th>
                                    <th class="text-center" colspan="2" style="border-bottom: 2px solid rgba(0,0,0,0.05);">Sold</th>
                                    <th class="text-end">Price</th>
                                    <th class="text-end">Gross</th>
                                    <th class="text-end">Payout</th>
                                    <th class="text-end pe-3">Net</th>
                                </tr>
                                <tr class="extra-small fw-black text-muted text-uppercase" style="background: rgba(0,0,0,0.02);">
                                    <th class="ps-3" style="border-top: none;"></th>
                                    <th class="text-center" style="font-size: 0.55rem; width: 50px;">Pkg</th>
                                    <th class="text-center" style="font-size: 0.55rem; width: 50px; border-left: 1px solid rgba(0,0,0,0.05);">Extra</th>
                                    <th colspan="4" style="border-top: none;"></th>
                                </tr>
                            </thead>
                            <tbody>
                                     @foreach (var sheetDef in AllDefinitions.Where(d => d.ColorName != "Admission 9 (PACK)"))
                                     {
                                         var sheetEntries = SelectedSession.GameEntries.Where(e => e.SheetColor.Equals(sheetDef.ColorName, StringComparison.OrdinalIgnoreCase)).ToList();
                                         var gamesToDisplay = sheetDef.Games.Select(g => g.GameName).ToList();
                                         
                                         // If we have actual entries, use those as the primary source of game names 
                                         // (in case games were changed but we want to see historical data)
                                         if (sheetEntries.Any()) 
                                         {
                                             gamesToDisplay = sheetEntries.Select(e => e.GameName).Distinct().ToList();
                                         }
                                         else if (sheetDef.IsAdmissionOnly && SelectedSession.AdmissionCount == 0)
                                         {
                                             // If it's an admission-only sheet and there were NO admissions, skip it to avoid clutter
                                             continue;
                                         }

                                         foreach (var gameName in gamesToDisplay)
                                         {
                                             var gameEntries = sheetEntries.Where(e => e.GameName == gameName).ToList();
                                             var pkgEntry = gameEntries.FirstOrDefault(e => e.PricePerSheet == 0);
                                             var extraEntry = gameEntries.FirstOrDefault(e => e.PricePerSheet > 0);
                                             
                                             var totalSold = gameEntries.Sum(e => e.SheetsSold);
                                             var totalGross = gameEntries.Sum(e => e.GrossReceipts);
                                             var totalPrize = gameEntries.Sum(e => e.PrizePaid);
                                             var totalNet = gameEntries.Sum(e => e.NetProceeds);
                                             var price = extraEntry?.PricePerSheet ?? sheetDef.DefaultPrice;

                                             <tr class="@(extraEntry != null ? "bg-primary-subtle bg-opacity-10" : (gameEntries.Any() ? "" : "opacity-50"))">
                                                 <td class="ps-3 py-2">
                                                     <div class="d-flex align-items-center gap-2">
                                                         <div class="rounded-circle shadow-sm" style="width: 10px; height: 10px; background: @sheetDef.DisplayColor; border: 1px solid rgba(0,0,0,0.1);"></div>
                                                         <div class="d-flex flex-column">
                                                             <div class="fw-bold small text-dark">@sheetDef.ColorName.ToUpper() - @gameName</div>
                                                             @if (pkgEntry != null && extraEntry != null)
                                                             {
                                                                 <div class="extra-small text-indigo fw-black text-uppercase"><i class="bi bi-diagram-2-fill me-1"></i> Mixed</div>
                                                             }
                                                             else if (extraEntry != null)
                                                             {
                                                                 <div class="extra-small text-primary fw-black text-uppercase">Extra Sale</div>
                                                             }
                                                             else if (pkgEntry != null || sheetDef.IsIncludedInAdmission)
                                                             {
                                                                 <div class="extra-small text-muted opacity-75">Package</div>
                                                             }
                                                             else
                                                             {
                                                                 <div class="extra-small text-danger opacity-75">No Sales</div>
                                                             }
                                                         </div>
                                                     </div>
                                                 </td>
                                                 <td class="small text-center text-muted">
                                                     @if (pkgEntry != null) { @pkgEntry.SheetsSold }
                                                     else if (sheetDef.IsIncludedInAdmission) { @SelectedSession.AdmissionCount }
                                                     else { @("-") }
                                                 </td>
                                                 <td class="small text-center @(extraEntry != null ? "fw-bold" : "text-muted")" style="border-left: 1px solid rgba(0,0,0,0.05);">
                                                     @(extraEntry?.SheetsSold ?? 0)
                                                 </td>
                                                 <td class="small text-end @(extraEntry != null ? "fw-bold text-primary" : "text-muted")">
                                                     @((extraEntry != null || !sheetDef.IsAdmissionOnly) ? price.ToString("C2") : "-")
                                                 </td>
                                                 <td class="small text-end @(totalGross > 0 ? "fw-bold" : "text-muted")">@totalGross.ToString("C2")</td>
                                                 <td class="small text-end @(totalPrize > 0 ? "text-danger fw-bold" : "text-muted")">@totalPrize.ToString("C2")</td>
                                                 <td class="small text-end @(totalNet > 0 ? "fw-black text-success" : "text-muted") pe-3">@totalNet.ToString("C2")</td>
                                             </tr>
                                         }
                                     }
                                    <tr class="bg-light fw-black small border-top-2">
                                        <td class="ps-3 py-2">SESSION TOTALS</td>
                                        <td class="text-center text-muted">-</td>
                                        <td class="text-center border-left">@SelectedSession.GameEntries.Where(e => e.PricePerSheet > 0).Sum(e => e.SheetsSold)</td>
                                        <td class="text-end"></td>
                                        <td class="text-end">@SelectedSession.GameEntries.Sum(e => e.GrossReceipts).ToString("C2")</td>
                                        <td class="text-end text-danger">@SelectedSession.GameEntries.Sum(e => e.PrizePaid).ToString("C2")</td>
                                        <td class="text-end text-success pe-3">@SelectedSession.TotalClubTake.ToString("C2")</td>
                                    </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@if (ShowCategoryModal)
{
    // Category modal moved to dedicated expense page
}

<style>
    .extra-small { font-size: 0.65rem; }
    .glass-card {
        background: rgba(255, 255, 255, 0.7);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.2);
        border-radius: 16px;
    }
    .text-indigo { color: #4c6ef5; }
</style>

@code {
    private string ActiveTab { get; set; } = "Sessions";
    private bool Loading { get; set; } = true;
    private int SelectedMonth { get; set; } = DateTime.Today.Month;
    private int SelectedYear { get; set; } = DateTime.Today.Year;
    private DateTime StartDate => new DateTime(SelectedYear, SelectedMonth, 1);
    private DateTime EndDate => StartDate.AddMonths(1).AddDays(-1);
    private List<BingoSession> Sessions = new();
    private List<BingoSheetDefinition> AllDefinitions = new();
    private BingoSession? SelectedSession;
    private List<BingoLotteryTransaction> Transactions { get; set; } = new();
    private int TotalDbCount { get; set; }

    // Finance Logic
    private List<BingoExpenseCategory> ExpenseCategories { get; set; } = new();
    private decimal AccountBalance { get; set; }
    private bool ShowCategoryModal { get; set; }
    private HashSet<DateTime> ExpandedDates { get; set; } = new();

    private void ToggleDate(DateTime date)
    {
        if (ExpandedDates.Contains(date)) ExpandedDates.Remove(date);
        else ExpandedDates.Add(date);
    }

    private decimal TotalGross => Sessions.Sum(s => s.TotalGrossReceipts);
    private decimal TotalPrizes => Sessions.Sum(s => s.TotalPrizesPaid);
    private decimal TotalLottery => Sessions.Sum(s => s.TotalLotteryTake);
    private decimal TotalRounding => Sessions.Sum(s => s.RoundingAdjustment);
    private decimal TotalExpenses => Math.Abs(Transactions.Where(t => t.Type == "Expense").Sum(t => t.Amount));
    private decimal NetAccount => Transactions.Sum(t => t.Amount);

    protected override async Task OnInitializedAsync()
    {
        if (!await HasAccess()) 
        {
            Navigation.NavigateTo("/access-denied");
            return;
        }
        await LoadData();
    }

    private async Task<bool> HasAccess()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        if (user.IsInRole("Admin")) return true;

        var userIdClaim = user.FindFirst("UserId") ?? user.FindFirst(ClaimTypes.NameIdentifier);
        if (userIdClaim != null && int.TryParse(userIdClaim.Value, out var userId))
        {
            var permissions = UserService.GetUserPagePermissions(userId);
            return permissions.Any(p => p.PageRoute == "/admin/bingo");
        }
        return false;
    }

    private async Task OnMonthChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var month))
        {
            SelectedMonth = month;
            await LoadData();
        }
    }

    private async Task OnYearChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var year))
        {
            SelectedYear = year;
            await LoadData();
        }
    }

    private async Task LoadData()
    {
        Loading = true;
        
        var endOfDate = EndDate.Date.AddDays(1).AddTicks(-1);
        
        AllDefinitions = await DbContext.BingoSheetDefinitions
            .Include(d => d.Games)
            .Where(d => !d.IsDeleted && d.IsActive)
            .OrderBy(d => d.DisplayOrder)
            .ToListAsync();

        Sessions = await DbContext.BingoSessions
            .AsNoTracking()
            .Include(s => s.GameEntries)
            .Include(s => s.AdmissionEntries)
                .ThenInclude(ae => ae.Definition)
            .Where(s => s.SessionDate >= StartDate.Date && s.SessionDate <= endOfDate && !s.IsDeleted)
            .OrderByDescending(s => s.SessionDate)
            .ToListAsync();

        TotalDbCount = await DbContext.BingoSessions.CountAsync();

        Transactions = await DbContext.BingoLotteryTransactions
            .AsNoTracking()
            .Include(t => t.Category)
            .Where(t => !t.IsDeleted && t.Date >= StartDate.Date && t.Date <= endOfDate)
            .OrderByDescending(t => t.Date)
            .ThenByDescending(t => t.Id)
            .ToListAsync();
            
        AccountBalance = Transactions.Sum(t => t.Amount);
        
        // Apply range filter for display
        // Transactions are now filtered in the database query above

        ExpenseCategories = await DbContext.BingoExpenseCategories.Where(c => !c.IsDeleted).ToListAsync();

        Loading = false;
    }

    private void OpenDetail(BingoSession session)
    {
        SelectedSession = session;
    }

