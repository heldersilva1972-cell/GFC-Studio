@page "/admin/pos-devices"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

<PageTitle>Terminal Management | GFC</PageTitle>

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-0 fw-bold">Terminal Management</h1>
            <p class="text-muted">Register, update, and manage POS tablets and hardware.</p>
        </div>
        <button class="btn btn-outline-primary rounded-pill px-4 shadow-sm" disabled>
            <i class="bi bi-broadcast me-2"></i> Pair New Terminal
        </button>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="card border-0 shadow-sm rounded-4 p-5 text-center bg-white h-100">
                <div class="py-5">
                    <i class="bi bi-tablet-landscape fs-1 text-primary opacity-25 mb-3 d-block"></i>
                    <h4 class="fw-bold">No Devices Paired</h4>
                    <p class="text-muted small">Pair your first Android/iOS tablet to start taking orders offline.</p>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .rounded-4 { border-radius: 1rem !important; }
</style>
