@code {
    private HallRentalRequest _request = new()
    {
        EventDate = DateTime.Today.AddDays(14),
        StartTime = "2:00 PM",
        EndTime = "7:00 PM",
        GuestCount = 50,
        MemberStatus = false
    };

    private HallRentalRequest _inquiryModel = new()
    {
        EventDate = DateTime.Today.AddDays(30),
        EventType = "General Inquiry"
    };

    private string _activeFormMode = "book"; // "book" or "inquiry"
    private bool _showInquiryModal = false;
    private bool _isInquirySubmitting = false;
    private bool _isInquirySubmitted = false;
    private string? _inquiryErrorMessage;

    private WebsiteSettings? _settings;
    private List<RentalRoomOption> _availableRooms = new();
    private List<RentalAddonOption> _availableAddons = new();
    private List<RentalPolicyItem> _policies = new();
    private HashSet<string> _selectedAddonIds = new();
    private HashSet<string> _agreedPolicyIds = new();
    private Dictionary<string, bool> _questionAnswers = new();

    private readonly List<string> _timeOptions = new()
    {
        "6:00 AM", "6:30 AM", "7:00 AM", "7:30 AM",
        "8:00 AM", "8:30 AM", "9:00 AM", "9:30 AM",
        "10:00 AM", "10:30 AM", "11:00 AM", "11:30 AM",
        "12:00 PM", "12:30 PM", "1:00 PM", "1:30 PM",
        "2:00 PM", "2:30 PM", "3:00 PM", "3:30 PM",
        "4:00 PM", "4:30 PM", "5:00 PM", "5:30 PM",
        "6:00 PM", "6:30 PM", "7:00 PM", "7:30 PM",
        "8:00 PM", "8:30 PM", "9:00 PM", "9:30 PM",
        "10:00 PM", "10:30 PM", "11:00 PM", "11:30 PM",
        "12:00 Midnight"
    };

    private readonly List<string> _eventTypeOptions = new()
    {
        "Birthday Party",
        "Wedding",
        "Anniversary Party",
        "Bereavement / Memorial / Collation",
        "Business Meeting / Corporate Event",
        "Fundraiser / Charity Event",
        "Holiday Party",
        "Baby / Bridal Shower",
        "Christening / Baptism",
        "Graduation Party",
        "Retirement Party",
        "Reunion",
        "Other Celebration / Event"
    };

    private List<UnavailableDateDto> _unavailableDates = new();
    private string? _selectedTierCardId;
    private string? _selectedSubGroupId;

    // Do I Qualify? Modal & Verification State
    private bool _showQualificationModal = false;
    private PricingTierCardConfig? _evaluatingTierCard;
    private Dictionary<string, bool> _tempQualificationAnswers = new();
    private Dictionary<string, Dictionary<string, bool>> _qualificationAnswers = new(); // CardId -> (QuestionId -> Bool)
    private bool _isEditingSection1 = false;

    private bool _isEmbedded = false;
    private bool _isSubmitting = false;
    private bool _isSubmitted = false;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);
        if (query.TryGetValue("embed", out var embedVal) && embedVal == "true")
        {
            _isEmbedded = true;
        }

        if (query.TryGetValue("mode", out var modeVal) && !string.IsNullOrWhiteSpace(modeVal))
        {
            if (string.Equals(modeVal, "inquiry", StringComparison.OrdinalIgnoreCase))
            {
                _activeFormMode = "inquiry";
            }
            else
            {
                _activeFormMode = "book";
            }
        }

        if (query.TryGetValue("date", out var dateVal) && DateTime.TryParse(dateVal, out var parsedDate))
        {
            _request.EventDate = parsedDate;
            _inquiryModel.EventDate = parsedDate;
        }

        try
        {
            _settings = await WebsiteSettingsService.GetWebsiteSettingsAsync();
            _availableRooms = _settings.GetRoomsList();
            _availableAddons = _settings.GetAddonsList();
            _policies = _settings.GetPoliciesList();

            try
            {
                _unavailableDates = await RentalService.GetUnavailableDatesAsync();
            }
            catch (Exception)
            {
                _unavailableDates = new List<UnavailableDateDto>();
            }

            // If a valid category/tier card is available for this date, pre-select the first available one that DOES NOT require qualification
            var activeTierCards = (_settings?.GetTierCardsList() ?? WebsiteSettings.GetDefaultTierCards()).Where(c => c.IsEnabled).ToList();
            if (activeTierCards.Count > 0 && string.IsNullOrEmpty(_selectedTierCardId))
            {
                var availableCard = activeTierCards.FirstOrDefault(c => IsCardAvailableForDate(c, _request.EventDate) && (c.Qualification == null || !c.Qualification.IsEnabled))
                                 ?? activeTierCards.FirstOrDefault(c => c.Qualification == null || !c.Qualification.IsEnabled)
                                 ?? activeTierCards.FirstOrDefault();
                if (availableCard != null && (availableCard.Qualification == null || !availableCard.Qualification.IsEnabled))
                {
                    ApplyTierCardSelection(availableCard);
                }
            }

            var displayed = GetDisplayedRooms();
            if (displayed.Count > 0 && string.IsNullOrEmpty(_request.RoomSelected))
            {
                var defaultRoom = displayed.FirstOrDefault(r => r.IsDefault) ?? displayed[0];
                _request.RoomSelected = defaultRoom.Name;
            }

            ApplyDefaultSlotForDate();
            RecalculatePricing();
        }
        catch (Exception ex)
        {
            _errorMessage = "Could not load club settings: " + ex.Message;
        }
    }

    private bool IsSlotBooked(DayScheduleSlotConfig slot)
    {
        var targetDate = _request.EventDate.Date;
        var dayEvents = _unavailableDates.Where(d => d.Date.Date == targetDate).ToList();
        if (!dayEvents.Any()) return false;

        var slotStart = ParseTimeToMinutes(slot.StartTime);
        var slotEnd = ParseTimeToMinutes(slot.EndTime);
        if (slotStart < 0 || slotEnd < 0) return false;

        foreach (var ev in dayEvents)
        {
            if (string.IsNullOrWhiteSpace(ev.EventTime))
            {
                // Full day booking or blackout date
                return true;
            }

            var parts = ev.EventTime.Split('-', StringSplitOptions.TrimEntries);
            if (parts.Length == 2)
            {
                var evStart = ParseTimeToMinutes(parts[0]);
                var evEnd = ParseTimeToMinutes(parts[1]);

                if (evStart >= 0 && evEnd >= 0)
                {
                    // Check interval overlap: [slotStart, slotEnd) overlaps [evStart, evEnd)
                    if (slotStart < evEnd && slotEnd > evStart)
                    {
                        return true;
                    }
                }
                else
                {
                    // Could not parse times, treat as conflicting
                    return true;
                }
            }
            else
            {
                return true;
            }
        }

        return false;
    }

    private bool IsCurrentSelectionBooked()
    {
        if (string.IsNullOrEmpty(_selectedTierCardId)) return false;

        var tierCards = _settings?.GetTierCardsList() ?? WebsiteSettings.GetDefaultTierCards();
        var card = tierCards.FirstOrDefault(c => c.Id == _selectedTierCardId);

        if (card != null && !IsCardAvailableForDate(card, _request.EventDate)) return true;

        var activeSlots = GetActiveTimeSlots();
        if (activeSlots.Count > 0)
        {
            var matchingSlot = activeSlots.FirstOrDefault(s => s.StartTime == _request.StartTime && s.EndTime == _request.EndTime);
            if (matchingSlot == null) return true;
            return IsSlotBooked(matchingSlot);
        }

        // For custom times, check interval directly
        var targetDate = _request.EventDate.Date;
        var dayEvents = _unavailableDates.Where(d => d.Date.Date == targetDate).ToList();
        if (!dayEvents.Any()) return false;

        var startMin = ParseTimeToMinutes(_request.StartTime);
        var endMin = ParseTimeToMinutes(_request.EndTime);
        if (startMin < 0 || endMin < 0) return false;

        foreach (var ev in dayEvents)
        {
            if (string.IsNullOrWhiteSpace(ev.EventTime)) return true;
            var parts = ev.EventTime.Split('-', StringSplitOptions.TrimEntries);
            if (parts.Length == 2)
            {
                var evStart = ParseTimeToMinutes(parts[0]);
                var evEnd = ParseTimeToMinutes(parts[1]);
                if (evStart >= 0 && evEnd >= 0 && startMin < evEnd && endMin > evStart)
                {
                    return true;
                }
            }
            else return true;
        }

        return false;
    }

    private List<DayScheduleSlotConfig> GetActiveTimeSlots()
    {
        var dayConfig = GetCurrentDayConfig();
        if (dayConfig != null && dayConfig.Slots != null && dayConfig.Slots.Count > 0)
        {
            return dayConfig.Slots.Where(s => s.IsActive).ToList();
        }
        return new List<DayScheduleSlotConfig>();
    }

    private void ApplyDefaultSlotForDate()
    {
        var activeSlots = GetActiveTimeSlots();
        if (activeSlots.Count > 0)
        {
            var firstAvailableSlot = activeSlots.FirstOrDefault(s => !IsSlotBooked(s));
            if (firstAvailableSlot != null)
            {
                _request.StartTime = firstAvailableSlot.StartTime;
                _request.EndTime = firstAvailableSlot.EndTime;
            }
            else
            {
                _request.StartTime = string.Empty;
                _request.EndTime = string.Empty;
            }
        }
        else
        {
            // Open booking (custom hours): ensure standard defaults exist if empty
            if (string.IsNullOrEmpty(_request.StartTime))
            {
                _request.StartTime = "2:00 PM";
            }
            if (string.IsNullOrEmpty(_request.EndTime))
            {
                int baseHours = _settings?.BaseFunctionHours ?? 5;
                var startMin = ParseTimeToMinutes(_request.StartTime);
                if (startMin >= 0)
                {
                    int endMin = startMin + (baseHours * 60);
                    _request.EndTime = FormatMinutesToTimeString(endMin);
                }
                else
                {
                    _request.EndTime = "7:00 PM";
                }
            }
        }
    }

    private static string FormatMinutesToTimeString(int minutes)
    {
        int hour24 = (minutes / 60) % 24;
        int min = minutes % 60;
        string ampm = hour24 >= 12 ? "PM" : "AM";
        int hour12 = hour24 % 12;
        if (hour12 == 0) hour12 = 12;
        return $"{hour12}:{min:D2} {ampm}";
    }

    private DayOfWeekScheduleConfig? GetCurrentDayConfig()
    {
        var dayConfigs = _settings?.GetDaySchedulesList();
        return dayConfigs?.FirstOrDefault(d => d.DayOfWeek == _request.EventDate.DayOfWeek);
    }

    private List<RentalRoomOption> GetDisplayedRooms()
    {
        var dayConfig = GetCurrentDayConfig();
        if (dayConfig != null && dayConfig.AllowedRoomNames != null && dayConfig.AllowedRoomNames.Count > 0)
        {
            if (dayConfig.AllowedRoomNames.Contains("__NONE__")) return new List<RentalRoomOption>();
            var filtered = _availableRooms
                .Where(r => dayConfig.AllowedRoomNames.Contains(r.Name, StringComparer.OrdinalIgnoreCase))
                .ToList();
            return filtered;
        }
        return _availableRooms;
    }

    private void SelectTimeSlot(DayScheduleSlotConfig slot)
    {
        if (IsSlotBooked(slot)) return;
        _request.StartTime = slot.StartTime;
        _request.EndTime = slot.EndTime;
        RecalculatePricing();
    }

    private void SelectTierCard(PricingTierCardConfig card)
    {
        // If this tier card requires qualification and has not been qualified yet, pop up the qualification questionnaire modal
        if (card.Qualification != null && card.Qualification.IsEnabled)
        {
            if (!_qualificationAnswers.ContainsKey(card.Id))
            {
                _evaluatingTierCard = card;
                _tempQualificationAnswers = new Dictionary<string, bool>();
                _isEditingSection1 = false;
                _showQualificationModal = true;
                StateHasChanged();
                return;
            }
        }

        ApplyTierCardSelection(card);
    }

    private void ReopenQualificationModal(PricingTierCardConfig card)
    {
        _evaluatingTierCard = card;
        _tempQualificationAnswers = _qualificationAnswers.TryGetValue(card.Id, out var existing)
            ? new Dictionary<string, bool>(existing)
            : new Dictionary<string, bool>();
        _isEditingSection1 = false;
        _showQualificationModal = true;
        StateHasChanged();
    }

    private void SetTempAnswer(string questionId, bool isYes, bool isSection1 = false)
    {
        if (isSection1 && isYes && _evaluatingTierCard?.Qualification != null)
        {
            int minSec1Yes = _evaluatingTierCard.Qualification.Section1MinRequiredYes > 0 ? _evaluatingTierCard.Qualification.Section1MinRequiredYes : 1;
            if (minSec1Yes == 1)
            {
                // If only 1 is required, clear other Section 1 YES answers to focus on the selected one
                var sec1Ids = _evaluatingTierCard.Qualification.Section1Questions.Select(q => q.Id).ToHashSet();
                foreach (var id in sec1Ids)
                {
                    if (id != questionId)
                    {
                        _tempQualificationAnswers[id] = false;
                    }
                }
                _isEditingSection1 = false;
            }
        }

        _tempQualificationAnswers[questionId] = isYes;
        StateHasChanged();
    }

    private void CancelQualificationModal()
    {
        _showQualificationModal = false;
        _evaluatingTierCard = null;
        StateHasChanged();
    }

    private void ConfirmQualificationAndSelectRate()
    {
        if (_evaluatingTierCard == null) return;

        _qualificationAnswers[_evaluatingTierCard.Id] = new Dictionary<string, bool>(_tempQualificationAnswers);
        _showQualificationModal = false;
        ApplyTierCardSelection(_evaluatingTierCard);
        _evaluatingTierCard = null;
        StateHasChanged();
    }

    private void SwitchToNonMemberTier()
    {
        _showQualificationModal = false;
        _evaluatingTierCard = null;

        var tierCards = _settings?.GetTierCardsList() ?? WebsiteSettings.GetDefaultTierCards();
        // Look for Non-Member tier card first, or the first card that does not require qualification
        var nonMemberCard = tierCards.FirstOrDefault(c => 
            (c.AssociatedRenterType != null && c.AssociatedRenterType.Contains("Non", StringComparison.OrdinalIgnoreCase)) ||
            (c.Title != null && c.Title.Contains("Non", StringComparison.OrdinalIgnoreCase)))
            ?? tierCards.FirstOrDefault(c => c.Qualification == null || !c.Qualification.IsEnabled)
            ?? tierCards.FirstOrDefault();

        if (nonMemberCard != null)
        {
            ApplyTierCardSelection(nonMemberCard);
        }
        StateHasChanged();
    }

    private void ApplyTierCardSelection(PricingTierCardConfig card)
    {
        _selectedTierCardId = card.Id;
        _selectedSubGroupId = null; // reset sub group when changing card
        _request.RenterType = card.AssociatedRenterType ?? card.Title;
        _request.MemberStatus = string.Equals(card.AssociatedRenterType, "Member", StringComparison.OrdinalIgnoreCase);
        RecalculatePricing();
    }

    private void OnSubGroupChanged(ChangeEventArgs e)
    {
        _selectedSubGroupId = e.Value?.ToString();
        RecalculatePricing();
    }

    private bool IsCurrentCategoryUnavailableOnDay()
    {
        var dayConfig = GetCurrentDayConfig();
        if (dayConfig != null && !dayConfig.IsAvailable) return true;

        if (string.IsNullOrEmpty(_selectedTierCardId)) return false;
        var currentCard = (_settings?.GetTierCardsList() ?? WebsiteSettings.GetDefaultTierCards()).FirstOrDefault(c => c.Id == _selectedTierCardId);
        return currentCard != null && !IsCardAvailableForDate(currentCard, _request.EventDate);
    }

    private static bool IsCardAvailableForDate(PricingTierCardConfig card, DateTime date)
    {
        return date.DayOfWeek switch
        {
            DayOfWeek.Monday => card.MondayAvailable,
            DayOfWeek.Tuesday => card.TuesdayAvailable,
            DayOfWeek.Wednesday => card.WednesdayAvailable,
            DayOfWeek.Thursday => card.ThursdayAvailable,
            DayOfWeek.Friday => card.FridayAvailable,
            DayOfWeek.Saturday => card.SaturdayAvailable,
            DayOfWeek.Sunday => card.SundayAvailable,
            _ => false
        };
    }

    private static decimal GetCardRateForDate(PricingTierCardConfig card, DateTime date)
    {
        return date.DayOfWeek switch
        {
            DayOfWeek.Monday => card.MondayRate,
            DayOfWeek.Tuesday => card.TuesdayRate,
            DayOfWeek.Wednesday => card.WednesdayRate,
            DayOfWeek.Thursday => card.ThursdayRate,
            DayOfWeek.Friday => card.FridayRate,
            DayOfWeek.Saturday => card.SaturdayRate,
            DayOfWeek.Sunday => card.SundayRate,
            _ => card.SaturdayRate
        };
    }

    private void SetMemberStatus(bool isMember)
    {
        _request.MemberStatus = isMember;
        _request.RenterType = isMember ? "Member" : "Non-Member";
        RecalculatePricing();
    }

    private void SelectRoom(string roomName)
    {
        _request.RoomSelected = roomName;
        RecalculatePricing();
    }

    private async Task OnDateChanged(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out var dt))
        {
            _request.EventDate = dt;

            try
            {
                _unavailableDates = await RentalService.GetUnavailableDatesAsync();
            }
            catch { }

            var displayed = GetDisplayedRooms();
            if (displayed.Count > 0 && !displayed.Any(r => r.Name.Equals(_request.RoomSelected, StringComparison.OrdinalIgnoreCase)))
            {
                var defaultRoom = displayed.FirstOrDefault(r => r.IsDefault) ?? displayed[0];
                _request.RoomSelected = defaultRoom.Name;
            }

            ApplyDefaultSlotForDate();
            RecalculatePricing();
        }
    }

