    private string GetSwitchToDesktopUrl()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);
        var queryParams = new Dictionary<string, string?>();
        foreach (var kvp in query)
        {
            if (!string.Equals(kvp.Key, "view", StringComparison.OrdinalIgnoreCase))
            {
                queryParams[kvp.Key] = kvp.Value.ToString();
            }
        }
        return Microsoft.AspNetCore.WebUtilities.QueryHelpers.AddQueryString("/rentals/apply", queryParams);
    }

