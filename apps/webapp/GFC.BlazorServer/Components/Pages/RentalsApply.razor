    protected override async Task OnInitializedAsync()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);
        if (query.TryGetValue("view", out var viewVal) && !string.IsNullOrWhiteSpace(viewVal))
        {
            _viewMode = viewVal.ToString();
        }

        if (query.TryGetValue("embed", out var embedVal) && embedVal == "true")
        {
            _isEmbedded = true;
        }

        if (query.TryGetValue("mode", out var modeVal) && !string.IsNullOrWhiteSpace(modeVal))
        {
            if (string.Equals(modeVal, "inquiry", StringComparison.OrdinalIgnoreCase))
            {
                _activeFormMode = "inquiry";
            }
            else
            {
                _activeFormMode = "book";
            }
        }

        if (query.TryGetValue("date", out var dateVal) && DateTime.TryParse(dateVal, out var parsedDate))
        {
            _request.EventDate = parsedDate;
        }

        try
        {
            _settings = await WebsiteSettingsService.GetWebsiteSettingsAsync();
            _availableRooms = _settings.GetRoomsList();
            _availableAddons = _settings.GetAddonsList();
            _policies = _settings.GetPoliciesList();

            try
            {
                _unavailableDates = await RentalService.GetUnavailableDatesAsync();
            }
            catch (Exception)
            {
                _unavailableDates = new List<UnavailableDateDto>();
            }

            // If a valid category/tier card is available for this date, pre-select the first available one that DOES NOT require qualification
            var activeTierCards = (_settings?.GetTierCardsList() ?? WebsiteSettings.GetDefaultTierCards()).Where(c => c.IsEnabled).ToList();
            if (activeTierCards.Count > 0 && string.IsNullOrEmpty(_selectedTierCardId))
            {
                var availableCard = activeTierCards.FirstOrDefault(c => IsCardAvailableForDate(c, _request.EventDate) && (c.Qualification == null || !c.Qualification.IsEnabled))
                                 ?? activeTierCards.FirstOrDefault(c => c.Qualification == null || !c.Qualification.IsEnabled)
                                 ?? activeTierCards.FirstOrDefault();
                if (availableCard != null && (availableCard.Qualification == null || !availableCard.Qualification.IsEnabled))
                {
                    ApplyTierCardSelection(availableCard);
                }
            }

            var displayed = GetDisplayedRooms();
            if (displayed.Count > 0 && string.IsNullOrEmpty(_request.RoomSelected))
            {
                var defaultRoom = displayed.FirstOrDefault(r => r.IsDefault) ?? displayed[0];
                _request.RoomSelected = defaultRoom.Name;
            }

            ApplyDefaultSlotForDate();
            RecalculatePricing();
        }
        catch (Exception ex)
        {
            _errorMessage = "Could not load club settings: " + ex.Message;
        }
    }

    private bool IsSlotBooked(DayScheduleSlotConfig slot)
    {
        var targetDate = _request.EventDate.Date;
        var dayEvents = _unavailableDates.Where(d => d.Date.Date == targetDate).ToList();
        if (!dayEvents.Any()) return false;

        var slotStart = ParseTimeToMinutes(slot.StartTime);
        var slotEnd = ParseTimeToMinutes(slot.EndTime);
        if (slotStart < 0 || slotEnd < 0) return false;

        foreach (var ev in dayEvents)
        {
            if (string.IsNullOrWhiteSpace(ev.EventTime))
            {
                // Full day booking or blackout date
                return true;
            }

            var parts = ev.EventTime.Split('-', StringSplitOptions.TrimEntries);
            if (parts.Length == 2)
            {
                var evStart = ParseTimeToMinutes(parts[0]);
                var evEnd = ParseTimeToMinutes(parts[1]);

                if (evStart >= 0 && evEnd >= 0)
                {
                    // Check interval overlap: [slotStart, slotEnd) overlaps [evStart, evEnd)
                    if (slotStart < evEnd && slotEnd > evStart)
                    {
                        return true;
                    }
                }
                else
                {
                    // Could not parse times, treat as conflicting
                    return true;
                }
            }
            else
            {
                return true;
            }
        }

        return false;
    }

    private bool IsCurrentSelectionBooked()
    {
        if (string.IsNullOrEmpty(_selectedTierCardId)) return false;

        var tierCards = _settings?.GetTierCardsList() ?? WebsiteSettings.GetDefaultTierCards();
        var card = tierCards.FirstOrDefault(c => c.Id == _selectedTierCardId);

        if (card != null && !IsCardAvailableForDate(card, _request.EventDate)) return true;

        var activeSlots = GetActiveTimeSlots();
        if (activeSlots.Count > 0)
        {
            var matchingSlot = activeSlots.FirstOrDefault(s => s.StartTime == _request.StartTime && s.EndTime == _request.EndTime);
            if (matchingSlot == null) return true;
            return IsSlotBooked(matchingSlot);
        }

        // For custom times, check interval directly
        var targetDate = _request.EventDate.Date;
        var dayEvents = _unavailableDates.Where(d => d.Date.Date == targetDate).ToList();
        if (!dayEvents.Any()) return false;

        var startMin = ParseTimeToMinutes(_request.StartTime);
        var endMin = ParseTimeToMinutes(_request.EndTime);
        if (startMin < 0 || endMin < 0) return false;

        foreach (var ev in dayEvents)
        {
            if (string.IsNullOrWhiteSpace(ev.EventTime)) return true;
            var parts = ev.EventTime.Split('-', StringSplitOptions.TrimEntries);
            if (parts.Length == 2)
            {
                var evStart = ParseTimeToMinutes(parts[0]);
                var evEnd = ParseTimeToMinutes(parts[1]);
                if (evStart >= 0 && evEnd >= 0 && startMin < evEnd && endMin > evStart)
                {
                    return true;
                }
            }
            else return true;
        }

        return false;
    }

    private List<DayScheduleSlotConfig> GetActiveTimeSlots()
    {
        var dayConfig = GetCurrentDayConfig();
        if (dayConfig != null && dayConfig.Slots != null && dayConfig.Slots.Count > 0)
        {
            return dayConfig.Slots.Where(s => s.IsActive).ToList();
        }
        return new List<DayScheduleSlotConfig>();
    }

    private void ApplyDefaultSlotForDate()
    {
        var activeSlots = GetActiveTimeSlots();
        if (activeSlots.Count > 0)
        {
            // Do not preselect any slot; require the applicant to choose their desired slot
            _request.StartTime = string.Empty;
            _request.EndTime = string.Empty;
        }
        else
        {
            // Open booking (custom hours): ensure standard defaults exist if empty
            if (string.IsNullOrEmpty(_request.StartTime))
            {
                _request.StartTime = "2:00 PM";
            }
            if (string.IsNullOrEmpty(_request.EndTime))
            {
                int baseHours = _settings?.BaseFunctionHours ?? 5;
                var startMin = ParseTimeToMinutes(_request.StartTime);
                if (startMin >= 0)
                {
                    int endMin = startMin + (baseHours * 60);
                    _request.EndTime = FormatMinutesToTimeString(endMin);
                }
                else
                {
                    _request.EndTime = "7:00 PM";
                }
            }
        }
    }

    private static string FormatMinutesToTimeString(int minutes)
    {
        int hour24 = (minutes / 60) % 24;
        int min = minutes % 60;
        string ampm = hour24 >= 12 ? "PM" : "AM";
        int hour12 = hour24 % 12;
        if (hour12 == 0) hour12 = 12;
        return $"{hour12}:{min:D2} {ampm}";
    }

    private DayOfWeekScheduleConfig? GetCurrentDayConfig()
    {
        var dayConfigs = _settings?.GetDaySchedulesList();
        return dayConfigs?.FirstOrDefault(d => d.DayOfWeek == _request.EventDate.DayOfWeek);
