@page "/rentals/apply"
@using GFC.Core.Models
@using GFC.BlazorServer.Services
@using GFC.Core.Interfaces
@inject IRentalService RentalService
@inject GFC.Core.Interfaces.IWebsiteSettingsService WebsiteSettingsService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]

<div class="gfc-public-rental-page @(_isEmbedded ? "embedded-mode" : "fullpage-mode")">
    <div class="container @(_isEmbedded ? "p-0" : "py-4")" style="max-width: 860px;">
        @if (!_isEmbedded)
        {
            <div class="text-center mb-4 gfc-hero-header">
                <h2 class="club-title fw-bold text-dark mb-1">
                    <i class="bi bi-building text-primary me-2"></i>@(_settings?.RentalFormSubtitle ?? "Gloucester Fraternity Club")
                </h2>
                <h5 class="club-subtitle text-muted mb-0">@(_settings?.RentalFormTitle ?? "Hall Rental Application")</h5>
                <p class="small text-secondary mt-1">@(_settings?.RentalFormIntroText ?? "27 Webster Street, Gloucester, MA 01930 | (978) 283-2889")</p>
            </div>
        }

        @if (_isSubmitted)
        {
            <div class="card shadow-sm border-0 submission-success-card text-center p-5">
                <div class="success-icon mb-3">
                    <i class="bi bi-check-circle-fill text-success" style="font-size: 4rem;"></i>
                </div>
                <h3 class="fw-bold text-dark mb-2">Application Submitted Successfully!</h3>
                <p class="text-muted mb-4 lead">
                    Thank you, <strong>@_request.ApplicantName</strong>. Your rental request for <strong>@_request.EventDate.ToString("dddd, MMMM d, yyyy")</strong> has been received and added to our calendar as <strong>Pending</strong>.
                </p>
                <div class="summary-box p-4 bg-light rounded-3 text-start mx-auto mb-4" style="max-width: 600px;">
                    <h6 class="fw-bold text-dark mb-3 border-bottom pb-2"><i class="bi bi-receipt me-2"></i>Application Summary</h6>
                    <div class="row g-2 small">
                        <div class="col-6 text-muted">Room:</div>
                        <div class="col-6 fw-bold text-end">@_request.RoomSelected</div>

                        <div class="col-6 text-muted">Event Type:</div>
                        <div class="col-6 fw-bold text-end">@_request.EventType</div>

                        @if (_settings?.ShowGuestCountField ?? true)
                        {
                            <div class="col-6 text-muted">Estimated Guests:</div>
                            <div class="col-6 fw-bold text-end">@_request.GuestCount guests</div>
                        }

                        <div class="col-6 text-muted">Estimated Total:</div>
                        <div class="col-6 fw-bold text-primary text-end fs-6">$@_request.TotalPrice.ToString("N2")</div>

                        @if ((_settings?.RequireSecurityDeposit ?? true) && _request.SecurityDepositAmount > 0)
                        {
                            <div class="col-6 text-muted">Security Deposit:</div>
                            <div class="col-6 fw-bold text-dark text-end">$@_request.SecurityDepositAmount.ToString("N2")</div>
                        }
                    </div>
                </div>
                <p class="small text-muted">
                    @(_settings?.RentalFormSuccessMessage ?? "The Hall Rental Committee will review your date and reach out to you directly to confirm booking and arrange deposit payment.")
                </p>
                <button class="btn btn-outline-primary px-4 mt-2" @onclick="ResetForm">
                    <i class="bi bi-plus-circle me-1"></i> Submit Another Application
                </button>
            </div>
        }
        else
        {
            <div class="card shadow-sm border-0 rental-form-card bg-white">
                <div class="card-header bg-white border-bottom py-3 px-4 text-dark">
                    <h5 class="mb-0 fw-bold d-flex align-items-center justify-content-between">
                        <span><i class="bi bi-file-earmark-text-fill me-2 text-primary"></i>@(_settings?.RentalFormTitle ?? "Hall Rental Application")</span>
                        @if (_settings?.EnableSandboxMode == true)
                        {
                            <span class="badge bg-warning text-dark border border-dark"><i class="bi bi-tools me-1"></i>Sandbox / Test Mode</span>
                        }
                    </h5>
                </div>

                <div class="card-body p-4">
                    @if (!string.IsNullOrEmpty(_errorMessage))
                    {
                        <div id="topErrorBanner" class="alert alert-danger alert-dismissible fade show shadow-sm border-danger" role="alert">
                            <div class="d-flex align-items-start gap-2">
                                <i class="bi bi-exclamation-triangle-fill fs-5 flex-shrink-0 text-danger"></i>
                                <div class="flex-grow-1">
                                    <strong>Please review the required information:</strong>
                                    <div class="mt-1">@_errorMessage</div>
                                </div>
                                <button type="button" class="btn-close" @onclick="() => _errorMessage = null"></button>
                            </div>
                        </div>
                    }

                    <EditForm Model="@_request" OnValidSubmit="HandleSubmit">
                        <DataAnnotationsValidator />

                        <!-- Section 1: Contact Info -->
                        <div class="form-section mb-4">
                            <h6 class="section-heading fw-bold text-dark pb-2 border-bottom">
                                <i class="bi bi-person-lines-fill me-2 text-primary"></i>1. Applicant Information
                            </h6>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold small">
                                        Full Name / Organization @((_settings?.RequireApplicantName ?? true) ? "*" : "(Optional)")
                                    </label>
                                    <InputText class="form-control" placeholder="Jane Doe or Organization Name" @bind-Value="_request.ApplicantName" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold small">
                                        Email Address @((_settings?.RequireEmail ?? true) ? "*" : "(Optional)")
                                    </label>
                                    <InputText class="form-control" type="email" placeholder="jane.doe@example.com" @bind-Value="_request.RequesterEmail" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold small">
                                        Phone Number @((_settings?.RequirePhone ?? true) ? "*" : "(Optional)")
                                    </label>
                                    <InputText class="form-control" type="tel" placeholder="(978) 555-0123" @bind-Value="_request.RequesterPhone" />
                                </div>
                                @if (_settings?.ShowAddressField ?? true)
                                {
                                    <div class="col-md-6">
                                        <label class="form-label fw-semibold small">
                                            Street Address @((_settings?.RequireAddress ?? false) ? "*" : "(Optional)")
                                        </label>
                                        <InputText class="form-control" placeholder="123 Main Street" @bind-Value="_request.RequesterAddress" />
                                    </div>
                                    <div class="col-md-5">
                                        <label class="form-label fw-semibold small">
                                            City @((_settings?.RequireAddress ?? false) ? "*" : "(Optional)")
                                        </label>
                                        <InputText class="form-control" placeholder="Gloucester" @bind-Value="_request.RequesterCity" />
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label fw-semibold small">
                                            State @((_settings?.RequireAddress ?? false) ? "*" : "(Optional)")
                                        </label>
                                        <InputText class="form-control" placeholder="MA" @bind-Value="_request.RequesterState" />
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label fw-semibold small">
                                            ZIP Code @((_settings?.RequireAddress ?? false) ? "*" : "(Optional)")
                                        </label>
                                        <InputText class="form-control" placeholder="01930" @bind-Value="_request.RequesterZip" />
                                    </div>
                                }
                                <div class="col-12">
                                    <label class="form-label fw-bold small text-dark mb-2"><i class="bi bi-person-badge-fill text-primary me-1"></i>Applicant Membership Status *</label>
                                    <div class="row g-2">
                                        <div class="col-12 col-sm-6">
                                            <div class="p-3 rounded-3 border @(!_request.MemberStatus ? "border-primary bg-primary-subtle bg-opacity-25 shadow-sm ring-selected" : "bg-white border")" 
                                                 style="cursor: pointer; transition: all 0.2s ease;" 
                                                 @onclick="() => SetMemberStatus(false)">
                                                <div class="form-check mb-0 d-flex align-items-center">
                                                    <input class="form-check-input me-2" type="radio" name="memberRadio" id="nonMember" checked="@(!_request.MemberStatus)" />
                                                    <div>
                                                        <label class="form-check-label fw-bold text-dark fs-6" for="nonMember" style="cursor: pointer;">
                                                             <i class="bi bi-person me-1 text-secondary"></i>Non-Member
                                                        </label>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-12 col-sm-6">
                                            <div class="p-3 rounded-3 border @(_request.MemberStatus ? "border-primary bg-primary-subtle bg-opacity-25 shadow-sm ring-selected" : "bg-white border")" 
                                                 style="cursor: pointer; transition: all 0.2s ease;" 
                                                 @onclick="() => SetMemberStatus(true)">
                                                <div class="form-check mb-0 d-flex align-items-center">
                                                    <input class="form-check-input me-2" type="radio" name="memberRadio" id="member" checked="@(_request.MemberStatus)" />
                                                    <div>
                                                        <label class="form-check-label fw-bold text-dark fs-6" for="member" style="cursor: pointer;">
                                                            <i class="bi bi-star-fill me-1 text-primary"></i>GFC Member
                                                        </label>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Section 2: Event Details -->
                        <div class="form-section mb-4">
                            <h6 class="section-heading fw-bold text-dark pb-2 border-bottom">
                                <i class="bi bi-calendar-event me-2 text-primary"></i>2. Event Details &amp; Date Selection
                            </h6>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold small">Desired Date *</label>
                                    <input type="date" class="form-control" value="@_request.EventDate.ToString("yyyy-MM-dd")" min="@DateTime.Today.AddDays(1).ToString("yyyy-MM-dd")" @onchange="OnDateChanged" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold small">Alternate Date <span class="text-muted">(Optional)</span></label>
                                    <input type="date" class="form-control" value="@(_request.AlternateEventDate?.ToString("yyyy-MM-dd") ?? "")" min="@DateTime.Today.AddDays(1).ToString("yyyy-MM-dd")" @onchange="OnAlternateDateChanged" />
                                </div>
                                @{
                                    var dayConfig = GetCurrentDayConfig();
                                    var hasConfiguredSlots = dayConfig != null && dayConfig.IsAvailable && dayConfig.Slots.Count > 0;
                                }

                                @if (!hasConfiguredSlots)
                                {
                                    <div class="col-md-6">
                                        <label class="form-label fw-semibold small">Start Time</label>
                                        <select class="form-select" value="@_request.StartTime" @onchange="OnStartTimeChanged">
                                            @foreach (var t in _timeOptions.Take(_timeOptions.Count - 2))
                                            {
                                                <option value="@t">@t</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label fw-semibold small">End Time</label>
                                        <select class="form-select" @bind="_request.EndTime" @bind:after="RecalculatePricing">
                                            @foreach (var t in GetAvailableEndTimes())
                                            {
                                                <option value="@t">@t</option>
                                            }
                                        </select>
                                    </div>
                                }

                                @if (dayConfig != null && !dayConfig.IsAvailable)
                                {
                                    <div class="col-12">
                                        <div class="alert alert-warning d-flex align-items-center gap-2 mb-0 shadow-sm border-warning">
                                            <i class="bi bi-calendar-x text-warning fs-5"></i>
                                            <div>
                                                <strong>Closed on @(_request.EventDate.ToString("dddd"))s:</strong> The Gloucester Fraternity Club is unavailable for private rentals on this day. Please pick another date.
                                            </div>
                                        </div>
                                    </div>
                                }

                                @if (hasConfiguredSlots)
                                {
                                    var allSlotsBooked = dayConfig!.Slots.All(s => IsSlotBooked(s));

                                    if (allSlotsBooked)
                                    {
                                        <div class="col-12">
                                            <div class="alert alert-danger d-flex align-items-center gap-2 mb-0 shadow-sm border-danger">
                                                <i class="bi bi-calendar-x-fill text-danger fs-5"></i>
                                                <div>
                                                    <strong>Fully Booked:</strong> All standard time periods for @(_request.EventDate.ToString("dddd, MMMM d, yyyy")) are already reserved. Please select another date.
                                                </div>
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="col-12">
                                            <div class="d-flex justify-content-between align-items-center flex-wrap gap-1 mb-2">
                                                <label class="form-label fw-bold small text-dark mb-0"><i class="bi bi-clock-history me-1 text-primary"></i>Available Time Periods for @(_request.EventDate.ToString("dddd")):</label>
                                                <small class="text-muted" style="font-size: 0.75rem;">👉 Select an available time block for your event</small>
                                            </div>
                                            <div class="d-flex flex-row flex-wrap align-items-center gap-2">
                                                @foreach (var slot in dayConfig!.Slots)
                                                {
                                                    var isBooked = IsSlotBooked(slot);
                                                    var isSlotSelected = _request.StartTime == slot.StartTime && _request.EndTime == slot.EndTime;
                                                    
                                                    <button type="button" 
                                                            disabled="@isBooked"
                                                            class="btn btn-sm d-inline-flex align-items-center gap-2 px-3 py-2 rounded-3 text-nowrap @(isBooked ? "btn-light border text-muted opacity-50 pe-none" : isSlotSelected ? "btn-primary text-white fw-bold shadow-sm" : "btn-light border text-dark")" 
                                                            style="@(isBooked ? "cursor: not-allowed;" : "cursor: pointer; transition: all 0.2s ease;")"
                                                            @onclick="() => SelectTimeSlot(slot)">
                                                        <i class="bi @(isBooked ? "bi-slash-circle text-danger" : isSlotSelected ? "bi-check-circle-fill text-white" : "bi-clock text-muted")"></i>
                                                        <span class="@(isBooked ? "text-decoration-line-through text-muted" : "")">@slot.Label</span>
                                                        <span class="badge @(isSlotSelected && !isBooked ? "bg-white text-primary fw-bold" : "bg-light text-secondary border") ms-1">@slot.StartTime - @slot.EndTime</span>
                                                        @if (isBooked)
                                                        {
                                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle ms-1">Unavailable</span>
                                                        }
                                                    </button>
                                                }
                                            </div>
                                        </div>
                                    }
                                }

                                <!-- Explicit Selected Date & Time Status Bar -->
                                <div class="col-12">
                                    <div class="p-3 bg-light border border-primary-subtle rounded-3 shadow-sm">
                                        <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
                                            <div class="d-flex align-items-center gap-3 flex-wrap">
                                                <div>
                                                    <small class="text-muted text-uppercase fw-bold d-block" style="font-size: 0.7rem; letter-spacing: 0.5px;">Selected Date</small>
                                                    <span class="fw-bold text-dark"><i class="bi bi-calendar2-check-fill text-primary me-1"></i>@_request.EventDate.ToString("dddd, MMMM d, yyyy")</span>
                                                </div>
                                                @if (_request.AlternateEventDate.HasValue)
                                                {
                                                    <div class="border-start ps-3 d-none d-md-block" style="height: 28px;"></div>
                                                    <div>
                                                        <small class="text-muted text-uppercase fw-bold d-block" style="font-size: 0.7rem; letter-spacing: 0.5px;">Alternate Date</small>
                                                        <span class="fw-bold text-secondary"><i class="bi bi-calendar-event me-1"></i>@_request.AlternateEventDate.Value.ToString("MMM d, yyyy")</span>
                                                    </div>
                                                }
                                                <div class="border-start ps-3 d-none d-md-block" style="height: 28px;"></div>
                                                <div>
                                                    <small class="text-muted text-uppercase fw-bold d-block" style="font-size: 0.7rem; letter-spacing: 0.5px;">Selected Time Period</small>
                                                    @if (IsCurrentSelectionBooked())
                                                    {
                                                        <div class="d-flex align-items-center gap-2">
                                                            <span class="fw-bold text-danger"><i class="bi bi-x-circle-fill text-danger me-1"></i>No Time Slot Selected (Unavailable)</span>
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <div class="d-flex align-items-center gap-2">
                                                            <span class="fw-bold text-dark"><i class="bi bi-clock-fill text-primary me-1"></i>@_request.StartTime to @_request.EndTime</span>
                                                            <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-10 rounded-pill" style="font-size: 0.72rem;">@(_calculatedDurationHours) hrs</span>
                                                        </div>
                                                    }
                                                </div>
                                                @if (!string.IsNullOrEmpty(_request.RoomSelected))
                                                {
                                                    <div class="border-start ps-3 d-none d-md-block" style="height: 28px;"></div>
                                                    <div>
                                                        <small class="text-muted text-uppercase fw-bold d-block" style="font-size: 0.7rem; letter-spacing: 0.5px;">Selected Space</small>
                                                        <span class="fw-bold text-primary"><i class="bi bi-door-open-fill me-1"></i>@_request.RoomSelected</span>
                                                    </div>
                                                }
                                            </div>
                                            <div>
                                                @if (IsCurrentSelectionBooked() || (dayConfig != null && !dayConfig.IsAvailable))
                                                {
                                                    <span class="badge bg-danger bg-opacity-10 text-danger border border-danger-subtle px-2 py-1 rounded-pill small">
                                                        <i class="bi bi-exclamation-octagon-fill me-1"></i>Date / Time Unavailable
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-success bg-opacity-10 text-success border border-success-subtle px-2 py-1 rounded-pill small">
                                                        <i class="bi bi-check2-circle me-1"></i>Ready for Application
                                                    </span>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label fw-semibold small">
                                        Event Type / Occasion @((_settings?.RequireEventType ?? true) ? "*" : "(Optional)")
                                    </label>
                                    <select class="form-select" @bind="_request.EventType">
                                        <option value="">-- Select Event Type --</option>
                                        @foreach (var evType in _eventTypeOptions)
                                        {
                                            <option value="@evType">@evType</option>
                                        }
                                    </select>
                                </div>

                                @if (_settings?.ShowGuestCountField ?? true)
                                {
                                    <div class="col-md-6">
                                        <label class="form-label fw-semibold small">
                                            Estimated Guest Count @((_settings?.RequireGuestCount ?? false) ? "*" : "(Optional)")
                                        </label>
                                        <InputNumber class="form-control" min="1" max="500" @bind-Value="_request.GuestCount" />
                                    </div>
                                }

                                <div class="col-12">
                                    <label class="form-label fw-semibold small">
                                        Event Description / Notes <span class="text-muted">(Special requests, setup details, DJ / band, etc.)</span>
                                    </label>
                                    <InputTextArea class="form-control" rows="3" placeholder="Please describe your planned affair, music, setup, or specific requirements..." @bind-Value="_request.EventDescription" />
                                </div>

                                <div class="col-12">
                                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-1 mb-1">
                                        <label class="form-label fw-bold small text-dark mb-0"><i class="bi bi-tag-fill me-1 text-primary"></i>Select Rental Pricing Tier / Category *</label>
                                        <small class="text-muted" style="font-size: 0.75rem;">👉 Click a pricing category card below to make your selection for the Function Hall</small>
                                    </div>
                                    <div class="row g-3">
                                        @foreach (var room in GetDisplayedRooms())
                                        {
                                            var isSelected = _request.RoomSelected == room.Name;
                                            <div class="col-12 col-sm-6 col-lg-4">
                                                <div class="card p-3 h-100 room-card position-relative @(isSelected ? "border-primary bg-primary-subtle bg-opacity-25 shadow-sm ring-selected" : "bg-white border")" 
                                                     style="cursor: pointer; border-radius: 12px; transition: all 0.2s ease;"
                                                     @onclick='() => SelectRoom(room.Name)'>
                                                    <div class="d-flex align-items-center justify-content-between mb-2">
                                                        <div class="form-check mb-0">
                                                            <input class="form-check-input" type="radio" name="roomRadio" checked="@isSelected" />
                                                            <label class="form-check-label fw-bold text-dark fs-6 ms-1">@room.Name</label>
                                                        </div>
                                                        @if (isSelected)
                                                        {
                                                            <span class="badge bg-primary text-white rounded-pill px-2 py-1" style="font-size: 0.65rem;">SELECTED</span>
                                                        }
                                                    </div>
                                                    <div class="small text-muted mb-2 flex-grow-1">@room.Description</div>
                                                    <div class="d-flex justify-content-between align-items-center pt-2 border-top mt-auto">
                                                        <span class="small text-secondary"><i class="bi bi-people me-1"></i>Cap: @room.Capacity</span>
                                                        <span class="fw-bold text-primary fs-5">$@GetRoomPrice(room.Name)</span>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Section 3: Add-on Services -->
                        @if (_availableAddons.Any())
                        {
                            <div class="form-section mb-4">
                                <h6 class="section-heading fw-bold text-dark pb-2 border-bottom">
                                    <i class="bi bi-plus-circle-fill me-2 text-primary"></i>3. Add-on Services &amp; Amenities
                                </h6>
                                <div class="row g-3">
                                    @foreach (var addon in _availableAddons)
                                    {
                                        bool isSelected = _selectedAddonIds.Contains(addon.Id);
                                        bool isBar = addon.Id == "addon_bar" || addon.Name.Contains("Bar", StringComparison.OrdinalIgnoreCase);
                                        <div class="col-12 col-sm-6 col-md-4">
                                            <div class="form-check p-3 bg-white rounded-3 border h-100 @(isSelected ? "border-primary bg-primary-subtle bg-opacity-25 shadow-sm ring-selected" : "")" style="cursor: pointer; transition: all 0.2s ease;" @onclick="() => ToggleAddon(addon.Id)">
                                                <div class="d-flex align-items-start">
                                                    <input class="form-check-input ms-0 me-2 mt-1" type="checkbox" checked="@isSelected" />
                                                    <div class="flex-grow-1 ms-2">
                                                        <div class="d-flex align-items-center justify-content-between gap-1 mb-1">
                                                            <label class="form-check-label fw-bold text-dark d-block">
                                                                @addon.Name
                                                            </label>
                                                            @if (isBar)
                                                            {
                                                                <span class="badge bg-warning bg-opacity-25 text-dark border border-warning border-opacity-50" style="font-size: 0.65rem;">
                                                                    <i class="bi bi-cup-straw me-1"></i>ALCOHOL
                                                                </span>
                                                            }
                                                        </div>
                                                        <div class="small text-muted mb-2" style="font-size: 0.8rem; line-height: 1.4; white-space: pre-line;">@addon.Description</div>
                                                        <div class="small fw-bold text-primary">+@($"${addon.Fee:N2}")</div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        }

                        <!-- Section 4: Dynamic Quote & Total (Clean Light Card) -->
                        <div class="pricing-summary-card p-4 rounded-4 bg-white border border-primary-subtle shadow-sm mb-4">
                            <div class="row align-items-center g-3">
                                <div class="col-12 col-sm-7">
                                    <span class="text-uppercase tracking-wider small fw-bold text-primary d-block mb-1">
                                        <i class="bi bi-calculator me-1"></i>Live Estimated Total
                                    </span>
                                    <div class="d-flex align-items-baseline gap-2">
                                        <h2 class="display-6 fw-bold mb-0 text-dark">$@_request.TotalPrice.ToString("N2")</h2>
                                        <span class="badge bg-light text-dark border px-2 py-1 small">
                                            <i class="bi bi-clock me-1"></i>@(_calculatedDurationHours) hrs total
                                        </span>
                                    </div>
                                    @if (_extraHours > 0)
                                    {
                                        <div class="small text-primary mt-1 fw-semibold">
                                            <i class="bi bi-plus-circle me-1"></i>Includes +@(_extraHours) extra hrs (@($"${_settings?.AdditionalHourRate ?? 50:N2}")/hr = +$@_extraHoursFee.ToString("N2"))
                                        </div>
                                    }
                                    @if ((_settings?.RequireSecurityDeposit ?? true) && _request.SecurityDepositAmount > 0)
                                    {
                                        <div class="small text-muted mt-1">
                                            <i class="bi bi-shield-check text-success me-1"></i>+ $@_request.SecurityDepositAmount.ToString("N2") Refundable Security Deposit
                                        </div>
                                    }
                                </div>
                                <div class="col-12 col-sm-5 text-sm-end">
                                    <div class="p-2 px-3 rounded-3 bg-light border text-dark fw-bold small d-inline-block text-wrap w-100 w-sm-auto text-start text-sm-end">
                                        <div class="text-muted small" style="font-size: 0.75rem;">Selected Package</div>
                                        <div class="text-truncate">@_request.RoomSelected</div>
                                        <span class="badge @(_request.MemberStatus ? "bg-primary text-white" : "bg-secondary text-white") mt-1">
                                            @(_request.MemberStatus ? "Member Rate" : "Non-Member Rate")
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Section 5: Terms, Conditions & Rental Policies -->
                        <div class="form-section mb-4">
                            <h6 class="section-heading fw-bold text-dark pb-2 border-bottom">
                                <i class="bi bi-file-earmark-ruled-fill me-2 text-primary"></i>4. Terms, Conditions &amp; Policies
                            </h6>

                            @* 1. Question-Triggered Policies (e.g. Setup Time Request) *@
                            @foreach (var qPolicy in GetQuestionTriggeredPolicies())
                            {
                                bool isYes = _questionAnswers.TryGetValue(qPolicy.Id, out var ans) && ans;
                                <div class="card mb-3 border shadow-sm rounded-3">
                                    <div class="p-3 bg-white">
                                        <label class="form-label fw-bold text-dark small mb-2 d-flex align-items-center gap-2">
                                            <i class="bi bi-question-circle-fill text-primary"></i>
                                            <span>@(string.IsNullOrWhiteSpace(qPolicy.PromptQuestion) ? qPolicy.Title : qPolicy.PromptQuestion) *</span>
                                        </label>
                                        <div class="d-flex gap-2">
                                            <button type="button" 
                                                    class="btn btn-sm px-3 rounded-pill @(!isYes ? "btn-secondary text-white fw-bold shadow-sm" : "btn-outline-secondary")" 
                                                    @onclick="() => SetQuestionAnswer(qPolicy.Id, false)">
                                                <i class="bi @(!isYes ? "bi-check-circle-fill me-1" : "bi-circle me-1")"></i>No
                                            </button>
                                            <button type="button" 
                                                    class="btn btn-sm px-3 rounded-pill @(isYes ? "btn-primary text-white fw-bold shadow-sm" : "btn-outline-secondary")" 
                                                    @onclick="() => SetQuestionAnswer(qPolicy.Id, true)">
                                                <i class="bi @(isYes ? "bi-check-circle-fill me-1" : "bi-circle me-1")"></i>Yes
                                            </button>
                                        </div>
                                    </div>

                                    @if (isYes)
                                    {
                                        bool isAgreed = _agreedPolicyIds.Contains(qPolicy.Id);
                                        <div class="animate-fade-in border-top">
                                            <div class="card-header bg-light py-2">
                                                <span class="fw-bold small text-dark"><i class="bi bi-info-circle-fill text-primary me-1"></i>@qPolicy.Title</span>
                                            </div>
                                            <div class="card-body p-3 small text-muted" style="background-color: #fdfdfd; font-size: 0.85rem; line-height: 1.6; white-space: pre-line;">
                                                @((MarkupString)qPolicy.Content)
                                            </div>
                                            <div class="card-footer bg-white border-top p-3">
                                                <div class="form-check">
                                                    <input class="form-check-input" type="checkbox" id="@($"chk_{qPolicy.Id}")" 
                                                           checked="@isAgreed" 
                                                           @onchange="(e) => TogglePolicyAgreement(qPolicy.Id, e.Value is bool b && b)" />
                                                    <label class="form-check-label fw-bold text-dark small" for="@($"chk_{qPolicy.Id}")">
                                                        @(string.IsNullOrWhiteSpace(qPolicy.CheckboxLabel) ? "I have read, understand, and agree to this policy *" : qPolicy.CheckboxLabel)
                                                    </label>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }

                            @* 2. Standard & Add-on Policies *@
                            @foreach (var policy in GetStandardAndAddonVisiblePolicies())
                            {
                                bool isAgreed = _agreedPolicyIds.Contains(policy.Id);
                                <div class="card mb-3 border bg-light shadow-sm">
                                    <div class="card-header bg-white py-2 d-flex align-items-center justify-content-between">
                                        <span class="fw-bold small text-dark">
                                            <i class="bi bi-shield-check text-primary me-1"></i>@policy.Title
                                        </span>
                                        @if (string.Equals(policy.DisplayMode, "AddonTriggered", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <span class="badge bg-warning bg-opacity-25 text-dark border border-warning border-opacity-50" style="font-size: 0.7rem;">
                                                <i class="bi bi-lightning-fill me-1"></i>Selected Add-on Policy
                                            </span>
                                        }
                                    </div>
                                    <div class="card-body p-3 small text-muted" style="max-height: 220px; overflow-y: auto; line-height: 1.6; font-size: 0.85rem; background-color: #fdfdfd; white-space: pre-line;">
                                        @((MarkupString)policy.Content)
                                    </div>
                                    <div class="card-footer bg-white border-top p-3">
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" id="@($"chk_{policy.Id}")" 
                                                   checked="@isAgreed" 
                                                   @onchange="(e) => TogglePolicyAgreement(policy.Id, e.Value is bool b && b)" />
                                            <label class="form-check-label fw-bold text-dark small" for="@($"chk_{policy.Id}")">
                                                @(string.IsNullOrWhiteSpace(policy.CheckboxLabel) ? "I have read, understand, and agree to this policy *" : policy.CheckboxLabel)
                                            </label>
                                        </div>
                                    </div>
                                </div>
                            }

                            <!-- General Rental Policies Link & Checkbox -->
                            <div class="p-3 bg-white border rounded-3 shadow-sm mb-3">
                                <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-2">
                                    <span class="fw-semibold small text-dark"><i class="bi bi-info-circle text-primary me-1"></i>Additional Rental Policies</span>
                                    <a href="@(_settings?.RentalPolicyUrl ?? "https://gloucesterfraternityclub.com/hall-rentals/hall-rental-policy/")" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-outline-primary py-0 px-2 small">
                                        <i class="bi bi-box-arrow-up-right me-1"></i>View Official Policy Page
                                    </a>
                                </div>
                                <div class="form-check mb-0">
                                    <input class="form-check-input" type="checkbox" id="generalPoliciesCheck" @bind="_request.RulesAgreed" />
                                    <label class="form-check-label text-dark small fw-semibold" for="generalPoliciesCheck">
                                        @(_settings?.RentalFormRulesText ?? "I have read and understand all GFC policies *")
                                    </label>
                                </div>
                            </div>
                        </div>

                        <!-- Section 6: Applicant Signature & Submission -->
                        <div class="form-section mb-4" id="submitSection">
                            <h6 class="section-heading fw-bold text-dark pb-2 border-bottom">
                                <i class="bi bi-pen-fill me-2 text-primary"></i>5. Electronic Signature &amp; Confirmation
                            </h6>

                            <div class="mb-3">
                                <label class="form-label fw-bold small text-dark">
                                    Applicant Signature *
                                </label>
                                <InputText class="form-control form-control-lg fs-6 font-monospace" placeholder="Type your full legal name to electronically sign" @bind-Value="_request.ApplicantSignature" />
                            </div>

                            <div class="alert alert-info d-flex align-items-start gap-2 shadow-sm border-info mb-4 p-3 rounded-3">
                                <i class="bi bi-info-circle-fill fs-5 text-primary flex-shrink-0"></i>
                                <div class="small text-dark">
                                    <strong>Important Note:</strong> @(_settings?.RentalPaymentWindowNotice ?? "After electronically signing this application, and once your date is approved by the Gloucester Fraternity Club (GFC), you will have two (2) business days to complete payment to reserve your date.")
                                </div>
                            </div>

                            <!-- Prominent Validation Warning Callout directly above Submit button (Critical for Mobile) -->
                            @if (!string.IsNullOrEmpty(_errorMessage))
                            {
                                <div class="alert alert-danger d-flex align-items-start gap-3 shadow-sm border-danger p-3 mb-3 rounded-3" role="alert">
                                    <i class="bi bi-exclamation-triangle-fill fs-4 flex-shrink-0 text-danger"></i>
                                    <div class="flex-grow-1">
                                        <h6 class="fw-bold text-danger mb-1"><i class="bi bi-shield-exclamation me-1"></i>Submission Incomplete</h6>
                                        <div class="small text-dark">@_errorMessage</div>
                                    </div>
                                </div>
                            }

                            <div class="d-flex justify-content-start">
                                <button type="submit" class="btn btn-primary btn-lg px-5 fw-bold shadow-sm w-100 w-sm-auto" disabled="@(!CanSubmit() || _isSubmitting)">
                                    @if (_isSubmitting)
                                    {
                                        <span class="spinner-border spinner-border-sm me-2"></span>
                                        <span>Submitting Application...</span>
                                    }
                                    else
                                    {
                                        <i class="bi bi-send-check-fill me-2"></i>
                                        <span>Submit Rental Application</span>
                                    }
                                </button>
                            </div>
                        </div>
                    </EditForm>
                </div>
            </div>
        }
    </div>
</div>

<style>
    .gfc-public-rental-page {
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        background-color: #f4f6f9;
        min-height: 100vh;
        color: #212529;
    }
    .embedded-mode {
        background-color: transparent !important;
        min-height: auto;
    }
    .rental-form-card {
        border-radius: 16px;
        overflow: hidden;
        border: 1px solid #e9ecef !important;
    }
    .room-card {
        transition: all 0.2s ease-in-out;
    }
    .room-card:hover {
        border-color: #0d6efd !important;
        transform: translateY(-2px);
    }
    .ring-selected {
        box-shadow: 0 0 0 2px #0d6efd !important;
    }
</style>

@code {
    private HallRentalRequest _request = new()
    {
        EventDate = DateTime.Today.AddDays(14),
        StartTime = "2:00 PM",
        EndTime = "7:00 PM",
        GuestCount = 50,
        MemberStatus = false
    };

    private WebsiteSettings? _settings;
    private List<RentalRoomOption> _availableRooms = new();
    private List<RentalAddonOption> _availableAddons = new();
    private List<RentalPolicyItem> _policies = new();
    private HashSet<string> _selectedAddonIds = new();
    private HashSet<string> _agreedPolicyIds = new();
    private Dictionary<string, bool> _questionAnswers = new();

    private readonly List<string> _timeOptions = new()
    {
        "6:00 AM", "6:30 AM", "7:00 AM", "7:30 AM",
        "8:00 AM", "8:30 AM", "9:00 AM", "9:30 AM",
        "10:00 AM", "10:30 AM", "11:00 AM", "11:30 AM",
        "12:00 PM", "12:30 PM", "1:00 PM", "1:30 PM",
        "2:00 PM", "2:30 PM", "3:00 PM", "3:30 PM",
        "4:00 PM", "4:30 PM", "5:00 PM", "5:30 PM",
        "6:00 PM", "6:30 PM", "7:00 PM", "7:30 PM",
        "8:00 PM", "8:30 PM", "9:00 PM", "9:30 PM",
        "10:00 PM", "10:30 PM", "11:00 PM", "11:30 PM",
        "12:00 Midnight"
    };

    private readonly List<string> _eventTypeOptions = new()
    {
        "Birthday Party",
        "Wedding",
        "Anniversary Party",
        "Bereavement / Memorial / Collation",
        "Business Meeting / Corporate Event",
        "Fundraiser / Charity Event",
        "Holiday Party",
        "Baby / Bridal Shower",
        "Christening / Baptism",
        "Graduation Party",
        "Retirement Party",
        "Reunion",
        "Other Celebration / Event"
    };

    private List<UnavailableDateDto> _unavailableDates = new();

    private bool _isEmbedded = false;
    private bool _isSubmitting = false;
    private bool _isSubmitted = false;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);
        if (query.TryGetValue("embed", out var embedVal) && embedVal == "true")
        {
            _isEmbedded = true;
        }

        try
        {
            _settings = await WebsiteSettingsService.GetWebsiteSettingsAsync();
            _availableRooms = _settings.GetRoomsList();
            _availableAddons = _settings.GetAddonsList();
            _policies = _settings.GetPoliciesList();

            try
            {
                _unavailableDates = await RentalService.GetUnavailableDatesAsync();
            }
            catch (Exception)
            {
                _unavailableDates = new List<UnavailableDateDto>();
            }

            var displayed = GetDisplayedRooms();
            if (displayed.Count > 0 && string.IsNullOrEmpty(_request.RoomSelected))
            {
                var defaultRoom = displayed.FirstOrDefault(r => r.IsDefault) ?? displayed[0];
                _request.RoomSelected = defaultRoom.Name;
            }

            ApplyDefaultSlotForDate();
            RecalculatePricing();
        }
        catch (Exception ex)
        {
            _errorMessage = "Could not load club settings: " + ex.Message;
        }
    }

    private bool IsSlotBooked(DayScheduleSlotConfig slot)
    {
        var targetDate = _request.EventDate.Date;
        var dayEvents = _unavailableDates.Where(d => d.Date.Date == targetDate).ToList();
        if (!dayEvents.Any()) return false;

        var slotStart = ParseTimeToMinutes(slot.StartTime);
        var slotEnd = ParseTimeToMinutes(slot.EndTime);
        if (slotStart < 0 || slotEnd < 0) return false;

        foreach (var ev in dayEvents)
        {
            if (string.IsNullOrWhiteSpace(ev.EventTime))
            {
                // Full day booking or blackout date
                return true;
            }

            var parts = ev.EventTime.Split('-', StringSplitOptions.TrimEntries);
            if (parts.Length == 2)
            {
                var evStart = ParseTimeToMinutes(parts[0]);
                var evEnd = ParseTimeToMinutes(parts[1]);

                if (evStart >= 0 && evEnd >= 0)
                {
                    // Check interval overlap: [slotStart, slotEnd) overlaps [evStart, evEnd)
                    if (slotStart < evEnd && slotEnd > evStart)
                    {
                        return true;
                    }
                }
                else
                {
                    // Could not parse times, treat as conflicting
                    return true;
                }
            }
            else
            {
                return true;
            }
        }

        return false;
    }

    private bool IsCurrentSelectionBooked()
    {
        var dayConfig = GetCurrentDayConfig();
        if (dayConfig != null && !dayConfig.IsAvailable) return true;

        if (dayConfig != null && dayConfig.IsAvailable && dayConfig.Slots.Count > 0)
        {
            var matchingSlot = dayConfig.Slots.FirstOrDefault(s => s.StartTime == _request.StartTime && s.EndTime == _request.EndTime);
            if (matchingSlot == null)
            {
                // Custom or nonexistent slot selected when slots are required
                return true;
            }
            return IsSlotBooked(matchingSlot);
        }

        // For custom times, check interval directly
        var targetDate = _request.EventDate.Date;
        var dayEvents = _unavailableDates.Where(d => d.Date.Date == targetDate).ToList();
        if (!dayEvents.Any()) return false;

        var startMin = ParseTimeToMinutes(_request.StartTime);
        var endMin = ParseTimeToMinutes(_request.EndTime);
        if (startMin < 0 || endMin < 0) return false;

        foreach (var ev in dayEvents)
        {
            if (string.IsNullOrWhiteSpace(ev.EventTime)) return true;
            var parts = ev.EventTime.Split('-', StringSplitOptions.TrimEntries);
            if (parts.Length == 2)
            {
                var evStart = ParseTimeToMinutes(parts[0]);
                var evEnd = ParseTimeToMinutes(parts[1]);
                if (evStart >= 0 && evEnd >= 0 && startMin < evEnd && endMin > evStart)
                {
                    return true;
                }
            }
            else return true;
        }

        return false;
    }

    private void ApplyDefaultSlotForDate()
    {
        var dayConfig = GetCurrentDayConfig();
        if (dayConfig != null && dayConfig.IsAvailable && dayConfig.Slots.Count > 0)
        {
            var firstAvailableSlot = dayConfig.Slots.FirstOrDefault(s => !IsSlotBooked(s));
            if (firstAvailableSlot != null)
            {
                _request.StartTime = firstAvailableSlot.StartTime;
                _request.EndTime = firstAvailableSlot.EndTime;
            }
            else
            {
                _request.StartTime = string.Empty;
                _request.EndTime = string.Empty;
            }
        }
    }

    private DayOfWeekScheduleConfig? GetCurrentDayConfig()
    {
        var dayConfigs = _settings?.GetDaySchedulesList();
        return dayConfigs?.FirstOrDefault(d => d.DayOfWeek == _request.EventDate.DayOfWeek);
    }

    private List<RentalRoomOption> GetDisplayedRooms()
    {
        var dayConfig = GetCurrentDayConfig();
        if (dayConfig != null && dayConfig.AllowedRoomNames != null && dayConfig.AllowedRoomNames.Count > 0)
        {
            if (dayConfig.AllowedRoomNames.Contains("__NONE__")) return new List<RentalRoomOption>();
            var filtered = _availableRooms
                .Where(r => dayConfig.AllowedRoomNames.Contains(r.Name, StringComparer.OrdinalIgnoreCase))
                .ToList();
            return filtered;
        }
        return _availableRooms;
    }

    private void SelectTimeSlot(DayScheduleSlotConfig slot)
    {
        if (IsSlotBooked(slot)) return;
        _request.StartTime = slot.StartTime;
        _request.EndTime = slot.EndTime;
        RecalculatePricing();
    }

    private void SetMemberStatus(bool isMember)
    {
        _request.MemberStatus = isMember;
        _request.RenterType = isMember ? "Member" : "Non-Member";
        RecalculatePricing();
    }

    private void SelectRoom(string roomName)
    {
        _request.RoomSelected = roomName;
        RecalculatePricing();
    }

    private async Task OnDateChanged(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out var dt))
        {
            _request.EventDate = dt;

            try
            {
                _unavailableDates = await RentalService.GetUnavailableDatesAsync();
            }
            catch { }

            var displayed = GetDisplayedRooms();
            if (displayed.Count > 0 && !displayed.Any(r => r.Name.Equals(_request.RoomSelected, StringComparison.OrdinalIgnoreCase)))
            {
                var defaultRoom = displayed.FirstOrDefault(r => r.IsDefault) ?? displayed[0];
                _request.RoomSelected = defaultRoom.Name;
            }

            ApplyDefaultSlotForDate();
            RecalculatePricing();
        }
    }

    private void OnAlternateDateChanged(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out var dt))
        {
            _request.AlternateEventDate = dt;
        }
        else
        {
            _request.AlternateEventDate = null;
        }
    }

    private void ToggleAddon(string addonId)
    {
        if (_selectedAddonIds.Contains(addonId))
        {
            _selectedAddonIds.Remove(addonId);
        }
        else
        {
            _selectedAddonIds.Add(addonId);
        }

        // Map backwards to standard flags if matching default IDs
        _request.BartenderRequested = _selectedAddonIds.Contains("addon_bar") || _selectedAddonIds.Any(id => _availableAddons.Any(a => a.Id == id && a.Name.Contains("Bar", StringComparison.OrdinalIgnoreCase)));
        _request.KitchenUsage = _selectedAddonIds.Contains("addon_kitchen") || _selectedAddonIds.Any(id => _availableAddons.Any(a => a.Id == id && a.Name.Contains("Kitchen", StringComparison.OrdinalIgnoreCase)));
        _request.AvEquipmentUsage = _selectedAddonIds.Contains("addon_av") || _selectedAddonIds.Any(id => _availableAddons.Any(a => a.Id == id && (a.Name.Contains("AV", StringComparison.OrdinalIgnoreCase) || a.Name.Contains("Sound", StringComparison.OrdinalIgnoreCase))));

        RecalculatePricing();
    }

    private decimal GetRoomPrice(string roomName)
    {
        bool isMember = _request.MemberStatus;

        var room = _availableRooms.FirstOrDefault(r => r.Name.Equals(roomName, StringComparison.OrdinalIgnoreCase));
        if (room != null)
        {
            return isMember ? room.MemberRate : room.NonMemberRate;
        }

        return isMember ? (_settings?.FunctionHallMemberRate ?? 300) : (_settings?.FunctionHallNonMemberRate ?? 400);
    }

    private double _calculatedDurationHours = 5;
    private double _extraHours = 0;
    private decimal _extraHoursFee = 0;

    private List<string> GetAvailableEndTimes()
    {
        var startMinutes = ParseTimeToMinutes(_request.StartTime);
        if (startMinutes < 0) startMinutes = 14 * 60; // Default 2:00 PM

        int baseHours = _settings?.BaseFunctionHours ?? 5;
        bool allowExtra = _settings?.AllowAdditionalHours ?? true;
        int maxDurationHours = allowExtra ? (_settings?.MaxHallRentalDurationHours ?? 8) : baseHours;

        if (maxDurationHours < baseHours) maxDurationHours = baseHours;

        var available = new List<string>();
        foreach (var timeStr in _timeOptions)
        {
            var endMinutes = ParseTimeToMinutes(timeStr);
            if (endMinutes <= startMinutes) continue; // Must be after start time

            double durationHours = (endMinutes - startMinutes) / 60.0;
            // Minimum 1 hour, maximum clamped by settings
            if (durationHours >= 1.0 && durationHours <= (double)maxDurationHours)
            {
                available.Add(timeStr);
            }
        }

        if (!available.Any())
        {
            // Fallback default
            available.Add("7:00 PM");
        }

        return available;
    }

    private void OnStartTimeChanged(ChangeEventArgs e)
    {
        var newStart = e.Value?.ToString();
        if (!string.IsNullOrEmpty(newStart))
        {
            _request.StartTime = newStart;
            var validEnds = GetAvailableEndTimes();
            if (!validEnds.Contains(_request.EndTime))
            {
                int baseHours = _settings?.BaseFunctionHours ?? 5;
                var startMin = ParseTimeToMinutes(newStart);
                var idealEndMin = startMin + (baseHours * 60);

                var closest = validEnds.FirstOrDefault(t => ParseTimeToMinutes(t) >= idealEndMin) ?? validEnds.LastOrDefault() ?? "7:00 PM";
                _request.EndTime = closest;
            }
            RecalculatePricing();
        }
    }

    private static int ParseTimeToMinutes(string? timeStr)
    {
        if (string.IsNullOrWhiteSpace(timeStr)) return -1;
        timeStr = timeStr.Trim();

        if (timeStr.Equals("12:00 Midnight", StringComparison.OrdinalIgnoreCase))
        {
            return 24 * 60;
        }

        if (DateTime.TryParse(timeStr, out var dt))
        {
            return dt.Hour * 60 + dt.Minute;
        }
        return -1;
    }

    private void RecalculatePricing()
    {
        decimal basePrice = GetRoomPrice(_request.RoomSelected ?? (_availableRooms.FirstOrDefault()?.Name ?? "Function Hall"));
        decimal addOns = 0;

        foreach (var addon in _availableAddons.Where(a => _selectedAddonIds.Contains(a.Id)))
        {
            addOns += addon.Fee;
        }

        // Calculate event duration & overtime hours
        var startMin = ParseTimeToMinutes(_request.StartTime);
        var endMin = ParseTimeToMinutes(_request.EndTime);

        if (startMin >= 0 && endMin > startMin)
        {
            _calculatedDurationHours = (endMin - startMin) / 60.0;
        }
        else
        {
            _calculatedDurationHours = _settings?.BaseFunctionHours ?? 5;
        }

        int baseHours = _settings?.BaseFunctionHours ?? 5;
        bool allowExtra = _settings?.AllowAdditionalHours ?? true;

        if (allowExtra && _calculatedDurationHours > baseHours)
        {
            _extraHours = _calculatedDurationHours - baseHours;
            decimal hourlyRate = _settings?.AdditionalHourRate ?? 50m;
            _extraHoursFee = (decimal)_extraHours * hourlyRate;
        }
        else
        {
            _extraHours = 0;
            _extraHoursFee = 0;
        }

        _request.TotalPrice = basePrice + addOns + _extraHoursFee;

        if (_settings?.RequireSecurityDeposit == false)
        {
            _request.SecurityDepositAmount = 0;
        }
        else
        {
            _request.SecurityDepositAmount = _settings?.SecurityDepositAmount ?? 200;
        }
    }

    private List<RentalPolicyItem> GetQuestionTriggeredPolicies()
    {
        if (_policies == null || _policies.Count == 0) return new List<RentalPolicyItem>();

        return _policies.Where(p => string.Equals(p.DisplayMode, "QuestionTriggered", StringComparison.OrdinalIgnoreCase)).ToList();
    }

    private List<RentalPolicyItem> GetStandardAndAddonVisiblePolicies()
    {
        if (_policies == null || _policies.Count == 0) return new List<RentalPolicyItem>();

        return _policies.Where(p =>
        {
            if (string.Equals(p.DisplayMode, "Hidden", StringComparison.OrdinalIgnoreCase))
            {
                return false;
            }
            if (string.Equals(p.DisplayMode, "QuestionTriggered", StringComparison.OrdinalIgnoreCase))
            {
                return false; // Handled separately in top question block
            }
            if (string.Equals(p.DisplayMode, "AddonTriggered", StringComparison.OrdinalIgnoreCase))
            {
                if (string.IsNullOrWhiteSpace(p.AssociatedAddonId)) return false;
                return _selectedAddonIds.Contains(p.AssociatedAddonId);
            }
            // "Always" or default
            return true;
        }).ToList();
    }

    private List<RentalPolicyItem> GetVisiblePolicies()
    {
        if (_policies == null || _policies.Count == 0) return new List<RentalPolicyItem>();

        var result = new List<RentalPolicyItem>();

        // 1. Add question-triggered policies only if applicant answered 'Yes'
        foreach (var qp in GetQuestionTriggeredPolicies())
        {
            if (_questionAnswers.TryGetValue(qp.Id, out var ans) && ans)
            {
                result.Add(qp);
            }
        }

        // 2. Add standard & add-on triggered policies
        result.AddRange(GetStandardAndAddonVisiblePolicies());

        return result;
    }

    private void SetQuestionAnswer(string policyId, bool isYes)
    {
        _questionAnswers[policyId] = isYes;
        if (!isYes)
        {
            _agreedPolicyIds.Remove(policyId);
        }

        if (policyId == "policy_setup" || policyId.Contains("setup", StringComparison.OrdinalIgnoreCase))
        {
            _request.RequiresSetupTime = isYes;
        }

        RecalculatePricing();
    }

    private void TogglePolicyAgreement(string policyId, bool isAgreed)
    {
        if (isAgreed)
        {
            _agreedPolicyIds.Add(policyId);
        }
        else
        {
            _agreedPolicyIds.Remove(policyId);
        }

        // Keep legacy backward compatibility fields updated
        var vis = GetVisiblePolicies();
        _request.TermsAgreed = _agreedPolicyIds.Contains("policy_terms") || vis.Where(p => p.Id == "policy_terms" || p.Title.Contains("Terms", StringComparison.OrdinalIgnoreCase)).All(p => _agreedPolicyIds.Contains(p.Id));
        _request.CancellationPolicyAgreed = _agreedPolicyIds.Contains("policy_cancel") || vis.Where(p => p.Id == "policy_cancel" || p.Title.Contains("Cancel", StringComparison.OrdinalIgnoreCase)).All(p => _agreedPolicyIds.Contains(p.Id));
        _request.KitchenPolicyAgreed = _agreedPolicyIds.Contains("policy_kitchen") || vis.Where(p => p.Id == "policy_kitchen" || p.Title.Contains("Kitchen", StringComparison.OrdinalIgnoreCase)).All(p => _agreedPolicyIds.Contains(p.Id));
    }

    private bool CanSubmit()
    {
        if (IsCurrentSelectionBooked()) return false;
        if (!_request.RulesAgreed) return false;

        var requiredVisiblePolicies = GetVisiblePolicies().Where(p => p.IsRequired);
        foreach (var pol in requiredVisiblePolicies)
        {
            if (!_agreedPolicyIds.Contains(pol.Id))
            {
                return false;
            }
        }

        return true;
    }

    private async Task HandleSubmit()
    {
        var missingFields = new List<string>();

        bool reqName = _settings?.RequireApplicantName ?? true;
        if (reqName && string.IsNullOrWhiteSpace(_request.ApplicantName))
        {
            missingFields.Add("Full Name / Organization");
        }

        bool reqEmail = _settings?.RequireEmail ?? true;
        if (reqEmail && string.IsNullOrWhiteSpace(_request.RequesterEmail))
        {
            missingFields.Add("Email Address");
        }

        bool reqPhone = _settings?.RequirePhone ?? true;
        if (reqPhone && string.IsNullOrWhiteSpace(_request.RequesterPhone))
        {
            missingFields.Add("Phone Number");
        }

        bool showAddress = _settings?.ShowAddressField ?? true;
        bool reqAddress = _settings?.RequireAddress ?? false;
        if (showAddress && reqAddress && string.IsNullOrWhiteSpace(_request.RequesterAddress))
        {
            missingFields.Add("Street Address");
        }

        bool reqEventType = _settings?.RequireEventType ?? true;
        if (reqEventType && string.IsNullOrWhiteSpace(_request.EventType))
        {
            missingFields.Add("Event Type / Occasion");
        }

        bool showGuests = _settings?.ShowGuestCountField ?? true;
        bool reqGuests = _settings?.RequireGuestCount ?? false;
        if (showGuests && reqGuests && (_request.GuestCount == null || _request.GuestCount <= 0))
        {
            missingFields.Add("Estimated Guest Count");
        }

        if (string.IsNullOrWhiteSpace(_request.RoomSelected))
        {
            missingFields.Add("Room / Space Selection");
        }

        if (string.IsNullOrWhiteSpace(_request.ApplicantSignature))
        {
            missingFields.Add("Applicant Signature");
        }

        // Validate visible required policies
        var visibleRequired = GetVisiblePolicies().Where(p => p.IsRequired);
        foreach (var pol in visibleRequired)
        {
            if (!_agreedPolicyIds.Contains(pol.Id))
            {
                missingFields.Add($"Agreement to '{pol.Title}'");
            }
        }

        if (!_request.RulesAgreed)
        {
            missingFields.Add("Acknowledgment of GFC Policies");
        }

        if (missingFields.Any())
        {
            _errorMessage = $"The following required fields are missing: {string.Join(", ", missingFields)}.";
            try
            {
                await JSRuntime.InvokeVoidAsync("eval", "document.getElementById('topErrorBanner')?.scrollIntoView({ behavior: 'smooth', block: 'center' });");
            }
            catch { }
            return;
        }

        _isSubmitting = true;
        _errorMessage = null;

        try
        {
            _request.RequesterName = _request.ApplicantName;

            // Serialize all agreed policies for full record transparency
            var agreedList = new List<object>();
            var allVis = GetVisiblePolicies();
            foreach (var p in allVis)
            {
                if (_agreedPolicyIds.Contains(p.Id))
                {
                    agreedList.Add(new
                    {
                        Id = p.Id,
                        Title = p.Title,
                        Agreed = true,
                        DisplayMode = p.DisplayMode
                    });
                }
            }
            if (_request.RulesAgreed)
            {
                agreedList.Add(new
                {
                    Id = "general_rules",
                    Title = _settings?.RentalFormRulesText ?? "I have read and understand all GFC rental policies",
                    Agreed = true,
                    DisplayMode = "GeneralRules"
                });
            }
            _request.AgreedPoliciesJson = System.Text.Json.JsonSerializer.Serialize(agreedList);

            bool isTest = (_settings?.EnableSandboxMode == true) || (_settings?.FormIngestionMode == "Simulation");

            await RentalService.SubmitPublicRentalRequestAsync(_request, isTest);
            _isSubmitted = true;
            try
            {
                await JSRuntime.InvokeVoidAsync("eval", "window.scrollTo({ top: 0, behavior: 'smooth' });");
            }
            catch { }
        }
        catch (Exception ex)
        {
            var detail = ex.InnerException != null ? $"{ex.Message} (Details: {ex.InnerException.Message})" : ex.Message;
            _errorMessage = "Error submitting application: " + detail;
            try
            {
                await JSRuntime.InvokeVoidAsync("eval", "document.getElementById('topErrorBanner')?.scrollIntoView({ behavior: 'smooth', block: 'center' });");
            }
            catch { }
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private void ResetForm()
    {
        _selectedAddonIds.Clear();
        _agreedPolicyIds.Clear();
        _questionAnswers.Clear();
        _request = new()
        {
            EventDate = DateTime.Today.AddDays(14),
            StartTime = "2:00 PM",
            EndTime = "7:00 PM",
            GuestCount = 50,
            RoomSelected = _availableRooms.FirstOrDefault()?.Name ?? "Function Hall",
            MemberStatus = false
        };
        _isSubmitted = false;
        _errorMessage = null;
        RecalculatePricing();
    }
}
