@code {
    private HallRentalRequest _request = new()
    {
        EventDate = DateTime.Today.AddDays(14),
        StartTime = string.Empty,
        EndTime = string.Empty,
        GuestCount = null,
        MemberStatus = false
    };

    private HallRentalRequest _inquiryModel = new()
    {
        EventDate = DateTime.MinValue,
        EventType = string.Empty,
        GuestCount = null
    };

    private string _inquiryContactPreference = "Email"; // "Email", "Phone", "Both"
    private string _activeFormMode = "book"; // "book" or "inquiry"
    private bool _showInquiryModal = false;
    private bool _isInquirySubmitting = false;
    private bool _isInquirySubmitted = false;
    private string? _inquiryErrorMessage;

    private WebsiteSettings? _settings;
    private List<RentalRoomOption> _availableRooms = new();
    private List<RentalAddonOption> _availableAddons = new();
    private List<RentalPolicyItem> _policies = new();
    private HashSet<string> _selectedAddonIds = new();
    private HashSet<string> _agreedPolicyIds = new();
    private Dictionary<string, bool> _questionAnswers = new();

    // Guided Wizard State
    private int _wizardStep = 1;
    private string? _wizardStepError;

    private void GoToStep(int step)
    {
        _wizardStepError = null;
        if (step > _wizardStep)
        {
            if (_wizardStep == 1 && !ValidateStep1()) return;
            if (_wizardStep == 2 && !ValidateStep2()) return;
        }
        _wizardStep = Math.Clamp(step, 1, 3);
        try
        {
            JSRuntime.InvokeVoidAsync("eval", "window.scrollTo({ top: 120, behavior: 'smooth' });");
        }
        catch { }
    }

    private void NextStep()
    {
        _wizardStepError = null;
        if (_wizardStep == 1)
        {
            if (!ValidateStep1()) return;
            _wizardStep = 2;
        }
        else if (_wizardStep == 2)
        {
            if (!ValidateStep2()) return;
            _wizardStep = 3;
        }
        try
        {
            JSRuntime.InvokeVoidAsync("eval", "window.scrollTo({ top: 120, behavior: 'smooth' });");
        }
        catch { }
    }

    private void PrevStep()
    {
        _wizardStepError = null;
        if (_wizardStep > 1)
        {
            _wizardStep--;
            try
            {
                JSRuntime.InvokeVoidAsync("eval", "window.scrollTo({ top: 120, behavior: 'smooth' });");
            }
            catch { }
        }
    }

    private bool ValidateStep1()
    {
        if (string.IsNullOrEmpty(_selectedTierCardId))
        {
            _wizardStepError = "Please select a Renter Category / Tier before continuing.";
            return false;
        }

        var activeCard = (_settings?.GetTierCardsList() ?? WebsiteSettings.GetDefaultTierCards()).FirstOrDefault(c => c.Id == _selectedTierCardId);
        if (activeCard?.Qualification != null && activeCard.Qualification.IsEnabled && !_qualificationAnswers.ContainsKey(activeCard.Id))
        {
            _wizardStepError = $"Please complete the '{activeCard.Title}' qualification questionnaire before continuing.";
            return false;
        }

        if (IsCurrentCategoryUnavailableOnDay())
        {
            _wizardStepError = $"The hall or selected category is unavailable on {_request.EventDate:dddd}s. Please pick another date.";
            return false;
        }

        if (IsCurrentSelectionBooked())
        {
            _wizardStepError = "The selected date or time block is already booked. Please choose another slot or date.";
            return false;
        }

        var activeSlots = GetActiveTimeSlots();
        if (activeSlots.Count > 0 && !activeSlots.Any(s => _request.StartTime == s.StartTime && _request.EndTime == s.EndTime))
        {
            _wizardStepError = "Please select one of the available time blocks for your date.";
            return false;
        }

        return true;
    }

    private bool ValidateStep2()
    {
        bool reqName = _settings?.RequireApplicantName ?? true;
        if (reqName && string.IsNullOrWhiteSpace(_request.ApplicantName))
        {
            _wizardStepError = "Please enter your Full Name or Organization.";
            return false;
        }

        bool reqEmail = _settings?.RequireEmail ?? true;
        if (reqEmail && string.IsNullOrWhiteSpace(_request.RequesterEmail))
        {
            _wizardStepError = "Please enter your Email Address.";
            return false;
        }

        bool reqPhone = _settings?.RequirePhone ?? true;
        if (reqPhone)
        {
            if (string.IsNullOrWhiteSpace(_request.RequesterPhone))
            {
                _wizardStepError = "Please enter your Phone Number.";
                return false;
            }
            var digits = System.Text.RegularExpressions.Regex.Replace(_request.RequesterPhone, @"\D", "");
            if (digits.Length < 10)
            {
                _wizardStepError = "Please enter a valid 10-digit phone number with area code.";
                return false;
            }
        }

        bool showAddress = _settings?.ShowAddressField ?? true;
        bool reqAddress = _settings?.RequireAddress ?? false;
        if (showAddress && reqAddress)
        {
            if (string.IsNullOrWhiteSpace(_request.RequesterAddress) ||
                string.IsNullOrWhiteSpace(_request.RequesterCity) ||
                string.IsNullOrWhiteSpace(_request.RequesterState) ||
                string.IsNullOrWhiteSpace(_request.RequesterZip))
            {
                _wizardStepError = "Please complete all address fields (Street, City, State, ZIP).";
                return false;
            }
        }

        bool reqEventType = _settings?.RequireEventType ?? true;
        if (reqEventType && string.IsNullOrWhiteSpace(_request.EventType))
        {
            _wizardStepError = "Please select an Event Type / Occasion.";
            return false;
        }

        bool showGuests = _settings?.ShowGuestCountField ?? true;
        bool reqGuests = _settings?.RequireGuestCount ?? false;
        if (showGuests && reqGuests && (_request.GuestCount == null || _request.GuestCount <= 0))
        {
            _wizardStepError = "Please enter an estimated guest count.";
            return false;
        }

        return true;
    }

