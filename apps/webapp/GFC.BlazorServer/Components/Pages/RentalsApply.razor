@page "/rentals/apply"
@using GFC.Core.Models
@using GFC.BlazorServer.Services
@using GFC.Core.Interfaces
@inject IRentalService RentalService
@inject GFC.Core.Interfaces.IWebsiteSettingsService WebsiteSettingsService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]

<div class="gfc-public-rental-page @(_isEmbedded ? "embedded-mode" : "fullpage-mode")">
    <div class="container @(_isEmbedded ? "p-0" : "py-4")" style="max-width: 860px;">
        @if (!_isEmbedded)
        {
            <div class="text-center mb-4 gfc-hero-header">
                <h2 class="club-title fw-bold text-dark mb-1">
                    <i class="bi bi-building text-primary me-2"></i>@(_settings?.RentalFormSubtitle ?? "Gloucester Fraternity Club")
                </h2>
                <h5 class="club-subtitle text-muted mb-0">@(_settings?.RentalFormTitle ?? "Hall Rental Application")</h5>
                <p class="small text-secondary mt-1">@(_settings?.RentalFormIntroText ?? "27 Webster Street, Gloucester, MA 01930 | (978) 283-2889")</p>
            </div>
        }

        <!-- OPTION A: TOP CHOICE FORK (SLEEK MODERN PILL / CARD SELECTOR) -->
        @if (_settings?.EnableInquiryForkBanner == true && !_isSubmitted && !_isInquirySubmitted)
        {
            <div class="gfc-fork-modern-wrapper mb-4">
                <div class="text-center mb-3">
                    <h5 class="fw-bold text-dark mb-1 d-flex align-items-center justify-content-center gap-2">
                        <span>@(_settings.InquiryForkBannerTitle ?? "Planning an Event at the Gloucester Fraternity Club?")</span>
                    </h5>
                    <p class="text-muted small mb-0">@(_settings.InquiryForkBannerSubtitle ?? "Select whether you are ready to book a date or would like to ask our committee a question.")</p>
                </div>

                <div class="gfc-fork-grid">
                    <!-- Option 1: Formal Booking Application -->
                    <div class="gfc-fork-tile @(_activeFormMode == "book" ? "active-book" : "")" @onclick='() => SetFormMode("book")'>
                        <div class="gfc-fork-icon-box book-icon">
                            <i class="bi bi-calendar2-check"></i>
                        </div>
                        <div class="gfc-fork-content">
                            <div class="d-flex align-items-center justify-content-between mb-1">
                                <h6 class="gfc-fork-heading mb-0">@(_settings.InquiryForkCardBookTitle ?? "Ready to Book?")</h6>
                                @if (_activeFormMode == "book")
                                {
                                    <span class="gfc-fork-pill-status book-status"><i class="bi bi-check2"></i> Active</span>
                                }
                            </div>
                            <p class="gfc-fork-desc mb-0">@(_settings.InquiryForkCardBookText ?? "Select your date, room, and amenities to submit a formal rental application.")</p>
                        </div>
                        <div class="gfc-fork-chevron">
                            <i class="bi bi-arrow-right-short"></i>
                        </div>
                    </div>

                    <!-- Option 2: Pre-Booking Question / Inquiry -->
                    <div class="gfc-fork-tile @(_activeFormMode == "inquiry" ? "active-inquiry" : "")" @onclick='() => SetFormMode("inquiry")'>
                        <div class="gfc-fork-icon-box inquiry-icon">
                            <i class="bi bi-chat-dots"></i>
                        </div>
                        <div class="gfc-fork-content">
                            <div class="d-flex align-items-center justify-content-between mb-1">
                                <h6 class="gfc-fork-heading mb-0">@(_settings.InquiryForkCardAskTitle ?? "Have Questions First?")</h6>
                                @if (_activeFormMode == "inquiry")
                                {
                                    <span class="gfc-fork-pill-status inq-status"><i class="bi bi-check2"></i> Active</span>
                                }
                            </div>
                            <p class="gfc-fork-desc mb-0">@(_settings.InquiryForkCardAskText ?? "Ask about catering, rules, bar service, or date availability without filling out an entire contract.")</p>
                        </div>
                        <div class="gfc-fork-chevron">
                            <i class="bi bi-arrow-right-short"></i>
                        </div>
                    </div>
                </div>
            </div>
        }

        <!-- INQUIRY SUBMISSION SUCCESS VIEW -->
        @if (_isInquirySubmitted)
        {
            <div class="card shadow-sm border-0 submission-success-card text-center p-5 bg-white rounded-4 mb-4">
                <div class="success-icon mb-3">
                    <i class="bi bi-check-circle-fill text-success" style="font-size: 4rem;"></i>
                </div>
                <h3 class="fw-bold text-dark mb-2">Question Received!</h3>
                <p class="text-muted mb-4 lead">
                    Thank you, <strong>@_inquiryModel.ApplicantName</strong>. Our rental team has received your message and will review it and get back to you directly 
                    @if (_inquiryModel.RequestPhoneCall && !string.IsNullOrWhiteSpace(_inquiryModel.RequesterPhone))
                    {
                        <span>by phone at <strong class="text-dark">@_inquiryModel.RequesterPhone</strong> (or email at <strong class="text-dark">@_inquiryModel.RequesterEmail</strong>)</span>
                    }
                    else
                    {
                        <span>at <strong class="text-dark">@_inquiryModel.RequesterEmail</strong></span>
                    }.
                </p>
                <div class="summary-box p-4 bg-light rounded-4 text-start mx-auto mb-4 border" style="max-width: 580px;">
                    <div class="d-flex justify-content-between align-items-center border-bottom pb-2 mb-2">
                        <h6 class="fw-bold text-dark mb-0"><i class="bi bi-chat-left-text me-2 text-primary"></i>Your Question</h6>
                        @if (_inquiryModel.RequestPhoneCall)
                        {
                            <span class="badge bg-success-subtle text-success border border-success px-2 py-1 rounded-pill small">
                                <i class="bi bi-telephone-fill me-1"></i>Phone Callback Requested
                            </span>
                        }
                    </div>
                    <p class="small text-dark mb-0 font-monospace" style="white-space: pre-wrap;">@_inquiryModel.EventDescription</p>
                </div>
                <div class="d-flex justify-content-center gap-2 mt-2 flex-wrap">
                    <button type="button" class="btn btn-primary px-4 fw-bold shadow-sm" @onclick='() => SetFormMode("book")'>
                        <i class="bi bi-calendar2-plus me-1"></i> Ready to Book a Date?
                    </button>
                    <a href="https://gloucesterfraternityclub.com" class="btn btn-outline-secondary px-4">
                        <i class="bi bi-box-arrow-up-right me-1"></i> Return to Main Website
                    </a>
                </div>
            </div>
        }
        else if (_isSubmitted)
        {
            <div class="card shadow-sm border-0 submission-success-card text-center p-5">
                <div class="success-icon mb-3">
                    <i class="bi bi-check-circle-fill text-success" style="font-size: 4rem;"></i>
                </div>
                <h3 class="fw-bold text-dark mb-2">Application Submitted Successfully!</h3>
                <p class="text-muted mb-4 lead">
                    Thank you, <strong>@_request.ApplicantName</strong>. Your rental request for <strong>@_request.EventDate.ToString("dddd, MMMM d, yyyy")</strong> has been received and added to our calendar as <strong>Pending</strong>.
                </p>
                <div class="summary-box p-4 bg-light rounded-3 text-start mx-auto mb-4" style="max-width: 600px;">
                    <h6 class="fw-bold text-dark mb-2 border-bottom pb-2"><i class="bi bi-receipt me-2"></i>Application Summary</h6>
                    <div class="row g-2 small">
                        <div class="col-6 text-muted">Room:</div>
                        <div class="col-6 fw-bold text-end">@_request.RoomSelected</div>

                        <div class="col-6 text-muted">Event Type:</div>
                        <div class="col-6 fw-bold text-end">@_request.EventType</div>

                        @if (_settings?.ShowGuestCountField ?? true)
                        {
                            <div class="col-6 text-muted">Estimated Guests:</div>
                            <div class="col-6 fw-bold text-end">@_request.GuestCount guests</div>
                        }

                        <div class="col-6 text-muted">Estimated Total:</div>
                        <div class="col-6 fw-bold text-primary text-end fs-6">$@_request.TotalPrice.ToString("N2")</div>

                        @if ((_settings?.RequireSecurityDeposit ?? true) && _request.SecurityDepositAmount > 0)
                        {
                            <div class="col-6 text-muted">Security Deposit:</div>
                            <div class="col-6 fw-bold text-dark text-end">$@_request.SecurityDepositAmount.ToString("N2")</div>
                        }
                    </div>
                </div>
                <p class="small text-muted mb-4">
                    @(_settings?.RentalFormSuccessMessage ?? "The Hall Rental Committee will review your date and reach out to you directly to confirm booking and arrange deposit payment.")
                </p>
                <div class="d-flex justify-content-center gap-2 mt-2">
                    <a href="https://gloucesterfraternityclub.com" class="btn btn-outline-secondary px-4">
                        <i class="bi bi-box-arrow-up-right me-1"></i> Return to Main Website
                    </a>
                </div>
            </div>
        }
        else if (_activeFormMode == "inquiry")
        {
            <!-- INLINE QUICK QUESTION / INQUIRY FORM -->
            <div class="card shadow-sm border-0 bg-white rounded-4 overflow-hidden mb-4 animate-fade-in">
                <div class="card-header bg-white border-bottom py-3 px-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <h5 class="mb-0 fw-bold text-dark">
                            <i class="bi bi-question-circle-fill text-warning me-2"></i>Ask a Question / General Inquiry
                        </h5>
                        <button type="button" class="btn btn-sm btn-outline-primary fw-semibold" @onclick='() => SetFormMode("book")'>
                            Switch to Full Booking Form <i class="bi bi-arrow-right ms-1"></i>
                        </button>
                    </div>
                    <small class="text-muted">Have a question about rules, dates, or catering before reserving? Let us know below!</small>
                </div>

                <div class="card-body p-4">
                    @if (!string.IsNullOrEmpty(_inquiryErrorMessage))
                    {
                        <div class="alert alert-danger py-2 px-3 small rounded-3 mb-3 d-flex align-items-center gap-2">
                            <i class="bi bi-exclamation-triangle-fill text-danger"></i>
                            <div>@_inquiryErrorMessage</div>
                        </div>
                    }

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold small text-dark mb-1">Your Name / Organization *</label>
                            <input type="text" class="form-control" placeholder="e.g. Jane Doe" @bind="_inquiryModel.ApplicantName" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold small text-dark mb-1">Email Address *</label>
                            <input type="email" class="form-control" placeholder="e.g. jane.doe@example.com" @bind="_inquiryModel.RequesterEmail" />
                        </div>
                        
                        <!-- Optional Target Date & Occasion -->
                        <div class="col-md-6">
                            <label class="form-label fw-bold small text-dark mb-1">Target Date or Timeframe (Optional)</label>
                            <input type="date" class="form-control" value="@(_inquiryModel.EventDate > DateTime.MinValue ? _inquiryModel.EventDate.ToString("yyyy-MM-dd") : "")" @onchange="OnInquiryDateChanged" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold small text-dark mb-1">Occasion / Event Type (Optional)</label>
                            <input type="text" class="form-control" placeholder="e.g. Birthday Party, Shower, Meeting" @bind="_inquiryModel.EventType" />
                        </div>

                        <!-- Phone Contact Preference -->
                        <div class="col-12">
                            <div class="p-3 bg-light rounded-3 border">
                                <label class="form-label fw-bold small text-dark mb-2 d-block">Would you like us to contact you by phone?</label>
                                <div class="d-flex gap-3 mb-2">
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio" name="inqPhonePref" id="inqPhoneNo" checked="@(!_inquiryRequestPhoneCall)" @onchange="() => { _inquiryRequestPhoneCall = false; _inquiryModel.RequesterPhone = string.Empty; }" />
                                        <label class="form-check-label small text-dark" for="inqPhoneNo">No, email correspondence is fine</label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio" name="inqPhonePref" id="inqPhoneYes" checked="@_inquiryRequestPhoneCall" @onchange="() => _inquiryRequestPhoneCall = true" />
                                        <label class="form-check-label small text-dark fw-bold" for="inqPhoneYes">Yes, please call me</label>
                                    </div>
                                </div>

                                @if (_inquiryRequestPhoneCall)
                                {
                                    <div class="mt-2 pt-2 border-top animate-fade-in">
                                        <label class="form-label fw-bold small text-dark mb-1">Phone Number *</label>
                                        <input type="tel" class="form-control form-control-sm" placeholder="e.g. (978) 555-0123" value="@_inquiryModel.RequesterPhone" @onchange="OnInquiryPhoneChanged" />
                                        <small class="text-muted" style="font-size: 0.75rem;">A 10-digit phone number is required for phone callbacks.</small>
                                    </div>
                                }
                            </div>
                        </div>

                        <div class="col-12">
                            <label class="form-label fw-bold small text-dark mb-1">Your Question or Message *</label>
                            <textarea class="form-control" rows="5" placeholder="Tell us what you'd like to know (e.g. catering questions, setup times, specific date availability, etc.)..." @bind="_inquiryModel.EventDescription"></textarea>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mt-4 pt-3 border-top">
                        <button type="button" class="btn btn-outline-secondary" @onclick='() => SetFormMode("book")'>
                            Cancel &amp; Go to Booking Form
                        </button>
                        <button type="button" class="btn btn-primary px-4 fw-bold shadow-sm d-flex align-items-center gap-2" @onclick="HandleInquirySubmit" disabled="@_isInquirySubmitting">
                            @if (_isInquirySubmitting)
                            {
                                <span class="spinner-border spinner-border-sm"></span>
                                <span>Sending Question...</span>
                            }
                            else
                            {
                                <i class="bi bi-send-fill"></i>
                                <span>Submit Question</span>
                            }
                        </button>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="card shadow-sm border-0 rental-form-card bg-white">
                <div class="card-header bg-white border-bottom py-3 px-4 text-dark">
                    <h5 class="mb-0 fw-bold d-flex align-items-center justify-content-between">
                        <span><i class="bi bi-file-earmark-text-fill me-2 text-primary"></i>@(_settings?.RentalFormTitle ?? "Hall Rental Application")</span>
                        @if (_settings?.EnableSandboxMode == true)
                        {
                            <span class="badge bg-warning text-dark border border-dark"><i class="bi bi-tools me-1"></i>Sandbox / Test Mode</span>
                        }
                    </h5>
                </div>

                <div class="card-body p-4">
                    @if (!string.IsNullOrEmpty(_errorMessage))
                    {
                        <div id="topErrorBanner" class="alert alert-danger alert-dismissible fade show shadow-sm border-danger" role="alert">
                            <div class="d-flex align-items-start gap-2">
                                <i class="bi bi-exclamation-triangle-fill fs-5 flex-shrink-0 text-danger"></i>
                                <div class="flex-grow-1">
                                    <strong>Please review the required information:</strong>
                                    <div class="mt-1">@_errorMessage</div>
                                </div>
                                <button type="button" class="btn-close" @onclick="() => _errorMessage = null"></button>
                            </div>
                        </div>
                    }

                    <EditForm Model="@_request" OnValidSubmit="HandleSubmit">
                        <DataAnnotationsValidator />

                        <!-- Section 1: Contact Info -->
                        <div class="form-section mb-4">
                            <h6 class="section-heading fw-bold text-dark pb-2 border-bottom">
                                <i class="bi bi-person-lines-fill me-2 text-primary"></i>1. Applicant Information
                            </h6>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold small">
                                        Full Name / Organization @((_settings?.RequireApplicantName ?? true) ? "*" : "(Optional)")
                                    </label>
                                    <InputText class="form-control" placeholder="Jane Doe or Organization Name" @bind-Value="_request.ApplicantName" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold small">
                                        Email Address @((_settings?.RequireEmail ?? true) ? "*" : "(Optional)")
                                    </label>
                                    <InputText class="form-control" type="email" placeholder="jane.doe@example.com" @bind-Value="_request.RequesterEmail" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold small">
                                        Phone Number @((_settings?.RequirePhone ?? true) ? "*" : "(Optional)")
                                    </label>
                                    <input class="form-control" type="tel" placeholder="" value="@_request.RequesterPhone" @onchange="OnPhoneChanged" />
                                </div>
                                @if (_settings?.ShowAddressField ?? true)
                                {
                                    <div class="col-md-6">
                                        <label class="form-label fw-semibold small">
                                            Street Address @((_settings?.RequireAddress ?? false) ? "*" : "(Optional)")
                                        </label>
                                        <InputText class="form-control" placeholder="" @bind-Value="_request.RequesterAddress" />
                                    </div>
                                    <div class="col-md-5">
                                        <label class="form-label fw-semibold small">
                                            City @((_settings?.RequireAddress ?? false) ? "*" : "(Optional)")
                                        </label>
                                        <InputText class="form-control" placeholder="" @bind-Value="_request.RequesterCity" />
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label fw-semibold small">
                                            State @((_settings?.RequireAddress ?? false) ? "*" : "(Optional)")
                                        </label>
                                        <InputText class="form-control" placeholder="" @bind-Value="_request.RequesterState" />
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label fw-semibold small">
                                            ZIP Code @((_settings?.RequireAddress ?? false) ? "*" : "(Optional)")
                                        </label>
                                        <InputText class="form-control" placeholder="" @bind-Value="_request.RequesterZip" />
                                    </div>
                                }
                                <div class="col-12">
                                    @{
                                        var activeTierCards = (_settings?.GetTierCardsList() ?? WebsiteSettings.GetDefaultTierCards()).Where(c => c.IsEnabled).ToList();
                                    }
                                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-1 mb-2">
                                        <label class="form-label fw-bold small text-dark mb-0"><i class="bi bi-person-badge-fill text-primary me-1"></i>Select Renter Category / Tier *</label>
                                        <small class="text-muted" style="font-size: 0.75rem;">👉 Please select an applicant category to see rates and available time slots</small>
                                    </div>

                                        @if (string.IsNullOrEmpty(_selectedTierCardId))
                                        {
                                            <div class="alert alert-warning py-2 px-3 mb-2 rounded-3 border-warning d-flex align-items-center gap-2 small">
                                                <i class="bi bi-hand-index-thumb-fill text-warning fs-6"></i>
                                                <span class="fw-semibold">Please select your category below</span>
                                            </div>
                                        }

                                        <div class="row g-2">
                                            @foreach (var card in activeTierCards)
                                            {
                                                var isAvailableOnDay = IsCardAvailableForDate(card, _request.EventDate);
                                                var isCardSelected = _selectedTierCardId == card.Id;
                                                bool hasQual = card.Qualification != null && card.Qualification.IsEnabled;
                                                <div class="col-12 col-md-4">
                                                    <div class="p-3 rounded-3 border h-100 position-relative @(!isAvailableOnDay ? "bg-light opacity-75 border-secondary-subtle" : isCardSelected ? "border-primary bg-primary-subtle bg-opacity-25 shadow-sm ring-selected" : "bg-white border")"
                                                         style="@(isAvailableOnDay ? "cursor: pointer;" : "cursor: not-allowed;") transition: all 0.2s ease; border-top: 4px solid @(isAvailableOnDay ? card.ThemeColor : "#adb5bd") !important;"
                                                         @onclick="() => { if (isAvailableOnDay) SelectTierCard(card); }">
                                                        <div class="d-flex align-items-center justify-content-between mb-1">
                                                            <div class="form-check mb-0">
                                                                <input class="form-check-input" type="radio" name="tierCardRadio" checked="@(isCardSelected && isAvailableOnDay)" disabled="@(!isAvailableOnDay)" />
                                                                <label class="form-check-label fw-bold text-dark fs-6 ms-1 @(!isAvailableOnDay ? "text-muted" : "")" style="@(isAvailableOnDay ? "cursor: pointer;" : "cursor: not-allowed;")">
                                                                    @card.Title
                                                                </label>
                                                            </div>
                                                            @if (!isAvailableOnDay)
                                                            {
                                                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-2 py-0" style="font-size: 0.65rem;">UNAVAILABLE</span>
                                                            }
                                                            else if (isCardSelected)
                                                            {
                                                                <span class="badge bg-primary text-white rounded-pill px-2 py-0" style="font-size: 0.65rem;">SELECTED</span>
                                                            }
                                                        </div>
                                                        <div class="small text-muted" style="font-size: 0.78rem;">@card.Subtitle</div>
                                                        @if (hasQual && isAvailableOnDay)
                                                        {
                                                            bool isCardQualified = _qualificationAnswers.ContainsKey(card.Id);
                                                            <div class="mt-2 pt-2 border-top d-flex align-items-center justify-content-between">
                                                                @if (isCardQualified)
                                                                {
                                                                    <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 rounded-pill px-2 py-0.5" style="font-size: 0.68rem;">
                                                                        <i class="bi bi-patch-check-fill me-1"></i>Qualified
                                                                    </span>
                                                                }
                                                                else
                                                                {
                                                                    <span class="badge bg-info bg-opacity-10 text-info border border-info border-opacity-25 rounded-pill px-2 py-0.5" style="font-size: 0.68rem;">
                                                                        <i class="bi bi-patch-question-fill me-1"></i>Qualification Required
                                                                    </span>
                                                                }
                                                                @if (isCardQualified)
                                                                {
                                                                    <button type="button" class="btn btn-link btn-sm p-0 text-decoration-none text-primary" style="font-size: 0.72rem;" @onclick:stopPropagation="true" @onclick="() => ReopenQualificationModal(card)">
                                                                        <i class="bi bi-pencil me-1"></i>Edit Answers
                                                                    </button>
                                                                }
                                                            </div>
                                                        }
                                                        @if (!isAvailableOnDay)
                                                        {
                                                            <div class="pt-2 border-top mt-2">
                                                                <span class="badge bg-secondary text-white rounded-pill px-2 py-1" style="font-size: 0.7rem;">Unavailable on @(_request.EventDate.ToString("dddd"))s</span>
                                                            </div>
                                                        }
                                                    </div>
                                                </div>
                                            }
                                        </div>

                                        <!-- Sub-group dropdown if active card has special sub-groups -->
                                        @if (!string.IsNullOrEmpty(_selectedTierCardId) && activeTierCards.FirstOrDefault(c => c.Id == _selectedTierCardId) is var currentSelectedCard && currentSelectedCard != null && currentSelectedCard.SubGroups.Count > 0)
                                        {
                                            <div class="mt-3 p-3 bg-light border rounded-3">
                                                <label class="form-label fw-bold small text-dark mb-1"><i class="bi bi-diagram-3-fill text-primary me-1"></i>Special Group / Sub-Category (Optional)</label>
                                                <select class="form-select form-select-sm" value="@_selectedSubGroupId" @onchange="OnSubGroupChanged">
                                                    <option value="">-- Standard @currentSelectedCard.Title Rate ($@GetCardRateForDate(currentSelectedCard, _request.EventDate)) --</option>
                                                    @foreach (var sub in currentSelectedCard.SubGroups.Where(s => s.IsAvailable))
                                                    {
                                                        <option value="@sub.Id">@sub.Name - $@sub.Rate @(!string.IsNullOrWhiteSpace(sub.Note) ? $"({sub.Note})" : "")</option>
                                                    }
                                                </select>
                                            </div>
                                        }
                                </div>
                            </div>
                        </div>

                        <!-- Section 2: Event Details -->
                        <div class="form-section mb-4">
                            <h6 class="section-heading fw-bold text-dark pb-2 border-bottom">
                                <i class="bi bi-calendar-event me-2 text-primary"></i>2. Event Details &amp; Date Selection
                            </h6>
                            <div class="row g-3">
                                <div class="@((_settings?.ShowAlternateDateField ?? true) ? "col-md-6" : "col-md-12")">
                                    <label class="form-label fw-semibold small">Desired Date *</label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-primary-subtle text-primary fw-bold">@_request.EventDate.ToString("ddd")</span>
                                        <input type="date" class="form-control" value="@_request.EventDate.ToString("yyyy-MM-dd")" min="@DateTime.Today.AddDays(1).ToString("yyyy-MM-dd")" @onchange="OnDateChanged" />
                                    </div>
                                </div>
                                @if (_settings?.ShowAlternateDateField ?? true)
                                {
                                    <div class="col-md-6">
                                        <label class="form-label fw-semibold small">Alternate Date @((_settings?.RequireAlternateDate ?? false) ? "*" : "(Optional)")</label>
                                        <div class="input-group">
                                            @if (_request.AlternateEventDate.HasValue)
                                            {
                                                <span class="input-group-text bg-light text-secondary fw-bold">@_request.AlternateEventDate.Value.ToString("ddd")</span>
                                            }
                                            <input type="date" class="form-control" value="@(_request.AlternateEventDate?.ToString("yyyy-MM-dd") ?? "")" min="@DateTime.Today.AddDays(1).ToString("yyyy-MM-dd")" @onchange="OnAlternateDateChanged" />
                                        </div>
                                    </div>
                                }
                                @{
                                    var activeSlots = GetActiveTimeSlots();
                                    var hasConfiguredSlots = activeSlots.Count > 0;
                                }

                                @if (IsCurrentCategoryUnavailableOnDay())
                                {
                                    var dayConfig = GetCurrentDayConfig();
                                    var isDayDisabled = dayConfig != null && !dayConfig.IsAvailable;
                                    <div class="col-12">
                                        <div class="alert alert-warning d-flex align-items-center gap-2 mb-0 shadow-sm border-warning">
                                            <i class="bi bi-calendar-x-fill text-warning-emphasis fs-5 flex-shrink-0"></i>
                                            <div>
                                                @if (isDayDisabled)
                                                {
                                                    <span><strong>Day Not Available for Bookings:</strong> The hall is closed for rental bookings on <strong>@(_request.EventDate.ToString("dddd"))s</strong>. Please select a different date.</span>
                                                }
                                                else
                                                {
                                                    <span><strong>Not Available for Selected Category:</strong> Bookings for this category are unavailable on <strong>@(_request.EventDate.ToString("dddd"))s</strong>. Please pick a different date.</span>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                }
                                else if (!hasConfiguredSlots)
                                {
                                    <div class="col-md-6">
                                        <label class="form-label fw-semibold small">Start Time</label>
                                        <select class="form-select" value="@_request.StartTime" @onchange="OnStartTimeChanged">
                                            @foreach (var t in _timeOptions.Take(_timeOptions.Count - 2))
                                            {
                                                <option value="@t">@t</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label fw-semibold small">End Time</label>
                                        <select class="form-select" @bind="_request.EndTime" @bind:after="RecalculatePricing">
                                            @foreach (var t in GetAvailableEndTimes())
                                            {
                                                <option value="@t">@t</option>
                                            }
                                        </select>
                                    </div>
                                }
                                else
                                {
                                    var allSlotsBooked = activeSlots.All(s => IsSlotBooked(s));

                                    if (allSlotsBooked)
                                    {
                                        <div class="col-12">
                                            <div class="alert alert-danger d-flex align-items-center gap-2 mb-0 shadow-sm border-danger">
                                                <i class="bi bi-calendar-x-fill text-danger fs-5"></i>
                                                <div>
                                                    <strong>Fully Booked:</strong> All standard time periods for @(_request.EventDate.ToString("dddd, MMMM d, yyyy")) are already reserved. Please select another date.
                                                </div>
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        var isAnySlotSelected = activeSlots.Any(s => _request.StartTime == s.StartTime && _request.EndTime == s.EndTime);
                                        <div class="col-12">
                                            <div class="p-3 rounded-4 border @(!isAnySlotSelected ? "bg-warning-subtle border-warning shadow-sm" : "bg-white border-primary-subtle shadow-sm")" style="transition: all 0.3s ease;">
                                                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
                                                    <label class="form-label fw-bold small text-dark mb-0 d-flex align-items-center gap-2">
                                                        <i class="bi bi-clock-history text-primary fs-6"></i>
                                                        <span>Select Time Block for @(_request.EventDate.ToString("dddd")) *</span>
                                                    </label>
                                                    @if (!isAnySlotSelected)
                                                    {
                                                        <span class="badge bg-warning text-dark border border-warning px-2 py-1 small fw-bold">
                                                            <i class="bi bi-hand-index-thumb me-1"></i>Action Required: Click a time block
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-success-subtle text-success border border-success px-2 py-1 small fw-bold">
                                                            <i class="bi bi-check2-circle me-1"></i>Time Block Selected
                                                        </span>
                                                    }
                                                </div>

                                                @if (!isAnySlotSelected)
                                                {
                                                    <div class="alert alert-warning py-2 px-3 mb-2 rounded-3 border-warning d-flex align-items-center gap-2 small">
                                                        <i class="bi bi-exclamation-triangle-fill text-warning-emphasis fs-6 flex-shrink-0"></i>
                                                        <span class="fw-semibold">Please select one of the available time blocks below.</span>
                                                    </div>
                                                }

                                                <div class="d-flex flex-row flex-wrap align-items-center gap-2 pt-1">
                                                    @foreach (var slot in activeSlots)
                                                    {
                                                        var isBooked = IsSlotBooked(slot);
                                                        var isSlotSelected = _request.StartTime == slot.StartTime && _request.EndTime == slot.EndTime;
                                                        
                                                        <button type="button" 
                                                                disabled="@isBooked"
                                                                class="btn d-inline-flex align-items-center gap-2 px-3 py-2 rounded-3 text-nowrap @(isBooked ? "btn-light border text-muted opacity-50 pe-none" : isSlotSelected ? "btn-primary text-white fw-bold shadow ring-selected" : "btn-outline-primary bg-white text-dark border shadow-sm")" 
                                                                style="@(isBooked ? "cursor: not-allowed;" : "cursor: pointer; font-size: 0.9rem; transition: all 0.2s ease;")"
                                                                @onclick="() => SelectTimeSlot(slot)">
                                                            <i class="bi @(isBooked ? "bi-slash-circle text-danger" : isSlotSelected ? "bi-check-circle-fill text-white fs-6" : "bi-circle text-primary fs-6")"></i>
                                                            <span class="fw-bold @(isBooked ? "text-decoration-line-through text-muted" : "")">@slot.Label:</span>
                                                            <span class="badge @(isSlotSelected && !isBooked ? "bg-white text-primary fw-bold fs-6" : "bg-light text-dark border") ms-1">@slot.StartTime - @slot.EndTime</span>
                                                            @if (isBooked)
                                                            {
                                                                <span class="badge bg-danger text-white ms-1">Unavailable</span>
                                                            }
                                                        </button>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    }
                                }

                                <!-- Explicit Selected Date & Time Status Bar -->
                                <div class="col-12">
                                    <div class="p-3 bg-light border border-primary-subtle rounded-3 shadow-sm">
                                        <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
                                            <div class="d-flex align-items-center gap-3 flex-wrap">
                                                <div>
                                                    <small class="text-muted text-uppercase fw-bold d-block" style="font-size: 0.7rem; letter-spacing: 0.5px;">Selected Date</small>
                                                    <span class="fw-bold text-dark"><i class="bi bi-calendar2-check-fill text-primary me-1"></i>@_request.EventDate.ToString("dddd, MMMM d, yyyy")</span>
                                                </div>
                                                @if (_request.AlternateEventDate.HasValue)
                                                {
                                                    <div class="border-start ps-3 d-none d-md-block" style="height: 28px;"></div>
                                                    <div>
                                                        <small class="text-muted text-uppercase fw-bold d-block" style="font-size: 0.7rem; letter-spacing: 0.5px;">Alternate Date</small>
                                                        <span class="fw-bold text-secondary"><i class="bi bi-calendar-event me-1"></i>@_request.AlternateEventDate.Value.ToString("MMM d, yyyy")</span>
                                                    </div>
                                                }
                                                <div class="border-start ps-3 d-none d-md-block" style="height: 28px;"></div>
                                                <div>
                                                    <small class="text-muted text-uppercase fw-bold d-block" style="font-size: 0.7rem; letter-spacing: 0.5px;">Selected Time Period</small>
                                                    @if (IsCurrentCategoryUnavailableOnDay())
                                                    {
                                                        <div class="d-flex align-items-center gap-2">
                                                            <span class="fw-bold text-danger"><i class="bi bi-x-circle-fill text-danger me-1"></i>Category Unavailable on @_request.EventDate.ToString("dddd")s</span>
                                                        </div>
                                                    }
                                                    else if (IsCurrentSelectionBooked())
                                                    {
                                                        <div class="d-flex align-items-center gap-2">
                                                            <span class="fw-bold text-danger"><i class="bi bi-x-circle-fill text-danger me-1"></i>Date / Time Period Unavailable</span>
                                                        </div>
                                                    }
                                                    else if (!string.IsNullOrEmpty(_request.StartTime) && !string.IsNullOrEmpty(_request.EndTime))
                                                    {
                                                        <div class="d-flex align-items-center gap-2">
                                                            <span class="fw-bold text-dark"><i class="bi bi-clock-fill text-primary me-1"></i>@_request.StartTime to @_request.EndTime</span>
                                                            <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-10 rounded-pill" style="font-size: 0.72rem;">@(_calculatedDurationHours) hrs</span>
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <div class="d-flex align-items-center gap-2">
                                                            <span class="fw-bold text-secondary"><i class="bi bi-clock me-1"></i>Standard @(_settings?.BaseFunctionHours ?? 5) hrs Function</span>
                                                        </div>
                                                    }
                                                </div>
                                                
                                                <!-- Rate Display in Status Bar -->
                                                <div class="border-start ps-3 d-none d-md-block" style="height: 28px;"></div>
                                                <div>
                                                    <small class="text-muted text-uppercase fw-bold d-block" style="font-size: 0.7rem; letter-spacing: 0.5px;">@_request.EventDate.ToString("dddd") Rate</small>
                                                    @if (IsCurrentSelectionBooked() || IsCurrentCategoryUnavailableOnDay())
                                                    {
                                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1 fw-bold fs-6">
                                                            <i class="bi bi-slash-circle me-1"></i>Unavailable
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        if (string.IsNullOrEmpty(_selectedTierCardId))
                                                        {
                                                            <span class="badge bg-warning text-dark border border-warning px-2 py-1 fw-bold fs-6">
                                                                <i class="bi bi-hand-index-thumb me-1"></i>Select Category
                                                            </span>
                                                        }
                                                        else
                                                        {
                                                            var selCard = (_settings?.GetTierCardsList() ?? WebsiteSettings.GetDefaultTierCards()).FirstOrDefault(c => c.Id == _selectedTierCardId);
                                                            if (selCard != null)
                                                            {
                                                                if (IsCardAvailableForDate(selCard, _request.EventDate))
                                                                {
                                                                    <span class="fw-bolder text-primary fs-5 d-inline-flex align-items-center">
                                                                        <i class="bi bi-tag-fill me-1 fs-6"></i>$@GetRoomPrice(_request.RoomSelected ?? "Function Hall").ToString("N0")
                                                                    </span>
                                                                }
                                                                else
                                                                {
                                                                    <span class="badge bg-danger text-white border border-danger px-2 py-1 fw-bold fs-6">
                                                                        <i class="bi bi-x-circle me-1"></i>Unavailable on @(_request.EventDate.ToString("dddd"))s
                                                                    </span>
                                                                }
                                                            }
                                                        }
                                                    }
                                                </div>

                                                @if (!string.IsNullOrEmpty(_request.RoomSelected))
                                                {
                                                    <div class="border-start ps-3 d-none d-md-block" style="height: 28px;"></div>
                                                    <div>
                                                        <small class="text-muted text-uppercase fw-bold d-block" style="font-size: 0.7rem; letter-spacing: 0.5px;">Selected Space</small>
                                                        <span class="fw-bold text-primary"><i class="bi bi-door-open-fill me-1"></i>@_request.RoomSelected</span>
                                                    </div>
                                                }
                                            </div>
                                            <div>
                                                @if (IsCurrentSelectionBooked())
                                                {
                                                    <span class="badge bg-danger bg-opacity-10 text-danger border border-danger-subtle px-2 py-1 rounded-pill small">
                                                        <i class="bi bi-exclamation-octagon-fill me-1"></i>Date / Time Unavailable
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-success bg-opacity-10 text-success border border-success-subtle px-2 py-1 rounded-pill small">
                                                        <i class="bi bi-check2-circle me-1"></i>Ready for Application
                                                    </span>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label fw-semibold small">
                                        Event Type / Occasion @((_settings?.RequireEventType ?? true) ? "*" : "(Optional)")
                                    </label>
                                    <select class="form-select" @bind="_request.EventType">
                                        <option value="">-- Select Event Type --</option>
                                        @foreach (var evType in _eventTypeOptions)
                                        {
                                            <option value="@evType">@evType</option>
                                        }
                                    </select>
                                </div>

                                @if (_settings?.ShowGuestCountField ?? true)
                                {
                                    <div class="col-md-6">
                                        <label class="form-label fw-semibold small">
                                            Estimated Guest Count @((_settings?.RequireGuestCount ?? false) ? "*" : "(Optional)")
                                        </label>
                                        <InputNumber class="form-control" min="1" max="500" @bind-Value="_request.GuestCount" />
                                    </div>
                                }

                                <div class="col-12">
                                    <label class="form-label fw-semibold small">
                                         Event Description / Notes <span class="text-muted">(Special requests, setup details, DJ / band, etc.)</span>
                                     </label>
                                     <InputTextArea class="form-control" rows="3" placeholder="Please describe your planned affair, music, setup, or specific requirements..." @bind-Value="_request.EventDescription" />
                                </div>
                            </div>
                        </div>

                        <!-- Section 3: Add-on Services -->
                        @if (_availableAddons.Any())
                        {
                            <div class="form-section mb-4">
                                <h6 class="section-heading fw-bold text-dark pb-2 border-bottom">
                                    <i class="bi bi-plus-circle-fill me-2 text-primary"></i>3. Add-on Services &amp; Amenities
                                </h6>
                                <div class="row g-3">
                                    @foreach (var addon in _availableAddons)
                                    {
                                        bool isSelected = _selectedAddonIds.Contains(addon.Id);
                                        bool isBar = addon.Id == "addon_bar" || addon.Name.Contains("Bar", StringComparison.OrdinalIgnoreCase);
                                        <div class="col-12 col-sm-6 col-md-4">
                                            <div class="form-check p-3 bg-white rounded-3 border h-100 @(isSelected ? "border-primary bg-primary-subtle bg-opacity-25 shadow-sm ring-selected" : "")" style="cursor: pointer; transition: all 0.2s ease;" @onclick="() => ToggleAddon(addon.Id)">
                                                <div class="d-flex align-items-start">
                                                    <input class="form-check-input ms-0 me-2 mt-1" type="checkbox" checked="@isSelected" />
                                                    <div class="flex-grow-1 ms-2">
                                                        <div class="d-flex align-items-center justify-content-between gap-1 mb-1">
                                                            <label class="form-check-label fw-bold text-dark d-block">
                                                                @addon.Name
                                                            </label>
                                                            @if (isBar)
                                                            {
                                                                <span class="badge bg-warning bg-opacity-25 text-dark border border-warning border-opacity-50" style="font-size: 0.65rem;">
                                                                    <i class="bi bi-cup-straw me-1"></i>ALCOHOL
                                                                </span>
                                                            }
                                                        </div>
                                                        <div class="small text-muted mb-2" style="font-size: 0.8rem; line-height: 1.4; white-space: pre-line;">@addon.Description</div>
                                                        <div class="small fw-bold text-primary">+@($"${addon.Fee:N2}")</div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        }

                        <!-- Section 4: Dynamic Quote & Total (Clean Light Card) -->
                        <div class="pricing-summary-card p-4 rounded-4 bg-white border border-primary-subtle shadow-sm mb-4">
                            <div class="row align-items-center g-3">
                                <div class="col-12 col-sm-7">
                                    <span class="text-uppercase tracking-wider small fw-bold text-primary d-block mb-1">
                                        <i class="bi bi-calculator me-1"></i>Live Estimated Total
                                    </span>
                                    <div class="d-flex align-items-baseline gap-2">
                                        @if (IsCurrentSelectionBooked() || IsCurrentCategoryUnavailableOnDay())
                                        {
                                            <h2 class="display-6 fw-bold mb-0 text-muted fs-3">--</h2>
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1 small">
                                                <i class="bi bi-calendar-x me-1"></i>Date Unavailable
                                            </span>
                                        }
                                        else if (string.IsNullOrEmpty(_selectedTierCardId))
                                        {
                                            <h2 class="display-6 fw-bold mb-0 text-muted fs-3">--</h2>
                                            <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle px-2 py-1 small">
                                                <i class="bi bi-exclamation-circle me-1"></i>Select a tier above
                                            </span>
                                        }
                                        else
                                        {
                                            <h2 class="display-6 fw-bold mb-0 text-dark">$@_request.TotalPrice.ToString("N2")</h2>
                                            <span class="badge bg-light text-dark border px-2 py-1 small">
                                                <i class="bi bi-clock me-1"></i>@(_calculatedDurationHours) hrs total
                                            </span>
                                        }
                                    </div>
                                    @if (!IsCurrentSelectionBooked() && !IsCurrentCategoryUnavailableOnDay() && _extraHours > 0 && !string.IsNullOrEmpty(_selectedTierCardId))
                                    {
                                        <div class="small text-primary mt-1 fw-semibold">
                                            <i class="bi bi-plus-circle me-1"></i>Includes +@(_extraHours) extra hrs (@($"${_settings?.AdditionalHourRate ?? 50:N2}")/hr = +$@_extraHoursFee.ToString("N2"))
                                        </div>
                                    }
                                    @if (!IsCurrentSelectionBooked() && !IsCurrentCategoryUnavailableOnDay() && (_settings?.RequireSecurityDeposit ?? true) && _request.SecurityDepositAmount > 0)
                                    {
                                        <div class="small text-muted mt-1">
                                            <i class="bi bi-shield-check text-success me-1"></i>+ $@_request.SecurityDepositAmount.ToString("N2") Refundable Security Deposit
                                        </div>
                                    }
                                </div>
                                <div class="col-12 col-sm-5 text-sm-end">
                                    <div class="p-2 px-3 rounded-3 bg-light border text-dark fw-bold small d-inline-block text-wrap w-100 w-sm-auto text-start text-sm-end">
                                        <div class="text-muted small" style="font-size: 0.75rem;">Selected Package</div>
                                        <div class="text-truncate">@_request.RoomSelected</div>
                                        @{
                                            var activeCard = (_settings?.GetTierCardsList() ?? WebsiteSettings.GetDefaultTierCards()).FirstOrDefault(c => c.Id == _selectedTierCardId);
                                        }
                                        <span class="badge @(activeCard != null ? "bg-primary text-white" : "bg-warning text-dark") mt-1">
                                            @(activeCard != null ? activeCard.Title : "No Tier Selected")
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Section 5: Terms, Conditions & Rental Policies -->
                        <div class="form-section mb-4">
                            <h6 class="section-heading fw-bold text-dark pb-2 border-bottom">
                                <i class="bi bi-file-earmark-ruled-fill me-2 text-primary"></i>4. Terms, Conditions &amp; Policies
                            </h6>

                            @* 1. Question-Triggered Policies (e.g. Setup Time Request) *@
                            @foreach (var qPolicy in GetQuestionTriggeredPolicies())
                            {
                                bool isYes = _questionAnswers.TryGetValue(qPolicy.Id, out var ans) && ans;
                                bool isAgreed = _agreedPolicyIds.Contains(qPolicy.Id);

                                <div class="card mb-3 border shadow-sm rounded-3">
                                    <div class="p-3 bg-white">
                                        <label class="form-label fw-bold text-dark small mb-2 d-flex align-items-center gap-2">
                                            <i class="bi bi-question-circle-fill text-primary"></i>
                                            <span>@(string.IsNullOrWhiteSpace(qPolicy.PromptQuestion) ? qPolicy.Title : qPolicy.PromptQuestion) *</span>
                                        </label>
                                        <div class="d-flex gap-2 mb-3">
                                            <button type="button" 
                                                    class="btn btn-sm px-3 rounded-pill @(!isYes ? "btn-dark text-white fw-bold shadow-sm" : "btn-outline-dark bg-white")" 
                                                    @onclick="() => SetQuestionAnswer(qPolicy.Id, false)">
                                                <i class="bi @(!isYes ? "bi-check-circle-fill me-1" : "bi-circle me-1 text-muted")"></i>No
                                            </button>
                                            <button type="button" 
                                                    class="btn btn-sm px-3 rounded-pill @(isYes ? "btn-primary text-white fw-bold shadow-sm" : "btn-outline-primary bg-white")" 
                                                    @onclick="() => SetQuestionAnswer(qPolicy.Id, true)">
                                                <i class="bi @(isYes ? "bi-check-circle-fill me-1" : "bi-circle me-1 text-muted")"></i>Yes
                                            </button>
                                        </div>

                                        <!-- Policy Contract Body (Always displayed) -->
                                        <div class="border rounded-3 overflow-hidden">
                                            <div class="card-header bg-light py-2">
                                                <span class="fw-bold small text-dark"><i class="bi bi-info-circle-fill text-primary me-1"></i>@qPolicy.Title</span>
                                            </div>
                                            <div class="p-3 small text-muted" style="background-color: #fdfdfd; font-size: 0.85rem; line-height: 1.6; white-space: pre-line;">
                                                @((MarkupString)qPolicy.Content)
                                            </div>

                                            @* Extra notice dynamically appended when 'Yes' is selected *@
                                            @if (isYes && qPolicy.ShowExtraNoteOnYes && !string.IsNullOrWhiteSpace(qPolicy.ExtraNoteOnYes))
                                            {
                                                <div class="p-3 border-top animate-fade-in @(qPolicy.HighlightOnYes ? "bg-warning bg-opacity-10 border-warning text-dark" : "bg-light text-dark")" style="font-size: 0.86rem; line-height: 1.5;">
                                                    <div class="d-flex align-items-start gap-2">
                                                        <i class="bi @(qPolicy.HighlightOnYes ? "bi-exclamation-triangle-fill text-warning-emphasis" : "bi-info-circle-fill text-primary") fs-6 mt-1 flex-shrink-0"></i>
                                                        <div class="fw-semibold">
                                                            @((MarkupString)qPolicy.ExtraNoteOnYes)
                                                        </div>
                                                    </div>
                                                </div>
                                            }

                                            <!-- Single Required Confirmation Checkbox -->
                                            <div class="bg-white border-top p-3">
                                                <div class="form-check">
                                                    <input class="form-check-input" type="checkbox" id="@($"chk_{qPolicy.Id}")" 
                                                           checked="@isAgreed" 
                                                           @onchange="(e) => TogglePolicyAgreement(qPolicy.Id, e.Value is bool b && b)" />
                                                    <label class="form-check-label fw-bold text-dark small" for="@($"chk_{qPolicy.Id}")">
                                                        @(string.IsNullOrWhiteSpace(qPolicy.CheckboxLabel) ? "I have read, understand, and agree to this policy *" : qPolicy.CheckboxLabel)
                                                    </label>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }

                            @* 2. Standard & Add-on Policies *@
                            @foreach (var policy in GetStandardAndAddonVisiblePolicies())
                            {
                                bool isAgreed = _agreedPolicyIds.Contains(policy.Id);
                                <div class="card mb-3 border bg-light shadow-sm">
                                    <div class="card-header bg-white py-2 d-flex align-items-center justify-content-between">
                                        <span class="fw-bold small text-dark">
                                            <i class="bi bi-shield-check text-primary me-1"></i>@policy.Title
                                        </span>
                                        @if (string.Equals(policy.DisplayMode, "AddonTriggered", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <span class="badge bg-warning bg-opacity-25 text-dark border border-warning border-opacity-50" style="font-size: 0.7rem;">
                                                <i class="bi bi-lightning-fill me-1"></i>Selected Add-on Policy
                                            </span>
                                        }
                                    </div>
                                    <div class="card-body p-3 small text-muted" style="max-height: 220px; overflow-y: auto; line-height: 1.6; font-size: 0.85rem; background-color: #fdfdfd; white-space: pre-line;">
                                        @((MarkupString)policy.Content)
                                    </div>
                                    <div class="card-footer bg-white border-top p-3">
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" id="@($"chk_{policy.Id}")" 
                                                   checked="@isAgreed" 
                                                   @onchange="(e) => TogglePolicyAgreement(policy.Id, e.Value is bool b && b)" />
                                            <label class="form-check-label fw-bold text-dark small" for="@($"chk_{policy.Id}")">
                                                @(string.IsNullOrWhiteSpace(policy.CheckboxLabel) ? "I have read, understand, and agree to this policy *" : policy.CheckboxLabel)
                                            </label>
                                        </div>
                                    </div>
                                </div>
                            }

                            <!-- General Rental Policies Link & Checkbox -->
                            <div class="p-3 bg-white border rounded-3 shadow-sm mb-3">
                                <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-2">
                                    <span class="fw-semibold small text-dark"><i class="bi bi-info-circle text-primary me-1"></i>Additional Rental Policies</span>
                                    <a href="@(_settings?.RentalPolicyUrl ?? "https://gloucesterfraternityclub.com/hall-rentals/hall-rental-policy/")" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-outline-primary py-0 px-2 small">
                                        <i class="bi bi-box-arrow-up-right me-1"></i>View Official Policy Page
                                    </a>
                                </div>
                                <div class="form-check mb-0">
                                    <input class="form-check-input" type="checkbox" id="generalPoliciesCheck" @bind="_request.RulesAgreed" />
                                    <label class="form-check-label text-dark small fw-semibold" for="generalPoliciesCheck">
                                        @(_settings?.RentalFormRulesText ?? "I have read and understand all GFC policies *")
                                    </label>
                                </div>
                            </div>
                        </div>

                        <!-- Section 6: Applicant Signature & Submission -->
                        <div class="form-section mb-4" id="submitSection">
                            <h6 class="section-heading fw-bold text-dark pb-2 border-bottom">
                                <i class="bi bi-pen-fill me-2 text-primary"></i>5. Electronic Signature &amp; Confirmation
                            </h6>

                            <div class="mb-3">
                                <label class="form-label fw-bold small text-dark">
                                    Applicant Signature *
                                </label>
                                <InputText class="form-control form-control-lg fs-6 font-monospace" placeholder="Type your full legal name to electronically sign" @bind-Value="_request.ApplicantSignature" />
                            </div>

                            <div class="alert alert-info d-flex align-items-start gap-2 shadow-sm border-info mb-4 p-3 rounded-3">
                                <i class="bi bi-info-circle-fill fs-5 text-primary flex-shrink-0"></i>
                                <div class="small text-dark">
                                    <strong>Important Note:</strong> @(_settings?.RentalPaymentWindowNotice ?? "After electronically signing this application, and once your date is approved by the Gloucester Fraternity Club (GFC), you will have two (2) business days to complete payment to reserve your date.")
                                </div>
                            </div>

                            <!-- Prominent Validation Warning Callout directly above Submit button (Critical for Mobile) -->
                            @if (!string.IsNullOrEmpty(_errorMessage))
                            {
                                <div class="alert alert-danger d-flex align-items-start gap-3 shadow-sm border-danger p-3 mb-3 rounded-3" role="alert">
                                    <i class="bi bi-exclamation-triangle-fill fs-4 flex-shrink-0 text-danger"></i>
                                    <div class="flex-grow-1">
                                        <h6 class="fw-bold text-danger mb-1"><i class="bi bi-shield-exclamation me-1"></i>Submission Incomplete</h6>
                                        <div class="small text-dark">@_errorMessage</div>
                                    </div>
                                </div>
                            }

                            <div class="d-flex justify-content-start">
                                <button type="submit" class="btn btn-primary btn-lg px-5 fw-bold shadow-sm w-100 w-sm-auto" disabled="@(!CanSubmit() || _isSubmitting)">
                                    @if (_isSubmitting)
                                    {
                                        <span class="spinner-border spinner-border-sm me-2"></span>
                                        <span>Submitting Application...</span>
                                    }
                                    else
                                    {
                                        <i class="bi bi-send-check-fill me-2"></i>
                                        <span>Submit Rental Application</span>
                                    }
                                </button>
                            </div>
                        </div>
                    </EditForm>
                </div>
            </div>
        }
    </div>
</div>

<!-- OPTION B: FLOATING QUESTION BUTTON & MODAL DRAWER (IF ENABLED) -->
@if (_settings?.EnableInquiryFloatingButton == true && !_isSubmitted && !_isInquirySubmitted)
{
    <!-- Floating Pill Button -->
    <div class="gfc-floating-question-container">
        <button type="button" class="btn btn-warning shadow-lg rounded-pill px-3 py-2 fw-bold text-dark d-flex align-items-center gap-2 gfc-float-btn" @onclick="OpenInquiryModal">
            <div class="rounded-circle bg-dark text-white p-1 d-flex align-items-center justify-content-center" style="width: 24px; height: 24px;">
                <i class="bi bi-chat-dots-fill" style="font-size: 0.75rem;"></i>
            </div>
            <span>@(_settings.InquiryFloatingButtonText ?? "Have a Question?")</span>
        </button>
    </div>
}

<!-- OPTION B: INQUIRY POPUP MODAL DRAWER -->
@if (_showInquiryModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(13, 27, 42, 0.7); backdrop-filter: blur(4px); z-index: 1060;" role="dialog">
        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable" style="max-width: 580px;" role="document">
            <div class="modal-content border-0 shadow-24 rounded-4 overflow-hidden">
                <div class="modal-header bg-dark text-white p-3 px-4 border-0 d-flex align-items-center justify-content-between" style="background: linear-gradient(135deg, #0d1b2a 0%, #1e293b 100%) !important;">
                    <div class="d-flex align-items-center gap-2">
                        <div class="rounded-circle bg-warning text-dark p-2 d-flex align-items-center justify-content-center" style="width: 36px; height: 36px;">
                            <i class="bi bi-question-lg fw-bold"></i>
                        </div>
                        <div>
                            <h5 class="modal-title fw-bold text-white mb-0">Ask a Question</h5>
                            <small class="text-white-50" style="font-size: 0.75rem;">Gloucester Fraternity Club Hall Rentals</small>
                        </div>
                    </div>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseInquiryModal"></button>
                </div>

                <div class="modal-body p-4 bg-light">
                    @if (_isInquirySubmitted)
                    {
                        <div class="text-center py-4 bg-white rounded-4 p-4 shadow-sm border">
                            <i class="bi bi-check-circle-fill text-success fs-1 mb-2 d-block"></i>
                            <h5 class="fw-bold text-dark mb-1">Message Sent!</h5>
                            <p class="text-muted small mb-3">
                                Thank you, <strong>@_inquiryModel.ApplicantName</strong>. Our rental coordinator will reach out to you shortly at <strong>@_inquiryModel.RequesterEmail</strong>.
                            </p>
                            <button type="button" class="btn btn-primary btn-sm px-4 fw-bold" @onclick="CloseInquiryModal">Done</button>
                        </div>
                    }
                    else
                    {
                        @if (!string.IsNullOrEmpty(_inquiryErrorMessage))
                        {
                            <div class="alert alert-danger py-2 px-3 small rounded-3 mb-3 d-flex align-items-center gap-2">
                                <i class="bi bi-exclamation-triangle-fill text-danger"></i>
                                <div>@_inquiryErrorMessage</div>
                            </div>
                        }

                        <p class="small text-muted mb-3">
                            Have questions about date availability, bar services, outside catering, or booking rules? Send us a quick note below!
                        </p>

                        <div class="row g-3 bg-white p-3 rounded-3 border">
                            <div class="col-12">
                                <label class="form-label fw-bold small text-dark mb-1">Your Name *</label>
                                <input type="text" class="form-control form-control-sm" placeholder="e.g. Jane Doe" @bind="_inquiryModel.ApplicantName" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold small text-dark mb-1">Email Address *</label>
                                <input type="email" class="form-control form-control-sm" placeholder="e.g. jane.doe@example.com" @bind="_inquiryModel.RequesterEmail" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold small text-dark mb-1">Phone Number (Optional)</label>
                                <input type="tel" class="form-control form-control-sm" placeholder="e.g. (978) 555-0123" value="@_inquiryModel.RequesterPhone" @onchange="OnInquiryPhoneChanged" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold small text-dark mb-1">Estimated Date (Optional)</label>
                                <input type="date" class="form-control form-control-sm" value="@(_inquiryModel.EventDate > DateTime.MinValue ? _inquiryModel.EventDate.ToString("yyyy-MM-dd") : "")" @onchange="OnInquiryDateChanged" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold small text-dark mb-1">Guest Estimate (Optional)</label>
                                <input type="number" class="form-control form-control-sm" placeholder="e.g. 80" @bind="_inquiryModel.GuestCount" min="1" max="500" />
                            </div>
                            <div class="col-12">
                                <label class="form-label fw-bold small text-dark mb-1">Your Question or Inquiry *</label>
                                <textarea class="form-control form-control-sm" rows="4" placeholder="Type your message or questions here..." @bind="_inquiryModel.EventDescription"></textarea>
                            </div>
                        </div>
                    }
                </div>

                @if (!_isInquirySubmitted)
                {
                    <div class="modal-footer bg-white p-3 border-top d-flex justify-content-between">
                        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="CloseInquiryModal">Cancel</button>
                        <button type="button" class="btn btn-primary btn-sm px-4 fw-bold shadow-sm d-flex align-items-center gap-1" @onclick="HandleInquirySubmit" disabled="@_isInquirySubmitting">
                            @if (_isInquirySubmitting)
                            {
                                <span class="spinner-border spinner-border-sm"></span>
                                <span>Sending...</span>
                            }
                            else
                            {
                                <i class="bi bi-send-fill"></i>
                                <span>Send Question</span>
                            }
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>
}

<!-- ========================================================================= -->
<!-- DO I QUALIFY? QUESTIONNAIRE POPUP MODAL -->
<!-- ========================================================================= -->
@if (_showQualificationModal && _evaluatingTierCard != null && _evaluatingTierCard.Qualification != null)
{
    var qualConfig = _evaluatingTierCard.Qualification;
    var activeSec1 = qualConfig.Section1Questions.Where(q => q.IsActive).ToList();
    var activeSec2 = qualConfig.Section2Questions.Where(q => q.IsActive).ToList();
    int minSec1Yes = qualConfig.Section1MinRequiredYes > 0 ? qualConfig.Section1MinRequiredYes : 1;
    int sec1YesCount = activeSec1.Count(q => _tempQualificationAnswers.TryGetValue(q.Id, out var ans) && ans == true);
    bool isSec1Passing = sec1YesCount >= minSec1Yes;
    bool isSec2Passing = activeSec2.All(q => _tempQualificationAnswers.TryGetValue(q.Id, out var ans) && ans == true);
    bool isOverallPassing = isSec1Passing && isSec2Passing;

    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(15, 23, 42, 0.75); z-index: 1055; backdrop-filter: blur(4px);" role="dialog">
        <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable" role="document">
            <div class="modal-content border-0 shadow-2xl rounded-4 overflow-hidden">
                <div class="modal-header bg-white border-bottom p-3 px-4">
                    <div class="d-flex align-items-center gap-2">
                        <div class="rounded-circle bg-primary bg-opacity-10 p-2 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                            <i class="bi bi-patch-question-fill fs-5 text-primary"></i>
                        </div>
                        <div>
                            <h5 class="modal-title fw-bold text-dark mb-0">@(string.IsNullOrWhiteSpace(qualConfig.ModalTitle) ? $"Do I Qualify for {_evaluatingTierCard.Title} Rates?" : qualConfig.ModalTitle)</h5>
                            <small class="text-muted">@_evaluatingTierCard.Title Qualification Wizard</small>
                        </div>
                    </div>
                    <button type="button" class="btn-close" @onclick="CancelQualificationModal"></button>
                </div>

                <div class="modal-body p-4 bg-light">
                    @if (!string.IsNullOrWhiteSpace(qualConfig.Description))
                    {
                        <div class="alert alert-info border-info border-opacity-25 bg-info bg-opacity-10 py-2.5 px-3 rounded-3 small mb-3 text-dark d-flex align-items-center gap-2">
                            <i class="bi bi-info-circle-fill text-info fs-5 flex-shrink-0"></i>
                            <span class="fw-semibold">@qualConfig.Description</span>
                        </div>
                    }

                    <!-- SECTION 1: Qualifying Entity or Cause -->
                    @if (activeSec1.Count > 0)
                    {
                        var firstYesQuestion = activeSec1.FirstOrDefault(q => _tempQualificationAnswers.TryGetValue(q.Id, out var a) && a == true);
                        bool isSingleRequirementMet = minSec1Yes == 1 && firstYesQuestion != null && !_isEditingSection1;

                        <div class="card border rounded-3 p-3 shadow-sm bg-white mb-3">
                            <div class="d-flex align-items-center justify-content-between mb-1 pb-2 border-bottom">
                                <div>
                                    <span class="fw-bold text-dark fs-6 d-block">@qualConfig.Section1Title</span>
                                    <small class="text-muted">@qualConfig.Section1Subtitle</small>
                                </div>
                                <span class="badge @(isSec1Passing ? "bg-success" : "bg-warning text-dark") px-2.5 py-1">
                                    @(isSec1Passing ? "Satisfied (Qualifying Cause Met)" : $"Need at least {minSec1Yes} YES")
                                </span>
                            </div>

                            @if (isSingleRequirementMet)
                            {
                                <!-- Collapsed Satisfied Confirmation View -->
                                <div class="mt-2 p-3 rounded-3 bg-success bg-opacity-10 border border-success border-opacity-25">
                                    <div class="d-flex align-items-center justify-content-between gap-2 flex-wrap">
                                        <div class="d-flex align-items-start gap-2.5">
                                            <div class="rounded-circle bg-success text-white p-1 d-flex align-items-center justify-content-center flex-shrink-0 mt-0.5" style="width: 24px; height: 24px;">
                                                <i class="bi bi-check-lg" style="font-size: 0.9rem;"></i>
                                            </div>
                                            <div>
                                                <div class="fw-bold text-dark mb-0.5">@firstYesQuestion!.Title</div>
                                                <div class="small text-success fw-semibold">
                                                    <i class="bi bi-patch-check-fill me-1"></i>Qualifying Entity Criteria Confirmed
                                                </div>
                                                @if (!string.IsNullOrWhiteSpace(firstYesQuestion.RequiredAttachmentNote))
                                                {
                                                    <div class="badge bg-white text-secondary border mt-1.5" style="font-size: 0.72rem;">
                                                        <i class="bi bi-paperclip me-1"></i>@firstYesQuestion.RequiredAttachmentNote
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                        <button type="button" class="btn btn-outline-secondary btn-sm bg-white shadow-sm" @onclick="() => _isEditingSection1 = true">
                                            <i class="bi bi-pencil me-1"></i>Change Category
                                        </button>
                                    </div>
                                </div>
                            }
                            else
                            {
                                @if (minSec1Yes == 1 && firstYesQuestion != null)
                                {
                                    <div class="d-flex justify-content-end mt-1">
                                        <button type="button" class="btn btn-link btn-sm text-decoration-none p-0 text-muted" @onclick="() => _isEditingSection1 = false">
                                            <i class="bi bi-check-circle me-1"></i>Keep "@firstYesQuestion.Title"
                                        </button>
                                    </div>
                                }
                                <div class="d-flex flex-column gap-2 mt-2">
                                    @foreach (var q in activeSec1)
                                    {
                                        bool hasAnswer = _tempQualificationAnswers.TryGetValue(q.Id, out var ans);
                                        bool isYes = hasAnswer && ans == true;
                                        bool isNo = hasAnswer && ans == false;

                                        <div class="p-3 rounded-3 border @(isYes ? "bg-success bg-opacity-10 border-success-subtle" : isNo ? "bg-light border-secondary-subtle" : "bg-white") transition-all">
                                            <div class="d-flex align-items-start justify-content-between gap-3">
                                                <div class="flex-grow-1">
                                                    <div class="fw-bold text-dark mb-1">@q.Title</div>
                                                    @if (!string.IsNullOrWhiteSpace(q.Description))
                                                    {
                                                        <div class="small text-muted mb-1" style="font-size: 0.82rem; line-height: 1.4;">@q.Description</div>
                                                    }
                                                    @if (!string.IsNullOrWhiteSpace(q.RequiredAttachmentNote))
                                                    {
                                                        <div class="badge bg-light text-secondary border mt-1" style="font-size: 0.72rem;">
                                                            <i class="bi bi-paperclip me-1"></i>@q.RequiredAttachmentNote
                                                        </div>
                                                    }
                                                </div>
                                                <div class="btn-group btn-group-sm flex-shrink-0" role="group">
                                                    <button type="button" class="btn fw-bold px-3 @(isYes ? "qual-btn-yes-selected" : "qual-btn-yes-unselected")" @onclick="() => SetTempAnswer(q.Id, true, isSection1: true)">
                                                        <i class="bi @(isYes ? "bi-check-circle-fill" : "bi-circle") me-1"></i>YES
                                                    </button>
                                                    <button type="button" class="btn fw-bold px-3 @(isNo ? "qual-btn-no-selected" : "qual-btn-no-unselected")" @onclick="() => SetTempAnswer(q.Id, false, isSection1: true)">
                                                        <i class="bi @(isNo ? "bi-x-circle-fill" : "bi-circle") me-1"></i>NO
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }

                    <!-- SECTION 2: Event Integrity & Terms (All Must Be YES) - ONLY SHOWN IF SECTION 1 IS SATISFIED -->
                    @if (isSec1Passing && activeSec2.Count > 0)
                    {
                        <div class="card border rounded-3 p-3 shadow-sm bg-white mb-3">
                            <div class="d-flex align-items-center justify-content-between mb-1 pb-2 border-bottom">
                                <div>
                                    <span class="fw-bold text-dark fs-6 d-block">@qualConfig.Section2Title</span>
                                    <small class="text-muted">@qualConfig.Section2Subtitle</small>
                                </div>
                                <span class="badge @(isSec2Passing ? "bg-success" : "bg-danger") px-2.5 py-1">
                                    @(isSec2Passing ? "All Criteria Confirmed" : "All Must Be YES")
                                </span>
                            </div>

                            <div class="d-flex flex-column gap-2 mt-2">
                                @foreach (var q in activeSec2)
                                {
                                    bool hasAnswer = _tempQualificationAnswers.TryGetValue(q.Id, out var ans);
                                    bool isYes = hasAnswer && ans == true;
                                    bool isNo = hasAnswer && ans == false;

                                    <div class="p-3 rounded-3 border @(isYes ? "bg-success bg-opacity-10 border-success-subtle" : isNo ? "bg-danger bg-opacity-10 border-danger-subtle" : "bg-white") transition-all">
                                        <div class="d-flex align-items-start justify-content-between gap-3">
                                            <div class="flex-grow-1">
                                                <div class="fw-bold text-dark mb-1">@q.Title</div>
                                                @if (!string.IsNullOrWhiteSpace(q.Description))
                                                {
                                                    <div class="small text-muted mb-1" style="font-size: 0.82rem; line-height: 1.4;">@q.Description</div>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(q.RequiredAttachmentNote))
                                                {
                                                    <div class="badge bg-light text-secondary border mt-1" style="font-size: 0.72rem;">
                                                        <i class="bi bi-paperclip me-1"></i>@q.RequiredAttachmentNote
                                                    </div>
                                                }
                                            </div>
                                            <div class="btn-group btn-group-sm flex-shrink-0" role="group">
                                                <button type="button" class="btn fw-bold px-3 @(isYes ? "qual-btn-yes-selected" : "qual-btn-yes-unselected")" @onclick="() => SetTempAnswer(q.Id, true)">
                                                    <i class="bi @(isYes ? "bi-check-circle-fill" : "bi-circle") me-1"></i>YES
                                                </button>
                                                <button type="button" class="btn fw-bold px-3 @(isNo ? "qual-btn-no-selected" : "qual-btn-no-unselected")" @onclick="() => SetTempAnswer(q.Id, false)">
                                                    <i class="bi @(isNo ? "bi-x-circle-fill" : "bi-circle") me-1"></i>NO
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    <!-- Real-time Status Card & Fallback Options -->
                    @{
                        bool hasAnyAnswer = _tempQualificationAnswers.Values.Any(v => v == true || v == false);
                        bool isExplicitlyFailed = (activeSec1.Count > 0 && activeSec1.All(q => _tempQualificationAnswers.TryGetValue(q.Id, out var ans) && ans == false))
                                               || (isSec1Passing && activeSec2.Any(q => _tempQualificationAnswers.TryGetValue(q.Id, out var ans) && ans == false));
                    }

                    <div class="p-3 rounded-3 border @(isOverallPassing ? "bg-success bg-opacity-10 border-success" : isExplicitlyFailed ? "bg-danger bg-opacity-10 border-danger" : "bg-white border-secondary-subtle") d-flex flex-column gap-3 shadow-sm">
                        <div class="d-flex align-items-center justify-content-between gap-3">
                            <div class="d-flex align-items-center gap-2.5">
                                @if (isOverallPassing)
                                {
                                    <div class="rounded-circle bg-success text-white p-2 d-flex align-items-center justify-content-center" style="width: 36px; height: 36px;">
                                        <i class="bi bi-patch-check-fill fs-5"></i>
                                    </div>
                                    <div>
                                        <strong class="d-block text-success fs-6">
                                            @(string.IsNullOrWhiteSpace(qualConfig.PassBadgeText) ? "You Qualify for this Rate" : qualConfig.PassBadgeText)
                                        </strong>
                                        <small class="text-muted">All criteria and terms have been satisfied.</small>
                                    </div>
                                }
                                else if (isExplicitlyFailed)
                                {
                                    <div class="rounded-circle bg-danger text-white p-2 d-flex align-items-center justify-content-center" style="width: 36px; height: 36px;">
                                        <i class="bi bi-x-circle-fill fs-5"></i>
                                    </div>
                                    <div>
                                        <strong class="d-block text-danger fs-6">
                                            @(string.IsNullOrWhiteSpace(qualConfig.FailBadgeText) ? "Does Not Meet Rate Qualification" : qualConfig.FailBadgeText)
                                        </strong>
                                        <small class="text-muted">
                                            @if (!isSec1Passing)
                                            {
                                                <span>A qualifying cause is required in Section 1. You may book under the standard Non-Member rate.</span>
                                            }
                                            else
                                            {
                                                <span>All event terms and integrity criteria must be confirmed with YES.</span>
                                            }
                                        </small>
                                    </div>
                                }
                                else
                                {
                                    <div class="rounded-circle bg-primary bg-opacity-10 text-primary p-2 d-flex align-items-center justify-content-center" style="width: 36px; height: 36px;">
                                        <i class="bi bi-info-circle-fill fs-5"></i>
                                    </div>
                                    <div>
                                        <strong class="d-block text-dark fs-6">Qualification Review Pending</strong>
                                        <small class="text-muted">Please review the criteria above to verify eligibility for this rate tier.</small>
                                    </div>
                                }
                            </div>
                        </div>

                        @if (!isOverallPassing)
                        {
                            <div class="p-3 rounded-3 bg-light border border-slate-200 d-flex align-items-center justify-content-between gap-3 flex-wrap">
                                <div class="d-flex align-items-center gap-2">
                                    <i class="bi bi-people-fill text-secondary fs-5"></i>
                                    <div>
                                        <div class="fw-bold text-dark small mb-0">Book under Standard Non-Member Rate</div>
                                        <div class="text-muted" style="font-size: 0.78rem;">No non-profit or civic qualification questions required.</div>
                                    </div>
                                </div>
                                <button type="button" class="btn btn-primary btn-sm fw-bold px-3 py-1.5 shadow-sm d-flex align-items-center gap-2 rounded-2" @onclick="SwitchToNonMemberTier">
                                    <span>Select Non-Member Rate</span>
                                    <i class="bi bi-arrow-right"></i>
                                </button>
                            </div>
                        }
                    </div>
                </div>

                <div class="modal-footer bg-white p-3 border-top d-flex justify-content-between">
                    <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="CancelQualificationModal">
                        Cancel
                    </button>
                    <div class="d-flex align-items-center gap-2">
                        @if (!isOverallPassing)
                        {
                            <button type="button" class="btn btn-outline-primary btn-sm fw-semibold" @onclick="SwitchToNonMemberTier">
                                <i class="bi bi-arrow-right-circle me-1"></i>Switch to Non-Member Rate
                            </button>
                        }
                        <button type="button" class="btn @(isOverallPassing ? "btn-success" : "btn-secondary") btn-sm px-4 fw-bold shadow-sm d-flex align-items-center gap-1.5" disabled="@(!isOverallPassing)" @onclick="ConfirmQualificationAndSelectRate">
                            <i class="bi bi-arrow-right-circle-fill"></i>
                            <span>Continue to Application</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
