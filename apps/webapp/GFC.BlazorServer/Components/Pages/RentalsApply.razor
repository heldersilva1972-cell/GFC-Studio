    private List<RentalRoomOption> GetDisplayedRooms()
    {
        var dayConfig = GetCurrentDayConfig();
        if (dayConfig != null && dayConfig.AllowedRoomNames != null && dayConfig.AllowedRoomNames.Count > 0)
        {
            if (dayConfig.AllowedRoomNames.Contains("__NONE__")) return new List<RentalRoomOption>();
            var filtered = _availableRooms
                .Where(r => dayConfig.AllowedRoomNames.Contains(r.Name, StringComparer.OrdinalIgnoreCase))
                .ToList();
            return filtered;
        }
        return _availableRooms;
    }

    private void SelectTimeSlot(DayScheduleSlotConfig slot)
    {
        if (IsSlotBooked(slot)) return;
        _request.StartTime = slot.StartTime;
        _request.EndTime = slot.EndTime;
        RecalculatePricing();
    }

    private bool HasAvailableSlotsForDate(DateTime date)
    {
        var dayConfigs = _settings?.GetDaySchedulesList();
        var dayConfig = dayConfigs?.FirstOrDefault(d => d.DayOfWeek == date.DayOfWeek);
        if (dayConfig != null && !dayConfig.IsAvailable) return false;

        var targetDate = date.Date;
        var dayEvents = _unavailableDates.Where(d => d.Date.Date == targetDate).ToList();

        // If there's a full-day blackout / event without specific times, it's fully booked
        if (dayEvents.Any(ev => string.IsNullOrWhiteSpace(ev.EventTime))) return false;

        var activeSlots = dayConfig?.Slots?.Where(s => s.IsActive).ToList() ?? new List<DayScheduleSlotConfig>();
        if (activeSlots.Count > 0)
        {
            // If configured slots exist, at least one must not be booked
            return activeSlots.Any(s => !IsSlotBooked(s));
        }

        // Custom / open hours check: if day events cover the day or custom slots exist
        return true;
    }

    private void CheckAndPromptQualificationForCurrentTier()
    {
        if (string.IsNullOrEmpty(_selectedTierCardId)) return;
        var tierCards = _settings?.GetTierCardsList() ?? WebsiteSettings.GetDefaultTierCards();
        var currentCard = tierCards.FirstOrDefault(c => c.Id == _selectedTierCardId);
        if (currentCard?.Qualification != null && currentCard.Qualification.IsEnabled)
        {
            if (!_qualificationAnswers.ContainsKey(currentCard.Id))
            {
                // Only prompt if the current date is available for this card and has open slots
                if (IsCardAvailableForDate(currentCard, _request.EventDate) && HasAvailableSlotsForDate(_request.EventDate))
                {
                    _evaluatingTierCard = currentCard;
                    _tempQualificationAnswers = new Dictionary<string, bool>();
                    _isEditingSection1 = false;
                    _showQualificationModal = true;
                    StateHasChanged();
                }
            }
        }
    }

    private void SelectTierCard(PricingTierCardConfig card)
    {
        // If this tier card requires qualification and has not been qualified yet,
        // only pop up the qualification questionnaire modal if the currently selected date actually has available slots
        if (card.Qualification != null && card.Qualification.IsEnabled)
        {
            if (!_qualificationAnswers.ContainsKey(card.Id))
            {
                if (IsCardAvailableForDate(card, _request.EventDate) && HasAvailableSlotsForDate(_request.EventDate))
                {
                    _evaluatingTierCard = card;
                    _tempQualificationAnswers = new Dictionary<string, bool>();
                    _isEditingSection1 = false;
                    _showQualificationModal = true;
                    StateHasChanged();
                    return;
                }
            }
        }

        ApplyTierCardSelection(card);
    }

    private void ReopenQualificationModal(PricingTierCardConfig card)
    {
        _evaluatingTierCard = card;
        _tempQualificationAnswers = _qualificationAnswers.TryGetValue(card.Id, out var existing)
            ? new Dictionary<string, bool>(existing)
            : new Dictionary<string, bool>();
        _isEditingSection1 = false;
        _showQualificationModal = true;
        StateHasChanged();
    }

    private void SetTempAnswer(string questionId, bool isYes, bool isSection1 = false)
    {
        if (isSection1 && isYes && _evaluatingTierCard?.Qualification != null)
        {
            int minSec1Yes = _evaluatingTierCard.Qualification.Section1MinRequiredYes > 0 ? _evaluatingTierCard.Qualification.Section1MinRequiredYes : 1;
            if (minSec1Yes == 1)
            {
                // If only 1 is required, clear other Section 1 YES answers to focus on the selected one
                var sec1Ids = _evaluatingTierCard.Qualification.Section1Questions.Select(q => q.Id).ToHashSet();
                foreach (var id in sec1Ids)
                {
                    if (id != questionId)
                    {
                        _tempQualificationAnswers[id] = false;
                    }
                }
                _isEditingSection1 = false;
            }
        }

        _tempQualificationAnswers[questionId] = isYes;
        StateHasChanged();
    }

    private void CancelQualificationModal()
    {
        _showQualificationModal = false;
        _evaluatingTierCard = null;
        StateHasChanged();
    }

    private void ConfirmQualificationAndSelectRate()
    {
        if (_evaluatingTierCard == null) return;

        _qualificationAnswers[_evaluatingTierCard.Id] = new Dictionary<string, bool>(_tempQualificationAnswers);
        _showQualificationModal = false;
        ApplyTierCardSelection(_evaluatingTierCard);
        _evaluatingTierCard = null;
        StateHasChanged();
    }

    private void SwitchToNonMemberTier()
    {
        _showQualificationModal = false;
        _evaluatingTierCard = null;

        var tierCards = _settings?.GetTierCardsList() ?? WebsiteSettings.GetDefaultTierCards();
        // Look for Non-Member tier card first, or the first card that does not require qualification
        var nonMemberCard = tierCards.FirstOrDefault(c => 
            (c.AssociatedRenterType != null && c.AssociatedRenterType.Contains("Non", StringComparison.OrdinalIgnoreCase)) ||
            (c.Title != null && c.Title.Contains("Non", StringComparison.OrdinalIgnoreCase)))
            ?? tierCards.FirstOrDefault(c => c.Qualification == null || !c.Qualification.IsEnabled)
            ?? tierCards.FirstOrDefault();

        if (nonMemberCard != null)
        {
            ApplyTierCardSelection(nonMemberCard);
        }
        StateHasChanged();
    }

