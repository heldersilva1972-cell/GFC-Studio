    private string GetCalendarUrl()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);
        var queryParams = new Dictionary<string, string?>();
        if (query.TryGetValue("view", out var viewVal) && !string.IsNullOrWhiteSpace(viewVal))
        {
            queryParams["view"] = viewVal.ToString();
        }
        if (query.TryGetValue("embed", out var embedVal) && !string.IsNullOrWhiteSpace(embedVal))
        {
            queryParams["embed"] = embedVal.ToString();
        }
        return Microsoft.AspNetCore.WebUtilities.QueryHelpers.AddQueryString("/public/calendar", queryParams);
    }
