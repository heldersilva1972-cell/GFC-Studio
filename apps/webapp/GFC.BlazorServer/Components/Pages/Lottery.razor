                <thead>
                    <tr>
                        <th class="ps-4">Shift</th>
                        <th>Bartender</th>
                        <th>Beginning Cash</th>
                        <th>Net Sales</th>
                        <th>Cashes</th>
                        <th>Instant Tickets</th>
                        <th>Net Due</th>
                        <th>Shift Net Sales</th>
                        <th>Expected Drawer</th>
                        <th>Ending Cash</th>
                        <th class="text-indigo">Backup Bag</th>
                        <th>Envelope Drop</th>
                        <th>Variance</th>
                        <th>Status</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
