                        <div style="border-right: 1px solid #ddd;">
                            <div class="x-small fw-bold text-muted text-uppercase">Expected Cash</div>
                            <div class="fw-black text-dark fs-6">$@(_shiftForm.ExpectedCash.ToString("N2"))</div>
                        </div>
                        <div>
                            <div class="x-small fw-bold text-muted text-uppercase">Variance</div>
                            <div class="fw-black fs-6 @(_shiftForm.Variance == 0 ? "text-success" : "text-danger")">
                                @_shiftForm.Variance.ToString("C2")
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="modal-card__actions p-3 pt-2 border-0 d-flex gap-2 bg-white">
                <button type="submit" class="btn btn-primary px-4 py-2 fs-7 fw-bold flex-grow-1 shadow-sm" disabled="@_savingShift">
                    @if (_savingShift)
                    {
                        <span class="spinner-border spinner-border-sm me-2"></span>
                        <span>SAVING...</span>
                    }
                    else
                    {
                        <span>SAVE CHANGES</span>
                    }
                </button>
                <button type="button" class="btn btn-light border px-4 py-2 fs-7 fw-bold" @onclick="CancelShiftModal">CANCEL</button>
            </div>
        </EditForm>

        @if (_showNoChangesModal)
        {
            <div class="position-absolute top-0 start-0 w-100 h-100 d-flex align-items-center justify-content-center p-4" style="background: rgba(255,255,255,0.7); backdrop-filter: blur(2px); z-index: 1200; border-radius: 12px;">
                <div class="bg-white border shadow-lg p-4 rounded-3 text-center" style="max-width: 400px; border: 1px solid #dee2e6 !important;">
                    <div class="mb-3 text-primary">
                        <i class="bi bi-info-circle-fill fs-1"></i>
                    </div>
                    <h5 class="fw-black text-dark mb-2 text-uppercase">NO CHANGES DETECTED</h5>
                    <p class="text-muted small mb-4">You haven't made any edits to this shift. Would you like to go back or close the window?</p>
                    <div class="d-grid gap-2">
                        <button type="button" class="btn btn-primary fw-bold py-2 shadow-sm" @onclick="() => _showNoChangesModal = false">RETURN TO AUDIT</button>
                        <button type="button" class="btn btn-outline-danger fw-bold py-2" @onclick="CancelShiftModal">CLOSE ANYWAY</button>
                    </div>
                </div>
            </div>
        }
    </div>
}

@* Delete Confirmation Modal *@
@if (_showDeleteModal)
{
    <div class="modal-backdrop"></div>
    <div class="modal-card" style="max-width: 400px;">
        <div class="modal-card__header">
            <h4>Confirm Delete</h4>
        </div>
        <div class="modal-card__body">
            <p>Are you sure you want to delete this shift record? This action cannot be undone.</p>
        </div>
        <div class="modal-card__actions">
            <button class="btn btn-danger" disabled="@_deletingShift" @onclick="DeleteShiftConfirmed">
                <span class="spinner-border spinner-border-sm me-1" role="status" hidden="@(!_deletingShift)"></span>
                Delete
            </button>
            <button class="btn btn-outline" @onclick="CancelDelete" disabled="@_deletingShift">Cancel</button>
        </div>
    </div>
}

@* Reassignment Confirmation Modal *@
@if (_showReassignConfirmation)
{
    <div class="modal-backdrop" style="z-index: 2050;"></div>
    <div class="modal-card shadow-lg border-primary border-top border-4" style="z-index: 2100; max-width: 450px;">
        <div class="modal-card__header pb-2 border-0">
            <h4 class="text-primary fw-black mb-0"><i class="bi bi-person-up me-2"></i>Confirm Reassignment</h4>
        </div>
        <div class="modal-card__body py-4">
            <p class="text-muted small fw-bold text-uppercase mb-4" style="letter-spacing: 0.05rem;">Shift Transfer Request</p>
            
            <div class="row align-items-center g-3 mb-4">
                <div class="col-5">
                    <div class="p-3 bg-light rounded-4 text-center border">
                        <div class="x-small text-muted fw-bold mb-1">ORIGINAL</div>
                        <div class="fw-black text-dark truncate">@_originalEmployeeName</div>
                    </div>
                </div>
                <div class="col-2">
                    <div class="transfer-arrow text-primary">
                        <i class="bi bi-arrow-right-circle-fill"></i>
                    </div>
                </div>
                <div class="col-5">
                    <div class="p-3 bg-primary bg-opacity-10 rounded-4 text-center border border-primary border-opacity-25">
                        <div class="x-small text-primary fw-bold mb-1">NEW ASSIGNEE</div>
                        <div class="fw-black text-primary truncate">@_pendingFullName</div>
                    </div>
                </div>
            </div>

            <div class="alert alert-warning border-0 rounded-4 mb-0">
                <div class="d-flex gap-3">
                    <i class="bi bi-exclamation-triangle-fill fs-4 text-warning"></i>
                    <div>
                        <div class="fw-black text-dark small">IMPORTANT ACCOUNTABILITY WARNING</div>
                        <div class="x-small text-dark text-opacity-75">
                            This action will permanently move all labor hours and sales credit for this shift to <strong>@_pendingFullName</strong>. 
                            This correction will be recorded in the audit logs.
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="modal-card__actions p-4 pt-0 gap-2">
            <button class="btn btn-primary w-100 py-3 rounded-pill fw-black shadow-sm" @onclick="ConfirmReassignment" type="button">YES, CONFIRM TRANSFER</button>
            <button class="btn btn-outline-secondary w-100 py-3 rounded-pill fw-bold border-0" @onclick="CancelReassignment" type="button">CANCEL</button>
        </div>
    </div>
}

@* Commission Rates Settings Modal *@
@if (_showRatesModal)
{
    <div class="modal-backdrop fade show" style="z-index: 2050; background: rgba(15, 23, 42, 0.4); backdrop-filter: blur(8px);"></div>
    <div class="modal d-block" style="z-index: 2100;">
        <div class="modal-dialog modal-dialog-centered modal-lg" style="max-width: 900px;">
            <div class="modal-content border-0 shadow-2xl rounded-4 overflow-hidden bg-white">
                <!-- PREMIUM INDIGO HEADER -->
                <div class="p-4 text-white d-flex justify-content-between align-items-center" style="background: linear-gradient(135deg, #4f46e5 0%, #3730a3 100%);">
                    <div class="d-flex align-items-center gap-4">
                        <i class="bi bi-shield-check-fill fs-1 text-white opacity-75"></i>
                        <div>
                            <h2 class="mb-0 fw-black text-uppercase tracking-tighter" style="font-size: 1.6rem; letter-spacing: -0.02em;">Commission & Fee Rates</h2>
                            <span class="small text-white opacity-75 fw-bold text-uppercase tracking-widest" style="font-size: 0.65rem; letter-spacing: 0.15em;">Master Financial Configuration & Audit Rules</span>
                        </div>
                    </div>
                    <button type="button" class="btn-close btn-close-white shadow-none opacity-50 hover-opacity-100" @onclick="() => _showRatesModal = false"></button>
                </div>

                <div class="modal-body p-5 bg-light-subtle" style="max-height: 80vh; overflow-y: auto;">
                    <!-- SYSTEM NOTICE -->
                    <div class="d-flex align-items-center gap-4 p-4 rounded-4 bg-white border border-indigo-subtle shadow-sm mb-5">
                        <i class="bi bi-info-circle-fill fs-3 text-indigo"></i>
                        <p class="small mb-0 text-muted-main fw-bold" style="line-height: 1.5;">
                            Year-specific configurations safeguard your historical audits. Changing these values will immediately update all profit calculations for the selected fiscal period.
                        </p>
                    </div>

                    @foreach (var rate in _commissionRates.OrderByDescending(r => r.Year))
                    {
                        <div class="config-card mb-5 bg-white rounded-4 border shadow-sm overflow-hidden">
                            <div class="card-header-slim px-4 py-3 bg-light border-bottom d-flex justify-content-between align-items-center">
                                <span class="fw-black text-indigo fs-5">FISCAL YEAR @rate.Year</span>
                                <button class="btn btn-indigo px-4 py-2 rounded-pill fw-black btn-sm shadow-sm" @onclick="() => SaveCommissionRate(rate)">
                                    <i class="bi bi-save2-fill me-2"></i>SAVE YEAR CONFIG
                                </button>
                            </div>
                            
                            <div class="accountability-grid p-4">
                                <div class="row g-4">
                                    <!-- EARNINGS SECTION -->
                                    <div class="col-md-4">
                                        <div class="p-3 bg-light rounded-4 border border-light">
                                            <label class="d-block x-small fw-black text-uppercase text-muted mb-2 tracking-widest">Sales Revenue (%)</label>
                                            <div class="input-group input-group-lg shadow-sm rounded-3">
                                                <input type="number" step="0.01" class="form-control border-0 bg-white text-center fw-black fs-4" @bind="rate.SalesRate" />
                                                <span class="input-group-text border-0 bg-white text-indigo fw-black px-3">%</span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="p-3 bg-light rounded-4 border border-light">
                                            <label class="d-block x-small fw-black text-uppercase text-muted mb-2 tracking-widest">Cashing Fee (%)</label>
                                            <div class="input-group input-group-lg shadow-sm rounded-3">
                                                <input type="number" step="0.01" class="form-control border-0 bg-white text-center fw-black fs-4" @bind="rate.CashingRate" />
                                                <span class="input-group-text border-0 bg-white text-indigo fw-black px-3">%</span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="p-3 bg-light rounded-4 border border-light">
                                            <label class="d-block x-small fw-black text-uppercase text-muted mb-2 tracking-widest">Daily Bonus (%)</label>
                                            <div class="input-group input-group-lg shadow-sm rounded-3">
                                                <input type="number" step="0.01" class="form-control border-0 bg-white text-center fw-black fs-4" @bind="rate.TicketRate" />
                                                <span class="input-group-text border-0 bg-white text-indigo fw-black px-3">%</span>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- EXPENSE SECTION -->
                                    <div class="col-md-6">
                                        <div class="p-3 rounded-4" style="background: #eef2ff; border: 1px solid #c7d2fe;">
                                            <label class="d-block x-small fw-black text-uppercase text-indigo mb-2 tracking-widest">Daily Terminal Fee ($)</label>
                                            <div class="input-group input-group-lg shadow-sm rounded-3">
                                                <span class="input-group-text border-0 bg-white text-indigo fw-black px-3">$</span>
                                                <input type="number" step="0.01" class="form-control border-0 bg-white text-center fw-black fs-4 text-indigo" @bind="rate.DailySystemFee" />
                                            </div>
                                            <p class="x-small text-indigo mb-0 mt-2 fw-semibold opacity-75">Typically baked into RPT 50/60 debt.</p>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="p-3 rounded-4" style="background: #fffbeb; border: 1px solid #fef3c7;">
                                            <label class="d-block x-small fw-black text-uppercase text-warning-dark mb-2 tracking-widest">Daily Bonding Fee ($)</label>
                                            <div class="input-group input-group-lg shadow-sm rounded-3">
                                                <span class="input-group-text border-0 bg-white text-warning-dark fw-black px-3">$</span>
                                                <input type="number" step="0.01" class="form-control border-0 bg-white text-center fw-black fs-4 text-warning-dark" @bind="rate.DailyBondingFee" />
                                            </div>
                                            <p class="x-small text-warning-dark mb-0 mt-2 fw-semibold opacity-75">Daily bonding amount (applied once daily).</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }

                    <button class="btn btn-outline-indigo w-100 py-4 rounded-4 border-2 border-dashed fw-black text-uppercase shadow-sm bg-white" @onclick="AddNewYearRate" style="border-style: dashed !important;">
                        <i class="bi bi-calendar-plus-fill me-2 fs-5"></i> Configure Rates for New Year
                    </button>
                </div>

                <div class="modal-footer p-4 bg-light border-top d-flex justify-content-between align-items-center">
                    <span class="small text-muted fw-bold ms-3">Authorized Financial Admin Override Zone</span>
                    <button type="button" class="btn btn-indigo px-5 py-3 rounded-pill fw-black shadow-lg" @onclick="() => _showRatesModal = false">DONE & CLOSE</button>
                </div>
            </div>
        </div>
    </div>
}


</div> @* End lottery-page-container *@
