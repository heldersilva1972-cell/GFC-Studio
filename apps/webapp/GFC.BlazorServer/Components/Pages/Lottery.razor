@* Add/Edit Shift Modal *@
@if (_showShiftModal)
{
    <div class="modal-backdrop"></div>
    <div class="modal-card" style="max-width: 700px;">
        <div class="modal-card__header d-flex justify-content-between align-items-center mb-3">
            <h4 class="mb-0">@(_editingShiftId.HasValue ? "Edit Shift" : "Add Shift")</h4>
            <button class="btn btn-link text-muted p-0" type="button" @onclick="CancelShiftModal">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>

        @if (!string.IsNullOrEmpty(_modalError))
        {
            <div class="alert alert-danger mb-3">
                <strong>Error:</strong> @_modalError
            </div>
        }

        <EditForm Model="@_shiftForm" OnValidSubmit="SaveShift">
            <DataAnnotationsValidator />
            <ValidationSummary class="alert alert-danger" />
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label">Shift Date <span class="text-danger">*</span></label>
                    <InputDate class="form-control" @bind-Value="_shiftForm.ShiftDate" />
                    <ValidationMessage For="@(() => _shiftForm.ShiftDate)" />
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">Employee Selection <span class="text-danger">*</span></label>
                    <select class="form-select" value="@_shiftForm.CreatedBy" @onchange="OnEmployeeChanged">
                        <option value="">-- Select Correct Employee --</option>
                        @foreach (var emp in _employeeMetadata)
                        {
                            <option value="@emp.Username">@emp.FullName</option>
                        }
                    </select>
                    <ValidationMessage For="@(() => _shiftForm.EmployeeName)" />
                    <div class="form-text x-small text-muted mt-1">
                        <i class="bi bi-info-circle me-1"></i> Selecting a new employee will also move their labor hours for this shift.
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label">Beginning Drawer Cash <span class="text-danger">*</span></label>
                    <InputNumber class="form-control" @bind-Value="_shiftForm.StartingCash" step="0.01" />
                    <ValidationMessage For="@(() => _shiftForm.StartingCash)" />
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">Ending Drawer Cash <span class="text-danger">*</span></label>
                    <InputNumber class="form-control" @bind-Value="_shiftForm.EndingCash" step="0.01" />
                    <ValidationMessage For="@(() => _shiftForm.EndingCash)" />
                </div>
            </div>
            <div class="row">
                <div class="col-md-3 mb-3">
                    <label class="form-label">Sales (RPT 50) <span class="text-danger">*</span></label>
                    <InputNumber class="form-control" @bind-Value="_shiftForm.TotalSales" step="0.01" />
                    <ValidationMessage For="@(() => _shiftForm.TotalSales)" />
                </div>
                <div class="col-md-3 mb-3">
                    <label class="form-label">Payouts (RPT 50) <span class="text-danger">*</span></label>
                    <InputNumber class="form-control" @bind-Value="_shiftForm.TotalPayouts" step="0.01" />
                    <ValidationMessage For="@(() => _shiftForm.TotalPayouts)" />
                </div>
                <div class="col-md-3 mb-3">
                    <label class="form-label">Instant Tickets (RPT 34) <span class="text-danger">*</span></label>
                    <InputNumber class="form-control" @bind-Value="_shiftForm.TotalCancels" step="0.01" />
                    <ValidationMessage For="@(() => _shiftForm.TotalCancels)" />
                </div>
                <div class="col-md-3 mb-3">
                    <label class="form-label">Net Due (RPT 50) <span class="text-danger">*</span></label>
                    <InputNumber class="form-control" @bind-Value="_shiftForm.NetDue" step="0.01" />
                    <ValidationMessage For="@(() => _shiftForm.NetDue)" />
                </div>
                <div class="col-md-3 mb-3">
                    <label class="form-label">Envelope Drop</label>
                    <InputNumber class="form-control bg-warning-subtle" @bind-Value="_shiftForm.EnvelopeAmount" step="0.01" />
                    <ValidationMessage For="@(() => _shiftForm.EnvelopeAmount)" />
                </div>
            </div>
            <div class="mb-3">
                <label class="form-label">Calculated Values</label>
                <div class="p-2 rounded" style="background: var(--bg-primary); border: 1px solid var(--glass-border);">
                    <div class="row">
                        <div class="col-md-4">
                            <div><strong>Net Sales:</strong></div>
                            <div>@_shiftForm.NetSales.ToString("C")</div>
                        </div>
                        <div class="col-md-4">
                            <div><strong>Expected Cash:</strong></div>
                            <div>@_shiftForm.ExpectedCash.ToString("C")</div>
                        </div>
                        <div class="col-md-4">
                            <div><strong>Variance:</strong></div>
                            <div class="@(_shiftForm.Variance < 0 ? "text-danger" : _shiftForm.Variance > 0 ? "text-success" : "")">
                                @_shiftForm.Variance.ToString("C")
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="mb-3">
                <label class="form-label">Notes</label>
                <InputTextArea class="form-control" rows="3" @bind-Value="_shiftForm.Notes" />
            </div>
            <div class="modal-card__actions">
                <button type="submit" class="btn btn-primary" disabled="@_savingShift">
                    <span class="spinner-border spinner-border-sm me-1" role="status" hidden="@(!_savingShift)"></span>
                    Save
                </button>
                <button type="button" class="btn btn-outline" @onclick="CancelShiftModal">Cancel</button>
            </div>
        </EditForm>
    </div>
}

@* Delete Confirmation Modal *@
@if (_showDeleteModal)
{
    <div class="modal-backdrop"></div>
    <div class="modal-card" style="max-width: 400px;">
        <div class="modal-card__header">
            <h4>Confirm Delete</h4>
        </div>
        <div class="modal-card__body">
            <p>Are you sure you want to delete this shift record? This action cannot be undone.</p>
        </div>
        <div class="modal-card__actions">
            <button class="btn btn-danger" disabled="@_deletingShift" @onclick="DeleteShiftConfirmed">
                <span class="spinner-border spinner-border-sm me-1" role="status" hidden="@(!_deletingShift)"></span>
                Delete
            </button>
            <button class="btn btn-outline" @onclick="CancelDelete" disabled="@_deletingShift">Cancel</button>
        </div>
    </div>
}

@* Reassignment Confirmation Modal *@
@if (_showReassignConfirmation)
{
    <div class="modal-backdrop" style="z-index: 2050;"></div>
    <div class="modal-card shadow-lg border-primary border-top border-4" style="z-index: 2100; max-width: 450px;">
        <div class="modal-card__header pb-2 border-0">
            <h4 class="text-primary fw-black mb-0"><i class="bi bi-person-up me-2"></i>Confirm Reassignment</h4>
        </div>
        <div class="modal-card__body py-4">
            <p class="text-muted small fw-bold text-uppercase mb-4" style="letter-spacing: 0.05rem;">Shift Transfer Request</p>
            
            <div class="row align-items-center g-3 mb-4">
                <div class="col-5">
                    <div class="p-3 bg-light rounded-4 text-center border">
                        <div class="x-small text-muted fw-bold mb-1">ORIGINAL</div>
                        <div class="fw-black text-dark truncate">@_originalEmployeeName</div>
                    </div>
                </div>
                <div class="col-2">
                    <div class="transfer-arrow text-primary">
                        <i class="bi bi-arrow-right-circle-fill"></i>
                    </div>
                </div>
                <div class="col-5">
                    <div class="p-3 bg-primary bg-opacity-10 rounded-4 text-center border border-primary border-opacity-25">
                        <div class="x-small text-primary fw-bold mb-1">NEW ASSIGNEE</div>
                        <div class="fw-black text-primary truncate">@_pendingFullName</div>
                    </div>
                </div>
            </div>

            <div class="alert alert-warning border-0 rounded-4 mb-0">
                <div class="d-flex gap-3">
                    <i class="bi bi-exclamation-triangle-fill fs-4 text-warning"></i>
                    <div>
                        <div class="fw-black text-dark small">IMPORTANT ACCOUNTABILITY WARNING</div>
                        <div class="x-small text-dark text-opacity-75">
                            This action will permanently move all labor hours and sales credit for this shift to <strong>@_pendingFullName</strong>. 
                            This correction will be recorded in the audit logs.
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="modal-card__actions p-4 pt-0 gap-2">
            <button class="btn btn-primary w-100 py-3 rounded-pill fw-black shadow-sm" @onclick="ConfirmReassignment" type="button">YES, CONFIRM TRANSFER</button>
            <button class="btn btn-outline-secondary w-100 py-3 rounded-pill fw-bold border-0" @onclick="CancelReassignment" type="button">CANCEL</button>
        </div>
    </div>
}


