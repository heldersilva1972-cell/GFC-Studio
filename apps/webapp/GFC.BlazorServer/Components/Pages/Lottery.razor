@if (ShowContent && _viewMode == "weekly")
{
    @* Monthly View (Old Reconcile View) - One line per week, simple and read-only *@
    <div class="data-card border-0 shadow-sm rounded-3 overflow-hidden mb-4 bg-white">
        <h5 class="fw-black text-muted mb-2 pt-3 px-3 text-uppercase x-small tracking-widest">Monthly Weekly Summaries</h5>
        <div class="table-container-fixed">
            <table class="data-table">
                <thead>
                    <tr class="text-uppercase x-small tracking-widest text-muted">
                        <th class="ps-4">Fiscal Period</th>
                        <th class="text-end">Sales (RPT 50)</th>
                        <th class="text-end">Cashes (RPT 50)</th>
                        <th class="text-end">Tickets (RPT 34)</th>
                        <th class="text-end fw-bold">Net Due</th>
                        <th class="text-end text-danger fw-bold">Due to Lottery</th>
                        <th class="text-end text-primary fw-bold">Envelope Cash</th>
                        <th class="text-end pe-4">Net Revenue</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_weeklySummaries != null && _weeklySummaries.Any())
                    {
                        @foreach (var week in _weeklySummaries.OrderByDescending(w => w.PeriodStart))
                        {
                            var weekDueToLottery = week.TotalNetDue - week.TotalCancels;
                            var weekRevenue = week.TotalEnvelope - weekDueToLottery;
                            
                            <tr class="align-middle">
                                <td class="ps-4 fw-bold">@week.PeriodLabel</td>
                                <td class="text-end">@week.TotalSales.ToString("C2")</td>
                                <td class="text-end">@week.TotalPayouts.ToString("C2")</td>
                                <td class="text-end">@week.TotalCancels.ToString("C2")</td>
                                <td class="text-end fw-bold">@week.TotalNetDue.ToString("C2")</td>
                                <td class="text-end text-danger fw-bold">@weekDueToLottery.ToString("C2")</td>
                                <td class="text-end text-primary fw-bold">@week.TotalEnvelope.ToString("C2")</td>
                                <td class="text-end pe-4 fw-black @(weekRevenue >= 0 ? "text-success" : "text-danger")">
                                    @weekRevenue.ToString("C2")
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@if (ShowContent && _viewMode == "weekly_sweep")
{
    @* Weekly Net Due / Sweep View *@
    <div class="data-card border-0 shadow-sm rounded-3 overflow-hidden mb-2 bg-white">
        <h5 class="fw-black text-muted mb-2 pt-3 px-3 text-uppercase x-small tracking-widest">Weekly Net Due Settlements</h5>
        @if (_loadingWeekly)
        {
            <div class="p-5 text-center">
                <div class="spinner-border spinner-border-sm text-info" role="status"></div>
                <span class="ms-2 text-muted">Loading weekly settlements...</span>
            </div>
        }
        else if (!_weeklySettlements.Any())
        {
            <div class="text-center py-5 text-muted p-5">
                <i class="bi bi-calendar-x d-block fs-2 mb-2 text-muted opacity-50"></i>
                <p class="fw-bold mb-0">No weekly settlements found for the selected month/year.</p>
            </div>
        }
        else
        {
            <div class="table-container-fixed" style="max-height: calc(100vh - 200px); box-shadow: none; border: none; background: transparent;">
                <table class="data-table weekly-sweep-table">
                    <thead>
                        <tr class="text-uppercase x-small tracking-widest text-muted">
                            <th class="ps-4">WEEK PERIOD</th>
                            <th>DUE DATE</th>
                            <th class="text-end">ENVELOPE DROP</th>
                            <th class="text-end">NET DUE TO LOTTERY</th>
                            <th class="text-center">STATUS</th>
                            <th class="text-center">DETAILS / LINKED BILL</th>
                            <th class="pe-4 text-end" style="width: 200px;">ACTIONS</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var settlement in _weeklySettlements)
                        {
                            <tr>
