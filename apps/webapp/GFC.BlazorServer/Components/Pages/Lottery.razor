                                </td>
                                <td colspan="12">
                                    <span class="text-muted small italic fw-normal"><i class="bi bi-exclamation-circle text-warning me-1"></i>No shift report entered</span>
                                </td>
                                <td>
                                    <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle x-small">Missing</span>
                                </td>
                                <td class="text-center">
                                    <button class="btn btn-sm btn-outline-danger rounded-pill px-3 fw-bold py-0.5 shadow-sm" style="font-size: 0.7rem;" @onclick='() => CreateClosedShift(currentDay, "Day")'>
                                        <i class="bi bi-door-closed-fill me-1"></i> Mark Closed
                                    </button>
                                </td>
                            </tr>
                        }

                        @* Render Night Shift *@
                        @if (nightShift != null)
                        {
                            <tr class="align-middle">
                                <td class="ps-4">
                                    <span class="badge bg-indigo-subtle text-indigo border border-indigo-subtle">NIGHT</span>
                                </td>
                                @if (string.Equals(nightShift.EmployeeName, "Club Closed", StringComparison.OrdinalIgnoreCase))
                                {
                                    <td colspan="12">
                                        <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-2 py-1"><i class="bi bi-door-closed-fill me-1"></i>CLUB CLOSED</span>
                                        <span class="text-muted small ms-2">No shift activity logged</span>
                                    </td>
                                }
                                else
                                {
                                    <td><span class="fw-bold">@nightShift.EmployeeName</span></td>
                                    <td class="small">@nightShift.StartingCash.ToString("C")</td>
                                    <td class="small">@nightShift.TotalSales.ToString("C2")</td>
                                    <td class="small">@nightShift.TotalPayouts.ToString("C2")</td>
                                    <td class="small">@nightShift.TotalCancels.ToString("C2")</td>
                                    <td class="fw-bold">@nightShift.NetDue.ToString("C2")</td>
                                    <td class="small">@nightShift.NetSales.ToString("C2")</td>
                                    <td class="fw-bold small">@nightShift.ExpectedCash.ToString("C2")</td>
                                    <td class="small">@nightShift.EndingCash.ToString("C")</td>
                                    <td class="small">
                                        @if (nightShift.BackupBagAmount > 0 || nightShift.BagRefillAmount > 0)
                                        {
                                            <div class="d-flex flex-column gap-1" style="min-width: 140px;">
                                                @if (nightShift.BackupBagAmount > 0)
                                                {
                                                    <div class="d-flex align-items-center">
                                                        <span class="badge bg-primary bg-opacity-10 text-primary border border-primary-subtle extra-small px-2 py-1 w-100 text-start" style="font-size: 0.62rem; letter-spacing: 0.02em;">
                                                            <i class="bi bi-box-arrow-right me-1"></i> OUT FROM BAG: <span class="fw-black ms-auto float-end">@nightShift.BackupBagAmount.ToString("C0")</span>
                                                        </span>
                                                    </div>
                                                }
                                                @if (nightShift.BagRefillAmount > 0)
                                                {
                                                    <div class="d-flex align-items-center">
                                                        <span class="badge bg-success bg-opacity-10 text-success border border-success-subtle extra-small px-2 py-1 w-100 text-start" style="font-size: 0.62rem; letter-spacing: 0.02em;">
                                                            <i class="bi bi-box-arrow-in-left me-1"></i> BACK TO BAG: <span class="fw-black ms-auto float-end">@nightShift.BagRefillAmount.ToString("C0")</span>
                                                        </span>
                                                    </div>
                                                }
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted opacity-50 x-small">$0.00</span>
                                        }
                                    </td>
                                    <td class="@(nightShift.EnvelopeAmount > 0 ? "text-warning fw-bold" : "text-muted opacity-50")">
                                        @nightShift.EnvelopeAmount.ToString("C2")
                                    </td>
                                    <td>
                                        <span class="variance-pill @(nightShift.Variance < 0 ? "variance-neg" : nightShift.Variance > 0 ? "variance-pos" : "variance-zero")">
                                            @nightShift.Variance.ToString("C2")
                                        </span>
                                    </td>
                                }
                                <td>
                                    @if (nightShift.Status == "Draft")
                                    {
                                        <span class="badge bg-warning text-dark x-small">Draft (In Progress)</span>
                                    }
                                    else
                                    {
                                        <span class="badge @(nightShift.IsReconciled ? "bg-success" : "bg-info") x-small">@(nightShift.IsReconciled ? "Reconciled" : "Submitted")</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <button class="btn btn-link btn-sm text-primary p-0" @onclick="() => EditShift(nightShift.ShiftId)" title="Edit">
                                        <i class="bi bi-pencil-square fs-5"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                        else
                        {
                            <tr class="align-middle" style="background-color: #fffdf9 !important;">
                                <td class="ps-4">
                                    <span class="badge bg-indigo-subtle text-indigo border border-indigo-subtle">NIGHT</span>
                                </td>
                                <td colspan="12">
                                    <span class="text-muted small italic fw-normal"><i class="bi bi-exclamation-circle text-warning me-1"></i>No shift report entered</span>
                                </td>
