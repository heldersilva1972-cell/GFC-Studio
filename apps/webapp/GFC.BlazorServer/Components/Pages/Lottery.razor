        <div class="table-container-fixed">
            <table class="data-table border-top table-compact">
                <thead>
                    <tr>
                        <th class="ps-4">Shift</th>
                        <th>Bartender</th>
                        <th>Beginning Cash</th>
                        <th>Ending Cash</th>
                        <th>Machine Sales</th>
                        <th>Machine Payouts</th>
                        <th>Instant Tickets</th>
                        <th class="text-indigo">Backup Bag</th>
                        <th>Net Due</th>
                        <th>Shift Net Sales</th>
                        <th>Expected Drawer</th>
                        <th>Envelope Drop</th>
                        <th>Variance</th>
                        <th>Status</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        bool anyShiftsInWeek = _shifts.Any();
                    }

                    @if (!anyShiftsInWeek)
                    {
                        <tr>
                            <td colspan="15" class="ps-4 py-5 text-center text-muted">
                                <i class="bi bi-info-circle fs-4 d-block mb-2"></i>
                                <span class="fw-bold">No lottery shifts recorded for this week.</span><br/>
                                <span class="small opacity-75">Select a different week or filter from the top bar.</span>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @for (var day = _filterEndDate.Date; day >= _filterStartDate.Date; day = day.AddDays(-1))
                        {
                            var shiftsForDay = _shifts.Where(s => s.ShiftDate.Date == day.Date).ToList();
                            if (!shiftsForDay.Any()) continue;

                            @* Day Header Row *@
                            <tr class="day-group-header">
                                <td colspan="15" class="ps-4 py-2 border-bottom border-top">
                                    <span class="fw-black text-primary text-uppercase small tracking-wider">@day.ToString("dddd, MMMM d")</span>
                                </td>
                            </tr>

                            @foreach (var shift in shiftsForDay)
                            {
                                <tr class="align-middle">
                                    <td class="ps-4">
                                        @if (shift.ShiftType == "Day")
                                        {
                                            <span class="badge bg-info-subtle text-info border border-info-subtle">DAY</span>
                                        }
                                        else if (shift.ShiftType == "Night")
                                        {
                                            <span class="badge bg-indigo-subtle text-indigo border border-indigo-subtle">NIGHT</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-muted">@shift.ShiftType</span>
                                        }
                                    </td>
                                    <td><span class="fw-bold">@shift.EmployeeName</span></td>
                                    <td class="small">@shift.StartingCash.ToString("C")</td>
                                    <td class="small">@shift.EndingCash.ToString("C")</td>
                                    <td class="small">@shift.TotalSales.ToString("C2")</td>
                                    <td class="small">@shift.TotalPayouts.ToString("C2")</td>
                                    <td class="small">@shift.TotalCancels.ToString("C2")</td>
                                    <td class="small">
                                        @if (shift.BackupBagAmount > 0 || shift.BagRefillAmount > 0)
                                        {
                                            <div class="d-flex gap-1 align-items-center">
                                                @if (shift.BackupBagAmount > 0)
                                                {
                                                    <span class="badge bg-danger text-white extra-small px-2 py-1" style="font-size: 0.6rem;">-@shift.BackupBagAmount.ToString("N0")</span>
                                                }
                                                @if (shift.BagRefillAmount > 0)
                                                {
                                                    <span class="badge bg-success text-white extra-small px-2 py-1" style="font-size: 0.6rem;">+@shift.BagRefillAmount.ToString("N0")</span>
                                                }
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted opacity-50">$0</span>
                                        }
                                    </td>
                                    <td class="fw-bold">@shift.NetDue.ToString("C2")</td>
                                    <td class="small">@shift.NetSales.ToString("C2")</td>
                                    <td class="fw-bold small">@shift.ExpectedCash.ToString("C2")</td>
                                    <td class="@(shift.EnvelopeAmount > 0 ? "text-warning fw-bold" : "text-muted opacity-50")">
                                        @shift.EnvelopeAmount.ToString("C2")
                                    </td>
                                    <td>
                                        <span class="variance-pill @(shift.Variance < 0 ? "variance-neg" : shift.Variance > 0 ? "variance-pos" : "variance-zero")">
                                            @shift.Variance.ToString("C2")
                                        </span>
                                    </td>
                                    <td>
                                        <span class="badge @(shift.IsReconciled ? "bg-success" : "bg-info") x-small">@(shift.IsReconciled ? "Reconciled" : "Submitted")</span>
                                    </td>
                                    <td class="text-center">
                                        <button class="btn btn-link btn-sm text-primary p-0" @onclick="() => EditShift(shift.ShiftId)" title="Edit">
                                            <i class="bi bi-pencil-square fs-5"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
}

