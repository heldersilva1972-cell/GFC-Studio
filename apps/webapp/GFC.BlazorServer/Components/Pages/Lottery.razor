@code {
    private LotteryShiftDto? _selectedShiftToSubmit;
    private bool _submittingOnBehalf;

    private void PromptSubmitOnBehalf(LotteryShiftDto shift)
    {
        _selectedShiftToSubmit = shift;
    }

    private async Task ConfirmSubmitOnBehalf()
    {
        if (_selectedShiftToSubmit == null) return;
        _submittingOnBehalf = true;
        try
        {
            var currentUser = AuthStateProvider.GetCurrentUser();
            var managerUsername = currentUser?.Username ?? "Manager";
            
            LotteryService.SubmitOnBehalfOfEmployee(_selectedShiftToSubmit.ShiftId, managerUsername);
            _selectedShiftToSubmit = null;
            await LoadData();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _submittingOnBehalf = false;
        }
    }
}

