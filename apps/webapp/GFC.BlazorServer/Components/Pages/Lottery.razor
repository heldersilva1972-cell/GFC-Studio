                .Select(g => {
                    var night = g.FirstOrDefault(s => string.Equals(s.ShiftType, "Night", StringComparison.OrdinalIgnoreCase));
                    var day = g.FirstOrDefault(s => string.Equals(s.ShiftType, "Day", StringComparison.OrdinalIgnoreCase));
                    
                    var representative = night;
                    if (night == null || string.Equals(night.EmployeeName, "Club Closed", StringComparison.OrdinalIgnoreCase))
                    {
                        if (day != null && !string.Equals(day.EmployeeName, "Club Closed", StringComparison.OrdinalIgnoreCase))
                        {
                            representative = day;
                        }
                    }
                    return representative ?? night ?? day ?? g.First();
                })
                .ToList();

            decimal cumulativeNetSales = finalShiftsOfDay.Sum(s => s.TotalSales);
            decimal cumulativeCashes = finalShiftsOfDay.Sum(s => s.TotalPayouts);
            decimal cumulativeTickets = finalShiftsOfDay.Sum(s => s.TotalCancels);
            decimal cumulativeNetDue = finalShiftsOfDay.Sum(s => s.NetDue);
        }

        <div class="d-flex flex-wrap gap-2 w-100">
            <!-- 1. Net Sales -->
            <div class="flex-fill" style="min-width: 140px;">
                <div class="data-card py-2 border rounded-3 bg-white shadow-sm h-100">
                    <div class="d-flex justify-content-between align-items-center px-3 mb-0">
                        <span class="text-muted extra-small text-uppercase fw-bold">Net Sales</span>
                        <span class="badge bg-light text-secondary border extra-small" style="font-size: 0.62rem;">Shift Reports</span>
                    </div>
                    <div class="h5 mb-0 fw-black text-dark px-3 mt-1">@cumulativeNetSales.ToString("C2")</div>
                </div>
            </div>
            <!-- 2. Total Cashes -->
            <div class="flex-fill" style="min-width: 140px;">
                <div class="data-card py-2 border rounded-3 bg-white shadow-sm h-100">
                    <div class="d-flex justify-content-between align-items-center px-3 mb-0">
                        <span class="text-muted extra-small text-uppercase fw-bold">Total Cashes</span>
                        <span class="badge bg-light text-secondary border extra-small" style="font-size: 0.62rem;">Shift Reports</span>
                    </div>
                    <div class="h5 mb-0 fw-black text-dark px-3 mt-1">@cumulativeCashes.ToString("C2")</div>
                </div>
            </div>
            <!-- 3. Total Tickets -->
            <div class="flex-fill" style="min-width: 140px;">
                <div class="data-card py-2 border rounded-3 bg-white shadow-sm h-100">
                    <div class="d-flex justify-content-between align-items-center px-3 mb-0">
                        <span class="text-muted extra-small text-uppercase fw-bold">Total Tickets</span>
                        <span class="badge bg-light text-secondary border extra-small" style="font-size: 0.62rem;">Shift Reports</span>
                    </div>
                    <div class="h5 mb-0 fw-black text-dark px-3 mt-1">@cumulativeTickets.ToString("C2")</div>
                </div>
            </div>
            <!-- 4. Net Due -->
            <div class="flex-fill" style="min-width: 140px;">
                <div class="data-card py-2 border rounded-3 bg-white shadow-sm h-100">
                    <div class="d-flex justify-content-between align-items-center px-3 mb-0">
                        <span class="text-muted extra-small text-uppercase fw-bold">Net Due</span>
                        <span class="badge bg-light text-secondary border extra-small" style="font-size: 0.62rem;">Shift Reports</span>
                    </div>
                    <div class="h5 mb-0 fw-black text-dark px-3 mt-1">@cumulativeNetDue.ToString("C2")</div>
                </div>
            </div>
            <!-- 5. Total Variance -->
            <div class="flex-fill" style="min-width: 140px;">
                <div class="data-card py-2 border rounded-3 bg-white shadow-sm h-100">
                    <div class="d-flex justify-content-between align-items-center px-3 mb-0">
                        <span class="text-muted extra-small text-uppercase fw-bold text-danger">Total Variance</span>
                        <span class="badge bg-light text-secondary border extra-small" style="font-size: 0.62rem;">Shift Drawer</span>
                    </div>
                    <div class="h5 mb-0 fw-black px-3 mt-1 @(contextVariance < 0 ? "text-danger" : contextVariance > 0 ? "text-success" : "text-dark")">
                        @contextVariance.ToString("C2")
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@if (_loading)
{
    <div class="loading-state">
        <div class="spinner-border spinner-border-sm text-info" role="status"></div>
