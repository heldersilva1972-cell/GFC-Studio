@* Collection Log History Modal *@
@if (_showVendingHistoryModal)
{
    <div class="modal fade show d-block" style="background: rgba(0,0,0,0.5); z-index: 1055;" tabindex="-1">
        <div class="modal-dialog modal-xl modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden bg-white">
                <div class="modal-header bg-light border-bottom p-3 px-4 d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="modal-title fw-black text-dark mb-0">
                            <i class="bi bi-ticket-perforated-fill text-warning me-2"></i>Vending Machine Collection Log
                        </h5>
                        <div class="extra-small text-muted mt-1">
                            Showing collections for period: <strong>@_filterStartDate.ToString("MMM d, yyyy") – @_filterEndDate.ToString("MMM d, yyyy")</strong> (@FilteredVendingCollections.Count() entries)
                        </div>
                    </div>
                    <button type="button" class="btn-close" @onclick="CloseVendingHistoryModal"></button>
                </div>
                <div class="modal-body p-0" style="max-height: 60vh; overflow-y: auto;">
                    <table class="data-table table-compact mb-0" style="width: 100%;">
                        <thead class="sticky-top bg-light shadow-sm">
                            <tr>
                                <th class="ps-4">Collection Date</th>
                                <th>Report Period Covered</th>
                                <th>Amount Collected</th>
                                <th>Logged By</th>
                                <th>Notes</th>
                                <th class="text-center">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!FilteredVendingCollections.Any())
                            {
                                <tr>
                                    <td colspan="6" class="text-center py-5 text-muted">
                                        <i class="bi bi-inbox fs-2 d-block mb-2 text-warning"></i>
                                        No vending machine collections recorded for the selected period.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var item in FilteredVendingCollections)
                                {
                                    <tr>
                                        <td class="ps-4 fw-bold">@item.CollectionDate.ToString("ddd, MMM d, yyyy")</td>
                                        <td>
                                            <span class="badge bg-light text-dark border px-2 py-1">
                                                @item.PeriodStartDate.ToString("MMM d") – @item.PeriodEndDate.ToString("MMM d, yyyy")
                                            </span>
                                        </td>
                                        <td class="fw-black text-success fs-6">@item.AmountCollected.ToString("C2")</td>
                                        <td>@(string.IsNullOrEmpty(item.EnteredBy) ? "Staff" : item.EnteredBy)</td>
                                        <td class="small text-muted">@(string.IsNullOrEmpty(item.Notes) ? "—" : item.Notes)</td>
                                        <td class="text-center">
                                            <button class="btn btn-sm btn-outline-primary rounded-pill me-1 px-3 py-1" @onclick="() => OpenEditVendingModal(item)" title="Edit Collection">
                                                <i class="bi bi-pencil-square me-1"></i>Edit
                                            </button>
                                            <button class="btn btn-sm btn-outline-danger rounded-pill px-3 py-1" @onclick="() => PromptDeleteVendingCollection(item)" title="Delete Collection">
                                                <i class="bi bi-trash-fill me-1"></i>Delete
                                            </button>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
                <div class="modal-footer border-top bg-light p-3 justify-content-between">
                    <button type="button" class="btn btn-warning fw-bold rounded-pill px-4 shadow-sm text-dark" @onclick="OpenNewVendingModal">
                        <i class="bi bi-plus-circle-fill me-1"></i> Log New Collection
                    </button>
                    <button type="button" class="btn btn-secondary fw-bold rounded-pill px-4" @onclick="CloseVendingHistoryModal">Close</button>
                </div>
            </div>
        </div>
    </div>
}

