@if (ShowContent && _viewMode == "daily")
{
    @* Shift Audit View - High Density (Original Table Format) *@
    <div class="data-card table-wrapper shadow-sm border-0">
        <h5 class="fw-black text-muted mb-2 pt-3 px-3 text-uppercase x-small tracking-widest">Weekly Shift Audit Log</h5>
        <div class="table-container-fixed">
            <table class="data-table table-compact">
                <thead>
                    <tr>
                        <th class="ps-4">Shift</th>
                        <th>Bartender</th>
                        <th>Beginning Cash</th>
                        <th>Net Sales</th>
                        <th>Cashes</th>
                        <th>Instant Tickets</th>
                        <th>Net Due</th>
                        <th>Shift Net Sales</th>
                        <th>Expected Drawer</th>
                        <th>Ending Cash</th>
                        <th class="text-indigo">Backup Bag</th>
                        <th>Envelope Drop</th>
                        <th>Variance</th>
                        <th>Status</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @for (var day = _filterEndDate.Date; day >= _filterStartDate.Date; day = day.AddDays(-1))
                    {
                        var currentDay = day;
                        var dayShiftsForDay = _shifts.Where(s => s.ShiftDate.Date == currentDay.Date && string.Equals(s.ShiftType, "Day", StringComparison.OrdinalIgnoreCase)).ToList();
                        var dayShift = dayShiftsForDay.FirstOrDefault(s => s.Status == "Draft") ?? dayShiftsForDay.FirstOrDefault();

                        var nightShiftsForDay = _shifts.Where(s => s.ShiftDate.Date == currentDay.Date && string.Equals(s.ShiftType, "Night", StringComparison.OrdinalIgnoreCase)).ToList();
                        var nightShift = nightShiftsForDay.FirstOrDefault(s => s.Status == "Draft") ?? nightShiftsForDay.FirstOrDefault();

                        // Only show the day group if it's not in the future, or if a shift actually exists for it
                        if (currentDay.Date > DateTime.Today && dayShift == null && nightShift == null)
                        {
                            continue;
                        }

                        @* Day Header Row *@
                        <tr class="day-group-header">
                            <td colspan="15" class="ps-4 py-2 border-bottom border-top">
                                <span class="fw-black text-primary text-uppercase small tracking-wider">@currentDay.ToString("dddd, MMMM d")</span>
                            </td>
                        </tr>

                        @* Render Day Shift *@
                        @if (dayShift != null)
                        {
                            <tr class="align-middle">
                                <td class="ps-4">
                                    <span class="badge bg-info-subtle text-info border border-info-subtle">DAY</span>
                                </td>
                                @if (string.Equals(dayShift.EmployeeName, "Club Closed", StringComparison.OrdinalIgnoreCase))
                                {
                                    <td colspan="12">
                                        <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-2 py-1"><i class="bi bi-door-closed-fill me-1"></i>CLUB CLOSED</span>
                                        <span class="text-muted small ms-2">No shift activity logged</span>
                                    </td>
                                }
                                else if (dayShift.Notes != null && dayShift.Notes.Contains("Included in Full Day Closeout"))
                                {
                                    <td colspan="12">
                                        <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1"><i class="bi bi-check-circle-fill me-1"></i>INCLUDED IN FULL DAY CLOSEOUT</span>
                                        <span class="text-muted small ms-2 fw-semibold">Covered by Night Shift (@dayShift.EmployeeName)</span>
                                    </td>
                                }
                                else
                                {
                                    <td><span class="fw-bold">@dayShift.EmployeeName</span></td>
                                    <td class="small">@dayShift.StartingCash.ToString("C")</td>
                                    <td class="small">@dayShift.TotalSales.ToString("C2")</td>
                                    <td class="small">@dayShift.TotalPayouts.ToString("C2")</td>
                                    <td class="small">@dayShift.TotalCancels.ToString("C2")</td>
                                    <td class="fw-bold">@dayShift.NetDue.ToString("C2")</td>
                                    <td class="small">@dayShift.NetSales.ToString("C2")</td>
                                    <td class="fw-bold small">@dayShift.ExpectedCash.ToString("C2")</td>
                                    <td class="small">@dayShift.EndingCash.ToString("C")</td>
                                    <td class="small">
                                        @if (dayShift.BackupBagAmount > 0 || dayShift.BagRefillAmount > 0)
                                        {
                                            <div class="d-flex flex-column gap-1" style="min-width: 140px;">
                                                @if (dayShift.BackupBagAmount > 0)
                                                {
                                                    <div class="d-flex align-items-center">
                                                        <span class="badge bg-primary bg-opacity-10 text-primary border border-primary-subtle extra-small px-2 py-1 w-100 text-start" style="font-size: 0.62rem; letter-spacing: 0.02em;">
                                                            <i class="bi bi-box-arrow-right me-1"></i> OUT FROM BAG: <span class="fw-black ms-auto float-end">@dayShift.BackupBagAmount.ToString("C0")</span>
                                                        </span>
                                                    </div>
                                                }
                                                @if (dayShift.BagRefillAmount > 0)
                                                {
                                                    <div class="d-flex align-items-center">
                                                        <span class="badge bg-success bg-opacity-10 text-success border border-success-subtle extra-small px-2 py-1 w-100 text-start" style="font-size: 0.62rem; letter-spacing: 0.02em;">
                                                            <i class="bi bi-box-arrow-in-left me-1"></i> BACK TO BAG: <span class="fw-black ms-auto float-end">@dayShift.BagRefillAmount.ToString("C0")</span>
                                                        </span>
                                                    </div>
                                                }
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted opacity-50 x-small">—</span>
                                        }
                                    </td>
                                    <td class="@(dayShift.EnvelopeAmount > 0 ? "text-warning fw-bold" : "text-muted opacity-50")">
                                        @dayShift.EnvelopeAmount.ToString("C2")
                                    </td>
                                    <td>
                                        <span class="variance-pill @(dayShift.Variance < 0 ? "variance-neg" : dayShift.Variance > 0 ? "variance-pos" : "variance-zero")">
                                            @dayShift.Variance.ToString("C2")
                                        </span>
                                    </td>
                                }
                                <td>
                                    @if (dayShift.Status == "Draft")
                                    {
                                        <span class="badge bg-warning text-dark x-small">Draft (In Progress)</span>
                                    }
                                    else
                                    {
                                        <span class="badge @(dayShift.IsReconciled ? "bg-success" : "bg-info") x-small">@(dayShift.IsReconciled ? "Reconciled" : "Submitted")</span>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (dayShift.Status == "Draft")
                                    {
                                        <button class="btn btn-sm btn-outline-warning rounded-pill px-2 py-0.5 me-1 fw-bold shadow-sm" style="font-size: 0.7rem;" @onclick="() => PromptSubmitOnBehalf(dayShift)" title="Submit on behalf of employee">
                                            <i class="bi bi-check-circle-fill me-1"></i> Submit On Behalf
                                        </button>
                                    }
                                    <button class="btn btn-link btn-sm text-primary p-0" @onclick="() => EditShift(dayShift.ShiftId)" title="Edit">
                                        <i class="bi bi-pencil-square fs-5"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                        else
                        {
                            <tr class="align-middle" style="background-color: @(nightShift != null && nightShift.Notes != null && nightShift.Notes.Contains("[Full Day Shift]") ? "#f6fcf8" : "#fffdf9") !important;">
                                <td class="ps-4">
                                    <span class="badge @(nightShift != null && nightShift.Notes != null && nightShift.Notes.Contains("[Full Day Shift]") ? "bg-info-subtle text-info border border-info-subtle" : "bg-light text-muted border")">DAY</span>
                                </td>
                                @if (nightShift != null && nightShift.Notes != null && nightShift.Notes.Contains("[Full Day Shift]"))
                                {
                                    <td colspan="12">
                                        <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1"><i class="bi bi-check-circle-fill me-1"></i>INCLUDED IN FULL DAY CLOSEOUT</span>
                                        <span class="text-muted small ms-2 fw-semibold">Covered by Full Day Shift (@nightShift.EmployeeName)</span>
                                    </td>
                                    <td>
                                        <span class="badge bg-success-subtle text-success border border-success-subtle x-small">Completed</span>
                                    </td>
                                    <td class="text-center">
                                        <button class="btn btn-link btn-sm text-primary p-0" @onclick="() => EditShift(nightShift.ShiftId)" title="Edit Full Day Shift">
                                            <i class="bi bi-pencil-square fs-5"></i>
                                        </button>
                                    </td>
                                }
                                else
                                {
                                    <td colspan="12">
                                        <span class="text-muted small italic fw-normal"><i class="bi bi-exclamation-circle text-warning me-1"></i>No shift report entered</span>
                                    </td>
                                    <td>
                                        <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle x-small">Missing</span>
                                    </td>
                                    <td class="text-center">
                                        <button class="btn btn-sm btn-outline-danger rounded-pill px-3 fw-bold py-0.5 shadow-sm" style="font-size: 0.7rem;" @onclick='() => CreateClosedShift(currentDay, "Day")'>
                                            <i class="bi bi-door-closed-fill me-1"></i> Mark Closed
                                        </button>
                                    </td>
                                }
                            </tr>
                        }

                        @* Render Night Shift *@
                        @if (nightShift != null)
                        {
                            <tr class="align-middle">
                                <td class="ps-4">
                                    <span class="badge bg-indigo-subtle text-indigo border border-indigo-subtle">NIGHT</span>
                                </td>
                                @if (string.Equals(nightShift.EmployeeName, "Club Closed", StringComparison.OrdinalIgnoreCase))
                                {
                                    <td colspan="12">
                                        <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-2 py-1"><i class="bi bi-door-closed-fill me-1"></i>CLUB CLOSED</span>
                                        <span class="text-muted small ms-2">No shift activity logged</span>
                                    </td>
                                }
                                else
                                {
                                    <td>
                                        <span class="fw-bold">@nightShift.EmployeeName</span>
                                        @if (nightShift.Notes != null && nightShift.Notes.Contains("[Full Day Shift]"))
                                        {
                                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle extra-small ms-1" style="font-size: 0.6rem;">FULL DAY</span>
                                        }
                                    </td>
                                    <td class="small">@nightShift.StartingCash.ToString("C")</td>
                                    <td class="small">@nightShift.TotalSales.ToString("C2")</td>
                                    <td class="small">@nightShift.TotalPayouts.ToString("C2")</td>
                                    <td class="small">@nightShift.TotalCancels.ToString("C2")</td>
                                    <td class="fw-bold">@nightShift.NetDue.ToString("C2")</td>
                                    <td class="small">@nightShift.NetSales.ToString("C2")</td>
                                    <td class="fw-bold small">@nightShift.ExpectedCash.ToString("C2")</td>
                                    <td class="small">@nightShift.EndingCash.ToString("C")</td>
                                    <td class="small">
                                        @if (nightShift.BackupBagAmount > 0 || nightShift.BagRefillAmount > 0)
                                        {
                                            <div class="d-flex flex-column gap-1" style="min-width: 140px;">
                                                @if (nightShift.BackupBagAmount > 0)
                                                {
                                                    <div class="d-flex align-items-center">
                                                        <span class="badge bg-primary bg-opacity-10 text-primary border border-primary-subtle extra-small px-2 py-1 w-100 text-start" style="font-size: 0.62rem; letter-spacing: 0.02em;">
                                                            <i class="bi bi-box-arrow-right me-1"></i> OUT FROM BAG: <span class="fw-black ms-auto float-end">@nightShift.BackupBagAmount.ToString("C0")</span>
                                                        </span>
                                                    </div>
                                                }
                                                @if (nightShift.BagRefillAmount > 0)
                                                {
                                                    <div class="d-flex align-items-center">
                                                        <span class="badge bg-success bg-opacity-10 text-success border border-success-subtle extra-small px-2 py-1 w-100 text-start" style="font-size: 0.62rem; letter-spacing: 0.02em;">
                                                            <i class="bi bi-box-arrow-in-left me-1"></i> BACK TO BAG: <span class="fw-black ms-auto float-end">@nightShift.BagRefillAmount.ToString("C0")</span>
                                                        </span>
                                                    </div>
                                                }
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted opacity-50 x-small">—</span>
                                        }
                                    </td>
                                    <td class="@(nightShift.EnvelopeAmount > 0 ? "text-warning fw-bold" : "text-muted opacity-50")">
                                        @nightShift.EnvelopeAmount.ToString("C2")
                                    </td>
                                    <td>
                                        <span class="variance-pill @(nightShift.Variance < 0 ? "variance-neg" : nightShift.Variance > 0 ? "variance-pos" : "variance-zero")">
                                            @nightShift.Variance.ToString("C2")
                                        </span>
                                    </td>
                                }
                                <td>
                                    @if (nightShift.Status == "Draft")
                                    {
                                        <span class="badge bg-warning text-dark x-small">Draft (In Progress)</span>
                                    }
                                    else
                                    {
                                        <span class="badge @(nightShift.IsReconciled ? "bg-success" : "bg-info") x-small">@(nightShift.IsReconciled ? "Reconciled" : "Submitted")</span>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (nightShift.Status == "Draft")
                                    {
                                        <button class="btn btn-sm btn-outline-warning rounded-pill px-2 py-0.5 me-1 fw-bold shadow-sm" style="font-size: 0.7rem;" @onclick="() => PromptSubmitOnBehalf(nightShift)" title="Submit on behalf of employee">
                                            <i class="bi bi-check-circle-fill me-1"></i> Submit On Behalf
                                        </button>
                                    }
                                    <button class="btn btn-link btn-sm text-primary p-0" @onclick="() => EditShift(nightShift.ShiftId)" title="Edit">
                                        <i class="bi bi-pencil-square fs-5"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                        else
                        {
                            <tr class="align-middle" style="background-color: #fffdf9 !important;">
                                <td class="ps-4">
                                    <span class="badge bg-indigo-subtle text-indigo border border-indigo-subtle">NIGHT</span>
                                </td>
                                <td colspan="12">
                                    <span class="text-muted small italic fw-normal"><i class="bi bi-exclamation-circle text-warning me-1"></i>No shift report entered</span>
                                </td>
                                <td>
                                    <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle x-small">Missing</span>
                                </td>
                                <td class="text-center">
                                    <button class="btn btn-sm btn-outline-danger rounded-pill px-3 fw-bold py-0.5 shadow-sm" style="font-size: 0.7rem;" @onclick='() => CreateClosedShift(currentDay, "Night")'>
                                        <i class="bi bi-door-closed-fill me-1"></i> Mark Closed
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
}

