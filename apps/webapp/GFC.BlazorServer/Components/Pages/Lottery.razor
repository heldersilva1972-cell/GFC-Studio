@if (ShowContent && _viewMode == "reconcile")
{
    @* Reconcile View (One line per week) *@
    <div class="data-card">
        <div class="table-container-fixed">
            <table class="data-table">
                <thead>
                    <tr class="text-uppercase x-small tracking-widest text-muted">
                        <th>Fiscal Period</th>
                        <th class="text-end">Sales (RPT 50)</th>
                        <th class="text-end">Cashes (RPT 50)</th>
                        <th class="text-end">Tickets (RPT 34)</th>
                        <th class="text-end fw-bold">Net Due</th>
                        <th class="text-end text-danger fw-bold">Due to Lottery</th>
                        <th class="text-end text-primary fw-bold">Envelope Cash</th>
                        <th class="text-end">Net Revenue</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_weeklySummaries != null && _weeklySummaries.Any())
                    {
                        @foreach (var week in _weeklySummaries.OrderByDescending(w => w.PeriodStart))
                        {
                            // [SMART-AUDIT]: Extract the true daily totals for this week (Ignoring Drafts)
                            var weekShifts = _shifts.Where(s => s.ShiftDate.Date >= week.PeriodStart.Date && s.ShiftDate.Date <= week.PeriodEnd.Date && s.Status != "Draft");
                            var dailyData = weekShifts.GroupBy(s => s.ShiftDate.Date)
                                .Select(g => {
                                    var latest = g.OrderByDescending(s => s.ShiftId).First();
                                    return new {
                                        Sales = latest.TotalSales,
                                        Payouts = latest.TotalPayouts,
                                        Tickets = latest.TotalCancels,
                                        NetDue = latest.NetDue,
                                        Envelope = g.Sum(s => s.EnvelopeAmount)
                                    };
                                }).ToList();

                            var weekSales = dailyData.Sum(d => d.Sales);
                            var weekPayouts = dailyData.Sum(d => d.Payouts);
                            var weekTickets = dailyData.Sum(d => d.Tickets);
                            var weekNetDue = dailyData.Sum(d => d.NetDue);
                            var weekEnvelope = dailyData.Sum(d => d.Envelope);
                            var weekDueToLottery = weekNetDue - weekTickets;
                            var weekRevenue = weekEnvelope - weekDueToLottery;
                            
                            <tr class="align-middle">
                                <td class="fw-bold">@week.PeriodLabel</td>
                                <td class="text-end">@weekSales.ToString("C2")</td>
                                <td class="text-end">@weekPayouts.ToString("C2")</td>
                                <td class="text-end">@weekTickets.ToString("C2")</td>
                                <td class="text-end fw-bold">@weekNetDue.ToString("C2")</td>
                                <td class="text-end text-danger fw-bold">@weekDueToLottery.ToString("C2")</td>
                                <td class="text-end text-primary fw-bold">@weekEnvelope.ToString("C2")</td>
                                <td class="text-end fw-black @(weekRevenue >= 0 ? "text-success" : "text-danger")">
                                    @weekRevenue.ToString("C2")
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
}
