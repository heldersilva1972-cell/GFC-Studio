                <button class="btn btn-sm @(_showMetricClaimsBonus ? "btn-indigo" : "btn-outline-indigo") rounded-pill px-3 fw-bold fs-7 shadow-sm" style="@(_showMetricClaimsBonus ? "background-color: #6366f1; color: white;" : "")" @onclick='() => ToggleCommissionsMetric("claimsbonus")'>
