@* Summary Statistics *@
@if (_viewMode == "commissions")
{
    var totalComm = _weeklyCommissionsStats.Sum(w => Math.Abs(w.OnlineCommission) + Math.Abs(w.InstantCommission));
    var totalCashBonus = _weeklyCommissionsStats.Sum(w => Math.Abs(w.OnlineCashBonus) + Math.Abs(w.InstantCashBonus));
    var totalClaimsBonus = _weeklyCommissionsStats.Sum(w => Math.Abs(w.OnlineClaimsBonus) + Math.Abs(w.InstantClaimsBonus));
    var totalFees = _weeklyCommissionsStats.Sum(w => Math.Abs(w.OnlineServiceFee) + Math.Abs(w.OnlineBondingFee));
    
    decimal totalEarnings = 0;
    if (_showMetricCommissions) totalEarnings += totalComm;
    if (_showMetricCashBonus) totalEarnings += totalCashBonus;
    if (_showMetricClaimsBonus) totalEarnings += totalClaimsBonus;
    if (_showMetricFees) totalEarnings -= totalFees;

    int weekCount = _weeklyCommissionsStats.Count;
    decimal avgEarnings = weekCount > 0 ? totalEarnings / weekCount : 0m;
    decimal avgComm = weekCount > 0 ? totalComm / weekCount : 0m;
    decimal avgCashBonus = weekCount > 0 ? totalCashBonus / weekCount : 0m;
    decimal avgClaimsBonus = weekCount > 0 ? totalClaimsBonus / weekCount : 0m;
    decimal avgFees = weekCount > 0 ? totalFees / weekCount : 0m;

    <div class="mb-3 px-1">
        <div class="d-flex flex-wrap gap-2 w-100">
            @if (_showMetricCommissions)
            {
                <!-- 1. Total Commissions -->
