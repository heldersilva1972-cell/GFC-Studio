else if (_viewMode != "imported" && _viewMode != "commissions" && _viewMode != "analytics" && _viewMode != "summaries" && _viewMode != "compliance" && _shifts.Any())
{
    // [SMART-AUDIT]: Commission for the summary cards is calculated from the cumulative machine readings
    // of the final shift of each day (Night shift) to ensure it matches the official reports.
    decimal contextCommissions = _shifts
        .GroupBy(s => s.ShiftDate.Date)
        .Sum(g => {
            var night = g.FirstOrDefault(s => string.Equals(s.ShiftType, "Night", StringComparison.OrdinalIgnoreCase));
            var day = g.FirstOrDefault(s => string.Equals(s.ShiftType, "Day", StringComparison.OrdinalIgnoreCase));
            
            var latest = night;
            if (night == null || string.Equals(night.EmployeeName, "Club Closed", StringComparison.OrdinalIgnoreCase))
            {
                if (day != null && !string.Equals(day.EmployeeName, "Club Closed", StringComparison.OrdinalIgnoreCase))
                {
                    latest = day;
                }
            }
            latest ??= night ?? day ?? g.First();

            var rates = _commissionRates.FirstOrDefault(r => r.Year == g.Key.Year);
            if (rates == null) return 0;
            return (latest.TotalSales * rates.SalesCommissionMultiplier) + 
                   (latest.TotalPayouts * rates.CashingBonusMultiplier) + 
                   (latest.TotalCancels * rates.TicketBonusMultiplier);
        });

    var rates = _commissionRates.FirstOrDefault(r => r.Year == _filterStartDate.Year);
    decimal dailyTotalFee = (rates?.DailySystemFee ?? 0) + (rates?.DailyBondingFee ?? 0);
    decimal contextFees = (decimal)_shifts.Select(s => s.ShiftDate.Date).Distinct().Count() * dailyTotalFee;
    decimal contextVariance = TotalVariance;

    string contextLabel = "Weekly";

    <div class="mb-2 px-1">
