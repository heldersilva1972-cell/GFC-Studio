@page "/setup/device"
@using GFC.BlazorServer.Services
@using GFC.Core.Interfaces
@inject IDeviceInviteService DeviceInviteService
@inject IDeviceTrustService DeviceTrustService
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@inject ISystemSettingsService SettingsService
@inject INotificationService NotificationService
@inject IBlazorSystemSettingsService BlazorSettingsService

<PageTitle>Device Setup - GFC System</PageTitle>

<div class="setup-container">
    <div class="setup-card">
        <div class="header">
            <i class="bi bi-shield-lock-fill icon"></i>
            <h1>Secure Device Enrollment</h1>
            <p>Introducing your device to the GFC System</p>
        </div>

        @if (_isProcessing)
        {
            <div class="status-msg processing">
                <div class="spinner-border text-primary mb-3" role="status"></div>
                <p>Verifying your secure token...</p>
            </div>
        }
        else if (_error != null)
        {
            <div class="status-msg error">
                <i class="bi bi-exclamation-triangle-fill error-icon"></i>
                <h3>Access Denied</h3>
                <p>@_error</p>
                <div class="mt-4">
                    <p class="small text-muted">This link may have expired or was already used. Please request a new setup link from an administrator.</p>
                </div>
            </div>
        }
        else if (_success)
        {
            <div class="status-msg success">
                <i class="bi bi-check-circle-fill success-icon"></i>
                <h3>Device Trusted!</h3>
                <p>Your device has been successfully registered and is now authorized to see the login page.</p>
                
                <div class="next-steps mt-4">
                    <button class="btn btn-primary w-100 py-3 mb-3 fw-bold shadow-sm" @onclick="GoToLogin">
                        Continue to System Login <i class="bi bi-arrow-right ms-2"></i>
                    </button>
                    
                    <div class="pwa-upsell mt-4 p-4 rounded-4 border border-primary border-opacity-25 bg-primary bg-opacity-10 text-start shadow-sm">
                        <div class="d-flex align-items-center mb-3">
                            <div class="p-2 bg-primary rounded-3 text-white me-3">
                                <i class="bi bi-phone-fill fs-4"></i>
                            </div>
                            <div>
                                <h6 class="fw-bold mb-0">Add to Home Screen?</h6>
                                <p class="small text-muted mb-0">Get one-tap access and notifications.</p>
                            </div>
                        </div>

                        <div class="row g-2">
                            <div class="col-sm-6">
                                @if (_canInstall)
                                {
                                    <button class="btn btn-outline-primary w-100 py-2 fw-bold bg-white" @onclick="TriggerInstall">
                                        <i class="bi bi-plus-circle me-2"></i> Yes, Add App
                                    </button>
                                }
                                else if (!string.IsNullOrEmpty(_platformInstructions))
                                {
                                    <button class="btn btn-outline-primary w-100 py-2 fw-bold bg-white" @onclick="() => _showInstructions = !_showInstructions">
                                        <i class="bi bi-info-circle me-2"></i> How to Install
                                    </button>
                                }
                            </div>
                            <div class="col-sm-6">
                                <button class="btn @(_isSubscribed ? "btn-success" : "btn-info text-white") w-100 py-2 fw-bold" 
                                        @onclick="TogglePushNotifications" 
                                        disabled="@_isPushProcessing">
                                    @if (_isPushProcessing) { <span class="spinner-border spinner-border-sm me-2"></span> }
                                    <i class="bi @(_isSubscribed ? "bi-bell-fill" : "bi-bell") me-2"></i>
                                    @(_isSubscribed ? "Alerts Active" : "Get Notifications")
                                </button>
                            </div>
                        </div>

                        @if (_showInstructions && !string.IsNullOrEmpty(_platformInstructions))
                        {
                            <div class="alert alert-light border border-primary border-opacity-10 small py-2 mb-2 mt-3">
                                @((MarkupString)_platformInstructions)
                            </div>
                            <p class="x-small text-muted text-center mb-0 mt-2"><i class="bi bi-info-circle me-1"></i> iPhone users must add manually via the share menu.</p>
                        }

                        <button class="btn btn-link btn-sm w-100 text-muted text-decoration-none mt-3" @onclick="GoToLogin">Maybe later</button>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<style>
    .setup-container {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 80vh;
        padding: 2rem;
        background: #f8f9fa;
    }

    .setup-card {
        background: white;
        padding: 2.5rem;
        border-radius: 12px;
        box-shadow: 0 10px 25px rgba(0,0,0,0.08);
        max-width: 450px;
        width: 100%;
        text-align: center;
        border-top: 5px solid #0d6efd;
    }

    .header .icon {
        font-size: 3.5rem;
        color: #0d6efd;
        margin-bottom: 1rem;
        display: block;
    }

    .header h1 {
        font-size: 1.5rem;
        font-weight: 700;
        margin-bottom: 0.5rem;
        color: #212529;
    }

    .header p {
        color: #6c757d;
        font-size: 0.95rem;
    }

    .status-msg {
        margin-top: 2rem;
    }

    .error-icon {
        font-size: 3rem;
        color: #dc3545;
        margin-bottom: 1rem;
        display: block;
    }

    .success-icon {
        font-size: 3rem;
        color: #198754;
        margin-bottom: 1rem;
        display: block;
    }

    .status-msg h3 {
        font-size: 1.25rem;
        font-weight: 600;
        margin-bottom: 0.75rem;
    }

    .status-msg p {
        color: #495057;
    }
</style>

@code {
    [Parameter]
    [SupplyParameterFromQuery]
    public string? Token { get; set; }

    private bool _isProcessing = true;
    private string? _error;
    private bool _success;
    private bool _canInstall = false;
    private string? _platformInstructions;
    private bool _showInstructions = false;
    private bool _isSubscribed = false;
    private bool _isPushProcessing = false;
    private int _onboardedUserId;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await ProcessToken();
            await CheckInstallability();
        }
    }

    private async Task CheckInstallability()
    {
        try 
        {
            var result = await JSRuntime.InvokeAsync<PwaCheckResult>("pwaInstaller.checkInstallability");
            if (result != null)
            {
                _canInstall = result.CanInstall;
                _platformInstructions = result.Instructions;
                StateHasChanged();
            }
        }
        catch { /* Ignore PWA errors here */ }
    }

    private async Task TriggerInstall()
    {
        try 
        {
            var success = await JSRuntime.InvokeAsync<bool>("pwaInstaller.install");
            if (success) {
                _canInstall = false;
                StateHasChanged();
            }
        }
        catch { }
    }

    public class PwaCheckResult {
        public bool CanInstall { get; set; }
        public string? Instructions { get; set; }
    }

    private async Task TogglePushNotifications()
    {
        if (_onboardedUserId <= 0) return;
        
        _isPushProcessing = true;
        try
        {
            if (!_isSubscribed)
            {
                var permission = await JSRuntime.InvokeAsync<string>("GFC_Notifications.requestPermission");
                if (permission == "granted")
                {
                    var settings = await BlazorSettingsService.GetAsync();
                    if (!string.IsNullOrEmpty(settings.VapidPublicKey))
                    {
                        var subscriptionJson = await JSRuntime.InvokeAsync<string>("GFC_Notifications.subscribe", settings.VapidPublicKey);
                        using var doc = System.Text.Json.JsonDocument.Parse(subscriptionJson);
                        var root = doc.RootElement;
                        var endpoint = root.GetProperty("endpoint").GetString() ?? "";
                        var p256dh = root.GetProperty("keys").GetProperty("p256dh").GetString() ?? "";
                        var auth = root.GetProperty("keys").GetProperty("auth").GetString() ?? "";

                        await NotificationService.SubscribeToPushAsync(_onboardedUserId, endpoint, p256dh, auth, "Browser Client (Onboarding)");
                        _isSubscribed = true;
                    }
                }
            }
            else
            {
                // Simple toggle off if they click again
                await JSRuntime.InvokeVoidAsync("GFC_Notifications.unsubscribe");
                _isSubscribed = false;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Push subscription error: {ex.Message}");
        }
        finally
        {
            _isPushProcessing = false;
            StateHasChanged();
        }
    }

    private async Task ProcessToken()
    {
        if (string.IsNullOrWhiteSpace(Token))
        {
            _error = "No setup token was provided.";
            _isProcessing = false;
            StateHasChanged();
            return;
        }

        try
        {
            var invite = await DeviceInviteService.ValidateTokenAsync(Token);
            if (invite == null)
            {
                _error = "The provided setup token is invalid, expired, or has already been used.";
                _isProcessing = false;
                StateHasChanged();
                return;
            }

            // Create actual Device Trust Token
            var userAgent = await JSRuntime.InvokeAsync<string>("eval", "navigator.userAgent");
            var ipAddress = "detected-at-auth"; // Will be updated during first login or via middleware
            
            var duration = await SettingsService.GetTrustedDeviceDurationDaysAsync();

            var trustToken = await DeviceTrustService.CreateDeviceTokenAsync(invite.UserId, userAgent, ipAddress, duration);

            // Save to LocalStorage and Cookies
            await JSRuntime.InvokeVoidAsync("localStorage.setItem", "gfc_device_token", trustToken);
            await JSRuntime.InvokeVoidAsync("window.setCookie", "GFC_DeviceTrustToken", trustToken, duration);

            // Mark invite as used
            await DeviceInviteService.MarkTokenAsUsedAsync(Token);

            _onboardedUserId = invite.UserId;
            _success = true;
        }
        catch (Exception ex)
        {
            _error = $"An internal error occurred: {ex.Message}";
        }
        finally
        {
            _isProcessing = false;
            StateHasChanged();
        }
    }

    private void GoToLogin()
    {
        // [FIX] Pass 'setup=enroll' so the Login page knows to redirect to the Device Wizard after login.
        // This ensures the user is prompted to set up a passcode and biometrics.
        NavigationManager.NavigateTo("/login?setup=enroll", true);
    }
}
