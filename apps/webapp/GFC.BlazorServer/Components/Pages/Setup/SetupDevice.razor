@page "/setup/device"
@using GFC.BlazorServer.Services
@using GFC.Core.Interfaces
@using GFC.Core.Models.Security
@inject IDeviceInviteService InviteService
@inject IDeviceTrustService TrustService
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@inject ISystemSettingsService SettingsService
@inject INotificationService NotificationService
@inject IBlazorSystemSettingsService BlazorSettingsService
@inject CustomAuthenticationStateProvider AuthStateProvider
@implements IDisposable

<PageTitle>Device Setup - GFC System</PageTitle>

<div class="setup-container">
    <div class="setup-card">
        <div class="header">
            <i class="bi bi-shield-lock-fill icon"></i>
            <h1>Secure Device Enrollment</h1>
            <p>Introducing your device to the GFC System</p>
        </div>

        @if (_isProcessing)
        {
            <div class="status-msg processing">
                <div class="spinner-border text-primary mb-3" role="status"></div>
                <p>Verifying your secure token...</p>
            </div>
        }
        else if (_error != null)
        {
            <div class="status-msg error">
                <i class="bi bi-exclamation-triangle-fill error-icon"></i>
                <h3>Access Denied</h3>
                <p>@_error</p>
                <div class="mt-4">
                    <p class="small text-muted">This link may have expired or was already used. Please request a new setup link from an administrator.</p>
                </div>
            </div>
        }
        else if (IsStation && !_stationConfirmed && !_isProcessing)
        {
            <div class="status-msg animate-slide-up">
                <div class="premium-orb bg-warning-soft text-warning mb-4 mx-auto">
                    <i class="bi bi-display-fill"></i>
                </div>
                <h3 class="fw-bold mb-3">Authorize Station</h3>
                <p class="text-muted small mb-4 px-3">
                    You are authorizing this computer as a <strong>Collective Station</strong>. Please give it a friendly name to identify it in the system.
                </p>
                
                <div class="form-group mb-4 text-start">
                    <label class="x-small fw-bold text-muted text-uppercase mb-2">Station Identity (e.g. Lobby PC)</label>
                    <input type="text" class="form-control-premium py-3" @bind="_stationName" placeholder="Enter station name..." />
                </div>

                <button class="btn btn-primary-premium w-100 py-3 fw-bold shadow-premium" 
                        @onclick="ConfirmStationSetup" 
                        disabled="@(string.IsNullOrWhiteSpace(_stationName) || _isProcessing)">
                    Authorize This Computer <i class="bi bi-shield-check ms-2"></i>
                </button>
            </div>
        }
        else if (_success)
        {
            <div class="status-msg success">
                <i class="bi bi-check-circle-fill success-icon"></i>
                <h3>Device Trusted!</h3>
                <p>Your device has been successfully registered and is now authorized to see the login page.</p>
                
                <div class="next-steps mt-4">
                    <button class="btn btn-primary w-100 py-3 mb-3 fw-bold shadow-sm" @onclick="GoToLogin" disabled="@_isNavigating">
                        @if (_isNavigating)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                            <span>Loading Setup...</span>
                        }
                        else
                        {
                            <span>Continue to System Login <i class="bi bi-arrow-right ms-2"></i></span>
                        }
                    </button>
                    @if (!string.IsNullOrEmpty(_error))
                    {
                        <div class="alert alert-danger mb-3 p-2 small">@_error</div>
                    }
                    
                    <div class="pwa-upsell mt-4 p-4 rounded-4 border border-primary border-opacity-25 bg-primary bg-opacity-10 text-start shadow-sm">
                        <div class="d-flex align-items-center mb-3">
                            <div class="p-2 bg-primary rounded-3 text-white me-3">
                                <i class="bi bi-phone-fill fs-4"></i>
                            </div>
                            <div>
                                <h6 class="fw-bold mb-0">Install App?</h6>
                                <p class="small text-muted mb-0">Install to your device for easy access.</p>
                            </div>
                        </div>

                        <div class="row g-2">
                            <div class="col-sm-6">
                                @if (_canInstall)
                                {
                                    <button class="btn btn-outline-primary w-100 py-2 fw-bold bg-white" @onclick="TriggerInstall">
                                        <i class="bi bi-download me-2"></i> Install App
                                    </button>
                                }
                                else if (!string.IsNullOrEmpty(_platformInstructions))
                                {
                                    <button class="btn btn-outline-primary w-100 py-2 fw-bold bg-white" @onclick="() => _showInstructions = !_showInstructions">
                                        <i class="bi bi-info-circle me-2"></i> How to Install
                                    </button>
                                }
                            </div>
                            <div class="col-sm-6">
                                @if (!_isNativeMode)
                                {
                                    <div class="alert alert-warning x-small p-2 mb-0 d-flex align-items-center">
                                        <i class="bi bi-phone-vibrate me-2"></i>
                                        <span>Use the <b>GFC App</b> to enable alerts.</span>
                                    </div>
                                }
                                else
                                {
                                    <button id="btn-toggle-push" data-gfc-notif-btn data-vapid="@_vapidKey" class="btn @(_isSubscribed ? "btn-success" : "btn-info text-white") w-100 py-2 fw-bold" 
                                            type="button">
                                        @if (_isPushProcessing) { <span class="spinner-border spinner-border-sm me-2"></span> }
                                        <i class="bi @(_isSubscribed ? "bi-bell-fill" : "bi-bell") me-2"></i>
                                        @(_isSubscribed ? "Alerts Active" : "Get Notifications")
                                    </button>
                                }
                            </div>
                        </div>

                        @if (_showInstructions && !string.IsNullOrEmpty(_platformInstructions))
                        {
                            <div class="alert alert-light border border-primary border-opacity-10 small py-2 mb-2 mt-3">
                                @((MarkupString)_platformInstructions)
                            </div>
                            <p class="x-small text-muted text-center mb-0 mt-2"><i class="bi bi-info-circle me-1"></i> iPhone users must add manually via the share menu.</p>
                        }

                        @if (!_isNativeMode)
                        {
                            <div class="text-center mt-3">
                                <a href="intent://#Intent;scheme=gfc;package=com.heldersilva.gfc;end" class="btn btn-link btn-sm text-primary p-0">Open GFC App <i class="bi bi-box-arrow-up-right ms-1"></i></a>
                            </div>
                        }

                        <button class="btn btn-link btn-sm w-100 text-muted text-decoration-none mt-3" @onclick="GoToLogin">Maybe later</button>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<style>
    .setup-container {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 80vh;
        padding: 2rem;
        background: #f8f9fa;
    }

    .setup-card {
        background: white;
        padding: 2.5rem;
        border-radius: 12px;
        box-shadow: 0 10px 25px rgba(0,0,0,0.08);
        max-width: 450px;
        width: 100%;
        text-align: center;
        border-top: 5px solid #0d6efd;
    }

    .header .icon {
        font-size: 3.5rem;
        color: #0d6efd;
        margin-bottom: 1rem;
        display: block;
    }

    .header h1 {
        font-size: 1.5rem;
        font-weight: 700;
        margin-bottom: 0.5rem;
        color: #212529;
    }

    .header p {
        color: #6c757d;
        font-size: 0.95rem;
    }

    .status-msg {
        margin-top: 2rem;
    }

    .error-icon {
        font-size: 3rem;
        color: #dc3545;
        margin-bottom: 1rem;
        display: block;
    }

    .success-icon {
        font-size: 3rem;
        color: #198754;
        margin-bottom: 1rem;
        display: block;
    }

    .status-msg h3 {
        font-size: 1.25rem;
        font-weight: 600;
        margin-bottom: 0.75rem;
    }

    .status-msg p {
        color: #495057;
    }
</style>

@code {
    [Parameter]
    [SupplyParameterFromQuery]
    public string? Token { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "station")]
    public bool IsStation { get; set; }

    private bool _isProcessing = true;
    private string? _error;
    private bool _success;
    private bool _canInstall = false;
    private string? _platformInstructions;
    private bool _showInstructions = false;
    private bool _isNativeMode = false;
    private bool _isSubscribed = false;
    private bool _isPushProcessing = false;
    private string? _vapidKey;
    private int _onboardedUserId;
    private string? _stationName;
    private bool _stationConfirmed = false;
    private DeviceInviteToken? _validatedInvite;

    private DotNetObjectReference<SetupDevice>? _objRef;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _isNativeMode = await JSRuntime.InvokeAsync<bool>("eval", "!!window.__GFC_NATIVE_APP__ || !!window.Android");
            await ProcessToken();
            await CheckPwaInstallability();
            _objRef = DotNetObjectReference.Create(this);
            StateHasChanged();
        }

        // CRITICAL: Bind the native listener every render if we have a user and aren't subscribed
        if (_onboardedUserId > 0 && !_isSubscribed && _isNativeMode)
        {
            try 
            {
                var settings = await BlazorSettingsService.GetAsync();
                if (!string.IsNullOrEmpty(settings.VapidPublicKey))
                {
                    await JSRuntime.InvokeVoidAsync("GFC_Notifications.bindNativePrompt", "btn-toggle-push", settings.VapidPublicKey, _objRef);
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Binding error: {ex.Message}");
            }
        }
    }

    [JSInvokable]
    public async Task OnSubscriptionSuccess(string subscriptionJson)
    {
        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(subscriptionJson);
            var root = doc.RootElement;
            var endpoint = root.GetProperty("endpoint").GetString() ?? "";
            var p256dh = root.GetProperty("keys").GetProperty("p256dh").GetString() ?? "";
            var auth = root.GetProperty("keys").GetProperty("auth").GetString() ?? "";

            await NotificationService.SubscribeToPushAsync(_onboardedUserId, endpoint, p256dh, auth, "Browser Client (Onboarding)");
            _isSubscribed = true;
            
            // Send welcome push
            try { await NotificationService.SendPushNotificationAsync(_onboardedUserId, "GFC Notifications", "System alerts are now active on this device!", "/"); } catch {}
            
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Subscription save error: {ex.Message}");
        }
    }

    [JSInvokable]
    public void OnPermissionResult(string permission)
    {
        StateHasChanged();
    }

    [JSInvokable]
    public void OnSubscriptionError(string message)
    {
        Console.WriteLine($"Push subscription error: {message}");
        StateHasChanged();
    }

    public void Dispose()
    {
        _objRef?.Dispose();
    }

    private async Task CheckPwaInstallability() 
    {
        try 
        {
            _canInstall = await JSRuntime.InvokeAsync<bool>("GFC.canInstall");
            
            // Check if iOS for manual instructions
            var isIOS = await JSRuntime.InvokeAsync<bool>("GFC.isIOS");
            if (isIOS)
            {
                _platformInstructions = "Tap the <strong>Share</strong> button <i class='bi bi-box-arrow-up'></i> at the bottom, then select <strong>Add to Home Screen</strong>.";
            }
            
            StateHasChanged();
        }
        catch { /* Ignore PWA errors here */ }
    }

    private async Task TriggerInstall()
    {
        try 
        {
            var success = await JSRuntime.InvokeAsync<bool>("GFC.triggerInstall");
            if (success) {
                _canInstall = false;
                StateHasChanged();
            }
        }
        catch { }
    }

    private async Task TogglePushNotifications()
    {
        // This is primarily for unsubscribing now, as subscription is handled by the native JS binder
        if (_onboardedUserId <= 0) return;
        
        if (_isSubscribed)
        {
            _isPushProcessing = true;
            try
            {
                await JSRuntime.InvokeVoidAsync("GFC_Notifications.unsubscribe");
                _isSubscribed = false;
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Unsubscribe error: {ex.Message}");
            }
            finally
            {
                _isPushProcessing = false;
                StateHasChanged();
            }
        }
    }

    private async Task ProcessToken()
    {
        if (string.IsNullOrWhiteSpace(Token))
        {
            _error = "No setup token was provided.";
            _isProcessing = false;
            StateHasChanged();
            return;
        }

        try
        {
            _validatedInvite = await InviteService.ValidateTokenAsync(Token);
            if (_validatedInvite == null)
            {
                _error = "The provided setup token is invalid, expired, or has already been used.";
                _isProcessing = false;
                StateHasChanged();
                return;
            }

            if (IsStation && !_stationConfirmed)
            {
                // Auto-fill the name if the admin pre-named it (and it's not the generic "Station" mode name)
                if (string.IsNullOrEmpty(_stationName) && !string.IsNullOrEmpty(_validatedInvite.TargetDeviceName) && _validatedInvite.TargetDeviceName != "Station")
                {
                    _stationName = _validatedInvite.TargetDeviceName;
                }

                // Stop here and ask for name in the UI
                _isProcessing = false;
                StateHasChanged();
                return;
            }

            // [SECURITY] If this invite is bound to a specific station, verify we are ON that station
            if (_validatedInvite.TargetStationId.HasValue)
            {
                // [FIX] Use robust window.getCookie helper
                var currentToken = await JSRuntime.InvokeAsync<string>("window.getCookie", "GFC_StationIdentity");
                if (string.IsNullOrEmpty(currentToken))
                {
                    currentToken = await JSRuntime.InvokeAsync<string>("window.getCookie", "GFC_DeviceTrustToken");
                }
                if (string.IsNullOrEmpty(currentToken))
                {
                    currentToken = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "gfc_device_token");
                }
                
                var currentDevice = await TrustService.GetDeviceByTokenAsync(currentToken);
                
                if (currentDevice == null || !currentDevice.IsStation || currentDevice.Id != _validatedInvite.TargetStationId.Value)
                {
                    _error = $"This setup code is restricted to the station '{_validatedInvite.TargetDeviceName ?? "a specific station"}'. Please use the correct terminal.";
                    _isProcessing = false;
                    StateHasChanged();
                    return;
                }
            }

            // Create actual Device Trust Token
            var userAgent = await JSRuntime.InvokeAsync<string>("eval", "navigator.userAgent");
            var ipAddress = "detected-at-auth"; // Will be updated during first login or via middleware
            
            var duration = await SettingsService.GetTrustedDeviceDurationDaysAsync();

            string trustToken;
            bool forceStationMode = IsStation || (_validatedInvite?.TargetStationId.HasValue ?? false);

            if (forceStationMode)
            {
                trustToken = await TrustService.CreateStationTokenAsync(_validatedInvite!.UserId, userAgent, ipAddress, 365, _stationName);
                // Save Station Identity cookie to disable auto-logins
                await JSRuntime.InvokeVoidAsync("window.setCookie", "GFC_StationIdentity", trustToken, 365);
                IsStation = true; // Ensure local flag is set for redirection later
            }
            else
            {
                trustToken = await TrustService.CreateDeviceTokenAsync(_validatedInvite!.UserId, userAgent, ipAddress, duration);
                
                // [CRITICAL FIX] Avoid wiping the workstation identity when users simply set up their PINs on a workstation.
                // If it's a station-bound invite, or if the device already has a GFC_StationIdentity, we MUST retain it.
                var existingStationToken = await JSRuntime.InvokeAsync<string>("window.getCookie", "GFC_StationIdentity");
                if (string.IsNullOrEmpty(existingStationToken))
                {
                    // Safe to clear only if this was never a station to begin with.
                    await JSRuntime.InvokeVoidAsync("window.setCookie", "GFC_StationIdentity", "", -1);
                }
            }

            // Save to LocalStorage and Cookies
            await JSRuntime.InvokeVoidAsync("localStorage.setItem", "gfc_device_token", trustToken);
            await JSRuntime.InvokeVoidAsync("window.setCookie", "GFC_DeviceTrustToken", trustToken, duration);

            // Mark invite as used
            await InviteService.MarkTokenAsUsedAsync(Token);

            _onboardedUserId = _validatedInvite.UserId;
            
            // Pre-fetch VAPID key
            var settings = await BlazorSettingsService.GetAsync();
            _vapidKey = settings.VapidPublicKey;
            
            _success = true;
        }
        catch (Exception ex)
        {
            _error = $"An internal error occurred: {ex.Message}";
        }
        finally
        {
            _isProcessing = false;
            StateHasChanged();
        }
    }

    private async Task ConfirmStationSetup()
    {
        if (string.IsNullOrWhiteSpace(_stationName)) return;
        
        _stationConfirmed = true;
        _isProcessing = true;
        StateHasChanged();
        
        await ProcessToken();
    }

    private bool _isNavigating = false;

    private async Task GoToLogin()
    {
        if (_isNavigating) return;
        _isNavigating = true;
        _error = null;
        StateHasChanged();

        try 
        {
            if (_onboardedUserId > 0)
            {
                // Force log them in so they can complete the wizard seamlessly.
                // This builds the Identity inside the current Blazor Circuit so we don't drop it.
                await AuthStateProvider.LoginWithUserAsync(_onboardedUserId);
            }

            // [CRITICAL FIX] Send them directly to the wizard using soft navigation (forceLoad: false).
            // A hard reload (forceLoad: true) would drop the Blazor Circuit. On mobile/embedded browsers (QR scanners), 
            // cookies can be delayed or blocked, causing auto-login to fail and dumping the user on the Login UI.
            var wizardUrl = "/setup/wizard?setup=enroll";
            if (IsStation) wizardUrl += "&station=true";
            
            NavigationManager.NavigateTo(wizardUrl, false);
        }
        catch (Exception ex)
        {
            _error = "Navigation error: " + ex.Message;
            _isNavigating = false;
            StateHasChanged();
        }
    }
}
