@page "/setup/wizard"
@using GFC.BlazorServer.Services
@using GFC.Core.Interfaces
@using Microsoft.AspNetCore.Authorization
@attribute [AllowAnonymous]
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject CustomAuthenticationStateProvider AuthStateProvider
@inject IPasskeyService PasskeyService
@inject INotificationService NotificationService
@inject IBlazorSystemSettingsService SystemSettingsService
@inject IUserManagementService UserService
@inject IUserConnectionService UserConnectionService
@inject ILogger<DeviceWizard> Logger

<PageTitle>Complete Device Setup - GFC</PageTitle>

<div class="wizard-container">
    <div class="wizard-card" style="max-width: @(CurrentStep == 5 ? "600px" : "480px")">
        @if (CurrentStep < 5)
        {
            <div class="wizard-header">
                <div class="step-indicator">
                    <div class="step @(CurrentStep >= 1 ? "active" : "")">1</div>
                    <div class="step-line @(CurrentStep >= 2 ? "active" : "")"></div>
                    <div class="step @(CurrentStep >= 2 ? "active" : "")">2</div>
                    <div class="step-line @(CurrentStep >= 3 ? "active" : "")"></div>
                    <div class="step @(CurrentStep >= 3 ? "active" : "")">3</div>
                    @if (UserConnectionService.IsMobile)
                    {
                        <div class="step-line @(CurrentStep >= 4 ? "active" : "")"></div>
                        <div class="step @(CurrentStep >= 4 ? "active" : "")">4</div>
                    }
                </div>
                <h1 class="wizard-title mt-4">@CurrentStepTitle</h1>
                <p class="wizard-subtitle">@CurrentStepSubtitle</p>
            </div>
        }

        <div class="wizard-body">
            @if (CurrentStep == 1)
            {
                <div class="step-content text-center">
                    <div class="setup-icon-wrapper pulse passcode">
                        <i class="bi bi-grid-3x3-gap-fill"></i>
                    </div>
                    <h3 class="fw-bold mb-3">Login Passcode</h3>
                    <p class="text-muted mb-4">
                        Set a 6-digit passcode for quick mobile login. 
                        This acts as your secondary authentication on this device, used if biometrics fail.
                    </p>
                    
                    <div class="passcode-input-container mb-4">
                        <input type="tel" 
                               class="form-control text-center fs-1 fw-bold rounded-4 py-3" 
                               maxlength="6" 
                               placeholder="000000"
                               @bind="_passcode"
                               inputmode="numeric" />
                    </div>

                    @if (!string.IsNullOrEmpty(_passcodeError))
                    {
                        <div class="alert alert-danger rounded-4 py-2 mb-3">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>@_passcodeError
                        </div>
                    }

                    <button class="btn btn-primary btn-lg w-100 rounded-pill py-3 fw-bold shadow mb-3" 
                            @onclick="SavePasscode" 
                            disabled="@_isProcessing">
                        @if (_isProcessing) { <span class="spinner-border spinner-border-sm me-2"></span> }
                        <i class="bi bi-shield-lock-fill me-2"></i>Save & Continue
                    </button>
                    
                    <div class="small text-muted text-center pt-2">
                        <i class="bi bi-shield-check me-1"></i>
                        Secure fallback method
                    </div>
                </div>
            }
            else if (CurrentStep == 2)
            {
                <div class="step-content text-center">
                    <div class="setup-icon-wrapper pulse biometrics">
                        <i class="bi bi-fingerprint"></i>
                    </div>
                    <h3 class="fw-bold mb-3">Biometric Access</h3>
                    <p class="text-muted mb-4">
                        Enable FaceID, TouchID, or your device's secure lock. 
                        This binds this specific device to your account for even faster access.
                    </p>
                    
                    @if (!string.IsNullOrEmpty(_passkeyError))
                    {
                        <div class="alert alert-danger rounded-4 py-3 mb-4 text-start">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>@_passkeyError
                        </div>
                    }

                    <button class="btn btn-primary btn-lg w-100 rounded-pill py-3 fw-bold shadow mb-3" 
                            @onclick="RegisterPasskey" 
                            disabled="@_isProcessing">
                        @if (_isProcessing) { <span class="spinner-border spinner-border-sm me-2"></span> }
                        <i class="bi bi-shield-check me-2"></i>Enable Secure Access
                    </button>
                    
                    <button class="btn btn-outline-secondary w-100 rounded-pill py-2" @onclick="NextStep">
                        <i class="bi bi-skip-forward me-2"></i>Skip for Now
                    </button>
                    
                    <div class="small text-muted text-center mt-3">
                        <i class="bi bi-info-circle me-1"></i>
                        Recommended for the best experience
                    </div>
                </div>
            }
            else if (CurrentStep == 3)
            {
                <div class="step-content text-center">
                    <div class="setup-icon-wrapper pwa">
                        <i class="bi @(UserConnectionService.IsMobile ? "bi-phone-vibrate" : "bi-laptop")"></i>
                    </div>
                    <h3 class="fw-bold mb-3">@(UserConnectionService.IsMobile ? "Install GFC App" : "Website Shortcut")</h3>
                    <p class="text-muted mb-4">
                        @(UserConnectionService.IsMobile 
                            ? "Add GFC to your home screen for an \"App-like\" experience. It works faster and keeps you securely connected."
                            : "Create a shortcut on your desktop or bookmark this page for instant access to the GFC portal."
                        )
                    </p>

                    @if (_canInstall)
                    {
                        <button class="btn btn-primary btn-lg w-100 rounded-pill py-3 fw-bold shadow mb-3" @onclick="TriggerPwaInstall">
                            <i class="bi bi-plus-circle-fill me-2"></i>@(UserConnectionService.IsMobile ? "Install App Now" : "Install to Desktop")
                        </button>
                    }
                    else if (!string.IsNullOrEmpty(_platformInstructions))
                    {
                        <div class="p-3 bg-light rounded-4 text-start border mb-3">
                            <h6 class="fw-bold small mb-2"><i class="bi bi-info-circle me-1"></i> iPhone/Safari Instructions:</h6>
                            <div class="small text-muted">@((MarkupString)_platformInstructions)</div>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info small py-2">
                            Our system detects this device already has the app or doesn't support direct installation.
                        </div>
                    }

                    <button class="btn btn-outline-primary w-100 rounded-pill py-2" @onclick="NextStep">Continue</button>
                </div>
            }
            else if (CurrentStep == 4)
            {
                <div class="step-content text-center">
                    <div class="setup-icon-wrapper @(_isSubscribed ? "success" : "bell")">
                        <i class="bi @(_isSubscribed ? "bi-check-all" : "bi-bell-fill")"></i>
                    </div>
                    <h3 class="fw-bold mb-3">Push Notifications</h3>
                    <p class="text-muted mb-4">
                        Stay informed about system access, security alerts, and important updates.
                    </p>

                    @if (_isSubscribed)
                    {
                        <div class="alert alert-success rounded-pill py-3 mb-4">
                            <i class="bi bi-check-circle-fill me-2"></i>Notifications Enabled
                        </div>
                        <button class="btn btn-primary btn-lg w-100 rounded-pill py-3 fw-bold shadow" @onclick="NextStep">
                            <i class="bi bi-arrow-right-circle-fill me-2"></i>Almost Done
                        </button>
                    }
                    else
                    {
                        <button class="btn btn-primary btn-lg w-100 rounded-pill py-3 fw-bold shadow mb-3" @onclick="EnableNotifications" disabled="@_isProcessing">
                            @if (_isProcessing) { <span class="spinner-border spinner-border-sm me-2"></span> }
                            <i class="bi bi-bell-fill me-2"></i>Enable Notifications
                        </button>
                        
                        <button class="btn btn-outline-secondary w-100 rounded-pill py-2" @onclick="NextStep">
                            <i class="bi bi-skip-forward me-2"></i>Skip for Now
                        </button>
                    }
                </div>
            }
            else if (CurrentStep == 5)
            {
                <div class="step-content text-center py-4">
                    <div class="success-checkmark mb-4">
                        <div class="check-icon">
                            <span class="icon-line line-tip"></span>
                            <span class="icon-line line-long"></span>
                            <div class="icon-circle"></div>
                            <div class="icon-fix"></div>
                        </div>
                    </div>
                    
                    <h2 class="fw-extrabold mb-3">Setup Complete!</h2>
                    <p class="text-muted mb-5 px-3">
                        Your device is now securely linked and configured. 
                        Welcome to the GFC Membership System.
                    </p>

                    <a href="@(UserConnectionService.IsMobile ? "/mobile" : "/")" class="btn btn-primary btn-lg w-100 rounded-pill py-3 fw-bold shadow-lg">
                        <i class="bi bi-house-door-fill me-2"></i>Go to Dashboard
                    </a>
                    
                    <div class="mt-4 pt-4 border-top">
                        <div class="row g-2">
                            <div class="col-6">
                                <div class="p-2 rounded-3 bg-light">
                                    <div class="small fw-bold">Passcode</div>
                                    <div class="text-success small"><i class="bi bi-check-circle-fill me-1"></i>Active</div>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="p-2 rounded-3 bg-light">
                                    <div class="small fw-bold">Device Access</div>
                                    <div class="text-success small"><i class="bi bi-check-circle-fill me-1"></i>Ready</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<style>
    .wizard-container {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 100vh;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        padding: 1.5rem;
    }

    .wizard-card {
        background: rgba(255, 255, 255, 0.98);
        width: 100%;
        max-width: 480px;
        padding: 2.5rem;
        border-radius: 2rem;
        box-shadow: 0 40px 100px -20px rgba(0,0,0,0.5);
        transition: max-width 0.4s ease;
    }

    .step-indicator {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.35rem;
    }

    .step {
        width: 32px;
        height: 32px;
        background: #e2e8f0;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        color: #64748b;
        transition: all 0.3s ease;
        font-size: 0.9rem;
    }

    .step.active {
        background: #4f46e5;
        color: white;
        box-shadow: 0 0 15px rgba(79, 70, 229, 0.4);
    }

    .step-line {
        height: 3px;
        width: 30px;
        background: #e2e8f0;
        border-radius: 2px;
    }

    .step-line.active {
        background: #4f46e5;
    }

    .wizard-title {
        color: #1e293b;
        font-weight: 800;
        font-size: 1.6rem;
        text-align: center;
        margin-bottom: 0.5rem;
    }

    .wizard-subtitle {
        color: #64748b;
        text-align: center;
        font-size: 0.95rem;
    }

    .setup-icon-wrapper {
        width: 90px;
        height: 90px;
        background: #f1f5f9;
        border-radius: 2.25rem;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 1.5rem auto;
        font-size: 2.75rem;
        color: #4f46e5;
    }

    .setup-icon-wrapper.passcode { color: #8b5cf6; background: #ede9fe; }
    .setup-icon-wrapper.biometrics { color: #3b82f6; background: #eff6ff; }
    .setup-icon-wrapper.pwa { color: #ec4899; background: #fdf2f8; }
    .setup-icon-wrapper.bell { color: #f59e0b; background: #fffbeb; }

    .setup-icon-wrapper.success {
        background: #dcfce7;
        color: #16a34a;
    }

    .pulse {
        animation: pulse-animation 2s infinite;
    }

    @@keyframes pulse-animation {
        0% { box-shadow: 0 0 0 0px rgba(79, 70, 229, 0.4); }
        70% { box-shadow: 0 0 0 20px rgba(79, 70, 229, 0); }
        100% { box-shadow: 0 0 0 0px rgba(79, 70, 229, 0); }
    }

    /* Success Checkmark Animation */
    .success-checkmark {
        width: 80px;
        height: 80px;
        margin: 0 auto;
    }
    
    .check-icon {
        width: 80px;
        height: 80px;
        position: relative;
        border-radius: 50%;
        box-sizing: content-box;
        border: 4px solid #4CAF50;
    }
    
    .check-icon::before {
        top: 3px;
        left: -2px;
        width: 30px;
        transform-origin: 100% 50%;
        border-radius: 100px 0 0 100px;
    }
    
    .check-icon::after {
        top: 0;
        left: 30px;
        width: 60px;
        transform-origin: 0 50%;
        border-radius: 0 100px 100px 0;
        animation: rotate-circle 4.25s ease-in;
    }
    
    .icon-line {
        height: 5px;
        background-color: #4CAF50;
        display: block;
        border-radius: 2px;
        position: absolute;
        z-index: 10;
    }
    
    .line-tip {
        top: 46px;
        left: 14px;
        width: 25px;
        transform: rotate(45deg);
        animation: icon-line-tip 0.75s;
    }
    
    .line-long {
        top: 38px;
        right: 8px;
        width: 47px;
        transform: rotate(-45deg);
        animation: icon-line-long 0.75s;
    }
    
    .icon-circle {
        top: -4px;
        left: -4px;
        z-index: 10;
        width: 80px;
        height: 80px;
        border-radius: 50%;
        border: 4px solid rgba(76, 175, 80, .5);
        box-sizing: content-box;
        position: absolute;
    }
    
    .icon-fix {
        top: 8px;
        width: 5px;
        left: 26px;
        z-index: 1;
        height: 85px;
        position: absolute;
        transform: rotate(-45deg);
    }
    
    @@keyframes rotate-circle {
        0% { transform: rotate(-45deg); }
        5% { transform: rotate(-45deg); }
        12% { transform: rotate(-405deg); }
        100% { transform: rotate(-405deg); }
    }
    
    @@keyframes icon-line-tip {
        0% { width: 0; left: 1px; top: 19px; }
        54% { width: 0; left: 1px; top: 19px; }
        70% { width: 50px; left: -8px; top: 37px; }
        84% { width: 17px; left: 21px; top: 48px; }
        100% { width: 25px; left: 14px; top: 46px; }
    }
    
    @@keyframes icon-line-long {
        0% { width: 0; right: 46px; top: 54px; }
        65% { width: 0; right: 46px; top: 54px; }
        84% { width: 55px; right: 0px; top: 35px; }
        100% { width: 47px; right: 8px; top: 38px; }
    }
</style>

@code {
    private int CurrentStep = 1;

    private bool _isProcessing = false;
    private string? _passkeyError;
    private string? _passcode;
    private string? _passcodeError;
    private bool _canInstall = false;
    private string? _platformInstructions;
    private bool _isSubscribed = false;

    private string CurrentStepTitle => CurrentStep switch {
        1 => "Access Passcode",
        2 => "Security Binding",
        3 => "App Shortcut",
        4 => "Alert Details",
        _ => "Setup Complete"
    };

    private string CurrentStepSubtitle => CurrentStep switch {
        1 => "Set your 6-digit login PIN",
        2 => "Link device biometrics for speed",
        3 => UserConnectionService.IsMobile ? "Install GFC to your home screen" : "Bookmark GFC for instant access",
        4 => "Stay updated with real-time push",
        _ => ""
    };

    protected override async Task OnInitializedAsync()
    {
        // 1. Give the circuit a tiny moment (Reduced from 500ms to 100ms for responsiveness)
        await Task.Delay(100);

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var principal = authState.User;
        
        // [DIAGNOSTIC] Log who is being processed BEFORE any other logic
        var diagUserId = principal.FindFirst("UserId")?.Value ?? principal.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "UNKNOWN";
        var diagUsername = principal.Identity?.Name ?? "UNKNOWN";
        Logger.LogWarning("=== WIZARD START === User: {Username}, ID: {UserId}, IsAuth: {IsAuth}", 
            diagUsername, diagUserId, principal.Identity?.IsAuthenticated ?? false);

        // [FIX] Verify authentication with fail-fast short circuit.
        // Since we are now AllowAnonymous, we handle the security check here manually.
        if (!principal.Identity?.IsAuthenticated ?? true)
        {
            Logger.LogWarning("Wizard initialization reached without authenticated principal. Attempting one-time refresh.");
            
            // Capture current params to pass through
            var uri = new Uri(Navigation.Uri);
            var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
            var t = query["t"];
            var pendingUrl = $"/setup/pending-auth?t={t}";

            // Try refresh with a strict 3-second timeout to avoid 2-minute hangs
            var refreshTask = AuthStateProvider.RefreshUserAsync();
            if (await Task.WhenAny(refreshTask, Task.Delay(3000)) == refreshTask)
            {
                await refreshTask; 
            }
            else 
            {
                Logger.LogWarning("RefreshUserAsync timed out. Redirecting to Pending Auth to break hang.");
                Navigation.NavigateTo(pendingUrl, false);
                return;
            }

            authState = await AuthStateProvider.GetAuthenticationStateAsync();
            principal = authState.User;

            if (!principal.Identity?.IsAuthenticated ?? true)
            {
                Logger.LogWarning("Authentication failed after refresh. Failing fast to broken circuit handler.");
                Navigation.NavigateTo(pendingUrl, false);
                return;
            }
        }

        // [FIX] Use robust ID detection
        var userIdStr = principal.FindFirst("UserId")?.Value ?? 
                         principal.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        
        if (int.TryParse(userIdStr, out int userId))
        {
            // [FIX] Force fresh fetch from DB to avoid any scoped/cached state issues
            var user = await UserService.GetUserAsync(userId);
            if (user != null)
            {
                var hasStalePasscode = !string.IsNullOrWhiteSpace(user.PassCodeHash);
                
                Logger.LogInformation("WIZARD DIAGNOSTIC: User={Username} (ID={Id}), HasPasscode={HasPass}, HashLen={HashLen}", 
                    user.Username, userId, hasStalePasscode, user.PassCodeHash?.Length ?? 0);

                // [FIX] Source of Truth: If a passcode exists in the DB, skip Step 1.
                // We don't force Step 1 based on URL params anymore, respecting the user's previously set security.
                if (hasStalePasscode)
                {
                    CurrentStep = 2;
                    Logger.LogInformation("Existing passcode detected for user {UserId}. Skipping Step 1.", userId);
                }
                else
                {
                    CurrentStep = 1;
                    Logger.LogInformation("No passcode detected for user {UserId}. Starting at Step 1.", userId);
                }
                
                // [FIX] Force immediate draw for mobile
                StateHasChanged(); 
            }
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await CheckPwaInstallability();
        }
    }

    private async Task NextStep() 
    {
        // [FIX] Safety Check: Before finishing (entering Step 5), verify Passcode is set
        if (CurrentStep == 4 || (CurrentStep == 3 && !UserConnectionService.IsMobile))
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var principal = authState.User;
            var userIdStr = principal.FindFirst("UserId")?.Value ?? 
                             principal.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
            
            if (int.TryParse(userIdStr, out int userId))
            {
                var user = await UserService.GetUserAsync(userId);
                if (user != null && string.IsNullOrWhiteSpace(user.PassCodeHash))
                {
                    // WHOOPS! No passcode set. Force them back to Step 1.
                    CurrentStep = 1;
                    _passcodeError = "A passcode is required to complete setup.";
                    StateHasChanged();
                    return;
                }
            }
        }

        // Branching for Laptop vs Mobile
        if (CurrentStep == 3 && !UserConnectionService.IsMobile)
        {
            CurrentStep = 5; // Skip Push Notifications (Step 4) on laptops
        }
        else
        {
            CurrentStep++;
        }
        
        StateHasChanged();
    }

    private async Task SavePasscode()
    {
        _passcodeError = null;
        if (string.IsNullOrWhiteSpace(_passcode) || _passcode.Length != 6 || !_passcode.All(char.IsDigit))
        {
            _passcodeError = "Passcode must be exactly 6 digits.";
            return;
        }

        _isProcessing = true;
        StateHasChanged();

        try
        {
            var user = AuthStateProvider.GetCurrentUser();
            if (user != null)
            {
                UserService.ChangePassCode(user.UserId, _passcode, true, user.UserId);
                
                // [FIX] Crucial: Refresh the local authentication state so IsAuthenticated/PasswordChangeRequired are correct
                await AuthStateProvider.RefreshUserAsync();
                
                Logger.LogInformation("Passcode updated for user {UserId} via wizard", user.UserId);
                NextStep();
            }
            else
            {
                _passcodeError = "Session lost. Please log in again.";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error saving passcode");
            _passcodeError = ex.Message;
        }
        finally
        {
            _isProcessing = false;
            StateHasChanged();
        }
    }

    private async Task RegisterPasskey()
    {
        _isProcessing = true;
        _passkeyError = null;
        StateHasChanged();

        try
        {
            var user = AuthStateProvider.GetCurrentUser();
            if (user == null) 
            {
                _passkeyError = "User session not found. Please log in again.";
                return;
            }

            // 1. Request options from server
            var options = await PasskeyService.RequestRegistrationOptionsAsync(user.UserId, user.Username);
            Logger.LogInformation("Passkey registration options generated for user {UserId}", user.UserId);
            
            // 2. Trigger browser WebAuthn API
            var responseJson = await JS.InvokeAsync<string>("GFC_Passkeys.register", options);
            Logger.LogInformation("Browser WebAuthn response received: {Length} chars", responseJson?.Length ?? 0);
            
            if (string.IsNullOrEmpty(responseJson))
            {
                _passkeyError = "No response from biometric scanner. Please try again.";
                return;
            }
            
            // 3. Complete registration on server
            using var doc = System.Text.Json.JsonDocument.Parse(responseJson);
            var root = doc.RootElement;
            var credentialId = root.GetProperty("id").GetString()!;
            var publicKey = root.GetProperty("response").GetProperty("attestationObject").GetString()!;
            
            Logger.LogInformation("Completing passkey registration with credentialId: {CredentialId}", credentialId);
            var success = await PasskeyService.CompleteRegistrationAsync(user.UserId, credentialId, publicKey, $"Device: {user.Username} Setup");

            if (success)
            {
                Logger.LogInformation("Passkey registration successful for user {UserId}", user.UserId);
                NextStep();
            }
            else
            {
                _passkeyError = "Failed to save security key to database. Please contact support.";
                Logger.LogWarning("Passkey registration returned false for user {UserId}", user.UserId);
            }
        }
        catch (System.Text.Json.JsonException jsonEx)
        {
            Logger.LogError(jsonEx, "JSON parsing error during passkey setup");
            _passkeyError = "Invalid response from biometric scanner. Please try again.";
        }
        catch (JSException jsEx)
        {
            Logger.LogError(jsEx, "JavaScript error during passkey setup");
            _passkeyError = $"Browser error: {jsEx.Message}. Your device may not support this feature.";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Passkey setup error");
            _passkeyError = $"Security binding failed: {ex.Message}";
        }
        finally
        {
            _isProcessing = false;
            StateHasChanged();
        }
    }

    private async Task CheckPwaInstallability()
    {
        try 
        {
            var result = await JS.InvokeAsync<PwaCheckResult>("pwaInstaller.checkInstallability");
            if (result != null)
            {
                _canInstall = result.CanInstall;
                _platformInstructions = result.Instructions;
                StateHasChanged();
            }
        }
        catch { }
    }

    private async Task TriggerPwaInstall()
    {
        try { await JS.InvokeAsync<bool>("pwaInstaller.install"); } catch { }
        NextStep();
    }

    private async Task EnableNotifications()
    {
        _isProcessing = true;
        StateHasChanged();

        try
        {
            var user = AuthStateProvider.GetCurrentUser();
            if (user == null) 
            {
                NextStep();
                return;
            }

            var permission = await JS.InvokeAsync<string>("GFC_Notifications.requestPermission");
            if (permission == "granted")
            {
                var settings = await SystemSettingsService.GetAsync();
                if (!string.IsNullOrEmpty(settings.VapidPublicKey))
                {
                    var subJson = await JS.InvokeAsync<string>("GFC_Notifications.subscribe", settings.VapidPublicKey);
                    using var doc = System.Text.Json.JsonDocument.Parse(subJson);
                    var payload = doc.RootElement;
                    
                    await NotificationService.SubscribeToPushAsync(
                        user.UserId, 
                        payload.GetProperty("endpoint").GetString()!,
                        payload.GetProperty("keys").GetProperty("p256dh").GetString()!,
                        payload.GetProperty("keys").GetProperty("auth").GetString()!,
                        "GFC Device Wizard"
                    );
                    
                    _isSubscribed = true;
                    _isProcessing = false;
                    StateHasChanged(); 
                }
                else
                {
                    // No VAPID key configured, skip notifications
                    NextStep();
                }
            }
            else
            {
                // User denied permission
                NextStep();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Notification setup error");
            NextStep();
        }
        finally
        {
            _isProcessing = false;
            StateHasChanged();
        }
    }

    private void FinishWizard()
    {
        // [FIX] Redirect directly to the Mobile Hub if on mobile to prevent "flashing" the desktop dashboard
        var destination = UserConnectionService.IsMobile ? "/mobile" : "/";
        Navigation.NavigateTo(destination, true);
    }

    public class PwaCheckResult {
        public bool CanInstall { get; set; }
        public string? Instructions { get; set; }
    }
}
