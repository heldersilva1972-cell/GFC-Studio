    };

    private string CurrentStepSubtitle => CurrentStep switch {
        1 => "Set your 6-digit login PIN",
        2 => "Link device biometrics for speed",
        3 => UserConnectionService.IsMobile ? "Install GFC App to your device" : "Bookmark GFC for instant access",
        4 => "Stay updated with real-time push",
        _ => ""
    };

    protected override async Task OnInitializedAsync()
    {
        // Pre-fetch VAPID key for native binding
        var settings = await SystemSettingsService.GetAsync();
        _vapidKey = settings.VapidPublicKey;

        // 1. Give the circuit a tiny moment (Reduced from 500ms to 100ms for responsiveness)
        await Task.Delay(100);

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var principal = authState.User;
        
        // [DIAGNOSTIC] Log who is being processed BEFORE any other logic
        var diagUserId = principal.FindFirst("UserId")?.Value ?? principal.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "UNKNOWN";
        var diagUsername = principal.Identity?.Name ?? "UNKNOWN";
        Logger.LogWarning("=== WIZARD START === User: {Username}, ID: {UserId}, IsAuth: {IsAuth}", 
            diagUsername, diagUserId, principal.Identity?.IsAuthenticated ?? false);

        // [FIX] Verify authentication with fail-fast short circuit.
        // Since we are now AllowAnonymous, we handle the security check here manually.
        if (!principal.Identity?.IsAuthenticated ?? true)
        {
            Logger.LogWarning("Wizard initialization reached without authenticated principal. Attempting one-time refresh.");
            
            // Capture current params to pass through
            var uri = new Uri(Navigation.Uri);
            var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
            var t = query["t"];
            var pendingUrl = $"/setup/pending-auth?t={t}";

            // Try refresh with a strict 3-second timeout to avoid 2-minute hangs
            var refreshTask = AuthStateProvider.RefreshUserAsync();
            if (await Task.WhenAny(refreshTask, Task.Delay(3000)) == refreshTask)
            {
                await refreshTask; 
            }
            else 
            {
                Logger.LogWarning("RefreshUserAsync timed out. Redirecting to Pending Auth to break hang.");
                Navigation.NavigateTo(pendingUrl, false);
                return;
            }

            authState = await AuthStateProvider.GetAuthenticationStateAsync();
            principal = authState.User;

            if (!principal.Identity?.IsAuthenticated ?? true)
            {
                Logger.LogWarning("Authentication failed after refresh. Failing fast to broken circuit handler.");
                Navigation.NavigateTo(pendingUrl, false);
                return;
            }
        }

        // [FIX] Use robust ID detection
        var userIdStr = principal.FindFirst("UserId")?.Value ?? 
                         principal.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        
        if (int.TryParse(userIdStr, out int userId))
        {
            // [FIX] Force fresh fetch from DB to avoid any scoped/cached state issues
            var user = await UserService.GetUserAsync(userId);
            if (user != null)
            {
                var hasStalePasscode = !string.IsNullOrWhiteSpace(user.PassCodeHash);
                
                Logger.LogInformation("WIZARD DIAGNOSTIC: User={Username} (ID={Id}), HasPasscode={HasPass}, HashLen={HashLen}", 
                    user.Username, userId, hasStalePasscode, user.PassCodeHash?.Length ?? 0);

                // [FIX] Source of Truth: If a passcode exists in the DB, skip Step 1.
                // We don't force Step 1 based on URL params anymore, respecting the user's previously set security.
                if (hasStalePasscode)
                {
                    CurrentStep = 2;
                    Logger.LogInformation("Existing passcode detected for user {UserId}. Skipping Step 1.", userId);
                }
                else
                {
                    CurrentStep = 1;
                    Logger.LogInformation("No passcode detected for user {UserId}. Starting at Step 1.", userId);
                }
                
                // [FIX] Force immediate draw for mobile
                StateHasChanged(); 
            }
        }
    }



    
    // [FIX] Separate Health Check from step transitions
    private async Task RunHealthCheck()
    {
        await Task.Delay(500); // UI Render
        _healthCheckError = null;
        _pwaHealthStatus = "SCANNING";
        StateHasChanged();

        try
        {
            var checkResults = await JS.InvokeAsync<List<PwaCheck>>("GFC.runPwaHealthCheck");
            await InvokeAsync(() => {
                _pwaChecks = checkResults;
                if (checkResults.Any(c => c.Status != 200 && c.Status != 100))
                {
                    _pwaHealthStatus = "ISSUES FOUND";
                    _showDebugDetails = true; // Auto-open if issues found

                    // Fetch the detailed error message if it was captured
                    var lastErrCheck = checkResults.FirstOrDefault(c => c.Name == "Last Error (H)");
                    if (lastErrCheck != null)
                    {
                        Task.Run(async () => {
                            var detailedError = await JS.InvokeAsync<string>("eval", "window._gfcLastNotifError");
                            await InvokeAsync(() => {
                                _healthCheckError = "Push Error: " + detailedError;
                                StateHasChanged();
                            });
                        });
                    }
                }
                else
                {
                    _pwaHealthStatus = "OK";
                }
                StateHasChanged();
            });
        }
        catch (Exception ex)
        {
            Logger.LogWarning("PWA Health Check returned error: {Message}", ex.Message);
            await InvokeAsync(() => {
                    _pwaHealthStatus = "CHECK FAILED";
                    _healthCheckError = ex.Message;
                    _showDebugDetails = true;
                    StateHasChanged();
            });
        }
    }

    private async Task NextStep() 
    {
        // [FIX] Auto-trigger PWA install when entering Step 3
        if (CurrentStep == 2)
        {
            CurrentStep = 3;
            StateHasChanged();
            
            currentCheckTask = Task.Run(async () =>
            {
                // Health Check already runs on load, but we can re-run or just proceed
                
                // 2. Trigger Install
                try 
                {
                    await Task.Delay(500);
                    await JS.InvokeAsync<bool>("GFC.triggerInstall"); 
                } 
                catch { }
                
                // Auto-advance
                await Task.Delay(4000); 
                await InvokeAsync(() =>
                {
                    if (CurrentStep == 3) // Only advance if still on step 3
                    {
                        CurrentStep++;
                        StateHasChanged();
                    }
                });
            });
            return;
        }
        
        // [FIX] Safety Check: Before finishing (entering Step 5), verify Passcode is set
        if (CurrentStep == 4 || (CurrentStep == 3 && !UserConnectionService.IsMobile))
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var principal = authState.User;
            var userIdStr = principal.FindFirst("UserId")?.Value ?? 
                             principal.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
            
            if (int.TryParse(userIdStr, out int userId))
            {
                var user = await UserService.GetUserAsync(userId);
                if (user != null && string.IsNullOrWhiteSpace(user.PassCodeHash))
                {
                    // WHOOPS! No passcode set. Force them back to Step 1.
                    CurrentStep = 1;
                    _passcodeError = "A passcode is required to complete setup.";
                    StateHasChanged();
                    return;
                }
            }
        }

        // Branching for Laptop vs Mobile
        if (CurrentStep == 3 && !UserConnectionService.IsMobile)
        {
            CurrentStep = 5; // Skip Push Notifications (Step 4) on laptops
        }
        else
        {
            CurrentStep++;
            _isProcessing = false; // Reset any previous step processing
            StateHasChanged();
        }
        
        StateHasChanged();
    }

    private async Task SavePasscode()
    {
        _passcodeError = null;
        if (string.IsNullOrWhiteSpace(_passcode) || _passcode.Length != 6 || !_passcode.All(char.IsDigit))
        {
            _passcodeError = "Passcode must be exactly 6 digits.";
            return;
        }

        _isProcessing = true;
        StateHasChanged();

        try
        {
            var user = AuthStateProvider.GetCurrentUser();
            if (user != null)
            {
                UserService.ChangePassCode(user.UserId, _passcode, true, user.UserId);
                
                // [FIX] Crucial: Refresh the local authentication state so IsAuthenticated/PasswordChangeRequired are correct
                await AuthStateProvider.RefreshUserAsync();
                
                Logger.LogInformation("Passcode updated for user {UserId} via wizard", user.UserId);
                NextStep();
            }
            else
            {
                _passcodeError = "Session lost. Please log in again.";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error saving passcode");
            _passcodeError = ex.Message;
        }
        finally
        {
            _isProcessing = false;
            StateHasChanged();
        }
    }

    private async Task RegisterPasskey()
    {
        _isProcessing = true;
        _passkeyError = null;
        StateHasChanged();

        try
        {
            var user = AuthStateProvider.GetCurrentUser();
            if (user == null) 
            {
                _passkeyError = "User session not found. Please log in again.";
                return;
            }

            // 1. Request options from server
            var options = await PasskeyService.RequestRegistrationOptionsAsync(user.UserId, user.Username);
            Logger.LogInformation("Passkey registration options generated for user {UserId}", user.UserId);
            
            // 2. Trigger browser WebAuthn API
            var responseJson = await JS.InvokeAsync<string>("GFC_Passkeys.register", options);
            Logger.LogInformation("Browser WebAuthn response received: {Length} chars", responseJson?.Length ?? 0);
            
            if (string.IsNullOrEmpty(responseJson))
            {
                _passkeyError = "No response from biometric scanner. Please try again.";
                return;
            }
            
            // 3. Complete registration on server
            using var doc = System.Text.Json.JsonDocument.Parse(responseJson);
            var root = doc.RootElement;
            var credentialId = root.GetProperty("id").GetString()!;
            var publicKey = root.GetProperty("response").GetProperty("attestationObject").GetString()!;
            
            Logger.LogInformation("Completing passkey registration with credentialId: {CredentialId}", credentialId);
            var success = await PasskeyService.CompleteRegistrationAsync(user.UserId, credentialId, publicKey, $"Device: {user.Username} Setup");

            if (success)
            {
                Logger.LogInformation("Passkey registration successful for user {UserId}", user.UserId);
                NextStep();
            }
            else
            {
                _passkeyError = "Failed to save security key to database. Please contact support.";
                Logger.LogWarning("Passkey registration returned false for user {UserId}", user.UserId);
            }
        }
        catch (System.Text.Json.JsonException jsonEx)
        {
            Logger.LogError(jsonEx, "JSON parsing error during passkey setup");
            _passkeyError = "Invalid response from biometric scanner. Please try again.";
        }
        catch (JSException jsEx)
        {
            Logger.LogError(jsEx, "JavaScript error during passkey setup");
            _passkeyError = $"Browser error: {jsEx.Message}. Your device may not support this feature.";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Passkey setup error");
            _passkeyError = $"Security binding failed: {ex.Message}";
        }
        finally
        {
            _isProcessing = false;
            StateHasChanged();
        }
    }

