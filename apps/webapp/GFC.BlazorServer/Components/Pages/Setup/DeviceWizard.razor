@page "/setup/wizard"
@using GFC.BlazorServer.Services
@using GFC.Core.Interfaces
@using Microsoft.AspNetCore.Authorization
@attribute [AllowAnonymous]
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject CustomAuthenticationStateProvider AuthStateProvider
@inject IPasskeyService PasskeyService
@inject INotificationService NotificationService
@implements IDisposable
@inject IBlazorSystemSettingsService SystemSettingsService
@inject IUserManagementService UserService
@inject IUserConnectionService UserConnectionService
@inject ILogger<DeviceWizard> Logger

<div class="wizard-page">
    <div class="wizard-layout animate-fade-in">
        <div class="wizard-glass-card shadow-premium" style="max-width: @(CurrentStep == 5 ? "600px" : "480px")">
            
            @if (CurrentStep < 5)
            {
                <div class="wizard-header mb-4">
                    <div class="modern-stepper">
                        <div class="step-blob @(CurrentStep >= 1 ? "active" : "")">
                            <span class="step-num">1</span>
                        </div>
                        <div class="connector @(CurrentStep >= 2 ? "active" : "")"></div>
                        <div class="step-blob @(CurrentStep >= 2 ? "active" : "")">
                            <span class="step-num">2</span>
                        </div>
                        <div class="connector @(CurrentStep >= 3 ? "active" : "")"></div>
                        <div class="step-blob @(CurrentStep >= 3 ? "active" : "")">
                            <span class="step-num">3</span>
                        </div>
                        @if (UserConnectionService.IsMobile)
                        {
                            <div class="connector @(CurrentStep >= 4 ? "active" : "")"></div>
                            <div class="step-blob @(CurrentStep >= 4 ? "active" : "")">
                                <span class="step-num">4</span>
                            </div>
                        }
                    </div>
                    <div class="text-center mt-4">
                        <h1 class="h3 fw-bold mb-1">@CurrentStepTitle</h1>
                        <p class="text-muted-light small">@CurrentStepSubtitle</p>
                    </div>
                </div>
            }

            <div class="wizard-content">
                @if (CurrentStep == 1)
                {
                    <div class="step-view text-center animate-slide-up">
                        <div class="premium-orb bg-indigo-soft text-indigo mb-4 mx-auto">
                            <i class="bi bi-grid-3x3-gap-fill"></i>
                        </div>
                        <h4 class="fw-bold mb-3">Quick Access PIN</h4>
                        <p class="text-muted small mb-4 px-3">
                            Establish a 6-digit passcode for immediate authentication. This provides a secure fallback if biometrics are unavailable.
                        </p>
                        
                        <div class="passcode-container mb-4">
                            <input type="tel" 
                                   class="form-control-premium text-center passcode-hero" 
                                   maxlength="6" 
                                   placeholder="0 0 0 0 0 0"
                                   @bind="_passcode"
                                   inputmode="numeric" />
                        </div>

                        @if (!string.IsNullOrEmpty(_passcodeError))
                        {
                            <div class="alert alert-danger-premium mb-4 text-start">
                                <i class="bi bi-exclamation-circle-fill me-2"></i>@_passcodeError
                            </div>
                        }

                        <div class="d-grid gap-3">
                            <button class="btn btn-primary-premium py-3 fw-bold" @onclick="SavePasscode" disabled="@_isProcessing">
                                @if (_isProcessing) { <span class="spinner-border spinner-border-sm me-2"></span> }
                                <i class="bi bi-shield-lock-fill me-2"></i>Initialize PIN
                            </button>
                            
                            @if (!UserConnectionService.IsMobile)
                            {
                                <button class="btn btn-glass-secondary py-2" @onclick="NextStep">
                                    <i class="bi bi-skip-forward me-2"></i>Configure Later
                                </button>
                            }
                        </div>
                    </div>
                }
                else if (CurrentStep == 2)
                {
                    <div class="step-view text-center animate-slide-up">
                        <div class="premium-orb bg-blue-soft text-blue mb-4 mx-auto">
                            <i class="bi bi-fingerprint"></i>
                        </div>
                        <h4 class="fw-bold mb-3">Biometric Link</h4>
                        <p class="text-muted small mb-4 px-3">
                            Connect your device's biometric sensors (FaceID/TouchID) to your account for zero-latency authentication.
                        </p>
                        
                        @if (!string.IsNullOrEmpty(_passkeyError))
                        {
                            <div class="alert alert-danger-premium mb-4 text-start">
                                <i class="bi bi-shield-slash-fill me-2"></i>@_passkeyError
                            </div>
                        }

                        <div class="d-grid gap-3">
                            <button class="btn btn-primary-premium py-3 fw-bold" @onclick="RegisterPasskey" disabled="@_isProcessing">
                                @if (_isProcessing) { <span class="spinner-border spinner-border-sm me-2"></span> }
                                <i class="bi bi-fingerprint me-2"></i>Activate Biometrics
                            </button>
                            
                            <button class="btn btn-glass-secondary py-2" @onclick="NextStep">
                                <i class="bi bi-skip-forward me-2"></i>Skip Step
                            </button>
                        </div>
                    </div>
                }
                else if (CurrentStep == 3)
                {
                    <div class="step-view text-center animate-fade-in">
                        <div class="premium-orb bg-pink-soft text-pink mb-4 mx-auto">
                            <i class="bi @(UserConnectionService.IsMobile ? "bi-phone-vibrate" : "bi-laptop")"></i>
                        </div>
                        <h4 class="fw-bold mb-3">@(UserConnectionService.IsMobile ? "Application Hub" : "Interface Config")</h4>
                        <p class="text-muted small mb-4 px-3">
                            @(UserConnectionService.IsMobile 
                                ? "Finalizing the GFC application installation for standalone operation..."
                                : "Optimizing your workstation for high-speed system interaction..."
                            )
                        </p>

                        <div class="info-bubble text-start mb-4">
                            <i class="bi bi-info-circle-fill me-2"></i>
                            Please allow any requested browser permissions to ensure seamless operation.
                        </div>

                        <div class="loading-state py-2">
                            <div class="spinner-premium"></div>
                            <p class="text-muted small mt-3">Configuring Environment...</p>
                        </div>
                    </div>
                }
                else if (CurrentStep == 4)
                {
                    <div class="step-view text-center animate-slide-up">
                        <div class="premium-orb @(_isSubscribed ? "bg-success-soft text-success" : "bg-orange-soft text-orange") mb-4 mx-auto">
                            <i class="bi @(_isSubscribed ? "bi-check-all" : "bi-bell-fill")"></i>
                        </div>
                        <h4 class="fw-bold mb-3">Real-time Intelligence</h4>
                        <p class="text-muted small mb-4 px-3">
                            Enable persistent system alerts for critical gate events, security status, and team updates.
                        </p>

                        @if (!string.IsNullOrEmpty(_notifError))
                        {
                            <div class="alert alert-warning-premium text-start mb-4 animate-shake">
                                <i class="bi bi-exclamation-triangle-fill me-2"></i>@_notifError
                            </div>
                        }

                        @if (_isSubscribed)
                        {
                            <div class="status-card success mb-4 animate-fade-in">
                                <i class="bi bi-patch-check-fill fs-3 text-success mb-2"></i>
                                <div class="fw-bold text-success">Channel Linked</div>
                                <div class="x-small text-muted">Test notification broadcast successful.</div>
                            </div>
                            <button class="btn btn-primary-premium w-100 py-3 fw-bold" @onclick="NextStep">
                                Finalize Setup <i class="bi bi-chevron-right ms-2"></i>
                            </button>
                        }
                        else
                        {
                            <div class="d-grid gap-3">
                                <button id="btn-enable-notif" data-gfc-notif-btn data-vapid="@_vapidKey" type="button" class="btn btn-primary-premium py-3 fw-bold shadow-premium">
                                    @if (_isProcessing) { <span class="spinner-border spinner-border-sm me-2"></span> }
                                    <i class="bi bi-broadcast-pin me-2"></i>Subscribe to Alerts
                                </button>
                                
                                <button class="btn btn-glass-secondary py-2" @onclick="NextStep">
                                    <i class="bi bi-skip-forward me-2"></i>Maybe Later
                                </button>
                            </div>
                        }
                    </div>
                }
                else if (CurrentStep == 5)
                {
                    <div class="step-view text-center py-4 animate-slide-up">
                        <div class="success-orb-premium mb-4 mx-auto shadow-success">
                            <i class="bi bi-check-lg"></i>
                        </div>
                        
                        <h2 class="fw-extrabold h3 mb-2">Systems Ready</h2>
                        <p class="text-muted small mb-5 px-4">
                            Onboarding complete. Your account and device are now fully integrated with the GFC secure perimeter.
                        </p>

                        <a href="@(UserConnectionService.IsMobile ? "/mobile" : "/")" class="btn btn-primary-premium btn-lg w-100 py-3 fw-bold shadow-premium-lg">
                            <i class="bi bi-grid-fill me-2"></i>Launch Dashboard
                        </a>
                        
                        <div class="summary-shelf mt-5 pt-4 border-top">
                            <div class="row g-2">
                                <div class="col-6">
                                    <div class="shelf-item animate-slide-up" style="animation-delay: 0.1s">
                                        <div class="small fw-bold text-indigo">Identity PIN</div>
                                        <div class="x-small text-muted">Verified & Active</div>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="shelf-item animate-slide-up" style="animation-delay: 0.2s">
                                        <div class="small fw-bold text-indigo">Trust Bridge</div>
                                        <div class="x-small text-muted">Device Encrypted</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>

        </div>
    </div>

    <!-- FIXED BOTTOM HEALTH STRIP -->
    <div class="pwa-health-strip animate-slide-up">
        <div class="strip-header d-flex justify-content-between align-items-center px-4 py-2" @onclick="ToggleDebugDetails" style="background: @(_pwaHealthStatus == "OK" ? "#1a1a1a" : "#2d1b1b")">
            <div class="d-flex align-items-center gap-3">
                <span class="badge @(_pwaHealthStatus == "OK" ? "bg-success" : (_pwaHealthStatus == "SCANNING" ? "bg-secondary" : "bg-danger shadow-pulse")) rounded-pill px-3 fw-bold">
                    @_pwaHealthStatus
                </span>
                <span class="small text-white fw-bold ls-1 opacity-75">SYSTEM DIAGNOSTICS</span>
            </div>
            <div class="text-white">
                <i class="bi bi-chevron-@( _showDebugDetails ? "down" : "up")"></i>
            </div>
        </div>

        @if (_showDebugDetails)
        {
            <div class="strip-content p-3 bg-black border-top border-secondary">
                <div class="container-fluid px-0">
                    @if (!string.IsNullOrEmpty(_healthCheckError))
                    {
                        <div class="alert alert-danger border-0 bg-danger bg-opacity-10 d-flex flex-column gap-2 mb-3 p-3 text-white">
                             <div class="d-flex align-items-center">
                                <i class="bi bi-exclamation-octagon-fill fs-4 me-2"></i>
                                <strong class="small text-uppercase">Diagnostic Error</strong>
                             </div>
                             <div class="small font-monospace p-2 bg-dark rounded border border-danger border-opacity-25">@_healthCheckError</div>
                             <button class="btn btn-danger btn-sm w-100 mt-1 fw-bold" @onclick="RunHealthCheck">
                                 <i class="bi bi-arrow-clockwise me-1"></i>Re-scan Systems
                             </button>
                        </div>
                    }
                    
                    @if (_pwaChecks != null)
                    {
                        <div class="row g-2">
                            @foreach (var check in _pwaChecks.Where(c => !c.Name.Contains("Native")))
                            {
                                <div class="col-6 col-md-3">
                                    <div class="p-2 rounded bg-dark d-flex justify-content-between align-items-center border border-secondary shadow-sm" style="background-color: #212529 !important; border: 1px solid #444 !important;">
                                        <span class="small text-truncate w-75 pe-2" style="color: #ffffff !important; font-weight: 700; opacity: 1 !important;">@check.Name</span>
                                        <span class="fw-black fs-6 @(check.Status == 200 ? "text-success" : (check.Status == 100 ? "text-info" : "text-danger"))">
                                            @check.Status
                                        </span>
                                    </div>
                                </div>
                            }
                        </div>
                        <div class="mt-3 text-center">
                             <button class="btn btn-sm btn-outline-secondary text-white px-3 border-secondary" @onclick="RunHealthCheck">
                                 <i class="bi bi-lightning-charge-fill me-1"></i>Force Refresh
                             </button>
                        </div>
                    }
                    else if (string.IsNullOrEmpty(_healthCheckError))
                    {
                        <div class="text-center py-4 text-muted">
                            <div class="spinner-border text-primary fs-4 me-2"></div>
                            <div class="mt-2 small text-uppercase fw-bold ls-1">Running system-wide audit...</div>
                        </div>
                    }
                </div>
            </div>
        }
    </div>

</div>

<style>
    /* ... existing styles ... */
    
    /* HEALTH STRIP STYLES */
    .pwa-health-strip {
        position: fixed;
        bottom: 0; left: 0; right: 0;
        background: #1a1a1a;
        z-index: 10001; /* Above reconnect modal */
        box-shadow: 0 -8px 30px rgba(0,0,0,0.8);
        border-top: 1px solid #444;
        font-family: 'Inter', system-ui, -apple-system, sans-serif;
    }

    .shadow-pulse {
        animation: badgePulse 2s infinite;
    }

    @@keyframes badgePulse {
        0% { box-shadow: 0 0 0 0 rgba(220, 53, 69, 0.4); }
        70% { box-shadow: 0 0 0 10px rgba(220, 53, 69, 0); }
        100% { box-shadow: 0 0 0 0 rgba(220, 53, 69, 0); }
    }
    
    .strip-header {
        cursor: pointer;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        height: 64px;
    }
    .strip-header:hover { background: #333 !important; }
    
    .opacity-90 { opacity: 0.9; }
    .fw-black { font-weight: 900; }
    .ls-1 { letter-spacing: 0.05rem; }

    :root {
        --wiz-primary: #4f46e5;
        --wiz-indigo: #6366f1;
        --wiz-glass: rgba(255, 255, 255, 0.96);
        --wiz-text: #1e293b;
        --wiz-text-light: #64748b;
    }

    .wizard-page {
        position: fixed;
        top: 0; left: 0; right: 0; bottom: 0;
        background: radial-gradient(circle at bottom left, #4f46e5 0%, #1e1b4b 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        overflow-y: auto;
        padding: 20px;
        z-index: 1000;
        font-family: 'Inter', system-ui, sans-serif;
    }

    .wizard-glass-card {
        background: var(--wiz-glass);
        backdrop-filter: blur(24px);
        -webkit-backdrop-filter: blur(24px);
        border: 1px solid rgba(255, 255, 255, 0.5);
        border-radius: 36px;
        padding: 48px;
        width: 100%;
        transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.4);
        color: var(--wiz-text);
    }

    .wizard-glass-card h1, .wizard-glass-card h2, .wizard-glass-card h3, .wizard-glass-card h4 {
        color: var(--wiz-text) !important;
    }

    /* Modern Stepper */
    .modern-stepper {
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 0 20px;
    }

    .step-blob {
        width: 40px;
        height: 40px;
        background: #f1f5f9;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.4s;
        position: relative;
    }

    .step-num { font-weight: 800; font-size: 0.9rem; color: #94a3b8; }

    .step-blob.active {
        background: var(--wiz-primary);
        transform: scale(1.1);
        box-shadow: 0 10px 15px -3px rgba(79, 70, 229, 0.3);
    }
    .step-blob.active .step-num { color: white; }

    .connector {
        flex: 1;
        height: 4px;
        background: #f1f5f9;
        margin: 0 8px;
        border-radius: 2px;
    }
    .connector.active { background: var(--wiz-primary); }

    /* Premium Orbs */
    .premium-orb {
        width: 100px;
        height: 100px;
        border-radius: 32px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 3rem;
    }

    .bg-indigo-soft { background: rgba(99, 102, 241, 0.12); color: #6366f1; }
    .bg-blue-soft { background: rgba(59, 130, 246, 0.12); color: #3b82f6; }
    .bg-pink-soft { background: rgba(236, 72, 153, 0.12); color: #ec4899; }
    .bg-orange-soft { background: rgba(249, 115, 22, 0.12); color: #f97316; }
    .bg-success-soft { background: rgba(16, 185, 129, 0.12); color: #10b981; }

    /* Inputs & Form Groups */
    .form-control-premium {
        width: 100%;
        background: #f1f5f9;
        border: 2px solid transparent;
        border-radius: 20px;
        padding: 16px;
        font-size: 1rem;
        transition: all 0.2s;
    }
    .form-control-premium:focus {
        background: white;
        border-color: var(--wiz-primary);
        box-shadow: 0 0 0 4px rgba(79, 70, 229, 0.1);
        outline: none;
    }
    .passcode-hero {
        font-family: monospace;
        letter-spacing: 0.5rem;
        font-size: 2.5rem;
        font-weight: 900;
        color: var(--wiz-primary);
    }

    /* Success Theme */
    .success-orb-premium {
        width: 110px;
        height: 110px;
        background: linear-gradient(135deg, #10b981 0%, #059669 100%);
        border-radius: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 4rem;
        color: white;
        animation: successEntrance 0.8s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }

    .shelf-item {
        background: rgba(0, 0, 0, 0.03);
        padding: 12px;
        border-radius: 16px;
        text-align: left;
    }

    /* Buttons */
    .btn-primary-premium {
        background: linear-gradient(135deg, #4f46e5 0%, #6366f1 100%);
        color: white;
        border: none;
        border-radius: 18px;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        box-shadow: 0 10px 15px -3px rgba(79, 70, 229, 0.3);
    }
    .btn-primary-premium:hover { transform: translateY(-2px); box-shadow: 0 20px 25px -5px rgba(79, 70, 229, 0.4); color: white; }

    .btn-glass-secondary {
        background: rgba(0, 0, 0, 0.05);
        color: var(--wiz-text-light);
        border: none;
        border-radius: 14px;
        font-weight: 600;
        transition: all 0.2s;
    }
    .btn-glass-secondary:hover { background: rgba(0, 0, 0, 0.08); color: var(--wiz-text); }

    /* Alerts & Cards */
    .alert-danger-premium { background: #fef2f2; color: #991b1b; border: 1px solid #fee2e2; border-radius: 16px; padding: 12px 16px; font-size: 0.9rem; }
    .alert-warning-premium { background: #fffbeb; color: #92400e; border: 1px solid #fde68a; border-radius: 16px; padding: 12px 16px; font-size: 0.9rem; }
    .info-bubble { background: rgba(79, 70, 229, 0.08); border-radius: 14px; padding: 12px; font-size: 0.85rem; color: #4338ca; border: 1px solid rgba(79, 70, 229, 0.1); }
    .status-card.success { background: #f0fdf4; border: 1px solid #dcfce7; border-radius: 20px; padding: 20px; }

    /* Premium Spinner */
    .spinner-premium {
        width: 56px; height: 56px; border-radius: 50%;
        background: radial-gradient(farthest-side, #4f46e5 94%, #0000) top/8px 8px no-repeat,
                    conic-gradient(#0000 30%, #4f46e5);
        -webkit-mask: radial-gradient(farthest-side, #0000 calc(100% - 8px), #000 0);
        animation: spin 1s infinite linear;
        margin: 0 auto;
    }

    .x-small { font-size: 0.7rem; }
    .text-muted-light { color: var(--wiz-text-light); }

    /* Animations */
    @@keyframes spin { 100% { transform: rotate(360deg); } }
    @@keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
    @@keyframes slideUp { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }
    @@keyframes successEntrance {
        from { opacity: 0; transform: scale(0.5) rotate(-15deg); }
        to { opacity: 1; transform: scale(1) rotate(0); }
    }
    @@keyframes shake {
        0%, 100% { transform: translateX(0); }
        25% { transform: translateX(-5px); }
        75% { transform: translateX(5px); }
    }

    .animate-fade-in { animation: fadeIn 0.8s ease-out forwards; }
    .animate-slide-up { animation: slideUp 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) forwards; }
    .animate-shake { animation: shake 0.4s ease-in-out; }

    @@media (max-width: 480px) {
        .wizard-glass-card { padding: 32px 20px; border-radius: 28px; }
        .passcode-hero { font-size: 1.8rem; }
    }
</style>


@code {
    private int CurrentStep = 1;

    private bool _isProcessing = false;
    private string? _passkeyError;
    private string? _passcode;
    private string? _passcodeError;
    private bool _canInstall = false;
    private string? _platformInstructions;
    private bool _isSubscribed = false;
    private string? _notifError;
    private string? _vapidKey;
    private DotNetObjectReference<DeviceWizard>? _objRef;

    // Health Check Props
    private class PwaCheck { 
        public string Name { get; set; } = ""; 
        public int Status { get; set; } 
    }
    private List<PwaCheck>? _pwaChecks;
    private string _pwaHealthStatus = "SCANNING";
    private string? _healthCheckError;

    private Task? currentCheckTask;

    private bool _showDebugDetails = false;
    private void ToggleDebugDetails() => _showDebugDetails = !_showDebugDetails;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await CheckPwaInstallability();
            
            // Initialize DotNet reference
            _objRef = DotNetObjectReference.Create(this);

            // Set VAPID for diagnostics
            if (!string.IsNullOrEmpty(_vapidKey))
            {
                await JS.InvokeVoidAsync("GFC.setVapidKey", _vapidKey);
            }

            // Run Health Check immediately on load
            _ = RunHealthCheck();
        }

        // CRITICAL: Bind native click listener for Step 4
        if (CurrentStep == 4 && !_isSubscribed)
        {
            try
            {
                var settings = await SystemSettingsService.GetAsync();
                if (!string.IsNullOrEmpty(settings.VapidPublicKey))
                {
                    await JS.InvokeVoidAsync("GFC_Notifications.bindNativePrompt", "btn-enable-notif", settings.VapidPublicKey, _objRef);
                }
            }
            catch (Exception ex)
            {
                Logger.LogWarning("Binding error: {Message}", ex.Message);
            }
        }
    }

    [JSInvokable]
    public async Task OnSubscriptionSuccess(string subscriptionJson)
    {
        try
        {
            var user = AuthStateProvider.GetCurrentUser();
            if (user == null) return;

            using var doc = System.Text.Json.JsonDocument.Parse(subscriptionJson);
            var root = doc.RootElement;
            
            await NotificationService.SubscribeToPushAsync(
                user.UserId, 
                root.GetProperty("endpoint").GetString()!,
                root.GetProperty("keys").GetProperty("p256dh").GetString()!,
                root.GetProperty("keys").GetProperty("auth").GetString()!,
                $"App: {GetPlatformName()}"
            );
            
            _isSubscribed = true;
            Logger.LogInformation("Push notification subscription successful for user {UserId}", user.UserId);
            
            // Send welcome push
            try { await NotificationService.SendPushNotificationAsync(user.UserId, "Welcome to GFC", "Notifications are active!", "/"); } catch {}
            
            StateHasChanged();
        }
        catch (Exception ex)
        {
            _notifError = "Subscription failed: " + ex.Message;
            
            // Add detailed info to health check log
            _healthCheckError = $"Push Registration Error: {ex.Message}";
            _showDebugDetails = true; // Auto-show the panel
            
            if (ex.Message.Contains("403")) _healthCheckError += " (Check VAPID/Permission)";
            if (ex.Message.Contains("429")) _healthCheckError += " (Rate Limited)";
            
            StateHasChanged();
        }
    }

    [JSInvokable]
    public void OnPermissionResult(string permission)
    {
        if (permission == "denied")
        {
             if (UserConnectionService.IsMobile)
            {
                _notifError = "Notifications are blocked by your device settings. Go to Settings > Apps > GFC > Notifications and enable 'Allow notifications'.";
            }
            else
            {
                _notifError = "Notifications are blocked by your browser for this site. Please click the lock icon in the address bar to reset permissions.";
            }
        }
        else if (permission == "default")
        {
             if (UserConnectionService.IsMobile)
            {
                 _notifError = "The system popup didn't appear. Go to your phone Settings > Apps > GFC App > Notifications and ensure they are ON.";
            }
            else
            {
                _notifError = "The browser suppressed the notification prompt. Please click the lock icon in the address bar to allow notifications.";
            }
        }
        else if (permission == "not_supported")
        {
            _notifError = "Notifications are not supported by this browser.";
        }
        else if (permission == "insecure_context")
        {
            _notifError = "HTTPS is required for push notifications.";
        }
        
        StateHasChanged();
    }

    [JSInvokable]
    public void OnSubscriptionError(string message)
    {
        _notifError = "Subscription error: " + message;
        StateHasChanged();
    }

    public void Dispose()
    {
        _objRef?.Dispose();
    }

