@page "/setup/activate"
@page "/setup/activate/{Token}"
@using GFC.BlazorServer.Services
@using GFC.BlazorServer.Services.Vpn
@using GFC.Core.Interfaces
@inject IDeviceTrustService DeviceTrustService
@inject IVpnConfigurationService VpnService
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject CustomAuthenticationStateProvider AuthStateProvider
@inject IUserManagementService UserManagementService
@inject ILogger<Activate> Logger

<div class="activation-container">
    @if (_activating)
    {
        <div class="text-center">
            <div class="spinner-border text-primary mb-3" role="status">
                <span class="visually-hidden">Activating...</span>
            </div>
            <h3>Activating Your Device...</h3>
            <p>Please wait while we set up secure access.</p>
        </div>
    }
    else if (_success)
    {
        <div class="alert alert-success shadow-sm">
            <i class="bi bi-check-circle-fill me-2"></i>
            <strong>Device Activated Successfully!</strong>
        </div>
        <p class="lead">Your device has been approved and securely registered.</p>
        
        <div class="mt-4 p-4 bg-white rounded-lg shadow-sm border" style="border-left: 5px solid #0d6efd !important;">
            <h5 class="text-primary"><i class="bi bi-shield-lock me-2"></i>Finalizing Setup</h5>
            <div class="d-flex align-items-center justify-content-center mt-3">
                <div class="spinner-border text-primary spinner-border-sm me-2" role="status"></div>
                <span class="text-muted">Redirecting to account setup...</span>
            </div>
        </div>
        <p class="mt-4 small text-muted">Redirecting automatically in a moment...</p>
        <div class="small text-muted" style="font-size: 0.7rem; opacity: 0.7;">Target: @_nextUrl</div>
    }
    else if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="alert alert-danger shadow-sm">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            <strong>Activation Failed</strong>
        </div>
        <p>@_errorMessage</p>
        <div class="mt-3 p-3 bg-light rounded small text-start">
            <strong>Troubleshooting:</strong>
            <ul class="mb-0 mt-1">
                <li>Make sure you scanned the correct QR code.</li>
                <li>Ensure you are connected to the network.</li>
                <li>Try copying and pasting the link manually if the scanner fails.</li>
            </ul>
        </div>
        <p class="text-muted mt-3">Please contact your administrator for a new invite link.</p>
    }
</div>

<style>
    .activation-container {
        max-width: 500px;
        margin: 100px auto;
        padding: 2rem;
        text-align: center;
    }
</style>

@code {
    [Parameter] public string? Token { get; set; }
    
    private bool _activating = true;
    private bool _success = false;
    private string _errorMessage = "";
    private string _nextUrl = "/";

    protected override async Task OnInitializedAsync()
    {
        await ActivateDevice();
    }

    private async Task ActivateDevice()
    {
        try
        {
            // 0. Get token from Route OR Query String
            var activeToken = Token;
            if (string.IsNullOrEmpty(activeToken))
            {
                var uri = new Uri(Navigation.Uri);
                var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
                activeToken = query["token"];
            }

            if (string.IsNullOrEmpty(activeToken))
            {
                _errorMessage = "Invalid activation link. No token provided.";
                _activating = false;
                StateHasChanged();
                return;
            }

            // Robustness: Trim any whitespace scanners might add
            activeToken = activeToken.Trim();

            // 1. Validate the Invite/Onboarding Token
            var result = await VpnService.ValidateOnboardingTokenAsync(activeToken);

            if (result == null)
            {
                _errorMessage = "Activation failed. This link has already been used, is invalid, or has expired. Please request a new activation link.";
                _activating = false;
                StateHasChanged();
                return;
            }

            var userId = result.UserId;
            string deviceTrustToken;

            if (result.IsStation)
            {
                // Create a STATION trust token (Shared Computer)
                deviceTrustToken = await DeviceTrustService.CreateStationTokenAsync(userId, "Shared Computer (Station)", "Unknown IP", 365);
                Logger.LogInformation("STATION activated by user {UserId}", userId);
            }
            else
            {
                // 2. Create a NEW Device Trust Token for this session
                // We use a default duration (e.g., 30 days) and generic user agent since we're in Blazor context
                deviceTrustToken = await DeviceTrustService.CreateDeviceTokenAsync(userId, "Web Browser (Activated)", "Unknown IP", 30);
            }

            // [SECURITY] Mark the onboarding token as used to prevent reuse
            await VpnService.SetTokenUsedAsync(activeToken);
            Logger.LogInformation("Onboarding token marked as used for user {UserId}", userId);

            // 3. Clear ANY existing session to prevent cross-account pollution
            // (e.g. if an admin was previously logged in on this phone)
            try { await AuthStateProvider.LogoutAsync(); } catch { }

            // [CRITICAL FIX] Clear the GLOBAL authentication cache
            // The CustomAuthenticationStateProvider uses a static cache that persists across circuits.
            // If we don't clear it, the wizard will load the CACHED user (e.g., Admin) instead of the NEW user.
            CustomAuthenticationStateProvider.InvalidateAll();

            // 4. Set the NEW TRUST COOKIE
            await JS.InvokeVoidAsync("window.setCookie", "GFC_DeviceTrustToken", deviceTrustToken, 365);
            await JS.InvokeVoidAsync("localStorage.setItem", "gfc_device_token", deviceTrustToken);

            // [FIX] Verify cookie before leaving
            var cookieVerified = await JS.InvokeAsync<bool>("window.verifyCookie", "GFC_DeviceTrustToken");
            if (!cookieVerified) {
                Logger.LogWarning("Cookie verification failed on first attempt. Waiting longer...");
                await Task.Delay(2000); // Wait longer if browser is slow
            }
            else {
                await Task.Delay(1000);
            }
            
            // 4. Determine next step based on user status (Breeze through if already set up)
            var bust = DateTime.UtcNow.Ticks;
            
            if (result.IsStation)
            {
                _nextUrl = $"/login?station=true&t={bust}";
            }
            else
            {
                _nextUrl = $"/setup/wizard?setup=true&t={bust}";
            }

            _success = true;
            _activating = false;
            StateHasChanged();
            
            // Force load to ensure cookies are sent freshly and auth state is rebuilt
            Navigation.NavigateTo(_nextUrl, forceLoad: true);

        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Activation failure");
            _errorMessage = $"An error occurred during activation: {ex.Message}";
            _activating = false;
            StateHasChanged();
        }
    }
}
