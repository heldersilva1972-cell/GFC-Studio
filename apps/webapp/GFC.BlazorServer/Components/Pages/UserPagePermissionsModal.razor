@using GFC.Core.Models
@using GFC.Core.Interfaces
@inject IUserManagementService UserService
@inject IEmailService EmailService
@inject ILogger<UserPagePermissionsModal> Logger

<link href="css/page-permissions-modern.css" rel="stylesheet" />

<div class="modal-backdrop" @onclick="OnClose"></div>
<div class="modal-card" style="max-width: 950px; width: 95%; max-height: 90vh; display: flex; flex-direction: column;">
    <!-- HEADER -->
    <div class="modal-card__header d-flex justify-content-between align-items-center p-3 border-bottom">
        <div class="d-flex align-items-center">
            <div class="bg-primary-subtle p-2 rounded-3 me-3">
                <i class="bi bi-shield-lock-fill text-primary fs-4"></i>
            </div>
            <div>
                <h4 class="mb-0 fw-bold">Page Access Permissions</h4>
                <p class="text-muted small mb-0">Managing access for <strong>@Username</strong></p>
            </div>
            @if (IsAdmin)
            {
                <span class="badge bg-primary ms-3 shadow-sm">SYSTEM ADMIN</span>
            }
        </div>
        <button class="btn btn-light rounded-circle p-2" type="button" @onclick="OnClose">
            <i class="bi bi-x-lg"></i>
        </button>
    </div>

    <!-- BODY -->
    <div class="modal-card__body p-0 overflow-auto flex-grow-1">
        @if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <div class="alert alert-danger m-3 border-0 shadow-sm d-flex align-items-center">
                <i class="bi bi-exclamation-octagon-fill me-2 fs-5"></i>
                <div>@ErrorMessage</div>
            </div>
        }

        @* [REMOVED] Restrictive Admin check - showing pages for all users now *@
        <!-- SEARCH & ACTIONS BAR -->
        <div class="search-box-container p-3 border-bottom shadow-sm">
            <div class="row g-3 align-items-center">
                <div class="col-md-6">
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0">
                            <i class="bi bi-search text-muted"></i>
                        </span>
                        <input type="text" 
                               class="form-control border-start-0" 
                               placeholder="Search by page name, route or description..." 
                               @bind="_searchTerm" 
                               @bind:event="oninput" />
                    </div>
                </div>
                <div class="col-md-6 text-md-end">
                    <div class="btn-group shadow-sm">
                        <button type="button" class="btn btn-outline-primary btn-sm px-3" @onclick="SelectAll">
                            <i class="bi bi-check-all me-1"></i> Grant All
                        </button>
                        <button type="button" class="btn btn-outline-secondary btn-sm px-3" @onclick="ClearAll">
                            <i class="bi bi-x-circle me-1"></i> Revoke All
                        </button>
                    </div>
                    <div class="d-inline-block ms-3">
                        <span class="badge bg-light text-dark border p-2">
                            <i class="bi bi-list-check me-1"></i> @SelectedPageIds.Count of @(AllPages.Count) Pages
                        </span>
                    </div>
                </div>
            </div>
        </div>

            <div class="p-3">
                @if (Loading)
                {
                    <div class="text-center py-5">
                        <div class="spinner-grow text-primary" role="status"></div>
                        <p class="mt-3 text-muted">Analyzing system routes...</p>
                    </div>
                }
                else
                {
                    var filteredCategories = GetFilteredPages();
                    if (!filteredCategories.Any())
                    {
                        <div class="empty-search-state">
                            <i class="bi bi-search"></i>
                            <h5>No matches found</h5>
                            <p>Try searching for a different keyword or part of a route.</p>
                            <button class="btn btn-link" @onclick="() => _searchTerm = string.Empty">Clear Search</button>
                        </div>
                    }
                else
                {
                    @foreach (var category in filteredCategories.Keys.OrderBy(k => k))
                    {

                        <div class="permission-category-header">
                            <div class="d-flex align-items-center">
                                <h6 class="mb-0 fw-bold">@category.ToUpper()</h6>
                                <span class="ms-2 category-stats">(@filteredCategories[category].Count pages)</span>
                            </div>
                            <button class="btn btn-link btn-sm text-decoration-none p-0" @onclick="() => ToggleCategory(category)">
                                <i class="bi @(IsCategoryExpanded(category) ? "bi-chevron-up" : "bi-chevron-down")"></i>
                            </button>
                        </div>

                        @if (IsCategoryExpanded(category))
                        {
                            @if (category.ToUpper() == "MOBILE" || category.ToUpper() == "MOBILE APPS")
                            {
                                <div class="alert alert-info py-2 px-3 mb-3 border-0 rounded-3 d-flex align-items-center" style="font-size: 0.8rem; background: rgba(13, 110, 253, 0.05); color: var(--app-primary);">
                                    <i class="bi bi-info-circle-fill me-2"></i>
                                    <span>GFC Portal Home access is automatically granted when any tool is selected.</span>
                                </div>
                            }

                            <div class="row g-3">
                                @foreach (var appPage in filteredCategories[category])
                                {
                                    if ((appPage.PageRoute ?? "").ToLower().StartsWith("/mobile/liquor/hub/")) continue;

                                    <div class="col-md-6 col-lg-4">
                                        <div class="card h-100 permission-card @(SelectedPageIds.Contains(appPage.PageId) ? "granted" : "")"
                                             style="cursor: pointer;">
                                            <div class="card-body p-3">
                                                <div class="d-flex align-items-center justify-content-between mb-2">
                                                    <div class="d-flex align-items-center gap-3" @onclick="() => TogglePage(appPage)">
                                                        <div class="p-2 rounded-circle bg-opacity-10 d-flex align-items-center justify-content-center @(SelectedPageIds.Contains(appPage.PageId) ? "bg-success text-success" : "bg-secondary text-secondary")" style="width: 40px; height: 40px;">
                                                            <i class="bi @GetPageIcon(appPage) fs-5"></i>
                                                        </div>
                                                        <h6 class="card-title fw-bold mb-0">@GetCleanPageName(appPage)</h6>
                                                    </div>
                                                    <div class="modern-switch @(SelectedPageIds.Contains(appPage.PageId) ? "checked" : "")" @onclick="() => TogglePage(appPage)"></div>
                                                </div>
                                                
                                                 @if (SelectedPageIds.Contains(appPage.PageId) && (SupportsPush(appPage) || SupportsEdit(appPage)))
                                                {
                                                    <div class="d-flex flex-column gap-2 pt-2 border-top mt-2 animate-fade-in">
                                                        @if (SupportsPush(appPage))
                                                        {
                                                            <div class="d-flex align-items-center justify-content-between">
                                                                <div class="d-flex align-items-center gap-2 text-muted small">
                                                                    <i class="bi bi-bell-fill @(PushEnabledPageIds.Contains(appPage.PageId) ? "text-warning" : "")"></i>
                                                                    <span>Push Notifications</span>
                                                                </div>
                                                                <div class="form-check form-switch mb-0">
                                                                    <input class="form-check-input" type="checkbox" role="switch" 
                                                                           checked="@PushEnabledPageIds.Contains(appPage.PageId)"
                                                                           @onchange="(e) => TogglePush(appPage.PageId, e)">
                                                                </div>
                                                            </div>
                                                        }
                                                        
                                                        @if (SupportsEdit(appPage))
                                                        {
                                                            <div class="d-flex align-items-center justify-content-between">
                                                                <div class="d-flex align-items-center gap-2 text-muted small">
                                                                    <i class="bi bi-pencil-square @(EditEnabledPageIds.Contains(appPage.PageId) ? "text-primary" : "")"></i>
                                                                    <span>Edit Permission</span>
                                                                </div>
                                                                <div class="form-check form-switch mb-0">
                                                                    <input class="form-check-input" type="checkbox" role="switch" 
                                                                           checked="@EditEnabledPageIds.Contains(appPage.PageId)"
                                                                           @onchange="(e) => ToggleEdit(appPage.PageId, e)">
                                                                </div>
                                                            </div>
                                                        }
                                                    </div>
                                                }

                                                @if (appPage.PageRoute?.ToLower() == "/mobile/liquor/hub")
                                                {
                                                    var liquorSubPages = AllPages.Where(p => (p.PageRoute?.ToLower() ?? "").StartsWith("/mobile/liquor/hub/")).ToList();
                                                    if (liquorSubPages.Any())
                                                    {
                                                        <div class="d-flex flex-column gap-2 pt-2 border-top mt-2 animate-fade-in">
                                                            <div class="text-muted small fw-bold mb-1" style="font-size: 0.75rem;">Liquor Hub Modules:</div>
                                                            @foreach (var subPage in liquorSubPages)
                                                            {
                                                                <div class="d-flex align-items-center justify-content-between ms-1">
                                                                    <div class="d-flex align-items-center gap-2 text-muted small">
                                                                        <i class="bi bi-diagram-3 pe-1 @(SelectedPageIds.Contains(subPage.PageId) ? "text-primary" : "")"></i>
                                                                        <span>@GetCleanPageName(subPage).Replace("Liquor Hub: ", "")</span>
                                                                    </div>
                                                                    <div class="form-check form-switch mb-0">
                                                                        <input class="form-check-input" type="checkbox" role="switch" 
                                                                               checked="@SelectedPageIds.Contains(subPage.PageId)"
                                                                               @onchange="(e) => TogglePage(subPage)">
                                                                    </div>
                                                                </div>
                                                            }
                                                        </div>
                                                    }
                                                }
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    }

                }
                }
            </div>
        }
    </div>

    <!-- FOOTER -->
    <div class="modal-card__actions p-3 border-top bg-light rounded-bottom-4 d-flex justify-content-between align-items-center">
        <div>
            @if (HasChanges)
            {
                <span class="text-primary small animate-pulse"><i class="bi bi-info-circle me-1"></i> You have unsaved changes</span>
            }
        </div>
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-outline-secondary px-4" @onclick="OnClose" disabled="@Saving">Cancel</button>
            <button type="button" class="btn btn-primary px-4 shadow" @onclick="SavePermissions" disabled="@(Saving || !HasChanges)">
                @if (Saving)
                {
                    <span class="spinner-border spinner-border-sm me-2"></span>
                    <span>Saving...</span>
                }
                else
                {
                    <i class="bi bi-shield-check me-2"></i>
                    <span>Apply Permissions</span>
                }
            </button>
        </div>
    </div>
</div>

@code {
    [Parameter] public int UserId { get; set; }
    [Parameter] public string Username { get; set; } = string.Empty;
    [Parameter] public bool IsAdmin { get; set; }
    [Parameter] public bool IsDirector { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }

    private bool Loading { get; set; } = true;
    private bool Saving { get; set; } = false;
    private string ErrorMessage { get; set; } = string.Empty;
    private string _searchTerm = string.Empty;
    
    private List<AppPage> AllPages { get; set; } = new();
    private Dictionary<string, List<AppPage>> PagesByCategory { get; set; } = new();
    private HashSet<int> SelectedPageIds { get; set; } = new();
    private HashSet<int> OriginalSelectedPageIds { get; set; } = new();
    private HashSet<int> PushEnabledPageIds { get; set; } = new();
    private HashSet<int> OriginalPushEnabledPageIds { get; set; } = new();
    private HashSet<int> EditEnabledPageIds { get; set; } = new();
    private HashSet<int> OriginalEditEnabledPageIds { get; set; } = new();
    private HashSet<string> CollapsedCategories { get; set; } = new();

    private bool HasChanges => !SelectedPageIds.SetEquals(OriginalSelectedPageIds) || 
                              !PushEnabledPageIds.SetEquals(OriginalPushEnabledPageIds) ||
                              !EditEnabledPageIds.SetEquals(OriginalEditEnabledPageIds);

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        Loading = true;
        ErrorMessage = string.Empty;
        
        try
        {
            AllPages = await Task.Run(() => UserService.GetActivePages());
            
            PagesByCategory = AllPages
                .GroupBy(p => p.Category ?? "Other")
                .ToDictionary(g => g.Key, g => g.OrderBy(p => p.DisplayOrder).ThenBy(p => p.PageName).ToList());
            
            if (!IsAdmin)
            {
                var userPermissions = await Task.Run(() => UserService.GetUserPagePermissions(UserId));
                SelectedPageIds = userPermissions.Select(p => p.PageId).ToHashSet();
                OriginalSelectedPageIds = new HashSet<int>(SelectedPageIds);
                
                PushEnabledPageIds = userPermissions.Where(p => p.ReceivePush).Select(p => p.PageId).ToHashSet();
                OriginalPushEnabledPageIds = new HashSet<int>(PushEnabledPageIds);

                EditEnabledPageIds = userPermissions.Where(p => p.CanEdit).Select(p => p.PageId).ToHashSet();
                OriginalEditEnabledPageIds = new HashSet<int>(EditEnabledPageIds);
            }

        }
        catch (Exception ex)
        {
            ErrorMessage = $"Failed to load page permissions: {ex.Message}";
        }
        finally
        {
            Loading = false;
        }
    }

    private Dictionary<string, List<AppPage>> GetFilteredPages()
    {
        var visiblePages = AllPages.Where(p => !IsHiddenPage(p));

        if (string.IsNullOrWhiteSpace(_searchTerm))
        {
            return visiblePages
                .GroupBy(p => p.Category ?? "Other")
                .ToDictionary(g => g.Key, g => g.OrderBy(p => p.DisplayOrder).ThenBy(p => p.PageName).ToList());
        }

        var term = _searchTerm.ToLower();
        return visiblePages
            .Where(p => p.PageName.ToLower().Contains(term) || 
                      p.PageRoute.ToLower().Contains(term) || 
                      (p.Description?.ToLower().Contains(term) ?? false) ||
                      (p.Category?.ToLower().Contains(term) ?? false))
            .GroupBy(p => p.Category ?? "Other")
            .ToDictionary(g => g.Key, g => g.ToList());
    }

    private void TogglePage(AppPage page)
    {
        // [MOD] Allow toggling any page, even if it requires admin (delegated access)
        if (SelectedPageIds.Contains(page.PageId))
        {
            SelectedPageIds.Remove(page.PageId);
            PushEnabledPageIds.Remove(page.PageId); // Auto-disable push if access is revoked
            
            // If we are unchecking the main Mobile Liquor Hub, automatically uncheck all its child sub-pages
            if (page.PageRoute?.ToLower() == "/mobile/liquor/hub")
            {
                var subPageIds = AllPages.Where(p => (p.PageRoute?.ToLower() ?? "").StartsWith("/mobile/liquor/hub/")).Select(p => p.PageId).ToList();
                foreach (var id in subPageIds)
                {
                    SelectedPageIds.Remove(id);
                }
            }
        }
        else
        {
            SelectedPageIds.Add(page.PageId);
        }
    }

    private void TogglePush(int pageId, ChangeEventArgs e)
    {
        bool isChecked = (bool)(e.Value ?? false);
        if (isChecked)
            PushEnabledPageIds.Add(pageId);
        else
            PushEnabledPageIds.Remove(pageId);
    }

    private bool SupportsPush(AppPage page)
    {
        var route = page.PageRoute?.ToLower() ?? "";
        return route.Contains("reimbursement") || 
               route.Contains("member-signup") || 
               route.Contains("dues") || 
               route.Contains("alert") || 
               route.Contains("controller");
    }

    private bool SupportsEdit(AppPage page)
    {
        var route = page.PageRoute?.ToLower().TrimStart('/') ?? "";
        var name = page.PageName?.ToLower() ?? "";
        
        // [NEW] specifically allow editing for Bar/Lottery sales entries
        // Check both the URL route and the Display Name to be safe
        return route.Contains("finance/bar-lottery-sales") || 
               name.Contains("bar/lottery sales") || 
               name.Contains("bar/lottery entries") ||
               name.Contains("bar lottery sales") ||
               name.Contains("bar lottery entries");
    }



    private void ToggleEdit(int pageId, ChangeEventArgs e)
    {
        bool isChecked = (bool)(e.Value ?? false);
        if (isChecked)
            EditEnabledPageIds.Add(pageId);
        else
            EditEnabledPageIds.Remove(pageId);
    }


    private void SelectAll()
    {
        // Grant all visible pages
        SelectedPageIds = AllPages
            .Where(p => !IsHiddenPage(p))
            .Select(p => p.PageId)
            .ToHashSet();
    }

    private void ClearAll()
    {
        SelectedPageIds.Clear();
    }

    private bool IsHiddenPage(AppPage page)
    {
        var route = (page.PageRoute ?? "").Trim().TrimEnd('/').ToLower();
        if (!string.IsNullOrEmpty(route) && !route.StartsWith("/")) route = "/" + route;

        // Filter by known variations of the hub route
        if (route == "/mobile" || route == "/hub") return true;

        // Filter by common name tokens to handle naming inconsistencies
        var name = (page.PageName ?? "").ToLower();
        if (name.Contains("staff portal hub") || name.Contains("portal hub")) return true;

        return false;
    }

    private void ToggleCategory(string category)
    {
        if (CollapsedCategories.Contains(category))
            CollapsedCategories.Remove(category);
        else
            CollapsedCategories.Add(category);
    }

    private bool IsCategoryExpanded(string category) => !CollapsedCategories.Contains(category);

    private string GetCleanPageName(AppPage page)
    {
        var route = (page.PageRoute ?? "").Trim().TrimEnd('/').ToLower();
        if (!string.IsNullOrEmpty(route) && !route.StartsWith("/")) route = "/" + route;

        return route switch
        {
            "/mobile" => "Staff Portal Hub",
            "/hub" => "Staff Portal Hub",
            "/mobile/schedule" => "Bartender Schedule (Mobile)",
            "/mobile/shift-report" => "End of Shift Sales (Mobile)",
            "/mobile/liquor/checkout" => "Bartender Liquor Checkout (Mobile)",
            "/mobile/liquor/manage" => "Liquor Inventory",
            "/mobile/analytics" => "Income Charts & Analytics",
            "/mobile/keycards" => "Door Key Cards (Mobile)",
            "/mobile/dues" => "Dues & Payments (Mobile)",
            "/mobile/manage-schedule" => "Schedule Manager",
            "/mobile/users" => "Mobile User Management",
            "/mobile/reimbursements" => "Submit Reimbursement (Mobile)",
            "/mobile/reimbursements/manager" => "Reimbursement Payout Hub",
            "/mobile/system/stats" => "System Vitals (Mobile)",
            "/widgets/shift-sales-alert" => "Shift Sales Alert Widget",
            "/operations/end-of-shift" => "End of Shift Sales",
            "/admin/staff-shifts" => "Bartender Schedule",
            "/members" => "Members Info",
            "/dues" => "Dues/Payments",
            "/keycards" => "Door Key Cards",
            "/life-eligibility" => "Life Eligibility",
            "/np-queue" => "Non-Portuguese Queue",
            "/bylaws" => "Club Bylaws",
            "/directors" => "Directors",
            "/physicalkeys" => "Physical Keys",
            "/finance/insights" => "Financial Insights",
            "/finance/lottery-analytics" => "Lottery Analytics",
            "/finance/lottery-summaries" => "Lottery Daily Summaries",
            "/reimbursements/manage" => "Manage Reimbursements",
            "/admin/bar-sales" => "Bar/Lottery Sales",
            "/active-sessions" => "Active Device Sessions",
            "/admin/users/live-activity" => "Live Activity Feed",
            "/admin/security-settings" => "Security & Access Hub",
            "/admin/audit-logs" => "Administrative Logs",
            "/export" => "Data Export",
            "/mobile/liquor/hub/insight" => "Insight",
            "/mobile/liquor/hub/ordering" => "Ordering",
            "/mobile/liquor/hub/receive" => "Receive Order",
            "/mobile/liquor/hub/unpaid" => "Unpaid Invoices",
            "/mobile/liquor/hub/count" => "Stock Count",
            "/mobile/liquor/hub/history" => "View History",
            "/mobile/liquor/hub/setup" => "Hub Setup",
            _ => page.PageName
        };
    }

    private string GetPageIcon(AppPage page)
    {
        var route = page.PageRoute.ToLower();
        if (route.Contains("dashboard")) return "bi-speedometer2";
        if (route.Contains("user")) return "bi-person-circle";
        if (route.Contains("member")) return "bi-people";
        if (route.Contains("camera")) return "bi-camera-video";
        if (route.Contains("finance") || route.Contains("sale")) return "bi-currency-dollar";
        if (route.Contains("security")) return "bi-shield-lock";
        if (route.Contains("setting")) return "bi-gear";
        if (route.Contains("report") || route.Contains("audit")) return "bi-file-earmark-bar-graph";
        if (route.Contains("end-of-shift") || route.Contains("shift-report")) return "bi-calendar-check";
        if (route.Contains("schedule")) return "bi-calendar-event";
        if (route.Contains("liquor")) return "bi-box-seam";
        if (route.Contains("hall")) return "bi-building";
        return "bi-file-earmark-text";
    }

    private async Task SavePermissions()
    {
        Saving = true;
        ErrorMessage = string.Empty;
        
        try
        {
            var cameraPermissionPage = AllPages.FirstOrDefault(p => p.PageRoute == "/cameras/view");
            bool wasCameraPermissionGranted = false;
            
            if (cameraPermissionPage != null)
            {
                bool originallyHadPermission = OriginalSelectedPageIds.Contains(cameraPermissionPage.PageId);
                bool nowHasPermission = SelectedPageIds.Contains(cameraPermissionPage.PageId);
                if (!originallyHadPermission && nowHasPermission)
                {
                    wasCameraPermissionGranted = true;
                }
            }

            // [AUTO-GRANT] If any mobile page is selected, automatically add the main portal routes
            var mobilePagesSelected = AllPages
                .Where(p => SelectedPageIds.Contains(p.PageId) && (p.PageRoute ?? "").ToLower().Contains("mobile/"))
                .Any();
                
            if (mobilePagesSelected)
            {
                // Add the "/mobile" route
                var mobileHubPage = AllPages.FirstOrDefault(p => (p.PageRoute ?? "").Trim().ToLower().TrimEnd('/') == "/mobile");
                if (mobileHubPage != null) SelectedPageIds.Add(mobileHubPage.PageId);
                
                // [NEW] If any liquor module is selected, auto-grant the liquor hub
                var liquorSubPageSelected = AllPages.Any(p => SelectedPageIds.Contains(p.PageId) && (p.PageRoute ?? "").ToLower().StartsWith("/mobile/liquor/hub/"));
                if (liquorSubPageSelected)
                {
                    var liquorHubPage = AllPages.FirstOrDefault(p => (p.PageRoute ?? "").Trim().ToLower().TrimEnd('/') == "/mobile/liquor/hub");
                    if (liquorHubPage != null) SelectedPageIds.Add(liquorHubPage.PageId);
                }

                // Also add "/hub" just in case legacy routes are being used
                var legacyHubPage = AllPages.FirstOrDefault(p => (p.PageRoute ?? "").Trim().ToLower().TrimEnd('/') == "/hub");
                if (legacyHubPage != null) SelectedPageIds.Add(legacyHubPage.PageId);
            }

            await Task.Run(() => UserService.SetUserPagePermissions(
                UserId, 
                SelectedPageIds.ToList(), 
                "Admin"));

            if (wasCameraPermissionGranted)
            {
                var user = await UserService.GetUserAsync(UserId);
                if (user != null && !string.IsNullOrEmpty(user.Email))
                {
                    try
                    {
                        await EmailService.SendEmailAsync(
                            user.Email,
                            "Your Secure Access to GFC Cameras is Ready",
                            $"<p>Hello {user.Username},</p><p>You have been granted secure remote access to the GFC camera system. You can now complete the one-time setup to view cameras from any device.</p><p>Please log in to the GFC website and navigate to the Cameras page to begin the setup wizard.</p>");
                    }
                    catch (Exception ex)
                    {
                        Logger.LogWarning(ex, "Failed to send camera access email to {Email}", user.Email);
                    }
                }
            }
            
            await OnSaved.InvokeAsync();
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Failed to save permissions: {ex.Message}";
            Saving = false;
        }
        finally
        {
            if (string.IsNullOrEmpty(ErrorMessage))
            {
                // [NEW] Persist push and edit preferences
                foreach (var pageId in SelectedPageIds)
                {
                    // Push
                    bool isPushEnabled = PushEnabledPageIds.Contains(pageId);
                    bool originallyPushEnabled = OriginalPushEnabledPageIds.Contains(pageId);
                    
                    if (isPushEnabled != originallyPushEnabled)
                    {
                        await Task.Run(() => UserService.UpdateUserPushPreference(UserId, pageId, isPushEnabled));
                    }

                    // Edit
                    bool isEditEnabled = EditEnabledPageIds.Contains(pageId);
                    bool originallyEditEnabled = OriginalEditEnabledPageIds.Contains(pageId);

                    if (isEditEnabled != originallyEditEnabled)
                    {
                        await Task.Run(() => UserService.UpdateUserEditPreference(UserId, pageId, isEditEnabled));
                    }
                }

                Saving = false;
                OriginalSelectedPageIds = new HashSet<int>(SelectedPageIds);
                OriginalPushEnabledPageIds = new HashSet<int>(PushEnabledPageIds);
                OriginalEditEnabledPageIds = new HashSet<int>(EditEnabledPageIds);
            }

        }
    }
}
