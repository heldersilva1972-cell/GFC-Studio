@using GFC.Core.Models
@using GFC.Core.Interfaces
@inject IUserManagementService UserService
@inject IEmailService EmailService
@inject GFC.Core.Interfaces.IPagePermissionRepository PageRepo
@inject ILogger<UserPagePermissionsModal> Logger
@inject GFC.BlazorServer.Services.PermissionStateService PermissionState

<link href="css/page-permissions-modern.css" rel="stylesheet" />

<div class="modal-backdrop" @onclick="OnClose"></div>
<div class="modal-card" style="max-width: 950px; width: 95%; max-height: 90vh; display: flex; flex-direction: column;">
    <!-- HEADER -->
    <div class="modal-card__header d-flex justify-content-between align-items-center p-3 border-bottom">
        <div class="d-flex align-items-center">
            <div class="bg-primary-subtle p-2 rounded-3 me-3">
                <i class="bi bi-shield-lock-fill text-primary fs-4"></i>
            </div>
            <div>
                <h4 class="mb-0 fw-bold">Page Access Permissions</h4>
                <p class="text-muted small mb-0">Managing access for <strong>@Username</strong></p>
            </div>
            @if (Username.ToLower() == "admin")
            {
                <span class="badge bg-primary ms-3 shadow-sm">SYSTEM ADMIN</span>
            }
        </div>
        <button class="btn btn-light rounded-circle p-2" type="button" @onclick="OnClose">
            <i class="bi bi-x-lg"></i>
        </button>
    </div>

    <!-- BODY -->
    <div class="modal-card__body p-0 overflow-auto flex-grow-1">
        @if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <div class="alert alert-danger m-3 border-0 shadow-sm d-flex align-items-center">
                <i class="bi bi-exclamation-octagon-fill me-2 fs-5"></i>
                <div>@ErrorMessage</div>
            </div>
        }

        @* [REMOVED] Restrictive Admin check - showing pages for all users now *@
        <!-- SEARCH & ACTIONS BAR -->
        <div class="search-box-container p-3 border-bottom shadow-sm">
            <div class="row g-3 align-items-center">
                <div class="col-md-6">
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0">
                            <i class="bi bi-search text-muted"></i>
                        </span>
                        <input type="text" 
                               class="form-control border-start-0" 
                               placeholder="Search by page name, route or description..." 
                               @bind="_searchTerm" 
                               @bind:event="oninput" />
                    </div>
                </div>
                <div class="col-md-6 text-md-end">
                    @if (Username.ToLower() != "admin")
                    {
                        <div class="btn-group shadow-sm">
                            <button type="button" class="btn btn-outline-primary btn-sm px-3" @onclick="SelectAll">
                                <i class="bi bi-check-all me-1"></i> Grant All
                            </button>
                            <button type="button" class="btn btn-outline-secondary btn-sm px-3" @onclick="ClearAll">
                                <i class="bi bi-x-circle me-1"></i> Revoke All
                            </button>
                        </div>
                    }
                    else
                    {
                        <div class="d-inline-flex align-items-center bg-primary-subtle text-primary border border-primary-subtle px-3 py-1 rounded-pill">
                            <i class="bi bi-lightning-charge-fill me-2 rotate-gear"></i>
                            <span class="fw-bold small">MASTER PERMISSIONS ACTIVE</span>
                        </div>
                    }
                    <div class="d-inline-block ms-3">
                        <span class="badge bg-light text-dark border p-2">
                            <i class="bi bi-list-check me-1"></i> @(Username.ToLower() == "admin" ? AllPages.Count : SelectedPageIds.Count) of @(AllPages.Count) Pages
                        </span>
                    </div>
                </div>
            </div>
        </div>

            <div class="p-3">
                @if (Loading)
                {
                    <div class="text-center py-5">
                        <div class="spinner-grow text-primary" role="status"></div>
                        <p class="mt-3 text-muted">Analyzing system routes...</p>
                    </div>
                }
                else
        {
            @* Administrator Role Toggle *@
            @if (Username.ToLower() != "admin")
            {
                <div class="admin-toggle-panel p-3 mb-4 rounded-3 border d-flex flex-column gap-2" style="background: rgba(245, 158, 11, 0.05); border-color: rgba(245, 158, 11, 0.2) !important; margin: 15px;">
                    <div class="d-flex align-items-center justify-content-between">
                        <div class="d-flex align-items-center gap-3">
                            <div class="p-3 rounded-circle bg-warning bg-opacity-10 text-warning d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                                <i class="bi bi-shield-fill-check fs-4"></i>
                            </div>
                            <div>
                                <h6 class="mb-0 fw-bold text-warning-emphasis" style="letter-spacing: 0.05em;">SYSTEM ADMINISTRATOR ROLE</h6>
                                <div class="text-muted small">Grant full system-wide access (bypasses all specific page checks)</div>
                            </div>
                        </div>
                        <div class="modern-switch @(LocalIsAdmin ? "checked" : "")" 
                             @onclick="ToggleAdminRole"
                             style="transform: scale(1.2); cursor: pointer;"></div>
                    </div>
                </div>
            }

            var filteredCategories = GetFilteredPages();
                    if (!filteredCategories.Any())
                    {
                        <div class="empty-search-state">
                            <i class="bi bi-search"></i>
                            <h5>No matches found</h5>
                            <p>Try searching for a different keyword or part of a route.</p>
                            <button class="btn btn-link" @onclick="() => _searchTerm = string.Empty">Clear Search</button>
                        </div>
                    }
                else
                {
                    @foreach (var category in filteredCategories.Keys.OrderBy(k => k))
                    {

                        <div class="permission-category-header">
                            <div class="d-flex align-items-center">
                                <h6 class="mb-0 fw-bold">@category.ToUpper()</h6>
                                <span class="ms-2 category-stats">(@filteredCategories[category].Count pages)</span>
                            </div>
                            <button class="btn btn-link btn-sm text-decoration-none p-0" @onclick="() => ToggleCategory(category)">
                                <i class="bi @(IsCategoryExpanded(category) ? "bi-chevron-up" : "bi-chevron-down")"></i>
                            </button>
                        </div>

                        @if (IsCategoryExpanded(category))
                        {
                            @if (category.ToUpper() == "MOBILE" || category.ToUpper() == "MOBILE APPS" || category.ToUpper() == "GFC PORTAL (MOBILE)")
                            {
                                var hubPage = filteredCategories[category].FirstOrDefault(p => {
                                    var r = (p.PageRoute ?? "").Trim().TrimEnd('/').ToLower();
                                    if (!string.IsNullOrEmpty(r) && !r.StartsWith("/")) r = "/" + r;
                                    return r == "/mobile" || r == "/hub";
                                });
                                
                                <div class="master-access-panel p-3 mb-3 rounded-3 border d-flex flex-column gap-3" style="background: rgba(13, 110, 253, 0.03); border-color: rgba(13, 110, 253, 0.1) !important;">
                                    <div class="d-flex align-items-center justify-content-between">
                                        <div class="d-flex align-items-center gap-3">
                                            <div class="p-3 rounded-circle bg-primary bg-opacity-10 text-primary d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                                                <i class="bi bi-phone-vibrate fs-4"></i>
                                            </div>
                                            <div>
                                                <h6 class="mb-0 fw-bold text-primary" style="letter-spacing: 0.05em;">MOBILE APP ACCESS</h6>
                                                <div class="text-muted small">Master key for all mobile applications</div>
                                            </div>
                                        </div>
                                        @if (hubPage != null)
                                        {
                                            <div class="modern-switch @(SelectedPageIds.Contains(hubPage.PageId) ? "checked" : "")" 
                                                 @onclick="() => TogglePage(hubPage)"
                                                 style="transform: scale(1.2);"></div>
                                        }
                                    </div>
                                    <div class="alert alert-info py-2 px-3 mb-0 border-0 rounded-3 d-flex align-items-center" style="font-size: 0.85rem; background: rgba(13, 110, 253, 0.08); color: var(--app-primary); border-left: 4px solid var(--app-primary) !important;">
                                        <i class="bi bi-info-circle-fill me-2 fs-5"></i>
                                        <span><strong>REQUIRED:</strong> Enabling this switch is the <u>only way</u> to make this user appear on the GFC Mobile login grid.</span>
                                    </div>
                                </div>

                                if (hubPage != null && !SelectedPageIds.Contains(hubPage.PageId))
                                {
                                    <div class="text-center p-5 bg-light rounded-4 border border-dashed mb-4" style="background: #fdfdfd !important;">
                                        <div class="bg-white rounded-circle shadow-sm d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px;">
                                            <i class="bi bi-shield-lock text-muted" style="font-size: 2.5rem;"></i>
                                        </div>
                                        <h5 class="fw-bold text-dark">Mobile Permissions Locked</h5>
                                        <p class="text-muted mb-0 mx-auto" style="max-width: 300px;">Enable <strong>Mobile App Access</strong> above to manage specific tool permissions for this user.</p>
                                    </div>
                                }
                            }

                            <div class="row g-3">
                                @foreach (var appPage in filteredCategories[category])
                                {
                                    // 1. Skip the Hub page (Master Switch) - already shown at top
                                    var r = (appPage.PageRoute ?? "").Trim().TrimEnd('/').ToLower();
                                    if (!string.IsNullOrEmpty(r) && !r.StartsWith("/")) r = "/" + r;
                                    if (r == "/mobile" || r == "/hub") continue;
                                    
                                    // 2. Skip sub-pages (liquor hub handles these)
                                    if ((appPage.PageRoute ?? "").ToLower().StartsWith("/mobile/liquor/hub/")) continue;

                                    // 3. ABSOLUTE LOCKDOWN: Hide ONLY mobile tools if the Hub is off
                                    // This check MUST only apply to the mobile category
                                    if (category.ToUpper() == "MOBILE" || category.ToUpper() == "MOBILE APPS" || category.ToUpper() == "GFC PORTAL (MOBILE)")
                                    {
                                        var hubPageId = AllPages.FirstOrDefault(p => {
                                            var hr = (p.PageRoute ?? "").Trim().TrimEnd('/').ToLower();
                                            if (!string.IsNullOrEmpty(hr) && !hr.StartsWith("/")) hr = "/" + hr;
                                            return hr == "/mobile" || hr == "/hub";
                                        })?.PageId ?? -1;
                                        
                                        if (!SelectedPageIds.Contains(hubPageId)) continue;
                                    }

                                    <div class="col-md-6 col-lg-4">
                                        <div class="card h-100 permission-card @(LocalIsAdmin || SelectedPageIds.Contains(appPage.PageId) ? "granted" : "")"
                                             style="cursor: pointer;">
                                            <div class="card-body p-3">
                                                <div class="d-flex align-items-center justify-content-between mb-2">
                                                    <div class="d-flex align-items-center gap-3" @onclick="() => { if(!LocalIsAdmin) TogglePage(appPage); }">
                                                        <div class="p-2 rounded-circle bg-opacity-10 d-flex align-items-center justify-content-center @(LocalIsAdmin || SelectedPageIds.Contains(appPage.PageId) ? "bg-success text-success" : "bg-secondary text-secondary")" style="width: 40px; height: 40px;">
                                                            <i class="bi @GetPageIcon(appPage) fs-5"></i>
                                                        </div>
                                                        <h6 class="card-title fw-bold mb-0">@GetCleanPageName(appPage)</h6>
                                                    </div>
                                                    @if (LocalIsAdmin)
                                                    {
                                                        <div class="p-1 px-2 rounded-pill bg-success bg-opacity-10 text-success d-flex align-items-center gap-1 border border-success border-opacity-25" style="border-radius: 8px !important;">
                                                            <i class="bi bi-check2-circle fs-6"></i>
                                                            <span class="fw-black" style="font-size: 0.6rem; letter-spacing: 0.05em;">ACCESS</span>
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <div class="modern-switch @(SelectedPageIds.Contains(appPage.PageId) ? "checked" : "")" @onclick="() => TogglePage(appPage)"></div>
                                                    }
                                                </div>
                                                
                                                 @if ((LocalIsAdmin || SelectedPageIds.Contains(appPage.PageId)) && (SupportsPush(appPage) || SupportsEdit(appPage)))
                                                {
                                                    <div class="d-flex flex-column gap-2 pt-2 border-top mt-2 animate-fade-in">
                                                        @if (SupportsPush(appPage))
                                                        {
                                                            <div class="d-flex align-items-center justify-content-between">
                                                                <div class="d-flex align-items-center gap-2 text-muted small">
                                                                    <i class="bi bi-bell-fill @(LocalIsAdmin || PushEnabledPageIds.Contains(appPage.PageId) ? "text-warning" : "")"></i>
                                                                    <span>Push Notifications</span>
                                                                </div>
                                                                @if (!LocalIsAdmin)
                                                                {
                                                                    <div class="form-check form-switch mb-0">
                                                                        <input class="form-check-input" type="checkbox" role="switch" 
                                                                               checked="@PushEnabledPageIds.Contains(appPage.PageId)"
                                                                               @onchange="(e) => TogglePush(appPage.PageId, e)">
                                                                    </div>
                                                                }
                                                                else
                                                                {
                                                                    <span class="badge bg-light text-success border-0 p-0 fs-6"><i class="bi bi-check-all"></i></span>
                                                                }
                                                            </div>
                                                        }
                                                        
                                                        @if (SupportsEdit(appPage))
                                                        {
                                                            <div class="d-flex align-items-center justify-content-between">
                                                                <div class="d-flex align-items-center gap-2 text-muted small">
                                                                    <i class="bi bi-pencil-square @(LocalIsAdmin || EditEnabledPageIds.Contains(appPage.PageId) ? "text-primary" : "")"></i>
                                                                    <span>Edit Permission</span>
                                                                </div>
                                                                @if (!LocalIsAdmin)
                                                                {
                                                                    <div class="form-check form-switch mb-0">
                                                                        <input class="form-check-input" type="checkbox" role="switch" 
                                                                               checked="@EditEnabledPageIds.Contains(appPage.PageId)"
                                                                               @onchange="(e) => ToggleEdit(appPage.PageId, e)">
                                                                    </div>
                                                                }
                                                                else
                                                                {
                                                                    <span class="badge bg-light text-success border-0 p-0 fs-6"><i class="bi bi-check-all"></i></span>
                                                                }
                                                            </div>
                                                        }
                                                    </div>
                                                }

                                                @if (appPage.PageRoute?.ToLower() == "/mobile/liquor/hub")
                                                {
                                                    var liquorSubPages = AllPages.Where(p => (p.PageRoute?.ToLower() ?? "").StartsWith("/mobile/liquor/hub/")).ToList();
                                                    if (liquorSubPages.Any())
                                                    {
                                                        <div class="d-flex flex-column gap-2 pt-2 border-top mt-2 animate-fade-in">
                                                            <div class="text-muted small fw-bold mb-1" style="font-size: 0.75rem;">Liquor Hub Modules:</div>
                                                            @foreach (var subPage in liquorSubPages)
                                                            {
                                                                <div class="d-flex align-items-center justify-content-between ms-1">
                                                                    <div class="d-flex align-items-center gap-2 text-muted small">
                                                                        <i class="bi bi-diagram-3 pe-1 @(SelectedPageIds.Contains(subPage.PageId) ? "text-primary" : "")"></i>
                                                                        <span>@GetCleanPageName(subPage).Replace("Liquor Hub: ", "")</span>
                                                                    </div>
                                                                    <div class="form-check form-switch mb-0">
                                                                        <input class="form-check-input" type="checkbox" role="switch" 
                                                                               checked="@SelectedPageIds.Contains(subPage.PageId)"
                                                                               @onchange="(e) => TogglePage(subPage)">
                                                                    </div>
                                                                </div>
                                                            }
                                                        </div>
                                                    }
                                                }
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    }

                }
                }
            </div>
        }
    </div>

    <!-- FOOTER -->
    <div class="modal-card__actions p-3 border-top bg-light rounded-bottom-4 d-flex justify-content-between align-items-center">
        <div>
            @if (HasChanges)
            {
                <span class="text-primary small animate-pulse"><i class="bi bi-info-circle me-1"></i> You have unsaved changes</span>
            }
        </div>
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-outline-secondary px-4" @onclick="OnClose" disabled="@Saving">Close Window</button>
            @if (Username.ToLower() != "admin")
            {
                <button type="button" class="btn btn-primary px-4 shadow" @onclick="SavePermissions" disabled="@(Saving || !HasChanges)">
                    @if (Saving)
                    {
                        <span class="spinner-border spinner-border-sm me-2"></span>
                        <span>Saving...</span>
                    }
                    else
                    {
                        <i class="bi bi-shield-check me-2"></i>
                        <span>Apply Permissions</span>
                    }
                </button>
            }
        </div>
    </div>
</div>

@code {
    [Parameter] public int UserId { get; set; }
    [Parameter] public string Username { get; set; } = string.Empty;
    [Parameter] public bool IsAdmin { get; set; }
    [Parameter] public bool IsDirector { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }

    private bool Loading { get; set; } = true;
    private bool Saving { get; set; } = false;
    private string ErrorMessage { get; set; } = string.Empty;
    private string _searchTerm = string.Empty;
    private bool LocalIsAdmin { get; set; }
    
    private List<AppPage> AllPages { get; set; } = new();
    private Dictionary<string, List<AppPage>> PagesByCategory { get; set; } = new();
    private HashSet<int> SelectedPageIds { get; set; } = new();
    private HashSet<int> OriginalSelectedPageIds { get; set; } = new();
    private HashSet<int> PushEnabledPageIds { get; set; } = new();
    private HashSet<int> OriginalPushEnabledPageIds { get; set; } = new();
    private HashSet<int> EditEnabledPageIds { get; set; } = new();
    private HashSet<int> OriginalEditEnabledPageIds { get; set; } = new();
    private HashSet<string> CollapsedCategories { get; set; } = new();

    private bool HasChanges => LocalIsAdmin != IsAdmin ||
                              !SelectedPageIds.SetEquals(OriginalSelectedPageIds) || 
                              !PushEnabledPageIds.SetEquals(OriginalPushEnabledPageIds) ||
                              !EditEnabledPageIds.SetEquals(OriginalEditEnabledPageIds);

    private void ToggleAdminRole()
    {
        LocalIsAdmin = !LocalIsAdmin;
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        Loading = true;
        ErrorMessage = string.Empty;
        
        try
        {
            AllPages = await Task.Run(() => UserService.GetActivePages());
            
            // Auto-register Lottery Compliance page if it doesn't exist
            var compliancePage = AllPages.FirstOrDefault(p => (p.PageRoute ?? "").Trim('/', ' ').ToLower() == "lottery/compliance");
            if (compliancePage == null)
            {
                var newPage = new AppPage
                {
                    PageName = "Lottery Compliance",
                    PageRoute = "/lottery/compliance",
                    Description = "Lottery daily shift compliance tracking grid",
                    Category = "LOTTERY",
                    RequiresAdmin = true,
                    IsActive = true,
                    DisplayOrder = 38
                };
                await Task.Run(() => PageRepo.AddPage(newPage));
                // Reload pages
                AllPages = await Task.Run(() => UserService.GetActivePages());
            }

            // Auto-register Inventory Check (Mobile) page if it doesn't exist
            var countPage = AllPages.FirstOrDefault(p => (p.PageRoute ?? "").Trim('/', ' ').ToLower() == "mobile/liquor/hub/count");
            if (countPage == null)
            {
                var newPage = new AppPage
                {
                    PageName = "Inventory Check (Mobile)",
                    PageRoute = "/mobile/liquor/hub/count",
                    Description = "Reconcile product stock counts on mobile hub",
                    Category = "MOBILE APPS",
                    RequiresAdmin = false,
                    IsActive = true,
                    DisplayOrder = 135
                };
                await Task.Run(() => PageRepo.AddPage(newPage));
                // Reload pages
                AllPages = await Task.Run(() => UserService.GetActivePages());
            }

            // Auto-register Ordering List (Mobile) page if it doesn't exist
            var orderingPage = AllPages.FirstOrDefault(p => (p.PageRoute ?? "").Trim('/', ' ').ToLower() == "mobile/liquor/hub/ordering");
            if (orderingPage == null)
            {
                var newPage = new AppPage
                {
                    PageName = "Ordering List (Mobile)",
                    PageRoute = "/mobile/liquor/hub/ordering",
                    Description = "Place and manage product orders on mobile hub",
                    Category = "MOBILE APPS",
                    RequiresAdmin = false,
                    IsActive = true,
                    DisplayOrder = 136
                };
                await Task.Run(() => PageRepo.AddPage(newPage));
                // Reload pages
                AllPages = await Task.Run(() => UserService.GetActivePages());
            }
            
            foreach (var page in AllPages)
            {
                var r = (page.PageRoute ?? "").Trim().TrimEnd('/').ToLower();
                if (!string.IsNullOrEmpty(r) && !r.StartsWith("/")) r = "/" + r;
                if (r == "/lottery" || r == "/finance/lottery-summaries" || r == "/lottery/compliance")
                {
                    page.Category = "LOTTERY";
                }
                else if (r == "/finance/bar-sales" || r == "/admin/bar-sales" || r == "/finance/bar-lottery-sales")
                {
                    page.Category = "BAR";
                }
            }
            
            PagesByCategory = AllPages
                .GroupBy(p => p.Category ?? "Other")
                .ToDictionary(g => g.Key, g => g.OrderBy(p => p.DisplayOrder).ThenBy(p => p.PageName).ToList());
            
            if (Username.ToLower() != "admin")
            {
                LocalIsAdmin = IsAdmin;
                var userPermissions = await Task.Run(() => UserService.GetUserPagePermissions(UserId));
                SelectedPageIds = userPermissions.Select(p => p.PageId).ToHashSet();
                OriginalSelectedPageIds = new HashSet<int>(SelectedPageIds);
                
                PushEnabledPageIds = userPermissions.Where(p => p.ReceivePush).Select(p => p.PageId).ToHashSet();
                OriginalPushEnabledPageIds = new HashSet<int>(PushEnabledPageIds);

                EditEnabledPageIds = userPermissions.Where(p => p.CanEdit).Select(p => p.PageId).ToHashSet();
                OriginalEditEnabledPageIds = new HashSet<int>(EditEnabledPageIds);
            }
            else
            {
                LocalIsAdmin = true;
                // Root admins conceptually have everything
                SelectedPageIds = AllPages.Select(p => p.PageId).ToHashSet();
                OriginalSelectedPageIds = new HashSet<int>(SelectedPageIds);
                PushEnabledPageIds = new HashSet<int>(SelectedPageIds);
                EditEnabledPageIds = new HashSet<int>(SelectedPageIds);
            }

        }
        catch (Exception ex)
        {
            ErrorMessage = $"Failed to load page permissions: {ex.Message}";
        }
        finally
        {
            Loading = false;
        }
    }

    private Dictionary<string, List<AppPage>> GetFilteredPages()
    {
        var visiblePages = AllPages.Where(p => !IsHiddenPage(p));

        if (string.IsNullOrWhiteSpace(_searchTerm))
        {
            return visiblePages
                .GroupBy(p => p.Category ?? "Other")
                .ToDictionary(g => g.Key, g => g.OrderBy(p => p.DisplayOrder).ThenBy(p => p.PageName).ToList());
        }

        var term = _searchTerm.ToLower();
        return visiblePages
            .Where(p => p.PageName.ToLower().Contains(term) || 
                      p.PageRoute.ToLower().Contains(term) || 
                      (p.Description?.ToLower().Contains(term) ?? false) ||
                      (p.Category?.ToLower().Contains(term) ?? false))
            .GroupBy(p => p.Category ?? "Other")
            .ToDictionary(g => g.Key, g => g.ToList());
    }

    private void TogglePage(AppPage page)
    {
        // [MOD] Allow toggling any page, even if it requires admin (delegated access)
        if (SelectedPageIds.Contains(page.PageId))
        {
            SelectedPageIds.Remove(page.PageId);
            PushEnabledPageIds.Remove(page.PageId); // Auto-disable push if access is revoked
            
            // If we are unchecking the main Mobile Liquor Hub, automatically uncheck all its child sub-pages
            if (page.PageRoute?.ToLower() == "/mobile/liquor/hub")
            {
                var subPageIds = AllPages.Where(p => (p.PageRoute?.ToLower() ?? "").StartsWith("/mobile/liquor/hub/")).Select(p => p.PageId).ToList();
                foreach (var id in subPageIds)
                {
                    SelectedPageIds.Remove(id);
                }
            }
        }
        else
        {
            SelectedPageIds.Add(page.PageId);
        }
    }

    private void TogglePush(int pageId, ChangeEventArgs e)
    {
        bool isChecked = (bool)(e.Value ?? false);
        if (isChecked)
            PushEnabledPageIds.Add(pageId);
        else
            PushEnabledPageIds.Remove(pageId);
    }

    private bool SupportsPush(AppPage page)
    {
        var route = page.PageRoute?.ToLower() ?? "";
        return route.Contains("reimbursement") || 
               route.Contains("member-signup") || 
               route.Contains("dues") || 
               route.Contains("alert") || 
               route.Contains("controller");
    }

    private bool SupportsEdit(AppPage page)
    {
        var route = page.PageRoute?.ToLower().TrimStart('/') ?? "";
        var name = page.PageName?.ToLower() ?? "";
        
        // [NEW] specifically allow editing for Bar/Lottery sales entries
        // Check both the URL route and the Display Name to be safe
        return route.Contains("finance/bar-lottery-sales") || 
               name.Contains("bar/lottery sales") || 
               name.Contains("bar/lottery entries") ||
               name.Contains("bar lottery sales") ||
               name.Contains("bar lottery entries");
    }



    private void ToggleEdit(int pageId, ChangeEventArgs e)
    {
        bool isChecked = (bool)(e.Value ?? false);
        if (isChecked)
            EditEnabledPageIds.Add(pageId);
        else
            EditEnabledPageIds.Remove(pageId);
    }


    private void SelectAll()
    {
        // Grant all visible pages
        SelectedPageIds = AllPages
            .Where(p => !IsHiddenPage(p))
            .Select(p => p.PageId)
            .ToHashSet();
    }

    private void ClearAll()
    {
        SelectedPageIds.Clear();
    }

    private bool IsHiddenPage(AppPage page)
    {
        var route = (page.PageRoute ?? "").Trim().TrimEnd('/').ToLower();
        if (!string.IsNullOrEmpty(route) && !route.StartsWith("/")) route = "/" + route;

        // [MOD] Stop hiding the /mobile and /hub routes so they can be used as Master Switches
                                        // if (route == "/mobile" || route == "/hub") return true; 
                                        // Filter by common name tokens to handle naming inconsistencies
        var name = (page.PageName ?? "").ToLower();
        if (name.Contains("staff portal hub") || name.Contains("portal hub")) return true;

        return false;
    }

    private void ToggleCategory(string category)
    {
        if (CollapsedCategories.Contains(category))
            CollapsedCategories.Remove(category);
        else
            CollapsedCategories.Add(category);
    }

    private bool IsCategoryExpanded(string category) => !CollapsedCategories.Contains(category);

