            </div>
        </div>
    </div>
}

<!-- ========================================================================= -->
<!-- REPLY TO VISITOR INQUIRY MODAL -->
<!-- ========================================================================= -->
@if (_showReplyInquiryModal && _selectedEvent != null)
{
    var inqAppData = ParseApplicationDetails(_selectedEvent);
    var inqName = !string.IsNullOrWhiteSpace(_selectedRequest?.ApplicantName) ? _selectedRequest.ApplicantName : (inqAppData.ApplicantName ?? GetCleanTitle(_selectedEvent));

    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.75); z-index: 1060;" role="dialog">
        <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
            <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="modal-header bg-primary text-white p-3 px-4">
                    <h5 class="modal-title fw-bold mb-0 d-flex align-items-center gap-2">
                        <i class="bi bi-reply-all-fill"></i>
                        <span>Reply to Inquiry - @inqName</span>
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => _showReplyInquiryModal = false"></button>
                </div>
                <div class="modal-body p-4">
                    @if (!string.IsNullOrEmpty(_inquiryReplyError))
                    {
                        <div class="alert alert-danger py-2 px-3 small d-flex align-items-center gap-2 mb-3">
                            <i class="bi bi-exclamation-triangle-fill text-danger flex-shrink-0"></i>
                            <span>@_inquiryReplyError</span>
                        </div>
                    }

                    <div class="card border rounded-3 p-3 bg-light mb-3">
                        <div class="row g-2 small">
                            <div class="col-md-6 d-flex justify-content-between">
                                <span class="text-muted">Visitor Name:</span>
                                <span class="fw-bold text-dark">@inqName</span>
                            </div>
                            <div class="col-md-6 d-flex justify-content-between">
                                <span class="text-muted">Inquiry ID:</span>
                                <span class="fw-bold font-monospace text-primary">#@(_selectedRequest?.Id > 0 ? _selectedRequest.Id.ToString() : "New")</span>
