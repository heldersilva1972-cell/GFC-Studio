    private string GetCleanTitle(CalendarEventItem evt)
    {
        var title = evt.Title ?? string.Empty;
        
        // Strip [TEST] prefix if present
        if (title.StartsWith("[TEST]", StringComparison.OrdinalIgnoreCase))
        {
            title = title.Substring(6).Trim();
        }

        // Strip PENDING prefixes
        if (title.StartsWith("PENDING -", StringComparison.OrdinalIgnoreCase))
        {
            title = title.Substring(9).Trim();
        }
        else if (title.StartsWith("PENDING:", StringComparison.OrdinalIgnoreCase))
        {
            title = title.Substring(8).Trim();
        }
        else if (title.StartsWith("PENDING", StringComparison.OrdinalIgnoreCase))
        {
            title = title.Substring(7).Trim(' ', '-', ':').Trim();
        }

        // Strip APPROVED prefixes
        if (title.StartsWith("APPROVED -", StringComparison.OrdinalIgnoreCase))
        {
            title = title.Substring(10).Trim();
        }
        else if (title.StartsWith("APPROVED:", StringComparison.OrdinalIgnoreCase))
        {
            title = title.Substring(9).Trim();
        }
        else if (title.StartsWith("APPROVED", StringComparison.OrdinalIgnoreCase))
        {
            title = title.Substring(8).Trim(' ', '-', ':').Trim();
        }

        if (title.Contains('\n'))
        {
            var firstLine = title.Split(new[] { '\r', '\n' }, StringSplitOptions.RemoveEmptyEntries).FirstOrDefault();
            if (!string.IsNullOrWhiteSpace(firstLine)) title = firstLine.Trim();
        }

        return string.IsNullOrWhiteSpace(title) ? "Hall Rental Event" : title;
    }

    private bool IsClubEvent(CalendarEventItem? evt)
    {
        if (evt == null) return false;
        var desc = evt.Description ?? string.Empty;

        // If explicitly tagged as Club Event or Secondary Space Meeting / Internal
        if (desc.Contains("Category: Club Event", StringComparison.OrdinalIgnoreCase) ||
            desc.Contains("Event Category: Club Event", StringComparison.OrdinalIgnoreCase) ||
            desc.Contains("Meeting / Internal", StringComparison.OrdinalIgnoreCase) ||
            desc.Contains("Category: Meeting", StringComparison.OrdinalIgnoreCase))
        {
            return true;
        }

        // If it possesses hall rental / application structure, it is a rental
        if (desc.Contains("Preferred Event Date:", StringComparison.OrdinalIgnoreCase) ||
            desc.Contains("Hall Rental Application", StringComparison.OrdinalIgnoreCase) ||
            desc.Contains("Full Name (Applicant):", StringComparison.OrdinalIgnoreCase) ||
            desc.Contains("Contact Phone Number:", StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }

        // Check room location: if in secondary space (e.g. Office, Directors Room) and not a rental application, treat as internal meeting
        var evtRoomNorm = NormalizeRoomName(evt.Location);
        var managedLocNorm = NormalizeRoomName(_webSettings?.ManagedRentalLocation ?? "Function Hall");
        if (evtRoomNorm != managedLocNorm && evtRoomNorm != "entire facility")
        {
            return true;
        }

        if (FindMatchingRentalRequest(evt) != null)
        {
            return false;
        }

        // Check if calendar feed source is specifically a Rental vs Club Calendar
        if (!string.IsNullOrEmpty(evt.Source) && evt.Source.Contains("Rental", StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }

        // Otherwise check title convention
        var title = evt.Title ?? string.Empty;
        if (title.StartsWith("Hall Rental", StringComparison.OrdinalIgnoreCase) ||
            title.StartsWith("PENDING -", StringComparison.OrdinalIgnoreCase) ||
            title.StartsWith("PENDING:", StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }

        return true;
    }

