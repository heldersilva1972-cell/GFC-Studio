<!-- MANUAL PAYMENT RECORDING MODAL -->
<!-- ========================================================================= -->
@if (_showRecordPaymentModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.65);" role="dialog">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="modal-header bg-success text-white p-3 px-4">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-cash-coin fs-4"></i>
                        <h5 class="modal-title fw-bold mb-0">Record Payment / Deposit</h5>
                    </div>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => _showRecordPaymentModal = false"></button>
                </div>
                <EditForm Model="@_paymentModel" OnValidSubmit="SavePayment">
                    <div class="modal-body p-4">
                        @if (!string.IsNullOrEmpty(_paymentError))
                        {
                            <div class="alert alert-danger py-2 small">@_paymentError</div>
                        }

                        <div class="mb-3">
                            <label class="form-label fw-bold small">Payment Category *</label>
                            <select class="form-select" @bind="_paymentModel.PaymentType">
                                <option value="Security Deposit">Security Deposit</option>
                                <option value="Rental Fee">Rental Fee</option>
                                <option value="Bartender Fee">Bartender Fee</option>
                                <option value="Kitchen Fee">Kitchen Fee</option>
                                <option value="Extra Hours">Extra Hours</option>
                                <option value="Refund">Deposit Refund</option>
                            </select>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-6">
                                <label class="form-label fw-bold small">Amount ($) *</label>
                                <div class="input-group">
                                    <span class="input-group-text">$</span>
                                    <InputNumber class="form-control fw-bold" @bind-Value="_paymentModel.Amount" min="1" step="0.01" />
                                </div>
                            </div>
                            <div class="col-6">
                                <label class="form-label fw-bold small">Date Received *</label>
                                <InputDate class="form-control" @bind-Value="_paymentModel.PaymentDate" />
                            </div>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-6">
                                <label class="form-label fw-bold small">Payment Method</label>
                                <select class="form-select" @bind="_paymentModel.PaymentMethod">
                                    <option value="Check">Check</option>
                                    <option value="Cash">Cash</option>
                                    <option value="Venmo / Zelle">Venmo / Zelle</option>
                                    <option value="Credit / Debit Card">Credit / Debit Card</option>
                                    <option value="Dropped Off / In-Person">Dropped Off / In-Person</option>
                                </select>
                            </div>
                            <div class="col-6">
                                <label class="form-label fw-bold small">Check / Reference #</label>
                                <InputText class="form-control font-monospace" placeholder="e.g. Check #1042" @bind-Value="_paymentModel.ReferenceOrCheckNumber" />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold small">Notes / Description</label>
                            <InputTextArea class="form-control" rows="2" placeholder="Optional notes regarding this payment..." @bind-Value="_paymentModel.Notes" />
                        </div>
                    </div>
                    <div class="modal-footer bg-light border-top p-3 px-4 d-flex justify-content-between">
                        <button type="button" class="btn btn-outline-secondary" @onclick="() => _showRecordPaymentModal = false">Cancel</button>
                        <button type="submit" class="btn btn-success px-4 fw-bold shadow-sm" disabled="@_isSavingPayment">
                            @if (_isSavingPayment)
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span>
                                <span>Saving...</span>
                            }
                            else
                            {
                                <i class="bi bi-check-circle me-1"></i>
                                <span>Save Payment</span>
                            }
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

<!-- ========================================================================= -->
<!-- MANUAL TEST FORM / SIMULATOR ENTRY MODAL -->
<!-- ========================================================================= -->
@if (_showTestSimulatorModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.7); z-index: 1055;" role="dialog">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable" role="document">
            <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="modal-header bg-warning text-dark p-3 px-4">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-controller fs-4"></i>
                        <div>
                            <h5 class="modal-title fw-bold mb-0">Test Form Submission Simulator</h5>
                            <small class="text-dark-50">Enter manual data to test calculation, database recording, and notification routing</small>
                        </div>
                    </div>
                    <button type="button" class="btn-close" @onclick="() => _showTestSimulatorModal = false"></button>
                </div>

                <div class="modal-body p-4">
                    <!-- Preset Quick Fill Bar -->
                    <div class="p-3 bg-light rounded-3 border mb-4">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="small fw-bold text-dark"><i class="bi bi-lightning-charge-fill text-warning me-1"></i>Quick Preset Auto-Fill:</span>
                            <span class="badge bg-secondary">Sandbox Mode</span>
                        </div>
                        <div class="d-flex gap-2 flex-wrap">
                            <button type="button" class="btn btn-sm btn-outline-primary" @onclick='() => ApplyTestFormPreset("wedding")'>
                                Wedding Reception (Function Hall + Bar + Kitchen)
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-success" @onclick='() => ApplyTestFormPreset("birthday")'>
                                Birthday Party (Coalition Room)
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-info" @onclick='() => ApplyTestFormPreset("youth")'>
                                Youth Sports Banquet
                            </button>
                        </div>
                    </div>

                    <EditForm Model="@_manualTestModel" OnValidSubmit="SubmitManualTestSimulation">
                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label class="form-label fw-bold small">Applicant / Organization Name *</label>
                                <InputText class="form-control" placeholder="e.g. John Doe (Test Event)" @bind-Value="_manualTestModel.ApplicantName" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold small">Email Address *</label>
                                <InputText class="form-control" type="email" placeholder="test-applicant@example.com" @bind-Value="_manualTestModel.RequesterEmail" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold small">Phone Number</label>
                                <InputText class="form-control" placeholder="(978) 555-0199" @bind-Value="_manualTestModel.RequesterPhone" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold small">Desired Event Date *</label>
                                <InputDate class="form-control" @bind-Value="_manualTestModel.EventDate" />
                            </div>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-4">
                                <label class="form-label fw-bold small">Room Selection</label>
                                <select class="form-select" @bind="_manualTestModel.RoomSelected" @bind:after="RecalculateManualTestQuote">
                                    @foreach (var r in (_editableRooms.Any() ? _editableRooms : (_webSettings?.GetRoomsList() ?? new List<RentalRoomOption>())))
                                    {
                                        <option value="@r.Name">@r.Name (Capacity: @r.Capacity)</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-bold small">Event Type</label>
                                <InputText class="form-control" placeholder="e.g. Anniversary Party" @bind-Value="_manualTestModel.EventType" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-bold small">Guest Count</label>
                                <InputNumber class="form-control" @bind-Value="_manualTestModel.GuestCount" />
                            </div>
                        </div>

                        <!-- Membership & Options -->
                        <div class="card p-3 bg-light border-0 rounded-3 mb-3">
                            <label class="form-label fw-bold small mb-2">Applicant Status & Add-ons</label>
                            <div class="row g-2">
                                <div class="col-md-3">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" id="testMemCheck" @bind="_manualTestModel.MemberStatus" @bind:after="RecalculateManualTestQuote" />
                                        <label class="form-check-label small" for="testMemCheck">GFC Member Rate</label>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" id="testBarCheck" @bind="_manualTestModel.BartenderRequested" @bind:after="RecalculateManualTestQuote" />
                                        <label class="form-check-label small" for="testBarCheck">Bar Service</label>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" id="testKitchCheck" @bind="_manualTestModel.KitchenUsage" @bind:after="RecalculateManualTestQuote" />
                                        <label class="form-check-label small" for="testKitchCheck">Kitchen Access</label>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" id="testAvCheck" @bind="_manualTestModel.AvEquipmentUsage" @bind:after="RecalculateManualTestQuote" />
                                        <label class="form-check-label small" for="testAvCheck">AV / Projector</label>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Live Quote Calculation Preview -->
                        <div class="p-3 bg-light border rounded-3 d-flex justify-content-between align-items-center mb-3">
                            <div>
                                <small class="text-primary text-uppercase fw-bold">Simulated Calculated Total</small>
                                <h4 class="mb-0 text-success fw-bold">$@_manualTestModel.TotalPrice.ToString("N2")</h4>
                            </div>
                            <div class="text-end">
                                <small class="text-muted">Security Deposit: $@_manualTestModel.SecurityDepositAmount.ToString("N2")</small>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center">
                            <button type="button" class="btn btn-outline-secondary" @onclick="() => _showTestSimulatorModal = false">Cancel</button>
                            <button type="submit" class="btn btn-warning px-4 fw-bold shadow-sm text-dark" disabled="@_isSubmittingManualTest">
                                @if (_isSubmittingManualTest)
                                {
                                    <span class="spinner-border spinner-border-sm me-1"></span>
                                    <span>Simulating...</span>
                                }
                                else
                                {
                                    <i class="bi bi-send-check-fill me-1"></i>
                                    <span>Submit Test Simulation</span>
                                }
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

