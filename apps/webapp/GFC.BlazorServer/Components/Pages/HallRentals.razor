    private (string Title, string Description) FormatGoogleEventDetails(HallRentalRequest request, bool isTest)
    {
        string prefix = isTest ? "PENDING (TEST): " : "PENDING: ";
        string eventType = string.IsNullOrWhiteSpace(request.EventType) ? "Rental" : request.EventType;
        string roomName = string.IsNullOrWhiteSpace(request.RoomSelected) ? "Main Function Hall" : request.RoomSelected;

        var services = new List<string>();
        if (request.BartenderRequested && _settings.PushBarServiceToDescription)
        {
            var barName = !string.IsNullOrWhiteSpace(_settings.BarServiceCalendarDisplayName) ? _settings.BarServiceCalendarDisplayName : "Bar / Bartender Service";
            services.Add(barName);
        }
        if (request.KitchenUsage && _settings.PushKitchenUsageToDescription)
        {
            var kitchenName = !string.IsNullOrWhiteSpace(_settings.KitchenUsageCalendarDisplayName) ? _settings.KitchenUsageCalendarDisplayName : "Kitchen Access";
            services.Add(kitchenName);
        }
        if (request.AvEquipmentUsage && _settings.PushAvEquipmentToDescription)
        {
            var avName = !string.IsNullOrWhiteSpace(_settings.AvEquipmentCalendarDisplayName) ? _settings.AvEquipmentCalendarDisplayName : "A/V Equipment";
            services.Add(avName);
        }
        if (request.RequiresSetupTime) services.Add("Setup Time Requested");

        // Build Title dynamically based on ordered and enabled EventTitleFields
        var titleFields = _settings.EventTitleFields ?? GoogleCalendarSettings.GetDefaultGoogleTitleFields();
        var enabledOrderedFields = titleFields.Where(f => f.IsEnabled).OrderBy(f => f.Order).ToList();

        var titleSegments = new List<string>();
        foreach (var field in enabledOrderedFields)
        {
            switch (field.FieldKey)
            {
                case "applicant_name":
                    if (!string.IsNullOrWhiteSpace(request.ApplicantName))
                        titleSegments.Add(request.ApplicantName.Trim());
                    break;
                case "event_type":
                    if (!string.IsNullOrWhiteSpace(eventType))
                        titleSegments.Add(eventType.Trim());
                    break;
                case "room_location":
                    if (!string.IsNullOrWhiteSpace(roomName))
                        titleSegments.Add(roomName.Trim());
                    break;
                case "time_window":
                    if (!string.IsNullOrWhiteSpace(request.StartTime) && !string.IsNullOrWhiteSpace(request.EndTime))
                        titleSegments.Add($"{request.StartTime} - {request.EndTime}");
                    break;
                case "services":
                    if (services.Any())
                        titleSegments.Add(string.Join(", ", services));
                    break;
                case "guest_count":
                    if (request.GuestCount > 0)
                        titleSegments.Add($"{request.GuestCount} Guests");
                    break;
                case "pricing_quote":
                    if (request.TotalPrice > 0)
                        titleSegments.Add($"${request.TotalPrice:N0}");
                    break;
                case "contact_phone":
                    if (!string.IsNullOrWhiteSpace(request.RequesterPhone))
                        titleSegments.Add(request.RequesterPhone.Trim());
                    break;
                case "contact_email":
                    if (!string.IsNullOrWhiteSpace(request.RequesterEmail))
                        titleSegments.Add(request.RequesterEmail.Trim());
                    break;
            }
        }

        string title = titleSegments.Any() ? $"{prefix}{string.Join(" | ", titleSegments)}" : $"{prefix}{eventType}";

        var lines = new List<string>();

        if (_settings.PushApplicantNameToDescription && !string.IsNullOrWhiteSpace(request.ApplicantName))
        {
            lines.Add($"Applicant / Organization: {request.ApplicantName}");
        }

        if (_settings.PushApplicantPhoneToDescription && !string.IsNullOrWhiteSpace(request.RequesterPhone))
        {
            lines.Add($"Contact Phone: {request.RequesterPhone}");
        }

        if (_settings.PushApplicantEmailToDescription && !string.IsNullOrWhiteSpace(request.RequesterEmail))
        {
            lines.Add($"Email: {request.RequesterEmail}");
        }

        if (_settings.PushAddressToDescription && !string.IsNullOrWhiteSpace(request.RequesterAddress))
        {
            lines.Add($"Address: {request.RequesterAddress}");
        }

        if (!string.IsNullOrWhiteSpace(request.EventType))
        {
            lines.Add($"Event Type: {request.EventType}");
        }

        if (!string.IsNullOrWhiteSpace(request.RoomSelected))
        {
            lines.Add($"Room / Facility: {request.RoomSelected}");
        }

        if (_settings.PushGuestCountToDescription && request.GuestCount > 0)
        {
            lines.Add($"Estimated Attendance: {request.GuestCount} guests");
        }

        if (_settings.PushServicesToDescription && services.Any())
        {
            lines.Add($"Requested Services: {string.Join(", ", services)}");
        }

        if (_settings.PushPricingQuoteToDescription && request.TotalPrice > 0)
        {
            lines.Add($"Quoted Price: ${request.TotalPrice:N2}");
        }

        if (_settings.PushNotesToDescription && !string.IsNullOrWhiteSpace(request.InternalNotes))
        {
            lines.Add($"Applicant Notes: {request.InternalNotes}");
        }

        if (!lines.Any())
        {
            lines.Add($"GFC Hall Rental: {eventType}");
        }

        return (title, string.Join("\n", lines));
    }

    private string _blockOutMode = "none"; // "all", "selected", "none"
    private HashSet<string> _selectedBlockedSlotTimes = new(StringComparer.OrdinalIgnoreCase);
    private bool _showOnPublicCalendar = false;

    public class TimelineSegment
    {
        public string Title { get; set; } = string.Empty;
        public string Subtitle { get; set; } = string.Empty;
        public TimeSpan StartTime { get; set; }
        public TimeSpan EndTime { get; set; }
        public bool IsSlot { get; set; }
        public bool IsBooked { get; set; }
        public bool IsPending { get; set; }
        public bool IsSelected { get; set; }
        public bool HasConflict { get; set; }
        public string? BookedTitle { get; set; }
        public string? SlotKey { get; set; }
        public double DurationHours => (EndTime - StartTime).TotalHours;
    }

    private List<TimelineSegment> GetTimelineForDate(DateTime date, string room, TimeSpan currentSelectedStart, TimeSpan currentSelectedEnd)
    {
        var segments = new List<TimelineSegment>();
        var dayOfWeek = date.DayOfWeek;
        var daySchedules = _webSettings?.GetDaySchedulesList() ?? WebsiteSettings.GetDefaultDaySchedules();
        var scheduleForDay = daySchedules.FirstOrDefault(s => (int)s.DayOfWeek == (int)dayOfWeek || (int)s.Day == (int)dayOfWeek);

        var managedRoomNorm = NormalizeRoomName(_webSettings?.ManagedRentalLocation ?? "Function Hall");
        var targetRoomNorm = NormalizeRoomName(room);
        bool isPrimaryRentalRoom = targetRoomNorm == managedRoomNorm || targetRoomNorm == "entire facility";

        var configuredSlots = (isPrimaryRentalRoom && scheduleForDay != null && scheduleForDay.IsAvailable && scheduleForDay.Slots != null)
            ? scheduleForDay.Slots.Where(s => s.IsActive).ToList()
            : new List<DayScheduleSlotConfig>();

        // Day boundary: 7:00 AM to 11:00 PM (23:00)
        var dayStart = TimeSpan.FromHours(7);
        var dayEnd = TimeSpan.FromHours(23);

        // Get bookings on this date for this room
        var dayBookings = _events.Where(e =>
        {
            if (e.Start.Date != date.Date) return false;
            if (!_isNewEvent && _editEventModel != null && (e.Uid == _editEventModel.Uid || (!string.IsNullOrEmpty(e.GoogleEventId) && e.GoogleEventId == _editEventModel.GoogleEventId)))
                return false; // Skip the event currently being edited
            if (string.Equals(e.Status, "CANCELLED", StringComparison.OrdinalIgnoreCase) ||
                string.Equals(e.Status, "REJECTED", StringComparison.OrdinalIgnoreCase))
                return false;

            var evtRoomNorm = NormalizeRoomName(e.Location);
            bool roomOverlap = targetRoomNorm == "entire facility"
                || evtRoomNorm == "entire facility"
                || targetRoomNorm == evtRoomNorm;

            return roomOverlap;
        }).OrderBy(e => e.Start.TimeOfDay).ToList();

        // Check if there is an all-day blockout or full-day blackout club event on this date
        var fullDayBlockoutBooking = dayBookings.FirstOrDefault(b =>
            b.IsAllDay ||
            (b.Description != null && (
                b.Description.Contains("Block Out Rental Slots: Yes", StringComparison.OrdinalIgnoreCase) &&
                !b.Description.Contains("Specific Slots:", StringComparison.OrdinalIgnoreCase)
            ))
        );

        if (fullDayBlockoutBooking != null)
        {
            bool hasTimeSelected = currentSelectedStart != TimeSpan.Zero || currentSelectedEnd != TimeSpan.Zero;
            bool isPending = (
                fullDayBlockoutBooking.Status?.Equals("Pending", StringComparison.OrdinalIgnoreCase) == true ||
                fullDayBlockoutBooking.Status?.Equals("Inquiry", StringComparison.OrdinalIgnoreCase) == true ||
                fullDayBlockoutBooking.Title.Contains("PENDING", StringComparison.OrdinalIgnoreCase) ||
                fullDayBlockoutBooking.Title.Contains("INQUIRY", StringComparison.OrdinalIgnoreCase)
            );
            var cleanTitle = (fullDayBlockoutBooking.Title ?? "Reserved Event").Replace("PENDING:", "").Replace("INQUIRY:", "").Trim();

            segments.Add(new TimelineSegment
            {
                Title = cleanTitle,
                Subtitle = $"{FormatTimeSpan(dayStart)} - {FormatTimeSpan(dayEnd)} (All Day Blocked)",
                StartTime = dayStart,
                EndTime = dayEnd,
                IsSlot = false,
                IsBooked = true,
                IsPending = isPending,
                IsSelected = hasTimeSelected,
                HasConflict = hasTimeSelected,
                BookedTitle = fullDayBlockoutBooking.Title,
                SlotKey = null
            });

            return segments;
        }

        // Build time intervals list: all slot start/ends, booking start/ends, and 7 AM / 11 PM
        var keyPoints = new SortedSet<TimeSpan>();
        keyPoints.Add(dayStart);
        keyPoints.Add(dayEnd);

        foreach (var slot in configuredSlots)
        {
            var sStart = ParseFlexibleTimeSpan(slot.StartTime, TimeSpan.FromHours(8));
            var sEnd = ParseFlexibleTimeSpan(slot.EndTime, TimeSpan.FromHours(13));
            if (sStart >= dayStart && sStart <= dayEnd) keyPoints.Add(sStart);
            if (sEnd >= dayStart && sEnd <= dayEnd) keyPoints.Add(sEnd);
        }

        foreach (var b in dayBookings)
        {
            var bStart = b.Start.TimeOfDay;
            var bEnd = b.End.TimeOfDay;
            if (b.IsAllDay)
            {
                bStart = dayStart;
                bEnd = dayEnd;
            }
            if (bStart < dayStart) bStart = dayStart;
            if (bEnd > dayEnd) bEnd = dayEnd;
            if (bEnd <= bStart) bEnd = bStart.Add(TimeSpan.FromHours(2));

            keyPoints.Add(bStart);
            keyPoints.Add(bEnd);
        }

        var keyPointsList = keyPoints.ToList();
        for (int i = 0; i < keyPointsList.Count - 1; i++)
        {
            var segStart = keyPointsList[i];
            var segEnd = keyPointsList[i + 1];
            if (segEnd <= segStart) continue;

            // Check if EXACTLY matches a configured slot (start and end must match)
            var matchingSlot = configuredSlots.FirstOrDefault(s =>
            {
                var st = ParseFlexibleTimeSpan(s.StartTime, TimeSpan.FromHours(8));
                var et = ParseFlexibleTimeSpan(s.EndTime, TimeSpan.FromHours(13));
                return (segStart == st && segEnd == et);
            });

            // Check if overlaps an existing booking
            var overlappingBooking = dayBookings.FirstOrDefault(b =>
            {
                var bStart = b.IsAllDay ? dayStart : b.Start.TimeOfDay;
                var bEnd = b.IsAllDay ? dayEnd : b.End.TimeOfDay;
                if (bEnd <= bStart) bEnd = bStart.Add(TimeSpan.FromHours(2));
                return (segStart < bEnd && segEnd > bStart);
            });

            // Check if overlaps current user selection (only if user selected a time)
            bool hasTimeSelected = currentSelectedStart != TimeSpan.Zero || currentSelectedEnd != TimeSpan.Zero;
            bool isSelected = hasTimeSelected && (segStart < currentSelectedEnd && segEnd > currentSelectedStart);
            bool isPending = overlappingBooking != null && (
                overlappingBooking.Status?.Equals("Pending", StringComparison.OrdinalIgnoreCase) == true ||
                overlappingBooking.Status?.Equals("Inquiry", StringComparison.OrdinalIgnoreCase) == true ||
                overlappingBooking.Title.Contains("PENDING", StringComparison.OrdinalIgnoreCase) ||
                overlappingBooking.Title.Contains("INQUIRY", StringComparison.OrdinalIgnoreCase)
            );

            bool isBooked = overlappingBooking != null;
            bool hasConflict = isSelected && isBooked;

            string segTitle;
            string segSubtitle = $"{FormatTimeSpan(segStart)} - {FormatTimeSpan(segEnd)}";

            if (isBooked)
            {
                var cleanTitle = (overlappingBooking?.Title ?? "Reserved Event").Replace("PENDING:", "").Replace("INQUIRY:", "").Trim();
                segTitle = cleanTitle;
            }
            else if (matchingSlot != null)
            {
                segTitle = $"{FormatTimeSpan(ParseFlexibleTimeSpan(matchingSlot.StartTime, TimeSpan.Zero))} Slot";
            }
            else
            {
                segTitle = "Open Time";
            }

            segments.Add(new TimelineSegment
            {
                Title = segTitle,
                Subtitle = segSubtitle,
                StartTime = segStart,
                EndTime = segEnd,
                IsSlot = matchingSlot != null,
                IsBooked = isBooked,
                IsPending = isPending,
                IsSelected = isSelected,
                HasConflict = hasConflict,
                BookedTitle = overlappingBooking?.Title,
                SlotKey = matchingSlot != null ? $"{matchingSlot.StartTime}-{matchingSlot.EndTime}" : null
            });
        }

        return segments;
    }

    private static string FormatTimeSpan(TimeSpan ts)
    {
        int h = ts.Hours;
        int m = ts.Minutes;
        string ampm = h >= 12 ? "PM" : "AM";
        int displayH = h % 12;
        if (displayH == 0) displayH = 12;
        return m == 0 ? $"{displayH} {ampm}" : $"{displayH}:{m:D2} {ampm}";
    }

    private void SelectTimelineSegment(TimelineSegment seg)
    {
        if (seg.IsBooked) return; // Prevent selecting booked segments

        var targetDate = _isNewEvent ? (_recurrenceMode == "custom" ? _customDateToAdd : _singleEventDate) : _editEventDate;
        _singleStartTime = $"{seg.StartTime.Hours:D2}:{seg.StartTime.Minutes:D2}";
        _singleEndTime = $"{seg.EndTime.Hours:D2}:{seg.EndTime.Minutes:D2}";
        _editEventStartTime = _singleStartTime;
        _editEventEndTime = _singleEndTime;
        _editEventModel.Start = targetDate.Date.Add(seg.StartTime);
        _editEventModel.End = targetDate.Date.Add(seg.EndTime);
        StateHasChanged();
    }

