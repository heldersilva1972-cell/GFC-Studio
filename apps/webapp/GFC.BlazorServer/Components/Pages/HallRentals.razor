    private string GetCleanTitle(CalendarEventItem evt)
    {
        var title = evt.Title ?? string.Empty;
        
        // Strip [TEST] prefix if present
        if (title.StartsWith("[TEST]", StringComparison.OrdinalIgnoreCase))
        {
            title = title.Substring(6).Trim();
        }

        // Strip PENDING prefixes
        if (title.StartsWith("PENDING -", StringComparison.OrdinalIgnoreCase))
        {
            title = title.Substring(9).Trim();
        }
        else if (title.StartsWith("PENDING:", StringComparison.OrdinalIgnoreCase))
        {
            title = title.Substring(8).Trim();
        }
        else if (title.StartsWith("PENDING", StringComparison.OrdinalIgnoreCase))
        {
            title = title.Substring(7).Trim(' ', '-', ':').Trim();
        }

        // Strip APPROVED prefixes
        if (title.StartsWith("APPROVED -", StringComparison.OrdinalIgnoreCase))
        {
            title = title.Substring(10).Trim();
        }
        else if (title.StartsWith("APPROVED:", StringComparison.OrdinalIgnoreCase))
        {
            title = title.Substring(9).Trim();
        }
        else if (title.StartsWith("APPROVED", StringComparison.OrdinalIgnoreCase))
        {
            title = title.Substring(8).Trim(' ', '-', ':').Trim();
        }

        return string.IsNullOrWhiteSpace(title) ? "Hall Rental Event" : title;
    }

    private bool IsEventMatchingFilter(CalendarEventItem e)
    {
        if (!string.IsNullOrEmpty(_filterFeedSource) && e.Source != _filterFeedSource)
        {
            return false;
        }

        if (_filterCategory == "PENDING")
        {
            if (!IsEventPending(e)) return false;
        }
        else if (_filterCategory == "PAID")
        {
            if (GetEventPaymentStatus(e) != "Paid") return false;
        }
        else if (_filterCategory == "UNPAID")
        {
            if (GetEventPaymentStatus(e) == "Paid") return false;
        }
        else if (_filterCategory == "APPLICATIONS")
        {
            bool isApp = !string.IsNullOrEmpty(e.Description) && 
                         (e.Description.Contains("Hall Rental", StringComparison.OrdinalIgnoreCase) ||
                          e.Description.Contains("Preferred Event Date", StringComparison.OrdinalIgnoreCase) ||
                          e.Description.Contains("Applicant", StringComparison.OrdinalIgnoreCase) ||
                          e.Source == "Rental Booking" ||
                          e.Source == "Sandbox Booking");
            if (!isApp) return false;
        }

        if (!string.IsNullOrWhiteSpace(_searchTerm))
        {
            var q = _searchTerm.ToLowerInvariant();
            bool matchesSearch = e.Title.ToLower().Contains(q) ||
                                 (e.Description ?? "").ToLower().Contains(q) ||
                                 (e.Location ?? "").ToLower().Contains(q) ||
                                 e.Start.ToString("yyyy-MM-dd").Contains(q);
            if (!matchesSearch) return false;
        }

        return true;
    }

    private bool IsEventPending(CalendarEventItem evt)
    {
        if (evt.Title.Contains("PENDING", StringComparison.OrdinalIgnoreCase)) return true;
        if (string.Equals(evt.Status, "PENDING", StringComparison.OrdinalIgnoreCase)) return true;
        
        var appData = ParseApplicationDetails(evt);
        var cleanTitle = GetCleanTitle(evt);
        var matched = _cachedRentalRequests.FirstOrDefault(r => 
            r.EventDate.Date == evt.Start.Date && 
            (string.Equals(r.ApplicantName, appData.ApplicantName, StringComparison.OrdinalIgnoreCase) ||
             string.Equals(r.ApplicantName, cleanTitle, StringComparison.OrdinalIgnoreCase)));
        
        return matched != null && string.Equals(matched.Status, "Pending", StringComparison.OrdinalIgnoreCase);
    }

    private List<CalendarEventItem> GetEventsForDate(DateTime date)
    {
        return _events.Where(e => e.Start.Date == date.Date && IsEventMatchingFilter(e))
                      .OrderBy(e => e.Start)
                      .ToList();
    }

