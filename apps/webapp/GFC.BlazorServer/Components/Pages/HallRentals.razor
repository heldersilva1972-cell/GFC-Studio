    {
        _isNewEvent = true;
        _editEventError = null;
        _customDateAddError = null;
        _bookingCategory = "club";
        _recurrenceMode = "single";
        _singleEventDate = DateTime.Today.AddDays(7);
        _singleStartTime = "";
        _singleEndTime = "";
        _weeklyRepeatIntervalWeeks = 1;
        _weeklyEndDate = DateTime.Today.AddMonths(2);
