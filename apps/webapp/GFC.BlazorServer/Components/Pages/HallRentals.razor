    private string NormalizeRoomName(string? room)
    {
        if (string.IsNullOrWhiteSpace(room)) return "function hall";
        var r = room.Trim().ToLowerInvariant();
        if (r.Contains("office")) return "office";
        if (r.Contains("pavilion") || r.Contains("outdoor") || r.Contains("grounds")) return "pavilion";
        if (r.Contains("director") || r.Contains("board")) return "directors room";
        if (r.Contains("lounge") || r.Contains("bar")) return "member lounge";
        if (r.Contains("kitchen")) return "kitchen";
        if (r.Contains("entire") || r.Contains("full") || r.Contains("all facility") || r.Contains("whole")) return "entire facility";
        if (r.Contains("hall") || r.Contains("function")) return "function hall";
        return r;
    }

    private TimeSpan ParseFlexibleTimeSpan(string? timeStr, TimeSpan fallback)
    {
        if (string.IsNullOrWhiteSpace(timeStr)) return fallback;
        timeStr = timeStr.Trim();

        // 1. Direct 24-hr TimeSpan parse (e.g., "18:00", "08:30:00")
        if (TimeSpan.TryParse(timeStr, out var ts))
        {
            return ts;
        }

        // 2. 12-hr DateTime parse (e.g., "2:00 PM", "6:00pm", "14:00")
        if (DateTime.TryParse(timeStr, out var dt))
        {
            return dt.TimeOfDay;
        }

        // 3. Formatted custom time extraction
        var match = System.Text.RegularExpressions.Regex.Match(timeStr, @"^(\d{1,2}):(\d{2})(?::(\d{2}))?\s*(am|pm)?$", System.Text.RegularExpressions.RegexOptions.IgnoreCase);
        if (match.Success)
        {
            int h = int.Parse(match.Groups[1].Value);
            int m = int.Parse(match.Groups[2].Value);
            string meridiem = match.Groups[4].Value.ToLowerInvariant();
            if (meridiem == "pm" && h < 12) h += 12;
            if (meridiem == "am" && h == 12) h = 0;
            return new TimeSpan(h, m, 0);
        }

        return fallback;
    }

    private List<CalendarEventItem> GetBookingConflicts()
    {
        var conflicts = new List<CalendarEventItem>();
        if (_events == null || !_events.Any())
        {
            return conflicts;
        }

        var targetRoomNorm = NormalizeRoomName(_editEventModel.Location);
        var plannedDates = _isNewEvent ? GetPlannedDatesList() : new List<DateTime> { _editEventModel.Start.Date };

        if (!plannedDates.Any())
        {
            return conflicts;
        }

        if (_isNewEvent && (string.IsNullOrWhiteSpace(_singleStartTime) || string.IsNullOrWhiteSpace(_singleEndTime)))
        {
            return conflicts;
        }
        else if (!_isNewEvent && (string.IsNullOrWhiteSpace(_editEventStartTime) || string.IsNullOrWhiteSpace(_editEventEndTime)))
        {
            return conflicts;
        }

        TimeSpan startTimeSpan = ParseFlexibleTimeSpan(_singleStartTime, TimeSpan.Zero);
        TimeSpan endTimeSpan = ParseFlexibleTimeSpan(_singleEndTime, TimeSpan.Zero);

        if (!_isNewEvent)
        {
            startTimeSpan = ParseFlexibleTimeSpan(_editEventStartTime, _editEventModel.Start.TimeOfDay);
            endTimeSpan = ParseFlexibleTimeSpan(_editEventEndTime, _editEventModel.End.TimeOfDay);
        }

        if (endTimeSpan <= startTimeSpan)
        {
            endTimeSpan = startTimeSpan.Add(TimeSpan.FromHours(3));
        }

        foreach (var pDate in plannedDates)
        {
            var pStart = pDate.Date.Add(startTimeSpan);
            var pEnd = pDate.Date.Add(endTimeSpan);

            foreach (var evt in _events)
            {
                // Skip self if editing
                if (!_isNewEvent && (!string.IsNullOrEmpty(evt.GoogleEventId) && evt.GoogleEventId == _editEventModel.GoogleEventId || evt.Uid == _editEventModel.Uid))
                {
                    continue;
                }

                // Skip cancelled / rejected events
                if (string.Equals(evt.Status, "CANCELLED", StringComparison.OrdinalIgnoreCase) ||
                    string.Equals(evt.Status, "REJECTED", StringComparison.OrdinalIgnoreCase))
                {
                    continue;
                }

                // Check room overlap (entire facility overlaps everything, matching normalized rooms overlap)
                var evtRoomNorm = NormalizeRoomName(evt.Location);
                bool roomOverlap = targetRoomNorm == "entire facility"
                    || evtRoomNorm == "entire facility"
                    || targetRoomNorm == evtRoomNorm;

                if (!roomOverlap)
                {
                    continue;
                }

                // Convert evt.Start and evt.End to local time if stored as UTC
                var evtStartLocal = evt.Start.Kind == DateTimeKind.Utc ? evt.Start.ToLocalTime() : evt.Start;
                var evtEndLocal = evt.End.Kind == DateTimeKind.Utc ? evt.End.ToLocalTime() : evt.End;

                // Check time overlap
                bool isAllDayOrFullDayBlockout = evt.IsAllDay || (
                    evt.Description != null &&
                    evt.Description.Contains("Block Out Rental Slots: Yes", StringComparison.OrdinalIgnoreCase) &&
                    !evt.Description.Contains("Specific Slots:", StringComparison.OrdinalIgnoreCase)
                );

                if (isAllDayOrFullDayBlockout)
                {
                    // An all-day or full-day blackout event covers the entire date(s)
                    if (pDate.Date >= evtStartLocal.Date && pDate.Date <= evtEndLocal.Date)
                    {
                        if (!conflicts.Any(c => (c.Uid == evt.Uid && !string.IsNullOrEmpty(evt.Uid)) || (!string.IsNullOrEmpty(c.GoogleEventId) && c.GoogleEventId == evt.GoogleEventId) || (c.Start == evt.Start && c.Title == evt.Title)))
                        {
                            conflicts.Add(evt);
                        }
                    }
                }
                else
                {
                    // If event has invalid end time, assume standard 3-hour duration
                    if (evtEndLocal <= evtStartLocal)
                    {
                        evtEndLocal = evtStartLocal.AddHours(3);
                    }

                    // Strict interval overlap: (PlannedStart < ExistingEnd) && (PlannedEnd > ExistingStart)
                    if (pStart < evtEndLocal && pEnd > evtStartLocal)
                    {
                        if (!conflicts.Any(c => (c.Uid == evt.Uid && !string.IsNullOrEmpty(evt.Uid)) || (!string.IsNullOrEmpty(c.GoogleEventId) && c.GoogleEventId == evt.GoogleEventId) || (c.Start == evt.Start && c.Title == evt.Title)))
                        {
                            conflicts.Add(evt);
                        }
                    }
                }
            }
        }

        return conflicts;
    }

    private List<CalendarEventItem> GetConflictsForDateAndTimes(DateTime targetDate, string startTimeStr, string endTimeStr, string? roomLocation)
    {
        var conflicts = new List<CalendarEventItem>();
        if (_events == null || !_events.Any())
        {
            return conflicts;
        }

        var targetRoomNorm = NormalizeRoomName(roomLocation);
        var startTimeSpan = ParseFlexibleTimeSpan(startTimeStr, TimeSpan.FromHours(18));
        var endTimeSpan = ParseFlexibleTimeSpan(endTimeStr, TimeSpan.FromHours(21));
        if (endTimeSpan <= startTimeSpan) endTimeSpan = startTimeSpan.Add(TimeSpan.FromHours(3));

        var pStart = targetDate.Date.Add(startTimeSpan);
        var pEnd = targetDate.Date.Add(endTimeSpan);

        foreach (var evt in _events)
        {
            if (string.Equals(evt.Status, "CANCELLED", StringComparison.OrdinalIgnoreCase) ||
                string.Equals(evt.Status, "REJECTED", StringComparison.OrdinalIgnoreCase))
            {
                continue;
            }

            var evtRoomNorm = NormalizeRoomName(evt.Location);
            bool roomOverlap = targetRoomNorm == "entire facility"
                || evtRoomNorm == "entire facility"
                || targetRoomNorm == evtRoomNorm;

            if (!roomOverlap) continue;

            var evtStartLocal = evt.Start.Kind == DateTimeKind.Utc ? evt.Start.ToLocalTime() : evt.Start;
            var evtEndLocal = evt.End.Kind == DateTimeKind.Utc ? evt.End.ToLocalTime() : evt.End;

                bool isAllDayOrFullDayBlockout = evt.IsAllDay || (
                    evt.Description != null &&
                    evt.Description.Contains("Block Out Rental Slots: Yes", StringComparison.OrdinalIgnoreCase) &&
                    !evt.Description.Contains("Specific Slots:", StringComparison.OrdinalIgnoreCase)
                );

                if (isAllDayOrFullDayBlockout)
                {
                    if (targetDate.Date >= evtStartLocal.Date && targetDate.Date <= evtEndLocal.Date)
                    {
                        if (!conflicts.Any(c => c.Uid == evt.Uid || (!string.IsNullOrEmpty(c.GoogleEventId) && c.GoogleEventId == evt.GoogleEventId)))
                        {
                            conflicts.Add(evt);
                        }
                    }
                }
                else
                {
                    if (evtEndLocal <= evtStartLocal) evtEndLocal = evtStartLocal.AddHours(3);
                    if (pStart < evtEndLocal && pEnd > evtStartLocal)
                    {
                        if (!conflicts.Any(c => c.Uid == evt.Uid || (!string.IsNullOrEmpty(c.GoogleEventId) && c.GoogleEventId == evt.GoogleEventId)))
                        {
                            conflicts.Add(evt);
                        }
                    }
                }
        }

        return conflicts;
    }

    private List<CalendarEventItem> GetBookingsForDate(DateTime targetDate, string? roomLocation)
    {
        var list = new List<CalendarEventItem>();
        if (_events == null || !_events.Any()) return list;

        var targetRoomNorm = NormalizeRoomName(roomLocation);

        foreach (var evt in _events)
        {
            if (evt.Start.Date != targetDate.Date) continue;
            if (!_isNewEvent && _editEventModel != null && (evt.Uid == _editEventModel.Uid || (!string.IsNullOrEmpty(evt.GoogleEventId) && evt.GoogleEventId == _editEventModel.GoogleEventId)))
                continue;
            if (string.Equals(evt.Status, "CANCELLED", StringComparison.OrdinalIgnoreCase) ||
                string.Equals(evt.Status, "REJECTED", StringComparison.OrdinalIgnoreCase))
                continue;

            var evtRoomNorm = NormalizeRoomName(evt.Location);
            bool roomOverlap = targetRoomNorm == "entire facility"
                || evtRoomNorm == "entire facility"
                || targetRoomNorm == evtRoomNorm;

            if (roomOverlap && !list.Any(c => (c.Uid == evt.Uid && !string.IsNullOrEmpty(evt.Uid)) || (!string.IsNullOrEmpty(c.GoogleEventId) && c.GoogleEventId == evt.GoogleEventId) || (c.Start == evt.Start && c.Title == evt.Title)))
            {
                list.Add(evt);
            }
        }

        return list.OrderBy(e => e.Start).ToList();
    }

    private List<CalendarEventItem> GetBookingConflictsForRequest(HallRentalRequest req)
    {
        var conflicts = new List<CalendarEventItem>();
        if (_events == null || !_events.Any() || req == null)
        {
            return conflicts;
        }

        var targetRoomNorm = NormalizeRoomName(req.RoomSelected);
        var pDate = req.EventDate.Date;

        TimeSpan startTimeSpan = TimeSpan.FromHours(14);
        TimeSpan endTimeSpan = TimeSpan.FromHours(20);
        if (DateTime.TryParse(req.StartTime, out var ps)) startTimeSpan = ps.TimeOfDay;
        if (DateTime.TryParse(req.EndTime, out var pe)) endTimeSpan = pe.TimeOfDay;
        if (endTimeSpan <= startTimeSpan) endTimeSpan = startTimeSpan.Add(TimeSpan.FromHours(4));

        var pStart = pDate.Add(startTimeSpan);
        var pEnd = pDate.Add(endTimeSpan);

        foreach (var evt in _events)
        {
            // Skip cancelled / rejected events
            if (string.Equals(evt.Status, "CANCELLED", StringComparison.OrdinalIgnoreCase) ||
                string.Equals(evt.Status, "REJECTED", StringComparison.OrdinalIgnoreCase))
            {
                continue;
            }

            // Check room overlap
            var evtRoomNorm = NormalizeRoomName(evt.Location);
            bool roomOverlap = targetRoomNorm == "entire facility"
                || evtRoomNorm == "entire facility"
                || targetRoomNorm == evtRoomNorm;

            if (!roomOverlap)
            {
                continue;
            }

            var evtStartLocal = evt.Start.Kind == DateTimeKind.Utc ? evt.Start.ToLocalTime() : evt.Start;
            var evtEndLocal = evt.End.Kind == DateTimeKind.Utc ? evt.End.ToLocalTime() : evt.End;

            if (evt.IsAllDay)
            {
                if (pDate >= evtStartLocal.Date && pDate <= evtEndLocal.Date)
                {
                    if (!conflicts.Any(c => (c.Uid == evt.Uid && !string.IsNullOrEmpty(evt.Uid)) || (!string.IsNullOrEmpty(c.GoogleEventId) && c.GoogleEventId == evt.GoogleEventId) || (c.Start == evt.Start && c.Title == evt.Title)))
                    {
                        conflicts.Add(evt);
                    }
                }
            }
            else
            {
                if (evtEndLocal <= evtStartLocal)
                {
                    evtEndLocal = evtStartLocal.AddHours(3);
                }

                if (pStart < evtEndLocal && pEnd > evtStartLocal)
                {
                    if (!conflicts.Any(c => (c.Uid == evt.Uid && !string.IsNullOrEmpty(evt.Uid)) || (!string.IsNullOrEmpty(c.GoogleEventId) && c.GoogleEventId == evt.GoogleEventId) || (c.Start == evt.Start && c.Title == evt.Title)))
                    {
                        conflicts.Add(evt);
                    }
                }
            }
        }

        return conflicts;
    }
    
