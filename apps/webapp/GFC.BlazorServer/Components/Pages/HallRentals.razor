    private async Task ConfirmAndApproveBookingAsync()
    {
        if (_selectedEvent == null) return;
        _isApprovingBooking = true;

        try
        {
            var appData = ParseApplicationDetails(_selectedEvent);
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            string adminUser = authState.User.Identity?.Name ?? "Admin";

            // 1. Match or create request record
            if (_selectedRequest == null)
            {
                _selectedRequest = new HallRentalRequest
                {
                    ApplicantName = appData.ApplicantName ?? GetCleanTitle(_selectedEvent),
                    RequesterName = appData.ApplicantName ?? GetCleanTitle(_selectedEvent),
                    RequesterEmail = appData.Email ?? "",
                    RequesterPhone = appData.Phone ?? "",
                    EventDate = _selectedEvent.Start.Date,
                    RequestedDate = _selectedEvent.Start.Date,
                    StartTime = _selectedEvent.Start.ToString("h:mm tt"),
                    EndTime = _selectedEvent.End.ToString("h:mm tt"),
                    RoomSelected = _selectedEvent.Location ?? "Function Hall",
                    EventType = appData.EventType ?? "Hall Rental",
                    GuestCount = int.TryParse(appData.GuestCount, out var gc) ? gc : 50,
                    TotalPrice = GetEventPaymentSummary(_selectedEvent).TotalPrice,
                    SecurityDepositAmount = GetEventPaymentSummary(_selectedEvent).DepositRequired,
                    Status = "Approved"
                };
                await RentalService.CreateRentalRequestAsync(_selectedRequest);
            }
            else
            {
                _selectedRequest.Status = "Approved";
                _selectedRequest.StatusChangedBy = adminUser;
                _selectedRequest.StatusChangedDate = DateTime.UtcNow;

                var sbAudit = new System.Text.StringBuilder();
                sbAudit.AppendLine($"[{DateTime.Now:yyyy-MM-dd h:mm tt} by {adminUser}]");
                sbAudit.AppendLine($"• Booking Approved");
                if (!string.IsNullOrWhiteSpace(_approvalReasonNote))
                {
                    sbAudit.AppendLine($"• Approval Note: {_approvalReasonNote.Trim()}");
                }
                sbAudit.AppendLine();
                _selectedRequest.InternalNotes = (sbAudit.ToString() + (_selectedRequest.InternalNotes ?? "")).Trim();

                await RentalService.UpdateRentalRequestAsync(_selectedRequest);
            }

            // 2. Update Calendar Availability in DB
            try
            {
                await RentalService.UpdateCalendarAvailabilityAsync(_selectedRequest.EventDate.Date, "Booked", _selectedRequest.ApplicantName, _selectedRequest.StartTime, _selectedRequest.EndTime);
            }
            catch { }

            // 3. Update Google Calendar title to remove PENDING prefix
            var (eventTitle, eventDescription) = FormatGoogleEventDetails(_selectedRequest, _selectedRequest.IsTestRecord);
            var googleId = _selectedEvent.GoogleEventId ?? _selectedEvent.Uid;
            if (!string.IsNullOrEmpty(googleId) && _settings.EnableWriteApi)
            {
                try
                {
                    DateTime start = _selectedRequest.EventDate.Date.AddHours(14);
                    DateTime end = _selectedRequest.EventDate.Date.AddHours(20);
                    if (DateTime.TryParse(_selectedRequest.StartTime, out var ps)) start = _selectedRequest.EventDate.Date.Add(ps.TimeOfDay);
                    if (DateTime.TryParse(_selectedRequest.EndTime, out var pe)) end = _selectedRequest.EventDate.Date.Add(pe.TimeOfDay);

                    string calTitle = eventTitle.Replace("PENDING: ", "").Replace("PENDING - ", "").Replace("PENDING ", "").Trim();

                    var updatedCalItem = new CalendarEventItem
                    {
                        Uid = _selectedEvent.Uid,
                        GoogleEventId = googleId,
                        Title = calTitle,
                        Start = start,
                        End = end,
                        Location = _selectedRequest.RoomSelected ?? "Function Hall",
                        Description = eventDescription
                    };

                    await CalendarService.UpdateGoogleEventAsync(googleId, updatedCalItem, _settings);
                }
                catch (Exception gEx)
                {
                    System.Diagnostics.Debug.WriteLine($"Notice: Google Calendar sync warning during approval: {gEx.Message}");
                }
            }

            // 4. Update in-memory event state
            _selectedEvent.Title = $"{(_selectedRequest.IsTestRecord ? "[TEST] " : "")}{_selectedRequest.ApplicantName} ({_selectedRequest.EventType ?? "Rental"})";
            _selectedEvent.Location = _selectedRequest.RoomSelected ?? "Function Hall";
            _selectedEvent.Status = "CONFIRMED";
            _selectedEvent.Description = eventDescription;

            // 5. Send Approval Email if opted
            string? targetEmail = !string.IsNullOrWhiteSpace(_selectedRequest.RequesterEmail) ? _selectedRequest.RequesterEmail : appData.Email;
            if (_sendApprovalEmailOnConfirm && !string.IsNullOrWhiteSpace(targetEmail))
            {
                try
                {
                    var settings = await WebsiteSettingsService.GetWebsiteSettingsAsync();
                    if (settings != null)
                    {
                        string clubNameStr = string.IsNullOrWhiteSpace(settings.RentalFormSubtitle) ? "Gloucester Fraternity Club" : settings.RentalFormSubtitle;
                        string clubPhoneStr = string.IsNullOrWhiteSpace(settings.ClubPhone) ? "(978) 283-2889" : settings.ClubPhone;
                        string eventDateStr = _selectedRequest.EventDate.ToString("dddd, MMMM dd, yyyy");

                        string subject = settings.BookingApprovalEmailSubject ?? "Rental Booking Approved & Calendar Confirmed - {ClubName}";
                        subject = subject
                            .Replace("{ClubName}", clubNameStr)
                            .Replace("{ApplicantName}", _selectedRequest.ApplicantName ?? "Applicant")
