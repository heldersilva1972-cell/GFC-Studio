    private void PromptDeleteFeed(int index)
    {
        if (index >= 0 && index < _settings.Feeds.Count)
        {
            _feedDeleteIndex = index;
            _feedToDelete = _settings.Feeds[index];
            _showDeleteFeedConfirm = true;
        }
    }

    private void CancelDeleteFeed()
    {
        _showDeleteFeedConfirm = false;
        _feedToDelete = null;
        _feedDeleteIndex = -1;
    }

    private void ConfirmDeleteFeed()
    {
        if (_feedDeleteIndex >= 0 && _feedDeleteIndex < _settings.Feeds.Count)
        {
            _settings.Feeds.RemoveAt(_feedDeleteIndex);
        }
        CancelDeleteFeed();
    }

