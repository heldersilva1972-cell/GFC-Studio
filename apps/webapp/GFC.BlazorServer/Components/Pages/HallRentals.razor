                    ? $"{appData.StreetAddress}{(string.IsNullOrWhiteSpace(appData.City) ? "" : $", {appData.City}")}{(string.IsNullOrWhiteSpace(appData.State) ? "" : $", {appData.State}")}{(string.IsNullOrWhiteSpace(appData.Zip) ? "" : $" {appData.Zip}")}"
                    : "",
