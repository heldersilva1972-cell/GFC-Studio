    private void OpenEditEventModal(CalendarEventItem evt)
    {
        _isNewEvent = false;
        _editEventError = null;
        _bookingCategory = evt.Title.StartsWith("Hall Rental", StringComparison.OrdinalIgnoreCase) ? "rental" : "club";
        
        var startLocal = evt.Start.Kind == DateTimeKind.Utc ? evt.Start.ToLocalTime() : evt.Start;
        var endLocal = evt.End.Kind == DateTimeKind.Utc ? evt.End.ToLocalTime() : evt.End;

        _editEventDate = startLocal.Date;
        _editEventEndDate = endLocal.Date;
        _editEventStartTime = startLocal.ToString("HH:mm");
        _editEventEndTime = endLocal.ToString("HH:mm");

        // Parse whether this event had public calendar display enabled
        _showOnPublicCalendar = evt.Description != null && evt.Description.Contains("Show on Public Calendar: Yes", StringComparison.OrdinalIgnoreCase);

        // Parse whether this club event had block out rental slots enabled
        _selectedBlockedSlotTimes.Clear();
        if (evt.Description != null && evt.Description.Contains("Block Out Rental Slots: Yes", StringComparison.OrdinalIgnoreCase))
        {
            _blockOutDayForRentals = true;
            if (evt.Description.Contains("Specific Slots:", StringComparison.OrdinalIgnoreCase))
            {
                _blockOutMode = "selected";
                int idx = evt.Description.IndexOf("Specific Slots:", StringComparison.OrdinalIgnoreCase);
                int endIdx = evt.Description.IndexOf(')', idx);
                if (idx >= 0 && endIdx > idx)
                {
                    string slotsSub = evt.Description.Substring(idx + "Specific Slots:".Length, endIdx - (idx + "Specific Slots:".Length));
                    foreach (var s in slotsSub.Split(',', StringSplitOptions.RemoveEmptyEntries))
                    {
                        if (!string.IsNullOrWhiteSpace(s)) _selectedBlockedSlotTimes.Add(s.Trim());
                    }
                }
            }
            else
            {
                _blockOutMode = "all";
            }
        }
        else
        {
            _blockOutDayForRentals = false;
            _blockOutMode = "none";
        }

        // Strip system-generated header lines from editable notes textarea for clean editing
        string cleanEditableDesc = evt.Description ?? string.Empty;
        if (_bookingCategory == "club" && !string.IsNullOrWhiteSpace(cleanEditableDesc))
        {
            var descLines = cleanEditableDesc.Split(new[] { "\r\n", "\r", "\n" }, StringSplitOptions.None)
                .Where(l => !l.StartsWith("Category:", StringComparison.OrdinalIgnoreCase) &&
                            !l.StartsWith("Event Category:", StringComparison.OrdinalIgnoreCase) &&
                            !l.StartsWith("Block Out Rental Slots:", StringComparison.OrdinalIgnoreCase) &&
                            !l.StartsWith("Show on Public Calendar:", StringComparison.OrdinalIgnoreCase) &&
                            !l.StartsWith("Created By:", StringComparison.OrdinalIgnoreCase) &&
                            !l.StartsWith("Created:", StringComparison.OrdinalIgnoreCase) &&
                            !l.StartsWith("Modified By:", StringComparison.OrdinalIgnoreCase) &&
                            !l.StartsWith("Modified:", StringComparison.OrdinalIgnoreCase))
                .Select(l => l.StartsWith("Notes:", StringComparison.OrdinalIgnoreCase) ? l.Substring(6).Trim() : l)
                .ToList();
            cleanEditableDesc = string.Join("\n", descLines).Trim();
        }

        _editEventModel = new CalendarEventItem
        {
            Uid = evt.Uid,
            GoogleEventId = evt.GoogleEventId,
            Title = evt.Title,
            Start = startLocal,
            End = endLocal,
            Location = evt.Location,
            Description = cleanEditableDesc,
            Source = evt.Source,
            Status = evt.Status
        };
        _editEventTargetFeed = evt.Source ?? "Primary Calendar";
        _showEditEventModal = true;
    }

    private async Task SaveGoogleEvent()
    {
        if (string.IsNullOrWhiteSpace(_editEventModel.Title))
        {
            _editEventError = "Please enter an event title.";
            return;
        }

        if (_isNewEvent && (string.IsNullOrWhiteSpace(_singleStartTime) || string.IsNullOrWhiteSpace(_singleEndTime)))
        {
            _editEventError = "Please select a start and end time for the event.";
            return;
        }
        else if (!_isNewEvent && (string.IsNullOrWhiteSpace(_editEventStartTime) || string.IsNullOrWhiteSpace(_editEventEndTime)))
        {
            _editEventError = "Please select a start and end time for the event.";
            return;
        }

        var plannedDates = GetPlannedDatesList();
        if (_isNewEvent && plannedDates.Count == 0)
        {
            _editEventError = "Please select at least one valid date for the booking.";
            return;
        }

        var bookingConflicts = GetBookingConflicts();
        if (bookingConflicts.Any())
        {
            _editEventError = $"Cannot save booking: schedule conflict detected with {bookingConflicts.Count} existing booking(s). Please choose a different date or time.";
            return;
        }

        _isSavingEvent = true;
        _editEventError = null;

        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            string loggedInUser = authState.User.Identity?.Name ?? "Admin";

            var startTimeSpan = ParseFlexibleTimeSpan(_singleStartTime, TimeSpan.FromHours(18));
            var endTimeSpan = ParseFlexibleTimeSpan(_singleEndTime, TimeSpan.FromHours(21));
            if (endTimeSpan <= startTimeSpan) endTimeSpan = startTimeSpan.Add(TimeSpan.FromHours(3));

            int createdCount = 0;

            if (_isNewEvent)
            {
                // Format description based on event category
                string eventDesc = _editEventModel.Description ?? string.Empty;
                var currentManagedLoc = NormalizeRoomName(_webSettings?.ManagedRentalLocation ?? "Function Hall");
                var currentSelectedLoc = NormalizeRoomName(_editEventModel.Location);
                bool isManagedSpaceBooking = currentSelectedLoc == currentManagedLoc || currentSelectedLoc == "entire facility";
                string secondarySpaceLabel = _webSettings?.SecondaryFlexibleLocation ?? "Office";

                if (_bookingCategory == "club")
                {
                    var lines = new List<string>();
                    lines.Add(isManagedSpaceBooking ? "Category: Club Event" : $"Category: {secondarySpaceLabel} / Internal");
                    if (_showOnPublicCalendar)
                    {
                        lines.Add("Show on Public Calendar: Yes");
                    }
                    if (_blockOutMode == "all")
                    {
                        lines.Add("Block Out Rental Slots: Yes");
                    }
                    else if (_blockOutMode == "selected" && _selectedBlockedSlotTimes.Any())
                    {
                        lines.Add($"Block Out Rental Slots: Yes (Specific Slots: {string.Join(", ", _selectedBlockedSlotTimes)})");
                    }
                    lines.Add($"Created By: {loggedInUser}");
                    lines.Add($"Created: {DateTime.Now:MMMM dd, yyyy 'at' h:mm tt}");
                    if (!string.IsNullOrWhiteSpace(eventDesc))
                    {
                        lines.Add($"Notes: {eventDesc.Trim()}");
                    }
                    eventDesc = string.Join("\n", lines);
                }
                else
                {
                    var lines = new List<string>();
                    lines.Add("Category: Hall Rental Booking");
                    if (!string.IsNullOrWhiteSpace(_editApplicantName))
                    {
                        lines.Add($"Contact Name: {_editApplicantName.Trim()}");
                    }
                    if (!string.IsNullOrWhiteSpace(_editApplicantEmail))
                    {
                        lines.Add($"Email: {_editApplicantEmail.Trim()}");
                    }
                    if (!string.IsNullOrWhiteSpace(_editApplicantPhone))
                    {
                        lines.Add($"Phone: {_editApplicantPhone.Trim()}");
                    }
                    lines.Add($"Created By: {loggedInUser}");
                    lines.Add($"Created: {DateTime.Now:MMMM dd, yyyy 'at' h:mm tt}");
                    if (!string.IsNullOrWhiteSpace(eventDesc))
                    {
                        lines.Add($"Notes: {eventDesc.Trim()}");
                    }
                    eventDesc = string.Join("\n", lines);
                }

                foreach (var pDate in plannedDates)
                {
                    var eventInstance = new CalendarEventItem
                    {
                        Uid = Guid.NewGuid().ToString("N"),
                        Title = _editEventModel.Title.Trim(),
                        Start = pDate.Date.Add(startTimeSpan),
                        End = pDate.Date.Add(endTimeSpan),
                        Location = string.IsNullOrWhiteSpace(_editEventModel.Location) ? (_webSettings?.ManagedRentalLocation ?? "Function Hall") : _editEventModel.Location,
                        Description = eventDesc,
                        Source = _editEventTargetFeed
                    };

                    if (_settings.EnableWriteApi && !string.IsNullOrWhiteSpace(_settings.ServiceAccountEmail))
                    {
                        var result = await CalendarService.CreateGoogleEventAsync(eventInstance, _settings);
                        if (result.Success)
                        {
                            createdCount++;
                        }
                    }
                    else
                    {
                        _events.Insert(0, eventInstance);
                        createdCount++;
                    }

                    // If blocking out rental slots was requested for a club event, record in Availability ledger
                    if (_bookingCategory == "club")
                    {
                        try
                        {
                            if (_blockOutMode == "all")
                            {
                                await RentalService.UpdateCalendarAvailabilityAsync(
                                    pDate.Date, 
                                    "Blackout", 
                                    $"Club Event: {_editEventModel.Title.Trim()}", 
                                    null, 
                                    null
                                );
                            }
                            else if (_blockOutMode == "selected" && _selectedBlockedSlotTimes.Any())
                            {
                                // Block out each selected specific slot window
                                foreach (var slotTime in _selectedBlockedSlotTimes)
                                {
                                    var parts = slotTime.Split('-');
                                    var sStart = parts.Length > 0 ? parts[0].Trim() : "";
                                    var sEnd = parts.Length > 1 ? parts[1].Trim() : "";
                                    await RentalService.UpdateCalendarAvailabilityAsync(
                                        pDate.Date,
                                        "Blackout",
                                        $"Club Event: {_editEventModel.Title.Trim()}",
                                        sStart,
                                        sEnd
                                    );
                                }
                            }
                        }
                        catch (Exception ex)
                        {
                            System.Diagnostics.Debug.WriteLine($"Notice: Failed to update availability blackout for date {pDate:yyyy-MM-dd}: {ex.Message}");
                        }
                    }
                }

                if (_settings.EnableWriteApi && !string.IsNullOrWhiteSpace(_settings.ServiceAccountEmail))
                {
                    _syncMessage = $"Successfully created {createdCount} event occurrence(s) in Google Calendar!" + (_blockOutDayForRentals && _bookingCategory == "club" ? " (Rental availability blocked for the date(s))" : "");
                }
                else
                {
                    _syncMessage = $"Added {createdCount} event occurrence(s) to the schedule." + (_blockOutDayForRentals && _bookingCategory == "club" ? " (Rental availability blocked for the date(s))" : "");
                }
                _syncSuccess = true;
            }
            else
            {
                if (_editEventModel.End <= _editEventModel.Start)
                {
                    _editEventError = "End date & time must be after the start date & time.";
                    _isSavingEvent = false;
                    return;
                }

                // Format description for edit mode
                var currentManagedLoc = NormalizeRoomName(_webSettings?.ManagedRentalLocation ?? "Function Hall");
                var currentSelectedLoc = NormalizeRoomName(_editEventModel.Location);
                bool isManagedSpaceBooking = currentSelectedLoc == currentManagedLoc || currentSelectedLoc == "entire facility";
                string secondarySpaceLabel = _webSettings?.SecondaryFlexibleLocation ?? "Office";

                if (_bookingCategory == "club")
                {
                    var lines = new List<string>();
                    lines.Add(isManagedSpaceBooking ? "Category: Club Event" : $"Category: {secondarySpaceLabel} / Internal");
                    if (_showOnPublicCalendar)
                    {
                        lines.Add("Show on Public Calendar: Yes");
                    }
                    if (_blockOutMode == "all")
                    {
                        lines.Add("Block Out Rental Slots: Yes");
                    }
                    else if (_blockOutMode == "selected" && _selectedBlockedSlotTimes.Any())
                    {
                        lines.Add($"Block Out Rental Slots: Yes (Specific Slots: {string.Join(", ", _selectedBlockedSlotTimes)})");
                    }
                    lines.Add($"Modified By: {loggedInUser}");
                    lines.Add($"Modified: {DateTime.Now:MMMM dd, yyyy 'at' h:mm tt}");
                    if (!string.IsNullOrWhiteSpace(_editEventModel.Description))
                    {
                        lines.Add($"Notes: {_editEventModel.Description.Trim()}");
                    }
                    _editEventModel.Description = string.Join("\n", lines);
                }

                if (_settings.EnableWriteApi && !string.IsNullOrWhiteSpace(_settings.ServiceAccountEmail))
                {
                    var eventId = _editEventModel.GoogleEventId ?? _editEventModel.Uid;
                    var result = await CalendarService.UpdateGoogleEventAsync(eventId, _editEventModel, _settings);
                    if (!result.Success)
                    {
                        _editEventError = result.Message;
                        return;
                    }
                    _syncMessage = "Event updated successfully in Google Calendar!";
                    _syncSuccess = true;
                }
                else
                {
                    var existing = _events.FirstOrDefault(e => e.Uid == _editEventModel.Uid);
                    if (existing != null)
                    {
                        existing.Title = _editEventModel.Title;
                        existing.Start = _editEventModel.Start;
                        existing.End = _editEventModel.End;
                        existing.Location = _editEventModel.Location;
                        existing.Description = _editEventModel.Description;
                    }
                    _syncMessage = "Event updated in local schedule.";
                    _syncSuccess = true;
                }

                // Sync availability ledger for edited club event
                if (_bookingCategory == "club")
                {
                    try
                    {
                        if (_blockOutDayForRentals)
                        {
                            await RentalService.UpdateCalendarAvailabilityAsync(
                                _editEventModel.Start.Date, 
                                "Blackout", 
                                $"Club Event: {_editEventModel.Title.Trim()}", 
                                null, 
                                null
                            );
                        }
                        else
                        {
                            await RentalService.UpdateCalendarAvailabilityAsync(_editEventModel.Start.Date, "Available");
                        }
                    }
                    catch (Exception ex)
                    {
                        System.Diagnostics.Debug.WriteLine($"Notice: Failed to update availability for edited club event on {_editEventModel.Start:yyyy-MM-dd}: {ex.Message}");
                    }
                }
            }

            _showEditEventModal = false;
            _selectedEvent = null;
            if (_settings.EnableWriteApi && !string.IsNullOrWhiteSpace(_settings.ServiceAccountEmail))
            {
                await SyncCalendarNow();
            }
        }
        catch (Exception ex)
        {
            _editEventError = $"Failed to save event: {ex.Message}";
        }
        finally
        {
            _isSavingEvent = false;
        }
    }

