                            </div>
                            <div class="col-12 d-flex justify-content-between border-bottom pb-2">
                                <span class="text-muted">Total Quoted:</span>
                                <span class="fw-bold text-dark">$@remTotalPrice.ToString("N2")</span>
                            </div>
                            <div class="col-12 d-flex justify-content-between border-bottom pb-2">
                                <span class="text-muted">Total Received:</span>
                                <span class="fw-bold text-success">$@remPaid.ToString("N2")</span>
