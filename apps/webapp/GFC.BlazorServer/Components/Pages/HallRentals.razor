    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(15,23,42,0.65); z-index: 1055; backdrop-filter: blur(4px);" role="dialog">
        <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable" role="document">
            <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="modal-header border-bottom py-3 px-4 bg-light d-flex justify-content-between align-items-center">
                    <div class="d-flex align-items-center gap-2">
                        <div class="p-2 rounded-3 bg-primary bg-opacity-10 text-primary">
                            <i class="bi bi-bar-chart-fill fs-5"></i>
                        </div>
