<!-- PROFESSIONAL 1-PAGE PRINTABLE APPLICATION TEMPLATE (PRINT / SAVE TO PDF) -->
@if (_selectedEvent != null)
{
    var printAppDetails = ParseApplicationDetails(_selectedEvent);
    var printCleanTitle = GetCleanTitle(_selectedEvent);
    var printPaySummary = GetEventPaymentSummary(_selectedEvent);
    var printAgreedPolicies = GetAcceptedPoliciesForDisplay(_selectedRequest, printAppDetails);

    string printName = !string.IsNullOrWhiteSpace(_selectedRequest?.ApplicantName)
        ? _selectedRequest.ApplicantName
        : (!string.IsNullOrWhiteSpace(printAppDetails.ApplicantName) ? printAppDetails.ApplicantName : printCleanTitle);

    string printPhone = !string.IsNullOrWhiteSpace(_selectedRequest?.RequesterPhone)
        ? _selectedRequest.RequesterPhone
        : (printAppDetails.Phone ?? "N/A");

    string printEmail = !string.IsNullOrWhiteSpace(_selectedRequest?.RequesterEmail)
        ? _selectedRequest.RequesterEmail
        : (printAppDetails.Email ?? "N/A");

    string printAddress = !string.IsNullOrWhiteSpace(_selectedRequest?.RequesterAddress)
        ? $"{_selectedRequest.RequesterAddress}{(!string.IsNullOrWhiteSpace(_selectedRequest.RequesterCity) ? $", {_selectedRequest.RequesterCity}" : "")}{(!string.IsNullOrWhiteSpace(_selectedRequest.RequesterState) ? $", {_selectedRequest.RequesterState}" : "")}{(!string.IsNullOrWhiteSpace(_selectedRequest.RequesterZip) ? $" {_selectedRequest.RequesterZip}" : "")}"
        : (!string.IsNullOrWhiteSpace(printAppDetails.StreetAddress)
            ? $"{printAppDetails.StreetAddress}{(string.IsNullOrWhiteSpace(printAppDetails.City) ? "" : $", {printAppDetails.City}")}{(string.IsNullOrWhiteSpace(printAppDetails.State) ? "" : $", {printAppDetails.State}")}{(string.IsNullOrWhiteSpace(printAppDetails.Zip) ? "" : $" {printAppDetails.Zip}")}"
            : "None Provided");

    string printSignature = !string.IsNullOrWhiteSpace(_selectedRequest?.ApplicantSignature)
        ? _selectedRequest.ApplicantSignature
        : (!string.IsNullOrWhiteSpace(printAppDetails.ApplicantSignature) ? printAppDetails.ApplicantSignature : "Electronic Signature on Record");

    string printTimestamp = _selectedRequest != null && _selectedRequest.CreatedDate.Year > 2000
        ? _selectedRequest.CreatedDate.ToLocalTime().ToString("MMMM dd, yyyy 'at' h:mm tt")
        : (!string.IsNullOrEmpty(printAppDetails.FormattedTimestamp) ? printAppDetails.FormattedTimestamp : DateTime.Now.ToString("MMMM dd, yyyy 'at' h:mm tt"));

    string printEventDate = _selectedRequest != null && _selectedRequest.EventDate.Year > 2000
        ? _selectedRequest.EventDate.ToString("dddd, MMMM dd, yyyy")
        : (_selectedEvent.Start.Year > 2000 ? _selectedEvent.Start.ToString("dddd, MMMM dd, yyyy") : (printAppDetails.PreferredEventDate ?? "TBD"));

    string printTimeRange = (_selectedRequest != null && !string.IsNullOrEmpty(_selectedRequest.StartTime) && !string.IsNullOrEmpty(_selectedRequest.EndTime))
        ? $"{_selectedRequest.StartTime} - {_selectedRequest.EndTime}"
        : ((!string.IsNullOrEmpty(printAppDetails.StartTime) && !string.IsNullOrEmpty(printAppDetails.EndTime)) ? $"{printAppDetails.StartTime} - {printAppDetails.EndTime}" : "TBD");

    string statusClass = (_selectedRequest?.Status == "Approved" || _selectedEvent.Title.Contains("APPROVED", StringComparison.OrdinalIgnoreCase)) ? "status-approved" : "status-pending";
    string statusText = (_selectedRequest?.Status ?? (_selectedEvent.Title.Contains("APPROVED", StringComparison.OrdinalIgnoreCase) ? "Approved" : "Pending Review")).ToUpper();

    <div id="gfc-printable-application" class="d-none d-print-block print-container">
        <!-- 1. Executive Header -->
        <div class="print-brand-header">
            <div class="print-brand-left">
                <h1 class="print-org-name">GLOUCESTER FRATERNITY CLUB</h1>
                <div class="print-org-sub">27 Webster Street, Gloucester, MA 01930 &bull; (978) 283-2889 &bull; info@gloucesterfraternityclub.com</div>
            </div>
            <div class="print-brand-right">
                <div class="print-badge @statusClass">@statusText</div>
                <div class="print-meta-date">Printed: @DateTime.Now.ToString("MMM dd, yyyy")</div>
            </div>
        </div>

        <div class="print-doc-title-bar">
            <span>HALL RENTAL APPLICATION &amp; AGREEMENT RECORD</span>
            <span class="print-ref-id">Ref #@((_selectedRequest?.Id > 0) ? _selectedRequest.Id.ToString() : "REC-" + _selectedEvent.Start.ToString("yyyyMMdd"))</span>
        </div>

        <!-- 2. Two-Column Information Layout -->
        <div class="print-grid-2col">
            <!-- Left Column: Applicant & Event Details -->
            <div class="print-col">
                <div class="print-card">
                    <div class="print-card-header">
                        <span class="print-card-title">1. APPLICANT &amp; CONTACT DETAILS</span>
                    </div>
                    <div class="print-card-body">
                        <div class="print-field-row">
                            <span class="print-lbl">Applicant / Org:</span>
                            <span class="print-val fw-bold">@printName</span>
                        </div>
                        <div class="print-field-row">
                            <span class="print-lbl">Membership:</span>
                            <span class="print-val">@(_selectedRequest?.MemberStatus == true ? "Active Member" : "Non-Member")</span>
                        </div>
                        <div class="print-field-row">
                            <span class="print-lbl">Contact Phone:</span>
                            <span class="print-val">@printPhone</span>
                        </div>
                        <div class="print-field-row">
                            <span class="print-lbl">Email Address:</span>
                            <span class="print-val">@printEmail</span>
                        </div>
                        <div class="print-field-row">
                            <span class="print-lbl">Mailing Address:</span>
                            <span class="print-val">@printAddress</span>
                        </div>
                    </div>
                </div>

                <div class="print-card mt-2">
                    <div class="print-card-header">
                        <span class="print-card-title">2. EVENT SPECIFICATIONS</span>
                    </div>
                    <div class="print-card-body">
                        <div class="print-field-row">
                            <span class="print-lbl">Event Date:</span>
                            <span class="print-val fw-bold">@printEventDate</span>
                        </div>
                        <div class="print-field-row">
                            <span class="print-lbl">Time Range:</span>
                            <span class="print-val">@printTimeRange</span>
                        </div>
                        <div class="print-field-row">
                            <span class="print-lbl">Facility Room:</span>
                            <span class="print-val fw-bold">@(_selectedRequest?.RoomSelected ?? _selectedEvent.Location ?? "Function Hall")</span>
                        </div>
                        <div class="print-field-row">
                            <span class="print-lbl">Event Occasion:</span>
                            <span class="print-val">@(_selectedRequest?.EventType ?? printAppDetails.EventType ?? "General Rental")</span>
                        </div>
                        <div class="print-field-row">
                            <span class="print-lbl">Guest Attendance:</span>
                            <span class="print-val">@(_selectedRequest?.GuestCount > 0 ? _selectedRequest.GuestCount.ToString() : (printAppDetails.GuestCount ?? "Unspecified")) guests</span>
                        </div>
                        <div class="print-field-row">
                            <span class="print-lbl">Setup Time:</span>
                            <span class="print-val">@(_selectedRequest?.RequiresSetupTime == true ? "Yes (Requested)" : (printAppDetails.SetupTimeRequired ?? "No"))</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right Column: Services & Financial Breakdown -->
            <div class="print-col">
                <div class="print-card">
                    <div class="print-card-header">
                        <span class="print-card-title">3. AMENITIES &amp; SERVICES</span>
                    </div>
                    <div class="print-card-body">
                        <div class="print-service-grid">
                            <div class="print-service-item @(_selectedRequest?.BartenderRequested == true ? "active" : "")">
                                <span class="print-svc-icon">@(_selectedRequest?.BartenderRequested == true ? "☑" : "☐")</span>
                                <span class="print-svc-name">Bar / Bartender Service</span>
                            </div>
                            <div class="print-service-item @(_selectedRequest?.KitchenUsage == true ? "active" : "")">
                                <span class="print-svc-icon">@(_selectedRequest?.KitchenUsage == true ? "☑" : "☐")</span>
                                <span class="print-svc-name">Kitchen Access</span>
                            </div>
                            <div class="print-service-item @(_selectedRequest?.AvEquipmentUsage == true ? "active" : "")">
                                <span class="print-svc-icon">@(_selectedRequest?.AvEquipmentUsage == true ? "☑" : "☐")</span>
                                <span class="print-svc-name">A/V Sound &amp; Projector</span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="print-card mt-2">
                    <div class="print-card-header">
                        <span class="print-card-title">4. FINANCIAL SUMMARY &amp; PAYMENTS</span>
                    </div>
                    <div class="print-card-body p-0">
                        <div class="print-ledger-tiles">
                            <div class="print-tile">
                                <span class="print-tile-lbl">Total Quoted</span>
                                <span class="print-tile-val fw-bold">$@printPaySummary.TotalPrice.ToString("N2")</span>
                            </div>
                            <div class="print-tile">
                                <span class="print-tile-lbl">Security Deposit</span>
                                <span class="print-tile-val">$@printPaySummary.DepositRequired.ToString("N2")</span>
                            </div>
                            <div class="print-tile highlight-green">
                                <span class="print-tile-lbl">Total Paid</span>
                                <span class="print-tile-val">$@printPaySummary.TotalPaid.ToString("N2")</span>
                            </div>
                            <div class="print-tile @(printPaySummary.RemainingBalance > 0 ? "highlight-red" : "highlight-green")">
                                <span class="print-tile-lbl">Balance Due</span>
                                <span class="print-tile-val fw-bold">$@printPaySummary.RemainingBalance.ToString("N2")</span>
                            </div>
                        </div>

                        @if (_selectedPayments.Any())
                        {
                            <div class="print-pay-history">
                                <div class="print-subhead">Recorded Payments &amp; Deposits</div>
                                <table class="print-mini-table">
                                    <thead>
                                        <tr>
                                            <th>Date</th>
                                            <th>Type</th>
                                            <th>Method / Ref</th>
                                            <th class="text-end">Amount</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var p in _selectedPayments.Take(3))
                                        {
                                            <tr>
                                                <td>@p.PaymentDate.ToString("MM/dd/yy")</td>
                                                <td>@p.PaymentType</td>
                                                <td>@p.PaymentMethod @(!string.IsNullOrEmpty(p.ReferenceOrCheckNumber) ? $"({p.ReferenceOrCheckNumber})" : "")</td>
                                                <td class="text-end fw-bold">@(p.PaymentType == "Refund" ? "-" : "")$@p.Amount.ToString("N2")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- 3. Accepted Agreements & Policies (Clean multi-column list) -->
        <div class="print-card mt-2">
            <div class="print-card-header">
                <span class="print-card-title">5. ACKNOWLEDGED POLICIES &amp; ACCEPTED TERMS (@printAgreedPolicies.Count)</span>
            </div>
            <div class="print-card-body py-1">
                <div class="print-policies-grid">
                    @foreach (var pol in printAgreedPolicies)
                    {
                        <div class="print-policy-pill">
                            <span class="print-check-mark">✓</span>
                            <span class="print-pol-title">@pol.Title</span>
                            @if (!string.IsNullOrEmpty(pol.Tag))
                            {
                                <span class="print-pol-tag">(@pol.Tag)</span>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- 4. Electronic Signature & Legal Execution Box -->
        <div class="print-card mt-2 print-signature-card">
            <div class="print-sig-row">
                <div class="print-sig-block">
                    <div class="print-sig-lbl">Applicant Electronic Signature (Legal Acceptance):</div>
                    <div class="print-sig-val">@printSignature</div>
                </div>
                <div class="print-sig-block">
                    <div class="print-sig-lbl">Submission Timestamp:</div>
                    <div class="print-sig-ts">@printTimestamp</div>
                </div>
            </div>
            <div class="print-legal-notice">
                By electronically signing, the applicant affirms they are 21+ years of age and agrees to all Gloucester Fraternity Club bylaws, hall rental rules, kitchen policies, and payment terms.
            </div>
        </div>
    </div>
}



<!-- ADD / EDIT GOOGLE CALENDAR EVENT MODAL -->
@if (_showEditEventModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.7); z-index: 1055;" role="dialog">
        <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
            <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="modal-header bg-light border-bottom p-3 px-4">
                    <div class="d-flex align-items-center gap-2">
                        <div class="p-2 rounded-circle bg-success-subtle text-success">
                            <i class="bi @(_isNewEvent ? "bi-calendar-plus" : "bi-pencil-square") fs-5"></i>
                        </div>
                        <div>
                            <h5 class="modal-title fw-bold mb-0">@(_isNewEvent ? "Add New Rental / Booking" : "Edit Booking in Google Calendar")</h5>
                            <small class="text-muted">Updates will synchronize directly to Google Calendar</small>
                        </div>
                    </div>
                    <button type="button" class="btn-close" @onclick="() => _showEditEventModal = false"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label fw-semibold small">Event / Reservation Title <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" placeholder="e.g. Hall Rental: John Doe Wedding" @bind="_editEventModel.Title" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold small">Start Date & Time <span class="text-danger">*</span></label>
                            <input type="datetime-local" class="form-control" @bind="_editEventModel.Start" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold small">End Date & Time <span class="text-danger">*</span></label>
                            <input type="datetime-local" class="form-control" @bind="_editEventModel.End" />
                        </div>

                        <div class="col-12">
                            <label class="form-label fw-semibold small">Location / Facility Room</label>
                            <input type="text" class="form-control" placeholder="e.g. Main Function Hall, Pavilion, Directors Room" @bind="_editEventModel.Location" />
                        </div>

                        <div class="col-12">
                            <label class="form-label fw-semibold small">Booking Details & Application Notes</label>
                            <textarea class="form-control" rows="6" placeholder="Enter rental details, applicant contact info, bar service or kitchen access notes..." @bind="_editEventModel.Description"></textarea>
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(_editEventError))
                    {
                        <div class="alert alert-danger py-2 px-3 mt-3 mb-0 border-0 rounded-3 small">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>
                            @_editEventError
                        </div>
                    }
                </div>
                <div class="modal-footer bg-light border-top p-3 px-4">
                    <button type="button" class="btn btn-light" @onclick="() => _showEditEventModal = false" disabled="@_isSavingEvent">Cancel</button>
                    <button type="button" class="btn btn-primary px-4 shadow-sm" @onclick="SaveGoogleEvent" disabled="@_isSavingEvent">
                        @if (_isSavingEvent)
                        {
                            <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                            <span>Saving to Google Calendar...</span>
                        }
                        else
                        {
                            <i class="bi bi-cloud-check me-1"></i>
                            <span>@(_isNewEvent ? "Create Booking" : "Update in Google Calendar")</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- CANCEL OR REMOVE EVENT MODAL -->
@if (_showCancelEventConfirm && _eventToCancelOrRemove != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.75); z-index: 1065;" role="dialog">
        <div class="modal-dialog modal-dialog-centered" style="max-width: 500px;" role="document">
            <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="modal-header bg-danger text-white p-3 px-4">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-exclamation-triangle-fill fs-4"></i>
                        <h5 class="modal-title fw-bold mb-0">Cancel or Remove Booking</h5>
                    </div>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseCancelEventConfirm" disabled="@_isProcessingCancelOrRemove"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <div class="fw-bold text-dark fs-6 mb-1">@_eventToCancelOrRemove.Title</div>
                        <div class="text-muted small">
                            <i class="bi bi-calendar3 me-1"></i>@_eventToCancelOrRemove.Start.ToString("dddd, MMMM dd, yyyy")
                            <span class="mx-1">•</span>
                            <i class="bi bi-clock me-1"></i>@_eventToCancelOrRemove.Start.ToString("h:mm tt") - @_eventToCancelOrRemove.End.ToString("h:mm tt")
                        </div>
                    </div>

                    <p class="text-secondary small mb-4">
                        Please choose how you would like to handle this pending event / rental booking:
                    </p>

                    <div class="d-grid gap-3">
                        <button type="button" class="btn btn-outline-warning text-dark text-start p-3 rounded-3 border d-flex align-items-start gap-3 shadow-sm hover-shadow" @onclick="MarkBookingCancelledAsync" disabled="@_isProcessingCancelOrRemove">
                            <i class="bi bi-slash-circle fs-3 text-warning"></i>
                            <div>
                                <strong class="d-block text-dark">Mark as Cancelled</strong>
                                <small class="text-muted">Keeps the record in your database for audit history, but changes status to Cancelled and frees up the calendar.</small>
                            </div>
                        </button>

                        <button type="button" class="btn btn-outline-danger text-start p-3 rounded-3 border d-flex align-items-start gap-3 shadow-sm hover-shadow" @onclick="PermanentlyDeleteBookingAsync" disabled="@_isProcessingCancelOrRemove">
                            <i class="bi bi-trash3-fill fs-3 text-danger"></i>
                            <div>
                                <strong class="d-block text-danger">Delete &amp; Remove Completely</strong>
                                <small class="text-muted">Permanently deletes the application from the database and removes the scheduled event from Google Calendar.</small>
                            </div>
                        </button>
                    </div>

                    @if (_isProcessingCancelOrRemove)
                    {
                        <div class="text-center mt-3 text-primary">
                            <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                            <span class="small fw-bold">Processing request...</span>
                        </div>
                    }
                </div>
                <div class="modal-footer bg-light p-3 px-4">
                    <button type="button" class="btn btn-secondary px-4 shadow-sm" @onclick="CloseCancelEventConfirm" disabled="@_isProcessingCancelOrRemove">
                        Dismiss
                    </button>
                </div>
            </div>
        </div>
    </div>
}

