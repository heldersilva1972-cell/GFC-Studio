@page "/hall-rentals"
@using GFC.Core.Models
@using GFC.Core.Interfaces
@using GFC.BlazorServer.Services
@using Microsoft.AspNetCore.Components.Forms
@using System.Text.RegularExpressions
@inject IGoogleCalendarService CalendarService
@inject IUserManagementService UserService
@inject IRentalService RentalService
@inject GFC.Core.Interfaces.IWebsiteSettingsService WebsiteSettingsService
@inject GFC.BlazorServer.Services.CustomAuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JSRuntime
@inject IToastService ToastService
@inject NavigationManager Navigation
@attribute [Authorize]
@rendermode InteractiveServer

<div class="hall-rentals-container">
    @if (!_hasPageAccess && !_isAdmin)
    {
        <div class="access-denied-panel text-center py-5">
            <div class="bg-light rounded-circle shadow-sm d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px;">
                <i class="bi bi-shield-lock-fill text-danger fs-1"></i>
            </div>
            <h3 class="fw-bold text-dark">Access Restricted</h3>
            <p class="text-muted">You do not have permission to view the Hall Rentals page. Please contact your system administrator.</p>
        </div>
    }
    else
    {
        <!-- Page Header -->
        <div class="dashboard-header d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
            <div>
                <h1 class="dashboard-title mb-1">
                    <i class="bi bi-calendar2-week-fill text-gold me-2"></i>
                    Hall Rentals
                </h1>
                <p class="dashboard-subtitle text-muted mb-0">Multi-calendar synchronization, event schedules, and hall rental applications</p>
            </div>
            <div class="header-actions d-flex gap-2 flex-wrap">
                <button class="btn btn-outline-secondary d-flex align-items-center gap-2 shadow-sm" @onclick="ExportCalendarIcs" disabled="@(_events.Count == 0)">
                    <i class="bi bi-download"></i>
                    <span>Export (.ics)</span>
                </button>
                <button class="btn btn-success d-flex align-items-center gap-2 shadow-sm" @onclick="OpenAddEventModal">
                    <i class="bi bi-calendar-plus-fill"></i>
                    <span>Add Booking</span>
                </button>
                <button class="btn btn-warning d-flex align-items-center gap-2 shadow-sm text-dark fw-semibold" @onclick='() => Navigation.NavigateTo("/hall-rentals/settings?tab=simulator")'>
                    <i class="bi bi-controller"></i>
                    <span>Test Form (Simulate)</span>
                </button>
                <button class="btn btn-outline-primary d-flex align-items-center gap-2 shadow-sm" @onclick='() => Navigation.NavigateTo("/hall-rentals/settings")'>
                    <i class="bi bi-sliders2-vertical"></i>
                    <span>Rental Settings</span>
                    @if (_settings.Feeds.Count > 1)
                    {
                        <span class="badge bg-primary rounded-pill">@_settings.Feeds.Count</span>
                    }
                </button>
                <button class="btn btn-primary d-flex align-items-center gap-2 shadow-sm" @onclick="SyncCalendarNow" disabled="@_isSyncing">
                    @if (_isSyncing)
                    {
                        <span class="spinner-border spinner-border-sm" role="status"></span>
                        <span>Syncing...</span>
                    }
                    else
                    {
                        <i class="bi bi-arrow-repeat"></i>
                        <span>Sync Now</span>
                    }
                </button>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(_syncMessage))
        {
            <div class="alert @(_syncSuccess ? "alert-success" : "alert-warning") alert-dismissible fade show shadow-sm" role="alert">
                <i class="bi @(_syncSuccess ? "bi-check-circle-fill" : "bi-exclamation-triangle-fill") me-2"></i>
                @_syncMessage
                <button type="button" class="btn-close" @onclick="() => _syncMessage = null"></button>
            </div>
        }

        <!-- Metric Stat Overview -->
        <div class="row g-3 mb-4">
            <div class="col-sm-6 col-xl-3">
                <div class="stat-card stat-primary">
                    <div class="stat-icon">
                        <i class="bi bi-calendar-event"></i>
                    </div>
                    <div class="stat-content">
                        <div class="stat-label">Total Synced Events</div>
                        <div class="stat-value">@_events.Count</div>
                    </div>
                </div>
            </div>
            <div class="col-sm-6 col-xl-3">
                <div class="stat-card stat-success">
                    <div class="stat-icon">
                        <i class="bi bi-calendar-check"></i>
                    </div>
                    <div class="stat-content">
                        <div class="stat-label">Upcoming (Next 30 Days)</div>
                        <div class="stat-value">@GetUpcomingCount()</div>
                    </div>
                </div>
            </div>
            <div class="col-sm-6 col-xl-3">
                <div class="stat-card stat-warning">
                    <div class="stat-icon">
                        <i class="bi bi-clock-history"></i>
                    </div>
                    <div class="stat-content">
                        <div class="stat-label">Pending Applications</div>
                        <div class="stat-value text-warning">@GetPendingCount()</div>
                    </div>
                </div>
            </div>
            <div class="col-sm-6 col-xl-3">
                <div class="stat-card stat-info">
                    <div class="stat-icon">
                        <i class="bi bi-layers-fill"></i>
                    </div>
                    <div class="stat-content">
                        <div class="stat-label">Connected Calendars</div>
                        <div class="stat-value">@(_settings.Feeds.Count(f => f.IsEnabled)) <span class="small text-muted" style="font-size: 0.8rem;">Active</span></div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ACTIVE CALENDAR SOURCE & MODE BANNER -->
        <div class="card border-0 rounded-3 mb-4 shadow-sm @(_webSettings?.EnableSandboxMode == true ? "bg-warning bg-opacity-10 border border-warning" : "bg-primary bg-opacity-10 border border-primary-subtle")">
            <div class="card-body p-3">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <div class="d-flex align-items-center gap-3 flex-wrap">
                        @if (_webSettings?.EnableSandboxMode == true)
                        {
                            <span class="badge bg-warning text-dark px-3 py-2 fs-6 shadow-sm">
                                <i class="bi bi-shield-fill-check me-1"></i>SANDBOX TEST MODE
                            </span>
                            <div>
                                <strong class="text-dark">Currently Viewing:</strong>
                                <span class="badge bg-white text-dark border border-warning ms-1 px-2 py-1 shadow-sm" title="@_webSettings?.SandboxGoogleCalendarId">
                                    <i class="bi bi-google text-danger me-1"></i>@GetSandboxCalendarDisplayName()
                                </span>
                                <span class="small text-muted ms-2">(Real club schedules &amp; public customer emails are protected)</span>
                            </div>
                        }
                        else
                        {
                            <span class="badge bg-success px-3 py-2 fs-6 shadow-sm">
                                <i class="bi bi-broadcast me-1"></i>LIVE PRODUCTION
                            </span>
                            <div>
                                <strong class="text-dark">Currently Viewing:</strong>
                                @if (_settings.Feeds.Any(f => f.IsEnabled))
                                {
                                    @foreach (var feed in _settings.Feeds.Where(f => f.IsEnabled))
                                    {
                                        <span class="badge bg-white text-dark border ms-1 px-2 py-1 shadow-sm" style="border-left: 3px solid @feed.Color !important;">
                                            <i class="bi bi-circle-fill me-1" style="color: @feed.Color; font-size: 0.6rem;"></i>@feed.Name
                                        </span>
                                    }
                                }
                                else
                                {
                                    <span class="badge bg-white text-dark border ms-1 px-2 py-1">
                                        @(_settings.CalendarName ?? "Primary Calendar")
                                    </span>
                                }
                            </div>
                        }
                    </div>

                    <div class="d-flex align-items-center gap-2">
                        <button type="button" class="btn btn-sm btn-outline-dark" @onclick='() => Navigation.NavigateTo("/hall-rentals/settings?tab=calendar")'>
                            <i class="bi bi-sliders me-1"></i>Switch / Manage Calendars
                        </button>
                    </div>
                </div>

                <!-- Source Badges Filter Strip / Calendar Selector -->
                <div class="d-flex align-items-center gap-2 mt-2 pt-2 border-top flex-wrap" style="font-size: 0.88rem;">
                    <span class="text-dark fw-bold me-1"><i class="bi bi-calendar-range-fill text-primary me-1"></i>Active Calendar View:</span>
                    <button type="button" class="btn btn-sm @(string.IsNullOrEmpty(_filterFeedSource) ? "btn-dark shadow-sm fw-bold" : "btn-outline-secondary") px-3 py-1" @onclick='() => _filterFeedSource = ""'>
                        <i class="bi bi-collection-fill me-1"></i> All Calendars (@_events.Count)
                    </button>
                    @foreach (var src in _events.Select(e => e.Source ?? "Google Calendar").Distinct().OrderBy(s => s))
                    {
                        var srcCount = _events.Count(e => (e.Source ?? "Google Calendar") == src);
                        var isSelected = _filterFeedSource == src;
                        <button type="button" class="btn btn-sm @(isSelected ? "btn-primary shadow-sm fw-bold text-white" : "btn-outline-secondary") px-3 py-1" @onclick='() => _filterFeedSource = src'>
                            <i class="bi bi-calendar-check me-1"></i>@src (@srcCount)
                        </button>
                    }
                </div>
            </div>
        </div>

        <!-- View Controls & Filter Bar -->
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-body p-3">
                <div class="row g-3 align-items-center justify-content-between">
                    <div class="col-md-5">
                        <div class="input-group">
                            <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                            <input type="text" class="form-control border-start-0" placeholder="Search by name, event type or date..." @bind="_searchTerm" @bind:event="oninput" />
                            @if (!string.IsNullOrEmpty(_searchTerm))
                            {
                                <button class="btn btn-outline-secondary border-start-0" @onclick="() => _searchTerm = string.Empty">
                                    <i class="bi bi-x-lg"></i>
                                </button>
                            }
                        </div>
                    </div>
                    <div class="col-md-7 d-flex justify-content-md-end gap-2 flex-wrap align-items-center">
                        <div class="btn-group btn-group-sm">
                            <button class="btn @(_filterCategory == "ALL" ? "btn-dark" : "btn-outline-secondary")" @onclick='() => _filterCategory = "ALL"'>All (@_events.Count)</button>
                            <button class="btn @(_filterCategory == "PENDING" ? "btn-warning" : "btn-outline-secondary")" @onclick='() => _filterCategory = "PENDING"'>Pending (@GetPendingCount())</button>
                            <button class="btn @(_filterCategory == "PAID" ? "btn-success" : "btn-outline-secondary")" @onclick='() => _filterCategory = "PAID"'>Paid (@GetPaidEventsCount())</button>
                            <button class="btn @(_filterCategory == "UNPAID" ? "btn-danger" : "btn-outline-secondary")" @onclick='() => _filterCategory = "UNPAID"'>Unpaid</button>
                            <button class="btn @(_filterCategory == "APPLICATIONS" ? "btn-primary" : "btn-outline-secondary")" @onclick='() => _filterCategory = "APPLICATIONS"'>Applications</button>
                        </div>

                        <div class="btn-group shadow-sm" role="group">
                            <button type="button" class="btn @(_activeView == "calendar" ? "btn-primary active" : "btn-outline-secondary")" @onclick='() => _activeView = "calendar"'>
                                <i class="bi bi-calendar3 me-1"></i> Calendar Grid
                            </button>
                            <button type="button" class="btn @(_activeView == "list" ? "btn-primary active" : "btn-outline-secondary")" @onclick='() => _activeView = "list"'>
                                <i class="bi bi-list-ul me-1"></i> Schedule List
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @if (_activeView == "calendar")
        {
            <!-- CALENDAR GRID VIEW -->
            <div class="card shadow-sm border-0 mb-4 calendar-wrapper-card">
                <div class="card-body p-3">
                    <div class="calendar-nav-bar d-flex justify-content-between align-items-center mb-3">
                        <button class="btn btn-light rounded-circle shadow-sm" @onclick="() => ChangeMonth(-1)">
                            <i class="bi bi-chevron-left"></i>
                        </button>
                        <h4 class="mb-0 fw-bold text-dark">
                            @_currentMonth.ToString("MMMM yyyy")
                        </h4>
                        <div class="d-flex gap-2">
                            <button class="btn btn-outline-secondary btn-sm" @onclick="() => _currentMonth = DateTime.Today">Today</button>
                            <button class="btn btn-light rounded-circle shadow-sm" @onclick="() => ChangeMonth(1)">
                                <i class="bi bi-chevron-right"></i>
                            </button>
                        </div>
                    </div>

                    <!-- Weekday Header -->
                    <div class="calendar-grid-header">
                        <div class="day-head">Sun</div>
                        <div class="day-head">Mon</div>
                        <div class="day-head">Tue</div>
                        <div class="day-head">Wed</div>
                        <div class="day-head">Thu</div>
                        <div class="day-head">Fri</div>
                        <div class="day-head">Sat</div>
                    </div>

                    <!-- Month Days -->
                    <div class="calendar-grid-body">
                        @{
                            var firstDayOfMonth = new DateTime(_currentMonth.Year, _currentMonth.Month, 1);
                            int leadingOffset = (int)firstDayOfMonth.DayOfWeek;
                            int totalDays = DateTime.DaysInMonth(_currentMonth.Year, _currentMonth.Month);
                        }

                        @for (int i = 0; i < leadingOffset; i++)
                        {
                            <div class="calendar-cell outside-month"></div>
                        }

                        @for (int day = 1; day <= totalDays; day++)
                        {
                            var date = new DateTime(_currentMonth.Year, _currentMonth.Month, day);
                            var dayEvents = GetEventsForDate(date);
                            bool isToday = date.Date == DateTime.Today;

                            <div class="calendar-cell @(isToday ? "cell-today" : "")">
                                <div class="cell-header d-flex justify-content-between align-items-center">
                                    <span class="cell-day-num @(isToday ? "badge bg-primary rounded-circle" : "")">@day</span>
                                    @if (dayEvents.Any())
                                    {
                                        <span class="badge bg-light text-dark border-0">@dayEvents.Count</span>
                                    }
                                </div>
                                <div class="cell-events">
                                    @foreach (var evt in dayEvents.Take(3))
                                    {
                                        var isPending = evt.Title.StartsWith("PENDING", StringComparison.OrdinalIgnoreCase);
                                        var payStatus = GetEventPaymentStatus(evt);
                                        <div class="event-pill @(isPending ? "pill-warning" : "pill-primary")" @onclick="() => ShowEventDetails(evt)" title="@evt.Title">
                                            <div class="d-flex justify-content-between align-items-center w-100">
                                                <span class="event-time">@(evt.IsAllDay ? "All-day" : evt.Start.ToString("h:mm tt"))</span>
                                                @if (payStatus == "Paid")
                                                {
                                                    <span class="badge bg-success text-white py-0 px-1 border border-success-subtle fw-bold" style="font-size: 0.65rem;" title="Paid in Full">PAID</span>
                                                }
                                                else if (payStatus == "Deposit Paid")
                                                {
                                                    <span class="badge py-0 px-1 fw-bold" style="font-size: 0.65rem; background-color: #0284c7 !important; color: #ffffff !important; border: 1px solid #0369a1 !important;" title="Security Deposit Received">DEP PAID</span>
                                                }
                                                else if (payStatus == "Partial")
                                                {
                                                    <span class="badge py-0 px-1 fw-bold" style="font-size: 0.65rem; background-color: #d97706 !important; color: #ffffff !important; border: 1px solid #b45309 !important;" title="Partially Paid">PARTIAL</span>
                                                }
                                            </div>
                                            <span class="event-title-text">@GetCleanTitle(evt)</span>
                                        </div>
                                    }
                                    @if (dayEvents.Count > 3)
                                    {
                                        <div class="more-events-badge" @onclick='() => { _searchTerm = date.ToString("yyyy-MM-dd"); _activeView = "list"; }'>
                                            +@(dayEvents.Count - 3) more
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
        else
        {
            <!-- LIST / SCHEDULE VIEW -->
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th style="width: 130px;">Event Date</th>
                                    <th style="width: 140px;">Time</th>
                                    <th style="width: 110px;">Status</th>
                                    <th style="width: 120px;">Payment</th>
                                    <th>Applicant / Event Title</th>
                                    <th>Event Type</th>
                                    <th>Calendar Source</th>
                                    <th>Location</th>
                                    <th style="width: 90px;" class="text-end">Details</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    var filteredEvents = GetFilteredEvents();
                                }
                                @if (!filteredEvents.Any())
                                {
                                    <tr>
                                        <td colspan="9" class="text-center py-5 text-muted">
                                            <i class="bi bi-calendar-x fs-2 d-block mb-2 text-secondary"></i>
                                            No events found matching your filter criteria.
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var evt in filteredEvents)
                                    {
                                        var details = ParseApplicationDetails(evt);
                                        var isPending = evt.Title.StartsWith("PENDING", StringComparison.OrdinalIgnoreCase);
                                        var isApproved = evt.Title.StartsWith("APPROVED", StringComparison.OrdinalIgnoreCase);
                                        var paySummary = GetEventPaymentSummary(evt);

                                        <tr>
                                            <td class="fw-semibold">
                                                @if (evt.Start.Year > 2000)
                                                {
                                                    <span>@evt.Start.ToString("MMM dd, yyyy")</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">Unspecified Date</span>
                                                }
                                            </td>
                                            <td class="text-muted small">
                                                @(evt.IsAllDay ? "All-Day Event" : $"{evt.Start:h:mm tt} - {evt.End:h:mm tt}")
                                            </td>
                                            <td>
                                                @if (isPending)
                                                {
                                                    <span class="badge px-2 py-1 rounded-pill" style="background-color: #fef3c7 !important; color: #78350f !important; font-weight: 700; border: 1px solid #d97706 !important;">
                                                        <i class="bi bi-hourglass-split me-1 text-warning"></i>Pending
                                                    </span>
                                                }
                                                else if (isApproved)
                                                {
                                                    <span class="badge bg-success-subtle text-success border border-success px-2 py-1 rounded-pill">
                                                        <i class="bi bi-check-circle-fill me-1"></i>Approved
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1 rounded-pill">
                                                        @(evt.Status ?? "CONFIRMED")
                                                    </span>
                                                }
                                            </td>
                                            <td>
                                                @if (paySummary.Status == "Paid")
                                                {
                                                    <span class="badge bg-success text-white px-2 py-1 rounded-pill fw-bold shadow-sm">
                                                        <i class="bi bi-check-circle-fill me-1"></i>Paid Full
                                                    </span>
                                                }
                                                else if (paySummary.Status == "Deposit Paid")
                                                {
                                                    <span class="badge px-2 py-1 rounded-pill fw-bold shadow-sm" style="background-color: #0284c7 !important; color: #ffffff !important; border: 1px solid #0369a1 !important;">
                                                        <i class="bi bi-shield-check me-1"></i>Dep Paid
                                                    </span>
                                                }
                                                else if (paySummary.Status == "Partial")
                                                {
                                                    <span class="badge px-2 py-1 rounded-pill fw-bold shadow-sm" style="background-color: #d97706 !important; color: #ffffff !important; border: 1px solid #b45309 !important;">
                                                        <i class="bi bi-pie-chart me-1"></i>Partial (${paySummary.TotalPaid:N0})
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-light text-dark border border-secondary-subtle px-2 py-1 rounded-pill fw-semibold">
                                                        Unpaid
                                                    </span>
                                                }
                                            </td>
                                            <td>
                                                <div class="fw-bold text-dark">@GetCleanTitle(evt)</div>
                                                @if (!string.IsNullOrEmpty(details.ApplicantName))
                                                {
                                                    <div class="text-muted small">
                                                        <i class="bi bi-person me-1"></i>@details.ApplicantName
                                                        @if (!string.IsNullOrEmpty(details.Email))
                                                        {
                                                            <span class="mx-1">•</span>
                                                            <a href="mailto:@details.Email" class="text-decoration-none text-muted">@details.Email</a>
                                                        }
                                                    </div>
                                                }
                                            </td>
                                            <td>
                                                @if (!string.IsNullOrEmpty(details.EventType))
                                                {
                                                    <span class="badge bg-light text-dark border">@details.EventType</span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted small">—</span>
                                                }
                                            </td>
                                            <td>
                                                <span class="badge bg-light text-dark border px-2 py-1">
                                                    <i class="bi bi-calendar2-range me-1 text-primary"></i>@evt.Source
                                                </span>
                                            </td>
                                            <td>
                                                <span class="text-muted small">@(string.IsNullOrEmpty(evt.Location) ? "Main Function Hall" : evt.Location)</span>
                                            </td>
                                            <td class="text-end">
                                                <button class="btn btn-sm btn-outline-primary rounded-pill px-3 shadow-sm" @onclick="() => ShowEventDetails(evt)">
                                                    <i class="bi bi-eye me-1"></i>View
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
    }
</div>

<!-- ========================================================================= -->
<!-- EVENT DETAILS MODAL (BEAUTIFULLY FORMATTED & EASY TO READ) -->
<!-- ========================================================================= -->
@if (_selectedEvent != null)
{
    var appDetails = ParseApplicationDetails(_selectedEvent);
    var cleanTitle = GetCleanTitle(_selectedEvent);
    var isPending = (_selectedRequest != null && string.Equals(_selectedRequest.Status, "Pending", StringComparison.OrdinalIgnoreCase)) ||
                    _selectedEvent.Title.Contains("PENDING", StringComparison.OrdinalIgnoreCase);
    var isApproved = (_selectedRequest != null && string.Equals(_selectedRequest.Status, "Approved", StringComparison.OrdinalIgnoreCase)) ||
                     _selectedEvent.Title.Contains("APPROVED", StringComparison.OrdinalIgnoreCase);
    var isCancelled = (_selectedRequest != null && string.Equals(_selectedRequest.Status, "Cancelled", StringComparison.OrdinalIgnoreCase)) ||
                      _selectedEvent.Title.Contains("CANCELLED", StringComparison.OrdinalIgnoreCase);

    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.65);" role="dialog">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable" role="document">
            <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
                <!-- Modal Header -->
                <div class="modal-header bg-light border-bottom p-3 px-4">
                    <div class="d-flex align-items-center gap-3">
                        <div class="p-2 rounded-3 @(isPending ? "bg-warning bg-opacity-25 text-warning-emphasis" : (isCancelled ? "bg-danger bg-opacity-10 text-danger" : "bg-primary bg-opacity-10 text-primary"))">
                            <i class="bi @(isPending ? "bi-hourglass-split" : (isCancelled ? "bi-x-circle-fill" : "bi-calendar-event-fill")) fs-4"></i>
                        </div>
                        <div>
                            <div class="d-flex align-items-center gap-2 mb-1 flex-wrap">
                                <h5 class="modal-title fw-bold mb-0 text-dark">@cleanTitle</h5>
                                @if (isPending)
                                {
                                    <span class="badge bg-warning text-dark fw-bold">PENDING REVIEW</span>
                                }
                                else if (isApproved)
                                {
                                    <span class="badge bg-success">APPROVED</span>
                                }
                                else if (isCancelled)
                                {
                                    <span class="badge bg-danger">CANCELLED</span>
                                }
                                else
                                {
                                    <span class="badge bg-primary">SCHEDULED</span>
                                }
                            </div>
                            <div class="text-muted small">Calendar Source: <strong>@_selectedEvent.Source</strong></div>
                        </div>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <button type="button" class="btn btn-outline-dark btn-sm rounded-pill px-3 shadow-sm d-flex align-items-center gap-1" @onclick="PrintSelectedApplication" title="Print application or save as PDF">
                            <i class="bi bi-printer-fill text-primary"></i>
                            <span class="fw-semibold">Print / Save PDF</span>
                        </button>
                        <button type="button" class="btn-close" @onclick="() => _selectedEvent = null"></button>
                    </div>
                </div>

                <!-- Modal Body -->
                <div class="modal-body p-4">
                    <!-- Hero Event Banner -->
                    <div class="event-hero-banner p-3 rounded-3 mb-4 d-flex justify-content-between align-items-center flex-wrap gap-3">
                        <div>
                            <div class="text-uppercase fw-bold small text-primary-emphasis mb-1"><i class="bi bi-calendar3 me-1"></i> Scheduled Event Date</div>
                            <h4 class="fw-bold text-dark mb-0">
                                @if (_selectedEvent.Start.Year > 2000)
                                {
                                    @_selectedEvent.Start.ToString("dddd, MMMM dd, yyyy")
                                }
                                else if (_selectedRequest != null && _selectedRequest.EventDate.Year > 2000)
                                {
                                    @_selectedRequest.EventDate.ToString("dddd, MMMM dd, yyyy")
                                }
                                else if (!string.IsNullOrEmpty(appDetails.PreferredEventDate))
                                {
                                    @appDetails.PreferredEventDate
                                }
                                else
                                {
                                    <span>Date Pending / Unspecified</span>
                                }
                            </h4>
                        </div>
                        <div class="text-md-end">
                            <div class="text-uppercase fw-bold small text-primary-emphasis mb-1"><i class="bi bi-clock me-1"></i> Time Range</div>
                            <h5 class="fw-bold text-dark mb-0">
                                @if (_selectedRequest != null && !string.IsNullOrEmpty(_selectedRequest.StartTime) && !string.IsNullOrEmpty(_selectedRequest.EndTime))
                                {
                                    <span>@_selectedRequest.StartTime - @_selectedRequest.EndTime</span>
                                }
                                else if (!string.IsNullOrEmpty(appDetails.StartTime) && !string.IsNullOrEmpty(appDetails.EndTime))
                                {
                                    <span>@appDetails.StartTime - @appDetails.EndTime</span>
                                }
                                else if (!_selectedEvent.IsAllDay)
                                {
                                    <span>@_selectedEvent.Start.ToString("h:mm tt") - @_selectedEvent.End.ToString("h:mm tt")</span>
                                }
                                else
                                {
                                    <span>All Day Event</span>
                                }
                            </h5>
                        </div>
                    </div>

                    <!-- 1. APPLICANT CONTACT CARD -->
                    @{
                        string effectiveName = !string.IsNullOrWhiteSpace(_selectedRequest?.ApplicantName) 
                            ? _selectedRequest.ApplicantName 
                            : (!string.IsNullOrWhiteSpace(appDetails.ApplicantName) ? appDetails.ApplicantName : cleanTitle);

                        string? effectivePhone = !string.IsNullOrWhiteSpace(_selectedRequest?.RequesterPhone) 
                            ? _selectedRequest.RequesterPhone 
                            : appDetails.Phone;

                        string? effectiveEmail = !string.IsNullOrWhiteSpace(_selectedRequest?.RequesterEmail) 
                            ? _selectedRequest.RequesterEmail 
                            : appDetails.Email;

                        string? effectiveAddress = !string.IsNullOrWhiteSpace(_selectedRequest?.RequesterAddress)
                            ? $"{_selectedRequest.RequesterAddress}{(!string.IsNullOrWhiteSpace(_selectedRequest.RequesterCity) ? $", {_selectedRequest.RequesterCity}" : "")}{(!string.IsNullOrWhiteSpace(_selectedRequest.RequesterState) ? $", {_selectedRequest.RequesterState}" : "")}{(!string.IsNullOrWhiteSpace(_selectedRequest.RequesterZip) ? $" {_selectedRequest.RequesterZip}" : "")}"
                            : (!string.IsNullOrWhiteSpace(appDetails.StreetAddress) 
                                ? $"{appDetails.StreetAddress}{(string.IsNullOrWhiteSpace(appDetails.City) ? "" : $", {appDetails.City}")}{(string.IsNullOrWhiteSpace(appDetails.State) ? "" : $", {appDetails.State}")}{(string.IsNullOrWhiteSpace(appDetails.Zip) ? "" : $" {appDetails.Zip}")}"
                                : null);

                        bool? isMemberVal = _selectedRequest != null 
                            ? _selectedRequest.MemberStatus 
                            : (!string.IsNullOrEmpty(appDetails.IsClubMember) ? appDetails.IsClubMember.ToLower().StartsWith("y") : null);
                    }
                    <div class="card border rounded-3 mb-3 shadow-none bg-white">
                        <div class="card-header bg-light py-2 px-3 fw-bold d-flex justify-content-between align-items-center">
                            <span><i class="bi bi-person-circle text-primary me-2"></i>Applicant / Organizer</span>
                            @if (isMemberVal.HasValue)
                            {
                                <span class="badge @(isMemberVal.Value ? "bg-success" : "bg-secondary")">
                                    @(isMemberVal.Value ? "Club Member" : "Non-Member")
                                </span>
                            }
                        </div>
                        <div class="card-body p-3">
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <div class="text-muted small">Full Name</div>
                                    <div class="fw-bold fs-6">@effectiveName</div>
                                </div>
                                <div class="col-md-6">
                                    <div class="text-muted small">Contact Phone</div>
                                    <div class="fw-semibold">
                                        @if (!string.IsNullOrEmpty(effectivePhone))
                                        {
                                            <a href="tel:@effectivePhone" class="text-decoration-none text-primary">
                                                <i class="bi bi-telephone me-1"></i>@effectivePhone
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-muted">None provided</span>
                                        }
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="text-muted small">Email Address</div>
                                    <div class="fw-semibold">
                                        @if (!string.IsNullOrEmpty(effectiveEmail))
                                        {
                                            <a href="mailto:@effectiveEmail" class="text-decoration-none text-primary">
                                                <i class="bi bi-envelope me-1"></i>@effectiveEmail
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-muted">None provided</span>
                                        }
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="text-muted small">Mailing Address</div>
                                    <div class="fw-semibold">
                                        @if (!string.IsNullOrEmpty(effectiveAddress))
                                        {
                                            <span>@effectiveAddress</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">None provided</span>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- 2. EVENT SPECIFICATIONS & SERVICES -->
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <div class="card border rounded-3 h-100 shadow-none bg-white">
                                <div class="card-header bg-light py-2 px-3 fw-bold">
                                    <i class="bi bi-card-checklist text-primary me-2"></i>Event Specifications
                                </div>
                                <div class="card-body p-3">
                                    <div class="d-flex justify-content-between py-1 border-bottom">
                                        <span class="text-muted small">Event Type</span>
                                        <span class="fw-bold">@(_selectedRequest?.EventType ?? appDetails.EventType ?? "General Function")</span>
                                    </div>
                                    @if (!string.IsNullOrEmpty(appDetails.EventDescription))
                                    {
                                        <div class="d-flex justify-content-between py-1 border-bottom">
                                            <span class="text-muted small">Description / Purpose</span>
                                            <span class="fw-bold text-dark">@appDetails.EventDescription</span>
                                        </div>
                                    }
                                    <div class="d-flex justify-content-between py-1 border-bottom">
                                        <span class="text-muted small">Estimated Guests</span>
                                        <span class="fw-bold">@(_selectedRequest?.GuestCount > 0 ? _selectedRequest.GuestCount.ToString() : (appDetails.GuestCount ?? "Unspecified"))</span>
                                    </div>
                                    <div class="d-flex justify-content-between py-1 border-bottom">
                                        <span class="text-muted small">Setup Time Required?</span>
                                        <span class="fw-bold @(appDetails.SetupTimeRequired?.ToLower().StartsWith("y") == true ? "text-success" : "text-muted")">
                                            @(appDetails.SetupTimeRequired ?? "No")
                                        </span>
                                    </div>
                                    @if (!string.IsNullOrEmpty(appDetails.AlternateDate))
                                    {
                                        <div class="d-flex justify-content-between py-1">
                                            <span class="text-muted small">Alternate Date Choice</span>
                                            <span class="fw-bold text-info">@appDetails.AlternateDate</span>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="card border rounded-3 h-100 shadow-none bg-white">
                                <div class="card-header bg-light py-2 px-3 fw-bold">
                                    <i class="bi bi-cup-straw text-primary me-2"></i>Facilities & Add-Ons
                                </div>
                                <div class="card-body p-3">
                                    <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                                        <div>
                                            <div class="fw-semibold"><i class="bi bi-cup-hot text-danger me-1"></i>Bar Service</div>
                                            <div class="text-muted small" style="font-size: 0.75rem;">Alcohol & bartender staffing</div>
                                        </div>
                                        <span class="badge @((_selectedRequest?.BartenderRequested == true || appDetails.BarService?.ToLower().StartsWith("y") == true) ? "bg-success" : "bg-light text-muted border") px-3 py-1">
                                            @((_selectedRequest?.BartenderRequested == true || appDetails.BarService?.ToLower().StartsWith("y") == true) ? "Requested" : "No")
                                        </span>
                                    </div>
                                    <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                                        <div>
                                            <div class="fw-semibold"><i class="bi bi-fire text-warning me-1"></i>Kitchen Access</div>
                                            <div class="text-muted small" style="font-size: 0.75rem;">Food prep / kitchen usage</div>
                                        </div>
                                        <span class="badge @((_selectedRequest?.KitchenUsage == true || appDetails.KitchenAccess?.ToLower().StartsWith("y") == true) ? "bg-success" : "bg-light text-muted border") px-3 py-1">
                                            @((_selectedRequest?.KitchenUsage == true || appDetails.KitchenAccess?.ToLower().StartsWith("y") == true) ? "Requested" : "No")
                                        </span>
                                    </div>
                                    <div class="d-flex justify-content-between align-items-center py-2">
                                        <div>
                                            <div class="fw-semibold"><i class="bi bi-speaker text-info me-1"></i>A/V Equipment</div>
                                            <div class="text-muted small" style="font-size: 0.75rem;">Microphone, speakers, projector</div>
                                        </div>
                                        <span class="badge @(_selectedRequest?.AvEquipmentUsage == true ? "bg-success" : "bg-light text-muted border") px-3 py-1">
                                            @(_selectedRequest?.AvEquipmentUsage == true ? "Requested" : "No")
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- 3. FINANCIAL SUMMARY & REAL-TIME PAYMENT STATUS -->
                    @{
                        var modalPaySummary = GetEventPaymentSummary(_selectedEvent);
                    }
                    <div class="card border rounded-3 shadow-none bg-white mb-3">
                        <div class="card-header bg-light py-2 px-3 fw-bold d-flex justify-content-between align-items-center">
                            <span><i class="bi bi-currency-dollar text-success me-2"></i>Financial &amp; Payment Breakdown</span>
                            <span class="badge @(modalPaySummary.Status == "Paid" ? "bg-success text-white" : (modalPaySummary.Status == "Deposit Paid" ? "bg-primary text-white" : (modalPaySummary.Status == "Partial" ? "bg-warning text-dark" : "bg-dark text-white"))) px-3 py-1.5 fs-6 shadow-sm fw-bold">
                                Payment Status: @modalPaySummary.Status.ToUpper()
                            </span>
                        </div>
                        <div class="card-body p-3">
                            <div class="row g-3 text-center">
                                <div class="col-md-3 col-6">
                                    <div class="p-2 bg-light rounded border">
                                        <small class="text-muted d-block">Agreed Total Price</small>
                                        <strong class="fs-5 text-dark">$@modalPaySummary.TotalPrice.ToString("N2")</strong>
                                    </div>
                                </div>
                                <div class="col-md-3 col-6">
                                    <div class="p-2 bg-light rounded border">
                                        <small class="text-muted d-block">Security Deposit</small>
                                        <strong class="fs-5 text-warning-emphasis">$@modalPaySummary.DepositRequired.ToString("N2")</strong>
                                    </div>
                                </div>
                                <div class="col-md-3 col-6">
                                    <div class="p-2 bg-success bg-opacity-10 rounded border border-success-subtle">
                                        <small class="text-success fw-semibold d-block">Total Paid to Date</small>
                                        <strong class="fs-5 text-success">$@modalPaySummary.TotalPaid.ToString("N2")</strong>
                                    </div>
                                </div>
                                <div class="col-md-3 col-6">
                                    <div class="p-2 @(modalPaySummary.RemainingBalance > 0 ? "bg-danger bg-opacity-10 border border-danger-subtle" : "bg-light border") rounded">
                                        <small class="@(modalPaySummary.RemainingBalance > 0 ? "text-danger fw-semibold" : "text-muted") d-block">Remaining Balance</small>
                                        <strong class="fs-5 @(modalPaySummary.RemainingBalance > 0 ? "text-danger" : "text-success")">$@modalPaySummary.RemainingBalance.ToString("N2")</strong>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- 4. MANUAL BOOKING ADJUSTMENTS & PRICE OVERRIDE -->
                    <div class="card border rounded-3 shadow-none bg-white mb-3">
                        <div class="card-header bg-light py-2 px-3 fw-bold d-flex justify-content-between align-items-center">
                            <span><i class="bi bi-sliders text-primary me-2"></i>Adjust Booking, Services &amp; Price Overrides</span>
                            <button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => _showBookingAdjustor = !_showBookingAdjustor">
                                <i class="bi @(_showBookingAdjustor ? "bi-chevron-up" : "bi-pencil-square") me-1"></i>@(_showBookingAdjustor ? "Hide Editor" : "Modify Booking & Pricing")
                            </button>
                        </div>
                        @if (_showBookingAdjustor && _selectedRequest != null)
                        {
                            <div class="card-body p-3 border-top bg-light animate-fade-in">
                                <div class="row g-3">
                                    <div class="col-md-4">
                                        <label class="form-label small fw-bold text-dark mb-1">Renter Tier / Membership</label>
                                        <select class="form-select form-select-sm" @bind="_selectedRequest.MemberStatus">
                                            <option value="false">Non-Member Rate</option>
                                            <option value="true">Active Member Rate</option>
                                        </select>
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label small fw-bold text-dark mb-1">Room / Facility Selection</label>
                                        <select class="form-select form-select-sm" @bind="_selectedRequest.RoomSelected">
                                            @foreach (var room in _editableRooms)
                                            {
                                                <option value="@room.Name">@room.Name ($@( _selectedRequest.MemberStatus ? room.MemberRate : room.NonMemberRate))</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label small fw-bold text-dark mb-1">Guest Attendance</label>
                                        <input type="number" class="form-control form-control-sm" @bind="_selectedRequest.GuestCount" />
                                    </div>

                                    <div class="col-12">
                                        <label class="form-label small fw-bold text-dark mb-1">Selected Amenities / Services</label>
                                        <div class="d-flex gap-3 flex-wrap">
                                            <div class="form-check">
                                                <input class="form-check-input" type="checkbox" id="adjBar" @bind="_selectedRequest.BartenderRequested" />
                                                <label class="form-check-label small" for="adjBar">Bar Service (+$@(_webSettings?.BartenderServiceFee ?? 100))</label>
                                            </div>
                                            <div class="form-check">
                                                <input class="form-check-input" type="checkbox" id="adjKit" @bind="_selectedRequest.KitchenUsage" />
                                                <label class="form-check-label small" for="adjKit">Kitchen Access (+$@(_webSettings?.KitchenFee ?? 50))</label>
                                            </div>
                                            <div class="form-check">
                                                <input class="form-check-input" type="checkbox" id="adjAv" @bind="_selectedRequest.AvEquipmentUsage" />
                                                <label class="form-check-label small" for="adjAv">A/V Equipment (+$@(_webSettings?.AvEquipmentFee ?? 25))</label>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-md-6">
                                        <label class="form-label small fw-bold text-dark mb-1">Total Agreed Price ($) <span class="text-primary">(Custom Discount / Override)</span></label>
                                        <div class="input-group input-group-sm">
                                            <span class="input-group-text">$</span>
                                            <input type="number" class="form-control fw-bold" step="0.01" @bind="_selectedRequest.TotalPrice" />
                                            <button type="button" class="btn btn-outline-secondary" @onclick="AutoCalculateSelectedRequestPrice" title="Reset to standard calculated quote">Auto-Calc</button>
                                        </div>
                                        <small class="text-muted">Type any custom price (e.g. member discount, fee waiver).</small>
                                    </div>

                                    <div class="col-md-6">
                                        <label class="form-label small fw-bold text-dark mb-1">Security Deposit Amount ($)</label>
                                        <div class="input-group input-group-sm">
                                            <span class="input-group-text">$</span>
                                            <input type="number" class="form-control fw-bold" step="0.01" @bind="_selectedRequest.SecurityDepositAmount" />
                                        </div>
                                    </div>

                                    <div class="col-12 text-end">
                                        <button type="button" class="btn btn-primary btn-sm px-4 shadow-sm fw-bold" @onclick="SaveBookingAdjustments" disabled="@_isSavingAdjustments">
                                            @if (_isSavingAdjustments)
                                            {
                                                <span class="spinner-border spinner-border-sm me-1"></span>
                                                <span>Saving Changes...</span>
                                            }
                                            else
                                            {
                                                <i class="bi bi-check-lg me-1"></i>
                                                <span>Save Booking &amp; Price Adjustments</span>
                                            }
                                        </button>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                    <!-- 5. AGREEMENTS & SUBMISSION TIMESTAMP -->
                    @{
                        string? effectiveTimestamp = _selectedRequest != null && _selectedRequest.CreatedDate.Year > 2000
                            ? _selectedRequest.CreatedDate.ToLocalTime().ToString("MMMM dd, yyyy 'at' h:mm tt")
                            : (!string.IsNullOrEmpty(appDetails.FormattedTimestamp) ? appDetails.FormattedTimestamp : appDetails.Timestamp);

                        string? effectiveSignature = !string.IsNullOrWhiteSpace(_selectedRequest?.ApplicantSignature)
                            ? _selectedRequest.ApplicantSignature
                            : (!string.IsNullOrWhiteSpace(appDetails.ApplicantSignature) ? appDetails.ApplicantSignature : "Electronic Acceptance");

                        var acceptedPoliciesList = GetAcceptedPoliciesForDisplay(_selectedRequest, appDetails);
                    }
                    <div class="card border rounded-3 shadow-none bg-white mb-3">
                        <div class="card-header bg-light py-2 px-3 fw-bold d-flex justify-content-between align-items-center">
                            <span><i class="bi bi-shield-check text-success me-2"></i>Accepted Terms, Policies &amp; Digital Signature</span>
                            @if (!string.IsNullOrEmpty(effectiveTimestamp))
                            {
                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1">
                                    <i class="bi bi-clock-history me-1"></i>Submitted: @effectiveTimestamp
                                </span>
                            }
                        </div>
                        <div class="card-body p-3">
                            <div class="text-muted small fw-bold text-uppercase mb-2" style="font-size: 0.75rem; letter-spacing: 0.5px;">
                                Acknowledged Policies &amp; Agreements (@acceptedPoliciesList.Count)
                            </div>
                            
                            <div class="d-flex flex-column gap-2 mb-3">
                                @foreach (var pol in acceptedPoliciesList)
                                {
                                    <div class="p-2 px-3 rounded-3 border bg-light d-flex align-items-center justify-content-between flex-wrap gap-2">
                                        <div class="d-flex align-items-center gap-2 flex-wrap">
                                            <i class="bi bi-check-circle-fill text-success fs-6"></i>
                                            <span class="fw-semibold text-dark small">@pol.Title</span>
                                            @if (!string.IsNullOrEmpty(pol.Tag))
                                            {
                                                <span class="badge bg-white text-dark border border-secondary-subtle px-2 py-1 shadow-sm fw-semibold" style="font-size: 0.75rem;">@pol.Tag</span>
                                            }
                                        </div>
                                        <span class="badge py-1 px-3 small fw-bold shadow-sm d-inline-flex align-items-center gap-1" style="background-color: #15803d !important; color: #ffffff !important; border: 1px solid #166534 !important; font-size: 0.8rem; letter-spacing: 0.3px;">
                                            <i class="bi bi-shield-fill-check"></i>Accepted
                                        </span>
                                    </div>
                                }
                            </div>

                            <div class="row g-3 pt-2 border-top">
                                <div class="col-md-6">
                                    <div class="text-muted small">Applicant Digital Signature</div>
                                    <div class="fw-bold font-monospace bg-light p-2 rounded border text-dark">
                                        <i class="bi bi-pen me-1 text-primary"></i>@effectiveSignature
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="text-muted small">Submission Timestamp</div>
                                    <div class="fw-semibold p-2 bg-light rounded border text-dark">
                                        <i class="bi bi-calendar-check text-primary me-1"></i>
                                        @(string.IsNullOrEmpty(effectiveTimestamp) ? "Recorded" : effectiveTimestamp)
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- 6. MANUAL PAYMENT & DEPOSIT TRACKING LEDGER -->
                    <div class="card border rounded-3 shadow-none bg-white mb-3">
                        <div class="card-header bg-light py-2 px-3 fw-bold d-flex justify-content-between align-items-center">
                            <span><i class="bi bi-cash-stack text-success me-2"></i>Payment & Deposit Ledger</span>
                            <button type="button" class="btn btn-sm btn-success rounded-pill px-3 shadow-sm" @onclick="() => OpenRecordPaymentModal(_selectedEvent)">
                                <i class="bi bi-plus-circle me-1"></i>Record Payment / Deposit
                            </button>
                        </div>
                        <div class="card-body p-3">
                            @if (_selectedPayments.Any())
                            {
                                <div class="table-responsive">
                                    <table class="table table-sm table-hover align-middle mb-0">
                                        <thead class="table-light small">
                                            <tr>
                                                <th>Date</th>
                                                <th>Type</th>
                                                <th>Method</th>
                                                <th>Ref / Check #</th>
                                                <th>Amount</th>
                                                <th>Recorded By</th>
                                                <th class="text-end">Action</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var p in _selectedPayments)
                                            {
                                                <tr>
                                                    <td class="small">@p.PaymentDate.ToString("MM/dd/yyyy")</td>
                                                    <td>
                                                        <span class="badge @(p.PaymentType == "Security Deposit" ? "bg-warning text-dark" : (p.PaymentType == "Refund" ? "bg-danger" : "bg-success"))">
                                                            @p.PaymentType
                                                        </span>
                                                    </td>
                                                    <td class="small">@p.PaymentMethod</td>
                                                    <td class="small font-monospace">@(string.IsNullOrEmpty(p.ReferenceOrCheckNumber) ? "—" : p.ReferenceOrCheckNumber)</td>
                                                    <td class="fw-bold @(p.PaymentType == "Refund" ? "text-danger" : "text-success")">
                                                        @(p.PaymentType == "Refund" ? "-" : "")$@p.Amount.ToString("N2")
                                                    </td>
                                                    <td class="small text-muted">@p.RecordedBy</td>
                                                    <td class="text-end">
                                                        <button class="btn btn-link btn-sm text-danger p-0" title="Delete payment" @onclick="() => DeletePayment(p.Id)">
                                                            <i class="bi bi-trash"></i>
                                                        </button>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                            else
                            {
                                <div class="text-center py-3 text-muted small">
                                    <i class="bi bi-wallet2 fs-4 d-block mb-1 opacity-50"></i>
                                    No payments or deposits recorded yet.
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Collapsible Raw Notes Section -->
                    <div class="mt-3">
                        <button class="btn btn-link btn-sm text-decoration-none p-0 text-muted" type="button" @onclick="() => _showRawNotes = !_showRawNotes">
                            <i class="bi @(_showRawNotes ? "bi-chevron-up" : "bi-chevron-down") me-1"></i>
                            @(_showRawNotes ? "Hide Raw Notes" : "View Raw Description & Details")
                        </button>

                        @if (_showRawNotes && !string.IsNullOrEmpty(_selectedEvent.Description))
                        {
                            <div class="p-3 bg-light rounded-3 border mt-2">
                                <pre class="small mb-0 text-dark" style="white-space: pre-wrap; font-family: inherit;">@_selectedEvent.Description</pre>
                            </div>
                        }
                    </div>
                </div>

                <!-- Modal Footer -->
                <div class="modal-footer bg-light border-top p-3 px-4 d-flex justify-content-between flex-wrap gap-2">
                    <div class="d-flex align-items-center gap-2">
                        <button type="button" class="btn btn-outline-danger btn-sm shadow-sm" @onclick="PromptCancelOrRemoveEvent" title="Cancel booking or remove this event">
                            <i class="bi bi-x-circle me-1"></i>Cancel / Remove Event
                        </button>
                    </div>
                    <div class="d-flex gap-2 flex-wrap">
                        @if (isPending)
                        {
                            <button type="button" class="btn btn-primary px-3 shadow-sm" @onclick="ApproveBookingAsync" disabled="@_isApprovingBooking" title="Approve this rental booking and remove PENDING prefix">
                                @if (_isApprovingBooking)
                                {
                                    <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                                    <span>Approving...</span>
                                }
                                else
                                {
                                    <i class="bi bi-check2-circle me-1"></i>
                                    <span>Approve Booking</span>
                                }
                            </button>
                        }
                        <button type="button" class="btn btn-outline-dark px-3 shadow-sm" @onclick="PrintSelectedApplication">
                            <i class="bi bi-printer me-1"></i>Print / Save PDF
                        </button>
                        <button type="button" class="btn btn-success px-3 shadow-sm" @onclick="() => OpenRecordPaymentModal(_selectedEvent)">
                            <i class="bi bi-cash me-1"></i>Add Payment
                        </button>
                        @if (_settings.EnableWriteApi)
                        {
                            <button type="button" class="btn btn-warning px-3 shadow-sm" @onclick="() => OpenEditEventModal(_selectedEvent)">
                                <i class="bi bi-pencil-square me-1"></i>Edit Booking
                            </button>
                        }
                        <button type="button" class="btn btn-secondary px-4 shadow-sm" @onclick="() => _selectedEvent = null">Close</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<!-- PROFESSIONAL 1-PAGE PRINTABLE APPLICATION TEMPLATE (PRINT / SAVE TO PDF) -->
@if (_selectedEvent != null)
{
    var printAppDetails = ParseApplicationDetails(_selectedEvent);
    var printCleanTitle = GetCleanTitle(_selectedEvent);
    var printPaySummary = GetEventPaymentSummary(_selectedEvent);
    var printAgreedPolicies = GetAcceptedPoliciesForDisplay(_selectedRequest, printAppDetails);

    string printName = !string.IsNullOrWhiteSpace(_selectedRequest?.ApplicantName)
        ? _selectedRequest.ApplicantName
        : (!string.IsNullOrWhiteSpace(printAppDetails.ApplicantName) ? printAppDetails.ApplicantName : printCleanTitle);

    string printPhone = !string.IsNullOrWhiteSpace(_selectedRequest?.RequesterPhone)
        ? _selectedRequest.RequesterPhone
        : (printAppDetails.Phone ?? "N/A");

    string printEmail = !string.IsNullOrWhiteSpace(_selectedRequest?.RequesterEmail)
        ? _selectedRequest.RequesterEmail
        : (printAppDetails.Email ?? "N/A");

    string printAddress = !string.IsNullOrWhiteSpace(_selectedRequest?.RequesterAddress)
        ? $"{_selectedRequest.RequesterAddress}{(!string.IsNullOrWhiteSpace(_selectedRequest.RequesterCity) ? $", {_selectedRequest.RequesterCity}" : "")}{(!string.IsNullOrWhiteSpace(_selectedRequest.RequesterState) ? $", {_selectedRequest.RequesterState}" : "")}{(!string.IsNullOrWhiteSpace(_selectedRequest.RequesterZip) ? $" {_selectedRequest.RequesterZip}" : "")}"
        : (!string.IsNullOrWhiteSpace(printAppDetails.StreetAddress)
            ? $"{printAppDetails.StreetAddress}{(string.IsNullOrWhiteSpace(printAppDetails.City) ? "" : $", {printAppDetails.City}")}{(string.IsNullOrWhiteSpace(printAppDetails.State) ? "" : $", {printAppDetails.State}")}{(string.IsNullOrWhiteSpace(printAppDetails.Zip) ? "" : $" {printAppDetails.Zip}")}"
            : "None Provided");

    string printSignature = !string.IsNullOrWhiteSpace(_selectedRequest?.ApplicantSignature)
        ? _selectedRequest.ApplicantSignature
        : (!string.IsNullOrWhiteSpace(printAppDetails.ApplicantSignature) ? printAppDetails.ApplicantSignature : "Electronic Signature on Record");

    string printTimestamp = _selectedRequest != null && _selectedRequest.CreatedDate.Year > 2000
        ? _selectedRequest.CreatedDate.ToLocalTime().ToString("MMMM dd, yyyy 'at' h:mm tt")
        : (!string.IsNullOrEmpty(printAppDetails.FormattedTimestamp) ? printAppDetails.FormattedTimestamp : DateTime.Now.ToString("MMMM dd, yyyy 'at' h:mm tt"));

    string printEventDate = _selectedRequest != null && _selectedRequest.EventDate.Year > 2000
        ? _selectedRequest.EventDate.ToString("dddd, MMMM dd, yyyy")
        : (_selectedEvent.Start.Year > 2000 ? _selectedEvent.Start.ToString("dddd, MMMM dd, yyyy") : (printAppDetails.PreferredEventDate ?? "TBD"));

    string printTimeRange = (_selectedRequest != null && !string.IsNullOrEmpty(_selectedRequest.StartTime) && !string.IsNullOrEmpty(_selectedRequest.EndTime))
        ? $"{_selectedRequest.StartTime} - {_selectedRequest.EndTime}"
        : ((!string.IsNullOrEmpty(printAppDetails.StartTime) && !string.IsNullOrEmpty(printAppDetails.EndTime)) ? $"{printAppDetails.StartTime} - {printAppDetails.EndTime}" : "TBD");

    string statusClass = (_selectedRequest?.Status == "Approved" || _selectedEvent.Title.Contains("APPROVED", StringComparison.OrdinalIgnoreCase)) ? "status-approved" : "status-pending";
    string statusText = (_selectedRequest?.Status ?? (_selectedEvent.Title.Contains("APPROVED", StringComparison.OrdinalIgnoreCase) ? "Approved" : "Pending Review")).ToUpper();

    <div id="gfc-printable-application" class="d-none d-print-block print-container">
        <!-- 1. Executive Header -->
        <div class="print-brand-header">
            <div class="print-brand-left">
                <h1 class="print-org-name">GLOUCESTER FRATERNITY CLUB</h1>
                <div class="print-org-sub">27 Webster Street, Gloucester, MA 01930 &bull; (978) 283-2889 &bull; info@gloucesterfraternityclub.com</div>
            </div>
            <div class="print-brand-right">
                <div class="print-badge @statusClass">@statusText</div>
                <div class="print-meta-date">Printed: @DateTime.Now.ToString("MMM dd, yyyy")</div>
            </div>
        </div>

        <div class="print-doc-title-bar">
            <span>HALL RENTAL APPLICATION &amp; AGREEMENT RECORD</span>
            <span class="print-ref-id">Ref #@((_selectedRequest?.Id > 0) ? _selectedRequest.Id.ToString() : "REC-" + _selectedEvent.Start.ToString("yyyyMMdd"))</span>
        </div>

        <!-- 2. Two-Column Information Layout -->
        <div class="print-grid-2col">
            <!-- Left Column: Applicant & Event Details -->
            <div class="print-col">
                <div class="print-card">
                    <div class="print-card-header">
                        <span class="print-card-title">1. APPLICANT &amp; CONTACT DETAILS</span>
                    </div>
                    <div class="print-card-body">
                        <div class="print-field-row">
                            <span class="print-lbl">Applicant / Org:</span>
                            <span class="print-val fw-bold">@printName</span>
                        </div>
                        <div class="print-field-row">
                            <span class="print-lbl">Membership:</span>
                            <span class="print-val">@(_selectedRequest?.MemberStatus == true ? "Active Member" : "Non-Member")</span>
                        </div>
                        <div class="print-field-row">
                            <span class="print-lbl">Contact Phone:</span>
                            <span class="print-val">@printPhone</span>
                        </div>
                        <div class="print-field-row">
                            <span class="print-lbl">Email Address:</span>
                            <span class="print-val">@printEmail</span>
                        </div>
                        <div class="print-field-row">
                            <span class="print-lbl">Mailing Address:</span>
                            <span class="print-val">@printAddress</span>
                        </div>
                    </div>
                </div>

                <div class="print-card mt-2">
                    <div class="print-card-header">
                        <span class="print-card-title">2. EVENT SPECIFICATIONS</span>
                    </div>
                    <div class="print-card-body">
                        <div class="print-field-row">
                            <span class="print-lbl">Event Date:</span>
                            <span class="print-val fw-bold">@printEventDate</span>
                        </div>
                        <div class="print-field-row">
                            <span class="print-lbl">Time Range:</span>
                            <span class="print-val">@printTimeRange</span>
                        </div>
                        <div class="print-field-row">
                            <span class="print-lbl">Facility Room:</span>
                            <span class="print-val fw-bold">@(_selectedRequest?.RoomSelected ?? _selectedEvent.Location ?? "Function Hall")</span>
                        </div>
                        <div class="print-field-row">
                            <span class="print-lbl">Event Occasion:</span>
                            <span class="print-val">@(_selectedRequest?.EventType ?? printAppDetails.EventType ?? "General Rental")</span>
                        </div>
                        <div class="print-field-row">
                            <span class="print-lbl">Guest Attendance:</span>
                            <span class="print-val">@(_selectedRequest?.GuestCount > 0 ? _selectedRequest.GuestCount.ToString() : (printAppDetails.GuestCount ?? "Unspecified")) guests</span>
                        </div>
                        <div class="print-field-row">
                            <span class="print-lbl">Setup Time:</span>
                            <span class="print-val">@(_selectedRequest?.RequiresSetupTime == true ? "Yes (Requested)" : (printAppDetails.SetupTimeRequired ?? "No"))</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right Column: Services & Financial Breakdown -->
            <div class="print-col">
                <div class="print-card">
                    <div class="print-card-header">
                        <span class="print-card-title">3. AMENITIES &amp; SERVICES</span>
                    </div>
                    <div class="print-card-body">
                        <div class="print-service-grid">
                            <div class="print-service-item @(_selectedRequest?.BartenderRequested == true ? "active" : "")">
                                <span class="print-svc-icon">@(_selectedRequest?.BartenderRequested == true ? "☑" : "☐")</span>
                                <span class="print-svc-name">Bar / Bartender Service</span>
                            </div>
                            <div class="print-service-item @(_selectedRequest?.KitchenUsage == true ? "active" : "")">
                                <span class="print-svc-icon">@(_selectedRequest?.KitchenUsage == true ? "☑" : "☐")</span>
                                <span class="print-svc-name">Kitchen Access</span>
                            </div>
                            <div class="print-service-item @(_selectedRequest?.AvEquipmentUsage == true ? "active" : "")">
                                <span class="print-svc-icon">@(_selectedRequest?.AvEquipmentUsage == true ? "☑" : "☐")</span>
                                <span class="print-svc-name">A/V Sound &amp; Projector</span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="print-card mt-2">
                    <div class="print-card-header">
                        <span class="print-card-title">4. FINANCIAL SUMMARY &amp; PAYMENTS</span>
                    </div>
                    <div class="print-card-body p-0">
                        <div class="print-ledger-tiles">
                            <div class="print-tile">
                                <span class="print-tile-lbl">Total Quoted</span>
                                <span class="print-tile-val fw-bold">$@printPaySummary.TotalPrice.ToString("N2")</span>
                            </div>
                            <div class="print-tile">
                                <span class="print-tile-lbl">Security Deposit</span>
                                <span class="print-tile-val">$@printPaySummary.DepositRequired.ToString("N2")</span>
                            </div>
                            <div class="print-tile highlight-green">
                                <span class="print-tile-lbl">Total Paid</span>
                                <span class="print-tile-val">$@printPaySummary.TotalPaid.ToString("N2")</span>
                            </div>
                            <div class="print-tile @(printPaySummary.RemainingBalance > 0 ? "highlight-red" : "highlight-green")">
                                <span class="print-tile-lbl">Balance Due</span>
                                <span class="print-tile-val fw-bold">$@printPaySummary.RemainingBalance.ToString("N2")</span>
                            </div>
                        </div>

                        @if (_selectedPayments.Any())
                        {
                            <div class="print-pay-history">
                                <div class="print-subhead">Recorded Payments &amp; Deposits</div>
                                <table class="print-mini-table">
                                    <thead>
                                        <tr>
                                            <th>Date</th>
                                            <th>Type</th>
                                            <th>Method / Ref</th>
                                            <th class="text-end">Amount</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var p in _selectedPayments.Take(3))
                                        {
                                            <tr>
                                                <td>@p.PaymentDate.ToString("MM/dd/yy")</td>
                                                <td>@p.PaymentType</td>
                                                <td>@p.PaymentMethod @(!string.IsNullOrEmpty(p.ReferenceOrCheckNumber) ? $"({p.ReferenceOrCheckNumber})" : "")</td>
                                                <td class="text-end fw-bold">@(p.PaymentType == "Refund" ? "-" : "")$@p.Amount.ToString("N2")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- 3. Accepted Agreements & Policies (Clean multi-column list) -->
        <div class="print-card mt-2">
            <div class="print-card-header">
                <span class="print-card-title">5. ACKNOWLEDGED POLICIES &amp; ACCEPTED TERMS (@printAgreedPolicies.Count)</span>
            </div>
            <div class="print-card-body py-1">
                <div class="print-policies-grid">
                    @foreach (var pol in printAgreedPolicies)
                    {
                        <div class="print-policy-pill">
                            <span class="print-check-mark">✓</span>
                            <span class="print-pol-title">@pol.Title</span>
                            @if (!string.IsNullOrEmpty(pol.Tag))
                            {
                                <span class="print-pol-tag">(@pol.Tag)</span>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- 4. Electronic Signature & Legal Execution Box -->
        <div class="print-card mt-2 print-signature-card">
            <div class="print-sig-row">
                <div class="print-sig-block">
                    <div class="print-sig-lbl">Applicant Electronic Signature (Legal Acceptance):</div>
                    <div class="print-sig-val">@printSignature</div>
                </div>
                <div class="print-sig-block">
                    <div class="print-sig-lbl">Submission Timestamp:</div>
                    <div class="print-sig-ts">@printTimestamp</div>
                </div>
            </div>
            <div class="print-legal-notice">
                By electronically signing, the applicant affirms they are 21+ years of age and agrees to all Gloucester Fraternity Club bylaws, hall rental rules, kitchen policies, and payment terms.
            </div>
        </div>
    </div>
}



<!-- ADD / EDIT GOOGLE CALENDAR EVENT MODAL -->
@if (_showEditEventModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.7); z-index: 1055;" role="dialog">
        <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
            <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="modal-header bg-light border-bottom p-3 px-4">
                    <div class="d-flex align-items-center gap-2">
                        <div class="p-2 rounded-circle bg-success-subtle text-success">
                            <i class="bi @(_isNewEvent ? "bi-calendar-plus" : "bi-pencil-square") fs-5"></i>
                        </div>
                        <div>
                            <h5 class="modal-title fw-bold mb-0">@(_isNewEvent ? "Add New Rental / Booking" : "Edit Booking in Google Calendar")</h5>
                            <small class="text-muted">Updates will synchronize directly to Google Calendar</small>
                        </div>
                    </div>
                    <button type="button" class="btn-close" @onclick="() => _showEditEventModal = false"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label fw-semibold small">Event / Reservation Title <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" placeholder="e.g. Hall Rental: John Doe Wedding" @bind="_editEventModel.Title" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold small">Start Date & Time <span class="text-danger">*</span></label>
                            <input type="datetime-local" class="form-control" @bind="_editEventModel.Start" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold small">End Date & Time <span class="text-danger">*</span></label>
                            <input type="datetime-local" class="form-control" @bind="_editEventModel.End" />
                        </div>

                        <div class="col-12">
                            <label class="form-label fw-semibold small">Location / Facility Room</label>
                            <input type="text" class="form-control" placeholder="e.g. Main Function Hall, Pavilion, Directors Room" @bind="_editEventModel.Location" />
                        </div>

                        <div class="col-12">
                            <label class="form-label fw-semibold small">Booking Details & Application Notes</label>
                            <textarea class="form-control" rows="6" placeholder="Enter rental details, applicant contact info, bar service or kitchen access notes..." @bind="_editEventModel.Description"></textarea>
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(_editEventError))
                    {
                        <div class="alert alert-danger py-2 px-3 mt-3 mb-0 border-0 rounded-3 small">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>
                            @_editEventError
                        </div>
                    }
                </div>
                <div class="modal-footer bg-light border-top p-3 px-4">
                    <button type="button" class="btn btn-light" @onclick="() => _showEditEventModal = false" disabled="@_isSavingEvent">Cancel</button>
                    <button type="button" class="btn btn-primary px-4 shadow-sm" @onclick="SaveGoogleEvent" disabled="@_isSavingEvent">
                        @if (_isSavingEvent)
                        {
                            <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                            <span>Saving to Google Calendar...</span>
                        }
                        else
                        {
                            <i class="bi bi-cloud-check me-1"></i>
                            <span>@(_isNewEvent ? "Create Booking" : "Update in Google Calendar")</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- CANCEL OR REMOVE EVENT MODAL -->
@if (_showCancelEventConfirm && _eventToCancelOrRemove != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.75); z-index: 1065;" role="dialog">
        <div class="modal-dialog modal-dialog-centered" style="max-width: 500px;" role="document">
            <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="modal-header bg-danger text-white p-3 px-4">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-exclamation-triangle-fill fs-4"></i>
                        <h5 class="modal-title fw-bold mb-0">Cancel or Remove Booking</h5>
                    </div>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseCancelEventConfirm" disabled="@_isProcessingCancelOrRemove"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <div class="fw-bold text-dark fs-6 mb-1">@_eventToCancelOrRemove.Title</div>
                        <div class="text-muted small">
                            <i class="bi bi-calendar3 me-1"></i>@_eventToCancelOrRemove.Start.ToString("dddd, MMMM dd, yyyy")
                            <span class="mx-1">•</span>
                            <i class="bi bi-clock me-1"></i>@_eventToCancelOrRemove.Start.ToString("h:mm tt") - @_eventToCancelOrRemove.End.ToString("h:mm tt")
                        </div>
                    </div>

                    <p class="text-secondary small mb-4">
                        Please choose how you would like to handle this pending event / rental booking:
                    </p>

                    <div class="d-grid gap-3">
                        <button type="button" class="btn btn-outline-warning text-dark text-start p-3 rounded-3 border d-flex align-items-start gap-3 shadow-sm hover-shadow" @onclick="MarkBookingCancelledAsync" disabled="@_isProcessingCancelOrRemove">
                            <i class="bi bi-slash-circle fs-3 text-warning"></i>
                            <div>
                                <strong class="d-block text-dark">Mark as Cancelled</strong>
                                <small class="text-muted">Keeps the record in your database for audit history, but changes status to Cancelled and frees up the calendar.</small>
                            </div>
                        </button>

                        <button type="button" class="btn btn-outline-danger text-start p-3 rounded-3 border d-flex align-items-start gap-3 shadow-sm hover-shadow" @onclick="PermanentlyDeleteBookingAsync" disabled="@_isProcessingCancelOrRemove">
                            <i class="bi bi-trash3-fill fs-3 text-danger"></i>
                            <div>
                                <strong class="d-block text-danger">Delete &amp; Remove Completely</strong>
                                <small class="text-muted">Permanently deletes the application from the database and removes the scheduled event from Google Calendar.</small>
                            </div>
                        </button>
                    </div>

                    @if (_isProcessingCancelOrRemove)
                    {
                        <div class="text-center mt-3 text-primary">
                            <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                            <span class="small fw-bold">Processing request...</span>
                        </div>
                    }
                </div>
                <div class="modal-footer bg-light p-3 px-4">
                    <button type="button" class="btn btn-secondary px-4 shadow-sm" @onclick="CloseCancelEventConfirm" disabled="@_isProcessingCancelOrRemove">
                        Dismiss
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- ========================================================================= -->
<!-- MANUAL PAYMENT RECORDING MODAL -->
<!-- ========================================================================= -->
@if (_showRecordPaymentModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.65);" role="dialog">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="modal-header bg-success text-white p-3 px-4">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-cash-coin fs-4"></i>
                        <h5 class="modal-title fw-bold mb-0">Record Payment / Deposit</h5>
                    </div>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => _showRecordPaymentModal = false"></button>
                </div>
                <EditForm Model="@_paymentModel" OnValidSubmit="SavePayment">
                    <div class="modal-body p-4">
                        @if (!string.IsNullOrEmpty(_paymentError))
                        {
                            <div class="alert alert-danger py-2 small">@_paymentError</div>
                        }

                        <div class="mb-3">
                            <label class="form-label fw-bold small">Payment Category *</label>
                            <select class="form-select" @bind="_paymentModel.PaymentType">
                                <option value="Security Deposit">Security Deposit</option>
                                <option value="Rental Fee">Rental Fee</option>
                                <option value="Bartender Fee">Bartender Fee</option>
                                <option value="Kitchen Fee">Kitchen Fee</option>
                                <option value="Extra Hours">Extra Hours</option>
                                <option value="Refund">Deposit Refund</option>
                            </select>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-6">
                                <label class="form-label fw-bold small">Amount ($) *</label>
                                <div class="input-group">
                                    <span class="input-group-text">$</span>
                                    <InputNumber class="form-control fw-bold" @bind-Value="_paymentModel.Amount" min="1" step="0.01" />
                                </div>
                            </div>
                            <div class="col-6">
                                <label class="form-label fw-bold small">Date Received *</label>
                                <InputDate class="form-control" @bind-Value="_paymentModel.PaymentDate" />
                            </div>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-6">
                                <label class="form-label fw-bold small">Payment Method</label>
                                <select class="form-select" @bind="_paymentModel.PaymentMethod">
                                    <option value="Check">Check</option>
                                    <option value="Cash">Cash</option>
                                    <option value="Venmo / Zelle">Venmo / Zelle</option>
                                    <option value="Credit / Debit Card">Credit / Debit Card</option>
                                    <option value="Dropped Off / In-Person">Dropped Off / In-Person</option>
                                </select>
                            </div>
                            <div class="col-6">
                                <label class="form-label fw-bold small">Check / Reference #</label>
                                <InputText class="form-control font-monospace" placeholder="e.g. Check #1042" @bind-Value="_paymentModel.ReferenceOrCheckNumber" />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold small">Notes / Description</label>
                            <InputTextArea class="form-control" rows="2" placeholder="Optional notes regarding this payment..." @bind-Value="_paymentModel.Notes" />
                        </div>
                    </div>
                    <div class="modal-footer bg-light border-top p-3 px-4 d-flex justify-content-between">
                        <button type="button" class="btn btn-outline-secondary" @onclick="() => _showRecordPaymentModal = false">Cancel</button>
                        <button type="submit" class="btn btn-success px-4 fw-bold shadow-sm" disabled="@_isSavingPayment">
                            @if (_isSavingPayment)
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span>
                                <span>Saving...</span>
                            }
                            else
                            {
                                <i class="bi bi-check-circle me-1"></i>
                                <span>Save Payment</span>
                            }
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

<!-- ========================================================================= -->
<!-- MANUAL TEST FORM / SIMULATOR ENTRY MODAL -->
<!-- ========================================================================= -->
@if (_showTestSimulatorModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.7); z-index: 1055;" role="dialog">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable" role="document">
            <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="modal-header bg-warning text-dark p-3 px-4">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-controller fs-4"></i>
                        <div>
                            <h5 class="modal-title fw-bold mb-0">Test Form Submission Simulator</h5>
                            <small class="text-dark-50">Enter manual data to test calculation, database recording, and notification routing</small>
                        </div>
                    </div>
                    <button type="button" class="btn-close" @onclick="() => _showTestSimulatorModal = false"></button>
                </div>

                <div class="modal-body p-4">
                    <!-- Preset Quick Fill Bar -->
                    <div class="p-3 bg-light rounded-3 border mb-4">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="small fw-bold text-dark"><i class="bi bi-lightning-charge-fill text-warning me-1"></i>Quick Preset Auto-Fill:</span>
                            <span class="badge bg-secondary">Sandbox Mode</span>
                        </div>
                        <div class="d-flex gap-2 flex-wrap">
                            <button type="button" class="btn btn-sm btn-outline-primary" @onclick='() => ApplyTestFormPreset("wedding")'>
                                Wedding Reception (Function Hall + Bar + Kitchen)
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-success" @onclick='() => ApplyTestFormPreset("birthday")'>
                                Birthday Party (Coalition Room)
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-info" @onclick='() => ApplyTestFormPreset("youth")'>
                                Youth Sports Banquet
                            </button>
                        </div>
                    </div>

                    <EditForm Model="@_manualTestModel" OnValidSubmit="SubmitManualTestSimulation">
                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label class="form-label fw-bold small">Applicant / Organization Name *</label>
                                <InputText class="form-control" placeholder="e.g. John Doe (Test Event)" @bind-Value="_manualTestModel.ApplicantName" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold small">Email Address *</label>
                                <InputText class="form-control" type="email" placeholder="test-applicant@example.com" @bind-Value="_manualTestModel.RequesterEmail" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold small">Phone Number</label>
                                <InputText class="form-control" placeholder="(978) 555-0199" @bind-Value="_manualTestModel.RequesterPhone" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold small">Desired Event Date *</label>
                                <InputDate class="form-control" @bind-Value="_manualTestModel.EventDate" />
                            </div>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-4">
                                <label class="form-label fw-bold small">Room Selection</label>
                                <select class="form-select" @bind="_manualTestModel.RoomSelected" @bind:after="RecalculateManualTestQuote">
                                    @foreach (var r in (_editableRooms.Any() ? _editableRooms : (_webSettings?.GetRoomsList() ?? new List<RentalRoomOption>())))
                                    {
                                        <option value="@r.Name">@r.Name (Capacity: @r.Capacity)</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-bold small">Event Type</label>
                                <InputText class="form-control" placeholder="e.g. Anniversary Party" @bind-Value="_manualTestModel.EventType" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-bold small">Guest Count</label>
                                <InputNumber class="form-control" @bind-Value="_manualTestModel.GuestCount" />
                            </div>
                        </div>

                        <!-- Membership & Options -->
                        <div class="card p-3 bg-light border-0 rounded-3 mb-3">
                            <label class="form-label fw-bold small mb-2">Applicant Status & Add-ons</label>
                            <div class="row g-2">
                                <div class="col-md-3">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" id="testMemCheck" @bind="_manualTestModel.MemberStatus" @bind:after="RecalculateManualTestQuote" />
                                        <label class="form-check-label small" for="testMemCheck">GFC Member Rate</label>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" id="testBarCheck" @bind="_manualTestModel.BartenderRequested" @bind:after="RecalculateManualTestQuote" />
                                        <label class="form-check-label small" for="testBarCheck">Bar Service</label>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" id="testKitchCheck" @bind="_manualTestModel.KitchenUsage" @bind:after="RecalculateManualTestQuote" />
                                        <label class="form-check-label small" for="testKitchCheck">Kitchen Access</label>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" id="testAvCheck" @bind="_manualTestModel.AvEquipmentUsage" @bind:after="RecalculateManualTestQuote" />
                                        <label class="form-check-label small" for="testAvCheck">AV / Projector</label>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Live Quote Calculation Preview -->
                        <div class="p-3 bg-light border rounded-3 d-flex justify-content-between align-items-center mb-3">
                            <div>
                                <small class="text-primary text-uppercase fw-bold">Simulated Calculated Total</small>
                                <h4 class="mb-0 text-success fw-bold">$@_manualTestModel.TotalPrice.ToString("N2")</h4>
                            </div>
                            <div class="text-end">
                                <small class="text-muted">Security Deposit: $@_manualTestModel.SecurityDepositAmount.ToString("N2")</small>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center">
                            <button type="button" class="btn btn-outline-secondary" @onclick="() => _showTestSimulatorModal = false">Cancel</button>
                            <button type="submit" class="btn btn-warning px-4 fw-bold shadow-sm text-dark" disabled="@_isSubmittingManualTest">
                                @if (_isSubmittingManualTest)
                                {
                                    <span class="spinner-border spinner-border-sm me-1"></span>
                                    <span>Simulating...</span>
                                }
                                else
                                {
                                    <i class="bi bi-send-check-fill me-1"></i>
                                    <span>Submit Test Simulation</span>
                                }
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

