    private string GetCleanTitle(CalendarEventItem evt)
    {
        var title = evt.Title ?? string.Empty;
        
        // Strip [TEST] prefix if present
        if (title.StartsWith("[TEST]", StringComparison.OrdinalIgnoreCase))
        {
            title = title.Substring(6).Trim();
        }

        // Strip PENDING prefixes
        if (title.StartsWith("PENDING -", StringComparison.OrdinalIgnoreCase))
        {
            title = title.Substring(9).Trim();
        }
        else if (title.StartsWith("PENDING:", StringComparison.OrdinalIgnoreCase))
        {
            title = title.Substring(8).Trim();
        }
        else if (title.StartsWith("PENDING", StringComparison.OrdinalIgnoreCase))
        {
            title = title.Substring(7).Trim(' ', '-', ':').Trim();
        }

        // Strip APPROVED prefixes
        if (title.StartsWith("APPROVED -", StringComparison.OrdinalIgnoreCase))
        {
            title = title.Substring(10).Trim();
        }
        else if (title.StartsWith("APPROVED:", StringComparison.OrdinalIgnoreCase))
        {
            title = title.Substring(9).Trim();
        }
        else if (title.StartsWith("APPROVED", StringComparison.OrdinalIgnoreCase))
        {
            title = title.Substring(8).Trim(' ', '-', ':').Trim();
        }

        return string.IsNullOrWhiteSpace(title) ? "Hall Rental Event" : title;
    }

    private List<CalendarEventItem> GetEventsForDate(DateTime date)
    {
        var list = _events.Where(e => e.Start.Date == date.Date);
        if (!string.IsNullOrEmpty(_filterFeedSource))
        {
            list = list.Where(e => e.Source == _filterFeedSource);
        }
        return list.OrderBy(e => e.Start).ToList();
    }

    private int GetUpcomingCount()
    {
        var today = DateTime.Today;
        return _events.Count(e => e.Start >= today && e.Start <= today.AddDays(30));
    }

    private int GetPendingCount()
    {
        return _events.Count(e => e.Title.Contains("PENDING", StringComparison.OrdinalIgnoreCase));
    }

    private List<CalendarEventItem> GetFilteredEvents()
    {
        var list = _events.AsEnumerable();

        if (!string.IsNullOrEmpty(_filterFeedSource))
        {
            list = list.Where(e => e.Source == _filterFeedSource);
        }

        if (_filterCategory == "PENDING")
        {
            list = list.Where(e => e.Title.StartsWith("PENDING", StringComparison.OrdinalIgnoreCase));
        }
        else if (_filterCategory == "PAID")
        {
            list = list.Where(e => GetEventPaymentStatus(e) == "Paid");
        }
        else if (_filterCategory == "UNPAID")
        {
            list = list.Where(e => GetEventPaymentStatus(e) != "Paid");
        }
        else if (_filterCategory == "APPLICATIONS")
        {
            list = list.Where(e => !string.IsNullOrEmpty(e.Description) && 
                                  (e.Description.Contains("Hall Rental", StringComparison.OrdinalIgnoreCase) ||
                                   e.Description.Contains("Preferred Event Date", StringComparison.OrdinalIgnoreCase) ||
                                   e.Description.Contains("Applicant", StringComparison.OrdinalIgnoreCase)));
        }

        if (!string.IsNullOrWhiteSpace(_searchTerm))
        {
            var q = _searchTerm.ToLowerInvariant();
            list = list.Where(e => e.Title.ToLower().Contains(q) ||
                                  (e.Description ?? "").ToLower().Contains(q) ||
                                  (e.Location ?? "").ToLower().Contains(q) ||
                                  e.Start.ToString("yyyy-MM-dd").Contains(q));
        }

        return list.OrderByDescending(e => e.Start.Year > 2000)
                   .ThenByDescending(e => e.Start)
                   .ToList();
    }

    private ParsedApplicationData ParseApplicationDetails(CalendarEventItem evt)
    {
        var data = new ParsedApplicationData();
        var desc = evt.Description;

        // Default name from title if available (e.g. "Daniel Fialho (Bar)" -> "Daniel Fialho")
        var cleanTitle = GetCleanTitle(evt);
        if (!string.IsNullOrEmpty(cleanTitle))
        {
            var parenIndex = cleanTitle.IndexOf('(');
            data.ApplicantName = parenIndex > 0 ? cleanTitle.Substring(0, parenIndex).Trim() : cleanTitle;
            if (cleanTitle.Contains("(Bar)", StringComparison.OrdinalIgnoreCase))
            {
                data.BarService = "Yes";
            }
        }

        if (string.IsNullOrWhiteSpace(desc)) return data;

        // 1. Unify all HTML line breaks into real newlines
        var clean = Regex.Replace(desc, @"<br\s*/?>|</?p>", "\n", RegexOptions.IgnoreCase);
        clean = clean.Replace("&nbsp;", " ")
                     .Replace("&amp;", "&")
                     .Replace("&#39;", "'")
                     .Replace("&quot;", "\"")
                     .Replace("&lt;", "<")
                     .Replace("&gt;", ">");

        var lines = clean.Split(new[] { "\r\n", "\r", "\n" }, StringSplitOptions.RemoveEmptyEntries);
        foreach (var rawLine in lines)
        {
            var line = rawLine.Trim();
            var colonIndex = line.IndexOf(':');
            if (colonIndex <= 0) continue;

            var key = line.Substring(0, colonIndex).Trim();
            var val = line.Substring(colonIndex + 1).Trim();

            if (string.IsNullOrEmpty(val)) continue;

            data.HasStructuredData = true;

            switch (key.ToLowerInvariant())
            {
                case "full name (applicant)":
                case "applicant name":
                case "applicant":
                case "requester name":
                case "name":
                case "applicant / organization":
                case "renter":
                    data.ApplicantName = val;
                    break;
                case "contact phone number":
                case "phone number":
                case "phone":
                case "contact phone":
                case "contact":
                case "cell":
                case "tel":
                    data.Phone = val;
                    break;
                case "email address":
                case "email":
                case "contact email":
                    data.Email = val;
                    break;
                case "street address":
                case "address":
                case "mailing address":
                case "street":
                    data.StreetAddress = val;
                    break;
                case "city":
                    data.City = val;
                    break;
                case "state":
                    data.State = val;
                    break;
                case "zip":
                    data.Zip = val;
                    break;
                case "are you a club member?":
                case "club member":
                    data.IsClubMember = val;
                    break;
                case "type of event":
                case "event type":
                    data.EventType = val;
                    break;
                case "event description":
                case "description":
                case "event details":
                    data.EventDescription = val;
                    break;
                case "preferred event date":
                case "event date":
                    data.PreferredEventDate = val;
                    break;
                case "alternate date (if first choice is unavailable)":
                case "alternate date":
                    data.AlternateDate = val;
                    break;
                case "event start time":
                case "start time":
                    data.StartTime = val;
                    break;
                case "event end time":
                case "end time":
                    data.EndTime = val;
                    break;
                case "estimated number of guests":
                case "guest count":
                case "number of guests":
                    data.GuestCount = val;
                    break;
                case "do you require setup time prior to the start time above?":
                case "setup time":
                    data.SetupTimeRequired = val;
                    break;
                case "kitchen access requested?":
                case "kitchen access":
                    data.KitchenAccess = val;
                    break;
                case "bar service (alcohol & bartender - additional cost)?":
                case "bar service":
                    data.BarService = val;
                    break;
                case "applicant signature":
                case "signature":
                    data.ApplicantSignature = val;
                    break;
                case "timestamp":
                    data.Timestamp = val;
                    if (DateTime.TryParse(val, out var parsedTs))
                    {
                        data.FormattedTimestamp = parsedTs.ToString("MMMM dd, yyyy 'at' h:mm tt");
                    }
                    else
                    {
                        data.FormattedTimestamp = val;
                    }
                    break;
                default:
                    if (!key.Equals("Hall Rental Application Details", StringComparison.OrdinalIgnoreCase))
                    {
                        data.ExtraFields[key] = val;
                    }
                    break;
            }
        }

        return data;
    }

