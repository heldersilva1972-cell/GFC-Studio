                            sb.AppendLine($"<small style='color: #94a3b8;'>Gloucester Fraternity Club &bull; 27 Webster Street, Gloucester, MA 01930 &bull; (978) 283-2889</small>");
                            sb.AppendLine($"</div>");

                            var sendRes = await RentalEmailDispatcher.SendRentalEmailAsync(settings, _selectedRequest.RequesterEmail, subject, sb.ToString(), settings.RentalEmailCc);
                            if (sendRes.Success)
                            {
                                await AppendAuditEmailLogAsync(_selectedRequest, "Updated Booking & Quote Notice", _selectedRequest.RequesterEmail, subject, noteSnapshot);
                            }
                        }
                    }
                    catch { }
                });
            }

            await LoadAllRequestsAndPayments();
            ToastService.ShowSuccess($"Booking & pricing updated successfully! ({_detectedDiffs.Count} changes recorded)");

            _showConfirmChangesModal = false;
            _isEditingBooking = false;
            _editingSection = null;
            _originalBookingSnapshot = null;
            _sendUpdatedQuoteEmail = false;
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Failed to save booking modifications: {ex.Message}");
        }
        finally
        {
            _isSavingAdjustments = false;
        }
    }

