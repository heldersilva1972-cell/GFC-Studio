    private bool IsEventMatchingFilter(CalendarEventItem e)
    {
        if (!string.IsNullOrEmpty(_filterFeedSource) && e.Source != _filterFeedSource)
        {
            return false;
        }

        bool isCanc = string.Equals(e.Status, "CANCELLED", StringComparison.OrdinalIgnoreCase) || 
                      string.Equals(e.Status, "REJECTED", StringComparison.OrdinalIgnoreCase) || 
                      e.Title.StartsWith("CANCELLED", StringComparison.OrdinalIgnoreCase);

        bool isInq = string.Equals(e.Status, "INQUIRY", StringComparison.OrdinalIgnoreCase) || 
                     string.Equals(e.Status, "RESPONDED", StringComparison.OrdinalIgnoreCase) ||
                     e.Title.StartsWith("INQUIRY", StringComparison.OrdinalIgnoreCase) ||
                     e.Source == "General Inquiry";

        bool isArchived = string.Equals(e.Status, "ARCHIVED", StringComparison.OrdinalIgnoreCase) ||
                          e.Title.StartsWith("ARCHIVED INQUIRY", StringComparison.OrdinalIgnoreCase);

        // When viewing Calendar grid or in calendar mode, never show Inquiries or Cancelled/Archived events
        if (_activeView == "calendar" || _isCalendarOnlyMode)
        {
            if (isInq || isCanc || isArchived)
            {
                return false;
            }
        }

        if (_filterCategory == "CLUB_EVENTS")
        {
            if (!IsClubEvent(e)) return false;
        }
        else if (_filterCategory == "PENDING_INQUIRIES")
        {
            bool isPending = IsEventPending(e);
            if (!isPending && !isInq) return false;
        }
        else if (_filterCategory == "PENDING")
        {
            if (!IsEventPending(e)) return false;
        }
        else if (_filterCategory == "PAID")
        {
            var st = GetEventPaymentStatus(e);
            if (st != "Paid" && st != "Waived" && !st.StartsWith("Paid (Waiver", StringComparison.OrdinalIgnoreCase)) return false;
        }
        else if (_filterCategory == "UNPAID")
        {
            var st = GetEventPaymentStatus(e);
            if (st == "Paid" || st == "Waived" || st.StartsWith("Paid (Waiver", StringComparison.OrdinalIgnoreCase)) return false;
        }
        else if (_filterCategory == "APPLICATIONS")
        {
            bool isApp = !string.IsNullOrEmpty(e.Description) && 
                         (e.Description.Contains("Hall Rental", StringComparison.OrdinalIgnoreCase) ||
                          e.Description.Contains("Preferred Event Date", StringComparison.OrdinalIgnoreCase) ||
                          e.Description.Contains("Applicant", StringComparison.OrdinalIgnoreCase) ||
                          e.Source == "Rental Booking" ||
                          e.Source == "Sandbox Booking");
            if (!isApp) return false;
        }
        else if (_filterCategory == "CANCELLED")
        {
            if (!isCanc) return false;
        }
        else if (_filterCategory == "INQUIRIES")
        {
            if (!isInq) return false;
        }
        else if (_filterCategory == "ARCHIVED_INQUIRIES")
        {
            if (!isArchived) return false;
        }

        if (!string.IsNullOrWhiteSpace(_searchTerm))
        {
            var q = _searchTerm.ToLowerInvariant();
            bool matchesSearch = e.Title.ToLower().Contains(q) ||
                                 (e.Description ?? "").ToLower().Contains(q) ||
                                 (e.Location ?? "").ToLower().Contains(q) ||
                                 e.Start.ToString("yyyy-MM-dd").Contains(q);
            if (!matchesSearch) return false;
        }

        return true;
    }

    private bool IsEventPending(CalendarEventItem evt)
    {
        var matched = FindMatchingRentalRequest(evt);
        if (matched != null)
        {
            if (string.Equals(matched.Status, "Approved", StringComparison.OrdinalIgnoreCase)) return false;
            if (string.Equals(matched.Status, "Cancelled", StringComparison.OrdinalIgnoreCase)) return false;
            return string.Equals(matched.Status, "Pending", StringComparison.OrdinalIgnoreCase);
        }

        if (string.Equals(evt.Status, "CONFIRMED", StringComparison.OrdinalIgnoreCase) || evt.Title.StartsWith("APPROVED", StringComparison.OrdinalIgnoreCase))
            return false;

        return evt.Title.Contains("PENDING", StringComparison.OrdinalIgnoreCase) || string.Equals(evt.Status, "PENDING", StringComparison.OrdinalIgnoreCase);
    }

    private List<CalendarEventItem> GetEventsForDate(DateTime date)
    {
        return _events.Where(e => e.Start.Date == date.Date && IsEventMatchingFilter(e))
                      .OrderBy(e => e.Start)
                      .ToList();
    }

    private int GetUpcomingCount()
    {
        var today = DateTime.Today;
        return _events.Count(e => e.Start >= today && e.Start <= today.AddDays(30));
    }

    private int GetPendingCount()
    {
        return _events.Count(e => IsEventPending(e));
    }

    private int GetPendingAndInquiriesCount()
    {
        return GetPendingCount() + GetInquiriesCount();
    }

    private int GetCancelledCount()
    {
        return _cachedRentalRequests.Count(r => string.Equals(r.Status, "Cancelled", StringComparison.OrdinalIgnoreCase));
    }

    private int GetInquiriesCount()
    {
        return _cachedRentalRequests.Count(r => string.Equals(r.Status, "Inquiry", StringComparison.OrdinalIgnoreCase) || string.Equals(r.Status, "Responded", StringComparison.OrdinalIgnoreCase));
    }

    private int GetArchivedInquiriesCount()
    {
        return _cachedRentalRequests.Count(r => string.Equals(r.Status, "Archived", StringComparison.OrdinalIgnoreCase));
    }

    private int GetApplicationsCount()
    {
        return _events.Count(e => !string.IsNullOrEmpty(e.Description) && 
                                  (e.Description.Contains("Hall Rental", StringComparison.OrdinalIgnoreCase) ||
                                   e.Description.Contains("Preferred Event Date", StringComparison.OrdinalIgnoreCase) ||
                                   e.Description.Contains("Applicant", StringComparison.OrdinalIgnoreCase) ||
                                   e.Source == "Rental Booking" ||
                                   e.Source == "Sandbox Booking"));
    }

    private List<CalendarEventItem> GetFilteredEvents()
    {
        List<CalendarEventItem> list;

        if (_filterCategory == "CANCELLED")
        {
            list = new List<CalendarEventItem>();
            var cancelledRequests = _cachedRentalRequests.Where(r => string.Equals(r.Status, "Cancelled", StringComparison.OrdinalIgnoreCase)).ToList();
            foreach (var req in cancelledRequests)
            {
                DateTime start = req.EventDate.Date.AddHours(12);
                DateTime end = req.EventDate.Date.AddHours(17);
                if (!string.IsNullOrWhiteSpace(req.StartTime) && DateTime.TryParse(req.StartTime, out var ps)) start = req.EventDate.Date.Add(ps.TimeOfDay);
                if (!string.IsNullOrWhiteSpace(req.EndTime) && DateTime.TryParse(req.EndTime, out var pe)) end = req.EventDate.Date.Add(pe.TimeOfDay);

                list.Add(new CalendarEventItem
                {
                    GoogleEventId = $"db-rental-{req.Id}",
                    Title = $"CANCELLED: {req.ApplicantName} ({req.EventType ?? "Rental"})",
                    Start = start,
                    End = end,
                    Location = req.RoomSelected ?? "Function Hall",
                    Source = "Rental Booking",
                    Status = "CANCELLED",
                    ColorCategory = "badge-danger",
                    Description = $"Applicant: {req.ApplicantName}\nPhone: {req.RequesterPhone}\nEmail: {req.RequesterEmail}\nAddress: {req.RequesterAddress}\nRoom: {req.RoomSelected}\nGuests: {req.GuestCount}\nTotal: ${req.TotalPrice:N2}",
                    CreatedDate = req.CreatedDate != default ? req.CreatedDate : (req.RequestedDate != default ? req.RequestedDate : null)
                });
            }
        }
        else if (_filterCategory == "INQUIRIES")
        {
            // Filter directly from _events which already contains all active inquiries
            list = _events.Where(e => string.Equals(e.Status, "INQUIRY", StringComparison.OrdinalIgnoreCase) || 
                                      string.Equals(e.Status, "RESPONDED", StringComparison.OrdinalIgnoreCase) ||
                                      e.Title.StartsWith("INQUIRY", StringComparison.OrdinalIgnoreCase) ||
                                      e.Source == "General Inquiry").ToList();
        }
        else if (_filterCategory == "ARCHIVED_INQUIRIES")
        {
            list = new List<CalendarEventItem>();
            var archivedInquiries = _cachedRentalRequests.Where(r => string.Equals(r.Status, "Archived", StringComparison.OrdinalIgnoreCase)).ToList();
            foreach (var req in archivedInquiries)
            {
                DateTime start = req.EventDate.Date.AddHours(12);
                DateTime end = req.EventDate.Date.AddHours(13);
                if (!string.IsNullOrWhiteSpace(req.StartTime) && DateTime.TryParse(req.StartTime, out var ps)) start = req.EventDate.Date.Add(ps.TimeOfDay);
                if (!string.IsNullOrWhiteSpace(req.EndTime) && DateTime.TryParse(req.EndTime, out var pe)) end = req.EventDate.Date.Add(pe.TimeOfDay);

                list.Add(new CalendarEventItem
                {
                    GoogleEventId = $"db-rental-{req.Id}",
                    Title = $"ARCHIVED INQUIRY: {req.ApplicantName}",
                    Start = start,
                    End = end,
                    Location = req.RoomSelected ?? "Function Hall",
                    Source = "Archived Inquiry (FAQ)",
                    Status = "ARCHIVED",
                    ColorCategory = "badge-secondary",
                    Description = $"Inquiry From: {req.ApplicantName}\nPhone: {req.RequesterPhone}\nEmail: {req.RequesterEmail}\nPreferred Date: {req.EventDate:MM/dd/yyyy}\nInquiry / Question & Log:\n{req.InternalNotes}",
                    CreatedDate = req.CreatedDate != default ? req.CreatedDate : (req.RequestedDate != default ? req.RequestedDate : null)
                });
            }
        }
        else
        {
            list = new List<CalendarEventItem>(_events);
        }

        return list.Where(IsEventMatchingFilter)
                   .OrderByDescending(e => GetEffectiveSubmissionDate(e))
                   .ThenByDescending(e => e.Start)
                   .ToList();
    }

    private DateTime GetEffectiveSubmissionDate(CalendarEventItem e)
    {
        if (e.CreatedDate.HasValue && e.CreatedDate.Value != default)
        {
            return e.CreatedDate.Value.Kind == DateTimeKind.Utc ? e.CreatedDate.Value.ToLocalTime() : e.CreatedDate.Value;
        }

        var matched = FindMatchingRentalRequest(e);
        if (matched != null)
        {
            var reqDt = matched.CreatedDate != default ? matched.CreatedDate : (matched.RequestedDate != default ? matched.RequestedDate : (DateTime?)null);
            if (reqDt.HasValue)
            {
                return reqDt.Value.Kind == DateTimeKind.Utc ? reqDt.Value.ToLocalTime() : reqDt.Value;
            }
        }

        var appData = ParseApplicationDetails(e);
        if (!string.IsNullOrWhiteSpace(appData.Timestamp) && DateTime.TryParse(appData.Timestamp, out var parsedTs))
        {
            return parsedTs.Kind == DateTimeKind.Utc ? parsedTs.ToLocalTime() : parsedTs;
        }
        if (!string.IsNullOrWhiteSpace(appData.CreatedTimestamp) && DateTime.TryParse(appData.CreatedTimestamp, out var parsedTs2))
        {
            return parsedTs2.Kind == DateTimeKind.Utc ? parsedTs2.ToLocalTime() : parsedTs2;
        }

        // Fallback: Use event start date if no submission timestamp is present
        return e.Start.Kind == DateTimeKind.Utc ? e.Start.ToLocalTime() : e.Start;
    }

    private ParsedApplicationData ParseApplicationDetails(CalendarEventItem evt)
    {
        var data = new ParsedApplicationData();
        var desc = evt.Description;

        // Default name, event type, and services from title if available (e.g. "Helder Silva | Birthday Party | Bar" or "Helder Smith (Holiday Party)")
        var cleanTitle = GetCleanTitle(evt);
        if (!string.IsNullOrEmpty(cleanTitle))
        {
            if (cleanTitle.Contains(" | "))
            {
                var segments = cleanTitle.Split(new[] { " | " }, StringSplitOptions.RemoveEmptyEntries).Select(s => s.Trim()).ToList();
                if (segments.Count > 0)
                {
                    data.ApplicantName = segments[0];
                }
                if (segments.Count > 1)
                {
                    data.EventType = segments[1];
                }
                if (segments.Count > 2)
                {
                    var rem = string.Join(", ", segments.Skip(2));
                    if (rem.Contains("Bar", StringComparison.OrdinalIgnoreCase)) data.BarService = "Yes";
                    if (rem.Contains("Kitchen", StringComparison.OrdinalIgnoreCase)) data.KitchenAccess = "Yes";
                }
            }
            else
            {
                var parenStart = cleanTitle.IndexOf('(');
                var parenEnd = cleanTitle.LastIndexOf(')');
                var dashIndex = cleanTitle.IndexOf(" - ");
                if (parenStart > 0 && parenEnd > parenStart)
                {
                    data.ApplicantName = cleanTitle.Substring(0, parenStart).Trim();
                    var insideParen = cleanTitle.Substring(parenStart + 1, parenEnd - parenStart - 1).Trim();
                    
                    if (insideParen.Equals("Bar", StringComparison.OrdinalIgnoreCase))
                    {
                        data.BarService = "Yes";
                    }
                    else if (string.IsNullOrEmpty(data.EventType))
                    {
                        data.EventType = insideParen;
                    }
                }
                else if (dashIndex > 0)
                {
                    data.ApplicantName = cleanTitle.Substring(0, dashIndex).Trim();
                    if (string.IsNullOrEmpty(data.EventType))
                    {
                        data.EventType = cleanTitle.Substring(dashIndex + 3).Trim();
                    }
                }
                else
                {
                    data.ApplicantName = cleanTitle;
                }
            }
        }

        if (string.IsNullOrWhiteSpace(desc)) return data;

        // 1. Unify all HTML line breaks into real newlines
        var clean = Regex.Replace(desc, @"<br\s*/?>|</?p>", "\n", RegexOptions.IgnoreCase);
        clean = clean.Replace("&nbsp;", " ")
                     .Replace("&amp;", "&")
                     .Replace("&#39;", "'")
                     .Replace("&quot;", "\"")
                     .Replace("&lt;", "<")
                     .Replace("&gt;", ">");

        var lines = clean.Split(new[] { "\r\n", "\r", "\n" }, StringSplitOptions.RemoveEmptyEntries);
        foreach (var rawLine in lines)
        {
            var line = rawLine.Trim();
            var colonIndex = line.IndexOf(':');
            if (colonIndex <= 0) continue;

            var key = line.Substring(0, colonIndex).Trim();
            var val = line.Substring(colonIndex + 1).Trim();

            if (string.IsNullOrEmpty(val)) continue;

            data.HasStructuredData = true;

            switch (key.ToLowerInvariant())
            {
                case "full name (applicant)":
                case "applicant name":
                case "applicant":
                case "requester name":
                case "name":
                case "applicant / organization":
                case "renter":
                    data.ApplicantName = val;
                    break;
                case "contact phone number":
                case "phone number":
                case "phone":
                case "contact phone":
                case "contact":
                case "cell":
                case "tel":
                    data.Phone = val;
                    break;
                case "email address":
                case "email":
                case "contact email":
                    data.Email = val;
                    break;
                case "street address":
                case "address":
                case "mailing address":
                case "street":
                    data.StreetAddress = val;
                    break;
                case "city":
                    data.City = val;
                    break;
                case "state":
                    data.State = val;
                    break;
                case "zip":
                    data.Zip = val;
                    break;
                case "are you a club member?":
                case "club member":
                    data.IsClubMember = val;
                    break;
                case "type of event":
                case "event type":
                    data.EventType = val;
                    break;
                case "event description":
                case "description":
                case "event details":
                case "notes":
                case "event notes":
                    data.EventDescription = val;
                    break;
                case "preferred event date":
                case "event date":
                    data.PreferredEventDate = val;
                    break;
                case "alternate date (if first choice is unavailable)":
                case "alternate date":
                    data.AlternateDate = val;
                    break;
                case "event start time":
                case "start time":
                    data.StartTime = val;
                    break;
                case "event end time":
                case "end time":
                    data.EndTime = val;
                    break;
                case "estimated number of guests":
                case "guest count":
                case "number of guests":
                    data.GuestCount = val;
                    break;
                case "do you require setup time prior to the start time above?":
                case "setup time":
                    data.SetupTimeRequired = val;
                    break;
                case "kitchen access requested?":
                case "kitchen access":
                    data.KitchenAccess = val;
                    break;
                case "bar service (alcohol & bartender - additional cost)?":
                case "bar service":
                    data.BarService = val;
                    break;
                case "applicant signature":
                case "signature":
                    data.ApplicantSignature = val;
                    break;
                case "created by":
                case "scheduled by":
                case "organized by":
                case "author":
                    data.CreatedBy = val;
                    break;
                case "created":
                case "created date":
                case "created on":
                    data.CreatedTimestamp = val;
                    break;
                case "timestamp":
                case "submission timestamp":
                case "submitted at":
                    data.Timestamp = val;
                    if (DateTimeOffset.TryParse(val, out var parsedDto))
                    {
                        data.FormattedTimestamp = parsedDto.ToLocalTime().ToString("MMMM dd, yyyy 'at' h:mm tt");
                    }
                    else if (DateTime.TryParse(val, out var parsedTs))
                    {
                        var localTs = parsedTs.Kind == DateTimeKind.Utc ? parsedTs.ToLocalTime() : (parsedTs.Kind == DateTimeKind.Unspecified ? DateTime.SpecifyKind(parsedTs, DateTimeKind.Utc).ToLocalTime() : parsedTs);
                        data.FormattedTimestamp = localTs.ToString("MMMM dd, yyyy 'at' h:mm tt");
                    }
                    else
                    {
                        data.FormattedTimestamp = val;
                    }
                    break;
                case "requested services":
                case "services":
                case "requested add-ons":
                case "add-ons":
                    data.ExtraFields["Services"] = val;
                    if (val.Contains("bar", StringComparison.OrdinalIgnoreCase) || val.Contains("bartender", StringComparison.OrdinalIgnoreCase))
                    {
                        data.BarService = "Yes";
                    }
                    if (val.Contains("kitchen", StringComparison.OrdinalIgnoreCase))
                    {
                        data.KitchenAccess = "Yes";
                    }
                    break;
                case "preferred contact method":
                case "contact preference":
                case "preferred contact":
                case "contact by":
                    data.PreferredContactMethod = val;
                    if (val.Contains("phone", StringComparison.OrdinalIgnoreCase) || val.Contains("call", StringComparison.OrdinalIgnoreCase))
                    {
                        data.RequestPhoneCall = true;
                    }
                    break;
                case "phone callback requested":
                case "request phone call":
                case "request phone callback":
                case "call requested":
                    data.RequestPhoneCall = val.Equals("true", StringComparison.OrdinalIgnoreCase) || val.Equals("yes", StringComparison.OrdinalIgnoreCase);
                    break;
                default:
                    if (!key.Equals("Hall Rental Application Details", StringComparison.OrdinalIgnoreCase))
                    {
                        data.ExtraFields[key] = val;
                    }
                    break;
            }
        }

        return data;
    }

    // =========================================================================
    // MEMBER DIRECTORY VERIFICATION & DUES STATUS EVALUATION ENGINE
    // =========================================================================
    public class MemberVerificationResult
    {
        public bool IsChecked { get; set; }
        public bool IsExactMatch { get; set; }
        public Member? ExactMember { get; set; }
        public OverdueResult? DuesStatus { get; set; }
        public List<MemberFuzzyCandidate> SimilarCandidates { get; set; } = new();
    }

    public class MemberFuzzyCandidate
    {
        public Member Member { get; set; } = new();
        public OverdueResult? DuesStatus { get; set; }
        public int MatchScore { get; set; } // 0-100
        public string MatchReason { get; set; } = string.Empty;
    }

    private List<Member>? _cachedAllMembers;

    private async Task<List<Member>> GetAllMembersCachedAsync()
    {
        if (_cachedAllMembers == null || !_cachedAllMembers.Any())
        {
            try
            {
                _cachedAllMembers = await Task.Run(() => MemberRepository.GetAllMembers());
            }
            catch (Exception ex)
            {
                System.Diagnostics.Debug.WriteLine($"Error fetching members: {ex.Message}");
                _cachedAllMembers = new List<Member>();
            }
        }
        return _cachedAllMembers;
    }

    private MemberVerificationResult VerifyApplicantMembership(string? applicantName, string? email, string? phone)
    {
        var result = new MemberVerificationResult { IsChecked = true };
        if (_cachedAllMembers == null || !_cachedAllMembers.Any())
        {
            try
            {
                _cachedAllMembers = MemberRepository.GetAllMembers();
            }
            catch
            {
                _cachedAllMembers = new List<Member>();
            }
        }

        if (_cachedAllMembers == null || !_cachedAllMembers.Any())
        {
            return result;
        }

        string cleanName = (applicantName ?? string.Empty).Trim().ToLowerInvariant();
        // Strip prefixes/suffixes like (Birthday Party) or Hall Rental:
        int parenIdx = cleanName.IndexOf('(');
        if (parenIdx > 0) cleanName = cleanName.Substring(0, parenIdx).Trim();
        if (cleanName.StartsWith("hall rental:", StringComparison.OrdinalIgnoreCase)) cleanName = cleanName.Substring(12).Trim();
        if (cleanName.StartsWith("rental:", StringComparison.OrdinalIgnoreCase)) cleanName = cleanName.Substring(7).Trim();

        string normEmail = (email ?? string.Empty).Trim().ToLowerInvariant();
        string cleanPhone = Regex.Replace(phone ?? string.Empty, @"[^\d]", "");

        string normApplicantName = NormalizePersonName(cleanName);

        var nameParts = cleanName.Split(new[] { ' ', ',', '-' }, StringSplitOptions.RemoveEmptyEntries);
        string firstPart = nameParts.Length > 0 ? nameParts[0] : "";
        string lastPart = nameParts.Length > 1 ? nameParts[nameParts.Length - 1] : "";

        // 1. Check for Exact Name Match (handles suffixes Jr/Sr/III/middle initials automatically)
        Member? exact = null;

        // Exact First + Last Name Match
        if (!string.IsNullOrEmpty(firstPart) && !string.IsNullOrEmpty(lastPart))
        {
            exact = _cachedAllMembers.FirstOrDefault(m =>
                string.Equals((m.FirstName ?? "").Trim(), firstPart, StringComparison.OrdinalIgnoreCase) &&
                string.Equals((m.LastName ?? "").Trim(), lastPart, StringComparison.OrdinalIgnoreCase));
        }

        // Exact Full Combined Name Match (raw or normalized without Jr/Sr/III/middle initials)
        if (exact == null && !string.IsNullOrEmpty(cleanName))
        {
            exact = _cachedAllMembers.FirstOrDefault(m =>
            {
                var mFull = $"{m.FirstName} {m.LastName}".Trim().ToLowerInvariant();
                var mRev = $"{m.LastName} {m.FirstName}".Trim().ToLowerInvariant();
                if (mFull == cleanName || mRev == cleanName) return true;

                var mNorm = NormalizePersonName(mFull);
                return !string.IsNullOrEmpty(mNorm) && mNorm == normApplicantName;
            });
        }

        if (exact != null)
        {
            result.IsExactMatch = true;
            result.ExactMember = exact;
            try
            {
                result.DuesStatus = OverdueService.CalculateOverdue(exact);
            }
            catch { }
            return result;
        }

        // 2. Fuzzy Matching & Similar Candidate Detection
        var candidateList = new List<MemberFuzzyCandidate>();

        foreach (var m in _cachedAllMembers)
        {
            int score = 0;
            var reasons = new List<string>();

            string mFirst = (m.FirstName ?? "").Trim().ToLowerInvariant();
            string mLast = (m.LastName ?? "").Trim().ToLowerInvariant();
            string mFullName = $"{mFirst} {mLast}".Trim();
            string mEmail = (m.Email ?? "").Trim().ToLowerInvariant();
            string mPhone = Regex.Replace(m.Phone ?? "", @"[^\d]", "");
            string mCell = Regex.Replace(m.CellPhone ?? "", @"[^\d]", "");

            // A. Exact Last Name match
            if (!string.IsNullOrEmpty(lastPart) && !string.IsNullOrEmpty(mLast) && mLast == lastPart)
            {
                score += 50;
                reasons.Add("Same Last Name");

                // Check First Name similarity or nickname alias (e.g., Joe / Joseph, Bill / William)
                if (!string.IsNullOrEmpty(firstPart) && !string.IsNullOrEmpty(mFirst))
                {
                    if (AreNicknamesMatching(firstPart, mFirst))
                    {
                        score += 45;
                        reasons.Add($"Nickname Match ({firstPart} / {mFirst})");
                    }
                    else if (mFirst.StartsWith(firstPart) || firstPart.StartsWith(mFirst))
                    {
                        score += 35;
                        reasons.Add("Similar First Name");
                    }
                    else
                    {
                        int lev = CalculateLevenshteinDistance(firstPart, mFirst);
                        if (lev <= 2)
                        {
                            score += Math.Max(10, 30 - (lev * 10));
                            reasons.Add("Close First Name Spelling");
                        }
                    }
                }
            }
            // B. Exact First Name match with different last name
            else if (!string.IsNullOrEmpty(firstPart) && !string.IsNullOrEmpty(mFirst) && mFirst == firstPart)
            {
                score += 40;
                reasons.Add("Same First Name");

                // Check Last Name similarity
                if (!string.IsNullOrEmpty(lastPart) && !string.IsNullOrEmpty(mLast))
                {
                    int lev = CalculateLevenshteinDistance(lastPart, mLast);
                    if (lev <= 2)
                    {
                        score += Math.Max(10, 30 - (lev * 10));
                        reasons.Add("Close Last Name Spelling");
                    }
                }
            }
            else if (!string.IsNullOrEmpty(cleanName) && !string.IsNullOrEmpty(mFullName))
            {
                // Full name Levenshtein
                int lev = CalculateLevenshteinDistance(cleanName, mFullName);
                if (lev <= 3)
                {
                    score += Math.Max(20, 80 - (lev * 15));
                    reasons.Add($"Spelling Similarity ({lev} edit{(lev > 1 ? "s" : "")})");
                }
                else if (mFullName.Contains(cleanName) || cleanName.Contains(mFullName))
                {
                    score += 45;
                    reasons.Add("Partial Name Match");
                }
            }

            // B. Email Match
            if (!string.IsNullOrEmpty(normEmail) && !string.IsNullOrEmpty(mEmail) && mEmail == normEmail)
            {
                score += 80;
                reasons.Add("Matching Email");
            }

            // C. Phone Match
            if (cleanPhone.Length >= 7)
            {
                if ((mPhone.Length >= 7 && (mPhone == cleanPhone || mPhone.EndsWith(cleanPhone) || cleanPhone.EndsWith(mPhone))) ||
                    (mCell.Length >= 7 && (mCell == cleanPhone || mCell.EndsWith(cleanPhone) || cleanPhone.EndsWith(mCell))))
                {
                    score += 70;
                    reasons.Add("Matching Phone");
                }
            }

            if (score >= 40)
            {
                OverdueResult? dues = null;
                try
                {
                    dues = OverdueService.CalculateOverdue(m);
                }
                catch { }

                candidateList.Add(new MemberFuzzyCandidate
                {
                    Member = m,
                    DuesStatus = dues,
                    MatchScore = score,
                    MatchReason = string.Join(", ", reasons)
                });
            }
        }

        result.SimilarCandidates = candidateList
            .OrderByDescending(c => c.MatchScore)
            .Take(4)
            .ToList();

        return result;
    }

    private string? _preLinkOriginalName;
    private string? _preLinkOriginalEmail;
    private string? _preLinkOriginalPhone;

    private static bool IsCardAvailableForDate(PricingTierCardConfig card, DateTime date)
    {
        return date.DayOfWeek switch
        {
            DayOfWeek.Monday => card.MondayAvailable,
            DayOfWeek.Tuesday => card.TuesdayAvailable,
            DayOfWeek.Wednesday => card.WednesdayAvailable,
            DayOfWeek.Thursday => card.ThursdayAvailable,
            DayOfWeek.Friday => card.FridayAvailable,
            DayOfWeek.Saturday => card.SaturdayAvailable,
            DayOfWeek.Sunday => card.SundayAvailable,
            _ => false
        };
    }

    private static decimal GetCardRateForDate(PricingTierCardConfig card, DateTime date)
    {
        return date.DayOfWeek switch
        {
            DayOfWeek.Monday => card.MondayRate,
            DayOfWeek.Tuesday => card.TuesdayRate,
            DayOfWeek.Wednesday => card.WednesdayRate,
            DayOfWeek.Thursday => card.ThursdayRate,
            DayOfWeek.Friday => card.FridayRate,
            DayOfWeek.Saturday => card.SaturdayRate,
            DayOfWeek.Sunday => card.SundayRate,
            _ => card.SaturdayRate
        };
    }

    private decimal AutoCalculatePriceForRequest(HallRentalRequest req)
    {
        if (req == null) return 0;
        var settings = _webSettings;
        if (settings == null) return req.MemberStatus ? 300 : 400;

        decimal basePrice = 0;
        var tierCards = settings.GetTierCardsList() ?? WebsiteSettings.GetDefaultTierCards();

        // 1. Match Tier Card by RenterType or MemberStatus
        PricingTierCardConfig? matchedCard = null;
        if (!string.IsNullOrWhiteSpace(req.RenterType))
        {
            matchedCard = tierCards.FirstOrDefault(c => 
                string.Equals(c.Id, req.RenterType, StringComparison.OrdinalIgnoreCase) ||
                string.Equals(c.Title, req.RenterType, StringComparison.OrdinalIgnoreCase) ||
                string.Equals(c.AssociatedRenterType, req.RenterType, StringComparison.OrdinalIgnoreCase));
        }

        if (matchedCard == null)
        {
            matchedCard = tierCards.FirstOrDefault(c => req.MemberStatus 
                ? string.Equals(c.AssociatedRenterType, "Member", StringComparison.OrdinalIgnoreCase)
                : string.Equals(c.AssociatedRenterType, "Non-Member", StringComparison.OrdinalIgnoreCase))
                ?? tierCards.FirstOrDefault();
        }

        if (matchedCard != null)
        {
            basePrice = GetCardRateForDate(matchedCard, req.EventDate);
        }
        else
        {
            var room = settings.GetRoomsList().FirstOrDefault(r => r.Name.Equals(req.RoomSelected ?? "Function Hall", StringComparison.OrdinalIgnoreCase));
            basePrice = room != null 
                ? (req.MemberStatus ? room.MemberRate : room.NonMemberRate)
                : (req.MemberStatus ? (settings.FunctionHallMemberRate ?? 300) : (settings.FunctionHallNonMemberRate ?? 400));
        }

        // 2. Add-on services
        decimal addOns = 0;
        var activeAddons = settings.GetAddonsList().Where(a => a.IsActive).ToList();
        foreach (var addon in activeAddons)
        {
            if (IsAddonSelected(req, addon))
            {
                addOns += addon.Fee;
            }
        }

        // 3. Extra duration calculation if times are specified
        decimal extraFee = 0;
        if (!string.IsNullOrEmpty(req.StartTime) && !string.IsNullOrEmpty(req.EndTime))
        {
            int startMin = ParseTimeToMinutes(req.StartTime);
            int endMin = ParseTimeToMinutes(req.EndTime);
            if (startMin >= 0 && endMin > startMin)
            {
                double duration = (endMin - startMin) / 60.0;
                int baseHours = settings.BaseFunctionHours ?? 5;
                bool allowExtra = settings.AllowAdditionalHours;
                if (allowExtra && duration > baseHours)
                {
                    double extraHours = duration - baseHours;
                    decimal hourlyRate = settings.AdditionalHourRate ?? 50m;
                    extraFee = (decimal)extraHours * hourlyRate;
                }
            }
        }

        return basePrice + addOns + extraFee;
    }

