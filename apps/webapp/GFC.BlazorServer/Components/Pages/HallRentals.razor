                            <div class="col-12 d-flex justify-content-between">
                                <span class="text-muted fw-bold">Remaining Balance Due:</span>
                                <span class="fw-bold text-danger fs-6">$@remRemaining.ToString("N2")</span>
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold text-dark mb-1">
                            Optional Reminder Note / Instructions <span class="text-muted font-normal">(Recorded to Audit Trail &amp; Email)</span>:
                        </label>
                        <div class="mb-2">
                            <select class="form-select form-select-sm" @onchange="OnPaymentReminderPresetSelected">
                                <option value="">-- Choose a preset reason or enter custom below (Optional) --</option>
                                @foreach (var reason in (_webSettings?.GetModificationReasonPresetsList() ?? WebsiteSettings.GetDefaultModificationReasonPresets()))
                                {
                                    <option value="@reason">@reason</option>
                                }
                            </select>
                        </div>
                        <input type="text" class="form-control form-control-sm" placeholder="e.g. Deposit due within 14 days to confirm reservation" @bind="_paymentReminderCustomNote" />
                    </div>

                    <div class="alert alert-info py-2 px-3 small d-flex align-items-center gap-2 mb-0">
                        <i class="bi bi-info-circle-fill text-info flex-shrink-0"></i>
                        <span>This will send the customized payment reminder email from <strong>@(_webSettings?.RentalSenderEmail ?? "rentals@gloucesterfraternityclub.com")</strong> to <strong>@remEmail</strong>.</span>
                    </div>
                </div>
                <div class="modal-footer bg-light border-top p-3 px-4 d-flex justify-content-between">
                    <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill px-3" @onclick="() => _showPaymentReminderModal = false" disabled="@_isSendingPaymentReminder">
                        Cancel
                    </button>
                    <button type="button" class="btn btn-warning text-dark btn-sm rounded-pill px-4 shadow-sm fw-bold" @onclick="ConfirmAndSendPaymentReminderAsync" disabled="@_isSendingPaymentReminder">
                        @if (_isSendingPaymentReminder)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                            <span>Sending Reminder...</span>
                        }
                        else
                        {
                            <i class="bi bi-send-fill me-1"></i>
                            <span>Send Payment Reminder</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- ========================================================================= -->
<!-- PRE-SAVE CHANGE CONFIRMATION & AUDIT DIFF MODAL -->
<!-- ========================================================================= -->
@if (_showConfirmChangesModal && _selectedRequest != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.75); z-index: 1060;" role="dialog">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="modal-header bg-primary text-white p-3 px-4">
                    <h5 class="modal-title fw-bold mb-0 d-flex align-items-center gap-2">
                        <i class="bi bi-shield-check"></i>
                        <span>Confirm Booking Modifications</span>
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => _showConfirmChangesModal = false"></button>
                </div>
                <div class="modal-body p-4">
                    <p class="text-muted small mb-3">
                        Please review the detected changes below before updating the database, Google Calendar schedule, and availability ledger:
                    </p>

                    <div class="card border rounded-3 mb-3 bg-light shadow-none">
                        <div class="card-header bg-white py-2 px-3 fw-bold small text-uppercase text-secondary">
                            Detected Field Differences (@_detectedDiffs.Count)
                        </div>
                        <div class="card-body p-0">
                            <div class="table-responsive mb-0">
                                <table class="table table-sm table-striped align-middle mb-0">
                                    <thead class="table-light small">
                                        <tr>
                                            <th>Field</th>
                                            <th>Previous Value</th>
                                            <th>New Value</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var diff in _detectedDiffs)
                                        {
                                            <tr>
                                                <td class="fw-bold small text-dark">@diff.FieldName</td>
                                                <td><span class="badge bg-secondary-subtle text-secondary border">@diff.OldValue</span></td>
                                                <td><span class="badge bg-primary-subtle text-primary border border-primary-subtle fw-bold">@diff.NewValue</span></td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold text-dark mb-1">
                            Reason for modification / Admin note <span class="text-muted font-normal">(Recorded to Audit Trail)</span>:
                        </label>
                        <div class="mb-2">
                            <select class="form-select form-select-sm" @onchange="OnModificationReasonPresetSelected">
                                <option value="">-- Choose a preset reason or enter custom below --</option>
                                @foreach (var reason in (_webSettings?.GetModificationReasonPresetsList() ?? WebsiteSettings.GetDefaultModificationReasonPresets()))
                                {
                                    <option value="@reason">@reason</option>
                                }
                            </select>
                        </div>
                        <input type="text" class="form-control form-control-sm" placeholder="e.g. Applied member discount, changed time upon renter request" @bind="_changeReasonNote" />
                    </div>

                    @if (!string.IsNullOrWhiteSpace(_selectedRequest.RequesterEmail))
                    {
                        <div class="p-3 bg-white rounded-3 border mb-3">
                            <div class="form-check form-switch mb-0">
                                <input class="form-check-input" type="checkbox" id="sendQuoteToggle" @bind="_sendUpdatedQuoteEmail" />
                                <label class="form-check-label fw-bold text-dark small" for="sendQuoteToggle">
                                    <i class="bi bi-envelope-paper me-1 text-primary"></i>Email Updated Quote to Applicant
                                </label>
                                <small class="text-muted d-block">Sends updated breakdown and pricing to <strong>@_selectedRequest.RequesterEmail</strong></small>
                            </div>
                        </div>
                    }

                    <div class="alert alert-info py-2 px-3 small d-flex align-items-center gap-2 mb-0">
                        <i class="bi bi-info-circle-fill text-info"></i>
                        <span>This action will update the database record and synchronize connected calendars immediately.</span>
                    </div>
                </div>
                <div class="modal-footer bg-light border-top p-3 px-4 d-flex justify-content-between">
                    <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill px-3" @onclick="() => _showConfirmChangesModal = false">
                        <i class="bi bi-arrow-left me-1"></i>Back to Editor
                    </button>
                    <button type="button" class="btn btn-primary btn-sm rounded-pill px-4 shadow-sm fw-bold" @onclick="CommitBookingModificationsAsync" disabled="@_isSavingAdjustments">
                        @if (_isSavingAdjustments)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                            <span>Applying Changes...</span>
                        }
                        else
                        {
                            <i class="bi bi-check2-circle me-1"></i>
                            <span>Confirm &amp; Apply Changes</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- UNSAVED CHANGES WARNING CONFIRMATION MODAL -->
@if (_showUnsavedChangesWarning)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.75); z-index: 1070;" role="dialog">
        <div class="modal-dialog modal-dialog-centered modal-sm" role="document">
            <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="modal-header bg-warning bg-opacity-25 text-warning-emphasis p-3">
                    <h6 class="modal-title fw-bold mb-0 d-flex align-items-center gap-2">
                        <i class="bi bi-exclamation-triangle-fill text-warning"></i>
                        <span>Unsaved Changes</span>
                    </h6>
                </div>
                <div class="modal-body p-3">
                    <p class="small text-muted mb-0">
                        You have modified fields that have not been saved. Are you sure you want to discard your changes and close?
                    </p>
                </div>
                <div class="modal-footer bg-light p-2 px-3 d-flex justify-content-between">
                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => _showUnsavedChangesWarning = false">
                        Keep Editing
                    </button>
                    <button type="button" class="btn btn-sm btn-danger fw-bold" @onclick="ForceCloseEventDetails">
                        Discard &amp; Close
                    </button>
