    private async Task CheckPermissions()
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            _isAdmin = user.IsInRole("Admin") || user.Identity?.Name?.ToLower() == "admin";

            if (_isAdmin)
            {
                _hasPageAccess = true;
                return;
            }

            var userIdClaim = user.FindFirst("UserId") ?? user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier);
            if (userIdClaim != null && int.TryParse(userIdClaim.Value, out var userId))
            {
                var permissions = UserService.GetUserPagePermissions(userId);
                var allPages = UserService.GetAllPages();
                var hallRentalsPage = allPages.FirstOrDefault(p => p.PageRoute.TrimStart('/').ToLower() == "hall-rentals");
                if (hallRentalsPage != null)
                {
                    _hasPageAccess = permissions.Any(p => p.PageId == hallRentalsPage.PageId);
                }
            }
        }
        catch
        {
            _hasPageAccess = false;
        }
    }

    private async Task LoadSettingsAndEvents()
    {
        try
        {
            _settings = await CalendarService.GetSettingsAsync();

            // Ensure at least 1 feed entry exists if Feeds list is empty
            if (_settings.Feeds.Count == 0 && !string.IsNullOrWhiteSpace(_settings.PublicCalendarUrl))
            {
                _settings.Feeds.Add(new CalendarFeedConfig
                {
                    Name = string.IsNullOrWhiteSpace(_settings.CalendarName) ? "Primary Calendar" : _settings.CalendarName,
                    Url = _settings.PublicCalendarUrl,
                    Color = "#0d6efd",
                    IsEnabled = true
                });
            }

            if (_settings.Feeds.Any(f => f.IsEnabled && !string.IsNullOrWhiteSpace(f.Url)))
            {
                _events = await CalendarService.FetchAllFeedsAsync(_settings);
            }
            else
            {
                _events = GenerateSampleEvents();
            }
        }
        catch (Exception ex)
        {
            _events = GenerateSampleEvents();
            _syncMessage = $"Notice: Displaying offline event cache. {ex.Message}";
            _syncSuccess = false;
        }
    }

    private async Task SyncCalendarNow()
    {
        _isSyncing = true;
        _syncMessage = null;
        try
        {
            if (!_settings.Feeds.Any(f => f.IsEnabled && !string.IsNullOrWhiteSpace(f.Url)))
            {
                _syncMessage = "Please configure at least one active Calendar URL in settings.";
                _syncSuccess = false;
                _showSettingsModal = true;
                return;
            }

            _events = await CalendarService.FetchAllFeedsAsync(_settings);
            _settings.LastSyncedAt = DateTime.Now;
            _settings.LastSyncSuccess = true;
            _settings.LastSyncStatus = $"Synced {_events.Count} events across {_settings.Feeds.Count(f => f.IsEnabled)} calendar(s).";
            _settings.TotalEventsCount = _events.Count;
            await CalendarService.SaveSettingsAsync(_settings);

            _syncMessage = $"Successfully synced {_events.Count} events across {_settings.Feeds.Count(f => f.IsEnabled)} calendar(s)!";
            _syncSuccess = true;
        }
        catch (Exception ex)
        {
            _syncMessage = $"Sync failed: {ex.Message}";
            _syncSuccess = false;
        }
        finally
        {
            _isSyncing = false;
        }
    }

