    private void RecalculateManualTestQuote()
    {
        decimal basePrice = 0;
        bool isMember = _manualTestModel.MemberStatus;

        var rooms = _editableRooms.Any() ? _editableRooms : (_webSettings?.GetRoomsList() ?? new List<RentalRoomOption>());
        var selectedRoom = rooms.FirstOrDefault(r => r.Name.Equals(_manualTestModel.RoomSelected, StringComparison.OrdinalIgnoreCase)) ?? rooms.FirstOrDefault();

        if (selectedRoom != null)
        {
            basePrice = isMember ? selectedRoom.MemberRate : selectedRoom.NonMemberRate;
        }
        else
        {
            basePrice = isMember ? (_webSettings?.FunctionHallMemberRate ?? 300) : (_webSettings?.FunctionHallNonMemberRate ?? 400);
        }

        decimal addOns = 0;
        if (_manualTestModel.BartenderRequested) addOns += (_webSettings?.BartenderServiceFee ?? 100);
        if (_manualTestModel.KitchenUsage) addOns += (_webSettings?.KitchenFee ?? 50);
        if (_manualTestModel.AvEquipmentUsage) addOns += (_webSettings?.AvEquipmentFee ?? 25);

        _manualTestModel.TotalPrice = basePrice + addOns;

        if (_webSettings?.RequireSecurityDeposit == false)
        {
            _manualTestModel.SecurityDepositAmount = 0;
        }
        else
        {
            _manualTestModel.SecurityDepositAmount = _webSettings?.SecurityDepositAmount ?? 200;
        }
    }

    private (string Title, string Description) FormatGoogleEventDetails(HallRentalRequest request, bool isTest)
    {
        // 1. Determine Title based on privacy setting
        string prefix = isTest ? "[TEST] PENDING: " : "PENDING: ";
        string eventType = string.IsNullOrWhiteSpace(request.EventType) ? "Rental" : request.EventType;
        string title;

        if (_settings.PushApplicantNameToTitle && !string.IsNullOrWhiteSpace(request.ApplicantName))
        {
            title = $"{prefix}{request.ApplicantName} ({eventType})";
        }
        else
        {
            title = $"{prefix}{eventType}";
        }

        // 2. Build Description based on field inclusion toggles
        var lines = new List<string>();

        if (_settings.PushApplicantNameToDescription && !string.IsNullOrWhiteSpace(request.ApplicantName))
        {
            lines.Add($"Applicant / Organization: {request.ApplicantName}");
        }

        if (_settings.PushApplicantPhoneToDescription && !string.IsNullOrWhiteSpace(request.RequesterPhone))
        {
            lines.Add($"Contact Phone: {request.RequesterPhone}");
        }

        if (_settings.PushApplicantEmailToDescription && !string.IsNullOrWhiteSpace(request.RequesterEmail))
        {
            lines.Add($"Email: {request.RequesterEmail}");
        }

        if (_settings.PushAddressToDescription && !string.IsNullOrWhiteSpace(request.RequesterAddress))
        {
            lines.Add($"Address: {request.RequesterAddress}");
        }

        if (!string.IsNullOrWhiteSpace(request.EventType))
        {
            lines.Add($"Event Type: {request.EventType}");
        }

        if (!string.IsNullOrWhiteSpace(request.RoomSelected))
        {
            lines.Add($"Room / Facility: {request.RoomSelected}");
        }

        if (_settings.PushGuestCountToDescription && request.GuestCount > 0)
        {
            lines.Add($"Estimated Attendance: {request.GuestCount} guests");
        }

        if (_settings.PushServicesToDescription)
        {
            var services = new List<string>();
            if (request.BartenderRequested) services.Add("Bar / Bartender Service");
            if (request.KitchenUsage) services.Add("Kitchen Access");
            if (request.AvEquipmentUsage) services.Add("A/V Equipment");

            if (services.Any())
            {
                lines.Add($"Requested Services: {string.Join(", ", services)}");
            }
        }

        if (_settings.PushPricingQuoteToDescription && request.TotalPrice > 0)
        {
            lines.Add($"Quoted Price: ${request.TotalPrice:N2}");
        }

        if (_settings.PushNotesToDescription && !string.IsNullOrWhiteSpace(request.InternalNotes))
        {
            lines.Add($"Applicant Notes: {request.InternalNotes}");
        }

        if (!lines.Any())
        {
            lines.Add($"GFC Hall Rental: {eventType}");
        }

        return (title, string.Join("\n", lines));
    }

    private async Task<bool> PushToTestGoogleCalendarAsync(HallRentalRequest request)
    {
        var targetCalId = _webSettings?.SandboxGoogleCalendarId?.Trim();
        if (string.IsNullOrWhiteSpace(targetCalId) && !string.IsNullOrWhiteSpace(_webSettings?.SandboxCalendarFeedUrl))
        {
            var m = System.Text.RegularExpressions.Regex.Match(_webSettings.SandboxCalendarFeedUrl, @"ical/([^/]+)/", System.Text.RegularExpressions.RegexOptions.IgnoreCase);
            if (m.Success)
            {
                targetCalId = System.Uri.UnescapeDataString(m.Groups[1].Value);
            }
        }
        if (string.IsNullOrWhiteSpace(targetCalId))
        {
            targetCalId = _settings.PrimaryGoogleCalendarId?.Trim();
        }
        if (string.IsNullOrWhiteSpace(targetCalId) && !string.IsNullOrWhiteSpace(_settings.PublicCalendarUrl))
        {
            var m = System.Text.RegularExpressions.Regex.Match(_settings.PublicCalendarUrl, @"ical/([^/]+)/", System.Text.RegularExpressions.RegexOptions.IgnoreCase);
            if (m.Success)
            {
                targetCalId = System.Uri.UnescapeDataString(m.Groups[1].Value);
            }
        }

        if (string.IsNullOrWhiteSpace(targetCalId))
        {
            _modalSimulationLogs.Add($"[{DateTime.Now:HH:mm:ss}] ℹ️ No Test Google Calendar ID configured. Local database record created only.");
            ToastService.ShowInfo("Database record created (no Google Calendar ID configured).");
            return false;
        }

        if (string.IsNullOrWhiteSpace(_settings.ServiceAccountEmail) || string.IsNullOrWhiteSpace(_settings.ServiceAccountPrivateKey))
        {
            _modalSimulationLogs.Add($"[{DateTime.Now:HH:mm:ss}] ⚠️ Google Service Account Key is missing. Upload your .json key in the Sandbox & Testing Hub tab to enable live Google Calendar event pushes.");
            ToastService.ShowWarning("Google Calendar push skipped: Service Account .json key is missing. Please upload your key in the Sandbox tab.");
            return false;
        }

        _modalSimulationLogs.Add($"[{DateTime.Now:HH:mm:ss}] 🔄 Connecting to Google Calendar API for calendar '{targetCalId}'...");

        var testCalSettings = new GoogleCalendarSettings
        {
            PrimaryGoogleCalendarId = targetCalId,
            ServiceAccountEmail = _settings.ServiceAccountEmail,
            ServiceAccountPrivateKey = _settings.ServiceAccountPrivateKey,
            ServiceAccountProjectNumber = _settings.ServiceAccountProjectNumber,
            EnableWriteApi = true,
            GoogleEventVisibility = _settings.GoogleEventVisibility,
            PushApplicantNameToTitle = _settings.PushApplicantNameToTitle,
            PushApplicantNameToDescription = _settings.PushApplicantNameToDescription,
            PushApplicantPhoneToDescription = _settings.PushApplicantPhoneToDescription,
            PushApplicantEmailToDescription = _settings.PushApplicantEmailToDescription,
            PushPricingQuoteToDescription = _settings.PushPricingQuoteToDescription,
            PushGuestCountToDescription = _settings.PushGuestCountToDescription,
            PushServicesToDescription = _settings.PushServicesToDescription,
            PushAddressToDescription = _settings.PushAddressToDescription,
            PushNotesToDescription = _settings.PushNotesToDescription
        };

        DateTime start = request.EventDate.Date.AddHours(14);
        DateTime end = request.EventDate.Date.AddHours(20);
        if (DateTime.TryParse(request.StartTime, out var ps)) start = request.EventDate.Date.Add(ps.TimeOfDay);
        if (DateTime.TryParse(request.EndTime, out var pe)) end = request.EventDate.Date.Add(pe.TimeOfDay);

        var (eventTitle, eventDescription) = FormatGoogleEventDetails(request, isTest: true);

        var googleEvt = new CalendarEventItem
        {
            Title = eventTitle,
            Start = start,
            End = end,
            Location = request.RoomSelected ?? "Function Hall",
            Description = eventDescription
        };

        var gResult = await CalendarService.CreateGoogleEventAsync(googleEvt, testCalSettings);
        if (gResult.Success)
        {
            _modalSimulationLogs.Add($"[{DateTime.Now:HH:mm:ss}] ✅ SUCCESS: Event created on Google Calendar '{targetCalId}'.");
            ToastService.ShowSuccess($"Event added to Google Calendar ({targetCalId})!");
            return true;
        }
        else
        {
            _modalSimulationLogs.Add($"[{DateTime.Now:HH:mm:ss}] ❌ Google Calendar API error: {gResult.Message}");
            ToastService.ShowError($"Google Calendar push error: {gResult.Message}");
            return false;
        }
    }

