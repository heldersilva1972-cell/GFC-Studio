    private async Task MarkBookingCancelledAsync()
    {
        if (_eventToCancelOrRemove == null) return;
        _isProcessingCancelOrRemove = true;

        try
        {
            var targetEvent = _eventToCancelOrRemove;
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            string adminUser = authState.User.Identity?.Name ?? "Admin";

            // 1. If matching DB request exists, update status to Cancelled and write audit trail
            HallRentalRequest? reqToUpdate = _selectedRequest;
            if (reqToUpdate == null)
            {
                var appData = ParseApplicationDetails(targetEvent);
                reqToUpdate = _cachedRentalRequests.FirstOrDefault(r =>
                    r.EventDate.Date == targetEvent.Start.Date &&
                    (string.Equals(r.ApplicantName, appData.ApplicantName, StringComparison.OrdinalIgnoreCase) ||
                     string.Equals(r.ApplicantName, GetCleanTitle(targetEvent), StringComparison.OrdinalIgnoreCase)));
            }

            if (reqToUpdate != null)
            {
                reqToUpdate.Status = "Cancelled";
                reqToUpdate.StatusChangedBy = adminUser;
                reqToUpdate.StatusChangedDate = DateTime.UtcNow;

                var sbAudit = new System.Text.StringBuilder();
                sbAudit.AppendLine($"[{DateTime.Now:yyyy-MM-dd h:mm tt} by {adminUser}]");
                sbAudit.AppendLine($"❌ Booking Cancelled (Status changed to Cancelled & released from calendar)");
                sbAudit.AppendLine();
                reqToUpdate.InternalNotes = (sbAudit.ToString() + (reqToUpdate.InternalNotes ?? "")).Trim();

                await RentalService.UpdateRentalRequestAsync(reqToUpdate);
            }

            // 2. If present in Google Calendar and write access is enabled, remove from active Google Calendar schedule
            var googleId = targetEvent.GoogleEventId ?? targetEvent.Uid;
            if (!string.IsNullOrEmpty(googleId) && _settings.EnableWriteApi)
            {
                try
                {
                    await CalendarService.DeleteGoogleEventAsync(googleId, _settings);
                }
                catch { }
            }

            // 3. Update Availability Calendar if applicable
            try
            {
                await RentalService.UpdateCalendarAvailabilityAsync(targetEvent.Start.Date, "Available");
            }
            catch { }

            ToastService.ShowSuccess("Booking status changed to Cancelled and logged to Audit Trail.");
            _showCancelEventConfirm = false;
            _selectedEvent = null;
            _eventToCancelOrRemove = null;
            await LoadAllRequestsAndPayments();
            await LoadSettingsAndEvents();
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Failed to cancel booking: {ex.Message}");
        }
        finally
        {
            _isProcessingCancelOrRemove = false;
        }
    }

    private async Task PermanentlyDeleteBookingAsync()
    {
        if (_eventToCancelOrRemove == null) return;
        _isProcessingCancelOrRemove = true;

        try
        {
            var targetEvent = _eventToCancelOrRemove;

            // 1. If matching DB request exists, permanently delete from SQL
            int requestId = _selectedRequest?.Id ?? 0;
            if (requestId == 0)
            {
                var appData = ParseApplicationDetails(targetEvent);
                var matched = _cachedRentalRequests.FirstOrDefault(r =>
                    r.EventDate.Date == targetEvent.Start.Date &&
                    (string.Equals(r.ApplicantName, appData.ApplicantName, StringComparison.OrdinalIgnoreCase) ||
                     string.Equals(r.ApplicantName, GetCleanTitle(targetEvent), StringComparison.OrdinalIgnoreCase)));
                if (matched != null) requestId = matched.Id;
            }

            if (requestId > 0)
            {
                await RentalService.DeleteRentalRequestAsync(requestId);
            }

            // 2. If present in Google Calendar, permanently delete from Google Calendar
            var googleId = targetEvent.GoogleEventId ?? targetEvent.Uid;
            if (!string.IsNullOrEmpty(googleId))
            {
                try
                {
                    await CalendarService.DeleteGoogleEventAsync(googleId, _settings);
                }
                catch { }
            }

            // 3. Update Availability Calendar if applicable
            try
            {
                await RentalService.UpdateCalendarAvailabilityAsync(targetEvent.Start.Date, "Available");
            }
            catch { }

            _events.RemoveAll(e => e.Uid == targetEvent.Uid || (!string.IsNullOrEmpty(googleId) && e.GoogleEventId == googleId));

            ToastService.ShowSuccess("Booking permanently removed from system & calendar.");
            _showCancelEventConfirm = false;
            _selectedEvent = null;
            _eventToCancelOrRemove = null;
            await LoadSettingsAndEvents();
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Failed to delete booking: {ex.Message}");
        }
        finally
        {
            _isProcessingCancelOrRemove = false;
        }
    }



    private async Task HandleFileUpload(InputFileChangeEventArgs e)
    {
        try
        {
            var file = e.File;
            if (file != null)
            {
                using var stream = file.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024);
                using var reader = new System.IO.StreamReader(stream);
                var content = await reader.ReadToEndAsync();
                var imported = CalendarService.ParseIcsContent(content, "Imported File");
                if (imported.Any())
                {
                    _events = imported;
                    _testResultSuccess = true;
                    _testResultFeedback = $"Successfully imported {imported.Count} events from file!";
                }
                else
                {
                    _testResultSuccess = false;
                    _testResultFeedback = "No events found in the uploaded .ics file.";
                }
            }
        }
        catch (Exception ex)
        {
            _testResultSuccess = false;
            _testResultFeedback = $"Import failed: {ex.Message}";
        }
    }

    private async Task ExportCalendarIcs()
    {
        try
        {
            var icsContent = CalendarService.ExportToIcs(_events, _settings.CalendarName);
            var bytes = System.Text.Encoding.UTF8.GetBytes(icsContent);
            var base64 = Convert.ToBase64String(bytes);
            var fileName = $"Hall_Rentals_Calendar_{DateTime.Today:yyyyMMdd}.ics";
            await JSRuntime.InvokeVoidAsync("eval", $"let a = document.createElement('a'); a.href = 'data:text/calendar;charset=utf-8;base64,{base64}'; a.download = '{fileName}'; document.body.appendChild(a); a.click(); document.body.removeChild(a);");
        }
        catch (Exception ex)
        {
            _syncMessage = $"Export failed: {ex.Message}";
            _syncSuccess = false;
        }
    }

