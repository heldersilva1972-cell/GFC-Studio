    public class PaymentSummary
    {
        public string Status { get; set; } = "Unpaid"; // Paid, Deposit Paid, Partial, Unpaid
        public decimal TotalPrice { get; set; }
        public decimal DepositRequired { get; set; }
        public decimal TotalPaid { get; set; }
        public decimal RemainingBalance { get; set; }
    }

    private PaymentSummary GetEventPaymentSummary(CalendarEventItem? evt)
    {
        var summary = new PaymentSummary();
        if (evt == null) return summary;

        var appData = ParseApplicationDetails(evt);
        var matchedReq = _cachedRentalRequests.FirstOrDefault(r => 
            r.EventDate.Date == evt.Start.Date && 
            (string.Equals(r.ApplicantName, appData.ApplicantName, StringComparison.OrdinalIgnoreCase) ||
             string.Equals(r.ApplicantName, GetCleanTitle(evt), StringComparison.OrdinalIgnoreCase)));

        decimal totalPrice = matchedReq?.TotalPrice ?? 400m;
        decimal depositAmount = matchedReq?.SecurityDepositAmount ?? (_webSettings?.SecurityDepositAmount ?? 200m);

        var payments = matchedReq != null 
            ? _allPayments.Where(p => p.HallRentalRequestId == matchedReq.Id).ToList()
            : new List<HallRentalPayment>();

        decimal totalPaid = payments.Where(p => p.PaymentType != "Refund").Sum(p => p.Amount) - 
                            payments.Where(p => p.PaymentType == "Refund").Sum(p => p.Amount);

        summary.TotalPrice = totalPrice;
        summary.DepositRequired = depositAmount;
        summary.TotalPaid = totalPaid;
        summary.RemainingBalance = Math.Max(0, totalPrice - totalPaid);

        if (totalPaid >= totalPrice && totalPrice > 0)
        {
            summary.Status = "Paid";
        }
        else if (totalPaid >= depositAmount && depositAmount > 0)
        {
            summary.Status = "Deposit Paid";
        }
        else if (totalPaid > 0)
        {
            summary.Status = "Partial";
        }
        else
        {
            summary.Status = "Unpaid";
        }

        return summary;
    }

