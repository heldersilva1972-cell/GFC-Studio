    private bool HasPendingModifications()
    {
        if (_selectedRequest == null || _originalBookingSnapshot == null) return false;
        return CalculateDiffs().Any();
    }

    private List<BookingFieldDiff> CalculateDiffs()
    {
        var diffs = new List<BookingFieldDiff>();
        if (_selectedRequest == null || _originalBookingSnapshot == null) return diffs;

        var orig = _originalBookingSnapshot;
        var curr = _selectedRequest;

        if (orig.ApplicantName != curr.ApplicantName)
            diffs.Add(new BookingFieldDiff { FieldName = "Applicant Name", OldValue = orig.ApplicantName ?? "(empty)", NewValue = curr.ApplicantName ?? "(empty)" });

        if (orig.EventDate.Date != curr.EventDate.Date)
            diffs.Add(new BookingFieldDiff { FieldName = "Event Date", OldValue = orig.EventDate.ToString("MM/dd/yyyy"), NewValue = curr.EventDate.ToString("MM/dd/yyyy") });

        if ((orig.StartTime ?? "") != (curr.StartTime ?? ""))
            diffs.Add(new BookingFieldDiff { FieldName = "Start Time", OldValue = string.IsNullOrEmpty(orig.StartTime) ? "(unspecified)" : orig.StartTime, NewValue = string.IsNullOrEmpty(curr.StartTime) ? "(unspecified)" : curr.StartTime });

        if ((orig.EndTime ?? "") != (curr.EndTime ?? ""))
            diffs.Add(new BookingFieldDiff { FieldName = "End Time", OldValue = string.IsNullOrEmpty(orig.EndTime) ? "(unspecified)" : orig.EndTime, NewValue = string.IsNullOrEmpty(curr.EndTime) ? "(unspecified)" : curr.EndTime });

        if ((orig.RoomSelected ?? "") != (curr.RoomSelected ?? ""))
            diffs.Add(new BookingFieldDiff { FieldName = "Room / Space", OldValue = orig.RoomSelected ?? "Function Hall", NewValue = curr.RoomSelected ?? "Function Hall" });

        if (orig.MemberStatus != curr.MemberStatus)
            diffs.Add(new BookingFieldDiff { FieldName = "Renter Tier", OldValue = orig.MemberStatus ? "Active Member" : "Non-Member", NewValue = curr.MemberStatus ? "Active Member" : "Non-Member" });

        if (orig.TotalPrice != curr.TotalPrice)
            diffs.Add(new BookingFieldDiff { FieldName = "Total Agreed Price", OldValue = $"${orig.TotalPrice:N2}", NewValue = $"${curr.TotalPrice:N2}" });

        if (orig.SecurityDepositAmount != curr.SecurityDepositAmount)
            diffs.Add(new BookingFieldDiff { FieldName = "Security Deposit", OldValue = $"${orig.SecurityDepositAmount:N2}", NewValue = $"${curr.SecurityDepositAmount:N2}" });

        if (orig.BartenderRequested != curr.BartenderRequested)
            diffs.Add(new BookingFieldDiff { FieldName = "Bar Service", OldValue = orig.BartenderRequested ? "Yes" : "No", NewValue = curr.BartenderRequested ? "Yes" : "No" });

        if (orig.KitchenUsage != curr.KitchenUsage)
            diffs.Add(new BookingFieldDiff { FieldName = "Kitchen Access", OldValue = orig.KitchenUsage ? "Yes" : "No", NewValue = curr.KitchenUsage ? "Yes" : "No" });

        if (orig.AvEquipmentUsage != curr.AvEquipmentUsage)
            diffs.Add(new BookingFieldDiff { FieldName = "A/V Equipment", OldValue = orig.AvEquipmentUsage ? "Yes" : "No", NewValue = curr.AvEquipmentUsage ? "Yes" : "No" });

        if (orig.GuestCount != curr.GuestCount)
            diffs.Add(new BookingFieldDiff { FieldName = "Guest Attendance", OldValue = orig.GuestCount.ToString(), NewValue = curr.GuestCount.ToString() });

        if ((orig.EventType ?? "") != (curr.EventType ?? ""))
            diffs.Add(new BookingFieldDiff { FieldName = "Event Type", OldValue = orig.EventType ?? "General", NewValue = curr.EventType ?? "General" });

        if ((orig.RequesterPhone ?? "") != (curr.RequesterPhone ?? ""))
            diffs.Add(new BookingFieldDiff { FieldName = "Phone", OldValue = orig.RequesterPhone ?? "(empty)", NewValue = curr.RequesterPhone ?? "(empty)" });

        if ((orig.RequesterEmail ?? "") != (curr.RequesterEmail ?? ""))
            diffs.Add(new BookingFieldDiff { FieldName = "Email", OldValue = orig.RequesterEmail ?? "(empty)", NewValue = curr.RequesterEmail ?? "(empty)" });

        if ((orig.RequesterAddress ?? "") != (curr.RequesterAddress ?? ""))
            diffs.Add(new BookingFieldDiff { FieldName = "Mailing Address", OldValue = orig.RequesterAddress ?? "(empty)", NewValue = curr.RequesterAddress ?? "(empty)" });

        if ((orig.Status ?? "") != (curr.Status ?? ""))
            diffs.Add(new BookingFieldDiff { FieldName = "Status", OldValue = orig.Status ?? "Pending", NewValue = curr.Status ?? "Pending" });

        return diffs;
    }

    private void InitiateSaveBookingChanges()
    {
        _detectedDiffs = CalculateDiffs();
        if (!_detectedDiffs.Any())
        {
            ToastService.ShowInfo("No modifications were detected.");
            _isEditingBooking = false;
            return;
        }

        _changeReasonNote = "";
        _showConfirmChangesModal = true;
    }

    private async Task CommitBookingModificationsAsync()
    {
        if (_selectedRequest == null || _selectedEvent == null) return;
        _isSavingAdjustments = true;

        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            string adminUser = authState.User.Identity?.Name ?? "Admin";

            // 1. Build timestamped audit trail log entry
            var sb = new System.Text.StringBuilder();
            sb.AppendLine($"[{DateTime.Now:yyyy-MM-dd h:mm tt} by {adminUser}]");
            foreach (var diff in _detectedDiffs)
            {
                sb.AppendLine($"• {diff.FieldName}: {diff.OldValue} ➔ {diff.NewValue}");
            }
            if (!string.IsNullOrWhiteSpace(_changeReasonNote))
            {
                sb.AppendLine($"• Reason / Note: {_changeReasonNote.Trim()}");
            }
            sb.AppendLine();

            _selectedRequest.InternalNotes = (sb.ToString() + (_selectedRequest.InternalNotes ?? "")).Trim();
            _selectedRequest.StatusChangedBy = adminUser;
            _selectedRequest.StatusChangedDate = DateTime.UtcNow;

            // 2. Persist to SQL Database
            if (_selectedRequest.Id > 0)
            {
                await RentalService.UpdateRentalRequestAsync(_selectedRequest);
            }
            else
            {
                await RentalService.CreateRentalRequestAsync(_selectedRequest);
            }

            // 3. Update Calendar Availability Schedule
            try
            {
                string availStatus = string.Equals(_selectedRequest.Status, "Cancelled", StringComparison.OrdinalIgnoreCase) ? "Available" : "Booked";
                await RentalService.UpdateCalendarAvailabilityAsync(_selectedRequest.EventDate.Date, availStatus, _selectedRequest.ApplicantName, _selectedRequest.StartTime, _selectedRequest.EndTime);
            }
            catch { }

            // 4. Update Google Calendar Event if connected and write API is enabled
            var googleId = _selectedEvent.GoogleEventId ?? _selectedEvent.Uid;
            if (!string.IsNullOrEmpty(googleId) && _settings.EnableWriteApi)
            {
                try
                {
                    DateTime start = _selectedRequest.EventDate.Date.AddHours(14);
                    DateTime end = _selectedRequest.EventDate.Date.AddHours(20);
                    if (DateTime.TryParse(_selectedRequest.StartTime, out var ps)) start = _selectedRequest.EventDate.Date.Add(ps.TimeOfDay);
                    if (DateTime.TryParse(_selectedRequest.EndTime, out var pe)) end = _selectedRequest.EventDate.Date.Add(pe.TimeOfDay);

                    var (eventTitle, eventDescription) = FormatGoogleEventDetails(_selectedRequest, _selectedRequest.IsTestRecord);
                    if (string.Equals(_selectedRequest.Status, "Approved", StringComparison.OrdinalIgnoreCase))
                    {
                        eventTitle = eventTitle.Replace("PENDING: ", "APPROVED: ");
                    }

                    var updatedCalItem = new CalendarEventItem
                    {
                        Uid = _selectedEvent.Uid,
                        GoogleEventId = googleId,
                        Title = eventTitle,
                        Start = start,
                        End = end,
                        Location = _selectedRequest.RoomSelected ?? "Function Hall",
                        Description = eventDescription
                    };

                    await CalendarService.UpdateGoogleEventAsync(googleId, updatedCalItem, _settings);
                }
                catch (Exception gEx)
                {
                    System.Diagnostics.Debug.WriteLine($"Notice: Google Calendar sync warning during modification: {gEx.Message}");
                }
            }

            // 5. Update local in-memory event and summary
            _selectedEvent.Title = $"{(_selectedRequest.IsTestRecord ? "[TEST] " : "")}{(_selectedRequest.Status == "Approved" ? "APPROVED: " : (_selectedRequest.Status == "Cancelled" ? "CANCELLED: " : "PENDING: "))}{_selectedRequest.ApplicantName} ({_selectedRequest.EventType ?? "Rental"})";
            _selectedEvent.Location = _selectedRequest.RoomSelected ?? "Function Hall";
            _selectedEvent.Status = _selectedRequest.Status.ToUpperInvariant();

            // 6. Send updated quote email if enabled
            if (_sendUpdatedQuoteEmail && !string.IsNullOrWhiteSpace(_selectedRequest.RequesterEmail))
            {
                _ = Task.Run(async () =>
                {
                    try
                    {
                        var settings = await WebsiteSettingsService.GetWebsiteSettingsAsync();
                        if (settings != null)
                        {
                            decimal effectiveDeposit = _selectedRequest.SecurityDepositAmount > 0 ? _selectedRequest.SecurityDepositAmount : (settings.SecurityDepositAmount ?? 200m);
                            string subject = $"Updated Hall Rental Application Quote - Gloucester Fraternity Club";
                            
                            var sb = new System.Text.StringBuilder();
                            sb.AppendLine($"<h3>Updated Hall Rental Quote &amp; Booking Details</h3>");
                            sb.AppendLine($"<p>Dear {_selectedRequest.ApplicantName ?? "Applicant"},</p>");
                            sb.AppendLine($"<p>Your rental application details and pricing quote have been updated by club administration:</p>");
                            sb.AppendLine($"<ul>");
                            sb.AppendLine($"<li><strong>Event Date:</strong> {_selectedRequest.EventDate:dddd, MMMM dd, yyyy}</li>");
                            if (!string.IsNullOrEmpty(_selectedRequest.StartTime) && !string.IsNullOrEmpty(_selectedRequest.EndTime))
                                sb.AppendLine($"<li><strong>Time Window:</strong> {_selectedRequest.StartTime} - {_selectedRequest.EndTime}</li>");
                            sb.AppendLine($"<li><strong>Selected Space:</strong> {_selectedRequest.RoomSelected ?? "Function Hall"}</li>");
                            if (_selectedRequest.GuestCount > 0)
                                sb.AppendLine($"<li><strong>Estimated Guests:</strong> {_selectedRequest.GuestCount}</li>");
                            sb.AppendLine($"<li><strong>Agreed Total Price:</strong> ${_selectedRequest.TotalPrice:N2}</li>");
                            if (settings.RequireSecurityDeposit)
                                sb.AppendLine($"<li><strong>Refundable Security Deposit:</strong> ${effectiveDeposit:N2}</li>");
                            sb.AppendLine($"<li><strong>Bar Service:</strong> {(_selectedRequest.BartenderRequested ? "Requested" : "No")}</li>");
                            sb.AppendLine($"<li><strong>Kitchen Access:</strong> {(_selectedRequest.KitchenUsage ? "Requested" : "No")}</li>");
                            sb.AppendLine($"<li><strong>A/V Equipment:</strong> {(_selectedRequest.AvEquipmentUsage ? "Requested" : "No")}</li>");
                            sb.AppendLine($"</ul>");
                            if (!string.IsNullOrWhiteSpace(_changeReasonNote))
                            {
                                sb.AppendLine($"<p><strong>Note from Administration:</strong> {_changeReasonNote.Trim()}</p>");
                            }
                            sb.AppendLine($"<p>If you have any questions, please contact the Gloucester Fraternity Club at {settings.ClubPhone ?? "(978) 283-2889"}.</p>");

                            await RentalEmailDispatcher.SendRentalEmailAsync(settings, _selectedRequest.RequesterEmail, subject, sb.ToString(), settings.RentalEmailCc);
                        }
                    }
                    catch { }
                });
            }

            await LoadAllRequestsAndPayments();
            ToastService.ShowSuccess($"Booking & pricing updated successfully! ({_detectedDiffs.Count} changes recorded)");

            _showConfirmChangesModal = false;
            _isEditingBooking = false;
            _originalBookingSnapshot = null;
            _sendUpdatedQuoteEmail = false;
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Failed to save booking modifications: {ex.Message}");
        }
        finally
        {
            _isSavingAdjustments = false;
        }
    }

    private bool _sendUpdatedQuoteEmail = false;
    private bool _isResendingQuote = false;
    private bool _showResendQuoteConfirmModal = false;

    private void OpenResendQuoteConfirmation()
    {
        if (_selectedEvent == null) return;
        var appData = ParseApplicationDetails(_selectedEvent);
        string? email = !string.IsNullOrWhiteSpace(_selectedRequest?.RequesterEmail) ? _selectedRequest.RequesterEmail : appData.Email;

        if (string.IsNullOrWhiteSpace(email))
        {
            ToastService.ShowWarning("No applicant email address is associated with this booking.");
            return;
        }

        _showResendQuoteConfirmModal = true;
    }

    private async Task ConfirmAndSendQuoteAsync()
    {
        _showResendQuoteConfirmModal = false;
        await ResendQuoteToApplicantAsync();
    }

    private void OnMemberStatusSelectionChanged(ChangeEventArgs e)
    {
        if (_selectedRequest == null) return;
        if (bool.TryParse(e.Value?.ToString(), out var isMember))
        {
            _selectedRequest.MemberStatus = isMember;
            RecalculateEditPriceQuote();
        }
    }

    private void RecalculateEditPriceQuote()
    {
        if (_selectedRequest == null) return;
        decimal basePrice = 0;
        bool isMember = _selectedRequest.MemberStatus;

        var rooms = _editableRooms.Any() ? _editableRooms : (_webSettings?.GetRoomsList() ?? new List<RentalRoomOption>());
        var selectedRoom = rooms.FirstOrDefault(r => r.Name.Equals(_selectedRequest.RoomSelected, StringComparison.OrdinalIgnoreCase)) ?? rooms.FirstOrDefault();

        if (selectedRoom != null)
        {
            basePrice = isMember ? selectedRoom.MemberRate : selectedRoom.NonMemberRate;
        }
        else
        {
            basePrice = isMember ? (_webSettings?.FunctionHallMemberRate ?? 300) : (_webSettings?.FunctionHallNonMemberRate ?? 400);
        }

        decimal addOns = 0;
        if (_selectedRequest.BartenderRequested) addOns += (_webSettings?.BartenderServiceFee ?? 100);
        if (_selectedRequest.KitchenUsage) addOns += (_webSettings?.KitchenFee ?? 50);
        if (_selectedRequest.AvEquipmentUsage) addOns += (_webSettings?.AvEquipmentFee ?? 25);

        _selectedRequest.TotalPrice = basePrice + addOns;
    }

    private void AutoCalculateSelectedRequestPrice()
    {
        RecalculateEditPriceQuote();
        if (_selectedRequest != null)
        {
            ToastService.ShowInfo($"Calculated standard quote: ${_selectedRequest.TotalPrice:N2}");
        }
    }

    private async Task ResendQuoteToApplicantAsync()
    {
        if (_selectedEvent == null) return;
        var appData = ParseApplicationDetails(_selectedEvent);
        string? email = !string.IsNullOrWhiteSpace(_selectedRequest?.RequesterEmail) ? _selectedRequest.RequesterEmail : appData.Email;

        if (string.IsNullOrWhiteSpace(email))
        {
            ToastService.ShowWarning("No applicant email address is associated with this booking.");
            return;
        }

        _isResendingQuote = true;
        try
        {
            var settings = await WebsiteSettingsService.GetWebsiteSettingsAsync();
            if (settings == null)
            {
                ToastService.ShowError("Could not load club website settings.");
                return;
            }

            var req = _selectedRequest ?? new HallRentalRequest
            {
                ApplicantName = appData.ApplicantName ?? GetCleanTitle(_selectedEvent),
                RequesterEmail = email,
                EventDate = _selectedEvent.Start.Date,
                RoomSelected = _selectedEvent.Location ?? "Function Hall",
                TotalPrice = GetEventPaymentSummary(_selectedEvent).TotalPrice,
                SecurityDepositAmount = GetEventPaymentSummary(_selectedEvent).DepositRequired
            };

            decimal effectiveDeposit = req.SecurityDepositAmount > 0 ? req.SecurityDepositAmount : (settings.SecurityDepositAmount ?? 200m);
            string subject = $"Updated Hall Rental Application Quote - Gloucester Fraternity Club";
            
            var sb = new System.Text.StringBuilder();
            sb.AppendLine($"<h3>Updated Hall Rental Quote &amp; Booking Details</h3>");
            sb.AppendLine($"<p>Dear {req.ApplicantName ?? "Applicant"},</p>");
            sb.AppendLine($"<p>Here is your updated rental quote and specification breakdown from the Gloucester Fraternity Club:</p>");
            sb.AppendLine($"<ul>");
            sb.AppendLine($"<li><strong>Event Date:</strong> {req.EventDate:dddd, MMMM dd, yyyy}</li>");
            if (!string.IsNullOrEmpty(req.StartTime) && !string.IsNullOrEmpty(req.EndTime))
                sb.AppendLine($"<li><strong>Time Window:</strong> {req.StartTime} - {req.EndTime}</li>");
            sb.AppendLine($"<li><strong>Selected Space:</strong> {req.RoomSelected ?? "Function Hall"}</li>");
            if (req.GuestCount > 0)
                sb.AppendLine($"<li><strong>Estimated Guests:</strong> {req.GuestCount}</li>");
            sb.AppendLine($"<li><strong>Agreed Total Price:</strong> ${req.TotalPrice:N2}</li>");
            if (settings.RequireSecurityDeposit)
                sb.AppendLine($"<li><strong>Refundable Security Deposit:</strong> ${effectiveDeposit:N2}</li>");
            sb.AppendLine($"<li><strong>Bar Service:</strong> {(req.BartenderRequested ? "Requested" : "No")}</li>");
            sb.AppendLine($"<li><strong>Kitchen Access:</strong> {(req.KitchenUsage ? "Requested" : "No")}</li>");
            sb.AppendLine($"<li><strong>A/V Equipment:</strong> {(req.AvEquipmentUsage ? "Requested" : "No")}</li>");
            sb.AppendLine($"</ul>");
            sb.AppendLine($"<p>If you have any questions or need to make further adjustments, please contact us at {settings.ClubPhone ?? "(978) 283-2889"}.</p>");
            sb.AppendLine($"<p>Thank you,<br/><strong>Gloucester Fraternity Club</strong></p>");

            var result = await RentalEmailDispatcher.SendRentalEmailAsync(settings, email, subject, sb.ToString(), settings.RentalEmailCc);
            if (result.Success)
            {
                ToastService.ShowSuccess($"Updated quote successfully emailed to {email}!");
            }
            else
            {
                ToastService.ShowError($"Email sending failed: {result.ErrorMessage}");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Failed to send updated quote: {ex.Message}");
        }
        finally
        {
            _isResendingQuote = false;
        }
    }

    private async Task OpenRecordPaymentModal(CalendarEventItem evt)
    {
        var appData = ParseApplicationDetails(evt);
        await LoadAllRequestsAndPayments();
        var matchedReq = _cachedRentalRequests.FirstOrDefault(r => 
            r.EventDate.Date == evt.Start.Date && 
            (string.Equals(r.ApplicantName, appData.ApplicantName, StringComparison.OrdinalIgnoreCase) ||
             string.Equals(r.ApplicantName, GetCleanTitle(evt), StringComparison.OrdinalIgnoreCase)));

        int reqId = matchedReq?.Id ?? 0;
        if (reqId == 0)
        {
            // Create or match a request record for this calendar event so payments attach cleanly
            var newReq = new HallRentalRequest
            {
                ApplicantName = appData.ApplicantName ?? GetCleanTitle(evt),
                RequesterName = appData.ApplicantName ?? GetCleanTitle(evt),
                RequesterEmail = appData.Email ?? "",
                RequesterPhone = appData.Phone ?? "",
                EventDate = evt.Start.Date,
                RequestedDate = evt.Start.Date,
                EventType = appData.EventType ?? "Hall Rental",
                GuestCount = int.TryParse(appData.GuestCount, out var gc) ? gc : 50,
                Status = evt.Title.StartsWith("PENDING", StringComparison.OrdinalIgnoreCase) ? "Pending" : "Approved",
                TotalPrice = 400
            };
            await RentalService.CreateRentalRequestAsync(newReq);
            reqId = newReq.Id;
        }

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        string loggedInUser = authState.User.Identity?.Name ?? "Admin";

        _paymentError = null;
        _paymentModel = new HallRentalPayment
        {
            HallRentalRequestId = reqId,
            PaymentType = "Security Deposit",
            Amount = 200,
            PaymentDate = DateTime.Today,
            PaymentMethod = "Check",
            RecordedBy = loggedInUser
        };
        _showRecordPaymentModal = true;
    }

    private async Task SavePayment()
    {
        if (_paymentModel.Amount <= 0)
        {
            _paymentError = "Please enter an amount greater than $0.00.";
            return;
        }

        _isSavingPayment = true;
        _paymentError = null;

        try
        {
            await RentalService.RecordPaymentAsync(_paymentModel);
            _showRecordPaymentModal = false;
            ToastService.ShowSuccess($"Payment of ${_paymentModel.Amount:N2} recorded successfully!");
            await LoadAllRequestsAndPayments();
            if (_selectedEvent != null)
            {
                await LoadPaymentsForSelectedEvent(_selectedEvent);
            }
        }
        catch (Exception ex)
        {
            _paymentError = $"Failed to save payment: {ex.Message}";
        }
        finally
        {
            _isSavingPayment = false;
        }
    }

    private async Task DeletePayment(int paymentId)
    {
        try
        {
            await RentalService.DeletePaymentAsync(paymentId);
            ToastService.ShowSuccess("Payment deleted.");
            await LoadAllRequestsAndPayments();
