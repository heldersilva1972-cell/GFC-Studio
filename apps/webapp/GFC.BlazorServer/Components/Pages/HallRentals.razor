    private async void OnCalendarUpdatedHandler()
    {
        try
        {
            await InvokeAsync(async () =>
            {
                await LoadSettingsAndEvents();
                if (_selectedEvent != null && !_isEditingBooking)
                {
                    await LoadPaymentsForSelectedEvent(_selectedEvent);
                }
                else
                {
                    await LoadAllRequestsAndPayments();
                }
                StateHasChanged();
            });
        }
        catch { }
    }

