    private async Task CheckPermissions()
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            _isAdmin = user.IsInRole("Admin") || user.Identity?.Name?.ToLower() == "admin";

            if (_isAdmin)
            {
                _hasPageAccess = true;
                return;
            }

            var userIdClaim = user.FindFirst("UserId") ?? user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier);
            if (userIdClaim != null && int.TryParse(userIdClaim.Value, out var userId))
            {
                var permissions = UserService.GetUserPagePermissions(userId);
                var allPages = UserService.GetAllPages();
                var hallRentalsPage = allPages.FirstOrDefault(p => p.PageRoute.TrimStart('/').ToLower() == "hall-rentals");
                if (hallRentalsPage != null)
                {
                    _hasPageAccess = permissions.Any(p => p.PageId == hallRentalsPage.PageId);
                }
            }
        }
        catch
        {
            _hasPageAccess = false;
        }
    }

    private async Task LoadSettingsAndEvents()
    {
        try
        {
            try
            {
                _settings = await CalendarService.GetSettingsAsync();
            }
            catch (Exception cEx)
            {
                _settings = new GoogleCalendarSettings();
                System.Diagnostics.Debug.WriteLine($"Warning: CalendarService.GetSettingsAsync failed: {cEx.Message}");
            }

            try
            {
                _webSettings = await WebsiteSettingsService.GetWebsiteSettingsAsync();
            }
            catch (Exception wEx)
            {
                _webSettings = new WebsiteSettings();
                System.Diagnostics.Debug.WriteLine($"Warning: WebsiteSettingsService.GetWebsiteSettingsAsync failed: {wEx.Message}");
            }

            // Ensure at least 1 feed entry exists if Feeds list is empty
            if (_settings.Feeds.Count == 0 && !string.IsNullOrWhiteSpace(_settings.PublicCalendarUrl))
            {
                _settings.Feeds.Add(new CalendarFeedConfig
                {
                    Name = string.IsNullOrWhiteSpace(_settings.CalendarName) ? "Primary Calendar" : _settings.CalendarName,
                    Url = _settings.PublicCalendarUrl,
                    Color = "#0d6efd",
                    IsEnabled = true
                });
            }

            var calendarEvents = new List<CalendarEventItem>();
            bool isSandbox = _webSettings?.EnableSandboxMode == true;

            if (isSandbox)
            {
                // In Sandbox Mode: Fetch the test sandbox calendar (First try real-time REST API, then fallback to iCal)
                var targetCalId = _webSettings?.SandboxGoogleCalendarId?.Trim();
                if (string.IsNullOrWhiteSpace(targetCalId)) targetCalId = _settings.PrimaryGoogleCalendarId?.Trim();
                if (string.IsNullOrWhiteSpace(targetCalId) && !string.IsNullOrWhiteSpace(_settings.PublicCalendarUrl))
                {
                    var m = System.Text.RegularExpressions.Regex.Match(_settings.PublicCalendarUrl, @"ical/([^/]+)/public", System.Text.RegularExpressions.RegexOptions.IgnoreCase);
                    if (m.Success) targetCalId = System.Uri.UnescapeDataString(m.Groups[1].Value);
                }

                List<CalendarEventItem> sandboxEvents = new();
                if (!string.IsNullOrWhiteSpace(targetCalId) && !string.IsNullOrWhiteSpace(_settings.ServiceAccountEmail) && !string.IsNullOrWhiteSpace(_settings.ServiceAccountPrivateKey))
                {
                    try
                    {
                        var apiEvents = await CalendarService.FetchEventsFromApiAsync(targetCalId, _settings, "Sandbox Test Calendar", "#f59e0b");
                        if (apiEvents != null && apiEvents.Count > 0)
                        {
                            sandboxEvents = apiEvents;
                        }
                    }
                    catch (Exception apiEx)
                    {
                        System.Diagnostics.Debug.WriteLine($"Notice: Sandbox API event fetch warning: {apiEx.Message}");
                    }
                }

                if (sandboxEvents.Count == 0)
                {
                    var sandboxUrl = !string.IsNullOrWhiteSpace(_webSettings?.SandboxCalendarFeedUrl) 
                        ? _webSettings.SandboxCalendarFeedUrl 
                        : _settings.PublicCalendarUrl;

                    if (!string.IsNullOrWhiteSpace(sandboxUrl))
                    {
                        try
                        {
                            var icalEvents = await CalendarService.FetchEventsFromUrlAsync(sandboxUrl, "Sandbox Test Calendar", "#f59e0b");
                            if (icalEvents != null)
                            {
                                sandboxEvents.AddRange(icalEvents);
                            }
                        }
                        catch (Exception sEx)
                        {
                            System.Diagnostics.Debug.WriteLine($"Notice: Sandbox calendar feed sync warning: {sEx.Message}");
                        }
                    }
                }

                calendarEvents.AddRange(sandboxEvents);
            }
            else
            {
                // In Live Production Mode: Fetch configured production Google Calendar feeds
                if (_settings.Feeds.Any(f => f.IsEnabled && !string.IsNullOrWhiteSpace(f.Url)))
                {
                    try
                    {
                        var fetched = await CalendarService.FetchAllFeedsAsync(_settings);
                        if (fetched != null)
                        {
                            calendarEvents.AddRange(fetched);
                        }
                    }
                    catch (Exception ex)
                    {
                        _syncMessage = $"Notice: Google Calendar sync error: {ex.Message}";
                    }
                }
            }

            // Always merge database rental requests so all submitted applications are present with complete contact info
            try
            {
                var dbRequests = await RentalService.GetRentalRequestsAsync();
                foreach (var req in dbRequests)
                {
                    bool isTestReq = req.IsTestRecord;
                    // In sandbox mode, show both or sandbox; in live mode, prioritize live requests
                    if (!isSandbox && isTestReq) continue;

                    string prefix = isTestReq ? "[TEST] " : "";
                    string statusPrefix = string.Equals(req.Status, "Approved", StringComparison.OrdinalIgnoreCase) ? "APPROVED: " : "PENDING: ";
                    string title = $"{prefix}{statusPrefix}{req.ApplicantName} ({req.EventType ?? "Rental"})";

                    // Check if already present in calendar events by date & name
                    string cleanApplicant = req.ApplicantName.Trim();
                    int parenIdx = cleanApplicant.IndexOf('(');
                    if (parenIdx > 0) cleanApplicant = cleanApplicant.Substring(0, parenIdx).Trim();

                    var existing = calendarEvents.FirstOrDefault(e => 
                        e.Start.Date == req.EventDate.Date && 
                        (e.Title.Contains(cleanApplicant, StringComparison.OrdinalIgnoreCase) || 
                         (!string.IsNullOrWhiteSpace(req.RequesterName) && e.Title.Contains(req.RequesterName, StringComparison.OrdinalIgnoreCase))));

                    if (existing == null)
                    {
                        DateTime start = req.EventDate.Date.AddHours(12);
                        DateTime end = req.EventDate.Date.AddHours(17);
                        if (!string.IsNullOrWhiteSpace(req.StartTime) && DateTime.TryParse(req.StartTime, out var ps)) start = req.EventDate.Date.Add(ps.TimeOfDay);
                        if (!string.IsNullOrWhiteSpace(req.EndTime) && DateTime.TryParse(req.EndTime, out var pe)) end = req.EventDate.Date.Add(pe.TimeOfDay);

                        calendarEvents.Add(new CalendarEventItem
                        {
                            Title = title,
                            Start = start,
                            End = end,
                            Location = req.RoomSelected ?? "Function Hall",
                            Source = isTestReq ? "Sandbox Booking" : "Rental Booking",
                            Status = req.Status?.ToUpperInvariant() ?? "PENDING",
                            ColorCategory = string.Equals(req.Status, "Approved", StringComparison.OrdinalIgnoreCase) ? "badge-success" : "badge-warning",
                            Description = $"Applicant: {req.ApplicantName}\nPhone: {req.RequesterPhone}\nEmail: {req.RequesterEmail}\nAddress: {req.RequesterAddress}\nRoom: {req.RoomSelected}\nGuests: {req.GuestCount}\nTotal: ${req.TotalPrice:N2}"
                        });
                    }
                }
            }
            catch (Exception dbEx)
            {
                System.Diagnostics.Debug.WriteLine($"Notice: Database rental request merge warning: {dbEx.Message}");
            }

            _events = calendarEvents;
        }
        catch (Exception ex)
        {
            _events = new List<CalendarEventItem>();
            _syncMessage = $"Notice: Calendar sync issue ({ex.Message}).";
            _syncSuccess = false;
        }
    }

