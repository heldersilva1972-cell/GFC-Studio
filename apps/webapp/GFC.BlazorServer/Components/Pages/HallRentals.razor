    private string GetCleanApplicantName(CalendarEventItem evt)
    {
        var appData = ParseApplicationDetails(evt);
        if (!string.IsNullOrWhiteSpace(appData.ApplicantName))
        {
            return appData.ApplicantName.Trim();
        }

        var clean = GetCleanTitle(evt);
        if (clean.Contains(" | "))
        {
            var firstSegment = clean.Split(new[] { " | " }, StringSplitOptions.RemoveEmptyEntries).FirstOrDefault();
            if (!string.IsNullOrWhiteSpace(firstSegment)) return firstSegment.Trim();
        }

        int paren = clean.IndexOf('(');
        if (paren > 0)
        {
            return clean.Substring(0, paren).Trim();
        }

        int dash = clean.IndexOf(" - ");
        if (dash > 0)
        {
            return clean.Substring(0, dash).Trim();
        }

        return string.IsNullOrWhiteSpace(clean) ? "Applicant" : clean;
    }

    private string GetEventServicesSummary(ParsedApplicationData details, CalendarEventItem? evt = null)
    {
        var services = new List<string>();

        bool showBar = _webSettings?.WebAppPushBarService ?? true;
        string barLabel = !string.IsNullOrWhiteSpace(_webSettings?.WebAppBarServiceDisplayName) ? _webSettings.WebAppBarServiceDisplayName : "Bar / Bartender Service";

        bool showKitchen = _webSettings?.WebAppPushKitchenUsage ?? true;
        string kitchenLabel = !string.IsNullOrWhiteSpace(_webSettings?.WebAppKitchenUsageDisplayName) ? _webSettings.WebAppKitchenUsageDisplayName : "Kitchen Access";

        bool showAv = _webSettings?.WebAppPushAvEquipment ?? true;
        string avLabel = !string.IsNullOrWhiteSpace(_webSettings?.WebAppAvEquipmentDisplayName) ? _webSettings.WebAppAvEquipmentDisplayName : "A/V Equipment";

        var matchedReq = evt != null ? FindMatchingRentalRequest(evt) : null;

        bool hasBar = string.Equals(details.BarService, "Yes", StringComparison.OrdinalIgnoreCase) ||
                      (matchedReq?.BartenderRequested == true) ||
                      (evt != null && (evt.Description?.Contains("Bar Service: Yes", StringComparison.OrdinalIgnoreCase) == true || evt.Description?.Contains("Bar / Bartender", StringComparison.OrdinalIgnoreCase) == true));

        bool hasKitchen = string.Equals(details.KitchenAccess, "Yes", StringComparison.OrdinalIgnoreCase) ||
                          (matchedReq?.KitchenUsage == true) ||
                          (evt != null && (evt.Description?.Contains("Kitchen Access: Yes", StringComparison.OrdinalIgnoreCase) == true || evt.Description?.Contains("Kitchen Usage", StringComparison.OrdinalIgnoreCase) == true));

        bool hasAv = (matchedReq?.AvEquipmentUsage == true) ||
                     (evt != null && (evt.Description?.Contains("A/V", StringComparison.OrdinalIgnoreCase) == true || evt.Description?.Contains("Audio", StringComparison.OrdinalIgnoreCase) == true || evt.Description?.Contains("Projector", StringComparison.OrdinalIgnoreCase) == true));

        if (hasBar && showBar)
        {
            services.Add(barLabel);
        }
        if (hasKitchen && showKitchen)
        {
            services.Add(kitchenLabel);
        }
        if (hasAv && showAv && !services.Contains(avLabel))
        {
            services.Add(avLabel);
        }

        if (details.ExtraFields.TryGetValue("Services", out var customServices) && !string.IsNullOrWhiteSpace(customServices))
        {
            var parts = customServices.Split(new[] { ',', ';' }, StringSplitOptions.RemoveEmptyEntries).Select(p => p.Trim());
            foreach (var part in parts)
            {
                if (part.Contains("Bar", StringComparison.OrdinalIgnoreCase) || part.Contains("Bartender", StringComparison.OrdinalIgnoreCase))
                {
                    if (showBar && !services.Contains(barLabel)) services.Add(barLabel);
                }
                else if (part.Contains("Kitchen", StringComparison.OrdinalIgnoreCase))
                {
                    if (showKitchen && !services.Contains(kitchenLabel)) services.Add(kitchenLabel);
                }
                else if (part.Contains("A/V", StringComparison.OrdinalIgnoreCase) || part.Contains("Audio", StringComparison.OrdinalIgnoreCase) || part.Contains("Projector", StringComparison.OrdinalIgnoreCase))
                {
                    if (showAv && !services.Contains(avLabel)) services.Add(avLabel);
                }
                else
                {
                    if (!services.Any(s => s.Equals(part, StringComparison.OrdinalIgnoreCase)))
                    {
                        services.Add(part);
                    }
                }
            }
        }
        return string.Join(", ", services);
    }

    private (string? text, string badgeClass, string tooltip, bool isOverdue) GetSubmissionAgeInfo(CalendarEventItem evt, ParsedApplicationData appData, string payStatus)
    {
        if (_webSettings?.EnableSubmissionAgeTracking != true)
        {
            return (null, "", "", false);
        }

        // Check if event is inquiry, approved, confirmed, or paid in full / deposit paid - if so, tracking is not needed / removed
        bool isInquiry = string.Equals(evt.Status, "INQUIRY", StringComparison.OrdinalIgnoreCase) || 
                         string.Equals(evt.Status, "RESPONDED", StringComparison.OrdinalIgnoreCase) ||
                         evt.Title.StartsWith("INQUIRY", StringComparison.OrdinalIgnoreCase) ||
                         evt.Source == "General Inquiry";
        bool isApproved = evt.Title.StartsWith("APPROVED", StringComparison.OrdinalIgnoreCase) || 
                          string.Equals(evt.Status, "APPROVED", StringComparison.OrdinalIgnoreCase) ||
                          string.Equals(evt.Status, "CONFIRMED", StringComparison.OrdinalIgnoreCase);
        bool isPaid = payStatus == "Paid" || payStatus == "Deposit Paid";
        bool isCancelled = evt.Title.StartsWith("CANCELLED", StringComparison.OrdinalIgnoreCase) || 
                           string.Equals(evt.Status, "CANCELLED", StringComparison.OrdinalIgnoreCase);

        if (isInquiry || isApproved || isPaid || isCancelled)
        {
            return (null, "", "", false);
        }

        DateTime? submittedDate = evt.CreatedDate;
        if (!submittedDate.HasValue && !string.IsNullOrWhiteSpace(appData.Timestamp))
        {
            if (DateTime.TryParse(appData.Timestamp, out var parsedTs))
            {
                submittedDate = parsedTs;
            }
        }
        if (!submittedDate.HasValue && !string.IsNullOrWhiteSpace(appData.CreatedTimestamp))
        {
            if (DateTime.TryParse(appData.CreatedTimestamp, out var parsedTs2))
            {
                submittedDate = parsedTs2;
            }
        }
        if (!submittedDate.HasValue && !string.IsNullOrWhiteSpace(evt.Description))
        {
            var match = System.Text.RegularExpressions.Regex.Match(evt.Description, @"(?:Timestamp|Submitted|Created):\s*([^\r\n]+)", System.Text.RegularExpressions.RegexOptions.IgnoreCase);
            if (match.Success && DateTime.TryParse(match.Groups[1].Value.Trim(), out var parsedDescDate))
            {
                submittedDate = parsedDescDate;
            }
        }

        if (!submittedDate.HasValue)
        {
            return (null, "", "", false);
        }

        var elapsed = DateTime.Now - submittedDate.Value;
        int windowDays = _webSettings.ApplicationPaymentWindowDays > 0 ? _webSettings.ApplicationPaymentWindowDays : 2;
        var window = TimeSpan.FromDays(windowDays);
        var remaining = window - elapsed;

        string elapsedText;
        if (elapsed.TotalMinutes < 60)
        {
            elapsedText = $"{(int)Math.Max(1, elapsed.TotalMinutes)}m ago";
        }
        else if (elapsed.TotalHours < 24)
        {
            elapsedText = $"{(int)elapsed.TotalHours}h ago";
        }
        else
        {
            int days = (int)elapsed.TotalDays;
            int hours = elapsed.Hours;
            elapsedText = hours > 0 ? $"{days}d {hours}h ago" : $"{days}d ago";
        }

        if (remaining.TotalSeconds <= 0)
        {
            // Overdue
            var overdueBy = elapsed - window;
            string overdueText;
            if (overdueBy.TotalHours < 24)
            {
                overdueText = $"{(int)Math.Max(1, overdueBy.TotalHours)}h overdue";
            }
            else
            {
                int d = (int)overdueBy.TotalDays;
                int h = overdueBy.Hours;
                overdueText = h > 0 ? $"{d}d {h}h overdue" : $"{d}d overdue";
            }

            string text = $"Overdue ({elapsedText})";
            string badgeClass = "badge bg-danger text-white border border-danger px-2 py-1 rounded-pill fw-bold shadow-sm";
            string tooltip = $"Submitted {submittedDate.Value:g}. Exceeded {windowDays}-day payment window by {overdueText}.";
            return (text, badgeClass, tooltip, true);
        }
        else if (remaining.TotalHours <= 12)
        {
            // Expiring soon (less than 12h remaining)
            string remText = remaining.TotalHours < 1 ? $"{(int)Math.Max(1, remaining.TotalMinutes)}m left" : $"{(int)remaining.TotalHours}h {remaining.Minutes}m left";
            string text = $"{remText} ({elapsedText})";
            string badgeClass = "badge px-2 py-1 rounded-pill fw-bold shadow-sm";
            string tooltip = $"Submitted {submittedDate.Value:g}. Window expires in {remText} ({windowDays}-day limit).";
            return (text, "badge-expiring-soon", tooltip, false);
        }
        else
        {
            // Within window (green)
            string remText;
            if (remaining.TotalDays >= 1)
            {
                int d = (int)remaining.TotalDays;
                int h = remaining.Hours;
                remText = h > 0 ? $"{d}d {h}h left" : $"{d}d left";
            }
            else
            {
                remText = $"{(int)remaining.TotalHours}h left";
            }

            string text = $"{remText} ({elapsedText})";
            string badgeClass = "badge bg-success bg-opacity-10 text-success border border-success px-2 py-1 rounded-pill fw-semibold";
            string tooltip = $"Submitted {submittedDate.Value:g}. {remText} remaining to pay ({windowDays}-day window).";
            return (text, badgeClass, tooltip, false);
        }
    }

    private string? GetMonthGridFieldValue(CalendarEventItem evt, string fieldKey, ParsedApplicationData appData, string payStatus)
    {
        switch (fieldKey)
        {
            case "time_window":
                return evt.IsAllDay ? "All-day" : $"{evt.Start:h:mm tt} - {evt.End:h:mm tt}";

            case "event_status":
                var matched = FindMatchingRentalRequest(evt);
                if (matched != null)
                {
                    if (string.Equals(matched.Status, "Approved", StringComparison.OrdinalIgnoreCase)) return "Approved";
                    if (string.Equals(matched.Status, "Cancelled", StringComparison.OrdinalIgnoreCase)) return "Cancelled";
                    if (string.Equals(matched.Status, "Pending", StringComparison.OrdinalIgnoreCase)) return "Pending";
                }
                if (evt.Title.StartsWith("APPROVED", StringComparison.OrdinalIgnoreCase) || string.Equals(evt.Status, "APPROVED", StringComparison.OrdinalIgnoreCase) || string.Equals(evt.Status, "CONFIRMED", StringComparison.OrdinalIgnoreCase))
                    return "Approved";
                if (evt.Title.StartsWith("PENDING", StringComparison.OrdinalIgnoreCase) || string.Equals(evt.Status, "PENDING", StringComparison.OrdinalIgnoreCase))
                    return "Pending";
                if (evt.Title.StartsWith("INQUIRY", StringComparison.OrdinalIgnoreCase) || string.Equals(evt.Status, "INQUIRY", StringComparison.OrdinalIgnoreCase) || evt.Source == "General Inquiry")
                    return "Inquiry";
                if (evt.Title.StartsWith("CANCELLED", StringComparison.OrdinalIgnoreCase) || string.Equals(evt.Status, "CANCELLED", StringComparison.OrdinalIgnoreCase))
                    return "Cancelled";
                return evt.Status ?? "Confirmed";

            case "payment_status":
                bool isEvtInquiry = string.Equals(evt.Status, "INQUIRY", StringComparison.OrdinalIgnoreCase) || 
                                    string.Equals(evt.Status, "RESPONDED", StringComparison.OrdinalIgnoreCase) ||
                                    evt.Title.StartsWith("INQUIRY", StringComparison.OrdinalIgnoreCase) ||
                                    evt.Source == "General Inquiry";
                return isEvtInquiry ? null : payStatus;

            case "submission_age":
                var ageInfo = GetSubmissionAgeInfo(evt, appData, payStatus);
                return ageInfo.text;

            case "applicant_name":
                return GetCleanApplicantName(evt);

            case "event_type":
                return !string.IsNullOrWhiteSpace(appData.EventType) ? appData.EventType : null;

            case "room_location":
                return !string.IsNullOrWhiteSpace(evt.Location) ? evt.Location : "Function Hall";

            case "services":
                var svcs = GetEventServicesSummary(appData, evt);
                return !string.IsNullOrWhiteSpace(svcs) ? svcs : null;

            case "guest_count":
                return !string.IsNullOrWhiteSpace(appData.GuestCount) ? $"{appData.GuestCount} Guests" : null;

            case "pricing_quote":
                var pay = GetEventPaymentSummary(evt);
                return pay.TotalPrice > 0 ? $"${pay.TotalPrice:N0}" : null;

            case "contact_phone":
                return !string.IsNullOrWhiteSpace(appData.Phone) ? FormatPhoneNumber(appData.Phone) : null;

            case "contact_email":
                return !string.IsNullOrWhiteSpace(appData.Email) ? appData.Email : null;

            default:
                return null;
        }
    }

    private DateTime? GetLatestActivityTime()
    {
        DateTime? latest = null;

        if (_cachedRentalRequests.Any())
        {
            var latestReq = _cachedRentalRequests
                .Select(r =>
                {
                    var dt = r.CreatedDate != default ? r.CreatedDate : (r.RequestedDate != default ? r.RequestedDate : (DateTime?)null);
                    if (dt.HasValue && dt.Value.Kind == DateTimeKind.Utc)
                    {
                        return dt.Value.ToLocalTime();
                    }
                    return dt;
                })
                .Where(d => d.HasValue)
                .OrderByDescending(d => d.Value)
                .FirstOrDefault();

            if (latestReq.HasValue && (!latest.HasValue || latestReq.Value > latest.Value))
            {
                latest = latestReq;
            }
        }

        if (_allPayments.Any())
        {
            var latestPay = _allPayments.OrderByDescending(p => p.PaymentDate).FirstOrDefault();
            if (latestPay != null)
            {
                var payDt = latestPay.PaymentDate.Kind == DateTimeKind.Utc ? latestPay.PaymentDate.ToLocalTime() : latestPay.PaymentDate;
                if (!latest.HasValue || payDt > latest.Value)
                {
                    latest = payDt;
                }
            }
        }

        return latest;
    }

