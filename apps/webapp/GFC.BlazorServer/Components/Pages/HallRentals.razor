    private bool HasPendingModifications()
    {
        if (_selectedRequest == null || _originalBookingSnapshot == null) return false;
        return CalculateDiffs().Any();
    }

    private List<BookingFieldDiff> CalculateDiffs()
    {
        var diffs = new List<BookingFieldDiff>();
        if (_selectedRequest == null || _originalBookingSnapshot == null) return diffs;

        var orig = _originalBookingSnapshot;
        var curr = _selectedRequest;

        if (orig.ApplicantName != curr.ApplicantName)
            diffs.Add(new BookingFieldDiff { FieldName = "Applicant Name", OldValue = orig.ApplicantName ?? "(empty)", NewValue = curr.ApplicantName ?? "(empty)" });

        if (orig.EventDate.Date != curr.EventDate.Date)
            diffs.Add(new BookingFieldDiff { FieldName = "Event Date", OldValue = orig.EventDate.ToString("MM/dd/yyyy"), NewValue = curr.EventDate.ToString("MM/dd/yyyy") });

        if ((orig.StartTime ?? "") != (curr.StartTime ?? ""))
            diffs.Add(new BookingFieldDiff { FieldName = "Start Time", OldValue = string.IsNullOrEmpty(orig.StartTime) ? "(unspecified)" : orig.StartTime, NewValue = string.IsNullOrEmpty(curr.StartTime) ? "(unspecified)" : curr.StartTime });

        if ((orig.EndTime ?? "") != (curr.EndTime ?? ""))
            diffs.Add(new BookingFieldDiff { FieldName = "End Time", OldValue = string.IsNullOrEmpty(orig.EndTime) ? "(unspecified)" : orig.EndTime, NewValue = string.IsNullOrEmpty(curr.EndTime) ? "(unspecified)" : curr.EndTime });

        if ((orig.RoomSelected ?? "") != (curr.RoomSelected ?? ""))
            diffs.Add(new BookingFieldDiff { FieldName = "Room / Space", OldValue = orig.RoomSelected ?? "Function Hall", NewValue = curr.RoomSelected ?? "Function Hall" });

        if (orig.MemberStatus != curr.MemberStatus)
            diffs.Add(new BookingFieldDiff { FieldName = "Renter Tier", OldValue = orig.MemberStatus ? "Active Member" : "Non-Member", NewValue = curr.MemberStatus ? "Active Member" : "Non-Member" });

        if (orig.TotalPrice != curr.TotalPrice)
            diffs.Add(new BookingFieldDiff { FieldName = "Total Agreed Price", OldValue = $"${orig.TotalPrice:N2}", NewValue = $"${curr.TotalPrice:N2}" });

        if (_webSettings?.RequireSecurityDeposit == true && orig.SecurityDepositAmount != curr.SecurityDepositAmount)
            diffs.Add(new BookingFieldDiff { FieldName = "Security Deposit", OldValue = $"${orig.SecurityDepositAmount:N2}", NewValue = $"${curr.SecurityDepositAmount:N2}" });

        foreach (var addon in (_webSettings?.GetAddonsList() ?? new List<RentalAddonOption>()).Where(a => a.IsActive))
        {
            var origSelected = IsAddonSelected(orig, addon);
            var currSelected = IsAddonSelected(curr, addon);
            if (origSelected != currSelected)
            {
                diffs.Add(new BookingFieldDiff { FieldName = addon.Name, OldValue = origSelected ? "Yes" : "No", NewValue = currSelected ? "Yes" : "No" });
            }
        }

        if (orig.GuestCount != curr.GuestCount)
            diffs.Add(new BookingFieldDiff { FieldName = "Guest Attendance", OldValue = orig.GuestCount.ToString(), NewValue = curr.GuestCount.ToString() });

        if ((orig.EventType ?? "") != (curr.EventType ?? ""))
            diffs.Add(new BookingFieldDiff { FieldName = "Event Type", OldValue = orig.EventType ?? "General", NewValue = curr.EventType ?? "General" });

        if ((orig.RequesterPhone ?? "") != (curr.RequesterPhone ?? ""))
            diffs.Add(new BookingFieldDiff { FieldName = "Phone", OldValue = orig.RequesterPhone ?? "(empty)", NewValue = curr.RequesterPhone ?? "(empty)" });

        if ((orig.RequesterEmail ?? "") != (curr.RequesterEmail ?? ""))
            diffs.Add(new BookingFieldDiff { FieldName = "Email", OldValue = orig.RequesterEmail ?? "(empty)", NewValue = curr.RequesterEmail ?? "(empty)" });

        if ((orig.RequesterAddress ?? "") != (curr.RequesterAddress ?? ""))
            diffs.Add(new BookingFieldDiff { FieldName = "Mailing Address", OldValue = orig.RequesterAddress ?? "(empty)", NewValue = curr.RequesterAddress ?? "(empty)" });

        if ((orig.Status ?? "") != (curr.Status ?? ""))
            diffs.Add(new BookingFieldDiff { FieldName = "Status", OldValue = orig.Status ?? "Pending", NewValue = curr.Status ?? "Pending" });

        return diffs;
    }

    private void InitiateSaveBookingChanges()
    {
        _detectedDiffs = CalculateDiffs();
        if (!_detectedDiffs.Any())
        {
            ToastService.ShowInfo("No modifications were detected.");
            _isEditingBooking = false;
            return;
        }

        _changeReasonNote = "";
        _showConfirmChangesModal = true;
    }

    private async Task CommitBookingModificationsAsync()
    {
        if (_selectedRequest == null || _selectedEvent == null) return;
        _isSavingAdjustments = true;

        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            string adminUser = authState.User.Identity?.Name ?? "Admin";

            // 1. Build timestamped audit trail log entry
            var sb = new System.Text.StringBuilder();
            sb.AppendLine($"[{DateTime.Now:yyyy-MM-dd h:mm tt} by {adminUser}]");
            foreach (var diff in _detectedDiffs)
            {
                sb.AppendLine($"• {diff.FieldName}: {diff.OldValue} ➔ {diff.NewValue}");
            }
            if (!string.IsNullOrWhiteSpace(_changeReasonNote))
            {
                sb.AppendLine($"• Reason / Note: {_changeReasonNote.Trim()}");
            }
            sb.AppendLine();

            _selectedRequest.InternalNotes = (sb.ToString() + (_selectedRequest.InternalNotes ?? "")).Trim();
            _selectedRequest.StatusChangedBy = adminUser;
            _selectedRequest.StatusChangedDate = DateTime.UtcNow;

            // 2. Persist to SQL Database
            if (_selectedRequest.Id > 0)
            {
                await RentalService.UpdateRentalRequestAsync(_selectedRequest);
            }
            else
            {
                await RentalService.CreateRentalRequestAsync(_selectedRequest);
            }

            // 3. Update Calendar Availability Schedule
            try
            {
                string availStatus = string.Equals(_selectedRequest.Status, "Cancelled", StringComparison.OrdinalIgnoreCase) ? "Available" : "Booked";
                await RentalService.UpdateCalendarAvailabilityAsync(_selectedRequest.EventDate.Date, availStatus, _selectedRequest.ApplicantName, _selectedRequest.StartTime, _selectedRequest.EndTime);
            }
            catch { }

            // 4. Update Google Calendar Event if connected and write API is enabled
            var (eventTitle, eventDescription) = FormatGoogleEventDetails(_selectedRequest, _selectedRequest.IsTestRecord);
            var googleId = _selectedEvent.GoogleEventId ?? _selectedEvent.Uid;
            if (!string.IsNullOrEmpty(googleId) && _settings.EnableWriteApi)
            {
                try
                {
                    DateTime start = _selectedRequest.EventDate.Date.AddHours(14);
                    DateTime end = _selectedRequest.EventDate.Date.AddHours(20);
                    if (DateTime.TryParse(_selectedRequest.StartTime, out var ps)) start = _selectedRequest.EventDate.Date.Add(ps.TimeOfDay);
                    if (DateTime.TryParse(_selectedRequest.EndTime, out var pe)) end = _selectedRequest.EventDate.Date.Add(pe.TimeOfDay);

                    string calTitle = eventTitle;
                    if (string.Equals(_selectedRequest.Status, "Approved", StringComparison.OrdinalIgnoreCase))
                    {
                        calTitle = calTitle.Replace("PENDING: ", "").Replace("PENDING - ", "").Trim();
                    }

                    var updatedCalItem = new CalendarEventItem
                    {
                        Uid = _selectedEvent.Uid,
                        GoogleEventId = googleId,
                        Title = calTitle,
                        Start = start,
                        End = end,
                        Location = _selectedRequest.RoomSelected ?? "Function Hall",
                        Description = eventDescription
                    };

                    await CalendarService.UpdateGoogleEventAsync(googleId, updatedCalItem, _settings);
                }
                catch (Exception gEx)
                {
                    System.Diagnostics.Debug.WriteLine($"Notice: Google Calendar sync warning during modification: {gEx.Message}");
                }
            }

            // 5. Update local in-memory event and summary
            _selectedEvent.Title = $"{(_selectedRequest.IsTestRecord ? "[TEST] " : "")}{(_selectedRequest.Status == "Approved" ? "APPROVED: " : (_selectedRequest.Status == "Cancelled" ? "CANCELLED: " : "PENDING: "))}{_selectedRequest.ApplicantName} ({_selectedRequest.EventType ?? "Rental"})";
            _selectedEvent.Location = _selectedRequest.RoomSelected ?? "Function Hall";
            _selectedEvent.Status = _selectedRequest.Status.ToUpperInvariant();
            _selectedEvent.Description = eventDescription;

            // 6. Send updated quote email if enabled
            if (_sendUpdatedQuoteEmail && !string.IsNullOrWhiteSpace(_selectedRequest.RequesterEmail))
            {
                var diffsSnapshot = _detectedDiffs.ToList();
                var noteSnapshot = _changeReasonNote?.Trim();
                _ = Task.Run(async () =>
                {
                    try
                    {
                        var settings = await WebsiteSettingsService.GetWebsiteSettingsAsync();
                        if (settings != null)
                        {
                            decimal effectiveDeposit = _selectedRequest.SecurityDepositAmount > 0 ? _selectedRequest.SecurityDepositAmount : (settings.SecurityDepositAmount ?? 200m);
                            string clubNameStr = string.IsNullOrWhiteSpace(settings.RentalFormSubtitle) ? "Gloucester Fraternity Club" : settings.RentalFormSubtitle;
                            string subject = $"Updated Hall Rental Booking Details & Quote - {clubNameStr}";
                            
                            var sb = new System.Text.StringBuilder();
                            sb.AppendLine($"<div style='font-family: Arial, sans-serif; font-size: 15px; color: #1e293b; line-height: 1.6; max-width: 650px; margin: 0 auto; padding: 20px; border: 1px solid #e2e8f0; border-radius: 8px; background: #ffffff;'>");
