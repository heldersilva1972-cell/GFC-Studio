    private async Task MarkBookingCancelledAsync()
    {
        if (_eventToCancelOrRemove == null) return;
        _isProcessingCancelOrRemove = true;

        try
        {
            var targetEvent = _eventToCancelOrRemove;

            // 1. If matching DB request exists, update status to Cancelled
            if (_selectedRequest != null)
            {
                _selectedRequest.Status = "Cancelled";
                await RentalService.UpdateRentalRequestAsync(_selectedRequest);
            }
            else
            {
                var appData = ParseApplicationDetails(targetEvent);
                var matched = _cachedRentalRequests.FirstOrDefault(r =>
                    r.EventDate.Date == targetEvent.Start.Date &&
                    (string.Equals(r.ApplicantName, appData.ApplicantName, StringComparison.OrdinalIgnoreCase) ||
                     string.Equals(r.ApplicantName, GetCleanTitle(targetEvent), StringComparison.OrdinalIgnoreCase)));

                if (matched != null)
                {
                    matched.Status = "Cancelled";
                    await RentalService.UpdateRentalRequestAsync(matched);
                }
            }

            // 2. If present in Google Calendar and write access is enabled, remove from active Google Calendar schedule
            var googleId = targetEvent.GoogleEventId ?? targetEvent.Uid;
            if (!string.IsNullOrEmpty(googleId) && _settings.EnableWriteApi)
            {
                try
                {
                    await CalendarService.DeleteGoogleEventAsync(googleId, _settings);
                }
                catch { }
            }

            // 3. Update Availability Calendar if applicable
            try
            {
                await RentalService.UpdateCalendarAvailabilityAsync(targetEvent.Start.Date, "Available");
            }
            catch { }

            ToastService.ShowSuccess("Booking status changed to Cancelled.");
            _showCancelEventConfirm = false;
            _selectedEvent = null;
            _eventToCancelOrRemove = null;
            await LoadSettingsAndEvents();
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Failed to cancel booking: {ex.Message}");
        }
        finally
        {
            _isProcessingCancelOrRemove = false;
        }
    }

    private async Task PermanentlyDeleteBookingAsync()
    {
        if (_eventToCancelOrRemove == null) return;
        _isProcessingCancelOrRemove = true;

        try
        {
            var targetEvent = _eventToCancelOrRemove;

            // 1. If matching DB request exists, permanently delete from SQL
            int requestId = _selectedRequest?.Id ?? 0;
            if (requestId == 0)
            {
                var appData = ParseApplicationDetails(targetEvent);
                var matched = _cachedRentalRequests.FirstOrDefault(r =>
                    r.EventDate.Date == targetEvent.Start.Date &&
                    (string.Equals(r.ApplicantName, appData.ApplicantName, StringComparison.OrdinalIgnoreCase) ||
                     string.Equals(r.ApplicantName, GetCleanTitle(targetEvent), StringComparison.OrdinalIgnoreCase)));
                if (matched != null) requestId = matched.Id;
            }

            if (requestId > 0)
            {
                await RentalService.DeleteRentalRequestAsync(requestId);
            }

            // 2. If present in Google Calendar, permanently delete from Google Calendar
            var googleId = targetEvent.GoogleEventId ?? targetEvent.Uid;
            if (!string.IsNullOrEmpty(googleId))
            {
                try
                {
                    await CalendarService.DeleteGoogleEventAsync(googleId, _settings);
                }
                catch { }
            }

            // 3. Update Availability Calendar if applicable
            try
            {
                await RentalService.UpdateCalendarAvailabilityAsync(targetEvent.Start.Date, "Available");
            }
            catch { }

            _events.RemoveAll(e => e.Uid == targetEvent.Uid || (!string.IsNullOrEmpty(googleId) && e.GoogleEventId == googleId));

            ToastService.ShowSuccess("Booking permanently removed from system & calendar.");
            _showCancelEventConfirm = false;
            _selectedEvent = null;
            _eventToCancelOrRemove = null;
            await LoadSettingsAndEvents();
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Failed to delete booking: {ex.Message}");
        }
        finally
        {
            _isProcessingCancelOrRemove = false;
        }
    }

    private async Task ApproveBookingAsync()
    {
        if (_selectedEvent == null) return;
        _isApprovingBooking = true;

        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            string adminUser = authState.User.Identity?.Name ?? "Admin";

            // 1. If matching DB request exists, approve it via RentalService
            int reqId = _selectedRequest?.Id ?? 0;
            if (reqId == 0)
            {
                var appData = ParseApplicationDetails(_selectedEvent);
                var matched = _cachedRentalRequests.FirstOrDefault(r =>
                    r.EventDate.Date == _selectedEvent.Start.Date &&
                    (string.Equals(r.ApplicantName, appData.ApplicantName, StringComparison.OrdinalIgnoreCase) ||
                     string.Equals(r.ApplicantName, GetCleanTitle(_selectedEvent), StringComparison.OrdinalIgnoreCase)));
                if (matched != null) reqId = matched.Id;
            }

            if (reqId > 0)
            {
                await RentalService.ApproveRentalRequestAsync(reqId, "Approved via Hall Rentals management console", adminUser);
                if (_selectedRequest != null)
                {
                    _selectedRequest.Status = "Approved";
                    _selectedRequest.ApprovedBy = adminUser;
                    _selectedRequest.ApprovalDate = DateTime.UtcNow;
                }
            }
            else
            {
                // Update local availability
                try
                {
                    await RentalService.UpdateCalendarAvailabilityAsync(_selectedEvent.Start.Date, "Booked", _selectedEvent.Title, _selectedEvent.Start.ToString("h:mm tt"), _selectedEvent.End.ToString("h:mm tt"));
                }
                catch { }
            }

            // 2. Remove "PENDING" prefix from Google Calendar event if write API is enabled
            var googleId = _selectedEvent.GoogleEventId ?? _selectedEvent.Uid;
            var cleanTitle = GetCleanTitle(_selectedEvent);
            bool isTest = _selectedRequest?.IsTestRecord == true || _selectedEvent.Title.Contains("[TEST]", StringComparison.OrdinalIgnoreCase);
            string approvedPrefix = isTest ? "[TEST] APPROVED: " : "APPROVED: ";
            string updatedTitle = $"{approvedPrefix}{cleanTitle}";

            if (!string.IsNullOrEmpty(googleId) && _settings.EnableWriteApi)
            {
                try
                {
                    var updatedEvent = new CalendarEventItem
                    {
                        Uid = _selectedEvent.Uid,
                        GoogleEventId = googleId,
                        Title = updatedTitle,
                        Start = _selectedEvent.Start,
                        End = _selectedEvent.End,
                        Location = _selectedEvent.Location,
                        Description = _selectedEvent.Description
                    };

                    await CalendarService.UpdateGoogleEventAsync(googleId, updatedEvent, _settings);
                }
                catch (Exception gEx)
                {
                    System.Diagnostics.Debug.WriteLine($"Google Calendar update on approval warning: {gEx.Message}");
                }
            }

            // 3. Update local in-memory event title and status
            _selectedEvent.Title = updatedTitle;
            _selectedEvent.Status = "APPROVED";
            _selectedEvent.ColorCategory = "badge-success";

            ToastService.ShowSuccess("Booking approved successfully! 'PENDING' removed from calendar.");
            await LoadSettingsAndEvents();
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Failed to approve booking: {ex.Message}");
        }
        finally
        {
            _isApprovingBooking = false;
        }
    }

