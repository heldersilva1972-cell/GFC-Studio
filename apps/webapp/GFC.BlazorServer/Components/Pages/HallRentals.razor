    private HallRentalRequest? FindMatchingRentalRequest(CalendarEventItem? evt)
    {
        if (evt == null) return null;
        if (evt.Description != null && (
            evt.Description.Contains("Category: Club Event", StringComparison.OrdinalIgnoreCase) || 
            evt.Description.Contains("Event Category: Club Event", StringComparison.OrdinalIgnoreCase) ||
            evt.Description.Contains("Meeting / Internal", StringComparison.OrdinalIgnoreCase) ||
            evt.Description.Contains("Category: Meeting", StringComparison.OrdinalIgnoreCase))) 
        {
            return null;
        }

        // Secondary non-rental spaces (e.g. Office) without structured application should not match rental requests
        var evtRoomNorm = NormalizeRoomName(evt.Location);
        var managedLocNorm = NormalizeRoomName(_webSettings?.ManagedRentalLocation ?? "Function Hall");
        var desc = evt.Description ?? string.Empty;
        bool hasRentalStructure = desc.Contains("Preferred Event Date:", StringComparison.OrdinalIgnoreCase) ||
                                  desc.Contains("Hall Rental Application", StringComparison.OrdinalIgnoreCase) ||
                                  desc.Contains("Full Name (Applicant):", StringComparison.OrdinalIgnoreCase);

        if (evtRoomNorm != managedLocNorm && evtRoomNorm != "entire facility" && !hasRentalStructure)
        {
            return null;
        }

        // 0. Direct match by database ID if available
        if (evt.RentalRequestId.HasValue && evt.RentalRequestId.Value > 0)
        {
            var match = _cachedRentalRequests.FirstOrDefault(r => r.Id == evt.RentalRequestId.Value);
            if (match != null) return match;
        }

        if (!string.IsNullOrWhiteSpace(evt.GoogleEventId) && evt.GoogleEventId.StartsWith("db-rental-") && int.TryParse(evt.GoogleEventId.Substring("db-rental-".Length), out int dbId))
        {
            var match = _cachedRentalRequests.FirstOrDefault(r => r.Id == dbId);
            if (match != null) return match;
        }

        var appData = ParseApplicationDetails(evt);
        var cleanTitle = GetCleanTitle(evt);

        string normTitle = cleanTitle.ToLowerInvariant().Trim();
        int pIdx = normTitle.IndexOf('(');
        if (pIdx > 0) normTitle = normTitle.Substring(0, pIdx).Trim();
        int dIdx = normTitle.IndexOf('-');
        if (dIdx > 0) normTitle = normTitle.Substring(0, dIdx).Trim();

        string normAppDataName = (appData.ApplicantName ?? "").ToLowerInvariant().Trim();
        string normEventType = (appData.EventType ?? "").ToLowerInvariant().Trim();
        string evtStartTimeStr = evt.Start.ToString("h:mm tt");

        // Candidates matching the same date
        var sameDateCandidates = _cachedRentalRequests.Where(r => r.EventDate.Date == evt.Start.Date).ToList();
        if (!sameDateCandidates.Any())
        {
            // Timezone tolerance (+/- 1 day) fallback
            sameDateCandidates = _cachedRentalRequests.Where(r => Math.Abs((r.EventDate.Date - evt.Start.Date).TotalDays) <= 1).ToList();
        }

        // 1. Primary Match: Date + Name + (Start Time OR Event Type)
        var exactMatch = sameDateCandidates.FirstOrDefault(r =>
            (!string.IsNullOrWhiteSpace(r.ApplicantName) && (
                string.Equals(r.ApplicantName, appData.ApplicantName, StringComparison.OrdinalIgnoreCase) ||
                string.Equals(r.ApplicantName, cleanTitle, StringComparison.OrdinalIgnoreCase) ||
                r.ApplicantName.ToLower().Trim() == normTitle ||
                r.ApplicantName.ToLower().Trim() == normAppDataName
            )) &&
            (
                (!string.IsNullOrWhiteSpace(normEventType) && !string.IsNullOrWhiteSpace(r.EventType) && (
                    r.EventType.ToLower().Contains(normEventType) || normEventType.Contains(r.EventType.ToLower())
                )) ||
                (!string.IsNullOrWhiteSpace(r.StartTime) && (
                    string.Equals(r.StartTime.Trim(), evtStartTimeStr, StringComparison.OrdinalIgnoreCase) ||
                    r.StartTime.Trim().Equals(evt.Start.ToString("HH:mm"), StringComparison.OrdinalIgnoreCase)
                )) ||
                cleanTitle.Contains(r.EventType ?? "___", StringComparison.OrdinalIgnoreCase)
            )
        );
        if (exactMatch != null) return exactMatch;

        // 2. Secondary Match: Match by Name and Date
        var nameMatch = sameDateCandidates.FirstOrDefault(r =>
            (!string.IsNullOrWhiteSpace(r.ApplicantName) && (
                string.Equals(r.ApplicantName, appData.ApplicantName, StringComparison.OrdinalIgnoreCase) ||
                string.Equals(r.ApplicantName, cleanTitle, StringComparison.OrdinalIgnoreCase) ||
                r.ApplicantName.ToLower().Trim() == normTitle ||
                r.ApplicantName.ToLower().Trim() == normAppDataName ||
                cleanTitle.Contains(r.ApplicantName, StringComparison.OrdinalIgnoreCase) ||
                r.ApplicantName.Contains(cleanTitle, StringComparison.OrdinalIgnoreCase)
            )) ||
            (!string.IsNullOrWhiteSpace(r.RequesterName) && (
                string.Equals(r.RequesterName, appData.ApplicantName, StringComparison.OrdinalIgnoreCase) ||
                string.Equals(r.RequesterName, cleanTitle, StringComparison.OrdinalIgnoreCase) ||
                r.RequesterName.ToLower().Trim() == normTitle
            ))
        );
        if (nameMatch != null) return nameMatch;

        // 3. Match by email or phone
        if (!string.IsNullOrWhiteSpace(appData.Email) || !string.IsNullOrWhiteSpace(appData.Phone))
        {
            var contactMatch = sameDateCandidates.FirstOrDefault(r =>
                (!string.IsNullOrWhiteSpace(appData.Email) && string.Equals(r.RequesterEmail, appData.Email, StringComparison.OrdinalIgnoreCase)) ||
                (!string.IsNullOrWhiteSpace(appData.Phone) && string.Equals(r.RequesterPhone, appData.Phone, StringComparison.OrdinalIgnoreCase))
            );
            if (contactMatch != null) return contactMatch;
        }

        // 4. Single booking on date fallback
        if (sameDateCandidates.Count == 1 && sameDateCandidates.First().EventDate.Date == evt.Start.Date)
        {
            return sameDateCandidates.First();
        }

        return null;
    }

    private PaymentSummary GetEventPaymentSummary(CalendarEventItem? evt)
    {
        var summary = new PaymentSummary();
        if (evt == null) return summary;

        var matchedReq = FindMatchingRentalRequest(evt);

        decimal totalPrice = matchedReq?.TotalPrice ?? 400m;
        bool depositEnabled = _webSettings?.RequireSecurityDeposit == true;
        decimal depositAmount = depositEnabled ? (matchedReq?.SecurityDepositAmount ?? (_webSettings?.SecurityDepositAmount ?? 200m)) : 0m;

        var payments = matchedReq != null 
            ? _allPayments.Where(p => p.HallRentalRequestId == matchedReq.Id).ToList()
            : new List<HallRentalPayment>();

        // Actual cash/check/card received (excluding waivers and refunds)
        decimal actualPaid = payments.Where(p => p.PaymentType != "Refund" && p.PaymentType != "Waived" && p.PaymentMethod != "Waived").Sum(p => p.Amount) - 
                             payments.Where(p => p.PaymentType == "Refund").Sum(p => p.Amount);

        // Amount waived (distinct from cash collected)
        decimal amountWaived = payments.Where(p => p.PaymentType == "Waived" || p.PaymentMethod == "Waived").Sum(p => p.Amount);

        // Fallback: if ledger entry was not recorded or payments list is empty but request is flagged as Waived
        if (amountWaived == 0 && matchedReq != null && (string.Equals(matchedReq.PaymentMethod, "Waived", StringComparison.OrdinalIgnoreCase) || (matchedReq.IsPaid && matchedReq.AmountPaid == 0 && totalPrice > 0)))
        {
            amountWaived = totalPrice;
        }

        // Remaining balance after accounting for waivers and actual cash paid
        decimal remainingBalance = Math.Max(0, totalPrice - amountWaived - actualPaid);

        summary.TotalPrice = totalPrice;
        summary.DepositRequired = depositAmount;
        summary.TotalPaid = Math.Max(0, actualPaid);
        summary.AmountWaived = amountWaived;
        summary.RemainingBalance = remainingBalance;

        if (remainingBalance <= 0 && totalPrice > 0)
        {
            if (amountWaived >= totalPrice && actualPaid == 0)
            {
                summary.Status = "Waived";
            }
            else if (amountWaived > 0)
            {
                summary.Status = "Paid (Waiver Applied)";
            }
            else
            {
                summary.Status = "Paid";
            }
        }
        else if (amountWaived > 0 && actualPaid == 0)
        {
            summary.Status = "Partially Waived";
        }
        else if (actualPaid > 0)
        {
            summary.Status = amountWaived > 0 ? "Partial (Waiver Applied)" : "Partial";
        }
        else if (depositEnabled && actualPaid >= depositAmount && depositAmount > 0)
        {
            summary.Status = "Deposit Paid";
        }
        else
        {
            summary.Status = "Unpaid";
        }

        return summary;
    }

    private string GetEventPaymentStatus(CalendarEventItem evt)
    {
        return GetEventPaymentSummary(evt).Status;
    }

    private int GetPaidEventsCount()
    {
        return _events.Count(e => GetEventPaymentStatus(e) == "Paid");
    }

    public class AcceptedPolicyDisplayItem
    {
        public string Title { get; set; } = string.Empty;
        public string? Tag { get; set; }
        public bool Agreed { get; set; } = true;
    }

    private List<AcceptedPolicyDisplayItem> GetAcceptedPoliciesForDisplay(HallRentalRequest? req, ParsedApplicationData appData)
    {
        var list = new List<AcceptedPolicyDisplayItem>();

        // 1. If stored in request.AgreedPoliciesJson, parse directly
        if (req != null && !string.IsNullOrWhiteSpace(req.AgreedPoliciesJson))
        {
            try
            {
                using var doc = System.Text.Json.JsonDocument.Parse(req.AgreedPoliciesJson);
                foreach (var el in doc.RootElement.EnumerateArray())
                {
                    string title = el.TryGetProperty("Title", out var tProp) ? tProp.GetString() ?? "" : "";
                    string mode = el.TryGetProperty("DisplayMode", out var mProp) ? mProp.GetString() ?? "" : "";
                    if (!string.IsNullOrWhiteSpace(title))
                    {
                        string? tag = mode == "AddonTriggered" ? "Add-on Policy" : (mode == "QuestionTriggered" ? "Setup Policy" : (mode == "GeneralRules" ? "Club Rules" : "Terms Agreement"));
                        list.Add(new AcceptedPolicyDisplayItem { Title = title, Tag = tag, Agreed = true });
                    }
                }
                if (list.Any()) return list;
            }
            catch { }
        }

        // 2. Fallback: Dynamically reconstruct all accepted policies based on request and system policy settings
        var allPolicies = _webSettings?.GetPoliciesList() ?? RentalPricingDefaults.GetDefaultPolicies();
        foreach (var policy in allPolicies)
        {
            if (string.Equals(policy.DisplayMode, "Always", StringComparison.OrdinalIgnoreCase))
            {
                list.Add(new AcceptedPolicyDisplayItem { Title = policy.Title, Tag = "Terms Agreement", Agreed = true });
            }
            else if (string.Equals(policy.DisplayMode, "QuestionTriggered", StringComparison.OrdinalIgnoreCase))
            {
                if (req?.RequiresSetupTime == true || appData.SetupTimeRequired?.ToLower().StartsWith("y") == true)
                {
                    list.Add(new AcceptedPolicyDisplayItem { Title = policy.Title, Tag = "Setup Policy", Agreed = true });
                }
            }
            else if (string.Equals(policy.DisplayMode, "AddonTriggered", StringComparison.OrdinalIgnoreCase))
            {
                bool isBar = policy.Id == "policy_bar" || policy.AssociatedAddonId == "addon_bar" || policy.Title.Contains("Bar", StringComparison.OrdinalIgnoreCase);
                bool isKitchen = policy.Id == "policy_kitchen" || policy.AssociatedAddonId == "addon_kitchen" || policy.Title.Contains("Kitchen", StringComparison.OrdinalIgnoreCase);

                if (isBar && (req?.BartenderRequested == true || appData.BarService?.ToLower().StartsWith("y") == true))
                {
                    list.Add(new AcceptedPolicyDisplayItem { Title = policy.Title, Tag = "Bar Service Policy", Agreed = true });
                }
                else if (isKitchen && (req?.KitchenUsage == true || appData.KitchenAccess?.ToLower().StartsWith("y") == true))
                {
                    list.Add(new AcceptedPolicyDisplayItem { Title = policy.Title, Tag = "Kitchen Policy", Agreed = true });
                }
            }
        }

        // Add General Rental Rules acknowledgment
        list.Add(new AcceptedPolicyDisplayItem
        {
            Title = _webSettings?.RentalFormRulesText ?? "I have read and understand all GFC rental policies",
            Tag = "Club Rules",
            Agreed = true
        });

        return list;
    }

