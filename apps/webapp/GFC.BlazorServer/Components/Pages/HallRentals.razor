        if (_commonNicknames.TryGetValue(name1, out var aliases) && aliases.Contains(name2)) return true;
        if (_commonNicknames.TryGetValue(name2, out var aliases2) && aliases2.Contains(name1)) return true;
        return false;
    }

    private static string NormalizePersonName(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return string.Empty;
        var s = name.Trim().ToLowerInvariant();

        // Strip punctuation like commas and periods (e.g. "John Smith, Jr." -> "john smith jr")
        s = Regex.Replace(s, @"[.,]", " ");

        var parts = s.Split(new[] { ' ' }, StringSplitOptions.RemoveEmptyEntries).ToList();
        
        // Remove common suffixes: jr, sr, ii, iii, iv, v, esq, md, etc.
        var suffixes = new HashSet<string>(StringComparer.OrdinalIgnoreCase) { "jr", "sr", "ii", "iii", "iv", "v", "esq", "md", "phd", "dds" };
        parts.RemoveAll(p => suffixes.Contains(p));

        // Remove single letter middle initials (e.g. "john a smith" -> "john smith")
        if (parts.Count > 2)
        {
            parts = parts.Where((p, idx) => !(idx > 0 && idx < parts.Count - 1 && p.Length == 1)).ToList();
        }

        return string.Join(" ", parts);
    }

