                    <div class="mb-3">
                        <label class="form-label small fw-bold text-dark mb-1">Message Content / Email Body</label>
                        <textarea class="form-control" rows="8" placeholder="Type your response to the visitor..." @bind="_inquiryReplyBody"></textarea>
                    </div>

                    <div class="alert alert-info py-2 px-3 small d-flex align-items-center gap-2 mb-0">
                        <i class="bi bi-info-circle-fill text-info flex-shrink-0"></i>
                        <span>This message will be emailed directly to the visitor and automatically logged to this inquiry's correspondence history.</span>
                    </div>
                </div>
                <div class="modal-footer bg-light border-top p-3 px-4 d-flex justify-content-between">
                    <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill px-3" @onclick="() => _showReplyInquiryModal = false" disabled="@_isSendingInquiryReply">
                        Cancel
                    </button>
                    <button type="button" class="btn btn-primary btn-sm rounded-pill px-4 shadow-sm fw-bold" @onclick="SendInquiryReplyAsync" disabled="@_isSendingInquiryReply">
                        @if (_isSendingInquiryReply)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                            <span>Sending Reply...</span>
                        }
                        else
                        {
                            <i class="bi bi-send-fill me-1"></i>
                            <span>Send Email Reply</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- ========================================================================= -->
<!-- CONFIRM ARCHIVE INQUIRY MODAL (WITH PHONE CALL CONFIRMATION / OVERRIDE) -->
<!-- ========================================================================= -->
@if (_showArchiveInquiryConfirmModal && _inquiryToArchive != null)
{
    var inqAppData = _selectedEvent != null ? ParseApplicationDetails(_selectedEvent) : new ParsedApplicationData();
    var inqName = !string.IsNullOrWhiteSpace(_inquiryToArchive.ApplicantName) ? _inquiryToArchive.ApplicantName : (inqAppData.ApplicantName ?? "Visitor");
    var inqPhone = !string.IsNullOrWhiteSpace(_inquiryToArchive.RequesterPhone) ? _inquiryToArchive.RequesterPhone : (inqAppData.Phone ?? "");
    var inqEmail = !string.IsNullOrWhiteSpace(_inquiryToArchive.RequesterEmail) ? _inquiryToArchive.RequesterEmail : (inqAppData.Email ?? "");
    bool isCallRequested = _inquiryToArchive.RequestPhoneCall || 
                           string.Equals(_inquiryToArchive.PreferredContactMethod, "Phone", StringComparison.OrdinalIgnoreCase) ||
                           inqAppData.RequestPhoneCall ||
                           string.Equals(inqAppData.PreferredContactMethod, "Phone", StringComparison.OrdinalIgnoreCase);
    bool hasCallBeenLogged = _inquiryToArchive.InternalNotes?.Contains("📞 Phone Call Placed", StringComparison.OrdinalIgnoreCase) == true;

    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.75); z-index: 1070;" role="dialog">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="modal-header bg-secondary text-white p-3 px-4">
                    <h5 class="modal-title fw-bold mb-0 d-flex align-items-center gap-2">
                        <i class="bi bi-archive-fill"></i>
                        <span>Confirm Archive Inquiry</span>
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => _showArchiveInquiryConfirmModal = false"></button>
                </div>
                <div class="modal-body p-4">
                    <p class="text-muted small mb-3">
                        Are you sure you want to archive this inquiry? It will be moved to the <strong>Archived FAQ Review Pool</strong>.
                    </p>

                    <div class="card border rounded-3 p-3 bg-light mb-3">
                        <div class="row g-2 small">
                            <div class="col-12 d-flex justify-content-between border-bottom pb-2">
                                <span class="text-muted">Visitor Name:</span>
                                <span class="fw-bold text-dark">@inqName</span>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(inqPhone))
                            {
                                <div class="col-12 d-flex justify-content-between border-bottom pb-2">
                                    <span class="text-muted">Contact Phone:</span>
                                    <span class="fw-bold text-dark">@FormatPhoneNumber(inqPhone)</span>
                                </div>
                            }
                            @if (!string.IsNullOrWhiteSpace(inqEmail))
                            {
                                <div class="col-12 d-flex justify-content-between border-bottom pb-2">
                                    <span class="text-muted">Email Address:</span>
                                    <span class="fw-bold text-dark">@inqEmail</span>
                                </div>
                            }
                            <div class="col-12 d-flex justify-content-between">
                                <span class="text-muted">Preferred Contact:</span>
                                <span class="badge @(isCallRequested ? "bg-success text-white" : "bg-primary-subtle text-primary border border-primary-subtle")">
                                    <i class="bi @(isCallRequested ? "bi-telephone-inbound-fill" : "bi-envelope-fill") me-1"></i>
                                    @(isCallRequested ? "Phone Call Requested" : "Email")
                                </span>
                            </div>
                        </div>
                    </div>

                    @if (isCallRequested)
                    {
                        if (hasCallBeenLogged)
                        {
                            <div class="alert alert-success d-flex align-items-center gap-2 py-2 px-3 small rounded-3 mb-3 border-success">
                                <i class="bi bi-check-circle-fill fs-5 text-success flex-shrink-0"></i>
                                <div>
                                    <strong class="text-success-emphasis d-block">Phone Call Confirmed &amp; Logged</strong>
                                    <span class="text-dark">A follow-up phone call has already been recorded for this inquiry.</span>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-warning border border-warning shadow-sm rounded-3 p-3 mb-3">
                                <div class="d-flex align-items-start gap-2">
                                    <i class="bi bi-exclamation-triangle-fill fs-4 text-warning-emphasis flex-shrink-0 mt-0.5"></i>
                                    <div>
                                        <strong class="text-dark d-block fs-6">Phone Call Requested by Visitor</strong>
                                        <div class="small text-muted mt-1 mb-2">
                                            This visitor requested a phone call. Please confirm that a phone call was placed before archiving, or check the confirmation box below to log it now.
                                        </div>
                                        <div class="form-check p-2 bg-white rounded border border-warning-subtle">
                                            <input class="form-check-input ms-0 me-2" type="checkbox" id="archiveCallPlacedChk" @bind="_confirmPhoneCallPlacedBeforeArchive" />
                                            <label class="form-check-label small fw-bold text-dark" for="archiveCallPlacedChk">
                                                <i class="bi bi-telephone-check-fill text-success me-1"></i>Yes, confirm that a phone call was placed to this visitor.
                                            </label>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    }

                    <div class="mb-3">
                        <label class="form-label small fw-bold text-dark mb-1">
                            Optional Archival Note / Memo <span class="text-muted font-normal">(Recorded to Audit History)</span>:
                        </label>
                        <input type="text" class="form-control form-control-sm" placeholder="e.g. Discussed hall rental over phone; applicant will book online" @bind="_archiveInquiryNote" />
                    </div>
                </div>
                <div class="modal-footer bg-light border-top p-3 px-4 d-flex justify-content-between">
                    <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill px-3" @onclick="() => _showArchiveInquiryConfirmModal = false" disabled="@_isArchivingInquiry">
                        Cancel
                    </button>
                    @{
                        bool isArchiveBlocked = isCallRequested && !hasCallBeenLogged && !_confirmPhoneCallPlacedBeforeArchive;
                    }
                    <button type="button" class="btn btn-secondary btn-sm rounded-pill px-4 shadow-sm fw-bold" @onclick="ConfirmAndArchiveInquiryAsync" disabled="@(_isArchivingInquiry || isArchiveBlocked)">
                        @if (_isArchivingInquiry)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                            <span>Archiving...</span>
                        }
                        else
                        {
                            <i class="bi bi-archive-fill me-1"></i>
                            <span>Confirm &amp; Archive</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- PROFESSIONAL 1-PAGE PRINTABLE APPLICATION TEMPLATE (PRINT / SAVE TO PDF) -->
@if (_selectedEvent != null)
{
    var printAppDetails = ParseApplicationDetails(_selectedEvent);
    var printCleanTitle = GetCleanTitle(_selectedEvent);
    var printPaySummary = GetEventPaymentSummary(_selectedEvent);
    var printAgreedPolicies = GetAcceptedPoliciesForDisplay(_selectedRequest, printAppDetails);

    string printName = !string.IsNullOrWhiteSpace(_selectedRequest?.ApplicantName)
        ? _selectedRequest.ApplicantName
        : (!string.IsNullOrWhiteSpace(printAppDetails.ApplicantName) ? printAppDetails.ApplicantName : printCleanTitle);

    string printPhone = !string.IsNullOrWhiteSpace(_selectedRequest?.RequesterPhone)
        ? _selectedRequest.RequesterPhone
        : (printAppDetails.Phone ?? "N/A");

    string printEmail = !string.IsNullOrWhiteSpace(_selectedRequest?.RequesterEmail)
        ? _selectedRequest.RequesterEmail
        : (printAppDetails.Email ?? "N/A");

    string printAddress = !string.IsNullOrWhiteSpace(_selectedRequest?.RequesterAddress)
        ? $"{_selectedRequest.RequesterAddress}{(!string.IsNullOrWhiteSpace(_selectedRequest.RequesterCity) ? $", {_selectedRequest.RequesterCity}" : "")}{(!string.IsNullOrWhiteSpace(_selectedRequest.RequesterState) ? $", {_selectedRequest.RequesterState}" : "")}{(!string.IsNullOrWhiteSpace(_selectedRequest.RequesterZip) ? $" {_selectedRequest.RequesterZip}" : "")}"
        : (!string.IsNullOrWhiteSpace(printAppDetails.StreetAddress)
            ? $"{printAppDetails.StreetAddress}{(string.IsNullOrWhiteSpace(printAppDetails.City) ? "" : $", {printAppDetails.City}")}{(string.IsNullOrWhiteSpace(printAppDetails.State) ? "" : $", {printAppDetails.State}")}{(string.IsNullOrWhiteSpace(printAppDetails.Zip) ? "" : $" {printAppDetails.Zip}")}"
            : "None Provided");

    string printSignature = !string.IsNullOrWhiteSpace(_selectedRequest?.ApplicantSignature)
        ? _selectedRequest.ApplicantSignature
        : (!string.IsNullOrWhiteSpace(printAppDetails.ApplicantSignature) ? printAppDetails.ApplicantSignature : "Electronic Signature on Record");

    string printTimestamp = _selectedRequest != null && _selectedRequest.CreatedDate.Year > 2000
        ? _selectedRequest.CreatedDate.ToLocalTime().ToString("MMMM dd, yyyy 'at' h:mm tt")
        : (!string.IsNullOrEmpty(printAppDetails.FormattedTimestamp) ? printAppDetails.FormattedTimestamp : DateTime.Now.ToString("MMMM dd, yyyy 'at' h:mm tt"));

    string printEventDate = _selectedRequest != null && _selectedRequest.EventDate.Year > 2000
        ? _selectedRequest.EventDate.ToString("dddd, MMMM dd, yyyy")
        : (_selectedEvent.Start.Year > 2000 ? _selectedEvent.Start.ToString("dddd, MMMM dd, yyyy") : (printAppDetails.PreferredEventDate ?? "TBD"));

    string printTimeRange = (_selectedRequest != null && !string.IsNullOrEmpty(_selectedRequest.StartTime) && !string.IsNullOrEmpty(_selectedRequest.EndTime))
        ? $"{_selectedRequest.StartTime} - {_selectedRequest.EndTime}"
        : ((!string.IsNullOrEmpty(printAppDetails.StartTime) && !string.IsNullOrEmpty(printAppDetails.EndTime)) ? $"{printAppDetails.StartTime} - {printAppDetails.EndTime}" : "TBD");

    string statusClass = (_selectedRequest?.Status == "Approved" || _selectedEvent.Title.Contains("APPROVED", StringComparison.OrdinalIgnoreCase)) ? "status-approved" : "status-pending";
    string statusText = (_selectedRequest?.Status ?? (_selectedEvent.Title.Contains("APPROVED", StringComparison.OrdinalIgnoreCase) ? "Approved" : "Pending Review")).ToUpper();

    <div id="gfc-printable-application" class="d-none d-print-block print-container">
        <!-- 1. Executive Header -->
        <div class="print-brand-header">
            <div class="print-brand-left">
                <h1 class="print-org-name">GLOUCESTER FRATERNITY CLUB</h1>
                <div class="print-org-sub">27 Webster Street, Gloucester, MA 01930 &bull; (978) 283-2889 &bull; info@gloucesterfraternityclub.com</div>
            </div>
            <div class="print-brand-right">
                <div class="print-badge @statusClass">@statusText</div>
                <div class="print-meta-date">Printed: @DateTime.Now.ToString("MMM dd, yyyy")</div>
            </div>
        </div>

        <div class="print-doc-title-bar">
            <span>HALL RENTAL APPLICATION &amp; AGREEMENT RECORD</span>
            <span class="print-ref-id">Ref #@((_selectedRequest?.Id > 0) ? _selectedRequest.Id.ToString() : "REC-" + _selectedEvent.Start.ToString("yyyyMMdd"))</span>
        </div>

        <!-- 2. Two-Column Information Layout -->
        <div class="print-grid-2col">
            <!-- Left Column: Applicant & Event Details -->
            <div class="print-col">
                <div class="print-card">
                    <div class="print-card-header">
                        <span class="print-card-title">1. APPLICANT &amp; CONTACT DETAILS</span>
                    </div>
                    <div class="print-card-body">
                        <div class="print-field-row">
                            <span class="print-lbl">Applicant / Org:</span>
                            <span class="print-val fw-bold">@printName</span>
                        </div>
                        <div class="print-field-row">
                            <span class="print-lbl">Membership:</span>
                            <span class="print-val">@(_selectedRequest?.MemberStatus == true ? "Active Member" : "Non-Member")</span>
                        </div>
                        <div class="print-field-row">
                            <span class="print-lbl">Contact Phone:</span>
                            <span class="print-val">@printPhone</span>
                        </div>
                        <div class="print-field-row">
                            <span class="print-lbl">Email Address:</span>
                            <span class="print-val">@printEmail</span>
                        </div>
                        <div class="print-field-row">
                            <span class="print-lbl">Mailing Address:</span>
                            <span class="print-val">@printAddress</span>
                        </div>
                    </div>
                </div>

                <div class="print-card mt-2">
                    <div class="print-card-header">
                        <span class="print-card-title">2. EVENT SPECIFICATIONS</span>
                    </div>
                    <div class="print-card-body">
                        <div class="print-field-row">
                            <span class="print-lbl">Event Date:</span>
                            <span class="print-val fw-bold">@printEventDate</span>
                        </div>
                        <div class="print-field-row">
                            <span class="print-lbl">Time Range:</span>
                            <span class="print-val">@printTimeRange</span>
                        </div>
                        <div class="print-field-row">
                            <span class="print-lbl">Facility Room:</span>
                            <span class="print-val fw-bold">@(_selectedRequest?.RoomSelected ?? _selectedEvent.Location ?? "Function Hall")</span>
                        </div>
                        <div class="print-field-row">
                            <span class="print-lbl">Event Occasion:</span>
                            <span class="print-val">@(_selectedRequest?.EventType ?? printAppDetails.EventType ?? "General Rental")</span>
                        </div>
                        <div class="print-field-row">
                            <span class="print-lbl">Guest Attendance:</span>
                            <span class="print-val">@(_selectedRequest?.GuestCount > 0 ? _selectedRequest.GuestCount.ToString() : (printAppDetails.GuestCount ?? "Unspecified")) guests</span>
                        </div>
                        <div class="print-field-row">
                            <span class="print-lbl">Setup Time:</span>
                            <span class="print-val">@(_selectedRequest?.RequiresSetupTime == true ? "Yes (Requested)" : (printAppDetails.SetupTimeRequired ?? "No"))</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right Column: Services & Financial Breakdown -->
            <div class="print-col">
                <div class="print-card">
                    <div class="print-card-header">
                        <span class="print-card-title">3. AMENITIES &amp; SERVICES</span>
                    </div>
                    <div class="print-card-body">
                        <div class="print-service-grid">
                            @{
                                var activePrintAddons = (_webSettings?.GetAddonsList() ?? new List<RentalAddonOption>()).Where(a => a.IsActive).ToList();
                            }
                            @foreach (var addon in activePrintAddons)
                            {
                                var isSelected = IsAddonSelected(_selectedRequest, addon);
                                <div class="print-service-item @(isSelected ? "active" : "")">
                                    <span class="print-svc-icon">@(isSelected ? "☑" : "☐")</span>
                                    <span class="print-svc-name">@addon.Name</span>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <div class="print-card mt-2">
                    <div class="print-card-header">
                        <span class="print-card-title">4. FINANCIAL SUMMARY &amp; PAYMENTS</span>
                    </div>
                    <div class="print-card-body p-0">
                        <div class="print-ledger-tiles">
                            <div class="print-tile">
                                <span class="print-tile-lbl">Total Quoted</span>
                                <span class="print-tile-val fw-bold">$@printPaySummary.TotalPrice.ToString("N2")</span>
                            </div>
                            @if (_webSettings?.RequireSecurityDeposit == true)
                            {
                                <div class="print-tile">
                                    <span class="print-tile-lbl">Security Deposit</span>
                                    <span class="print-tile-val">$@printPaySummary.DepositRequired.ToString("N2")</span>
                                </div>
                            }
                            <div class="print-tile highlight-green">
                                <span class="print-tile-lbl">Total Paid</span>
                                <span class="print-tile-val">$@printPaySummary.TotalPaid.ToString("N2")</span>
                            </div>
                            <div class="print-tile @(printPaySummary.RemainingBalance > 0 ? "highlight-red" : "highlight-green")">
                                <span class="print-tile-lbl">Balance Due</span>
                                <span class="print-tile-val fw-bold">$@printPaySummary.RemainingBalance.ToString("N2")</span>
                            </div>
                        </div>

                        @if (_selectedPayments.Any())
                        {
                            <div class="print-pay-history">
                                <div class="print-subhead">Recorded Payments &amp; Deposits</div>
                                <table class="print-mini-table">
                                    <thead>
                                        <tr>
                                            <th>Date</th>
                                            <th>Type</th>
                                            <th>Method / Ref</th>
                                            <th class="text-end">Amount</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var p in _selectedPayments.Take(3))
                                        {
                                            <tr>
                                                <td>@p.PaymentDate.ToString("MM/dd/yy")</td>
                                                <td>@p.PaymentType</td>
                                                <td>@p.PaymentMethod @(!string.IsNullOrEmpty(p.ReferenceOrCheckNumber) ? $"({p.ReferenceOrCheckNumber})" : "")</td>
                                                <td class="text-end fw-bold">@(p.PaymentType == "Refund" ? "-" : "")$@p.Amount.ToString("N2")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- 3. Accepted Agreements & Policies (Clean flexible list with full text visibility) -->
        <div class="print-card mt-2">
            <div class="print-card-header">
                <span class="print-card-title">5. ACKNOWLEDGED POLICIES &amp; ACCEPTED TERMS (@printAgreedPolicies.Count)</span>
            </div>
            <div class="print-card-body p-2">
                <div class="print-policies-grid">
                    @foreach (var pol in printAgreedPolicies)
                    {
                        <div class="print-policy-pill">
                            <span class="print-check-mark">✓</span>
                            <div class="print-pol-content">
                                <span class="print-pol-title">@pol.Title</span>
                                @if (!string.IsNullOrEmpty(pol.Tag))
                                {
                                    <span class="print-pol-tag">@pol.Tag</span>
                                }
                            </div>
                            <span class="print-pol-accepted">ACCEPTED</span>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- 4. Electronic Signature & Legal Execution Box -->
        <div class="print-card mt-2 print-signature-card">
            <div class="print-sig-row">
                <div class="print-sig-block">
                    <div class="print-sig-lbl">Applicant Electronic Signature (Legal Acceptance):</div>
                    <div class="print-sig-val">@printSignature</div>
                </div>
                <div class="print-sig-block">
                    <div class="print-sig-lbl">Submission Timestamp:</div>
                    <div class="print-sig-ts">@printTimestamp</div>
                </div>
            </div>
            <div class="print-legal-notice">
                By electronically signing, the applicant affirms they are 21+ years of age and agrees to all Gloucester Fraternity Club bylaws, hall rental rules, kitchen policies, and payment terms.
            </div>
        </div>
    </div>
}



<!-- ADD / EDIT GOOGLE CALENDAR EVENT MODAL (CLUB EVENTS, RENTALS, RECURRENCE & CONFLICT DETECTION) -->
@if (_showEditEventModal)
{
    var conflicts = GetBookingConflicts();
    var plannedDates = GetPlannedDatesList();

    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.75); z-index: 1055;" role="dialog">
        <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable" style="max-width: 960px;" role="document">
            <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
                <!-- Modal Header with Event Type Switcher -->
                <div class="modal-header bg-light border-bottom p-3 px-4">
                    @{
                        var primaryLocName = _webSettings?.ManagedRentalLocation ?? "Function Hall";
                        var secondaryLocName = _webSettings?.SecondaryFlexibleLocation ?? "Office";
                        var currentLocNorm = NormalizeRoomName(_editEventModel.Location);
                        var isManagedSpace = currentLocNorm == NormalizeRoomName(primaryLocName) || currentLocNorm == "entire facility";
                        
                        string eventCategoryLabel = isManagedSpace ? "Club Event" : $"{secondaryLocName} / Internal";
                        string modalTitle = _isNewEvent
                            ? (_bookingCategory == "club" ? (isManagedSpace ? "Add Club / Internal Event" : $"Add {secondaryLocName} Schedule / Meeting") : "Add Hall Rental Booking")
                            : "Edit Event / Booking";
                    }
                    <div class="d-flex align-items-center gap-3 flex-wrap">
                        <div class="p-2 rounded-circle @(_bookingCategory == "club" ? (isManagedSpace ? "bg-primary-subtle text-primary" : "bg-info-subtle text-info") : "bg-success-subtle text-success")">
                            <i class="bi @(_bookingCategory == "club" ? (isManagedSpace ? "bi-building-fill-gear" : "bi-door-open-fill") : "bi-calendar-plus") fs-4"></i>
                        </div>
                        <div>
                            <h5 class="modal-title fw-bold mb-0">@modalTitle</h5>
                            <small class="text-muted">Direct synchronization with connected calendars</small>
                        </div>
                    </div>

                    @if (_isNewEvent)
                    {
                        <!-- Event Category Switcher -->
                        <div class="btn-group btn-group-sm ms-auto me-2 shadow-sm" role="group">
                            <button type="button" class="btn @(_bookingCategory == "club" ? (isManagedSpace ? "btn-primary fw-bold" : "btn-info text-white fw-bold") : "btn-outline-secondary") px-3" @onclick='() => SetBookingCategory("club")'>
                                <i class="bi @(isManagedSpace ? "bi-shield-shaded" : "bi-door-open") me-1"></i>@eventCategoryLabel
                            </button>
                            <button type="button" class="btn @(_bookingCategory == "rental" ? "btn-success fw-bold text-white" : "btn-outline-secondary") px-3" @onclick='() => SetBookingCategory("rental")'>
                                <i class="bi bi-people-fill me-1"></i>Hall Rental
                            </button>
                        </div>
                    }

                    <div class="d-flex align-items-center gap-2 @(_isNewEvent ? "" : "ms-auto")">
                        <button type="button" class="btn btn-sm btn-outline-primary shadow-sm d-flex align-items-center gap-1" @onclick="SwitchToCalendarFromBookingModal" title="View Full Calendar Grid">
                            <i class="bi bi-calendar3"></i>
                            <span class="fw-semibold">View Calendar</span>
                        </button>
                        <button type="button" class="btn-close" @onclick="() => _showEditEventModal = false"></button>
                    </div>
                </div>

                <div class="modal-body p-4">
                    <!-- CLUB EVENT VS RENTAL FORM CONTROLS -->
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label fw-semibold small text-dark mb-1">
                                Event Title <span class="text-danger">*</span>
                            </label>
                            <input type="text" class="form-control" placeholder="@(_bookingCategory == "club" ? (isManagedSpace ? "e.g. Board of Directors Meeting, BINGO Night, Member Dinner, Cornhole League" : $"e.g. {secondaryLocName} Meeting, Committee Session, Review") : "e.g. Birthday Party, Wedding Reception, Family Gathering")" @bind="_editEventModel.Title" />
                        </div>

                        @if (_bookingCategory == "rental")
                        {
                            <!-- Contact details associated with the event -->
                            <div class="col-md-4">
                                <label class="form-label fw-semibold small text-dark mb-1">Contact / Applicant Name</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light text-muted"><i class="bi bi-person"></i></span>
                                    <input type="text" class="form-control" placeholder="e.g. Jane Doe" @bind="_editApplicantName" />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-semibold small text-dark mb-1">Email Address</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light text-muted"><i class="bi bi-envelope"></i></span>
                                    <input type="email" class="form-control" placeholder="e.g. jane@example.com" @bind="_editApplicantEmail" />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-semibold small text-dark mb-1">Phone Number</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light text-muted"><i class="bi bi-telephone"></i></span>
                                    <input type="tel" class="form-control" placeholder="e.g. (555) 123-4567" @bind="_editApplicantPhone" />
                                </div>
                            </div>
                        }

                        <!-- RECURRENCE & MULTI-DATE SELECTOR (Available on New Events) -->
                        @if (_isNewEvent)
                        {
                            <div class="col-12">
                                <div class="card bg-light border rounded-3 p-3">
                                    <div class="d-flex justify-content-between align-items-center mb-2 flex-wrap gap-2">
                                        <label class="form-label fw-bold small text-dark mb-0">
                                            <i class="bi bi-arrow-repeat text-primary me-1"></i>Schedule &amp; Recurrence Mode:
                                        </label>
                                        <div class="btn-group btn-group-sm" role="group">
                                            <button type="button" class="btn @(_recurrenceMode == "single" ? "btn-dark fw-bold" : "btn-outline-secondary")" @onclick='() => SetRecurrenceMode("single")'>
                                                Single Date
                                            </button>
                                            <button type="button" class="btn @(_recurrenceMode == "weekly" ? "btn-primary fw-bold text-white" : "btn-outline-secondary")" @onclick='() => SetRecurrenceMode("weekly")'>
                                                Weekly Recurring
                                            </button>
                                            <button type="button" class="btn @(_recurrenceMode == "custom" ? "btn-primary fw-bold text-white" : "btn-outline-secondary")" @onclick='() => SetRecurrenceMode("custom")'>
                                                Multiple Specific Dates
                                            </button>
                                        </div>
                                    </div>

                                    @if (_recurrenceMode == "single")
                                    {
                                        <div class="row g-3 align-items-center">
                                            <div class="col-md-4">
                                                <label class="form-label small fw-semibold text-muted mb-1">Event Date</label>
                                                <input type="date" class="form-control" value="@_singleEventDate.ToString("yyyy-MM-dd")" @oninput="OnSingleDateInput" @onchange="OnSingleDateChanged" />
                                            </div>
                                            <div class="col-md-4">
                                                <label class="form-label small fw-semibold text-muted mb-1">Start Time</label>
                                                <select class="form-select shadow-none" value="@_singleStartTime" @onchange="OnStartTimeChanged">
                                                    <option value="">-- Select Start Time --</option>
                                                    @foreach (var opt in _timeSlotOptions)
                                                    {
                                                        <option value="@opt.Value">@opt.Label</option>
                                                    }
                                                </select>
                                            </div>
                                            <div class="col-md-4">
                                                <label class="form-label small fw-semibold text-muted mb-1">End Time</label>
                                                <select class="form-select shadow-none" value="@_singleEndTime" @onchange="OnEndTimeChanged">
                                                    <option value="">-- Select End Time --</option>
                                                    @foreach (var opt in _timeSlotOptions)
                                                    {
                                                        <option value="@opt.Value">@opt.Label</option>
                                                    }
                                                </select>
                                            </div>
                                        </div>
                                    }
                                    else if (_recurrenceMode == "weekly")
                                    {
                                        <div class="row g-3">
                                            <div class="col-md-3">
                                                <label class="form-label small fw-semibold text-muted mb-1">Start Date</label>
                                                <input type="date" class="form-control" value="@_singleEventDate.ToString("yyyy-MM-dd")" @oninput="OnSingleDateInput" @onchange="OnSingleDateChanged" />
                                            </div>
                                            <div class="col-md-3">
                                                <label class="form-label small fw-semibold text-muted mb-1">End Recurrence By</label>
                                                <input type="date" class="form-control" value="@_weeklyEndDate.ToString("yyyy-MM-dd")" @oninput="OnWeeklyEndDateInput" @onchange="OnWeeklyEndDateChanged" />
                                            </div>
                                            <div class="col-md-3">
                                                <label class="form-label small fw-semibold text-muted mb-1">Start Time</label>
                                                <select class="form-select shadow-none" value="@_singleStartTime" @onchange="OnStartTimeChanged">
                                                    <option value="">-- Select Start Time --</option>
                                                    @foreach (var opt in _timeSlotOptions)
                                                    {
                                                        <option value="@opt.Value">@opt.Label</option>
                                                    }
                                                </select>
                                            </div>
                                            <div class="col-md-3">
                                                <label class="form-label small fw-semibold text-muted mb-1">End Time</label>
                                                <select class="form-select shadow-none" value="@_singleEndTime" @onchange="OnEndTimeChanged">
                                                    <option value="">-- Select End Time --</option>
                                                    @foreach (var opt in _timeSlotOptions)
                                                    {
                                                        <option value="@opt.Value">@opt.Label</option>
                                                    }
                                                </select>
                                            </div>
                                            <div class="col-12 mt-2">
                                                <label class="form-label small fw-semibold text-muted mb-1 d-block">Repeat on Days of the Week:</label>
                                                <div class="btn-group w-100 shadow-none border rounded" role="group">
                                                    @foreach (var day in Enum.GetValues<DayOfWeek>())
                                                    {
                                                        bool isDaySelected = _weeklySelectedDays.Contains(day);
                                                        <button type="button" class="btn py-2 @(isDaySelected ? "btn-primary fw-bold" : "btn-light text-dark")" @onclick="() => ToggleWeeklyDay(day)">
                                                            @(day.ToString().Substring(0, 3))
                                                        </button>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                        <div class="mt-2 text-primary small fw-semibold">
                                            <i class="bi bi-info-circle me-1"></i>Generates <strong>@plannedDates.Count</strong> recurring event occurrences between @_singleEventDate.ToString("MMM dd, yyyy") and @_weeklyEndDate.ToString("MMM dd, yyyy").
                                        </div>
                                    }
                                    else if (_recurrenceMode == "custom")
                                    {
                                        <div class="row g-3 align-items-end mb-2">
                                            <div class="col-md-4">
                                                <label class="form-label small fw-semibold text-muted mb-1">Add Another Date</label>
                                                <input type="date" class="form-control" value="@_customDateToAdd.ToString("yyyy-MM-dd")" @oninput="OnCustomDateToAddInput" @onchange="OnCustomDateToAddInput" />
                                            </div>
                                            <div class="col-md-2">
                                                <button type="button" class="btn btn-primary w-100 fw-semibold shadow-sm" @onclick="AddCustomDate">
                                                    <i class="bi bi-plus-lg me-1"></i>Add
                                                </button>
                                            </div>
                                            <div class="col-md-3">
                                                <label class="form-label small fw-semibold text-muted mb-1">Start Time</label>
                                                <select class="form-select shadow-none" value="@_singleStartTime" @onchange="OnStartTimeChanged">
                                                    <option value="">-- Select Start Time --</option>
                                                    @foreach (var opt in _timeSlotOptions)
                                                    {
                                                        <option value="@opt.Value">@opt.Label</option>
                                                    }
                                                </select>
                                            </div>
                                            <div class="col-md-3">
                                                <label class="form-label small fw-semibold text-muted mb-1">End Time</label>
                                                <select class="form-select shadow-none" value="@_singleEndTime" @onchange="OnEndTimeChanged">
                                                    <option value="">-- Select End Time --</option>
                                                    @foreach (var opt in _timeSlotOptions)
                                                    {
                                                        <option value="@opt.Value">@opt.Label</option>
                                                    }
                                                </select>
                                            </div>
                                        </div>
                                        @if (!string.IsNullOrEmpty(_customDateAddError))
                                        {
                                            <div class="alert alert-warning py-1.5 px-3 mb-2 small rounded-3 d-flex align-items-center gap-2">
                                                <i class="bi bi-exclamation-triangle-fill text-warning"></i>
                                                <span>@_customDateAddError</span>
                                            </div>
                                        }
                                        <div class="d-flex gap-1.5 flex-wrap mt-2 p-2 bg-white rounded border">
                                            @if (!_customDatesList.Any())
                                            {
                                                <span class="text-muted small">No dates added yet. Pick a date above and click the <strong>Add</strong> button.</span>
                                            }
                                            @foreach (var dt in _customDatesList.OrderBy(d => d))
                                            {
                                                var hasCustomTime = !string.IsNullOrWhiteSpace(_singleStartTime) && !string.IsNullOrWhiteSpace(_singleEndTime);
                                                var stTs = hasCustomTime ? ParseFlexibleTimeSpan(_singleStartTime, TimeSpan.Zero) : TimeSpan.Zero;
                                                var etTs = hasCustomTime ? ParseFlexibleTimeSpan(_singleEndTime, TimeSpan.Zero) : TimeSpan.Zero;
                                                if (hasCustomTime && etTs <= stTs) etTs = stTs.Add(TimeSpan.FromHours(3));

                                                <span class="badge bg-light text-dark border px-2.5 py-1.5 shadow-sm d-flex align-items-center gap-1.5" style="cursor: pointer;" @onclick="() => SelectCustomDateBadge(dt)" title="Click to view availability for this date">
                                                    <i class="bi bi-calendar-check text-primary"></i>
                                                    <span class="fw-bold">@dt.ToString("ddd, MMM dd, yyyy")</span>
                                                    @if (hasCustomTime)
                                                    {
                                                        <span class="badge bg-secondary bg-opacity-10 text-secondary border fw-normal" style="font-size: 0.72rem;">@FormatTimeSpan(stTs) – @FormatTimeSpan(etTs)</span>
                                                    }
                                                    <i class="bi bi-x text-danger cursor-pointer fs-6 ms-1" style="cursor: pointer;" title="Remove this date" @onclick:stopPropagation="true" @onclick="() => RemoveCustomDate(dt)"></i>
                                                </span>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                        else
                        {
                            <!-- Single event editing start/end controls -->
                            <div class="col-md-6">
                                <label class="form-label fw-semibold small">Start Date &amp; Time <span class="text-danger">*</span></label>
                                <input type="date" class="form-control shadow-none mb-2" value="@_editEventDate.ToString("yyyy-MM-dd")" @onchange="OnEditEventDateChanged" />
                                <label class="form-label fw-semibold small">Start Time <span class="text-danger">*</span></label>
                                <select class="form-select shadow-none" value="@_editEventStartTime" @onchange="OnEditEventStartTimeChanged">
                                    <option value="">-- Select Start Time --</option>
                                    @foreach (var opt in _timeSlotOptions)
                                    {
                                        <option value="@opt.Value">@opt.Label</option>
                                    }
                                </select>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-semibold small">End Date &amp; Time <span class="text-danger">*</span></label>
                                <input type="date" class="form-control shadow-none mb-2" value="@_editEventEndDate.ToString("yyyy-MM-dd")" @onchange="OnEditEventEndDateChanged" />
                                <label class="form-label fw-semibold small">End Time <span class="text-danger">*</span></label>
                                <select class="form-select shadow-none" value="@_editEventEndTime" @onchange="OnEditEventEndTimeChanged">
                                    <option value="">-- Select End Time --</option>
                                    @foreach (var opt in _timeSlotOptions)
                                    {
                                        <option value="@opt.Value">@opt.Label</option>
                                    }
                                </select>
                            </div>
                        }

                        <div class="col-md-6">
                            <label class="form-label fw-semibold small">Location <span class="text-danger">*</span></label>
                            <select class="form-select fw-semibold" value="@_editEventModel.Location" @onchange="OnLocationChanged">
                                <option value="@primaryLocName">@primaryLocName (Rental Facility)</option>
                                <option value="@secondaryLocName">@secondaryLocName (Meeting / Internal Space)</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold small text-muted">Calendar Destination</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-primary border-end-0">
                                    <i class="bi bi-calendar-check"></i>
                                </span>
                                <input type="text" class="form-control bg-light text-dark fw-medium border-start-0 shadow-none" value="@(!string.IsNullOrWhiteSpace(_editEventTargetFeed) ? _editEventTargetFeed : (_settings.Feeds.FirstOrDefault(f => f.IsEnabled)?.Name ?? _settings.CalendarName ?? "Primary Calendar"))" readonly />
                            </div>
                            <div class="form-text text-muted" style="font-size: 0.75rem;">
                                Synchronizes automatically with the active primary schedule.
                            </div>
                        </div>

                        @{
                            var inspectDate = _isNewEvent ? (_recurrenceMode == "custom" ? _customDateToAdd : _singleEventDate) : _editEventDate;
                            var activeStartTime = _isNewEvent ? _singleStartTime : _editEventStartTime;
                            var activeEndTime = _isNewEvent ? _singleEndTime : _editEventEndTime;
                            var hasSelectedTime = !string.IsNullOrWhiteSpace(activeStartTime) && !string.IsNullOrWhiteSpace(activeEndTime);
                            var curStartTs = hasSelectedTime ? ParseFlexibleTimeSpan(activeStartTime, TimeSpan.Zero) : TimeSpan.Zero;
                            var curEndTs = hasSelectedTime ? ParseFlexibleTimeSpan(activeEndTime, TimeSpan.Zero) : TimeSpan.Zero;
                            if (hasSelectedTime && curEndTs <= curStartTs) curEndTs = curStartTs.Add(TimeSpan.FromHours(3));

                            var timelineSegments = GetTimelineForDate(inspectDate, _editEventModel.Location ?? "Function Hall", curStartTs, curEndTs);
                            var dayBookingsOnDate = GetBookingsForDate(inspectDate, _editEventModel.Location ?? "Function Hall");
                            var directConflictsOnDate = hasSelectedTime ? GetConflictsForDateAndTimes(inspectDate, activeStartTime, activeEndTime, _editEventModel.Location ?? "Function Hall") : new List<CalendarEventItem>();
                            
                            var daySchedules = _webSettings?.GetDaySchedulesList() ?? WebsiteSettings.GetDefaultDaySchedules();
                            var dayConfig = daySchedules.FirstOrDefault(s => (int)s.DayOfWeek == (int)inspectDate.DayOfWeek || (int)s.Day == (int)inspectDate.DayOfWeek);
                            var availableSlotsOnDay = (dayConfig != null && dayConfig.IsAvailable && dayConfig.Slots != null)
                                ? dayConfig.Slots.Where(s => s.IsActive).ToList()
                                : new List<DayScheduleSlotConfig>();
                        }

                        <!-- VISUAL SCHEDULE TIMELINE BAR (7:00 AM - 11:00 PM) -->
                        <div class="col-12">
                            <div class="card border rounded-3 p-3 bg-white shadow-sm mb-1">
                                <div class="d-flex justify-content-between align-items-center mb-2 flex-wrap gap-2">
                                    <span class="fw-bold text-dark small d-flex align-items-center gap-1.5">
                                        <i class="bi bi-calendar2-range text-primary fs-6"></i>
                                        <span>Schedule &amp; Availability Bar: <strong>@inspectDate.ToString("dddd, MMM dd, yyyy")</strong></span>
                                    </span>
                                    <div class="d-flex align-items-center gap-2">
                                        @if (dayBookingsOnDate.Any())
                                        {
                                            <span class="badge bg-danger bg-opacity-10 text-danger border border-danger-subtle small fw-semibold">
                                                <i class="bi bi-calendar-x me-1"></i>@dayBookingsOnDate.Count @(dayBookingsOnDate.Count == 1 ? "Booking Scheduled" : "Bookings Scheduled")
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success bg-opacity-10 text-success border border-success-subtle small fw-semibold">
                                                <i class="bi bi-calendar-check me-1"></i>Open Day
                                            </span>
                                        }
                                        <span class="badge bg-light text-secondary border small">7:00 AM – 11:00 PM</span>
                                    </div>
                                </div>

                                <!-- Horizontal Proportional Pill Bar -->
                                <div class="d-flex gap-1.5 p-1.5 bg-light rounded-3 border overflow-auto align-items-stretch" style="min-height: 72px;">
                                    @foreach (var seg in timelineSegments)
                                    {
                                        var flexGrow = Math.Max(1, (int)Math.Round(seg.DurationHours * 2));
                                        string bgClass;
                                        string borderStyle;
                                        string textColor;
                                        string statusIcon;

                                        if (seg.HasConflict)
                                        {
                                            bgClass = "bg-danger bg-opacity-25";
                                            borderStyle = "2px solid #dc3545";
                                            textColor = "text-danger";
                                            statusIcon = "bi-exclamation-triangle-fill text-danger";
                                        }
                                        else if (seg.IsBooked)
                                        {
                                            bgClass = seg.IsPending ? "bg-warning bg-opacity-20" : "bg-danger bg-opacity-15";
                                            borderStyle = seg.IsPending ? "1.5px solid #f59e0b" : "1.5px solid #ef4444";
                                            textColor = seg.IsPending ? "text-warning-emphasis" : "text-danger";
                                            statusIcon = seg.IsPending ? "bi-hourglass-split text-warning" : "bi-lock-fill text-danger";
                                        }
                                        else if (seg.IsSelected)
                                        {
                                            bgClass = "bg-primary text-white";
                                            borderStyle = "2px solid #0d6efd";
                                            textColor = "text-white";
                                            statusIcon = "bi-check-circle-fill text-white";
                                        }
                                        else
                                        {
                                            bgClass = seg.IsSlot ? "bg-success bg-opacity-10" : "bg-white";
                                            borderStyle = seg.IsSlot ? "1.5px solid #86efac" : "1px dashed #cbd5e1";
                                            textColor = seg.IsSlot ? "text-success" : "text-secondary";
                                            statusIcon = seg.IsSlot ? "bi-calendar-check text-success" : "bi-clock text-muted";
                                        }

                                        <div class="rounded-3 p-2 d-flex flex-column justify-content-between transition-all @(seg.IsBooked ? "opacity-75" : "cursor-pointer hover-shadow")"
                                             style="flex: @flexGrow 1 0; min-width: 105px; border: @borderStyle; background-color: @(seg.IsSelected && !seg.HasConflict ? "#0d6efd" : "");"
                                             title="@(seg.IsBooked ? $"Booked: {seg.BookedTitle} ({seg.Subtitle}) - Cannot be selected" : $"Click to set event time: {seg.Subtitle}")"
                                             @onclick="() => { if (!seg.IsBooked) SelectTimelineSegment(seg); }">
                                            
                                            <div class="d-flex align-items-center justify-content-between mb-1">
                                                <i class="bi @statusIcon" style="font-size: 0.85rem;"></i>
                                                <span class="badge @(seg.IsSelected ? "bg-white text-primary fw-bold" : (seg.IsBooked ? "bg-secondary" : (seg.IsSlot ? "bg-success text-white" : "bg-light text-dark border")))" style="font-size: 0.68rem;">
                                                    @(seg.HasConflict ? "CONFLICT" : (seg.IsSelected ? "SELECTED" : (seg.IsBooked ? (seg.IsPending ? "HOLD" : "BOOKED") : (seg.IsSlot ? "SLOT" : "OPEN"))))
                                                </span>
                                            </div>

                                            <div class="fw-bold text-truncate @(seg.IsSelected && !seg.HasConflict ? "text-white" : "text-dark")" style="font-size: 0.76rem;" title="@seg.Title">
                                                @seg.Title
                                            </div>

                                            <div class="@(seg.IsSelected && !seg.HasConflict ? "text-white-50" : "text-muted")" style="font-size: 0.68rem; font-weight: 500;">
                                                @seg.Subtitle
                                            </div>
                                        </div>
                                    }
                                </div>

                                <!-- Timeline Legend -->
                                <div class="d-flex align-items-center justify-content-between mt-2 pt-1 border-top flex-wrap gap-2 text-muted" style="font-size: 0.72rem;">
                                    <div class="d-flex align-items-center gap-3 flex-wrap">
                                        <span class="d-flex align-items-center gap-1"><span class="badge bg-success p-1 rounded-circle" style="width:7px; height:7px;"></span> Available Slot</span>
                                        <span class="d-flex align-items-center gap-1"><span class="badge bg-light border text-dark p-1 rounded-circle" style="width:7px; height:7px;"></span> Open Time</span>
                                        <span class="d-flex align-items-center gap-1"><span class="badge bg-primary p-1 rounded-circle" style="width:7px; height:7px;"></span> Your Event Window</span>
                                        <span class="d-flex align-items-center gap-1"><span class="badge bg-danger p-1 rounded-circle" style="width:7px; height:7px;"></span> Booked (Locked)</span>
                                    </div>
                                    <span class="text-primary fw-semibold"><i class="bi bi-hand-index-thumb me-1"></i>Click any open slot to quickly set time</span>
                                </div>
                            </div>
                        </div>

                        <!-- LIVE CONFLICT CHECKING & SCHEDULED BOOKINGS FOR THIS DATE BANNER -->
                        <div class="col-12">
                            @if (directConflictsOnDate.Any() || conflicts.Any())
                            {
                                var activeConflictList = directConflictsOnDate.Any() ? directConflictsOnDate : conflicts;
                                <div class="alert alert-danger p-3 rounded-3 mb-0 shadow-sm border border-danger">
                                    <div class="d-flex align-items-center gap-2 mb-2">
                                        <i class="bi bi-exclamation-octagon-fill text-danger fs-5"></i>
                                        <strong class="text-danger">⚠️ Schedule Conflict Detected! (@activeConflictList.Count overlapping @(activeConflictList.Count == 1 ? "booking" : "bookings"))</strong>
                                    </div>
                                    <p class="small mb-2 text-dark">The following existing booking(s) already occupy <strong>@(_editEventModel.Location ?? "the selected room")</strong> during your chosen time:</p>
                                    <div class="list-group list-group-flush border rounded-2 bg-white small mb-0">
                                        @foreach (var c in activeConflictList.Take(5))
                                        {
                                            <div class="list-group-item py-2 d-flex justify-content-between align-items-center">
                                                <div>
                                                    <strong class="text-danger">@c.Title</strong>
                                                    <div class="text-muted" style="font-size: 0.78rem;">
                                                        <i class="bi bi-clock me-1"></i>@c.Start.ToString("MMM dd, yyyy h:mm tt") - @c.End.ToString("h:mm tt")
                                                        <span class="mx-1">•</span>
                                                        <i class="bi bi-geo-alt me-1"></i>@(c.Location ?? "Main Function Hall")
                                                    </div>
                                                </div>
                                                <span class="badge @(c.Title.Contains("PENDING", StringComparison.OrdinalIgnoreCase) ? "bg-warning text-dark" : "bg-danger")">
                                                    @(c.Title.Contains("PENDING", StringComparison.OrdinalIgnoreCase) ? "Pending Hold" : "Confirmed Booking")
                                                </span>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                            else if (dayBookingsOnDate.Any())
                            {
                                <div class="alert alert-warning p-3 rounded-3 mb-0 shadow-sm border border-warning">
                                    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-2">
                                        <div class="d-flex align-items-center gap-2">
                                            <i class="bi bi-info-circle-fill text-warning-emphasis fs-5"></i>
                                            <strong class="text-warning-emphasis">Existing Bookings on @inspectDate.ToString("ddd, MMM dd, yyyy"): (@dayBookingsOnDate.Count @(dayBookingsOnDate.Count == 1 ? "event" : "events") scheduled)</strong>
                                        </div>
                                        @if (hasSelectedTime)
                                        {
                                            <span class="badge bg-success text-white px-2.5 py-1.5 shadow-sm fw-semibold d-flex align-items-center gap-1">
                                                <i class="bi bi-check-circle-fill"></i>Your Selected Time is Clear
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-dark border px-2.5 py-1.5 shadow-sm fw-semibold d-flex align-items-center gap-1">
                                                <i class="bi bi-clock"></i>Select a time to check availability
                                            </span>
                                        }
                                    </div>
                                    <p class="small mb-2 text-muted">Other time slots are occupied on this date for <strong>@(_editEventModel.Location ?? "the selected room")</strong>:</p>
                                    <div class="list-group list-group-flush border rounded-2 bg-white small mb-0">
                                        @foreach (var b in dayBookingsOnDate)
                                        {
                                            <div class="list-group-item py-2 d-flex justify-content-between align-items-center">
                                                <div>
                                                    <strong>@b.Title</strong>
                                                    <div class="text-muted" style="font-size: 0.78rem;">
                                                        <i class="bi bi-clock me-1"></i>@b.Start.ToString("h:mm tt") - @b.End.ToString("h:mm tt")
                                                        <span class="mx-1">•</span>
                                                        <i class="bi bi-geo-alt me-1"></i>@(b.Location ?? "Main Function Hall")
                                                    </div>
                                                </div>
                                                <span class="badge @(b.Title.Contains("PENDING", StringComparison.OrdinalIgnoreCase) ? "bg-warning text-dark" : "bg-secondary")">
                                                    @(b.Title.Contains("PENDING", StringComparison.OrdinalIgnoreCase) ? "Pending Hold" : "Booked")
                                                </span>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="alert alert-success py-2 px-3 rounded-3 mb-0 small d-flex align-items-center gap-2 bg-success bg-opacity-10 border border-success-subtle text-success">
                                    <i class="bi bi-check-circle-fill fs-6 text-success"></i>
                                    <span><strong>Space Available:</strong> Entire day is completely open on the calendar for @(_editEventModel.Location ?? "this room").</span>
                                </div>
                            }
                        </div>

                        @if (_bookingCategory == "club")
                        {
                            <!-- Simplified Club Event Notes -->
                            <div class="col-12">
                                <label class="form-label fw-semibold small">Club Event Description &amp; Notes (Optional)</label>
                                <textarea class="form-control" rows="3" placeholder="Enter meeting agenda, event notes, or public details for the club calendar..." @bind="_editEventModel.Description"></textarea>
                            </div>

                            @if (!isManagedSpace)
                            {
                                <!-- Secondary Flexible Space: Option to Display Title on Public-Facing Calendar -->
                                <div class="col-12">
                                    <div class="card border border-info-subtle rounded-3 p-3 bg-white shadow-sm">
                                        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                                            <div class="d-flex align-items-center gap-2">
                                                <div class="p-2 rounded-circle bg-primary-subtle text-primary">
                                                    <i class="bi bi-globe2 fs-5"></i>
                                                </div>
                                                <div>
                                                    <label class="form-label fw-bold text-dark small mb-0 d-block cursor-pointer" for="pubCalToggle">
                                                        Display on Public-Facing Calendar
                                                    </label>
                                                    <small class="text-muted">When enabled, only the event title (e.g. "@(_editEventModel.Title?.Trim().Length > 0 ? _editEventModel.Title.Trim() : "Meeting")") will be visible on the public website calendar grid.</small>
                                                </div>
                                            </div>
                                            <div class="form-check form-switch fs-5 mb-0">
                                                <input class="form-check-input cursor-pointer" type="checkbox" role="switch" id="pubCalToggle" @bind="_showOnPublicCalendar" />
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <!-- Primary Managed Rental Space: Granular Public Rental Blockout Controls -->
                                <div class="col-12">
                                    <div class="card border border-primary-subtle rounded-3 p-3 bg-light shadow-sm">
                                        <div class="d-flex align-items-center justify-content-between mb-2 flex-wrap gap-2">
                                            <label class="form-label fw-bold text-dark small mb-0 d-flex align-items-center gap-1.5">
                                                <i class="bi bi-shield-lock-fill text-danger fs-6"></i>
                                                <span>Public Rental Availability &amp; Slot Blackout:</span>
                                            </label>
                                            <div class="btn-group btn-group-sm" role="group">
                                                <button type="button" class="btn @(_blockOutMode == "none" ? "btn-dark fw-bold" : "btn-outline-secondary")" @onclick='() => { _blockOutMode = "none"; _blockOutDayForRentals = false; }'>
                                                    Do Not Block
                                                </button>
                                                <button type="button" class="btn @(_blockOutMode == "selected" ? "btn-primary fw-bold text-white" : "btn-outline-secondary")" @onclick='() => { _blockOutMode = "selected"; _blockOutDayForRentals = true; }'>
                                                    Block Specific Slots
                                                </button>
                                                <button type="button" class="btn @(_blockOutMode == "all" ? "btn-danger fw-bold text-white" : "btn-outline-secondary")" @onclick='() => { _blockOutMode = "all"; _blockOutDayForRentals = true; }'>
                                                    Block Entire Day
                                                </button>
                                            </div>
                                        </div>

                                        @if (_blockOutMode == "all")
                                        {
                                            <div class="alert alert-danger py-2 px-3 mb-0 small rounded-3 d-flex align-items-center gap-2">
                                                <i class="bi bi-slash-circle-fill text-danger fs-6"></i>
                                                <span><strong>All rental time slots</strong> on @(_isNewEvent && plannedDates.Count > 1 ? "these dates" : "this date") will be fully blocked out from the public rental application calendar.</span>
                                            </div>
                                        }
                                        else if (_blockOutMode == "selected")
                                        {
                                            <div class="p-2.5 bg-white border rounded-3 mb-1">
                                                <div class="small fw-semibold text-dark mb-2">Check the specific rental slots to block for the public:</div>
                                                @if (!availableSlotsOnDay.Any())
                                                {
                                                    <div class="text-muted small py-1">No predefined slots configured for @inspectDate.ToString("dddd")s. Standard hours apply.</div>
                                                }
                                                else
                                                {
                                                    <div class="d-flex gap-3 flex-wrap">
                                                        @foreach (var slot in availableSlotsOnDay)
                                                        {
                                                            var slotKey = $"{slot.StartTime}-{slot.EndTime}";
                                                            bool isChecked = _selectedBlockedSlotTimes.Contains(slotKey);
                                                            <div class="form-check">
                                                                <input class="form-check-input" type="checkbox" id="blockSlot_@slotKey" 
                                                                       checked="@isChecked"
                                                                       @onchange="(e) => {
                                                                           if ((bool)(e.Value ?? false)) _selectedBlockedSlotTimes.Add(slotKey);
                                                                           else _selectedBlockedSlotTimes.Remove(slotKey);
                                                                       }" />
                                                                <label class="form-check-label small fw-semibold text-dark cursor-pointer" for="blockSlot_@slotKey">
                                                                    <i class="bi bi-clock me-1 text-primary"></i>@slot.StartTime - @slot.EndTime
                                                                </label>
                                                            </div>
                                                        }
                                                    </div>
                                                }
                                            </div>
                                            <small class="text-muted">Unchecked slots will remain open for visitors to submit rental applications on the website.</small>
                                        }
                                        else
                                        {
                                            <div class="text-muted small">
                                                <i class="bi bi-info-circle me-1"></i>Standard reservation. Non-overlapping rental slots remain open for public rental booking.
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <!-- Full Hall Rental Details -->
                            <div class="col-12">
                                <label class="form-label fw-semibold small">Booking Details &amp; Applicant Notes</label>
                                <textarea class="form-control" rows="4" placeholder="Enter rental details, applicant contact info, bar service or kitchen access notes..." @bind="_editEventModel.Description"></textarea>
                            </div>
                        }
                    </div>

                    @if (!string.IsNullOrEmpty(_editEventError))
                    {
                        <div class="alert alert-danger py-2 px-3 mt-3 mb-0 border-0 rounded-3 small">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>
                            @_editEventError
                        </div>
                    }
                </div>

                <div class="modal-footer bg-light border-top p-3 px-4 d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <div class="d-flex align-items-center gap-2">
                        <button type="button" class="btn btn-outline-secondary" @onclick="() => _showEditEventModal = false" disabled="@_isSavingEvent">Cancel</button>
                        <button type="button" class="btn btn-outline-primary d-flex align-items-center gap-1" @onclick="SwitchToCalendarFromBookingModal" disabled="@_isSavingEvent">
                            <i class="bi bi-calendar3"></i>
                            <span>View Calendar</span>
                        </button>
                    </div>
                    <button type="button" class="btn btn-primary px-4 shadow-sm fw-bold d-flex align-items-center gap-2" @onclick="SaveGoogleEvent" disabled="@_isSavingEvent">
                        @if (_isSavingEvent)
                        {
                            <span class="spinner-border spinner-border-sm" role="status"></span>
                            <span>Saving Event(s)...</span>
                        }
                        else
                        {
                            <i class="bi bi-cloud-check fs-5"></i>
                            <span>@(_isNewEvent ? (_recurrenceMode != "single" ? $"Create {plannedDates.Count} Event Occurrences" : "Create Event") : "Update in Google Calendar")</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- CANCEL OR REMOVE EVENT MODAL -->
@if (_showCancelEventConfirm && _eventToCancelOrRemove != null)
{
    var cancelPaySummary = GetEventPaymentSummary(_eventToCancelOrRemove);
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.75); z-index: 1065;" role="dialog">
        <div class="modal-dialog modal-dialog-centered" style="max-width: 520px;" role="document">
            <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="modal-header bg-danger text-white p-3 px-4">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-exclamation-triangle-fill fs-4"></i>
                        <h5 class="modal-title fw-bold mb-0">Cancel or Remove Booking</h5>
                    </div>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseCancelEventConfirm" disabled="@_isProcessingCancelOrRemove"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <div class="fw-bold text-dark fs-6 mb-1">@_eventToCancelOrRemove.Title</div>
                        <div class="text-muted small">
                            <i class="bi bi-calendar3 me-1"></i>@_eventToCancelOrRemove.Start.ToString("dddd, MMMM dd, yyyy")
                            <span class="mx-1">•</span>
                            <i class="bi bi-clock me-1"></i>@_eventToCancelOrRemove.Start.ToString("h:mm tt") - @_eventToCancelOrRemove.End.ToString("h:mm tt")
                        </div>
                    </div>

                    @if (cancelPaySummary.TotalPaid > 0)
                    {
                        <div class="alert alert-warning border border-warning shadow-sm rounded-3 p-3 mb-3">
                            <div class="d-flex align-items-start gap-2">
                                <i class="bi bi-cash-coin fs-4 text-warning-emphasis flex-shrink-0"></i>
                                <div>
                                    <strong class="text-dark d-block">Recorded Payments Detected ($@cancelPaySummary.TotalPaid.ToString("N2"))</strong>
                                    <div class="small text-muted mb-2">This booking has recorded payments. If canceling, you can issue a refund transaction to balance the ledger.</div>
                                    <button type="button" class="btn btn-warning btn-sm rounded-pill px-3 shadow-sm fw-bold text-dark" @onclick="() => OpenRefundPaymentModal(_eventToCancelOrRemove, cancelPaySummary.TotalPaid)">
                                        <i class="bi bi-arrow-counterclockwise me-1"></i>Record / Issue Refund
                                    </button>
                                </div>
                            </div>
                        </div>
                    }

                    <p class="text-secondary small mb-3">
                        Please choose how you would like to handle this pending event / rental booking:
                    </p>

                    <div class="d-grid gap-3">
                        <button type="button" class="btn btn-outline-warning text-dark text-start p-3 rounded-3 border d-flex align-items-start gap-3 shadow-sm hover-shadow" @onclick="MarkBookingCancelledAsync" disabled="@_isProcessingCancelOrRemove">
                            <i class="bi bi-slash-circle fs-3 text-warning"></i>
                            <div>
                                <strong class="d-block text-dark">Mark as Cancelled</strong>
                                <small class="text-muted">Keeps the record in your database for audit history, but changes status to Cancelled and frees up the calendar.</small>
                            </div>
                        </button>

                        <button type="button" class="btn btn-outline-danger text-start p-3 rounded-3 border d-flex align-items-start gap-3 shadow-sm hover-shadow" @onclick="PermanentlyDeleteBookingAsync" disabled="@_isProcessingCancelOrRemove">
                            <i class="bi bi-trash3-fill fs-3 text-danger"></i>
                            <div>
                                <strong class="d-block text-danger">Delete &amp; Remove Completely</strong>
                                <small class="text-muted">Permanently deletes the application from the database and removes the scheduled event from Google Calendar.</small>
                            </div>
                        </button>
                    </div>

                    @if (_isProcessingCancelOrRemove)
                    {
                        <div class="text-center mt-3 text-primary">
                            <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                            <span class="small fw-bold">Processing request...</span>
                        </div>
                    }
                </div>
                <div class="modal-footer bg-light p-3 px-4">
                    <button type="button" class="btn btn-secondary px-4 shadow-sm" @onclick="CloseCancelEventConfirm" disabled="@_isProcessingCancelOrRemove">
                        Dismiss
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- ========================================================================= -->
<!-- MANUAL PAYMENT RECORDING / EDITING MODAL -->
<!-- ========================================================================= -->
@if (_showRecordPaymentModal)
{
    var modalPayEvent = _selectedEvent;
    var currentPaySummary = modalPayEvent != null ? GetEventPaymentSummary(modalPayEvent) : new PaymentSummary();
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.65); z-index: 1070;" role="dialog">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="modal-header @(_paymentModel.PaymentType == "Refund" ? "bg-danger" : "bg-success") text-white p-3 px-4">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi @(_paymentModel.PaymentType == "Refund" ? "bi-arrow-counterclockwise" : "bi-cash-coin") fs-4"></i>
                        <h5 class="modal-title fw-bold mb-0">@(_isEditingExistingPayment ? "Edit Payment Record" : (_paymentModel.PaymentType == "Refund" ? "Record Refund" : "Record Payment / Deposit"))</h5>
                    </div>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => _showRecordPaymentModal = false"></button>
                </div>
                <EditForm Model="@_paymentModel" OnValidSubmit="SavePayment">
                    <div class="modal-body p-4">
                        @if (!string.IsNullOrEmpty(_paymentError))
                        {
                            <div class="alert alert-danger py-2 small">@_paymentError</div>
                        }

                        <!-- Live Financial Balance Summary Card -->
                        <div class="card border rounded-3 bg-light p-3 mb-3 shadow-none">
                            <div class="row g-2 text-center small">
                                <div class="col-4 border-end">
                                    <span class="text-muted d-block" style="font-size: 0.72rem;">Total Quoted</span>
                                    <strong class="text-dark fs-6">$@currentPaySummary.TotalPrice.ToString("N2")</strong>
                                </div>
                                <div class="col-4 border-end">
                                    <span class="text-muted d-block" style="font-size: 0.72rem;">Total Paid</span>
                                    <strong class="text-success fs-6">$@currentPaySummary.TotalPaid.ToString("N2")</strong>
                                </div>
                                <div class="col-4">
                                    <span class="text-muted d-block" style="font-size: 0.72rem;">Remaining Balance</span>
                                    <strong class="fs-6 @(currentPaySummary.RemainingBalance > 0 ? "text-danger" : "text-success")">
                                        $@currentPaySummary.RemainingBalance.ToString("N2")
                                    </strong>
                                </div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold small">Payment Category *</label>
                            <select class="form-select" @bind="_paymentModel.PaymentType">
                                <option value="Rental Fee">Rental Fee</option>
                                @if (_webSettings?.RequireSecurityDeposit == true)
                                {
                                    <option value="Security Deposit">Deposit</option>
                                }
                                <option value="Waived">Waived / Fee Waiver</option>
                                @if (_paymentModel.PaymentType == "Refund" || _isEditingExistingPayment)
                                {
                                    <option value="Refund">Refund / Return</option>
                                }
                            </select>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-6">
                                <label class="form-label fw-bold small">Amount ($) *</label>
                                <div class="input-group">
                                    <span class="input-group-text">$</span>
                                    <InputNumber class="form-control fw-bold" @bind-Value="_paymentModel.Amount" min="1" step="0.01" />
                                </div>
                            </div>
                            <div class="col-6">
                                <label class="form-label fw-bold small">Date Received *</label>
                                <InputDate class="form-control" @bind-Value="_paymentModel.PaymentDate" />
                            </div>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-6">
                                <label class="form-label fw-bold small">Payment Method</label>
                                <select class="form-select" @bind="_paymentModel.PaymentMethod">
                                    <option value="Check">Check</option>
                                    <option value="Cash">Cash</option>
                                    <option value="Venmo / Zelle">Venmo / Zelle</option>
                                    <option value="Credit / Debit Card">Credit / Debit Card</option>
                                    <option value="Dropped Off / In-Person">Dropped Off / In-Person</option>
                                    <option value="Waived">Waived</option>
                                </select>
                            </div>
                            <div class="col-6">
                                <label class="form-label fw-bold small">Check / Reference #</label>
                                <InputText class="form-control font-monospace" placeholder="e.g. Check #1042" @bind-Value="_paymentModel.ReferenceOrCheckNumber" />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold small">Notes / Description</label>
                            <InputTextArea class="form-control" rows="2" placeholder="Optional notes regarding this payment..." @bind-Value="_paymentModel.Notes" />
                        </div>
                    </div>
                    <div class="modal-footer bg-light border-top p-3 px-4 d-flex justify-content-between">
                        <button type="button" class="btn btn-outline-secondary" @onclick="() => _showRecordPaymentModal = false">Cancel</button>
                        <button type="submit" class="btn @(_paymentModel.PaymentType == "Refund" ? "btn-danger" : "btn-success") px-4 fw-bold shadow-sm" disabled="@_isSavingPayment">
                            @if (_isSavingPayment)
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span>
                                <span>Saving...</span>
                            }
                            else
                            {
                                <i class="bi bi-check-circle me-1"></i>
                                <span>@(_isEditingExistingPayment ? "Update Payment" : (_paymentModel.PaymentType == "Refund" ? "Save Refund" : "Save Payment"))</span>
                            }
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

<!-- PRICING GUIDE & CHART MODAL -->
@if (_showPricingGuideModal)
