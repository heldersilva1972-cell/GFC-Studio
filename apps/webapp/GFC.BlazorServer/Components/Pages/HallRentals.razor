            if (_weeklySelectedDays == null || _weeklySelectedDays.Count == 0)
            {
                _weeklySelectedDays = new HashSet<DayOfWeek> { _singleEventDate.DayOfWeek };
            }

            while (curr <= end && list.Count < 200)
            {
                if (_weeklySelectedDays.Contains(curr.DayOfWeek))
                {
                    list.Add(curr);
                }
                curr = curr.AddDays(1);
            }
            return list;
        }
        else if (_recurrenceMode == "custom")
        {
            if (_customDatesList.Any())
            {
                return _customDatesList.OrderBy(d => d).ToList();
            }
            // If no custom dates added to the list yet, evaluate conflicts against the currently chosen date in the datepicker
            return new List<DateTime> { _customDateToAdd.Date };
