    private async Task LoadPaymentsForSelectedEvent(CalendarEventItem evt)
    {
        _selectedPayments.Clear();
        _selectedRequest = null;
        try
        {
            await LoadAllRequestsAndPayments();
            var appData = ParseApplicationDetails(evt);
            var cleanTitle = GetCleanTitle(evt);

            string normTitle = cleanTitle.ToLowerInvariant().Trim();
            int pIdx = normTitle.IndexOf('(');
            if (pIdx > 0) normTitle = normTitle.Substring(0, pIdx).Trim();
            int dIdx = normTitle.IndexOf('-');
            if (dIdx > 0) normTitle = normTitle.Substring(0, dIdx).Trim();

            string normAppDataName = (appData.ApplicantName ?? "").ToLowerInvariant().Trim();

            // 1. Match by exact or normalized applicant name and date
            var matchedReq = _cachedRentalRequests.FirstOrDefault(r => 
                r.EventDate.Date == evt.Start.Date && (
                    (!string.IsNullOrWhiteSpace(r.ApplicantName) && (
                        string.Equals(r.ApplicantName, appData.ApplicantName, StringComparison.OrdinalIgnoreCase) ||
                        string.Equals(r.ApplicantName, cleanTitle, StringComparison.OrdinalIgnoreCase) ||
                        r.ApplicantName.ToLower().Trim() == normTitle ||
                        r.ApplicantName.ToLower().Trim() == normAppDataName ||
                        cleanTitle.Contains(r.ApplicantName, StringComparison.OrdinalIgnoreCase) ||
                        r.ApplicantName.Contains(cleanTitle, StringComparison.OrdinalIgnoreCase) ||
                        normTitle.Contains(r.ApplicantName.ToLower().Trim()) ||
                        (!string.IsNullOrWhiteSpace(normAppDataName) && normTitle.Contains(normAppDataName))
                    )) ||
                    (!string.IsNullOrWhiteSpace(r.RequesterName) && (
                        string.Equals(r.RequesterName, appData.ApplicantName, StringComparison.OrdinalIgnoreCase) ||
                        string.Equals(r.RequesterName, cleanTitle, StringComparison.OrdinalIgnoreCase) ||
                        r.RequesterName.ToLower().Trim() == normTitle
                    ))
                )
            );

            // 2. Match by email or phone across any matching date
            if (matchedReq == null && (!string.IsNullOrWhiteSpace(appData.Email) || !string.IsNullOrWhiteSpace(appData.Phone)))
            {
                matchedReq = _cachedRentalRequests.FirstOrDefault(r =>
                    r.EventDate.Date == evt.Start.Date &&
                    ((!string.IsNullOrWhiteSpace(appData.Email) && string.Equals(r.RequesterEmail, appData.Email, StringComparison.OrdinalIgnoreCase)) ||
                     (!string.IsNullOrWhiteSpace(appData.Phone) && string.Equals(r.RequesterPhone, appData.Phone, StringComparison.OrdinalIgnoreCase)))
                );
            }

            // 3. Match across same date if only 1 rental request exists
            if (matchedReq == null)
            {
                var sameDateBookings = _cachedRentalRequests.Where(r => r.EventDate.Date == evt.Start.Date).ToList();
                if (sameDateBookings.Count == 1)
                {
                    matchedReq = sameDateBookings.First();
                }
            }

            // 4. Fallback: match by applicant name alone across all requests if date matches within 1 day (timezone difference)
            if (matchedReq == null && !string.IsNullOrWhiteSpace(normTitle) && normTitle.Length > 2)
            {
                matchedReq = _cachedRentalRequests.FirstOrDefault(r =>
                    Math.Abs((r.EventDate.Date - evt.Start.Date).TotalDays) <= 1 &&
                    !string.IsNullOrWhiteSpace(r.ApplicantName) && (
                        r.ApplicantName.ToLower().Trim() == normTitle ||
                        r.ApplicantName.ToLower().Trim().Contains(normTitle) ||
                        normTitle.Contains(r.ApplicantName.ToLower().Trim())
                    )
                );
            }

            // 5. Final fallback: match by applicant name alone
            if (matchedReq == null && !string.IsNullOrWhiteSpace(normTitle) && normTitle.Length > 2)
            {
                matchedReq = _cachedRentalRequests.FirstOrDefault(r =>
                    !string.IsNullOrWhiteSpace(r.ApplicantName) && (
                        r.ApplicantName.ToLower().Trim() == normTitle ||
                        r.ApplicantName.ToLower().Trim().Contains(normTitle) ||
                        normTitle.Contains(r.ApplicantName.ToLower().Trim())
                    )
                );
            }

            if (matchedReq != null)
            {
                _selectedRequest = matchedReq;
                var payments = await RentalService.GetPaymentsForRequestAsync(matchedReq.Id);
                _selectedPayments = payments.ToList();
            }
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"Error loading payments: {ex.Message}");
        }
    }

    private void AutoCalculateSelectedRequestPrice()
    {
        if (_selectedRequest == null) return;
        decimal basePrice = 0;
        bool isMember = _selectedRequest.MemberStatus;

        var rooms = _editableRooms.Any() ? _editableRooms : (_webSettings?.GetRoomsList() ?? new List<RentalRoomOption>());
        var selectedRoom = rooms.FirstOrDefault(r => r.Name.Equals(_selectedRequest.RoomSelected, StringComparison.OrdinalIgnoreCase)) ?? rooms.FirstOrDefault();

        if (selectedRoom != null)
        {
            basePrice = isMember ? selectedRoom.MemberRate : selectedRoom.NonMemberRate;
        }
        else
        {
            basePrice = isMember ? (_webSettings?.FunctionHallMemberRate ?? 300) : (_webSettings?.FunctionHallNonMemberRate ?? 400);
        }

        decimal addOns = 0;
        if (_selectedRequest.BartenderRequested) addOns += (_webSettings?.BartenderServiceFee ?? 100);
        if (_selectedRequest.KitchenUsage) addOns += (_webSettings?.KitchenFee ?? 50);
        if (_selectedRequest.AvEquipmentUsage) addOns += (_webSettings?.AvEquipmentFee ?? 25);

        _selectedRequest.TotalPrice = basePrice + addOns;
        ToastService.ShowInfo($"Calculated standard quote: ${_selectedRequest.TotalPrice:N2}");
    }

