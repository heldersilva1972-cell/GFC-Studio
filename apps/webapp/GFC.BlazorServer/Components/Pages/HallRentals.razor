    private bool IsAddonSelected(HallRentalRequest? req, RentalAddonOption addon)
    {
        if (req == null || addon == null) return false;
        if (addon.Id == "addon_bar" || addon.Name.Contains("Bar", StringComparison.OrdinalIgnoreCase))
            return req.BartenderRequested;
        if (addon.Id == "addon_kitchen" || addon.Name.Contains("Kitchen", StringComparison.OrdinalIgnoreCase))
            return req.KitchenUsage;
        if (addon.Id == "addon_av" || addon.Name.Contains("AV", StringComparison.OrdinalIgnoreCase) || addon.Name.Contains("Sound", StringComparison.OrdinalIgnoreCase))
            return req.AvEquipmentUsage;
        return false;
    }

    private void SetAddonSelected(HallRentalRequest? req, RentalAddonOption addon, bool isSelected)
    {
        if (req == null || addon == null) return;
        if (addon.Id == "addon_bar" || addon.Name.Contains("Bar", StringComparison.OrdinalIgnoreCase))
            req.BartenderRequested = isSelected;
        else if (addon.Id == "addon_kitchen" || addon.Name.Contains("Kitchen", StringComparison.OrdinalIgnoreCase))
            req.KitchenUsage = isSelected;
        else if (addon.Id == "addon_av" || addon.Name.Contains("AV", StringComparison.OrdinalIgnoreCase) || addon.Name.Contains("Sound", StringComparison.OrdinalIgnoreCase))
            req.AvEquipmentUsage = isSelected;
        RecalculateEditPriceQuote();
    }

    private async Task CheckPermissions()
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            _isAdmin = user.IsInRole("Admin") || user.Identity?.Name?.ToLower() == "admin";

            if (_isAdmin)
            {
                _hasPageAccess = true;
                return;
            }

            var userIdClaim = user.FindFirst("UserId") ?? user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier);
            if (userIdClaim != null && int.TryParse(userIdClaim.Value, out var userId))
            {
                var permissions = UserService.GetUserPagePermissions(userId);
                var allPages = UserService.GetAllPages();
                var hallRentalsPage = allPages.FirstOrDefault(p => p.PageRoute.TrimStart('/').ToLower() == "hall-rentals");
                if (hallRentalsPage != null)
                {
                    _hasPageAccess = permissions.Any(p => p.PageId == hallRentalsPage.PageId);
                }
            }
        }
        catch
        {
            _hasPageAccess = false;
        }
    }

    private async Task LoadSettingsAndEvents()
    {
        try
        {
            try
            {
                _settings = await CalendarService.GetSettingsAsync();
            }
            catch (Exception cEx)
            {
                _settings = new GoogleCalendarSettings();
                System.Diagnostics.Debug.WriteLine($"Warning: CalendarService.GetSettingsAsync failed: {cEx.Message}");
            }

            try
            {
                _webSettings = await WebsiteSettingsService.GetWebsiteSettingsAsync();
            }
            catch (Exception wEx)
            {
                _webSettings = new WebsiteSettings();
                System.Diagnostics.Debug.WriteLine($"Warning: WebsiteSettingsService.GetWebsiteSettingsAsync failed: {wEx.Message}");
            }

            // Ensure at least 1 feed entry exists if Feeds list is empty
            if (_settings.Feeds.Count == 0 && !string.IsNullOrWhiteSpace(_settings.PublicCalendarUrl))
            {
                _settings.Feeds.Add(new CalendarFeedConfig
                {
                    Name = string.IsNullOrWhiteSpace(_settings.CalendarName) ? "Primary Calendar" : _settings.CalendarName,
                    Url = _settings.PublicCalendarUrl,
                    Color = "#0d6efd",
                    IsEnabled = true
                });
            }

            var calendarEvents = new List<CalendarEventItem>();

            // Fetch configured production Google Calendar feeds
            if (_settings.Feeds.Any(f => f.IsEnabled && !string.IsNullOrWhiteSpace(f.Url)))
            {
                try
                {
                    var fetched = await CalendarService.FetchAllFeedsAsync(_settings);
                    if (fetched != null)
                    {
                        calendarEvents.AddRange(fetched);
                    }
                }
                catch (Exception ex)
                {
                    _syncMessage = $"Notice: Google Calendar sync error: {ex.Message}";
                }
            }

            // Always merge database rental requests so all submitted applications are present with complete contact info
            try
            {
                var dbRequests = await RentalService.GetRentalRequestsAsync();
                _cachedRentalRequests = dbRequests.ToList();
                
                // Collect set of cancelled request dates / applicants so they are never displayed on calendar
                var cancelledRequests = dbRequests.Where(r => string.Equals(r.Status, "Cancelled", StringComparison.OrdinalIgnoreCase)).ToList();
                foreach (var cancelled in cancelledRequests)
                {
                    string cleanCancelledName = (cancelled.ApplicantName ?? "").Trim();
                    int parenIdx = cleanCancelledName.IndexOf('(');
                    if (parenIdx > 0) cleanCancelledName = cleanCancelledName.Substring(0, parenIdx).Trim();

                    calendarEvents.RemoveAll(e => 
                        e.Start.Date == cancelled.EventDate.Date && 
                        (!string.IsNullOrWhiteSpace(cleanCancelledName) && (
                            e.Title.Contains(cleanCancelledName, StringComparison.OrdinalIgnoreCase) || 
                            (!string.IsNullOrWhiteSpace(cancelled.RequesterName) && e.Title.Contains(cancelled.RequesterName, StringComparison.OrdinalIgnoreCase))
                        )));
                }

                foreach (var req in dbRequests)
                {
                    // Do not display Cancelled or Archived requests on the active calendar; they are kept in DB for audit trail & FAQ records
                    if (string.Equals(req.Status, "Cancelled", StringComparison.OrdinalIgnoreCase) ||
                        string.Equals(req.Status, "Archived", StringComparison.OrdinalIgnoreCase)) continue;

                    bool isApproved = string.Equals(req.Status, "Approved", StringComparison.OrdinalIgnoreCase);
                    bool isInquiryReq = string.Equals(req.Status, "Inquiry", StringComparison.OrdinalIgnoreCase) || string.Equals(req.Status, "Responded", StringComparison.OrdinalIgnoreCase);

                    string statusPrefix = isApproved ? "" : (isInquiryReq ? "INQUIRY: " : "PENDING: ");
                    string title;
                    if (isInquiryReq)
                    {
                        title = $"INQUIRY: {req.ApplicantName}";
                    }
                    else
                    {
                        var (formattedTitle, _) = FormatGoogleEventDetails(req, false);
                        title = isApproved ? formattedTitle.Replace("PENDING: ", "") : formattedTitle;
                    }

                    // Check if already present in calendar events by ID, date & name, or title
                    string cleanApplicant = req.ApplicantName.Trim();
                    int parenIdx = cleanApplicant.IndexOf('(');
                    if (parenIdx > 0) cleanApplicant = cleanApplicant.Substring(0, parenIdx).Trim();

                    var existing = calendarEvents.FirstOrDefault(e => 
                        (!string.IsNullOrWhiteSpace(e.GoogleEventId) && e.GoogleEventId == $"db-rental-{req.Id}") ||
                        (!isInquiryReq &&
                            e.Start.Date == req.EventDate.Date && 
                            (
                                (!string.IsNullOrWhiteSpace(cleanApplicant) && e.Title.Contains(cleanApplicant, StringComparison.OrdinalIgnoreCase)) || 
                                (!string.IsNullOrWhiteSpace(req.RequesterName) && e.Title.Contains(req.RequesterName, StringComparison.OrdinalIgnoreCase)) ||
                                (!string.IsNullOrWhiteSpace(req.EventType) && e.Title.Contains(req.EventType, StringComparison.OrdinalIgnoreCase))
                            )
                        ));

                    if (existing == null)
                    {
                        DateTime start = req.EventDate.Date.AddHours(12);
                        DateTime end = req.EventDate.Date.AddHours(isInquiryReq ? 13 : 17);
                        if (!string.IsNullOrWhiteSpace(req.StartTime) && DateTime.TryParse(req.StartTime, out var ps)) start = req.EventDate.Date.Add(ps.TimeOfDay);
                        if (!string.IsNullOrWhiteSpace(req.EndTime) && DateTime.TryParse(req.EndTime, out var pe)) end = req.EventDate.Date.Add(pe.TimeOfDay);

                        var svcsList = new List<string>();
                        if (req.BartenderRequested) svcsList.Add("Bar Service");
                        if (req.KitchenUsage) svcsList.Add("Kitchen Access");
                        if (req.AvEquipmentUsage) svcsList.Add("A/V Equipment");
                        string svcsLine = svcsList.Any() ? $"\nRequested Services: {string.Join(", ", svcsList)}" : "";

                        string eventDesc = isInquiryReq
                            ? $"Inquiry From: {req.ApplicantName}\nPhone: {req.RequesterPhone}\nEmail: {req.RequesterEmail}\nPreferred Date: {req.EventDate:MM/dd/yyyy}\nPhone Callback Requested: {(req.RequestPhoneCall || string.Equals(req.PreferredContactMethod, "Phone", StringComparison.OrdinalIgnoreCase) ? "Yes" : "No")}\nPreferred Contact Method: {(string.IsNullOrWhiteSpace(req.PreferredContactMethod) ? (req.RequestPhoneCall ? "Phone" : "Email") : req.PreferredContactMethod)}\nInquiry / Question: {req.EventDescription ?? req.InternalNotes}"
                            : $"Applicant: {req.ApplicantName}\nPhone: {req.RequesterPhone}\nEmail: {req.RequesterEmail}\nAddress: {req.RequesterAddress}\nRoom: {req.RoomSelected}\nGuests: {req.GuestCount}\nTotal: ${req.TotalPrice:N2}\nBar Service: {(req.BartenderRequested ? "Yes" : "No")}\nKitchen Access: {(req.KitchenUsage ? "Yes" : "No")}{svcsLine}";

                        calendarEvents.Add(new CalendarEventItem
                        {
                            GoogleEventId = $"db-rental-{req.Id}",
                            RentalRequestId = req.Id,
                            Title = title,
                            Start = start,
                            End = end,
                            Location = req.RoomSelected ?? "Function Hall",
                            Source = isInquiryReq ? "General Inquiry" : "Rental Booking",
                            Status = req.Status?.ToUpperInvariant() ?? (isInquiryReq ? "INQUIRY" : "PENDING"),
                            ColorCategory = isInquiryReq ? "badge-info" : (isApproved ? "badge-success" : "badge-warning"),
                            Description = eventDesc,
                            CreatedDate = req.CreatedDate != default ? req.CreatedDate : (req.RequestedDate != default ? req.RequestedDate : null)
                        });
                    }
                    else
                    {
                        existing.RentalRequestId = req.Id;
                        if (isApproved)
                        {
                            existing.Title = title;
                            existing.Status = "CONFIRMED";
                            existing.ColorCategory = "badge-success";
                        }
                        if (existing.CreatedDate == null)
                        {
                            existing.CreatedDate = req.CreatedDate != default ? req.CreatedDate : (req.RequestedDate != default ? req.RequestedDate : null);
                        }
                    }
                }
            }
            catch (Exception dbEx)
            {
                System.Diagnostics.Debug.WriteLine($"Notice: Database rental request merge warning: {dbEx.Message}");
            }

            // 2b. Merge database blackout dates & club events (from AvailabilityCalendars table)
            try
            {
                var dbBlackouts = await RentalService.GetUnavailableDatesAsync(includeRentalRequests: false);
                foreach (var unavail in dbBlackouts)
                {
                    var title = !string.IsNullOrWhiteSpace(unavail.EventType) ? unavail.EventType : "Club Event";
                    var isOffice = title.Contains("Office", StringComparison.OrdinalIgnoreCase);
                    var loc = isOffice ? (_webSettings?.SecondaryFlexibleLocation ?? "Office") : (_webSettings?.ManagedRentalLocation ?? "Function Hall");

                    var existing = calendarEvents.FirstOrDefault(e => 
                        (!string.IsNullOrWhiteSpace(e.GoogleEventId) && e.GoogleEventId == $"db-blackout-{unavail.Id}") ||
                        (
                            e.Start.Date == unavail.Date.Date && 
                            (
                                (!string.IsNullOrWhiteSpace(title) && (e.Title.Contains(title, StringComparison.OrdinalIgnoreCase) || title.Contains(e.Title, StringComparison.OrdinalIgnoreCase))) ||
                                (unavail.IsFullDay && e.IsAllDay && string.Equals(e.Location, loc, StringComparison.OrdinalIgnoreCase))
                            )
                        ));

                    if (existing == null)
                    {
                        DateTime start = unavail.Date.Date.AddHours(9);
                        DateTime end = unavail.Date.Date.AddHours(23);
                        bool isAllDay = unavail.IsFullDay;

                        if (!unavail.IsFullDay && !string.IsNullOrWhiteSpace(unavail.EventTime))
                        {
                            var parts = unavail.EventTime.Split('-', StringSplitOptions.TrimEntries);
                            if (parts.Length == 2 && DateTime.TryParse(parts[0], out var ps) && DateTime.TryParse(parts[1], out var pe))
                            {
                                start = unavail.Date.Date.Add(ps.TimeOfDay);
                                end = unavail.Date.Date.Add(pe.TimeOfDay);
                                isAllDay = false;
                            }
                        }

                        calendarEvents.Add(new CalendarEventItem
                        {
                            GoogleEventId = $"db-blackout-{unavail.Id}",
                            Title = title,
                            Start = start,
                            End = end,
                            IsAllDay = isAllDay,
                            Location = loc,
                            Source = "Club Event",
                            Status = "Confirmed",
                            ColorCategory = "badge-dark",
                            Description = isOffice ? "Club Event (Office Space)\nShow on Public Calendar: Yes" : "Club Event / Blackout"
                        });
                    }
                }
            }
            catch (Exception dbEx)
            {
                System.Diagnostics.Debug.WriteLine($"Notice: Database blackout merge warning: {dbEx.Message}");
            }

            // Global deduplication pass across merged feeds and database items
            // Sort database items first so their accurate database metadata & RentalRequestId take precedence
            var sortedCalendarEvents = calendarEvents
                .OrderByDescending(e => !string.IsNullOrWhiteSpace(e.GoogleEventId) && e.GoogleEventId.StartsWith("db-rental-"))
                .ToList();

            var distinctList = new List<CalendarEventItem>();
            foreach (var evt in sortedCalendarEvents)
            {
                // Distinct database records with explicit IDs should never be discarded by fuzzy deduplication
                if (!string.IsNullOrWhiteSpace(evt.GoogleEventId) && (evt.GoogleEventId.StartsWith("db-rental-") || evt.GoogleEventId.StartsWith("db-blackout-")))
                {
                    if (!distinctList.Any(d => d.GoogleEventId == evt.GoogleEventId))
                    {
                        distinctList.Add(evt);
                    }
                    continue;
                }

                string cleanEvtTitle = (evt.Title ?? "")
                    .Replace("PENDING:", "", StringComparison.OrdinalIgnoreCase)
                    .Replace("INQUIRY:", "", StringComparison.OrdinalIgnoreCase)
                    .Replace("APPROVED:", "", StringComparison.OrdinalIgnoreCase)
                    .Trim();

                bool isDup = distinctList.Any(d =>
                {
                    if (d.Start.Date != evt.Start.Date) return false;

                    // Match same Google Event ID
                    if (!string.IsNullOrWhiteSpace(d.GoogleEventId) && !string.IsNullOrWhiteSpace(evt.GoogleEventId) && d.GoogleEventId == evt.GoogleEventId)
                        return true;

                    string cleanDTitle = (d.Title ?? "")
                        .Replace("PENDING:", "", StringComparison.OrdinalIgnoreCase)
                        .Replace("INQUIRY:", "", StringComparison.OrdinalIgnoreCase)
                        .Replace("APPROVED:", "", StringComparison.OrdinalIgnoreCase)
                        .Trim();

                    // Match same Clean Title / Name on same date
                    if (!string.IsNullOrWhiteSpace(cleanDTitle) && !string.IsNullOrWhiteSpace(cleanEvtTitle) &&
                        (string.Equals(cleanDTitle, cleanEvtTitle, StringComparison.OrdinalIgnoreCase) ||
                         cleanDTitle.Contains(cleanEvtTitle, StringComparison.OrdinalIgnoreCase) ||
                         cleanEvtTitle.Contains(cleanDTitle, StringComparison.OrdinalIgnoreCase)))
                    {
                        return true;
                    }

                    // Overlapping time window on same date with matching or empty room
                    if (Math.Abs((d.Start - evt.Start).TotalMinutes) <= 60)
                    {
                        if (string.Equals(d.Location, evt.Location, StringComparison.OrdinalIgnoreCase) ||
                            string.IsNullOrWhiteSpace(d.Location) || string.IsNullOrWhiteSpace(evt.Location))
                        {
                            return true;
                        }
                    }

                    return false;
                });

                if (!isDup)
                {
                    distinctList.Add(evt);
                }
            }

            _events = distinctList;
            _lastPageRefreshLocal = DateTime.Now;
            _settings.TotalEventsCount = _events.Count;

            // Ensure payments ledger cache is loaded so GetEventPaymentSummary computes accurate status
            await LoadAllRequestsAndPayments();
        }
        catch (Exception ex)
        {
            _events = new List<CalendarEventItem>();
            _syncMessage = $"Notice: Calendar sync issue ({ex.Message}).";
            _syncSuccess = false;
        }
    }

