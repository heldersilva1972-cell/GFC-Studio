                    <div class="mb-3">
                        <label class="form-label small fw-bold text-dark mb-1">Quick Response Preset Template (Optional)</label>
                        <select class="form-select form-select-sm" @onchange="OnInquiryReplyPresetSelected">
                            <option value="">-- Select a response template or write custom below --</option>
                            <option value="available">Date is Available &amp; Ready for Booking</option>
                            <option value="unavailable">Date is Unavailable / Already Booked</option>
                            <option value="pricing_info">Standard Rental Pricing &amp; Details</option>
                            <option value="call_to_discuss">Request Phone Discussion</option>
                        </select>
