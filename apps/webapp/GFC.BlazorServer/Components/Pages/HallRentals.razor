                            sb.AppendLine($"<h2 style='color: #0f172a; margin: 0;'>Booking Details &amp; Quote Update</h2>");
                            sb.AppendLine($"<p style='color: #64748b; margin: 4px 0 0 0; font-size: 13px;'>{clubNameStr} &bull; Hall Rental Administration</p>");
                            sb.AppendLine($"</div>");

                            sb.AppendLine($"<p>Dear {System.Net.WebUtility.HtmlEncode(_selectedRequest.ApplicantName ?? "Applicant")},</p>");
                            sb.AppendLine($"<p>Your hall rental application and pricing quote have been adjusted by club administration. Please review the updated specifications and summary below:</p>");
                            
                            // Changes Comparison Table
                            if (diffsSnapshot.Any())
                            {
                                sb.AppendLine($"<div style='margin: 16px 0;'>");
                                sb.AppendLine($"<h4 style='color: #334155; margin-bottom: 8px;'>Summary of Modifications ({diffsSnapshot.Count}):</h4>");
                                sb.AppendLine($"<table style='width: 100%; border-collapse: collapse; font-size: 14px; text-align: left;'>");
                                sb.AppendLine($"<thead><tr style='background: #f1f5f9; border-bottom: 2px solid #cbd5e1;'>");
                                sb.AppendLine($"<th style='padding: 8px 12px; color: #475569;'>Specification</th>");
                                sb.AppendLine($"<th style='padding: 8px 12px; color: #475569;'>Previous Value</th>");
                                sb.AppendLine($"<th style='padding: 8px 12px; color: #0284c7;'>Updated Value</th>");
                                sb.AppendLine($"</tr></thead><tbody>");
                                
                                foreach (var diff in diffsSnapshot)
                                {
                                    sb.AppendLine($"<tr style='border-bottom: 1px solid #e2e8f0;'>");
                                    sb.AppendLine($"<td style='padding: 8px 12px; font-weight: bold; color: #1e293b;'>{System.Net.WebUtility.HtmlEncode(diff.FieldName)}</td>");
                                    sb.AppendLine($"<td style='padding: 8px 12px; color: #64748b; background: #f8fafc;'><strike>{System.Net.WebUtility.HtmlEncode(diff.OldValue)}</strike></td>");
                                    sb.AppendLine($"<td style='padding: 8px 12px; color: #0f172a; font-weight: bold; background: #f0fdf4;'>{System.Net.WebUtility.HtmlEncode(diff.NewValue)}</td>");
                                    sb.AppendLine($"</tr>");
                                }
                                sb.AppendLine($"</tbody></table></div>");
                            }

                            if (!string.IsNullOrWhiteSpace(noteSnapshot))
                            {
                                sb.AppendLine($"<div style='background: #fffbeb; border-left: 4px solid #f59e0b; padding: 12px; margin: 16px 0; border-radius: 4px;'>");
                                sb.AppendLine($"<strong style='color: #92400e;'>Note from Administration:</strong>");
                                sb.AppendLine($"<p style='color: #78350f; margin: 4px 0 0 0;'>{System.Net.WebUtility.HtmlEncode(noteSnapshot)}</p>");
                                sb.AppendLine($"</div>");
                            }

                            // Current Complete Booking Specifications
                            sb.AppendLine($"<h4 style='color: #334155; margin-bottom: 8px;'>Current Booking Specifications:</h4>");
                            sb.AppendLine($"<ul style='padding-left: 20px;'>");
                            sb.AppendLine($"<li><strong>Event Date:</strong> {_selectedRequest.EventDate:dddd, MMMM dd, yyyy}</li>");
                            if (!string.IsNullOrEmpty(_selectedRequest.StartTime) && !string.IsNullOrEmpty(_selectedRequest.EndTime))
                                sb.AppendLine($"<li><strong>Time Window:</strong> {_selectedRequest.StartTime} - {_selectedRequest.EndTime}</li>");
                            sb.AppendLine($"<li><strong>Facility Room:</strong> {_selectedRequest.RoomSelected ?? "Function Hall"}</li>");
                            if (_selectedRequest.GuestCount > 0)
                                sb.AppendLine($"<li><strong>Estimated Guests:</strong> {_selectedRequest.GuestCount}</li>");
                            sb.AppendLine($"<li><strong>Agreed Rental Rate:</strong> ${_selectedRequest.TotalPrice:N2}</li>");
                            if (settings.RequireSecurityDeposit)
                                sb.AppendLine($"<li><strong>Refundable Security Deposit:</strong> ${effectiveDeposit:N2}</li>");
                            foreach (var addon in (_webSettings?.GetAddonsList() ?? new List<RentalAddonOption>()).Where(a => a.IsActive))
                            {
                                var isIncluded = IsAddonSelected(_selectedRequest, addon);
                                sb.AppendLine($"<li><strong>{addon.Name}:</strong> {(isIncluded ? "Yes (Included)" : "No")}</li>");
                            }
                            sb.AppendLine($"</ul>");
                            
