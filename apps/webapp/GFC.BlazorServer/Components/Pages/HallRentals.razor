    private static string FormatPhoneNumber(string? phone)
    {
        if (string.IsNullOrWhiteSpace(phone)) return string.Empty;
        var digits = new string(phone.Where(char.IsDigit).ToArray());

        // Standard 10-digit US phone: (XXX) XXX-XXXX
        if (digits.Length == 10)
        {
            return $"({digits.Substring(0, 3)}) {digits.Substring(3, 3)}-{digits.Substring(6)}";
        }
        // 11-digit starting with 1 (country code): (XXX) XXX-XXXX
        if (digits.Length == 11 && digits.StartsWith("1"))
        {
            return $"({digits.Substring(1, 3)}) {digits.Substring(4, 3)}-{digits.Substring(7)}";
        }
        // 7-digit local phone: missing area code warning / formatted
        if (digits.Length == 7)
        {
            return $"{digits.Substring(0, 3)}-{digits.Substring(3)} (Missing Area Code)";
        }
        // If other length, return cleaned string with notice if too short/long
        if (digits.Length > 0 && digits.Length < 10)
        {
            return $"{phone.Trim()} (Incomplete - {digits.Length} digits)";
        }
        if (digits.Length > 11)
        {
            return $"{phone.Trim()} (Invalid - Too many digits)";
        }

        return phone.Trim();
    }

    private static bool IsValidPhoneNumber(string? phone, out string? errorMessage)
    {
        if (string.IsNullOrWhiteSpace(phone))
        {
            errorMessage = null;
            return true;
        }

        var digits = new string(phone.Where(char.IsDigit).ToArray());
        if (digits.Length == 10 || (digits.Length == 11 && digits.StartsWith("1")))
        {
            errorMessage = null;
            return true;
        }

        if (digits.Length == 7)
        {
            errorMessage = "Phone number is missing a 3-digit area code (must be 10 digits).";
            return false;
        }

        if (digits.Length < 10)
        {
            errorMessage = $"Phone number is incomplete (found only {digits.Length} digits, 10 required including area code).";
            return false;
        }

        errorMessage = $"Phone number has too many digits ({digits.Length} digits). Please enter a standard 10-digit number with area code.";
        return false;
    }

