@page "/hall-rentals"
@using GFC.Core.Models
@using GFC.Core.Interfaces
@using GFC.BlazorServer.Services
@using Microsoft.AspNetCore.Components.Forms
@using System.Text.RegularExpressions
@inject IGoogleCalendarService CalendarService
@inject IUserManagementService UserService
@inject IRentalService RentalService
@inject IRentalEmailDispatcher RentalEmailDispatcher
@inject GFC.Core.Interfaces.IWebsiteSettingsService WebsiteSettingsService
@inject GFC.Core.Interfaces.IMemberRepository MemberRepository
@inject GFC.Core.Services.OverdueCalculationService OverdueService
@inject GFC.BlazorServer.Services.CustomAuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JSRuntime
@inject IToastService ToastService
@inject NavigationManager Navigation
@attribute [Authorize]
@rendermode InteractiveServer
@implements IDisposable

<div class="hall-rentals-container">
    @if (!_hasPageAccess && !_isAdmin)
    {
        <div class="access-denied-panel text-center py-5">
            <div class="bg-light rounded-circle shadow-sm d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px;">
                <i class="bi bi-shield-lock-fill text-danger fs-1"></i>
            </div>
            <h3 class="fw-bold text-dark">Access Restricted</h3>
            <p class="text-muted">You do not have permission to view the Hall Rentals page. Please contact your system administrator.</p>
        </div>
    }
    else
    {
        @if (!_isCalendarOnlyMode)
        {
        <!-- Compact Page Header & Quick Actions -->
        <div class="d-flex justify-content-between align-items-center mb-2 flex-wrap gap-2">
            <div>
                <h1 class="dashboard-title mb-0 fs-3">
                    <i class="bi bi-calendar2-week-fill text-gold me-2"></i>
                    Hall Rentals
                </h1>
                <p class="dashboard-subtitle text-muted mb-0 small">Multi-calendar synchronization, event schedules, and rental bookings</p>
            </div>
            <div class="header-actions d-flex gap-2 flex-wrap align-items-center">
                <a href="/public/calendar" target="_blank" class="btn btn-sm btn-primary d-flex align-items-center gap-1.5 shadow-sm fw-semibold" title="Open Public Hall Rental Calendar in Full Screen">
                    <i class="bi bi-eye-fill"></i>
                    <span>Public Calendar (What Public Sees)</span>
                </a>
                <button class="btn btn-sm btn-success d-flex align-items-center gap-1 shadow-sm fw-semibold" @onclick="OpenAddEventModal">
                    <i class="bi bi-calendar-plus-fill"></i>
                    <span>Add Booking</span>
                </button>
                <button class="btn btn-sm btn-outline-primary d-flex align-items-center gap-1 shadow-sm fw-semibold" @onclick="() => _showPricingGuideModal = true" title="View & Customize Pricing Guide">
                    <i class="bi bi-bar-chart-fill text-primary"></i>
                    <span>Pricing Guide Chart</span>
                </button>
                <button class="btn btn-sm btn-outline-primary d-flex align-items-center gap-1 shadow-sm" @onclick='() => Navigation.NavigateTo("/hall-rentals/settings")'>
                    <i class="bi bi-sliders2-vertical"></i>
                    <span>Rental Settings</span>
                    @if (_settings.Feeds.Count > 1)
                    {
                        <span class="badge bg-primary rounded-pill">@_settings.Feeds.Count</span>
                    }
                </button>
                <button class="btn btn-sm btn-primary d-flex align-items-center gap-1 shadow-sm" @onclick="SyncCalendarNow" disabled="@_isSyncing">
                    @if (_isSyncing)
                    {
                        <span class="spinner-border spinner-border-sm" role="status"></span>
                        <span>Syncing...</span>
                    }
                    else
                    {
                        <i class="bi bi-arrow-repeat"></i>
                        <span>Sync Now</span>
                    }
                </button>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(_syncMessage))
        {
            <div class="alert @(_syncSuccess ? "alert-success" : "alert-warning") alert-dismissible fade show shadow-sm py-2 px-3 mb-2 small" role="alert">
                <i class="bi @(_syncSuccess ? "bi-check-circle-fill" : "bi-exclamation-triangle-fill") me-2"></i>
                @_syncMessage
                <button type="button" class="btn-close py-2 px-3" @onclick="() => _syncMessage = null"></button>
            </div>
        }

        <!-- Streamlined Stats & Environment Ribbon -->
        <div class="card border-0 shadow-sm mb-2 rounded-3 bg-light border">
            <div class="card-body p-2 px-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
                <!-- Inline Metric Pills -->
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <span class="badge bg-primary text-white border border-primary px-2.5 py-1 rounded-pill fw-semibold shadow-sm">
                        <i class="bi bi-calendar-event me-1"></i>Total: <strong>@_events.Count</strong>
                    </span>
                    <span class="badge bg-success text-white border border-success px-2.5 py-1 rounded-pill fw-semibold shadow-sm">
                        <i class="bi bi-calendar-check me-1"></i>Next 30 Days: <strong>@GetUpcomingCount()</strong>
                    </span>
                    <span class="badge bg-warning text-dark border border-warning px-2.5 py-1 rounded-pill fw-bold shadow-sm">
                        <i class="bi bi-clock-history me-1"></i>Pending: <strong>@GetPendingCount()</strong>
                    </span>
                    @if (GetInquiriesCount() > 0)
                    {
                        <span class="badge px-2.5 py-1 rounded-pill fw-bold shadow-sm" style="cursor: pointer; background-color: #e0f2fe !important; color: #0369a1 !important; border: 1px solid #38bdf8 !important;" @onclick='() => _filterCategory = "INQUIRIES"' title="Filter by Pre-Booking Questions &amp; Inquiries">
                            <i class="bi bi-question-diamond-fill me-1" style="color: #0284c7;"></i>Inquiries: <strong style="color: #0c4a6e;">@GetInquiriesCount()</strong>
                        </span>
                    }
                    <span class="badge bg-info text-dark border border-info px-2.5 py-1 rounded-pill fw-bold shadow-sm">
                        <i class="bi bi-layers-fill me-1"></i>Calendars: <strong>@(_settings.Feeds.Count(f => f.IsEnabled)) Active</strong>
                    </span>
                    @if (_settings.LastSyncedAt.HasValue)
                    {
                        var minsAgo = (int)Math.Max(0, (DateTime.Now - _settings.LastSyncedAt.Value).TotalMinutes);
                        string timeAgoStr = minsAgo < 1 ? "Just now" : (minsAgo < 60 ? $"{minsAgo}m ago" : _settings.LastSyncedAt.Value.ToString("h:mm tt"));
                        <span class="badge bg-light text-secondary border px-2.5 py-1 rounded-pill fw-semibold shadow-sm" title="Last checked for new applications, inquiries &amp; calendar events: @_settings.LastSyncedAt.Value.ToString("MM/dd/yyyy h:mm:ss tt")">
                            <i class="bi bi-clock-history me-1 text-primary"></i>Data Refreshed: <span class="text-dark fw-bold">@timeAgoStr</span>
                        </span>
                    }
                    @{
                        var latestActivity = GetLatestActivityTime();
                        if (latestActivity.HasValue)
                        {
                            var actMins = (int)Math.Max(0, (DateTime.Now - latestActivity.Value).TotalMinutes);
                            string actStr = actMins < 1 ? "Just now" : (actMins < 60 ? $"{actMins}m ago" : (latestActivity.Value.Date == DateTime.Today ? $"Today at {latestActivity.Value:h:mm tt}" : latestActivity.Value.ToString("MMM dd, h:mm tt")));
                            <span class="badge bg-white text-dark border px-2.5 py-1 rounded-pill fw-semibold shadow-sm" title="Latest submitted inquiry, booking application, or record update: @latestActivity.Value.ToString("MM/dd/yyyy h:mm tt")">
                                <i class="bi bi-activity me-1 text-success"></i>Latest Activity: <span class="text-success fw-bold">@actStr</span>
                            </span>
                        }
                    }
                    @if (GetArchivedInquiriesCount() > 0)
                    {
                        <span class="badge bg-secondary-subtle text-secondary border border-secondary px-2.5 py-1 rounded-pill fw-bold shadow-sm" style="cursor: pointer;" @onclick='() => _filterCategory = "ARCHIVED_INQUIRIES"' title="View Archived Inquiries for FAQ Preparation">
                            <i class="bi bi-archive-fill me-1 text-secondary"></i>FAQ / Archived: <strong>@GetArchivedInquiriesCount()</strong>
                        </span>
                    }
                    @if (GetCancelledCount() > 0)
                    {
                        <span class="badge bg-danger-subtle text-danger border border-danger px-2.5 py-1 rounded-pill fw-bold shadow-sm" style="cursor: pointer;" @onclick='() => _filterCategory = "CANCELLED"' title="Filter by Cancelled Bookings">
                            <i class="bi bi-x-circle me-1"></i>Cancelled: <strong>@GetCancelledCount()</strong>
                        </span>
                    }
                </div>

                <!-- Environment Indicator -->
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <span class="badge bg-success px-2 py-1 shadow-sm">
                        <i class="bi bi-broadcast me-1"></i>LIVE PRODUCTION
                    </span>
                </div>
            </div>
        </div>

        <!-- Unified Search & Category Filter Toolbar -->
        <div class="card shadow-sm border-0 mb-3">
            <div class="card-body p-2 px-3">
                <div class="row g-2 align-items-center justify-content-between">
                    <div class="col-lg-4 col-md-5">
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                            <input type="text" class="form-control border-start-0" placeholder="Search by name, event type or date..." @bind="_searchTerm" @bind:event="oninput" />
                            @if (!string.IsNullOrEmpty(_searchTerm))
                            {
                                <button class="btn btn-outline-secondary border-start-0" @onclick="() => _searchTerm = string.Empty">
                                    <i class="bi bi-x-lg"></i>
                                </button>
                            }
                        </div>
                    </div>
                    <div class="col-lg-8 col-md-7 d-flex justify-content-md-end gap-2 flex-wrap align-items-center">
                        <div class="btn-group btn-group-sm flex-wrap">
                            <button class="btn @(_filterCategory == "ALL" ? "btn-dark fw-bold shadow-sm" : "btn-outline-secondary")" @onclick='() => _filterCategory = "ALL"'>All (@_events.Count)</button>
                            <button class="btn @(_filterCategory == "CLUB_EVENTS" ? "btn-primary fw-bold text-white shadow-sm" : "btn-outline-secondary")" style="@(_filterCategory == "CLUB_EVENTS" ? "background-color: #7c3aed !important; border-color: #6d28d9 !important;" : "")" @onclick='() => _filterCategory = "CLUB_EVENTS"' title="Show only internal Club Events & Meetings">
                                <i class="bi bi-shield-shaded me-1"></i>Club Events (@GetClubEventsCount())
                            </button>
                            <button class="btn @(_filterCategory == "PENDING_INQUIRIES" ? "btn-warning fw-bold text-dark shadow-sm" : "btn-outline-secondary")" @onclick='() => _filterCategory = "PENDING_INQUIRIES"'>Pending &amp; Inquiries (@GetPendingAndInquiriesCount())</button>
                            <button class="btn @(_filterCategory == "PENDING" ? "btn-warning fw-bold text-dark shadow-sm" : "btn-outline-secondary")" @onclick='() => _filterCategory = "PENDING"'>Pending (@GetPendingCount())</button>
                            <button class="btn @(_filterCategory == "INQUIRIES" ? "btn-info text-dark fw-bold shadow-sm" : "btn-outline-secondary")" @onclick='() => _filterCategory = "INQUIRIES"'>Inquiries (@GetInquiriesCount())</button>
                            <button class="btn @(_filterCategory == "PAID" ? "btn-success fw-bold shadow-sm" : "btn-outline-secondary")" @onclick='() => _filterCategory = "PAID"'>Paid (@GetPaidEventsCount())</button>
                            <button class="btn @(_filterCategory == "UNPAID" ? "btn-danger fw-bold shadow-sm" : "btn-outline-secondary")" @onclick='() => _filterCategory = "UNPAID"'>Unpaid</button>
                            <button class="btn @(_filterCategory == "APPLICATIONS" ? "btn-primary fw-bold shadow-sm" : "btn-outline-secondary")" @onclick='() => _filterCategory = "APPLICATIONS"'>Applications (@GetApplicationsCount())</button>
                            @if (GetArchivedInquiriesCount() > 0)
                            {
                                <button class="btn @(_filterCategory == "ARCHIVED_INQUIRIES" ? "btn-secondary fw-bold text-white shadow-sm" : "btn-outline-secondary")" @onclick='() => _filterCategory = "ARCHIVED_INQUIRIES"' title="Browse archived inquiries for FAQ creation">
                                    <i class="bi bi-archive me-1"></i>Archived FAQ (@GetArchivedInquiriesCount())
                                </button>
                            }
                            <button class="btn @(_filterCategory == "CANCELLED" ? "btn-danger fw-bold text-white shadow-sm" : "btn-outline-secondary")" @onclick='() => _filterCategory = "CANCELLED"'>Cancelled (@GetCancelledCount())</button>
                        </div>

                        <div class="d-flex gap-1 p-1 bg-white border rounded-3 shadow-sm align-items-center" role="group">
                            <button type="button" class="btn btn-sm px-3 py-1 fw-bold rounded-2 transition-all @(_activeView == "calendar" ? "btn-primary shadow-sm" : "btn-light text-secondary border-0")" @onclick="SwitchToCalendar">
                                <i class="bi bi-calendar3 me-1.5"></i> Calendar View
                            </button>
                            <button type="button" class="btn btn-sm px-3 py-1 fw-bold rounded-2 transition-all @(_activeView == "list" ? "btn-primary shadow-sm" : "btn-light text-secondary border-0")" @onclick="SwitchToListView">
                                <i class="bi bi-list-ul me-1.5"></i> Schedule List
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        }

        @if (_activeView == "calendar" || _isCalendarOnlyMode)
        {
            <!-- CALENDAR GRID VIEW -->
            <div class="card shadow-sm border-0 mb-4 calendar-wrapper-card">
                <div class="card-body p-3">
                    <!-- Notice Banner: Directly at top of Calendar -->
                    <div class="alert alert-warning border-warning bg-warning bg-opacity-10 py-2 px-3 rounded-3 mb-3 shadow-sm d-flex align-items-center justify-content-between flex-wrap gap-2">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-shield-lock-fill text-warning fs-5 flex-shrink-0"></i>
                            <div class="small text-dark">
                                <strong>Internal Calendar View:</strong> This calendar is for internal management and is <strong>not viewable to the public</strong>.
                                <span class="text-muted d-block" style="font-size: 0.78rem;">To see what the public sees, click the button on the right or at the top of the page.</span>
                            </div>
                        </div>
                        <a href="/public/calendar" target="_blank" class="btn btn-sm btn-primary d-flex align-items-center gap-1.5 fw-semibold py-1 px-3 shadow-sm" style="font-size: 0.8rem;" title="View exact public calendar in full screen">
                            <i class="bi bi-eye-fill"></i>
                            <span>View Public Calendar</span>
                        </a>
                    </div>

                    <div class="calendar-nav-bar d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                        <div class="d-flex align-items-center gap-2">
                            @if (_isCalendarOnlyMode)
                            {
                                <button class="btn btn-primary btn-sm d-flex align-items-center gap-2 shadow fw-bold px-3 py-1" @onclick="ReturnBackToBooking" title="Return to booking window">
                                    <i class="bi bi-arrow-left-circle-fill fs-6"></i>
                                    <span>Back to Booking</span>
                                </button>
                            }
                            else
                            {
                                <button class="btn btn-outline-dark btn-sm d-flex align-items-center gap-1 shadow-sm fw-semibold" @onclick='() => _activeView = "list"' title="Return to Bookings schedule list">
                                    <i class="bi bi-arrow-left"></i>
                                    <span>Back to Bookings</span>
                                </button>
                            }
                            <button class="btn btn-light rounded-circle shadow-sm" @onclick="() => ChangeMonth(-1)" title="Previous Month">
                                <i class="bi bi-chevron-left"></i>
                            </button>
                        </div>
                        <h4 class="mb-0 fw-bold text-dark text-center">
                            @_currentMonth.ToString("MMMM yyyy")
                        </h4>
                        <div class="d-flex gap-2 align-items-center">
                            <button class="btn btn-light rounded-circle shadow-sm" @onclick="() => ChangeMonth(1)" title="Next Month">
                                <i class="bi bi-chevron-right"></i>
                            </button>
                        </div>
                    </div>

                    <!-- Weekday Header -->
                    <div class="calendar-grid-header">
                        <div class="day-head">Sun</div>
                        <div class="day-head">Mon</div>
                        <div class="day-head">Tue</div>
                        <div class="day-head">Wed</div>
                        <div class="day-head">Thu</div>
                        <div class="day-head">Fri</div>
                        <div class="day-head">Sat</div>
                    </div>

                    <!-- Month Days -->
                    <div class="calendar-grid-body">
                        @{
                            var firstDayOfMonth = new DateTime(_currentMonth.Year, _currentMonth.Month, 1);
                            int leadingOffset = (int)firstDayOfMonth.DayOfWeek;
                            int totalDays = DateTime.DaysInMonth(_currentMonth.Year, _currentMonth.Month);
                        }

                        @for (int i = 0; i < leadingOffset; i++)
                        {
                            <div class="calendar-cell outside-month"></div>
                        }

                        @for (int day = 1; day <= totalDays; day++)
                        {
                            var date = new DateTime(_currentMonth.Year, _currentMonth.Month, day);
                            var dayEvents = GetEventsForDate(date);
                            bool isToday = date.Date == DateTime.Today;

                            <div class="calendar-cell @(isToday ? "cell-today" : "")">
                                <div class="cell-header d-flex justify-content-between align-items-center">
                                    <span class="cell-day-num @(isToday ? "badge bg-primary rounded-circle" : "")">@day</span>
                                    @if (dayEvents.Any())
                                    {
                                        <span class="badge bg-light text-dark border-0">@dayEvents.Count</span>
                                    }
                                </div>
                                <div class="cell-events">
                                    @{
                                        var displayMode = _webSettings?.MonthCalendarDisplayMode ?? "multiline";
                                        var monthFields = (_webSettings?.MonthCalendarFields ?? WebsiteSettings.GetDefaultMonthCalendarFields())
                                            .Where(f => f.IsEnabled)
                                            .OrderBy(f => f.Order)
                                            .ToList();
                                    }
                                    @foreach (var evt in dayEvents.Take(3))
                                    {
                                        var isClub = IsClubEvent(evt);
                                        var matchedReq = isClub ? null : FindMatchingRentalRequest(evt);
                                        var isApproved = !isClub && ((matchedReq != null && string.Equals(matchedReq.Status, "Approved", StringComparison.OrdinalIgnoreCase)) || evt.Title.StartsWith("APPROVED", StringComparison.OrdinalIgnoreCase) || string.Equals(evt.Status, "CONFIRMED", StringComparison.OrdinalIgnoreCase));
                                        var isPending = !isClub && !isApproved && (evt.Title.StartsWith("PENDING", StringComparison.OrdinalIgnoreCase) || string.Equals(evt.Status, "PENDING", StringComparison.OrdinalIgnoreCase) || (matchedReq != null && string.Equals(matchedReq.Status, "Pending", StringComparison.OrdinalIgnoreCase)));
                                        var payStatus = isClub ? "Club Event" : GetEventPaymentStatus(evt);
                                        var appData = ParseApplicationDetails(evt);

                                        var secondaryLabel = _webSettings?.SecondaryFlexibleLocation ?? "Office";
                                        var evtRoomNorm = NormalizeRoomName(evt.Location);
                                        var managedLocNorm = NormalizeRoomName(_webSettings?.ManagedRentalLocation ?? "Function Hall");
                                        var isSecSpace = evtRoomNorm != managedLocNorm && evtRoomNorm != "entire facility";

                                        @if (displayMode == "compact")
                                        {
                                            <div class="event-pill @(isClub ? "pill-club" : (isPending ? "pill-warning" : "pill-primary"))" @onclick="() => ShowEventDetails(evt)" title="@evt.Title">
                                                <span class="event-time">@(evt.IsAllDay ? "All-day" : evt.Start.ToString("h:mm tt"))</span>
                                                @if (isClub)
                                                {
                                                    @if (isSecSpace)
                                                    {
                                                        <span class="badge py-0 px-1 fw-bold" style="font-size: 0.65rem; background-color: #0284c7 !important; color: #ffffff !important;" title="@secondaryLabel Meeting / Internal">
                                                            <i class="bi bi-door-open me-0.5"></i>@secondaryLabel.ToUpper()
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge py-0 px-1 fw-bold" style="font-size: 0.65rem; background-color: #7c3aed !important; color: #ffffff !important;" title="Internal Club Event">
                                                            <i class="bi bi-shield-shaded me-0.5"></i>CLUB
                                                        </span>
                                                    }
                                                }
                                                else if (payStatus == "Waived")
                                                {
                                                    <span class="badge py-0 px-1 fw-bold" style="font-size: 0.65rem; background-color: #7c3aed !important; color: #ffffff !important; border: 1px solid #6d28d9 !important;" title="Fee Waived">WAIVED</span>
                                                }
                                                else if (payStatus.Contains("Waiver Applied", StringComparison.OrdinalIgnoreCase) || payStatus == "Partially Waived")
                                                {
                                                    <span class="badge py-0 px-1 fw-bold" style="font-size: 0.65rem; background-color: #9333ea !important; color: #ffffff !important; border: 1px solid #7e22ce !important;" title="@payStatus">WAIVED+</span>
                                                }
                                                else if (payStatus == "Paid")
                                                {
                                                    <span class="badge bg-success text-white py-0 px-1 border border-success-subtle fw-bold" style="font-size: 0.65rem;" title="Paid in Full">PAID</span>
                                                }
                                                else if (payStatus == "Deposit Paid")
                                                {
                                                    <span class="badge py-0 px-1 fw-bold" style="font-size: 0.65rem; background-color: #0284c7 !important; color: #ffffff !important; border: 1px solid #0369a1 !important;" title="Security Deposit Received">DEP PAID</span>
                                                }
                                                else if (payStatus == "Partial")
                                                {
                                                    <span class="badge py-0 px-1 fw-bold" style="font-size: 0.65rem; background-color: #d97706 !important; color: #ffffff !important; border: 1px solid #b45309 !important;" title="Partially Paid">PARTIAL</span>
                                                }
                                                <span class="event-title-text text-truncate">@GetCleanTitle(evt)</span>
                                            </div>
                                        }
                                        else
                                        {
                                            <!-- Dynamic Multi-Line Card View based on Configured Order & Visibility -->
                                            <div class="event-multiline-card @(isClub ? "card-club" : (isPending ? "card-warning" : "card-primary"))" @onclick="() => ShowEventDetails(evt)" title="@evt.Title">
                                                @if (isClub)
                                                {
                                                    <div class="card-row-item d-flex align-items-center justify-content-between">
                                                        @if (isSecSpace)
                                                        {
                                                            <span class="badge py-0 px-1.5 fw-bold" style="font-size: 0.65rem; background-color: #0284c7 !important; color: #ffffff !important;">
                                                                <i class="bi bi-door-open me-1"></i>@secondaryLabel.ToUpper()
                                                            </span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge py-0 px-1.5 fw-bold" style="font-size: 0.65rem; background-color: #7c3aed !important; color: #ffffff !important;">
                                                                <i class="bi bi-shield-shaded me-1"></i>CLUB EVENT
                                                            </span>
                                                        }
                                                    </div>
                                                }
                                                @foreach (var field in monthFields)
                                                {
                                                    var fieldVal = GetMonthGridFieldValue(evt, field.FieldKey, appData, payStatus);
                                                    if (!string.IsNullOrWhiteSpace(fieldVal))
                                                    {
                                                        if (field.FieldKey == "event_status")
                                                        {
                                                            if (!isClub)
                                                            {
                                                                <div class="card-row-item">
                                                                    @if (fieldVal == "Pending")
                                                                    {
                                                                        <span class="badge py-0 px-1 fw-bold" style="font-size: 0.65rem; background-color: #fef3c7 !important; color: #78350f !important; border: 1px solid #d97706 !important;">
                                                                            <i class="bi bi-hourglass-split me-1 text-warning"></i>PENDING
                                                                        </span>
                                                                    }
                                                                    else if (fieldVal == "Approved")
                                                                    {
                                                                        <span class="badge bg-success-subtle text-success border border-success py-0 px-1 fw-bold" style="font-size: 0.65rem;">
                                                                            <i class="bi bi-check-circle-fill me-1"></i>APPROVED
                                                                        </span>
                                                                    }
                                                                    else if (fieldVal == "Inquiry")
                                                                    {
                                                                        <span class="badge bg-info text-dark border border-info py-0 px-1 fw-bold" style="font-size: 0.65rem;">
                                                                            <i class="bi bi-question-diamond-fill me-1 text-primary"></i>INQUIRY
                                                                        </span>
                                                                    }
                                                                    else if (fieldVal == "Cancelled")
                                                                    {
                                                                        <span class="badge bg-danger text-white border border-danger py-0 px-1 fw-bold" style="font-size: 0.65rem;">
                                                                            <i class="bi bi-x-circle me-1"></i>CANCELLED
                                                                        </span>
                                                                    }
                                                                    else
                                                                    {
                                                                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle py-0 px-1 fw-semibold" style="font-size: 0.65rem;">
                                                                            @fieldVal.ToUpper()
                                                                        </span>
                                                                    }
                                                                </div>
                                                            }
                                                        }
                                                        else if (field.FieldKey == "payment_status")
                                                        {
                                                            if (!isClub)
                                                            {
                                                                <div class="card-row-item">
                                                                    @if (payStatus == "Waived")
                                                                    {
                                                                        <span class="badge py-0 px-1 fw-bold" style="font-size: 0.65rem; background-color: #7c3aed !important; color: #ffffff !important; border: 1px solid #6d28d9 !important;">WAIVED</span>
                                                                    }
                                                                    else if (payStatus.Contains("Waiver", StringComparison.OrdinalIgnoreCase) || payStatus == "Partially Waived")
                                                                    {
                                                                        <span class="badge py-0 px-1 fw-bold" style="font-size: 0.65rem; background-color: #9333ea !important; color: #ffffff !important; border: 1px solid #7e22ce !important;">WAIVED+</span>
                                                                    }
                                                                    else if (payStatus == "Paid")
                                                                    {
                                                                        <span class="badge bg-success text-white py-0 px-1 fw-bold" style="font-size: 0.65rem;">PAID FULL</span>
                                                                    }
                                                                    else if (payStatus == "Deposit Paid")
                                                                    {
                                                                        <span class="badge py-0 px-1 fw-bold" style="font-size: 0.65rem; background-color: #0284c7 !important; color: #ffffff !important;">DEP PAID</span>
                                                                    }
                                                                    else if (payStatus == "Partial")
                                                                    {
                                                                        <span class="badge py-0 px-1 fw-bold" style="font-size: 0.65rem; background-color: #d97706 !important; color: #ffffff !important;">PARTIAL</span>
                                                                    }
                                                                    else
                                                                    {
                                                                        <span class="badge bg-secondary-subtle text-secondary border py-0 px-1 fw-semibold" style="font-size: 0.65rem;">UNPAID</span>
                                                                    }
                                                                </div>
                                                            }
                                                        }
                                                        else if (field.FieldKey == "time_window")
                                                        {
                                                            <div class="card-row-item fw-bold text-dark" style="font-size: 0.72rem;">
                                                                <i class="bi bi-clock me-1 text-primary"></i>@fieldVal
                                                            </div>
                                                        }
                                                        else if (field.FieldKey == "submission_age")
                                                        {
                                                            var ageInfo = GetSubmissionAgeInfo(evt, appData, payStatus);
                                                            if (!string.IsNullOrEmpty(ageInfo.text))
                                                            {
                                                                <div class="card-row-item" title="@ageInfo.tooltip">
                                                                    @if (ageInfo.isOverdue)
                                                                    {
                                                                        <span class="badge bg-danger text-white py-0 px-1 fw-bold shadow-sm" style="font-size: 0.65rem;">
                                                                            <i class="bi bi-exclamation-circle-fill me-1"></i>@fieldVal
                                                                        </span>
                                                                    }
                                                                    else if (ageInfo.badgeClass.Contains("badge-expiring-soon"))
                                                                    {
                                                                        <span class="badge py-0 px-1 fw-bold shadow-sm" style="font-size: 0.65rem; background-color: #fef3c7 !important; color: #92400e !important; border: 1px solid #f59e0b !important;">
                                                                            <i class="bi bi-hourglass-split me-1 text-warning"></i>@fieldVal
                                                                        </span>
                                                                    }
                                                                    else
                                                                    {
                                                                        <span class="badge bg-success bg-opacity-10 text-success border border-success py-0 px-1 fw-semibold" style="font-size: 0.65rem;">
                                                                            <i class="bi bi-stopwatch me-1"></i>@fieldVal
                                                                        </span>
                                                                    }
                                                                </div>
                                                            }
                                                        }
                                                        else if (field.FieldKey == "applicant_name")
                                                        {
                                                            <div class="card-row-item fw-bold text-dark text-truncate" style="font-size: 0.75rem;">
                                                                @fieldVal
                                                            </div>
                                                        }
                                                        else if (field.FieldKey == "event_type")
                                                        {
                                                            <div class="card-row-item text-muted text-truncate" style="font-size: 0.7rem;">
                                                                <i class="bi bi-tag me-1"></i>@fieldVal
                                                            </div>
                                                        }
                                                        else if (field.FieldKey == "room_location")
                                                        {
                                                            <div class="card-row-item text-secondary text-truncate" style="font-size: 0.7rem;">
                                                                <i class="bi bi-geo-alt me-1"></i>@fieldVal
                                                            </div>
                                                        }
                                                        else if (field.FieldKey == "services")
                                                        {
                                                            <div class="card-row-item text-muted text-truncate" style="font-size: 0.68rem;">
                                                                <i class="bi bi-stars me-1 text-warning"></i>@fieldVal
                                                            </div>
                                                        }
                                                        else
                                                        {
                                                            <div class="card-row-item text-muted text-truncate" style="font-size: 0.7rem;">
                                                                @fieldVal
                                                            </div>
                                                        }
                                                    }
                                                }
                                            </div>
                                        }
                                    }
                                    @if (dayEvents.Count > 3)
                                    {
                                        <div class="more-events-badge" @onclick='() => { _searchTerm = date.ToString("yyyy-MM-dd"); _activeView = "list"; }'>
                                            +@(dayEvents.Count - 3) more
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
        else
        {
            <!-- LIST / SCHEDULE VIEW -->
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    @{
                                        var listColumns = (_webSettings?.ScheduleListColumns ?? WebsiteSettings.GetDefaultScheduleListColumns())
                                            .Where(c => c.IsEnabled)
                                            .OrderBy(c => c.Order)
                                            .ToList();
                                    }
                                    @foreach (var col in listColumns)
                                    {
                                        <th style="@GetScheduleColumnWidthStyle(col.FieldKey)">@col.Label</th>
                                    }
                                    <th style="width: 90px;" class="text-end">Details</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    var filteredEvents = GetFilteredEvents();
                                }
                                @if (!filteredEvents.Any())
                                {
                                    <tr>
                                        <td colspan="@(listColumns.Count + 1)" class="text-center py-5 text-muted">
                                            <i class="bi bi-calendar-x fs-2 d-block mb-2 text-secondary"></i>
                                            No events found matching your filter criteria.
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var evt in filteredEvents)
                                    {
                                        var isClub = IsClubEvent(evt);
                                        var details = ParseApplicationDetails(evt);
                                        var paySummary = GetEventPaymentSummary(evt);
                                        var matchedReq = isClub ? null : FindMatchingRentalRequest(evt);
                                        var isArchivedInquiry = string.Equals(evt.Status, "ARCHIVED", StringComparison.OrdinalIgnoreCase) || evt.Title.StartsWith("ARCHIVED INQUIRY", StringComparison.OrdinalIgnoreCase);
                                        var isInquiry = !isArchivedInquiry && (string.Equals(evt.Status, "INQUIRY", StringComparison.OrdinalIgnoreCase) || string.Equals(evt.Status, "RESPONDED", StringComparison.OrdinalIgnoreCase) || evt.Title.StartsWith("INQUIRY", StringComparison.OrdinalIgnoreCase));
                                        var isCancelled = string.Equals(evt.Status, "CANCELLED", StringComparison.OrdinalIgnoreCase) || evt.Title.StartsWith("CANCELLED", StringComparison.OrdinalIgnoreCase) || (matchedReq != null && string.Equals(matchedReq.Status, "Cancelled", StringComparison.OrdinalIgnoreCase));
                                        var isApproved = !isClub && !isCancelled && ((matchedReq != null && string.Equals(matchedReq.Status, "Approved", StringComparison.OrdinalIgnoreCase)) || evt.Title.StartsWith("APPROVED", StringComparison.OrdinalIgnoreCase) || string.Equals(evt.Status, "CONFIRMED", StringComparison.OrdinalIgnoreCase));
                                        var isPending = !isClub && !isInquiry && !isArchivedInquiry && !isApproved && !isCancelled && (evt.Title.StartsWith("PENDING", StringComparison.OrdinalIgnoreCase) || string.Equals(evt.Status, "PENDING", StringComparison.OrdinalIgnoreCase) || (matchedReq != null && string.Equals(matchedReq.Status, "Pending", StringComparison.OrdinalIgnoreCase)));
                                        bool hasCallRequested = !isClub && (details.RequestPhoneCall ||
                                            (matchedReq != null && (matchedReq.RequestPhoneCall || string.Equals(matchedReq.PreferredContactMethod, "Phone", StringComparison.OrdinalIgnoreCase) || matchedReq.InternalNotes?.Contains("Call", StringComparison.OrdinalIgnoreCase) == true || matchedReq.EventDescription?.Contains("call", StringComparison.OrdinalIgnoreCase) == true)) ||
                                            (evt.Description != null && (evt.Description.Contains("Call Requested", StringComparison.OrdinalIgnoreCase) || evt.Description.Contains("Phone Callback Requested: Yes", StringComparison.OrdinalIgnoreCase) || evt.Description.Contains("Preferred Contact Method: Phone", StringComparison.OrdinalIgnoreCase) || evt.Description.Contains("Request Phone Call: Yes", StringComparison.OrdinalIgnoreCase))));

                                        <tr class="@(isArchivedInquiry ? "table-secondary bg-opacity-10 opacity-75" : (isInquiry ? (hasCallRequested ? "table-success bg-opacity-10" : "table-info bg-opacity-10") : (isCancelled ? "table-danger bg-opacity-10" : "")))">
                                            @foreach (var col in listColumns)
                                            {
                                                switch (col.FieldKey)
                                                {
                                                    case "event_date":
                                                        <td class="fw-semibold">
                                                            @if (evt.Start.Year > 2000)
                                                            {
                                                                <span>@evt.Start.ToString("MMM dd, yyyy")</span>
                                                            }
                                                            else
                                                            {
                                                                <span class="badge bg-secondary">Unspecified Date</span>
                                                            }
                                                        </td>
                                                        break;

                                                    case "time_window":
                                                        <td class="text-muted small">
                                                            @if (isInquiry || isArchivedInquiry)
                                                            {
                                                                <span class="text-muted small">—</span>
                                                            }
                                                            else
                                                            {
                                                                @(evt.IsAllDay ? "All-Day Event" : $"{evt.Start:h:mm tt} - {evt.End:h:mm tt}")
                                                            }
                                                        </td>
                                                        break;

                                                    case "event_status":
                                                        <td>
                                                            @if (isClub)
                                                            {
                                                                var secondaryLabel = _webSettings?.SecondaryFlexibleLocation ?? "Office";
                                                                var evtRoomNorm = NormalizeRoomName(evt.Location);
                                                                var isSecSpace = evtRoomNorm != NormalizeRoomName(_webSettings?.ManagedRentalLocation ?? "Function Hall") && evtRoomNorm != "entire facility";
                                                                if (isSecSpace)
                                                                {
                                                                    <span class="badge py-1 px-2 rounded-pill fw-bold shadow-sm" style="background-color: #0284c7 !important; color: #ffffff !important;">
                                                                        <i class="bi bi-door-open me-1"></i>@secondaryLabel
                                                                    </span>
                                                                }
                                                                else
                                                                {
                                                                    <span class="badge bg-primary text-white border border-primary px-2 py-1 rounded-pill fw-bold shadow-sm">
                                                                        <i class="bi bi-shield-shaded me-1"></i>Club Event
                                                                    </span>
                                                                }
                                                            }
                                                            else if (isArchivedInquiry)
                                                            {
                                                                <span class="badge bg-secondary-subtle text-secondary border border-secondary px-2 py-1 rounded-pill fw-bold shadow-sm">
                                                                    <i class="bi bi-archive-fill me-1 text-secondary"></i>Archived FAQ
                                                                </span>
                                                            }
                                                            else if (isInquiry)
                                                            {
                                                                @if (hasCallRequested)
                                                                {
                                                                    <span class="badge bg-success text-white border border-success px-2 py-1 rounded-pill fw-bold shadow-sm" title="Inquiry requesting a phone call">
                                                                        <i class="bi bi-telephone-inbound-fill me-1"></i>Inquiry &bull; Call Req
                                                                    </span>
                                                                }
                                                                else
                                                                {
                                                                    <span class="badge bg-info text-dark border border-info px-2 py-1 rounded-pill fw-bold shadow-sm">
                                                                        <i class="bi bi-question-diamond-fill me-1 text-primary"></i>Inquiry
                                                                    </span>
                                                                }
                                                            }
                                                            else if (isCancelled)
                                                            {
                                                                <span class="badge bg-danger text-white border border-danger px-2 py-1 rounded-pill fw-bold shadow-sm">
                                                                    <i class="bi bi-x-circle me-1"></i>Cancelled
                                                                </span>
                                                            }
                                                            else if (isPending)
                                                            {
                                                                <span class="badge px-2 py-1 rounded-pill" style="background-color: #fef3c7 !important; color: #78350f !important; font-weight: 700; border: 1px solid #d97706 !important;">
                                                                    <i class="bi bi-hourglass-split me-1 text-warning"></i>Pending
                                                                </span>
                                                            }
                                                            else if (isApproved)
                                                            {
                                                                <span class="badge bg-success-subtle text-success border border-success px-2 py-1 rounded-pill">
                                                                    <i class="bi bi-check-circle-fill me-1"></i>Approved
                                                                </span>
                                                            }
                                                            else
                                                            {
                                                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1 rounded-pill">
                                                                    @(evt.Status ?? "CONFIRMED")
                                                                </span>
                                                            }
                                                        </td>
                                                        break;

                                                    case "payment_status":
                                                        <td>
                                                            @if (isClub || isInquiry || isArchivedInquiry)
                                                            {
                                                                <span class="text-muted small">—</span>
                                                            }
                                                            else if (paySummary.Status == "Waived")
                                                            {
                                                                <span class="badge px-2 py-1 rounded-pill fw-bold shadow-sm" style="background-color: #7c3aed !important; color: #ffffff !important; border: 1px solid #6d28d9 !important;">
                                                                    <i class="bi bi-gift-fill me-1"></i>Waived
                                                                </span>
                                                            }
                                                            else if (paySummary.Status.Contains("Waiver", StringComparison.OrdinalIgnoreCase) || paySummary.Status == "Partially Waived")
                                                            {
                                                                <span class="badge px-2 py-1 rounded-pill fw-bold shadow-sm" style="background-color: #9333ea !important; color: #ffffff !important; border: 1px solid #7e22ce !important;">
                                                                    <i class="bi bi-gift-fill me-1"></i>Waived ($@paySummary.AmountWaived.ToString("N0"))
                                                                </span>
                                                            }
                                                            else if (paySummary.Status == "Paid")
                                                            {
                                                                <span class="badge bg-success text-white px-2 py-1 rounded-pill fw-bold shadow-sm">
                                                                    <i class="bi bi-check-circle-fill me-1"></i>Paid Full
                                                                </span>
                                                            }
                                                            else if (paySummary.Status == "Deposit Paid")
                                                            {
                                                                <span class="badge px-2 py-1 rounded-pill fw-bold shadow-sm" style="background-color: #0284c7 !important; color: #ffffff !important; border: 1px solid #0369a1 !important;">
                                                                    <i class="bi bi-shield-check me-1"></i>Dep Paid
                                                                </span>
                                                            }
                                                            else if (paySummary.Status == "Partial")
                                                            {
                                                                <span class="badge px-2 py-1 rounded-pill fw-bold shadow-sm" style="background-color: #d97706 !important; color: #ffffff !important; border: 1px solid #b45309 !important;">
                                                                    <i class="bi bi-pie-chart me-1"></i>Partial ($@paySummary.TotalPaid.ToString("N0"))
                                                                </span>
                                                            }
                                                            else
                                                            {
                                                                <span class="badge bg-light text-dark border border-secondary-subtle px-2 py-1 rounded-pill fw-semibold">
                                                                    Unpaid
                                                                </span>
                                                            }
                                                        </td>
                                                        break;

                                                    case "applicant_name":
                                                        <td>
                                                            @{
                                                                var applicantDisplay = !string.IsNullOrEmpty(details.ApplicantName)
                                                                    ? details.ApplicantName
                                                                    : GetCleanApplicantName(evt);
                                                            }
                                                            <div class="d-flex align-items-center gap-1.5 flex-wrap">
                                                                <span class="fw-bold text-dark">@applicantDisplay</span>
                                                                @if (hasCallRequested)
                                                                {
                                                                    <span class="badge bg-success text-white py-0.5 px-2 rounded-pill shadow-sm d-inline-flex align-items-center gap-1" style="font-size: 0.68rem;" title="Applicant requested a phone call / callback">
                                                                        <i class="bi bi-telephone-inbound-fill"></i> Call Requested
                                                                    </span>
                                                                }
                                                            </div>
                                                        </td>
                                                        break;

                                                    case "event_type":
                                                        <td>
                                                            @if (!string.IsNullOrEmpty(details.EventType))
                                                            {
                                                                <span class="badge bg-light text-dark border">@details.EventType</span>
                                                            }
                                                            else
                                                            {
                                                                <span class="text-muted small">—</span>
                                                            }
                                                        </td>
                                                        break;

                                                    case "calendar_source":
                                                        <td>
                                                            <span class="badge bg-light text-dark border px-2 py-1">
                                                                <i class="bi bi-calendar2-range me-1 text-primary"></i>@evt.Source
                                                            </span>
                                                        </td>
                                                        break;

                                                    case "room_location":
                                                        <td>
                                                            <span class="text-muted small">@(string.IsNullOrEmpty(evt.Location) ? "Main Function Hall" : evt.Location)</span>
                                                        </td>
                                                        break;

                                                    case "services":
                                                        <td>
                                                            @{
                                                                var svcs = GetEventServicesSummary(details, evt);
                                                            }
                                                            @if (!string.IsNullOrWhiteSpace(svcs))
                                                            {
                                                                <span class="text-dark small"><i class="bi bi-stars text-warning me-1"></i>@svcs</span>
                                                            }
                                                            else
                                                            {
                                                                <span class="text-muted small">—</span>
                                                            }
                                                        </td>
                                                        break;

                                                    case "guest_count":
                                                        <td>
                                                            @if (!string.IsNullOrWhiteSpace(details.GuestCount))
                                                            {
                                                                <span class="badge bg-light text-dark border"><i class="bi bi-people me-1"></i>@details.GuestCount</span>
                                                            }
                                                            else
                                                            {
                                                                <span class="text-muted small">—</span>
                                                            }
                                                        </td>
                                                        break;

                                                    case "pricing_quote":
                                                        <td>
                                                            @if (paySummary.TotalPrice > 0)
                                                            {
                                                                <span class="fw-bold text-success">${paySummary.TotalPrice:N0}</span>
                                                            }
                                                            else
                                                            {
                                                                <span class="text-muted small">—</span>
                                                            }
                                                        </td>
                                                        break;

                                                    case "contact_phone":
                                                        <td>
                                                            @if (!string.IsNullOrWhiteSpace(details.Phone))
                                                            {
                                                                <div class="d-flex align-items-center gap-1">
                                                                    <a href="tel:@details.Phone" class="text-decoration-none text-muted small"><i class="bi bi-telephone me-1"></i>@FormatPhoneNumber(details.Phone)</a>
                                                                    @if (hasCallRequested)
                                                                    {
                                                                        <span class="badge bg-success-subtle text-success border border-success px-1.5 py-0.5 rounded-pill" style="font-size:0.65rem;" title="Phone Callback Requested">
                                                                            <i class="bi bi-telephone-inbound-fill"></i> Callback
                                                                        </span>
                                                                    }
                                                                </div>
                                                            }
                                                            else
                                                            {
                                                                <span class="text-muted small">—</span>
                                                            }
                                                        </td>
                                                        break;

                                                    case "submission_age":
                                                        <td>
                                                            @{
                                                                var ageInfo = GetSubmissionAgeInfo(evt, details, paySummary.Status);
                                                            }
                                                            @if (!string.IsNullOrEmpty(ageInfo.text))
                                                            {
                                                                @if (ageInfo.isOverdue)
                                                                {
                                                                    <span class="badge bg-danger text-white border border-danger px-2 py-1 rounded-pill fw-bold shadow-sm" title="@ageInfo.tooltip">
                                                                        <i class="bi bi-exclamation-octagon-fill me-1"></i>@ageInfo.text
                                                                    </span>
                                                                }
                                                                else if (ageInfo.badgeClass.Contains("badge-expiring-soon"))
                                                                {
                                                                    <span class="badge px-2 py-1 rounded-pill fw-bold shadow-sm" style="background-color: #fef3c7 !important; color: #92400e !important; border: 1px solid #f59e0b !important;" title="@ageInfo.tooltip">
                                                                        <i class="bi bi-hourglass-split me-1 text-warning"></i>@ageInfo.text
                                                                    </span>
                                                                }
                                                                else
                                                                {
                                                                    <span class="badge bg-success bg-opacity-10 text-success border border-success px-2 py-1 rounded-pill fw-semibold shadow-sm" title="@ageInfo.tooltip">
                                                                        <i class="bi bi-stopwatch me-1"></i>@ageInfo.text
                                                                    </span>
                                                                }
                                                            }
                                                            else
                                                            {
                                                                <span class="text-muted small">—</span>
                                                            }
                                                        </td>
                                                        break;

                                                    case "contact_email":
                                                        <td>
                                                            @if (!string.IsNullOrWhiteSpace(details.Email))
                                                            {
                                                                <a href="mailto:@details.Email" class="text-decoration-none text-muted small"><i class="bi bi-envelope me-1"></i>@details.Email</a>
                                                            }
                                                            else
                                                            {
                                                                <span class="text-muted small">—</span>
                                                            }
                                                        </td>
                                                        break;

                                                    default:
                                                        <td>
                                                            <span class="text-muted small">—</span>
                                                        </td>
                                                        break;
                                                }
                                            }
                                            <td class="text-end">
                                                <button class="btn btn-sm btn-outline-primary rounded-pill px-3 shadow-sm" @onclick="() => ShowEventDetails(evt)">
                                                    <i class="bi bi-eye me-1"></i>View
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
    }
</div>

<!-- ========================================================================= -->
<!-- EVENT DETAILS MODAL (BEAUTIFULLY FORMATTED & EASY TO READ) -->
<!-- ========================================================================= -->
@if (_selectedEvent != null && !_isCalendarOnlyMode)
{
    var appDetails = ParseApplicationDetails(_selectedEvent);
    var cleanTitle = GetCleanTitle(_selectedEvent);
    var isPending = (_selectedRequest != null && string.Equals(_selectedRequest.Status, "Pending", StringComparison.OrdinalIgnoreCase)) ||
                    _selectedEvent.Title.Contains("PENDING", StringComparison.OrdinalIgnoreCase);
    var isApproved = (_selectedRequest != null && string.Equals(_selectedRequest.Status, "Approved", StringComparison.OrdinalIgnoreCase)) ||
                     _selectedEvent.Title.Contains("APPROVED", StringComparison.OrdinalIgnoreCase);
    var isInquiry = (_selectedRequest != null && (string.Equals(_selectedRequest.Status, "Inquiry", StringComparison.OrdinalIgnoreCase) || string.Equals(_selectedRequest.Status, "Responded", StringComparison.OrdinalIgnoreCase))) ||
                    _selectedEvent.Title.Contains("INQUIRY", StringComparison.OrdinalIgnoreCase) ||
                    _selectedEvent.Source == "General Inquiry";
    var isCancelled = (_selectedRequest != null && string.Equals(_selectedRequest.Status, "Cancelled", StringComparison.OrdinalIgnoreCase)) ||
                      _selectedEvent.Title.Contains("CANCELLED", StringComparison.OrdinalIgnoreCase);

    string effectiveName = !string.IsNullOrWhiteSpace(_selectedRequest?.ApplicantName)
        ? _selectedRequest.ApplicantName
        : (!string.IsNullOrWhiteSpace(appDetails.ApplicantName) ? appDetails.ApplicantName : cleanTitle);

    string? effectivePhone = !string.IsNullOrWhiteSpace(_selectedRequest?.RequesterPhone)
        ? _selectedRequest.RequesterPhone
        : appDetails.Phone;

    string? effectiveEmail = !string.IsNullOrWhiteSpace(_selectedRequest?.RequesterEmail)
        ? _selectedRequest.RequesterEmail
        : appDetails.Email;

    string? effectiveAddress = !string.IsNullOrWhiteSpace(_selectedRequest?.RequesterAddress)
        ? $"{_selectedRequest.RequesterAddress}{(!string.IsNullOrWhiteSpace(_selectedRequest.RequesterCity) ? $", {_selectedRequest.RequesterCity}" : "")}{(!string.IsNullOrWhiteSpace(_selectedRequest.RequesterState) ? $", {_selectedRequest.RequesterState}" : "")}{(!string.IsNullOrWhiteSpace(_selectedRequest.RequesterZip) ? $" {_selectedRequest.RequesterZip}" : "")}"
        : (!string.IsNullOrWhiteSpace(appDetails.StreetAddress)
            ? $"{appDetails.StreetAddress}{(string.IsNullOrWhiteSpace(appDetails.City) ? "" : $", {appDetails.City}")}{(string.IsNullOrWhiteSpace(appDetails.State) ? "" : $", {appDetails.State}")}{(string.IsNullOrWhiteSpace(appDetails.Zip) ? "" : $" {appDetails.Zip}")}"
            : null);

    bool? isMemberVal = _selectedRequest != null
        ? _selectedRequest.MemberStatus
        : (!string.IsNullOrEmpty(appDetails.IsClubMember) ? appDetails.IsClubMember.ToLower().StartsWith("y") : null);

    var modalPaySummary = GetEventPaymentSummary(_selectedEvent);

    string? effectiveTimestamp = _selectedRequest != null && _selectedRequest.CreatedDate.Year > 2000
        ? _selectedRequest.CreatedDate.ToLocalTime().ToString("MMMM dd, yyyy 'at' h:mm tt")
        : (!string.IsNullOrEmpty(appDetails.FormattedTimestamp) ? appDetails.FormattedTimestamp : appDetails.Timestamp);

    string? effectiveSignature = !string.IsNullOrWhiteSpace(_selectedRequest?.ApplicantSignature)
        ? _selectedRequest.ApplicantSignature
        : (!string.IsNullOrWhiteSpace(appDetails.ApplicantSignature) ? appDetails.ApplicantSignature : "Electronic Acceptance");

    var acceptedPoliciesList = GetAcceptedPoliciesForDisplay(_selectedRequest, appDetails);
    var memberVerify = VerifyApplicantMembership(effectiveName, effectiveEmail, effectivePhone);
    bool claimedMember = isMemberVal == true;
    bool isClub = IsClubEvent(_selectedEvent);
    bool isBlackoutBlocked = (_selectedEvent.Description != null && _selectedEvent.Description.Contains("Block Out Rental Slots: Yes", StringComparison.OrdinalIgnoreCase)) ||
                             (appDetails.EventDescription != null && appDetails.EventDescription.Contains("Block Out Rental Slots: Yes", StringComparison.OrdinalIgnoreCase));

    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.65);" role="dialog">
        <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable" role="document">
            <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
                <!-- Modal Header -->
                <div class="modal-header bg-light border-bottom p-3 px-4">
                    <div class="d-flex align-items-center gap-3">
                        <div class="p-2 rounded-3 @(isInquiry ? "bg-info bg-opacity-25 text-info-emphasis" : (isClub ? "bg-primary bg-opacity-10 text-primary" : (isPending ? "bg-warning bg-opacity-25 text-warning-emphasis" : (isCancelled ? "bg-danger bg-opacity-10 text-danger" : "bg-primary bg-opacity-10 text-primary"))))">
                            <i class="bi @(isInquiry ? "bi-question-diamond-fill" : (isClub ? "bi-shield-shaded" : (isPending ? "bi-hourglass-split" : (isCancelled ? "bi-x-circle-fill" : "bi-calendar-event-fill")))) fs-4"></i>
                        </div>
                        <div>
                            <div class="d-flex align-items-center gap-2 mb-1 flex-wrap">
                                <h5 class="modal-title fw-bold mb-0 text-dark">@cleanTitle</h5>
                                @if (isInquiry)
                                {
                                    <span class="badge bg-info text-dark fw-bold"><i class="bi bi-question-diamond-fill me-1"></i>PRE-BOOKING QUESTION / INQUIRY</span>
                                }
                                else if (isClub)
                                {
                                    var secondaryLabel = _webSettings?.SecondaryFlexibleLocation ?? "Office";
                                    var evtRoomNorm = NormalizeRoomName(_selectedEvent.Location);
                                    var isSecSpace = evtRoomNorm != NormalizeRoomName(_webSettings?.ManagedRentalLocation ?? "Function Hall") && evtRoomNorm != "entire facility";
                                    if (isSecSpace)
                                    {
                                        <span class="badge text-white fw-bold" style="background-color: #0284c7 !important;">
                                            <i class="bi bi-door-open-fill me-1"></i>@secondaryLabel.ToUpper() / INTERNAL
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-primary"><i class="bi bi-shield-shaded me-1"></i>CLUB EVENT</span>
                                    }
                                }
                                else if (isPending)
                                {
                                    <span class="badge bg-warning text-dark fw-bold">PENDING REVIEW</span>
                                }
                                else if (isApproved)
                                {
                                    <span class="badge bg-success">APPROVED</span>
                                }
                                else if (isCancelled)
                                {
                                    <span class="badge bg-danger">CANCELLED</span>
                                }
                                else
                                {
                                    <span class="badge bg-primary">SCHEDULED</span>
                                }
                                @if (_isEditingBooking)
                                {
                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle"><i class="bi bi-pencil me-1"></i>EDIT MODE</span>
                                }
                            </div>
                            <div class="text-muted small">Calendar Source: <strong>@_selectedEvent.Source</strong></div>
                        </div>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        @if (isInquiry)
                        {
                            <button type="button" class="btn btn-outline-primary btn-sm rounded-pill px-3 shadow-sm d-flex align-items-center gap-1" @onclick="SwitchToCalendarFromDetailsModal" title="Close and view on full Calendar Grid">
                                <i class="bi bi-calendar3"></i>
                                <span class="fw-semibold">View Calendar</span>
                            </button>
                            <button type="button" class="btn btn-primary btn-sm rounded-pill px-3 shadow-sm d-flex align-items-center gap-1 fw-bold" @onclick="OpenReplyToInquiryModal" title="Compose and email reply directly to visitor">
                                <i class="bi bi-reply-fill"></i>
                                <span>Reply to Inquiry</span>
                            </button>
                            <button type="button" class="btn btn-outline-dark btn-sm rounded-pill px-3 shadow-sm d-flex align-items-center gap-1" @onclick="PrintSelectedApplication" title="Print inquiry or save as PDF">
                                <i class="bi bi-printer-fill text-primary"></i>
                                <span class="fw-semibold">Print / PDF</span>
                            </button>
                        }
                        else if (!isClub)
                        {
                            @if (!_isEditingBooking)
                            {
                                <button type="button" class="btn btn-outline-primary btn-sm rounded-pill px-3 shadow-sm d-flex align-items-center gap-1" @onclick="SwitchToCalendarFromDetailsModal" title="Close and view on full Calendar Grid">
                                <i class="bi bi-calendar3"></i>
                                <span class="fw-semibold">View Calendar</span>
                            </button>
                            <button type="button" class="btn btn-primary btn-sm rounded-pill px-3 shadow-sm d-flex align-items-center gap-1" @onclick="EnterBookingEditMode" title="Modify booking specs, room, services & prices">
                                <i class="bi bi-pencil-square"></i>
                                <span class="fw-semibold">Modify Booking &amp; Prices</span>
                            </button>
                            <button type="button" class="btn btn-outline-info text-dark btn-sm rounded-pill px-3 shadow-sm d-flex align-items-center gap-1" @onclick="OpenResendQuoteConfirmation" disabled="@_isResendingQuote" title="Email latest updated event details & quote to applicant">
                                <i class="bi bi-envelope-paper-fill text-primary"></i>
                                <span class="fw-semibold">Email Event / Quote</span>
                            </button>
                            <button type="button" class="btn btn-outline-dark btn-sm rounded-pill px-3 shadow-sm d-flex align-items-center gap-1" @onclick="PrintSelectedApplication" title="Print application or save as PDF">
                                <i class="bi bi-printer-fill text-primary"></i>
                                <span class="fw-semibold">Print / PDF</span>
                            </button>
                        }
                        else
                        {
                            <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill px-3 shadow-sm" @onclick="CancelBookingEditMode">
                                <i class="bi bi-x-lg me-1"></i>Cancel Edit
                            </button>
                            <button type="button" class="btn btn-primary btn-sm rounded-pill px-3 shadow-sm fw-bold" @onclick="InitiateSaveBookingChanges">
                                <i class="bi bi-check-lg me-1"></i>Review &amp; Save
                            </button>
                        }
                    }
                    else
                    {
                            <button type="button" class="btn btn-outline-primary btn-sm rounded-pill px-3 shadow-sm d-flex align-items-center gap-1" @onclick="SwitchToCalendarFromDetailsModal" title="Close and view on full Calendar Grid">
                                <i class="bi bi-calendar3"></i>
                                <span class="fw-semibold">View Calendar</span>
                            </button>
                            <button type="button" class="btn btn-primary btn-sm rounded-pill px-3 shadow-sm d-flex align-items-center gap-1" @onclick="() => OpenEditEventModal(_selectedEvent)" title="Edit Club Event">
                                <i class="bi bi-pencil-square"></i>
                                <span class="fw-semibold">Edit Event</span>
                            </button>
                        }
                        <button type="button" class="btn-close" @onclick="CloseEventDetailsModal"></button>
                    </div>
                </div>

                <!-- Modal Body -->
                <div class="modal-body p-4">
                    @if (_isEditingBooking && _selectedRequest != null)
                    {
                        <!-- ========================================================= -->
                        <!-- DIRECT EDITING WORKSPACE / FORM -->
                        <!-- ========================================================= -->
                        <!-- 1. EDIT FINANCIALS & PRICE OVERRIDE CARD (STICKY TOP) -->
                        <div class="card border rounded-3 mb-3 shadow-sm bg-white sticky-top-card">
                            <div class="card-header section-header-success py-2 px-3 fw-bold d-flex justify-content-between align-items-center">
                                <span><i class="bi bi-currency-dollar text-success me-2 fs-5"></i>Agreed Price &amp; Security Deposit</span>
                                <button type="button" class="btn btn-outline-success btn-sm fw-semibold shadow-sm" @onclick="AutoCalculateSelectedRequestPrice" title="Recalculate price based on room & active add-ons">
                                    <i class="bi bi-calculator me-1"></i>Auto-Calc Quote
                                </button>
                            </div>
                            <div class="card-body p-3">
                                <div class="row g-3">
                                    <div class="@(_webSettings?.RequireSecurityDeposit == true ? "col-md-6" : "col-12")">
                                        <label class="form-label small fw-bold text-dark mb-1">Agreed Total Price ($)</label>
                                        <div class="input-group">
                                            <span class="input-group-text">$</span>
                                            <input type="number" step="0.01" class="form-control form-control-lg fw-bold text-success" @bind="_selectedRequest.TotalPrice" />
                                            <button type="button" class="btn btn-outline-secondary" @onclick="AutoCalculateSelectedRequestPrice" title="Reset to standard quote based on selections">
                                                <i class="bi bi-arrow-clockwise me-1"></i>Auto-Calc
                                            </button>
                                        </div>
                                        <small class="text-muted">Enter any custom agreed price, discount, or waiver.</small>
                                    </div>
                                    @if (_webSettings?.RequireSecurityDeposit == true)
                                    {
                                        <div class="col-md-6">
                                            <label class="form-label small fw-bold text-dark mb-1">Security Deposit Required ($)</label>
                                            <div class="input-group">
                                                <span class="input-group-text">$</span>
                                                <input type="number" step="0.01" class="form-control form-control-lg fw-bold text-warning-emphasis" @bind="_selectedRequest.SecurityDepositAmount" />
                                            </div>
                                            <small class="text-muted">Refundable security deposit amount.</small>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>

                        <div class="alert alert-primary d-flex align-items-center justify-content-between p-3 rounded-3 mb-3 shadow-sm border border-primary-subtle">
                            <div class="d-flex align-items-center gap-2">
                                <i class="bi bi-info-circle-fill fs-5 text-primary"></i>
                                <div>
                                    <div class="fw-bold">You are modifying this booking</div>
                                    <small class="text-muted">Adjust any applicant info, schedule, room selection, amenities, or price override below. You will review a summary before saving.</small>
                                </div>
                            </div>
                        </div>

                        <!-- 2. EDIT SCHEDULE & ROOM CARD -->
                        <div class="card border rounded-3 mb-3 shadow-none bg-white">
                            <div class="card-header section-header-primary py-2 px-3 fw-bold d-flex justify-content-between align-items-center">
                                <span><i class="bi bi-calendar-event text-primary me-2 fs-5"></i>Date, Time &amp; Space Selection</span>
                            </div>
                            <div class="card-body p-3">
                                <div class="row g-3">
                                    <div class="col-md-4">
                                        <label class="form-label small fw-bold text-dark mb-1">Event Date</label>
                                        <input type="date" class="form-control" @bind="_selectedRequest.EventDate" />
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label small fw-bold text-dark mb-1">Start Time</label>
                                        <select class="form-select" @bind="_selectedRequest.StartTime">
                                            <option value="">-- Select Start Time --</option>
                                            @if (!string.IsNullOrWhiteSpace(_selectedRequest.StartTime) && !_timeSlotOptions.Any(o => o.Label.Equals(_selectedRequest.StartTime, StringComparison.OrdinalIgnoreCase)))
                                            {
                                                <option value="@_selectedRequest.StartTime">@_selectedRequest.StartTime (Current)</option>
                                            }
                                            @foreach (var opt in _timeSlotOptions)
                                            {
                                                <option value="@opt.Label">@opt.Label</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label small fw-bold text-dark mb-1">End Time</label>
                                        <select class="form-select" @bind="_selectedRequest.EndTime">
                                            <option value="">-- Select End Time --</option>
                                            @if (!string.IsNullOrWhiteSpace(_selectedRequest.EndTime) && !_timeSlotOptions.Any(o => o.Label.Equals(_selectedRequest.EndTime, StringComparison.OrdinalIgnoreCase)))
                                            {
                                                <option value="@_selectedRequest.EndTime">@_selectedRequest.EndTime (Current)</option>
                                            }
                                            @foreach (var opt in _timeSlotOptions)
                                            {
                                                <option value="@opt.Label">@opt.Label</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label small fw-bold text-dark mb-1">Rental Pricing Category</label>
                                        <select class="form-select" @bind="_selectedRequest.RoomSelected" @bind:after="RecalculateEditPriceQuote">
                                            @foreach (var room in (_editableRooms.Any() ? _editableRooms : (_webSettings?.GetRoomsList() ?? new List<RentalRoomOption>())))
                                            {
                                                <option value="@room.Name">@room.Name ($@( _selectedRequest.MemberStatus ? room.MemberRate : room.NonMemberRate))</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="col-md-8">
                                        <label class="form-label small fw-bold text-dark mb-1">Renter Tier (Tier &amp; Day Matrix Rates)</label>
                                        @{
                                            var editTierCards = (_webSettings?.GetTierCardsList() ?? WebsiteSettings.GetDefaultTierCards()).Where(c => c.IsEnabled).ToList();
                                            var editEventDate = _selectedRequest.EventDate.Year > 2000 ? _selectedRequest.EventDate : DateTime.Today;
                                        }
                                        <div class="d-flex align-items-center bg-light border rounded-3 p-1.5 gap-1.5 flex-wrap">
                                            @foreach (var card in editTierCards)
                                            {
                                                var rateForDay = GetCardRateForDate(card, editEventDate);
                                                bool isAvailableOnDay = IsCardAvailableForDate(card, editEventDate);
                                                bool isCardSelected = false;
                                                if (!string.IsNullOrWhiteSpace(_selectedRequest.RenterType))
                                                {
                                                    isCardSelected = string.Equals(_selectedRequest.RenterType, card.Title, StringComparison.OrdinalIgnoreCase) ||
                                                                     string.Equals(_selectedRequest.RenterType, card.Id, StringComparison.OrdinalIgnoreCase) ||
                                                                     string.Equals(_selectedRequest.RenterType, card.AssociatedRenterType, StringComparison.OrdinalIgnoreCase);
                                                }
                                                else
                                                {
                                                    isCardSelected = _selectedRequest.MemberStatus 
                                                        ? string.Equals(card.AssociatedRenterType, "Member", StringComparison.OrdinalIgnoreCase)
                                                        : string.Equals(card.AssociatedRenterType, "Non-Member", StringComparison.OrdinalIgnoreCase);
                                                }

                                                <button type="button" 
                                                        class="btn btn-sm rounded-pill py-1 px-2.5 fw-bold @(isCardSelected ? "btn-primary text-white shadow-sm" : (!isAvailableOnDay ? "btn-light text-muted border opacity-50 text-decoration-line-through" : "btn-white text-secondary border"))" 
                                                        style="font-size: 0.80rem; @(isCardSelected && !string.IsNullOrEmpty(card.ThemeColor) ? $"background-color: {card.ThemeColor} !important; border-color: {card.ThemeColor} !important;" : "")"
                                                        disabled="@(!isAvailableOnDay && !isCardSelected)"
                                                        title="@(!isAvailableOnDay ? $"{card.Title} is not available on {editEventDate:dddd}s" : $"Select {card.Title} (${rateForDay:N0})")"
                                                        @onclick="() => { if (isAvailableOnDay) QuickSetPricingTier(card); }">
                                                    <i class="bi @(isCardSelected ? "bi-check-circle-fill" : (!isAvailableOnDay ? "bi-slash-circle" : "bi-circle")) me-1"></i>
                                                    <span>@card.Title (@(isAvailableOnDay ? $"${rateForDay:N0}" : "N/A on " + editEventDate.ToString("ddd")))</span>
                                                </button>
                                            }
                                        </div>
                                        @if (_selectedRequest.MemberStatus)
                                        {
                                            var editVerify = VerifyApplicantMembership(_selectedRequest.ApplicantName, _selectedRequest.RequesterEmail, _selectedRequest.RequesterPhone);
                                            if (editVerify.IsExactMatch && editVerify.ExactMember != null)
                                            {
                                                var dues = editVerify.DuesStatus;
                                                bool isLife = MemberStatusHelper.IsLifeStatus(editVerify.ExactMember.Status);
                                                bool isDuesCurrent = isLife || (dues != null && !dues.IsOverdue);
                                                <div class="mt-1 small">
                                                    <span class="badge @(isDuesCurrent ? "bg-success" : "bg-danger")">
                                                        <i class="bi bi-person-check-fill me-1"></i>#@editVerify.ExactMember.MemberID (@(isLife ? "Life" : (isDuesCurrent ? "Dues Paid" : "Dues Overdue")))
                                                    </span>
                                                </div>
                                            }
                                            else if (editVerify.SimilarCandidates.Any())
                                            {
                                                <div class="mt-1 small text-warning-emphasis">
                                                    <i class="bi bi-exclamation-triangle me-1"></i>@editVerify.SimilarCandidates.Count similar member(s) found
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="mt-1 small text-danger">
                                                    <i class="bi bi-x-circle me-1"></i>No matching member in directory
                                                </div>
                                            }
                                        }
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label small fw-bold text-dark mb-1">Booking Status</label>
                                        <select class="form-select fw-semibold @(_selectedRequest.Status == "Approved" ? "text-success" : (_selectedRequest.Status == "Cancelled" ? "text-danger" : "text-warning-emphasis"))" @bind="_selectedRequest.Status">
                                            <option value="Pending">Pending Review</option>
                                            <option value="Approved">Approved</option>
                                            <option value="Cancelled">Cancelled</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- 3. EDIT APPLICANT INFO CARD -->
                        <div class="card border rounded-3 mb-3 shadow-none bg-white">
                            <div class="card-header section-header-indigo py-2 px-3 fw-bold d-flex justify-content-between align-items-center">
                                <span><i class="bi bi-person-circle text-primary me-2 fs-5"></i>Applicant &amp; Event Details</span>
                            </div>
                            <div class="card-body p-3">
                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <label class="form-label small fw-bold text-dark mb-1">Applicant / Organization Name</label>
                                        <input type="text" class="form-control" @bind="_selectedRequest.ApplicantName" />
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label small fw-bold text-dark mb-1">Contact Phone</label>
                                        <input type="text" class="form-control" placeholder="(978) 555-0199" value="@_selectedRequest.RequesterPhone" @oninput="OnApplicantPhoneInput" />
                                        @{
                                            bool isEditPhoneValid = IsValidPhoneNumber(_selectedRequest.RequesterPhone, out var editPhoneErr);
                                            if (!isEditPhoneValid && !string.IsNullOrEmpty(editPhoneErr))
                                            {
                                                <div class="text-danger small mt-1" style="font-size: 0.75rem;">
                                                    <i class="bi bi-exclamation-triangle-fill me-1"></i>@editPhoneErr
                                                </div>
                                            }
                                        }
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label small fw-bold text-dark mb-1">Email Address</label>
                                        <input type="email" class="form-control" placeholder="user@example.com" @bind="_selectedRequest.RequesterEmail" />
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label small fw-bold text-dark mb-1">Event Type / Purpose</label>
                                        <select class="form-select" @bind="_selectedRequest.EventType">
                                            <option value="">-- Select Event Type --</option>
                                            @if (!string.IsNullOrWhiteSpace(_selectedRequest.EventType) && !_standardEventTypeOptions.Contains(_selectedRequest.EventType))
                                            {
                                                <option value="@_selectedRequest.EventType">@_selectedRequest.EventType (Current)</option>
                                            }
                                            @foreach (var evType in _standardEventTypeOptions)
                                            {
                                                <option value="@evType">@evType</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label small fw-bold text-dark mb-1">Guest Attendance</label>
                                        <input type="number" class="form-control" min="1" max="500" @bind="_selectedRequest.GuestCount" />
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label small fw-bold text-dark mb-1">Mailing Address</label>
                                        <input type="text" class="form-control" placeholder="Street, City, State Zip" @bind="_selectedRequest.RequesterAddress" />
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- 4. EDIT AMENITIES & ADD-ONS CARD -->
                        <div class="card border rounded-3 mb-3 shadow-none bg-white">
                            <div class="card-header section-header-amber py-2 px-3 fw-bold">
                                <i class="bi bi-check2-square text-warning-emphasis me-2 fs-5"></i>Requested Amenities &amp; Services
                            </div>
                            <div class="card-body p-3">
                                @{
                                    var activeModalAddons = (_webSettings?.GetAddonsList() ?? new List<RentalAddonOption>()).Where(a => a.IsActive).ToList();
                                }
                                @if (activeModalAddons.Any())
                                {
                                    <div class="row g-3">
                                        @foreach (var addon in activeModalAddons)
                                        {
                                            var isChecked = IsAddonSelected(_selectedRequest, addon);
                                            <div class="col-md-4">
                                                <div class="p-3 border rounded-3 bg-light d-flex align-items-center justify-content-between h-100">
                                                    <div class="form-check mb-0 flex-grow-1 me-2">
                                                        <input class="form-check-input" type="checkbox" id="edit_@addon.Id" checked="@isChecked" @onchange="(e) => SetAddonSelected(_selectedRequest, addon, (bool)(e.Value ?? false))" />
                                                        <label class="form-check-label fw-bold small" for="edit_@addon.Id">
                                                            @addon.Name
                                                        </label>
                                                        @if (!string.IsNullOrWhiteSpace(addon.Description))
                                                        {
                                                            <small class="text-muted d-block" style="font-size: 0.75rem;">@addon.Description</small>
                                                        }
                                                    </div>
                                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle">+$@addon.Fee</span>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <div class="text-muted small py-2 text-center fst-italic">No optional amenities or add-on services are currently configured in Hall Rental Settings.</div>
                                }
                            </div>
                        </div>
                    }
                    else
                    {
                        @if (HasPendingModifications())
                        {
                            var diffList = CalculateDiffs();
                            <div class="alert alert-warning border border-warning shadow-sm rounded-3 mb-3 p-3 d-flex align-items-center justify-content-between flex-wrap gap-2 animate-fade-in sticky-alert-banner">
                                <div class="d-flex align-items-center gap-2">
                                    <i class="bi bi-exclamation-circle-fill fs-5 text-warning-emphasis"></i>
                                    <div>
                                        <div class="fw-bold text-dark">You have @diffList.Count pending modification@(diffList.Count > 1 ? "s" : "") on this booking</div>
                                        <div class="small text-muted">Pricing and specifications have been recalculated. Review differences before committing to the database or sending emails.</div>
                                    </div>
                                </div>
                                <div class="d-flex align-items-center gap-2">
                                    <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill px-3 shadow-sm" @onclick="CancelBookingEditMode">
                                        <i class="bi bi-x-lg me-1"></i>Discard
                                    </button>
                                    <button type="button" class="btn btn-primary btn-sm rounded-pill px-3 shadow-sm fw-bold" @onclick="InitiateSaveBookingChanges">
                                        <i class="bi bi-check2-circle me-1"></i>Review &amp; Save
                                    </button>
                                </div>
                            </div>
                        }

                        <!-- Hero Event Banner (Sticky Top) -->
                        <div class="event-hero-banner p-3 rounded-3 mb-4 d-flex justify-content-between align-items-center flex-wrap gap-3 sticky-top-card">
                            <div>
                                <div class="text-uppercase fw-bold small text-primary-emphasis mb-1"><i class="bi bi-calendar3 me-1"></i> Scheduled Event Date</div>
                                <h4 class="fw-bold text-dark mb-0">
                                    @if (_selectedEvent.Start.Year > 2000)
                                    {
                                        @_selectedEvent.Start.ToString("dddd, MMMM dd, yyyy")
                                    }
                                    else if (_selectedRequest != null && _selectedRequest.EventDate.Year > 2000)
                                    {
                                        @_selectedRequest.EventDate.ToString("dddd, MMMM dd, yyyy")
                                    }
                                    else if (!string.IsNullOrEmpty(appDetails.PreferredEventDate))
                                    {
                                        @appDetails.PreferredEventDate
                                    }
                                    else
                                    {
                                        <span>Date Pending / Unspecified</span>
                                    }
                                </h4>
                            </div>
                            <div class="text-md-end">
                                <div class="text-uppercase fw-bold small text-primary-emphasis mb-1"><i class="bi bi-clock me-1"></i> Time Range</div>
                                <h5 class="fw-bold text-dark mb-0">
                                    @if (_selectedRequest != null && !string.IsNullOrEmpty(_selectedRequest.StartTime) && !string.IsNullOrEmpty(_selectedRequest.EndTime))
                                    {
                                        <span>@_selectedRequest.StartTime - @_selectedRequest.EndTime</span>
                                    }
                                    else if (!string.IsNullOrEmpty(appDetails.StartTime) && !string.IsNullOrEmpty(appDetails.EndTime))
                                    {
                                        <span>@appDetails.StartTime - @appDetails.EndTime</span>
                                    }
                                    else if (!_selectedEvent.IsAllDay)
                                    {
                                        <span>@_selectedEvent.Start.ToString("h:mm tt") - @_selectedEvent.End.ToString("h:mm tt")</span>
                                    }
                                    else
                                    {
                                        <span>All Day Event</span>
                                    }
                                </h5>
                            </div>
                        </div>

                        @if (isInquiry)
                        {
                            <!-- ========================================================= -->
                            <!-- STREAMLINED INQUIRY / QUESTION VIEW -->
                            <!-- ========================================================= -->
                            <!-- Visitor Contact & Question Details Card -->
                            <div class="card border rounded-3 mb-3 shadow-none bg-white">
                                <div class="card-header section-header-primary py-2 px-3 fw-bold d-flex justify-content-between align-items-center">
                                    <span><i class="bi bi-question-circle-fill text-info me-2 fs-5"></i>Pre-Booking Inquiry Details</span>
                                    <button type="button" class="btn btn-sm btn-primary rounded-pill px-3 shadow-sm fw-bold" @onclick="OpenReplyToInquiryModal">
                                        <i class="bi bi-reply-fill me-1"></i>Reply to Visitor
                                    </button>
                                </div>
                                <div class="card-body p-3">
                                    @{
                                        bool isPhoneCallbackRequested = _selectedRequest?.RequestPhoneCall == true || 
                                                                         appDetails.RequestPhoneCall || 
                                                                         string.Equals(_selectedRequest?.PreferredContactMethod, "Phone", StringComparison.OrdinalIgnoreCase) ||
                                                                         string.Equals(appDetails.PreferredContactMethod, "Phone", StringComparison.OrdinalIgnoreCase);
                                        bool hasCallBeenLogged = _selectedRequest?.InternalNotes?.Contains("📞 Phone Call Placed", StringComparison.OrdinalIgnoreCase) == true;
                                    }
                                    @if (isPhoneCallbackRequested)
                                    {
                                        <div class="alert @(hasCallBeenLogged ? "alert-success border-success" : "alert-warning border-warning") d-flex align-items-center justify-content-between py-2 px-3 mb-3 rounded-3 shadow-sm flex-wrap gap-2">
                                            <div class="d-flex align-items-center gap-2">
                                                <i class="bi @(hasCallBeenLogged ? "bi-telephone-check-fill text-success" : "bi-telephone-inbound-fill text-warning-emphasis") fs-5"></i>
                                                <div>
                                                    <strong class="@(hasCallBeenLogged ? "text-success-emphasis" : "text-warning-emphasis")">
                                                        @(hasCallBeenLogged ? "Phone Call Completed & Logged:" : "Phone Callback Requested:")
                                                    </strong>
                                                    <span class="small text-dark ms-1">
                                                        @(hasCallBeenLogged ? "A follow-up phone call has been recorded for this inquiry." : "The visitor requested to be contacted by phone regarding this question.")
                                                    </span>
                                                </div>
                                            </div>
                                            <div class="d-flex align-items-center gap-2">
                                                @if (!string.IsNullOrWhiteSpace(effectivePhone))
                                                {
                                                    <a href="tel:@effectivePhone" class="btn btn-sm btn-outline-success rounded-pill px-3 fw-bold shadow-sm">
                                                        <i class="bi bi-telephone-fill me-1"></i>Call @FormatPhoneNumber(effectivePhone)
                                                    </a>
                                                }
                                                @if (!hasCallBeenLogged && _selectedRequest != null)
                                                {
                                                    <button type="button" class="btn btn-sm btn-success rounded-pill px-3 fw-bold shadow-sm" @onclick="() => LogPhoneCallPlacedAsync(_selectedRequest)">
                                                        <i class="bi bi-check2-circle me-1"></i>Mark Call Placed
                                                    </button>
                                                }
                                                else if (hasCallBeenLogged)
                                                {
                                                    <span class="badge bg-success text-white rounded-pill px-2.5 py-1 fw-bold shadow-sm">
                                                        <i class="bi bi-check-circle-fill me-1"></i>Call Confirmed
                                                    </span>
                                                }
                                            </div>
                                        </div>
                                    }

                                    <div class="row g-3">
                                        <div class="col-md-4">
                                            <div class="text-muted small">Visitor Name</div>
                                            <div class="fw-bold fs-6 text-dark mt-1">@effectiveName</div>
                                        </div>
                                        <div class="col-md-4">
                                            <div class="text-muted small">Email Address</div>
                                            <div class="mt-1">
                                                @if (!string.IsNullOrWhiteSpace(effectiveEmail))
                                                {
                                                    <a href="mailto:@effectiveEmail" class="fw-semibold text-primary text-decoration-none">
                                                        <i class="bi bi-envelope-fill me-1"></i>@effectiveEmail
                                                    </a>
                                                }
                                                else
                                                {
                                                    <span class="text-muted fst-italic">None provided</span>
                                                }
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <div class="d-flex align-items-center justify-content-between">
                                                <div class="text-muted small">Contact Phone</div>
                                                @if (isPhoneCallbackRequested)
                                                {
                                                    <span class="badge bg-success-subtle text-success border border-success px-2 py-0.5 rounded-pill fw-bold" style="font-size:0.70rem;">
                                                        <i class="bi bi-telephone-fill me-1"></i>Preferred
                                                    </span>
                                                }
                                            </div>
                                            <div class="mt-1">
                                                @if (!string.IsNullOrWhiteSpace(effectivePhone))
                                                {
                                                    <a href="tel:@effectivePhone" class="fw-bold text-dark text-decoration-none">
                                                        <i class="bi bi-telephone-fill text-success me-1"></i>@FormatPhoneNumber(effectivePhone)
                                                    </a>
                                                }
                                                else
                                                {
                                                    <span class="text-muted fst-italic">None provided</span>
                                                }
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <div class="text-muted small">Target Event Date</div>
                                            <div class="fw-semibold text-dark mt-1">
                                                <i class="bi bi-calendar-check text-primary me-1"></i>
                                                @(_selectedRequest != null && _selectedRequest.EventDate.Year > 2000 ? _selectedRequest.EventDate.ToString("MMMM dd, yyyy") : (_selectedEvent.Start.Year > 2000 ? _selectedEvent.Start.ToString("MMMM dd, yyyy") : "Unspecified"))
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <div class="text-muted small">Estimated Guest Count</div>
                                            <div class="fw-semibold text-dark mt-1">
                                                <i class="bi bi-people-fill text-secondary me-1"></i>
                                                @(_selectedRequest?.GuestCount > 0 ? $"{_selectedRequest.GuestCount} Guests" : (!string.IsNullOrWhiteSpace(appDetails.GuestCount) ? $"{appDetails.GuestCount} Guests" : "Not specified"))
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <div class="text-muted small">Inquiry Status</div>
                                            <div class="mt-1">
                                                <span class="badge @(_selectedRequest?.Status == "Responded" || _selectedEvent.Status == "RESPONDED" ? "bg-success" : "bg-info text-dark") fw-bold px-2 py-1">
                                                    <i class="bi @(_selectedRequest?.Status == "Responded" || _selectedEvent.Status == "RESPONDED" ? "bi-check-all" : "bi-hourglass-split") me-1"></i>
                                                    @(_selectedRequest?.Status ?? _selectedEvent.Status ?? "INQUIRY")
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Visitor Question / Message Card -->
                            <div class="card border rounded-3 mb-3 shadow-none bg-white">
                                <div class="card-header section-header-primary py-2 px-3 fw-bold d-flex justify-content-between align-items-center">
                                    <span><i class="bi bi-chat-left-text-fill text-primary me-2 fs-5"></i>Visitor Question &amp; Inquiry Message</span>
                                </div>
                                <div class="card-body p-3">
                                    @{
                                        string messageContent = !string.IsNullOrWhiteSpace(_selectedRequest?.EventDescription) 
                                            ? _selectedRequest.EventDescription 
                                            : (!string.IsNullOrWhiteSpace(appDetails.EventDescription) ? appDetails.EventDescription : _selectedEvent.Description ?? "No message text provided.");
                                    }
                                    <div class="bg-light p-3 rounded-3 border text-dark" style="white-space: pre-wrap; font-size: 0.95rem; line-height: 1.6;">
                                        @messageContent
                                    </div>
                                </div>
                            </div>

                            <!-- Correspondence & Reply History Card -->
                            <div class="card border rounded-3 shadow-none bg-white mb-3">
                                <div class="card-header section-header-secondary py-2 px-3 fw-bold d-flex justify-content-between align-items-center">
                                    <span><i class="bi bi-clock-history text-secondary me-2 fs-5"></i>Correspondence &amp; Reply History</span>
                                    <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">Audit Trail</span>
                                </div>
                                <div class="card-body p-3">
                                    @if (!string.IsNullOrWhiteSpace(_selectedRequest?.InternalNotes))
                                    {
                                        <div class="bg-light p-3 rounded-3 border font-monospace small" style="white-space: pre-wrap; font-size: 0.85rem; line-height: 1.5;">@_selectedRequest.InternalNotes</div>
                                    }
                                    else
                                    {
                                        <div class="text-muted small py-2 text-center fst-italic">
                                            <i class="bi bi-info-circle me-1"></i>No staff replies recorded yet for this inquiry.
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                        else if (isClub)
                        {
                            <!-- ========================================================= -->
                            <!-- STREAMLINED CLUB EVENT VIEW -->
                            <!-- ========================================================= -->
                            var modalSecLabel = _webSettings?.SecondaryFlexibleLocation ?? "Office";
                            var modalEvtRoomNorm = NormalizeRoomName(_selectedEvent.Location);
                            var modalIsSecSpace = modalEvtRoomNorm != NormalizeRoomName(_webSettings?.ManagedRentalLocation ?? "Function Hall") && modalEvtRoomNorm != "entire facility";

                            <!-- Location Card -->
                            <div class="card border rounded-3 mb-3 shadow-none bg-white">
                                <div class="card-header section-header-primary py-2 px-3 fw-bold d-flex justify-content-between align-items-center">
                                    <span><i class="bi bi-geo-alt-fill text-primary me-2 fs-5"></i>Facility Space / Room</span>
                                </div>
                                <div class="card-body p-3">
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="badge @(modalIsSecSpace ? "text-white" : "bg-primary") fs-6 px-3 py-2" style="@(modalIsSecSpace ? "background-color: #0284c7 !important;" : "")">
                                            <i class="bi @(modalIsSecSpace ? "bi-door-open-fill" : "bi-building") me-1"></i>@(string.IsNullOrEmpty(_selectedEvent.Location) ? "Main Function Hall" : _selectedEvent.Location)
                                        </span>
                                    </div>
                                </div>
                            </div>

                            @if (!modalIsSecSpace)
                            {
                                <!-- Rental Blackout / Blocking Status Card (Primary Rental Space Only) -->
                                <div class="card border rounded-3 mb-3 shadow-none bg-white">
                                    <div class="card-header py-2 px-3 fw-bold d-flex justify-content-between align-items-center @(isBlackoutBlocked ? "section-header-amber" : "section-header-secondary")">
                                        <span><i class="bi @(isBlackoutBlocked ? "bi-slash-circle-fill text-danger" : "bi-calendar-check text-success") me-2 fs-5"></i>Public Rental Availability</span>
                                        <span class="badge @(isBlackoutBlocked ? "bg-danger" : "bg-success") px-2.5 py-1">
                                            @(isBlackoutBlocked ? "Slots Blocked" : "Slots Open")
                                        </span>
                                    </div>
                                    <div class="card-body p-3">
                                        @if (isBlackoutBlocked)
                                        {
                                            <div class="d-flex align-items-center gap-2 text-danger fw-bold small mb-1">
                                                <i class="bi bi-shield-lock-fill fs-5"></i>
                                                <span>All public rental slots for this date are blocked out.</span>
                                            </div>
                                            <div class="text-muted small ps-4">
                                                Public visitors are blocked from booking rental time slots on this date because this club event reserved the entire facility schedule.
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="d-flex align-items-center gap-2 text-success fw-bold small mb-1">
                                                <i class="bi bi-check-circle-fill fs-5"></i>
                                                <span>Rental booking slots remain available.</span>
                                            </div>
                                            <div class="text-muted small ps-4">
                                                Non-overlapping rental slots on this date remain available for public booking applications.
                                            </div>
                                        }
                                    </div>
                                </div>
                            }

                            <!-- Club Event Notes / Description -->
                            @if (!string.IsNullOrWhiteSpace(_selectedEvent.Description) || !string.IsNullOrWhiteSpace(appDetails.EventDescription))
                            {
                                var displayNotes = !string.IsNullOrWhiteSpace(appDetails.EventDescription) ? appDetails.EventDescription : _selectedEvent.Description;
                                <div class="card border rounded-3 mb-3 shadow-none bg-white">
                                    <div class="card-header section-header-primary py-2 px-3 fw-bold d-flex justify-content-between align-items-center">
                                        <span><i class="bi bi-card-text text-primary me-2 fs-5"></i>Event Description &amp; Notes</span>
                                    </div>
                                    <div class="card-body p-3">
                                        <div class="bg-light p-3 rounded-3 border text-dark" style="white-space: pre-wrap; font-size: 0.95rem; line-height: 1.6;">@displayNotes</div>
                                    </div>
                                </div>
                            }

                            <!-- Event Metadata & Created By Audit Card -->
                            <div class="card border rounded-3 mb-3 shadow-none bg-white">
                                <div class="card-header section-header-secondary py-2 px-3 fw-bold d-flex justify-content-between align-items-center">
                                    <span><i class="bi bi-person-badge text-secondary me-2 fs-5"></i>Event Creator &amp; Record Details</span>
                                    <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">Audit Info</span>
                                </div>
                                <div class="card-body p-3">
                                    <div class="row g-3">
                                        <div class="col-md-6">
                                            <div class="text-muted small">Created By</div>
                                            <div class="fw-bold fs-6 text-dark mt-1">
                                                <i class="bi bi-person-check-fill text-primary me-1"></i>@(string.IsNullOrWhiteSpace(appDetails.CreatedBy) ? "Club Administrator" : appDetails.CreatedBy)
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="text-muted small">Created On</div>
                                            <div class="fw-semibold text-dark mt-1">
                                                <i class="bi bi-clock-history text-secondary me-1"></i>@(string.IsNullOrWhiteSpace(appDetails.CreatedTimestamp) ? (string.IsNullOrWhiteSpace(effectiveTimestamp) ? "Recorded on Calendar" : effectiveTimestamp) : appDetails.CreatedTimestamp)
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <!-- 1. APPLICANT CONTACT CARD WITH MEMBER DIRECTORY VERIFICATION & DUES STATUS -->
                            <div class="card border rounded-3 mb-3 shadow-none bg-white">
                                <div class="card-header section-header-primary py-2 px-3 fw-bold d-flex justify-content-between align-items-center">
                                    <span><i class="bi bi-person-circle text-primary me-2 fs-5"></i>Applicant / Organizer</span>
                                <div class="d-flex align-items-center gap-3 flex-wrap">
                                    @{
                                        var allTierCards = (_webSettings?.GetTierCardsList() ?? WebsiteSettings.GetDefaultTierCards()).Where(c => c.IsEnabled).ToList();
                                        var currentReqDate = _selectedRequest != null && _selectedRequest.EventDate.Year > 2000 
                                            ? _selectedRequest.EventDate 
                                            : (_selectedEvent != null ? _selectedEvent.Start.Date : DateTime.Today);
                                    }
                                    <div class="d-flex align-items-center bg-light border rounded-pill p-1 shadow-sm gap-1 flex-wrap" title="Select renter pricing tier from Tier &amp; Day Matrix">
                                        @foreach (var card in allTierCards)
                                        {
                                            var rateForDay = GetCardRateForDate(card, currentReqDate);
                                            bool isAvailableOnDay = IsCardAvailableForDate(card, currentReqDate);
                                            bool isCardSelected = false;
                                            if (_selectedRequest != null && !string.IsNullOrWhiteSpace(_selectedRequest.RenterType))
                                            {
                                                isCardSelected = string.Equals(_selectedRequest.RenterType, card.Title, StringComparison.OrdinalIgnoreCase) ||
                                                                 string.Equals(_selectedRequest.RenterType, card.Id, StringComparison.OrdinalIgnoreCase) ||
                                                                 string.Equals(_selectedRequest.RenterType, card.AssociatedRenterType, StringComparison.OrdinalIgnoreCase);
                                            }
                                            else
                                            {
                                                isCardSelected = isMemberVal == true 
                                                    ? string.Equals(card.AssociatedRenterType, "Member", StringComparison.OrdinalIgnoreCase)
                                                    : string.Equals(card.AssociatedRenterType, "Non-Member", StringComparison.OrdinalIgnoreCase);
                                            }

                                            <button type="button" 
                                                    class="btn btn-sm rounded-pill py-0.5 px-2.5 fw-bold @(isCardSelected ? "btn-primary text-white shadow-sm" : (!isAvailableOnDay ? "btn-light text-muted border-0 opacity-50 text-decoration-line-through" : "btn-light text-secondary border-0"))" 
                                                    style="font-size: 0.78rem; @(isCardSelected && !string.IsNullOrEmpty(card.ThemeColor) ? $"background-color: {card.ThemeColor} !important; border-color: {card.ThemeColor} !important;" : "")"
                                                    disabled="@(!isAvailableOnDay && !isCardSelected)"
                                                    title="@(!isAvailableOnDay ? $"{card.Title} is not available on {currentReqDate:dddd}s" : $"Select {card.Title} (${rateForDay:N0})")"
                                                    @onclick="() => { if (isAvailableOnDay) QuickSetPricingTier(card); }">
                                                <i class="bi @(isCardSelected ? "bi-check-circle-fill" : (!isAvailableOnDay ? "bi-slash-circle" : "bi-circle")) me-1"></i>
                                                <span>@card.Title (@(isAvailableOnDay ? $"${rateForDay:N0}" : "N/A on " + currentReqDate.ToString("ddd")))</span>
                                            </button>
                                        }
                                    </div>
                                    @if (_editingSection != "Applicant")
                                    {
                                        <button type="button" class="btn btn-link btn-sm text-primary p-0 text-decoration-none fw-semibold" @onclick='() => EnterSectionEditMode("Applicant")' title="Edit applicant info">
                                            <i class="bi bi-pencil-square me-1"></i>Edit
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-3 py-0.5 shadow-sm fw-bold" @onclick="ExitSectionEditMode" title="Finish editing applicant info">
                                            <i class="bi bi-check-lg me-1"></i>Done
                                        </button>
                                    }
                                </div>
                            </div>
                            <div class="card-body p-3">
                                @if (_editingSection == "Applicant" && _selectedRequest != null)
                                {
                                    <div class="row g-3">
                                        <div class="col-md-6">
                                            <label class="form-label small fw-bold text-dark mb-1">Full Name / Organization</label>
                                            <input type="text" class="form-control" @bind="_selectedRequest.ApplicantName" />
                                        </div>
                                        <div class="col-md-3">
                                            <label class="form-label small fw-bold text-dark mb-1">Contact Phone</label>
                                            <input type="text" class="form-control" placeholder="(978) 555-0199" value="@_selectedRequest.RequesterPhone" @oninput="OnApplicantPhoneInput" />
                                            @{
                                                bool isSectionPhoneValid = IsValidPhoneNumber(_selectedRequest.RequesterPhone, out var secPhoneErr);
                                                if (!isSectionPhoneValid && !string.IsNullOrEmpty(secPhoneErr))
                                                {
                                                    <div class="text-danger small mt-1" style="font-size: 0.75rem;">
                                                        <i class="bi bi-exclamation-triangle-fill me-1"></i>@secPhoneErr
                                                    </div>
                                                }
                                            }
                                        </div>
                                        <div class="col-md-3">
                                            <label class="form-label small fw-bold text-dark mb-1">Email Address</label>
                                            <input type="email" class="form-control" placeholder="user@example.com" @bind="_selectedRequest.RequesterEmail" />
                                        </div>
                                        <div class="col-md-12">
                                            <label class="form-label small fw-bold text-dark mb-1">Mailing Address</label>
                                            <input type="text" class="form-control" placeholder="Street, City, State Zip" @bind="_selectedRequest.RequesterAddress" />
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <div class="row g-3">
                                        <div class="col-md-6">
                                            <div class="text-muted small">Full Name</div>
                                            <div class="fw-bold fs-6">@effectiveName</div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="text-muted small">Contact Phone</div>
                                            <div class="fw-semibold">
                                                @if (!string.IsNullOrEmpty(effectivePhone))
                                                {
                                                    bool isPhoneValid = IsValidPhoneNumber(effectivePhone, out var phoneErr);
                                                    <a href="tel:@effectivePhone" class="text-decoration-none text-primary">
                                                        <i class="bi bi-telephone me-1"></i>@FormatPhoneNumber(effectivePhone)
                                                    </a>
                                                    @if (!isPhoneValid && !string.IsNullOrEmpty(phoneErr))
                                                    {
                                                        <div class="small text-danger mt-1">
                                                            <i class="bi bi-exclamation-triangle-fill me-1"></i>@phoneErr
                                                        </div>
                                                    }
                                                }
                                                else
                                                {
                                                    <span class="text-muted">None provided</span>
                                                }
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="text-muted small">Email Address</div>
                                            <div class="fw-semibold">
                                                @if (!string.IsNullOrEmpty(effectiveEmail))
                                                {
                                                    <a href="mailto:@effectiveEmail" class="text-decoration-none text-primary">
                                                        <i class="bi bi-envelope me-1"></i>@effectiveEmail
                                                    </a>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">None provided</span>
                                                }
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="text-muted small">Mailing Address</div>
                                            <div class="fw-semibold">
                                                @if (!string.IsNullOrEmpty(effectiveAddress))
                                                {
                                                    <span>@effectiveAddress</span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">None provided</span>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                }

                                <!-- MEMBER DIRECTORY VERIFICATION & DUES STATUS PANEL -->
                                @if (claimedMember)
                                {
                                    <div class="mt-3 pt-3 border-top">
                                        <div class="d-flex align-items-center justify-content-between mb-2">
                                            <span class="small fw-bold text-dark text-uppercase" style="letter-spacing: 0.5px; font-size: 0.75rem;">
                                                <i class="bi bi-person-badge-fill text-primary me-1"></i>Directory Membership &amp; Dues Verification
                                            </span>
                                            @if (memberVerify.IsExactMatch && memberVerify.ExactMember != null)
                                            {
                                                var dues = memberVerify.DuesStatus;
                                                bool isLife = MemberStatusHelper.IsLifeStatus(memberVerify.ExactMember.Status);
                                                bool isDuesCurrent = isLife || (dues != null && !dues.IsOverdue);

                                                <div class="d-flex align-items-center gap-1">
                                                    <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                                                        <i class="bi bi-patch-check-fill me-1"></i>Verified Member #@memberVerify.ExactMember.MemberID
                                                    </span>
                                                    <span class="badge @(isDuesCurrent ? "bg-success" : "bg-danger") px-2 py-1">
                                                        @(isLife ? "Life Member (Exempt)" : (isDuesCurrent ? "Dues Current (Paid)" : $"Dues Overdue ({dues?.MonthsOverdue} mos)"))
                                                    </span>
                                                </div>
                                            }
                                            else if (claimedMember && !memberVerify.IsExactMatch && !memberVerify.SimilarCandidates.Any())
                                            {
                                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1">
                                                    <i class="bi bi-exclamation-triangle-fill me-1"></i>No Member Record Found
                                                </span>
                                            }
                                        </div>

                                        @if (memberVerify.IsExactMatch && memberVerify.ExactMember != null)
                                        {
                                            var m = memberVerify.ExactMember;
                                            var dues = memberVerify.DuesStatus;
                                            bool isLife = MemberStatusHelper.IsLifeStatus(m.Status);
                                            bool isDuesCurrent = isLife || (dues != null && !dues.IsOverdue);

                                            <div class="p-2 px-3 rounded-3 border @(isDuesCurrent ? "bg-success bg-opacity-10 border-success-subtle" : "bg-warning bg-opacity-10 border-warning-subtle")">
                                                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                                                    <div>
                                                        <strong class="text-dark">@GetMemberDisplayName(m)</strong>
                                                        <span class="badge bg-light text-dark border ms-2">#@m.MemberID</span>
                                                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle ms-1">@m.Status</span>
                                                        @if (m.AcceptedDate.HasValue)
                                                        {
                                                            <span class="text-muted small ms-2">Member since @m.AcceptedDate.Value.ToString("yyyy")</span>
                                                        }
                                                    </div>
                                                    <div class="d-flex align-items-center gap-2">
                                                        @if (isDuesCurrent)
                                                        {
                                                            <span class="text-success small fw-bold">
                                                                <i class="bi bi-check-circle-fill me-1"></i>Dues in Good Standing
                                                            </span>
                                                        }
                                                        else
                                                        {
                                                            <span class="text-danger small fw-bold">
                                                                <i class="bi bi-exclamation-octagon-fill me-1"></i>Dues Unpaid (@(dues?.MonthsOverdue ?? 0) Months Overdue)
                                                            </span>
                                                        }
                                                        <button type="button" class="btn btn-sm btn-outline-secondary px-2 py-0 ms-1" style="font-size: 0.75rem;" @onclick="UnlinkApplicantFromMemberAsync" title="Unlink this member verification and set to non-member">
                                                            <i class="bi bi-slash-circle me-1"></i>Unlink
                                                        </button>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                        else if (!memberVerify.IsExactMatch)
                                        {
                                            @if (memberVerify.SimilarCandidates.Any())
                                            {
                                                <div class="p-3 rounded-3 border bg-warning bg-opacity-10 border-warning-subtle">
                                                    <div class="d-flex align-items-center gap-2 mb-1 text-warning-emphasis fw-bold small">
                                                        <i class="bi bi-exclamation-triangle-fill fs-6"></i>
                                                        No exact match for "@effectiveName" — Similar directory entries found (Not a confirmed match):
                                                    </div>
                                                    <div class="small text-muted mb-2 ps-4" style="font-size: 0.78rem;">
                                                        The following members share a similar first name, last name, phone, or email. Please verify if the applicant is authorized under one of these records before approving member pricing.
                                                    </div>
                                                    <div class="d-flex flex-column gap-2">
                                                        @foreach (var candidate in memberVerify.SimilarCandidates)
                                                        {
                                                            var candDues = candidate.DuesStatus;
                                                            bool candLife = MemberStatusHelper.IsLifeStatus(candidate.Member.Status);
                                                            bool candDuesCurrent = candLife || (candDues != null && !candDues.IsOverdue);

                                                            <div class="d-flex justify-content-between align-items-center p-2 rounded bg-white border shadow-sm flex-wrap gap-2">
                                                                <div class="d-flex align-items-center gap-2 flex-wrap">
                                                                    <i class="bi bi-person text-secondary"></i>
                                                                    <strong class="text-dark">@GetMemberDisplayName(candidate.Member)</strong>
                                                                    <span class="badge bg-light text-dark border">#@candidate.Member.MemberID</span>
                                                                    <span class="badge bg-secondary-subtle text-secondary">@candidate.Member.Status</span>
                                                                    <span class="badge @(candDuesCurrent ? "bg-success-subtle text-success" : "bg-danger-subtle text-danger") border">
                                                                        @(candLife ? "Life" : (candDuesCurrent ? "Dues Paid" : "Dues Overdue"))
                                                                    </span>
                                                                    <small class="text-muted">(@candidate.MatchReason)</small>
                                                                </div>
                                                                <button type="button" class="btn btn-sm btn-outline-primary fw-semibold px-2 py-1 shadow-sm" @onclick="() => LinkApplicantToMember(candidate.Member)" title="Verify and link this applicant to this member record">
                                                                    <i class="bi bi-link-45deg me-1"></i>Link to Member
                                                                </button>
                                                            </div>
                                                        }
                                                    </div>
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="p-2 px-3 rounded-3 border bg-danger bg-opacity-10 border-danger-subtle d-flex align-items-center justify-content-between flex-wrap gap-2">
                                                    <div class="text-danger small">
                                                        <i class="bi bi-exclamation-diamond-fill me-1"></i>
                                                        Applicant requested <strong>GFC Member Rate</strong>, but no matching name, email, or phone was found in the Member Directory.
                                                    </div>
                                                    <button type="button" class="btn btn-sm btn-outline-danger fw-semibold" @onclick='() => EnterSectionEditMode("Financial")'>
                                                        Review Pricing / Info
                                                    </button>
                                                </div>
                                            }
                                        }
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- 2. EVENT SPECIFICATIONS & SERVICES -->
                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <div class="card border rounded-3 h-100 shadow-none bg-white">
                                    <div class="card-header section-header-primary py-2 px-3 fw-bold d-flex justify-content-between align-items-center">
                                        <span><i class="bi bi-card-checklist text-primary me-2 fs-5"></i>Event Specifications</span>
                                        @if (_editingSection != "Specifications")
                                        {
                                            <button type="button" class="btn btn-link btn-sm text-primary p-0 text-decoration-none fw-semibold" @onclick='() => EnterSectionEditMode("Specifications")' title="Edit specifications">
                                                <i class="bi bi-pencil-square me-1"></i>Edit
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-3 py-0.5 shadow-sm fw-bold" @onclick="ExitSectionEditMode" title="Finish editing specifications">
                                                <i class="bi bi-check-lg me-1"></i>Done
                                            </button>
                                        }
                                    </div>
                                    <div class="card-body p-3">
                                        @if (_editingSection == "Specifications" && _selectedRequest != null)
                                        {
                                            <div class="row g-2">
                                                <div class="col-12">
                                                    <label class="form-label small fw-bold text-dark mb-1">Event Date</label>
                                                    <input type="date" class="form-control form-control-sm" @bind="_selectedRequest.EventDate" />
                                                </div>
                                                <div class="col-6">
                                                    <label class="form-label small fw-bold text-dark mb-1">Start Time</label>
                                                    <select class="form-select form-select-sm" @bind="_selectedRequest.StartTime">
                                                        <option value="">-- Select --</option>
                                                        @if (!string.IsNullOrWhiteSpace(_selectedRequest.StartTime) && !_timeSlotOptions.Any(o => o.Label.Equals(_selectedRequest.StartTime, StringComparison.OrdinalIgnoreCase)))
                                                        {
                                                            <option value="@_selectedRequest.StartTime">@_selectedRequest.StartTime (Current)</option>
                                                        }
                                                        @foreach (var opt in _timeSlotOptions)
                                                        {
                                                            <option value="@opt.Label">@opt.Label</option>
                                                        }
                                                    </select>
                                                </div>
                                                <div class="col-6">
                                                    <label class="form-label small fw-bold text-dark mb-1">End Time</label>
                                                    <select class="form-select form-select-sm" @bind="_selectedRequest.EndTime">
                                                        <option value="">-- Select --</option>
                                                        @if (!string.IsNullOrWhiteSpace(_selectedRequest.EndTime) && !_timeSlotOptions.Any(o => o.Label.Equals(_selectedRequest.EndTime, StringComparison.OrdinalIgnoreCase)))
                                                        {
                                                            <option value="@_selectedRequest.EndTime">@_selectedRequest.EndTime (Current)</option>
                                                        }
                                                        @foreach (var opt in _timeSlotOptions)
                                                        {
                                                            <option value="@opt.Label">@opt.Label</option>
                                                        }
                                                    </select>
                                                </div>
                                                <div class="col-12">
                                                    <label class="form-label small fw-bold text-dark mb-1">Room / Space</label>
                                                    <select class="form-select form-select-sm" @bind="_selectedRequest.RoomSelected" @bind:after="RecalculateEditPriceQuote">
                                                        @foreach (var room in (_editableRooms.Any() ? _editableRooms : (_webSettings?.GetRoomsList() ?? new List<RentalRoomOption>())))
                                                        {
                                                            <option value="@room.Name">@room.Name ($@( _selectedRequest.MemberStatus ? room.MemberRate : room.NonMemberRate))</option>
                                                        }
                                                    </select>
                                                </div>
                                                <div class="col-6">
                                                    <label class="form-label small fw-bold text-dark mb-1">Event Type</label>
                                                    <select class="form-select form-select-sm" @bind="_selectedRequest.EventType">
                                                        <option value="">-- Select --</option>
                                                        @if (!string.IsNullOrWhiteSpace(_selectedRequest.EventType) && !_standardEventTypeOptions.Contains(_selectedRequest.EventType))
                                                        {
                                                            <option value="@_selectedRequest.EventType">@_selectedRequest.EventType (Current)</option>
                                                        }
                                                        @foreach (var evType in _standardEventTypeOptions)
                                                        {
                                                            <option value="@evType">@evType</option>
                                                        }
                                                    </select>
                                                </div>
                                                <div class="col-6">
                                                    <label class="form-label small fw-bold text-dark mb-1">Guests</label>
                                                    <input type="number" class="form-control form-control-sm" min="1" max="500" @bind="_selectedRequest.GuestCount" />
                                                </div>
                                                <div class="col-12">
                                                    <label class="form-label small fw-bold text-dark mb-1">Booking Status</label>
                                                    <select class="form-select form-select-sm fw-semibold @(_selectedRequest.Status == "Approved" ? "text-success" : (_selectedRequest.Status == "Cancelled" ? "text-danger" : "text-warning-emphasis"))" @bind="_selectedRequest.Status">
                                                        <option value="Pending">Pending Review</option>
                                                        <option value="Approved">Approved</option>
                                                        <option value="Cancelled">Cancelled</option>
                                                    </select>
                                                </div>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="d-flex justify-content-between py-1 border-bottom">
                                                <span class="text-muted small">Event Type</span>
                                                <span class="fw-bold">@(_selectedRequest?.EventType ?? appDetails.EventType ?? "General Function")</span>
                                            </div>
                                            <div class="d-flex justify-content-between py-1 border-bottom">
                                                <span class="text-muted small">Selected Room</span>
                                                <span class="fw-bold text-primary">@(_selectedRequest?.RoomSelected ?? _selectedEvent.Location ?? "Function Hall")</span>
                                            </div>
                                            <div class="d-flex justify-content-between py-1 border-bottom">
                                                <span class="text-muted small">Estimated Guests</span>
                                                <span class="fw-bold">@(_selectedRequest?.GuestCount > 0 ? _selectedRequest.GuestCount.ToString() : (appDetails.GuestCount ?? "Unspecified"))</span>
                                            </div>
                                            <div class="d-flex justify-content-between py-1 border-bottom">
                                                <span class="text-muted small">Setup Time Required?</span>
                                                <span class="fw-bold @(appDetails.SetupTimeRequired?.ToLower().StartsWith("y") == true ? "text-success" : "text-muted")">
                                                    @(appDetails.SetupTimeRequired ?? "No")
                                                </span>
                                            </div>
                                            @if (!string.IsNullOrEmpty(appDetails.AlternateDate))
                                            {
                                                <div class="d-flex justify-content-between py-1">
                                                    <span class="text-muted small">Alternate Date Choice</span>
                                                    <span class="fw-bold text-info">@appDetails.AlternateDate</span>
                                                </div>
                                            }
                                        }
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="card border rounded-3 h-100 shadow-none bg-white">
                                    <div class="card-header section-header-amber py-2 px-3 fw-bold d-flex justify-content-between align-items-center">
                                        <span><i class="bi bi-cup-straw text-warning-emphasis me-2 fs-5"></i>Facilities &amp; Add-Ons</span>
                                        @if (_editingSection != "AddOns")
                                        {
                                            <button type="button" class="btn btn-link btn-sm text-primary p-0 text-decoration-none fw-semibold" @onclick='() => EnterSectionEditMode("AddOns")' title="Edit add-ons">
                                                <i class="bi bi-pencil-square me-1"></i>Edit
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-3 py-0.5 shadow-sm fw-bold" @onclick="ExitSectionEditMode" title="Finish editing add-ons">
                                                <i class="bi bi-check-lg me-1"></i>Done
                                            </button>
                                        }
                                    </div>
                                    <div class="card-body p-3">
                                        @{
                                            var activeDrawerAddons = (_webSettings?.GetAddonsList() ?? new List<RentalAddonOption>()).Where(a => a.IsActive).ToList();
                                        }
                                        @if (_editingSection == "AddOns" && _selectedRequest != null)
                                        {
                                            <div class="d-flex flex-column gap-2">
                                                @if (activeDrawerAddons.Any())
                                                {
                                                    @foreach (var addon in activeDrawerAddons)
                                                    {
                                                        var isChecked = IsAddonSelected(_selectedRequest, addon);
                                                        <div class="p-2 border rounded-3 bg-light d-flex align-items-center justify-content-between">
                                                            <div class="form-check mb-0 flex-grow-1 me-2">
                                                                <input class="form-check-input" type="checkbox" id="inline_@addon.Id" checked="@isChecked" @onchange="(e) => SetAddonSelected(_selectedRequest, addon, (bool)(e.Value ?? false))" />
                                                                <label class="form-check-label fw-bold small" for="inline_@addon.Id">
                                                                    @addon.Name
                                                                </label>
                                                                @if (!string.IsNullOrWhiteSpace(addon.Description))
                                                                {
                                                                    <small class="text-muted d-block" style="font-size: 0.72rem;">@addon.Description</small>
                                                                }
                                                            </div>
                                                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle">+$@addon.Fee</span>
                                                        </div>
                                                    }
                                                }
                                                else
                                                {
                                                    <div class="text-muted small py-1 fst-italic">No active amenities configured.</div>
                                                }
                                            </div>
                                        }
                                        else
                                        {
                                            @if (activeDrawerAddons.Any())
                                            {
                                                @foreach (var addon in activeDrawerAddons)
                                                {
                                                    var isSelected = IsAddonSelected(_selectedRequest, addon);
                                                    <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                                                        <div>
                                                            <div class="fw-semibold">@addon.Name</div>
                                                            @if (!string.IsNullOrWhiteSpace(addon.Description))
                                                            {
                                                                <div class="text-muted small" style="font-size: 0.75rem;">@addon.Description</div>
                                                            }
                                                        </div>
                                                        <span class="badge @(isSelected ? "bg-success" : "bg-light text-muted border") px-3 py-1">
                                                            @(isSelected ? "Requested" : "No")
                                                        </span>
                                                    </div>
                                                }
                                            }
                                            else
                                            {
                                                <div class="text-muted small py-1 fst-italic">No active amenities configured.</div>
                                            }
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- 3. FINANCIAL SUMMARY & REAL-TIME PAYMENT STATUS -->
                        <div class="card border rounded-3 shadow-none bg-white mb-3">
                            <div class="card-header section-header-success py-2 px-3 fw-bold d-flex justify-content-between align-items-center">
                                <span><i class="bi bi-currency-dollar text-success me-2 fs-5"></i>Financial &amp; Payment Breakdown</span>
                                <div class="d-flex align-items-center gap-2">
                                    <span class="badge @(modalPaySummary.Status == "Waived" ? "" : (modalPaySummary.Status == "Paid" ? "bg-success text-white" : (modalPaySummary.Status == "Deposit Paid" ? "bg-primary text-white" : (modalPaySummary.Status.StartsWith("Partial") ? "bg-warning text-dark" : "bg-light text-dark border border-secondary shadow-sm")))) px-3 py-1 fs-6 fw-bold" style="@(modalPaySummary.Status == "Waived" || modalPaySummary.Status.Contains("Waiver") ? "background-color: #7c3aed !important; color: #ffffff !important;" : (modalPaySummary.Status == "Unpaid" ? "color: #1e293b !important; background-color: #f1f5f9 !important; border-color: #94a3b8 !important;" : ""))">
                                        Payment Status: @modalPaySummary.Status.ToUpper()
                                    </span>
                                    @if (_editingSection != "Financial")
                                    {
                                        <button type="button" class="btn btn-outline-success btn-sm rounded-pill px-2 py-0.5 shadow-sm fw-semibold" @onclick='() => EnterSectionEditMode("Financial")' title="Modify pricing or deposit">
                                            <i class="bi bi-pencil-square me-1"></i>Edit Price
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-success rounded-pill px-3 py-0.5 shadow-sm fw-bold" @onclick="ExitSectionEditMode" title="Finish editing price">
                                            <i class="bi bi-check-lg me-1"></i>Done
                                        </button>
                                    }
                                </div>
                            </div>
                            <div class="card-body p-3">
                                @if (_editingSection == "Financial" && _selectedRequest != null)
                                {
                                    <div class="row g-3">
                                        <div class="@(_webSettings?.RequireSecurityDeposit == true ? "col-md-6" : "col-12")">
                                            <label class="form-label small fw-bold text-dark mb-1">Agreed Total Price ($)</label>
                                            <div class="input-group">
                                                <span class="input-group-text">$</span>
                                                <input type="number" step="0.01" class="form-control form-control-lg fw-bold text-success" @bind="_selectedRequest.TotalPrice" />
                                                <button type="button" class="btn btn-outline-secondary" @onclick="AutoCalculateSelectedRequestPrice" title="Reset to standard quote based on selections">
                                                    <i class="bi bi-arrow-clockwise me-1"></i>Auto-Calc
                                                </button>
                                                <button type="button" class="btn btn-outline-danger" @onclick="WaiveAllFeesForSelectedRequest" title="Waive all rental fees ($0.00)">
                                                    <i class="bi bi-gift me-1"></i>Waive Fees
                                                </button>
                                            </div>
                                            <small class="text-muted">Enter custom price, discount, standard quote, or fee waiver.</small>
                                        </div>
                                        @if (_webSettings?.RequireSecurityDeposit == true)
                                        {
                                            <div class="col-md-6">
                                                <label class="form-label small fw-bold text-dark mb-1">Security Deposit Required ($)</label>
                                                <div class="input-group">
                                                    <span class="input-group-text">$</span>
                                                    <input type="number" step="0.01" class="form-control form-control-lg fw-bold text-warning-emphasis" @bind="_selectedRequest.SecurityDepositAmount" />
                                                </div>
                                                <small class="text-muted">Refundable security deposit amount.</small>
                                            </div>
                                        }
                                    </div>
                                }
                                else
                                {
                                    var showDepositCol = _webSettings?.RequireSecurityDeposit == true;
                                    var hasWaiver = modalPaySummary.AmountWaived > 0;
                                    <div class="row g-3 text-center">
                                        <div class="@(hasWaiver ? "col-md-auto col-6 flex-fill" : (showDepositCol ? "col-md-3 col-6" : "col-md-4 col-12"))">
                                            <div class="p-2 bg-light rounded border">
                                                <small class="text-muted d-block">Original Total Price</small>
                                                <strong class="fs-5 text-dark">$@modalPaySummary.TotalPrice.ToString("N2")</strong>
                                            </div>
                                        </div>
                                        @if (hasWaiver)
                                        {
                                            <div class="col-md-auto col-6 flex-fill">
                                                <div class="p-2 bg-purple bg-opacity-10 rounded border border-purple-subtle" style="background-color: #f3e8ff; border-color: #d8b4fe;">
                                                    <small class="fw-semibold d-block" style="color: #6b21a8;"><i class="bi bi-gift me-1"></i>Amount Waived</small>
                                                    <strong class="fs-5" style="color: #6b21a8;">-$@modalPaySummary.AmountWaived.ToString("N2")</strong>
                                                </div>
                                            </div>
                                        }
                                        @if (showDepositCol)
                                        {
                                            <div class="@(hasWaiver ? "col-md-auto col-6 flex-fill" : "col-md-3 col-6")">
                                                <div class="p-2 bg-light rounded border">
                                                    <small class="text-muted d-block">Security Deposit</small>
                                                    <strong class="fs-5 text-warning-emphasis">$@modalPaySummary.DepositRequired.ToString("N2")</strong>
                                                </div>
                                            </div>
                                        }
                                        <div class="@(hasWaiver ? "col-md-auto col-6 flex-fill" : (showDepositCol ? "col-md-3 col-6" : "col-md-4 col-6"))">
                                            <div class="p-2 bg-success bg-opacity-10 rounded border border-success-subtle">
                                                <small class="text-success fw-semibold d-block">Total Paid to Date</small>
                                                <strong class="fs-5 text-success">$@modalPaySummary.TotalPaid.ToString("N2")</strong>
                                            </div>
                                        </div>
                                        <div class="@(hasWaiver ? "col-md-auto col-6 flex-fill" : (showDepositCol ? "col-md-3 col-6" : "col-md-4 col-6"))">
                                            <div class="p-2 @(modalPaySummary.RemainingBalance > 0 ? "bg-danger bg-opacity-10 border border-danger-subtle" : "bg-light border") rounded">
                                                <small class="@(modalPaySummary.RemainingBalance > 0 ? "text-danger fw-semibold" : "text-muted") d-block">Remaining Balance</small>
                                                <strong class="fs-5 @(modalPaySummary.RemainingBalance > 0 ? "text-danger" : "text-success")">$@modalPaySummary.RemainingBalance.ToString("N2")</strong>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- 4. MANUAL PAYMENT & DEPOSIT TRACKING LEDGER -->
                        <div class="card border rounded-3 shadow-none bg-white mb-3">
                            <div class="card-header section-header-success py-2 px-3 fw-bold d-flex justify-content-between align-items-center">
                                <span><i class="bi bi-cash-stack text-success me-2 fs-5"></i>Payment &amp; Deposit Ledger</span>
                                <button type="button" class="btn btn-sm btn-outline-success rounded-pill px-3 shadow-sm" @onclick="() => OpenRecordPaymentModal(_selectedEvent)">
                                    <i class="bi bi-plus-circle me-1"></i>Record Payment / Deposit
                                </button>
                            </div>
                            <div class="card-body p-2 @(_selectedPayments.Any() ? "p-3" : "")">
                                @if (_selectedPayments.Any())
                                {
                                    <div class="table-responsive">
                                        <table class="table table-sm table-hover align-middle mb-0">
                                            <thead class="table-light small">
                                                <tr>
                                                    <th>Date</th>
                                                    <th>Type</th>
                                                    <th>Method</th>
                                                    <th>Ref / Check #</th>
                                                    <th>Amount</th>
                                                    <th>Recorded By</th>
                                                    <th class="text-end">Actions</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var p in _selectedPayments)
                                                {
                                                    <tr>
                                                        <td class="small">@p.PaymentDate.ToString("MM/dd/yyyy")</td>
                                                        <td>
                                                            @if (p.PaymentType == "Waived" || p.PaymentMethod == "Waived")
                                                            {
                                                                <span class="badge" style="background-color: #7c3aed; color: #ffffff;">
                                                                    <i class="bi bi-gift me-1"></i>Waived
                                                                </span>
                                                            }
                                                            else
                                                            {
                                                                <span class="badge @(p.PaymentType == "Security Deposit" ? "bg-warning text-dark" : (p.PaymentType == "Refund" ? "bg-danger" : "bg-success"))">
                                                                    @p.PaymentType
                                                                </span>
                                                            }
                                                        </td>
                                                        <td class="small">@p.PaymentMethod</td>
                                                        <td class="small font-monospace">@(string.IsNullOrEmpty(p.ReferenceOrCheckNumber) ? "—" : p.ReferenceOrCheckNumber)</td>
                                                        <td class="fw-bold @(p.PaymentType == "Waived" || p.PaymentMethod == "Waived" ? "text-purple" : (p.PaymentType == "Refund" ? "text-danger" : "text-success"))" style="@(p.PaymentType == "Waived" || p.PaymentMethod == "Waived" ? "color: #7c3aed !important;" : "")">
                                                            @(p.PaymentType == "Refund" ? "-" : (p.PaymentType == "Waived" || p.PaymentMethod == "Waived" ? "[Waived] " : ""))@p.Amount.ToString("N2")
                                                        </td>
                                                        <td class="small text-muted">@p.RecordedBy</td>
                                                        <td class="text-end">
                                                            <div class="d-inline-flex gap-2">
                                                                <button class="btn btn-link btn-sm text-primary p-0" title="Edit / correct payment" @onclick="() => OpenEditPaymentModal(p)">
                                                                    <i class="bi bi-pencil-square"></i>
                                                                </button>
                                                                <button class="btn btn-link btn-sm text-danger p-0" title="Delete payment" @onclick="() => DeletePayment(p.Id)">
                                                                    <i class="bi bi-trash"></i>
                                                                </button>
                                                            </div>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                }
                                else
                                {
                                    <div class="d-flex align-items-center justify-content-between p-2 px-3 bg-light rounded-2 text-muted small">
                                        <span><i class="bi bi-info-circle me-1 text-secondary"></i>No payment transactions recorded yet.</span>
                                        <span class="text-secondary opacity-75" style="font-size: 0.75rem;">Balance pending</span>
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- QUALIFICATION QUESTIONNAIRE ANSWERS (IF COMPLETED) -->
                        @if (!string.IsNullOrWhiteSpace(_selectedRequest?.QualificationAnswersJson))
                        {
                            try
                            {
                                using var doc = System.Text.Json.JsonDocument.Parse(_selectedRequest.QualificationAnswersJson);
                                var root = doc.RootElement;
                                var tierTitle = root.TryGetProperty("TierCardTitle", out var tTitle) ? tTitle.GetString() : "Pricing Tier";
                                var verifiedAt = root.TryGetProperty("VerifiedAt", out var vAt) ? vAt.GetString() : "";

                                <div class="card border rounded-3 shadow-none bg-white mb-3">
                                    <div class="card-header py-2 px-3 fw-bold d-flex justify-content-between align-items-center" style="background-color: #f0fdf4; border-bottom: 1px solid #bbf7d0; color: #166534;">
                                        <div class="d-flex align-items-center gap-2">
                                            <i class="bi bi-patch-check-fill text-success fs-5"></i>
                                            <span>Rate Qualification Verified: @tierTitle</span>
                                        </div>
                                        @if (!string.IsNullOrEmpty(verifiedAt))
                                        {
                                            <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-2 py-1">
                                                <i class="bi bi-clock-history me-1"></i>Verified: @verifiedAt
                                            </span>
                                        }
                                    </div>
                                    <div class="card-body p-3">
                                        @if (root.TryGetProperty("Section1Answers", out var sec1) && sec1.ValueKind == System.Text.Json.JsonValueKind.Array && sec1.GetArrayLength() > 0)
                                        {
                                            <div class="mb-3">
                                                <div class="small fw-bold text-dark text-uppercase mb-2" style="font-size: 0.75rem; letter-spacing: 0.5px;">
                                                    Section 1: Qualifying Entity / Cause
                                                </div>
                                                <div class="d-flex flex-column gap-2">
                                                    @foreach (var item in sec1.EnumerateArray())
                                                    {
                                                        var qTitle = item.TryGetProperty("Title", out var t) ? t.GetString() : "";
                                                        var qAns = item.TryGetProperty("Answer", out var a) ? a.GetString() : "NO";
                                                        var qAttach = item.TryGetProperty("RequiredAttachmentNote", out var att) ? att.GetString() : "";
                                                        bool isYes = string.Equals(qAns, "YES", StringComparison.OrdinalIgnoreCase);

                                                        <div class="p-2 px-3 rounded-2 border @(isYes ? "bg-success bg-opacity-10 border-success-subtle" : "bg-light border-secondary-subtle") d-flex align-items-center justify-content-between gap-2">
                                                            <div>
                                                                <span class="small fw-bold @(isYes ? "text-dark" : "text-muted")">@qTitle</span>
                                                                @if (!string.IsNullOrEmpty(qAttach))
                                                                {
                                                                    <div class="text-secondary small" style="font-size: 0.72rem;"><i class="bi bi-paperclip me-1"></i>@qAttach</div>
                                                                }
                                                            </div>
                                                            <span class="badge @(isYes ? "bg-success" : "bg-secondary") px-2.5 py-1">@qAns</span>
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                        }

                                        @if (root.TryGetProperty("Section2Answers", out var sec2) && sec2.ValueKind == System.Text.Json.JsonValueKind.Array && sec2.GetArrayLength() > 0)
                                        {
                                            <div>
                                                <div class="small fw-bold text-dark text-uppercase mb-2" style="font-size: 0.75rem; letter-spacing: 0.5px;">
                                                    Section 2: Event Integrity &amp; Criteria Compliance
                                                </div>
                                                <div class="d-flex flex-column gap-2">
                                                    @foreach (var item in sec2.EnumerateArray())
                                                    {
                                                        var qTitle = item.TryGetProperty("Title", out var t) ? t.GetString() : "";
                                                        var qAns = item.TryGetProperty("Answer", out var a) ? a.GetString() : "NO";
                                                        bool isYes = string.Equals(qAns, "YES", StringComparison.OrdinalIgnoreCase);

                                                        <div class="p-2 px-3 rounded-2 border @(isYes ? "bg-success bg-opacity-10 border-success-subtle" : "bg-danger bg-opacity-10 border-danger-subtle") d-flex align-items-center justify-content-between gap-2">
                                                            <span class="small fw-bold @(isYes ? "text-dark" : "text-danger")">@qTitle</span>
                                                            <span class="badge @(isYes ? "bg-success" : "bg-danger") px-2.5 py-1">@qAns</span>
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                            catch { }
                        }

                        <!-- 5. AGREEMENTS & SUBMISSION TIMESTAMP -->
                        <div class="card border rounded-3 shadow-none bg-white mb-3">
                            <div class="card-header section-header-success py-2 px-3 fw-bold d-flex justify-content-between align-items-center">
                                <span><i class="bi bi-shield-check text-success me-2 fs-5"></i>Accepted Terms, Policies &amp; Digital Signature</span>
                                @if (!string.IsNullOrEmpty(effectiveTimestamp))
                                {
                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1">
                                        <i class="bi bi-clock-history me-1"></i>Submitted: @effectiveTimestamp
                                    </span>
                                }
                            </div>
                            <div class="card-body p-3">
                                <div class="text-muted small fw-bold text-uppercase mb-2" style="font-size: 0.75rem; letter-spacing: 0.5px;">
                                    Acknowledged Policies &amp; Agreements (@acceptedPoliciesList.Count)
                                </div>
                                
                                <div class="d-flex flex-column gap-2 mb-3">
                                    @foreach (var pol in acceptedPoliciesList)
                                    {
                                        <div class="p-2 px-3 rounded-3 border bg-light d-flex align-items-center justify-content-between gap-3">
                                            <div class="d-flex align-items-center gap-2 flex-wrap min-w-0">
                                                <i class="bi bi-check-circle-fill text-success fs-6 flex-shrink-0"></i>
                                                <span class="fw-semibold text-dark small text-break">@pol.Title</span>
                                                @if (!string.IsNullOrEmpty(pol.Tag))
                                                {
                                                    <span class="badge bg-white text-dark border border-secondary-subtle px-2 py-0.5 shadow-sm fw-semibold flex-shrink-0" style="font-size: 0.72rem;">@pol.Tag</span>
                                                }
                                            </div>
                                            <span class="badge py-1 px-3 small fw-bold shadow-sm d-inline-flex align-items-center gap-1 flex-shrink-0 ms-auto" style="background-color: #15803d !important; color: #ffffff !important; border: 1px solid #166534 !important; font-size: 0.8rem; letter-spacing: 0.3px;">
                                                <i class="bi bi-shield-fill-check"></i>Accepted
                                            </span>
                                        </div>
                                    }
                                </div>

                                <div class="row g-3 pt-2 border-top">
                                    <div class="col-md-6">
                                        <div class="text-muted small">Applicant Digital Signature</div>
                                        <div class="fw-bold font-monospace bg-light p-2 rounded border text-dark">
                                            <i class="bi bi-pen me-1 text-primary"></i>@effectiveSignature
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="text-muted small">Submission Timestamp</div>
                                        <div class="fw-semibold p-2 bg-light rounded border text-dark">
                                            <i class="bi bi-calendar-check text-primary me-1"></i>
                                            @(string.IsNullOrEmpty(effectiveTimestamp) ? "Recorded" : effectiveTimestamp)
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- 6. AUDIT TRAIL & CHANGE HISTORY CARD -->
                        <div class="card border rounded-3 shadow-none bg-white mb-3">
                            <div class="card-header section-header-secondary py-2 px-3 fw-bold d-flex justify-content-between align-items-center">
                                <span><i class="bi bi-journal-text text-secondary me-2 fs-5"></i>Audit Trail &amp; Modification History</span>
                                <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">Audit Log</span>
                            </div>
                            <div class="card-body p-3">
                                @if (!string.IsNullOrWhiteSpace(_selectedRequest?.InternalNotes))
                                {
                                    <div class="bg-light p-3 rounded-3 border font-monospace small" style="white-space: pre-wrap; font-size: 0.8rem; line-height: 1.5;">@_selectedRequest.InternalNotes</div>
                                }
                                else
                                {
                                    <div class="text-muted small py-2 text-center fst-italic">
                                        <i class="bi bi-info-circle me-1"></i>No modifications or email delivery logs recorded yet for this booking.
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- Collapsible Raw Notes Section -->
                        <div class="mt-3">
                            <button class="btn btn-link btn-sm text-decoration-none p-0 text-muted" type="button" @onclick="() => _showRawNotes = !_showRawNotes">
                                <i class="bi @(_showRawNotes ? "bi-chevron-up" : "bi-chevron-down") me-1"></i>
                                @(_showRawNotes ? "Hide Raw Notes" : "View Raw Description & Details")
                            </button>

                            @if (_showRawNotes && !string.IsNullOrEmpty(_selectedEvent.Description))
                            {
                                <div class="p-3 bg-light rounded-3 border mt-2">
                                    <pre class="small mb-0 text-dark" style="white-space: pre-wrap; font-family: inherit;">@_selectedEvent.Description</pre>
                                </div>
                            }
                        </div>
                        }
                    }
                </div>

                <!-- Modal Footer -->
                <div class="modal-footer bg-light border-top p-3 px-4 d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <div class="d-flex align-items-center gap-2">
                        <button type="button" class="btn btn-outline-danger btn-sm rounded-pill px-3 shadow-sm" @onclick="PromptCancelOrRemoveEvent" title="Cancel booking or remove this event">
                            <i class="bi bi-trash3 me-1"></i>Cancel / Delete Event
                        </button>
                    </div>
                    <div class="d-flex align-items-center gap-2 flex-wrap ms-auto">
                        @if (isInquiry)
                        {
                            @if (_selectedRequest != null)
                            {
                                @if (_selectedRequest.Status == "Archived")
                                {
                                    <button type="button" class="btn btn-outline-success btn-sm rounded-pill px-3 shadow-sm d-flex align-items-center gap-1" @onclick="() => UnarchiveInquiryAsync(_selectedRequest)" title="Restore inquiry to active inquiries list">
                                        <i class="bi bi-arrow-counterclockwise"></i>
                                        <span>Restore Inquiry</span>
                                    </button>
                                }
                                else
                                {
                                    <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill px-3 shadow-sm d-flex align-items-center gap-1" @onclick="() => PromptArchiveInquiry(_selectedRequest)" title="Archive inquiry and save to FAQ review pool">
                                        <i class="bi bi-archive-fill text-muted"></i>
                                        <span>Archive Inquiry (FAQ Review)</span>
                                    </button>
                                }
                            }
                            <button type="button" class="btn btn-primary btn-sm rounded-pill px-3 shadow-sm d-flex align-items-center gap-1 fw-bold" @onclick="OpenReplyToInquiryModal" title="Compose and email reply to visitor">
                                <i class="bi bi-reply-fill"></i>
                                <span>Reply to Inquiry</span>
                            </button>
                            <div class="vr mx-1 d-none d-sm-block" style="height: 24px;"></div>
                            <button type="button" class="btn btn-secondary btn-sm rounded-pill px-4 shadow-sm" @onclick="CloseEventDetailsModal">Close</button>
                        }
                        else if (isClub)
                        {
                            <button type="button" class="btn btn-primary btn-sm rounded-pill px-3 shadow-sm d-flex align-items-center gap-1" @onclick="() => OpenEditEventModal(_selectedEvent)" title="Edit Club Event">
                                <i class="bi bi-pencil-square"></i>
                                <span class="fw-semibold">Edit Event</span>
                            </button>
                            <div class="vr mx-1 d-none d-sm-block" style="height: 24px;"></div>
                            <button type="button" class="btn btn-secondary btn-sm rounded-pill px-4 shadow-sm" @onclick="CloseEventDetailsModal">Close</button>
                        }
                        else if (_isEditingBooking || HasPendingModifications())
                        {
                            var diffCount = CalculateDiffs().Count;
                            <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill px-3 shadow-sm" @onclick="CancelBookingEditMode">
                                <i class="bi bi-x-lg me-1"></i>Discard Changes
                            </button>
                            <button type="button" class="btn btn-primary btn-sm rounded-pill px-4 shadow-sm fw-bold animate-pulse" @onclick="InitiateSaveBookingChanges" disabled="@_isSavingAdjustments">
                                @if (_isSavingAdjustments)
                                {
                                    <span class="spinner-border spinner-border-sm me-1"></span>
                                    <span>Saving...</span>
                                }
                                else
                                {
                                    <i class="bi bi-check2-circle me-1"></i>
                                    <span>Review &amp; Save Changes @(diffCount > 0 ? $"({diffCount})" : "")</span>
                                }
                            </button>
                        }
                        else
                        {
                            <button type="button" class="btn btn-outline-success btn-sm rounded-pill px-3 shadow-sm" @onclick="() => OpenRecordPaymentModal(_selectedEvent)">
                                <i class="bi bi-cash-stack me-1"></i>Add Payment
                            </button>
                            <button type="button" class="btn btn-outline-info text-dark btn-sm rounded-pill px-3 shadow-sm fw-semibold" @onclick="OpenResendQuoteConfirmation" disabled="@_isResendingQuote" title="Email current updated booking & quote to applicant">
                                <i class="bi bi-envelope-paper-fill me-1 text-primary"></i>
                                <span>Email Updated Event</span>
                            </button>
                            @if ((!string.IsNullOrWhiteSpace(_selectedRequest?.RequesterEmail) || !string.IsNullOrWhiteSpace(appDetails.Email)) && modalPaySummary.RemainingBalance > 0)
                            {
                                <button type="button" class="btn btn-outline-warning text-dark btn-sm rounded-pill px-3 shadow-sm fw-semibold" @onclick="OpenPaymentReminderConfirmation" disabled="@_isSendingPaymentReminder" title="Send payment & balance reminder email to applicant">
                                <i class="bi bi-credit-card-2-front me-1 text-warning"></i>
                                <span>Send Payment Reminder</span>
                            </button>
                            }
                            @if (isPending)
                            {
                                <button type="button" class="btn btn-success btn-sm rounded-pill px-3 shadow-sm fw-bold" @onclick="PromptApproveBooking" disabled="@_isApprovingBooking" title="Approve this rental booking and remove PENDING prefix">
                                    <i class="bi bi-check2-circle me-1"></i>
                                    <span>Approve Booking</span>
                                </button>
                            }
                            <div class="vr mx-1 d-none d-sm-block" style="height: 24px;"></div>
                            <button type="button" class="btn btn-secondary btn-sm rounded-pill px-4 shadow-sm" @onclick="CloseEventDetailsModal">Close</button>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<!-- ========================================================================= -->
<!-- CONFIRM RESEND QUOTE EMAIL MODAL -->
<!-- ========================================================================= -->
@if (_showResendQuoteConfirmModal && _selectedEvent != null)
{
    var confirmAppData = ParseApplicationDetails(_selectedEvent);
    var confirmEmail = !string.IsNullOrWhiteSpace(_selectedRequest?.RequesterEmail) ? _selectedRequest.RequesterEmail : confirmAppData.Email;
    var confirmPaySummary = GetEventPaymentSummary(_selectedEvent);
    var confirmName = !string.IsNullOrWhiteSpace(_selectedRequest?.ApplicantName) ? _selectedRequest.ApplicantName : (confirmAppData.ApplicantName ?? GetCleanTitle(_selectedEvent));
    var confirmRoom = !string.IsNullOrWhiteSpace(_selectedRequest?.RoomSelected) ? _selectedRequest.RoomSelected : (_selectedEvent.Location ?? "Function Hall");
    var confirmPrice = _selectedRequest != null ? _selectedRequest.TotalPrice : confirmPaySummary.TotalPrice;
    var confirmDeposit = _selectedRequest != null && _selectedRequest.SecurityDepositAmount > 0 ? _selectedRequest.SecurityDepositAmount : confirmPaySummary.DepositRequired;

    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.75); z-index: 1060;" role="dialog">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="modal-header bg-primary text-white p-3 px-4">
                    <h5 class="modal-title fw-bold mb-0 d-flex align-items-center gap-2">
                        <i class="bi bi-envelope-paper"></i>
                        <span>Confirm Resend Quote</span>
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => _showResendQuoteConfirmModal = false"></button>
                </div>
                <div class="modal-body p-4">
                    <p class="text-muted small mb-3">
                        Are you sure you want to send the latest rental quote and pricing breakdown to the applicant?
                    </p>

                    <div class="card border rounded-3 p-3 bg-light mb-3">
                        <div class="row g-2 small">
                            <div class="col-12 d-flex justify-content-between border-bottom pb-2">
                                <span class="text-muted">Recipient Email:</span>
                                <span class="fw-bold text-dark">@confirmEmail</span>
                            </div>
                            <div class="col-12 d-flex justify-content-between border-bottom pb-2">
                                <span class="text-muted">Applicant Name:</span>
                                <span class="fw-bold text-dark">@confirmName</span>
                            </div>
                            <div class="col-12 d-flex justify-content-between border-bottom pb-2">
                                <span class="text-muted">Event Date &amp; Space:</span>
                                <span class="fw-bold text-dark">@_selectedEvent.Start.ToString("MMM dd, yyyy") (@confirmRoom)</span>
                            </div>
                            <div class="col-12 d-flex justify-content-between @(_webSettings?.RequireSecurityDeposit == true ? "border-bottom pb-2" : "")">
                                <span class="text-muted">Rental Price:</span>
                                <span class="fw-bold text-primary">$@confirmPrice.ToString("N2")</span>
                            </div>
                            @if (_webSettings?.RequireSecurityDeposit == true)
                            {
                                <div class="col-12 d-flex justify-content-between">
                                    <span class="text-muted">Security Deposit:</span>
                                    <span class="fw-bold text-warning-emphasis">$@confirmDeposit.ToString("N2")</span>
                                </div>
                            }
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold text-dark mb-1">
                            Optional Memo / Note to Applicant <span class="text-muted font-normal">(Recorded to Audit Trail &amp; Email)</span>:
                        </label>
                        <div class="mb-2">
                            <select class="form-select form-select-sm" @onchange="OnResendQuotePresetSelected">
                                <option value="">-- Choose a preset reason or enter custom below (Optional) --</option>
                                @foreach (var reason in (_webSettings?.GetModificationReasonPresetsList() ?? WebsiteSettings.GetDefaultModificationReasonPresets()))
                                {
                                    <option value="@reason">@reason</option>
                                }
                            </select>
                        </div>
                        <input type="text" class="form-control form-control-sm" placeholder="e.g. Updated quote per your phone request" @bind="_resendQuoteCustomNote" />
                    </div>

                    <div class="alert alert-info py-2 px-3 small d-flex align-items-center gap-2 mb-0">
                        <i class="bi bi-info-circle-fill text-info flex-shrink-0"></i>
                        <span>This will send a formatted quote email directly to <strong>@confirmEmail</strong>.</span>
                    </div>
                </div>
                <div class="modal-footer bg-light border-top p-3 px-4 d-flex justify-content-between">
                    <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill px-3" @onclick="() => _showResendQuoteConfirmModal = false" disabled="@_isResendingQuote">
                        Cancel
                    </button>
                    <button type="button" class="btn btn-primary btn-sm rounded-pill px-4 shadow-sm fw-bold" @onclick="ConfirmAndSendQuoteAsync" disabled="@_isResendingQuote">
                        @if (_isResendingQuote)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                            <span>Sending Quote...</span>
                        }
                        else
                        {
                            <i class="bi bi-send-fill me-1"></i>
                            <span>Send Quote Email</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- ========================================================================= -->
<!-- CONFIRM BOOKING APPROVAL MODAL -->
<!-- ========================================================================= -->
@if (_showApproveBookingConfirmModal && _selectedEvent != null)
{
    var appData = ParseApplicationDetails(_selectedEvent);
    var cleanName = !string.IsNullOrWhiteSpace(_selectedRequest?.ApplicantName) ? _selectedRequest.ApplicantName : (appData.ApplicantName ?? GetCleanTitle(_selectedEvent));
    var spaceName = !string.IsNullOrWhiteSpace(_selectedRequest?.RoomSelected) ? _selectedRequest.RoomSelected : (_selectedEvent.Location ?? "Function Hall");
    var paySummary = GetEventPaymentSummary(_selectedEvent);
    var totalPrice = _selectedRequest != null ? _selectedRequest.TotalPrice : paySummary.TotalPrice;

    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.75); z-index: 1060;" role="dialog">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="modal-header bg-success text-white p-3 px-4">
                    <h5 class="modal-title fw-bold mb-0 d-flex align-items-center gap-2">
                        <i class="bi bi-check2-circle"></i>
                        <span>Confirm Booking Approval</span>
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => _showApproveBookingConfirmModal = false"></button>
                </div>
                <div class="modal-body p-4">
                    <p class="text-muted small mb-3">
                        Are you sure you want to approve this rental booking?
                    </p>

                    <div class="card border rounded-3 p-3 bg-light mb-3">
                        <div class="row g-2 small">
                            <div class="col-12 d-flex justify-content-between border-bottom pb-2">
                                <span class="text-muted">Applicant Name:</span>
                                <span class="fw-bold text-dark">@cleanName</span>
                            </div>
                            <div class="col-12 d-flex justify-content-between border-bottom pb-2">
                                <span class="text-muted">Event Date &amp; Space:</span>
                                <span class="fw-bold text-dark">@_selectedEvent.Start.ToString("dddd, MMM dd, yyyy") (@spaceName)</span>
                            </div>
                            <div class="col-12 d-flex justify-content-between border-bottom pb-2">
                                <span class="text-muted">Time Window:</span>
                                <span class="fw-bold text-dark">@(_selectedEvent.IsAllDay ? "All Day" : $"{_selectedEvent.Start:h:mm tt} - {_selectedEvent.End:h:mm tt}")</span>
                            </div>
                            <div class="col-12 d-flex justify-content-between">
                                <span class="text-muted">Agreed Price:</span>
                                <span class="fw-bold text-success">$@totalPrice.ToString("N2")</span>
                            </div>
                        </div>
                    </div>

                    <div class="alert alert-success bg-success bg-opacity-10 border border-success-subtle py-2 px-3 small d-flex align-items-center gap-2 mb-3">
                        <i class="bi bi-info-circle-fill text-success flex-shrink-0"></i>
                        <span>This will mark the application <strong>APPROVED</strong> in the database and remove the "PENDING" prefix from Google Calendar.</span>
                    </div>

                    @if (paySummary.RemainingBalance > 0 && totalPrice > 0)
                    {
                        <div class="alert alert-warning border border-warning shadow-sm rounded-3 p-3 mb-3">
                            <div class="d-flex align-items-start gap-2">
                                <i class="bi bi-exclamation-triangle-fill fs-5 text-warning-emphasis flex-shrink-0 mt-0.5"></i>
                                <div>
                                    <strong class="text-dark d-block">Outstanding Balance Pending ($@paySummary.RemainingBalance.ToString("N2"))</strong>
                                    <div class="small text-muted mb-2">
                                        Full payment has not been recorded yet (Total Quoted: $@totalPrice.ToString("N2"), Total Paid: $@paySummary.TotalPaid.ToString("N2")).
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" id="overrideUnpaidApprovalChk" @bind="_overrideUnpaidBookingApproval" />
                                        <label class="form-check-label small fw-bold text-dark" for="overrideUnpaidApprovalChk">
                                            Approve without full payment (Manual administrator override)
                                        </label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }

                    @{
                        bool isMemberSelected = (_selectedRequest != null && (_selectedRequest.MemberStatus || string.Equals(_selectedRequest.RenterType, "Member", StringComparison.OrdinalIgnoreCase))) ||
                                                (appData.IsClubMember != null && (appData.IsClubMember.Equals("Yes", StringComparison.OrdinalIgnoreCase) || appData.IsClubMember.Equals("True", StringComparison.OrdinalIgnoreCase)));
                        var memberVerifyModal = VerifyApplicantMembership(cleanName, _selectedRequest?.RequesterEmail ?? appData.Email, _selectedRequest?.RequesterPhone ?? appData.Phone);
                        bool isMemberUnverified = isMemberSelected && (!memberVerifyModal.IsExactMatch || memberVerifyModal.ExactMember == null);
                    }

                    @if (isMemberUnverified)
                    {
                        <div class="alert alert-danger border border-danger shadow-sm rounded-3 p-3 mb-3">
                            <div class="d-flex align-items-start gap-2">
                                <i class="bi bi-shield-exclamation fs-4 text-danger flex-shrink-0 mt-0.5"></i>
                                <div>
                                    <strong class="text-danger d-block fs-6">Unverified Member Rate Warning</strong>
                                    <div class="small text-dark mt-1 mb-2">
                                        Applicant requested <strong>GFC Member Rate</strong>, but no matching name, email, or phone was found in the Member Directory.
                                    </div>
                                    <div class="form-check p-2 bg-white rounded border border-danger-subtle">
                                        <input class="form-check-input ms-0 me-2" type="checkbox" id="overrideUnverifiedMemberApprovalChk" @bind="_overrideUnverifiedMemberApproval" />
                                        <label class="form-check-label small fw-bold text-danger" for="overrideUnverifiedMemberApprovalChk">
                                            I understand this applicant is not verified in the Member Directory and confirm approving at the Member Rate.
                                        </label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }

                    <div class="mb-3">
                        <label class="form-label small fw-bold text-dark mb-1">
                            Approval Note / Memo <span class="text-muted font-normal">(Recorded to Audit Trail &amp; Email)</span>:
                        </label>
                        <div class="mb-2">
                            <select class="form-select form-select-sm" @onchange="OnApprovalReasonPresetSelected">
                                <option value="">-- Choose a preset note or enter custom below (Optional) --</option>
                                @foreach (var reason in (_webSettings?.GetModificationReasonPresetsList() ?? WebsiteSettings.GetDefaultModificationReasonPresets()))
                                {
                                    <option value="@reason">@reason</option>
                                }
                            </select>
                        </div>
                        <input type="text" class="form-control form-control-sm" placeholder="e.g. Approved per Rental Committee review" @bind="_approvalReasonNote" />
                    </div>

                    @if (!string.IsNullOrWhiteSpace(_selectedRequest?.RequesterEmail) || !string.IsNullOrWhiteSpace(appData.Email))
                    {
                        var targetEmail = !string.IsNullOrWhiteSpace(_selectedRequest?.RequesterEmail) ? _selectedRequest.RequesterEmail : appData.Email;
                        <div class="p-3 bg-white rounded-3 border">
                            <div class="form-check form-switch mb-0">
                                <input class="form-check-input" type="checkbox" role="switch" id="sendApprEmailSw" @bind="_sendApprovalEmailOnConfirm" />
                                <label class="form-check-label fw-bold text-dark small" for="sendApprEmailSw">
                                    <i class="bi bi-envelope-check-fill text-success me-1"></i>Send Booking Approval Email to Applicant
                                </label>
                                <small class="text-muted d-block">Sends the official approval &amp; calendar confirmed notice to <strong>@targetEmail</strong></small>
                            </div>
                        </div>
                    }
                </div>
                <div class="modal-footer bg-light border-top p-3 px-4 d-flex justify-content-between">
                    <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill px-3" @onclick="() => _showApproveBookingConfirmModal = false" disabled="@_isApprovingBooking">
                        Cancel
                    </button>
                    @{
                        var isPaymentBlocked = paySummary.RemainingBalance > 0 && totalPrice > 0 && !_overrideUnpaidBookingApproval;
                        var isMemberBlocked = isMemberUnverified && !_overrideUnverifiedMemberApproval;
                        var isApprovalBlocked = isPaymentBlocked || isMemberBlocked;
                    }
                    <button type="button" class="btn btn-success btn-sm rounded-pill px-4 shadow-sm fw-bold" @onclick="ConfirmAndApproveBookingAsync" disabled="@(_isApprovingBooking || isApprovalBlocked)">
                        @if (_isApprovingBooking)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                            <span>Approving...</span>
                        }
                        else
                        {
                            <i class="bi bi-check-lg me-1"></i>
                            <span>Confirm &amp; Approve</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- ========================================================================= -->
<!-- CONFIRM PAYMENT REMINDER EMAIL MODAL -->
<!-- ========================================================================= -->
@if (_showPaymentReminderModal && _selectedEvent != null)
{
    var remAppData = ParseApplicationDetails(_selectedEvent);
