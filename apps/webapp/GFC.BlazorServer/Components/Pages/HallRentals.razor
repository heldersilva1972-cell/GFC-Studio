@page "/hall-rentals"
@using GFC.Core.Models
@using GFC.Core.Interfaces
@using GFC.BlazorServer.Services
@using Microsoft.AspNetCore.Components.Forms
@using System.Text.RegularExpressions
@inject IGoogleCalendarService CalendarService
@inject IUserManagementService UserService
@inject IRentalService RentalService
@inject IRentalEmailDispatcher RentalEmailDispatcher
@inject GFC.Core.Interfaces.IWebsiteSettingsService WebsiteSettingsService
@inject GFC.BlazorServer.Services.CustomAuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JSRuntime
@inject IToastService ToastService
@inject NavigationManager Navigation
@attribute [Authorize]
@rendermode InteractiveServer

<div class="hall-rentals-container">
    @if (!_hasPageAccess && !_isAdmin)
    {
        <div class="access-denied-panel text-center py-5">
            <div class="bg-light rounded-circle shadow-sm d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px;">
                <i class="bi bi-shield-lock-fill text-danger fs-1"></i>
            </div>
            <h3 class="fw-bold text-dark">Access Restricted</h3>
            <p class="text-muted">You do not have permission to view the Hall Rentals page. Please contact your system administrator.</p>
        </div>
    }
    else
    {
        <!-- Page Header -->
        <div class="dashboard-header d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
            <div>
                <h1 class="dashboard-title mb-1">
                    <i class="bi bi-calendar2-week-fill text-gold me-2"></i>
                    Hall Rentals
                </h1>
                <p class="dashboard-subtitle text-muted mb-0">Multi-calendar synchronization, event schedules, and hall rental applications</p>
            </div>
            <div class="header-actions d-flex gap-2 flex-wrap">
                <button class="btn btn-outline-secondary d-flex align-items-center gap-2 shadow-sm" @onclick="ExportCalendarIcs" disabled="@(_events.Count == 0)">
                    <i class="bi bi-download"></i>
                    <span>Export (.ics)</span>
                </button>
                <button class="btn btn-success d-flex align-items-center gap-2 shadow-sm" @onclick="OpenAddEventModal">
                    <i class="bi bi-calendar-plus-fill"></i>
                    <span>Add Booking</span>
                </button>
                <button class="btn btn-warning d-flex align-items-center gap-2 shadow-sm text-dark fw-semibold" @onclick='() => Navigation.NavigateTo("/hall-rentals/settings?tab=simulator")'>
                    <i class="bi bi-controller"></i>
                    <span>Test Form (Simulate)</span>
                </button>
                <button class="btn btn-outline-primary d-flex align-items-center gap-2 shadow-sm" @onclick='() => Navigation.NavigateTo("/hall-rentals/settings")'>
                    <i class="bi bi-sliders2-vertical"></i>
                    <span>Rental Settings</span>
                    @if (_settings.Feeds.Count > 1)
                    {
                        <span class="badge bg-primary rounded-pill">@_settings.Feeds.Count</span>
                    }
                </button>
                <button class="btn btn-primary d-flex align-items-center gap-2 shadow-sm" @onclick="SyncCalendarNow" disabled="@_isSyncing">
                    @if (_isSyncing)
                    {
                        <span class="spinner-border spinner-border-sm" role="status"></span>
                        <span>Syncing...</span>
                    }
                    else
                    {
                        <i class="bi bi-arrow-repeat"></i>
                        <span>Sync Now</span>
                    }
                </button>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(_syncMessage))
        {
            <div class="alert @(_syncSuccess ? "alert-success" : "alert-warning") alert-dismissible fade show shadow-sm" role="alert">
                <i class="bi @(_syncSuccess ? "bi-check-circle-fill" : "bi-exclamation-triangle-fill") me-2"></i>
                @_syncMessage
                <button type="button" class="btn-close" @onclick="() => _syncMessage = null"></button>
            </div>
        }

        <!-- Metric Stat Overview -->
        <div class="row g-3 mb-4">
            <div class="col-sm-6 col-xl-3">
                <div class="stat-card stat-primary">
                    <div class="stat-icon">
                        <i class="bi bi-calendar-event"></i>
                    </div>
                    <div class="stat-content">
                        <div class="stat-label">Total Synced Events</div>
                        <div class="stat-value">@_events.Count</div>
                    </div>
                </div>
            </div>
            <div class="col-sm-6 col-xl-3">
                <div class="stat-card stat-success">
                    <div class="stat-icon">
                        <i class="bi bi-calendar-check"></i>
                    </div>
                    <div class="stat-content">
                        <div class="stat-label">Upcoming (Next 30 Days)</div>
                        <div class="stat-value">@GetUpcomingCount()</div>
                    </div>
                </div>
            </div>
            <div class="col-sm-6 col-xl-3">
                <div class="stat-card stat-warning">
                    <div class="stat-icon">
                        <i class="bi bi-clock-history"></i>
                    </div>
                    <div class="stat-content">
                        <div class="stat-label">Pending Applications</div>
                        <div class="stat-value text-warning">@GetPendingCount()</div>
                    </div>
                </div>
            </div>
            <div class="col-sm-6 col-xl-3">
                <div class="stat-card stat-info">
                    <div class="stat-icon">
                        <i class="bi bi-layers-fill"></i>
                    </div>
                    <div class="stat-content">
                        <div class="stat-label">Connected Calendars</div>
                        <div class="stat-value">@(_settings.Feeds.Count(f => f.IsEnabled)) <span class="small text-muted" style="font-size: 0.8rem;">Active</span></div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ACTIVE CALENDAR SOURCE & MODE BANNER -->
        <div class="card border-0 rounded-3 mb-4 shadow-sm @(_webSettings?.EnableSandboxMode == true ? "bg-warning bg-opacity-10 border border-warning" : "bg-primary bg-opacity-10 border border-primary-subtle")">
            <div class="card-body p-3">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <div class="d-flex align-items-center gap-3 flex-wrap">
                        @if (_webSettings?.EnableSandboxMode == true)
                        {
                            <span class="badge bg-warning text-dark px-3 py-2 fs-6 shadow-sm">
                                <i class="bi bi-shield-fill-check me-1"></i>SANDBOX TEST MODE
                            </span>
                            <div>
                                <strong class="text-dark">Currently Viewing:</strong>
                                <span class="badge bg-white text-dark border border-warning ms-1 px-2 py-1 shadow-sm" title="@_webSettings?.SandboxGoogleCalendarId">
                                    <i class="bi bi-google text-danger me-1"></i>@GetSandboxCalendarDisplayName()
                                </span>
                                <span class="small text-muted ms-2">(Real club schedules &amp; public customer emails are protected)</span>
                            </div>
                        }
                        else
                        {
                            <span class="badge bg-success px-3 py-2 fs-6 shadow-sm">
                                <i class="bi bi-broadcast me-1"></i>LIVE PRODUCTION
                            </span>
                            <div>
                                <strong class="text-dark">Currently Viewing:</strong>
                                @if (_settings.Feeds.Any(f => f.IsEnabled))
                                {
                                    @foreach (var feed in _settings.Feeds.Where(f => f.IsEnabled))
                                    {
                                        <span class="badge bg-white text-dark border ms-1 px-2 py-1 shadow-sm" style="border-left: 3px solid @feed.Color !important;">
                                            <i class="bi bi-circle-fill me-1" style="color: @feed.Color; font-size: 0.6rem;"></i>@feed.Name
                                        </span>
                                    }
                                }
                                else
                                {
                                    <span class="badge bg-white text-dark border ms-1 px-2 py-1">
                                        @(_settings.CalendarName ?? "Primary Calendar")
                                    </span>
                                }
                            </div>
                        }
                    </div>

                    <div class="d-flex align-items-center gap-2">
                        <button type="button" class="btn btn-sm btn-outline-dark" @onclick='() => Navigation.NavigateTo("/hall-rentals/settings?tab=calendar")'>
                            <i class="bi bi-sliders me-1"></i>Switch / Manage Calendars
                        </button>
                    </div>
                </div>

                <!-- Source Badges Filter Strip / Calendar Selector -->
                <div class="d-flex align-items-center gap-2 mt-2 pt-2 border-top flex-wrap" style="font-size: 0.88rem;">
                    <span class="text-dark fw-bold me-1"><i class="bi bi-calendar-range-fill text-primary me-1"></i>Active Calendar View:</span>
                    <button type="button" class="btn btn-sm @(string.IsNullOrEmpty(_filterFeedSource) ? "btn-dark shadow-sm fw-bold" : "btn-outline-secondary") px-3 py-1" @onclick='() => _filterFeedSource = ""'>
                        <i class="bi bi-collection-fill me-1"></i> All Calendars (@_events.Count)
                    </button>
                    @foreach (var src in _events.Select(e => e.Source ?? "Google Calendar").Distinct().OrderBy(s => s))
                    {
                        var srcCount = _events.Count(e => (e.Source ?? "Google Calendar") == src);
                        var isSelected = _filterFeedSource == src;
                        <button type="button" class="btn btn-sm @(isSelected ? "btn-primary shadow-sm fw-bold text-white" : "btn-outline-secondary") px-3 py-1" @onclick='() => _filterFeedSource = src'>
                            <i class="bi bi-calendar-check me-1"></i>@src (@srcCount)
                        </button>
                    }
                </div>
            </div>
        </div>

        <!-- View Controls & Filter Bar -->
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-body p-3">
                <div class="row g-3 align-items-center justify-content-between">
                    <div class="col-md-5">
                        <div class="input-group">
                            <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                            <input type="text" class="form-control border-start-0" placeholder="Search by name, event type or date..." @bind="_searchTerm" @bind:event="oninput" />
                            @if (!string.IsNullOrEmpty(_searchTerm))
                            {
                                <button class="btn btn-outline-secondary border-start-0" @onclick="() => _searchTerm = string.Empty">
                                    <i class="bi bi-x-lg"></i>
                                </button>
                            }
                        </div>
                    </div>
                    <div class="col-md-7 d-flex justify-content-md-end gap-2 flex-wrap align-items-center">
                        <div class="btn-group btn-group-sm">
                            <button class="btn @(_filterCategory == "ALL" ? "btn-dark" : "btn-outline-secondary")" @onclick='() => _filterCategory = "ALL"'>All (@_events.Count)</button>
                            <button class="btn @(_filterCategory == "PENDING" ? "btn-warning" : "btn-outline-secondary")" @onclick='() => _filterCategory = "PENDING"'>Pending (@GetPendingCount())</button>
                            <button class="btn @(_filterCategory == "PAID" ? "btn-success" : "btn-outline-secondary")" @onclick='() => _filterCategory = "PAID"'>Paid (@GetPaidEventsCount())</button>
                            <button class="btn @(_filterCategory == "UNPAID" ? "btn-danger" : "btn-outline-secondary")" @onclick='() => _filterCategory = "UNPAID"'>Unpaid</button>
                            <button class="btn @(_filterCategory == "APPLICATIONS" ? "btn-primary" : "btn-outline-secondary")" @onclick='() => _filterCategory = "APPLICATIONS"'>Applications (@GetApplicationsCount())</button>
                        </div>

                        <div class="btn-group shadow-sm" role="group">
                            <button type="button" class="btn @(_activeView == "calendar" ? "btn-primary active" : "btn-outline-secondary")" @onclick='() => _activeView = "calendar"'>
                                <i class="bi bi-calendar3 me-1"></i> Calendar Grid
                            </button>
                            <button type="button" class="btn @(_activeView == "list" ? "btn-primary active" : "btn-outline-secondary")" @onclick='() => _activeView = "list"'>
                                <i class="bi bi-list-ul me-1"></i> Schedule List
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @if (_activeView == "calendar")
        {
            <!-- CALENDAR GRID VIEW -->
            <div class="card shadow-sm border-0 mb-4 calendar-wrapper-card">
                <div class="card-body p-3">
                    <div class="calendar-nav-bar d-flex justify-content-between align-items-center mb-3">
                        <button class="btn btn-light rounded-circle shadow-sm" @onclick="() => ChangeMonth(-1)">
                            <i class="bi bi-chevron-left"></i>
                        </button>
                        <h4 class="mb-0 fw-bold text-dark">
                            @_currentMonth.ToString("MMMM yyyy")
                        </h4>
                        <div class="d-flex gap-2">
                            <button class="btn btn-outline-secondary btn-sm" @onclick="() => _currentMonth = DateTime.Today">Today</button>
                            <button class="btn btn-light rounded-circle shadow-sm" @onclick="() => ChangeMonth(1)">
                                <i class="bi bi-chevron-right"></i>
                            </button>
                        </div>
                    </div>

                    <!-- Weekday Header -->
                    <div class="calendar-grid-header">
                        <div class="day-head">Sun</div>
                        <div class="day-head">Mon</div>
                        <div class="day-head">Tue</div>
                        <div class="day-head">Wed</div>
                        <div class="day-head">Thu</div>
                        <div class="day-head">Fri</div>
                        <div class="day-head">Sat</div>
                    </div>

                    <!-- Month Days -->
                    <div class="calendar-grid-body">
                        @{
                            var firstDayOfMonth = new DateTime(_currentMonth.Year, _currentMonth.Month, 1);
                            int leadingOffset = (int)firstDayOfMonth.DayOfWeek;
                            int totalDays = DateTime.DaysInMonth(_currentMonth.Year, _currentMonth.Month);
                        }

                        @for (int i = 0; i < leadingOffset; i++)
                        {
                            <div class="calendar-cell outside-month"></div>
                        }

                        @for (int day = 1; day <= totalDays; day++)
                        {
                            var date = new DateTime(_currentMonth.Year, _currentMonth.Month, day);
                            var dayEvents = GetEventsForDate(date);
                            bool isToday = date.Date == DateTime.Today;

                            <div class="calendar-cell @(isToday ? "cell-today" : "")">
                                <div class="cell-header d-flex justify-content-between align-items-center">
                                    <span class="cell-day-num @(isToday ? "badge bg-primary rounded-circle" : "")">@day</span>
                                    @if (dayEvents.Any())
                                    {
                                        <span class="badge bg-light text-dark border-0">@dayEvents.Count</span>
                                    }
                                </div>
                                <div class="cell-events">
                                    @foreach (var evt in dayEvents.Take(3))
                                    {
                                        var isPending = evt.Title.StartsWith("PENDING", StringComparison.OrdinalIgnoreCase);
                                        var payStatus = GetEventPaymentStatus(evt);
                                        <div class="event-pill @(isPending ? "pill-warning" : "pill-primary")" @onclick="() => ShowEventDetails(evt)" title="@evt.Title">
                                            <div class="d-flex justify-content-between align-items-center w-100">
                                                <span class="event-time">@(evt.IsAllDay ? "All-day" : evt.Start.ToString("h:mm tt"))</span>
                                                @if (payStatus == "Paid")
                                                {
                                                    <span class="badge bg-success text-white py-0 px-1 border border-success-subtle fw-bold" style="font-size: 0.65rem;" title="Paid in Full">PAID</span>
                                                }
                                                else if (payStatus == "Deposit Paid")
                                                {
                                                    <span class="badge py-0 px-1 fw-bold" style="font-size: 0.65rem; background-color: #0284c7 !important; color: #ffffff !important; border: 1px solid #0369a1 !important;" title="Security Deposit Received">DEP PAID</span>
                                                }
                                                else if (payStatus == "Partial")
                                                {
                                                    <span class="badge py-0 px-1 fw-bold" style="font-size: 0.65rem; background-color: #d97706 !important; color: #ffffff !important; border: 1px solid #b45309 !important;" title="Partially Paid">PARTIAL</span>
                                                }
                                            </div>
                                            <span class="event-title-text">@GetCleanTitle(evt)</span>
                                        </div>
                                    }
                                    @if (dayEvents.Count > 3)
                                    {
                                        <div class="more-events-badge" @onclick='() => { _searchTerm = date.ToString("yyyy-MM-dd"); _activeView = "list"; }'>
                                            +@(dayEvents.Count - 3) more
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
        else
        {
            <!-- LIST / SCHEDULE VIEW -->
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th style="width: 130px;">Event Date</th>
                                    <th style="width: 140px;">Time</th>
                                    <th style="width: 110px;">Status</th>
                                    <th style="width: 120px;">Payment</th>
                                    <th>Applicant / Event Title</th>
                                    <th>Event Type</th>
                                    <th>Calendar Source</th>
                                    <th>Location</th>
                                    <th style="width: 90px;" class="text-end">Details</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    var filteredEvents = GetFilteredEvents();
                                }
                                @if (!filteredEvents.Any())
                                {
                                    <tr>
                                        <td colspan="9" class="text-center py-5 text-muted">
                                            <i class="bi bi-calendar-x fs-2 d-block mb-2 text-secondary"></i>
                                            No events found matching your filter criteria.
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var evt in filteredEvents)
                                    {
                                        var details = ParseApplicationDetails(evt);
                                        var isPending = evt.Title.StartsWith("PENDING", StringComparison.OrdinalIgnoreCase);
                                        var isApproved = evt.Title.StartsWith("APPROVED", StringComparison.OrdinalIgnoreCase);
                                        var paySummary = GetEventPaymentSummary(evt);

                                        <tr>
                                            <td class="fw-semibold">
                                                @if (evt.Start.Year > 2000)
                                                {
                                                    <span>@evt.Start.ToString("MMM dd, yyyy")</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">Unspecified Date</span>
                                                }
                                            </td>
                                            <td class="text-muted small">
                                                @(evt.IsAllDay ? "All-Day Event" : $"{evt.Start:h:mm tt} - {evt.End:h:mm tt}")
                                            </td>
                                            <td>
                                                @if (isPending)
                                                {
                                                    <span class="badge px-2 py-1 rounded-pill" style="background-color: #fef3c7 !important; color: #78350f !important; font-weight: 700; border: 1px solid #d97706 !important;">
                                                        <i class="bi bi-hourglass-split me-1 text-warning"></i>Pending
                                                    </span>
                                                }
                                                else if (isApproved)
                                                {
                                                    <span class="badge bg-success-subtle text-success border border-success px-2 py-1 rounded-pill">
                                                        <i class="bi bi-check-circle-fill me-1"></i>Approved
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1 rounded-pill">
                                                        @(evt.Status ?? "CONFIRMED")
                                                    </span>
                                                }
                                            </td>
                                            <td>
                                                @if (paySummary.Status == "Paid")
                                                {
                                                    <span class="badge bg-success text-white px-2 py-1 rounded-pill fw-bold shadow-sm">
                                                        <i class="bi bi-check-circle-fill me-1"></i>Paid Full
                                                    </span>
                                                }
                                                else if (paySummary.Status == "Deposit Paid")
                                                {
                                                    <span class="badge px-2 py-1 rounded-pill fw-bold shadow-sm" style="background-color: #0284c7 !important; color: #ffffff !important; border: 1px solid #0369a1 !important;">
                                                        <i class="bi bi-shield-check me-1"></i>Dep Paid
                                                    </span>
                                                }
                                                else if (paySummary.Status == "Partial")
                                                {
                                                    <span class="badge px-2 py-1 rounded-pill fw-bold shadow-sm" style="background-color: #d97706 !important; color: #ffffff !important; border: 1px solid #b45309 !important;">
                                                        <i class="bi bi-pie-chart me-1"></i>Partial (${paySummary.TotalPaid:N0})
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-light text-dark border border-secondary-subtle px-2 py-1 rounded-pill fw-semibold">
                                                        Unpaid
                                                    </span>
                                                }
                                            </td>
                                            <td>
                                                <div class="fw-bold text-dark">@GetCleanTitle(evt)</div>
                                                @if (!string.IsNullOrEmpty(details.ApplicantName))
                                                {
                                                    <div class="text-muted small">
                                                        <i class="bi bi-person me-1"></i>@details.ApplicantName
                                                        @if (!string.IsNullOrEmpty(details.Email))
                                                        {
                                                            <span class="mx-1">•</span>
                                                            <a href="mailto:@details.Email" class="text-decoration-none text-muted">@details.Email</a>
                                                        }
                                                    </div>
                                                }
                                            </td>
                                            <td>
                                                @if (!string.IsNullOrEmpty(details.EventType))
                                                {
                                                    <span class="badge bg-light text-dark border">@details.EventType</span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted small">—</span>
                                                }
                                            </td>
                                            <td>
                                                <span class="badge bg-light text-dark border px-2 py-1">
                                                    <i class="bi bi-calendar2-range me-1 text-primary"></i>@evt.Source
                                                </span>
                                            </td>
                                            <td>
                                                <span class="text-muted small">@(string.IsNullOrEmpty(evt.Location) ? "Main Function Hall" : evt.Location)</span>
                                            </td>
                                            <td class="text-end">
                                                <button class="btn btn-sm btn-outline-primary rounded-pill px-3 shadow-sm" @onclick="() => ShowEventDetails(evt)">
                                                    <i class="bi bi-eye me-1"></i>View
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
    }
</div>

<!-- ========================================================================= -->
<!-- EVENT DETAILS MODAL (BEAUTIFULLY FORMATTED & EASY TO READ) -->
<!-- ========================================================================= -->
@if (_selectedEvent != null)
{
    var appDetails = ParseApplicationDetails(_selectedEvent);
    var cleanTitle = GetCleanTitle(_selectedEvent);
    var isPending = (_selectedRequest != null && string.Equals(_selectedRequest.Status, "Pending", StringComparison.OrdinalIgnoreCase)) ||
                    _selectedEvent.Title.Contains("PENDING", StringComparison.OrdinalIgnoreCase);
    var isApproved = (_selectedRequest != null && string.Equals(_selectedRequest.Status, "Approved", StringComparison.OrdinalIgnoreCase)) ||
                     _selectedEvent.Title.Contains("APPROVED", StringComparison.OrdinalIgnoreCase);
    var isCancelled = (_selectedRequest != null && string.Equals(_selectedRequest.Status, "Cancelled", StringComparison.OrdinalIgnoreCase)) ||
                      _selectedEvent.Title.Contains("CANCELLED", StringComparison.OrdinalIgnoreCase);

    string effectiveName = !string.IsNullOrWhiteSpace(_selectedRequest?.ApplicantName)
        ? _selectedRequest.ApplicantName
        : (!string.IsNullOrWhiteSpace(appDetails.ApplicantName) ? appDetails.ApplicantName : cleanTitle);

    string? effectivePhone = !string.IsNullOrWhiteSpace(_selectedRequest?.RequesterPhone)
        ? _selectedRequest.RequesterPhone
        : appDetails.Phone;

    string? effectiveEmail = !string.IsNullOrWhiteSpace(_selectedRequest?.RequesterEmail)
        ? _selectedRequest.RequesterEmail
        : appDetails.Email;

    string? effectiveAddress = !string.IsNullOrWhiteSpace(_selectedRequest?.RequesterAddress)
        ? $"{_selectedRequest.RequesterAddress}{(!string.IsNullOrWhiteSpace(_selectedRequest.RequesterCity) ? $", {_selectedRequest.RequesterCity}" : "")}{(!string.IsNullOrWhiteSpace(_selectedRequest.RequesterState) ? $", {_selectedRequest.RequesterState}" : "")}{(!string.IsNullOrWhiteSpace(_selectedRequest.RequesterZip) ? $" {_selectedRequest.RequesterZip}" : "")}"
        : (!string.IsNullOrWhiteSpace(appDetails.StreetAddress)
            ? $"{appDetails.StreetAddress}{(string.IsNullOrWhiteSpace(appDetails.City) ? "" : $", {appDetails.City}")}{(string.IsNullOrWhiteSpace(appDetails.State) ? "" : $", {appDetails.State}")}{(string.IsNullOrWhiteSpace(appDetails.Zip) ? "" : $" {appDetails.Zip}")}"
            : null);

    bool? isMemberVal = _selectedRequest != null
        ? _selectedRequest.MemberStatus
        : (!string.IsNullOrEmpty(appDetails.IsClubMember) ? appDetails.IsClubMember.ToLower().StartsWith("y") : null);

    var modalPaySummary = GetEventPaymentSummary(_selectedEvent);

    string? effectiveTimestamp = _selectedRequest != null && _selectedRequest.CreatedDate.Year > 2000
        ? _selectedRequest.CreatedDate.ToLocalTime().ToString("MMMM dd, yyyy 'at' h:mm tt")
        : (!string.IsNullOrEmpty(appDetails.FormattedTimestamp) ? appDetails.FormattedTimestamp : appDetails.Timestamp);

    string? effectiveSignature = !string.IsNullOrWhiteSpace(_selectedRequest?.ApplicantSignature)
        ? _selectedRequest.ApplicantSignature
        : (!string.IsNullOrWhiteSpace(appDetails.ApplicantSignature) ? appDetails.ApplicantSignature : "Electronic Acceptance");

    var acceptedPoliciesList = GetAcceptedPoliciesForDisplay(_selectedRequest, appDetails);

    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.65);" role="dialog">
        <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable" role="document">
            <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
                <!-- Modal Header -->
                <div class="modal-header bg-light border-bottom p-3 px-4">
                    <div class="d-flex align-items-center gap-3">
                        <div class="p-2 rounded-3 @(isPending ? "bg-warning bg-opacity-25 text-warning-emphasis" : (isCancelled ? "bg-danger bg-opacity-10 text-danger" : "bg-primary bg-opacity-10 text-primary"))">
                            <i class="bi @(isPending ? "bi-hourglass-split" : (isCancelled ? "bi-x-circle-fill" : "bi-calendar-event-fill")) fs-4"></i>
                        </div>
                        <div>
                            <div class="d-flex align-items-center gap-2 mb-1 flex-wrap">
                                <h5 class="modal-title fw-bold mb-0 text-dark">@cleanTitle</h5>
                                @if (isPending)
                                {
                                    <span class="badge bg-warning text-dark fw-bold">PENDING REVIEW</span>
                                }
                                else if (isApproved)
                                {
                                    <span class="badge bg-success">APPROVED</span>
                                }
                                else if (isCancelled)
                                {
                                    <span class="badge bg-danger">CANCELLED</span>
                                }
                                else
                                {
                                    <span class="badge bg-primary">SCHEDULED</span>
                                }
                                @if (_isEditingBooking)
                                {
                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle"><i class="bi bi-pencil me-1"></i>EDIT MODE</span>
                                }
                            </div>
                            <div class="text-muted small">Calendar Source: <strong>@_selectedEvent.Source</strong></div>
                        </div>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        @if (!_isEditingBooking)
                        {
                            <button type="button" class="btn btn-primary btn-sm rounded-pill px-3 shadow-sm d-flex align-items-center gap-1" @onclick="EnterBookingEditMode" title="Modify booking specs, room, services & prices">
                                <i class="bi bi-pencil-square"></i>
                                <span class="fw-semibold">Modify Booking &amp; Prices</span>
                            </button>
                            <button type="button" class="btn btn-outline-dark btn-sm rounded-pill px-3 shadow-sm d-flex align-items-center gap-1" @onclick="PrintSelectedApplication" title="Print application or save as PDF">
                                <i class="bi bi-printer-fill text-primary"></i>
                                <span class="fw-semibold">Print / PDF</span>
                            </button>
                        }
                        else
                        {
                            <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill px-3 shadow-sm" @onclick="CancelBookingEditMode">
                                <i class="bi bi-x-lg me-1"></i>Cancel Edit
                            </button>
                            <button type="button" class="btn btn-primary btn-sm rounded-pill px-3 shadow-sm fw-bold" @onclick="InitiateSaveBookingChanges">
                                <i class="bi bi-check-lg me-1"></i>Review &amp; Save
                            </button>
                        }
                        <button type="button" class="btn-close" @onclick="CloseEventDetailsModal"></button>
                    </div>
                </div>

                <!-- Modal Body -->
                <div class="modal-body p-4">
                    @if (_isEditingBooking && _selectedRequest != null)
                    {
                        <!-- ========================================================= -->
                        <!-- DIRECT EDITING WORKSPACE / FORM -->
                        <!-- ========================================================= -->
                        <!-- 1. EDIT FINANCIALS & PRICE OVERRIDE CARD (STICKY TOP) -->
                        <div class="card border rounded-3 mb-3 shadow-sm bg-white sticky-top-card">
                            <div class="card-header section-header-success py-2 px-3 fw-bold d-flex justify-content-between align-items-center">
                                <span><i class="bi bi-currency-dollar text-success me-2 fs-5"></i>Agreed Price &amp; Security Deposit</span>
                                <button type="button" class="btn btn-outline-success btn-sm fw-semibold shadow-sm" @onclick="AutoCalculateSelectedRequestPrice" title="Recalculate price based on room & active add-ons">
                                    <i class="bi bi-calculator me-1"></i>Auto-Calc Quote
                                </button>
                            </div>
                            <div class="card-body p-3">
                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <label class="form-label small fw-bold text-dark mb-1">Agreed Total Price ($)</label>
                                        <div class="input-group">
                                            <span class="input-group-text">$</span>
                                            <input type="number" step="0.01" class="form-control form-control-lg fw-bold text-success" @bind="_selectedRequest.TotalPrice" />
                                            <button type="button" class="btn btn-outline-secondary" @onclick="AutoCalculateSelectedRequestPrice" title="Reset to standard quote based on selections">
                                                <i class="bi bi-arrow-clockwise me-1"></i>Auto-Calc
                                            </button>
                                        </div>
                                        <small class="text-muted">Enter any custom agreed price, discount, or waiver.</small>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label small fw-bold text-dark mb-1">Security Deposit Required ($)</label>
                                        <div class="input-group">
                                            <span class="input-group-text">$</span>
                                            <input type="number" step="0.01" class="form-control form-control-lg fw-bold text-warning-emphasis" @bind="_selectedRequest.SecurityDepositAmount" />
                                        </div>
                                        <small class="text-muted">Refundable security deposit amount.</small>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="alert alert-primary d-flex align-items-center justify-content-between p-3 rounded-3 mb-3 shadow-sm border border-primary-subtle">
                            <div class="d-flex align-items-center gap-2">
                                <i class="bi bi-info-circle-fill fs-5 text-primary"></i>
                                <div>
                                    <div class="fw-bold">You are modifying this booking</div>
                                    <small class="text-muted">Adjust any applicant info, schedule, room selection, amenities, or price override below. You will review a summary before saving.</small>
                                </div>
                            </div>
                        </div>

                        <!-- 2. EDIT SCHEDULE & ROOM CARD -->
                        <div class="card border rounded-3 mb-3 shadow-none bg-white">
                            <div class="card-header section-header-primary py-2 px-3 fw-bold d-flex justify-content-between align-items-center">
                                <span><i class="bi bi-calendar-event text-primary me-2 fs-5"></i>Date, Time &amp; Space Selection</span>
                            </div>
                            <div class="card-body p-3">
                                <div class="row g-3">
                                    <div class="col-md-4">
                                        <label class="form-label small fw-bold text-dark mb-1">Event Date</label>
                                        <input type="date" class="form-control" @bind="_selectedRequest.EventDate" />
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label small fw-bold text-dark mb-1">Start Time</label>
                                        <input type="text" class="form-control" placeholder="e.g. 2:00 PM" @bind="_selectedRequest.StartTime" />
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label small fw-bold text-dark mb-1">End Time</label>
                                        <input type="text" class="form-control" placeholder="e.g. 10:00 PM" @bind="_selectedRequest.EndTime" />
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label small fw-bold text-dark mb-1">Room / Space</label>
                                        <select class="form-select" @bind="_selectedRequest.RoomSelected" @bind:after="RecalculateEditPriceQuote">
                                            @foreach (var room in (_editableRooms.Any() ? _editableRooms : (_webSettings?.GetRoomsList() ?? new List<RentalRoomOption>())))
                                            {
                                                <option value="@room.Name">@room.Name ($@( _selectedRequest.MemberStatus ? room.MemberRate : room.NonMemberRate))</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label small fw-bold text-dark mb-1">Renter Tier / Membership</label>
                                        <select class="form-select fw-semibold" value="@(_selectedRequest.MemberStatus ? "true" : "false")" @onchange="OnMemberStatusSelectionChanged">
                                            <option value="false">Non-Member Rate</option>
                                            <option value="true">Active Member Rate</option>
                                        </select>
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label small fw-bold text-dark mb-1">Booking Status</label>
                                        <select class="form-select fw-semibold @(_selectedRequest.Status == "Approved" ? "text-success" : (_selectedRequest.Status == "Cancelled" ? "text-danger" : "text-warning-emphasis"))" @bind="_selectedRequest.Status">
                                            <option value="Pending">Pending Review</option>
                                            <option value="Approved">Approved</option>
                                            <option value="Cancelled">Cancelled</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- 3. EDIT APPLICANT INFO CARD -->
                        <div class="card border rounded-3 mb-3 shadow-none bg-white">
                            <div class="card-header section-header-indigo py-2 px-3 fw-bold d-flex justify-content-between align-items-center">
                                <span><i class="bi bi-person-circle text-primary me-2 fs-5"></i>Applicant &amp; Event Details</span>
                            </div>
                            <div class="card-body p-3">
                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <label class="form-label small fw-bold text-dark mb-1">Applicant / Organization Name</label>
                                        <input type="text" class="form-control" @bind="_selectedRequest.ApplicantName" />
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label small fw-bold text-dark mb-1">Contact Phone</label>
                                        <input type="text" class="form-control" placeholder="(978) 555-0199" @bind="_selectedRequest.RequesterPhone" />
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label small fw-bold text-dark mb-1">Email Address</label>
                                        <input type="email" class="form-control" placeholder="user@example.com" @bind="_selectedRequest.RequesterEmail" />
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label small fw-bold text-dark mb-1">Event Type / Purpose</label>
                                        <select class="form-select" @bind="_selectedRequest.EventType">
                                            <option value="">-- Select Event Type --</option>
                                            @if (!string.IsNullOrWhiteSpace(_selectedRequest.EventType) && !_standardEventTypeOptions.Contains(_selectedRequest.EventType))
                                            {
                                                <option value="@_selectedRequest.EventType">@_selectedRequest.EventType (Current)</option>
                                            }
                                            @foreach (var evType in _standardEventTypeOptions)
                                            {
                                                <option value="@evType">@evType</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label small fw-bold text-dark mb-1">Guest Attendance</label>
                                        <input type="number" class="form-control" min="1" max="500" @bind="_selectedRequest.GuestCount" />
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label small fw-bold text-dark mb-1">Mailing Address</label>
                                        <input type="text" class="form-control" placeholder="Street, City, State Zip" @bind="_selectedRequest.RequesterAddress" />
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- 4. EDIT AMENITIES & ADD-ONS CARD -->
                        <div class="card border rounded-3 mb-3 shadow-none bg-white">
                            <div class="card-header section-header-amber py-2 px-3 fw-bold">
                                <i class="bi bi-check2-square text-warning-emphasis me-2 fs-5"></i>Requested Amenities &amp; Services
                            </div>
                            <div class="card-body p-3">
                                <div class="row g-3">
                                    <div class="col-md-4">
                                        <div class="p-3 border rounded-3 bg-light d-flex align-items-center justify-content-between">
                                            <div class="form-check mb-0">
                                                <input class="form-check-input" type="checkbox" id="editBar" @bind="_selectedRequest.BartenderRequested" @bind:after="RecalculateEditPriceQuote" />
                                                <label class="form-check-label fw-bold small" for="editBar">
                                                    Bar Service
                                                </label>
                                                <small class="text-muted d-block">Alcohol &amp; Bartender</small>
                                            </div>
                                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle">+$@(_webSettings?.BartenderServiceFee ?? 100)</span>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="p-3 border rounded-3 bg-light d-flex align-items-center justify-content-between">
                                            <div class="form-check mb-0">
                                                <input class="form-check-input" type="checkbox" id="editKit" @bind="_selectedRequest.KitchenUsage" @bind:after="RecalculateEditPriceQuote" />
                                                <label class="form-check-label fw-bold small" for="editKit">
                                                    Kitchen Access
                                                </label>
                                                <small class="text-muted d-block">Food prep &amp; warming</small>
                                            </div>
                                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle">+$@(_webSettings?.KitchenFee ?? 50)</span>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="p-3 border rounded-3 bg-light d-flex align-items-center justify-content-between">
                                            <div class="form-check mb-0">
                                                <input class="form-check-input" type="checkbox" id="editAv" @bind="_selectedRequest.AvEquipmentUsage" @bind:after="RecalculateEditPriceQuote" />
                                                <label class="form-check-label fw-bold small" for="editAv">
                                                    A/V Equipment
                                                </label>
                                                <small class="text-muted d-block">Mic, speakers &amp; projector</small>
                                            </div>
                                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle">+$@(_webSettings?.AvEquipmentFee ?? 25)</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <!-- ========================================================= -->
                        <!-- STANDARD READ-ONLY EVENT DETAILS VIEW -->
                        <!-- ========================================================= -->
                        <!-- Hero Event Banner (Sticky Top) -->
                        <div class="event-hero-banner p-3 rounded-3 mb-4 d-flex justify-content-between align-items-center flex-wrap gap-3 sticky-top-card">
                            <div>
                                <div class="text-uppercase fw-bold small text-primary-emphasis mb-1"><i class="bi bi-calendar3 me-1"></i> Scheduled Event Date</div>
                                <h4 class="fw-bold text-dark mb-0">
                                    @if (_selectedEvent.Start.Year > 2000)
                                    {
                                        @_selectedEvent.Start.ToString("dddd, MMMM dd, yyyy")
                                    }
                                    else if (_selectedRequest != null && _selectedRequest.EventDate.Year > 2000)
                                    {
                                        @_selectedRequest.EventDate.ToString("dddd, MMMM dd, yyyy")
                                    }
                                    else if (!string.IsNullOrEmpty(appDetails.PreferredEventDate))
                                    {
                                        @appDetails.PreferredEventDate
                                    }
                                    else
                                    {
                                        <span>Date Pending / Unspecified</span>
                                    }
                                </h4>
                            </div>
                            <div class="text-md-end">
                                <div class="text-uppercase fw-bold small text-primary-emphasis mb-1"><i class="bi bi-clock me-1"></i> Time Range</div>
                                <h5 class="fw-bold text-dark mb-0">
                                    @if (_selectedRequest != null && !string.IsNullOrEmpty(_selectedRequest.StartTime) && !string.IsNullOrEmpty(_selectedRequest.EndTime))
                                    {
                                        <span>@_selectedRequest.StartTime - @_selectedRequest.EndTime</span>
                                    }
                                    else if (!string.IsNullOrEmpty(appDetails.StartTime) && !string.IsNullOrEmpty(appDetails.EndTime))
                                    {
                                        <span>@appDetails.StartTime - @appDetails.EndTime</span>
                                    }
                                    else if (!_selectedEvent.IsAllDay)
                                    {
                                        <span>@_selectedEvent.Start.ToString("h:mm tt") - @_selectedEvent.End.ToString("h:mm tt")</span>
                                    }
                                    else
                                    {
                                        <span>All Day Event</span>
                                    }
                                </h5>
                            </div>
                        </div>

                        <!-- 1. APPLICANT CONTACT CARD -->
                        <div class="card border rounded-3 mb-3 shadow-none bg-white">
                            <div class="card-header section-header-primary py-2 px-3 fw-bold d-flex justify-content-between align-items-center">
                                <span><i class="bi bi-person-circle text-primary me-2 fs-5"></i>Applicant / Organizer</span>
                                <div class="d-flex align-items-center gap-2">
                                    @if (isMemberVal.HasValue)
                                    {
                                        <span class="badge @(isMemberVal.Value ? "bg-success" : "bg-secondary")">
                                            @(isMemberVal.Value ? "Club Member" : "Non-Member")
                                        </span>
                                    }
                                    <button type="button" class="btn btn-link btn-sm text-primary p-0 text-decoration-none" @onclick="EnterBookingEditMode" title="Edit applicant info">
                                        <i class="bi bi-pencil-square me-1"></i>Edit
                                    </button>
                                </div>
                            </div>
                            <div class="card-body p-3">
                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <div class="text-muted small">Full Name</div>
                                        <div class="fw-bold fs-6">@effectiveName</div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="text-muted small">Contact Phone</div>
                                        <div class="fw-semibold">
                                            @if (!string.IsNullOrEmpty(effectivePhone))
                                            {
                                                <a href="tel:@effectivePhone" class="text-decoration-none text-primary">
                                                    <i class="bi bi-telephone me-1"></i>@effectivePhone
                                                </a>
                                            }
                                            else
                                            {
                                                <span class="text-muted">None provided</span>
                                            }
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="text-muted small">Email Address</div>
                                        <div class="fw-semibold">
                                            @if (!string.IsNullOrEmpty(effectiveEmail))
                                            {
                                                <a href="mailto:@effectiveEmail" class="text-decoration-none text-primary">
                                                    <i class="bi bi-envelope me-1"></i>@effectiveEmail
                                                </a>
                                            }
                                            else
                                            {
                                                <span class="text-muted">None provided</span>
                                            }
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="text-muted small">Mailing Address</div>
                                        <div class="fw-semibold">
                                            @if (!string.IsNullOrEmpty(effectiveAddress))
                                            {
                                                <span>@effectiveAddress</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">None provided</span>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- 2. EVENT SPECIFICATIONS & SERVICES -->
                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <div class="card border rounded-3 h-100 shadow-none bg-white">
                                    <div class="card-header section-header-primary py-2 px-3 fw-bold d-flex justify-content-between align-items-center">
                                        <span><i class="bi bi-card-checklist text-primary me-2 fs-5"></i>Event Specifications</span>
                                        <button type="button" class="btn btn-link btn-sm text-primary p-0 text-decoration-none" @onclick="EnterBookingEditMode" title="Edit specifications">
                                            <i class="bi bi-pencil-square me-1"></i>Edit
                                        </button>
                                    </div>
                                    <div class="card-body p-3">
                                        <div class="d-flex justify-content-between py-1 border-bottom">
                                            <span class="text-muted small">Event Type</span>
                                            <span class="fw-bold">@(_selectedRequest?.EventType ?? appDetails.EventType ?? "General Function")</span>
                                        </div>
                                        <div class="d-flex justify-content-between py-1 border-bottom">
                                            <span class="text-muted small">Selected Room</span>
                                            <span class="fw-bold text-primary">@(_selectedRequest?.RoomSelected ?? _selectedEvent.Location ?? "Function Hall")</span>
                                        </div>
                                        <div class="d-flex justify-content-between py-1 border-bottom">
                                            <span class="text-muted small">Estimated Guests</span>
                                            <span class="fw-bold">@(_selectedRequest?.GuestCount > 0 ? _selectedRequest.GuestCount.ToString() : (appDetails.GuestCount ?? "Unspecified"))</span>
                                        </div>
                                        <div class="d-flex justify-content-between py-1 border-bottom">
                                            <span class="text-muted small">Setup Time Required?</span>
                                            <span class="fw-bold @(appDetails.SetupTimeRequired?.ToLower().StartsWith("y") == true ? "text-success" : "text-muted")">
                                                @(appDetails.SetupTimeRequired ?? "No")
                                            </span>
                                        </div>
                                        @if (!string.IsNullOrEmpty(appDetails.AlternateDate))
                                        {
                                            <div class="d-flex justify-content-between py-1">
                                                <span class="text-muted small">Alternate Date Choice</span>
                                                <span class="fw-bold text-info">@appDetails.AlternateDate</span>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="card border rounded-3 h-100 shadow-none bg-white">
                                    <div class="card-header section-header-amber py-2 px-3 fw-bold d-flex justify-content-between align-items-center">
                                        <span><i class="bi bi-cup-straw text-warning-emphasis me-2 fs-5"></i>Facilities &amp; Add-Ons</span>
                                        <button type="button" class="btn btn-link btn-sm text-primary p-0 text-decoration-none" @onclick="EnterBookingEditMode" title="Edit add-ons">
                                            <i class="bi bi-pencil-square me-1"></i>Edit
                                        </button>
                                    </div>
                                    <div class="card-body p-3">
                                        <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                                            <div>
                                                <div class="fw-semibold"><i class="bi bi-cup-hot text-danger me-1"></i>Bar Service</div>
                                                <div class="text-muted small" style="font-size: 0.75rem;">Alcohol &amp; bartender staffing</div>
                                            </div>
                                            <span class="badge @((_selectedRequest?.BartenderRequested == true || appDetails.BarService?.ToLower().StartsWith("y") == true) ? "bg-success" : "bg-light text-muted border") px-3 py-1">
                                                @((_selectedRequest?.BartenderRequested == true || appDetails.BarService?.ToLower().StartsWith("y") == true) ? "Requested" : "No")
                                            </span>
                                        </div>
                                        <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                                            <div>
                                                <div class="fw-semibold"><i class="bi bi-fire text-warning me-1"></i>Kitchen Access</div>
                                                <div class="text-muted small" style="font-size: 0.75rem;">Food prep / kitchen usage</div>
                                            </div>
                                            <span class="badge @((_selectedRequest?.KitchenUsage == true || appDetails.KitchenAccess?.ToLower().StartsWith("y") == true) ? "bg-success" : "bg-light text-muted border") px-3 py-1">
                                                @((_selectedRequest?.KitchenUsage == true || appDetails.KitchenAccess?.ToLower().StartsWith("y") == true) ? "Requested" : "No")
                                            </span>
                                        </div>
                                        <div class="d-flex justify-content-between align-items-center py-2">
                                            <div>
                                                <div class="fw-semibold"><i class="bi bi-speaker text-info me-1"></i>A/V Equipment</div>
                                                <div class="text-muted small" style="font-size: 0.75rem;">Microphone, speakers, projector</div>
                                            </div>
                                            <span class="badge @(_selectedRequest?.AvEquipmentUsage == true ? "bg-success" : "bg-light text-muted border") px-3 py-1">
                                                @(_selectedRequest?.AvEquipmentUsage == true ? "Requested" : "No")
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- 3. FINANCIAL SUMMARY & REAL-TIME PAYMENT STATUS -->
                        <div class="card border rounded-3 shadow-none bg-white mb-3">
                            <div class="card-header section-header-success py-2 px-3 fw-bold d-flex justify-content-between align-items-center">
                                <span><i class="bi bi-currency-dollar text-success me-2 fs-5"></i>Financial &amp; Payment Breakdown</span>
                                <div class="d-flex align-items-center gap-2">
                                    <span class="badge @(modalPaySummary.Status == "Paid" ? "bg-success text-white" : (modalPaySummary.Status == "Deposit Paid" ? "bg-primary text-white" : (modalPaySummary.Status == "Partial" ? "bg-warning text-dark" : "bg-light text-dark border border-secondary shadow-sm"))) px-3 py-1 fs-6 fw-bold" style="@(modalPaySummary.Status == "Unpaid" ? "color: #1e293b !important; background-color: #f1f5f9 !important; border-color: #94a3b8 !important;" : "")">
                                        Payment Status: @modalPaySummary.Status.ToUpper()
                                    </span>
                                    <button type="button" class="btn btn-outline-success btn-sm rounded-pill px-2 py-0.5 shadow-sm" @onclick="EnterBookingEditMode" title="Modify pricing or deposit">
                                        <i class="bi bi-pencil-square me-1"></i>Edit Price
                                    </button>
                                </div>
                            </div>
                            <div class="card-body p-3">
                                <div class="row g-3 text-center">
                                    <div class="col-md-3 col-6">
                                        <div class="p-2 bg-light rounded border">
                                            <small class="text-muted d-block">Agreed Total Price</small>
                                            <strong class="fs-5 text-dark">$@modalPaySummary.TotalPrice.ToString("N2")</strong>
                                        </div>
                                    </div>
                                    <div class="col-md-3 col-6">
                                        <div class="p-2 bg-light rounded border">
                                            <small class="text-muted d-block">Security Deposit</small>
                                            <strong class="fs-5 text-warning-emphasis">$@modalPaySummary.DepositRequired.ToString("N2")</strong>
                                        </div>
                                    </div>
                                    <div class="col-md-3 col-6">
                                        <div class="p-2 bg-success bg-opacity-10 rounded border border-success-subtle">
                                            <small class="text-success fw-semibold d-block">Total Paid to Date</small>
                                            <strong class="fs-5 text-success">$@modalPaySummary.TotalPaid.ToString("N2")</strong>
                                        </div>
                                    </div>
                                    <div class="col-md-3 col-6">
                                        <div class="p-2 @(modalPaySummary.RemainingBalance > 0 ? "bg-danger bg-opacity-10 border border-danger-subtle" : "bg-light border") rounded">
                                            <small class="@(modalPaySummary.RemainingBalance > 0 ? "text-danger fw-semibold" : "text-muted") d-block">Remaining Balance</small>
                                            <strong class="fs-5 @(modalPaySummary.RemainingBalance > 0 ? "text-danger" : "text-success")">$@modalPaySummary.RemainingBalance.ToString("N2")</strong>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- 4. AGREEMENTS & SUBMISSION TIMESTAMP -->
                        <div class="card border rounded-3 shadow-none bg-white mb-3">
                            <div class="card-header section-header-success py-2 px-3 fw-bold d-flex justify-content-between align-items-center">
                                <span><i class="bi bi-shield-check text-success me-2 fs-5"></i>Accepted Terms, Policies &amp; Digital Signature</span>
                                @if (!string.IsNullOrEmpty(effectiveTimestamp))
                                {
                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1">
                                        <i class="bi bi-clock-history me-1"></i>Submitted: @effectiveTimestamp
                                    </span>
                                }
                            </div>
                            <div class="card-body p-3">
                                <div class="text-muted small fw-bold text-uppercase mb-2" style="font-size: 0.75rem; letter-spacing: 0.5px;">
                                    Acknowledged Policies &amp; Agreements (@acceptedPoliciesList.Count)
                                </div>
                                
                                <div class="d-flex flex-column gap-2 mb-3">
                                    @foreach (var pol in acceptedPoliciesList)
                                    {
                                        <div class="p-2 px-3 rounded-3 border bg-light d-flex align-items-center justify-content-between gap-3">
                                            <div class="d-flex align-items-center gap-2 flex-wrap min-w-0">
                                                <i class="bi bi-check-circle-fill text-success fs-6 flex-shrink-0"></i>
                                                <span class="fw-semibold text-dark small text-break">@pol.Title</span>
                                                @if (!string.IsNullOrEmpty(pol.Tag))
                                                {
                                                    <span class="badge bg-white text-dark border border-secondary-subtle px-2 py-0.5 shadow-sm fw-semibold flex-shrink-0" style="font-size: 0.72rem;">@pol.Tag</span>
                                                }
                                            </div>
                                            <span class="badge py-1 px-3 small fw-bold shadow-sm d-inline-flex align-items-center gap-1 flex-shrink-0 ms-auto" style="background-color: #15803d !important; color: #ffffff !important; border: 1px solid #166534 !important; font-size: 0.8rem; letter-spacing: 0.3px;">
                                                <i class="bi bi-shield-fill-check"></i>Accepted
                                            </span>
                                        </div>
                                    }
                                </div>

                                <div class="row g-3 pt-2 border-top">
                                    <div class="col-md-6">
                                        <div class="text-muted small">Applicant Digital Signature</div>
                                        <div class="fw-bold font-monospace bg-light p-2 rounded border text-dark">
                                            <i class="bi bi-pen me-1 text-primary"></i>@effectiveSignature
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="text-muted small">Submission Timestamp</div>
                                        <div class="fw-semibold p-2 bg-light rounded border text-dark">
                                            <i class="bi bi-calendar-check text-primary me-1"></i>
                                            @(string.IsNullOrEmpty(effectiveTimestamp) ? "Recorded" : effectiveTimestamp)
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- 5. AUDIT TRAIL & CHANGE HISTORY CARD -->
                        @if (!string.IsNullOrWhiteSpace(_selectedRequest?.InternalNotes))
                        {
                            <div class="card border rounded-3 shadow-none bg-white mb-3">
                                <div class="card-header section-header-secondary py-2 px-3 fw-bold d-flex justify-content-between align-items-center">
                                    <span><i class="bi bi-journal-text text-secondary me-2 fs-5"></i>Audit Trail &amp; Modification History</span>
                                    <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">Audit Log</span>
                                </div>
                                <div class="card-body p-3">
                                    <div class="bg-light p-3 rounded-3 border font-monospace small" style="white-space: pre-wrap; font-size: 0.8rem; line-height: 1.5;">@_selectedRequest.InternalNotes</div>
                                </div>
                            </div>
                        }

                        <!-- 6. MANUAL PAYMENT & DEPOSIT TRACKING LEDGER -->
                        <div class="card border rounded-3 shadow-none bg-white mb-3">
                            <div class="card-header section-header-success py-2 px-3 fw-bold d-flex justify-content-between align-items-center">
                                <span><i class="bi bi-cash-stack text-success me-2 fs-5"></i>Payment &amp; Deposit Ledger</span>
                                <button type="button" class="btn btn-sm btn-outline-success rounded-pill px-3 shadow-sm" @onclick="() => OpenRecordPaymentModal(_selectedEvent)">
                                    <i class="bi bi-plus-circle me-1"></i>Record Payment / Deposit
                                </button>
                            </div>
                            <div class="card-body p-2 @(_selectedPayments.Any() ? "p-3" : "")">
                                @if (_selectedPayments.Any())
                                {
                                    <div class="table-responsive">
                                        <table class="table table-sm table-hover align-middle mb-0">
                                            <thead class="table-light small">
                                                <tr>
                                                    <th>Date</th>
                                                    <th>Type</th>
                                                    <th>Method</th>
                                                    <th>Ref / Check #</th>
                                                    <th>Amount</th>
                                                    <th>Recorded By</th>
                                                    <th class="text-end">Action</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var p in _selectedPayments)
                                                {
                                                    <tr>
                                                        <td class="small">@p.PaymentDate.ToString("MM/dd/yyyy")</td>
                                                        <td>
                                                            <span class="badge @(p.PaymentType == "Security Deposit" ? "bg-warning text-dark" : (p.PaymentType == "Refund" ? "bg-danger" : "bg-success"))">
                                                                @p.PaymentType
                                                            </span>
                                                        </td>
                                                        <td class="small">@p.PaymentMethod</td>
                                                        <td class="small font-monospace">@(string.IsNullOrEmpty(p.ReferenceOrCheckNumber) ? "—" : p.ReferenceOrCheckNumber)</td>
                                                        <td class="fw-bold @(p.PaymentType == "Refund" ? "text-danger" : "text-success")">
                                                            @(p.PaymentType == "Refund" ? "-" : "")$@p.Amount.ToString("N2")
                                                        </td>
                                                        <td class="small text-muted">@p.RecordedBy</td>
                                                        <td class="text-end">
                                                            <button class="btn btn-link btn-sm text-danger p-0" title="Delete payment" @onclick="() => DeletePayment(p.Id)">
                                                                <i class="bi bi-trash"></i>
                                                            </button>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                }
                                else
                                {
                                    <div class="d-flex align-items-center justify-content-between p-2 px-3 bg-light rounded-2 text-muted small">
                                        <span><i class="bi bi-info-circle me-1 text-secondary"></i>No payment transactions recorded yet.</span>
                                        <span class="text-secondary opacity-75" style="font-size: 0.75rem;">Balance pending</span>
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- Collapsible Raw Notes Section -->
                        <div class="mt-3">
                            <button class="btn btn-link btn-sm text-decoration-none p-0 text-muted" type="button" @onclick="() => _showRawNotes = !_showRawNotes">
                                <i class="bi @(_showRawNotes ? "bi-chevron-up" : "bi-chevron-down") me-1"></i>
                                @(_showRawNotes ? "Hide Raw Notes" : "View Raw Description & Details")
                            </button>

                            @if (_showRawNotes && !string.IsNullOrEmpty(_selectedEvent.Description))
                            {
                                <div class="p-3 bg-light rounded-3 border mt-2">
                                    <pre class="small mb-0 text-dark" style="white-space: pre-wrap; font-family: inherit;">@_selectedEvent.Description</pre>
                                </div>
                            }
                        </div>
                    }
                </div>

                <!-- Modal Footer -->
                <div class="modal-footer bg-light border-top p-3 px-4 d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <div class="d-flex align-items-center gap-2">
                        <button type="button" class="btn btn-outline-danger btn-sm rounded-pill px-3 shadow-sm" @onclick="PromptCancelOrRemoveEvent" title="Cancel booking or remove this event">
                            <i class="bi bi-trash3 me-1"></i>Cancel / Delete Event
                        </button>
                    </div>
                    <div class="d-flex align-items-center gap-2 flex-wrap ms-auto">
                        @if (_isEditingBooking)
                        {
                            <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill px-3 shadow-sm" @onclick="CancelBookingEditMode">
                                <i class="bi bi-x-lg me-1"></i>Cancel
                            </button>
                            <button type="button" class="btn btn-primary btn-sm rounded-pill px-4 shadow-sm fw-bold" @onclick="InitiateSaveBookingChanges" disabled="@_isSavingAdjustments">
                                @if (_isSavingAdjustments)
                                {
                                    <span class="spinner-border spinner-border-sm me-1"></span>
                                    <span>Saving...</span>
                                }
                                else
                                {
                                    <i class="bi bi-check2-circle me-1"></i>
                                    <span>Review &amp; Save</span>
                                }
                            </button>
                        }
                        else
                        {
                            <button type="button" class="btn btn-outline-dark btn-sm rounded-pill px-3 shadow-sm" @onclick="PrintSelectedApplication" title="Print application or save as PDF">
                                <i class="bi bi-printer me-1"></i>Print / PDF
                            </button>
                            <button type="button" class="btn btn-outline-success btn-sm rounded-pill px-3 shadow-sm" @onclick="() => OpenRecordPaymentModal(_selectedEvent)">
                                <i class="bi bi-cash-stack me-1"></i>Add Payment
                            </button>
                            @if (!string.IsNullOrWhiteSpace(_selectedRequest?.RequesterEmail) || !string.IsNullOrWhiteSpace(appDetails.Email))
                            {
                                <button type="button" class="btn btn-outline-primary btn-sm rounded-pill px-3 shadow-sm" @onclick="OpenResendQuoteConfirmation" disabled="@_isResendingQuote" title="Email updated rental quote & breakdown to applicant">
                                    <i class="bi bi-envelope-paper me-1"></i>
                                    <span>Resend Quote</span>
                                </button>
                            }
                            <button type="button" class="btn btn-primary btn-sm rounded-pill px-3 shadow-sm fw-semibold" @onclick="EnterBookingEditMode">
                                <i class="bi bi-pencil-square me-1"></i>Modify Booking
                            </button>
                            @if (isPending)
                            {
                                <button type="button" class="btn btn-success btn-sm rounded-pill px-3 shadow-sm fw-bold" @onclick="PromptApproveBooking" disabled="@_isApprovingBooking" title="Approve this rental booking and remove PENDING prefix">
                                    <i class="bi bi-check2-circle me-1"></i>
                                    <span>Approve Booking</span>
                                </button>
                            }
                            <div class="vr mx-1 d-none d-sm-block" style="height: 24px;"></div>
                            <button type="button" class="btn btn-secondary btn-sm rounded-pill px-4 shadow-sm" @onclick="CloseEventDetailsModal">Close</button>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<!-- ========================================================================= -->
<!-- CONFIRM RESEND QUOTE EMAIL MODAL -->
<!-- ========================================================================= -->
@if (_showResendQuoteConfirmModal && _selectedEvent != null)
{
    var confirmAppData = ParseApplicationDetails(_selectedEvent);
    var confirmEmail = !string.IsNullOrWhiteSpace(_selectedRequest?.RequesterEmail) ? _selectedRequest.RequesterEmail : confirmAppData.Email;
    var confirmPaySummary = GetEventPaymentSummary(_selectedEvent);
    var confirmName = !string.IsNullOrWhiteSpace(_selectedRequest?.ApplicantName) ? _selectedRequest.ApplicantName : (confirmAppData.ApplicantName ?? GetCleanTitle(_selectedEvent));
    var confirmRoom = !string.IsNullOrWhiteSpace(_selectedRequest?.RoomSelected) ? _selectedRequest.RoomSelected : (_selectedEvent.Location ?? "Function Hall");
    var confirmPrice = _selectedRequest != null ? _selectedRequest.TotalPrice : confirmPaySummary.TotalPrice;
    var confirmDeposit = _selectedRequest != null && _selectedRequest.SecurityDepositAmount > 0 ? _selectedRequest.SecurityDepositAmount : confirmPaySummary.DepositRequired;

    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.75); z-index: 1060;" role="dialog">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="modal-header bg-primary text-white p-3 px-4">
                    <h5 class="modal-title fw-bold mb-0 d-flex align-items-center gap-2">
                        <i class="bi bi-envelope-paper"></i>
                        <span>Confirm Resend Quote</span>
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => _showResendQuoteConfirmModal = false"></button>
                </div>
                <div class="modal-body p-4">
                    <p class="text-muted small mb-3">
                        Are you sure you want to send the latest rental quote and pricing breakdown to the applicant?
                    </p>

                    <div class="card border rounded-3 p-3 bg-light mb-3">
                        <div class="row g-2 small">
                            <div class="col-12 d-flex justify-content-between border-bottom pb-2">
                                <span class="text-muted">Recipient Email:</span>
                                <span class="fw-bold text-dark">@confirmEmail</span>
                            </div>
                            <div class="col-12 d-flex justify-content-between border-bottom pb-2">
                                <span class="text-muted">Applicant Name:</span>
                                <span class="fw-bold text-dark">@confirmName</span>
                            </div>
                            <div class="col-12 d-flex justify-content-between border-bottom pb-2">
                                <span class="text-muted">Event Date &amp; Space:</span>
                                <span class="fw-bold text-dark">@_selectedEvent.Start.ToString("MMM dd, yyyy") (@confirmRoom)</span>
                            </div>
                            <div class="col-12 d-flex justify-content-between border-bottom pb-2">
                                <span class="text-muted">Rental Price:</span>
                                <span class="fw-bold text-primary">$@confirmPrice.ToString("N2")</span>
                            </div>
                            <div class="col-12 d-flex justify-content-between">
                                <span class="text-muted">Security Deposit:</span>
                                <span class="fw-bold text-warning-emphasis">$@confirmDeposit.ToString("N2")</span>
                            </div>
                        </div>
                    </div>

                    <div class="alert alert-info py-2 px-3 small d-flex align-items-center gap-2 mb-0">
                        <i class="bi bi-info-circle-fill text-info flex-shrink-0"></i>
                        <span>This will send a formatted quote email directly to <strong>@confirmEmail</strong>.</span>
                    </div>
                </div>
                <div class="modal-footer bg-light border-top p-3 px-4 d-flex justify-content-between">
                    <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill px-3" @onclick="() => _showResendQuoteConfirmModal = false" disabled="@_isResendingQuote">
                        Cancel
                    </button>
                    <button type="button" class="btn btn-primary btn-sm rounded-pill px-4 shadow-sm fw-bold" @onclick="ConfirmAndSendQuoteAsync" disabled="@_isResendingQuote">
                        @if (_isResendingQuote)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                            <span>Sending Quote...</span>
                        }
                        else
                        {
                            <i class="bi bi-send-fill me-1"></i>
                            <span>Send Quote Email</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- ========================================================================= -->
<!-- CONFIRM BOOKING APPROVAL MODAL -->
<!-- ========================================================================= -->
@if (_showApproveBookingConfirmModal && _selectedEvent != null)
{
    var appData = ParseApplicationDetails(_selectedEvent);
    var cleanName = !string.IsNullOrWhiteSpace(_selectedRequest?.ApplicantName) ? _selectedRequest.ApplicantName : (appData.ApplicantName ?? GetCleanTitle(_selectedEvent));
    var spaceName = !string.IsNullOrWhiteSpace(_selectedRequest?.RoomSelected) ? _selectedRequest.RoomSelected : (_selectedEvent.Location ?? "Function Hall");
    var paySummary = GetEventPaymentSummary(_selectedEvent);
    var totalPrice = _selectedRequest != null ? _selectedRequest.TotalPrice : paySummary.TotalPrice;

    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.75); z-index: 1060;" role="dialog">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="modal-header bg-success text-white p-3 px-4">
                    <h5 class="modal-title fw-bold mb-0 d-flex align-items-center gap-2">
                        <i class="bi bi-check2-circle"></i>
                        <span>Confirm Booking Approval</span>
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => _showApproveBookingConfirmModal = false"></button>
                </div>
                <div class="modal-body p-4">
                    <p class="text-muted small mb-3">
                        Are you sure you want to approve this rental booking?
                    </p>

                    <div class="card border rounded-3 p-3 bg-light mb-3">
                        <div class="row g-2 small">
                            <div class="col-12 d-flex justify-content-between border-bottom pb-2">
                                <span class="text-muted">Applicant Name:</span>
                                <span class="fw-bold text-dark">@cleanName</span>
                            </div>
                            <div class="col-12 d-flex justify-content-between border-bottom pb-2">
                                <span class="text-muted">Event Date &amp; Space:</span>
                                <span class="fw-bold text-dark">@_selectedEvent.Start.ToString("dddd, MMM dd, yyyy") (@spaceName)</span>
                            </div>
                            <div class="col-12 d-flex justify-content-between border-bottom pb-2">
                                <span class="text-muted">Time Window:</span>
                                <span class="fw-bold text-dark">@(_selectedEvent.IsAllDay ? "All Day" : $"{_selectedEvent.Start:h:mm tt} - {_selectedEvent.End:h:mm tt}")</span>
                            </div>
                            <div class="col-12 d-flex justify-content-between">
                                <span class="text-muted">Agreed Price:</span>
                                <span class="fw-bold text-success">$@totalPrice.ToString("N2")</span>
                            </div>
                        </div>
                    </div>

                    <div class="alert alert-success bg-success bg-opacity-10 border border-success-subtle py-2 px-3 small d-flex align-items-center gap-2 mb-0">
                        <i class="bi bi-info-circle-fill text-success flex-shrink-0"></i>
                        <span>This will mark the application <strong>APPROVED</strong> in the database and remove the "PENDING" prefix from Google Calendar.</span>
                    </div>
                </div>
                <div class="modal-footer bg-light border-top p-3 px-4 d-flex justify-content-between">
                    <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill px-3" @onclick="() => _showApproveBookingConfirmModal = false" disabled="@_isApprovingBooking">
                        Cancel
                    </button>
                    <button type="button" class="btn btn-success btn-sm rounded-pill px-4 shadow-sm fw-bold" @onclick="ConfirmAndApproveBookingAsync" disabled="@_isApprovingBooking">
                        @if (_isApprovingBooking)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                            <span>Approving...</span>
                        }
                        else
                        {
                            <i class="bi bi-check-lg me-1"></i>
                            <span>Confirm &amp; Approve</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- ========================================================================= -->
<!-- PRE-SAVE CHANGE CONFIRMATION & AUDIT DIFF MODAL -->
<!-- ========================================================================= -->
@if (_showConfirmChangesModal && _selectedRequest != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.75); z-index: 1060;" role="dialog">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="modal-header bg-primary text-white p-3 px-4">
                    <h5 class="modal-title fw-bold mb-0 d-flex align-items-center gap-2">
                        <i class="bi bi-shield-check"></i>
                        <span>Confirm Booking Modifications</span>
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => _showConfirmChangesModal = false"></button>
                </div>
                <div class="modal-body p-4">
                    <p class="text-muted small mb-3">
                        Please review the detected changes below before updating the database, Google Calendar schedule, and availability ledger:
                    </p>

                    <div class="card border rounded-3 mb-3 bg-light shadow-none">
                        <div class="card-header bg-white py-2 px-3 fw-bold small text-uppercase text-secondary">
                            Detected Field Differences (@_detectedDiffs.Count)
                        </div>
                        <div class="card-body p-0">
                            <div class="table-responsive mb-0">
                                <table class="table table-sm table-striped align-middle mb-0">
                                    <thead class="table-light small">
                                        <tr>
                                            <th>Field</th>
                                            <th>Previous Value</th>
                                            <th>New Value</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var diff in _detectedDiffs)
                                        {
                                            <tr>
                                                <td class="fw-bold small text-dark">@diff.FieldName</td>
                                                <td><span class="badge bg-secondary-subtle text-secondary border">@diff.OldValue</span></td>
                                                <td><span class="badge bg-primary-subtle text-primary border border-primary-subtle fw-bold">@diff.NewValue</span></td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold text-dark mb-1">
                            Reason for modification / Admin note <span class="text-muted font-normal">(Recorded to Audit Trail)</span>:
                        </label>
                        <input type="text" class="form-control" placeholder="e.g. Applied member discount, changed time upon renter request" @bind="_changeReasonNote" />
                    </div>

                    @if (!string.IsNullOrWhiteSpace(_selectedRequest.RequesterEmail))
                    {
                        <div class="p-3 bg-white rounded-3 border mb-3">
                            <div class="form-check form-switch mb-0">
                                <input class="form-check-input" type="checkbox" id="sendQuoteToggle" @bind="_sendUpdatedQuoteEmail" />
                                <label class="form-check-label fw-bold text-dark small" for="sendQuoteToggle">
                                    <i class="bi bi-envelope-paper me-1 text-primary"></i>Email Updated Quote to Applicant
                                </label>
                                <small class="text-muted d-block">Sends updated breakdown and pricing to <strong>@_selectedRequest.RequesterEmail</strong></small>
                            </div>
                        </div>
                    }

                    <div class="alert alert-info py-2 px-3 small d-flex align-items-center gap-2 mb-0">
                        <i class="bi bi-info-circle-fill text-info"></i>
                        <span>This action will update the database record and synchronize connected calendars immediately.</span>
                    </div>
                </div>
                <div class="modal-footer bg-light border-top p-3 px-4 d-flex justify-content-between">
                    <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill px-3" @onclick="() => _showConfirmChangesModal = false">
                        <i class="bi bi-arrow-left me-1"></i>Back to Editor
                    </button>
                    <button type="button" class="btn btn-primary btn-sm rounded-pill px-4 shadow-sm fw-bold" @onclick="CommitBookingModificationsAsync" disabled="@_isSavingAdjustments">
                        @if (_isSavingAdjustments)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                            <span>Applying Changes...</span>
                        }
                        else
                        {
                            <i class="bi bi-check2-circle me-1"></i>
                            <span>Confirm &amp; Apply Changes</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- UNSAVED CHANGES WARNING CONFIRMATION MODAL -->
@if (_showUnsavedChangesWarning)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.75); z-index: 1070;" role="dialog">
        <div class="modal-dialog modal-dialog-centered modal-sm" role="document">
            <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="modal-header bg-warning bg-opacity-25 text-warning-emphasis p-3">
