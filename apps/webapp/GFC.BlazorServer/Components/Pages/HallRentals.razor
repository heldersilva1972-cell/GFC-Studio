    private void OpenReplyToInquiryModal()
    {
        if (_selectedEvent == null) return;
        var appData = ParseApplicationDetails(_selectedEvent);
        _inquiryReplyRecipient = !string.IsNullOrWhiteSpace(_selectedRequest?.RequesterEmail) ? _selectedRequest.RequesterEmail : (appData.Email ?? "");
        
        int inqId = _selectedRequest?.Id ?? 0;
        string applicantName = !string.IsNullOrWhiteSpace(_selectedRequest?.ApplicantName) ? _selectedRequest.ApplicantName : (appData.ApplicantName ?? GetCleanTitle(_selectedEvent));
        string eventDateStr = _selectedRequest != null && _selectedRequest.EventDate.Year > 2000 
            ? _selectedRequest.EventDate.ToString("MM/dd/yyyy") 
            : (_selectedEvent.Start.Year > 2000 ? _selectedEvent.Start.ToString("MM/dd/yyyy") : (appData.PreferredEventDate ?? "Requested Date"));

        string trackingCode = inqId > 0 ? $"[GFC-INQ-{inqId}] " : "";
        _inquiryReplySubject = $"Re: {trackingCode}Hall Rental Inquiry - Gloucester Fraternity Club";
        
        _inquiryReplyBody = $"Dear {applicantName},\n\nThank you for reaching out to the Gloucester Fraternity Club regarding your hall rental inquiry for {eventDateStr}.\n\n";
        _inquiryReplyError = "";
        _showReplyInquiryModal = true;
    }

    private void OnInquiryReplyPresetSelected(ChangeEventArgs e)
    {
        var preset = e.Value?.ToString();
        if (string.IsNullOrWhiteSpace(preset)) return;

        var appData = _selectedEvent != null ? ParseApplicationDetails(_selectedEvent) : new ParsedApplicationData();
        string applicantName = !string.IsNullOrWhiteSpace(_selectedRequest?.ApplicantName) ? _selectedRequest.ApplicantName : (appData.ApplicantName ?? (_selectedEvent != null ? GetCleanTitle(_selectedEvent) : "Applicant"));
        string eventDateStr = _selectedRequest != null && _selectedRequest.EventDate.Year > 2000 
            ? _selectedRequest.EventDate.ToString("MMMM dd, yyyy") 
            : (_selectedEvent != null && _selectedEvent.Start.Year > 2000 ? _selectedEvent.Start.ToString("MMMM dd, yyyy") : (appData.PreferredEventDate ?? "your requested date"));

        switch (preset)
        {
            case "available":
                _inquiryReplyBody = $"Dear {applicantName},\n\nThank you for contacting the Gloucester Fraternity Club. We are happy to let you know that our facility is currently AVAILABLE on {eventDateStr}!\n\nOur hall rental includes tables, chairs, and access to our amenities. If you would like to proceed with securing your date, please complete our online rental booking form or let us know a good time to schedule a walkthrough.\n\nWarm regards,\nGloucester Fraternity Club Hall Rental Committee";
                break;
            case "unavailable":
                _inquiryReplyBody = $"Dear {applicantName},\n\nThank you for your interest in the Gloucester Fraternity Club. Unfortunately, our facility is already booked or unavailable on {eventDateStr}.\n\nIf you have alternate dates in mind, please let us know and we will be glad to check our schedule for you.\n\nWarm regards,\nGloucester Fraternity Club Hall Rental Committee";
                break;
            case "pricing_info":
                _inquiryReplyBody = $"Dear {applicantName},\n\nThank you for inquiring about our hall rental options. Our Function Hall is available for member and non-member events.\n\nStandard rental pricing starts at $400 for non-members ($300 for club members) for a 5-hour window, with optional bar service and kitchen access available.\n\nPlease let us know if you have any questions or would like to schedule a time to view the hall.\n\nWarm regards,\nGloucester Fraternity Club Hall Rental Committee";
                break;
            case "call_to_discuss":
                _inquiryReplyBody = $"Dear {applicantName},\n\nThank you for your inquiry. We would love to discuss the specific details of your event for {eventDateStr}. Please feel free to give us a call at (978) 283-2889 at your earliest convenience so we can assist you.\n\nWarm regards,\nGloucester Fraternity Club Hall Rental Committee";
                break;
        }
    }

    private async Task SendInquiryReplyAsync()
    {
        if (string.IsNullOrWhiteSpace(_inquiryReplyRecipient))
        {
            _inquiryReplyError = "Please enter a valid recipient email address.";
            return;
        }

        if (string.IsNullOrWhiteSpace(_inquiryReplyBody))
        {
            _inquiryReplyError = "Please enter your message reply.";
            return;
        }

        _isSendingInquiryReply = true;
        _inquiryReplyError = "";

        try
        {
            var settings = await WebsiteSettingsService.GetWebsiteSettingsAsync() ?? new WebsiteSettings();
            string clubNameStr = string.IsNullOrWhiteSpace(settings.RentalFormSubtitle) ? "Gloucester Fraternity Club" : settings.RentalFormSubtitle;
            string clubPhoneStr = string.IsNullOrWhiteSpace(settings.ClubPhone) ? "(978) 283-2889" : settings.ClubPhone;

            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            string adminUser = authState.User.Identity?.Name ?? "Admin";

            // Format message HTML
            string formattedHtml = $"<div style='font-family: Arial, sans-serif; font-size: 15px; color: #1e293b; line-height: 1.6; max-width: 600px; margin: 0 auto; padding: 20px; border: 1px solid #e2e8f0; border-radius: 8px; background: #ffffff;'>" +
                $"<div style='border-bottom: 2px solid #0284c7; padding-bottom: 12px; margin-bottom: 16px;'>" +
                $"<h2 style='color: #0369a1; margin: 0;'>Hall Rental Inquiry Response</h2>" +
                $"<p style='color: #64748b; margin: 4px 0 0 0; font-size: 13px;'>{clubNameStr} &bull; Inquiry Reference #{_selectedRequest?.Id}</p>" +
                $"</div>" +
                $"<div style='white-space: pre-line;'>{System.Net.WebUtility.HtmlEncode(_inquiryReplyBody)}</div>" +
                $"<hr style='border: none; border-top: 1px solid #e2e8f0; margin: 20px 0 10px 0;'/>" +
                $"<small style='color: #94a3b8;'>Gloucester Fraternity Club &bull; 27 Webster Street, Gloucester, MA 01930 &bull; {clubPhoneStr}</small>" +
                $"</div>";

            var sendRes = await RentalEmailDispatcher.SendRentalEmailAsync(settings, _inquiryReplyRecipient, _inquiryReplySubject, formattedHtml, settings.RentalEmailCc);
            if (sendRes.Success)
            {
                // Update request notes with conversation log and change status to Responded
                if (_selectedRequest != null)
                {
                    _selectedRequest.Status = "Responded";
                    _selectedRequest.StatusChangedBy = adminUser;
                    _selectedRequest.StatusChangedDate = DateTime.UtcNow;

                    var sb = new System.Text.StringBuilder();
                    sb.AppendLine($"[{DateTime.Now:yyyy-MM-dd h:mm tt} by {adminUser}]");
                    sb.AppendLine($"💬 Staff Reply Sent to {_inquiryReplyRecipient}");
                    sb.AppendLine($"• Subject: {_inquiryReplySubject}");
                    sb.AppendLine($"• Message: {_inquiryReplyBody.Trim()}");
                    sb.AppendLine();

                    _selectedRequest.InternalNotes = (sb.ToString() + (_selectedRequest.InternalNotes ?? "")).Trim();
                    await RentalService.UpdateRentalRequestAsync(_selectedRequest);

                    if (_selectedEvent != null)
                    {
                        _selectedEvent.Status = "RESPONDED";
                    }
                }

                ToastService.ShowSuccess($"Reply successfully sent to {_inquiryReplyRecipient}!");
                _showReplyInquiryModal = false;
                await LoadAllRequestsAndPayments();
            }
            else
            {
                _inquiryReplyError = $"Failed to send email: {sendRes.ErrorMessage}";
            }
        }
        catch (Exception ex)
        {
            _inquiryReplyError = $"Error dispatching reply: {ex.Message}";
        }
        finally
        {
            _isSendingInquiryReply = false;
        }
    }

