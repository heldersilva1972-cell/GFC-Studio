@page "/login"
@using GFC.BlazorServer.Services
@using GFC.Core.Interfaces
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@attribute [AllowAnonymous]
@inject CustomAuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject ILogger<Login> Logger
@inject IJSRuntime JSRuntime
@inject IUserConnectionService UserConnectionService
@inject IBlazorSystemSettingsService SystemSettingsService
@inject IPasskeyService PasskeyService
@inject IAuditLogger AuditLogger
@inject IDeviceTrustService DeviceTrustService
@inject IUserManagementService UserManagementService

<PageTitle>Login - GFC Membership</PageTitle>

<div class="login-container">
    <div class="login-card">
        <div class="login-header">
            <h1>GFC Membership System</h1>
            <p class="text-muted">Please sign in to continue</p>
        </div>

        @if (_loginRestricted)
        {
            <div class="alert alert-warning text-center" role="alert">
                <h4 class="alert-heading h5"><i class="bi bi-shield-lock-fill"></i> Access Restricted</h4>
                <p class="mb-0">Login is restricted to secure private network access only.</p>
                <div class="mt-2 small text-muted">
                    Your location: @UserConnectionService.LocationType
                </div>
            </div>
        }
        else
        {
            @if (_checkingPasskey)
            {
                <div class="text-center py-5">
                    <div class="mb-3">
                        <i class="bi bi-fingerprint" style="font-size: 4rem; color: #3b82f6;"></i>
                    </div>
                    <h4 class="text-white mb-2">Biometric Authentication</h4>
                    <p class="text-white-50">Please authenticate with your device...</p>
                    <div class="spinner-border text-primary mt-3" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <div class="mt-3">
                        <button class="btn btn-outline-light btn-sm" @onclick="CancelPasskeyAndShowPasscode">
                            Use Passcode Instead
                        </button>
                    </div>
                </div>
            }
            else
            {


                @if (!string.IsNullOrEmpty(_error))
                {
                    <div class="alert alert-danger" role="alert">@_error</div>
                }

                @if (!string.IsNullOrEmpty(_successMessage))
                {
                    <div class="alert alert-success" role="alert">@_successMessage</div>
                }

            @if (_loginMode == LoginMode.FastGrid && !_showConfirmation)
            {
                <div class="fast-login-grid animate-fade-in w-100">
                    <h5 class="text-white text-center mb-4 text-uppercase ls-2 fw-bold opacity-75 small">Select Identity</h5>
                    <div class="user-grid">
                        @foreach (var user in _fastLoginUsers)
                        {
                            <button class="user-btn" @onclick="() => ConfirmUser(user)">
                                <div class="user-name">@user.Username</div>
                            </button>
                        }
                    </div>
                    <div class="text-center mt-4 pt-3 border-top border-white border-opacity-10">
                        <button class="btn btn-link btn-sm text-white-50 p-0 text-decoration-none" @onclick='() => SetMode(LoginMode.PassCode)'>
                            <i class="bi bi-shield-lock me-1"></i> Use Keyboard Login
                        </button>
                    </div>
                </div>
            }

            @if (_showConfirmation && _confirmingUser != null)
            {
                <div class="confirmation-flow animate-zoom text-center">
                    <div class="conf-icon mb-3">
                        <i class="bi bi-person-check-fill text-primary" style="font-size: 4rem; opacity: 0.8;"></i>
                    </div>
                    <h3 class="text-white fw-bold mb-3">Identity Check</h3>
                    <p class="text-white-50 mb-4">Yes, I am <strong>@_confirmingUser.Username</strong> logging in.</p>
                    
                    <div class="d-grid gap-2">
                        <button class="btn btn-primary py-3 fw-bold" @onclick="ProceedToLogin">
                            Continue to Login <i class="bi bi-arrow-right ms-2"></i>
                        </button>
                        <button class="btn btn-link text-white-50 btn-sm mt-2" @onclick="CancelConfirmation">No, that's not me</button>
                    </div>
                </div>
            }

            @if (_loginMode == LoginMode.Password || _loginMode == LoginMode.PassCode)
            {
                @if (_isStationMode && _loginMode == LoginMode.PassCode && _fastLoginUsers.Any())
                {
                    <div class="mb-4 text-center">
                        <button class="btn btn-outline-light btn-sm rounded-pill px-3" @onclick='() => SetMode(LoginMode.FastGrid)'>
                            <i class="bi bi-grid-fill me-2"></i>Switch to User Grid
                        </button>
                    </div>
                }
                <EditForm Model="_model" OnSubmit="HandleLoginAsync" autocomplete="off">
                    <DataAnnotationsValidator />
                    <ValidationSummary class="alert alert-danger" />

                    <div class="mb-3">
                        <label class="form-label" for="username">Username</label>
                        <input id="username" 
                               class="form-control" 
                               @bind="_model.Username" 
                               placeholder="Enter username"
                               autocomplete="on" />
                        <ValidationMessage For="@(() => _model.Username)" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label" for="password">
                            @(_loginMode == LoginMode.PassCode ? "6-Digit Passcode" : "Password")
                        </label>
                        
                        @if (_loginMode == LoginMode.PassCode)
                        {
                            <div class="position-relative">
                                <input id="password"
                                       type="@(_showPasscode || _useTextKeyboard ? "text" : "password")"
                                       inputmode="@(_useTextKeyboard ? "text" : (_showPasscode ? "text" : "numeric"))"
                                       class="form-control text-center fs-4 fw-bold pe-5"
                                       maxlength="64"
                                       style="letter-spacing: 0.2rem;"
                                       @bind="_model.Password"
                                       @onkeydown="HandleKeyDown"
                                       placeholder="@(_isStationMode ? "Passcode or Setup Code" : "------")"
                                       autocomplete="off" />
                                <button type="button" 
                                        class="btn btn-link position-absolute end-0 top-50 translate-middle-y text-muted px-3" 
                                        style="z-index: 10; border: none; text-decoration: none; margin-top: 0;"
                                        @onclick="() => _showPasscode = !_showPasscode"
                                        tabindex="-1">
                                    <i class="bi @(_showPasscode ? "bi-eye-slash" : "bi-eye")"></i>
                                </button>
                            </div>
                            <div class="text-center mt-2">
                                <button type="button" class="btn btn-link btn-sm text-white-50 p-0" style="font-size:0.78rem; text-decoration:underline dotted;" @onclick="() => _useTextKeyboard = !_useTextKeyboard">
                                    <i class="bi @(_useTextKeyboard ? "bi-123" : "bi-keyboard") me-1"></i>
                                    @(_useTextKeyboard ? "Switch back to number pad" : "Need to type a setup code? Tap for keyboard")
                                </button>
                            </div>
                        }
                        else
                        {
                            <div class="position-relative">
                                <input id="password"
                                       type="@(_showPasscode ? "text" : "password")"
                                       class="form-control pe-5"
                                       style="border-radius: 0.75rem !important;"
                                       @bind="_model.Password"
                                       @onkeydown="HandleKeyDown"
                                       placeholder="Enter password"
                                       autocomplete="new-password" />
                                <button type="button" 
                                        class="btn btn-link position-absolute end-0 top-50 translate-middle-y text-muted px-3" 
                                        style="z-index: 10; border: none; text-decoration: none; margin-top: 0;"
                                        @onclick="() => _showPasscode = !_showPasscode"
                                        tabindex="-1">
                                    <i class="bi @(_showPasscode ? "bi-eye-slash" : "bi-eye")"></i>
                                </button>
                            </div>
                        }
                        <ValidationMessage For="@(() => _model.Password)" />
                    </div>

                    @if (_loginMode == LoginMode.Password)
                {
                    <div class="mb-3">
                        @* Implicitly tracked now - UI hidden *@
                    </div>
                }
                    <button class="btn btn-primary w-100 mt-3"
                            type="submit"
                            disabled="@_isSubmitting">
                        @if (_isSubmitting)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                            <span>Signing in...</span>
                        }
                        else
                        {
                            <span>Sign In</span>
                        }
                    </button>
                    <div class="mt-4 text-center">
                        <small class="text-white-50">
                            Forgot your passcode? Contact an administrator for a reset link.
                        </small>
                    </div>
                </EditForm>
                

            }
        }
    }
</div>
</div>

<style>
