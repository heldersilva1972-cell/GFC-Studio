    }
</style>

@code {
    private LoginModel _model = new();
    private bool _isSubmitting = false;
    private string? _error;
    private string? _successMessage;
    private string? _resolvedReturnUrl;
    private bool _loginRestricted = false;
    private LoginMode _loginMode = LoginMode.PassCode;
    private bool _isSetupMode = false;
    private bool _checkingPasskey = false;
    private bool _passkeyAttempted = false;
    private bool _isStationMode = false;
    private bool _showPasscode = false;
    private bool _useTextKeyboard = false;
    private List<UserListItemDto> _fastLoginUsers = new();
    private UserListItemDto? _confirmingUser = null;
    private bool _showConfirmation = false;

    [Parameter]
    [SupplyParameterFromQuery(Name = "station")]
    public string? StationParam { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "setup")]
    public string? SetupParam { get; set; }

    protected override async Task OnInitializedAsync()
    {
        UpdateResolvedReturnUrl();
        await CheckLoginRestriction();
        
        _isSetupMode = !string.IsNullOrEmpty(SetupParam);
        
        try
        {
            // If this machine has the Station Identity cookie, it is locked into Station Mode.
            _isStationMode = await JSRuntime.InvokeAsync<bool>("window.verifyCookie", "GFC_StationIdentity");

            if (_isStationMode)
            {
                var stationToken = await JSRuntime.InvokeAsync<string>("window.getCookie", "GFC_StationIdentity");
                var station = await DeviceTrustService.GetDeviceByTokenAsync(stationToken);
                
                if (station?.LoginMode == "FastGrid")
                {
                    _loginMode = LoginMode.FastGrid;
                    if (!string.IsNullOrEmpty(station.AuthorizedUserIdsCsv))
                    {
                        var ids = station.AuthorizedUserIdsCsv.Split(',').Select(int.Parse).ToList();
                        var allUsers = UserManagementService.GetAllUsers();
                        _fastLoginUsers = allUsers.Where(u => ids.Contains(u.UserId) && u.IsActive).ToList();
                    }
                }
                else
                {
                    _loginMode = LoginMode.PassCode;
                }
            }

            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            if (authState.User.Identity?.IsAuthenticated == true)
            {
                // INFINITE LOOP PREVENTION: 
                // If an already authenticated user lands on the login page, it usually means exactly one thing:
                // they were bounced back from a page they didn't have authorization to view. 
                // If we follow the ReturnUrl again, they will bounce back and forth infinitely.
                // Erase the return URL and send them to the safe dashboard.
                var fallbackDest = UserConnectionService.IsMobile ? "/mobile" : "/";
                Navigation.NavigateTo(fallbackDest);
                return;
            }

            // Auto-trigger passkey authentication if available (Not in station mode)
            if (!_isStationMode)
            {
                await TryPasskeyAuthenticationAsync();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error during initialization: {Error}", ex.Message);
        }
    }

    private async Task CheckLoginRestriction()
    {
        try
        {
            // Dev override: if loopback, never restrict
            if (UserConnectionService.LocationType == LocationType.Local)
            {
                return;
            }

            var settings = await SystemSettingsService.GetSystemSettingsAsync();
            if (settings != null && settings.EnforceVpn)
            {
                if (UserConnectionService.LocationType != LocationType.VPN &&
                    UserConnectionService.LocationType != LocationType.LAN &&
                    UserConnectionService.LocationType != LocationType.Local)
                {
                    _loginRestricted = true;
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to check login restriction");
        }
    }

    private async Task TryPasskeyAuthenticationAsync()
    {
        if (_passkeyAttempted || _loginRestricted)
        {
            return; // Don't retry or attempt if login is restricted
        }

        try
        {
            // Get device trust token to identify the user
            var deviceToken = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "gfc_device_token");
            if (string.IsNullOrEmpty(deviceToken))
            {
                // No device trust = no passkey possible
                return;
            }

            // Try to get username from device trust
            var username = await GetUsernameFromDeviceTrustAsync(deviceToken);
            if (string.IsNullOrEmpty(username))
            {
                return;
            }

            // Check if user has passkeys registered
            var hasPasskeys = await PasskeyService.HasPasskeysAsync(username);
            if (!hasPasskeys)
            {
                // No passkeys registered, show passcode input
                return;
            }

            // User has passkeys! Auto-trigger biometric prompt
            _checkingPasskey = true;
            _passkeyAttempted = true;
            StateHasChanged();

            await Task.Delay(500); // Brief delay for UI to render

            // Trigger passkey authentication
            _passkeyUsername = username;
            await HandlePasskeyLoginAsync();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Passkey auto-authentication failed, falling back to passcode");
            _checkingPasskey = false;
            _passkeyAttempted = true;
            StateHasChanged();
        }
    }

    private async Task<string?> GetUsernameFromDeviceTrustAsync(string deviceToken)
    {
        try
        {
            // 1. Get User ID from Token
            var userId = await DeviceTrustService.GetUserIdByTokenAsync(deviceToken);
            if (userId == null) return null;

            // 2. Get User from Database
            var user = await UserManagementService.GetUserAsync(userId.Value);
            return user?.Username;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to resolve username from device trust token");
            return null;
        }
    }

    private void CancelPasskeyAndShowPasscode()
    {
        _checkingPasskey = false;
        _error = null;
        StateHasChanged();
    }

    private void ConfirmUser(UserListItemDto user)
    {
        _confirmingUser = user;
        _showConfirmation = true;
        _error = null;
    }

    private void CancelConfirmation()
    {
        _showConfirmation = false;
        _confirmingUser = null;
    }

    private async Task ProceedToLogin()
    {
        if (_confirmingUser == null) return;
        
        if (_isStationMode)
        {
            var stationToken = await JSRuntime.InvokeAsync<string>("window.getCookie", "GFC_StationIdentity");
            var userId = await DeviceTrustService.ValidateStationAutoLoginAsync(stationToken, _confirmingUser.Username);

            if (userId != null)
            {
                // Station trust confirmed - bypass passcode and log in immediately
                var result = await AuthStateProvider.LoginWithUserAsync(userId.Value);
                if (result.Success)
                {
                    Navigation.NavigateTo("/");
                    return;
                }
            }
        }

        // Fallback to standard passcode flow if anything fails or not in station mode
        _model.Username = _confirmingUser.Username;
        _model.Password = "";
        _loginMode = LoginMode.PassCode;
        _showConfirmation = false;
        StateHasChanged();
    }

    private void SetMode(LoginMode mode)
    {
        _loginMode = mode;
        _error = null;
        _successMessage = null;
        _showConfirmation = false;
        _confirmingUser = null;
    }

    private async Task HandleLoginAsync()
    {
        _error = null;
        _isSubmitting = true;
        UpdateResolvedReturnUrl();

        try
        {
            var passwordToUse = _model.Password?.Trim();

            // [NEW] Setup Code Detection
            // If the user enters an 8-character code or a full 64-character token,
            // redirect them to the device setup wizard.
            if (!string.IsNullOrEmpty(passwordToUse) && (passwordToUse.Length == 8 || passwordToUse.Length == 64))
            {
                Navigation.NavigateTo($"/setup/device?token={passwordToUse}&native=true");
                return;
            }

            // ALWAYS request a device token so we can survive a page refresh.
            // Persistence is handled by the cookie's expiration, not the database.
            _model.RememberMe = true;

            // [MANUAL VALIDATION] Since we use OnSubmit to catch setup codes first
            if (string.IsNullOrWhiteSpace(_model.Username) || string.IsNullOrWhiteSpace(_model.Password))
            {
                _error = "Username and Password/Passcode are required.";
                return;
            }

            var result = await AuthStateProvider.LoginAsync(_model.Username, passwordToUse, _model.RememberMe);

            if (result.Code != LoginResultCode.Success)
            {
                if (result.Code == LoginResultCode.MfaRequired)
                {
                    Navigation.NavigateTo($"/verify-mfa?userId={result.User.UserId}&returnUrl={Uri.EscapeDataString(GetPostLoginDestination())}");
                    return;
                }

                if (result.Code == LoginResultCode.Error && !string.IsNullOrEmpty(result.ErrorMessageForLog))
                {
                    _error = result.ErrorMessageForLog;
                }
                else
                {
                    _error = GetUserMessage(result.Code);
                }
                return;
            }
             
            if (result.User == null)
            {
                 _error = "Login failed.";
                 return;
            }

            if (!string.IsNullOrWhiteSpace(result.DeviceToken))
            {
                await JSRuntime.InvokeVoidAsync("localStorage.setItem", "gfc_device_token", result.DeviceToken);
                await JSRuntime.InvokeVoidAsync("sessionStorage.setItem", "gfc_session_active", "true");
                
                // [FIXED] Strategy: On stations, use a session cookie (days = 0).
                // This survives page refreshes but expires when the browser closes.
                int cookieDays = _isStationMode ? 0 : 30;
                await JSRuntime.InvokeVoidAsync("window.setCookie", "GFC_DeviceTrustToken", result.DeviceToken, cookieDays);
            }

            Navigation.NavigateTo(GetPostLoginDestination(), forceLoad: false);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Login error");
            _error = "An unexpected error occurred.";
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    // Removed HandleMagicLinkAsync

    private sealed class LoginModel
    {
        [System.ComponentModel.DataAnnotations.Required]
        public string Username { get; set; } = "";
        [System.ComponentModel.DataAnnotations.Required]
        public string Password { get; set; } = "";
        public bool RememberMe { get; set; }
    }



    private enum LoginMode { PassCode, Passkey, Password, FastGrid }
    private string _passkeyUsername = "";

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await HandleLoginAsync();
        }
    }

    private async Task HandlePasskeyLoginAsync()
    {
        if (string.IsNullOrWhiteSpace(_passkeyUsername))
        {
            _error = "Please enter your username to use a passkey.";
            return;
        }

        _error = null;
        _isSubmitting = true;
        try
        {
            var options = await PasskeyService.RequestLoginOptionsAsync(_passkeyUsername);
            var responseJson = await JSRuntime.InvokeAsync<string>("GFC_Passkeys.login", options);
            
            // Parse the credential ID from the response
            using var doc = System.Text.Json.JsonDocument.Parse(responseJson);
            var credentialId = doc.RootElement.GetProperty("id").GetString();
            
            if (!string.IsNullOrEmpty(credentialId))
            {
                var isValid = await PasskeyService.ValidateLoginAsync(credentialId, _passkeyUsername);
                if (isValid)
                {
                    var result = await AuthStateProvider.LoginWithPasskeyAsync(_passkeyUsername, UserConnectionService.IpAddress);
                    if (result.Success)
                    {
                        // Logic for remember device / tokens
                        if (!string.IsNullOrWhiteSpace(result.DeviceToken))
                        {
                            await JSRuntime.InvokeVoidAsync("localStorage.setItem", "gfc_device_token", result.DeviceToken);
                            await JSRuntime.InvokeVoidAsync("sessionStorage.setItem", "gfc_session_active", "true");
                            await JSRuntime.InvokeVoidAsync("window.setCookie", "GFC_DeviceTrustToken", result.DeviceToken, 30);
                        }

                        Navigation.NavigateTo(GetPostLoginDestination(), forceLoad: false);
                    }
                    else
                    {
                        _error = result.ErrorMessageForLog ?? "Login failed after passkey verification.";
                        _checkingPasskey = false;
                    }
                }
                else
                {
                    _error = "Passkey verification failed.";
                    _checkingPasskey = false;
                }
            }
            else
            {
                _error = "Biometric authentication was cancelled.";
                _checkingPasskey = false;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Passkey login error: {Message}", ex.Message);
            _error = "Biometric authentication failed. Please use your passcode.";
            _checkingPasskey = false;
        }
        finally
        {
            _isSubmitting = false;
            StateHasChanged();
        }
    }

    // Helpers from original file
    private static string GetUserMessage(LoginResultCode code) => code switch
    {
        LoginResultCode.InvalidCredentials => "Invalid username or password.",
        LoginResultCode.AccountLockedOrDisabled => "Your account is locked or disabled.",
        _ => "Unable to sign in at this time."
    };

    private void UpdateResolvedReturnUrl() => _resolvedReturnUrl = NormalizeReturnUrl(ReturnUrl);
    
    private string GetPostLoginDestination() 
    {
        if (_isSetupMode) 
        {
             return "/setup/wizard"; // This will be our new enrollment wizard
        }

        // [NEW] Redirect mobile users to the mobile hub by default
        if (UserConnectionService.IsMobile && string.IsNullOrEmpty(_resolvedReturnUrl))
        {
            return "/mobile";
        }

        return _resolvedReturnUrl ?? "/";
    }
    
    private static string? NormalizeReturnUrl(string? raw)
    {
        if (string.IsNullOrWhiteSpace(raw)) return null;
        try { raw = Uri.UnescapeDataString(raw); } catch { return null; }
        if (raw.StartsWith("//") || raw.Contains("://")) return null;
        if (!raw.StartsWith('/')) raw = "/" + raw;
        return raw.Equals("/login", StringComparison.OrdinalIgnoreCase) ? null : raw;
    }
}
