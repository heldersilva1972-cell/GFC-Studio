@page "/life-eligibility"
@using Microsoft.AspNetCore.Authorization
@using GFC.Core.Interfaces
@attribute [Authorize]
@inject ILifeEligibilityService LifeService
@inject IMemberRepository MemberRepository
@inject MemberService MemberService
@inject IMemberHistoryService HistoryService
@inject GFC.BlazorServer.Services.CustomAuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JSRuntime
@inject ILogger<LifeEligibility> Logger

<link href="css/life-eligibility-modern.css" rel="stylesheet" />

<div class="life-eligibility-container">
    <div class="d-flex justify-content-between align-items-end mb-4">
        <div>
            <h1 class="page-title mb-1">Life Eligibility</h1>
            <p class="text-muted mb-0">Manage members eligible for conversion to Life status.</p>
        </div>
        <div class="toolbar d-flex align-items-center gap-3">
            <div class="form-check form-switch modern-toggle mb-0">
                <input class="form-check-input" type="checkbox" id="upcomingSwitch" @bind="_includeUpcoming" @bind:after="OnFilterChanged" />
                <label class="form-check-label fw-bold text-secondary" for="upcomingSwitch">Include next 12 months</label>
            </div>
            <button class="btn btn-outline-secondary rounded-pill px-3 fw-bold d-flex align-items-center gap-2 shadow-sm"
                    @onclick="PrintList">
                <i class="bi bi-printer-fill"></i>
                <span>Print List</span>
            </button>
        </div>
    </div>

    @if (!_loading && !_operationInProgress)
    {
        <div class="eligibility-stats">
            <div class="stat-card">
                <div class="stat-icon icon-eligible">
                    <i class="bi bi-person-check-fill"></i>
                </div>
                <div class="stat-info">
                    <span class="stat-value">@_members.Count(m => m.EligibleNow)</span>
                    <span class="stat-label">Eligible Now</span>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon icon-upcoming">
                    <i class="bi bi-clock-history"></i>
                </div>
                <div class="stat-info">
                    <span class="stat-value">@_members.Count(m => !m.EligibleNow)</span>
                    <span class="stat-label">Upcoming</span>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon icon-total">
                    <i class="bi bi-people-fill"></i>
                </div>
                <div class="stat-info">
                    <span class="stat-value">@_members.Count</span>
                    <span class="stat-label">Total Shown</span>
                </div>
            </div>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(_operationMessage))
    {
        <div class="alert @( _operationError ? "alert-danger" : "alert-success") d-flex align-items-center mb-4 rounded-4 shadow-sm border-0">
            <i class="bi @(_operationError ? "bi-exclamation-triangle-fill" : "bi-check-circle-fill") me-2 fs-5"></i>
            <div>@_operationMessage</div>
        </div>
    }

    @if (_loading)
    {
        <div class="modern-card p-5 text-center">
            <div class="spinner-border text-primary mb-3" role="status"></div>
            <p class="text-muted fw-bold">Analyzing eligibility records...</p>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <div class="alert alert-danger rounded-4 border-0 shadow-sm">
            <i class="bi bi-exclamation-octagon-fill me-2"></i>
            @_errorMessage
        </div>
    }
    else
    {
        <div class="modern-card">
            <div class="card-header-modern">
                <h5 class="mb-0 fw-bold"><i class="bi bi-table me-2 text-primary"></i>Member Listing</h5>
                <span class="badge bg-light text-dark border rounded-pill px-3 py-2">@_members.Count Entries</span>
            </div>
            <div class="table-responsive-modern">
                <table class="table-modern">
                    <thead>
                        <tr>
                            <th>Member</th>
                            <th>Age</th>
                            <th>Regular Since</th>
                            <th>Eligibility Date</th>
                            <th>Status</th>
                            <th>Dues Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (_members.Count == 0)
                        {
                            <tr>
                                <td colspan="7">
                                    <div class="empty-state-modern">
                                        <div class="empty-state-icon"><i class="bi bi-person-x"></i></div>
                                        <h5>No Members Found</h5>
                                        <p class="mb-0">There are currently no members matching your selection criteria.</p>
                                    </div>
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var member in _members)
                            {
                                <tr>
                                    <td>
                                        <div class="member-cell">
                                            <div class="member-avatar">@member.FullName.Substring(0, 1)</div>
                                            <div>
                                                <div class="member-name">@member.FullName</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="fw-bold text-dark">@member.Age</span>
                                        <span class="text-muted small ms-1">yrs</span>
                                    </td>
                                    <td>
                                        <div class="d-flex flex-column">
                                            <span class="fw-semibold">@FormatDate(member.RegularSince)</span>
                                            @if (member.RegularSince.HasValue)
                                            {
                                                var years = DateTime.Today.Year - member.RegularSince.Value.Year;
                                                if (DateTime.Today < member.RegularSince.Value.AddYears(years)) years--;
                                                <span class="text-primary small fw-bold">@years Years Tenure</span>
                                            }
                                        </div>
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <i class="bi bi-calendar-event me-2 text-muted"></i>
                                            <span class="fw-semibold">@FormatDate(member.EligibilityDate)</span>
                                        </div>
                                    </td>
                                    <td>
                                        @if (member.EligibleNow)
                                        {
                                            <span class="badge-modern badge-eligible">
                                                <i class="bi bi-check-circle-fill"></i> Eligible
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge-modern badge-upcoming">
                                                <i class="bi bi-hourglass-split"></i> Upcoming
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        @if (member.CurrentYearPaid)
                                        {
                                            <span class="badge-modern badge-paid">
                                                <i class="bi bi-shield-fill-check"></i> Paid
                                            </span>
                                        }
                                        else
                                        {
                                            <div class="d-flex flex-column">
                                                <span class="badge-modern badge-unpaid mb-1">
                                                    <i class="bi bi-shield-fill-exclamation"></i> Unpaid
                                                </span>
                                                @if (member.MonthsUnpaid.HasValue)
                                                {
                                                    <span class="text-danger small fw-bold ms-1" style="font-size: 0.7rem;">@member.MonthsUnpaid.Value months overdue</span>
                                                }
                                            </div>
                                        }
                                    </td>
                                    <td class="text-end">
                                        @if (member.EligibleNow)
                                        {
                                            <button class="btn btn-primary btn-sm rounded-pill px-3 fw-bold"
                                                    disabled="@_operationInProgress"
                                                    @onclick="() => BeginConversion(member)">
                                                Convert to Life
                                            </button>
                                        }
                                        else
                                        {
                                            <span class="text-muted small fst-italic">Pending...</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@if (_pendingMember is not null)
{
    <div class="modal-backdrop fade show" style="background: rgba(15, 23, 42, 0.4); backdrop-filter: blur(4px);"></div>
    <div class="modal d-block" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg rounded-4">
                <div class="modal-header border-bottom-0 pt-4 px-4">
                    <h5 class="modal-title fw-800 text-dark">Confirm Conversion</h5>
                    <button type="button" class="btn-close" @onclick="CancelConversion"></button>
                </div>
                <div class="modal-body px-4 py-3">
                    <div class="d-flex align-items-center mb-3">
                        <div class="bg-primary bg-opacity-10 p-3 rounded-circle me-3">
                            <i class="bi bi-person-badge-fill text-primary fs-3"></i>
                        </div>
                        <div>
                            <p class="mb-0 text-muted">You are about to convert</p>
                            <h5 class="mb-0 fw-bold">@_pendingMember.FullName</h5>
                        </div>
                    </div>
                    <p class="text-secondary mb-0">
                        This will permanently change the member's status to <strong>LIFE</strong>. Dues will no longer be assessed for this member.
                    </p>
                </div>
                <div class="modal-footer border-top-0 pb-4 px-4">
                    <button type="button" class="btn btn-light rounded-pill px-4 fw-bold" @onclick="CancelConversion">Cancel</button>
                    <button type="button" class="btn btn-primary rounded-pill px-4 fw-bold" 
                            disabled="@_operationInProgress"
                            @onclick="ConfirmConversionAsync">
                        @if (_operationInProgress)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        Confirm Conversion
                    </button>
                </div>
            </div>
        </div>
    </div>
}


@code {
    private bool _loading = true;
    private bool _includeUpcoming;
    private List<LifeEligibilityDto> _members = new();
    private string? _errorMessage;
    private string? _operationMessage;
    private bool _operationError;
    private bool _operationInProgress;
    private LifeEligibilityDto? _pendingMember;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        _loading = true;
        _errorMessage = null;
        try
        {
            _members = (await LifeService.GetEligibleMembersAsync(_includeUpcoming)).ToList();
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"[LifeEligibility] {ex}");
            _errorMessage = "Unable to load life eligibility data.";
            _members = new List<LifeEligibilityDto>();
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OnFilterChanged()
    {
        _operationMessage = null;
        await LoadData();
    }

    private void BeginConversion(LifeEligibilityDto member)
    {
        if (!member.EligibleNow || _operationInProgress)
        {
            return;
        }

        _pendingMember = member;
        _operationMessage = null;
        _operationError = false;
    }

    private void CancelConversion()
    {
        _pendingMember = null;
        _operationInProgress = false;
    }

    private async Task ConfirmConversionAsync()
    {
        if (_pendingMember is null || _operationInProgress)
        {
            return;
        }

        _operationInProgress = true;

        try
        {
            var entity = await Task.Run(() => MemberRepository.GetMemberById(_pendingMember.MemberId));
            if (entity is null)
            {
                _operationError = true;
                _operationMessage = "The selected member could not be found.";
                return;
            }

            var currentUser = AuthStateProvider.GetCurrentUser();
            var username = currentUser?.Username ?? "Unknown";
            await MemberService.UpdateMemberStatusAsync(entity, "LIFE", username);
            _operationError = false;
            _operationMessage = $"{_pendingMember.FullName} converted to Life.";
            await LoadData();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "[LifeEligibility] Failed to convert member {MemberId} to Life", _pendingMember.MemberId);
            _operationError = true;
            _operationMessage = "Unable to convert the member to Life status.";
        }
        finally
        {
            _operationInProgress = false;
            _pendingMember = null;
        }
    }

    private static string FormatDate(DateTime? value)
        => value?.ToString("MMM d, yyyy") ?? "--";

    private async Task PrintList()
    {
        if (_members == null || _members.Count == 0) return;

        var sb = new System.Text.StringBuilder();
        sb.Append("<!DOCTYPE html><html><head><meta charset='utf-8'/><title>Life Eligibility List</title>");
        sb.Append("<style>");
        sb.Append("@page { size: letter portrait; margin: 0.5in; }");
        sb.Append("body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; color: #1e293b; margin: 0; padding: 20px; font-size: 10pt; }");
        sb.Append(".header { border-bottom: 2px solid #0f172a; padding-bottom: 12px; margin-bottom: 16px; display: flex; justify-content: space-between; align-items: flex-end; }");
        sb.Append(".title { font-size: 16pt; font-weight: 800; color: #0f172a; margin: 0 0 4px 0; }");
        sb.Append(".meta { font-size: 9pt; color: #64748b; margin: 0; }");
        sb.Append(".stats { text-align: right; font-size: 9pt; color: #475569; }");
        sb.Append(".stats strong { color: #0f172a; }");
        sb.Append("table { width: 100%; border-collapse: collapse; margin-top: 10px; }");
        sb.Append("th { background-color: #f8fafc; color: #334155; font-size: 8.5pt; text-transform: uppercase; letter-spacing: 0.05em; font-weight: 700; text-align: left; padding: 8px 10px; border-bottom: 2px solid #cbd5e1; }");
        sb.Append("td { padding: 9px 10px; border-bottom: 1px solid #e2e8f0; font-size: 9.5pt; vertical-align: middle; }");
        sb.Append("tr:nth-child(even) td { background-color: #fafbfc; }");
        sb.Append(".name { font-weight: 700; color: #0f172a; }");
        sb.Append(".status-eligible { color: #166534; font-weight: 700; }");
        sb.Append(".status-upcoming { color: #6366f1; font-weight: 700; }");
        sb.Append(".status-paid { color: #166534; font-weight: 700; }");
        sb.Append(".status-unpaid { color: #b91c1c; font-weight: 700; }");
        sb.Append("</style></head><body>");

        // Header
        sb.Append("<div class='header'>");
        sb.Append("<div>");
        sb.Append("<h1 class='title'>Life Membership Eligibility List</h1>");
        var filterLabel = _includeUpcoming ? "Including next 12 months" : "Currently eligible only";
        sb.Append($"<p class='meta'>Printed on {DateTime.Now:MMMM d, yyyy h:mm tt} ({filterLabel})</p>");
        sb.Append("</div>");
        sb.Append("<div class='stats'>");
        sb.Append($"<div>Eligible Now: <strong>{_members.Count(m => m.EligibleNow)}</strong></div>");
        if (_includeUpcoming)
        {
            sb.Append($"<div>Upcoming: <strong>{_members.Count(m => !m.EligibleNow)}</strong></div>");
        }
        sb.Append($"<div>Total Listed: <strong>{_members.Count}</strong></div>");
        sb.Append("</div>");
        sb.Append("</div>");

        // Table
        sb.Append("<table><thead><tr>");
        sb.Append("<th>Member Name</th>");
        sb.Append("<th>Age</th>");
        sb.Append("<th>Regular Since / Tenure</th>");
        sb.Append("<th>Eligible Date</th>");
        sb.Append("<th>Eligibility</th>");
        sb.Append("<th>Dues Status</th>");
        sb.Append("</tr></thead><tbody>");

        foreach (var member in _members)
        {
            sb.Append("<tr>");
            sb.Append($"<td class='name'>{System.Net.WebUtility.HtmlEncode(member.FullName)}</td>");
            sb.Append($"<td>{member.Age} yrs</td>");

            var tenureYears = "";
            if (member.RegularSince.HasValue)
            {
                var y = DateTime.Today.Year - member.RegularSince.Value.Year;
                if (DateTime.Today < member.RegularSince.Value.AddYears(y)) y--;
                tenureYears = $" ({y} yrs tenure)";
            }
            sb.Append($"<td>{FormatDate(member.RegularSince)}{tenureYears}</td>");

            sb.Append($"<td>{FormatDate(member.EligibilityDate)}</td>");

            if (member.EligibleNow)
            {
                sb.Append("<td class='status-eligible'>✓ Eligible Now</td>");
            }
            else
            {
                sb.Append("<td class='status-upcoming'>⏳ Upcoming</td>");
            }

            if (member.CurrentYearPaid)
            {
                sb.Append("<td class='status-paid'>✓ Paid</td>");
            }
            else
            {
                var overdueText = member.MonthsUnpaid.HasValue ? $" ({member.MonthsUnpaid.Value} mo overdue)" : "";
                sb.Append($"<td class='status-unpaid'>✗ Unpaid{overdueText}</td>");
            }

            sb.Append("</tr>");
        }

        sb.Append("</tbody></table>");
        sb.Append("<script>window.onload = function() { window.print(); setTimeout(function() { window.close(); }, 750); };</script>");
        sb.Append("</body></html>");

        var jsonHtml = System.Text.Json.JsonSerializer.Serialize(sb.ToString());
        var script = "var printWin = window.open('', '_blank', 'width=850,height=1000'); if (printWin) { printWin.document.write(" + jsonHtml + "); printWin.document.close(); }";
        await JSRuntime.InvokeVoidAsync("eval", script);
    }
}

