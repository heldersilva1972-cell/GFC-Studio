@code {
    private DateTime _startDate = DateTime.Today.AddDays(-30);
    private DateTime _endDate = DateTime.Today;

    private bool _loading = true;
    private bool _showSummariesOnly = false;
    private bool _showGuide = false;
    private bool _canEdit = false;
    private string _statusMessage = "Initializing...";
    private string? _errorMessage;
    private List<DailySalesReportDto> _days = new();
    private ShiftReportDto? _selectedShift;
    private DateTime _selectedShiftDate;

    protected override async Task OnInitializedAsync()
    {
        await CheckPermissions();
        await RefreshData();
    }

    private async Task CheckPermissions()
    {
        try 
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            
            // System Admins always have edit access
            if (user.IsInRole("Admin"))
            {
                _canEdit = true;
                return;
            }

            // Check granular page permission for non-admins
            var userIdClaim = user.FindFirst(c => c.Type == "sub") ?? user.FindFirst(c => c.Type == System.Security.Claims.ClaimTypes.NameIdentifier);
            if (userIdClaim != null && int.TryParse(userIdClaim.Value, out int userId))
            {
                var permission = await Task.Run(() => UserService.GetUserPagePermission(userId, "/finance/bar-lottery-sales"));
                _canEdit = permission?.CanEdit ?? false;
            }
        }
        catch (Exception ex)
        {
            _canEdit = false; // Safe default
        }
    }



    private async Task RefreshData()
    {
        _loading = true;
        _errorMessage = null;
        _statusMessage = "Connecting to Financial Server...";
        StateHasChanged();

        try
        {
            _statusMessage = "Analyzing Bar and Lottery Records...";
            StateHasChanged();
            
            var result = await FinancialService.GetDailySalesReportsAsync(_startDate, _endDate);
            _days = result.Data;
            
            if (result.Error != "None")
            {
                // Silent error in background
            }


            
            if (_days.Count > 0)
            {
                var totalShifts = _days.Sum(d => d.Shifts.Count);
            }

        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
            _statusMessage = "An error occurred. Please try again.";
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private async Task SetDateRange(int days)
    {
        _endDate = DateTime.Today;
        _startDate = DateTime.Today.AddDays(-days);
        await RefreshData();
    }

    private async Task SetThisMonth()
    {
        var today = DateTime.Today;
        _startDate = new DateTime(today.Year, today.Month, 1);
        _endDate = new DateTime(today.Year, today.Month, DateTime.DaysInMonth(today.Year, today.Month));
        await RefreshData();
    }

    private async Task SetLastMonth()
    {
        var today = DateTime.Today;
        var firstOfThisMonth = new DateTime(today.Year, today.Month, 1);
        _endDate = firstOfThisMonth.AddDays(-1);
        _startDate = new DateTime(_endDate.Year, _endDate.Month, 1);
        await RefreshData();
    }

    private void ShowShiftDetail(DateTime businessDate, ShiftReportDto shift)
    {
        _selectedShiftDate = businessDate;
        _selectedShift = shift;
    }

    private void GoToEdit(DateTime businessDate, ShiftReportDto shift)
    {
        // Navigate to the end-of-shift page with the correct business date and shift context
        Navigation.NavigateTo($"/operations/end-of-shift?date={businessDate:yyyy-MM-dd}&shift={shift.ShiftType}");
    }

    private async Task ExportToExcel()
    {
