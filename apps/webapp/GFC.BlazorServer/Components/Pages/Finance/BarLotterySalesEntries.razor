        await JS.InvokeVoidAsync("alert", "Exporting " + _days.Count + " days of data to Excel...");
    }

    private async Task PrintSummaries()
    {
        // Force the UI into summary mode first
        _showSummariesOnly = true;
        StateHasChanged();
        
        // Slight delay to allow DOM to re-render without the tables
        await Task.Delay(100); 
        
        // Trigger browser print dialog
        await JS.InvokeVoidAsync("window.print");
    }

    // SIMULATOR STATE
    private bool _showSim = false;
    private string _simShiftType = "Day";
    
    // BACKING DATA (The actual entries)
    private decimal _simNetSales = 0;
    private decimal _simCashes = 0;
    private decimal _simNetDue = 0;
    private decimal _simBeginningCash = 1200; // Manual input for Day
    private decimal _simBag = 0;
    private decimal _simCounted = 0;

    // PERSISTED DAY DATA (Frozen when switching)
    private decimal _simPersistedDaySales = 0;
    private decimal _simPersistedDayCashes = 0;
    private decimal _simPersistedDayNetDue = 0;
    private decimal _simPersistedDayBeginning = 1200;
    private decimal _simPersistedDayBag = 0;
    private decimal _simPersistedDayCounted = 0;

    // PERSISTED NIGHT DATA (Saved when switching back to Day)
    private decimal _simPersistedNightSales = 0;
    private decimal _simPersistedNightCashes = 0;
    private decimal _simPersistedNightNetDue = 0;
    private decimal _simPersistedNightBag = 0;
    private decimal _simPersistedNightCounted = 0;

    private bool _simUseIsolation = true;

    // Calculations based on stored logic in EndOfShiftSales.razor
    // Logic: Calculate the shift portion by subtracting Day from the current Cumulative total
    private decimal SimShiftSales => (_simShiftType == "Night" && _simUseIsolation) ? (_simNetSales - _simPersistedDaySales) : _simNetSales;
    private decimal SimShiftCashes => (_simShiftType == "Night" && _simUseIsolation) ? (_simCashes - _simPersistedDayCashes) : _simCashes;
    private decimal SimShiftNetDue => (_simShiftType == "Night" && _simUseIsolation) ? (_simNetDue - _simPersistedDayNetDue) : _simNetDue;
    
    private decimal SimExpected => _simBeginningCash + SimShiftSales - SimShiftCashes + _simBag;
    private decimal SimVariance => _simCounted - SimExpected;

    // Settlement Logic (Same as EndOfShiftSales.razor)
    private decimal SimSurplus => Math.Max(0, _simCounted - 1200);
    private decimal SimReturnToBag => Math.Min(SimSurplus, _simBag);
    private decimal SimEnv => Math.Max(0, SimSurplus - SimReturnToBag);
    private decimal SimNextShiftStart => _simCounted - SimReturnToBag - SimEnv;

    private decimal SimCollected => SimShiftSales - SimShiftCashes;
    private decimal SimIncome => SimCollected - SimShiftNetDue;
    private decimal SimNetIncome => SimIncome + SimVariance;

    // Day Shift Results for Comparison
    private decimal DayExpectedVal => _simPersistedDayBeginning + _simPersistedDaySales - _simPersistedDayCashes + _simPersistedDayBag;
    private decimal DayVarianceVal => _simPersistedDayCounted - DayExpectedVal;
    private decimal DayIncomeVal => (_simPersistedDaySales - _simPersistedDayCashes) - _simPersistedDayNetDue;

    private void ToggleSimShift(string type)
    {
        // 1. Calculate Carryover BEFORE saving/swapping if we are moving TO Night
        decimal calculatedCarryover = _simBeginningCash; 
        if (_simShiftType == "Day" && type == "Night")
        {
            calculatedCarryover = SimNextShiftStart;
        }

        // 2. Save current inputs into the respective persistence slot
        if (_simShiftType == "Day")
        {
            _simPersistedDaySales = _simNetSales;
            _simPersistedDayCashes = _simCashes;
            _simPersistedDayNetDue = _simNetDue;
            _simPersistedDayBeginning = _simBeginningCash;
            _simPersistedDayBag = _simBag;
            _simPersistedDayCounted = _simCounted;
        }
        else
        {
            _simPersistedNightSales = _simNetSales;
            _simPersistedNightCashes = _simCashes;
            _simPersistedNightNetDue = _simNetDue;
            _simPersistedNightBag = _simBag;
            _simPersistedNightCounted = _simCounted;
        }

        // 3. Switch the active type
        _simShiftType = type;

        // 4. Load the data from the new shift back into active inputs
        if (_simShiftType == "Day")
        {
            _simNetSales = _simPersistedDaySales;
            _simCashes = _simPersistedDayCashes;
            _simNetDue = _simPersistedDayNetDue;
            _simBeginningCash = _simPersistedDayBeginning;
            _simBag = _simPersistedDayBag;
            _simCounted = _simPersistedDayCounted;
        }
        else
        {
            _simNetSales = _simPersistedNightSales;
            _simCashes = _simPersistedNightCashes;
            _simNetDue = _simPersistedNightNetDue;
            _simBeginningCash = calculatedCarryover; // Always use the calculated carryover for Night Start
            _simBag = _simPersistedNightBag;
            _simCounted = _simPersistedNightCounted;
        }
    }

    private void ClearSim()
    {
        _simNetSales = 0;
        _simCashes = 0;
        _simNetDue = 0;
        _simBeginningCash = 1200;
        _simBag = 0;
        _simCounted = 0;
        _simPersistedDaySales = 0;
        _simPersistedDayCashes = 0;
        _simPersistedDayNetDue = 0;
        _simUseIsolation = true;
    }

