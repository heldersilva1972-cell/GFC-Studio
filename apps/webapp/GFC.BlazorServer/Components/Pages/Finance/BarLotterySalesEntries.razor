@page "/finance/bar-lottery-sales"
@using Microsoft.AspNetCore.Authorization
@using GFC.BlazorServer.Services
@using GFC.Core.Models
@using GFC.Core.DTOs
@inject IFinancialAnalyticsService FinancialService
@inject IJSRuntime JS
@attribute [Authorize]

<PageTitle>Bar and Lottery Sales Entries | GFC Finance</PageTitle>

<div class="glass-page-container">
    <div class="page-content-wrapper">
        
        <!-- HEADER SECTION -->
        <header class="entries-header mb-4">
            <div class="header-glass py-3 px-4 shadow-sm border-bottom">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                    <div class="d-flex align-items-center gap-3">
                        <div class="header-icon-box bg-primary bg-opacity-10 p-2 rounded-3">
                            <i class="bi bi-journal-check text-primary fs-3"></i>
                        </div>
                        <div>
                            <h1 class="display-6 fw-black text-dark mb-0 fs-3">Bar and Lottery Sales Entries</h1>
                            <p class="text-muted small mb-0">Daily shift reports and reconciliation tracking</p>
                        </div>
                    </div>
                    
                    <div class="d-flex align-items-center gap-2">
                        <div class="date-filter-group bg-white rounded-pill p-1 border shadow-sm d-flex align-items-center">
                            <input type="date" class="form-control form-control-sm border-0 bg-transparent fw-bold" 
                                   @bind="_startDate" style="width: 130px;" />
                            <span class="text-muted mx-1">to</span>
                            <input type="date" class="form-control form-control-sm border-0 bg-transparent fw-bold" 
                                   @bind="_endDate" style="width: 130px;" />
                            <button class="btn btn-primary btn-sm rounded-pill px-3 ms-2" @onclick="RefreshData" disabled="@_loading">
                                @if (_loading) { <span class="spinner-border spinner-border-sm"></span> }
                                else { <i class="bi bi-search me-1"></i> <span>Search</span> }
                            </button>
                        </div>
                        <button class="btn btn-outline-success btn-sm rounded-pill px-3 shadow-sm" @onclick="ExportToExcel">
                            <i class="bi bi-file-earmark-excel me-1"></i> Export
                        </button>
                    </div>
                </div>
            </div>
        </header>

        @if (_loading)
        {
            <div class="d-flex flex-column align-items-center justify-content-center py-5">
                <div class="loader-ring mb-3"></div>
                <span class="text-muted fw-bold uppercase-tracking">@_statusMessage</span>
            </div>
        }

        else if (_days.Count == 0)
        {
            <div class="text-center py-5 mt-4 glass-card p-5 border-0">
                <div class="mb-3">
                    <i class="bi bi-calendar-x fs-1 text-muted"></i>
                </div>
                <h3 class="fw-bold text-dark">No Entries Found</h3>
                <p class="text-muted">No sales reports were found for the selected date range.</p>
                <button class="btn btn-primary rounded-pill px-4 mt-2" @onclick="() => { _startDate = DateTime.Today.AddDays(-7); _endDate = DateTime.Today; RefreshData(); }">
                    View Last 7 Days
                </button>
            </div>
        }
        else
        {
            <div class="entries-list d-flex flex-column gap-4">
                @foreach (var day in _days)
                {
                    <div class="day-group-card animate-slide-up">
                        <div class="day-header py-2 px-4 d-flex justify-content-between align-items-center">
                            <div class="d-flex align-items-center gap-3">
                                <span class="calendar-icon-mini">
                                    <span class="month">@day.Date.ToString("MMM")</span>
                                    <span class="day">@day.Date.ToString("dd")</span>
                                </span>
                                <div>
                                    <h4 class="mb-0 fw-black text-dark fs-5">@day.Date.ToString("dddd, MMMM d, yyyy")</h4>
                                    <div class="d-flex gap-2 mt-1">
                                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1 rounded-pill x-small">
                                            BAR: @day.TotalBarSales.ToString("C2")
                                        </span>
                                        <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1 rounded-pill x-small">
                                            LOTTERY: @day.TotalLottoNetSales.ToString("C2")
                                        </span>
                                    </div>
                                </div>
                            </div>
                            <div class="text-end">
                                <div class="text-muted x-small uppercase-tracking fw-bold">Daily Variance</div>
                                <div class="fw-black @(day.TotalVariance == 0 ? "text-success" : day.TotalVariance > 0 ? "text-primary" : "text-danger")">
                                    @(day.TotalVariance > 0 ? "+" : "")@day.TotalVariance.ToString("C2")
                                </div>
                            </div>
                        </div>

                        <div class="day-body p-0">
                            <div class="table-responsive">
                                <table class="table table-hover mb-0 align-middle custom-table">
                                    <thead>
                                        <tr>
                                            <th class="ps-4">SHIFT</th>
                                            <th class="text-end">BAR SALES</th>
                                            <th class="text-end">LOTTO SALES</th>
                                            <th class="text-end">LOTTO CASHES</th>
                                            <th class="text-end">NET SALES</th>
                                            <th class="text-end">NET DUE</th>
                                            <th class="text-end">VARIANCE</th>
                                            <th class="pe-4 text-center">DETAILS</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var shift in day.Shifts)
                                        {
                                            <tr>
                                                <td class="ps-4">
                                                    <div class="d-flex align-items-center gap-2">
                                                        <span class="shift-indicator @shift.ShiftType.ToLower()"></span>
                                                        <div class="fw-bold text-dark">@shift.ShiftType SHIFT</div>
                                                        @if (shift.IsRentalHall)
                                                        {
                                                            <span class="badge bg-indigo-subtle text-indigo px-2 py-0 x-small rounded-pill">HALL</span>
                                                        }
                                                    </div>
                                                    <div class="x-small text-muted">By @shift.CreatedBy</div>
                                                </td>
                                                <td class="text-end fw-bold">@shift.BarSales.ToString("C2")</td>
                                                <td class="text-end">@shift.LottoSales.ToString("C2")</td>
                                                <td class="text-end">@shift.LottoPayouts.ToString("C2")</td>
                                                <td class="text-end fw-bold text-primary">@shift.LottoNetSales.ToString("C2")</td>
                                                <td class="text-end text-muted small">@shift.LottoNetDue.ToString("C2")</td>
                                                <td class="text-end">
                                                    <span class="fw-bold @(shift.Variance == 0 ? "text-success" : shift.Variance > 0 ? "text-primary" : "text-danger")">
                                                        @(shift.Variance > 0 ? "+" : "")@shift.Variance.ToString("N2")
                                                    </span>
                                                </td>
                                                <td class="pe-4 text-center">
                                                    <button class="btn btn-icon-sm" @onclick="() => ShowShiftDetail(shift)">
                                                        <i class="bi bi-info-circle"></i>
                                                    </button>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }

        <!-- DEBUG CONSOLE -->
        <div class="mt-5 glass-card p-4 border-dashed border-2">
            <h5 class="text-muted small uppercase-tracking fw-bold mb-3 d-flex justify-content-between">
                System Debug Log 
                <button class="btn btn-link btn-sm p-0 text-decoration-none" @onclick="() => _debugLogs.Clear()">Clear</button>
            </h5>
            <div class="debug-scroll bg-dark text-success p-3 rounded-3 font-monospace small" style="max-height: 200px; overflow-y: auto;">
                @if (_debugLogs.Count == 0)
                {
                    <div class="opacity-50 fst-italic">Waiting for system activity...</div>
                }
                else
                {
                    @foreach (var log in _debugLogs)
                    {
                        <div class="mb-1">
                            <span class="text-primary me-2">[@DateTime.Now.ToString("HH:mm:ss")]</span>
                            <span>@log</span>
                        </div>
                    }
                }
            </div>
            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <div class="alert alert-danger mt-3 small">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i> @_errorMessage
                </div>
            }
        </div>
    </div>
</div>


<!-- Simple Detail Modal -->
@if (_selectedShift != null)
{
    <div class="modal fade show d-block" style="background: rgba(0,0,0,0.5); backdrop-filter: blur(4px);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="modal-header bg-dark text-white p-4">
                    <h5 class="modal-title fw-black uppercase-tracking fs-6">Shift Details: @_selectedShift.ShiftType</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => _selectedShift = null"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="row g-4">
                        <div class="col-6">
                            <div class="detail-box">
                                <label>CREATED BY</label>
                                <div>@_selectedShift.CreatedBy</div>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="detail-box">
                                <label>TIMESTAMP</label>
                                <div>@_selectedShift.CreatedAt.ToLocalTime().ToString("g")</div>
                            </div>
                        </div>
                        <div class="col-12 mt-3">
                            <div class="detail-box accent-success">
                                <label>LOTTERY MATH</label>
                                <div class="small">
                                    Start (@_selectedShift.StartingCash.ToString("C2")) + Sales (@_selectedShift.LottoSales.ToString("C2")) - Payouts (@_selectedShift.LottoPayouts.ToString("C2")) + Bag (@_selectedShift.BackupBagAmount.ToString("C2")) = Expected (@_selectedShift.ExpectedCash.ToString("C2"))
                                </div>
                                <div class="mt-2 fw-bold text-dark">
                                    Actual Counted: @_selectedShift.EndingCash.ToString("C2")
                                    <span class="ms-2 @(_selectedShift.Variance == 0 ? "text-success" : "text-danger")">
                                        (@(_selectedShift.Variance > 0 ? "+" : "")@_selectedShift.Variance.ToString("C2"))
                                    </span>
                                </div>
                            </div>
                        </div>
                        @if (!string.IsNullOrEmpty(_selectedShift.Notes))
                        {
                            <div class="col-12 mt-3">
                                <div class="detail-box bg-light">
                                    <label>NOTES</label>
                                    <div class="fst-italic text-dark">"@_selectedShift.Notes"</div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
                <div class="modal-footer border-0 p-3 bg-light">
                    <button class="btn btn-secondary rounded-pill px-4" @onclick="() => _selectedShift = null">Close</button>
                    <button class="btn btn-primary rounded-pill px-4" @onclick="() => GoToEdit(_selectedShift)">Edit Report</button>
                </div>
            </div>
        </div>
    </div>
}

<style>
    .glass-page-container {
        min-height: 100vh;
        background: radial-gradient(circle at top right, #f8fafc, #eff6ff);
        padding: 2rem;
        font-family: 'Inter', sans-serif;
    }

    .page-content-wrapper {
        max-width: 1200px;
        margin: 0 auto;
    }

    .header-glass {
        background: rgba(255, 255, 255, 0.7);
        backdrop-filter: blur(10px);
        border-radius: 20px;
        border: 1px solid rgba(255, 255, 255, 0.8);
    }

    .fw-black { font-weight: 900; }
    .uppercase-tracking { text-transform: uppercase; letter-spacing: 0.1em; }
    .x-small { font-size: 0.7rem; }
    .text-indigo { color: #6366f1; }
    .bg-indigo-subtle { background: #eef2ff; }

    .day-group-card {
        background: white;
        border-radius: 24px;
        box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.05);
        overflow: hidden;
        border: 1px solid #f1f5f9;
        transition: transform 0.3s ease;
    }

    .day-header {
        background: #f8fafc;
        border-bottom: 1px solid #f1f5f9;
    }

    .calendar-icon-mini {
        width: 48px;
        height: 48px;
        background: white;
        border-radius: 12px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        border: 1px solid #e2e8f0;
        box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);
    }

    .calendar-icon-mini .month {
        font-size: 0.6rem;
        font-weight: 800;
        text-transform: uppercase;
        color: #ef4444;
        line-height: 1;
    }

    .calendar-icon-mini .day {
        font-size: 1.25rem;
        font-weight: 900;
        color: #1e293b;
        line-height: 1;
    }

    .custom-table th {
        font-size: 0.7rem;
        font-weight: 800;
        color: #94a3b8;
        text-transform: uppercase;
        padding: 1rem 0.75rem;
        border-bottom: 2px solid #f1f5f9;
        background: white;
    }

    .custom-table td {
        padding: 1.25rem 0.75rem;
        color: #475569;
        font-size: 0.875rem;
        border-bottom: 1px solid #f8fafc;
    }

    .shift-indicator {
        width: 8px;
        height: 8px;
        border-radius: 50%;
    }
    .shift-indicator.day { background-color: #f59e0b; box-shadow: 0 0 10px rgba(245, 158, 11, 0.5); }
    .shift-indicator.night { background-color: #6366f1; box-shadow: 0 0 10px rgba(99, 102, 241, 0.5); }
    .shift-indicator.hall { background-color: #10b981; box-shadow: 0 0 10px rgba(16, 185, 129, 0.5); }

    .btn-icon-sm {
        width: 32px;
        height: 32px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #94a3b8;
        transition: all 0.2s;
        border: 1px solid transparent;
    }

    .btn-icon-sm:hover {
        background: #f1f5f9;
        color: #3b82f6;
        border-color: #e2e8f0;
    }

    .detail-box {
        background: #f8fafc;
        padding: 0.75rem 1rem;
        border-radius: 12px;
        border: 1px solid #e2e8f0;
    }

    .detail-box label {
        display: block;
        font-size: 0.65rem;
        font-weight: 800;
        color: #94a3b8;
        text-transform: uppercase;
        margin-bottom: 0.25rem;
    }

    .detail-box div {
        font-weight: 700;
        color: #1e293b;
    }

    .accent-success { border-left: 4px solid #10b981; background: rgba(16, 185, 129, 0.05); }

    .loader-ring {
        width: 48px;
        height: 48px;
        border: 4px solid #e2e8f0;
        border-top-color: var(--accent-primary);
        border-radius: 50%;
        animation: spin 1s linear infinite;
    }

    @@keyframes spin { to { transform: rotate(360deg); } }
    
    .animate-slide-up {
        animation: slide-up 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    @@keyframes slide-up {
        from { transform: translateY(20px); opacity: 0; }
        to { transform: translateY(0); opacity: 1; }
    }
</style>

@code {
    private DateTime _startDate = DateTime.Today.AddDays(-30);
    private DateTime _endDate = DateTime.Today;

    private bool _loading = true;
    private string _statusMessage = "Initializing...";
    private string? _errorMessage;
    private List<DailySalesReportDto> _days = new();
    private List<string> _debugLogs = new();
    private ShiftReportDto? _selectedShift;

    protected override async Task OnInitializedAsync()
    {
        Log("Page Initialized");
        await RefreshData();
    }

    private void Log(string message)
    {
        _debugLogs.Insert(0, message);
        StateHasChanged();
    }

    private async Task RefreshData()
    {
        _loading = true;
        _errorMessage = null;
        _statusMessage = "Connecting to Financial Server...";
        Log("Starting RefreshData...");
        StateHasChanged();

        try
        {
            Log($"Requesting data range: {_startDate:yyyy-MM-dd} to {_endDate:yyyy-MM-dd}");
            _statusMessage = "Analyzing Bar and Lottery Records...";
            StateHasChanged();
            
            var result = await FinancialService.GetDailySalesReportsAsync(_startDate, _endDate);
            _days = result.Data;
            
            Log($"DB Identity -> {result.Server} | {result.Database}");
            if (result.Error != "None")
            {
                Log($"SERVER ERROR: {result.Error}");
            }
            Log($"Total in DB -> Bar: {result.TotalBar}, Lotto: {result.TotalLotto}");
            Log($"Range Filter -> Found {_days.Count} day groups.");


            
            if (_days.Count > 0)
            {
                var totalShifts = _days.Sum(d => d.Shifts.Count);
                Log($"Success: Found {totalShifts} shifts across {_days.Count} days.");
            }
            else
            {
                Log("Warning: No records found for this SPECIFIC range.");
            }

        }
        catch (Exception ex)
        {
            Log($"CRITICAL ERROR: {ex.Message}");
            _errorMessage = ex.Message;
            _statusMessage = "An error occurred. Please try again.";
        }
        finally
        {
            _loading = false;
            Log("Process complete.");
            StateHasChanged();
        }
    }



    private void ShowShiftDetail(ShiftReportDto shift)
    {
        _selectedShift = shift;
    }

    private void GoToEdit(ShiftReportDto shift)
    {
        // Navigate to the end-of-shift page with the correct date and shift context
        // This assumes the end-of-shift page can handle parameters or we just navigate there
        JS.InvokeVoidAsync("location.assign", $"/operations/end-of-shift?date={shift.CreatedAt:yyyy-MM-dd}&shift={shift.ShiftType}");
    }

    private async Task ExportToExcel()
    {
        // Placeholder for export functionality
        await JS.InvokeVoidAsync("alert", "Exporting " + _days.Count + " days of data to Excel...");
    }
}
