@page "/finance/overview"
@using GFC.BlazorServer.Services
@using GFC.Core.Models
@inject IFinancialAnalyticsService FinancialService
@inject NavigationManager Navigation
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

<PageTitle>Financial Overview | GFC</PageTitle>

<div class="overview-container">
    <div class="overview-header no-print">
        <div class="d-flex justify-content-between align-items-end mb-0">
            <div>
                <h1 class="h2 fw-bold mb-1 text-dark presentation-title">Financial Report</h1>
                <p class="text-muted mb-0">
                    @(SelectedMonth == 0 ? $"Annual Summary for {SelectedYear}" : $"{GetMonthName(SelectedMonth)} {SelectedYear} Overview")
                </p>
            </div>
            <div class="d-flex gap-2 align-items-center">
                <div class="control-group">
                    <label class="control-label">Period</label>
                    <div class="d-flex gap-1">
                        <select class="form-select form-select-sm month-select" @bind="SelectedMonth" @bind:after="LoadOverview">
                            <option value="0">Full Year</option>
                            @for (int i = 1; i <= 12; i++)
                            {
                                <option value="@i">@GetMonthName(i)</option>
                            }
                        </select>
                        <select class="form-select form-select-sm year-select" @bind="SelectedYear" @bind:after="LoadOverview">
                            @foreach (var year in _availableYears)
                            {
                                <option value="@year">@year</option>
                            }
                        </select>
                    </div>
                </div>
                <button class="btn btn-sm btn-dark print-btn ms-2" @onclick="PrintOverview">
                    <i class="bi bi-printer me-1"></i> Board Copy
                </button>
            </div>
        </div>
    </div>

    <!-- Print Header (Only visible when printing) -->
    <div class="print-header only-print mb-4">
        <div class="d-flex justify-content-between align-items-center">
            <div class="club-branding">
                <h1 class="mb-0">GLOUCESTER FRATERNITY CLUB</h1>
                <p class="mb-0">Financial Board Report</p>
            </div>
            <div class="report-meta text-end">
                <h2 class="mb-0">@(SelectedMonth == 0 ? "Annual Report" : GetMonthName(SelectedMonth)) @SelectedYear</h2>
                <p class="mb-0">Generated on @DateTime.Now.ToString("MMMM dd, yyyy")</p>
            </div>
        </div>
        <hr />
    </div>

    @if (_isLoading)
    {
        <div class="d-flex flex-column justify-content-center align-items-center" style="height: 400px;">
            <div class="spinner-grow text-primary mb-3" role="status"></div>
            <span class="text-muted fw-500">Preparing financial data...</span>
        </div>
    }
    else if (_overview != null)
    {
        <!-- Summary Cards -->
        <div class="row g-4 mb-5">
            <div class="col-md-4">
                <div class="summary-premium-card income">
                    <div class="card-glow"></div>
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <span class="label">Total Income</span>
                        <div class="status-pill"><i class="bi bi-graph-up-arrow"></i></div>
                    </div>
                    <h2 class="value">@_overview.TotalIncome.ToString("C0")</h2>
                    <p class="description">All revenue streams consolidated</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="summary-premium-card expense">
                    <div class="card-glow"></div>
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <span class="label">Operating Expenses</span>
                        <div class="status-pill"><i class="bi bi-calculator"></i></div>
                    </div>
                    <h2 class="value">@_overview.TotalExpenses.ToString("C0")</h2>
                    <p class="description">Payroll, taxes, and reimbursements</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="summary-premium-card @(_overview.NetProfit >= 0 ? "profit" : "loss")">
                    <div class="card-glow"></div>
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <span class="label">Net Performance</span>
                        <div class="status-pill"><i class="bi bi-pie-chart-fill"></i></div>
                    </div>
                    <h2 class="value">@_overview.NetProfit.ToString("C0")</h2>
                    <p class="description">Bottom-line net position</p>
                </div>
            </div>
        </div>

        <div class="row g-5">
            <!-- Income Section -->
            <div class="col-lg-6">
                <div class="section-title-premium mb-4">
                    <div class="icon-box bg-success-soft"><i class="bi bi-bank2"></i></div>
                    <div>
                        <h3 class="h5 mb-0 fw-bold">Revenue Breakdown</h3>
                        <p class="text-muted small mb-0">Detailed list of all income sources</p>
                    </div>
                </div>
                
                <div class="revenue-list">
                    <div class="revenue-item shadow-sm">
                        <div class="item-icon bg-success-subtle text-success"><i class="bi bi-shop"></i></div>
                        <div class="item-details">
                            <span class="item-name">Downstairs Bar</span>
                            <span class="item-desc">Core Operations & Register Sales</span>
                        </div>
                        <div class="item-value">@_overview.BarSalesDownstairs.ToString("C0")</div>
                    </div>

                    <div class="revenue-item shadow-sm">
                        <div class="item-icon bg-info-subtle text-info"><i class="bi bi-building-up"></i></div>
                        <div class="item-details">
                            <span class="item-name">Upstairs Bar</span>
                            <span class="item-desc">Private Events & Hall Sales</span>
                        </div>
                        <div class="item-value">@_overview.BarSalesUpstairs.ToString("C0")</div>
                    </div>

                    <div class="revenue-item shadow-sm">
                        <div class="item-icon bg-purple-subtle text-purple"><i class="bi bi-person-check"></i></div>
                        <div class="item-details">
                            <span class="item-name">Membership Dues</span>
                            <span class="item-desc">Annual Member Assessment Fees</span>
                        </div>
                        <div class="item-value">@_overview.MembershipDues.ToString("C0")</div>
                    </div>

                    <div class="revenue-item shadow-sm">
                        <div class="item-icon bg-orange-subtle text-orange"><i class="bi bi-calendar-event"></i></div>
                        <div class="item-details">
                            <span class="item-name">Hall Rentals</span>
                            <span class="item-desc">Facility Usage & Reservation Fees</span>
                        </div>
                        <div class="item-value">@_overview.HallRentals.ToString("C0")</div>
                    </div>

                    <div class="total-bar success mt-3">
                        <span class="total-label">Total Period Income</span>
                        <span class="total-amount">@_overview.TotalIncome.ToString("C0")</span>
                    </div>
                </div>
            </div>

            <!-- Expense Section -->
            <div class="col-lg-6">
                <div class="section-title-premium mb-4">
                    <div class="icon-box bg-danger-soft"><i class="bi bi-wallet2"></i></div>
                    <div>
                        <h3 class="h5 mb-0 fw-bold">Expense Breakdown</h3>
                        <p class="text-muted small mb-0">Personnel and operational obligations</p>
                    </div>
                </div>
                
                <div class="revenue-list">
                    <div class="revenue-item shadow-sm">
                        <div class="item-icon bg-danger-subtle text-danger"><i class="bi bi-people-fill"></i></div>
                        <div class="item-details">
                            <span class="item-name">Payroll Expenses</span>
                            <span class="item-desc">Gross Wages, FICA, MA PFML & Unemployment</span>
                        </div>
                        <div class="item-value">@((_overview.GrossPayroll + _overview.EmployerFica + _overview.EmployerPfml + _overview.MaUnemployment).ToString("C0"))</div>
                    </div>

                    <div class="revenue-item shadow-sm">
                        <div class="item-icon bg-warning-subtle text-dark"><i class="bi bi-receipt"></i></div>
                        <div class="item-details">
                            <span class="item-name">Operational Reimbursements</span>
                            <span class="item-desc">Paid Out Petty Cash & Supplies</span>
                        </div>
                        <div class="item-value">@_overview.Reimbursements.ToString("C0")</div>
                    </div>

                    <div class="total-bar danger mt-3">
                        <span class="total-label">Total Period Expenses</span>
                        <span class="total-amount">@_overview.TotalExpenses.ToString("C0")</span>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<style>
    :root {
        --gfc-primary: #0f172a;
        --gfc-success: #10b981;
        --gfc-danger: #ef4444;
        --gfc-accent: #6366f1;
        --card-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.05), 0 4px 6px -2px rgba(0, 0, 0, 0.02);
    }

    .overview-container {
        padding: 2.5rem;
        background: #fdfdfd;
        min-height: calc(100vh - 65px);
        font-family: 'Inter', -apple-system, sans-serif;
    }

    .presentation-title {
        letter-spacing: -0.02em;
        color: var(--gfc-primary);
    }

    .control-group {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
    }

    .control-label {
        font-size: 0.7rem;
        font-weight: 700;
        text-transform: uppercase;
        color: #94a3b8;
        letter-spacing: 0.05em;
    }

    .month-select, .year-select {
        border-radius: 10px;
        font-weight: 600;
        padding: 0.5rem 1rem;
        border: 1px solid #e2e8f0;
        background-color: white;
    }

    .month-select { width: 140px; }
    .year-select { width: 100px; }

    /* Summary Premium Cards */
    .summary-premium-card {
        position: relative;
        padding: 1.75rem;
        border-radius: 24px;
        background: white;
        border: 1px solid #f1f5f9;
        box-shadow: var(--card-shadow);
        overflow: hidden;
        transition: all 0.3s ease;
    }

    .summary-premium-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.08);
    }

    .card-glow {
        position: absolute;
        top: 0; right: 0;
        width: 100px; height: 100px;
        background: radial-gradient(circle, rgba(255,255,255,0.8) 0%, rgba(255,255,255,0) 70%);
        opacity: 0.5;
    }

    .summary-premium-card.income { border-left: 6px solid var(--gfc-success); }
    .summary-premium-card.expense { border-left: 6px solid var(--gfc-danger); }
    .summary-premium-card.profit { border-left: 6px solid var(--gfc-accent); }
    .summary-premium-card.loss { border-left: 6px solid #f59e0b; }

    .summary-premium-card .label {
        font-size: 0.8rem;
        font-weight: 700;
        text-transform: uppercase;
        color: #64748b;
        letter-spacing: 0.05em;
    }

    .summary-premium-card .value {
        font-size: 2.25rem;
        font-weight: 800;
        margin: 0.5rem 0;
        color: var(--gfc-primary);
    }

    .summary-premium-card .description {
        font-size: 0.85rem;
        color: #94a3b8;
        margin-bottom: 0;
    }

    .status-pill {
        background: #f8fafc;
        width: 32px; height: 32px;
        border-radius: 100%;
        display: flex;
        align-items: center; justify-content: center;
        color: #64748b;
    }

    /* Section Headers */
    .section-title-premium {
        display: flex;
        align-items: center;
        gap: 1rem;
    }

    .icon-box {
        width: 48px; height: 48px;
        border-radius: 14px;
        display: flex;
        align-items: center; justify-content: center;
        font-size: 1.25rem;
    }

    .bg-success-soft { background: #ecfdf5; color: #059669; }
    .bg-danger-soft { background: #fef2f2; color: #dc2626; }

    /* Revenue/Expense Items */
    .revenue-list {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .revenue-item {
        display: flex;
        align-items: center;
        padding: 1rem 1.25rem;
        background: white;
        border-radius: 18px;
        border: 1px solid #f8fafc;
    }

    .item-icon {
        width: 42px; height: 42px;
        border-radius: 12px;
        display: flex;
        align-items: center; justify-content: center;
        margin-right: 1.25rem;
        font-size: 1.1rem;
    }

    .item-details {
        flex: 1;
        display: flex;
        flex-direction: column;
    }

    .item-name {
        font-weight: 700;
        color: var(--gfc-primary);
        font-size: 0.95rem;
    }

    .item-desc {
        font-size: 0.75rem;
        color: #94a3b8;
    }

    .item-value {
        font-weight: 800;
        color: var(--gfc-primary);
        font-size: 1.1rem;
    }

    /* Total Bar */
    .total-bar {
        padding: 1.25rem;
        border-radius: 18px;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .total-bar.success { background: #065f46; color: white; }
    .total-bar.danger { background: #991b1b; color: white; }

    .total-label { font-weight: 600; font-size: 0.9rem; text-transform: uppercase; letter-spacing: 0.05em; }
    .total-amount { font-weight: 800; font-size: 1.25rem; }

    /* Printing */
    .only-print { display: none; }

    @@media print {
        .overview-container { padding: 0; background: white; width: 100%; }
        .no-print { display: none !important; }
        .only-print { display: block !important; }
        .summary-premium-card { box-shadow: none !important; border: 1px solid #eee !important; page-break-inside: avoid; }
        .revenue-item { box-shadow: none !important; border: 1px solid #eee !important; page-break-inside: avoid; }
        .total-bar { border: 1px solid #000 !important; }
        .total-bar.success, .total-bar.danger { color: black !important; background: #f8fafc !important; }
        body { background: white; }
    }

    .fw-500 { font-weight: 500; }
    .bg-purple-subtle { background: #f3e8ff; }
    .text-purple { color: #7e22ce; }
    .bg-orange-subtle { background: #fff7ed; }
    .text-orange { color: #c2410c; }
</style>

@code {
    private int SelectedYear { get; set; } = DateTime.Now.Year;
    private int SelectedMonth { get; set; } = DateTime.Now.Month;
    private List<int> _availableYears = new();
    private FinancialSnapshotDto? _overview;
    private bool _isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        _availableYears = await FinancialService.GetAvailableYearsAsync();
        if (!_availableYears.Contains(DateTime.Now.Year)) _availableYears.Insert(0, DateTime.Now.Year);
        _availableYears = _availableYears.OrderByDescending(y => y).ToList();
        
        await LoadOverview();
    }

    private async Task LoadOverview()
    {
        _isLoading = true;
        // If SelectedMonth is 0, we fetch for the year, otherwise for the month
        _overview = await FinancialService.GetFinancialSnapshotAsync(SelectedYear, SelectedMonth == 0 ? null : SelectedMonth);
        _isLoading = false;
    }

    private string GetMonthName(int month) => System.Globalization.DateTimeFormatInfo.CurrentInfo.GetMonthName(month);

    private async Task PrintOverview()
    {
        await Microsoft.JSInterop.JSRuntimeExtensions.InvokeVoidAsync(null, "window.print");
    }
}
