@page "/finance/bar-sales"
@using Microsoft.AspNetCore.Authorization
@using GFC.BlazorServer.Services
@using GFC.Core.Models
@using GFC.Core.DTOs
@inject IFinancialAnalyticsService FinancialService
@inject IJSRuntime JS
@inject AuthenticationStateProvider AuthStateProvider
@inject IUserManagementService UserService
@inject NavigationManager Navigation
@attribute [Authorize]

<PageTitle>Downstairs Bar Sales | GFC Finance</PageTitle>

<div class="glass-page-container">
    <div class="page-content-wrapper">
        
        <!-- HEADER SECTION -->
        <header class="entries-header mb-4">
            <div class="header-glass py-3 px-4 shadow-sm border-bottom">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                    <div class="d-flex align-items-center gap-3">
                        <div class="header-icon-box bg-primary bg-opacity-10 text-primary rounded-4 p-2">
                            <i class="bi bi-cup-straw fs-4"></i>
                        </div>
                        <div>
                            <h1 class="h3 fw-black text-dark mb-0">BAR SALES</h1>
                            <p class="text-muted x-small uppercase-tracking mb-0">Profit & Labor Analytics</p>
                        </div>
                    </div>

                    <div class="d-flex flex-column align-items-end gap-3">
                        <div class="d-flex gap-2">
                            <div class="location-toggle-group bg-light rounded-pill p-1 border shadow-sm">
                                <button class="btn @(_selectedLocation == "Downstairs" ? "btn-primary" : "btn-link text-muted text-decoration-none") btn-sm rounded-pill px-3 fw-bold" @onclick='() => _selectedLocation = "Downstairs"'>Downstairs</button>
                                <button class="btn @(_selectedLocation == "Upstairs" ? "btn-primary" : "btn-link text-muted text-decoration-none") btn-sm rounded-pill px-3 fw-bold" @onclick='() => _selectedLocation = "Upstairs"'>Upstairs</button>
                                <button class="btn @(_selectedLocation == "Both" ? "btn-primary" : "btn-link text-muted text-decoration-none") btn-sm rounded-pill px-3 fw-bold" @onclick='() => _selectedLocation = "Both"'>Both Combined</button>
                            </div>
                        </div>
                        
                        <div class="d-flex gap-2">
                            <button class="btn @(_showDetails ? "btn-outline-primary" : "btn-primary") btn-sm rounded-pill px-3 shadow-sm" @onclick="() => _showDetails = !_showDetails">
                                <i class="bi @(_showDetails ? "bi-list-ul" : "bi-distribute-vertical") me-1"></i>
                                <span>@(_showDetails ? "Summary View" : "Show Shifts")</span>
                            </button>
                            <button class="btn btn-outline-dark btn-sm rounded-pill px-3 shadow-sm" @onclick="PrintReport">
                                <i class="bi bi-printer me-1"></i> Print
                            </button>
                        </div>

                        <div class="d-flex gap-2">
                            <div class="month-selector-group bg-white rounded-pill p-1 border shadow-sm d-flex align-items-center">
                                <select class="form-select form-select-sm border-0 bg-transparent fw-bold" 
                                        @bind="_selectedMonth" @bind:after="OnMonthYearChanged" style="width: 120px;">
                                    <option value="1">January</option>
                                    <option value="2">February</option>
                                    <option value="3">March</option>
                                    <option value="4">April</option>
                                    <option value="5">May</option>
                                    <option value="6">June</option>
                                    <option value="7">July</option>
                                    <option value="8">August</option>
                                    <option value="9">September</option>
                                    <option value="10">October</option>
                                    <option value="11">November</option>
                                    <option value="12">December</option>
                                </select>
                                <select class="form-select form-select-sm border-0 bg-transparent fw-bold" 
                                        @bind="_selectedYear" @bind:after="OnMonthYearChanged" style="width: 100px;">
                                    @for (int y = DateTime.Today.Year; y >= 2024; y--)
                                    {
                                        <option value="@y">@y</option>
                                    }
                                </select>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </header>

        @if (_loading)
        {
            <div class="d-flex flex-column align-items-center justify-content-center py-5">
                <div class="loader-ring mb-3"></div>
                <span class="text-muted fw-bold uppercase-tracking">@_statusMessage</span>
            </div>
        }
        else if (_days.Count == 0)
        {
            <div class="text-center py-5 mt-4 glass-card p-5 border-0">
                <div class="mb-3">
                    <i class="bi bi-calendar-x fs-1 text-muted"></i>
                </div>
                <h3 class="fw-bold text-dark">No Bar Sales Found</h3>
                <p class="text-muted">No downstairs bar sales were found for the selected date range.</p>
                <button class="btn btn-success rounded-pill px-4 mt-2" @onclick="() => { _startDate = DateTime.Today.AddDays(-7); _endDate = DateTime.Today; RefreshData(); }">
                    View Last 7 Days
                </button>
            </div>
        }
        else
        {
            @if (_days.Count > 0)
        {
            <div class="summary-card glass-card p-4 mb-4 border-0 shadow-sm animate-slide-up">
                @{
                    var filteredShiftsAll = _days.SelectMany(d => d.Shifts).Where(s => 
                        _selectedLocation == "Both" || 
                        (_selectedLocation == "Upstairs" && s.IsRentalHall) || 
                        (_selectedLocation == "Downstairs" && !s.IsRentalHall)
                    ).ToList();

                    // Upstairs/Hall shifts don't have labor cost tracking in this view
                    var periodTotalSales = filteredShiftsAll.Sum(s => s.BarSales);
                    var periodTotalLabor = filteredShiftsAll.Sum(s => s.IsRentalHall ? 0m : (s.TotalHours ?? 0) * (s.HourlyRate ?? 0));
                    var periodTotalProfit = periodTotalSales - periodTotalLabor;
                    var periodLaborPercent = periodTotalSales > 0 ? (periodTotalLabor / periodTotalSales) * 100 : 0;
                }
                <div class="row align-items-center">
                    <div class="col-md-3 border-end">
                        <div class="text-muted x-small uppercase-tracking fw-bold mb-1">Period Total Sales</div>
                        <div class="h3 fw-black text-dark mb-0">@periodTotalSales.ToString("C2")</div>
                    </div>
                    <div class="col-md-3 border-end ps-md-4">
                        <div class="text-muted x-small uppercase-tracking fw-bold mb-1">Period Labor Cost</div>
                        <div class="h3 fw-bold text-dark mb-0">@periodTotalLabor.ToString("C2")</div>
                    </div>
                    <div class="col-md-3 border-end ps-md-4">
                        <div class="text-muted x-small uppercase-tracking fw-bold mb-1 text-success">Period Net Profit</div>
                        <div class="h2 fw-black text-success mb-0">@periodTotalProfit.ToString("C2")</div>
                    </div>
                    <div class="col-md-3 ps-md-4">
                        <div class="text-muted x-small uppercase-tracking fw-bold">Period Labor %</div>
                        <div class="h3 fw-black @(periodLaborPercent > 35 ? "text-danger" : "text-dark") mb-0">@periodLaborPercent.ToString("N1")%</div>
                    </div>
                </div>
            </div>
        }

        <div class="entries-list d-flex flex-column gap-3">
                @foreach (var day in _days)
                {
                    var filteredShifts = day.Shifts.Where(s => 
                        _selectedLocation == "Both" || 
                        (_selectedLocation == "Upstairs" && s.IsRentalHall) || 
                        (_selectedLocation == "Downstairs" && !s.IsRentalHall)
                    ).ToList();

                    if (!filteredShifts.Any()) continue;

                    var dayTotal = filteredShifts.Sum(s => s.BarSales);

                    <div class="day-group-card animate-slide-up @(!_showDetails ? "compact-item" : "")">
                        <div class="day-header py-2 px-4 d-flex justify-content-between align-items-center border-0">
                            <div class="d-flex align-items-center gap-3">
                                <span class="calendar-icon-mini position-relative">
                                    <span class="month">@day.Date.ToString("MMM")</span>
                                    <span class="day">@day.Date.ToString("dd")</span>
                                </span>
                                <div>
                                    <h4 class="mb-0 fw-black text-dark fs-5">@day.Date.ToString("dddd, MMMM d, yyyy")</h4>
                                </div>
                            </div>
                            <div class="d-flex align-items-center gap-4">
                                <div class="text-end">
                                    <div class="text-muted x-small uppercase-tracking fw-bold">Daily Sales Total</div>
                                    <div class="fw-bold text-dark fs-5">
                                        @dayTotal.ToString("C2")
                                    </div>
                                </div>
                                <div class="text-end border-start ps-4">
                                    @{
                                        var dayLaborCost = filteredShifts.Sum(s => s.IsRentalHall ? 0m : (s.TotalHours ?? 0) * (s.HourlyRate ?? 0));
                                        var dayProfit = dayTotal - dayLaborCost;
                                        var dayLaborPct = dayTotal > 0 ? (dayLaborCost / dayTotal) * 100 : 0;
                                    }
                                    <div class="text-muted x-small uppercase-tracking fw-bold text-success">Net Profit (After Labor)</div>
                                    <div class="fw-black text-success fs-4">
                                        @dayProfit.ToString("C2")
                                    </div>
                                </div>
                                <div class="text-end border-start ps-4">
                                    <div class="text-muted x-small uppercase-tracking fw-bold">Labor Cost %</div>
                                    <div class="fw-bold @(dayLaborPct > 35 ? "text-danger" : "text-dark") fs-5">
                                        @dayLaborPct.ToString("N1")%
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                        @if (_showDetails)
                        {
                            <div class="day-body p-0 border-top">
                                <div class="table-responsive">
                                <table class="table table-hover mb-0 align-middle custom-table">
                                    <thead>
                                        <tr>
                                            <th class="ps-4">SHIFT TYPE / AREA</th>
                                            <th class="text-center">BARTENDER</th>
                                            <th class="text-center">HOURS WORKED</th>
                                            <th class="text-end">BAR REVENUE</th>
                                            <th class="text-end">NET PROFIT</th>
                                            <th class="text-end pe-5">LABOR %</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var shift in filteredShifts)
                                        {
                                            var laborCost = shift.IsRentalHall ? 0m : (shift.TotalHours ?? 0) * (shift.HourlyRate ?? 0);
                                            var netProfit = shift.BarSales - laborCost;
                                            var laborWaitPercentage = shift.BarSales > 0 ? (laborCost / shift.BarSales) * 100 : 0;

                                            <tr>
                                                <td class="ps-4">
                                                    <div class="d-flex align-items-center gap-2">
                                                        <span class="shift-indicator @(shift.IsRentalHall ? "hall" : shift.ShiftType?.ToLower())"></span>
                                                        <div class="fw-bold text-dark">@(shift.IsRentalHall ? "UPSTAIRS HALL" : $"{shift.ShiftType?.ToUpper()} SHIFT")</div>
                                                        @if (!string.IsNullOrWhiteSpace(shift.Notes))
                                                        {
                                                            <i class="bi bi-chat-right-text text-muted ms-1" title="@shift.Notes"></i>
                                                        }
                                                    </div>
                                                    <div class="x-small text-muted">@shift.CreatedAt.ToLocalTime().ToString("t")</div>
                                                </td>
                                                <td class="text-center fw-bold">@shift.CreatedBy</td>
                                                <td class="text-center text-muted">
                                                    @if (!shift.IsRentalHall)
                                                    {
                                                        <div>@(shift.TotalHours?.ToString("N2") ?? "0.00") hrs</div>
                                                        @if (shift.HourlyRate.HasValue)
                                                        {
                                                            <div class="x-small text-muted">@@ @shift.HourlyRate.Value.ToString("C2")/hr</div>
                                                        }
                                                    }
                                                    else
                                                    {
                                                        <span class="opacity-50">-</span>
                                                    }
                                                </td>
                                                <td class="text-end fw-bold text-dark">@shift.BarSales.ToString("C2")</td>
                                                <td class="text-end fw-bold text-success">@netProfit.ToString("C2")</td>
                                                <td class="text-end pe-5 fw-black @(laborWaitPercentage > 30 ? "text-danger" : "text-muted")">
                                                    @laborWaitPercentage.ToString("N1")%
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                        }
                    </div>
                }
            </div>
        }
    </div>
</div>

<style>
    .glass-page-container {
        min-height: 100vh;
        background: radial-gradient(circle at top right, #f8fafc, #f0fdf4);
        padding: 2rem;
        font-family: 'Inter', sans-serif;
    }

    .page-content-wrapper {
        max-width: 1000px;
        margin: 0 auto;
    }

    .header-glass {
        background: rgba(255, 255, 255, 0.7);
        backdrop-filter: blur(10px);
        border-radius: 20px;
        border: 1px solid rgba(255, 255, 255, 0.8);
    }

    .header-icon-box {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 50px;
        height: 50px;
    }

    .fw-black { font-weight: 900; }
    .uppercase-tracking { text-transform: uppercase; letter-spacing: 0.1em; }
    .x-small { font-size: 0.7rem; }

    .day-group-card {
        background: white;
        border-radius: 24px;
        box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.05);
        overflow: hidden;
        border: 1px solid #f1f5f9;
        transition: transform 0.3s ease;
    }

    .day-header {
        background: #f8fafc;
        border-bottom: 1px solid #f1f5f9;
    }

    .calendar-icon-mini {
        width: 48px;
        height: 48px;
        background: white;
        border-radius: 12px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        border: 1px solid #e2e8f0;
        box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);
    }

    .calendar-icon-mini .month {
        font-size: 0.6rem;
        font-weight: 800;
        text-transform: uppercase;
        color: #10b981;
        line-height: 1;
    }

    .calendar-icon-mini .day {
        font-size: 1.25rem;
        font-weight: 900;
        color: #1e293b;
        line-height: 1;
    }

    .day-group-card.compact-item {
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
        margin-bottom: 0.5rem;
    }

    .day-group-card.compact-item .day-header {
        padding: 0.75rem 1rem !important;
    }

    .day-group-card.compact-item .calendar-icon-mini {
        width: 40px;
        height: 40px;
    }

    .day-group-card.compact-item .calendar-icon-mini .day {
        font-size: 1rem;
    }

    .day-group-card.compact-item .fw-black.text-success {
        font-size: 1.25rem !important;
    }

    .date-filter-group, .month-selector-group {
        height: 38px;
        transition: all 0.2s ease;
    }
    
    .date-filter-group:hover, .month-selector-group:hover {
        border-color: #10b981 !important;
        box-shadow: 0 4px 12px rgba(16, 185, 129, 0.15) !important;
    }

    .custom-table th {
        font-size: 0.75rem;
        font-weight: 800;
        color: #94a3b8;
        text-transform: uppercase;
        padding: 1.25rem 1rem;
        border-bottom: 2px solid #f1f5f9;
        background: white;
    }

    .custom-table td {
        padding: 1.25rem 1rem;
        color: #475569;
        font-size: 0.95rem;
        border-bottom: 1px solid #f8fafc;
    }

    .shift-indicator {
        width: 10px;
        height: 10px;
        border-radius: 50%;
    }
    .shift-indicator.day { background-color: #f59e0b; box-shadow: 0 0 10px rgba(245, 158, 11, 0.5); }
    .shift-indicator.night { background-color: #6366f1; box-shadow: 0 0 10px rgba(99, 102, 241, 0.5); }

    .loader-ring {
        width: 48px;
        height: 48px;
        border: 4px solid #e2e8f0;
        border-top-color: #10b981;
        border-radius: 50%;
        animation: spin 1s linear infinite;
    }

    @@keyframes spin { to { transform: rotate(360deg); } }
    
    .animate-slide-up {
        animation: slide-up 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    @@keyframes slide-up {
        from { transform: translateY(20px); opacity: 0; }
        to { transform: translateY(0); opacity: 1; }
    }

    @@media print {
        .app-topbar, .app-sidebar, .sidebar, .navbar, .entries-header, .btn, .loader-ring, .sidebar-overlay { 
            display: none !important; 
        }
        
        body, .glass-page-container { 
            background: white !important; 
            padding: 0 !important; 
            margin: 0 !important; 
        }

        .page-content-wrapper { 
            max-width: 100% !important; 
        }

        .summary-card {
            box-shadow: none !important;
            border: 2px solid #e2e8f0 !important;
            margin-bottom: 2rem !important;
            border-radius: 0 !important;
        }

        .summary-card .row {
            display: flex !important;
            flex-direction: row !important;
            flex-wrap: nowrap !important;
        }

        .summary-card .col-md-3 {
            flex: 1 !important;
            width: 25% !important;
            border-right: 1px solid #e2e8f0 !important;
            padding: 0.5rem 1rem !important;
        }

        .summary-card .col-md-3:last-child {
            border-right: none !important;
        }

        .day-group-card { 
            box-shadow: none !important; 
            border: 1px solid #e2e8f0 !important; 
            page-break-inside: avoid !important;
            margin-bottom: 1.5rem !important;
            border-radius: 0 !important;
        }

        .h2, .h3 { font-size: 1.25rem !important; }
    }
</style>

@code {
    private DateTime _startDate = DateTime.Today.AddDays(-30);
    private DateTime _endDate = DateTime.Today;
    private int _selectedMonth = DateTime.Today.Month;
    private int _selectedYear = DateTime.Today.Year;
    private string _selectedLocation = "Downstairs";
    private bool _loading = true;
    private bool _hasAccess = false;
    private bool _showDetails = false;
    private string _statusMessage = "Authenticating...";
    private List<DailySalesReportDto> _days = new();

    private async Task OnMonthYearChanged()
    {
        _startDate = new DateTime(_selectedYear, _selectedMonth, 1);
        _endDate = new DateTime(_selectedYear, _selectedMonth, DateTime.DaysInMonth(_selectedYear, _selectedMonth));
        await RefreshData();
    }

    protected override async Task OnInitializedAsync()
    {
        await CheckPermissions();
        if (_hasAccess)
        {
            await RefreshData();
        }
    }

    private async Task CheckPermissions()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        
        // 1. Admins have absolute access
        if (user.IsInRole("Admin")) { _hasAccess = true; return; }

        // 2. Check granular permission for everyone else
        var userIdClaim = user.FindFirst("UserId") ?? user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier);
        if (userIdClaim != null && int.TryParse(userIdClaim.Value, out int userId))
        {
            var permission = await Task.Run(() => UserService.GetUserPagePermission(userId, "/finance/bar-sales"));
            _hasAccess = permission != null;
        }

        if (!_hasAccess) 
        {
            _statusMessage = "Access Denied. Please contact an administrator.";
            _loading = false;
        }
    }

    private async Task RefreshData()
    {
        if (!_hasAccess) return;
        
        _loading = true;
        _statusMessage = "Analyzing Bar Records...";
        StateHasChanged();

        try
        {
            var result = await FinancialService.GetDailySalesReportsAsync(_startDate, _endDate);
            _days = result.Data;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error fetching bar sales: {ex.Message}");
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private async Task SetDateRange(int days)
    {
        _endDate = DateTime.Today;
        _startDate = DateTime.Today.AddDays(-days);
        await RefreshData();
    }

    private async Task SetThisMonth()
    {
        var today = DateTime.Today;
        _startDate = new DateTime(today.Year, today.Month, 1);
        _endDate = today;
        await RefreshData();
    }

    private async Task SetLastMonth()
    {
        var today = DateTime.Today;
        var lastMonth = today.AddMonths(-1);
        _startDate = new DateTime(lastMonth.Year, lastMonth.Month, 1);
        _endDate = new DateTime(lastMonth.Year, lastMonth.Month, DateTime.DaysInMonth(lastMonth.Year, lastMonth.Month));
        await RefreshData();
    }

    private async Task PrintReport()
    {
        await JS.InvokeVoidAsync("window.print");
    }

    private async Task ExportToExcel()
    {
        await JS.InvokeVoidAsync("alert", "Export function coming soon.");
    }
}
