@page "/finance/bar-sales"
@using Microsoft.AspNetCore.Authorization
@using GFC.BlazorServer.Services
@using GFC.Core.Models
@using GFC.Core.DTOs
@inject IFinancialAnalyticsService FinancialService
@inject IJSRuntime JS
@inject AuthenticationStateProvider AuthStateProvider
@inject IUserManagementService UserService
@inject NavigationManager Navigation
@attribute [Authorize]

<PageTitle>Downstairs Bar Sales | GFC Finance</PageTitle>

<div class="bar-sales-page-container">
    <div class="page-content-wrapper h-100 d-flex flex-column">
        
        <!-- HEADER SECTION (FIXED) -->
        <header class="entries-header mb-2">
            <div class="header-glass py-2 px-4 shadow-sm border-bottom">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <div class="d-flex align-items-center gap-2">
                        <div class="header-icon-box bg-primary bg-opacity-10 text-primary rounded-4 p-2" style="width: 40px; height: 40px;">
                            <i class="bi bi-cup-straw fs-5"></i>
                        </div>
                        <div>
                            <h1 class="h5 fw-black text-dark mb-0">BAR SALES</h1>
                            <p class="text-muted extra-small uppercase-tracking mb-0">Profit & Labor Analytics</p>
                        </div>
                    </div>

                    <div class="d-flex align-items-center gap-3">
                        <div class="location-toggle-group bg-light rounded-pill p-1 border shadow-sm">
                            <button class="btn @(_selectedLocation == "Downstairs" ? "btn-primary shadow-sm" : "btn-link text-muted text-decoration-none") btn-xs rounded-pill px-3 fw-bold" @onclick='() => _selectedLocation = "Downstairs"'>Downstairs</button>
                            <button class="btn @(_selectedLocation == "Upstairs" ? "btn-primary shadow-sm" : "btn-link text-muted text-decoration-none") btn-xs rounded-pill px-3 fw-bold" @onclick='() => _selectedLocation = "Upstairs"'>Upstairs</button>
                        </div>
                        
                        <div class="d-flex gap-2">
                            <button class="btn @(_showDetails ? "btn-outline-primary" : "btn-primary") btn-xs rounded-pill px-3 shadow-sm fw-bold" @onclick="() => _showDetails = !_showDetails">
                                @(_showDetails ? "Summary" : "Details")
                            </button>
                            <button class="btn btn-outline-dark btn-xs rounded-pill px-3 shadow-sm fw-bold" @onclick="PrintReport">
                                <i class="bi bi-printer"></i>
                            </button>
                        </div>

                        <div class="month-selector-group bg-white rounded-pill p-1 border shadow-sm d-flex align-items-center" style="height: 32px;">
                            <select class="form-select form-select-sm border-0 bg-transparent fw-bold py-0" 
                                    @bind="_selectedMonth" @bind:after="OnMonthYearChanged" style="width: 100px; font-size: 0.75rem;">
                                <option value="1">Jan</option>
                                <option value="2">Feb</option>
                                <option value="3">Mar</option>
                                <option value="4">Apr</option>
                                <option value="5">May</option>
                                <option value="6">Jun</option>
                                <option value="7">Jul</option>
                                <option value="8">Aug</option>
                                <option value="9">Sep</option>
                                <option value="10">Oct</option>
                                <option value="11">Nov</option>
                                <option value="12">Dec</option>
                            </select>
                            <select class="form-select form-select-sm border-0 bg-transparent fw-bold py-0 border-start" 
                                    @bind="_selectedYear" @bind:after="OnMonthYearChanged" style="width: 80px; font-size: 0.75rem;">
                                @for (int y = DateTime.Today.Year; y >= 2024; y--)
                                {
                                    <option value="@y">@y</option>
                                }
                            </select>
                        </div>
                    </div>
                </div>
            </div>
        </header>

        @if (_loading)
        {
            <div class="d-flex flex-grow-1 flex-column align-items-center justify-content-center">
                <div class="loader-ring mb-3"></div>
                <span class="text-muted fw-bold uppercase-tracking x-small">@_statusMessage</span>
            </div>
        }
        else if (_days.Count == 0)
        {
            <div class="text-center py-5 flex-grow-1 d-flex flex-column justify-content-center">
                <div class="mb-3"><i class="bi bi-calendar-x fs-1 text-muted"></i></div>
                <h3 class="fw-bold text-dark">No Bar Sales Found</h3>
                <p class="text-muted small">No records found for the selected criteria.</p>
            </div>
        }
        else
        {
            @if (_days.Count > 0)
            {
                <div class="summary-card glass-card p-3 mb-2 border-0 shadow-sm animate-slide-up bg-white">
                    @{
                        var filteredShiftsAll = _days.SelectMany(d => d.Shifts).Where(s => 
                            _selectedLocation == "Both" || 
                            (_selectedLocation == "Upstairs" && s.IsRentalHall) || 
                            (_selectedLocation == "Downstairs" && !s.IsRentalHall)
                        ).ToList();

                        var periodTotalSales = filteredShiftsAll.Sum(s => s.BarSales);
                        var periodTotalLabor = filteredShiftsAll.Sum(s => s.IsRentalHall ? 0m : (s.TotalHours ?? 0) * (s.HourlyRate ?? 0));
                        var periodTotalProfit = periodTotalSales - periodTotalLabor;
                        var periodLaborPercent = periodTotalSales > 0 ? (periodTotalLabor / periodTotalSales) * 100 : 0;
                    }
                    <div class="row align-items-center g-0">
                        <div class="col-md-3 text-center border-end">
                            <div class="text-muted extra-small uppercase-tracking fw-bold mb-0">Total Sales</div>
                            <div class="h5 fw-black text-dark mb-0">@periodTotalSales.ToString("C2")</div>
                        </div>
                        <div class="col-md-3 text-center border-end">
                            <div class="text-muted extra-small uppercase-tracking fw-bold mb-0">Labor Cost</div>
                            <div class="h5 fw-bold text-dark mb-0">@periodTotalLabor.ToString("C2")</div>
                        </div>
                        <div class="col-md-3 text-center border-end">
                            <div class="text-muted extra-small uppercase-tracking fw-bold mb-0 text-success">Net Profit</div>
                            <div class="h5 fw-black text-success mb-0">@periodTotalProfit.ToString("C2")</div>
                        </div>
                        <div class="col-md-3 text-center">
                            <div class="text-muted extra-small uppercase-tracking fw-bold">Labor %</div>
                            <div class="h5 fw-black @(periodLaborPercent > 35 ? "text-danger" : "text-dark") mb-0">@periodLaborPercent.ToString("N1")%</div>
                        </div>
                    </div>
                </div>
            }

            <div class="scrollable-entries-area flex-grow-1 pe-2">
                <div class="entries-list d-flex flex-column gap-2 pb-5">
                    @foreach (var day in _days)
                    {
                        var filteredShifts = day.Shifts.Where(s => 
                            _selectedLocation == "Both" || 
                            (_selectedLocation == "Upstairs" && s.IsRentalHall) || 
                            (_selectedLocation == "Downstairs" && !s.IsRentalHall)
                        ).ToList();

                        if (!filteredShifts.Any()) continue;

                        var dayTotal = filteredShifts.Sum(s => s.BarSales);

                        <div class="day-group-card animate-slide-up @(!_showDetails ? "compact-item" : "")">
                            <div class="day-header py-2 px-3 d-flex justify-content-between align-items-center border-0">
                                <div class="d-flex align-items-center gap-3">
                                    <span class="calendar-icon-mini position-relative" style="width: 36px; height: 36px;">
                                        <span class="month" style="font-size: 0.5rem;">@day.Date.ToString("MMM")</span>
                                        <span class="day" style="font-size: 1rem;">@day.Date.ToString("dd")</span>
                                    </span>
                                    <div>
                                        <h4 class="mb-0 fw-black text-dark" style="font-size: 0.95rem;">@day.Date.ToString("dddd, MMMM d")</h4>
                                    </div>
                                </div>
                                <div class="d-flex align-items-center gap-3">
                                    <div class="text-end">
                                        <div class="text-muted extra-small uppercase-tracking fw-bold">Sales</div>
                                        <div class="fw-bold text-dark small">@dayTotal.ToString("C2")</div>
                                    </div>
                                    <div class="text-end border-start ps-3">
                                        @{
                                            var dayLaborCost = filteredShifts.Sum(s => s.IsRentalHall ? 0m : (s.TotalHours ?? 0) * (s.HourlyRate ?? 0));
                                            var dayProfit = dayTotal - dayLaborCost;
                                            var dayLaborPct = dayTotal > 0 ? (dayLaborCost / dayTotal) * 100 : 0;
                                        }
                                        <div class="text-muted extra-small uppercase-tracking fw-bold text-success">Net Profit</div>
                                        <div class="fw-black text-success small">@dayProfit.ToString("C2")</div>
                                    </div>
                                    <div class="text-end border-start ps-3">
                                        <div class="text-muted extra-small uppercase-tracking fw-bold">Labor %</div>
                                        <div class="fw-bold @(dayLaborPct > 35 ? "text-danger" : "text-dark") small">@dayLaborPct.ToString("N1")%</div>
                                    </div>
                                </div>
                            </div>
                            
                            @if (_showDetails)
                            {
                                <div class="day-body p-0 border-top bg-white">
                                    <div class="table-responsive">
                                        <table class="table table-hover mb-0 align-middle custom-table">
                                            <thead>
                                                <tr>
                                                    <th class="ps-3 py-1 extra-small">SHIFT TYPE</th>
                                                    <th class="text-center py-1 extra-small">BARTENDER</th>
                                                    <th class="text-center py-1 extra-small">HOURS</th>
                                                    <th class="text-end py-1 extra-small">REVENUE</th>
                                                    <th class="text-end py-1 extra-small">PROFIT</th>
                                                    <th class="text-end pe-4 py-1 extra-small">LABOR %</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var shift in filteredShifts)
                                                {
                                                    var laborCost = shift.IsRentalHall ? 0m : (shift.TotalHours ?? 0) * (shift.HourlyRate ?? 0);
                                                    var netProfit = shift.BarSales - laborCost;
                                                    var laborWaitPercentage = shift.BarSales > 0 ? (laborCost / shift.BarSales) * 100 : 0;

                                                    <tr style="font-size: 0.82rem;">
                                                        <td class="ps-3 py-2">
                                                            <div class="d-flex align-items-center gap-2">
                                                                <span class="shift-indicator @(shift.IsRentalHall ? "hall" : shift.ShiftType?.ToLower())"></span>
                                                                <div class="fw-bold">@(shift.IsRentalHall ? "HALL" : shift.ShiftType?.ToUpper())</div>
                                                            </div>
                                                        </td>
                                                        <td class="text-center fw-bold py-2">@shift.CreatedBy</td>
                                                        <td class="text-center text-muted py-2">
                                                            @if (!shift.IsRentalHall) { @(shift.TotalHours?.ToString("N2") ?? "0.00") } else { <span class="opacity-50">-</span> }
                                                        </td>
                                                        <td class="text-end fw-bold py-2">@shift.BarSales.ToString("C2")</td>
                                                        <td class="text-end fw-bold text-success py-2">@netProfit.ToString("C2")</td>
                                                        <td class="text-end pe-4 fw-black py-2 @(laborWaitPercentage > 30 ? "text-danger" : "text-muted")">
                                                            @laborWaitPercentage.ToString("N1")%
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</div>

<style>
    .bar-sales-page-container {
        height: calc(100vh - 95px);
        overflow: hidden;
        background: #f8fafc;
        display: flex;
        flex-direction: column;
        padding: 0 1.5rem 0.5rem 1.5rem;
    }

    .page-content-wrapper {
        max-width: 1000px;
        margin: 0 auto;
        width: 100%;
        display: flex;
        flex-direction: column;
    }

    .scrollable-entries-area {
        overflow-y: auto;
        flex-grow: 1;
        scrollbar-width: thin;
        scrollbar-color: #cbd5e1 transparent;
    }

    .scrollable-entries-area::-webkit-scrollbar { width: 6px; }
    .scrollable-entries-area::-webkit-scrollbar-track { background: transparent; }
    .scrollable-entries-area::-webkit-scrollbar-thumb { background-color: #cbd5e1; border-radius: 20px; }

    .header-glass {
        background: white;
        border-radius: 0 0 20px 20px;
        border: 1px solid #e2e8f0;
    }

    .btn-xs { padding: 4px 10px; font-size: 0.7rem; }
    .extra-small { font-size: 0.65rem; }

    .day-group-card {
        background: white;
        border-radius: 16px;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
        overflow: hidden;
        border: 1px solid #e2e8f0;
    }

    .calendar-icon-mini {
        background: #f1f5f9;
        border-radius: 8px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        border: 1px solid #e2e8f0;
    }

    .day-group-card.compact-item { margin-bottom: 0.25rem; }
    .day-group-card.compact-item .day-header { padding: 0.5rem 1rem !important; }

    .custom-table th {
        font-size: 0.65rem;
        font-weight: 800;
        color: #64748b;
        text-transform: uppercase;
        padding: 4px 12px;
        border-bottom: 1px solid #e2e8f0;
        background: #f8fafc;
        position: sticky;
        top: 0;
        z-index: 5;
    }

    .custom-table td { padding: 8px 12px; }

    .shift-indicator { width: 8px; height: 8px; border-radius: 50%; }
    .animate-slide-up { animation: slide-up 0.4s ease-out forwards; }
    @@keyframes slide-up { from { transform: translateY(10px); opacity: 0; } to { transform: translateY(0); opacity: 1; } }


    @@media print {
        .app-topbar, .app-sidebar, .sidebar, .navbar, .entries-header, .btn, .loader-ring, .sidebar-overlay { 
            display: none !important; 
        }
        
        body, .glass-page-container { 
            background: white !important; 
            padding: 0 !important; 
            margin: 0 !important; 
        }

        .page-content-wrapper { 
            max-width: 100% !important; 
        }

        .summary-card {
            box-shadow: none !important;
            border: 2px solid #e2e8f0 !important;
            margin-bottom: 2rem !important;
            border-radius: 0 !important;
        }

        .summary-card .row {
            display: flex !important;
            flex-direction: row !important;
            flex-wrap: nowrap !important;
        }

        .summary-card .col-md-3 {
            flex: 1 !important;
            width: 25% !important;
            border-right: 1px solid #e2e8f0 !important;
            padding: 0.5rem 1rem !important;
        }

        .summary-card .col-md-3:last-child {
            border-right: none !important;
        }

        .day-group-card { 
            box-shadow: none !important; 
            border: 1px solid #e2e8f0 !important; 
            page-break-inside: avoid !important;
            margin-bottom: 1.5rem !important;
            border-radius: 0 !important;
        }

        .h2, .h3 { font-size: 1.25rem !important; }
    }
</style>

@code {
    private DateTime _startDate = DateTime.Today.AddDays(-30);
    private DateTime _endDate = DateTime.Today;
    private int _selectedMonth = DateTime.Today.Month;
    private int _selectedYear = DateTime.Today.Year;
    private string _selectedLocation = "Downstairs";
    private bool _loading = true;
    private bool _hasAccess = false;
    private bool _showDetails = false;
    private string _statusMessage = "Authenticating...";
    private List<DailySalesReportDto> _days = new();

    private async Task OnMonthYearChanged()
    {
        _startDate = new DateTime(_selectedYear, _selectedMonth, 1);
        _endDate = new DateTime(_selectedYear, _selectedMonth, DateTime.DaysInMonth(_selectedYear, _selectedMonth));
        await RefreshData();
    }

    protected override async Task OnInitializedAsync()
    {
        await CheckPermissions();
        if (_hasAccess)
        {
            await RefreshData();
        }
    }

    private async Task CheckPermissions()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        
        // 1. Admins have absolute access
        if (user.IsInRole("Admin")) { _hasAccess = true; return; }

        // 2. Check granular permission for everyone else
        var userIdClaim = user.FindFirst("UserId") ?? user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier);
        if (userIdClaim != null && int.TryParse(userIdClaim.Value, out int userId))
        {
            var permission = await Task.Run(() => UserService.GetUserPagePermission(userId, "/finance/bar-sales"));
            _hasAccess = permission != null;
        }

        if (!_hasAccess) 
        {
            _statusMessage = "Access Denied. Please contact an administrator.";
            _loading = false;
        }
    }

    private async Task RefreshData()
    {
        if (!_hasAccess) return;
        
        _loading = true;
        _statusMessage = "Analyzing Bar Records...";
        StateHasChanged();

        try
        {
            var result = await FinancialService.GetDailySalesReportsAsync(_startDate, _endDate);
            _days = result.Data;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error fetching bar sales: {ex.Message}");
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private async Task SetDateRange(int days)
    {
        _endDate = DateTime.Today;
        _startDate = DateTime.Today.AddDays(-days);
        await RefreshData();
    }

    private async Task SetThisMonth()
    {
        var today = DateTime.Today;
        _startDate = new DateTime(today.Year, today.Month, 1);
        _endDate = today;
        await RefreshData();
    }

    private async Task SetLastMonth()
    {
        var today = DateTime.Today;
        var lastMonth = today.AddMonths(-1);
        _startDate = new DateTime(lastMonth.Year, lastMonth.Month, 1);
        _endDate = new DateTime(lastMonth.Year, lastMonth.Month, DateTime.DaysInMonth(lastMonth.Year, lastMonth.Month));
        await RefreshData();
    }

    private async Task PrintReport()
    {
        await JS.InvokeVoidAsync("window.print");
    }

    private async Task ExportToExcel()
    {
        await JS.InvokeVoidAsync("alert", "Export function coming soon.");
    }
}
