    private void EditPayment(FinancePayment payment)
    {
        var bill = payment.Bill ?? (payment.BillId.HasValue ? Bills.FirstOrDefault(b => b.Id == payment.BillId.Value) : null);
        var loan = payment.Loan ?? (payment.LoanId.HasValue ? AllLoans.FirstOrDefault(l => l.Id == payment.LoanId.Value) : null);

        EditingPayment = new FinancePayment
        {
            Id = payment.Id,
            BillId = payment.BillId,
            Bill = bill,
            LoanId = payment.LoanId,
            Loan = loan,
            AmountPaid = payment.AmountPaid,
            PaymentDate = payment.PaymentDate,
            PaymentMethod = payment.PaymentMethod,
            Note = payment.Note,
            ProcessedBy = payment.ProcessedBy
        };
        ShowEditPaymentModal = true;
    }

