    private bool IsLoading { get; set; } = true;
    private List<FinanceBill> DisplayUnpaidBills { get; set; } = new();
    private List<FinanceBill> DisplayPaidBills { get; set; } = new();
    private decimal DisplayTotalDue { get; set; }
    private decimal DisplayTotalPaid { get; set; }

    // Logic:
    // 1. Unpaid: All bills in 'Bills' where status is not Paid, filtered by time selection.
    // 2. Paid: All bills in 'Bills' that have a payment in the CURRENT month.
    private void UpdateDisplay()
    {
        var sw = Stopwatch.StartNew();
        var today = DateTime.Today;
        var endOfMonth = new DateTime(CurrentDate.Year, CurrentDate.Month, 1).AddMonths(1).AddDays(-1);

        // Filter for Unpaid column (Left)
        var unpaidQuery = Bills.Where(b => b.Status != "Paid");
        if (!IncludeNextMonth) unpaidQuery = unpaidQuery.Where(b => b.DueDate <= endOfMonth);
        
        if (SelectedTimeFilter == "Upcoming")
        {
            var horizon = DateTime.Today.AddDays(14);
            unpaidQuery = unpaidQuery.Where(b => b.DueDate <= horizon);
        }
        if (BillSortOrder == "Priority")
        {
            DisplayUnpaidBills = unpaidQuery
                .OrderBy(b => b.Vendor != null ? b.Vendor.Priority : 3)
                .ThenBy(b => b.DueDate)
                .ToList();
        }
        else
        {
            DisplayUnpaidBills = unpaidQuery.OrderBy(b => b.DueDate).ToList();
        }

        // Filter for Paid column (Middle) - Optimized to avoid redundant Max() lookups
        DisplayPaidBills = Bills.Select(b => new { Bill = b, LastPaymentDate = b.Payments
                .Where(p => p.PaymentDate.Month == CurrentDate.Month && p.PaymentDate.Year == CurrentDate.Year)
                .Select(p => p.PaymentDate)
                .DefaultIfEmpty(DateTime.MinValue)
                .Max() })
            .Where(x => x.LastPaymentDate > DateTime.MinValue)
            .OrderByDescending(x => x.LastPaymentDate)
            .Select(x => x.Bill)
            .ToList();

        // Totals
        if (IsYearView && CurrentView == "PAYMENTS")
        {
            DisplayTotalDue = Bills.Where(b => b.Status != "Paid").Sum(b => b.BalanceRemaining);
            DisplayTotalPaid = Bills.SelectMany(b => b.Payments).Sum(p => p.AmountPaid);
        }
        else
        {
            DisplayTotalDue = DisplayUnpaidBills.Sum(b => b.BalanceRemaining);
            DisplayTotalPaid = Bills.SelectMany(b => b.Payments)
                .Where(p => p.PaymentDate.Month == CurrentDate.Month && p.PaymentDate.Year == CurrentDate.Year)
                .Sum(p => p.AmountPaid);
        }
        
        sw.Stop();
        Console.WriteLine($"[FINANCE_UI] UpdateDisplay FINISHED in {sw.ElapsedMilliseconds}ms");
    }

