@page "/finance/bills"
@layout GFC.BlazorServer.Components.Layout.FullPageLayout
@using GFC.Core.Interfaces
@using GFC.Core.Models.Finance
@using GFC.BlazorServer.Components.Shared
@using GFC.BlazorServer.Services
@inject IFinanceService FinanceService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Bills & Invoices | GFC Studio</PageTitle>

<link href="css/finance-modern.css?v=@(Revision ?? Guid.NewGuid().ToString())" rel="stylesheet" />

<div class="audit-page-wrapper full-view">
    <!-- Top Bar -->
    <div class="compact-top-bar px-4 py-3 border-bottom d-flex justify-content-between align-items-center bg-white">
        <div class="d-flex align-items-center gap-3">
             <button class="btn btn-link text-dark p-0 me-2" @onclick='() => Navigation.NavigateTo("/")'><i class="bi bi-arrow-left-circle h4 mb-0"></i></button>
             <h1 class="h4 fw-black mb-0 text-uppercase letter-spacing-1">BILLS & INVOICES</h1>
             <div class="badge bg-light text-muted border px-3 py-2 rounded-pill" style="font-size: 0.65rem;">REV @(Revision ?? "2.1.80")</div>
        </div>
        <div class="d-flex gap-3">
             <div class="btn-group p-1 bg-light rounded-pill border me-3 shadow-sm" style="font-size: 0.75rem;">
                <button class="btn btn-sm px-4 rounded-pill fw-black @(CurrentView == "BILLS" ? "btn-primary shadow-sm" : "btn-link text-muted text-decoration-none")" @onclick='() => CurrentView = "BILLS"'>CURRENT BILLS</button>
                <button class="btn btn-sm px-4 rounded-pill fw-black @(CurrentView == "PAYMENTS" ? "btn-primary shadow-sm" : "btn-link text-muted text-decoration-none")" @onclick='() => CurrentView = "PAYMENTS"'>PAYMENT HISTORY</button>
             </div>
             <button class="btn btn-outline-secondary rounded-pill px-4 fw-bold shadow-sm" @onclick="GoToReport" style="font-size: 0.8rem;">VIEW REPORT</button>
             <button class="btn btn-outline-secondary rounded-pill px-4 fw-bold shadow-sm" @onclick="() => ShowManageCategories = true" style="font-size: 0.8rem;">CATEGORIES</button>
             <button class="btn btn-primary rounded-pill px-4 fw-bold shadow-sm" @onclick="OpenAddBillModal" style="font-size: 0.8rem;">NEW BILL</button>
        </div>
    </div>

    <div class="audit-main-content">
        @if (IsLoading)
        {
            <div class="d-flex align-items-center justify-content-center p-2 bg-primary text-white fw-bold w-100" style="position: absolute; z-index: 1000; top: 0; left: 0; font-size: 0.7rem; letter-spacing: 2px;">
                <span class="spinner-border spinner-border-sm me-2"></span> UPDATING BILLS...
            </div>
        }
        <div class="audit-workspace-container">
            @if (CurrentView == "BILLS")
            {
                <!-- COLUMN 1: Bills Due -->
                <div class="audit-list-panel" style="width: 35%; flex: 0 0 35%;">
                    <div class="panel-header">
                        <span>BILLS DUE (UNPAID)</span>
                        <span class="badge bg-danger rounded-pill">@DisplayUnpaidBills.Count()</span>
                    </div>
                    <div class="scroll-container custom-scrollbar px-3 pt-3">
                        @if (!DisplayUnpaidBills.Any())
                        {
                            <div class="p-5 text-center text-muted opacity-50">
                                <i class="bi bi-check-circle h1 mb-3 d-block"></i>
                                <div class="fw-bold text-uppercase letter-spacing-1">NO PENDING BILLS</div>
                            </div>
                        }
                        else
                        {
                            @foreach (var bill in DisplayUnpaidBills)
                            {
                                <div class="bill-row @(bill.IsOverdue ? "overdue" : bill.IsInWarningWindow ? "warning" : "")" @onclick="() => SelectBill(bill)">
                                    <div class="vendor-name">
                                        @bill.Vendor?.Name
                                        @if (bill.IsRecurring) { <i class="bi bi-arrow-repeat text-primary ms-2" style="font-size: 0.9rem;" title="Recurring Bill"></i> }
                                    </div>
                                    <div class="due-info @(bill.IsOverdue ? "text-danger" : "")">
                                        <i class="bi bi-calendar-event me-1"></i> @bill.DueDate.ToString("MM/dd/yy")
                                        @if (bill.Status == "Partial")
                                        {
                                            <div class="progress rounded-0" style="height: 3px; background: transparent;">
                                                @{
                                                    var progress = (double)((bill.OriginalAmount - bill.BalanceRemaining) / bill.OriginalAmount * 100);
                                                }
                                                <div class="progress-bar bg-warning" style="width: @progress%"></div>
                                            </div>
                                        }
                                    </div>
                                    <div class="amount @(bill.IsOverdue ? "text-danger" : "")">
                                        <div class="fw-black">@bill.BalanceRemaining.ToString("C")</div>
                                        @if (bill.Status == "Partial")
                                        {
                                            <div class="text-muted text-uppercase" style="font-size: 0.55rem; font-weight: 800; letter-spacing: 0.5px; white-space: nowrap;">
                                                @bill.Payments.Sum(p => p.AmountPaid).ToString("C") PAID OF @bill.OriginalAmount.ToString("C") | REMAINING @bill.BalanceRemaining.ToString("C")
                                            </div>
                                        }
                                    </div>
                                    <div class="d-flex align-items-center gap-2 justify-content-end">
                                        <span class="status-badge @(bill.Status == "Partial" ? "status-partial" : (bill.IsOverdue ? "status-overdue" : "status-pending"))">@(bill.Status == "Partial" ? "Partial" : (bill.IsOverdue ? "Overdue" : "Pending"))</span>
                                        <button class="btn btn-success compact-btn" @onclick:stopPropagation="true" @onclick="() => MarkAsPaid(bill)">PAY</button>
                                    </div>
                                </div>
                            }
                        }
                    </div>
                </div>

                <!-- COLUMN 2: Bills Paid -->
                <div class="audit-list-panel border-start" style="width: 35%; flex: 0 0 35%;">
                    <div class="panel-header">
                        <span>RECENTLY PAID</span>
                        <span class="badge bg-success rounded-pill">@DisplayPaidBills.Count()</span>
                    </div>
                    <div class="scroll-container custom-scrollbar px-3 pt-3">
                        @if (!DisplayPaidBills.Any())
                        {
                            <div class="p-5 text-center text-muted opacity-50">
                                <i class="bi bi-info-circle h1 mb-3 d-block"></i>
                                <div class="fw-bold text-uppercase letter-spacing-1">NO RECENT PAYMENTS</div>
                            </div>
                        }
                        else
                        {
                            @foreach (var bill in DisplayPaidBills)
                            {
                                <div class="bill-row @(bill.Status == "Paid" ? "paid-record" : "")" @onclick="() => SelectBill(bill)">
                                    <div class="vendor-name d-flex align-items-center gap-3">
                                        @bill.Vendor?.Name
                                        @if (bill.IsRecurring) { <i class="bi bi-arrow-repeat text-success ms-2" style="font-size: 0.9rem;" title="Recurring Bill"></i> }
                                    </div>
                                    @{
                                        var lastPayment = bill.Payments.OrderByDescending(p => p.PaymentDate).FirstOrDefault();
                                    }
                                    <div class="due-info text-success">
                                        <i class="bi bi-check-circle-fill me-1"></i> @lastPayment?.PaymentDate.ToString("MM/dd/yy")
                                    </div>
                                    <div class="amount text-success">@bill.Payments.Sum(p => p.AmountPaid).ToString("C")</div>
                                    <div class="text-end">
                                        <span class="status-badge status-paid">PAID</span>
                                    </div>
                                </div>
                            }
                        }
                    </div>
                </div>
            }
            else
            {
                <!-- MODERN CARD-BASED TRANSACTION LEDGER -->
                <div class="audit-list-panel bg-white p-4" style="width: 70%; flex: 0 0 70%;">
                    <div class="d-flex justify-content-between align-items-center mb-4 px-2">
                        <div class="d-flex align-items-center gap-3">
                            <i class="bi bi-clock-history text-primary h4 mb-0"></i>
                            <h4 class="mb-0 fw-black text-uppercase letter-spacing-2">Financial Ledger</h4>
                        </div>
                        <div class="d-flex gap-2 align-items-center">
                            <span class="badge bg-light text-muted border px-3 py-2 rounded-pill" style="font-size: 0.65rem;">SORTED BY: @SortColumn.ToUpper()</span>
                            <span class="badge bg-primary px-3 py-2 rounded-pill">@Bills.SelectMany(b => b.Payments).Count() TRANSACTIONS</span>
                        </div>
                    </div>

                    <div class="scroll-container custom-scrollbar px-2">
                        @{
                            var allPaymentsQuery = Bills.SelectMany(b => b.Payments.Select(p => new { Bill = b, Payment = p }));
                            
                            if (!IsYearView && CurrentView == "PAYMENTS")
                            {
                                allPaymentsQuery = allPaymentsQuery.Where(x => x.Payment.PaymentDate.Month == CurrentDate.Month && x.Payment.PaymentDate.Year == CurrentDate.Year);
                            }

                            // Apply Sorting
                            allPaymentsQuery = SortColumn switch
                            {
                                "Date" => SortAscending ? allPaymentsQuery.OrderBy(x => x.Payment.PaymentDate) : allPaymentsQuery.OrderByDescending(x => x.Payment.PaymentDate),
                                "Vendor" => SortAscending ? allPaymentsQuery.OrderBy(x => x.Bill.Vendor?.Name) : allPaymentsQuery.OrderByDescending(x => x.Bill.Vendor?.Name),
                                "Category" => SortAscending ? allPaymentsQuery.OrderBy(x => x.Bill.Category?.Name) : allPaymentsQuery.OrderByDescending(x => x.Bill.Category?.Name),
                                "Amount" => SortAscending ? allPaymentsQuery.OrderBy(x => x.Payment.AmountPaid) : allPaymentsQuery.OrderByDescending(x => x.Payment.AmountPaid),
                                _ => allPaymentsQuery.OrderByDescending(x => x.Payment.PaymentDate)
                            };

                            var allPayments = allPaymentsQuery.ToList();

                            if (!allPayments.Any())
                            {
                                <div class="text-center py-5 opacity-50">
                                    <i class="bi bi-archive h1 d-block mb-3"></i>
                                    <div class="italic">No transactions found for this period.</div>
                                </div>
                            }
                            else if (GroupBy != "None")
                            {
                                var groups = GroupBy switch
                                {
                                    "Category" => allPayments.GroupBy(x => x.Bill.Category?.Name ?? "Uncategorized").OrderBy(g => g.Key),
                                    "Vendor" => allPayments.GroupBy(x => x.Bill.Vendor?.Name ?? "Unknown").OrderBy(g => g.Key),
                                    _ => allPayments.GroupBy(x => "All").OrderBy(g => g.Key)
                                };

                                @foreach (var group in groups)
                                {
                                    bool isExpanded = ExpandedGroups.Contains(group.Key);
                                    <div class="history-group-card mb-3 border rounded-4 shadow-sm overflow-hidden @(isExpanded ? "expanded" : "")">
                                        <!-- GROUP HEADER -->
                                        <div class="group-header p-3 d-flex justify-content-between align-items-center bg-light bg-opacity-50" style="cursor: pointer;" @onclick="() => ToggleGroup(group.Key)">
                                            <div class="d-flex align-items-center gap-3">
                                                <i class="bi bi-chevron-@(isExpanded ? "down" : "right") text-primary"></i>
                                                <div>
                                                    <span class="text-muted text-uppercase fw-black" style="font-size: 0.6rem; letter-spacing: 1px;">@GroupBy</span>
                                                    <h6 class="mb-0 fw-black">@group.Key</h6>
                                                </div>
                                            </div>
                                            <div class="text-end">
                                                <div class="text-muted small fw-bold mb-1">@group.Count() TRANSACTIONS</div>
                                                <div class="h5 mb-0 fw-black text-dark">@group.Sum(x => x.Payment.AmountPaid).ToString("C")</div>
                                            </div>
                                        </div>

                                        <!-- GROUP TRANSACTIONS -->
                                        @if (isExpanded)
                                        {
                                            <div class="group-content border-top">
                                                @foreach (var entry in group)
                                                {
                                                    <div class="transaction-item d-flex align-items-center p-3 border-bottom hover-bg-light transition-base">
                                                        <div class="date-block text-center pe-4 border-end" style="width: 80px;">
                                                            <div class="fw-black text-primary" style="font-size: 0.9rem;">@entry.Payment.PaymentDate.ToString("dd")</div>
                                                            <div class="text-muted text-uppercase fw-bold" style="font-size: 0.6rem;">@entry.Payment.PaymentDate.ToString("MMM")</div>
                                                        </div>
                                                        <div class="ps-4 flex-grow-1">
                                                            <div class="fw-black">@entry.Bill.Vendor?.Name</div>
                                                            <div class="small text-muted">@entry.Bill.Description</div>
                                                        </div>
                                                        <div class="px-3 text-center">
                                                            <span class="badge bg-info-subtle text-info border border-info-subtle rounded-pill px-3 py-1">@entry.Payment.PaymentMethod</span>
                                                        </div>
                                                        <div class="text-end ps-4" style="min-width: 120px;">
                                                            <div class="fw-black text-success h5 mb-0">@entry.Payment.AmountPaid.ToString("C")</div>
                                                            <div class="text-muted" style="font-size: 0.6rem;">@entry.Payment.PaymentDate.ToString("h:mm tt")</div>
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="flat-history-list border rounded-4 overflow-hidden">
                                    @foreach (var entry in allPayments)
                                    {
                                        <div class="transaction-item d-flex align-items-center p-3 border-bottom hover-bg-light transition-base bg-white">
                                            <div class="date-block text-center pe-4 border-end" style="width: 80px;">
                                                <div class="fw-black text-primary" style="font-size: 0.9rem;">@entry.Payment.PaymentDate.ToString("dd")</div>
                                                <div class="text-muted text-uppercase fw-bold" style="font-size: 0.6rem;">@entry.Payment.PaymentDate.ToString("MMM")</div>
                                            </div>
                                            <div class="ps-4 flex-grow-1">
                                                <div class="fw-black">@entry.Bill.Vendor?.Name</div>
                                                <div class="small text-muted">@entry.Bill.Description</div>
                                                <span class="badge bg-light text-muted border mt-1" style="font-size: 0.6rem;">@entry.Bill.Category?.Name</span>
                                            </div>
                                            <div class="px-3 text-center">
                                                <span class="badge bg-info-subtle text-info border border-info-subtle rounded-pill px-3 py-1">@entry.Payment.PaymentMethod</span>
                                            </div>
                                            <div class="text-end ps-4" style="min-width: 120px;">
                                                <div class="fw-black text-success h5 mb-0">@entry.Payment.AmountPaid.ToString("C")</div>
                                                <div class="text-muted" style="font-size: 0.6rem;">@entry.Payment.PaymentDate.ToString("h:mm tt")</div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        }
                    </div>
                </div>
            }

            <!-- COLUMN 3: Filters & Settings Sidebar -->
            <div class="audit-sidebar-panel" style="width: 30%; flex: 0 0 30%;">
                <!-- Financial Totals Section -->
                <div class="sidebar-section mb-4">
                    <label class="sidebar-label">@(CurrentView == "BILLS" ? (IsYearView ? "ANNUAL" : "MONTHLY") + " FINANCIALS" : "PAYMENT ANALYSIS")</label>
                    
                    @if (CurrentView == "BILLS")
                    {
                        <div class="stat-card mb-3 highlight p-3 shadow-sm border-2">
                            <div class="label text-primary">TOTAL DUE @(IsYearView ? "(ANNUAL)" : "(MONTHLY)")</div>
                            <div class="value text-primary" style="font-size: 2rem;">@DisplayTotalDue.ToString("C")</div>
                        </div>
                    }

                    <div class="stat-card p-3 shadow-sm border-2 border-success-subtle bg-success-subtle bg-opacity-10">
                        <div class="label text-success">@(CurrentView == "BILLS" ? "TOTAL PAID" : "TOTAL DISBURSED") @(IsYearView && CurrentView == "PAYMENTS" ? "(ANNUAL)" : "(MONTHLY)")</div>
                        <div class="value text-success" style="font-size: 2rem;">@DisplayTotalPaid.ToString("C")</div>
                    </div>
                    
                    @if (CurrentView == "PAYMENTS")
                    {
                        <div class="mt-2 text-center">
                            <span class="badge bg-light text-muted border px-3 py-1 rounded-pill" style="font-size: 0.6rem;">@Bills.SelectMany(b => b.Payments).Count() TOTAL TRANSACTIONS</span>
                        </div>
                    }
                </div>

                <!-- Date Range Selection -->
                <div class="sidebar-section mb-4">
                    <label class="sidebar-label">CALENDAR NAVIGATION</label>
                    <div class="month-selector d-flex justify-content-between align-items-center bg-light rounded-pill px-4 py-3 border mb-3">
                        <button class="btn btn-link btn-sm p-0 text-decoration-none text-dark" @onclick="PrevMonth"><i class="bi bi-chevron-left h5 mb-0"></i></button>
                        <span class="fw-black h5 mb-0">@(IsYearView && CurrentView == "PAYMENTS" ? CurrentDate.Year.ToString() : CurrentDate.ToString("MMMM yyyy"))</span>
                        <button class="btn btn-link btn-sm p-0 text-decoration-none text-dark" @onclick="NextMonth"><i class="bi bi-chevron-right h5 mb-0"></i></button>
                    </div>

                        <div class="p-3 bg-light rounded-4 border">
                            <label class="sidebar-label mb-2">QUICK FILTERS</label>
                            <div class="btn-group w-100 p-1 bg-white rounded-pill border mb-3 shadow-sm" style="font-size: 0.65rem;">
                                @if (CurrentView == "BILLS")
                                {
                                    <button class="btn btn-xs @(SelectedTimeFilter == "All" ? "btn-primary shadow-sm" : "btn-link text-muted fw-bold text-decoration-none") rounded-pill py-2" @onclick='() => { SelectedTimeFilter = "All"; UpdateDisplay(); }'>ALL BILLS</button>
                                    <button class="btn btn-xs @(SelectedTimeFilter == "This Week" ? "btn-primary shadow-sm" : "btn-link text-muted fw-bold text-decoration-none") rounded-pill py-2" @onclick='() => { SelectedTimeFilter = "This Week"; UpdateDisplay(); }'>THIS WEEK</button>
                                    <button class="btn btn-xs @(SelectedTimeFilter == "Next Week" ? "btn-primary shadow-sm" : "btn-link text-muted fw-bold text-decoration-none") rounded-pill py-2" @onclick='() => { SelectedTimeFilter = "Next Week"; UpdateDisplay(); }'>NEXT WEEK</button>
                                }
                                else
                                {
                                    <button class="btn btn-xs @(!IsYearView ? "btn-primary shadow-sm" : "btn-link text-muted fw-bold text-decoration-none") rounded-pill py-2" @onclick='() => ToggleYearView(false)'>MONTH VIEW</button>
                                    <button class="btn btn-xs @(IsYearView ? "btn-primary shadow-sm" : "btn-link text-muted fw-bold text-decoration-none") rounded-pill py-2" @onclick='() => ToggleYearView(true)'>FULL YEAR</button>
                                }
                            </div>

                            @if (CurrentView == "PAYMENTS")
                            {
                                <div class="mt-4 pt-3 border-top">
                                    <label class="sidebar-label mb-2">GROUP BY</label>
                                    <select class="form-select rounded-4 border shadow-sm" @bind="GroupBy" style="font-size: 0.75rem; font-weight: 900;">
                                        <option value="None">NO GROUPING</option>
                                        <option value="Category">CATEGORY</option>
                                        <option value="Vendor">PAYEE (VENDOR)</option>
                                    </select>
                                </div>
                            }

                        @if (CurrentView == "BILLS")
                        {
                            <div class="form-check form-switch d-flex align-items-center justify-content-between ps-0 mt-3">
                                <label class="fw-bold text-muted mb-0" style="font-size: 0.75rem;">SHOW NEXT MONTH BILLS</label>
                                <input class="form-check-input ms-0" type="checkbox" role="switch" @onchange='(e) => { IncludeNextMonth = (bool)e.Value!; UpdateDisplay(); }' checked="@IncludeNextMonth" style="width: 2.5em; height: 1.25em;">
                            </div>
                        }
                    </div>
                </div>


            </div>
        </div>
    </div>

    @if (ShowBillModal)
    {
        <FinanceBillModal Bill="EditingBill" OnClose="CloseModal" OnSave="HandleBillSaved" />
    }

    @if (ShowPaymentModal)
    {
        <FinancePaymentModal Bill="PayingBill" OnClose="ClosePaymentModal" OnSave="HandlePaymentSaved" />
    }

    @if (ShowManageCategories)
    {
        <FinanceManageCategoriesModal OnClose="() => ShowManageCategories = false" OnUpdate="LoadData" />
    }
</div>

@code {
    [Inject] private IConfiguration Config { get; set; } = default!;
    private string? Revision => Config["ApplicationVersion:Revision"];
    private bool ShowManageCategories { get; set; }
    private string CurrentView { get; set; } = "BILLS";
    private bool IsYearView { get; set; }
    private string SortColumn { get; set; } = "Date";
    private bool SortAscending { get; set; }
    private string GroupBy { get; set; } = "None";
    private HashSet<string> ExpandedGroups { get; set; } = new();
    private bool IsLoading { get; set; } = true;
    private List<FinanceBill> DisplayUnpaidBills { get; set; } = new();
    private List<FinanceBill> DisplayPaidBills { get; set; } = new();
    private decimal DisplayTotalDue { get; set; }
    private decimal DisplayTotalPaid { get; set; }

    // Logic:
    // 1. Unpaid: All bills in 'Bills' where status is not Paid, filtered by time selection.
    // 2. Paid: All bills in 'Bills' that have a payment in the CURRENT month.
    private void UpdateDisplay()
    {
        var today = DateTime.Today;
        var endOfMonth = new DateTime(CurrentDate.Year, CurrentDate.Month, 1).AddMonths(1).AddDays(-1);

        // Filter for Unpaid column (Left)
        var unpaidQuery = Bills.Where(b => b.Status != "Paid");
        if (!IncludeNextMonth) unpaidQuery = unpaidQuery.Where(b => b.DueDate <= endOfMonth);
        
        if (SelectedTimeFilter == "This Week")
        {
            var startOfWeek = today.AddDays(-(int)today.DayOfWeek);
            var endOfWeek = startOfWeek.AddDays(7);
            unpaidQuery = unpaidQuery.Where(b => b.DueDate >= startOfWeek && b.DueDate < endOfWeek);
        }
        else if (SelectedTimeFilter == "Next Week")
        {
            var startOfWeek = today.AddDays(7 - (int)today.DayOfWeek);
            var endOfWeek = startOfWeek.AddDays(7);
            unpaidQuery = unpaidQuery.Where(b => b.DueDate >= startOfWeek && b.DueDate < endOfWeek);
        }
        DisplayUnpaidBills = unpaidQuery.OrderBy(b => b.DueDate).ToList();

        // Filter for Paid column (Middle)
        DisplayPaidBills = Bills.Where(b => b.Payments.Any(p => p.PaymentDate.Month == CurrentDate.Month && p.PaymentDate.Year == CurrentDate.Year))
            .OrderByDescending(b => b.Payments.Where(p => p.PaymentDate.Month == CurrentDate.Month).Max(p => p.PaymentDate))
            .ToList();

        // Totals
        if (IsYearView && CurrentView == "PAYMENTS")
        {
            DisplayTotalDue = Bills.Where(b => b.Status != "Paid").Sum(b => b.BalanceRemaining);
            DisplayTotalPaid = Bills.SelectMany(b => b.Payments).Sum(p => p.AmountPaid);
        }
        else
        {
            DisplayTotalDue = DisplayUnpaidBills.Sum(b => b.BalanceRemaining);
            DisplayTotalPaid = Bills.SelectMany(b => b.Payments)
                .Where(p => p.PaymentDate.Month == CurrentDate.Month && p.PaymentDate.Year == CurrentDate.Year)
                .Sum(p => p.AmountPaid);
        }
    }

    private DateTime CurrentDate { get; set; } = DateTime.Now;
    private List<FinanceBill> Bills { get; set; } = new();
    private string SelectedTimeFilter { get; set; } = "All";
    private bool IncludeNextMonth { get; set; } = true;
    private bool ShowBillModal { get; set; }
    private FinanceBill EditingBill { get; set; } = new();
    private bool ShowPaymentModal { get; set; }
    private FinanceBill PayingBill { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private void GoToReport()
    {
        Navigation.NavigateTo($"/finance/report/{CurrentDate.Month}/{CurrentDate.Year}");
    }

    private async Task LoadData()
    {
        Console.WriteLine("[FINANCE_UI] LoadData START");
        IsLoading = true;
        StateHasChanged();
        
        try
        {
            if (IsYearView && CurrentView == "PAYMENTS")
            {
                Bills = (await FinanceService.GetBillsForYearAsync(CurrentDate.Year)).ToList();
            }
            else
            {
                Bills = (await FinanceService.GetBillsAsync(CurrentDate.Month, CurrentDate.Year)).ToList();
            }
            Console.WriteLine($"[FINANCE_UI] Updating Display...");
            UpdateDisplay();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[FINANCE_UI] CRITICAL ERROR: {ex.Message}");
        }
        finally
        {
            IsLoading = false;
            Console.WriteLine("[FINANCE_UI] LoadData FINISHED");
            StateHasChanged();
        }
    }

    private async Task PrevMonth()
    {
        CurrentDate = CurrentDate.AddMonths(-1);
        await LoadData();
    }

    private async Task NextMonth()
    {
        CurrentDate = CurrentDate.AddMonths(1);
        await LoadData();
    }

    private void OpenAddBillModal()
    {
        EditingBill = new FinanceBill { DueDate = DateTime.Today, WarningDays = 7, Status = "Pending" };
        ShowBillModal = true;
    }

    private void SelectBill(FinanceBill bill)
    {
        // Prevent editing fully paid bills
        if (bill.Status == "Paid") return;

        EditingBill = bill;
        ShowBillModal = true;
    }

    private void MarkAsPaid(FinanceBill bill)
    {
        PayingBill = bill;
        ShowPaymentModal = true;
    }

    private async Task ToggleYearView(bool yearView)
    {
        IsYearView = yearView;
        await LoadData();
    }

    private void Sort(string column)
    {
        if (SortColumn == column)
        {
            SortAscending = !SortAscending;
        }
        else
        {
            SortColumn = column;
            SortAscending = true;
        }
        StateHasChanged();
    }

    private void ToggleGroup(string key)
    {
        if (ExpandedGroups.Contains(key))
            ExpandedGroups.Remove(key);
        else
            ExpandedGroups.Add(key);
        StateHasChanged();
    }

    private string GetSortIcon(string column)
    {
        if (SortColumn != column) return "";
        return SortAscending ? "↑" : "↓";
    }

    private void CloseModal() => ShowBillModal = false;
    private void ClosePaymentModal() => ShowPaymentModal = false;

    private async Task HandleBillSaved(bool success)
    {
        ShowBillModal = false;
        await LoadData();
    }

    private async Task HandlePaymentSaved(bool success)
    {
        ShowPaymentModal = false;
        await LoadData();
    }
}
