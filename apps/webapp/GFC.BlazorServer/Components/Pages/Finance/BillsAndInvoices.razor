    @if (ShowPaymentModal)
    {
        <FinancePaymentModal Bill="PayingBill" OnClose="ClosePaymentModal" OnSave="HandlePaymentSaved" />
    }

    @if (ShowManageCategories)
    {
        <FinanceManageCategoriesModal OnClose="() => ShowManageCategories = false" OnUpdate="LoadData" />
    }

    @if (ShowVendorModal)
    {
        <FinanceVendorModal Vendor="EditingVendor" OnClose="CloseVendorModal" OnSave="HandleVendorSaved" OnDeleteRequested="InitiateDeleteVendor" PaymentTypes="AllPaymentTypes" />
