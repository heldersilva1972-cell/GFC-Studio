    private int? GetGroupDueDay(IEnumerable<FinanceLoan> groupLoans)
    {
        return groupLoans.FirstOrDefault(l => l.PaymentDueDay.HasValue)?.PaymentDueDay;
    }

    private async Task UpdateGroupDueDay(string groupName, object? val)
    {
        if (val != null && int.TryParse(val.ToString(), out var day))
        {
            if (day >= 1 && day <= 31)
            {
                var groupLoans = AllLoans.Where(l => string.Equals(l.GroupName, groupName, StringComparison.OrdinalIgnoreCase) && l.IsActive).ToList();
                foreach (var loan in groupLoans)
                {
                    if (loan.PaymentDueDay != day)
                    {
                        loan.PaymentDueDay = day;
                        await FinanceService.UpdateLoanAsync(loan);
                    }
                }
                await LoadData();
            }
        }
    }
