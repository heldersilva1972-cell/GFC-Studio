    private async Task LoadData()
    {
        var sw = Stopwatch.StartNew();
        Console.WriteLine("[FINANCE_UI] LoadData START");
        IsLoading = true;
        StateHasChanged();
        
        try
        {
            try
            {
                var authState = await AuthStateProvider.GetAuthenticationStateAsync();
                CurrentUserEmail = authState.User?.Identity?.Name;
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error retrieving authentication state: {ex.Message}");
            }

            try
            {
                AuditLogs = (await FinanceService.GetAuditLogsAsync()).ToList();
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error retrieving audit logs: {ex.Message}");
            }

            if (IsYearView && CurrentView == "PAYMENTS")
            {
                Bills = (await FinanceService.GetBillsForYearAsync(CurrentDate.Year)).ToList();
            }
            else
            {
                Bills = (await FinanceService.GetBillsAsync(CurrentDate.Month, CurrentDate.Year)).ToList();
            }
            
            AllVendors = (await FinanceService.GetAllVendorsAsync(includeInactive: true)).ToList();
            AllCategories = (await FinanceService.GetAllCategoriesAsync()).ToList();
            AllLoans = (await FinanceService.GetAllLoansAsync(includeInactive: true)).ToList();
            AllPaymentTypes = (await FinanceService.GetAllPaymentTypesAsync()).ToList();
            UpdateLoansDisplay();
            
            // Fetch system settings to check if lottery integration is enabled
            try
            {
                var settings = await SettingsService.GetAsync();
                IsLotteryFinancialsEnabled = settings != null && (settings.LotteryBillCreationEnabled || settings.LotteryRecordPaidHistoryEnabled);
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error retrieving system settings: {ex.Message}");
                IsLotteryFinancialsEnabled = false;
            }

            // Fetch weekly lottery settlements to find the in-progress one
            DateTime weekStart = DateTime.Today;
            DateTime weekEnd = DateTime.Today;
            var today = DateTime.Today;
            
            // Calculate current Saturday-to-Friday week boundaries as baseline/fallback
            weekStart = today;
            while (weekStart.DayOfWeek != DayOfWeek.Saturday)
            {
                weekStart = weekStart.AddDays(-1);
            }
            weekEnd = weekStart.AddDays(6);
            
            UpcomingLotterySweepAmount = 0;
            UpcomingLotteryRecordedShifts = 0;
            UpcomingLotteryEnvelopeDrop = 0;
            
            try
            {
                var settlements = await LotterySettlementService.GetWeeklySettlementsForYearAsync(CurrentDate.Year);
                var currentWeek = settlements.FirstOrDefault(s => s.WeekStartDate.Date <= today && s.WeekEndDate.Date >= today);
                
                if (currentWeek != null)
                {
                    UpcomingLotterySweepAmount = currentWeek.NetDueAmount;
                    UpcomingLotteryRecordedShifts = currentWeek.RecordedShiftsCount;
                    UpcomingLotteryEnvelopeDrop = currentWeek.EnvelopeDropAmount;
                    weekStart = currentWeek.WeekStartDate.Date;
                    weekEnd = currentWeek.WeekEndDate.Date;
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Database query for weekly settlements failed (migration may not be applied yet): {ex.Message}");
            }
            
            UpcomingLotteryDaysRemaining = Math.Max(0, (weekEnd - today).Days + 1);
            HasUpcomingLotterySweep = true;
            
            Console.WriteLine($"[FINANCE_UI] Updating Display...");
            UpdateDisplay();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[FINANCE_UI] CRITICAL ERROR: {ex.Message}");
        }
        finally
        {
            IsLoading = false;
            sw.Stop();
            Console.WriteLine($"[FINANCE_UI] LoadData FINISHED in {sw.ElapsedMilliseconds}ms");
            StateHasChanged();
        }
    }

