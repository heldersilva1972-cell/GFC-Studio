    private async Task HandlePaymentSaved(bool success)
    {
        ShowPaymentModal = false;
        if (success && PayingBill != null)
        {
            var isLottery = (PayingBill.Vendor?.Name == "State Lottery") || (PayingBill.Category?.Name == "Lottery Payments");
            if (isLottery)
            {
                try
                {
                    using var db = await DbFactory.CreateDbContextAsync();
                    var settlement = await db.LotteryWeeklySettlements.FirstOrDefaultAsync(s => s.LinkedBillId == PayingBill.Id);
                    if (settlement != null && settlement.Status != "Settled")
                    {
                        settlement.Status = "Settled";
                        settlement.SettleDate = DateTime.Now;
                        settlement.SettleBy = CurrentUserEmail ?? "System";
                        settlement.ReferenceNumber = "ACH Sweep / Bills Page";
                        await db.SaveChangesAsync();
                    }
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"Error syncing lottery settlement: {ex.Message}");
                }
            }
        }
        await LoadData();
    }

    private void UpdateLoansDisplay()
    {
        var query = AllLoans.AsQueryable();
        if (!ShowPaidOffLoans)
        {
            query = query.Where(l => l.IsActive && l.CurrentBalance > 0);
        }
        DisplayLoans = query.OrderByDescending(l => l.OriginDate).ToList();

        // Recalculate total loan balance for active loans
        TotalLoanBalance = AllLoans.Where(l => l.IsActive).Sum(l => l.CurrentBalance);

        if (SelectedLoan != null)
        {
            SelectedLoan = AllLoans.FirstOrDefault(l => l.Id == SelectedLoan.Id);
        }

        if (SelectedLoan == null && DisplayLoans.Any())
        {
            SelectedLoan = DisplayLoans.First();
        }
    }

