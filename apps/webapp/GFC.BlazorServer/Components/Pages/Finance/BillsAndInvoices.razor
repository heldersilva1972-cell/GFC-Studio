    @if (ShowDeleteVendorConfirm && VendorToDelete != null)
    {
        <div class="modal fade show d-block animate-fade-in" tabindex="-1" style="background: rgba(0,0,0,0.55); z-index: 1060; backdrop-filter: blur(4px);">
            <div class="modal-dialog modal-dialog-centered" style="max-width: 380px;">
                <div class="modal-content border-0 shadow-lg" style="border-radius: 24px;">
                    <div class="modal-body p-4 text-center">
                        <i class="bi bi-exclamation-triangle-fill text-danger display-4 mb-3 d-block"></i>
                        <h5 class="fw-bold mb-2 text-dark">Delete Vendor?</h5>
                        <p class="text-muted small mb-4">Are you sure you want to delete <strong>@VendorToDelete.Name</strong>? This will deactivate the vendor and hide them from future bills.</p>
                        <div class="d-flex gap-2 justify-content-center">
                            <button type="button" class="btn btn-light rounded-pill px-4 py-2" @onclick="() => ShowDeleteVendorConfirm = false">Cancel</button>
                            <button type="button" class="btn btn-danger rounded-pill px-4 py-2 shadow-sm fw-bold" @onclick="ConfirmDeleteVendor">Yes, Delete</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    @if (ShowLoanModal)
    {
        <FinanceLoanModal Loan="EditingLoan" OnClose="CloseLoanModal" OnSave="HandleLoanSaved" ExistingGroups="ExistingLoanGroups" />
    }

    @if (ShowLoanPaymentModal)
    {
        <FinanceLoanPaymentModal Loan="PayingLoan" OnClose="CloseLoanPaymentModal" OnSave="HandleLoanPaymentSaved" />
    }

    @if (ShowLoanGroupPaymentModal)
    {
        <FinanceLoanGroupPaymentModal GroupName="@PayingLoanGroupName" Loans="@PayingGroupLoans" CurrentDate="@CurrentDate" OnClose="CloseLoanGroupPaymentModal" OnSave="HandleLoanGroupPaymentSaved" />
    }

    @if (ShowEditPaymentModal)
    {
        <FinanceEditPaymentModal Payment="EditingPayment" OnClose="CloseEditPaymentModal" OnSave="HandlePaymentUpdated" OnDeleteRequested="InitiateDeletePayment" />
    }

    @if (ShowDeletePaymentConfirm && PaymentToDelete != null)
    {
        <div class="modal fade show d-block animate-fade-in" tabindex="-1" style="background: rgba(0,0,0,0.55); z-index: 1060; backdrop-filter: blur(4px);">
            <div class="modal-dialog modal-dialog-centered" style="max-width: 380px;">
                <div class="modal-content border-0 shadow-lg" style="border-radius: 24px;">
                    <div class="modal-body p-4 text-center">
                        <i class="bi bi-exclamation-triangle-fill text-danger display-4 mb-3 d-block"></i>
                        <h5 class="fw-bold mb-2 text-dark">Delete Payment?</h5>
                        <p class="text-muted small mb-4">Are you sure you want to delete this payment of <strong>@PaymentToDelete.AmountPaid.ToString("C")</strong>? This will restore the balance of the corresponding bill or loan.</p>
                        <div class="d-flex gap-2 justify-content-center">
                            <button type="button" class="btn btn-light rounded-pill px-4 py-2" @onclick="() => ShowDeletePaymentConfirm = false">Cancel</button>
                            <button type="button" class="btn btn-danger rounded-pill px-4 py-2 shadow-sm fw-bold" @onclick="ConfirmDeletePayment">Yes, Delete</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    @if (ShowDeleteLoanConfirm && LoanToDelete != null)
    {
        <div class="modal fade show d-block animate-fade-in" tabindex="-1" style="background: rgba(0,0,0,0.55); z-index: 1060; backdrop-filter: blur(4px);">
            <div class="modal-dialog modal-dialog-centered" style="max-width: 380px;">
                <div class="modal-content border-0 shadow-lg" style="border-radius: 24px;">
                    <div class="modal-body p-4 text-center">
                        <i class="bi bi-exclamation-triangle-fill text-danger display-4 mb-3 d-block"></i>
                        <h5 class="fw-bold mb-2 text-dark">Delete Loan?</h5>
                        <p class="text-muted small mb-4">Are you sure you want to delete the loan from <strong>@LoanToDelete.LenderName</strong>? This will also delete all associated payment records and cannot be undone.</p>
                        <div class="d-flex gap-2 justify-content-center">
                            <button type="button" class="btn btn-light rounded-pill px-4 py-2" @onclick="() => ShowDeleteLoanConfirm = false">Cancel</button>
                            <button type="button" class="btn btn-danger rounded-pill px-4 py-2 shadow-sm fw-bold" @onclick="ConfirmDeleteLoan">Yes, Delete</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Inject] private IConfiguration Config { get; set; } = default!;
    private string? Revision => Config["ApplicationVersion:Revision"];
    private bool ShowManageCategories { get; set; }
    private string CurrentView { get; set; } = "BILLS";
    private string BillSortOrder { get; set; } = "Priority";
    private bool ShowVendorModal { get; set; }
    private FinanceVendor EditingVendor { get; set; } = new();
    private bool ShowDeleteVendorConfirm { get; set; }
    private FinanceVendor? VendorToDelete { get; set; }
    private bool ShowDeleteBillConfirm { get; set; }
    private FinanceBill? BillToDelete { get; set; }
    private List<FinanceVendor> AllVendors { get; set; } = new();
    private List<FinanceCategory> AllCategories { get; set; } = new();
    private int? SelectedCategoryFilterId { get; set; }
    private List<FinancePaymentType> AllPaymentTypes { get; set; } = new();
    private string VendorSearchText { get; set; } = "";
    private bool ShowInactiveVendors { get; set; }
    private bool ShowLoanModal { get; set; }
    private FinanceLoan EditingLoan { get; set; } = new();
    private bool ShowLoanPaymentModal { get; set; }
    private FinanceLoan PayingLoan { get; set; } = new();
    private bool ShowLoanGroupPaymentModal { get; set; }
    private string PayingLoanGroupName { get; set; } = "";
    private List<FinanceLoan> PayingGroupLoans { get; set; } = new();
    private bool ShowEditPaymentModal { get; set; }
    private FinancePayment EditingPayment { get; set; } = new();
    private bool ShowDeletePaymentConfirm { get; set; }
    private FinancePayment? PaymentToDelete { get; set; }
    private bool ShowDeleteLoanConfirm { get; set; }
    private FinanceLoan? LoanToDelete { get; set; }
    private List<FinanceLoan> AllLoans { get; set; } = new();
    private List<FinanceLoan> DisplayLoans { get; set; } = new();
    private FinanceLoan? SelectedLoan { get; set; }
    private bool ShowPaidOffLoans { get; set; }
    private bool GroupLoans { get; set; } = true;
    private List<string> ExistingLoanGroups =>
        AllLoans.Where(l => !string.IsNullOrWhiteSpace(l.GroupName))
                .Select(l => l.GroupName!)
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .OrderBy(g => g)
                .ToList();
    private List<FinanceAuditLog> AuditLogs { get; set; } = new();
    private string? CurrentUserEmail { get; set; }
    private decimal TotalLoanBalance { get; set; }
    private bool IsYearView { get; set; }
    private string SortColumn { get; set; } = "Date";
    private bool SortAscending { get; set; }
    private string GroupBy { get; set; } = "Category";
    private HashSet<string> ExpandedGroups { get; set; } = new();
    private bool IsLoading { get; set; } = true;
    private List<FinanceBill> DisplayUnpaidBills { get; set; } = new();
    private List<FinanceBill> DisplayPaidBills { get; set; } = new();
    private decimal DisplayTotalDue { get; set; }
    private decimal DisplayTotalPaid { get; set; }
    private decimal LotteryTotalDue { get; set; }
    private decimal LotteryTotalPaid { get; set; }
    private decimal LotteryOutstanding { get; set; }
    private decimal UpcomingLotterySweepAmount { get; set; }
    private decimal UpcomingLotteryEnvelopeDrop { get; set; }
    private int UpcomingLotteryRecordedShifts { get; set; }
    private int UpcomingLotteryDaysRemaining { get; set; }
    private bool HasUpcomingLotterySweep { get; set; }
    private bool IsLotteryFinancialsEnabled { get; set; }

    // Logic:
    // 1. Unpaid: All bills in 'Bills' where status is not Paid, filtered by time selection.
    // 2. Paid: All bills in 'Bills' that have a payment in the CURRENT month.
    private void UpdateDisplay()
    {
        var sw = Stopwatch.StartNew();
        var today = DateTime.Today;
        var startOfMonth = new DateTime(CurrentDate.Year, CurrentDate.Month, 1);
        var endOfMonth = startOfMonth.AddMonths(1).AddDays(-1);

        // Filter for Unpaid column (Left)
        var unpaidQuery = Bills.Where(b => b.Status != "Paid");
        
        if (SelectedTimeFilter == "7Days")
        {
            var horizon = today.AddDays(7);
            unpaidQuery = unpaidQuery.Where(b => b.DueDate <= horizon);
        }
        else if (SelectedTimeFilter == "14Days")
        {
            var horizon = today.AddDays(14);
            unpaidQuery = unpaidQuery.Where(b => b.DueDate <= horizon);
        }
        else // "Month"
        {
            unpaidQuery = unpaidQuery.Where(b => b.DueDate <= endOfMonth);
        }
        
        var unpaidList = unpaidQuery.ToList();

        // Dynamically inject Virtual Bills for active loans configured with a PaymentDueDay (can have 0 or positive MonthlyPaymentAmount)
        var activeLoans = AllLoans.Where(l => l.IsActive).ToList();
        
        // 1. Grouped Loans - Consolidate loans sharing a GroupName into a single virtual bill
        var groupedLoans = activeLoans
            .Where(l => !string.IsNullOrWhiteSpace(l.GroupName))
            .GroupBy(l => l.GroupName!.Trim(), StringComparer.OrdinalIgnoreCase);

        foreach (var group in groupedLoans)
        {
            var groupName = group.Key;
            var currentMonthKey = CurrentDate.ToString("yyyy-MM");
            
            // Determine group due day: find the first non-null PaymentDueDay set on any loan in this group
            var groupDueDayOpt = group.FirstOrDefault(l => l.PaymentDueDay.HasValue)?.PaymentDueDay;
            if (!groupDueDayOpt.HasValue)
            {
                // If the group has no due date set yet (either in the header or on individual loans), do not show a reminder
                continue;
            }

            int dueDay = groupDueDayOpt.Value;
            int day = Math.Min(dueDay, DateTime.DaysInMonth(CurrentDate.Year, CurrentDate.Month));
            var groupDueDate = new DateTime(CurrentDate.Year, CurrentDate.Month, day);

            // Filter by selected time window
            bool includeGroup = false;
            if (SelectedTimeFilter == "7Days")
            {
                var horizon = today.AddDays(7);
                includeGroup = groupDueDate <= horizon;
            }
            else if (SelectedTimeFilter == "14Days")
            {
                var horizon = today.AddDays(14);
                includeGroup = groupDueDate <= horizon;
            }
            else // "Month"
            {
                includeGroup = true;
            }

            if (includeGroup)
            {
                // Gather all loans in this group that need payment/attention this month
                var pendingLoansInGroup = new List<FinanceLoan>();
                foreach (var loan in group)
                {
                    var targetAmount = loan.MonthlyPaymentAmount ?? 0;
                    var isSkipped = !string.IsNullOrWhiteSpace(loan.SkippedMonths) && 
                                    loan.SkippedMonths.Split(',').Contains(currentMonthKey);
                    
                    var monthPayments = loan.Payments.Where(p => p.PaymentDate.Month == CurrentDate.Month && p.PaymentDate.Year == CurrentDate.Year).ToList();
                    var totalMonthPaid = monthPayments.Sum(p => p.AmountPaid);

                    bool needsPayment = targetAmount > 0 ? (totalMonthPaid < targetAmount) : (totalMonthPaid == 0);

                    if (!isSkipped && needsPayment)
                    {
                        pendingLoansInGroup.Add(loan);
                    }
                }

                if (pendingLoansInGroup.Any())
                {
                    decimal groupOriginalAmount = pendingLoansInGroup.Sum(l => l.MonthlyPaymentAmount ?? 0);
                    decimal groupTotalPaid = pendingLoansInGroup.Sum(l => l.Payments.Where(p => p.PaymentDate.Month == CurrentDate.Month && p.PaymentDate.Year == CurrentDate.Year).Sum(p => p.AmountPaid));

                    var virtualGroupBill = new FinanceBill
                    {
                        Id = -20000 - Math.Abs(groupName.GetHashCode() % 10000), // Distinct ID range to represent a group
                        OriginalAmount = groupOriginalAmount,
                        DueDate = groupDueDate,
                        Status = groupTotalPaid > 0 ? "Partial" : "Pending",
                        Description = groupName, // Stash group name in description to identify it in action routes
                        WarningDays = groupOriginalAmount == 0 ? 999 : 7,
                        Vendor = new FinanceVendor { Name = groupName, Priority = 1 } // High priority
                    };

                    // Load all current month payments for members of this group
                    foreach (var loan in pendingLoansInGroup)
                    {
                        var monthPayments = loan.Payments.Where(p => p.PaymentDate.Month == CurrentDate.Month && p.PaymentDate.Year == CurrentDate.Year).ToList();
                        foreach (var p in monthPayments)
                        {
                            virtualGroupBill.Payments.Add(p);
                        }
                    }

                    unpaidList.Add(virtualGroupBill);
                }
            }
        }

        // 2. Ungrouped Loans - Render individually as before
        var ungroupedLoans = activeLoans.Where(l => string.IsNullOrWhiteSpace(l.GroupName) && l.PaymentDueDay.HasValue).ToList();
        foreach (var loan in ungroupedLoans)
        {
            var targetAmount = loan.MonthlyPaymentAmount ?? 0;
            var currentMonthKey = CurrentDate.ToString("yyyy-MM");
            var isSkipped = !string.IsNullOrWhiteSpace(loan.SkippedMonths) && 
                            loan.SkippedMonths.Split(',').Contains(currentMonthKey);

            int day = Math.Min(loan.PaymentDueDay!.Value, DateTime.DaysInMonth(CurrentDate.Year, CurrentDate.Month));
            var loanDueDate = new DateTime(CurrentDate.Year, CurrentDate.Month, day);

            bool includeLoan = false;
            if (SelectedTimeFilter == "7Days")
            {
                var horizon = today.AddDays(7);
                includeLoan = loanDueDate <= horizon;
            }
            else if (SelectedTimeFilter == "14Days")
            {
                var horizon = today.AddDays(14);
                includeLoan = loanDueDate <= horizon;
            }
            else // "Month"
            {
                includeLoan = true;
            }

            if (includeLoan)
            {
                var monthPayments = loan.Payments.Where(p => p.PaymentDate.Month == CurrentDate.Month && p.PaymentDate.Year == CurrentDate.Year).ToList();
                var totalMonthPaid = monthPayments.Sum(p => p.AmountPaid);

                var lastPmt = loan.Payments.OrderByDescending(p => p.PaymentDate).FirstOrDefault();
                string lastPmtText = "";
                if (lastPmt != null)
                {
                    var daysAgo = (today - lastPmt.PaymentDate.Date).Days;
                    lastPmtText = $"Last payment: {lastPmt.AmountPaid:C} on {lastPmt.PaymentDate:MM/dd/yy} ({daysAgo} days ago)";
                }
                else
                {
                    lastPmtText = "No previous payments logged";
                }

                bool needsPayment = targetAmount > 0 ? (totalMonthPaid < targetAmount) : (totalMonthPaid == 0);

                if (!isSkipped && needsPayment)
                {
                    var virtualBill = new FinanceBill
                    {
                        Id = -loan.Id,
                        LoanId = loan.Id,
                        Loan = loan,
                        OriginalAmount = targetAmount,
                        DueDate = loanDueDate,
                        Status = totalMonthPaid > 0 ? "Partial" : "Pending",
                        Description = lastPmtText,
                        WarningDays = targetAmount == 0 ? 999 : 7,
                        Vendor = new FinanceVendor { Name = loan.LenderName, Priority = 1 }
                    };

                    foreach (var p in monthPayments)
                    {
                        virtualBill.Payments.Add(p);
                    }

                    unpaidList.Add(virtualBill);
                }
            }
        }

        if (BillSortOrder == "Priority")
        {
            DisplayUnpaidBills = unpaidList
                .OrderBy(b => b.Vendor != null ? b.Vendor.Priority : 3)
                .ThenBy(b => b.DueDate)
                .ToList();
        }
        else
        {
            DisplayUnpaidBills = unpaidList.OrderBy(b => b.DueDate).ToList();
        }

        // Filter for Paid column (Middle) - Always shows the full calendar month
        var paidList = Bills.Select(b => new { Bill = b, LastPaymentDate = b.Payments
                .Where(p => p.PaymentDate.Month == CurrentDate.Month && p.PaymentDate.Year == CurrentDate.Year)
                .Select(p => p.PaymentDate)
                .DefaultIfEmpty(DateTime.MinValue)
                .Max() })
            .Where(x => x.LastPaymentDate > DateTime.MinValue)
            .OrderByDescending(x => x.LastPaymentDate)
            .Select(x => x.Bill)
            .ToList();

        // Add virtual fully paid/skipped loans to paidList
        foreach (var loan in activeLoans)
        {
            // Determine due day: if grouped, use the group's synced due day; if ungrouped, use its own
            int? dueDayOpt = null;
            if (!string.IsNullOrWhiteSpace(loan.GroupName))
            {
                dueDayOpt = AllLoans.FirstOrDefault(l => string.Equals(l.GroupName, loan.GroupName, StringComparison.OrdinalIgnoreCase) && l.PaymentDueDay.HasValue)?.PaymentDueDay;
            }
            else
            {
                dueDayOpt = loan.PaymentDueDay;
            }

            if (!dueDayOpt.HasValue)
            {
                continue;
            }

            var targetAmount = loan.MonthlyPaymentAmount ?? 0;
            var currentMonthKey = CurrentDate.ToString("yyyy-MM");
            var isSkipped = !string.IsNullOrWhiteSpace(loan.SkippedMonths) && 
                            loan.SkippedMonths.Split(',').Contains(currentMonthKey);

            int day = Math.Min(dueDayOpt.Value, DateTime.DaysInMonth(CurrentDate.Year, CurrentDate.Month));
            var loanDueDate = new DateTime(CurrentDate.Year, CurrentDate.Month, day);

            var monthPayments = loan.Payments.Where(p => p.PaymentDate.Month == CurrentDate.Month && p.PaymentDate.Year == CurrentDate.Year).ToList();
            var totalMonthPaid = monthPayments.Sum(p => p.AmountPaid);

            bool isPaid = targetAmount > 0 ? (totalMonthPaid >= targetAmount) : (totalMonthPaid > 0);

            if (isSkipped || isPaid)
            {
                // Determine transaction date for rolling range matching
                DateTime referenceDate = loanDueDate;
                if (!isSkipped && monthPayments.Any())
                {
                    referenceDate = monthPayments.OrderByDescending(p => p.PaymentDate).First().PaymentDate;
                }

                // Always include paid loans for the current calendar month
                bool includePaidLoan = true;

                if (includePaidLoan)
                {
                    var virtualBill = new FinanceBill
                    {
                        Id = -loan.Id,
                        LoanId = loan.Id,
                        Loan = loan,
                        OriginalAmount = targetAmount,
                        DueDate = loanDueDate,
                        Status = isSkipped ? "Skipped" : "Paid",
                        Description = isSkipped ? "Repayment skipped this month" : $"Monthly Repayment for {loan.LenderName}",
                        Vendor = new FinanceVendor { Name = loan.LenderName }
                    };
                    foreach (var p in monthPayments)
                    {
                        virtualBill.Payments.Add(p);
                    }
                    paidList.Add(virtualBill);
                }
            }
        }
        DisplayPaidBills = paidList;

        // Totals (Excluding Lottery)
        var nonLotteryBills = Bills.Where(b => b.Vendor?.Name != "State Lottery" && b.Category?.Name != "Lottery Payments").ToList();
        var lotteryBills = Bills.Where(b => b.Vendor?.Name == "State Lottery" || b.Category?.Name == "Lottery Payments").ToList();

        if (IsYearView && CurrentView == "PAYMENTS")
        {
            DisplayTotalDue = nonLotteryBills.Where(b => b.Status != "Paid").Sum(b => b.BalanceRemaining);
            DisplayTotalPaid = nonLotteryBills.SelectMany(b => b.Payments).Sum(p => p.AmountPaid);
            
            LotteryTotalDue = lotteryBills.Where(b => b.Status != "Paid").Sum(b => b.BalanceRemaining);
            LotteryTotalPaid = lotteryBills.SelectMany(b => b.Payments).Sum(p => p.AmountPaid);
        }
        else
        {
            DisplayTotalDue = DisplayUnpaidBills.Where(b => b.Vendor?.Name != "State Lottery" && b.Category?.Name != "Lottery Payments").Sum(b => b.BalanceRemaining);
            
            var periodUnpaidLottery = DisplayUnpaidBills.Where(b => b.Vendor?.Name == "State Lottery" || b.Category?.Name == "Lottery Payments").ToList();
            var periodPaidLottery = DisplayPaidBills.Where(b => b.Vendor?.Name == "State Lottery" || b.Category?.Name == "Lottery Payments").ToList();
            LotteryTotalDue = periodUnpaidLottery.Sum(b => b.BalanceRemaining) + periodPaidLottery.Sum(b => b.OriginalAmount);

            decimal loanPaymentsSum = activeLoans.SelectMany(l => l.Payments)
                .Where(p => p.PaymentDate.Month == CurrentDate.Month && p.PaymentDate.Year == CurrentDate.Year)
                .Sum(p => p.AmountPaid);

            DisplayTotalPaid = nonLotteryBills.SelectMany(b => b.Payments)
                .Where(p => p.PaymentDate.Month == CurrentDate.Month && p.PaymentDate.Year == CurrentDate.Year)
                .Sum(p => p.AmountPaid) + loanPaymentsSum;

            LotteryTotalPaid = lotteryBills.SelectMany(b => b.Payments)
                .Where(p => p.PaymentDate.Month == CurrentDate.Month && p.PaymentDate.Year == CurrentDate.Year)
                .Sum(p => p.AmountPaid);
        }
        LotteryOutstanding = LotteryTotalDue - LotteryTotalPaid;
        if (LotteryOutstanding < 0) LotteryOutstanding = 0;
        
        sw.Stop();
        Console.WriteLine($"[FINANCE_UI] UpdateDisplay FINISHED in {sw.ElapsedMilliseconds}ms");
    }

