@page "/finance/income"
@using GFC.BlazorServer.Services
@using GFC.Core.Models
@using Microsoft.AspNetCore.Authorization
@inject IFinancialAnalyticsService FinancialService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@attribute [Authorize]

<PageTitle>Income Streams | GFC Finance</PageTitle>

<div class="income-page-container d-flex flex-column h-100 position-relative" style="max-height: calc(100vh - 60px); overflow: hidden;">
    
    <!-- FIXED HEADER & CONTROLS -->
    <header class="income-header bg-white border-bottom shadow-sm p-4 flex-shrink-0 z-3">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div>
                <div class="d-flex align-items-center gap-3">
                    <div class="bg-success bg-opacity-10 text-success rounded-4 p-2 d-flex align-items-center justify-content-center" style="width: 44px; height: 44px;">
                        <i class="bi bi-cash-stack fs-4"></i>
                    </div>
                    <div>
                        <h1 class="h3 fw-black text-dark mb-0">INCOME STREAMS</h1>
                        <p class="text-muted small mb-0">Unified Revenue Overview & Shift Completeness Audit</p>
                    </div>
                </div>
            </div>

            <div class="d-flex align-items-center gap-2 flex-wrap">
                <!-- VIEW TOGGLE: GRAPH VS COMPARE VS TABLE -->
                <div class="btn-group shadow-sm" role="group">
                    <button class="btn @(_activeView == "chart" ? "btn-dark" : "btn-outline-secondary") fw-bold px-3" @onclick='() => SetView("chart")'>
                        <i class="bi bi-bar-chart-line-fill me-1"></i> Visual Chart
                    </button>
                    <button class="btn @(_activeView == "compare" ? "btn-dark" : "btn-outline-secondary") fw-bold px-3" @onclick='() => SetView("compare")'>
                        <i class="bi bi-arrow-left-right me-1"></i> Period Comparison
                    </button>
                    <button class="btn @(_activeView == "table" ? "btn-dark" : "btn-outline-secondary") fw-bold px-3" @onclick='() => SetView("table")'>
                        <i class="bi bi-table me-1"></i> Detailed Ledger
                    </button>
                </div>

                <!-- PERIOD SCOPE TOGGLE: FULL YEAR (12 MONTHS) VS SINGLE MONTH VIEW -->
                <div class="btn-group shadow-sm" role="group">
                    <button class="btn @(_isFullYear ? "btn-success" : "btn-outline-secondary") fw-bold px-3" @onclick="SetFullYearMode">
                        <i class="bi bi-calendar-range me-1"></i> Full Year
                    </button>
                    <button class="btn @(!_isFullYear ? "btn-success" : "btn-outline-secondary") fw-bold px-3" @onclick="SetMonthMode">
                        <i class="bi bi-calendar-month me-1"></i> Month View
                    </button>
                </div>

                @if (!_isFullYear)
                {
                    <!-- MONTH SELECTOR (Active in Month View) -->
                    <div class="input-group shadow-sm" style="width: 150px;">
                        <select class="form-select fw-bold" @bind="_selectedMonth" @bind:after="LoadData">
                            @for (int m = 1; m <= 12; m++)
                            {
                                <option value="@m">@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(m)</option>
                            }
                        </select>
                    </div>
                }

                <!-- PRIMARY YEAR SELECTOR -->
                <div class="input-group shadow-sm" style="width: 110px;">
                    <select class="form-select fw-bold" @bind="_selectedYear" @bind:after="LoadData">
                        @foreach (var y in _availableYears)
                        {
                            <option value="@y">@y</option>
                        }
                    </select>
                </div>

                <button class="btn btn-outline-secondary rounded-3 shadow-sm px-3" @onclick="LoadData" title="Refresh Data">
                    <i class="bi bi-arrow-clockwise"></i>
                </button>
            </div>
        </div>

        @if (!_isLoading)
        {


            @if (_activeView != "compare")
            {
                <!-- TOP STAT CARDS -->
                <div class="row g-3 mt-1">
                    <!-- COMBINED TOTAL INCOME -->
                    <div class="col-md-3">
                        <div class="card border-0 shadow-sm rounded-4 bg-success text-white h-100">
                            <div class="card-body p-3">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <span class="small text-white-50 text-uppercase fw-bold">Combined Income</span>
                                    <i class="bi bi-currency-dollar text-white fs-5"></i>
                                </div>
                                <div class="fs-3 fw-black">@_summary?.CombinedTotalIncome.ToString("C2")</div>
                                <div class="d-flex align-items-center justify-content-between flex-wrap gap-1 mt-1">
                                    <span class="small text-white-50">@(_selectedMonth == 0 ? "Yearly Gross" : "Monthly Gross")</span>
                                    @if (_summary != null && (_summary.PrevMonthBarSales > 0 || _summary.PrevMonthLotteryCommissions > 0))
                                    {
                                        var mtdTitle = _summary.PrevMonthDaysCompared > 0 && _summary.PrevMonthDaysCompared < 28 
                                            ? $"Like-for-like MTD: First {_summary.PrevMonthDaysCompared} days of {_selectedYear} vs first {_summary.PrevMonthDaysCompared} days of previous month" 
                                            : "Month-over-month comparison against previous period";
                                        <span class="badge bg-white text-success fw-bold" title="@mtdTitle">
                                            @(_summary.CombinedMomGrowth >= 0 ? "▲ +" : "▼ ")@_summary.CombinedMomGrowth.ToString("N1")% MoM
                                        </span>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- BAR SALES -->
                    <div class="col-md-3">
                        <div class="card border-0 shadow-sm rounded-4 bg-white border-start border-primary border-4 h-100" style="cursor: pointer;" @onclick='() => NavigateToUrl("/finance/bar-sales")'>
                            <div class="card-body p-3">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <span class="small text-muted text-uppercase fw-bold">Bar Sales</span>
                                    <i class="bi bi-cup-straw text-primary fs-5"></i>
                                </div>
                                <div class="fs-3 fw-black text-dark">@_summary?.TotalBarSales.ToString("C2")</div>
                                <div class="d-flex align-items-center justify-content-between flex-wrap gap-1 mt-1">
                                    <span class="small text-muted">Bar sales gross</span>
                                    @if (_summary != null && _summary.PrevMonthBarSales > 0)
                                    {
                                        var mtdTitle = _summary.PrevMonthDaysCompared > 0 && _summary.PrevMonthDaysCompared < 28 
                                            ? $"Like-for-like MTD: First {_summary.PrevMonthDaysCompared} days of {_selectedYear} vs first {_summary.PrevMonthDaysCompared} days of previous month" 
                                            : "Like-for-like comparison against previous period";
                                        <span class="badge @(_summary.BarSalesMomGrowth >= 0 ? "bg-success-subtle text-success border border-success-subtle" : "bg-danger-subtle text-danger border border-danger-subtle") fw-bold" style="cursor: default;" @onclick:stopPropagation="true" title="@mtdTitle">
                                            @(_summary.BarSalesMomGrowth >= 0 ? "▲ +" : "▼ ")@_summary.BarSalesMomGrowth.ToString("N1")% MoM
                                        </span>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- LOTTERY COMMISSIONS -->
                    <div class="col-md-3">
                        <div class="card border-0 shadow-sm rounded-4 bg-white border-start border-danger border-4 h-100" style="cursor: pointer;" @onclick='() => NavigateToUrl("/lottery")'>
                            <div class="card-body p-3">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <span class="small text-muted text-uppercase fw-bold">Lottery Commissions</span>
                                    <i class="bi bi-ticket-detailed text-danger fs-5"></i>
                                </div>
                                <div class="fs-3 fw-black text-dark">@_summary?.TotalLotteryCommissions.ToString("C2")</div>
                                <div class="d-flex align-items-center justify-content-between flex-wrap gap-1 mt-1">
                                    <span class="small text-muted">Net commissions & bonuses</span>
                                    @if (_summary != null && _summary.PrevMonthLotteryCommissions > 0)
                                    {
                                        var mtdTitle = _summary.PrevMonthDaysCompared > 0 && _summary.PrevMonthDaysCompared < 28 
                                            ? $"Like-for-like MTD: First {_summary.PrevMonthDaysCompared} days of {_selectedYear} vs first {_summary.PrevMonthDaysCompared} days of previous month" 
                                            : "Like-for-like comparison against previous period";
                                        <span class="badge @(_summary.LotteryMomGrowth >= 0 ? "bg-success-subtle text-success border border-success-subtle" : "bg-danger-subtle text-danger border border-danger-subtle") fw-bold" style="cursor: default;" @onclick:stopPropagation="true" title="@mtdTitle">
                                            @(_summary.LotteryMomGrowth >= 0 ? "▲ +" : "▼ ")@_summary.LotteryMomGrowth.ToString("N1")% MoM
                                        </span>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- MEMBERSHIP DUES -->
                    <div class="col-md-3">
                        <div class="card border-0 shadow-sm rounded-4 bg-white border-start border-info border-4 h-100" style="cursor: pointer;" @onclick='() => NavigateToUrl("/dues")'>
                            <div class="card-body p-3">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <span class="small text-muted text-uppercase fw-bold">Membership Dues</span>
                                    <i class="bi bi-wallet2 text-info fs-5"></i>
                                </div>
                                <div class="fs-3 fw-black text-dark">@_summary?.TotalMembershipDues.ToString("C2")</div>
                                <div class="d-flex align-items-center justify-content-between flex-wrap gap-1 mt-1">
                                    <span class="small text-muted">Dues collected</span>
                                    @if (_summary != null && _summary.PrevMonthMembershipDues > 0)
                                    {
                                        var mtdTitle = _summary.PrevMonthDaysCompared > 0 && _summary.PrevMonthDaysCompared < 28 
                                            ? $"Like-for-like MTD: First {_summary.PrevMonthDaysCompared} days of {_selectedYear} vs first {_summary.PrevMonthDaysCompared} days of previous month" 
                                            : "Like-for-like comparison against previous period";
                                        <span class="badge @(_summary.DuesMomGrowth >= 0 ? "bg-success-subtle text-success border border-success-subtle" : "bg-danger-subtle text-danger border border-danger-subtle") fw-bold" style="cursor: default;" @onclick:stopPropagation="true" title="@mtdTitle">
                                            @(_summary.DuesMomGrowth >= 0 ? "▲ +" : "▼ ")@_summary.DuesMomGrowth.ToString("N1")% MoM
                                        </span>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
    </header>

    <!-- MAIN DISPLAY AREA (GRAPHICAL OR TABLE) -->
    <div class="income-content-scroll flex-grow-1 overflow-auto p-4">
        @if (_isLoading)
        {
            <div class="d-flex justify-content-center align-items-center py-5">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading income data...</span>
                </div>
            </div>
        }
        else if (_activeView == "chart")
        {
            <!-- GRAPHICAL VIEW: VISUAL BREAKDOWN CHARTS -->
            <div class="row g-4 mb-4">
                <!-- STREAM COMPARISON CHART (MULTI-YEAR OVERLAY IF SELECTED) -->
                <div class="col-lg-8">
                    <div class="card border-0 shadow-sm rounded-4 bg-white h-100">
                        <div class="card-header bg-white border-0 py-3 px-4 d-flex justify-content-between align-items-center">
                            <div>
                                <h5 class="fw-black text-dark mb-0">
                                    @(_summary?.ComparisonYear > 0 ? $"YEAR OVER YEAR COMPARISON ({_selectedYear} vs {_summary.ComparisonYear})" : "DAILY REVENUE BY STREAM")
                                </h5>
                                <span class="text-muted small">
                                    @(_summary?.ComparisonYear > 0 ? $"Comparing day-by-day revenue trends between {_selectedYear} and {_summary.ComparisonYear}" : "Daily comparison of Bar Sales vs. Lottery Commissions vs. Dues")
                                </span>
                            </div>
                        </div>
                        <div class="card-body p-4 position-relative" style="height: 380px;">
                            <canvas id="incomeComparisonChart"></canvas>
                        </div>
                    </div>
                </div>

                <!-- REVENUE SHARE DONUT CHART -->
                <div class="col-lg-4">
                    <div class="card border-0 shadow-sm rounded-4 bg-white h-100">
                        <div class="card-header bg-white border-0 py-3 px-4">
                            <h5 class="fw-black text-dark mb-0">REVENUE CONTRIBUTION</h5>
                            <span class="text-muted small">Share of total monthly income (@_selectedYear)</span>
                        </div>
                        <div class="card-body p-4 position-relative d-flex justify-content-center align-items-center" style="height: 380px;">
                            <canvas id="incomeShareChart"></canvas>
                        </div>
                    </div>
                </div>
            </div>
        }
        else if (_activeView == "compare")
        {
            <!-- PERIOD COMPARISON VIEW: SIDE-BY-SIDE ANALYTICS & VARIANCE BREAKDOWN -->
            <div class="row g-4 mb-4">
                <!-- STREAM COMPARISON BAR CHART -->
                <div class="col-lg-7">
                    <div class="card border-0 shadow-sm rounded-4 bg-white h-100">
                        <div class="card-header bg-white border-0 py-3 px-4 d-flex justify-content-between align-items-center flex-wrap gap-2">
                            <div>
                                <h5 class="fw-black text-dark mb-0">STREAM PERFORMANCE COMPARISON</h5>
                                <span class="text-muted small">
                                    @(_selectedMonth == 0 ? $"Full Year Comparison ({_selectedYear} vs {(_compareYear > 0 ? _compareYear : _selectedYear - 1)})" : $"{System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(_selectedMonth)} Comparison ({_selectedYear} vs {(_compareYear > 0 ? _compareYear : "Prior Period")})")
                                </span>
                            </div>

                            <!-- CHART CONTROLS: BASE COMPARISON YEAR SELECTOR -->
                            <div class="d-flex align-items-center gap-2 flex-wrap ms-auto">
                                <div class="input-group input-group-sm shadow-sm" style="width: 170px;">
                                    <span class="input-group-text bg-light text-muted fw-bold px-2">Compare From:</span>
                                    <select class="form-select border-start-0 fw-bold px-2" @bind="_compareYear" @bind:after="OnCompareControlsChanged">
                                        <option value="0">Prior Year (@(_selectedYear - 1))</option>
                                        @foreach (var y in _availableYears.Where(y => y < _selectedYear))
                                        {
                                            <option value="@y">From Year @y</option>
                                        }
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="card-body p-4 position-relative" style="height: 380px;">
                            <canvas id="incomeCompareChart"></canvas>
                        </div>
                    </div>
                </div>

                <!-- STREAM VARIANCE BREAKDOWN TABLE -->
                <div class="col-lg-5">
                    <div class="card border-0 shadow-sm rounded-4 bg-white h-100">
                        <div class="card-header bg-white border-0 py-3 px-4 d-flex justify-content-between align-items-center flex-wrap gap-2">
                            <div>
                                <h5 class="fw-black text-dark mb-0">REVENUE VARIANCE BREAKDOWN</h5>
                                <span class="text-muted small">
                                    Multi-year revenue trajectory (@(_summary?.MultiYearSummaries.Keys.Any() == true ? string.Join(" → ", _summary.MultiYearSummaries.Keys.OrderBy(y => y)) : $"{_selectedYear}"))
                                </span>
                            </div>

                            <!-- VARIANCE MODE DISPLAY SELECTOR -->
                            <div class="input-group input-group-sm shadow-sm ms-auto" style="width: 175px;">
                                <span class="input-group-text bg-light text-muted fw-bold px-2">Variance:</span>
                                <select class="form-select border-start-0 fw-bold px-2" @bind="_varianceMode">
                                    <option value="netDollar">Net $ Change</option>
                                    <option value="netPercent">Net % Change</option>
                                    <option value="combined">Net $ & %</option>
                                    <option value="yoyDollar">Latest YoY $</option>
                                    <option value="yoyPercent">Latest YoY %</option>
                                </select>
                            </div>
                        </div>
                        <div class="card-body p-0">
                            @if (_summary != null && _summary.MultiYearSummaries.Any())
                            {
                                var activeYears = _summary.MultiYearSummaries.Keys.OrderBy(y => y).ToList();
                                var startYear = activeYears.First();
                                var endYear = activeYears.Last();
                                var priorYear = activeYears.Count > 1 ? activeYears[activeYears.Count - 2] : startYear;

                                var startDto = _summary.MultiYearSummaries[startYear];
                                var endDto = _summary.MultiYearSummaries[endYear];
                                var priorDto = _summary.MultiYearSummaries[priorYear];

                                <div class="table-responsive">
                                    <table class="table table-hover align-middle mb-0">
                                        <thead class="bg-light text-muted extra-small uppercase-tracking">
                                            <tr>
                                                <th class="ps-4">REVENUE STREAM</th>
                                                @foreach (var y in activeYears)
                                                {
                                                    <th class="text-end">@y</th>
                                                }
                                                <th class="text-end pe-4">VARIANCE</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr>
                                                <td class="ps-4 fw-bold text-dark">
                                                    <i class="bi bi-cup-straw text-primary me-2"></i>Bar Sales
                                                </td>
                                                @foreach (var y in activeYears)
                                                {
                                                    <td class="text-end fw-bold">@_summary.MultiYearSummaries[y].TotalBarSales.ToString("C0")</td>
                                                }
                                                <td class="text-end pe-4">
                                                    <span class="badge @(IsVariancePositive(startDto.TotalBarSales, endDto.TotalBarSales, priorDto.TotalBarSales) ? "bg-success-subtle text-success border border-success-subtle" : "bg-danger-subtle text-danger border border-danger-subtle") fw-bold">
                                                        @FormatVarianceBadge(startDto.TotalBarSales, endDto.TotalBarSales, priorDto.TotalBarSales)
                                                    </span>
                                                </td>
                                            </tr>
                                            <tr>
                                                <td class="ps-4 fw-bold text-dark">
                                                    <i class="bi bi-ticket-detailed text-danger me-2"></i>Lottery Net
                                                </td>
                                                @foreach (var y in activeYears)
                                                {
                                                    <td class="text-end fw-bold">@_summary.MultiYearSummaries[y].TotalLotteryCommissions.ToString("C0")</td>
                                                }
                                                <td class="text-end pe-4">
                                                    <span class="badge @(IsVariancePositive(startDto.TotalLotteryCommissions, endDto.TotalLotteryCommissions, priorDto.TotalLotteryCommissions) ? "bg-success-subtle text-success border border-success-subtle" : "bg-danger-subtle text-danger border border-danger-subtle") fw-bold">
                                                        @FormatVarianceBadge(startDto.TotalLotteryCommissions, endDto.TotalLotteryCommissions, priorDto.TotalLotteryCommissions)
                                                    </span>
                                                </td>
                                            </tr>
                                            <tr>
                                                <td class="ps-4 fw-bold text-dark">
                                                    <i class="bi bi-wallet2 text-info me-2"></i>Membership Dues
                                                </td>
                                                @foreach (var y in activeYears)
                                                {
                                                    <td class="text-end fw-bold">@_summary.MultiYearSummaries[y].TotalMembershipDues.ToString("C0")</td>
                                                }
                                                <td class="text-end pe-4">
                                                    <span class="badge @(IsVariancePositive(startDto.TotalMembershipDues, endDto.TotalMembershipDues, priorDto.TotalMembershipDues) ? "bg-success-subtle text-success border border-success-subtle" : "bg-danger-subtle text-danger border border-danger-subtle") fw-bold">
                                                        @FormatVarianceBadge(startDto.TotalMembershipDues, endDto.TotalMembershipDues, priorDto.TotalMembershipDues)
                                                    </span>
                                                </td>
                                            </tr>
                                            <tr class="table-light fw-black border-top">
                                                <td class="ps-4 text-uppercase">Total Combined</td>
                                                @foreach (var y in activeYears)
                                                {
                                                    <td class="text-end text-primary">@_summary.MultiYearSummaries[y].CombinedTotalIncome.ToString("C0")</td>
                                                }
                                                <td class="text-end pe-4">
                                                    <span class="badge @(IsVariancePositive(startDto.CombinedTotalIncome, endDto.CombinedTotalIncome, priorDto.CombinedTotalIncome) ? "bg-success text-white" : "bg-danger text-white") fw-black px-2 py-1">
                                                        @FormatVarianceBadge(startDto.CombinedTotalIncome, endDto.CombinedTotalIncome, priorDto.CombinedTotalIncome)
                                                    </span>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
        else
        {
            <!-- DETAILED LEDGER TABLE VIEW -->
            <div class="card border-0 shadow-sm rounded-4 bg-white">
                <div class="card-header bg-white border-0 py-3 px-4 d-flex justify-content-between align-items-center flex-wrap gap-2 sticky-top z-2">
                    <h5 class="fw-black text-dark mb-0">CHRONOLOGICAL INCOME LEDGER</h5>
                    <div class="d-flex gap-2 align-items-center">
                        <select class="form-select form-select-sm fw-bold rounded-pill" @bind="_selectedStreamFilter" style="width: 180px;">
                            <option value="All">All Income Streams</option>
                            <option value="Bar Sales">Bar Sales</option>
                            <option value="Lottery">Lottery</option>
                            <option value="Membership Dues">Membership Dues</option>
                        </select>
                    </div>
                </div>
                <div class="card-body p-0">
                    @if (FilteredLedgerEntries.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="bg-light text-muted extra-small uppercase-tracking sticky-top z-1">
                                    <tr>
                                        <th class="ps-4">DATE</th>
                                        <th>INCOME STREAM</th>
                                        <th>SHIFT</th>
                                        <th>DESCRIPTION</th>
                                        <th class="text-end pe-4">AMOUNT</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var entry in FilteredLedgerEntries)
                                    {
                                        <tr style="cursor: pointer;" @onclick="() => NavigateToUrl(entry.SourceUrl)">
                                            <td class="ps-4 fw-bold text-secondary">@entry.Date.ToString("MMM dd, yyyy (ddd)")</td>
                                            <td>
                                                @if (entry.Stream == "Bar Sales")
                                                {
                                                    <span class="badge bg-primary text-white px-3 py-1 rounded-pill fw-bold">Bar Sales</span>
                                                }
                                                else if (entry.Stream == "Lottery")
                                                {
                                                    <span class="badge bg-danger text-white px-3 py-1 rounded-pill fw-bold">
                                                        <i class="bi bi-ticket-detailed me-1"></i>Lottery
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-info text-white px-3 py-1 rounded-pill fw-bold">Dues</span>
                                                }
                                            </td>
                                            <td>
                                                @if (entry.IsFullDayShift || entry.Shift == "Full Day")
                                                {
                                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1 rounded-2 font-monospace fw-bold" style="font-size: 0.72rem;">
                                                        <i class="bi bi-arrow-repeat me-1"></i>FULL DAY
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary bg-opacity-10 text-dark border px-2 py-1 rounded-2 font-monospace fw-bold" style="font-size: 0.72rem;">
                                                        @entry.Shift
                                                    </span>
                                                }
                                            </td>
                                            <td class="fw-semibold text-dark">@entry.Description</td>
                                            <td class="text-end pe-4 fw-black text-success fs-6">@entry.Amount.ToString("C2")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5 text-muted">
                            <i class="bi bi-inbox fs-1 d-block mb-2 opacity-50"></i>
                            <p class="mb-0">No income entries found for the selected period or stream filter.</p>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</div>

@code {
    private int _selectedMonth = DateTime.Now.Month; // Default to current month
    private int _selectedYear = DateTime.Now.Year;
    private List<int> _availableYears = new() { DateTime.Now.Year };
    private IncomeAuditSummaryDto? _summary;
    private bool _isLoading = true;
    private bool _showAllWarnings = false;
    private bool _dismissAuditBanner = false;
    private string _selectedStreamFilter = "All";
    private string _activeView = "chart";

    private string _compareLayout = "separated"; // "separated" or "stacked"
    private int _compareYear = 0; // 0 = Prior Period, or specific comparison year (e.g. 2025)
    private string _varianceMode = "netDollar"; // "netDollar", "netPercent", "combined", "yoyDollar", "yoyPercent"

    private string FormatVarianceBadge(decimal startVal, decimal endVal, decimal priorYearVal)
    {
        if (_varianceMode == "netPercent")
        {
            decimal pct = startVal > 0 ? ((endVal - startVal) / startVal) * 100m : 0m;
            return (pct >= 0 ? "▲ +" : "▼ ") + pct.ToString("N1") + "%";
        }
        else if (_varianceMode == "combined")
        {
            decimal diff = endVal - startVal;
            decimal pct = startVal > 0 ? (diff / startVal) * 100m : 0m;
            return $"{(diff >= 0 ? "▲ +" : "▼ ")}{diff.ToString("C0")} ({(pct >= 0 ? "+" : "")}{pct.ToString("N1")}%)";
        }
        else if (_varianceMode == "yoyDollar")
        {
            decimal yoyDiff = endVal - priorYearVal;
            return (yoyDiff >= 0 ? "▲ +" : "▼ ") + yoyDiff.ToString("C0") + " YoY";
        }
        else if (_varianceMode == "yoyPercent")
        {
            decimal yoyPct = priorYearVal > 0 ? ((endVal - priorYearVal) / priorYearVal) * 100m : 0m;
            return (yoyPct >= 0 ? "▲ +" : "▼ ") + yoyPct.ToString("N1") + "% YoY";
        }
        else
        {
            decimal diff = endVal - startVal;
            return (diff >= 0 ? "▲ +" : "▼ ") + diff.ToString("C0");
        }
    }

    private bool IsVariancePositive(decimal startVal, decimal endVal, decimal priorYearVal)
    {
        if (_varianceMode == "yoyDollar" || _varianceMode == "yoyPercent")
        {
            return endVal >= priorYearVal;
        }
        return endVal >= startVal;
    }

    private IEnumerable<IncomeStreamEntryDto> FilteredLedgerEntries =>
        _summary?.LedgerEntries.Where(e => _selectedStreamFilter == "All" || e.Stream == _selectedStreamFilter) ?? Enumerable.Empty<IncomeStreamEntryDto>();

    protected override async Task OnInitializedAsync()
    {
        _isFullYear = false;
        if (_selectedMonth <= 0 || _selectedMonth > 12)
        {
            _selectedMonth = DateTime.Now.Month;
        }

        try
        {
            _availableYears = await FinancialService.GetAvailableYearsAsync();
            if (!_availableYears.Contains(_selectedYear))
            {
                _availableYears.Add(_selectedYear);
                _availableYears = _availableYears.OrderByDescending(y => y).ToList();
            }
        }
        catch { }

        await LoadData();
    }

    private async Task LoadData()
    {
        _isLoading = true;
        StateHasChanged();

        DateTime startDate;
        DateTime endDate;

        if (_isFullYear || _selectedMonth == 0)
        {
            // Full Year (Jan 1 to Dec 31)
            _selectedMonth = 0;
            startDate = new DateTime(_selectedYear, 1, 1);
            endDate = new DateTime(_selectedYear, 12, 31);
        }
        else
        {
            // Specific Month
            startDate = new DateTime(_selectedYear, _selectedMonth, 1);
            endDate = startDate.AddMonths(1).AddDays(-1);
        }

        int targetCompYear = _compareYear > 0 ? _compareYear : (_selectedYear - 1);
        _summary = await FinancialService.GetIncomeSummaryWithAuditAsync(startDate, endDate, targetCompYear);
        _isLoading = false;
        StateHasChanged();

        if (_activeView == "chart" || _activeView == "compare")
        {
            await Task.Delay(100);
            await RenderChartsAsync();
        }
    }

    private async Task SetView(string view)
    {
        _activeView = view;
        StateHasChanged();
        if (_activeView == "chart" || _activeView == "compare")
        {
            await Task.Delay(100);
            await RenderChartsAsync();
        }
    }

    private bool _isFullYear = false;

    private async Task SetFullYearMode()
    {
        _isFullYear = true;
        _selectedMonth = 0;
        await LoadData();
    }

    private async Task SetMonthMode()
    {
        _isFullYear = false;
        if (_selectedMonth <= 0 || _selectedMonth > 12) _selectedMonth = DateTime.Now.Month;
        await LoadData();
    }

    private async Task SetCompareLayout(string layout)
    {
        _compareLayout = layout;
        StateHasChanged();
        if (_activeView == "compare")
        {
            await Task.Delay(50);
            await RenderChartsAsync();
        }
    }

    private async Task OnCompareControlsChanged()
    {
        await LoadData();
    }

    private async Task RenderChartsAsync()
    {
        if (_summary == null) return;

        try
        {
            if (_activeView == "compare")
            {
                var yearList = _summary.MultiYearSummaries.Keys.OrderBy(y => y).ToList();
                if (!yearList.Any()) yearList.Add(_selectedYear);

                var colorPalette = new[] { "#6c757d", "#0dcaf0", "#0d6efd", "#198754", "#ffc107", "#6f42c1" };
                var bgPalette = new[] { "rgba(108, 117, 125, 0.75)", "rgba(13, 202, 240, 0.75)", "rgba(13, 110, 253, 0.85)", "rgba(25, 135, 84, 0.85)", "rgba(255, 193, 7, 0.85)", "rgba(111, 66, 193, 0.85)" };

                if (_selectedMonth == 0 || _isFullYear)
                {
                    // FULL YEAR VIEW: 12 MONTHS ON X-AXIS
                    var months = new[] { "Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec" };
                    var compareYearDatasets = new List<object>();

                    for (int i = 0; i < yearList.Count; i++)
                    {
                        int y = yearList[i];
                        var yDto = _summary.MultiYearSummaries[y];
                        var color = colorPalette[i % colorPalette.Length];
                        var bg = bgPalette[i % bgPalette.Length];

                        compareYearDatasets.Add(new
                        {
                            label = $"{y} Total Revenue",
                            data = yDto.MonthlyTotalIncome,
                            color = color,
                            bg = bg,
                            stack = (string?)null
                        });
                    }

                    var compareConfig = new
                    {
                        type = "bar",
                        labels = months,
                        datasets = compareYearDatasets.ToArray()
                    };

                    await JSRuntime.InvokeVoidAsync("financialCharts.renderChart", "incomeCompareChart", compareConfig);
                }
                else
                {
                    // SINGLE MONTH VIEW: REVENUE STREAMS ON X-AXIS
                    var monthName = System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetAbbreviatedMonthName(_selectedMonth);
                    var streamLabels = new[] { "Bar Sales", "Lottery Net", "Membership Dues", "Total Combined" };
                    var compareMonthDatasets = new List<object>();

                    for (int i = 0; i < yearList.Count; i++)
                    {
                        int y = yearList[i];
                        var yDto = _summary.MultiYearSummaries[y];
                        var color = colorPalette[i % colorPalette.Length];
                        var bg = bgPalette[i % bgPalette.Length];

                        int mIdx = _selectedMonth - 1;
                        decimal barVal = (mIdx >= 0 && mIdx < 12) ? yDto.MonthlyBarSales[mIdx] : 0m;
                        decimal lotVal = (mIdx >= 0 && mIdx < 12) ? yDto.MonthlyLotteryCommissions[mIdx] : 0m;
                        decimal duesVal = (mIdx >= 0 && mIdx < 12) ? yDto.MonthlyMembershipDues[mIdx] : 0m;
                        decimal totalVal = barVal + lotVal + duesVal;

                        compareMonthDatasets.Add(new
                        {
                            label = $"{monthName} {y}",
                            data = new[] { barVal, lotVal, duesVal, totalVal },
                            color = color,
                            bg = bg,
                            stack = (string?)null
                        });
                    }

                    var compareConfig = new
                    {
                        type = "bar",
                        labels = streamLabels,
                        datasets = compareMonthDatasets.ToArray()
                    };

                    await JSRuntime.InvokeVoidAsync("financialCharts.renderChart", "incomeCompareChart", compareConfig);
                }
                return;
            }

            int dataPointsCount;
            bool isFullYear = _selectedMonth == 0;
            object[] labels;

            if (isFullYear)
            {
                dataPointsCount = 12;
                labels = new object[] { "Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec" };
            }
            else
            {
                dataPointsCount = DateTime.DaysInMonth(_selectedYear, _selectedMonth);
                labels = Enumerable.Range(1, dataPointsCount)
                    .Select(d => new object[] { $"{_selectedMonth}/{d}", new DateTime(_selectedYear, _selectedMonth, d).ToString("ddd") })
                    .ToArray();
            }

            var barSalesDayData = new decimal[dataPointsCount];
            var barSalesNightData = new decimal[dataPointsCount];
            var barSalesFullDayData = new decimal[dataPointsCount];
            var lotteryData = new decimal[dataPointsCount];
            var duesData = new decimal[dataPointsCount];

            foreach (var entry in _summary.LedgerEntries)
            {
                int index = isFullYear ? (entry.Date.Month - 1) : (entry.Date.Day - 1);
                if (index >= 0 && index < dataPointsCount)
                {
                    var shift = string.IsNullOrWhiteSpace(entry.Shift) ? "Day" : entry.Shift;
                    
                    if (entry.Stream == "Bar Sales")
                    {
                        if (entry.IsFullDayShift || shift.Equals("Full Day", StringComparison.OrdinalIgnoreCase))
                            barSalesFullDayData[index] += entry.Amount;
                        else if (shift.Equals("Night", StringComparison.OrdinalIgnoreCase))
                            barSalesNightData[index] += entry.Amount;
                        else
                            barSalesDayData[index] += entry.Amount;
                    }
                    else if (entry.Stream == "Lottery")
                    {
                        lotteryData[index] += entry.Amount;
                    }
                    else if (entry.Stream == "Membership Dues")
                    {
                        duesData[index] += entry.Amount;
                    }
                }
            }

            var streamDatasets = new List<object>
            {
                new { label = "Bar Sales (Day Shift)", data = barSalesDayData, backgroundColor = "#0d6efd" },
                new { label = "Bar Sales (Night Shift)", data = barSalesNightData, backgroundColor = "#0a58ca" }
            };

            if (barSalesFullDayData.Any(v => v > 0))
            {
                streamDatasets.Add(new { label = "Bar Sales (Full Day Shift)", data = barSalesFullDayData, backgroundColor = "#4f46e5" });
            }

            streamDatasets.Add(new { label = "Lottery Commissions", data = lotteryData, backgroundColor = "#dc3545" });
            streamDatasets.Add(new { label = "Membership Dues", data = duesData, backgroundColor = "#0dcaf0" });

            var comparisonConfig = new
            {
                type = "bar",
                data = new
                {
                    labels = labels,
                    datasets = streamDatasets.ToArray()
                },
                options = new
                {
                    responsive = true,
                    maintainAspectRatio = false,
                    plugins = new
                    {
                        legend = new { position = "top" },
                        tooltip = new { mode = "index", intersect = false }
                    },
                    scales = new
                    {
                        x = new { stacked = true },
                        y = new { stacked = true, beginAtZero = true }
                    }
                }
            };

            await JSRuntime.InvokeVoidAsync("renderChart", "incomeComparisonChart", comparisonConfig);

            // DONUT CHART FOR REVENUE SHARE
            var shareConfig = new
            {
                type = "doughnut",
                data = new
                {
                    labels = new[] { "Bar Sales", "Lottery Commissions", "Membership Dues" },
                    datasets = new[]
                    {
                        new
                        {
                            data = new[] { _summary.TotalBarSales, _summary.TotalLotteryCommissions, _summary.TotalMembershipDues },
                            backgroundColor = new[] { "#0d6efd", "#dc3545", "#0dcaf0" }
                        }
                    }
                },
                options = new
                {
                    responsive = true,
                    maintainAspectRatio = false
                }
            };

            await JSRuntime.InvokeVoidAsync("renderChart", "incomeShareChart", shareConfig);
        }
        catch { }
    }

    private void NavigateToUrl(string url)
    {
        if (!string.IsNullOrWhiteSpace(url))
        {
            Navigation.NavigateTo(url);
        }
    }
}
