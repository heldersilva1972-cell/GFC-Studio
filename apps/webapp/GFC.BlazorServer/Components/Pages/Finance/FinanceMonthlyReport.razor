@page "/finance/report/{Month:int}/{Year:int}"
@using GFC.Core.Interfaces
@using GFC.Core.Models.Finance
@inject IFinanceService FinanceService
@inject NavigationManager NavManager
@inject IJSRuntime JSRuntime
@layout EmptyLayout

<div class="report-container">
    <!-- Fixed Action Bar -->
    <div class="action-bar-fixed no-print d-flex justify-content-center align-items-center gap-3 py-3 border-bottom shadow-sm">
        <button class="btn btn-outline-secondary rounded-pill px-4 bg-white" @onclick="GoBack">
            <i class="bi bi-arrow-left me-2"></i> Back to Finance
        </button>
        <button class="btn btn-primary rounded-pill px-4 shadow-sm" @onclick="PrintReport">
            <i class="bi bi-printer me-2"></i> Print Official Report
        </button>
    </div>

    <div class="report-paper">
        <!-- Official Report Header -->
        <div class="report-header d-flex justify-content-between align-items-end mb-4">
            <div class="text-start">
                <div class="h1 fw-black text-dark mb-0 letter-spacing-2">GFC STUDIO</div>
                <div class="small text-muted text-uppercase fw-bold">Financial Management System</div>
            </div>
            <div class="text-end">
                <div class="h3 fw-black mb-0">EXPENDITURE REPORT</div>
                <div class="text-muted fw-bold">@ReportDate.ToString("MMMM yyyy")</div>
                <div class="small text-muted">Generated: @DateTime.Now.ToString("MMM dd, yyyy @ HH:mm")</div>
            </div>
        </div>

        <!-- Executive Summary -->
        <div class="summary-grid mb-5">
            <div class="summary-box">
                <div class="label">TOTAL OBLIGATIONS</div>
                <div class="value">@TotalObligations.ToString("C")</div>
                <div class="desc">Combined total of all billed invoices</div>
            </div>
            <div class="summary-box">
                <div class="label">SETTLED AMOUNT</div>
                <div class="value text-success">@TotalSettled.ToString("C")</div>
                <div class="desc">Payments processed to date</div>
            </div>
            <div class="summary-box highlight">
                <div class="label">OUTSTANDING BALANCE</div>
                <div class="value">@OutstandingBalance.ToString("C")</div>
                <div class="desc">Remaining liability for period</div>
            </div>
        </div>

        <div class="row mb-5">
            <!-- Category Breakdown -->
            <div class="col-6 pe-4 border-end">
                <div class="section-title">EXPENDITURE BY CATEGORY</div>
                <table class="table table-sm border-0 align-middle">
                    <thead class="bg-light">
                        <tr>
                            <th class="ps-2">CATEGORY</th>
                            <th class="text-end pe-2">AMOUNT</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var cat in CategorySummaries.OrderByDescending(c => c.TotalAmount))
                        {
                            <tr>
                                <td class="ps-2 py-2">
                                    <div class="fw-bold">@cat.Name</div>
                                    <div class="progress mt-1" style="height: 4px;">
                                        <div class="progress-bar" style="width: @((cat.TotalAmount / TotalObligations * 100).ToString("N0"))%; background-color: @cat.Color;"></div>
                                    </div>
                                </td>
                                <td class="text-end pe-2 fw-black">@cat.TotalAmount.ToString("C")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Distribution Info -->
            <div class="col-6 ps-4">
                <div class="section-title">SETTLEMENT SUMMARY</div>
                <div class="p-4 bg-light rounded-4 text-center border">
                    @{
                        var progress = TotalObligations > 0 ? (double)(TotalSettled / TotalObligations * 100) : 0;
                    }
                    <div class="h2 fw-black mb-1">@progress.ToString("N1")%</div>
                    <div class="small text-muted text-uppercase fw-bold mb-3">Of Obligations Settled</div>
                    <div class="progress rounded-pill mb-3" style="height: 12px;">
                        <div class="progress-bar bg-success" style="width: @progress%"></div>
                    </div>
                    <div class="small text-muted italic">All calculations based on records for @ReportDate.ToString("MMMM yyyy")</div>
                </div>
            </div>
        </div>

        <!-- Detailed Transaction Log -->
        <div class="section-title mb-3">DETAILED TRANSACTION LOG</div>
        <table class="table table-report table-sm align-middle">
            <thead>
                <tr>
                    <th style="width: 25%;">VENDOR</th>
                    <th style="width: 15%;">CATEGORY</th>
                    <th style="width: 15%;">DUE DATE</th>
                    <th style="width: 10%;">STATUS</th>
                    <th style="width: 11%;" class="text-end">TOTAL</th>
                    <th style="width: 11%;" class="text-end">PAID</th>
                    <th style="width: 13%;" class="text-end">BALANCE</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var bill in AllBills.OrderBy(b => b.DueDate))
                {
                    <tr>
                        <td class="fw-black">@bill.Vendor?.Name</td>
                        <td>
                            <span class="badge px-2 py-1" style="font-size: 0.6rem; background-color: @(bill.Category?.Color ?? "#cbd5e1"); color: white;">@(bill.Category?.Name ?? "Uncategorized")</span>
                        </td>
                        <td class="small">@bill.DueDate.ToString("MMM dd, yyyy")</td>
                        <td class="small fw-bold">
                            @if (bill.Status != "Paid" && bill.IsOverdue)
                            {
                                <span class="text-danger">OVERDUE</span>
                            }
                            else
                            {
                                @bill.Status.ToUpper()
                            }
                        </td>
                        <td class="text-end">@bill.OriginalAmount.ToString("N2")</td>
                        <td class="text-end text-success">@bill.Payments.Sum(p => p.AmountPaid).ToString("N2")</td>
                        <td class="text-end fw-black">@bill.BalanceRemaining.ToString("N2")</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <td colspan="4" class="text-end pe-4 fw-black">GRAND TOTALS (USD)</td>
                    <td class="text-end fw-black border-top border-dark">@TotalObligations.ToString("N2")</td>
                    <td class="text-end fw-black border-top border-dark text-success">@TotalSettled.ToString("N2")</td>
                    <td class="text-end fw-black border-top border-dark text-danger">@OutstandingBalance.ToString("N2")</td>
                </tr>
            </tfoot>
        </table>

        <!-- Footer -->
        <div class="report-footer mt-5 pt-4 text-center">
            <div class="fw-bold mb-1">CERTIFIED MONTHLY REPORT</div>
            <div class="text-muted small">This document is a true representation of the GFC Studio financial accounts for the period indicated.</div>
            <div class="mt-3 text-muted" style="font-size: 0.6rem;">&copy; @DateTime.Now.Year GFC STUDIO. | Report ID: GFC-@Year-@Month-@DateTime.Now.Ticks.ToString().Substring(10)</div>
        </div>
    </div>
</div>

<style>
    .report-container {
        background: #f1f5f9;
        min-height: 100vh;
        width: 100%;
        margin: 0;
        padding: 100px 0 60px 0;
        font-family: 'Inter', system-ui, -apple-system, sans-serif;
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .action-bar-fixed {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        z-index: 1000;
        background: rgba(241, 245, 249, 0.85);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
    }

    .report-paper {
        background: white;
        width: 8.5in;
        min-height: 11in;
        margin: 0 auto;
        padding: 0.2in 0.75in 0.6in 0.75in;
        box-shadow: 0 10px 30px rgba(0,0,0,0.1);
        color: #1e293b;
        position: relative;
    }

    .letter-spacing-2 { letter-spacing: 2px; }
    
    .section-title {
        font-size: 0.65rem;
        font-weight: 900;
        letter-spacing: 1.5px;
        color: #64748b;
        border-bottom: 2px solid #e2e8f0;
        padding-bottom: 0.5rem;
        margin-bottom: 1.5rem;
    }

    .summary-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1rem;
    }

    .summary-box {
        border: 1px solid #e2e8f0;
        padding: 1.25rem;
        border-radius: 12px;
        text-align: center;
    }

    .summary-box.highlight {
        background: #fff1f2;
        color: #991b1b;
        border: 2px solid #fecaca;
    }

    .summary-box .label {
        font-size: 0.6rem;
        font-weight: 900;
        letter-spacing: 1px;
        opacity: 0.7;
        margin-bottom: 0.5rem;
    }

    .summary-box .value {
        font-size: 1.5rem;
        font-weight: 900;
    }

    .summary-box .desc {
        font-size: 0.55rem;
        opacity: 0.6;
        margin-top: 0.5rem;
    }

    .table-report {
        width: 100%;
        font-size: 0.75rem;
    }

    .table-report thead th {
        background: #f8fafc;
        padding: 0.75rem 0.5rem;
        border-bottom: 2px solid #e2e8f0;
        font-weight: 900;
        color: #475569;
    }

    .table-report tbody td {
        padding: 0.75rem 0.5rem;
        border-bottom: 1px solid #f1f5f9;
    }

    .border-double {
        border-bottom: 3px double #000 !important;
    }

    .report-footer {
        border-top: 1px solid #e2e8f0;
        font-size: 0.7rem;
    }

    .no-print-view { display: none; }

    .print-page-number {
        position: fixed;
        bottom: 0.3in;
        left: 0.75in;
        right: 0.75in;
        display: none;
        justify-content: space-between;
        font-size: 0.65rem;
        color: #475569;
        border-top: 1px solid #e2e8f0;
        padding-top: 0.1in;
        z-index: 9999;
    }

    @@media print {
        .report-container { background: white !important; padding: 0 !important; }
        .report-paper { 
            box-shadow: none !important; 
            margin: 0 !important; 
            padding: 0.1in 0.5in 0.8in 0.5in !important;
            width: 100% !important;
        }
        .no-print { display: none !important; }
        .print-page-number { display: flex !important; }
        
        body { 
            margin: 0; padding: 0; 
            counter-reset: page;
        }

        .page-counter::after {
            counter-increment: page;
            content: "Page " counter(page);
        }
        
        .table-report { page-break-inside: auto; }
        .table-report tr { page-break-inside: avoid; page-break-after: auto; }
        .table-report thead { display: table-header-group; }
        
        /* Force color printing */
        .summary-box.highlight {
            background-color: #fff1f2 !important;
            color: #991b1b !important;
            border: 2px solid #fecaca !important;
            -webkit-print-color-adjust: exact;
        }
        .text-danger { color: #b91c1c !important; }
        .text-success { color: #166534 !important; }
        .bg-success { background-color: #22c55e !important; }
    }
</style>

@code {
    [Parameter] public int Month { get; set; }
    [Parameter] public int Year { get; set; }

    private DateTime ReportDate => new DateTime(Year, Month, 1);
    private List<FinanceBill> AllBills { get; set; } = new();
    private List<CategorySum> CategorySummaries { get; set; } = new();
    
    private decimal TotalObligations => AllBills.Sum(b => b.OriginalAmount);
    private decimal TotalSettled => AllBills.Sum(b => b.Payments.Sum(p => p.AmountPaid));
    private decimal OutstandingBalance => TotalObligations - TotalSettled;
    private decimal MaxCategoryAmount => CategorySummaries.Any() ? CategorySummaries.Max(c => c.TotalAmount) : 1;

    protected override async Task OnInitializedAsync()
    {
        // Fetch only bills RELEVANT to this specific month for the report
        AllBills = (await FinanceService.GetBillsForReportAsync(Month, Year)).ToList();

        // Calculate Category Summaries
        CategorySummaries = AllBills
            .GroupBy(b => new { b.CategoryId, Name = b.Category?.Name ?? "Uncategorized", Color = b.Category?.Color ?? "#cbd5e1" })
            .Select(g => new CategorySum 
            { 
                Name = g.Key.Name, 
                Color = g.Key.Color, 
                TotalAmount = g.Sum(b => b.OriginalAmount) 
            })
            .ToList();
    }

    private void GoBack() => NavManager.NavigateTo("/finance/bills");
    
    private async Task PrintReport()
    {
        await JSRuntime.InvokeVoidAsync("window.print");
    }

    private class CategorySum
    {
        public string Name { get; set; }
        public string Color { get; set; }
        public decimal TotalAmount { get; set; }
    }
}
