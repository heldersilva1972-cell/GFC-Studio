@page "/finance/club-events"
@using Microsoft.AspNetCore.Authorization
@using GFC.Core.Interfaces
@using GFC.Core.Models
@inject IClubEventRepository EventRepo
@inject IJSRuntime JS
@inject NavigationManager Navigation
@attribute [Authorize]

<PageTitle>Club Events Financials | GFC</PageTitle>

<style>
    .events-page {
        height: calc(100vh - 65px);
        background: #f8fafc;
        padding: 2rem;
        overflow-y: auto;
    }

    .container-max {
        max-width: 1400px;
        margin: 0 auto;
    }

    .header-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 2.5rem;
    }

    .page-title {
        font-size: 2.25rem;
        font-weight: 950;
        color: #0f172a;
        margin: 0;
        letter-spacing: -0.02em;
    }

    .btn-create {
        background: #3b82f6;
        color: white;
        padding: 0.8rem 1.5rem;
        border-radius: 16px;
        font-weight: 700;
        border: none;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 0.6rem;
        transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        box-shadow: 0 4px 12px rgba(59, 130, 246, 0.1);
    }

    .btn-create:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 20px -5px rgba(59, 130, 246, 0.2);
        background: #2563eb;
    }

    .event-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(400px, 1fr));
        gap: 2rem;
    }

    .event-card {
        background: white;
        border-radius: 32px;
        padding: 2rem;
        border: 1px solid #f1f5f9;
        box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.04);
        cursor: pointer;
        transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
        position: relative;
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
    }

    .event-card:hover {
        transform: scale(1.02) translateY(-5px);
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.1);
        border-color: #3b82f6;
    }

    .event-name {
        font-size: 1.5rem;
        font-weight: 900;
        color: #1e293b;
        letter-spacing: -0.01em;
    }

    .stats-tray {
        background: #f8fafc;
        border-radius: 20px;
        padding: 1rem;
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 0.5rem;
        border: 1px solid #f1f5f9;
    }

    .tray-item { display: flex; flex-direction: column; }
    .tray-label { font-size: 0.6rem; font-weight: 850; color: #94a3b8; text-transform: uppercase; margin-bottom: 0.25rem; }
    .tray-val { font-size: 1rem; font-weight: 900; }

    .chart-box {
        height: 80px;
        display: flex;
        align-items: flex-end;
        gap: 6px;
        padding-bottom: 0.5rem;
        border-bottom: 1px solid #f1f5f9;
    }

    .mini-bar {
        flex: 1;
        border-radius: 10px;
        height: 2px;
        transition: all 0.6s cubic-bezier(0.4, 0, 0.2, 1);
        position: relative;
    }

    .mini-bar:hover::after {
        content: attr(title);
        position: absolute;
        bottom: 100%;
        left: 50%;
        transform: translateX(-50%);
        background: #1e293b;
        color: white;
        padding: 4px 8px;
        border-radius: 6px;
        font-size: 0.6rem;
        white-space: nowrap;
        z-index: 10;
    }

    .balance-footer {
        background: #f0f7ff;
        border-radius: 20px;
        padding: 1rem 1.5rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        border: 1px solid #dbeafe;
    }

    .modal-backdrop {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        background: rgba(15, 23, 42, 0.4);
        backdrop-filter: blur(12px);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 1000;
    }

    .modal-content {
        background: white;
        border-radius: 32px;
        padding: 2.5rem;
        width: 100%;
        max-width: 500px;
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.3);
    }

    .form-group { margin-bottom: 1.5rem; }
    .form-label { display: block; font-size: 0.75rem; font-weight: 850; color: #64748b; text-transform: uppercase; margin-bottom: 0.5rem; }
    .form-input { width: 100%; padding: 0.9rem; border-radius: 14px; border: 2px solid #f1f5f9; font-weight: 700; transition: 0.2s; }
    .form-input:focus { outline: none; border-color: #3b82f6; box-shadow: 0 0 0 4px rgba(59, 130, 246, 0.1); }
</style>

<div class="events-page">
    <div class="container-max">
        <div class="header-bar">
            <div>
                <h1 class="page-title">Financial Ledgers</h1>
                <p style="color: #64748b; margin-top: 0.4rem; font-size: 1.1rem; font-weight: 500;">Multi-Year Financial Groups</p>
            </div>
            <div style="display: flex; gap: 1rem;">
                <button class="btn-create" style="background: white; color: #1e293b; border: 1px solid #e2e8f0;" @onclick="OpenSummaryModal">
                    <i class="fas fa-chart-bar"></i> Analytics
                </button>
                <button class="btn-create" @onclick="ShowNewEventModal">
                    <i class="fas fa-plus"></i> New Ledger
                </button>
            </div>
        </div>

        @if (events == null)
        {
            <div style="display: flex; justify-content: center; padding: 4rem;">
                <div class="spinner-border text-primary" role="status"></div>
            </div>
        }
        else if (!events.Any())
        {
            <div style="text-align: center; padding: 6rem 1rem; background: white; border-radius: 40px; border: 2px dashed #e2e8f0;">
                <div style="background: #f8fafc; width: 80px; height: 80px; border-radius: 100px; display: flex; align-items: center; justify-content: center; margin: 0 auto 1.5rem;">
                    <i class="fas fa-calendar-alt fa-2x" style="color: #cbd5e1;"></i>
                </div>
                <h2 style="color: #1e293b; font-weight: 900;">Establish Your First Ledger</h2>
                <p style="color: #94a3b8; max-width: 400px; margin: 0 auto 2rem;">Create a recurring master event to begin tracking year-over-year financial performance.</p>
                <button class="btn-create" style="margin: 0 auto;" @onclick="ShowNewEventModal">Initialize New Event</button>
            </div>
        }
        else
        {
            <div class="event-grid">
                @foreach (var group in events.GroupBy(e => e.EventGroup))
                {
                    var masterEvt = group.OrderByDescending(e => e.EventDate).First();
                    var currentYear = DateTime.Now.Year;
                    var allTrans = group.SelectMany(e => e.Transactions).Where(t => !t.IsDeleted).ToList();
                    
                    var cyInc = allTrans.Where(t => t.TransactionDate.Year == currentYear && t.Amount > 0 && t.Category != OpeningBalanceCategory && t.Description != "Opening Balance").Sum(t => t.Amount);
                    var cyExp = allTrans.Where(t => t.TransactionDate.Year == currentYear && t.Amount < 0 && t.Category != OpeningBalanceCategory && t.Description != "Opening Balance").Sum(t => t.Amount);
                    var cyNet = cyInc + cyExp;
                    var totalBal = allTrans.Sum(t => t.Amount);
                    
                    var yearlyStats = allTrans
                        .Where(t => t.Category != OpeningBalanceCategory && t.Description != "Opening Balance")
                        .GroupBy(t => t.TransactionDate.Year)
                        .Select(g => new { Year = g.Key, Net = g.Sum(t => t.Amount) })
                        .OrderBy(g => g.Year)
                        .ToList();

                    <div class="event-card" @onclick="() => NavigateToDetail(masterEvt.Id)">
                        <div style="display: flex; justify-content: space-between; align-items: center;">
                            <div>
                                <div class="event-name">@group.Key</div>
                                <span style="background: #eff6ff; color: #3b82f6; padding: 0.2rem 0.6rem; border-radius: 8px; font-size: 0.6rem; font-weight: 900; text-transform: uppercase;">Recurring Series</span>
                            </div>
                            <button @onclick="() => OpenSettings(masterEvt.Id)" @onclick:stopPropagation="true" style="width: 32px; height: 32px; border: none; background: #f8fafc; color: #94a3b8; border-radius: 10px; cursor: pointer;"><i class="fas fa-chevron-right"></i></button>
                        </div>

                        <div class="stats-tray">
                            <div class="tray-item">
                                <span class="tray-label">Income</span>
                                <span class="tray-val" style="color: #10b981;">@cyInc.ToString("C0")</span>
                            </div>
                            <div class="tray-item">
                                <span class="tray-label">Expenses</span>
                                <span class="tray-val" style="color: #ef4444;">@Math.Abs(cyExp).ToString("C0")</span>
                            </div>
                            <div class="tray-item">
                                <span class="tray-label">Profit</span>
                                <span class="tray-val" style="color: #6366f1;">@cyNet.ToString("C0")</span>
                            </div>
                        </div>

                        <div class="chart-box">
                            @foreach (var stat in yearlyStats.TakeLast(5))
                            {
                                var max = yearlyStats.Max(s => Math.Abs(s.Net));
                                if (max == 0) max = 1;
                                var pct = (int)(Math.Min(100, (Math.Abs(stat.Net) / max) * 100));
                                <div style="flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: flex-end; height: 100%;">
                                    <div class="mini-bar" title="@stat.Year: @stat.Net.ToString("C0")" 
                                         style="height: @(Math.Max(15, pct))%; width: 100%; background: @(stat.Net >= 0 ? "#10b981" : "#ef4444"); opacity: @(stat.Year == currentYear ? "1" : "0.3");">
                                    </div>
                                    <span style="font-size: 0.5rem; font-weight: 800; color: #94a3b8; margin-top: 4px;">@stat.Year.ToString().Substring(2)</span>
                                </div>
                            }
                        </div>

                        <div class="balance-footer">
                            <span style="font-size: 0.7rem; font-weight: 900; color: #3b82f6; text-transform: uppercase;">Total Liquidity</span>
                            <span style="font-size: 1.25rem; font-weight: 950; color: #1e3a8a;">@totalBal.ToString("C2")</span>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

@if (showModal)
{
    <div class="modal-backdrop" @onclick="CloseModal">
        <div class="modal-content" @onclick:stopPropagation>
            <h2 style="font-weight: 950; margin-bottom: 2rem; color: #0f172a;">Establish New Ledger</h2>
            
            <div class="form-group">
                <label class="form-label">Ledger Title</label>
                <input class="form-input" @bind="newEvt.EventName" placeholder="e.g. Annual Gala 2026" />
                <small style="color: #94a3b8; margin-top: 0.5rem; display: block;">The system handles year-over-year linking automatically.</small>
            </div>

            <div style="margin-bottom: 2rem; padding: 1.5rem; background: #f8fafc; border-radius: 20px; border: 1px solid #f1f5f9;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
                    <label class="form-label" style="margin: 0;">Connection Logic</label>
                    @if (!isCustomSeries)
                    {
                        <button style="border: none; background: none; color: #3b82f6; font-size: 0.7rem; font-weight: 800; cursor: pointer;" @onclick="() => isCustomSeries = true">OVERRIDE SERIES</button>
                    }
                </div>
                
                @if (isCustomSeries)
                {
                    <input class="form-input" @bind="newEvt.EventGroup" placeholder="Enter custom series name..." />
                }
                else
                {
                    <div style="display: flex; align-items: center; gap: 0.5rem; color: #64748b; font-size: 0.85rem;">
                        <i class="fas fa-link" style="color: #10b981;"></i>
                        <span>Auto-linking to: <strong>@(string.IsNullOrEmpty(newEvt.EventName) ? "--" : StripYear(newEvt.EventName))</strong></span>
                    </div>
                }
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1.5rem;">
                <div>
                    <label class="form-label">Activation Date</label>
                    <input type="date" class="form-input" @bind="newEvt.EventDate" />
                </div>
                <div>
                    <label class="form-label">Starting balance</label>
                    <input type="number" step="0.01" class="form-input" @bind="newEvt.InitialBudget" onfocus="this.select()" />
                </div>
            </div>

            <button class="btn-create" style="width: 100%; justify-content: center; height: 56px; font-size: 1.1rem;" @onclick="SaveNewEvent">Create Ledger</button>
        </div>
    </div>
}

@if (showSummaryModal)
{
    <div class="modal-backdrop" @onclick='() => showSummaryModal = false'>
        <div class="modal-content" style="max-width: 800px;" @onclick:stopPropagation>
            <h2 style="font-weight: 950; margin-bottom: 2rem;">Global Financial Summary</h2>
            <div style="max-height: 50vh; overflow-y: auto;">
                <table style="width: 100%; border-collapse: collapse;">
                    <thead>
                        <tr style="border-bottom: 2px solid #f1f5f9;">
                            <th style="padding: 1rem; text-align: left; font-size: 0.75rem; font-weight: 850; color: #94a3b8; text-transform: uppercase;">Series Name</th>
                            <th style="padding: 1rem; text-align: right; font-size: 0.75rem; font-weight: 850; color: #94a3b8; text-transform: uppercase;">Total Profit</th>
                            <th style="padding: 1rem; text-align: right; font-size: 0.75rem; font-weight: 850; color: #94a3b8; text-transform: uppercase;">Balance</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var entry in events.GroupBy(e => e.EventGroup))
                        {
                            var masters = entry.SelectMany(e => e.Transactions).Where(t => !t.IsDeleted).ToList();
                            var net = masters.Where(t => t.Category != OpeningBalanceCategory && t.Description != "Opening Balance").Sum(t => t.Amount);
                            var bal = masters.Sum(t => t.Amount);
                            <tr style="border-bottom: 1px solid #f8fafc;">
                                <td style="padding: 1.25rem 1rem; font-weight: 800;">@entry.Key</td>
                                <td style="padding: 1.25rem 1rem; text-align: right; color: #9333ea; font-weight: 900;">@net.ToString("C2")</td>
                                <td style="padding: 1.25rem 1rem; text-align: right; font-weight: 950; color: #1e3a8a;">@bal.ToString("C2")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <button class="btn-create" style="width: 100%; margin-top: 2rem; justify-content: center;" @onclick='() => showSummaryModal = false'>Done</button>
        </div>
    </div>
}

@code {
    private List<ClubEvent>? events;
    private bool showModal = false;
    private ClubEvent newEvt = new();
    private bool isCustomSeries = false;
    
    private const string OpeningBalanceCategory = "Opening Balance";
    private bool showSummaryModal = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadEvents();
    }

    private async Task LoadEvents() => events = (await EventRepo.GetAllEventsAsync(true)).ToList();
    private void NavigateToDetail(int id) => Navigation.NavigateTo($"/finance/club-events/{id}");
    private void OpenSettings(int id) => Navigation.NavigateTo($"/finance/club-events/{id}");

    private void ShowNewEventModal()
    {
        newEvt = new ClubEvent { EventDate = DateTime.Now };
        isCustomSeries = false;
        showModal = true;
    }

    private void CloseModal() => showModal = false;

    private void OpenSummaryModal() => showSummaryModal = true;

    private string StripYear(string text)
    {
        if (string.IsNullOrWhiteSpace(text)) return "";
        // Simple logic to remove 4-digit years at the end
        return System.Text.RegularExpressions.Regex.Replace(text, @"\s*\d{4}$", "").Trim();
    }

    private async Task SaveNewEvent()
    {
        if (string.IsNullOrWhiteSpace(newEvt.EventName)) return;
        
        if (!isCustomSeries)
            newEvt.EventGroup = StripYear(newEvt.EventName);
        else if (string.IsNullOrWhiteSpace(newEvt.EventGroup))
            newEvt.EventGroup = newEvt.EventName;

        await EventRepo.CreateEventAsync(newEvt);

        if (newEvt.InitialBudget.HasValue && newEvt.InitialBudget.Value != 0)
        {
            await EventRepo.AddTransactionAsync(new ClubEventTransaction
            {
                EventId = newEvt.Id,
                TransactionDate = newEvt.EventDate,
                Description = "Opening Balance",
                Category = OpeningBalanceCategory,
                Amount = newEvt.InitialBudget.Value
            });
        }

        showModal = false;
        await LoadEvents();
    }
}
