@page "/finance/lottery-reconcile"
@using GFC.Core.DTOs
@using GFC.Core.Interfaces
@using GFC.Core.Models
@using GFC.BlazorServer.Services
@using GFC.BlazorServer.Auth
@inject IFinancialAnalyticsService FinancialService
@inject IJSRuntime JS
@inject NavigationManager NavMgr
@inject CustomAuthenticationStateProvider AuthStateProvider
@attribute [Authorize]

<PageTitle>Lottery Reconcile | GFC Finance</PageTitle>

<div class="lottery-reconcile-page">
    <div class="sticky-page-header px-4">
        <div class="dash-modern-canvas-slim">
            <div class="d-flex justify-content-between align-items-end">
                <div>
                    <h1 class="header-main-title fw-black mb-1">Lottery Reconcile</h1>
                    <div class="d-flex align-items-center gap-2 text-muted small">
                        <i class="bi bi-calendar-range-fill text-primary"></i>
                        <span>Weekly Performance (Sunday to Saturday)</span>
                    </div>
                </div>
                
                <div class="d-flex align-items-center gap-2 mb-1">
                    <div class="input-group input-group-sm rounded-pill overflow-hidden border-0 shadow-sm">
                        <span class="input-group-text bg-white border-0"><i class="bi bi-calendar3"></i></span>
                        <input type="date" class="form-control border-0" @bind="_startDate" @bind:after="LoadData" />
                        <span class="input-group-text bg-white border-0">to</span>
                        <input type="date" class="form-control border-0" @bind="_endDate" @bind:after="LoadData" />
                    </div>
                    
                    <button type="button" class="btn btn-sm px-4 py-2 rounded-pill bg-white shadow-sm text-primary fw-bold d-flex align-items-center border-0 ms-2" @onclick="LoadData" disabled="@_isLoading">
                        @if (_isLoading)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        else
                        {
                            <i class="bi bi-arrow-repeat me-2"></i>
                        }
                        <span>Refresh</span>
                    </button>
                    
                    <button type="button" class="btn btn-sm p-2 rounded-circle bg-white shadow-sm text-muted border-0 ms-1" @onclick="PrintReport">
                        <i class="bi bi-printer"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Header Spacer to prevent content jump -->
    <div class="page-header-spacer"></div>

    <div class="dash-modern-canvas">
        @if (_isLoading)
        {
            <div class="d-flex flex-column align-items-center justify-content-center py-5 mt-5">
                <div class="spinner-border text-primary mb-3" role="status"></div>
                <span class="text-muted fw-bold text-uppercase" style="letter-spacing: 0.1em;">Analyzing Financial Periods...</span>
            </div>
        }
        else if (!_weeklySummaries.Any())
        {
            <div class="text-center py-5 text-muted bg-white rounded-4 shadow-sm mx-2 mt-4">
                <i class="bi bi-calendar-x d-block fs-1 mb-3 opacity-25"></i>
                <p class="fw-bold">No lottery data found for this period.</p>
                <p class="small">Try selecting a different date range.</p>
            </div>
        }
        else
        {
            <div class="reconcile-grid">
                @foreach (var week in _weeklySummaries)
                {
                    <div class="weekly-card mb-5">
                        <div class="weekly-header d-flex justify-content-between align-items-center p-4 border-bottom">
                            <div class="d-flex align-items-center gap-4">
                                <div class="date-range">
                                    <span class="text-uppercase fw-black text-muted x-small tracking-widest d-block mb-1">Fiscal Period: Week @GetWeekNumber(week.WeekStart)</span>
                                    <h3 class="fw-black mb-0 text-dark" style="font-size: 1.4rem; letter-spacing: -0.01em;">
                                        @week.WeekStart.ToString("MMMM d") &mdash; @week.WeekEnd.ToString("MMMM d, yyyy")
                                    </h3>
                                </div>
                            </div>
                            
                            <div class="d-flex gap-4">
                                @{
                                    // RECONCILIATION LOGIC:
                                    // expected = Net Commission Earnings (Earnings - System Fees + Cumulative Variance)
                                    // actual = The cash profit we actually hold (Total Envelopes - Debt to State)
                                    decimal netDebt = (week.TotalNetDue - week.TotalTickets);
                                    decimal expected = week.TotalIncome - week.TotalFees + week.TotalVariance;
                                    decimal actual = week.TotalEnvelope - netDebt;
                                    decimal diff = actual - expected;
                                    bool isBalanced = Math.Abs(diff) < 2.0m; 
                                }

                                <div class="audit-status-badge d-flex align-items-center gap-2 px-3 py-2 rounded-pill @(isBalanced ? "status-balanced" : "status-investigate")">
                                    <div class="status-dot"></div>
                                    <span class="fw-black text-uppercase tracking-wider" style="font-size: 0.75rem;">
                                        @(isBalanced ? "Audit Balanced" : "Investigation Required")
                                    </span>
                                </div>
                            </div>
                        </div>

                        <!-- RECONCILIATION DASHBOARD - CLEAN & PROFESSIONAL -->
                        <div class="reconcile-dashboard p-4 pb-0 bg-white shadow-none">
                            <div class="row g-4">
                                <div class="col-md-3">
                                    <div class="finance-card">
                                        <div class="finance-label">Total Cash Dropped</div>
                                        <div class="finance-value">@week.TotalEnvelope.ToString("C2")</div>
                                        <div class="finance-meta">Sum of recorded envelopes</div>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="finance-card">
                                        <div class="finance-label">Debt to Lottery</div>
                                        <div class="finance-value text-danger">@netDebt.ToString("C2")</div>
                                        <div class="finance-meta">Final debt per RPT 50/34</div>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="finance-card card-accent-blue">
                                        <div class="finance-label">Audited Net Revenue</div>
                                        <div class="finance-value">@actual.ToString("C2")</div>
                                        <div class="finance-meta">Physical cash after state debt</div>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="finance-card @(isBalanced ? "card-accent-green" : "card-accent-red")">
                                        <div class="finance-label">Reconciliation Gap</div>
                                        <div class="finance-value">@diff.ToString("C2")</div>
                                        <div class="finance-meta">@(isBalanced ? "Verified: Cash matches earnings" : "Variance: Investigate recorded drops")</div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="weekly-content p-2">
                            <div class="gfc-widget border-0 shadow-sm rounded-4 overflow-hidden">
                                <table class="table table-hover mb-0 align-middle">
                                    <thead class="bg-light">
                                        <tr>
                                            <th class="ps-4">DAY / DATE</th>
                                            <th class="text-end">SALES (RPT 50)</th>
                                            <th class="text-end">CASHES (RPT 50)</th>
                                            <th class="text-end">TICKETS (RPT 34)</th>
                                            <th class="text-end ps-4">NET DUE (RPT 50)</th>
                                            <th class="text-end">DUE TO LOTTERY</th>
                                            <th class="text-end ps-4">ENVELOPE CASH</th>
                                            <th class="text-end pe-4">DAILY VARIANCE</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var day in week.Days)
                                        {
                                            var dayShift = day.Shifts.FirstOrDefault(s => s.ShiftType == "Day");
                                            var nightShift = day.Shifts.FirstOrDefault(s => s.ShiftType == "Night");
                                            bool isIncomplete = nightShift == null;

                                            <tr class="@(isIncomplete ? "bg-light-yellow-subtle" : "")">
                                                <td class="ps-4">
                                                    <div class="d-flex align-items-center justify-content-between pe-3">
                                                        <div class="d-flex align-items-center gap-2">
                                                            <div class="date-stack d-flex flex-column">
                                                                <span class="fw-black text-dark" style="line-height: 1;">@day.Date.ToString("ddd")</span>
                                                                <span class="text-muted small" style="font-size: 0.7rem;">@day.Date.ToString("MMM d")</span>
                                                            </div>
                                                            
                                                            @if (isIncomplete)
                                                            {
                                                                <i class="bi bi-exclamation-triangle-fill text-warning ms-1" title="Night shift missing - partial data"></i>
                                                            }
                                                        </div>

                                                        <div class="shift-indicators d-flex gap-1">
                                                            <span class="badge rounded-pill @(dayShift != null ? "bg-success text-white" : "bg-light text-muted border")" 
                                                                  style="font-size: 0.55rem; width: 1.4rem; height: 1.4rem; display: flex; align-items: center; justify-content: center;"
                                                                  title="@(dayShift != null ? $"Day Shift: {dayShift.CreatedBy}" : "Day Shift Missing")">D</span>
                                                            
                                                            <span class="badge rounded-pill @(nightShift != null ? "bg-indigo text-white" : "bg-light text-muted border")" 
                                                                  style="font-size: 0.55rem; width: 1.4rem; height: 1.4rem; display: flex; align-items: center; justify-content: center;"
                                                                  title="@(nightShift != null ? $"Night Shift: {nightShift.CreatedBy}" : "Night Shift Missing")">N</span>
                                                        </div>
                                                    </div>
                                                </td>
                                                <td class="text-end text-muted small">@day.TotalLottoSales.ToString("N2")</td>
                                                <td class="text-end text-muted small">-@day.TotalLottoPayouts.ToString("N2")</td>
                                                <td class="text-end text-muted small">@((day.TotalLottoCancels).ToString("N2"))</td>
                                                <td class="text-end text-muted small ps-4">@day.TotalLottoNetDue.ToString("N2")</td>
                                                <td class="text-end text-dark fw-semibold">@((day.TotalLottoNetDue - day.TotalLottoCancels).ToString("N2"))</td>
                                                <td class="text-end fw-bold text-primary ps-4">@day.TotalEnvelope.ToString("C2")</td>
                                                <td class="text-end pe-4">
                                                    <span class="variance-pill @(day.TotalVariance < 0 ? "variance-neg" : day.TotalVariance > 0 ? "variance-pos" : "variance-zero")">
                                                        @day.TotalVariance.ToString("C2")
                                                    </span>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                    <tfoot class="weekly-total-footer border-0">
                                        <tr>
                                            <td class="ps-4 py-3 fw-bold text-uppercase" style="font-size: 0.7rem; color: #64748b; letter-spacing: 0.05em;">WEEKLY TOTALS</td>
                                            <td class="text-end py-3 text-muted">@week.TotalSales.ToString("N2")</td>
                                            <td class="text-end py-3 text-muted">-@week.TotalPayouts.ToString("N2")</td>
                                            <td class="text-end py-3 text-muted">@week.TotalTickets.ToString("N2")</td>
                                            <td class="text-end py-3 text-muted">@week.TotalNetDue.ToString("N2")</td>
                                            <td class="text-end py-3 text-dark fw-bold">@((week.TotalNetDue - week.TotalTickets).ToString("N2"))</td>
                                            <td class="text-end py-3 fw-bold text-primary border-0">@week.TotalEnvelope.ToString("C2")</td>
                                            <td class="text-end pe-4 py-3">
                                                <span class="variance-pill @(week.TotalVariance < 0 ? "variance-neg" : week.TotalVariance > 0 ? "variance-pos" : "variance-zero")">
                                                    @week.TotalVariance.ToString("C2")
                                                </span>
                                            </td>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

<style>
    .lottery-reconcile-page {
        --bg-primary: #f8fafc;
        --bg-surface: #ffffff;
        background: var(--bg-primary);
        min-height: 100vh;
        padding-bottom: 3rem;
    }

    .variance-pill {
        display: inline-block;
        padding: 4px 12px;
        border-radius: 8px;
        font-weight: 800;
        font-size: 0.85rem;
        min-width: 90px;
        text-align: right;
    }
    .variance-neg { background-color: #fee2e2 !important; color: #991b1b !important; }
    .variance-pos { background-color: #dcfce7 !important; color: #166534 !important; }
    .variance-zero { background-color: #f8fafc !important; color: #64748b !important; }

    .bg-indigo { background-color: #4f46e5 !important; }
    .btn-indigo {
        background-color: #4f46e5 !important;
        color: white !important;
        border: none !important;
    }
    .btn-indigo:hover {
        background-color: #4338ca !important;
        transform: translateY(-1px);
    }

    .dash-modern-canvas {
        background: #ffffff;
        border-radius: 12px;
        border: 1px solid #e2e8f0;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
        margin: 0 1.5rem;
        overflow: hidden;
    }

    .weekly-card {
        border-bottom: 8px solid #f1f5f9;
        margin-bottom: 0 !important;
    }

    .finance-card {
        padding: 1.5rem;
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        height: 100%;
        transition: transform 0.2s ease;
    }
    
    .finance-label {
        font-size: 0.75rem;
        font-weight: 800;
        text-transform: uppercase;
        color: #64748b;
        letter-spacing: 0.05em;
        margin-bottom: 0.5rem;
    }
    
    .finance-value {
        font-size: 1.5rem;
        font-weight: 900;
        color: #0f172a;
        font-family: 'JetBrains Mono', monospace;
        letter-spacing: -0.04em;
    }
    
    .finance-meta {
        font-size: 0.7rem;
        font-weight: 600;
        color: #94a3b8;
        margin-top: 0.25rem;
    }

    .card-accent-blue { border-left: 4px solid #4f46e5 !important; }
    .card-accent-green { border-left: 4px solid #10b981 !important; }
    .card-accent-red { border-left: 4px solid #ef4444 !important; }

    .audit-status-badge {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
    }

    .status-balanced { border-color: #10b98133; color: #065f46; background: #ecfdf5; }
    .status-investigate { border-color: #ef444433; color: #991b1b; background: #fef2f2; }

    .status-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: currentColor;
    }

    .status-balanced .status-dot { background: #10b981; }
    .status-investigate .status-dot { background: #ef4444; }

    .dash-modern-canvas-slim {
        max-width: 1400px;
        margin: 0 auto;
    }

    .bg-light-green-subtle { background-color: #f0fdf4 !important; }
    .bg-light-yellow-subtle { background-color: #fffbeb !important; }

    .shift-indicators .badge {
        transition: all 0.2s ease;
        cursor: help;
        opacity: 0.9;
    }
    
    .shift-indicators .badge:hover {
        opacity: 1;
        transform: scale(1.1);
    }

    .table thead th {
        font-size: 0.75rem;
        font-weight: 900;
        color: #1e293b;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        border-bottom: 2px solid #cbd5e1;
        padding: 1.25rem 0.75rem;
    }

    .table tbody td {
        font-size: 1rem !important;
        padding: 1.1rem 0.75rem;
        border-bottom: 1.5px solid #e2e8f0;
        font-weight: 600;
        color: #0f172a !important;
    }

    .table tfoot td {
        border-top: 2px solid #f1f5f9 !important;
        background-color: #f8fafc;
    }

    .weekly-total-footer {
        border-top: 2px solid #e2e8f0;
    }

    @@media (max-width: 992px) {
        .sticky-page-header { left: 0; }
    }

    @@media print {
        .sticky-page-header, .page-header-spacer, .btn, .input-group { display: none !important; }
        .lottery-reconcile-page { padding: 0 !important; background: white !important; }
        .dash-modern-canvas { padding: 0 !important; }
        .weekly-card { break-inside: avoid; border: 1px solid #ddd !important; border-radius: 8px !important; }
    }
</style>

@code {
    private DateTime _startDate = DateTime.Today.AddDays(-60);
    private DateTime _endDate = DateTime.Today;
    private bool _isLoading = false;
    private List<WeeklySummaryDto> _weeklySummaries = new();

    protected override async Task OnInitializedAsync()
    {
        // Align start date to the nearest Sunday to get clean weeks
        int diff = (7 + (_startDate.DayOfWeek - DayOfWeek.Sunday)) % 7;
        _startDate = _startDate.AddDays(-1 * diff);
        
        await LoadData();
    }

    private async Task LoadData()
    {
        _isLoading = true;
        try
        {
            var result = await FinancialService.GetDailySalesReportsAsync(_startDate, _endDate);
            _weeklySummaries = GroupByWeek(result.Data);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading weekly summaries: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private List<WeeklySummaryDto> GroupByWeek(List<DailySalesReportDto> dailyReports)
    {
        // Use a strict Sunday-to-Saturday fiscal week
        return dailyReports
            .GroupBy(d => {
                var date = d.Date.Date;
                int diff = (date.DayOfWeek - DayOfWeek.Sunday + 7) % 7;
                return date.AddDays(-1 * diff);
            })
            .Select(g => new WeeklySummaryDto {
                WeekStart = g.Key,
                WeekEnd = g.Key.AddDays(6),
                Days = g.OrderBy(d => d.Date).ToList()
            })
            .OrderByDescending(w => w.WeekStart)
            .ToList();
    }

    private int GetWeekNumber(DateTime date)
    {
        // Simple ISO week number or just week of month for context
        var day = (int)System.Globalization.CultureInfo.CurrentCulture.Calendar.GetWeekOfYear(date, System.Globalization.CalendarWeekRule.FirstFourDayWeek, DayOfWeek.Sunday);
        return day;
    }

    private void PrintReport()
    {
        _ = JS.InvokeVoidAsync("window.print");
    }

    public class WeeklySummaryDto
    {
        public DateTime WeekStart { get; set; }
        public DateTime WeekEnd { get; set; }
        public List<DailySalesReportDto> Days { get; set; } = new();

        public decimal TotalSales => Days.Sum(d => d.TotalLottoSales);
        public decimal TotalPayouts => Days.Sum(d => d.TotalLottoPayouts);
        public decimal TotalTickets => Days.Sum(d => d.TotalLottoCancels);
        public decimal TotalEnvelope => Days.Sum(d => d.TotalEnvelope);
        public decimal TotalNetDue => Days.Sum(d => d.TotalLottoNetDue);
        public decimal TotalIncome => Days.Sum(d => d.TotalLotteryIncome);
        public decimal TotalVariance => Days.Sum(d => d.TotalVariance);
        public decimal TotalNetProfit => Days.Sum(d => d.TotalNetIncome);
        public decimal TotalFees => Days.Sum(d => d.TotalIdentifiedFees);

        // SaturdaySurplus removed - redundant as Envelopes already cover drawer surplus.

        public decimal Discrepancy {
            get {
                // Expected Cash Profit = Net Commission + Variance - System Fees
                decimal netDebt = (TotalNetDue - TotalTickets);
                decimal expected = TotalIncome - TotalFees + TotalVariance;
                decimal actual = TotalEnvelope - netDebt;
                return actual - expected;
            }
        }
    }
}
