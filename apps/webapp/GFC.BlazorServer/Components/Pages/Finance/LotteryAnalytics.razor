@page "/finance/lottery-analytics"
@using Microsoft.AspNetCore.Authorization
@using GFC.Core.Interfaces
@using GFC.Core.Models
@using GFC.Core.DTOs
@using GFC.BlazorServer.Services
@using GFC.BlazorServer.Auth
@inject IFinancialAnalyticsService FinancialService
@inject IUserManagementService UserService
@inject IJSRuntime JS
@inject NavigationManager NavMgr
@inject CustomAuthenticationStateProvider AuthStateProvider
@attribute [Authorize]

<PageTitle>Lottery Analytics | GFC Finance</PageTitle>

<div class="lottery-analytics-page">
    <div class="dash-modern-canvas">
        <!-- Header Section -->
        <div class="d-flex justify-content-between align-items-end mb-4 px-2">
            <div>
                <h1 class="display-6 fw-extrabold mb-1" style="color: #0f172a; letter-spacing: -0.03em;">Lottery Analytics</h1>
                <div class="d-flex align-items-center gap-2 text-muted small">
                    <i class="bi bi-ticket-perforated-fill text-primary"></i>
                    <span>Tracking Performance & Cash Variance</span>
                    <span class="mx-1">•</span>
                    <span>Last 30 Days</span>
                </div>
            </div>
            
            <div class="d-flex align-items-center gap-2">
                <div class="filter-group d-flex gap-2">
                    <div class="input-group input-group-sm rounded-pill overflow-hidden border-0 shadow-sm">
                        <span class="input-group-text bg-white border-0"><i class="bi bi-calendar3"></i></span>
                        <input type="date" class="form-control border-0" @bind="_startDate" @bind:after="LoadDataAsync" />
                        <span class="input-group-text bg-white border-0">to</span>
                        <input type="date" class="form-control border-0" @bind="_endDate" @bind:after="LoadDataAsync" />
                    </div>
                    
                    <select class="form-select form-select-sm rounded-pill border-0 shadow-sm px-3" @bind="_selectedShift" @bind:after="FilterData">
                        <option value="">All Shifts</option>
                        <option value="Day">Day Shift</option>
                        <option value="Night">Night Shift</option>
                    </select>

                    <select class="form-select form-select-sm rounded-pill border-0 shadow-sm px-3" @bind="_selectedUser" @bind:after="FilterData">
                        <option value="">All Users</option>
                        @foreach (var user in _users)
                        {
                            <option value="@user">@user</option>
                        }
                    </select>
                </div>
                
                <button type="button" class="btn btn-sm px-4 py-2 rounded-pill bg-white shadow-sm text-primary fw-bold d-flex align-items-center border-0 ms-2" @onclick="LoadDataAsync" disabled="@_isLoading">
                    @if (_isLoading)
                    {
                        <span class="spinner-border spinner-border-sm me-2"></span>
                    }
                    else
                    {
                        <i class="bi bi-arrow-repeat me-2"></i>
                    }
                    <span>Refresh</span>
                </button>
            </div>
        </div>

        <!-- Quick Action Ribbon -->
        <div class="command-ribbon px-2 mb-4">

            @if (CanAccess("/finance/insights"))
            {
                <a href="/finance/insights" class="ribbon-item">
                    <div class="ribbon-icon-wrapper icon-green">
                        <i class="bi bi-graph-up-arrow"></i>
                    </div>
                    <span class="ribbon-label">Financial Insights</span>
                </a>
            }
            <button type="button" class="ribbon-item border-0 bg-transparent" @onclick="PrintPage">
                <div class="ribbon-icon-wrapper icon-slate">
                    <i class="bi bi-printer-fill"></i>
                </div>
                <span class="ribbon-label">Print Report</span>
            </button>
            <a href="/" class="ribbon-item">
                <div class="ribbon-icon-wrapper icon-purple">
                    <i class="bi bi-layout-dashboard"></i>
                </div>
                <span class="ribbon-label">Dashboard</span>
            </a>
        </div>

        <!-- KPI Cards -->
        <div class="row g-3 mb-4 px-2">
            <div class="col-md-3">
                <div class="gfc-widget kpi-card border-start-0 border-top-0 border-bottom-0 border-end border-primary border-5">
                    <div class="widget-header mb-1">
                        <span class="kpi-label uppercase-tracking">Net Lottery profit</span>
                        <i class="bi bi-wallet2 text-primary"></i>
                    </div>
                    <div class="kpi-value text-primary">@_stats.TotalNetProfit.ToString("C2")</div>
                    <div class="extra-small text-muted mt-2">
                        <span class="fw-bold text-dark">@_stats.TotalIncome.ToString("C0")</span> Income vs 
                        <span class="@(_stats.TotalVariance >= 0 ? "text-success" : "text-danger") fw-bold">@_stats.TotalVariance.ToString("C2")</span> Variance
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="gfc-widget kpi-card">
                    <div class="widget-header mb-1">
                        <span class="kpi-label uppercase-tracking">Avg. Daily Variance</span>
                        <i class="bi bi-calculator text-muted"></i>
                    </div>
                    <div class="kpi-value @(_stats.AvgVariance >= 0 ? "text-dark" : "text-danger")">@_stats.AvgVariance.ToString("C2")</div>
                    <div class="extra-small text-muted mt-2">
                        Based on <span class="fw-bold">@_filteredShifts.Count</span> recorded shifts
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="gfc-widget kpi-card">
                    <div class="widget-header mb-1">
                        <span class="kpi-label uppercase-tracking">Variance Stability</span>
                        <i class="bi bi-shield-check text-success"></i>
                    </div>
                    <div class="kpi-value">@_stats.StabilityScore.ToString("N0")%</div>
                    <div class="extra-small text-muted mt-2">
                        <span class="fw-bold text-success">@_stats.PerfectShiftCount</span> Perfect vs 
                        <span class="fw-bold text-danger">@_stats.ShortShiftCount</span> Short Shifts
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="gfc-widget kpi-card">
                    <div class="widget-header mb-1">
                        <span class="kpi-label uppercase-tracking">Shortage Frequency</span>
                        <i class="bi bi-exclamation-triangle-fill text-warning"></i>
                    </div>
                    <div class="kpi-value">@_stats.ShortageFrequency.ToString("N1")%</div>
                    <div class="extra-small text-muted mt-2">
                        Top short user: <span class="fw-bold">@(_stats.TopShortUser ?? "N/A")</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Charts Section -->
        <div class="row g-4 px-2 mb-5">
            <div class="col-lg-8">
                <div class="gfc-widget h-100">
                    <div class="widget-header">
                        <div class="widget-title">
                            <i class="bi bi-bar-chart-line-fill text-primary"></i>
                            <span>Income vs Cash Variance</span>
                        </div>
                        <div class="d-flex gap-2">
                            <span class="badge rounded-pill bg-primary-subtle text-primary border-0 px-3">Performance Trend</span>
                        </div>
                    </div>
                    <div class="chart-container" style="height: 350px;">
                        <canvas id="incomeVarianceChart"></canvas>
                    </div>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="gfc-widget h-100">
                    <div class="widget-header">
                        <div class="widget-title">
                            <i class="bi bi-activity text-danger"></i>
                            <span>Variance Consistency</span>
                        </div>
                    </div>
                    <div class="chart-container" style="height: 350px;">
                        <canvas id="varianceTrendChart"></canvas>
                    </div>
                    <div class="mt-3 p-3 bg-light rounded-3">
                        <div class="small fw-bold border-bottom pb-1 mb-2">Trend Insight</div>
                        <p class="extra-small text-muted mb-0">
                            @if (_stats.TotalVariance < -50) {
                                <i class="bi bi-info-circle-fill text-danger me-1"></i>
                                <span>High negative variance detected. Consistent shortages suggest possible training needs or cash control review.</span>
                            } else if (_stats.StabilityScore > 85) {
                                <i class="bi bi-check-circle-fill text-success me-1"></i>
                                <span>Excellent stability! Cash handling is 85%+ accurate across recorded shifts.</span>
                            } else {
                                <span>Tracking normal distribution of cash variances for the selected period.</span>
                            }
                        </p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Data Table -->
        <div class="px-2">
            <div class="gfc-widget">
                <div class="widget-header">
                    <div class="widget-title">
                        <i class="bi bi-table text-muted"></i>
                        <span>Shift Record Detail</span>
                    </div>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle custom-table">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Shift</th>
                                <th>Employee</th>
                                <th class="text-end">Sales (Net)</th>
                                <th class="text-end">Commission</th>
                                <th class="text-end">Variance</th>
                                <th class="text-end">Net Impact</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!_filteredShifts.Any())
                            {
                                <tr>
                                    <td colspan="7" class="text-center py-5 text-muted">
                                        <i class="bi bi-search d-block fs-3 mb-2"></i>
                                        No lottery shifts found for the selected criteria.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var shift in _filteredShifts)
                                {
                                    <tr>
                                        <td class="fw-bold">@shift.ShiftDate.ToString("MMM dd, yyyy")</td>
                                        <td>
                                            <span class="badge @(shift.ShiftType == "Day" ? "bg-info-subtle text-info" : "bg-dark shadow-sm text-white") rounded-pill px-3">
                                                @shift.ShiftType
                                            </span>
                                        </td>
                                        <td>
                                            <div class="d-flex align-items-center gap-2">
                                                <div class="user-avatar">@shift.EmployeeName.Substring(0, 1)</div>
                                                <span class="fw-semibold">@shift.EmployeeName</span>
                                            </div>
                                        </td>
                                        <td class="text-end fw-bold">@shift.NetSales.ToString("C2")</td>
                                        <td class="text-end text-primary fw-bold">@shift.LotteryIncome.ToString("C2")</td>
                                        <td class="text-end">
                                            <span class="fw-bold @(shift.Variance >= 0 ? (shift.Variance == 0 ? "text-muted" : "text-success") : "text-danger")">
                                                @shift.Variance.ToString("C2")
                                            </span>
                                        </td>
                                        <td class="text-end">
                                            @{
                                                var netImpact = shift.LotteryIncome + shift.Variance;
                                            }
                                            <div class="fw-extrabold @(netImpact >= 0 ? "text-dark" : "text-danger")" style="font-size: 1rem;">
                                                @netImpact.ToString("C2")
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .lottery-analytics-page {
        --primary: #3b82f6;
        --success: #10b981;
        --danger: #ef4444;
        --warning: #f59e0b;
        background: #fdfdfd;
        min-height: 100vh;
    }

    .kpi-card {
        padding: 1.25rem;
        background: rgba(255, 255, 255, 0.9);
        backdrop-filter: blur(10px);
    }

    .user-avatar {
        width: 28px;
        height: 28px;
        background: var(--primary);
        color: white;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.75rem;
        font-weight: 800;
    }

    .custom-table {
        margin-top: 0.5rem;
    }

    .custom-table thead th {
        font-size: 0.65rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: #94a3b8;
        border-bottom: 2px solid #f1f5f9;
        font-weight: 700;
        padding: 1rem 0.75rem;
    }

    .custom-table tbody td {
        padding: 0.85rem 0.75rem;
        border-bottom: 1px solid #f1f5f9;
        font-size: 0.85rem;
    }

    .custom-table tbody tr:last-child td {
        border-bottom: none;
    }

    /* Command Ribbon Styling (Matches Dashboard) */
    .command-ribbon {
        display: flex;
        flex-wrap: wrap;
        gap: 1.25rem;
        padding: 0.5rem 0;
        align-items: center;
    }

    .ribbon-item {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.5rem;
        text-decoration: none;
        color: inherit;
        transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
        position: relative;
        padding: 0.5rem;
    }

    .ribbon-icon-wrapper {
        width: 52px;
        height: 52px;
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.4rem;
        color: white;
        box-shadow: 0 8px 16px -4px rgba(0, 0, 0, 0.1);
        transition: all 0.3s ease;
    }

    .ribbon-item:hover {
        transform: translateY(-4px);
    }

    .ribbon-label {
        font-size: 0.72rem;
        font-weight: 700;
        color: #64748b;
        letter-spacing: 0.01em;
    }

    .icon-blue { background: linear-gradient(135deg, #60a5fa 0%, #3b82f6 100%); }
    .icon-green { background: linear-gradient(135deg, #34d399 0%, #10b981 100%); }
    .icon-slate { background: linear-gradient(135deg, #94a3b8 0%, #64748b 100%); }
    .icon-purple { background: linear-gradient(135deg, #a78bfa 0%, #8b5cf6 100%); }

    @@media print {
        .command-ribbon, .filter-group, button { display: none !important; }
        .dash-modern-canvas { padding: 0 !important; }
        .gfc-widget { box-shadow: none !important; border: 1px solid #ddd !important; }
    }
</style>

@code {
    private DateTime _startDate = DateTime.Today.AddDays(-30);
    private DateTime _endDate = DateTime.Today;
    private string _selectedShift = "";
    private string _selectedUser = "";
    private bool _isLoading = false;
    
    private List<LotteryShift> _allShifts = new();
    private List<LotteryShift> _filteredShifts = new();
    private List<string> _users = new();
    private int _currentUserId;
    
    private LotteryStats _stats = new();

    protected override async Task OnInitializedAsync()
    {
        _isLoading = true;
        try 
        {
            var user = AuthStateProvider.GetCurrentUser();
            if (user != null)
            {
                _currentUserId = user.UserId;
            }
            
            await LoadDataAsync();
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task LoadDataAsync()
    {
        _isLoading = true;
        try 
        {
            _allShifts = await FinancialService.GetLotteryAnalyticsAsync(_startDate, _endDate);
            _users = _allShifts.Select(s => s.EmployeeName).Distinct().OrderBy(n => n).ToList();
            FilterData();
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void FilterData()
    {
        IEnumerable<LotteryShift> query = _allShifts;
        
        if (!string.IsNullOrEmpty(_selectedShift))
            query = query.Where(s => s.ShiftType == _selectedShift);
            
        if (!string.IsNullOrEmpty(_selectedUser))
            query = query.Where(s => s.EmployeeName == _selectedUser);
            
        _filteredShifts = query.OrderByDescending(s => s.ShiftDate).ToList();
        
        CalculateStats();
        _ = UpdateCharts();
    }

    private void CalculateStats()
    {
        if (!_filteredShifts.Any())
        {
            _stats = new LotteryStats();
            return;
        }

        _stats.TotalIncome = _filteredShifts.Sum(s => s.LotteryIncome);
        _stats.TotalVariance = _filteredShifts.Sum(s => s.Variance);
        _stats.TotalNetProfit = _stats.TotalIncome + _stats.TotalVariance;
        _stats.AvgVariance = _filteredShifts.Average(s => s.Variance);
        
        _stats.PerfectShiftCount = _filteredShifts.Count(s => Math.Abs(s.Variance) <= 0.05m);
        _stats.ShortShiftCount = _filteredShifts.Count(s => s.Variance < -0.05m);
        _stats.StabilityScore = (decimal)_stats.PerfectShiftCount / _filteredShifts.Count * 100;
        _stats.ShortageFrequency = (decimal)_stats.ShortShiftCount / _filteredShifts.Count * 100;
        
        // Find top short user
        var shortUsers = _filteredShifts
            .Where(s => s.Variance < 0)
            .GroupBy(s => s.EmployeeName)
            .Select(g => new { Name = g.Key, TotalShort = g.Sum(s => s.Variance) })
            .OrderBy(u => u.TotalShort)
            .FirstOrDefault();
            
        _stats.TopShortUser = shortUsers?.Name;
    }

    private async Task UpdateCharts()
    {
        if (_filteredShifts == null) return;

        // Group by date for the time series
        var dailyData = _filteredShifts
            .GroupBy(s => s.ShiftDate.Date)
            .OrderBy(g => g.Key)
            .Select(g => new { 
                Date = g.Key.ToString("MM/dd"), 
                Income = g.Sum(s => s.LotteryIncome), 
                Variance = g.Sum(s => s.Variance),
                Net = g.Sum(s => s.LotteryIncome + s.Variance)
            }).ToList();

        var labels = dailyData.Select(d => d.Date).ToList();
        
        // Income vs Variance Chart
        var incomeVsVarDatasets = new List<object>
        {
            new { label = "Actual Income", data = dailyData.Select(d => d.Income).ToList(), color = "#3b82f6", bg = "rgba(59, 130, 246, 0.7)", type = "bar" },
            new { label = "Variance", data = dailyData.Select(d => d.Variance).ToList(), color = "#ef4444", bg = "rgba(239, 68, 68, 0.7)", type = "bar" },
            new { label = "Net Profit", data = dailyData.Select(d => d.Net).ToList(), color = "#10b981", bg = "rgba(16, 185, 129, 0.1)", type = "line" }
        };

        await JS.InvokeVoidAsync("financialCharts.renderChart", "incomeVarianceChart", new { 
            type = "bar", 
            labels = labels, 
            datasets = incomeVsVarDatasets
        });

        // Variance Consistency Chart
        var varianceTrendDatasets = new List<object>
        {
            new { label = "Daily Variance", data = dailyData.Select(d => d.Variance).ToList(), color = "#f59e0b", bg = "rgba(245, 158, 11, 0.1)", type = "line" }
        };

        await JS.InvokeVoidAsync("financialCharts.renderChart", "varianceTrendChart", new { 
            type = "line", 
            labels = labels, 
            datasets = varianceTrendDatasets
        });
    }

    private bool CanAccess(string route)
    {
        if (_currentUserId == 0) return false;
        return UserService.UserHasPageAccess(_currentUserId, route);
    }

    private async Task PrintPage() => await JS.InvokeVoidAsync("window.print");

    private class LotteryStats
    {
        public decimal TotalIncome { get; set; }
        public decimal TotalVariance { get; set; }
        public decimal TotalNetProfit { get; set; }
        public decimal AvgVariance { get; set; }
        public int PerfectShiftCount { get; set; }
        public int ShortShiftCount { get; set; }
        public decimal StabilityScore { get; set; }
        public decimal ShortageFrequency { get; set; }
        public string? TopShortUser { get; set; }
    }
}
