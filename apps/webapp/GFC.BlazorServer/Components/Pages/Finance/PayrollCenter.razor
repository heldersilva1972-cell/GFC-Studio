@code {
    private bool _loading = true;
    private string _searchQuery = "";
    private bool _showProcessModal = false;
    private bool _showTaxProfileModal = false;
    private bool _showTaxTablesModal = false;
    private bool _show941Modal = false;
    private bool _showQuestModal = false;
    private string _payPeriod = "FullMonth";
    private string _payPeriodTitle = "Monthly Recap";
    private AppUser? _selectedUser;
    private string _selectedUserDisplayName = "";
    private string _cycleStatus = "DRAFT";
    private DateTime _startDate;
    private DateTime _endDate;
    private List<EmployeeHoursDto> _data = new();

    private IEnumerable<EmployeeHoursDto> FilteredData => _data
        .Where(d => string.IsNullOrEmpty(_searchQuery) || 
                   (d.MemberName?.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase) ?? false) ||
                   d.Username.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task ChangePeriod(string period)
    {
        _payPeriod = period;
        await LoadData();
    }

    private async Task DownloadQuestFile()
    {
        if (!FilteredData.Any())
        {
            await ToastService.ShowWarning("No payroll data available for the selected range.");
            return;
        }

        using var db = await DbFactory.CreateDbContextAsync();
        var sys = await db.SystemSettings.FirstOrDefaultAsync();
        var ean = sys?.MaEmployerAccountNumber?.Replace("-", "") ?? "REPLACE_ME";
        
        // Quarter Logic (Simplified)
        var quarter = (_startDate.Month - 1) / 3 + 1;
        var period = $"{_startDate.Year}{quarter}";

        var csv = new System.Text.StringBuilder();
        // [MA Standard CSV Format]: EAN,Period,SSN,Name,Hours,GrossWages,AdjustmentCode
        foreach (var d in FilteredData)
        {
            // Fetch the AppUser to get the SSN
            var user = await db.AppUsers.FirstOrDefaultAsync(u => u.Username == d.Username);
            var ssn = user?.SocialSecurityNumber?.Replace("-", "") ?? "000000000";
            
            csv.AppendLine($"{ean},{period},{ssn},{d.MemberName},{Math.Floor(d.TotalHours)},{d.TotalPay:F2},0");
        }

        var bytes = System.Text.Encoding.UTF8.GetBytes(csv.ToString());
        var base64 = Convert.ToBase64String(bytes);
        var fileName = $"MA_QUEST_{_startDate:yyyyMMdd}_{_endDate:yyyyMMdd}.csv";
        await JSRuntime.InvokeVoidAsync("downloadFile", fileName, base64, "text/csv");
        await ToastService.ShowSuccess("MA QUEST Bulk Upload file generated.");
    }

