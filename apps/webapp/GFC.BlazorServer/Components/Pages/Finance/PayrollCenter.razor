    private async Task LoadData()
    {
        _loading = true;
        StateHasChanged();

        if (_payPeriod == "ThisWeek")
        {
            // Current week (Monday - Sunday)
            _startDate = DateTime.Now.Date.AddDays(-(int)DateTime.Now.Date.DayOfWeek + (int)DayOfWeek.Monday);
            _endDate = _startDate.AddDays(6);
            _payPeriodTitle = "Current Pay Cycle";
        }
        else if (_payPeriod == "LastWeek")
        {
            _startDate = DateTime.Now.Date.AddDays(-(int)DateTime.Now.Date.DayOfWeek + (int)DayOfWeek.Monday).AddDays(-7);
            _endDate = _startDate.AddDays(6);
            _payPeriodTitle = "Last Week Recap";
        }
        else if (_payPeriod == "FullMonth")
        {
            _startDate = new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1);
            _endDate = _startDate.AddMonths(1).AddDays(-1);
            _payPeriodTitle = "Monthly Recap";
        }
        else if (_payPeriod == "PrevMonth")
        {
            var prevM = DateTime.Now.AddMonths(-1);
            _startDate = new DateTime(prevM.Year, prevM.Month, 1);
            _endDate = _startDate.AddMonths(1).AddDays(-1);
            _payPeriodTitle = "Previous Month Archive";
        }
        else if (_payPeriod == "Custom")
        {
            _payPeriodTitle = "Custom Audit Range";
        }

        _data = await FinancialService.GetEmployeeHoursAsync(_startDate, _endDate, null, "Main");
        
        // Determine Cycle Status based on database state
        using var db = await DbFactory.CreateDbContextAsync();
        var entries = await db.BarSaleEntries
            .Where(e => e.SaleDate >= _startDate && e.SaleDate <= _endDate)
            .ToListAsync();
            
        if (!entries.Any()) _cycleStatus = "EMPTY";
        else if (entries.All(e => e.Status == "Committed")) _cycleStatus = "COMMITTED";
        else if (entries.All(e => e.Status == "Submitted")) _cycleStatus = "READY";
        else _cycleStatus = "DRAFT";
        
        _loading = false;
        StateHasChanged();
    }

    private async Task CommitCycle()
    {
        _showProcessModal = false;
        _loading = true;
        StateHasChanged();
        
        try
        {
            using var db = await DbFactory.CreateDbContextAsync();
            var entries = await db.BarSaleEntries
                .Where(e => e.SaleDate >= _startDate && e.SaleDate <= _endDate)
                .ToListAsync();
                
            foreach (var e in entries)
            {
                e.Status = "Committed";
            }
            
            await db.SaveChangesAsync();
            await LoadData();
            await ToastService.ShowSuccess($"Successfully committed {_payPeriodTitle} to historical archives.");
        }
        catch (Exception ex)
        {
            await ToastService.ShowError($"Failed to commit cycle: {ex.Message}");
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private async Task OpenTaxProfile(string username)
    {
        try 
        {
            using var db = await DbFactory.CreateDbContextAsync();
            _selectedUser = await db.AppUsers.FirstOrDefaultAsync(u => u.Username == username);
            if (_selectedUser != null)
            {
                // Fetch the friendly name from the Member record if available
                var member = await db.Members.AsNoTracking().FirstOrDefaultAsync(m => m.MemberID == _selectedUser.MemberId);
                _selectedUserDisplayName = member != null ? $"{member.FirstName} {member.LastName}" : _selectedUser.Username;
                
                _showTaxProfileModal = true;
            }
        }
        catch (Exception ex)
        {
            await ToastService.ShowError($"Error loading profile: {ex.Message}");
        }
    }

    private async Task SaveTaxProfile()
    {
        if (_selectedUser == null) return;

        try
        {
            using var db = await DbFactory.CreateDbContextAsync();
            db.AppUsers.Update(_selectedUser);
            await db.SaveChangesAsync();
            await ToastService.ShowSuccess($"Updated W-4 Profile for {_selectedUserDisplayName}");
            _showTaxProfileModal = false;
            await LoadData();
        }
        catch (Exception ex)
        {
            await ToastService.ShowError($"Error saving tax profile: {ex.Message}");
        }
    }

    private SystemSettings? _sysSettings;
    private int _selectedTaxYear = 2026;
    private string _activeTaxTab = "Single";
    private List<TaxBracket> _currentBrackets = new();
    private List<TaxStandardDeduction> _currentDeductions = new();
    private bool _savingTax = false;

    private async Task OpenTaxConfig()
    {
        _showTaxTablesModal = true;
        using var db = await DbFactory.CreateDbContextAsync();
        _sysSettings = await db.SystemSettings.FirstOrDefaultAsync();
        await LoadTaxRates();
    }

    private async Task LoadTaxRates()
    {
        using var db = await DbFactory.CreateDbContextAsync();
        _currentBrackets = await db.TaxBrackets
            .Where(b => b.TaxYear == _selectedTaxYear)
            .OrderBy(b => b.FilingStatus).ThenBy(b => b.LowerBound)
            .ToListAsync();
            
        _currentDeductions = await db.TaxStandardDeductions
            .Where(d => d.TaxYear == _selectedTaxYear)
            .ToListAsync();
            
        StateHasChanged();
    }

    private async Task SaveTaxRates()
    {
        _savingTax = true;
        try
        {
            using var db = await DbFactory.CreateDbContextAsync();
            db.TaxBrackets.UpdateRange(_currentBrackets);
            db.TaxStandardDeductions.UpdateRange(_currentDeductions);
            
            if (_sysSettings != null)
            {
                db.SystemSettings.Update(_sysSettings);
            }
            
            await db.SaveChangesAsync();
            await ToastService.ShowSuccess($"Saved {_selectedTaxYear} Tax Criteria");
            await LoadData(); // Recompute current view with new taxes
        }
        catch (Exception ex) 
        {
            await ToastService.ShowError($"Error saving taxes: {ex.Message}");
        }
        finally
        {
            _savingTax = false;
        }
    }

    private async Task SeedNextYear()
    {
        _savingTax = true;
        try
        {
            using var db = await DbFactory.CreateDbContextAsync();
            var nextYear = _selectedTaxYear + 1;
            
            if (await db.TaxBrackets.AnyAsync(b => b.TaxYear == nextYear))
            {
                await ToastService.ShowWarning($"{nextYear} already exists.");
                return;
            }

            var nextBrackets = _currentBrackets.Select(b => new TaxBracket {
                TaxYear = nextYear,
                FilingStatus = b.FilingStatus,
                LowerBound = b.LowerBound,
                UpperBound = b.UpperBound,
                BaseTax = b.BaseTax,
                Rate = b.Rate
            }).ToList();

            var nextDeductions = _currentDeductions.Select(d => new TaxStandardDeduction {
                TaxYear = nextYear,
                FilingStatus = d.FilingStatus,
                Amount = d.Amount
            }).ToList();

            db.TaxBrackets.AddRange(nextBrackets);
            db.TaxStandardDeductions.AddRange(nextDeductions);
            await db.SaveChangesAsync();
            
            _selectedTaxYear = nextYear;
            await LoadTaxRates();
            await ToastService.ShowSuccess($"Initialized {nextYear} from current values.");
        }
        catch (Exception ex)
        {
            await ToastService.ShowError($"Error seeding next year: {ex.Message}");
        }
        finally
        {
            _savingTax = false;
        }
    }

