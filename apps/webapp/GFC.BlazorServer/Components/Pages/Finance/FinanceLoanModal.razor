@using GFC.Core.Interfaces
@using GFC.Core.Models.Finance
@inject IFinanceService FinanceService

<div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.4); backdrop-filter: blur(8px);">
    <div class="modal-dialog modal-dialog-centered finance-modal-content">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 28px;">
            <div class="modal-header finance-modal-header d-flex justify-content-between align-items-center">
                <h5 class="modal-title fw-bold">@(Loan.Id == 0 ? "Create New Loan" : "Edit Loan")</h5>
                <button type="button" class="btn-close" @onclick="OnClose"></button>
            </div>
            <div class="modal-body finance-modal-body">
                <EditForm Model="Loan" OnValidSubmit="HandleSubmit">
                    <div class="row g-3">
                        <!-- Lender Name -->
                        <div class="col-12">
                            <label class="form-label small fw-bold text-muted">Lender Name / Description</label>
                            <InputText @bind-Value="Loan.LenderName" class="form-control rounded-4 shadow-sm" placeholder="e.g. Bank of America, Member Loan" />
                        </div>

                        <!-- Origin Date & Original Balance -->
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-muted">Origin Date</label>
                            <InputDate @bind-Value="Loan.OriginDate" class="form-control rounded-4 shadow-sm" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-muted">Original Balance</label>
                            <div class="input-group">
                                <span class="input-group-text bg-white border-end-0">$</span>
                                <InputNumber @bind-Value="Loan.OriginalBalance" class="form-control border-start-0" placeholder="0.00" onfocus="this.select()" disabled="@(Loan.Id > 0)" />
                            </div>
                        </div>

                        <!-- Monthly Payment & Due Day (Recurring Schedule) -->
                        <div class="col-12">
                            <div class="p-3 rounded-4 bg-light border">
                                <div class="d-flex align-items-center justify-content-between mb-2">
                                    <div class="d-flex align-items-center gap-2">
                                        <i class="bi bi-arrow-repeat text-primary"></i>
                                        <label class="form-label small fw-bold text-dark mb-0">Monthly Repayment Schedule (Dashboard Reminders)</label>
                                    </div>
                                    @if (Loan.PaymentDueDay.HasValue || (Loan.MonthlyPaymentAmount.HasValue && Loan.MonthlyPaymentAmount.Value > 0))
                                    {
                                        <button type="button" class="btn btn-link btn-sm text-danger text-decoration-none p-0" style="font-size: 0.7rem;" @onclick="ClearLoanSchedule">
                                            <i class="bi bi-x-circle me-1"></i>Clear / Stop Recurring Reminder
                                        </button>
                                    }
                                </div>
                                <div class="row g-2">
                                    <div class="col-md-6">
                                        <label class="form-label small fw-bold text-muted" style="font-size: 0.75rem;">Monthly Target Amount <span class="text-muted fw-normal">(optional)</span></label>
                                        <div class="input-group input-group-sm">
                                            <span class="input-group-text bg-white border-end-0">$</span>
                                            <InputNumber @bind-Value="Loan.MonthlyPaymentAmount" class="form-control border-start-0 rounded-end-4" placeholder="0.00 (Flexible Target if left blank)" onfocus="this.select()" />
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        @if (!string.IsNullOrWhiteSpace(Loan.GroupName))
                                        {
                                            <label class="form-label small fw-bold text-muted" style="font-size: 0.75rem;">Payment Due Day</label>
                                            <div class="form-control form-control-sm rounded-4 shadow-sm bg-white fw-bold text-primary d-flex align-items-center justify-content-between" style="font-size: 0.8rem;">
                                                <span>Day @(Loan.PaymentDueDay?.ToString() ?? "Not Set")</span>
                                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill" style="font-size: 0.55rem;">MANAGED BY GROUP</span>
                                            </div>
                                        }
                                        else
                                        {
                                            <label class="form-label small fw-bold text-muted" style="font-size: 0.75rem;">Payment Due Day <span class="text-muted fw-normal">(1-31, optional)</span></label>
                                            <InputNumber @bind-Value="Loan.PaymentDueDay" class="form-control form-control-sm rounded-4 shadow-sm" placeholder="e.g. 15 (Sets monthly bill reminder)" min="1" max="31" />
                                        }
                                    </div>
                                </div>
                                <small class="text-muted d-block mt-2" style="font-size: 0.68rem; line-height: 1.3;">
                                    <i class="bi bi-info-circle me-1 text-primary"></i> Setting a <strong>Payment Due Day</strong> generates a monthly repayment reminder under <strong>Bills Due</strong> and in the <strong>Recurring Hub</strong>. Leave blank or clear to disable automatic reminders.
                                </small>
                            </div>
                        </div>

                        <!-- Notes -->
                        <div class="col-12">
                            <label class="form-label small fw-bold text-muted">Notes / Description</label>
                            <InputTextArea @bind-Value="Loan.Notes" class="form-control rounded-4 shadow-sm" rows="3" placeholder="Additional details..." />
                        </div>

                        <!-- Group -->
                        <div class="col-12">
                            <label class="form-label small fw-bold text-muted">Group Label <span class="text-muted fw-normal">(optional)</span></label>
                            <input type="text"
                                   class="form-control rounded-4 shadow-sm"
                                   list="loanGroupList"
                                   placeholder="e.g. Real Estate, Equipment, SBA Loans"
                                   @bind="Loan.GroupName"
                                   @bind:event="oninput"
                                   autocomplete="off" />
                            <datalist id="loanGroupList">
                                @foreach (var g in ExistingGroups)
                                {
                                    <option value="@g" />
                                }
                            </datalist>
                            <small class="text-muted d-block mt-1">
                                <i class="bi bi-info-circle me-1"></i>Type any group name to organise loans. Leave blank for "Ungrouped".
                            </small>
                        </div>

                        <!-- Active Switch (Only visible when editing) -->
                        @if (Loan.Id > 0)
                        {
                            <div class="col-12">
                                <div class="recurring-container p-3 rounded-4 d-flex flex-column @(Loan.IsActive ? "active" : "")">
                                    <div class="form-check form-switch d-flex align-items-center gap-3">
                                        <InputCheckbox @bind-Value="Loan.IsActive" class="form-check-input ms-0" id="isLoanActiveSwitch" />
                                        <label class="form-check-label fw-bold mb-0" for="isLoanActiveSwitch" style="cursor:pointer">Active Loan</label>
                                    </div>
                                    <small class="text-muted mt-2 d-block">
                                        <i class="bi bi-info-circle me-1"></i> Marking as inactive will hide this loan from the active view.
                                    </small>
                                </div>
                            </div>
                        }
                    </div>

                    <div class="modal-footer border-0 px-0 mt-2 flex-column align-items-stretch">
                        @if (ValidationError != null)
                        {
                            <div class="alert alert-danger py-2 px-3 mb-3 d-flex align-items-center gap-2 shadow-sm rounded-4">
                                <i class="bi bi-exclamation-triangle-fill"></i>
                                <span class="small fw-bold">@ValidationError</span>
                            </div>
                        }
                        <div class="d-flex justify-content-end gap-2 w-100">
                            <button type="button" class="btn btn-light rounded-pill px-4" @onclick="OnClose">Cancel</button>
                            <button type="submit" class="btn btn-primary rounded-pill px-4 shadow-sm">Save Loan</button>
                        </div>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public FinanceLoan Loan { get; set; } = new() { OriginDate = DateTime.Today, IsActive = true };
    [Parameter] public EventCallback<bool> OnSave { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public List<string> ExistingGroups { get; set; } = new();

    private string? ValidationError { get; set; }

    private void ClearLoanSchedule()
    {
        Loan.PaymentDueDay = null;
        Loan.MonthlyPaymentAmount = null;
    }

    private async Task HandleSubmit()
    {
        ValidationError = null;

        if (string.IsNullOrWhiteSpace(Loan.LenderName))
        {
            ValidationError = "Please enter a lender name.";
            return;
        }

        if (Loan.OriginalBalance <= 0)
        {
            ValidationError = "Please enter an original balance greater than $0.00.";
            return;
        }

        if (Loan.MonthlyPaymentAmount.HasValue && Loan.MonthlyPaymentAmount.Value < 0)
        {
            ValidationError = "Monthly repayment amount cannot be negative.";
            return;
        }

        if (Loan.PaymentDueDay.HasValue && (Loan.PaymentDueDay.Value < 1 || Loan.PaymentDueDay.Value > 31))
        {
            ValidationError = "Payment due day must be between 1 and 31.";
            return;
        }

        try
        {
            if (Loan.Id == 0)
            {
                await FinanceService.CreateLoanAsync(Loan);
            }
            else
            {
                await FinanceService.UpdateLoanAsync(Loan);
            }

            // Sync the due day to all active loans in the same group
            if (!string.IsNullOrWhiteSpace(Loan.GroupName) && Loan.PaymentDueDay.HasValue)
            {
                var siblingLoans = (await FinanceService.GetAllLoansAsync(includeInactive: false))
                    .Where(l => l.Id != Loan.Id && string.Equals(l.GroupName, Loan.GroupName, StringComparison.OrdinalIgnoreCase) && l.IsActive)
                    .ToList();

                foreach (var sibling in siblingLoans)
                {
                    if (sibling.PaymentDueDay != Loan.PaymentDueDay)
                    {
                        sibling.PaymentDueDay = Loan.PaymentDueDay;
                        await FinanceService.UpdateLoanAsync(sibling);
                    }
                }
            }

            await OnSave.InvokeAsync(true);
        }
        catch (Exception ex)
        {
            ValidationError = $"Error saving loan: {ex.Message}";
        }
    }
}
