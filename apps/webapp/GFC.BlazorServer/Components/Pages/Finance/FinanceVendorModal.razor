@using GFC.Core.Interfaces
@using GFC.Core.Models.Finance
@inject IFinanceService FinanceService
@inject IJSRuntime JS

<div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.4); backdrop-filter: blur(8px);">
    <div class="modal-dialog modal-dialog-centered finance-modal-content">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 28px;">
            <div class="modal-header finance-modal-header d-flex justify-content-between align-items-center">
                <h5 class="modal-title fw-bold">@(Vendor.Id == 0 ? "Create New Vendor" : "Edit Vendor")</h5>
                <button type="button" class="btn-close" @onclick="OnClose"></button>
            </div>
            <div class="modal-body finance-modal-body">
                <EditForm Model="Vendor" OnValidSubmit="HandleSubmit">
                    <div class="row g-3">
                        <!-- Vendor Name -->
                        <div class="col-12">
                            <label class="form-label small fw-bold text-muted">Vendor Name</label>
                            <InputText @bind-Value="Vendor.Name" class="form-control rounded-4 shadow-sm" placeholder="e.g. Acme Corp" />
                        </div>

                        <!-- Priority & Default Category -->
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-muted">Priority Ranking</label>
                            <InputSelect @bind-Value="Vendor.Priority" class="form-select rounded-4 shadow-sm">
                                <option value="1">High Priority (1)</option>
                                <option value="2">Medium Priority (2)</option>
                                <option value="3">Low Priority (3)</option>
                            </InputSelect>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-muted">Default Bill Category</label>
                            <InputSelect @bind-Value="Vendor.DefaultCategoryId" class="form-select rounded-4 shadow-sm">
                                <option value="">-- No Default Category --</option>
                                @foreach (var cat in Categories)
                                {
                                    <option value="@cat.Id">@cat.Name</option>
                                }
                            </InputSelect>
                        </div>

                        <!-- Contact Email & Phone -->
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-muted">Email Address</label>
                            <InputText @bind-Value="Vendor.Email" class="form-control rounded-4 shadow-sm" placeholder="email@vendor.com" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-muted">Phone Number</label>
                            <InputText @bind-Value="Vendor.Phone" class="form-control rounded-4 shadow-sm" placeholder="(555) 555-5555" />
                        </div>

                        <!-- Website & Account Number -->
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-muted">Website URL</label>
                            <InputText @bind-Value="Vendor.Website" class="form-control rounded-4 shadow-sm" placeholder="https://www.vendor.com" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-muted">Account Number</label>
                            <InputText @bind-Value="Vendor.AccountNumber" class="form-control rounded-4 shadow-sm" placeholder="e.g. ACCT-123456" />
                        </div>

                        <!-- Contact Notes -->
                        <div class="col-12">
                            <label class="form-label small fw-bold text-muted">Contact Info / Notes</label>
                            <InputTextArea @bind-Value="Vendor.ContactInfo" class="form-control rounded-4 shadow-sm" rows="2" placeholder="Account numbers, specific sales rep, etc." />
                        </div>

                        <!-- Is Active Status -->
                        <div class="col-12">
                            <div class="recurring-container p-3 rounded-4 d-flex flex-column @(Vendor.IsActive ? "active" : "")">
                                <div class="form-check form-switch d-flex align-items-center gap-3">
                                    <InputCheckbox @bind-Value="Vendor.IsActive" class="form-check-input ms-0" id="isActiveSwitch" />
                                    <label class="form-check-label fw-bold mb-0" for="isActiveSwitch" style="cursor:pointer">Active Vendor</label>
                                </div>
                                <small class="text-muted mt-2 d-block">
                                    <i class="bi bi-info-circle me-1"></i> Inactive vendors will be hidden from new bill selections.
                                </small>
                            </div>
                        </div>
                    </div>

                    <div class="modal-footer border-0 px-0 mt-2 flex-column align-items-stretch">
                        @if (ValidationError != null)
                        {
                            <div class="alert alert-danger py-2 px-3 mb-3 d-flex align-items-center gap-2 shadow-sm rounded-4">
                                <i class="bi bi-exclamation-triangle-fill"></i>
                                <span class="small fw-bold">@ValidationError</span>
                            </div>
                        }
                        <div class="d-flex justify-content-between gap-2 w-100">
                            @if (Vendor.Id > 0)
                            {
                                <button type="button" class="btn btn-outline-danger rounded-pill px-4 fw-bold" @onclick="() => OnDeleteRequested.InvokeAsync(Vendor)">Delete Vendor</button>
                            }
                            else
                            {
                                <div></div>
                            }
                            <div class="d-flex gap-2">
                                <button type="button" class="btn btn-light rounded-pill px-4" @onclick="OnClose">Cancel</button>
                                <button type="submit" class="btn btn-primary rounded-pill px-4 shadow-sm">Save Vendor</button>
                            </div>
                        </div>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public FinanceVendor Vendor { get; set; } = new() { IsActive = true, Priority = 3 };
    [Parameter] public EventCallback<bool> OnSave { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<FinanceVendor> OnDeleteRequested { get; set; }

    private List<FinanceCategory> Categories { get; set; } = new();
    private string? ValidationError { get; set; }

    protected override async Task OnInitializedAsync()
    {
        Categories = (await FinanceService.GetAllCategoriesAsync()).ToList();
    }

    private async Task HandleSubmit()
    {
        ValidationError = null;

        if (string.IsNullOrWhiteSpace(Vendor.Name))
        {
            ValidationError = "Please enter a vendor name.";
            return;
        }

        try
        {
            if (Vendor.Id == 0)
            {
                await FinanceService.CreateVendorAsync(Vendor);
            }
            else
            {
                await FinanceService.UpdateVendorAsync(Vendor);
            }
            await OnSave.InvokeAsync(true);
        }
        catch (Exception ex)
        {
            ValidationError = $"Error saving vendor: {ex.Message}";
        }
    }
}
