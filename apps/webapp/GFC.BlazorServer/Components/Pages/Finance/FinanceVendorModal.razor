@using GFC.Core.Interfaces
@using GFC.Core.Models.Finance
@inject IFinanceService FinanceService
@inject IJSRuntime JS

<div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.4); backdrop-filter: blur(8px);">
    <div class="modal-dialog modal-dialog-centered finance-modal-content">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 28px;">
            <div class="modal-header finance-modal-header d-flex justify-content-between align-items-center">
                <h5 class="modal-title fw-bold">@(Vendor.Id == 0 ? "Create New Vendor" : "Edit Vendor")</h5>
                <button type="button" class="btn-close" @onclick="OnClose"></button>
            </div>
            <div class="modal-body finance-modal-body">
                <EditForm Model="Vendor" OnValidSubmit="HandleSubmit">
                    <div class="row g-3">
                        <!-- Vendor Name -->
                        <div class="col-12">
                            <label class="form-label small fw-bold text-muted">Vendor Name</label>
                            <InputText @bind-Value="Vendor.Name" class="form-control rounded-4 shadow-sm" placeholder="e.g. Acme Corp" />
                        </div>

                        <!-- Priority & Default Category -->
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-muted">Priority Ranking</label>
                            <InputSelect @bind-Value="Vendor.Priority" class="form-select rounded-4 shadow-sm">
                                <option value="1">High Priority (1)</option>
                                <option value="2">Medium Priority (2)</option>
                                <option value="3">Low Priority (3)</option>
                            </InputSelect>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-muted">Default Bill Category</label>
                            <InputSelect @bind-Value="Vendor.DefaultCategoryId" class="form-select rounded-4 shadow-sm">
                                <option value="">-- No Default Category --</option>
                                @foreach (var cat in Categories)
                                {
                                    <option value="@cat.Id">@cat.Name</option>
                                }
                            </InputSelect>
                        </div>

                        <!-- Payment Type -->
                        <div class="col-12">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <label class="form-label small fw-bold text-muted mb-0">Default Payment Type</label>
                                <button type="button" class="btn btn-link btn-sm p-0 text-muted" style="font-size: 0.7rem;"
                                        @onclick="() => { ShowManagePaymentTypes = !ShowManagePaymentTypes; ShowAddPaymentType = false; }">
                                    <i class="bi bi-gear me-1"></i>@(ShowManagePaymentTypes ? "Done" : "Manage Types")
                                </button>
                            </div>

                            @if (ShowManagePaymentTypes)
                            {
                                <!-- Manage existing types -->
                                <div class="border rounded-4 overflow-hidden shadow-sm mb-2">
                                    @if (!PaymentTypes.Any())
                                    {
                                        <div class="p-3 text-center text-muted" style="font-size: 0.75rem;">No payment types yet.</div>
                                    }
                                    else
                                    {
                                        @foreach (var pt in PaymentTypes.ToList())
                                        {
                                            bool isEditing = EditingPaymentTypeId == pt.Id;
                                            <div class="d-flex align-items-center px-3 py-2 border-bottom bg-white hover-bg-light" style="gap: 8px;">
                                                @if (isEditing)
                                                {
                                                    <input type="text" class="form-control form-control-sm rounded-pill shadow-sm flex-grow-1"
                                                           style="font-size: 0.8rem;"
                                                           @bind="EditingPaymentTypeName"
                                                           @bind:event="oninput"
                                                           @onkeydown="HandleEditPaymentTypeKey" />
                                                    <button type="button" class="btn btn-sm btn-primary rounded-pill px-2 py-1 fw-bold"
                                                            style="font-size: 0.7rem;"
                                                            @onclick="() => SaveEditPaymentType(pt)"
                                                            disabled="@(string.IsNullOrWhiteSpace(EditingPaymentTypeName))">
                                                        Save
                                                    </button>
                                                    <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-2 py-1"
                                                            style="font-size: 0.7rem;"
                                                            @onclick="CancelEditPaymentType">
                                                        Cancel
                                                    </button>
                                                }
                                                else
                                                {
                                                    <span class="flex-grow-1 fw-bold" style="font-size: 0.8rem;">@pt.Name</span>
                                                    <button type="button" class="btn btn-sm btn-outline-secondary rounded-circle p-1"
                                                            style="width:28px; height:28px; line-height:1;"
                                                            title="Rename"
                                                            @onclick="() => BeginEditPaymentType(pt)">
                                                        <i class="bi bi-pencil" style="font-size: 0.65rem;"></i>
                                                    </button>
                                                    <button type="button" class="btn btn-sm btn-outline-danger rounded-circle p-1"
                                                            style="width:28px; height:28px; line-height:1;"
                                                            title="Remove"
                                                            @onclick="() => RemovePaymentType(pt)">
                                                        <i class="bi bi-trash" style="font-size: 0.65rem;"></i>
                                                    </button>
                                                }
                                            </div>
                                        }
                                    }
                                    <!-- Add new inside manage panel -->
                                    <div class="px-3 py-2 bg-light d-flex gap-2 align-items-center">
                                        <input type="text" class="form-control form-control-sm rounded-pill shadow-sm flex-grow-1"
                                               placeholder="New payment type name..."
                                               @bind="NewPaymentTypeName"
                                               @bind:event="oninput"
                                               @onkeydown="HandleAddPaymentTypeKey"
                                               style="font-size: 0.8rem;" />
                                        <button type="button" class="btn btn-sm btn-success rounded-pill px-3 fw-bold"
                                                style="font-size: 0.75rem; white-space: nowrap;"
                                                @onclick="SaveNewPaymentType"
                                                disabled="@(string.IsNullOrWhiteSpace(NewPaymentTypeName))">
                                            <i class="bi bi-plus"></i> Add
                                        </button>
                                    </div>
                                    @if (PaymentTypeError != null)
                                    {
                                        <div class="px-3 pb-2">
                                            <small class="text-danger fw-bold"><i class="bi bi-exclamation-circle me-1"></i>@PaymentTypeError</small>
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <!-- Normal dropdown mode -->
                                <div class="d-flex gap-2 align-items-center">
                                    <InputSelect @bind-Value="Vendor.DefaultPaymentTypeId" class="form-select rounded-4 shadow-sm flex-grow-1">
                                        <option value="">-- No Default Payment Type --</option>
                                        @foreach (var pt in PaymentTypes)
                                        {
                                            <option value="@pt.Id">@pt.Name</option>
                                        }
                                    </InputSelect>
                                    <button type="button" class="btn btn-outline-primary rounded-pill px-3 py-2 fw-bold shadow-sm"
                                            style="white-space: nowrap; font-size: 0.75rem;"
                                            @onclick="ToggleAddPaymentType"
                                            title="Add new payment type">
                                        <i class="bi bi-plus-circle me-1"></i> Add Type
                                    </button>
                                </div>

                                @if (ShowAddPaymentType)
                                {
                                    <div class="mt-2 p-3 border rounded-4 bg-light shadow-sm d-flex gap-2 align-items-center">
                                        <input type="text" class="form-control form-control-sm rounded-pill shadow-sm"
                                               placeholder="e.g. Wire Transfer"
                                               @bind="NewPaymentTypeName"
                                               @bind:event="oninput"
                                               @onkeydown="HandleAddPaymentTypeKey"
                                               style="font-size: 0.8rem;" />
                                        <button type="button" class="btn btn-sm btn-primary rounded-pill px-3 fw-bold shadow-sm"
                                                style="font-size: 0.75rem; white-space: nowrap;"
                                                @onclick="SaveNewPaymentType"
                                                disabled="@(string.IsNullOrWhiteSpace(NewPaymentTypeName))">
                                            Save
                                        </button>
                                        <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-3"
                                                style="font-size: 0.75rem;"
                                                @onclick="() => ShowAddPaymentType = false">
                                            Cancel
                                        </button>
                                        @if (PaymentTypeError != null)
                                        {
                                            <small class="text-danger fw-bold"><i class="bi bi-exclamation-circle me-1"></i>@PaymentTypeError</small>
                                        }
                                    </div>
                                }
                            }
                        </div>

                        <!-- Contact Email & Phone -->
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-muted">Email Address</label>
                            <InputText @bind-Value="Vendor.Email" class="form-control rounded-4 shadow-sm" placeholder="email@vendor.com" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-muted">Phone Number</label>
                            <InputText @bind-Value="Vendor.Phone" class="form-control rounded-4 shadow-sm" placeholder="(555) 555-5555" />
                        </div>

                        <!-- Website & Account Number -->
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-muted">Website URL</label>
                            <InputText @bind-Value="Vendor.Website" class="form-control rounded-4 shadow-sm" placeholder="https://www.vendor.com" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-muted">Account Number</label>
                            <InputText @bind-Value="Vendor.AccountNumber" class="form-control rounded-4 shadow-sm" placeholder="e.g. ACCT-123456" />
                        </div>

                        <!-- Contact Notes -->
                        <div class="col-12">
                            <label class="form-label small fw-bold text-muted">Contact Info / Notes</label>
                            <InputTextArea @bind-Value="Vendor.ContactInfo" class="form-control rounded-4 shadow-sm" rows="2" placeholder="Account numbers, specific sales rep, etc." />
                        </div>

                        <!-- Is Active Status -->
                        <div class="col-12">
                            <div class="recurring-container p-3 rounded-4 d-flex flex-column @(Vendor.IsActive ? "active" : "")">
                                <div class="form-check form-switch d-flex align-items-center gap-3">
                                    <InputCheckbox @bind-Value="Vendor.IsActive" class="form-check-input ms-0" id="isActiveSwitch" />
                                    <label class="form-check-label fw-bold mb-0" for="isActiveSwitch" style="cursor:pointer">Active Vendor</label>
                                </div>
                                <small class="text-muted mt-2 d-block">
                                    <i class="bi bi-info-circle me-1"></i> Inactive vendors will be hidden from new bill selections.
                                </small>
                            </div>
                        </div>
                    </div>

                    <div class="modal-footer border-0 px-0 mt-2 flex-column align-items-stretch">
                        @if (ValidationError != null)
                        {
                            <div class="alert alert-danger py-2 px-3 mb-3 d-flex align-items-center gap-2 shadow-sm rounded-4">
                                <i class="bi bi-exclamation-triangle-fill"></i>
                                <span class="small fw-bold">@ValidationError</span>
                            </div>
                        }
                        <div class="d-flex justify-content-between gap-2 w-100">
                            @if (Vendor.Id > 0)
                            {
                                <button type="button" class="btn btn-outline-danger rounded-pill px-4 fw-bold" @onclick="() => OnDeleteRequested.InvokeAsync(Vendor)">Delete Vendor</button>
                            }
                            else
                            {
                                <div></div>
                            }
                            <div class="d-flex gap-2">
                                <button type="button" class="btn btn-light rounded-pill px-4" @onclick="OnClose">Cancel</button>
                                <button type="submit" class="btn btn-primary rounded-pill px-4 shadow-sm">Save Vendor</button>
                            </div>
                        </div>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public FinanceVendor Vendor { get; set; } = new() { IsActive = true, Priority = 3 };
    [Parameter] public EventCallback<bool> OnSave { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<FinanceVendor> OnDeleteRequested { get; set; }
    [Parameter] public List<FinancePaymentType> PaymentTypes { get; set; } = new();

    private List<FinanceCategory> Categories { get; set; } = new();
    private string? ValidationError { get; set; }

    // Inline add payment type
    private bool ShowAddPaymentType { get; set; }
    private bool ShowManagePaymentTypes { get; set; }
    private string NewPaymentTypeName { get; set; } = string.Empty;
    private string? PaymentTypeError { get; set; }

    // Inline edit payment type
    private int EditingPaymentTypeId { get; set; }
    private string EditingPaymentTypeName { get; set; } = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        Categories = (await FinanceService.GetAllCategoriesAsync()).ToList();
    }

    private void ToggleAddPaymentType()
    {
        ShowAddPaymentType = !ShowAddPaymentType;
        NewPaymentTypeName = string.Empty;
        PaymentTypeError = null;
    }

    private async Task HandleAddPaymentTypeKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(NewPaymentTypeName))
            await SaveNewPaymentType();
    }

    private async Task SaveNewPaymentType()
    {
        PaymentTypeError = null;
        var trimmed = NewPaymentTypeName.Trim();
        if (string.IsNullOrWhiteSpace(trimmed))
        {
            PaymentTypeError = "Name is required.";
            return;
        }
        if (PaymentTypes.Any(pt => string.Equals(pt.Name, trimmed, StringComparison.OrdinalIgnoreCase)))
        {
            PaymentTypeError = "This payment type already exists.";
            return;
        }
        try
        {
            var created = await FinanceService.CreatePaymentTypeAsync(new FinancePaymentType { Name = trimmed });
            PaymentTypes.Add(created);
            PaymentTypes = PaymentTypes.OrderBy(pt => pt.Name).ToList();
            Vendor.DefaultPaymentTypeId = created.Id;
            NewPaymentTypeName = string.Empty;
            ShowAddPaymentType = false;
        }
        catch (Exception ex)
        {
            PaymentTypeError = $"Error: {ex.Message}";
        }
    }

    private void BeginEditPaymentType(FinancePaymentType pt)
    {
        EditingPaymentTypeId = pt.Id;
        EditingPaymentTypeName = pt.Name;
        PaymentTypeError = null;
    }

    private void CancelEditPaymentType()
    {
        EditingPaymentTypeId = 0;
        EditingPaymentTypeName = string.Empty;
        PaymentTypeError = null;
    }

    private async Task HandleEditPaymentTypeKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(EditingPaymentTypeName))
        {
            var pt = PaymentTypes.FirstOrDefault(p => p.Id == EditingPaymentTypeId);
            if (pt != null) await SaveEditPaymentType(pt);
        }
        else if (e.Key == "Escape")
        {
            CancelEditPaymentType();
        }
    }

    private async Task SaveEditPaymentType(FinancePaymentType pt)
    {
        PaymentTypeError = null;
        var trimmed = EditingPaymentTypeName.Trim();
        if (string.IsNullOrWhiteSpace(trimmed))
        {
            PaymentTypeError = "Name cannot be empty.";
            return;
        }
        if (PaymentTypes.Any(p => p.Id != pt.Id && string.Equals(p.Name, trimmed, StringComparison.OrdinalIgnoreCase)))
        {
            PaymentTypeError = "A payment type with that name already exists.";
            return;
        }
        try
        {
            pt.Name = trimmed;
            await FinanceService.UpdatePaymentTypeAsync(pt);
            PaymentTypes = PaymentTypes.OrderBy(p => p.Name).ToList();
            EditingPaymentTypeId = 0;
            EditingPaymentTypeName = string.Empty;
        }
        catch (Exception ex)
        {
            PaymentTypeError = $"Error: {ex.Message}";
        }
    }

    private async Task RemovePaymentType(FinancePaymentType pt)
    {
        try
        {
            await FinanceService.DeletePaymentTypeAsync(pt.Id);
            // If this vendor had this type selected, clear the selection
            if (Vendor.DefaultPaymentTypeId == pt.Id)
                Vendor.DefaultPaymentTypeId = null;
            PaymentTypes.Remove(pt);
        }
        catch (Exception ex)
        {
            PaymentTypeError = $"Error: {ex.Message}";
        }
    }

    private async Task HandleSubmit()
    {
        ValidationError = null;

        if (string.IsNullOrWhiteSpace(Vendor.Name))
        {
            ValidationError = "Please enter a vendor name.";
            return;
        }

        try
        {
            if (Vendor.Id == 0)
            {
                await FinanceService.CreateVendorAsync(Vendor);
            }
            else
            {
                await FinanceService.UpdateVendorAsync(Vendor);
            }
            await OnSave.InvokeAsync(true);
        }
        catch (Exception ex)
        {
            ValidationError = $"Error saving vendor: {ex.Message}";
        }
    }
}
