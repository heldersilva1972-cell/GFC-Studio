    // =========================================================================
    // CONFIRMATION WORKFLOWS
    // =========================================================================

    private void RequestSaveShift()
    {
        if (_editingShift == null) return;

        if (string.IsNullOrWhiteSpace(_editingShift.Username))
        {
            ToastService.ShowWarning("Please select an employee.");
            return;
        }

        if (!_editingShift.Hours.HasValue || _editingShift.Hours.Value <= 0)
        {
            ToastService.ShowWarning("Please enter a valid number of hours (greater than 0).");
            return;
        }

        var empName = !string.IsNullOrWhiteSpace(_editingShift.MemberName) 
            ? _editingShift.MemberName 
            : GetUserDisplayName(_editingShift.Username);

        if (_editingShift.IsNew)
        {
            _confirmData = new ShiftConfirmationModel
            {
                ActionType = "Add",
                Title = "Confirm Adding Shift Hours",
                TargetId = null,
                Username = _editingShift.Username,
                EmployeeName = empName,
                Date = _editingShift.Date,
                ShiftType = _editingShift.ShiftType,
                Location = _editingShift.Location,
                PreviousHours = null,
                NewHours = _editingShift.Hours.Value,
                Notes = _editingShift.Notes
            };
        }
        else
        {
            _confirmData = new ShiftConfirmationModel
            {
                ActionType = "Edit",
                Title = "Confirm Updating Shift Hours",
                TargetId = _editingShift.Id,
                Username = _editingShift.Username,
                EmployeeName = empName,
                Date = _editingShift.Date,
                ShiftType = _editingShift.ShiftType,
                Location = _editingShift.Location,
                PreviousHours = _editingShift.OriginalHours,
                NewHours = _editingShift.Hours.Value,
                Notes = _editingShift.Notes
            };
        }

        _showConfirmModal = true;
    }

    private void RequestDeleteCurrentShift()
    {
        if (_editingShift == null || _editingShift.Id == null || _editingShift.Id <= 0) return;

        var empName = !string.IsNullOrWhiteSpace(_editingShift.MemberName) 
            ? _editingShift.MemberName 
            : GetUserDisplayName(_editingShift.Username);

        _confirmData = new ShiftConfirmationModel
        {
            ActionType = "Delete",
            Title = "Confirm Deleting Shift Record",
            TargetId = _editingShift.Id,
            Username = _editingShift.Username,
            EmployeeName = empName,
            Date = _editingShift.Date,
            ShiftType = _editingShift.ShiftType,
            Location = _editingShift.Location,
            PreviousHours = _editingShift.OriginalHours ?? _editingShift.Hours,
            NewHours = 0,
            Notes = _editingShift.Notes
        };

        _showConfirmModal = true;
    }

    private void PromptDeleteShift(ShiftDetailItem s)
    {
