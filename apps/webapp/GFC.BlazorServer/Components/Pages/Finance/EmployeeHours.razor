                                            <label class="small fw-bold text-muted mb-1">PFML Employee Share (%)</label>
                                            <div class="input-group">
                                                <input type="number" class="form-control" step="0.01" @bind="_pfmlEmployeeRate" />
                                                <span class="input-group-text">%</span>
                                            </div>
