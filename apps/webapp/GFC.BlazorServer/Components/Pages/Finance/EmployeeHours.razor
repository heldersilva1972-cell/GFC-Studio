@page "/finance/employee-hours"
@using Microsoft.AspNetCore.Authorization
@using GFC.BlazorServer.Services
@using GFC.Core.Models
@using GFC.Core.DTOs
@inject IFinancialAnalyticsService FinancialService
@inject IJSRuntime JS
@inject Microsoft.EntityFrameworkCore.IDbContextFactory<GFC.BlazorServer.Data.GfcDbContext> DbFactory
@inject IToastService ToastService
@attribute [Authorize]
@using Microsoft.EntityFrameworkCore

<PageTitle>Employee Hours Worked | GFC Finance</PageTitle>

<style>
    .hours-page {
        min-height: calc(100vh - 65px);
        background: radial-gradient(circle at top right, #f8fafc, #eff6ff);
        padding: 1.5rem;
    }

    .glass-card {
        background: rgba(255, 255, 255, 0.9);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.2);
        border-radius: 24px;
        box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.05);
        padding: 1.5rem;
        height: 100%;
    }

    .stat-card {
        background: white;
        border-radius: 20px;
        padding: 1.25rem;
        border: 1px solid #f1f5f9;
        transition: all 0.3s ease;
    }

    .stat-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 15px 30px -5px rgba(59, 130, 246, 0.1);
        border-color: #3b82f644;
    }

    .stat-icon {
        width: 48px;
        height: 48px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 1rem;
        font-size: 1.5rem;
    }

    .icon-blue { background: #eff6ff; color: #3b82f6; }
    .icon-green { background: #ecfdf5; color: #10b981; }
    .icon-purple { background: #f5f3ff; color: #8b5cf6; }
    .icon-orange { background: #fff7ed; color: #f59e0b; }

    .period-selector {
        background: #f1f5f9;
        padding: 0.35rem;
        border-radius: 14px;
        display: inline-flex;
        gap: 0.25rem;
    }

    .period-btn {
        border: none;
        background: transparent;
        padding: 0.5rem 1.25rem;
        border-radius: 10px;
        font-size: 0.85rem;
        font-weight: 700;
        color: #64748b;
        transition: all 0.2s;
    }

    .period-btn.active {
        background: white;
        color: #3b82f6;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
    }

    .hours-table th {
        background: #f8fafc;
        color: #64748b;
        font-weight: 700;
        text-transform: uppercase;
        font-size: 0.75rem;
        letter-spacing: 0.05em;
        border-top: none;
        padding: 1rem;
    }

    .hours-table td {
        padding: 1rem;
        vertical-align: middle;
        border-bottom: 1px solid #f1f5f9;
    }

    .user-avatar {
        width: 36px;
        height: 36px;
        background: #3b82f6;
        color: white;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 0.9rem;
    }

    .hours-badge {
        font-size: 0.9rem;
        font-weight: 700;
        padding: 0.4rem 0.8rem;
        border-radius: 10px;
    }

    .badge-primary { background: #eff6ff; color: #3b82f6; }

    .search-input {
        border: 2px solid #f1f5f9;
        border-radius: 14px;
        padding: 0.6rem 1rem;
        font-size: 0.9rem;
        transition: all 0.2s;
        background: #f8fafc;
    }

    .search-input:focus {
        border-color: #3b82f6;
        background: white;
        box-shadow: 0 0 0 4px rgba(59, 130, 246, 0.1);
        outline: none;
    }

    .empty-state {
        padding: 4rem 2rem;
        text-align: center;
    }

    .empty-icon {
        font-size: 4rem;
        color: #e2e8f0;
        margin-bottom: 1.5rem;
    }

    .table-scroll-container {
        max-height: calc(100vh - 440px);
        overflow-y: auto;
        scrollbar-width: thin;
        scrollbar-color: #e0e0e0 transparent;
    }

    .table-scroll-container::-webkit-scrollbar {
        width: 6px;
    }
    
    .table-scroll-container::-webkit-scrollbar-track {
        background: transparent;
    }
    
    .table-scroll-container::-webkit-scrollbar-thumb {
        background-color: #e0e0e0;
        border-radius: 10px;
    }

    .table thead th {
        position: sticky;
        top: 0;
        z-index: 100;
        background-color: #f8f9fa !important;
        border-bottom: 2px solid #dee2e6 !important;
    }

    .table tfoot td {
        position: sticky;
        bottom: 0;
        z-index: 90;
        background-color: #f8f9fa !important;
        border-top: 2px solid #dee2e6 !important;
    }

    /* Sticky First Column for Breakdown View */
    .hours-table th:first-child,
    .hours-table td:first-child {
        position: sticky;
        left: 0;
        background-color: white !important;
        z-index: 10;
        border-right: 1px solid #dee2e6 !important;
        box-shadow: 2px 0 5px rgba(0,0,0,0.05);
    }

    .hours-table thead th:first-child {
        z-index: 110 !important; /* Higher than sticky headers */
        background-color: #f8f9fa !important;
    }

    .hours-table tfoot td:first-child {
        z-index: 105 !important;
        background-color: #f8f9fa !important;
    }

    /* Sticky Last 3 Columns for Breakdown View */
    .sticky-right-audit-1 { 
        position: sticky; right: 0; background: white !important; z-index: 20; 
        border-left: 1px solid #dee2e6 !important; box-shadow: -2px 0 5px rgba(0,0,0,0.05);
        min-width: 100px !important;
    }
    .sticky-right-audit-2 { 
        position: sticky; right: 100px; background: white !important; z-index: 20; 
        border-left: 1px solid #dee2e6 !important;
        min-width: 100px !important;
    }
    .sticky-right-audit-3 { 
        position: sticky; right: 200px; background: white !important; z-index: 20; 
        border-left: 1px solid #dee2e6 !important;
        min-width: 80px !important;
    }

    .hours-table thead th.sticky-right-audit-1,
    .hours-table thead th.sticky-right-audit-2,
    .hours-table thead th.sticky-right-audit-3 {
        z-index: 110 !important;
        background-color: #f8f9fa !important;
    }

    .hours-table tfoot td.sticky-right-audit-1,
    .hours-table tfoot td.sticky-right-audit-2,
    .hours-table tfoot td.sticky-right-audit-3 {
        z-index: 105 !important;
        background-color: #f8f9fa !important;
    }

    @@media print {
        @@page { size: portrait; margin: 1cm; overflow: visible; }
        
        /* Hide ALL framework shell elements */
        .app-topbar, .app-sidebar, .sidebar-overlay, .menu-toggle-btn, .theme-toggle, .desktop-actions, .app-badge, .badge, .btn-primary, .btn-light, .btn-white {
            display: none !important;
        }

        /* Reset all layout containers to be plain blocks */
        .app-shell, .app-main, .app-content, .content, .container-fluid, .hours-page, .glass-card {
            display: block !important;
            margin: 0 !important;
            padding: 0 !important;
            border: none !important;
            box-shadow: none !important;
            background: white !important;
            width: 100% !important;
            max-width: none !important;
            min-height: auto !important;
            overflow: visible !important;
            float: none !important;
        }

        /* Hide interactive controls and placeholders */
        .no-print, nav, .sidebar, .period-selector, .search-box, .btn, .breadcrumb, .stat-card, footer, .main-header, .search-input, .settings-btn, .table-content-area, .spinner-border { 
            display: none !important; 
        }
        
        #blazor-error-ui { display: none !important; }
        
        /* Force display of the detailed report only */
        .print-only-report { 
            display: block !important; 
            width: 100% !important;
            margin: 0 !important;
            padding: 0 !important;
            visibility: visible !important;
        }
    }

    .print-only-report { display: none; }

    /* Shift Badge Styling - Ultra Readable & Distinct */
    .shift-badge-day { 
        background-color: rgba(13, 110, 253, 0.25) !important; 
        color: #0d47a1 !important; 
        border: 1px solid rgba(13, 110, 253, 0.4) !important;
        font-weight: 800 !important;
    }
    .shift-badge-night { 
        background-color: rgba(225, 29, 72, 0.2) !important; 
        color: #be123c !important; 
        border: 1px solid rgba(225, 29, 72, 0.4) !important;
        font-weight: 800 !important;
    }
    .shift-badge-both { 
        background-color: rgba(25, 135, 84, 0.2) !important; 
        color: #065f46 !important; 
        border: 1px solid rgba(25, 135, 84, 0.4) !important;
        font-weight: 800 !important;
    }
    .shift-badge-hall { 
        background-color: rgba(107, 114, 128, 0.25) !important; 
        color: #374151 !important; 
        border: 1px solid rgba(107, 114, 128, 0.4) !important;
        font-weight: 800 !important;
    }
</style>

<div class="hours-page">
    <div class="container-fluid max-width-1400">
        <!-- Header Section -->
        <div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4 no-print">
            <div>
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-1">
                        <li class="breadcrumb-item text-muted small">Finance</li>
                        <li class="breadcrumb-item active small" aria-current="page">Employee Hours</li>
                    </ol>
                </nav>
                <h1 class="h3 fw-bold mb-0 text-dark">Employee Hours Worked</h1>
                <p class="text-muted small mb-0">Tracking active shifts and reported work hours for mobile sales staff.</p>
            </div>

            <div class="d-flex gap-3 align-items-center">
                <div class="period-selector">
                    <button class="period-btn @(_viewMode == "Week" ? "active" : "")" @onclick='() => SetViewMode("Week")'>WEEKLY</button>
                    <button class="period-btn @(_viewMode == "Month" ? "active" : "")" @onclick='() => SetViewMode("Month")'>MONTHLY</button>
                    <button class="period-btn @(_viewMode == "Year" ? "active" : "")" @onclick='() => SetViewMode("Year")'>YEARLY</button>
                </div>

                <div class="d-flex gap-2">
                    @if (_viewMode == "Month" || _viewMode == "Year")
                    {
                        @if (_viewMode == "Month")
                        {
                            <select class="form-select border-0 shadow-sm rounded-3 me-2" @bind="_selectedMonth" @bind:after="LoadData">
                                @foreach (var m in Enumerable.Range(1, 12))
                                {
                                    <option value="@m">@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(m)</option>
                                }
                            </select>
                        }
                        <select class="form-select border-0 shadow-sm rounded-3" @bind="_selectedYear" @bind:after="LoadData">
                            @foreach (var year in _availableYears)
                            {
                                <option value="@year">@year</option>
                            }
                        </select>
                    }
                    else if (_viewMode == "Week")
                    {
                        <select class="form-select border-0 shadow-sm rounded-3" @bind="_selectedWeek" @bind:after="LoadData">
                            @foreach (var week in _weekOptions)
                            {
                                <option value="@week.Value">@week.Text</option>
                            }
                        </select>
                    }
                </div>

                <button class="btn btn-light shadow-sm rounded-3 me-2 border fw-bold" @onclick="() => _showPayrollSettings = true">
                    <i class="bi bi-gear-fill me-2 text-primary"></i> Settings
                </button>

                <button class="btn btn-white shadow-sm rounded-3 btn-print border" @onclick="PrintReport">
                    <i class="bi bi-printer me-2"></i> Print
                </button>
            </div>
        </div>

        <!-- COMPRESSED SUMMARY STATS -->
        <div class="row g-2 mb-3 no-print">
            <!-- TILE 1: LABOR ACTIVITY -->
            <div class="col-md-4">
                <div class="stat-card p-2 px-3 h-100 shadow-sm border-0 bg-white">
                    <div class="d-flex align-items-center gap-3">
                        <div class="stat-icon icon-blue mb-0" style="width: 32px; height: 32px; font-size: 1rem; flex-shrink: 0;">
                            <i class="bi bi-clock-history"></i>
                        </div>
                        <div class="row g-0 flex-grow-1">
                            <div class="col-6 border-end pe-2 text-center">
                                <div class="text-muted x-small fw-black text-uppercase opacity-75">Work Hours</div>
                                <div class="h5 fw-black text-dark mb-0">@_summaryTotalHours.ToString("N1")</div>
                            </div>
                            <div class="col-6 ps-2 text-center">
                                <div class="text-muted x-small fw-black text-uppercase opacity-75">Total Shifts</div>
                                <div class="h5 fw-black text-dark mb-0">@_summaryTotalShifts</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- TILE 2: TAXES -->
            <div class="col-md-4">
                <div class="stat-card p-2 px-3 h-100 shadow-sm border-0 border-start border-primary border-4 bg-white">
                    <div class="row g-0 align-items-center">
                        <div class="col-5 border-end pe-2 text-center">
                            <div class="text-muted x-small fw-black text-uppercase opacity-75">TAXES PAYABLE</div>
                            <div class="h5 fw-black text-primary mb-0">@(FilteredData.Sum(d => d.TotalWithheld + d.TotalEmployerAddOn).ToString("C"))</div>
                        </div>
                        <div class="col-7 ps-3">
                            <div class="d-flex justify-content-between x-small py-1 border-bottom border-light">
                                <span class="text-muted fw-bold">Withheld</span>
                                <span class="fw-bold">@FilteredData.Sum(d => d.TotalWithheld).ToString("C")</span>
                            </div>
                            <div class="d-flex justify-content-between x-small pt-1">
                                <span class="text-muted fw-bold">Club Add-on</span>
                                <span class="fw-bold">@FilteredData.Sum(d => d.TotalEmployerAddOn).ToString("C")</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- TILE 3: CLUB COST -->
            <div class="col-md-4">
                <div class="stat-card p-2 px-3 h-100 shadow-sm border-0 bg-white">
                    <div class="d-flex align-items-center gap-3">
                        <div class="stat-icon icon-orange mb-0" style="width: 32px; height: 32px; font-size: 1rem; flex-shrink: 0;">
                            <i class="bi bi-wallet2"></i>
                        </div>
                        <div class="row g-0 flex-grow-1">
                            <div class="col-6 border-end pe-2 text-center">
                                <div class="text-muted x-small fw-black text-uppercase opacity-75">Gross Pay</div>
                                <div class="h5 fw-bold text-dark mb-0">@FilteredData.Sum(d => d.TotalPay).ToString("C0")</div>
                            </div>
                            <div class="col-6 ps-2 text-center">
                                <div class="text-muted x-small fw-black text-uppercase opacity-75">Total Club Cost</div>
                                <div class="h5 fw-black text-primary mb-0">@FilteredData.Sum(d => d.TotalPayrollCost).ToString("C0")</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Main Content Card -->
        <div class="glass-card">
            <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 no-print">
                <div class="d-flex align-items-center gap-3">
                    <div class="btn-group p-1 bg-light rounded-pill shadow-sm">
                        <button class="btn btn-sm rounded-pill px-3 fw-black @(_layoutMode == "List" ? "btn-dark shadow-sm" : "btn-light text-muted")" 
                                @onclick='() => _layoutMode = "List"'>
                            <i class="bi bi-list-ul me-1"></i> SUMMARY
                        </button>
                        <button class="btn btn-sm rounded-pill px-3 fw-black @(_layoutMode == "Grid" ? "btn-dark shadow-sm" : "btn-light text-muted")" 
                                @onclick='() => _layoutMode = "Grid"'>
                            <i class="bi bi-grid-3x3-gap-fill me-1"></i> BREAKDOWN
                        </button>
                    </div>
                </div>
                <div class="search-box position-relative no-print" style="min-width: 300px;">
                    <i class="bi bi-search position-absolute text-muted" style="left: 1rem; top: 50%; transform: translateY(-50%);"></i>
                    <input type="text" class="search-input w-100 ps-5" placeholder="Search by name or username..." @bind="_searchQuery" @bind:event="oninput" />
                </div>
            </div>

            <!-- PRINT ONLY REPORT HEADER -->
            <div class="print-only-report">
                <div class="d-flex justify-content-between align-items-center border-bottom pb-4 mb-4">
                    <div>
                        <h1 class="h2 fw-black mb-1">PAYROLL SUMMARY</h1>
                        <div class="text-primary fw-bold fs-5">Downstairs Bar Report</div>
                        <div class="text-muted fw-bold mt-2">
                            <i class="bi bi-calendar3 me-2"></i>
                            @(_viewMode == "Month" ? $"{System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(_selectedMonth)} {_selectedYear}" : $"{_startDate:MMM dd, yyyy} - {_endDate:MMM dd, yyyy}")
                        </div>
                    </div>
                    <div class="text-end">
                        <div class="small fw-black text-muted uppercase">GENERATED ON</div>
                        <div class="fw-bold">@DateTime.Now.ToString("G")</div>
                    </div>
                </div>

                <div class="row g-0 border rounded-4 overflow-hidden mb-4 bg-light">
                    <div class="col-3 p-4 border-end">
                        <div class="x-small fw-black text-muted mb-1 text-uppercase">GROSS PAYROLL</div>
                        <div class="h3 fw-black mb-0">@FilteredData.Sum(d => d.TotalPay).ToString("C")</div>
                        <div class="x-small text-muted opacity-75">Pre-Tax Total</div>
                    </div>
                    <div class="col-3 p-4 border-end">
                        <div class="x-small fw-black text-muted mb-1 text-uppercase">Tax Liabilities</div>
                        <div class="h3 fw-black text-danger mb-0">@TotalTaxLiability.ToString("C")</div>
                        <div class="x-small text-muted opacity-75">Emp + Club</div>
                    </div>
                    <div class="col-3 p-4 border-end">
                        <div class="x-small fw-black text-muted mb-1 text-uppercase">Employee Net</div>
                        <div class="h3 fw-black text-success mb-0">@FilteredData.Sum(d => d.NetPay).ToString("C")</div>
                        <div class="x-small text-muted opacity-75">Est. Check Totals</div>
                    </div>
                    <div class="col-3 p-4 bg-primary text-white">
                        <div class="x-small fw-black mb-1 text-uppercase opacity-75">TOTAL CLUB COST</div>
                        <div class="h2 fw-black mb-0">@FilteredData.Sum(d => d.TotalPayrollCost).ToString("C")</div>
                    </div>
                </div>

                <div class="card border-0 bg-light rounded-4 p-4 mb-5 border">
                    <h6 class="fw-black mb-3">TAX BREAKDOWN AUDIT</h6>
                    <div class="row g-5">
                        <div class="col-6">
                            <div class="d-flex justify-content-between mb-2">
                                <span class="text-muted small fw-bold">STATE TAX & UI</span>
                                <span class="fw-bold">@((TotalStateTax + TotalUi).ToString("C"))</span>
                            </div>
                            <div class="d-flex justify-content-between mb-2">
                                <span class="text-muted small fw-bold">FICA LIABILITY (SSI)</span>
                                <span class="fw-bold">@TotalFica.ToString("C")</span>
                            </div>
                        </div>
                        <div class="col-6 text-end">
                            <div class="d-flex justify-content-between mb-2 ps-5">
                                <span class="text-muted small fw-bold">PFML TOTALS</span>
                                <span class="fw-bold">@TotalPfml.ToString("C")</span>
                            </div>
                            <div class="d-flex justify-content-between pt-2 border-top ps-5">
                                <span class="fw-black text-uppercase small">TOTAL REMITTANCE</span>
                                <span class="fw-black text-danger fs-5">@TotalTaxLiability.ToString("C")</span>
                            </div>
                        </div>
                    </div>
                </div>

                <h6 class="fw-black text-uppercase border-bottom pb-2 mb-3" style="letter-spacing: 0.1rem;">EMPLOYEE LABOR BREAKDOWN</h6>
                <table class="table table-bordered align-middle">
                    <thead class="bg-light">
                        <tr class="x-small fw-black text-uppercase">
                            <th class="ps-3">Employee</th>
                            <th class="text-center">Rate</th>
                            <th class="text-center">Hours</th>
                            <th class="text-end">Gross Pay</th>
                            <th class="text-end">Net Check</th>
                            <th class="text-end pe-3">Total Cost</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in FilteredData)
                        {
                            <tr>
                                <td class="ps-3 py-2">
                                    <div class="fw-bold text-dark">@item.MemberName</div>
                                    <div class="x-small text-muted">@item.Username</div>
                                </td>
                                <td class="text-center small">@item.HourlyRate?.ToString("C")</td>
                                <td class="text-center fw-bold">@item.TotalHours.ToString("N1")</td>
                                <td class="text-end small">@item.TotalPay.ToString("C")</td>
                                <td class="text-end fw-black">@item.NetPay.ToString("C")</td>
                                <td class="text-end pe-3 text-primary fw-bold">@item.TotalPayrollCost.ToString("C")</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="bg-light fw-black">
                        <tr>
                            <td colspan="2" class="ps-3">TOTALS</td>
                            <td class="text-center">@FilteredData.Sum(d => d.TotalHours).ToString("N1")</td>
                            <td class="text-end">@FilteredData.Sum(d => d.TotalPay).ToString("C")</td>
                            <td class="text-end">@FilteredData.Sum(d => d.NetPay).ToString("C")</td>
                            <td class="text-end pe-3">@FilteredData.Sum(d => d.TotalPayrollCost).ToString("C")</td>
                        </tr>
                    </tfoot>
                </table>

                <div class="text-center mt-5 pt-5 x-small text-muted opacity-50 border-top">
                    This report is and its calculations are based on Massachusetts state tax regulations as configured in System Settings.<br/>
                    End of Report - GFC Management System
                </div>
            </div>

            <div class="table-content-area">
                @if (_loading)
                {
                    <div class="text-center py-5 shadow-sm rounded-4 bg-white border">
                        <div class="spinner-border text-primary" role="status"></div>
                        <p class="mt-3 text-muted fw-bold">Gathering shift records...</p>
                    </div>
                }
                else if (!FilteredData.Any())
                {
                    <div class="empty-state text-center py-5 bg-white rounded-4 border shadow-sm">
                        <i class="bi bi-calendar-x display-4 text-muted opacity-25"></i>
                        <h3 class="h5 fw-bold text-dark mt-3">No records found</h3>
                        <p class="text-muted">There are no hours reported for the selected period.</p>
                    </div>
                }
                else
                {
                    @if (_layoutMode == "Grid")
                    {
                        <div class="d-flex align-items-center justify-content-between mb-3 px-4 border shadow-sm py-2 rounded-4 bg-light bg-opacity-50 no-print">
                            <div class="small fw-black text-muted text-uppercase tracking-wider">Shift Legend:</div>
                            <div class="d-flex gap-4">
                                <div class="d-flex align-items-center gap-2">
                                    <div class="rounded-1" style="width: 12px; height: 12px; background: rgba(13, 110, 253, 0.25); border: 1px solid rgba(13, 110, 253, 0.4);"></div>
