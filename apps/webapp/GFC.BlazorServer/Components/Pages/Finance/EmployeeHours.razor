@if (showRateModal)
{
    <div class="modal fade show" tabindex="-1" style="display: block; background: rgba(0,0,0,0.6); backdrop-filter: blur(8px); z-index: 1080;" role="dialog">
        <div class="modal-dialog modal-sm modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg" style="border-radius: 24px; overflow: hidden;">
