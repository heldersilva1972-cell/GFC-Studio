    private IEnumerable<EmployeeHoursDto> FilteredData => _data
        .Where(d => string.IsNullOrEmpty(_searchQuery) || 
                   (d.MemberName?.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase) ?? false) ||
                   d.Username.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        _loading = true;
        try 
        {
            using var db = await DbFactory.CreateDbContextAsync();
            var sys = await db.SystemSettings.FirstOrDefaultAsync() ?? new SystemSettings();
            
            _availableYears = await FinancialService.GetAvailableYearsAsync();
            if (!_availableYears.Contains(DateTime.Now.Year)) _availableYears.Insert(0, DateTime.Now.Year);
            
            PopulateWeekOptions();
            await LoadAllUsers();
            await LoadData();
        }
        catch (Exception ex)
        {
            await ToastService.ShowError($"Employee Hours Init Error: {ex.Message}");
            Console.WriteLine($"[ERROR] OnInitializedAsync failed: {ex}");
            _data = new List<EmployeeHoursDto>();
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task LoadAllUsers()
    {
        try
        {
            using var db = await DbFactory.CreateDbContextAsync();
            allSystemUsers = await db.AppUsers.AsNoTracking()
                .OrderBy(u => u.Username)
                .ToListAsync();
            
            var members = await db.Members.AsNoTracking().ToListAsync();
            userDisplayNames.Clear();
            foreach (var u in allSystemUsers)
            {
                var member = u.MemberId.HasValue ? members.FirstOrDefault(m => m.MemberID == u.MemberId.Value) : null;
                var name = member != null ? $"{member.FirstName} {member.LastName}".Trim() : u.Username;
                userDisplayNames[u.Username] = name;
            }
        }
        catch (Exception ex)
        {
            await ToastService.ShowError($"Employee Load Error: {ex.Message}");
        }
    }

    private string GetUserDisplayName(string? username)
    {
        if (string.IsNullOrWhiteSpace(username)) return "Unknown";
        if (userDisplayNames.TryGetValue(username, out var name) && !string.IsNullOrWhiteSpace(name)) return name;
        return username;
    }

    private IEnumerable<DateTime> GetWeekDays()
    {
        for (var d = _startDate.Date; d <= _endDate.Date; d = d.AddDays(1)) yield return d;
    }

    // =========================================================================
    // SHIFT ROSTER & EDITING ACTIONS
    // =========================================================================

    private async Task OpenEmployeeShiftsRoster(EmployeeHoursDto item)
    {
        _selectedRosterEmployee = item;
        await LoadRosterShiftsAsync(item.Username);
        _showShiftRoster = true;
        StateHasChanged();
    }

    private async Task LoadRosterShiftsAsync(string username)
    {
        try
        {
            using var db = await DbFactory.CreateDbContextAsync();
            var entries = await db.BarSaleEntries.IgnoreQueryFilters().AsNoTracking()
                .Where(e => !e.IsDeleted && 
                       (e.AdjustedSaleDate ?? e.SaleDate) >= _startDate.Date && 
                       (e.AdjustedSaleDate ?? e.SaleDate) <= _endDate.Date &&
                       (e.EmployeeUsername == username || e.ModifiedBy == username || e.CreatedBy == username))
                .OrderByDescending(e => (e.AdjustedSaleDate ?? e.SaleDate))
                .ToListAsync();

            _rosterShifts = entries.Select(e => new ShiftDetailItem
            {
                Id = e.Id,
                Date = (e.AdjustedSaleDate ?? e.SaleDate).Date,
                ShiftType = e.Shift ?? "Day",
                Location = (e.IsRentalHall || e.Shift == "Hall") ? "Hall" : (e.BarLocation ?? "Main"),
                Hours = e.TotalHours ?? 0,
                Notes = e.Notes,
                HourlyRate = e.HourlyRate_AtTimeOfShift ?? _selectedRosterEmployee?.HourlyRate,
                Status = e.Status
            }).ToList();
        }
        catch (Exception ex)
        {
            await ToastService.ShowError($"Error loading shifts: {ex.Message}");
        }
    }

