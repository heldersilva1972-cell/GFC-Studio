                                            <label class="small fw-bold text-muted mb-1">FICA Employer Share (%)</label>
                                            <div class="input-group">
                                                <input type="number" class="form-control" step="0.01" @bind="_ficaEmployerRate" />
                                                <span class="input-group-text">%</span>
                                            </div>
                                        </div>
                                        <div class="mb-3">
                                            <label class="small fw-bold text-muted mb-1">PFML Employer Share (%)</label>
                                            <div class="input-group">
                                                <input type="number" class="form-control" step="0.01" @bind="_pfmlEmployerRate" />
                                                <span class="input-group-text">%</span>
                                            </div>
                                        </div>
