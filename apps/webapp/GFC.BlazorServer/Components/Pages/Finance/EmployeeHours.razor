    private async Task ExecuteConfirmedActionAsync()
    {
        if (_confirmData == null) return;

        _savingShift = true;
        StateHasChanged();

        try
        {
            using var db = await DbFactory.CreateDbContextAsync();
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var currentUser = authState.User.Identity?.Name ?? "Manager";

            if (_confirmData.ActionType == "Delete")
            {
                if (_confirmData.TargetId.HasValue && _confirmData.TargetId.Value > 0)
                {
                    var record = await db.BarSaleEntries.FirstOrDefaultAsync(e => e.Id == _confirmData.TargetId.Value);
                    if (record != null)
                    {
                        record.IsDeleted = true;
                        record.TotalHours = 0;
                        record.ModifiedBy = currentUser;
                        record.ModifiedAt = DateTime.UtcNow;
                        await db.SaveChangesAsync();
                    }
                }
                await ToastService.ShowSuccess($"Removed shift record for {_confirmData.EmployeeName}.");
            }
            else // Add or Edit
            {
                BarSaleEntry? record = null;
                if (_editingShift?.Id.HasValue == true && _editingShift.Id.Value > 0)
                {
                    record = await db.BarSaleEntries.FirstOrDefaultAsync(e => e.Id == _editingShift.Id.Value);
                }

                var isHall = _editingShift!.Location == "Hall" || _editingShift.ShiftType == "Hall";

                if (record == null)
                {
                    // Create new BarSaleEntry
                    record = new BarSaleEntry
                    {
                        SaleDate = _editingShift.Date.Date,
                        AdjustedSaleDate = _editingShift.Date.Date,
                        Shift = _editingShift.ShiftType,
                        IsRentalHall = isHall,
                        BarLocation = _editingShift.Location,
                        TotalHours = _editingShift.Hours,
                        EmployeeUsername = _editingShift.Username,
                        Notes = _editingShift.Notes,
                        Status = "Audited",
                        IsAudited = true,
                        CreatedAt = DateTime.UtcNow,
                        CreatedBy = currentUser,
                        ModifiedBy = currentUser
                    };

                    var userObj = await db.AppUsers.AsNoTracking().FirstOrDefaultAsync(u => u.Username == _editingShift.Username);
                    if (userObj != null)
                    {
                        var yearWage = await db.YearlyWages.AsNoTracking().FirstOrDefaultAsync(w => w.Username == _editingShift.Username && w.Year == _editingShift.Date.Year);
                        record.HourlyRate_AtTimeOfShift = yearWage?.HourlyRate ?? userObj.HourlyRate;
                    }

                    db.BarSaleEntries.Add(record);
                }
                else
                {
                    record.AdjustedSaleDate = _editingShift.Date.Date;
                    record.Shift = _editingShift.ShiftType;
                    record.IsRentalHall = isHall;
                    record.BarLocation = _editingShift.Location;
                    record.TotalHours = _editingShift.Hours;
                    record.EmployeeUsername = _editingShift.Username;
                    record.Notes = _editingShift.Notes;
                    record.Status = "Audited";
                    record.IsAudited = true;
                    record.ModifiedBy = currentUser;
                    record.ModifiedAt = DateTime.UtcNow;
                }

                await db.SaveChangesAsync();
                await ToastService.ShowSuccess($"Shift hours successfully {(_editingShift.IsNew ? "added" : "updated")} for {_confirmData.EmployeeName}.");
            }

            _showConfirmModal = false;
            _showShiftEditor = false;
            _isEditMode = false; // Auto-disable Edit Mode after saving as requested

            if (_showShiftRoster && _selectedRosterEmployee != null)
            {
                await LoadRosterShiftsAsync(_selectedRosterEmployee.Username);
            }

            await LoadData();
        }
        catch (Exception ex)
        {
            await ToastService.ShowError($"Failed to process shift: {ex.Message}");
        }
        finally
        {
            _savingShift = false;
            StateHasChanged();
        }
    }

    // =========================================================================
    // PAY RATE MANAGEMENT
    // =========================================================================

    private void OpenEditRateModal(EmployeeHoursDto item)
    {
        editingItem = item;
        newRate = item.HourlyRate ?? 0;
        showRateModal = true;
    }

    private async Task SavePayRate()
    {
        if (editingItem == null) return;
        
        try
        {
            using var db = await DbFactory.CreateDbContextAsync();
            var user = await db.AppUsers.FirstOrDefaultAsync(u => u.Username == editingItem.Username);
            
            if (user != null)
            {
                user.HourlyRate = newRate;
                
                var yearly = await db.YearlyWages.FirstOrDefaultAsync(w => w.Username == user.Username && w.Year == _selectedYear);
                if (yearly != null) yearly.HourlyRate = newRate;
                else db.YearlyWages.Add(new YearlyWage { Username = user.Username, Year = _selectedYear, HourlyRate = newRate, CreatedAt = DateTime.UtcNow });

                await db.SaveChangesAsync();
                await ToastService.ShowSuccess($"Saved pay rate for {editingItem.MemberName} in {_selectedYear}");
                showRateModal = false;
                
                if (_showShiftRoster && _selectedRosterEmployee != null)
                {
                    _selectedRosterEmployee.HourlyRate = newRate;
                    await LoadRosterShiftsAsync(_selectedRosterEmployee.Username);
                }

                await LoadData();
            }
        }
        catch (Exception ex)
        {
            await ToastService.ShowError($"Error saving rate: {ex.Message}");
        }
    }

    // =========================================================================
    // PERIOD NAVIGATION & DATA FETCHING
    // =========================================================================

    private void PopulateWeekOptions()
    {
        _weekOptions.Clear();
        var year = _selectedYear;
        for (int w = 1; w <= 52; w++)
        {
            var start = FirstDateOfWeekIso8601(year, w);
            var end = start.AddDays(6);
            _weekOptions.Add((w, $"Week {w} ({start:MMM dd} - {end:MMM dd})"));
        }
    }

    private async Task SetViewMode(string mode)
    {
        _viewMode = mode;
        if (mode == "Week") _layoutMode = "Grid";
        else if (mode == "Month" || mode == "Year") _layoutMode = "List";
        
        await LoadData();
    }

    private async Task LoadData()
    {
        _loading = true;
        StateHasChanged();

        if (_viewMode == "Month")
        {
            _startDate = new DateTime(_selectedYear, _selectedMonth, 1);
            _endDate = _startDate.AddMonths(1).AddDays(-1);
        }
        else if (_viewMode == "Year")
        {
            _startDate = new DateTime(_selectedYear, 1, 1);
            _endDate = new DateTime(_selectedYear, 12, 31);
        }
        else if (_viewMode == "Week")
        {
            _startDate = FirstDateOfWeekIso8601(_selectedYear, _selectedWeek);
            _endDate = _startDate.AddDays(6);
        }

        try 
        {
            _data = await FinancialService.GetEmployeeHoursAsync(_startDate, _endDate, null, _selectedLocation);
            
            _summaryTotalHours = _data.Sum(d => d.TotalHours);
            _summaryActiveEmployees = _data.Count;
            _summaryTotalShifts = _data.Sum(d => d.EntryCount);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[EmployeeHours] Error loading data: {ex.Message}");
            _data = new List<EmployeeHoursDto>();
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private async Task PrintReport()
    {
        await JS.InvokeVoidAsync("window.print");
    }

    private static DateTime FirstDateOfWeekIso8601(int year, int weekOfYear)
    {
        DateTime jan1 = new DateTime(year, 1, 1);
        int daysOffset = DayOfWeek.Thursday - jan1.DayOfWeek;
        DateTime firstThursday = jan1.AddDays(daysOffset);
        var cal = System.Globalization.CultureInfo.CurrentCulture.Calendar;
        int firstWeek = cal.GetWeekOfYear(firstThursday, System.Globalization.CalendarWeekRule.FirstFourDayWeek, DayOfWeek.Monday);
        var weekNum = weekOfYear;
        if (firstWeek <= 1) weekNum -= 1;
        var result = firstThursday.AddDays(weekNum * 7);
        return result.AddDays(-4);
    }

