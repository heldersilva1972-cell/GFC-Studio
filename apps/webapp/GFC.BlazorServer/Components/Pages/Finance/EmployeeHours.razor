@code {
    private string GetShiftColorClass(string? type) => type switch
    {
        "Day" => "shift-badge-day",
        "Night" => "shift-badge-night",
        "Both" => "shift-badge-both",
        "Hall" => "shift-badge-hall",
        _ => "bg-light text-muted opacity-25"
    };

    private List<EmployeeHoursDto> _data = new();
    private string _searchQuery = "";
    private string _userSearchQuery = "";
    private bool _loading = true;
    private string _viewMode = "Week"; // Week, Month, Custom
    private string _layoutMode = "Grid"; // List, Grid

    // Payroll & Settings State
    private bool _showPayrollSettings = false;
    private string _activeSettingsTab = "Wages"; // Wages, Taxes
    private bool _isSavingSettings = false;
    
    // Detailed Pay Breakdown State
    private bool _showPayDetails = false;
    private EmployeeHoursDto? _selectedUserPayDetails = null;

    // Massachusetts / Global Tax Rates (%)
    private decimal _maStateTaxRate = 5.0m;
    private decimal _pfmlEmployeeRate = 0.35m;
    private decimal _pfmlEmployerRate = 0.53m;
    private decimal _ficaEmployeeRate = 7.65m;
    private decimal _ficaEmployerRate = 7.65m;
    private decimal _maUnemploymentRate = 2.42m; // Typical MA UI
    
    private decimal TotalEmployeeDeductionRate => (_maStateTaxRate + _pfmlEmployeeRate + _ficaEmployeeRate) / 100m;
    private decimal TotalEmployerSurchargeRate => (_pfmlEmployerRate + _ficaEmployerRate + _maUnemploymentRate) / 100m;

    // Real-time Total Tax Liabilities
    private decimal TotalStateTax => _data.Sum(d => d.TotalPay * (_maStateTaxRate / 100m));
    private decimal TotalPfml => _data.Sum(d => d.TotalPay * ((_pfmlEmployeeRate + _pfmlEmployerRate) / 100m));
    private decimal TotalFica => _data.Sum(d => d.TotalPay * ((_ficaEmployeeRate + _ficaEmployerRate) / 100m));
    private decimal TotalUi => _data.Sum(d => d.TotalPay * (_maUnemploymentRate / 100m));
    private decimal TotalTaxLiability => TotalStateTax + TotalPfml + TotalFica + TotalUi;

    private int _selectedMonth = DateTime.Now.Month;
    private int _selectedYear = DateTime.Now.Year;
    private int _selectedWeek = System.Globalization.ISOWeek.GetWeekOfYear(DateTime.Now);
    private DateTime _startDate = DateTime.Now.AddDays(-30);
    private DateTime _endDate = DateTime.Now;

    private List<int> _availableYears = new();
    private List<(int Value, string Text)> _weekOptions = new();

    private decimal _summaryTotalHours = 0;
    private int _summaryActiveEmployees = 0;
    private int _summaryTotalShifts = 0;
    
    // Rate Editing
    private bool showRateModal = false;
    private List<AppUser> allSystemUsers = new();
    private List<Member> allMembers = new();
    private EmployeeHoursDto? editingItem;
    private decimal newRate;

    private IEnumerable<EmployeeHoursDto> FilteredData => _data
        .Where(d => string.IsNullOrEmpty(_searchQuery) || 
                   (d.MemberName?.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase) ?? false) ||
                   d.Username.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        _loading = true;
        
        using var db = await DbFactory.CreateDbContextAsync();
        var sys = await db.SystemSettings.FirstOrDefaultAsync() ?? new SystemSettings();
        _maStateTaxRate = sys.MaStateTaxRate;
        _pfmlEmployeeRate = sys.PfmlEmployeeRate;
        _pfmlEmployerRate = sys.PfmlEmployerRate;
        _ficaEmployeeRate = sys.FicaEmployeeRate;
        _ficaEmployerRate = sys.FicaEmployerRate;
        _maUnemploymentRate = sys.MaUnemploymentRate;
        
        _availableYears = await FinancialService.GetAvailableYearsAsync();
        if (!_availableYears.Contains(DateTime.Now.Year)) _availableYears.Insert(0, DateTime.Now.Year);
        
        PopulateWeekOptions();
        await LoadData();
        await LoadAllUsers();
    }

    private IEnumerable<DateTime> GetWeekDays()
    {
        for (var d = _startDate.Date; d <= _endDate.Date; d = d.AddDays(1)) yield return d;
    }

    private string GetUserName(AppUser user)
    {
        if (user.MemberId != null)
        {
            var member = allMembers.FirstOrDefault(m => m.MemberID == user.MemberId);
            if (member != null)
            {
                return $"{member.FirstName} {member.LastName}{(string.IsNullOrEmpty(member.Suffix) ? "" : " " + member.Suffix)}";
            }
        }
        return user.Username;
    }

    private async Task LoadAllUsers()
    {
        try
        {
            using var db = await DbFactory.CreateDbContextAsync();
            allSystemUsers = await db.AppUsers.AsNoTracking()
                .OrderBy(u => u.Username)
                .ToListAsync();

            allMembers = await db.Members.AsNoTracking().ToListAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading users: {ex.Message}");
        }
    }

    private async Task SavePayrollSettings()
    {
        _isSavingSettings = true;
        try
        {
            using var db = await DbFactory.CreateDbContextAsync();
            
            // Save employee wage updates
            foreach (var user in allSystemUsers)
            {
                var dbUser = await db.AppUsers.FindAsync(user.UserId);
                if (dbUser != null) dbUser.HourlyRate = user.HourlyRate;
            }
            
            // Save global tax updates
            var sys = await db.SystemSettings.FirstOrDefaultAsync();
            if (sys != null)
            {
                sys.MaStateTaxRate = _maStateTaxRate;
                sys.PfmlEmployeeRate = _pfmlEmployeeRate;
                sys.PfmlEmployerRate = _pfmlEmployerRate;
                sys.FicaEmployeeRate = _ficaEmployeeRate;
                sys.FicaEmployerRate = _ficaEmployerRate;
                sys.MaUnemploymentRate = _maUnemploymentRate;
            }
            
            await db.SaveChangesAsync();
            await ToastService.ShowSuccess("Payroll and tax settings updated and persistent.");
            _showPayrollSettings = false;
            await LoadData();
        }
        catch (Exception ex) { await ToastService.ShowError(ex.Message); }
        finally { _isSavingSettings = false; }
    }

    private void OpenPayDetails(EmployeeHoursDto item)
    {
        _selectedUserPayDetails = item;
        _showPayDetails = true;
    }

    private void OpenEditRateModal(EmployeeHoursDto item)
    {
        editingItem = item;
        newRate = item.HourlyRate ?? 0;
        showRateModal = true;
    }

    private async Task SavePayRate()
    {
        if (editingItem == null) return;
        
        try
        {
            using var db = await DbFactory.CreateDbContextAsync();
            var user = await db.AppUsers.FirstOrDefaultAsync(u => u.Username == editingItem.Username);
            
            if (user != null)
            {
                user.HourlyRate = newRate;
                await db.SaveChangesAsync();
                await ToastService.ShowSuccess($"Saved pay rate for {editingItem.MemberName}");
                showRateModal = false;
                await LoadData();
            }
        }
        catch (Exception ex)
        {
            await ToastService.ShowError($"Error saving rate: {ex.Message}");
        }
    }

    private void PopulateWeekOptions()
    {
        _weekOptions.Clear();
        var year = _selectedYear;
        for (int w = 1; w <= 52; w++)
        {
            var start = FirstDateOfWeekIso8601(year, w);
            var end = start.AddDays(6);
            _weekOptions.Add((w, $"Week {w} ({start:MMM dd} - {end:MMM dd})"));
        }
    }

    private async Task SetViewMode(string mode)
    {
        _viewMode = mode;
        // Default to grid for weekly, list for monthly/yearly
        if (mode == "Week") _layoutMode = "Grid";
        else if (mode == "Month" || mode == "Year") _layoutMode = "List";
        
        await LoadData();
    }

    private async Task LoadData()
    {
        _loading = true;
        StateHasChanged();

        if (_viewMode == "Month")
        {
            _startDate = new DateTime(_selectedYear, _selectedMonth, 1);
            _endDate = _startDate.AddMonths(1).AddDays(-1);
        }
        else if (_viewMode == "Year")
        {
            _startDate = new DateTime(_selectedYear, 1, 1);
            _endDate = new DateTime(_selectedYear, 12, 31);
        }
        else if (_viewMode == "Week")
        {
            _startDate = FirstDateOfWeekIso8601(_selectedYear, _selectedWeek);
            _endDate = _startDate.AddDays(6);
        }
        else
        {
            // Custom mode
        }

        _data = await FinancialService.GetEmployeeHoursAsync(_startDate, _endDate, null, "Main");
        
        foreach (var d in _data)
        {
            d.EmployeeDeductionRate = TotalEmployeeDeductionRate;
            d.EmployerSurchargeRate = TotalEmployerSurchargeRate;
        }

        _summaryTotalHours = _data.Sum(d => d.TotalHours);
        _summaryActiveEmployees = _data.Count;
        _summaryTotalShifts = _data.Sum(d => d.EntryCount);

        _loading = false;
        StateHasChanged();
    }

    private async Task PrintReport()
    {
        await JS.InvokeVoidAsync("window.print");
    }

    private static DateTime FirstDateOfWeekIso8601(int year, int weekOfYear)
    {
        DateTime jan1 = new DateTime(year, 1, 1);
        int daysOffset = DayOfWeek.Thursday - jan1.DayOfWeek;
        DateTime firstThursday = jan1.AddDays(daysOffset);
        var cal = System.Globalization.CultureInfo.CurrentCulture.Calendar;
        int firstWeek = cal.GetWeekOfYear(firstThursday, System.Globalization.CalendarWeekRule.FirstFourDayWeek, DayOfWeek.Monday);
        var weekNum = weekOfYear;
        if (firstWeek <= 1) weekNum -= 1;
        var result = firstThursday.AddDays(weekNum * 7);
        return result.AddDays(-3);
    }
