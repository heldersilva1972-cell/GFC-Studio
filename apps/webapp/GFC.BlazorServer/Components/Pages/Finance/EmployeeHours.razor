@page "/finance/employee-hours"
@using Microsoft.AspNetCore.Authorization
@using GFC.BlazorServer.Services
@using GFC.Core.Models
@using GFC.Core.DTOs
@using Microsoft.AspNetCore.Components.Authorization
@inject IFinancialAnalyticsService FinancialService
@inject IJSRuntime JS
@inject Microsoft.EntityFrameworkCore.IDbContextFactory<GFC.BlazorServer.Data.GfcDbContext> DbFactory
@inject IConfiguration AppConfig
@inject IToastService ToastService
@inject AuthenticationStateProvider AuthStateProvider
@attribute [Authorize]
@using Microsoft.EntityFrameworkCore

<PageTitle>Employee Hours | GFC Finance</PageTitle>

<style>
    .hours-page {
        height: calc(100vh - 56px); /* Account for navbar */
        display: flex;
        flex-direction: column;
        background: radial-gradient(circle at top right, #f8fafc, #eff6ff);
        padding: 1rem;
        overflow: hidden;
        position: relative;
    }

    .glass-card {
        background: rgba(255, 255, 255, 0.9);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.2);
        border-radius: 24px;
        box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.05);
        padding: 1.5rem;
        display: flex;
        flex-direction: column;
        flex: 1;
        min-height: 0;
    }

    .stat-card {
        background: white;
        border-radius: 20px;
        padding: 1.25rem;
        border: 1px solid #f1f5f9;
        transition: all 0.3s ease;
    }

    .stat-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 15px 30px -5px rgba(59, 130, 246, 0.1);
        border-color: #3b82f644;
    }

    .stat-icon {
        width: 48px;
        height: 48px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 1rem;
        font-size: 1.5rem;
    }

    .icon-blue { background: #eff6ff; color: #3b82f6; }
    .icon-green { background: #ecfdf5; color: #10b981; }
    .icon-purple { background: #f5f3ff; color: #8b5cf6; }
    .icon-orange { background: #fff7ed; color: #f59e0b; }

    .period-selector {
        background: #f1f5f9;
        padding: 0.35rem;
        border-radius: 14px;
        display: inline-flex;
        gap: 0.25rem;
    }

    .period-btn {
        border: none;
        background: transparent;
        padding: 0.5rem 1.25rem;
        border-radius: 10px;
        font-size: 0.85rem;
        font-weight: 700;
        color: #64748b;
        transition: all 0.2s;
    }

    .period-btn.active {
        background: white;
        color: #3b82f6;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
    }

    .hours-table th {
        background: #f8fafc;
        color: #64748b;
        font-weight: 700;
        text-transform: uppercase;
        font-size: 0.7rem;
        letter-spacing: 0.05em;
        border-top: none;
        padding: 0.25rem 0.5rem;
    }

    .hours-table td {
        padding: 0.25rem 0.5rem;
        vertical-align: middle;
        height: 30px;
        border-bottom: 1px solid #f1f5f9;
    }

    .user-avatar {
        width: 36px;
        height: 36px;
        background: #3b82f6;
        color: white;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 0.9rem;
    }

    .hours-badge {
        font-size: 0.9rem;
        font-weight: 700;
        padding: 0.4rem 0.8rem;
        border-radius: 10px;
    }

    .badge-primary { background: #eff6ff; color: #3b82f6; }

    .search-input {
        border: 2px solid #f1f5f9;
        border-radius: 14px;
        padding: 0.6rem 1rem;
        font-size: 0.9rem;
        transition: all 0.2s;
        background: #f8fafc;
    }

    .search-input:focus {
        border-color: #3b82f6;
        background: white;
        box-shadow: 0 0 0 4px rgba(59, 130, 246, 0.1);
        outline: none;
    }

    .empty-state {
        padding: 4rem 2rem;
        text-align: center;
    }

    .empty-icon {
        font-size: 4rem;
        color: #e2e8f0;
        margin-bottom: 1.5rem;
    }

    .table-scroll-container {
        max-height: calc(100vh - 440px);
        overflow-y: auto;
        scrollbar-width: thin;
        scrollbar-color: #e0e0e0 transparent;
    }

    .table-scroll-container::-webkit-scrollbar {
        width: 6px;
    }
    
    .table-scroll-container::-webkit-scrollbar-track {
        background: transparent;
    }
    
    .table-scroll-container::-webkit-scrollbar-thumb {
        background-color: #e0e0e0;
        border-radius: 10px;
    }

    .table thead th {
        position: sticky;
        top: 0;
        z-index: 100;
        background-color: #f8f9fa !important;
        border-bottom: 2px solid #dee2e6 !important;
    }

    .table tfoot td {
        position: sticky;
        bottom: 0;
        z-index: 90;
        background-color: #f8f9fa !important;
        border-top: 2px solid #dee2e6 !important;
    }

    /* Sticky First Column for Breakdown View */
    .hours-table th:first-child,
    .hours-table td:first-child {
        position: sticky;
        left: 0;
        background-color: white !important;
        z-index: 10;
        border-right: 1px solid #dee2e6 !important;
        box-shadow: 2px 0 5px rgba(0,0,0,0.05);
    }

    .hours-table thead th:first-child {
        z-index: 110 !important; /* Higher than sticky headers */
        background-color: #f8f9fa !important;
    }

    .hours-table tfoot td:first-child {
        z-index: 105 !important;
        background-color: #f8f9fa !important;
    }

    /* Sticky Last 3 Columns for Breakdown View */
    .sticky-right-audit-1 { 
        position: sticky; right: 0; background: white !important; z-index: 20; 
        border-left: 1px solid #dee2e6 !important; box-shadow: -2px 0 5px rgba(0,0,0,0.05);
        min-width: 100px !important;
    }
    .sticky-right-audit-2 { 
        position: sticky; right: 100px; background: white !important; z-index: 20; 
        border-left: 1px solid #dee2e6 !important;
        min-width: 100px !important;
    }
    .sticky-right-audit-3 { 
        position: sticky; right: 200px; background: white !important; z-index: 20; 
        border-left: 1px solid #dee2e6 !important;
        min-width: 80px !important;
    }

    .hours-table thead th.sticky-right-audit-1,
    .hours-table thead th.sticky-right-audit-2,
    .hours-table thead th.sticky-right-audit-3 {
        z-index: 110 !important;
        background-color: #f8f9fa !important;
    }

    .hours-table tfoot td.sticky-right-audit-1,
    .hours-table tfoot td.sticky-right-audit-2,
    .hours-table tfoot td.sticky-right-audit-3 {
        z-index: 105 !important;
        background-color: #f8f9fa !important;
    }

    @@media print {
        @@page { size: portrait; margin: 1cm; overflow: visible; }
        
        /* Hide ALL framework shell elements */
        .app-topbar, .app-sidebar, .sidebar-overlay, .menu-toggle-btn, .theme-toggle, .desktop-actions, .app-badge, .badge, .btn-primary, .btn-light, .btn-white {
            display: none !important;
        }

        /* Reset all layout containers to be plain blocks */
        .app-shell, .app-main, .app-content, .content, .container-fluid, .hours-page, .glass-card {
            display: block !important;
            margin: 0 !important;
            padding: 0 !important;
            border: none !important;
            box-shadow: none !important;
            background: white !important;
            width: 100% !important;
            max-width: none !important;
            min-height: auto !important;
            overflow: visible !important;
            float: none !important;
        }

        /* Hide interactive controls and placeholders */
        .no-print, nav, .sidebar, .period-selector, .search-box, .btn, .breadcrumb, .stat-card, footer, .main-header, .search-input, .settings-btn, .table-content-area, .spinner-border { 
            display: none !important; 
        }
        
        #blazor-error-ui { display: none !important; }
        
        /* Force display of the detailed report only */
        .print-only-report { 
            display: block !important; 
            width: 100% !important;
            margin: 0 !important;
            padding: 0 !important;
            visibility: visible !important;
        }
    }

    .print-only-report { display: none; }

    /* Shift Badge Styling - Ultra Readable & Distinct */
    .shift-badge-day { 
        background-color: rgba(13, 110, 253, 0.25) !important; 
        color: #0d47a1 !important; 
        border: 1px solid rgba(13, 110, 253, 0.4) !important;
        font-weight: 800 !important;
    }
    .shift-badge-night { 
        background-color: rgba(225, 29, 72, 0.2) !important; 
        color: #be123c !important; 
        border: 1px solid rgba(225, 29, 72, 0.4) !important;
        font-weight: 800 !important;
    }
    .shift-badge-both { 
        background-color: rgba(25, 135, 84, 0.2) !important; 
        color: #065f46 !important; 
        border: 1px solid rgba(25, 135, 84, 0.4) !important;
        font-weight: 800 !important;
    }
    .shift-badge-hall { 
        background-color: rgba(251, 191, 36, 0.25) !important; 
        color: #b45309 !important; 
        border: 1px solid rgba(251, 191, 36, 0.4) !important;
        font-weight: 800 !important;
    }
    .shift-badge-janitor { 
        background-color: rgba(167, 139, 250, 0.2) !important; 
        color: #7c3aed !important; 
        border: 1px solid rgba(167, 139, 250, 0.4) !important;
        font-weight: 800 !important;
    }

    /* Interactive cell styles */
    .shift-badge-interactive {
        transition: transform 0.15s ease, box-shadow 0.15s ease;
        cursor: pointer;
    }
    .shift-badge-interactive:hover {
        transform: scale(1.08);
        box-shadow: 0 4px 8px rgba(0,0,0,0.15) !important;
    }

    .empty-shift-cell {
        border-radius: 6px;
        transition: background-color 0.15s ease, color 0.15s ease;
        min-height: 22px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
    }
    .empty-shift-cell:hover {
        background-color: rgba(59, 130, 246, 0.12);
        color: #3b82f6 !important;
    }
    .empty-shift-cell:hover .empty-dash {
        display: none;
    }
    .empty-shift-cell .empty-add-icon {
        display: none;
    }
    .empty-shift-cell:hover .empty-add-icon {
        display: inline-block;
        font-size: 0.85rem;
    }

    /* Hide Number Input Spinners (Arrows) */
    input::-webkit-outer-spin-button,
    input::-webkit-inner-spin-button {
      -webkit-appearance: none;
      margin: 0;
    }
    input[type=number] {
      -moz-appearance: textfield;
    }

    .sticky-col {
        position: sticky;
        left: 0;
        background: white;
        z-index: 5;
    }
    thead th.sticky-col { z-index: 10; background: #f8f9fa; }
</style>

<div class="hours-page">
    <div class="container-fluid max-width-1400 flex-grow-1 d-flex flex-column overflow-hidden">
        
        <!-- Header Section -->
        <div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4 no-print">
            <div>
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-1">
                        <li class="breadcrumb-item text-muted small">Finance</li>
                        <li class="breadcrumb-item active small" aria-current="page">Employee Hours</li>
                    </ol>
                </nav>
                <h1 class="h3 fw-bold mb-0 text-dark">Employee Hours</h1>
                <p class="text-muted small mb-0">
                    <span class="fw-black text-primary text-uppercase me-2">
                        @(_selectedLocation == "All" ? "Complete Facility" : (_selectedLocation == "Main" ? "Downstairs Bar" : "Upstairs Bar"))
                    </span>
                    • Tracking active shifts for 
                    <span class="fw-bold">@(_viewMode == "Month" ? $"{System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(_selectedMonth)} {_selectedYear}" : (_viewMode == "Year" ? _selectedYear.ToString() : $"{_startDate:MMM dd} - {_endDate:MMM dd, yyyy}"))</span>
                </p>
            </div>

            <div class="d-flex gap-3 align-items-center flex-wrap">
                <div class="period-selector">
                    <button class="period-btn @(_viewMode == "Week" ? "active" : "")" @onclick='() => SetViewMode("Week")'>WEEKLY</button>
                    <button class="period-btn @(_viewMode == "Month" ? "active" : "")" @onclick='() => SetViewMode("Month")'>MONTHLY</button>
                    <button class="period-btn @(_viewMode == "Year" ? "active" : "")" @onclick='() => SetViewMode("Year")'>YEARLY</button>
                </div>

                <div class="d-flex gap-2">
                    @if (_viewMode == "Month" || _viewMode == "Year")
                    {
                        @if (_viewMode == "Month")
                        {
                            <select class="form-select border-0 shadow-sm rounded-3 me-2" @bind="_selectedMonth" @bind:after="LoadData">
                                @foreach (var m in Enumerable.Range(1, 12))
                                {
                                    <option value="@m">@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(m)</option>
                                }
                            </select>
                        }
                        <select class="form-select border-0 shadow-sm rounded-3" @bind="_selectedYear" @bind:after="LoadData">
                            @foreach (var year in _availableYears)
                            {
                                <option value="@year">@year</option>
                            }
                        </select>
                    }
                    else if (_viewMode == "Week")
                    {
                        <select class="form-select border-0 shadow-sm rounded-3" @bind="_selectedWeek" @bind:after="LoadData">
                            @foreach (var week in _weekOptions)
                            {
                                <option value="@week.Value">@week.Text</option>
                            }
                        </select>
                    }
                </div>

                <div class="d-flex gap-2">
                    <select class="form-select border-0 shadow-sm rounded-3 fw-bold text-primary" style="min-width: 150px;" @bind="_selectedLocation" @bind:after="LoadData">
                        <option value="All">All Locations</option>
                        <option value="Main">Downstairs Bar</option>
                        <option value="Hall">Upstairs Bar</option>
                    </select>
                </div>

                @if (!_isEditMode)
                {
                    <button class="btn btn-outline-primary shadow-sm rounded-3 fw-bold px-3 d-flex align-items-center gap-2" @onclick="ToggleEditMode">
                        <i class="bi bi-pencil-square"></i> <span>Edit Hours</span>
                    </button>
                }
                else
                {
                    <button class="btn btn-warning text-dark shadow-sm rounded-3 fw-bold px-3 d-flex align-items-center gap-2 border border-warning" @onclick="ToggleEditMode">
                        <i class="bi bi-lock-fill"></i> <span>Exit Edit Mode</span>
                    </button>
                }

                <button class="btn btn-white shadow-sm rounded-3 btn-print border" @onclick="PrintReport">
                    <i class="bi bi-printer me-2"></i> Print
                </button>
            </div>
        </div>

        <!-- COMPRESSED SUMMARY STATS -->
        <div class="row g-2 mb-3 no-print">
            <!-- TILE 1: LABOR ACTIVITY -->
            <div class="col-md-6">
                <div class="stat-card p-2 px-3 h-100 shadow-sm border-0 bg-white">
                    <div class="d-flex align-items-center gap-3">
                        <div class="stat-icon icon-blue mb-0" style="width: 32px; height: 32px; font-size: 1rem; flex-shrink: 0;">
                            <i class="bi bi-clock-history"></i>
                        </div>
                        <div class="row g-0 flex-grow-1">
                            <div class="col-6 border-end pe-2 text-center">
                                <div class="text-muted x-small fw-black text-uppercase opacity-75">Work Hours</div>
                                <div class="h4 fw-black text-dark mb-0">@_summaryTotalHours.ToString("N1")</div>
                            </div>
                            <div class="col-6 ps-2 text-center">
                                <div class="text-muted x-small fw-black text-uppercase opacity-75">Total Shifts</div>
                                <div class="h4 fw-black text-dark mb-0">@_summaryTotalShifts</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- TILE 2: GROSS PAYROLL -->
            <div class="col-md-6">
                <div class="stat-card p-2 px-3 h-100 shadow-sm border-0 bg-white">
                    <div class="d-flex align-items-center gap-3">
                        <div class="stat-icon icon-orange mb-0" style="width: 32px; height: 32px; font-size: 1rem; flex-shrink: 0;">
                            <i class="bi bi-cash-stack"></i>
                        </div>
                        <div class="row g-0 flex-grow-1">
                            <div class="col-12 text-center">
                                <div class="text-muted x-small fw-black text-uppercase opacity-75">Est. Gross Payroll</div>
                                <div class="h4 fw-black text-dark mb-0">@FilteredData.Sum(d => d.TotalPay).ToString("C")</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Main Content Card -->
        <div class="glass-card flex-grow-1 overflow-hidden" style="min-height: 0;">
            <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 no-print">
                <div class="d-flex align-items-center gap-3">
                    <div class="btn-group p-1 bg-light rounded-pill shadow-sm">
                        <button class="btn btn-sm rounded-pill px-3 fw-black @(_layoutMode == "List" ? "btn-dark shadow-sm" : "btn-light text-muted")" 
                                @onclick='() => _layoutMode = "List"'>
                            <i class="bi bi-list-ul me-1"></i> SUMMARY
                        </button>
                        <button class="btn btn-sm rounded-pill px-3 fw-black @(_layoutMode == "Grid" ? "btn-dark shadow-sm" : "btn-light text-muted")" 
                                @onclick='() => _layoutMode = "Grid"'>
                            <i class="bi bi-grid-3x3-gap-fill me-1"></i> BREAKDOWN
                        </button>
                    </div>
                </div>
                <div class="search-box position-relative no-print" style="min-width: 300px;">
                    <i class="bi bi-search position-absolute text-muted" style="left: 1rem; top: 50%; transform: translateY(-50%);"></i>
                    <input type="text" class="search-input w-100 ps-5" placeholder="Search by name or username..." @bind="_searchQuery" @bind:event="oninput" />
                </div>
            </div>

            <!-- PRINT ONLY REPORT HEADER -->
            <div class="print-only-report">
                <div class="d-flex justify-content-between align-items-center border-bottom pb-4 mb-4">
                    <div>
                        <h1 class="h2 fw-black mb-1">PAYROLL SUMMARY</h1>
                        <div class="text-primary fw-bold fs-5">@(_selectedLocation == "All" ? "Complete Facility" : (_selectedLocation == "Main" ? "Downstairs Bar" : "Upstairs Bar")) Report</div>
                        <div class="text-muted fw-bold mt-2">
                            <i class="bi bi-calendar3 me-2"></i>
                            @(_viewMode == "Month" ? $"{System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(_selectedMonth)} {_selectedYear}" : $"{_startDate:MMM dd, yyyy} - {_endDate:MMM dd, yyyy}")
                        </div>
                    </div>
                    <div class="text-end">
                        <div class="small fw-black text-muted uppercase">GENERATED ON</div>
                        <div class="fw-bold">@DateTime.Now.ToString("G")</div>
                    </div>
                </div>

                <div class="row g-0 border rounded-4 overflow-hidden mb-4 bg-light">
                    <div class="col-6 p-4 border-end text-center">
                        <div class="x-small fw-black text-muted mb-1 text-uppercase">TOTAL HOURS</div>
                        <div class="h3 fw-black mb-0">@FilteredData.Sum(d => d.TotalHours).ToString("N1")</div>
                        <div class="x-small text-muted opacity-75">Confirmed Labor</div>
                    </div>
                    <div class="col-6 p-4 bg-primary text-white text-center">
                        <div class="x-small fw-black mb-1 text-uppercase opacity-75">GROSS PAYROLL</div>
                        <div class="h2 fw-black mb-0">@FilteredData.Sum(d => d.TotalPay).ToString("C")</div>
                        <div class="x-small text-muted opacity-75">Pre-Tax Estimated Total</div>
                    </div>
                </div>

                <h6 class="fw-black text-uppercase border-bottom pb-2 mb-3" style="letter-spacing: 0.1rem;">EMPLOYEE LABOR BREAKDOWN</h6>
                <table class="table table-bordered align-middle">
                    <thead class="bg-light">
                        <tr class="x-small fw-black text-uppercase">
                            <th class="ps-3">Employee</th>
                            <th class="text-center">Shifts</th>
                            <th class="text-center">Hours</th>
                            <th class="text-end pe-3">Gross Pay</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in FilteredData)
                        {
                            <tr>
                                <td class="ps-3 py-1">
                                    <div class="fw-bold text-dark small">@item.MemberName</div>
                                </td>
                                <td class="text-center py-1">
                                    <span class="badge bg-light text-dark border small fw-bold">
                                        @item.EntryCount @(item.EntryCount == 1 ? "SHIFT" : "SHIFTS")
                                    </span>
                                </td>
                                <td class="text-center py-1 fw-bold">@item.TotalHours.ToString("N1")</td>
                                <td class="text-end pe-3 py-1 fw-black">@item.TotalPay.ToString("C")</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="bg-light fw-black">
                        <tr>
                            <td class="ps-3 py-1">TOTALS</td>
                            <td class="text-center">-</td>
                            <td class="text-center">@FilteredData.Sum(d => d.TotalHours).ToString("N1")</td>
                            <td class="text-end pe-3">@FilteredData.Sum(d => d.TotalPay).ToString("C")</td>
                        </tr>
                    </tfoot>
                </table>

                <div class="text-center mt-5 pt-5 x-small text-muted opacity-50 border-top">
                    This report represents estimated labor costs based on recorded shifts and current hourly rates.<br/>
                    End of Report - GFC Management System
                </div>
            </div>

            <!-- EDIT MODE ACTIVE BANNER -->
            @if (_isEditMode)
            {
                <div class="alert alert-warning border-warning shadow-sm py-2 px-3 mb-3 rounded-4 d-flex justify-content-between align-items-center no-print">
                    <div class="d-flex align-items-center gap-2 small fw-bold text-dark">
                        <i class="bi bi-pencil-fill text-warning fs-5"></i>
                        <span><strong>Edit Mode Active:</strong> Click any shift badge or empty cell to add/edit hours. Edit mode will automatically lock once changes are saved.</span>
                    </div>
                    <button class="btn btn-sm btn-dark rounded-pill px-3 fw-bold shadow-sm" @onclick="() => _isEditMode = false">
                        <i class="bi bi-lock me-1"></i> Lock Editing
                    </button>
                </div>
            }

            <div class="table-content-area flex-grow-1 d-flex flex-column overflow-hidden" style="min-height: 0;">
                @if (_loading)
                {
                    <div class="text-center py-5 shadow-sm rounded-4 bg-white border">
                        <div class="spinner-border text-primary" role="status"></div>
                        <p class="mt-3 text-muted fw-bold">Gathering shift records...</p>
                    </div>
                }
                else if (!FilteredData.Any())
                {
                    <div class="empty-state text-center py-5 bg-white rounded-4 border shadow-sm flex-grow-1 d-flex flex-column justify-content-center align-items-center">
                        <i class="bi bi-calendar-x display-4 text-muted opacity-25"></i>
                        <h3 class="h5 fw-bold text-dark mt-3">No records found</h3>
                        <p class="text-muted mb-3">There are no hours reported for the selected period.</p>
                        @if (_isEditMode)
                        {
                            <button class="btn btn-outline-primary rounded-pill px-4 fw-bold" @onclick="OpenAddHoursModal">
                                <i class="bi bi-plus-circle me-1"></i> Log Hours Now
                            </button>
                        }
                        else
                        {
                            <button class="btn btn-outline-primary rounded-pill px-4 fw-bold" @onclick="ToggleEditMode">
                                <i class="bi bi-pencil-square me-1"></i> Enable Edit Mode to Add Hours
                            </button>
                        }
                    </div>
                }
                else
                {
                    @if (_layoutMode == "Grid")
                    {
                        <div class="d-flex align-items-center justify-content-between mb-3 px-4 border shadow-sm py-2 rounded-4 bg-light bg-opacity-50 no-print flex-wrap gap-2">
                            <div class="small fw-black text-muted text-uppercase tracking-wider">Shift Legend:</div>
                            <div class="d-flex gap-3 align-items-center flex-wrap">
                                <div class="d-flex align-items-center gap-1">
                                    <div class="rounded-1" style="width: 12px; height: 12px; background: rgba(13, 110, 253, 0.25); border: 1px solid rgba(13, 110, 253, 0.4);"></div>
                                    <span class="x-small fw-bold text-dark opacity-75">DAY</span>
                                </div>
                                <div class="d-flex align-items-center gap-1">
                                    <div class="rounded-1" style="width: 12px; height: 12px; background: rgba(225, 29, 72, 0.25); border: 1px solid rgba(225, 29, 72, 0.4);"></div>
                                    <span class="x-small fw-bold text-dark opacity-75">NIGHT</span>
                                </div>
                                <div class="d-flex align-items-center gap-1">
                                    <div class="rounded-1" style="width: 12px; height: 12px; background: rgba(25, 135, 84, 0.25); border: 1px solid rgba(25, 135, 84, 0.4);"></div>
                                    <span class="x-small fw-bold text-dark opacity-75">DOUBLE</span>
                                </div>
                                <div class="d-flex align-items-center gap-1">
                                    <div class="rounded-1" style="width: 12px; height: 12px; background: rgba(251, 191, 36, 0.25); border: 1px solid rgba(251, 191, 36, 0.4);"></div>
                                    <span class="x-small fw-bold text-dark opacity-75">HALL</span>
                                </div>
                                <div class="d-flex align-items-center gap-1">
                                    <div class="rounded-1" style="width: 12px; height: 12px; background: rgba(167, 139, 250, 0.25); border: 1px solid rgba(167, 139, 250, 0.4);"></div>
                                    <span class="x-small fw-bold text-dark opacity-75">JANITOR</span>
                                </div>
                                @if (_isEditMode)
                                {
                                    <span class="badge bg-warning text-dark border ms-2 x-small fw-bold">
                                        <i class="bi bi-pencil-fill me-1"></i> Edit Mode Active: Click cells to edit/add
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-white text-muted border ms-2 x-small">
                                        <i class="bi bi-lock-fill me-1"></i> View Mode
                                    </span>
                                }
                            </div>
                        </div>
                    }

                    <div class="table-scroll-container bg-white rounded-4 shadow-sm border flex-grow-1 overflow-hidden d-flex flex-column" style="min-height: 0;">
                        <div class="overflow-auto flex-grow-1" style="min-height: 0;">
                            @if (_layoutMode == "List")
                            {
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="bg-light sticky-top">
                                        <tr class="x-small fw-black text-muted text-uppercase tracking-wider">
                                            <th class="ps-4 py-2 border-0">EMPLOYEE</th>
                                            <th class="py-2 text-center border-0">SHIFTS</th>
                                            <th class="py-2 text-center border-0">HOURS</th>
                                            <th class="py-2 text-end border-0">GROSS PAY</th>
                                            <th class="pe-4 py-2 text-center border-0" style="width: 140px;">ACTIONS</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in FilteredData)
                                        {
                                            <tr>
                                                <td class="ps-4 py-1">
                                                    <div class="d-flex align-items-center gap-2">
                                                        <div class="avatar-xs bg-primary bg-opacity-10 text-primary rounded-circle d-flex align-items-center justify-content-center fw-black" style="width: 28px; height: 28px; font-size: 0.65rem;">
                                                            @item.MemberName?.Substring(0,1).ToUpper()
                                                        </div>
                                                        <div>
                                                            <div class="fw-bold text-dark small">@item.MemberName</div>
                                                            <div class="text-muted x-small">@@@item.Username</div>
                                                        </div>
                                                    </div>
                                                </td>
                                                <td class="text-center py-1">
                                                    <span class="badge bg-indigo bg-opacity-10 text-indigo-emphasis border border-indigo-subtle shadow-sm" 
                                                          style="font-size: 0.65rem; color: #4338ca !important; padding: 0.2rem 0.4rem;">
                                                        @item.EntryCount @(item.EntryCount == 1 ? "SHIFT" : "SHIFTS")
                                                    </span>
                                                </td>
                                                <td class="text-center">
                                                    <span class="badge bg-primary bg-opacity-10 text-primary px-3 py-1 rounded-pill fw-bold" style="font-size: 0.75rem;">
                                                        @item.TotalHours.ToString("N1") <small class="fw-normal opacity-75">hrs</small>
                                                    </span>
                                                </td>
                                                <td class="text-end fw-black text-dark">@item.TotalPay.ToString("C")</td>
                                                <td class="pe-4 text-center">
                                                    @if (_isEditMode)
                                                    {
                                                        <button class="btn btn-outline-secondary btn-sm rounded-pill px-3 fw-bold" 
                                                                @onclick="() => OpenEditRateModal(item)" 
                                                                title="Edit Pay Rate">
                                                            <i class="bi bi-currency-dollar me-1"></i> Edit Rate
                                                        </button>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted x-small">-</span>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                    <tfoot class="sticky-bottom bg-light border-top-2">
                                        <tr class="fw-black text-dark">
                                            <td colspan="2" class="ps-4">TOTALS</td>
                                            <td class="text-center">@FilteredData.Sum(d => d.TotalHours).ToString("N1")</td>
                                            <td class="text-end">@FilteredData.Sum(d => d.TotalPay).ToString("C")</td>
                                            <td></td>
                                        </tr>
                                    </tfoot>
                                </table>
                            }
                            else if (_layoutMode == "Grid")
                            {
                                <table class="table table-hover align-middle mb-0 hours-table">
                                    <thead class="bg-light sticky-top">
                                        <tr style="height: 25px;">
                                            <th class="ps-3 sticky-col border-end text-uppercase x-small py-1">Employee</th>
                                            @foreach (var day in GetWeekDays())
                                            {
                                                <th class="text-center">
                                                    <div class="small fw-bold">@day.ToString("ddd")</div>
                                                    <div class="x-small text-muted" style="font-size: 0.65rem;">@day.ToString("MM/dd")</div>
                                                </th>
                                            }
                                            <th class="text-center border-start sticky-right-audit-2">TOTAL HRS</th>
                                            <th class="text-end pe-4 sticky-right-audit-1">GROSS PAY</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in FilteredData)
                                        {
                                            <tr>
                                                <td class="ps-3 py-1 sticky-col border-end p-0" style="height: 30px;">
                                                    <div class="d-flex align-items-center gap-2">
                                                        <div class="avatar-xxs bg-light text-muted border rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 18px; height: 18px; font-size: 0.55rem;">
                                                            @item.MemberName?.Substring(0,1).ToUpper()
                                                        </div>
                                                        <div class="fw-bold text-dark x-small" style="white-space: nowrap;">@item.MemberName</div>
                                                    </div>
                                                </td>
                                                @foreach (var day in GetWeekDays())
                                                {
                                                    <td class="text-center p-1">
                                                        @if (item.DailyHours.ContainsKey(day.Date))
                                                        {
                                                            var shiftType = item.DailyShiftTypes.ContainsKey(day.Date) ? item.DailyShiftTypes[day.Date] : "Day";
                                                            if (shiftType.Contains('|'))
                                                            {
                                                                <div class="d-flex flex-wrap gap-1 justify-content-center align-items-center">
                                                                    @foreach (var part in shiftType.Split('|', StringSplitOptions.RemoveEmptyEntries))
                                                                    {
                                                                        var segments = part.Split(':');
                                                                        if (segments.Length == 2)
                                                                        {
                                                                            var subType = segments[0].Trim();
                                                                            var subHours = segments[1];
                                                                            <span class="badge @GetShiftColorClass(subType) @(_isEditMode ? "shift-badge-interactive cursor-pointer" : "") rounded-1 shadow-sm px-1 py-0.5" 
                                                                                  style="font-size: 0.6rem; min-width: 28px; @(_isEditMode ? "cursor: pointer;" : "")" 
                                                                                  title="@(_isEditMode ? $"Click to edit {subType} shift ({subHours} hrs)" : "")"
                                                                                  @onclick="@(async () => { if (_isEditMode) await OpenEditShiftForDay(item, day.Date, subType); })">
                                                                                @subHours
                                                                            </span>
                                                                        }
                                                                    }
                                                                </div>
                                                            }
                                                            else
                                                            {
                                                                <div class="badge @GetShiftColorClass(shiftType) @(_isEditMode ? "shift-badge-interactive" : "") rounded-1 w-100 py-1 border shadow-sm" 
                                                                     style="font-size: 0.7rem; min-height: 22px; display: flex; align-items: center; justify-content: center; @(_isEditMode ? "cursor: pointer;" : "")" 
                                                                     @onclick="@(async () => { if (_isEditMode) await OpenEditShiftForDay(item, day.Date); })"
                                                                     title="@(_isEditMode ? $"Click to edit shift on {day:MMM dd}" : "")">
                                                                    @if (shiftType == "Hall" && item.DailyHours[day.Date] == 0)
                                                                    {
                                                                        <i class="bi bi-star-fill" style="font-size: 0.6rem;"></i>
                                                                    }
                                                                    else
                                                                    {
                                                                        @item.DailyHours[day.Date].ToString("N1")
                                                                    }
                                                                </div>
                                                            }
                                                        }
                                                        else
                                                        {
                                                            @if (_isEditMode)
                                                            {
                                                                <div class="empty-shift-cell text-muted" 
                                                                     @onclick="() => OpenAddShiftForDay(item, day.Date)"
                                                                     title="Click to add hours for @item.MemberName on @day.ToString("MMM dd")">
                                                                    <span class="empty-dash opacity-25">-</span>
                                                                    <i class="bi bi-plus-circle-fill empty-add-icon text-primary"></i>
                                                                </div>
                                                            }
                                                            else
                                                            {
                                                                <span class="opacity-25">-</span>
                                                            }
                                                        }
                                                    </td>
                                                }
                                                <td class="text-center fw-black border-start sticky-right-audit-2 x-small">@item.TotalHours.ToString("N1")</td>
                                                <td class="text-end pe-4 fw-black text-dark sticky-right-audit-1 x-small p-1">@item.TotalPay.ToString("C")</td>
                                            </tr>
                                        }
                                    </tbody>
                                    <tfoot class="bg-light bg-opacity-50 sticky-bottom border-top-2">
                                        <tr class="fw-black">
                                            <td class="ps-4 sticky-col border-end">Totals</td>
                                            @foreach (var day in GetWeekDays())
                                            {
                                                <td class="text-center text-primary">@FilteredData.SelectMany(d => d.DailyHours).Where(h => h.Key.Date == day.Date).Sum(h => h.Value).ToString("N1")</td>
                                            }
                                            <td class="text-center fw-black border-start sticky-right-audit-2">@FilteredData.Sum(d => d.TotalHours).ToString("N1")</td>
                                            <td class="text-end pe-4 fw-black text-dark sticky-right-audit-1 small">@FilteredData.Sum(d => d.TotalPay).ToString("C")</td>
                                        </tr>
                                    </tfoot>
                                </table>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- ========================================================================= -->
<!-- 1. SHIFT ROSTER & PAY DETAILS MODAL -->
<!-- ========================================================================= -->
@if (_showShiftRoster && _selectedRosterEmployee != null)
{
    <div class="modal fade show d-block" style="background: rgba(0,0,0,0.5); backdrop-filter: blur(8px); z-index: 1050;" tabindex="-1">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg" style="border-radius: 28px; overflow: hidden;">
                <div class="modal-header border-0 bg-primary bg-opacity-10 p-4">
                    <div class="d-flex align-items-center gap-3">
                        <div class="avatar-md bg-white text-primary rounded-circle d-flex align-items-center justify-content-center shadow-sm fw-black fs-4" style="width: 54px; height: 54px; border: 2px solid white;">
                            @_selectedRosterEmployee.Username.Substring(0,1).ToUpper()
                        </div>
                        <div>
                            <h4 class="modal-title fw-black mb-0">Shift Hours & Payroll</h4>
                            <div class="fw-bold text-primary">@_selectedRosterEmployee.MemberName <span class="text-muted small fw-normal">(@_selectedRosterEmployee.Username)</span></div>
                        </div>
                    </div>
                    <button type="button" class="btn-close" @onclick="CloseShiftRoster"></button>
                </div>
                
                <div class="modal-body p-4 bg-white">
                    <!-- Quick Stats Header -->
                    <div class="row g-3 mb-4">
                        <div class="col-md-4">
                            <div class="p-3 bg-light rounded-4 border text-center">
                                <div class="text-muted x-small fw-bold text-uppercase">TOTAL HOURS</div>
                                <div class="h3 fw-black text-dark mb-0">@_selectedRosterEmployee.TotalHours.ToString("N1") <span class="fs-6 opacity-50">hrs</span></div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="p-3 bg-light rounded-4 border text-center">
                                <div class="text-muted x-small fw-bold text-uppercase">HOURLY RATE</div>
                                <div class="h3 fw-black text-primary mb-0">@(_selectedRosterEmployee.HourlyRate?.ToString("C") ?? "$0.00")</div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="p-3 bg-light rounded-4 border text-center">
                                <div class="text-muted x-small fw-bold text-uppercase">EST. GROSS PAY</div>
                                <div class="h3 fw-black text-success mb-0">@_selectedRosterEmployee.TotalPay.ToString("C")</div>
                            </div>
                        </div>
                    </div>

                    <!-- Shift List Header & Actions -->
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h6 class="fw-black text-dark text-uppercase mb-0 tracking-wider">
                            <i class="bi bi-calendar-check me-2 text-primary"></i> Recorded Shifts for Selected Period
                        </h6>
                        <div class="d-flex gap-2">
                            <button class="btn btn-outline-secondary btn-sm rounded-pill px-3 fw-bold" @onclick="() => OpenEditRateModal(_selectedRosterEmployee)">
                                <i class="bi bi-currency-dollar me-1"></i> Edit Rate
                            </button>
                            <button class="btn btn-primary btn-sm rounded-pill px-3 fw-bold" @onclick="AddShiftForRosterEmployee">
                                <i class="bi bi-plus-lg me-1"></i> Add Shift
                            </button>
                        </div>
                    </div>

                    <!-- Individual Shifts Table -->
                    <div class="border rounded-4 overflow-hidden shadow-sm">
                        <div class="table-responsive" style="max-height: 280px;">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="bg-light">
                                    <tr class="x-small fw-black text-muted text-uppercase">
                                        <th class="ps-3 py-2">Date</th>
                                        <th class="py-2">Shift Type</th>
                                        <th class="py-2">Location</th>
                                        <th class="py-2 text-center">Hours</th>
                                        <th class="py-2 text-end">Est. Pay</th>
                                        <th class="py-2">Notes</th>
                                        <th class="pe-3 py-2 text-end" style="width: 100px;">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (!_rosterShifts.Any())
                                    {
                                        <tr>
                                            <td colspan="7" class="text-center py-4 text-muted">
                                                <i class="bi bi-clock-history display-6 text-muted opacity-25 d-block mb-2"></i>
                                                No individual shifts recorded in this period.
                                            </td>
                                        </tr>
                                    }
                                    else
                                    {
                                        @foreach (var s in _rosterShifts)
                                        {
                                            <tr>
                                                <td class="ps-3 py-2 fw-bold small text-dark">
                                                    @s.Date.ToString("ddd, MMM dd, yyyy")
                                                </td>
                                                <td class="py-2">
                                                    <span class="badge @GetShiftColorClass(s.ShiftType) rounded-1 shadow-sm px-2 py-1 x-small fw-bold">
                                                        @s.ShiftType
                                                    </span>
                                                </td>
                                                <td class="py-2 small text-muted">
                                                    @(s.Location == "Hall" ? "Upstairs Bar" : "Downstairs Bar")
                                                </td>
                                                <td class="py-2 text-center fw-bold small text-dark">
                                                    @s.Hours.ToString("N1") hrs
                                                </td>
                                                <td class="py-2 text-end fw-bold small text-success">
                                                    @s.GrossPay.ToString("C")
                                                </td>
                                                <td class="py-2 small text-muted text-truncate" style="max-width: 150px;" title="@s.Notes">
                                                    @(string.IsNullOrWhiteSpace(s.Notes) ? "-" : s.Notes)
                                                </td>
                                                <td class="pe-3 py-2 text-end">
                                                    <button class="btn btn-outline-primary btn-sm py-0 px-2 rounded-2 me-1" 
                                                            @onclick="() => EditRosterShift(s)" 
                                                            title="Edit this shift">
                                                        <i class="bi bi-pencil-square"></i>
                                                    </button>
                                                    <button class="btn btn-outline-danger btn-sm py-0 px-2 rounded-2" 
                                                            @onclick="() => PromptDeleteShift(s)" 
                                                            title="Delete this shift">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <div class="modal-footer border-0 p-4 pt-0 bg-white">
                    <button type="button" class="btn btn-outline-secondary px-4 rounded-pill fw-black" @onclick="CloseShiftRoster">CLOSE</button>
                </div>
            </div>
        </div>
    </div>
}

<!-- ========================================================================= -->
<!-- 2. SHIFT EDITOR MODAL (ADD / EDIT SHIFT HOURS) -->
<!-- ========================================================================= -->
@if (_showShiftEditor && _editingShift != null)
{
    <div class="modal fade show d-block" style="background: rgba(0,0,0,0.6); backdrop-filter: blur(8px); z-index: 1060;" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg" style="border-radius: 28px; overflow: hidden;">
                <div class="modal-header border-0 @(_editingShift.IsNew ? "bg-primary" : "bg-dark") text-white p-4">
                    <div class="d-flex align-items-center gap-3">
                        <div class="rounded-circle bg-white bg-opacity-25 d-flex align-items-center justify-content-center" style="width: 44px; height: 44px; font-size: 1.3rem;">
                            <i class="bi @(_editingShift.IsNew ? "bi-clock-history" : "bi-pencil-square")"></i>
                        </div>
                        <div>
                            <h5 class="modal-title fw-black mb-0">@(_editingShift.IsNew ? "Log Employee Hours" : "Edit Shift Hours")</h5>
                            <div class="small opacity-75">@(_editingShift.IsNew ? "Add missed or additional hours" : "Modify recorded work hours")</div>
                        </div>
                    </div>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseShiftEditor"></button>
                </div>
                
                <div class="modal-body p-4 bg-white">
                    <!-- Employee Picker -->
                    <div class="mb-3">
                        <label class="form-label small text-uppercase fw-bold text-muted">Employee</label>
                        <select class="form-select border shadow-sm rounded-3 fw-bold" @bind="_editingShift.Username">
                            <option value="">-- Select Employee --</option>
                            @foreach (var user in allSystemUsers)
                            {
                                <option value="@user.Username">@GetUserDisplayName(user.Username) (@@@user.Username)</option>
                            }
                        </select>
                    </div>

                    <!-- Date & Shift Row -->
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label small text-uppercase fw-bold text-muted">Shift Date</label>
                            <input type="date" class="form-control border shadow-sm rounded-3 fw-bold" @bind="_editingShift.Date" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small text-uppercase fw-bold text-muted">Shift Type</label>
                            <select class="form-select border shadow-sm rounded-3 fw-bold" @bind="_editingShift.ShiftType" @bind:after="OnShiftTypeChanged">
                                <option value="Day">Day Shift</option>
                                <option value="Night">Night Shift</option>
                                <option value="Both">Double Shift (Both)</option>
                                <option value="Hall">Upstairs Bar (Hall)</option>
                                <option value="Janitor">Janitor</option>
                            </select>
                        </div>
                    </div>

                    <!-- Location & Hours Row -->
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label small text-uppercase fw-bold text-muted">Location</label>
                            <select class="form-select border shadow-sm rounded-3 fw-bold" @bind="_editingShift.Location">
                                <option value="Main">Downstairs Bar</option>
                                <option value="Hall">Upstairs Bar (Hall)</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small text-uppercase fw-bold text-muted">Hours Worked</label>
                            <div class="input-group shadow-sm rounded-3 overflow-hidden">
                                <input type="number" step="0.25" min="0.25" max="24" class="form-control fw-black text-primary fs-5 text-center" @bind="_editingShift.Hours" placeholder="0.0" autofocus />
                                <span class="input-group-text bg-light text-muted fw-bold">hrs</span>
                            </div>
                        </div>
                    </div>

                    <!-- Notes / Adjustment Reason -->
                    <div class="mb-2">
                        <label class="form-label small text-uppercase fw-bold text-muted">Notes / Reason for Adjustment</label>
                        <textarea class="form-control border shadow-sm rounded-3" rows="2" placeholder="e.g. Forgot to clock in on tablet, covered extra hours, manager adjustment..." @bind="_editingShift.Notes"></textarea>
                    </div>
                </div>

                <div class="modal-footer border-0 p-4 pt-0 bg-white d-flex justify-content-between">
                    @if (!_editingShift.IsNew)
                    {
                        <button type="button" class="btn btn-outline-danger rounded-pill px-3 fw-bold" @onclick="RequestDeleteCurrentShift">
                            <i class="bi bi-trash me-1"></i> Delete Shift
                        </button>
                    }
                    else
                    {
                        <div></div>
                    }

                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-light rounded-pill px-4 fw-bold" @onclick="CloseShiftEditor">Cancel</button>
                        <button type="button" class="btn btn-primary rounded-pill px-4 fw-bold shadow-sm" @onclick="RequestSaveShift">
                            <i class="bi bi-check-lg me-1"></i> Save Hours
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<!-- ========================================================================= -->
<!-- 3. EXPLICIT CONFIRMATION DIALOG MODAL -->
<!-- ========================================================================= -->
@if (_showConfirmModal && _confirmData != null)
{
    <div class="modal fade show d-block" style="background: rgba(0,0,0,0.7); backdrop-filter: blur(10px); z-index: 1070;" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg" style="border-radius: 28px; overflow: hidden;">
                <div class="modal-header border-0 @(_confirmData.ActionType == "Delete" ? "bg-danger text-white" : (_confirmData.ActionType == "Add" ? "bg-primary text-white" : "bg-dark text-white")) p-4">
                    <div class="d-flex align-items-center gap-3">
                        <div class="rounded-circle bg-white bg-opacity-25 d-flex align-items-center justify-content-center" style="width: 44px; height: 44px; font-size: 1.3rem;">
                            <i class="bi @(_confirmData.ActionType == "Delete" ? "bi-exclamation-triangle-fill" : (_confirmData.ActionType == "Add" ? "bi-plus-circle-fill" : "bi-pencil-fill"))"></i>
                        </div>
                        <div>
                            <h5 class="modal-title fw-black mb-0">@_confirmData.Title</h5>
                            <div class="small opacity-75">Please review and confirm this change</div>
                        </div>
                    </div>
                </div>

                <div class="modal-body p-4 bg-white">
                    <div class="card border rounded-4 p-3 mb-3 bg-light">
                        <div class="d-flex justify-content-between align-items-center border-bottom pb-2 mb-2">
                            <span class="text-muted small fw-bold text-uppercase">Employee</span>
                            <span class="fw-black text-dark">@_confirmData.EmployeeName</span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center border-bottom pb-2 mb-2">
                            <span class="text-muted small fw-bold text-uppercase">Date & Shift</span>
                            <span class="fw-bold text-dark">@_confirmData.Date.ToString("MMM dd, yyyy") (@_confirmData.ShiftType)</span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center border-bottom pb-2 mb-2">
                            <span class="text-muted small fw-bold text-uppercase">Location</span>
                            <span class="fw-bold text-dark">@(_confirmData.Location == "Hall" ? "Upstairs Bar" : "Downstairs Bar")</span>
                        </div>
                        
                        @if (_confirmData.ActionType == "Edit")
                        {
                            <div class="d-flex justify-content-between align-items-center pt-1">
                                <span class="text-muted small fw-bold text-uppercase">Hours Change</span>
                                <div>
                                    <span class="text-muted text-decoration-line-through me-2">@(_confirmData.PreviousHours?.ToString("N1") ?? "0.0") hrs</span>
                                    <i class="bi bi-arrow-right text-primary me-2"></i>
                                    <span class="badge bg-primary fs-6 fw-black">@_confirmData.NewHours.ToString("N1") hrs</span>
                                </div>
                            </div>
                        }
                        else if (_confirmData.ActionType == "Add")
                        {
                            <div class="d-flex justify-content-between align-items-center pt-1">
                                <span class="text-muted small fw-bold text-uppercase">Hours to Record</span>
                                <span class="badge bg-success fs-6 fw-black">@_confirmData.NewHours.ToString("N1") hrs</span>
                            </div>
                        }
                        else if (_confirmData.ActionType == "Delete")
                        {
                            <div class="d-flex justify-content-between align-items-center pt-1">
                                <span class="text-danger small fw-bold text-uppercase">Hours Being Removed</span>
                                <span class="badge bg-danger fs-6 fw-black">@_confirmData.PreviousHours?.ToString("N1") hrs</span>
                            </div>
                        }
                    </div>

                    @if (!string.IsNullOrWhiteSpace(_confirmData.Notes))
                    {
                        <div class="small bg-white p-3 rounded-3 border text-muted">
                            <span class="fw-bold text-dark">Notes:</span> @_confirmData.Notes
                        </div>
                    }

                    @if (_confirmData.ActionType == "Delete")
                    {
                        <div class="alert alert-warning rounded-3 py-2 small mb-0 mt-3 d-flex align-items-center gap-2">
                            <i class="bi bi-exclamation-circle-fill"></i>
                            <div>This will delete the shift record and update calculated payroll totals.</div>
                        </div>
                    }
                </div>

                <div class="modal-footer border-0 p-4 pt-0 bg-white">
                    <button type="button" class="btn btn-light rounded-pill px-4 fw-bold" @onclick="() => _showConfirmModal = false" disabled="@_savingShift">
                        Cancel
                    </button>
                    <button type="button" class="btn @(_confirmData.ActionType == "Delete" ? "btn-danger" : "btn-primary") rounded-pill px-4 fw-bold shadow-sm" @onclick="ExecuteConfirmedActionAsync" disabled="@_savingShift">
                        @if (_savingShift)
                        {
                            <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                            <span>Saving...</span>
                        }
                        else
                        {
                            <i class="bi @(_confirmData.ActionType == "Delete" ? "bi-trash" : "bi-check-circle") me-1"></i>
                            <span>Confirm & @(_confirmData.ActionType == "Delete" ? "Delete" : "Apply")</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

