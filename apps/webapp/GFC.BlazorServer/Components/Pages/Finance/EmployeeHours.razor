                                            <label class="small fw-bold text-muted mb-1">MA State Income Tax (%)</label>
                                            <div class="input-group">
                                                <input type="number" class="form-control" step="0.01" @bind="_maStateTaxRate" />
                                                <span class="input-group-text">%</span>
                                            </div>
                                        </div>
