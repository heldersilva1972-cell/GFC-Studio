                </div>
                <div class="modal-footer border-0 p-4 bg-light">
                    <button type="button" class="btn btn-link text-muted text-decoration-none fw-bold" @onclick="() => _showPayrollSettings = false">CANCEL</button>
                    <button type="button" class="btn btn-primary px-5 py-2 rounded-pill fw-black shadow" @onclick="SavePayrollSettings">
