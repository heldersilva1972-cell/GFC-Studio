                                @foreach (var item in FilteredData)
                                {
                                    <tr>
                                        <td class="ps-4">
                                            <div class="d-flex align-items-center gap-3 cursor-pointer" @onclick="() => OpenPayDetails(item)">
                                                <div class="avatar-sm bg-primary bg-opacity-10 text-primary rounded-circle d-flex align-items-center justify-content-center fw-black" style="width: 40px; height: 40px;">
                                                    @item.Username.Substring(0,1).ToUpper()
                                                </div>
                                                <div>
                                                    <div class="fw-bold text-dark hover-primary">@item.MemberName</div>
                                                    <div class="small text-muted">@item.Username</div>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="text-center">
                                            <span class="badge bg-light text-dark border">@item.EntryCount</span>
                                        </td>
                                        <td class="text-center fw-bold">
                                            @(item.HourlyRate?.ToString("C") ?? "-")
                                        </td>
                                        <td class="text-center">
                                            <span class="badge bg-primary bg-opacity-10 text-primary px-3 py-2 rounded-pill fw-bold" style="font-size: 0.85rem;">
                                                @item.TotalHours.ToString("N1") hrs
                                            </span>
                                        </td>
                                        <td class="text-end fw-bold text-muted small">@item.TotalPay.ToString("C")</td>
                                        <td class="text-end fw-black text-success">@item.NetPay.ToString("C")</td>
                                        <td class="text-end pe-4">
                                            <div class="fw-black text-primary">@item.TotalPayrollCost.ToString("C")</div>
                                            <div class="x-small text-muted opacity-50">Incl. Taxes</div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot class="sticky-bottom bg-light border-top-2">
                                <tr class="bg-dark text-white fw-black">
                                    <td colspan="3" class="ps-4 border-white border-opacity-10">TOTALS</td>
                                    <td class="text-center border-white border-opacity-10">@FilteredData.Sum(d => d.TotalHours).ToString("N1")</td>
                                    <td class="text-end border-white border-opacity-10">@FilteredData.Sum(d => d.TotalPay).ToString("C")</td>
                                    <td class="text-end text-success border-white border-opacity-10">@FilteredData.Sum(d => d.NetPay).ToString("C")</td>
                                    <td class="text-end pe-4 text-primary border-white border-opacity-10">@FilteredData.Sum(d => d.TotalPayrollCost).ToString("C")</td>
                                </tr>
                            </tfoot>
                        </table>
                    }
                    else if (_layoutMode == "Grid")
                    {
                        <table class="table table-hover align-middle mb-0 hours-table">
                            <thead class="bg-light">
                                <tr>
                                    <th class="ps-4">Employee</th>
                                    <th>Rate</th>
                                    @foreach (var day in GetWeekDays())
                                    {
                                        <th class="text-center">
                                            <div class="small fw-bold">@day.ToString("ddd")</div>
                                            <div class="x-small text-muted" style="font-size: 0.65rem;">@day.ToString("MM/dd")</div>
                                        </th>
                                    }
                                    <th class="text-center border-end sticky-right-audit-3">TOTAL HRS</th>
                                    <th class="text-end border-end sticky-right-audit-2">GROSS PAY</th>
                                    <th class="text-end pe-4 sticky-right-audit-1">TOTAL COST</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in FilteredData)
                                {
                                    <tr>
                                        <td class="ps-4">
                                            <div class="d-flex align-items-center gap-2 cursor-pointer" @onclick="() => OpenPayDetails(item)">
                                                <div class="avatar-sm bg-light text-muted border rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 32px; height: 32px; font-size: 0.75rem;">
                                                    @item.Username.Substring(0,1).ToUpper()
