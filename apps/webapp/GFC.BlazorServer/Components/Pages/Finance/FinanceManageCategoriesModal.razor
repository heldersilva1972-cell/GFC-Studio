@using GFC.Core.Interfaces
@using GFC.Core.Models.Finance
@inject IFinanceService FinanceService

<div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.4); backdrop-filter: blur(8px);">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 28px; overflow: hidden;">
            <div class="modal-header bg-white border-0 px-4 pt-4 pb-0 d-flex justify-content-between align-items-center">
                <div>
                    <h5 class="modal-title fw-bold h4 mb-0">Manage Categories</h5>
                    <p class="text-muted small mb-0">Organize your bills with colors and icons</p>
                </div>
                <button type="button" class="btn-close" @onclick="OnClose"></button>
            </div>
            
            <div class="modal-body p-4">
                <div class="row g-4">
                    <!-- Left Side: List -->
                    <div class="col-md-6 border-end">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h6 class="fw-bold mb-0">Existing Categories</h6>
                            @if (EditingCategory.Id != 0)
                            {
                                <button class="btn btn-sm btn-primary rounded-pill px-3" @onclick="PrepareNew">
                                    <i class="bi bi-plus-lg me-1"></i> New
                                </button>
                            }
                        </div>
                        
                        <div class="category-list pe-2" style="max-height: 400px; overflow-y: auto;">
                            @foreach (var cat in Categories)
                            {
                                <div class="category-item d-flex align-items-center justify-content-between p-2 mb-2 rounded-3 @(EditingCategory.Id == cat.Id ? "bg-primary-subtle border border-primary" : "bg-light")" 
                                     style="cursor: pointer;" @onclick="() => Edit(cat)">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="cat-icon-preview" style="background: @cat.Color; color: white; width: 32px; height: 32px; border-radius: 8px; display: flex; align-items: center; justify-content: center;">
                                            <i class="bi @cat.Icon"></i>
                                        </div>
                                        <span class="fw-bold">@cat.Name</span>
                                    </div>
                                    <button class="btn btn-sm text-danger opacity-50 hover-opacity-100" @onclick:stopPropagation="true" @onclick="() => Delete(cat.Id)">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Right Side: Edit Form -->
                    <div class="col-md-6">
                        <h6 class="fw-bold mb-3">@(EditingCategory.Id == 0 ? "Create Category" : "Edit Category")</h6>
                        <EditForm Model="EditingCategory" OnValidSubmit="Save">
                            <div class="mb-3">
                                <label class="form-label small fw-bold text-muted">Category Name</label>
                                <InputText @bind-Value="EditingCategory.Name" class="form-control rounded-3" placeholder="e.g. Utilities, Insurance" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label small fw-bold text-muted">Pick a Color</label>
                                <div class="d-flex flex-wrap gap-2">
                                    @foreach (var color in ColorPresets)
                                    {
                                        <div class="color-swatch @(EditingCategory.Color == color ? "active" : "")" 
                                             style="background: @color; width: 32px; height: 32px; border-radius: 50%; cursor: pointer;" 
                                             @onclick="() => EditingCategory.Color = color">
                                        </div>
                                    }
                                </div>
                            </div>

                            <div class="mb-4">
                                <label class="form-label small fw-bold text-muted">Pick an Icon</label>
                                <div class="d-flex flex-wrap gap-2 icon-grid">
                                    @foreach (var icon in IconPresets)
                                    {
                                        <div class="icon-swatch @(EditingCategory.Icon == icon ? "active" : "")" 
                                             style="width: 36px; height: 36px; border-radius: 8px; border: 1px solid #e2e8f0; display: flex; align-items: center; justify-content: center; cursor: pointer;"
                                             @onclick="() => EditingCategory.Icon = icon">
                                            <i class="bi @icon h5 mb-0"></i>
                                        </div>
                                    }
                                </div>
                            </div>

                            <div class="d-grid">
                                <button type="submit" class="btn btn-primary rounded-pill py-2 shadow-sm fw-bold">
                                    @(EditingCategory.Id == 0 ? "Add Category" : "Save Changes")
                                </button>
                                @if (EditingCategory.Id != 0)
                                {
                                    <button type="button" class="btn btn-link btn-sm text-muted mt-2" @onclick="PrepareNew">Cancel Editing</button>
                                }
                            </div>
                        </EditForm>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .color-swatch.active { ring: 3px solid white; outline: 3px solid #3b82f6; }
    .icon-swatch.active { background: #3b82f6; color: white; border-color: #3b82f6 !important; }
    .icon-grid { max-height: 150px; overflow-y: auto; padding: 2px; }
    .hover-opacity-100:hover { opacity: 1 !important; }
</style>

@code {
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnUpdate { get; set; }

    private List<FinanceCategory> Categories { get; set; } = new();
    private FinanceCategory EditingCategory { get; set; } = new();

    private readonly string[] ColorPresets = { 
        "#3b82f6", "#ef4444", "#10b981", "#f59e0b", "#8b5cf6", 
        "#ec4899", "#06b6d4", "#f43f5e", "#6366f1", "#14b8a6" 
    };

    private readonly string[] IconPresets = {
        "bi-receipt", "bi-lightning-charge", "bi-droplet", "bi-house", "bi-car-front",
        "bi-shield-check", "bi-credit-card", "bi-phone", "bi-wifi", "bi-cart",
        "bi-briefcase", "bi-heart-pulse", "bi-mortarboard", "bi-tools", "bi-piggy-bank"
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadCategories();
    }

    private async Task LoadCategories()
    {
        Categories = (await FinanceService.GetAllCategoriesAsync()).ToList();
    }

    private void PrepareNew()
    {
        EditingCategory = new FinanceCategory { Color = ColorPresets[0], Icon = IconPresets[0] };
    }

    private void Edit(FinanceCategory cat)
    {
        EditingCategory = new FinanceCategory 
        { 
            Id = cat.Id, 
            Name = cat.Name, 
            Color = cat.Color, 
            Icon = cat.Icon,
            IsActive = cat.IsActive
        };
    }

    private async Task Save()
    {
        if (string.IsNullOrWhiteSpace(EditingCategory.Name)) return;

        if (EditingCategory.Id == 0)
            await FinanceService.CreateCategoryAsync(EditingCategory);
        else
            await FinanceService.UpdateCategoryAsync(EditingCategory);

        await LoadCategories();
        PrepareNew();
        await OnUpdate.InvokeAsync();
    }

    private async Task Delete(int id)
    {
        await FinanceService.DeleteCategoryAsync(id);
        await LoadCategories();
        if (EditingCategory.Id == id) PrepareNew();
        await OnUpdate.InvokeAsync();
    }
}
