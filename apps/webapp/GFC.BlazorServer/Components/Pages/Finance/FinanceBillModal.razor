@using GFC.Core.Interfaces
@using GFC.Core.Models.Finance
@inject IFinanceService FinanceService
@inject GFC.BlazorServer.Services.CustomAuthenticationStateProvider AuthStateProvider

<style>
    /* Direct priority overrides to ensure visibility and bypass file caching */
    .priority-high {
        background-color: #dc3545 !important;
        color: #ffffff !important;
        border: 1px solid #b21f2d !important;
        font-weight: 1000 !important;
    }
    .priority-medium {
        background-color: #fd7e14 !important;
        color: #ffffff !important;
        border: 1px solid #d96200 !important;
        font-weight: 1000 !important;
    }
    .priority-low {
        background-color: #475569 !important;
        color: #ffffff !important;
        border: 1px solid #334155 !important;
        font-weight: 1000 !important;
    }
</style>

<div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.4); backdrop-filter: blur(8px);">
    <div class="modal-dialog modal-dialog-centered finance-modal-content">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 28px;">
            <div class="modal-header finance-modal-header d-flex justify-content-between align-items-center">
                <h5 class="modal-title fw-bold">@(Bill.Id == 0 ? "Create New Bill" : "Edit Bill")</h5>
                <button type="button" class="btn-close" @onclick="OnClose"></button>
            </div>
            <div class="modal-body finance-modal-body">
                @if (ActiveLoans.Any() && Bill.Id == 0)
                {
                    <div class="d-flex justify-content-center mb-4">
                        <div class="btn-group w-100" role="group" style="border-radius: 50px; overflow: hidden; padding: 2px; background: #f1f5f9; border: 1px solid #e2e8f0;">
                            <button type="button" class="btn btn-sm rounded-pill py-2 fw-bold @(BillType == "Standard" ? "btn-primary text-white" : "btn-link text-muted")" @onclick='() => SetBillType("Standard")' style="font-size:0.75rem; border:none; text-decoration:none;">STANDARD BILL</button>
                            <button type="button" class="btn btn-sm rounded-pill py-2 fw-bold @(BillType == "Loan" ? "btn-primary text-white" : "btn-link text-muted")" @onclick='() => SetBillType("Loan")' style="font-size:0.75rem; border:none; text-decoration:none;">LOAN REPAYMENT</button>
                        </div>
                    </div>
                }

                <EditForm Model="Bill" OnValidSubmit="HandleSubmit">
                    <div class="row g-3">
                        @if (BillType == "Standard")
                        {
                            <!-- Vendor Selection -->
                            <div class="col-12">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <label class="form-label small fw-bold text-muted mb-0">Vendor</label>
                                    @if (!ShowNewVendor && SelectedVendor != null && SelectedVendor.Id > 0)
                                    {
                                        <span class="badge rounded-pill px-3 py-1 shadow-sm fw-black @GetPriorityBadgeClass(SelectedVendor.Priority)" style="font-size: 0.65rem; letter-spacing: 0.5px;">
                                            <i class="bi bi-flag-fill me-1"></i> @GetPriorityName(SelectedVendor.Priority).ToUpper() PRIORITY
                                        </span>
                                    }
                                </div>
                                
                                @if (!ShowNewVendor)
                                {
                                    <div class="input-group">
                                        <InputSelect ValueExpression="@(() => Bill.VendorId)" 
                                                     Value="@Bill.VendorId" 
                                                     ValueChanged="@((int val) => OnVendorChanged(val))" 
                                                     class="form-select rounded-4 shadow-sm">
                                            <option value="0">-- Select Existing Vendor --</option>
                                            @foreach (var vendor in Vendors)
                                            {
                                                <option value="@vendor.Id">@vendor.Name</option>
                                            }
                                        </InputSelect>
                                        <button class="btn btn-outline-primary border-0 ms-2" type="button" @onclick="ToggleNewVendor" title="Add New Vendor">
                                            <i class="bi bi-plus-circle-fill h4 mb-0"></i>
                                        </button>
                                    </div>
                                }
                                else
                                {
                                    <div class="input-group">
                                        <InputText @bind-Value="NewVendorName" class="form-control rounded-4 shadow-sm" placeholder="Type new vendor name..." />
                                        <button class="btn btn-outline-secondary border-0 ms-2" type="button" @onclick="ToggleNewVendor" title="Back to list">
                                            <i class="bi bi-arrow-left-circle-fill h4 mb-0"></i>
                                        </button>
                                    </div>
                                    <small class="text-primary mt-1 d-block"><i class="bi bi-info-circle me-1"></i> Creating a new vendor record</small>
                                }
                            </div>
                        }
                        else
                        {
                            <!-- Loan Selection -->
                            <div class="col-12">
                                <label class="form-label small fw-bold text-muted">Select Loan to Repay</label>
                                <InputSelect @bind-Value="SelectedLoanId" class="form-select rounded-4 shadow-sm">
                                    <option value="">-- Select Loan --</option>
                                    @foreach (var loan in ActiveLoans)
                                    {
                                        <option value="@loan.Id">@loan.LenderName (Bal: @loan.CurrentBalance.ToString("C"))</option>
                                    }
                                </InputSelect>
                                <small class="text-primary mt-1 d-block"><i class="bi bi-info-circle me-1"></i> Payments recorded on this bill will reduce the loan balance automatically.</small>
                            </div>
                        }

                        <!-- Amount & Category / Loan Info -->
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-muted">Amount Due</label>
                            <div class="input-group">
                                <span class="input-group-text bg-white border-end-0">$</span>
                                <InputNumber @bind-Value="Bill.OriginalAmount" class="form-control border-start-0" placeholder="0.00" onfocus="this.select()" />
                            </div>
                        </div>

                        @if (BillType == "Standard")
                        {
                            <div class="col-md-6">
                                <label class="form-label small fw-bold text-muted">Category</label>
                                <InputSelect @bind-Value="Bill.CategoryId" class="form-select">
                                    <option value="">General</option>
                                    @foreach (var cat in Categories)
                                    {
                                        <option value="@cat.Id">@cat.Name</option>
                                    }
                                </InputSelect>
                            </div>
                        }

                        <!-- Invoice Date, Due Date & Warning -->
                        <div class="col-md-4">
                            <label class="form-label small fw-bold text-muted">Invoice Date (Optional)</label>
                            <InputDate @bind-Value="Bill.InvoiceDate" class="form-control" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold text-muted">Due Date</label>
                            <InputDate @bind-Value="Bill.DueDate" class="form-control" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold text-muted">Alert Warning (Days)</label>
                            <InputNumber @bind-Value="Bill.WarningDays" class="form-control" placeholder="7" onfocus="this.select()" />
                        </div>

                        <!-- Recurring Options -->
                        <div class="col-12">
                            <div class="recurring-container p-3 rounded-4 d-flex flex-column @(Bill.IsRecurring ? "active" : "")">
                                <div class="form-check form-switch d-flex align-items-center gap-3">
                                    <InputCheckbox Value="Bill.IsRecurring" ValueChanged="@((bool val) => OnRecurringChanged(val))" ValueExpression="@(() => Bill.IsRecurring)" class="form-check-input ms-0" id="recurringSwitch" />
                                    <label class="form-check-label fw-bold mb-0" for="recurringSwitch" style="cursor:pointer">Recurring Bill</label>
                                </div>
                                @if (Bill.IsRecurring)
                                {
                                    <div class="mt-3 ps-5">
                                        <label class="form-label small fw-bold text-muted">Frequency</label>
                                        <InputSelect @bind-Value="Bill.RecurringFrequency" class="form-select form-select-sm rounded-pill shadow-sm border-0">
                                            <option value="Monthly">Monthly</option>
                                            <option value="Weekly">Weekly</option>
                                            <option value="BiWeekly">Bi-Weekly</option>
                                            <option value="Quarterly">Quarterly</option>
                                            <option value="Yearly">Yearly</option>
                                        </InputSelect>
                                        <small class="text-primary mt-2 d-block">
                                            <i class="bi bi-magic me-1"></i> Auto-generates next bill on payment
                                        </small>
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- Description -->
                        <div class="col-12">
                            <label class="form-label small fw-bold text-muted">Notes / Description</label>
                            <InputTextArea @bind-Value="Bill.Description" class="form-control" rows="2" placeholder="e.g. Account #123456" />
                        </div>

                        <!-- Payment History / Paid Date Details -->
                        @if (Bill.Payments != null && Bill.Payments.Any())
                        {
                            <div class="col-12 mt-3 pt-3 border-top">
                                <div class="d-flex align-items-center justify-content-between mb-2">
                                    <div class="d-flex align-items-center gap-2">
                                        <i class="bi bi-clock-history text-primary"></i>
                                        <span class="fw-bold small text-muted text-uppercase" style="font-size: 0.7rem; letter-spacing: 0.5px;">Payment History</span>
                                    </div>
                                    @{
                                        var lastPayment = Bill.Payments.OrderByDescending(p => p.PaymentDate).FirstOrDefault();
                                        var isLate = lastPayment != null && lastPayment.PaymentDate.Date > Bill.DueDate.Date;
                                    }
                                    @if (isLate)
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-3 py-1 fw-bold" style="font-size: 0.65rem;">PAID LATE</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1 fw-bold" style="font-size: 0.65rem;">PAID ON TIME</span>
                                    }
                                </div>
                                <div class="bg-light p-3 rounded-4 border border-light-subtle">
                                    <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom text-muted small" style="font-size: 0.75rem;">
                                        @if (Bill.InvoiceDate.HasValue)
                                        {
                                            <span>Invoice Date: <strong>@Bill.InvoiceDate.Value.ToString("MM/dd/yyyy")</strong></span>
                                        }
                                        <span>Due Date: <strong>@Bill.DueDate.ToString("MM/dd/yyyy")</strong></span>
                                        <span>Total Paid: <strong class="text-success">@Bill.TotalPaid.ToString("C")</strong></span>
                                    </div>
                                    @foreach (var payment in Bill.Payments.OrderByDescending(p => p.PaymentDate))
                                    {
                                        <div class="d-flex justify-content-between align-items-center mb-2" style="font-size: 0.75rem;">
                                            <div>
                                                <span class="fw-bold text-dark">@payment.PaymentDate.ToString("MM/dd/yyyy")</span>
                                                <span class="text-muted ms-2">(@payment.PaymentMethod)</span>
                                                @if (!string.IsNullOrEmpty(payment.Note))
                                                {
                                                    <div class="text-muted italic" style="font-size: 0.65rem;">@payment.Note</div>
                                                }
                                            </div>
                                            <div class="text-end">
                                                <span class="fw-bold text-success">@payment.AmountPaid.ToString("C")</span>
                                                @if (payment.PaymentDate.Date > Bill.DueDate.Date)
                                                {
                                                    <div class="text-danger fw-bold" style="font-size: 0.55rem; letter-spacing: 0.5px;">LATE</div>
                                                }
                                                else
                                                {
                                                    <div class="text-success fw-bold" style="font-size: 0.55rem; letter-spacing: 0.5px;">ON TIME</div>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>

                    <div class="modal-footer border-0 px-0 mt-2 flex-column align-items-stretch">
                        @if (ValidationError != null)
                        {
                            <div class="alert alert-danger py-2 px-3 mb-3 d-flex align-items-center gap-2 shadow-sm rounded-4">
                                <i class="bi bi-exclamation-triangle-fill"></i>
                                <span class="small fw-bold">@ValidationError</span>
                            </div>
                        }
                        <div class="d-flex justify-content-between gap-2 w-100">
                            @if (Bill.Id > 0)
                            {
                                <button type="button" class="btn btn-outline-danger rounded-pill px-4 fw-bold" @onclick="() => OnDeleteRequested.InvokeAsync(Bill)">Delete Bill</button>
                            }
                            else
                            {
                                <div></div>
                            }
                            <div class="d-flex gap-2">
                                <button type="button" class="btn btn-light rounded-pill px-4" @onclick="OnClose">Cancel</button>
                                <button type="submit" class="btn btn-primary rounded-pill px-4 shadow-sm">Save Bill</button>
                            </div>
                        </div>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public FinanceBill Bill { get; set; } = new() { DueDate = DateTime.Today, WarningDays = 7, Status = "Pending" };
    [Parameter] public EventCallback<bool> OnSave { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<FinanceBill> OnDeleteRequested { get; set; }

    private List<FinanceVendor> Vendors { get; set; } = new();
    private List<FinanceCategory> Categories { get; set; } = new();
    private List<FinanceLoan> ActiveLoans { get; set; } = new();
    private bool ShowNewVendor { get; set; }
    private string NewVendorName { get; set; } = "";
    private string? ValidationError { get; set; }
    private string BillType { get; set; } = "Standard";
    private int? SelectedLoanId { get; set; }

    protected override async Task OnInitializedAsync()
    {
        Vendors = (await FinanceService.GetAllVendorsAsync()).ToList();
        Categories = (await FinanceService.GetAllCategoriesAsync()).ToList();
        ActiveLoans = (await FinanceService.GetAllLoansAsync()).Where(l => l.IsActive || (Bill.LoanId.HasValue && l.Id == Bill.LoanId.Value)).ToList();
        
        if (Bill.LoanId.HasValue)
        {
            BillType = "Loan";
            SelectedLoanId = Bill.LoanId.Value;
        }
    }

    private void SetBillType(string type)
    {
        BillType = type;
        ValidationError = null;
    }

    private FinanceVendor? SelectedVendor => Vendors.FirstOrDefault(v => v.Id == Bill.VendorId);

    private void OnVendorChanged(int vendorId)
    {
        Bill.VendorId = vendorId;
        var vendor = Vendors.FirstOrDefault(v => v.Id == vendorId);
        if (vendor != null && vendor.DefaultCategoryId.HasValue)
        {
            Bill.CategoryId = vendor.DefaultCategoryId.Value;
        }
    }

    private string GetPriorityName(int priority) => priority switch
    {
        1 => "High",
        2 => "Medium",
        3 => "Low",
        _ => "Low"
    };

    private string GetPriorityBadgeClass(int priority) => priority switch
    {
        1 => "priority-high",
        2 => "priority-medium",
        3 => "priority-low",
        _ => "priority-low"
    };

    private void ToggleNewVendor() 
    {
        ShowNewVendor = !ShowNewVendor;
        if (!ShowNewVendor) NewVendorName = "";
        else Bill.VendorId = 0;
    }

    private void OnRecurringChanged(bool val)
    {
        Bill.IsRecurring = val;
        if (val && string.IsNullOrWhiteSpace(Bill.RecurringFrequency))
        {
            Bill.RecurringFrequency = "Monthly";
        }
    }

    private async Task HandleSubmit()
    {
        ValidationError = null;

        if (Bill.IsRecurring)
        {
            if (string.IsNullOrWhiteSpace(Bill.RecurringFrequency))
            {
                Bill.RecurringFrequency = "Monthly";
            }
        }
        else
        {
            Bill.RecurringFrequency = null;
        }

        // Validation: Amount
        if (Bill.OriginalAmount <= 0)
        {
            ValidationError = "Please enter a bill amount greater than $0.00.";
            return;
        }

        if (BillType == "Loan")
        {
            if (!SelectedLoanId.HasValue)
            {
                ValidationError = "Please select a loan for repayment.";
                return;
            }

            var loan = ActiveLoans.FirstOrDefault(l => l.Id == SelectedLoanId.Value);
            if (loan == null)
            {
                ValidationError = "Selected loan not found.";
                return;
            }

            if (Bill.OriginalAmount > loan.CurrentBalance)
            {
                ValidationError = $"Bill amount cannot exceed the remaining loan balance of {loan.CurrentBalance.ToString("C")}.";
                return;
            }

            // Resolve/Auto-create payee vendor
            var vendorName = $"Loan: {loan.LenderName}";
            var existingVendor = (await FinanceService.GetAllVendorsAsync())
                .FirstOrDefault(v => v.Name.Equals(vendorName, StringComparison.OrdinalIgnoreCase));
            if (existingVendor == null)
            {
                existingVendor = await FinanceService.CreateVendorAsync(new FinanceVendor { Name = vendorName, IsActive = true });
            }

            Bill.VendorId = existingVendor.Id;
            Bill.LoanId = loan.Id;
            Bill.CategoryId = null; // No category needed
            if (string.IsNullOrWhiteSpace(Bill.Description))
            {
                Bill.Description = $"Loan payment to {loan.LenderName}";
            }
        }
        else
        {
            // Standard Bill
            Bill.LoanId = null;

            // Validation: Vendor
            if (ShowNewVendor && string.IsNullOrWhiteSpace(NewVendorName))
            {
                ValidationError = "Please enter a name for the new vendor.";
                return;
            }
            if (!ShowNewVendor && Bill.VendorId == 0)
            {
                ValidationError = "Please select an existing vendor or create a new one.";
                return;
            }

            // Auto-create vendor if using the "New Vendor" input
            if (ShowNewVendor && !string.IsNullOrWhiteSpace(NewVendorName))
            {
                var vendor = await FinanceService.CreateVendorAsync(new FinanceVendor { Name = NewVendorName, IsActive = true });
                Bill.VendorId = vendor.Id;
            }
        }

        string? currentUser = null;
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            currentUser = authState.User?.Identity?.Name;
        }
        catch { }

        if (Bill.Id == 0)
            await FinanceService.CreateBillAsync(Bill, currentUser);
        else
            await FinanceService.UpdateBillAsync(Bill, currentUser);

        await OnSave.InvokeAsync(true);
    }
}
