    private void ResetQuickModal()
    {
        _quickGeneratedLink = "";
        _showQrCode = false;
        _isStationSetup = false;
    }

    private void OpenQuickOnboardModal()
    {
        _showQuickOnboardModal = true;
        _quickGeneratedLink = "";
        _quickCopied = false;
        _showQrCode = false;
        _isStationSetup = false;
        // [SAFETY] Default to 0 (Choose a user...) instead of auto-selecting the first user (which might be admin)
        _quickOnboardUserId = 0; 
    }

    private void CloseQuickOnboardModal()
    {
        _showQuickOnboardModal = false;
    }

    private void OnStationToggle()
    {
        if (_isStationSetup)
        {
            // If turning on station mode, default the user ID to the current admin
            // This satisfies the backend requirement while hiding the dropdown
            _quickOnboardUserId = _currentUserId;
        }
    }

    private async Task GenerateQuickInviteLink()
    {
        if (_quickOnboardUserId == 0 && !_isStationSetup) return;
        
        // Final safeguard for station mode
        var targetUserId = _isStationSetup ? _currentUserId : _quickOnboardUserId;
        if (targetUserId == 0) return;

        _generatingQuickLink = true;
        try
        {
            var token = await VpnService.CreateOnboardingTokenAsync(targetUserId, 1, _isStationSetup);
            var baseUrl = await UrlHelper.GetBaseUrlAsync();
            
            // For stations, we can append a hint to the URL
            var stationSfx = _isStationSetup ? "&station=true" : "";
            _quickGeneratedLink = $"{baseUrl.TrimEnd('/')}/setup/activate?token={token}{stationSfx}";
        }
        catch (Exception ex)
        {
            await ToastService.ShowError($"Failed to generate link: {ex.Message}");
        }
        finally
        {
            _generatingQuickLink = false;
        }
    }

    private async Task ResetQuickMobileSetup()
    {
        if (_quickOnboardUserId == 0) return;
        var user = _users.FirstOrDefault(u => u.UserId == _quickOnboardUserId);
        if (user == null) return;

        // [SAFETY] Prevent resetting the primary admin account
        if (user.Username.ToLowerInvariant() == "admin")
        {
            await ToastService.ShowWarning("Safety Lock: You cannot reset the environment for the primary 'admin' account.");
            return;
        }
        
        _showResetMobileConfirm = true;
    }

    private async Task ExecuteResetMobile()
    {
        if (_quickOnboardUserId == 0) return;
        
        _resettingMobile = true;
        _showResetMobileConfirm = false;
        
        try
        {
            await DeviceTrustService.ResetMobileSetupAsync(_quickOnboardUserId);
            await ToastService.ShowSuccess("Mobile environment has been completely reset for this user.");
            _quickGeneratedLink = ""; // Force them to generate new link after reset
        }
        catch (Exception ex)
        {
            await ToastService.ShowError($"Error resetting mobile setup: {ex.Message}");
        }
        finally
        {
            _resettingMobile = false;
        }
    }

