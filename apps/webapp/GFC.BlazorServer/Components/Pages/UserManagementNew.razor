@page "/users"
@attribute [Authorize(Policy = AppPolicies.RequireAdmin)]
@using GFC.BlazorServer.Services
@using GFC.Core.DTOs
@using GFC.Core.Interfaces
@using GFC.Core.Models
@using Microsoft.AspNetCore.Authorization
@using GFC.BlazorServer.Auth
@inject IUserManagementService UserManagementService
@inject GFC.BlazorServer.Services.CustomAuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JS
@inject IUrlHelperService UrlHelper
@inject INotificationService NotificationService
@inject IToastService ToastService
@inject IVpnConfigurationService VpnService
@using GFC.BlazorServer.Services.Vpn
@inject IPasskeyService PasskeyService
@inject IDeviceTrustService DeviceTrustService

<PageTitle>User Management - GFC</PageTitle>

<div class="user-management-container">
    <div class="page-header">
        <div>
            <h1 class="page-title">User Management</h1>
            <p class="page-subtitle">Manage user accounts and permissions</p>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-outline-warning fw-bold px-4" @onclick="OpenQuickOnboardModal">
                <i class="bi bi-lightning-charge-fill me-2"></i>Quick Onboard
            </button>
            <button class="btn btn-primary px-4" @onclick="OpenAddUserModal">
                <i class="bi bi-person-plus me-2"></i>Add User
            </button>
        </div>
    </div>

    @* Quick Stats *@
    <div class="stats-grid">
        <div class="stat-card">
            <div class="stat-icon bg-primary">
                <i class="bi bi-people-fill"></i>
            </div>
            <div class="stat-content">
                <div class="stat-value">@_users.Count</div>
                <div class="stat-label">Total Users</div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon bg-success">
                <i class="bi bi-check-circle-fill"></i>
            </div>
            <div class="stat-content">
                <div class="stat-value">@_users.Count(u => u.IsActive)</div>
                <div class="stat-label">Active</div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon bg-warning">
                <i class="bi bi-shield-fill-check"></i>
            </div>
            <div class="stat-content">
                <div class="stat-value">@_users.Count(u => u.IsAdmin)</div>
                <div class="stat-label">Admins</div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon bg-info">
                <i class="bi bi-person-badge"></i>
            </div>
            <div class="stat-content">
                <div class="stat-value">@_users.Count(u => u.IsDirector)</div>
                <div class="stat-label">Directors</div>
            </div>
        </div>
    </div>

    @* Users Table *@
    <div class="content-card">
        <div class="card-header">
            <h2 class="card-title">Users</h2>
            <div class="card-actions">
                <div class="search-box">
                    <i class="bi bi-search"></i>
                    <input type="text" 
                           class="form-control" 
                           placeholder="Search users..."
                           @bind="_searchQuery"
                           @bind:event="oninput" />
                </div>
                <button class="btn btn-outline-secondary" @onclick="OpenDefaultPermissionsModal">
                    <i class="bi bi-gear me-2"></i>Default Permissions
                </button>
            </div>
        </div>

        @if (_loading)
        {
            <div class="loading-state">
                <div class="spinner-border text-primary"></div>
                <p>Loading users...</p>
            </div>
        }
        else if (FilteredUsers.Any())
        {
            <div class="table-responsive">
                <table class="modern-table">
                    <thead>
                        <tr>
                            <th>User</th>
                            <th>Role</th>
                            <th>Status</th>
                            <th>Last Login</th>
                            <th>Access</th>
                            <th>Notifications</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in FilteredUsers)
                        {
                            <tr class="@(!user.IsActive ? "inactive-row" : "")">
                                <td>
                                    <div class="user-cell">
                                        <div class="user-avatar">
                                            <i class="bi bi-person-circle"></i>
                                        </div>
                                        <div class="user-info">
                                            <div class="user-name">@user.Username</div>
                                            @if (!string.IsNullOrEmpty(user.MemberName))
                                            {
                                                <div class="user-member">@user.MemberName</div>
                                            }
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    @if (user.IsAdmin)
                                    {
                                        <span class="badge badge-admin">
                                            <i class="bi bi-shield-fill-check me-1"></i>Admin
                                        </span>
                                    }
                                    else if (user.IsDirector)
                                    {
                                        <span class="badge badge-director">
                                            <i class="bi bi-person-badge me-1"></i>Director
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-user">
                                            <i class="bi bi-person me-1"></i>User
                                        </span>
                                    }
                                </td>
                                <td>
                                    @if (user.IsActive)
                                    {
                                        <span class="status-badge status-active">
                                            <i class="bi bi-check-circle-fill"></i>Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status-badge status-inactive">
                                            <i class="bi bi-x-circle-fill"></i>Inactive
                                        </span>
                                    }
                                </td>
                                <td>
                                    @if (user.LastLoginDate.HasValue)
                                    {
                                        <span class="text-muted small">@user.LastLoginDate.Value.ToString("MMM d, yyyy")</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Never</span>
                                    }
                                </td>
                                <td>
                                    <button class="btn btn-sm btn-link" @onclick="() => OpenPermissionsModal(user)">
                                        <i class="bi bi-key me-1"></i>Manage
                                    </button>
                                </td>
                                <td>
                                    <div class="d-flex flex-column gap-1">
                                        <button class="btn btn-sm btn-link text-info p-0 text-start" @onclick="() => OpenNotificationModal(user)">
                                            <i class="bi bi-bell me-1"></i>Alerts
                                        </button>
                                        <button class="btn btn-sm btn-link text-primary p-0 text-start" @onclick="() => OpenSendNotificationModal(user)">
                                            <i class="bi bi-send me-1"></i>Send Message
                                        </button>
                                    </div>
                                </td>
                                <td class="text-end">
                                    <div class="action-buttons">
                                        <button class="btn btn-outline-warning btn-sm px-2 me-2" @onclick="() => ConfirmResetPasscode(user)">
                                            Reset Passcode
                                        </button>
                                        <button class="btn btn-sm btn-icon" title="Edit" @onclick="() => OpenEditUserModal(user)">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        @if (user.Username.ToLowerInvariant() != "admin" && user.UserId != _currentUserId)
                                        {
                                            <button class="btn btn-sm btn-icon" title="Delete" @onclick="() => ConfirmDeleteUser(user)">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        }
                                        else
                                        {
                                            <div class="btn btn-sm btn-icon disabled" style="opacity: 0.3; cursor: not-allowed;" title="Cannot delete system admin or your own account">
                                                <i class="bi bi-trash"></i>
                                            </div>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="empty-state">
                <i class="bi bi-people"></i>
                <h3>No users found</h3>
                <p>Try adjusting your search or add a new user</p>
            </div>
        }
    </div>
</div>

@* Add/Edit User Modal *@
@if (_showUserModal)
{
    <div class="modal-overlay" @onclick="CloseUserModal">
        <div class="modal-container" @onclick:stopPropagation>
            <div class="modal-header">
                <h2 class="modal-title">@(_editingUser == null ? "Add New User" : "Edit User")</h2>
                <button class="btn-close" @onclick="CloseUserModal">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label class="form-label">Username <span class="text-danger">*</span></label>
                    <input type="text" class="form-control" @bind="_userForm.Username" placeholder="Enter username" />
                </div>

                <div class="form-group">
                    <label class="form-label">Member</label>
                    <select class="form-select" @bind="_userForm.MemberId" @bind:after="OnMemberSelected">
                        <option value="">-- Select Member (Optional) --</option>
                        @foreach (var member in _availableMembers)
                        {
                            <option value="@member.MemberId">@member.DisplayName</option>
                        }
                    </select>
                    @if (_editingUser == null)
                    {
                        <small class="form-text">Username will be auto-generated from member name</small>
                    }
                </div>

                @* Passcode removed - users set this during device activation wizard (Step 1) *@

                <div class="form-group">
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" @bind="_userForm.IsAdmin" id="isAdminCheck" />
                        <label class="form-check-label" for="isAdminCheck">
                            <i class="bi bi-shield-fill-check me-1"></i>Administrator
                        </label>
                    </div>
                    <small class="form-text">Admins have access to all pages and settings</small>
                </div>

                <div class="form-group">
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" @bind="_userForm.IsActive" id="isActiveCheck" />
                        <label class="form-check-label" for="isActiveCheck">
                            <i class="bi bi-check-circle me-1"></i>Active
                        </label>
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label">Notes</label>
                    <textarea class="form-control" @bind="_userForm.Notes" rows="3" placeholder="Optional notes about this user"></textarea>
                </div>

                @if (!string.IsNullOrEmpty(_userModalError))
                {
                    <div class="alert alert-danger">
                        <i class="bi bi-exclamation-triangle me-2"></i>@_userModalError
                    </div>
                }
            </div>
            <div class="modal-footer">
                <button class="btn btn-outline-secondary" @onclick="CloseUserModal">Cancel</button>
                <button class="btn btn-primary" @onclick="SaveUser" disabled="@_savingUser">
                    @if (_savingUser)
                    {
                        <span class="spinner-border spinner-border-sm me-2"></span>
                    }
                    <i class="bi bi-check-lg me-1"></i>@(_editingUser == null ? "Create User" : "Save Changes")
                </button>
            </div>
        </div>
    </div>
}

@* Permissions Modal *@
@if (_showPermissionsModal && _selectedUser != null)
{
    <div class="modal-overlay" @onclick="ClosePermissionsModal">
        <div class="modal-container modal-lg" @onclick:stopPropagation>
            <div class="modal-header">
                <div>
                    <h2 class="modal-title">Page Access Permissions</h2>
                    <p class="modal-subtitle">Managing access for @_selectedUser.Username</p>
                </div>
                <button class="btn-close" @onclick="ClosePermissionsModal">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
            <div class="modal-body">
                <div class="permissions-actions mb-3">
                    <button class="btn btn-sm btn-outline-primary" @onclick="SelectAllPermissions">
                        <i class="bi bi-check-all me-1"></i>Grant All
                    </button>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="ClearAllPermissions">
                        <i class="bi bi-x-lg me-1"></i>Revoke All
                    </button>
                </div>

                <div class="permissions-grid">
                    @foreach (var category in _pagesByCategory)
                    {
                        <div class="permission-category">
                            <h4 class="category-title">
                                <i class="bi bi-folder2-open me-2"></i>@category.Key
                                <span class="badge badge-secondary ms-2">@category.Value.Count pages</span>
                            </h4>
                            <div class="permission-list">
                                @foreach (var page in category.Value)
                                {
                                    <div class="permission-item">
                                        <div class="form-check">
                                            <input class="form-check-input" 
                                                   type="checkbox" 
                                                   id="page-@(page.PageId)"
                                                   checked="@_selectedPermissions.Contains(page.PageId)"
                                                   @onchange="@(e => TogglePermission(page.PageId, (bool)e.Value))" />
                                            <label class="form-check-label" for="page-@(page.PageId)">
                                                <strong>@GetCleanPageName(page)</strong>
                                                @if (!string.IsNullOrEmpty(page.Description))
                                                {
                                                    <br /><small class="text-muted">@(page.Description)</small>
                                                }
                                            </label>
                                        </div>
                                        @if (page.RequiresAdmin)
                                        {
                                            <span class="badge badge-warning">
                                                <i class="bi bi-shield-fill-check"></i>Admin Only
                                            </span>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-outline-secondary" @onclick="ClosePermissionsModal">Cancel</button>
                <button class="btn btn-primary" @onclick="SavePermissions" disabled="@_savingPermissions">
                    @if (_savingPermissions)
                    {
                        <span class="spinner-border spinner-border-sm me-2"></span>
                    }
                    <i class="bi bi-check-lg me-1"></i>Apply Permissions
                </button>
            </div>
        </div>
    </div>
}

@* Default Permissions Modal *@
@if (_showDefaultPermissionsModal)
{
    <div class="modal-overlay" @onclick="CloseDefaultPermissionsModal">
        <div class="modal-container modal-lg" @onclick:stopPropagation>
            <div class="modal-header">
                <div>
                    <h2 class="modal-title">Default Permissions Configuration</h2>
                    <p class="modal-subtitle">Set which permissions are automatically granted to new users</p>
                </div>
                <button class="btn-close" @onclick="CloseDefaultPermissionsModal">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
            <div class="modal-body">
                <div class="alert alert-info">
                    <i class="bi bi-info-circle me-2"></i>
                    <strong>Note:</strong> These permissions will be automatically granted to all newly created non-admin users. 
                    Admin users always have access to all pages.
                </div>

                <div class="permissions-grid">
                    @foreach (var category in _pagesByCategory)
                    {
                        <div class="permission-category">
                            <h4 class="category-title">
                                <i class="bi bi-folder2-open me-2"></i>@category.Key
                            </h4>
                            <div class="permission-list">
                                @foreach (var page in category.Value)
                                {
                                    <div class="permission-item @(page.RequiresAdmin ? "admin-page-item" : "")">
                                        <div class="form-check">
                                            <input class="form-check-input" 
                                                   type="checkbox" 
                                                   id="default-page-@(page.PageId)"
                                                   checked="@_defaultPermissions.Contains(page.PageId)"
                                                   @onchange="@(e => ToggleDefaultPermission(page.PageId, (bool)e.Value))" />
                                            
                                            <label class="form-check-label" for="default-page-@(page.PageId)">
                                                <div class="d-flex align-items-center">
                                                    <strong>@GetCleanPageName(page)</strong>
                                                    @if (page.RequiresAdmin)
                                                    {
                                                        <span class="badge bg-light text-dark ms-2 border" style="font-size: 0.65rem; opacity: 0.8;">
                                                            <i class="bi bi-shield-lock me-1"></i>ADMIN
                                                        </span>
                                                    }
                                                </div>
                                                @if (!string.IsNullOrEmpty(page.Description))
                                                {
                                                    <small class="text-muted d-block mt-1">@(page.Description)</small>
                                                }
                                            </label>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-outline-secondary" @onclick="CloseDefaultPermissionsModal">Cancel</button>
                <button class="btn btn-primary" @onclick="SaveDefaultPermissions" disabled="@_savingDefaultPermissions">
                    @if (_savingDefaultPermissions)
                    {
                        <span class="spinner-border spinner-border-sm me-2"></span>
                    }
                    <i class="bi bi-check-lg me-1"></i>Save Default Access
                </button>
            </div>
        </div>
    </div>
}




@* Notification Preferences Modal *@
@if (_showNotificationModal && _selectedUser != null)
{
    <div class="modal-overlay" @onclick="CloseNotificationModal">
        <div class="modal-container" @onclick:stopPropagation>
            <div class="modal-header">
                <div>
                    <h2 class="modal-title">Notification Channels</h2>
                    <p class="modal-subtitle">Configure what alerts @_selectedUser.Username receives</p>
                </div>
                <button class="btn-close" @onclick="CloseNotificationModal">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
            <div class="modal-body">
                <div class="table-responsive">
                    <table class="table table-sm table-borderless align-middle">
                        <thead>
                            <tr class="text-muted small uppercase">
                                <th>Event Category</th>
                                <th class="text-center">Email</th>
                                <th class="text-center">SMS</th>
                                <th class="text-center">Push</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td class="py-3"><i class="bi bi-person-plus text-success me-2"></i>New Signups</td>
                                <td class="text-center"><input type="checkbox" @bind="_userPrefs.MemberSignupNotifyEmail" /></td>
                                <td class="text-center"><input type="checkbox" @bind="_userPrefs.MemberSignupNotifySMS" /></td>
                                <td class="text-center"><input type="checkbox" @bind="_userPrefs.MemberSignupNotifyPush" /></td>
                            </tr>
                            <tr>
                                <td class="py-3"><i class="bi bi-wallet2 text-primary me-2"></i>Dues Payments</td>
                                <td class="text-center"><input type="checkbox" @bind="_userPrefs.DuesPaymentNotifyEmail" /></td>
                                <td class="text-center"><input type="checkbox" @bind="_userPrefs.DuesPaymentNotifySMS" /></td>
                                <td class="text-center"><input type="checkbox" @bind="_userPrefs.DuesPaymentNotifyPush" /></td>
                            </tr>
                            <tr>
                                <td class="py-3"><i class="bi bi-receipt text-warning me-2"></i>Reimbursements</td>
                                <td class="text-center"><input type="checkbox" @bind="_userPrefs.ReimbursementNotifyEmail" /></td>
                                <td class="text-center"><input type="checkbox" @bind="_userPrefs.ReimbursementNotifySMS" /></td>
                                <td class="text-center"><input type="checkbox" @bind="_userPrefs.ReimbursementNotifyPush" /></td>
                            </tr>
                            <tr>
                                <td class="py-3"><i class="bi bi-exclamation-octagon text-danger me-2"></i>System Alerts</td>
                                <td class="text-center"><input type="checkbox" @bind="_userPrefs.SystemAlertNotifyEmail" /></td>
                                <td class="text-center"><input type="checkbox" @bind="_userPrefs.SystemAlertNotifySMS" /></td>
                                <td class="text-center"><input type="checkbox" @bind="_userPrefs.SystemAlertNotifyPush" /></td>
                            </tr>
                            <tr>
                                <td class="py-3"><i class="bi bi-ticket-perforated text-info me-2"></i>Lottery Sales</td>
                                <td class="text-center"><input type="checkbox" @bind="_userPrefs.LotterySalesNotifyEmail" /></td>
                                <td class="text-center"><input type="checkbox" @bind="_userPrefs.LotterySalesNotifySMS" /></td>
                                <td class="text-center"><input type="checkbox" @bind="_userPrefs.LotterySalesNotifyPush" /></td>
                            </tr>
                            <tr>
                                <td class="py-3"><i class="bi bi-door-open text-secondary me-2"></i>Controller Events</td>
                                <td class="text-center"><input type="checkbox" @bind="_userPrefs.ControllerEventNotifyEmail" /></td>
                                <td class="text-center"><input type="checkbox" @bind="_userPrefs.ControllerEventNotifySMS" /></td>
                                <td class="text-center"><input type="checkbox" @bind="_userPrefs.ControllerEventNotifyPush" /></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-outline-secondary" @onclick="CloseNotificationModal">Cancel</button>
                <button class="btn btn-primary px-4" @onclick="SaveNotificationPrefs" disabled="@_savingPrefs">
                    @if (_savingPrefs) { <span class="spinner-border spinner-border-sm me-2"></span> }
                    Apply Policy
                </button>
            </div>
        </div>
    </div>
}

@* Send Custom Notification Modal *@
@if (_showSendNotificationModal && _selectedUser != null)
{
    <div class="modal-overlay" @onclick="CloseSendNotificationModal">
        <div class="modal-container" @onclick:stopPropagation>
            <div class="modal-header">
                <div>
                    <h2 class="modal-title">Send Custom Notification</h2>
                    <p class="modal-subtitle">Direct message to @_selectedUser.Username (@_pushSubscriptionCount registered devices)</p>
                </div>
                <button class="btn-close" @onclick="CloseSendNotificationModal">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
            <div class="modal-body">
                @if (!string.IsNullOrEmpty(_sendNotificationError))
                {
                    <div class="alert alert-danger mb-3">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>@_sendNotificationError
                    </div>
                }

                @if (_sendNotificationSuccess)
                {
                    <div class="alert alert-success mb-3">
                        <i class="bi bi-check-circle-fill me-2"></i>Notification sent successfully.
                    </div>
                }

                <div class="form-group mb-3">
                    <label class="form-label fw-bold">Subject</label>
                    <input type="text" class="form-control" @bind="_customNotification.Title" placeholder="Enter notification title..." />
                </div>

                <div class="form-group mb-3">
                    <label class="form-label fw-bold">Message Content</label>
                    <textarea class="form-control" @bind="_customNotification.Message" rows="5" placeholder="Type your message here..."></textarea>
                </div>

                <div class="notification-channels mt-4 p-3 bg-light rounded border">
                    <label class="form-label fw-bold d-block mb-3">Delivery Channels</label>
                    
                    <div class="form-check form-switch mb-3">
                        <input class="form-check-input" type="checkbox" @bind="_customNotification.SendPush" id="sendPushCheck" />
                        <label class="form-check-label" for="sendPushCheck">
                            <i class="bi bi-phone-vibrate me-2"></i>Push Notification
                        </label>
                        <div class="small text-muted ms-4">
                            @if (_pushSubscriptionCount > 0)
                            {
                                <span class="text-success"><i class="bi bi-check-circle-fill me-1"></i>Available on @_pushSubscriptionCount registered device(s).</span>
                            }
                            else
                            {
                                <span class="text-danger"><i class="bi bi-x-circle-fill me-1"></i>No registered devices. The user must enabled notifications in 'My Security'.</span>
                            }
                        </div>
                    </div>

                    <div class="form-check form-switch mb-2">
                        <input class="form-check-input" type="checkbox" @bind="_customNotification.SendEmail" id="sendEmailCheck" />
                        <label class="form-check-label" for="sendEmailCheck">
                            <i class="bi bi-envelope-at me-2"></i>Email Message
                        </label>
                        <div class="small text-muted ms-4">
                            Sends to: <strong>@(_selectedUser.Email ?? "No email on file")</strong>
                        </div>
                    </div>
                </div>

                @if (_customNotification.SendEmail && string.IsNullOrEmpty(_selectedUser.Email))
                {
                    <div class="alert alert-warning mt-3 py-2 small">
                        <i class="bi bi-exclamation-circle me-1"></i> Warning: User has no email address configured in their account settings. Email delivery will be skipped.
                    </div>
                }
            </div>
            <div class="modal-footer">
                @if (_sendNotificationSuccess)
                {
                    <button class="btn btn-secondary w-100 py-2" @onclick="CloseSendNotificationModal">Close Portal</button>
                }
                else
                {
                    <button class="btn btn-outline-secondary" @onclick="CloseSendNotificationModal">Cancel</button>
                    <button class="btn btn-primary px-4" @onclick="SendCustomNotification" disabled="@_sendingCustomNotification">
                        @if (_sendingCustomNotification)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        <i class="bi bi-send-fill me-2"></i>Send Now
                    </button>
                }
            </div>
        </div>
    </div>
}

@* Quick Onboard Modal (Unified with Access Controls) *@
@if (_showQuickOnboardModal)
{
    <div class="modal-overlay" @onclick="CloseQuickOnboardModal">
        <div class="modal-container modal-lg" @onclick:stopPropagation>
            <div class="modal-header bg-warning bg-opacity-10 border-bottom-0">
                <div>
                    <h2 class="modal-title text-dark"><i class="bi bi-lightning-charge-fill text-warning me-2"></i>Quick Onboard Device</h2>
                    <p class="modal-subtitle">Generate a one-time link or QR code to authorize a new phone or computer.</p>
                </div>
                <button class="btn-close" @onclick="CloseQuickOnboardModal">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
            <div class="modal-body pt-0">
                <div class="onboarding-tool p-4 bg-light rounded-4 border">
                    <div class="row g-4">
                        <div class="col-md-7">
                            @if (!_isStationSetup)
                            {
                                <label class="form-label fw-bold">1. Select the User to Onboard</label>
                                <select class="form-select border-0 shadow-sm py-2 mb-4" @bind="_quickOnboardUserId">
                                    <option value="0">Choose a user...</option>
                                    @foreach (var user in _users.OrderBy(u => u.Username))
                                    {
                                        <option value="@user.UserId">@user.Username @(string.IsNullOrEmpty(user.MemberName) ? "" : $"({user.MemberName})")</option>
                                    }
                                </select>

                                @if (_quickOnboardUserId > 0)
                                {
                                    <div class="troubleshooting-card animate-entrance card border-0 shadow-sm p-4 mb-3 bg-white rounded-4">
                                        <label class="fw-bold text-danger small mb-2 d-block text-uppercase"><i class="bi bi-shield-exclamation me-2"></i>Troubleshooting Only</label>
                                        <p class="x-small text-muted mb-3">If the user is stuck in a login loop or can't see the hub, use the <strong>Clean Slate</strong> reset first.</p>
                                        
                                        <button class="btn btn-outline-danger btn-sm w-100 py-2 fw-bold rounded-pill" @onclick="ResetQuickMobileSetup" disabled="@_resettingMobile">
                                            @if (_resettingMobile) { <span class="spinner-border spinner-border-sm me-2"></span> }
                                            else { <i class="bi bi-trash3-fill me-2"></i> }
                                            Revoke All Linked Devices
                                        </button>
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="station-mode-info animate-entrance h-100 d-flex flex-column justify-content-center p-4 bg-white rounded-4 shadow-sm border border-primary border-opacity-10 text-center">
                                    <div class="mb-3">
                                        <i class="bi bi-display text-primary" style="font-size: 3rem; opacity: 0.2;"></i>
                                    </div>
                                    <h5 class="fw-bold text-primary mb-2">Station Setup Enabled</h5>
                                    <p class="small text-muted mb-0">This link will authorize the device for <strong>all users</strong>. Individual login will be required on the device.</p>
                                    <div class="mt-3 p-2 bg-light rounded small">
                                        <i class="bi bi-shield-check me-2 text-success"></i>Authorized by: <strong>Admin (@(_users.FirstOrDefault(u => u.UserId == _currentUserId)?.Username ?? "You"))</strong>
                                    </div>
                                </div>
                            }
                        </div>
                        <div class="col-md-5">
                             <div class="mb-4">
                                 <label class="form-label fw-bold">2. Mode Selection</label>
                                 <div class="form-check form-switch p-3 bg-white rounded-4 shadow-sm border @(_isStationSetup ? "border-primary shadow-sm" : "")" style="transition: all 0.2s;">
                                     <input class="form-check-input ms-0 me-3" type="checkbox" role="switch" id="stationToggle" @bind="_isStationSetup" @bind:after="OnStationToggle" disabled="@(!string.IsNullOrEmpty(_quickGeneratedLink))">
                                     <label class="form-check-label fw-bold @(_isStationSetup ? "text-primary" : "")" for="stationToggle">
                                         <i class="bi bi-display me-2"></i>Shared / Station Mode
                                     </label>
                                     <p class="x-small text-muted mt-2 mb-0 ms-1">
                                         <i class="bi bi-info-circle me-1"></i> For lobby PCs or shared tablets. Skips device setup for individuals.
                                     </p>
                                 </div>
                             </div>

                             <label class="form-label fw-bold">3. Access Generation</label>
                             <div class="d-grid gap-2">
                                <button class="btn btn-warning py-3 fw-bold shadow-sm" 
                                        @onclick="GenerateQuickInviteLink" 
                                        disabled="@((_quickOnboardUserId == 0 && !_isStationSetup) || _generatingQuickLink || !string.IsNullOrEmpty(_quickGeneratedLink))">
                                    @if (_generatingQuickLink) { <span class="spinner-border spinner-border-sm me-2"></span> }
                                    else { <i class="bi bi-link-45deg me-1"></i> }
                                    Generate Access Link
                                </button>
                                
                                <button class="btn btn-outline-secondary py-2 small" @onclick="ResetQuickModal" disabled="@(string.IsNullOrEmpty(_quickGeneratedLink))">
                                    <i class="bi bi-arrow-counterclockwise me-1"></i> Start Over
                                </button>
                             </div>

                            @if (!string.IsNullOrEmpty(_quickGeneratedLink))
                            {
                                <div class="mt-4 animate-entrance text-center">
                                    <div class="qr-container p-3 bg-white rounded-4 border shadow-sm d-inline-block">
                                        @if (_showQrCode)
                                        {
                                            <div class="qr-wrapper animate-entrance">
                                                <img src="@($"https://api.qrserver.com/v1/create-qr-code/?size=180x180&data={Uri.EscapeDataString(_quickGeneratedLink)}")" 
                                                     alt="Setup QR Code" width="180" height="180" class="img-fluid" />
                                                <div class="mt-2 x-small text-primary fw-bold"><i class="bi bi-camera me-1"></i> Scan with Phone</div>
                                            </div>
                                        }
                                        else
                                        {
                                            <button class="btn btn-sm btn-outline-primary rounded-pill px-4 py-2" @onclick="() => _showQrCode = true">
                                                <i class="bi bi-qr-code me-2"></i>Generate QR Code
                                            </button>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(_quickGeneratedLink))
                    {
                        <div class="invite-link-box p-4 bg-white rounded-4 border border-primary border-opacity-25 shadow-sm animate-entrance mt-4">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="fw-bold text-primary small">ONBOARDING LINK READY</span>
                                <span class="badge bg-success small fw-normal">Verified Security</span>
                            </div>
                            <div class="input-group">
                                <input type="text" class="form-control bg-light border-0" value="@_quickGeneratedLink" readonly id="quickLinkInput" />
                                <button class="btn @(_quickCopied ? "btn-success" : "btn-primary") px-3" @onclick="CopyQuickInviteLink">
                                    <i class="bi @(_quickCopied ? "bi-check-lg" : "bi-clipboard")"></i>
                                </button>
                            </div>
                            <p class="x-small text-muted mt-3 mb-0">
                                <strong>Instructions:</strong> Inform the user to open this link on their device. 
                                @( _isStationSetup ? "This will trust the MACHINE for any user to log in." : "It is a one-time use link valid for 1 hour." )
                            </p>
                        </div>
                    }
                </div>

                <div class="alert alert-info border-0 rounded-4 mt-4 mb-0 d-flex align-items-center">
                    <i class="bi bi-info-circle-fill fs-4 me-3 text-info"></i>
                    <div>
                        <h6 class="fw-bold mb-0 small">Secure Setup Protocol</h6>
                        <p class="x-small mb-0 text-muted">A "Trust Token" will be permanently burned into the device upon completion, allowing for encrypted biometric access.</p>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-top-0">
                <button class="btn btn-outline-secondary px-4" @onclick="CloseQuickOnboardModal">Done</button>
            </div>
        </div>
    </div>
}

@* Reset Passcode Confirmation Modal *@
@if (_showResetPasscodeConfirm && _selectedUser != null)
