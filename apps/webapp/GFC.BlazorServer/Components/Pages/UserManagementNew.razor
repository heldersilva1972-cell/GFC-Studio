    private void OnMemberSelected()
    {
        // Only auto-generate username when creating a new user
        if (_editingUser != null || string.IsNullOrEmpty(_userForm.MemberId))
            return;

        var memberId = int.Parse(_userForm.MemberId);
        
        // Check both lists
        var selectedMember = _availableMembers.FirstOrDefault(m => m.MemberId == memberId) 
                             ?? _availableDirectors.FirstOrDefault(m => m.MemberId == memberId);
        
        if (selectedMember != null)
        {
            // Generate username: First initial + Last name (e.g., "HSilva" for "Helder Silva")
            var firstInitial = !string.IsNullOrEmpty(selectedMember.FirstName) ? selectedMember.FirstName[0].ToString().ToUpperInvariant() : "";
            var lastName = selectedMember.LastName ?? "";
            
            // Remove spaces or hyphens from last name
            lastName = lastName.Replace(" ", "").Replace("-", "");

            if (!string.IsNullOrEmpty(firstInitial) && !string.IsNullOrEmpty(lastName))
            {
                _userForm.Username = $"{firstInitial}{lastName}";
            }
            else
            {
                _userForm.Username = selectedMember.DisplayName.Replace(" ", "").Replace(",", "");
            }
        }
    }

    private async Task SaveUser()
    {
        _userModalError = "";
        
        if (string.IsNullOrWhiteSpace(_userForm.Username))
        {
            _userModalError = "Username is required";
            return;
        }

        // Passcode validation removed - users set passcode during device activation

        _savingUser = true;
        try
        {
            int? memberId = string.IsNullOrEmpty(_userForm.MemberId) ? null : int.Parse(_userForm.MemberId);
            
            // [FIX] Double-check for duplicate member assignment
            if (memberId.HasValue && IsMemberTaken(memberId.Value))
            {
                _userModalError = "This member is already associated with another user account.";
                _savingUser = false;
                return;
            }

            if (_editingUser == null)
            {
                if (!string.IsNullOrWhiteSpace(_userForm.Password))
                {
                    if (_userForm.Password.Length < 6 || !_userForm.Password.All(char.IsDigit))
                    {
                        _userModalError = "Passcode must be exactly 6 digits";
                        _savingUser = false;
                        return;
                    }
                }

                var userId = UserManagementService.CreateUser(
                    _userForm.Username,
                    "", 
                    _userForm.IsAdmin,
                    memberId,
                    _userForm.Notes,
                    "admin", 
                    passwordChangeRequired: true
                );

                if (!string.IsNullOrWhiteSpace(_userForm.Password))
                {
                    UserManagementService.ChangePassCode(userId, _userForm.Password, clearPasswordChangeRequired: false);
                }
            }
            else
            {
                // Update existing user properties
                UserManagementService.UpdateUser(
                    _editingUser.UserId,
                    _userForm.Username,
                    null, // Don't update password
                    memberId,
                    _userForm.Notes,
                    isAdmin: _userForm.IsAdmin,
                    isActive: _userForm.IsActive
                );

                if (!string.IsNullOrWhiteSpace(_userForm.Password))
                {
                    if (_userForm.Password.Length < 6 || !_userForm.Password.All(char.IsDigit))
                    {
                        _userModalError = "Passcode must be 6 digits";
                        _savingUser = false;
                        return;
                    }
                    UserManagementService.ChangePassCode(_editingUser.UserId, _userForm.Password, clearPasswordChangeRequired: false);
                }

                // [NEW] If user was deactivated, invalidate their sessions IMMEDIATELY
                if (!_userForm.IsActive)
                {
                    CustomAuthenticationStateProvider.InvalidateUser(_editingUser.UserId);
                }
            }

            await LoadUsers();
            CloseUserModal();
        }
        catch (Exception ex)
        {
            _userModalError = ex.Message;
        }
        finally
        {
            _savingUser = false;
        }
    }


