@* Edit Station Modal *@
@if (_showEditStationModal && _editingStation != null)
{
    <div class="modal-overlay" @onclick="CloseEditStationModal">
        <div class="modal-container" @onclick:stopPropagation style="max-width: 500px;">
            <div class="modal-header border-bottom-0 pb-0">
                <div>
                    <h2 class="modal-title h4 fw-bold text-primary">Edit Station Configuration</h2>
