        _ = Task.Run(async () => {
            var allStations = await DeviceTrustService.GetAllActiveStationsAsync();
            _editingStation = allStations.FirstOrDefault(s => s.DeviceToken == session.DeviceToken);
            if (_editingStation != null)
            {
                _editingStationLoginMode = !string.IsNullOrEmpty(_editingStation.LoginMode) ? _editingStation.LoginMode : "Standard";
                _selectedAuthorizedUserIds.Clear();
                if (!string.IsNullOrEmpty(_editingStation.AuthorizedUserIdsCsv))
                {
                    var ids = _editingStation.AuthorizedUserIdsCsv.Split(',').Select(int.Parse).ToList();
                    _selectedAuthorizedUserIds = ids;
                }
                _showEditStationModal = true;
                await InvokeAsync(StateHasChanged);
            }
        });
    }

    private void CloseEditStationModal()
    {
        _showEditStationModal = false;
        _editingStation = null;
    }

    private async Task SaveStationConfig()
    {
        if (_editingStation == null) return;
        
        _editingStation.LoginMode = _editingStationLoginMode;
        _editingStation.AuthorizedUserIdsCsv = _selectedAuthorizedUserIds.Any() ? string.Join(",", _selectedAuthorizedUserIds) : null;
        
        try
        {
            await DeviceTrustService.UpdateDeviceAsync(_editingStation);
            await ToastService.ShowSuccess($"Configuration for {_editingStation.StationName} updated.");
            CloseEditStationModal();
            await RefreshWorkstations();
        }
        catch (Exception ex)
        {
            await ToastService.ShowError($"Failed to save: {ex.Message}");
        }
    }

    private void ToggleStationUser(int userId, bool isChecked)
    {
        if (isChecked)
        {
            if (!_selectedAuthorizedUserIds.Contains(userId))
                _selectedAuthorizedUserIds.Add(userId);
        }
        else
        {
            _selectedAuthorizedUserIds.Remove(userId);
        }
    }

    public void Dispose()
    {
        StopCountdown();
    }
}
