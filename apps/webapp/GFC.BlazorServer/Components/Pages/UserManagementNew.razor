    private bool IsHiddenPage(AppPage page)
    {
        var route = (page.PageRoute ?? "").Trim().TrimEnd('/').ToLower();
        if (!string.IsNullOrEmpty(route) && !route.StartsWith("/")) route = "/" + route;

        // Filter by known variations of the hub route
        if (route == "/mobile" || route == "/hub") return true;

        // Backup filter by name
        var name = (page.PageName ?? "").ToLower();
        if (name.Contains("staff portal hub") || name.Contains("portal hub") || name.Contains("gfc portal home")) return true;

        return false;
    }

    private string GetCleanPageName(AppPage page)
    {
        var route = (page.PageRoute ?? "").Trim().TrimEnd('/').ToLower();
        if (!string.IsNullOrEmpty(route) && !route.StartsWith("/")) route = "/" + route;

        return route switch
        {
            "/mobile/shift-report" => "End of shift sales",
            "/mobile/liquor/manage" => "Liquor inventory manager",
            "/mobile/analytics" => "Income charts",
            "/mobile/keycards" => "Mobile Key Cards",
            "/mobile/dues" => "Mobile Dues & Payments",
            "/mobile/users" => "Mobile User Management",
            _ => page.PageName
        };
    }

