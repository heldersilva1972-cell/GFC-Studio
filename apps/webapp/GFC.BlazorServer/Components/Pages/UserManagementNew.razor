    private bool IsMemberTaken(int memberId)
    {
        // Any user other than the one currently being edited using this memberId counts as "taken"
        // We use the cached _users list for high-speed checking
        return _users.Any(u => u.MemberId == memberId && u.UserId != (_editingUser?.UserId ?? 0));
    }

