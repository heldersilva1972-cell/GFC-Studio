@page "/users"
@attribute [Authorize(Policy = AppPolicies.RequireAdmin)]
@using GFC.BlazorServer.Services
@using GFC.Core.DTOs
@using GFC.Core.Interfaces
@using GFC.Core.Models
@using Microsoft.AspNetCore.Authorization
@using GFC.BlazorServer.Auth
@inject IUserManagementService UserManagementService
@inject GFC.BlazorServer.Services.CustomAuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JS
@inject IUrlHelperService UrlHelper
@inject INotificationService NotificationService
@inject IVpnConfigurationService VpnService
@using GFC.BlazorServer.Services.Vpn
@inject IPasskeyService PasskeyService
@inject IDeviceTrustService DeviceTrustService

<PageTitle>User Management - GFC</PageTitle>

<div class="user-management-container">
    <div class="page-header">
        <div>
            <h1 class="page-title">User Management</h1>
            <p class="page-subtitle">Manage user accounts and permissions</p>
        </div>
        <button class="btn btn-primary" @onclick="OpenAddUserModal">
            <i class="bi bi-person-plus me-2"></i>Add User
        </button>
    </div>

    @* Quick Stats *@
    <div class="stats-grid">
        <div class="stat-card">
            <div class="stat-icon bg-primary">
                <i class="bi bi-people-fill"></i>
            </div>
            <div class="stat-content">
                <div class="stat-value">@_users.Count</div>
                <div class="stat-label">Total Users</div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon bg-success">
                <i class="bi bi-check-circle-fill"></i>
            </div>
            <div class="stat-content">
                <div class="stat-value">@_users.Count(u => u.IsActive)</div>
                <div class="stat-label">Active</div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon bg-warning">
                <i class="bi bi-shield-fill-check"></i>
            </div>
            <div class="stat-content">
                <div class="stat-value">@_users.Count(u => u.IsAdmin)</div>
                <div class="stat-label">Admins</div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon bg-info">
                <i class="bi bi-person-badge"></i>
            </div>
            <div class="stat-content">
                <div class="stat-value">@_users.Count(u => u.IsDirector)</div>
                <div class="stat-label">Directors</div>
            </div>
        </div>
    </div>

    @* Users Table *@
    <div class="content-card">
        <div class="card-header">
            <h2 class="card-title">Users</h2>
            <div class="card-actions">
                <div class="search-box">
                    <i class="bi bi-search"></i>
                    <input type="text" 
                           class="form-control" 
                           placeholder="Search users..."
                           @bind="_searchQuery"
                           @bind:event="oninput" />
                </div>
                <button class="btn btn-outline-secondary" @onclick="OpenDefaultPermissionsModal">
                    <i class="bi bi-gear me-2"></i>Default Permissions
                </button>
            </div>
        </div>

        @if (_loading)
        {
            <div class="loading-state">
                <div class="spinner-border text-primary"></div>
                <p>Loading users...</p>
            </div>
        }
        else if (FilteredUsers.Any())
        {
            <div class="table-responsive">
                <table class="modern-table">
                    <thead>
                        <tr>
                            <th>User</th>
                            <th>Role</th>
                            <th>Status</th>
                            <th>Last Login</th>
                            <th>Access</th>
                            <th>Notifications</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in FilteredUsers)
                        {
                            <tr class="@(!user.IsActive ? "inactive-row" : "")">
                                <td>
                                    <div class="user-cell">
                                        <div class="user-avatar">
                                            <i class="bi bi-person-circle"></i>
                                        </div>
                                        <div class="user-info">
                                            <div class="user-name">@user.Username</div>
                                            @if (!string.IsNullOrEmpty(user.MemberName))
                                            {
                                                <div class="user-member">@user.MemberName</div>
                                            }
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    @if (user.IsAdmin)
                                    {
                                        <span class="badge badge-admin">
                                            <i class="bi bi-shield-fill-check me-1"></i>Admin
                                        </span>
                                    }
                                    else if (user.IsDirector)
                                    {
                                        <span class="badge badge-director">
                                            <i class="bi bi-person-badge me-1"></i>Director
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-user">
                                            <i class="bi bi-person me-1"></i>User
                                        </span>
                                    }
                                </td>
                                <td>
                                    @if (user.IsActive)
                                    {
                                        <span class="status-badge status-active">
                                            <i class="bi bi-check-circle-fill"></i>Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status-badge status-inactive">
                                            <i class="bi bi-x-circle-fill"></i>Inactive
                                        </span>
                                    }
                                </td>
                                <td>
                                    @if (user.LastLoginDate.HasValue)
                                    {
                                        <span class="text-muted small">@user.LastLoginDate.Value.ToString("MMM d, yyyy")</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Never</span>
                                    }
                                </td>
                                <td>
                                    <button class="btn btn-sm btn-link" @onclick="() => OpenPermissionsModal(user)">
                                        <i class="bi bi-key me-1"></i>Manage
                                    </button>
                                </td>
                                <td>
                                    <div class="d-flex flex-column gap-1">
                                        <button class="btn btn-sm btn-link text-info p-0 text-start" @onclick="() => OpenNotificationModal(user)">
                                            <i class="bi bi-bell me-1"></i>Alerts
                                        </button>
                                        <button class="btn btn-sm btn-link text-primary p-0 text-start" @onclick="() => OpenSendNotificationModal(user)">
                                            <i class="bi bi-send me-1"></i>Send Message
                                        </button>
                                    </div>
                                </td>
                                <td class="text-end">
                                    <div class="action-buttons">
                                        <button class="btn btn-sm btn-icon" title="Edit" @onclick="() => OpenEditUserModal(user)">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        <button class="btn btn-sm btn-icon" title="Reset/Grant Access" @onclick="() => OpenDeviceSetupModal(user)">
                                            <i class="bi bi-box-arrow-in-right"></i>
                                        </button>
                                        @if (user.Username.ToLowerInvariant() != "admin" && user.UserId != _currentUserId)
                                        {
                                            <button class="btn btn-sm btn-icon" title="Delete" @onclick="() => ConfirmDeleteUser(user)">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        }
                                        else
                                        {
                                            <div class="btn btn-sm btn-icon disabled" style="opacity: 0.3; cursor: not-allowed;" title="Cannot delete system admin or your own account">
                                                <i class="bi bi-trash"></i>
                                            </div>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="empty-state">
                <i class="bi bi-people"></i>
                <h3>No users found</h3>
                <p>Try adjusting your search or add a new user</p>
            </div>
        }
    </div>
</div>

@* Add/Edit User Modal *@
@if (_showUserModal)
{
    <div class="modal-overlay" @onclick="CloseUserModal">
        <div class="modal-container" @onclick:stopPropagation>
            <div class="modal-header">
                <h2 class="modal-title">@(_editingUser == null ? "Add New User" : "Edit User")</h2>
                <button class="btn-close" @onclick="CloseUserModal">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label class="form-label">Username <span class="text-danger">*</span></label>
                    <input type="text" class="form-control" @bind="_userForm.Username" placeholder="Enter username" />
                </div>

                <div class="form-group">
                    <label class="form-label">Member</label>
                    <select class="form-select" @bind="_userForm.MemberId" @bind:after="OnMemberSelected">
                        <option value="">-- Select Member (Optional) --</option>
                        @foreach (var member in _availableMembers)
                        {
                            <option value="@member.MemberId">@member.DisplayName</option>
                        }
                    </select>
                    @if (_editingUser == null)
                    {
                        <small class="form-text">Username will be auto-generated from member name</small>
                    }
                </div>

                <div class="form-group">
                    <label class="form-label">
                        @(_editingUser == null ? "Temporary Passcode" : "New Passcode (leave blank to keep current)")
                        @if (_editingUser == null) { <span class="text-danger">*</span> }
                    </label>
                    <input type="text" class="form-control" @bind="_userForm.Password" 
                           placeholder="Enter 6-digit numeric passcode" 
                           inputmode="numeric" 
                           pattern="[0-9]*" 
                           maxlength="6" />
                    <small class="form-text">User will be required to change this on first login</small>
                </div>

                <div class="form-group">
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" @bind="_userForm.IsAdmin" id="isAdminCheck" />
                        <label class="form-check-label" for="isAdminCheck">
                            <i class="bi bi-shield-fill-check me-1"></i>Administrator
                        </label>
                    </div>
                    <small class="form-text">Admins have access to all pages and settings</small>
                </div>

                <div class="form-group">
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" @bind="_userForm.IsActive" id="isActiveCheck" />
                        <label class="form-check-label" for="isActiveCheck">
                            <i class="bi bi-check-circle me-1"></i>Active
                        </label>
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label">Notes</label>
                    <textarea class="form-control" @bind="_userForm.Notes" rows="3" placeholder="Optional notes about this user"></textarea>
                </div>

                @if (!string.IsNullOrEmpty(_userModalError))
                {
                    <div class="alert alert-danger">
                        <i class="bi bi-exclamation-triangle me-2"></i>@_userModalError
                    </div>
                }
            </div>
            <div class="modal-footer">
                <button class="btn btn-outline-secondary" @onclick="CloseUserModal">Cancel</button>
                <button class="btn btn-primary" @onclick="SaveUser" disabled="@_savingUser">
                    @if (_savingUser)
                    {
                        <span class="spinner-border spinner-border-sm me-2"></span>
                    }
                    <i class="bi bi-check-lg me-1"></i>@(_editingUser == null ? "Create User" : "Save Changes")
                </button>
            </div>
        </div>
    </div>
}

@* Permissions Modal *@
@if (_showPermissionsModal && _selectedUser != null)
{
    <div class="modal-overlay" @onclick="ClosePermissionsModal">
        <div class="modal-container modal-lg" @onclick:stopPropagation>
            <div class="modal-header">
                <div>
                    <h2 class="modal-title">Page Access Permissions</h2>
                    <p class="modal-subtitle">Managing access for @_selectedUser.Username</p>
                </div>
                <button class="btn-close" @onclick="ClosePermissionsModal">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
            <div class="modal-body">
                <div class="permissions-actions mb-3">
                    <button class="btn btn-sm btn-outline-primary" @onclick="SelectAllPermissions">
                        <i class="bi bi-check-all me-1"></i>Grant All
                    </button>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="ClearAllPermissions">
                        <i class="bi bi-x-lg me-1"></i>Revoke All
                    </button>
                </div>

                <div class="permissions-grid">
                    @foreach (var category in _pagesByCategory)
                    {
                        <div class="permission-category">
                            <h4 class="category-title">
                                <i class="bi bi-folder2-open me-2"></i>@category.Key
                                <span class="badge badge-secondary ms-2">@category.Value.Count pages</span>
                            </h4>
                            <div class="permission-list">
                                @foreach (var page in category.Value)
                                {
                                    <div class="permission-item">
                                        <div class="form-check">
                                            <input class="form-check-input" 
                                                   type="checkbox" 
                                                   id="page-@(page.PageId)"
                                                   checked="@_selectedPermissions.Contains(page.PageId)"
                                                   @onchange="@(e => TogglePermission(page.PageId, (bool)e.Value))" />
                                            <label class="form-check-label" for="page-@(page.PageId)">
                                                <strong>@(page.PageName)</strong>
                                                @if (!string.IsNullOrEmpty(page.Description))
                                                {
                                                    <br /><small class="text-muted">@(page.Description)</small>
                                                }
                                            </label>
                                        </div>
                                        @if (page.RequiresAdmin)
                                        {
                                            <span class="badge badge-warning">
                                                <i class="bi bi-shield-fill-check"></i>Admin Only
                                            </span>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-outline-secondary" @onclick="ClosePermissionsModal">Cancel</button>
                <button class="btn btn-primary" @onclick="SavePermissions" disabled="@_savingPermissions">
                    @if (_savingPermissions)
                    {
                        <span class="spinner-border spinner-border-sm me-2"></span>
                    }
                    <i class="bi bi-check-lg me-1"></i>Apply Permissions
                </button>
            </div>
        </div>
    </div>
}

@* Default Permissions Modal *@
@if (_showDefaultPermissionsModal)
{
    <div class="modal-overlay" @onclick="CloseDefaultPermissionsModal">
        <div class="modal-container modal-lg" @onclick:stopPropagation>
            <div class="modal-header">
                <div>
                    <h2 class="modal-title">Default Permissions Configuration</h2>
                    <p class="modal-subtitle">Set which permissions are automatically granted to new users</p>
                </div>
                <button class="btn-close" @onclick="CloseDefaultPermissionsModal">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
            <div class="modal-body">
                <div class="alert alert-info">
                    <i class="bi bi-info-circle me-2"></i>
                    <strong>Note:</strong> These permissions will be automatically granted to all newly created non-admin users. 
                    Admin users always have access to all pages.
                </div>

                <div class="permissions-grid">
                    @foreach (var category in _pagesByCategory)
                    {
                        <div class="permission-category">
                            <h4 class="category-title">
                                <i class="bi bi-folder2-open me-2"></i>@category.Key
                            </h4>
                            <div class="permission-list">
                                @foreach (var page in category.Value)
                                {
                                    <div class="permission-item @(page.RequiresAdmin ? "admin-page-item" : "")">
                                        <div class="form-check">
                                            <input class="form-check-input" 
                                                   type="checkbox" 
                                                   id="default-page-@(page.PageId)"
                                                   checked="@_defaultPermissions.Contains(page.PageId)"
                                                   @onchange="@(e => ToggleDefaultPermission(page.PageId, (bool)e.Value))" />
                                            
                                            <label class="form-check-label" for="default-page-@(page.PageId)">
                                                <div class="d-flex align-items-center">
                                                    <strong>@(page.PageName)</strong>
                                                    @if (page.RequiresAdmin)
                                                    {
                                                        <span class="badge bg-light text-dark ms-2 border" style="font-size: 0.65rem; opacity: 0.8;">
                                                            <i class="bi bi-shield-lock me-1"></i>ADMIN
                                                        </span>
                                                    }
                                                </div>
                                                @if (!string.IsNullOrEmpty(page.Description))
                                                {
                                                    <small class="text-muted d-block mt-1">@(page.Description)</small>
                                                }
                                            </label>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-outline-secondary" @onclick="CloseDefaultPermissionsModal">Cancel</button>
                <button class="btn btn-primary" @onclick="SaveDefaultPermissions" disabled="@_savingDefaultPermissions">
                    @if (_savingDefaultPermissions)
                    {
                        <span class="spinner-border spinner-border-sm me-2"></span>
                    }
                    <i class="bi bi-check-lg me-1"></i>Save Default Access
                </button>
            </div>
        </div>
    </div>
}

@* System Access Link Modal *@
@if (_showDeviceSetupModal && _selectedUser != null)
{
    <div class="modal-overlay" @onclick="CloseDeviceSetupModal">
        <div class="modal-container" @onclick:stopPropagation>
            <div class="modal-header">
                <div>
                    <h2 class="modal-title">System Access Link</h2>
                    <p class="modal-subtitle">Grant or reset access for @_selectedUser.Username</p>
                </div>
                <button class="btn-close" @onclick="CloseDeviceSetupModal">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
            <div class="modal-body">
                @if (string.IsNullOrEmpty(_generatedInviteLink))
                {
                    <div class="alert alert-warning mb-4">
                        <i class="bi bi-shield-exclamation me-2"></i>
                        <strong>Security Protocol:</strong> Access links provide temporary bypass of the network shield.
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-bold">Revocation Actions (Optional)</label>
                        <div class="form-check form-switch mb-2">
                            <input class="form-check-input" type="checkbox" @bind="_revokePreviousDevices" id="revokeDevicesCheck" />
                            <label class="form-check-label" for="revokeDevicesCheck">
                                Revoke all other trusted devices
                            </label>
                            <div class="small text-muted">Terminates any active sessions on other phones/laptops.</div>
                        </div>
                        <div class="form-check form-switch mb-2">
                            <input class="form-check-input" type="checkbox" @bind="_revokePreviousPasskeys" id="revokePasskeysCheck" />
                            <label class="form-check-label" for="revokePasskeysCheck">
                                Revoke all Biometric/Passkeys (FaceID/TouchID)
                            </label>
                            <div class="small text-muted">Forces user to register new biometric keys on their new device.</div>
                        </div>
                    </div>

                    <div class="mb-4 pt-3 border-top">
                        <label class="form-label fw-bold text-danger">Clean Slate Action</label>
                        <p class="small text-muted mb-3">Use this if the user is having "infinite loop" issues or needs to re-experience the "first-time" setup (PWA/Notifications).</p>
                        <button class="btn btn-outline-danger btn-sm" @onclick="ResetMobileSetup" disabled="@_resettingMobile">
                            @if (_resettingMobile) { <span class="spinner-border spinner-border-sm me-2"></span> }
                            <i class="bi bi-trash3-fill me-2"></i>Reset Mobile Setup
                        </button>
                    </div>

                    <div class="alert alert-info">
                        <i class="bi bi-info-circle me-2"></i>
                        The link will be valid for <strong>1 hour</strong> and can be used on <strong>one device</strong>.
                    </div>
                }
                else
                {
                    <div class="invite-link-box">
                        <label class="form-label fw-bold">Setup URL:</label>
                        <div class="input-group">
                            <input type="text" class="form-control" value="@_generatedInviteLink" readonly id="inviteLinkInput" />
                            <button class="btn btn-outline-primary" @onclick="CopyInviteLink">
                                <i class="bi @(_copied ? "bi-check-lg" : "bi-copy")"></i>
                            </button>
                        </div>
                        <div class="mt-3 p-3 bg-light rounded border">
                            <p class="mb-0 small">
                                <strong>Instructions:</strong> Inform the user to open this link on the <u>new device</u>. 
                                @if (_selectedUser.LastLoginDate == null) {
                                    <span>They will be prompted to set their initial password.</span>
                                } else {
                                    <span>They will be prompted to login to re-authorize their device.</span>
                                }
                            </p>
                        </div>
                    </div>
                }
            </div>
            <div class="modal-footer">
                @if (string.IsNullOrEmpty(_generatedInviteLink))
                {
                    <button class="btn btn-outline-secondary" @onclick="CloseDeviceSetupModal">Cancel</button>
                    <button class="btn btn-primary px-4" @onclick="GenerateDeviceSetupLink" disabled="@_generatingLink">
                        @if (_generatingLink) { <span class="spinner-border spinner-border-sm me-2"></span> }
                        <i class="bi bi-send-fill me-2"></i>Generate Link
                    </button>
                }
                else
                {
                    <button class="btn btn-primary px-4" @onclick="CloseDeviceSetupModal">Close Portal</button>
                }
            </div>
        </div>
    </div>
}



@* Notification Preferences Modal *@
@if (_showNotificationModal && _selectedUser != null)
{
    <div class="modal-overlay" @onclick="CloseNotificationModal">
        <div class="modal-container" @onclick:stopPropagation>
            <div class="modal-header">
                <div>
                    <h2 class="modal-title">Notification Channels</h2>
                    <p class="modal-subtitle">Configure what alerts @_selectedUser.Username receives</p>
                </div>
                <button class="btn-close" @onclick="CloseNotificationModal">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
            <div class="modal-body">
                <div class="table-responsive">
                    <table class="table table-sm table-borderless align-middle">
                        <thead>
                            <tr class="text-muted small uppercase">
                                <th>Event Category</th>
                                <th class="text-center">Email</th>
                                <th class="text-center">SMS</th>
                                <th class="text-center">Push</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td class="py-3"><i class="bi bi-person-plus text-success me-2"></i>New Signups</td>
                                <td class="text-center"><input type="checkbox" @bind="_userPrefs.MemberSignupNotifyEmail" /></td>
                                <td class="text-center"><input type="checkbox" @bind="_userPrefs.MemberSignupNotifySMS" /></td>
                                <td class="text-center"><input type="checkbox" @bind="_userPrefs.MemberSignupNotifyPush" /></td>
                            </tr>
                            <tr>
                                <td class="py-3"><i class="bi bi-wallet2 text-primary me-2"></i>Dues Payments</td>
                                <td class="text-center"><input type="checkbox" @bind="_userPrefs.DuesPaymentNotifyEmail" /></td>
                                <td class="text-center"><input type="checkbox" @bind="_userPrefs.DuesPaymentNotifySMS" /></td>
                                <td class="text-center"><input type="checkbox" @bind="_userPrefs.DuesPaymentNotifyPush" /></td>
                            </tr>
                            <tr>
                                <td class="py-3"><i class="bi bi-receipt text-warning me-2"></i>Reimbursements</td>
                                <td class="text-center"><input type="checkbox" @bind="_userPrefs.ReimbursementNotifyEmail" /></td>
                                <td class="text-center"><input type="checkbox" @bind="_userPrefs.ReimbursementNotifySMS" /></td>
                                <td class="text-center"><input type="checkbox" @bind="_userPrefs.ReimbursementNotifyPush" /></td>
                            </tr>
                            <tr>
                                <td class="py-3"><i class="bi bi-exclamation-octagon text-danger me-2"></i>System Alerts</td>
                                <td class="text-center"><input type="checkbox" @bind="_userPrefs.SystemAlertNotifyEmail" /></td>
                                <td class="text-center"><input type="checkbox" @bind="_userPrefs.SystemAlertNotifySMS" /></td>
                                <td class="text-center"><input type="checkbox" @bind="_userPrefs.SystemAlertNotifyPush" /></td>
                            </tr>
                            <tr>
                                <td class="py-3"><i class="bi bi-ticket-perforated text-info me-2"></i>Lottery Sales</td>
                                <td class="text-center"><input type="checkbox" @bind="_userPrefs.LotterySalesNotifyEmail" /></td>
                                <td class="text-center"><input type="checkbox" @bind="_userPrefs.LotterySalesNotifySMS" /></td>
                                <td class="text-center"><input type="checkbox" @bind="_userPrefs.LotterySalesNotifyPush" /></td>
                            </tr>
                            <tr>
                                <td class="py-3"><i class="bi bi-door-open text-secondary me-2"></i>Controller Events</td>
                                <td class="text-center"><input type="checkbox" @bind="_userPrefs.ControllerEventNotifyEmail" /></td>
                                <td class="text-center"><input type="checkbox" @bind="_userPrefs.ControllerEventNotifySMS" /></td>
                                <td class="text-center"><input type="checkbox" @bind="_userPrefs.ControllerEventNotifyPush" /></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-outline-secondary" @onclick="CloseNotificationModal">Cancel</button>
                <button class="btn btn-primary px-4" @onclick="SaveNotificationPrefs" disabled="@_savingPrefs">
                    @if (_savingPrefs) { <span class="spinner-border spinner-border-sm me-2"></span> }
                    Apply Policy
                </button>
            </div>
        </div>
    </div>
}

@* Send Custom Notification Modal *@
@if (_showSendNotificationModal && _selectedUser != null)
{
    <div class="modal-overlay" @onclick="CloseSendNotificationModal">
        <div class="modal-container" @onclick:stopPropagation>
            <div class="modal-header">
                <div>
                    <h2 class="modal-title">Send Custom Notification</h2>
                    <p class="modal-subtitle">Direct message to @_selectedUser.Username (@_pushSubscriptionCount registered devices)</p>
                </div>
                <button class="btn-close" @onclick="CloseSendNotificationModal">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
            <div class="modal-body">
                @if (!string.IsNullOrEmpty(_sendNotificationError))
                {
                    <div class="alert alert-danger mb-3">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>@_sendNotificationError
                    </div>
                }

                @if (_sendNotificationSuccess)
                {
                    <div class="alert alert-success mb-3">
                        <i class="bi bi-check-circle-fill me-2"></i>Notification sent successfully.
                    </div>
                }

                <div class="form-group mb-3">
                    <label class="form-label fw-bold">Subject</label>
                    <input type="text" class="form-control" @bind="_customNotification.Title" placeholder="Enter notification title..." />
                </div>

                <div class="form-group mb-3">
                    <label class="form-label fw-bold">Message Content</label>
                    <textarea class="form-control" @bind="_customNotification.Message" rows="5" placeholder="Type your message here..."></textarea>
                </div>

                <div class="notification-channels mt-4 p-3 bg-light rounded border">
                    <label class="form-label fw-bold d-block mb-3">Delivery Channels</label>
                    
                    <div class="form-check form-switch mb-3">
                        <input class="form-check-input" type="checkbox" @bind="_customNotification.SendPush" id="sendPushCheck" />
                        <label class="form-check-label" for="sendPushCheck">
                            <i class="bi bi-phone-vibrate me-2"></i>Push Notification
                        </label>
                        <div class="small text-muted ms-4">
                            @if (_pushSubscriptionCount > 0)
                            {
                                <span class="text-success"><i class="bi bi-check-circle-fill me-1"></i>Available on @_pushSubscriptionCount registered device(s).</span>
                            }
                            else
                            {
                                <span class="text-danger"><i class="bi bi-x-circle-fill me-1"></i>No registered devices. The user must enabled notifications in 'My Security'.</span>
                            }
                        </div>
                    </div>

                    <div class="form-check form-switch mb-2">
                        <input class="form-check-input" type="checkbox" @bind="_customNotification.SendEmail" id="sendEmailCheck" />
                        <label class="form-check-label" for="sendEmailCheck">
                            <i class="bi bi-envelope-at me-2"></i>Email Message
                        </label>
                        <div class="small text-muted ms-4">
                            Sends to: <strong>@(_selectedUser.Email ?? "No email on file")</strong>
                        </div>
                    </div>
                </div>

                @if (_customNotification.SendEmail && string.IsNullOrEmpty(_selectedUser.Email))
                {
                    <div class="alert alert-warning mt-3 py-2 small">
                        <i class="bi bi-exclamation-circle me-1"></i> Warning: User has no email address configured in their account settings. Email delivery will be skipped.
                    </div>
                }
            </div>
            <div class="modal-footer">
                @if (_sendNotificationSuccess)
                {
                    <button class="btn btn-secondary w-100 py-2" @onclick="CloseSendNotificationModal">Close Portal</button>
                }
                else
                {
                    <button class="btn btn-outline-secondary" @onclick="CloseSendNotificationModal">Cancel</button>
                    <button class="btn btn-primary px-4" @onclick="SendCustomNotification" disabled="@_sendingCustomNotification">
                        @if (_sendingCustomNotification)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        <i class="bi bi-send-fill me-2"></i>Send Now
                    </button>
                }
            </div>
        </div>
    </div>
}

@code {
    private List<UserListItemDto> _users = new();
    private List<ActiveMemberDto> _availableMembers = new();
    private List<AppPage> _allPages = new();
    private Dictionary<string, List<AppPage>> _pagesByCategory = new();
    private HashSet<int> _defaultPermissions = new();
    
    private string _searchQuery = "";
    private bool _loading = true;

    // Modals
    private bool _showUserModal = false;
    private bool _showPermissionsModal = false;
    private bool _showDefaultPermissionsModal = false;
    private int _currentUserId;

    // Device Setup Modal
    private bool _showDeviceSetupModal = false;
    private bool _revokePreviousDevices = false;
    private bool _revokePreviousPasskeys = false;
    private string _generatedInviteLink = "";
    private bool _generatingLink = false;
    private bool _resettingMobile = false;
    private bool _copied = false;

    // User Modal
    private UserListItemDto? _editingUser = null;
    private UserFormModel _userForm = new();
    private string _userModalError = "";
    private bool _savingUser = false;

    // Permissions Modal
    private UserListItemDto? _selectedUser = null;
    private HashSet<int> _selectedPermissions = new();
    private bool _savingPermissions = false;

    // Notification Modal
    private bool _showNotificationModal = false;
    private UserNotificationPreferences _userPrefs = new();
    private bool _savingPrefs = false;

    // Custom Notification Modal
    private bool _showSendNotificationModal = false;
    private CustomNotificationModel _customNotification = new();
    private bool _sendingCustomNotification = false;
    private string _sendNotificationError = "";
    private bool _sendNotificationSuccess = false;
    private int _pushSubscriptionCount = 0;

    // Default Permissions Modal
    private bool _savingDefaultPermissions = false;

    private IEnumerable<UserListItemDto> FilteredUsers =>
        _users.Where(u => string.IsNullOrEmpty(_searchQuery) ||
                         u.Username.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase) ||
                         (u.MemberName?.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase) ?? false));

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        _loading = true;
        try
        {
            await Task.WhenAll(
                Task.Run(() => _users = UserManagementService.GetAllUsers()),
                Task.Run(() => _availableMembers = UserManagementService.GetActiveMembersForUserCreation()),
                Task.Run(() => _allPages = UserManagementService.GetAllPages().ToList()),
                Task.Run(async () => {
                    var authState = await AuthStateProvider.GetAuthenticationStateAsync();
                    var user = authState.User;
                    var userIdClaim = user.FindFirst("UserId") ?? user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier);
                    if (userIdClaim != null && int.TryParse(userIdClaim.Value, out var id))
                    {
                        _currentUserId = id;
                    }
                })
            );
            
            // Group pages by category and sort categories by the DisplayOrder of the first page in each group
            _pagesByCategory = _allPages
                .Where(p => p.IsActive)
                .GroupBy(p => p.Category ?? "UNSPECIFIED")
                .OrderBy(g => g.Min(p => p.DisplayOrder))
                .ToDictionary(g => g.Key, g => g.OrderBy(p => p.DisplayOrder).ThenBy(p => p.PageName).ToList());
            
            // Load default permissions from system settings (you'll need to implement this)
            await LoadDefaultPermissions();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading user management data: {ex.Message}");
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private async Task OpenNotificationModal(UserListItemDto user)
    {
        _selectedUser = user;
        _userPrefs = await NotificationService.GetUserPreferencesAsync(user.UserId) 
                    ?? new UserNotificationPreferences { UserId = user.UserId };
        _showNotificationModal = true;
    }

    private void CloseNotificationModal()
    {
        _showNotificationModal = false;
        _selectedUser = null;
    }

    private async Task SaveNotificationPrefs()
    {
        if (_selectedUser == null) return;
        _savingPrefs = true;
        try
        {
            await NotificationService.SaveUserPreferencesAsync(_userPrefs);
            _showNotificationModal = false;
        }
        catch (Exception ex)
        {
            _userModalError = $"Error saving notifications: {ex.Message}";
        }
        finally
        {
            _savingPrefs = false;
            StateHasChanged();
        }
    }

    private async Task OpenSendNotificationModal(UserListItemDto user)
    {
        _selectedUser = user;
        _customNotification = new CustomNotificationModel
        {
            Title = "GFC Management Update",
            Message = "",
            SendPush = true,
            SendEmail = !string.IsNullOrEmpty(user.Email)
        };
        _sendNotificationError = "";
        _sendNotificationSuccess = false;
        
        // Load subscription count
        try 
        {
            _pushSubscriptionCount = await NotificationService.GetPushSubscriptionCountAsync(user.UserId);
        }
        catch { _pushSubscriptionCount = 0; }

        _showSendNotificationModal = true;
    }

    private void CloseSendNotificationModal()
    {
        _showSendNotificationModal = false;
        _selectedUser = null;
    }

    private async Task SendCustomNotification()
    {
        if (_selectedUser == null) return;
        
        if (string.IsNullOrWhiteSpace(_customNotification.Title) || string.IsNullOrWhiteSpace(_customNotification.Message))
        {
            _sendNotificationError = "Subject and Message are required.";
            return;
        }

        _sendNotificationError = "";
        _sendingCustomNotification = true;
        
        try
        {
            // 1. Send Push if selected
            if (_customNotification.SendPush)
            {
                await NotificationService.SendPushNotificationAsync(
                    _selectedUser.UserId, 
                    _customNotification.Title, 
                    _customNotification.Message
                );
            }

            // 2. Send Email if selected and available
            if (_customNotification.SendEmail && !string.IsNullOrEmpty(_selectedUser.Email))
            {
                await NotificationService.SendEmailAsync(
                    _selectedUser.Email,
                    _customNotification.Title,
                    _customNotification.Message
                );
            }

            _sendNotificationSuccess = true;
            StateHasChanged();
            
            // Auto close after success? Maybe let them click close.
        }
        catch (Exception ex)
        {
            _sendNotificationError = $"Failed to deliver notification: {ex.Message}";
        }
        finally
        {
            _sendingCustomNotification = false;
            StateHasChanged();
        }
    }

    private async Task LoadUsers()
    {
        try
        {
            _users = await Task.Run(() => UserManagementService.GetAllUsers());
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Error loading users: {ex.Message}");
        }
    }

    private async Task LoadDefaultPermissions()
    {
        try
        {
            _defaultPermissions = ((GFC.Core.Interfaces.IUserManagementService)UserManagementService).GetDefaultPageIds().ToHashSet();
            
            // If no defaults are set yet, fall back to basic membership for new systems
            if (_defaultPermissions.Count == 0)
            {
                _defaultPermissions = _allPages
                    .Where(p => p.IsActive && !p.RequiresAdmin && 
                               (p.Category == "DASHBOARD" || p.Category == "MEMBERSHIP"))
                    .Select(p => p.PageId)
                    .ToHashSet();
            }
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Error loading default permissions: {ex.Message}");
        }
    }

    // User Modal Methods
    private void OpenAddUserModal()
    {
        _editingUser = null;
        _userForm = new UserFormModel { IsActive = true };
        _userModalError = "";
        _showUserModal = true;
    }

    private void OpenEditUserModal(UserListItemDto user)
    {
        _editingUser = user;
        _userForm = new UserFormModel
        {
            Username = user.Username,
            MemberId = user.MemberId?.ToString() ?? "",
            IsAdmin = user.IsAdmin,
            IsActive = user.IsActive,
            Notes = user.Notes ?? ""
        };
        _userModalError = "";
        _showUserModal = true;
    }

    private void CloseUserModal()
    {
        _showUserModal = false;
        _editingUser = null;
        _userForm = new();
        _userModalError = "";
    }

    private void OnMemberSelected()
    {
        // Only auto-generate username when creating a new user
        if (_editingUser != null || string.IsNullOrEmpty(_userForm.MemberId))
            return;

        var memberId = int.Parse(_userForm.MemberId);
        var selectedMember = _availableMembers.FirstOrDefault(m => m.MemberId == memberId);
        
        if (selectedMember != null)
        {
            // Generate username: First initial + Last name (e.g., "HSilva" for "Helder Silva")
            var firstInitial = !string.IsNullOrEmpty(selectedMember.FirstName) ? selectedMember.FirstName[0].ToString().ToUpperInvariant() : "";
            var lastName = selectedMember.LastName ?? "";
            
            // Remove spaces or hyphens from last name
            lastName = lastName.Replace(" ", "").Replace("-", "");

            if (!string.IsNullOrEmpty(firstInitial) && !string.IsNullOrEmpty(lastName))
            {
                _userForm.Username = $"{firstInitial}{lastName}";
            }
            else
            {
                _userForm.Username = selectedMember.DisplayName.Replace(" ", "").Replace(",", "");
            }
        }
    }

    private async Task SaveUser()
    {
        _userModalError = "";
        
        if (string.IsNullOrWhiteSpace(_userForm.Username))
        {
            _userModalError = "Username is required";
            return;
        }

        if (_editingUser == null && (string.IsNullOrWhiteSpace(_userForm.Password) || _userForm.Password.Length < 6 || !_userForm.Password.All(char.IsDigit)))
        {
            _userModalError = "A 6-digit numeric passcode is required for new users";
            return;
        }

        _savingUser = true;
        try
        {
            int? memberId = string.IsNullOrEmpty(_userForm.MemberId) ? null : int.Parse(_userForm.MemberId);
            
            if (_editingUser == null)
            {
                // 1. Create new user with empty password (we use passcodes now)
                var userId = UserManagementService.CreateUser(
                    _userForm.Username,
                    "", 
                    _userForm.IsAdmin,
                    memberId,
                    _userForm.Notes,
                    "admin", // TODO: Get current user
                    passwordChangeRequired: true
                );

                // 2. Set initial passcode (keep PasswordChangeRequired=true so they MUST change it)
                UserManagementService.ChangePassCode(userId, _userForm.Password, clearPasswordChangeRequired: false);
            }
            else
            {
                // Update existing user properties
                UserManagementService.UpdateUser(
                    _editingUser.UserId,
                    _userForm.Username,
                    null, // Don't update password
                    memberId,
                    _userForm.Notes,
                    isAdmin: _userForm.IsAdmin,
                    isActive: _userForm.IsActive
                );

                // Update passcode if provided
                if (!string.IsNullOrWhiteSpace(_userForm.Password))
                {
                    if (_userForm.Password.Length < 6 || !_userForm.Password.All(char.IsDigit))
                    {
                        _userModalError = "Passcode must be 6 digits";
                        _savingUser = false;
                        return;
                    }
                    UserManagementService.ChangePassCode(_editingUser.UserId, _userForm.Password, clearPasswordChangeRequired: false);
                }
            }

            await LoadUsers();
            CloseUserModal();
        }
        catch (Exception ex)
        {
            _userModalError = ex.Message;
        }
        finally
        {
            _savingUser = false;
        }
    }

    // System Access Methods
    private void OpenDeviceSetupModal(UserListItemDto user)
    {
        _selectedUser = user;
        _revokePreviousDevices = false;
        _revokePreviousPasskeys = false;
        _generatedInviteLink = "";
        _generatingLink = false;
        _copied = false;
        _showDeviceSetupModal = true;
    }

    private void CloseDeviceSetupModal()
    {
        _showDeviceSetupModal = false;
        _selectedUser = null;
    }

    private async Task GenerateDeviceSetupLink()
    {
        if (_selectedUser == null) return;
        _generatingLink = true;

        try
        {
            // 1. Process Revocations if selected
            if (_revokePreviousDevices)
            {
                await DeviceTrustService.RevokeAllUserDevicesAsync(_selectedUser.UserId);
            }
            if (_revokePreviousPasskeys)
            {
                await PasskeyService.RevokeAllUserPasskeysAsync(_selectedUser.UserId);
            }

            // 2. Generate Unified Setup Token
            // We use the Onboarding Token system as it's the most powerful (handles password + device)
            var token = await VpnService.CreateOnboardingTokenAsync(_selectedUser.UserId, 1);
            var baseUrl = await UrlHelper.GetBaseUrlAsync();
            _generatedInviteLink = $"{baseUrl.TrimEnd('/')}/setup/activate?token={token}";
        }
        catch (Exception ex)
        {
            _userModalError = $"Failed to generate link: {ex.Message}";
        }
        finally
        {
            _generatingLink = false;
        }
    }

    private async Task ResetMobileSetup()
    {
        if (_selectedUser == null) return;
        
        var confirmed = await JS.InvokeAsync<bool>("confirm", 
            $"CRITICAL: This will permanently delete all trusted devices, push subscriptions, and passkeys for '{_selectedUser.Username}'. " +
            "The user will be treated as completely new on their next mobile access. Proceed?");

        if (!confirmed) return;

        _resettingMobile = true;
        try
        {
            await DeviceTrustService.ResetMobileSetupAsync(_selectedUser.UserId);
            await JS.InvokeVoidAsync("alert", "Mobile environment has been completely reset for this user.");
            CloseDeviceSetupModal();
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Error resetting mobile setup: {ex.Message}");
        }
        finally
        {
            _resettingMobile = false;
        }
    }

    private async Task CopyInviteLink()
    {
        if (string.IsNullOrEmpty(_generatedInviteLink)) return;
        
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", _generatedInviteLink);
        _copied = true;
        await Task.Delay(2000);
        _copied = false;
        StateHasChanged();
    }

    // Permissions Modal Methods
    private async Task OpenPermissionsModal(UserListItemDto user)
    {
        _selectedUser = user;
        _selectedPermissions.Clear();
        
        try
        {
            var userPermissions = await Task.Run(() => UserManagementService.GetUserPagePermissions(user.UserId));
            _selectedPermissions = userPermissions.Select(p => p.PageId).ToHashSet();
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Error loading user permissions: {ex.Message}");
        }
        
        _showPermissionsModal = true;
    }

    private void ClosePermissionsModal()
    {
        _showPermissionsModal = false;
        _selectedUser = null;
        _selectedPermissions.Clear();
    }

    private void TogglePermission(int pageId, bool isChecked)
    {
        if (isChecked)
            _selectedPermissions.Add(pageId);
        else
            _selectedPermissions.Remove(pageId);
    }

    private void SelectAllPermissions()
    {
        _selectedPermissions = _allPages.Where(p => p.IsActive).Select(p => p.PageId).ToHashSet();
    }

    private void ClearAllPermissions()
    {
        _selectedPermissions.Clear();
    }

    private async Task SavePermissions()
    {
        if (_selectedUser == null) return;
        
        _savingPermissions = true;
        try
        {
            UserManagementService.SetUserPagePermissions(
                _selectedUser.UserId,
                _selectedPermissions.ToList(),
                "admin" // TODO: Get current user
            );
            
            ClosePermissionsModal();
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Error saving permissions: {ex.Message}");
        }
        finally
        {
            _savingPermissions = false;
        }
    }

    private async Task OpenDefaultPermissionsModal()
    {
        _savingDefaultPermissions = false;
        
        // Ensure we have the latest page list
        _allPages = UserManagementService.GetAllPages().ToList();
        
        // Group pages by category and sort them for the UI
        _pagesByCategory = _allPages
            .Where(p => p.IsActive)
            .GroupBy(p => p.Category ?? "UNSPECIFIED")
            .OrderBy(g => g.Min(p => p.DisplayOrder))
            .ToDictionary(g => g.Key, g => g.OrderBy(p => p.DisplayOrder).ThenBy(p => p.PageName).ToList());

        // Load ACTUAL saved defaults from the database
        await LoadDefaultPermissions();
        
        _showDefaultPermissionsModal = true;
    }

    private void CloseDefaultPermissionsModal()
    {
        _showDefaultPermissionsModal = false;
    }

    private void ToggleDefaultPermission(int pageId, bool isChecked)
    {
        if (isChecked)
            _defaultPermissions.Add(pageId);
        else
            _defaultPermissions.Remove(pageId);
    }

    private async Task SaveDefaultPermissions()
    {
        _savingDefaultPermissions = true;
        try
        {
            await Task.Run(() => ((GFC.Core.Interfaces.IUserManagementService)UserManagementService).SetDefaultPageIds(_defaultPermissions.ToList()));
            _showDefaultPermissionsModal = false;
            // Optionally show a success toast here
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Error saving default permissions: {ex.Message}");
            await JS.InvokeVoidAsync("alert", $"Error: {ex.Message}");
        }
        finally
        {
            _savingDefaultPermissions = false;
        }
    }

    private async Task ConfirmDeleteUser(UserListItemDto user)
    {
        if (user.Username.ToLowerInvariant() == "admin")
        {
            await JS.InvokeVoidAsync("alert", "The primary system administrator account ('admin') cannot be deleted.");
            return;
        }

        if (user.UserId == _currentUserId)
        {
            await JS.InvokeVoidAsync("alert", "You cannot delete your own account.");
            return;
        }

        var confirmed = await JS.InvokeAsync<bool>("confirm", 
            $"Are you sure you want to delete user '{user.Username}'? This action cannot be undone.");
        
        if (confirmed)
        {
            try
            {
                UserManagementService.DeleteUser(user.UserId);
                await LoadUsers();
            }
            catch (Exception ex)
            {
                await JS.InvokeVoidAsync("alert", $"Error deleting user: {ex.Message}");
            }
        }
    }

    private class UserFormModel
    {
        public string Username { get; set; } = "";
        public string MemberId { get; set; } = "";
        public string Password { get; set; } = "";
        public bool IsAdmin { get; set; }
        public bool IsActive { get; set; } = true;
        public string Notes { get; set; } = "";
    }

    private class CustomNotificationModel
    {
        public string Title { get; set; } = "";
        public string Message { get; set; } = "";
        public bool SendPush { get; set; } = true;
        public bool SendEmail { get; set; } = false;
    }
}
