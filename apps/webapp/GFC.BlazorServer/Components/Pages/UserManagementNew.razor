                        <i class="bi bi-people-fill me-2"></i>2. Curate Staff Shortcut List
                    </label>
                    <div class="user-selection-grid p-3 bg-light border rounded-4" style="max-height: 250px; overflow-y: auto;">
                        @foreach (var user in _users.Where(u => u.IsActive).OrderBy(u => u.Username))
                        {
                            <div class="form-check small mb-2">
                                <input class="form-check-input" type="checkbox" id="edit-staff-@user.UserId" 
                                       checked="@_selectedAuthorizedUserIds.Contains(user.UserId)"
                                       @onchange="@(e => ToggleStationUser(user.UserId, (bool)e.Value))">
                                <label class="form-check-label fw-600" for="edit-staff-@user.UserId">
                                    @user.Username
                                    @if (!string.IsNullOrEmpty(user.MemberName))
                                    {
                                        <span class="text-muted fw-normal ms-1">(@user.MemberName)</span>
                                    }
                                </label>
                            </div>
                        }
                    </div>
                    <div class="x-small text-muted mt-2">
                        <i class="bi bi-info-circle me-1"></i> Selected users will appear on the Fast Login grid.
                    </div>
                </div>
            </div>
            <div class="modal-footer border-top-0 pb-4">
                <button class="btn btn-outline-secondary px-4 rounded-pill" @onclick="CloseEditStationModal">Cancel</button>
                <button class="btn btn-primary px-4 rounded-pill fw-bold shadow-sm" @onclick="SaveStationConfig">
                    Save Changes <i class="bi bi-check2 ms-2"></i>
                </button>
            </div>
        </div>
    </div>
}






