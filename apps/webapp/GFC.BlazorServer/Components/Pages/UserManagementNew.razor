                        </button>
                        <button class="btn @(_editingStationLoginMode == "FastGrid" ? "btn-primary shadow-sm" : "btn-outline-secondary") flex-grow-1 py-2 fw-bold" 
                                @onclick='() => _editingStationLoginMode = "FastGrid"'>
