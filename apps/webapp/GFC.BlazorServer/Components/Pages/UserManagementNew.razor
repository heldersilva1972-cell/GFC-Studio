    private async Task LoadData()
    {
        _loading = true;
        try
        {
            await Task.WhenAll(
                Task.Run(() => _users = UserManagementService.GetAllUsers()),
                Task.Run(() => _availableDirectors = UserManagementService.GetEligibleDirectorsForUserCreation()),
                Task.Run(() => _availableMembers = UserManagementService.GetEligibleMembersForUserCreation()),
                Task.Run(() => _allPages = UserManagementService.GetAllPages().ToList()),
                Task.Run(async () => _systemSettings = await SystemSettingsService.GetAsync()),
                Task.Run(async () => {
                    var authState = await AuthStateProvider.GetAuthenticationStateAsync();
                    var user = authState.User;
                    var userIdClaim = user.FindFirst("UserId") ?? user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier);
                    if (userIdClaim != null && int.TryParse(userIdClaim.Value, out var id))
                    {
                        _currentUserId = id;
                    }
                }),
                Task.Run(async () => {
                    _activeStations = await DeviceTrustService.GetAllActiveStationsAsync();
                    _sessions = await DeviceTrustService.GetAllActiveDevicesAsync();
                    _pendingSessions = await DeviceTrustService.GetPendingPairingRequestsAsync();
                })
            );
            
            // Group pages by category and sort categories by the DisplayOrder of the first page in each group
            // [FIX] Exclude hidden system pages from the UI
            _pagesByCategory = _allPages
                .Where(p => p.IsActive && !IsHiddenPage(p))
                .GroupBy(p => p.Category ?? "UNSPECIFIED")
                .OrderBy(g => g.Min(p => p.DisplayOrder))
                .ToDictionary(g => g.Key, g => g.OrderBy(p => p.DisplayOrder).ThenBy(p => p.PageName).ToList());
            
            // Load default permissions from system settings (you'll need to implement this)
            await LoadDefaultPermissions();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading user management data: {ex.Message}");
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

