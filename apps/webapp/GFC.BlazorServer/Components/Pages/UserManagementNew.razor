@* Send Custom Notification Modal *@
@if (_showSendNotificationModal && _selectedUser != null)
{
    <div class="modal-overlay" @onclick="CloseSendNotificationModal">
        <div class="modal-container" @onclick:stopPropagation>
            <div class="modal-header">
                <div>
                    <h2 class="modal-title">Send Custom Notification</h2>
                    <p class="modal-subtitle">Direct message to @_selectedUser.Username (@_pushSubscriptionCount registered devices)</p>
                </div>
                <button class="btn-close" @onclick="CloseSendNotificationModal">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
            <div class="modal-body">
                @if (!string.IsNullOrEmpty(_sendNotificationError))
                {
                    <div class="alert alert-danger mb-3">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>@_sendNotificationError
                    </div>
                }

                @if (_sendNotificationSuccess)
                {
                    <div class="alert alert-success mb-3">
                        <i class="bi bi-check-circle-fill me-2"></i>Notification sent successfully.
                    </div>
                }

                <div class="form-group mb-3">
                    <label class="form-label fw-bold">Subject</label>
                    <input type="text" class="form-control" @bind="_customNotification.Title" placeholder="Enter notification title..." />
                </div>

                <div class="form-group mb-3">
                    <label class="form-label fw-bold">Message Content</label>
                    <textarea class="form-control" @bind="_customNotification.Message" rows="5" placeholder="Type your message here..."></textarea>
                </div>

                <div class="notification-channels mt-4 p-3 bg-light rounded border">
                    <label class="form-label fw-bold d-block mb-3">Delivery Channels</label>
                    
                    <div class="form-check form-switch mb-3">
                        <input class="form-check-input" type="checkbox" @bind="_customNotification.SendPush" id="sendPushCheck" />
                        <label class="form-check-label" for="sendPushCheck">
                            <i class="bi bi-phone-vibrate me-2"></i>Push Notification
                        </label>
                        <div class="small text-muted ms-4">
                            @if (_pushSubscriptionCount > 0)
                            {
                                <span class="text-success"><i class="bi bi-check-circle-fill me-1"></i>Available on @_pushSubscriptionCount registered device(s).</span>
                            }
                            else
                            {
                                <span class="text-danger"><i class="bi bi-x-circle-fill me-1"></i>No registered devices. The user must enabled notifications in 'My Security'.</span>
                            }
                        </div>
                    </div>

                    <div class="form-check form-switch mb-2">
                        <input class="form-check-input" type="checkbox" @bind="_customNotification.SendEmail" id="sendEmailCheck" />
                        <label class="form-check-label" for="sendEmailCheck">
                            <i class="bi bi-envelope-at me-2"></i>Email Message
                        </label>
                        <div class="small text-muted ms-4">
                            Sends to: <strong>@(_selectedUser.Email ?? "No email on file")</strong>
                        </div>
                    </div>
                </div>

                @if (_customNotification.SendEmail && string.IsNullOrEmpty(_selectedUser.Email))
                {
                    <div class="alert alert-warning mt-3 py-2 small">
                        <i class="bi bi-exclamation-circle me-1"></i> Warning: User has no email address configured in their account settings. Email delivery will be skipped.
                    </div>
                }
            </div>
            <div class="modal-footer">
                @if (_sendNotificationSuccess)
                {
                    <button class="btn btn-secondary w-100 py-2" @onclick="CloseSendNotificationModal">Close Portal</button>
                }
                else
                {
                    <button class="btn btn-outline-secondary" @onclick="CloseSendNotificationModal">Cancel</button>
                    <button class="btn btn-primary px-4" @onclick="SendCustomNotification" disabled="@_sendingCustomNotification">
                        @if (_sendingCustomNotification)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        <i class="bi bi-send-fill me-2"></i>Send Now
                    </button>
                }
            </div>
        </div>
    </div>
}

@* Quick Onboard Modal (Simplified Workstation Onboarding) *@
@if (_showOnboardModal)
{
    <div class="modal-overlay" @onclick="CloseOnboardModal">
        <div class="modal-container" @onclick:stopPropagation style="max-width: 500px;">
            <div class="modal-header bg-primary text-white border-0">
                <h5 class="modal-title fw-bold text-white"><i class="bi bi-shield-plus me-2"></i>Quick Onboard Workstation</h5>
                <button type="button" class="btn-close btn-close-white" @onclick="CloseOnboardModal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4 text-dark">
                @if (_isApprovedInModal)
                {
                    <div class="text-center py-4">
                        <i class="bi bi-shield-check text-success" style="font-size: 4rem;"></i>
                        <h4 class="fw-bold text-success mt-3">Workstation Authorized!</h4>
                        <p class="text-muted small">The device has been successfully registered and is now active.</p>
                        <button class="btn btn-primary w-100 mt-3" @onclick="CloseOnboardModal">Done</button>
                    </div>
                }
                else if (string.IsNullOrEmpty(_generatedPairingCode))
                {
                    <div class="form-group mb-3">
                        <label class="form-label fw-bold text-dark"><i class="bi bi-display-fill me-1 text-primary"></i> Station Name</label>
                        <input type="text" class="form-control text-dark" @bind="_newStationName" placeholder="e.g. Bar POS, Office PC" />
                        <div class="form-text mt-1 text-muted small">A descriptive name to identify this workstation. Defaults to "Shared Station".</div>
                    </div>

                    <div class="mb-3 form-check form-switch bg-light p-3 rounded border border-light">
                        <input class="form-check-input ms-0 me-2" type="checkbox" role="switch" id="curateToggle" @bind="_curateToggle" />
                        <label class="form-check-label fw-bold" for="curateToggle">
                            <i class="bi bi-people-fill me-1 text-primary"></i> Curate Staff Shortcut List (Fast Login)
                        </label>
                        <div class="form-text ms-4 mt-1">Enable this to pre-select which staff members are displayed in the Fast Login grid on this device. Otherwise, standard login is used.</div>
                    </div>

                    @if (_curateToggle)
                    {
                        <div class="card p-3 border-light bg-light mb-3 animate-fade-in">
                            <label class="form-label fw-semibold small text-primary mb-2"><i class="bi bi-person-check-fill me-1"></i>Select Authorized Users for Fast Login</label>
                            <div class="border rounded p-2 bg-white mb-2" style="max-height: 180px; overflow-y: auto;">
                                @foreach (var u in _users.Where(u => u.IsActive).OrderBy(u => u.Username))
                                {
                                    <div class="form-check py-1 border-bottom border-light">
                                        <input class="form-check-input" type="checkbox" id="authUser_@u.UserId" 
                                               checked="@_selectedAuthorizedUserIds.Contains(u.UserId)"
                                               @onclick="() => ToggleAuthorizedUser(u.UserId)" />
                                        <label class="form-check-label small fw-semibold" for="authUser_@u.UserId">
                                            @u.Username
                                        </label>
                                    </div>
                                }
                            </div>
                            <div class="form-text x-small text-muted">Selected users will be shown on the fast login screen. Others must use standard manual login.</div>
                        </div>
                    }

                    <div class="d-grid mt-4">
                        <button class="btn btn-primary btn-lg" @onclick="GenerateCode">
                            <i class="bi bi-qr-code me-2"></i>Generate Onboarding Code
                        </button>
                    </div>
                }
                else
                {
                    <div class="text-center py-3">
                        <p class="text-muted mb-1">Enter this pairing code on the new device's setup screen:</p>
                        <h2 class="display-4 fw-bold text-primary my-3 tracking-wide" style="letter-spacing: 2px;">@_generatedPairingCode</h2>
                        
                        <div class="alert alert-warning border-0 small d-inline-block py-2 px-3">
                            <i class="bi bi-clock-history me-2"></i>Code expires in <strong>@FormatTime(_secondsRemaining)</strong>
                        </div>

                        @{
                            var currentPending = _pendingSessions?.FirstOrDefault(s => s.LoginMode == $"PENDING:{_generatedPairingCode}");
                        }
                        @if (currentPending != null)
                        {
                            <div class="alert alert-success border-0 small d-flex flex-column align-items-center py-3 px-3 my-3">
                                <div class="fw-bold mb-2"><i class="bi bi-check-circle-fill me-2 text-success"></i>Device Connected!</div>
                                <div class="x-small text-muted mb-3">IP: @currentPending.IpAddress | @ParseUserAgent(currentPending.UserAgent)</div>
                                <button class="btn btn-success w-100 fw-bold" @onclick="() => ApproveRequest(currentPending)">
                                    <i class="bi bi-shield-check me-2"></i>Approve & Register Device
                                </button>
                            </div>
                        }
                        else
                        {
                            <p class="text-muted x-small mt-3">
                                <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true" style="width: 12px; height: 12px; vertical-align: middle;"></span>
                                Awaiting device connection... Once the code is submitted on the device, you will see a request to approve right here.
                            </p>
                        }

                        <button class="btn btn-outline-secondary btn-sm mt-3" @onclick="ResetGeneratedCode">
                            <i class="bi bi-arrow-left me-1"></i> Generate Another Code
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>
}

@if (_showReTrustModal)
{
    <div class="modal-overlay" @onclick="CloseReTrustModal">
        <div class="modal-container" @onclick:stopPropagation style="max-width: 500px;">
            <div class="modal-header bg-primary text-white border-0">
                <h5 class="modal-title fw-bold text-white"><i class="bi bi-key-fill me-2"></i>Re-Trust Workstation</h5>
                <button type="button" class="btn-close btn-close-white" @onclick="CloseReTrustModal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4 text-center text-dark">
                <p class="text-muted mb-1">Enter this recovery code on the blocked screen of <strong class="text-dark">@_reTrustStationName</strong>:</p>
                <h2 class="display-4 fw-bold text-primary my-3 tracking-wide" style="letter-spacing: 2px;">@_reTrustCode</h2>
                <p class="text-muted x-small">This code is valid for 15 minutes. Once typed on the device, its access will be restored immediately without needing further approval.</p>
                <button class="btn btn-secondary btn-sm mt-3" @onclick="CloseReTrustModal">Close</button>
            </div>
        </div>
