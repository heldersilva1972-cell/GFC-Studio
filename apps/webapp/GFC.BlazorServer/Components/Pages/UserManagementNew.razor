@page "/users"
@attribute [Authorize]
@using GFC.BlazorServer.Services
@using GFC.Core.DTOs
@using GFC.Core.Interfaces
@using GFC.Core.Models
@using GFC.Core.Models.Security
@using Microsoft.AspNetCore.Authorization
@using GFC.BlazorServer.Auth
@inject IUserManagementService UserManagementService
@inject GFC.BlazorServer.Services.CustomAuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JS
@inject IUrlHelperService UrlHelper
@inject INotificationService NotificationService
@inject IToastService ToastService
@inject IVpnConfigurationService VpnService
@using GFC.BlazorServer.Services.Vpn
@inject IPasskeyService PasskeyService
@inject IDeviceTrustService DeviceTrustService
@inject IDeviceInviteService DeviceInviteService
@inject NavigationManager Navigation
@inject IBlazorSystemSettingsService SystemSettingsService
@implements IDisposable

<PageTitle>User Management - GFC</PageTitle>

<div class="user-management-container">
    <div class="page-header">
        <div>
            <h1 class="page-title">User Management</h1>
            <p class="page-subtitle">Manage user accounts and permissions</p>
        </div>
        <div class="d-flex gap-2">
            @if (_currentTab == "users")
            {
                <button class="btn btn-primary px-4" @onclick="OpenAddUserModal">
                    <i class="bi bi-person-plus me-2"></i>Add User
                </button>
            }
        </div>
    </div>

    @* Quick Stats *@
    <div class="stats-grid">
        <div class="stat-card">
            <div class="stat-icon bg-primary">
                <i class="bi bi-people-fill"></i>
            </div>
            <div class="stat-content">
                <div class="stat-value">@_users.Count</div>
                <div class="stat-label">Total Users</div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon bg-success">
                <i class="bi bi-check-circle-fill"></i>
            </div>
            <div class="stat-content">
                <div class="stat-value">@_users.Count(u => u.IsActive)</div>
                <div class="stat-label">Active</div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon bg-warning">
                <i class="bi bi-shield-fill-check"></i>
            </div>
            <div class="stat-content">
                <div class="stat-value">@_users.Count(u => u.IsAdmin)</div>
                <div class="stat-label">Admins</div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon bg-info">
                <i class="bi bi-person-badge"></i>
            </div>
            <div class="stat-content">
                <div class="stat-value">@_users.Count(u => u.IsDirector)</div>
                <div class="stat-label">Directors</div>
            </div>
        </div>
    </div>

    @* Main Content Tabs *@
    <div class="content-card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <div class="nav nav-pills bg-light p-1 rounded-3 gap-1" style="display: inline-flex; border: 1px solid rgba(0,0,0,0.08);">
                <button type="button" class="btn btn-sm px-4 py-2 fw-semibold rounded-3 d-flex align-items-center gap-2 border-0 @(_currentTab == "users" ? "bg-white text-primary shadow-sm" : "text-muted bg-transparent")" 
                        @onclick='() => _currentTab = "users"' style="transition: all 0.2s ease-in-out; font-size: 0.95rem;">
                    <i class="bi bi-people-fill"></i>
                    <span>Staff Accounts</span>
                </button>
                <button type="button" class="btn btn-sm px-4 py-2 fw-semibold rounded-3 d-flex align-items-center gap-2 border-0 @(_currentTab == "stations" ? "bg-white text-primary shadow-sm" : "text-muted bg-transparent")" 
                        @onclick='() => _currentTab = "stations"' style="transition: all 0.2s ease-in-out; font-size: 0.95rem;">
                    <i class="bi bi-display"></i>
                    <span>Shared Workstations</span>
                </button>
            </div>
            <div class="card-actions">
                @if (_currentTab == "users")
                {
                    <div class="search-box">
                        <i class="bi bi-search"></i>
                        <input type="text" 
                               class="form-control" 
                               placeholder="Search users..."
                               @bind="_searchQuery"
                               @bind:event="oninput" />
                    </div>
                }
                else
                {
                    <button class="btn btn-outline-primary btn-sm" @onclick="LoadData">
                        <i class="bi bi-arrow-clockwise me-1"></i>Refresh Stations
                    </button>
                }
            </div>
        </div>

        @if (_loading)
        {
            <div class="loading-state">
                <div class="spinner-border text-primary"></div>
                <p>Synchronizing data...</p>
            </div>
        }
        else if (_currentTab == "users")
        {
            @if (FilteredUsers.Any())
            {
            <div class="table-responsive">
                <table class="modern-table">
                    <thead>
                        <tr>
                            <th>User</th>
                            <th>Role</th>
                            <th>Status</th>
                            <th>Last Login</th>
                            <th>Access</th>
                            <th>Notifications</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in FilteredUsers)
                        {
                            <tr class="@(!user.IsActive ? "inactive-row" : "")">
                                <td>
                                    <div class="user-cell">
                                        <div class="user-avatar">
                                            <i class="bi bi-person-circle"></i>
                                        </div>
                                        <div class="user-info">
                                            <div class="user-name">@user.Username</div>
                                            @if (!string.IsNullOrEmpty(user.MemberName))
                                            {
                                                <div class="user-member">@user.MemberName</div>
                                            }
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    @if (user.IsAdmin)
                                    {
                                        <span class="badge badge-admin">
                                            <i class="bi bi-shield-fill-check me-1"></i>Admin
                                        </span>
                                    }
                                    else if (user.IsDirector)
                                    {
                                        <span class="badge badge-director">
                                            <i class="bi bi-person-badge me-1"></i>Director
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-user" style="background-color: #f1f5f9; color: #475569; border: 1px solid #cbd5e1;">
                                            <i class="bi bi-cup-straw me-1"></i>Bartender
                                        </span>
                                    }
                                </td>
                                <td>
                                    @if (user.IsActive)
                                    {
                                        <span class="status-badge status-active">
                                            <i class="bi bi-check-circle-fill"></i>Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status-badge status-inactive">
                                            <i class="bi bi-x-circle-fill"></i>Inactive
                                        </span>
                                    }
                                </td>
                                <td>
                                    @if (user.LastLoginDate.HasValue)
                                    {
                                        <span class="text-muted small">@user.LastLoginDate.Value.ToString("MMM d, yyyy")</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Never</span>
                                    }
                                </td>
                                <td>
                                    <button class="btn btn-sm btn-link" 
                                            @onclick="async () => await OpenPermissionsModal(user)">
                                        <i class="bi bi-key me-1"></i> Manage
                                    </button>
                                </td>
                                <td>
                                    <div class="d-flex flex-column gap-1">
                                        <button class="btn btn-sm btn-link text-info p-0 text-start" @onclick="async () => await OpenNotificationModal(user)">
                                            <i class="bi bi-bell me-1"></i>Alerts
                                        </button>
                                        <button class="btn btn-sm btn-link text-primary p-0 text-start" @onclick="async () => await OpenSendNotificationModal(user)">
                                            <i class="bi bi-send me-1"></i>Send Message
                                        </button>
                                    </div>
                                </td>
                                <td class="text-end">
                                    <div class="action-buttons">

                                        <button class="btn btn-sm btn-icon" title="Edit" @onclick="() => OpenEditUserModal(user)">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        @if (user.Username.ToLowerInvariant() != "admin" && user.UserId != _currentUserId)
                                        {
                                            <button class="btn btn-sm btn-icon" title="Delete" @onclick="async () => await ConfirmDeleteUser(user)">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        }
                                        else
                                        {
                                            <div class="btn btn-sm btn-icon disabled" style="opacity: 0.3; cursor: not-allowed;" title="Cannot delete system admin or your own account">
                                                <i class="bi bi-trash"></i>
                                            </div>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="empty-state">
                <i class="bi bi-people"></i>
                <h3>No users found</h3>
                <p>Try adjusting your search or add a new user</p>
            </div>
        }
        }
        else if (_currentTab == "stations")
        {
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h3 class="h5 mb-1"><i class="bi bi-display-fill text-primary me-2"></i>Shared Workstations</h3>
                    <p class="text-muted small mb-0">Authorized machines and browsers configured as shared workstations or POS terminals.</p>
                </div>
                <div class="d-flex gap-2">
                    <button class="btn btn-warning text-dark btn-sm fw-bold shadow-sm" @onclick="OpenQuickOnboardModal">
                        <i class="bi bi-lightning-charge-fill me-1"></i> Quick Onboard Workstation
                    </button>
                    <button class="btn btn-light btn-sm border" @onclick="async () => await RefreshWorkstations()">
                        <i class="bi bi-arrow-clockwise me-1"></i> Sync Workstations
                    </button>
                </div>
            </div>

            @if (_systemSettings != null)
            {
                <div class="card p-3 mb-4 shadow-sm border-0 bg-light rounded-3">
                    <div class="row align-items-end g-3 text-dark">
                        <div class="col-md-5">
                            <label class="form-label fw-bold mb-1 small d-flex align-items-center">
                                <i class="bi bi-hourglass-split text-primary me-2"></i>
                                Workstation Session Timeout (Minutes)
                            </label>
                            <input type="number" class="form-control form-control-sm" @bind="_systemSettings.IdleTimeoutMinutes" min="1" max="1440" />
                            <div class="text-muted x-small mt-1" style="font-size: 0.75rem;">Minutes of inactivity before logging out the active staff member.</div>
                        </div>
                        <div class="col-md-5">
                            <label class="form-label fw-bold mb-1 small d-flex align-items-center">
                                <i class="bi bi-shield-check text-primary me-2"></i>
                                Personal Device Trust Lifespan (Days)
                            </label>
                            <input type="number" class="form-control form-control-sm" @bind="_systemSettings.TrustedDeviceDurationDays" min="1" max="3650" />
                            <div class="text-muted x-small mt-1" style="font-size: 0.75rem;">Days a trusted personal device/browser remains authorized before requiring MFA re-verification.</div>
                        </div>
                        <div class="col-md-2">
                            <button type="button" class="btn btn-primary btn-sm w-100 fw-bold py-2 shadow-sm" @onclick="SaveSystemSettings" disabled="@_savingSettings">
                                @if (_savingSettings)
                                {
                                    <span class="spinner-border spinner-border-sm me-1"></span>
                                }
                                else
                                {
                                    <i class="bi bi-save me-1"></i>
                                }
                                Save Policies
                            </button>
                        </div>
                    </div>
                </div>
            }

            @if (_pendingSessions != null && _pendingSessions.Any())
            {
                <div class="mb-5 p-3 rounded-4 border border-warning animate-fade-in" style="background: rgba(240, 173, 78, 0.05); margin-bottom: 2rem;">
                    <h4 class="h6 mb-3 d-flex align-items-center text-warning fw-bold">
                        <i class="bi bi-exclamation-triangle-fill me-2 animate-pulse"></i>
                        Pending Workstation Registrations
                        <span class="badge rounded-pill bg-warning text-dark ms-2" style="font-size: 0.7rem;">@_pendingSessions.Count Awaiting Approval</span>
                    </h4>
                    <div class="row g-3">
                        @foreach (var session in _pendingSessions)
                        {
                            <div class="col-md-6 col-lg-4" @key="session.DeviceToken">
                                <div class="card h-100 border-warning shadow-sm" style="background: #fff; border-radius: 12px;">
                                    <div class="card-body d-flex flex-column justify-content-between p-3">
                                        <div>
                                            <div class="d-flex justify-content-between align-items-start mb-2">
                                                <span class="badge bg-warning text-dark">@ParseUserAgent(session.UserAgent)</span>
                                                <span class="text-muted small text-dark">IP: @session.IpAddress</span>
                                            </div>
                                            <h5 class="card-title mb-1 text-warning fw-bold">
                                                @session.StationName
                                            </h5>
                                            <p class="text-muted small mb-2 text-dark">Requested by: <strong>@session.Username</strong></p>
                                            <p class="x-small text-muted mb-3 text-truncate" title="@session.UserAgent" style="max-width: 100%;">@session.UserAgent</p>
                                        </div>
                                        <div class="d-flex gap-2 mt-2">
                                            <button class="btn btn-success btn-sm flex-fill" @onclick="() => ApproveRequest(session)">
                                                <i class="bi bi-check-circle me-1"></i> Approve
                                            </button>
                                            <button class="btn btn-outline-danger btn-sm flex-fill" @onclick="() => RejectRequest(session)">
                                                <i class="bi bi-x-circle me-1"></i> Reject
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }

            <div class="mb-5">
                @if (_sessions == null || !_sessions.Any(s => s.IsStation))
                {
                    <div class="empty-state text-center py-5">
                        <i class="bi bi-display text-muted" style="font-size: 3rem; opacity: 0.3;"></i>
                        <h3 class="mt-3 text-dark">No Shared Workstations Linked</h3>
                        <p class="text-muted mx-auto" style="max-width: 400px;">
                            Authorized machines like lobby PCs or shared tablets will appear here after they are onboarded.
                        </p>
                    </div>
                }
                else
                {
                    <div class="row g-3">
                        @foreach (var session in _sessions.Where(s => s.IsStation))
                        {
                            <div class="col-md-6 col-lg-4" @key="session.DeviceToken">
                                <div class="card h-100 border-primary shadow-sm" style="background: #fff; border-radius: 12px; border: 1px solid rgba(0, 123, 255, 0.25);">
                                    <div class="card-body p-3 text-dark">
                                        <div class="d-flex justify-content-between align-items-start mb-3">
                                            <div class="bg-primary bg-opacity-10 p-2 rounded text-primary">
                                                <i class="bi bi-pc-display-horizontal fs-4"></i>
                                            </div>
                                            <div class="d-flex gap-1">
                                                <button class="btn btn-outline-primary btn-sm" @onclick="() => ReTrustStation(session)" title="Re-trust this workstation without sending a code">
                                                    <i class="bi bi-key-fill me-1"></i> Re-Trust
                                                </button>
                                                <button class="btn btn-outline-secondary btn-sm" @onclick="() => OpenEditStationModal(session)" title="Edit workstation details / rename">
                                                    <i class="bi bi-pencil-fill"></i>
                                                </button>
                                                <button class="btn btn-outline-danger btn-sm" @onclick="() => RevokeSession(session)" title="Revoke workstation access">
                                                    <i class="bi bi-x-circle"></i>
                                                </button>
                                            </div>
                                        </div>
                                        <h5 class="card-title mb-1 text-primary fw-bold">
                                            @(!string.IsNullOrEmpty(session.StationName) ? session.StationName : "Shared Workstation")
                                        </h5>
                                        <p class="text-muted small mb-3">IP: @session.IpAddress</p>
                                        
                                        <div class="d-flex align-items-center p-2 bg-light rounded small mb-2">
                                            <i class="bi bi-person-check-fill text-muted me-2"></i>
                                            <div>
                                                <div class="text-muted">Authorized By</div>
                                                <div class="fw-bold text-dark">@session.Username</div>
                                            </div>
                                        </div>
                                        
                                        <div class="mt-2 pt-2 border-top d-flex justify-content-between x-small text-muted">
                                            <span>Last Paired: @GetTimeAgo(session.LastUsedUtc)</span>
                                            <span>Permanent Trust</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>

            <!-- PERSONAL DEVICES SECTION -->
            <div class="mt-5">
                <h4 class="h5 mb-3 d-flex align-items-center text-muted fw-bold">
                    <i class="bi bi-laptop me-2"></i>
                    Active User Sessions (Personal Devices)
                    <span class="badge rounded-pill bg-light text-dark border ms-2" style="font-size: 0.7rem;">@(_sessions?.Count(s => !s.IsStation) ?? 0) Active</span>
                </h4>
                
                @if (_sessions == null || !_sessions.Any(s => !s.IsStation))
                {
                    <div class="card border-dashed p-4 text-center bg-light">
                        <p class="text-muted mb-0">No personal devices are currently remembered.</p>
                    </div>
                }
                else
                {
                    <div class="card border-0 shadow-sm overflow-hidden">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0 text-dark">
                                <thead class="bg-light x-small text-uppercase">
                                    <tr>
                                        <th class="ps-4 text-muted">User</th>
                                        <th class="text-muted">Device</th>
                                        <th class="text-muted">Last Action</th>
                                        <th class="text-end pe-4 text-muted">Manage</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var session in _sessions.Where(s => !s.IsStation))
                                    {
                                        <tr @key="session.DeviceToken">
                                            <td class="ps-4 fw-bold text-dark">@session.Username</td>
                                            <td>
                                                <i class="bi @GetDeviceIcon(session.UserAgent) me-2 text-muted"></i>
                                                @ParseUserAgent(session.UserAgent)
                                            </td>
                                            <td class="small text-muted">@GetTimeAgo(session.LastUsedUtc)</td>
                                            <td class="text-end pe-4">
                                                <button class="btn btn-outline-danger btn-sm" @onclick="() => RevokeSession(session)" title="Logout this user on this device">
                                                    <i class="bi bi-box-arrow-right"></i>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

@* Add/Edit User Modal *@
@if (_showUserModal)
{
    <div class="modal-overlay" @onclick="CloseUserModal">
        <div class="modal-container" @onclick:stopPropagation>
            <div class="modal-header">
                <h2 class="modal-title">@(_editingUser == null ? "Add New User" : "Edit User")</h2>
                <button class="btn-close" @onclick="CloseUserModal">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label class="form-label">Username <span class="text-danger">*</span></label>
                    <input type="text" class="form-control" @bind="_userForm.Username" placeholder="Enter username" disabled="@IsEditingAdmin" />
                    @if (IsEditingAdmin)
                    {
                        <small class="text-muted d-block mt-1">The primary system admin name cannot be changed.</small>
                    }
                </div>

                @if (!IsEditingAdmin)
                {
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="form-label text-primary fw-bold">Directors</label>
                                <select class="form-select border-primary border-opacity-25" @bind="_userForm.MemberId" @bind:after="OnMemberSelected">
                                    <option value="">-- Select Director --</option>
                                    @foreach (var member in _availableDirectors.Where(m => !IsMemberTaken(m.MemberId)))
                                    {
                                        <option value="@member.MemberId">@member.DisplayName</option>
                                    }
                                </select>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="form-label fw-bold">Active Members</label>
                                <select class="form-select" @bind="_userForm.MemberId" @bind:after="OnMemberSelected">
                                    <option value="">-- Select Active Member --</option>
                                    @foreach (var member in _availableMembers.Where(m => !IsMemberTaken(m.MemberId)))
                                    {
                                        <option value="@member.MemberId">@member.DisplayName</option>
                                    }
                                </select>
                            </div>
                        </div>
                    </div>
                    @if (_editingUser == null)
                    {
                        <div class="text-center mt-n2 mb-3">
                            <small class="form-text text-muted">Username will be auto-generated from member name</small>
                        </div>
                    }
                }

                <div class="form-group">
                    <label class="form-label">@(_editingUser == null ? "Initial Passcode" : "Update Passcode")</label>
                    <div class="position-relative">
                        <input type="@(_showAdminPasscode ? "text" : "password")" class="form-control pe-5" @bind="_userForm.Password" 
                               placeholder="Enter 6-digit passcode" maxlength="6" />
                        <button type="button" 
                                class="btn btn-link position-absolute end-0 top-50 translate-middle-y text-muted px-3" 
                                style="z-index: 10; border: none; text-decoration: none;"
                                @onclick="() => _showAdminPasscode = !_showAdminPasscode"
                                tabindex="-1">
                            <i class="bi @(_showAdminPasscode ? "bi-eye-slash" : "bi-eye")"></i>
                        </button>
                    </div>
                    <small class="text-muted">@(_editingUser == null ? "Enter a 6-digit numeric passcode for fast login." : "Leave blank to keep current passcode. Must be exactly 6 digits.")</small>
                </div>

                <div class="form-group">
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" @bind="_userForm.IsAdmin" id="isAdminCheck" disabled="@IsEditingAdmin" />
                        <label class="form-check-label" for="isAdminCheck">
                            <i class="bi bi-shield-fill-check me-1"></i>Administrator
                        </label>
                    </div>
                    <small class="form-text">@((IsEditingAdmin) ? "The primary admin must remain an administrator." : "Admins have access to all pages and settings")</small>
                </div>

                <div class="form-group">
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" @bind="_userForm.IsActive" id="isActiveCheck" disabled="@IsEditingAdmin" />
                        <label class="form-check-label" for="isActiveCheck">
                            <i class="bi bi-check-circle me-1"></i>Active
                        </label>
                    </div>
                    @if (IsEditingAdmin)
                    {
                        <small class="form-text">The primary admin account cannot be deactivated.</small>
                    }
                </div>

                <div class="form-group">
                    <label class="form-label">Notes</label>
                    <textarea class="form-control" @bind="_userForm.Notes" rows="3" placeholder="Optional notes about this user"></textarea>
                </div>

                @if (!string.IsNullOrEmpty(_userModalError))
                {
                    <div class="alert alert-danger">
                        <i class="bi bi-exclamation-triangle me-2"></i>@_userModalError
                    </div>
                }
            </div>
            <div class="modal-footer">
                <button class="btn btn-outline-secondary" @onclick="CloseUserModal">Cancel</button>
                <button class="btn btn-primary" @onclick="SaveUser" disabled="@_savingUser">
                    @if (_savingUser)
                    {
                        <span class="spinner-border spinner-border-sm me-2"></span>
                    }
                    <i class="bi bi-check-lg me-1"></i>@(_editingUser == null ? "Create User" : "Save Changes")
                </button>
            </div>
        </div>
    </div>
}

@* Permissions Modal *@
@if (_showPermissionsModal && _selectedUser != null)
{
    @* Use the standalone modal component *@
    <UserPagePermissionsModal 
        UserId="@_selectedUser.UserId"
        Username="@_selectedUser.Username"
        IsAdmin="@_selectedUser.IsAdmin"
        IsDirector="@_selectedUser.IsDirector"
        OnClose="ClosePermissionsModal"
        OnSaved="ClosePermissionsModal" />
}

@* Default Permissions Modal *@
@if (_showDefaultPermissionsModal)
{
    <div class="modal-overlay" @onclick="CloseDefaultPermissionsModal">
        <div class="modal-container modal-lg" @onclick:stopPropagation>
            <div class="modal-header">
                <div>
                    <h2 class="modal-title">Default Permissions Configuration</h2>
                    <p class="modal-subtitle">Set which permissions are automatically granted to new users</p>
                </div>
                <button class="btn-close" @onclick="CloseDefaultPermissionsModal">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
            <div class="modal-body">
                <div class="alert alert-info">
                    <i class="bi bi-info-circle me-2"></i>
                    <strong>Note:</strong> These permissions will be automatically granted to all newly created non-admin users. 
                    Admin users always have access to all pages.
                </div>

                <div class="permissions-grid">
                    @foreach (var category in _pagesByCategory)
                    {
                        <div class="permission-category">
                            <h4 class="category-title">
                                <i class="bi bi-folder2-open me-2"></i>@category.Key
                            </h4>
                            <div class="permission-list">
                                @foreach (var page in category.Value)
                                {
                                    <div class="permission-item @(page.RequiresAdmin ? "admin-page-item" : "")">
                                        <div class="form-check">
                                            <input class="form-check-input" 
                                                   type="checkbox" 
                                                   id="default-page-@(page.PageId)"
                                                   checked="@_defaultPermissions.Contains(page.PageId)"
                                                   @onchange="@(e => ToggleDefaultPermission(page.PageId, (bool)e.Value))" />
                                            
                                            <label class="form-check-label" for="default-page-@(page.PageId)">
                                                <div class="d-flex align-items-center">
                                                    <strong>@GetCleanPageName(page)</strong>
                                                    @if (page.RequiresAdmin)
                                                    {
                                                        <span class="badge bg-light text-dark ms-2 border" style="font-size: 0.65rem; opacity: 0.8;">
                                                            <i class="bi bi-shield-lock me-1"></i>ADMIN
                                                        </span>
                                                    }
                                                </div>
                                                @if (!string.IsNullOrEmpty(page.Description))
                                                {
                                                    <small class="text-muted d-block mt-1">@(page.Description)</small>
                                                }
                                            </label>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-outline-secondary" @onclick="CloseDefaultPermissionsModal">Cancel</button>
                <button class="btn btn-primary" @onclick="SaveDefaultPermissions" disabled="@_savingDefaultPermissions">
                    @if (_savingDefaultPermissions)
                    {
                        <span class="spinner-border spinner-border-sm me-2"></span>
                    }
                    <i class="bi bi-check-lg me-1"></i>Save Default Access
                </button>
            </div>
        </div>
    </div>
}




