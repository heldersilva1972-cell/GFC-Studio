@page "/lottery/imported-reports"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using GFC.BlazorServer.Data
@using GFC.Core.Models
@using GFC.Core.Interfaces
@using System.IO
@using System.Globalization
@using System.Text.RegularExpressions
@inject IDbContextFactory<GfcDbContext> DbFactory
@inject GFC.Core.Interfaces.IPagePermissionRepository PageRepo
@inject GFC.Core.Interfaces.IUserManagementService UserService
@inject GFC.BlazorServer.Services.CustomAuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject ILogger<ImportedReports> Logger
@inject GFC.BlazorServer.Services.LotteryEmailService EmailService
@attribute [Authorize]

<PageTitle>Lottery Imported Reports | GFC</PageTitle>

<style>
    .imported-reports-container {
        padding: 1.5rem;
        background: #f8fafc;
        flex: 1;
        overflow-y: auto;
        max-height: calc(100vh - 200px);
        font-family: 'Outfit', 'Inter', sans-serif;
    }

    .premium-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 16px;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -1px rgba(0, 0, 0, 0.02);
        padding: 2rem;
        margin-bottom: 1.5rem;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .premium-card:hover {
        box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.08), 0 4px 6px -2px rgba(0, 0, 0, 0.03);
    }

    .header-panel {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 1rem;
        border-bottom: 2px solid #f1f5f9;
        padding-bottom: 1.5rem;
        margin-bottom: 2rem;
    }

    .header-title-section h1 {
        font-size: 1.75rem;
        font-weight: 800;
        color: #1e293b;
        margin: 0 0 0.25rem 0;
        background: linear-gradient(135deg, #1e293b, #3b82f6);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .header-title-section p {
        color: #64748b;
        margin: 0;
        font-size: 0.95rem;
    }

    .history-controls {
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .form-select-custom {
        padding: 0.5rem 2rem 0.5rem 1rem;
        font-size: 0.9rem;
        font-weight: 600;
        color: #334155;
        background-color: #fff;
        border: 1px solid #cbd5e1;
        border-radius: 10px;
        box-shadow: 0 1px 2px rgba(0,0,0,0.05);
        cursor: pointer;
        transition: border-color 0.2s;
    }

    .form-select-custom:focus {
        border-color: #3b82f6;
        outline: none;
    }

    .grid-2-col {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1.5rem;
        margin-bottom: 1.5rem;
    }

    @@media (max-width: 992px) {
        .grid-2-col {
            grid-template-columns: 1fr;
        }
    }

    .upload-zone {
        border: 2px dashed #cbd5e1;
        border-radius: 12px;
        padding: 2.5rem 1.5rem;
        text-align: center;
        background: #f8fafc;
        cursor: pointer;
        transition: all 0.2s ease-in-out;
        position: relative;
    }

    .upload-zone:hover {
        border-color: #3b82f6;
        background: #f0f7ff;
    }

    .upload-icon {
        font-size: 2.5rem;
        color: #94a3b8;
        margin-bottom: 0.75rem;
        transition: color 0.2s;
    }

    .upload-zone:hover .upload-icon {
        color: #3b82f6;
    }

    .upload-label {
        font-weight: 700;
        color: #334155;
        margin-bottom: 0.25rem;
    }

    .upload-hint {
        font-size: 0.8rem;
        color: #64748b;
    }

    .hidden-input {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        opacity: 0;
        cursor: pointer;
    }

    .file-list {
        margin-top: 1rem;
        list-style: none;
        padding: 0;
    }

    .file-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: #f1f5f9;
        padding: 0.5rem 0.75rem;
        border-radius: 8px;
        margin-bottom: 0.5rem;
        font-size: 0.85rem;
        font-weight: 500;
        color: #334155;
    }

    .file-remove-btn {
        background: none;
        border: none;
        color: #ef4444;
        cursor: pointer;
        padding: 2px;
        font-size: 1rem;
    }

    .comparison-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1.25rem;
        margin-bottom: 0.75rem;
    }

    @@media (max-width: 992px) {
        .comparison-grid {
            grid-template-columns: 1fr;
        }
    }

    .comparison-section-header {
        font-size: 0.95rem;
        font-weight: 800;
        color: #0f172a;
        margin: 0.5rem 0 0.25rem 0;
        padding-bottom: 0.25rem;
        border-bottom: 2px solid #e2e8f0;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .comparison-table {
        width: 100%;
        border-collapse: collapse;
        margin-bottom: 0.75rem;
    }

    .comparison-table th {
        background: #f8fafc;
        color: #475569;
        font-weight: 700;
        font-size: 0.8rem;
        text-transform: uppercase;
        padding: 0.4rem 0.6rem;
        text-align: left;
        border-bottom: 2px solid #e2e8f0;
    }

    .comparison-table td {
        padding: 0.4rem 0.6rem;
        font-size: 0.825rem;
        color: #334155;
        border-bottom: 1px solid #e2e8f0;
    }

    .comparison-table tr:hover {
        background-color: #f8fafc;
    }

    .badge-match {
        background: #d1fae5;
        color: #065f46;
        padding: 0.25rem 0.6rem;
        border-radius: 9999px;
        font-size: 0.75rem;
        font-weight: 700;
        display: inline-flex;
        align-items: center;
        gap: 0.25rem;
    }

    .badge-mismatch {
        background: #fee2e2;
        color: #991b1b;
        padding: 0.25rem 0.6rem;
        border-radius: 9999px;
        font-size: 0.75rem;
        font-weight: 700;
        display: inline-flex;
        align-items: center;
        gap: 0.25rem;
    }

    .btn-action-primary {
        background: linear-gradient(135deg, #2563eb, #1d4ed8);
        color: white;
        border: none;
        border-radius: 10px;
        padding: 0.6rem 1.5rem;
        font-weight: 700;
        cursor: pointer;
        box-shadow: 0 4px 6px -1px rgba(37, 99, 235, 0.2);
        transition: all 0.2s;
    }

    .btn-action-primary:hover:not(:disabled) {
        transform: translateY(-1px);
        box-shadow: 0 10px 15px -3px rgba(37, 99, 235, 0.3);
    }

    .btn-action-primary:disabled {
        background: #cbd5e1;
        box-shadow: none;
        cursor: not-allowed;
    }

    .btn-action-secondary {
        background: white;
        color: #475569;
        border: 1px solid #cbd5e1;
        border-radius: 10px;
        padding: 0.6rem 1.5rem;
        font-weight: 700;
        cursor: pointer;
        transition: all 0.2s;
    }

    .btn-action-secondary:hover {
        background: #f8fafc;
        border-color: #94a3b8;
    }

    .meta-box {
        background: #f0f7ff;
        border: 1px solid #bfdbfe;
        border-radius: 10px;
        padding: 0.75rem 1rem;
        font-size: 0.85rem;
        color: #1e40af;
        margin-bottom: 1rem;
    }

    .sticky-col {
        position: sticky;
        left: 0;
        background-color: #ffffff !important;
        border-right: 2px solid #cbd5e1;
        z-index: 2;
        box-shadow: 2px 0 5px -2px rgba(0, 0, 0, 0.1);
    }

    th.sticky-col {
        background-color: #f8fafc !important;
        z-index: 3;
    }

    .sync-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        background: rgba(15, 23, 42, 0.6);
        backdrop-filter: blur(8px);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 9999;
    }

    .sync-status-card {
        background: #ffffff;
        border: 1px solid rgba(226, 232, 240, 0.8);
        border-radius: 20px;
        box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
        padding: 2.5rem;
        width: 100%;
        max-width: 450px;
        display: flex;
        flex-direction: column;
        align-items: center;
        animation: scaleIn 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    @@keyframes scaleIn {
        0% { transform: scale(0.9); opacity: 0; }
        100% { transform: scale(1); opacity: 1; }
    }
</style>

<div class="imported-reports-container">
    @if (_isFetchingEmail || _syncCompleted)
    {
        <div class="sync-overlay">
            <div class="sync-status-card" style="max-width: 500px; width: 90%;">
                @if (_isFetchingEmail)
                {
                    <div class="spinner-border text-primary mb-3" role="status" style="width: 2.5rem; height: 2.5rem;">
                        <span class="visually-hidden">Syncing...</span>
                    </div>
                    <h4 class="fw-bold mb-2 text-slate-800">Syncing with Gmail</h4>
                    <p class="text-muted text-center px-2 mb-2" style="font-size: 0.9rem; min-height: 40px;">@_syncStatusMessage</p>
                    
                    <button class="btn btn-sm btn-link text-decoration-none mb-3 p-0" style="font-size: 0.8rem;" @onclick="() => _showDetailedLogs = !_showDetailedLogs">
                        @(_showDetailedLogs ? "Hide Live Log Details" : "Show Live Log Details")
                    </button>

                    @if (_showDetailedLogs && _syncLogs.Any())
                    {
                        <div class="border rounded bg-light p-2 mb-3 text-start w-100" style="max-height: 120px; overflow-y: auto; font-family: monospace; font-size: 0.72rem; line-height: 1.4;">
                            @foreach (var log in _syncLogs)
                            {
                                <div style="border-bottom: 1px solid #e2e8f0; padding: 2px 0; color: #475569;">• @log</div>
                            }
                        </div>
                    }

                    <button class="btn btn-outline-danger btn-sm px-4" style="border-radius: 8px;" @onclick="CancelSync">
                        <i class="bi bi-x-circle me-1"></i> Cancel Sync
                    </button>
                }
                else if (_syncCompleted)
                {
                    @if (string.IsNullOrEmpty(_errorMessage))
                    {
                        <i class="bi bi-check-circle-fill text-success fs-1 mb-2"></i>
                        <h4 class="fw-bold mb-2 text-slate-800">Sync Completed</h4>
                        <div class="alert alert-success small text-center w-100 mb-3">@_successMessage</div>
                    }
                    else
                    {
                        <i class="bi bi-exclamation-triangle-fill text-danger fs-1 mb-2"></i>
                        <h4 class="fw-bold mb-2 text-slate-800">Sync Finished</h4>
                        <div class="alert alert-danger small text-center w-100 mb-3">@_errorMessage</div>
                    }

                    <div class="d-flex justify-content-between align-items-center w-100 mb-2">
                        <h5 class="fw-bold mb-0" style="font-size: 0.85rem; color: #475569;">Detailed Sync Logs:</h5>
                        <button class="btn btn-sm btn-link text-decoration-none p-0" style="font-size: 0.8rem;" @onclick="() => _showDetailedLogs = !_showDetailedLogs">
                            @(_showDetailedLogs ? "Hide Logs" : "Show Logs")
                        </button>
                    </div>
                    
                    @if (_showDetailedLogs)
                    {
                        <div class="border rounded bg-light p-2 mb-3 text-start w-100" style="max-height: 150px; overflow-y: auto; font-family: monospace; font-size: 0.72rem; line-height: 1.4;">
                            @foreach (var log in _syncLogs)
                            {
                                <div style="border-bottom: 1px solid #e2e8f0; padding: 2px 0; color: #475569;">• @log</div>
                            }
                        </div>
                    }

                    <button class="btn btn-primary btn-sm px-4 w-100" style="border-radius: 8px; font-weight: 600;" @onclick="CloseSyncModal">
                        Close Log View
                    </button>
                }
            </div>
        </div>
    }
    @if (!_hasAccessChecked)
    {
        <div class="d-flex justify-content-center p-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Checking access...</span>
            </div>
        </div>
    }
    else
    {
        <!-- COMPACT TOP CONTROL BAR -->
        <div class="d-flex justify-content-end align-items-center gap-2 mb-3 flex-wrap">
            @if (!string.IsNullOrEmpty(_successMessage))
            {
                <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1.5 extra-small d-inline-flex align-items-center shadow-sm" style="max-width: 450px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" title="@_successMessage">
                    <i class="bi bi-check-circle-fill me-1 flex-shrink-0"></i> 
                    <span class="text-truncate">@_successMessage</span>
                    <button type="button" class="btn p-0 ms-2 border-0 text-success" style="line-height: 1;" @onclick='() => _successMessage = string.Empty'><i class="bi bi-x-circle-fill"></i></button>
                </span>
            }
            @if (_emailSettings.AutoSyncEnabled && !string.IsNullOrEmpty(_emailSettings.LastSyncStatus))
            {
                <span class="badge @(_emailSettings.LastSyncStatus.StartsWith("Error") ? "bg-danger-subtle text-danger border border-danger-subtle" : "bg-success-subtle text-success border border-success-subtle") rounded-pill px-3 py-1.5 extra-small" title="Last background check status">
                    <i class="bi @(_emailSettings.LastSyncStatus.StartsWith("Error") ? "bi-exclamation-triangle-fill" : "bi-check-circle-fill") me-1"></i> @_emailSettings.LastSyncStatus
                </span>
            }
            <button class="btn btn-primary btn-sm rounded-pill px-3 py-1.5 fw-bold shadow-sm" @onclick="FetchEmails" disabled="@_isFetchingEmail">
                @if (_isFetchingEmail)
                {
                    <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                    <span>Syncing...</span>
                }
                else
                {
                    <i class="bi bi-envelope-check me-1"></i><span>Sync Gmail Inbox</span>
                }
            </button>
            <button class="btn btn-outline-secondary btn-sm rounded-pill px-3 py-1.5 fw-bold shadow-sm" @onclick="ToggleSettings">
                <i class="bi bi-gear-fill me-1 text-primary"></i> Gmail Settings
            </button>
            @if (_isHistoricalView || _hasDataLoaded)
            {
                <button class="btn btn-outline-secondary btn-sm rounded-pill px-3 py-1.5 fw-bold shadow-sm" @onclick="GoBackToDashboard"><i class="bi bi-arrow-left me-1"></i> Back to Dashboard</button>
            }
        </div>

        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <div class="alert alert-danger border-0 shadow-sm mb-4 d-flex align-items-center">
                <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>
                <div>@_errorMessage</div>
            </div>
        }

        <!-- EMAIL CONFIGURATION SETTINGS MODAL -->
        @if (_showSettings)
        {
            <div class="modal fade show d-block" style="background: rgba(15, 23, 42, 0.6); backdrop-filter: blur(4px); z-index: 1055;" tabindex="-1">
                <div class="modal-dialog modal-lg modal-dialog-centered">
                    <div class="modal-content shadow-lg border-0 rounded-4">
                        <div class="modal-header bg-light border-bottom px-4 py-3">
                            <h5 class="modal-title fw-black text-slate-800" style="font-size: 1.1rem;">
                                <i class="bi bi-envelope-fill text-primary me-2"></i>Gmail Auto-Fetch Settings
                            </h5>
                            <button type="button" class="btn-close" @onclick="ToggleSettings" aria-label="Close"></button>
                        </div>
                        <div class="modal-body p-4">
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label fw-bold text-slate-700 font-size-sm">Gmail Address</label>
                                    <input type="email" class="form-control" placeholder="your-email@gmail.com" @bind="_emailSettings.EmailAddress" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-bold text-slate-700 font-size-sm">Google App Password</label>
                                    <input type="password" class="form-control" placeholder="16-character app code" @bind="_emailSettings.AppPassword" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-bold text-slate-700 font-size-sm">Sender Filter Address</label>
                                    <input type="text" class="form-control" placeholder="reports@lottery.com" @bind="_emailSettings.SenderAddress" />
                                    <div class="text-muted small mt-1">Only fetch messages from this email address.</div>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-bold text-slate-700 font-size-sm">Subject Keyword Filter</label>
                                    <input type="text" class="form-control" placeholder="e.g. Weekly Report" @bind="_emailSettings.SubjectKeyword" />
                                    <div class="text-muted small mt-1">Only fetch messages containing this word in the subject.</div>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-bold text-slate-700 font-size-sm">Gmail Daily Folder / Label Path</label>
                                    <input type="text" class="form-control" placeholder="INBOX" @bind="_emailSettings.DailyGmailLabel" />
                                    <div class="text-muted small mt-1">Enter "INBOX" or a custom Gmail label for Daily logs.</div>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-bold text-slate-700 font-size-sm">Gmail Weekly Folder / Label Path</label>
                                    <input type="text" class="form-control" placeholder="INBOX" @bind="_emailSettings.WeeklyGmailLabel" />
                                    <div class="text-muted small mt-1">Enter "INBOX" or a custom Gmail label for Weekly invoices.</div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-check mt-3">
                                        <input class="form-check-input" type="checkbox" id="autoSyncCheck" @bind="_emailSettings.AutoSyncEnabled" />
                                        <label class="form-check-label fw-bold text-slate-700 font-size-sm" for="autoSyncCheck">
                                            Enable Background Auto-Sync
                                        </label>
                                        <div class="text-muted small">Periodically downloads reports in the background.</div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-check mt-3">
                                        <input class="form-check-input" type="checkbox" id="autoCommitCheck" @bind="_emailSettings.AutoCommitEnabled" />
                                        <label class="form-check-label fw-bold text-slate-700 font-size-sm" for="autoCommitCheck">
                                            Auto-Commit / Direct Import (Skip Review & Process)
                                        </label>
                                        <div class="text-muted small">Automatically saves synced reports directly to database without requiring manual review.</div>
                                    </div>
                                </div>
                                <div class="col-md-12">
                                    <label class="form-label fw-bold text-slate-700 font-size-sm">Check Frequency</label>
                                    <select class="form-select" @bind="_emailSettings.SyncIntervalHours">
                                        <option value="1">Every Hour</option>
                                        <option value="6">Every 6 Hours</option>
                                        <option value="12">Every 12 Hours</option>
                                        <option value="24">Every 24 Hours (Daily)</option>
                                    </select>
                                    @if (_emailSettings.LastSyncTime.HasValue)
                                    {
                                        <div class="p-2.5 mt-2 rounded-3 border @(_emailSettings.LastSyncStatus?.StartsWith("Error") == true ? "bg-danger-subtle border-danger-subtle text-danger" : "bg-light border-slate-200 text-slate-700") small">
                                            <div><i class="bi bi-clock-history me-1"></i> Last Background Check: <strong>@_emailSettings.LastSyncTime.Value.ToString("g")</strong></div>
                                            @if (!string.IsNullOrEmpty(_emailSettings.LastSyncStatus))
                                            {
                                                <div class="mt-1 fw-semibold"><i class="bi @(_emailSettings.LastSyncStatus.StartsWith("Error") ? "bi-exclamation-circle-fill text-danger" : "bi-check-circle-fill text-success") me-1"></i> @_emailSettings.LastSyncStatus</div>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                        <div class="modal-footer bg-light border-top px-4 py-3">
                            <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill px-4" @onclick="ToggleSettings">Cancel</button>
                            <button type="button" class="btn btn-primary btn-sm rounded-pill px-4 shadow-sm" @onclick="SaveEmailSettings">
                                <i class="bi bi-save me-1"></i> Save Settings
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }

        <!-- DELETE CONFIRMATION MODAL -->
        @if (_recordToDelete != null)
        {
            <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(15, 23, 42, 0.6); backdrop-filter: blur(4px); z-index: 1060;">
                <div class="modal-dialog modal-dialog-centered" style="max-width: 480px;">
                    <div class="modal-content border-0 shadow-lg" style="border-radius: 16px; overflow: hidden;">
                        <div class="modal-header bg-danger text-white px-4 py-3 border-0">
                            <h5 class="modal-title fw-bold">
                                <i class="bi bi-exclamation-triangle-fill me-2"></i>Confirm Report Deletion
                            </h5>
                            <button type="button" class="btn-close btn-close-white" @onclick="CancelDeleteRecord"></button>
                        </div>
                        <div class="modal-body p-4 text-slate-700">
                            <p class="mb-3">Are you sure you want to permanently delete this imported weekly lottery statement?</p>
                            <div class="p-3 bg-light border rounded-3 mb-3">
                                <div class="small text-muted fw-semibold">Report Details:</div>
                                <div class="fw-bold text-dark mt-1">Week Ending: <span class="text-primary">@_recordToDelete.WeekEndingDate.ToString("MM/dd/yyyy")</span></div>
                                <div class="fw-bold text-dark mt-1">Total Statement Due: <span class="text-success">@_recordToDelete.TotalDue.ToString("C2")</span></div>
                            </div>
                            <div class="text-danger small fw-bold"><i class="bi bi-info-circle me-1"></i> This action cannot be undone.</div>
                        </div>
                        <div class="modal-footer bg-light border-top px-4 py-3">
                            <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill px-4" @onclick="CancelDeleteRecord">Cancel</button>
                            <button type="button" class="btn btn-danger btn-sm rounded-pill px-4 shadow-sm fw-bold" @onclick="ExecuteDeleteWeekRecord">
                                <i class="bi bi-trash-fill me-1"></i> Delete Statement
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }



        @if (!_isHistoricalView && !_hasDataLoaded && _weekGroups.Any())
        {
            <!-- PENDING WEEKLY BATCHES WORKSPACE (Only shown when pending batches exist) -->
            <div class="premium-card mb-4">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
                    <h2 class="fw-bold mb-0 text-slate-800" style="font-size: 1.2rem;">
                        <i class="bi bi-inbox text-primary me-2"></i>Pending Weekly Batches (@_weekGroups.Count)
                    </h2>
                    @if (_allDailyStaged.Any() || _allWeeklyStaged.Any())
                    {
                        <button class="btn btn-outline-danger btn-sm px-3 rounded-pill" @onclick="ResetPage">
                            Discard All Staged
                        </button>
                    }
                </div>

                <div class="d-flex flex-column gap-3">
                    @foreach (var group in _weekGroups)
                    {
                        var hasStatement = group.MatchingWeeklyFile != null;
                        var expectedDays = 7;
                        var loadedDays = group.DailyFiles.Count;
                        
                        <div class="card shadow-sm border border-slate-200 rounded-3 overflow-hidden" style="border-left: 4px solid @(hasStatement && loadedDays == expectedDays ? "#10b981" : "#3b82f6") !important;">
                            <div class="card-body p-3">
                                <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                                    <div>
                                        <h4 class="fw-bold mb-1 text-slate-800" style="font-size: 1.05rem;">
                                            Week Ending: @group.WeekEndingDate.ToString("MM/dd/yyyy") (Saturday)
                                        </h4>
                                        <p class="text-muted small mb-0">
                                            Period: @group.WeekStartDate.ToString("MM/dd/yyyy") to @group.WeekEndingDate.ToString("MM/dd/yyyy")
                                        </p>
                                    </div>

                                    <div class="d-flex align-items-center gap-2 flex-wrap">
                                        <div class="text-center px-3 py-1 bg-light rounded border" style="min-width: 100px;">
                                            <span class="small text-muted d-block" style="font-size: 0.7rem; font-weight: 600;">Daily Logs</span>
                                            <strong class="@(loadedDays == expectedDays ? "text-success" : "text-warning")" style="font-size: 0.9rem;">
                                                @loadedDays of @expectedDays Days
                                            </strong>
                                        </div>

                                        <div class="text-center px-3 py-1 bg-light rounded border" style="min-width: 130px;">
                                            <span class="small text-muted d-block" style="font-size: 0.7rem; font-weight: 600;">Weekly Statement</span>
                                            @if (hasStatement)
                                            {
                                                <strong class="text-success" style="font-size: 0.9rem;"><i class="bi bi-file-earmark-check-fill me-1"></i>Matched</strong>
                                            }
                                            else
                                            {
                                                <strong class="text-muted" style="font-size: 0.9rem;">Daily-Only Mode</strong>
                                            }
                                        </div>

                                        <button class="btn btn-primary btn-sm px-3 py-2 ms-2" style="border-radius: 8px; font-weight: 600;" @onclick="() => SelectGroupForProcessing(group)">
                                            <i class="bi bi-layout-split me-1"></i> Review & Process
                                        </button>
                                    </div>
                                </div>

                                <hr class="my-2 text-slate-200" />
                                <div class="d-flex flex-wrap gap-2 align-items-center">
                                    <span class="small text-muted fw-bold me-1" style="font-size: 0.75rem;">Dates Staged:</span>
                                    @for (int i = -6; i <= 0; i++)
                                    {
                                        var date = group.WeekEndingDate.AddDays(i);
                                        var isLoaded = group.DailyFiles.Any(f => f.ParsedDate.HasValue && f.ParsedDate.Value.Date == date.Date);
                                        <span class="badge @(isLoaded ? "bg-success-subtle text-success border border-success-subtle" : "bg-danger-subtle text-danger border border-danger-subtle") rounded-pill px-2 py-1" style="font-size: 0.75rem; font-weight: 600; text-transform: uppercase;">
                                            @date.ToString("ddd MM/dd")
                                        </span>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
        else if (_isHistoricalView || _hasDataLoaded)
        {
            <!-- COMPARISON VIEW -->
            <div class="premium-card">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h2 class="fw-bold text-slate-800 m-0">
                        @if (_isHistoricalView)
                        {
                            <span><i class="bi bi-clock-history text-secondary me-2"></i>Historical Report: Week Ending @_historicalWeekEndingDate?.ToString("MM/dd/yyyy")</span>
                        }
                        else
                        {
                            <span><i class="bi bi-check2-all text-success me-2"></i>Comparison Matrix</span>
                        }
                    </h2>
                    @if (_isHistoricalView)
                    {
                        <div class="text-muted small">Imported by: <strong>@_selectedReportAuthor</strong> on @_selectedReportCreatedDate?.ToString("g")</div>
                    }
                </div>

                @if (!_isHistoricalView)
                {
                    <div class="mb-4 d-flex align-items-center gap-2 flex-wrap bg-light p-2 rounded-3 border" style="border-color: #e2e8f0 !important;">
                        <span class="fw-bold text-slate-700 small" style="font-size: 0.8rem;"><i class="bi bi-sliders text-primary me-1"></i>Display View Mode:</span>
                        <div class="btn-group" role="group" aria-label="Display View Mode">
                            <button type="button" class="btn btn-xs @(_displayMode == ComparisonDisplayMode.Compare ? "btn-primary text-white" : "btn-outline-primary")" style="font-size: 0.75rem; padding: 4px 10px; border-radius: 6px 0 0 6px;" @onclick="() => SetDisplayMode(ComparisonDisplayMode.Compare)" disabled="@(!HasBothData)">
                                <i class="bi bi-arrow-left-right me-1"></i>Sync & Compare
                            </button>
                            <button type="button" class="btn btn-xs @(_displayMode == ComparisonDisplayMode.WeeklyOnly ? "btn-primary text-white" : "btn-outline-primary")" style="font-size: 0.75rem; padding: 4px 10px;" @onclick="() => SetDisplayMode(ComparisonDisplayMode.WeeklyOnly)" disabled="@(!HasWeeklyData)">
                                <i class="bi bi-file-earmark-text me-1"></i>Weekly Statement Only
                            </button>
                            <button type="button" class="btn btn-xs @(_displayMode == ComparisonDisplayMode.DailyOnly ? "btn-primary text-white" : "btn-outline-primary")" style="font-size: 0.75rem; padding: 4px 10px; border-radius: 0 6px 6px 0;" @onclick="() => SetDisplayMode(ComparisonDisplayMode.DailyOnly)" disabled="@(!HasDailyData)">
                                <i class="bi bi-file-earmark-spreadsheet me-1"></i>Daily Shift Logs Only
                            </button>
                        </div>
                    </div>
                }

                @if (_isHistoricalView)
                {
                    <div class="alert alert-info border-0 shadow-sm mb-4">
                        <i class="bi bi-info-circle-fill me-2"></i>You are viewing saved historical data. Daily sums were committed on this date.
                    </div>
                }
                else
                {
                    <div class="alert alert-light border shadow-sm mb-4" style="background-color: #f8fafc; border-color: #e2e8f0 !important; border-radius: 12px;">
                        <div class="row">
                            @if (_displayMode == ComparisonDisplayMode.DailyOnly)
                            {
                                <div class="col-md-6 border-md-end">
                                    <div class="fw-bold text-slate-700 mb-1"><i class="bi bi-calendar3 text-primary me-1"></i>Daily Shift Reports Summary (Sunday to Saturday Week)</div>
                                    <div class="text-muted small">Week Ending Saturday: <strong class="text-primary">@_weeklyMeta?.WeekEndingDate?.ToString("MM/dd/yyyy")</strong></div>
                                </div>
                                <div class="col-md-6 ps-md-4 mt-3 mt-md-0">
                                    <div class="fw-bold text-slate-700 mb-2"><i class="bi bi-files text-primary me-1"></i>Uploaded Daily Files (@_dailyFiles.Count) <span class="text-muted" style="font-size: 0.75rem; font-weight: normal;">(click x to exclude a day)</span></div>
                                    <div class="d-flex flex-wrap gap-2">
                                        @foreach (var file in _dailyFiles)
                                        {
                                            <span class="badge bg-white text-dark border d-flex align-items-center gap-2 p-2 shadow-sm" style="font-size: 0.8rem; border-radius: 6px; border-color: #e2e8f0 !important;">
                                                <i class="bi bi-file-earmark-spreadsheet text-success"></i>
                                                <strong>@(file.ParsedDate?.ToString("MM/dd") ?? "??")</strong>
                                                <button type="button" class="btn p-0 border-0 text-danger" style="line-height: 1;" @onclick="() => RemoveDailyFile(file)"><i class="bi bi-x-circle-fill"></i></button>
                                            </span>
                                        }
                                    </div>
                                </div>
                            }
                            else if (_displayMode == ComparisonDisplayMode.WeeklyOnly)
                            {
                                <div class="col-12">
                                    <div class="fw-bold text-slate-700 mb-1"><i class="bi bi-file-earmark-text-fill text-primary me-1"></i>Weekly Invoice Statement</div>
                                    <div class="text-muted small">File name: <strong>@_weeklyFile?.FileName</strong></div>
                                    <div class="text-muted small">Statement Week Ending: <strong class="text-primary">@_weeklyMeta?.WeekEndingDate?.ToString("MM/dd/yyyy")</strong></div>
                                </div>
                            }
                            else
                            {
                                <div class="col-md-6 border-md-end">
                                    <div class="fw-bold text-slate-700 mb-1"><i class="bi bi-file-earmark-text-fill text-primary me-1"></i>Weekly Invoice Statement</div>
                                    <div class="text-muted small">File name: <strong>@_weeklyFile?.FileName</strong></div>
                                    <div class="text-muted small">Statement Week Ending: <strong class="text-primary">@_weeklyMeta?.WeekEndingDate?.ToString("MM/dd/yyyy")</strong></div>
                                </div>
                                <div class="col-md-6 ps-md-4 mt-3 mt-md-0">
                                    <div class="fw-bold text-slate-700 mb-2"><i class="bi bi-calendar3 text-primary me-1"></i>Compared Daily Files (@_dailyFiles.Count) <span class="text-muted" style="font-size: 0.75rem; font-weight: normal;">(click x to exclude a day)</span></div>
                                    <div class="d-flex flex-wrap gap-2">
                                        @foreach (var file in _dailyFiles)
                                        {
                                            <span class="badge bg-white text-dark border d-flex align-items-center gap-2 p-2 shadow-sm" style="font-size: 0.8rem; border-radius: 6px; border-color: #e2e8f0 !important;">
                                                <i class="bi bi-file-earmark-spreadsheet text-success"></i>
                                                <strong>@(file.ParsedDate?.ToString("MM/dd") ?? "??")</strong>
                                                <button type="button" class="btn p-0 border-0 text-danger" style="line-height: 1;" @onclick="() => RemoveDailyFile(file)"><i class="bi bi-x-circle-fill"></i></button>
                                            </span>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }

                <!-- COMPACT SUMMARY BAR -->
                <div class="d-flex justify-content-between align-items-center p-3 rounded-3 bg-light border mb-3 flex-wrap gap-3">
                    @if (_displayMode == ComparisonDisplayMode.Compare || _displayMode == ComparisonDisplayMode.DailyOnly)
                    {
                        <div>
                            <span class="small text-muted fw-bold d-block" style="font-size: 0.75rem;">TOTAL DAILY SUM DUE</span>
                            <span class="fw-bold text-slate-800" style="font-size: 1.25rem;">@_totalDailyDue.ToString("C2")</span>
                        </div>
                    }
                    @if (_displayMode == ComparisonDisplayMode.Compare || _displayMode == ComparisonDisplayMode.WeeklyOnly)
                    {
                        <div>
                            <span class="small text-muted fw-bold d-block" style="font-size: 0.75rem;">TOTAL WEEKLY STATEMENT DUE</span>
                            <span class="fw-bold text-slate-800" style="font-size: 1.25rem;">@_totalWeeklyDue.ToString("C2")</span>
                        </div>
                    }
                    @if (_displayMode == ComparisonDisplayMode.Compare)
                    {
                        <div>
                            <span class="small text-muted fw-bold d-block" style="font-size: 0.75rem; margin-bottom: 2px;">VARIANCE STATUS</span>
                            @if (_totalDueVariance == 0)
                            {
                                <span class="badge bg-success text-white px-3 py-2" style="font-weight: 600; font-size: 0.85rem;"><i class="bi bi-check-circle-fill me-1"></i> Perfect Match</span>
                            }
                            else
                            {
                                <span class="badge bg-danger text-white px-3 py-2" style="font-weight: 600; font-size: 0.85rem;"><i class="bi bi-exclamation-circle-fill me-1"></i> Mismatch @_totalDueVariance.ToString("C2")</span>
                            }
                        </div>
                    }
                </div>

                <!-- SIDE-BY-SIDE TABLES GRID -->
                <div class="comparison-grid">
                    <!-- ONLINE SECTION -->
                    <div>
                        <div class="comparison-section-header">
                            <i class="bi bi-globe text-primary"></i> ONLINE SALES STATS
                        </div>
                        <table class="comparison-table">
                            <thead>
                                <tr>
                                    <th style="width: 40%;">Metric Field</th>
                                    @if (_displayMode == ComparisonDisplayMode.Compare)
                                    {
                                        <th style="text-align: right;">Daily</th>
                                        <th style="text-align: right;">Weekly</th>
                                        <th style="text-align: right;">Variance</th>
                                    }
                                    else if (_displayMode == ComparisonDisplayMode.WeeklyOnly)
                                    {
                                        <th style="text-align: right;">Weekly Value</th>
                                    }
                                    else if (_displayMode == ComparisonDisplayMode.DailyOnly)
                                    {
                                        <th style="text-align: right;">Daily Sum</th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in _onlineRows)
                                {
                                    <tr>
                                        <td class="fw-bold text-slate-700">@row.Name</td>
                                        @if (_displayMode == ComparisonDisplayMode.Compare)
                                        {
                                            <td style="text-align: right;">@row.DailyValue.ToString("C2")</td>
                                            <td style="text-align: right;">@row.WeeklyValue.ToString("C2")</td>
                                            <td style="text-align: right;">
                                                @if (row.VarianceValue == 0)
                                                {
                                                    <span class="text-success small fw-bold">$0.00</span>
                                                }
                                                else
                                                {
                                                    <span class="text-danger small fw-bold">@(row.VarianceValue > 0 ? "+" : "")@row.VarianceValue.ToString("C2")</span>
                                                }
                                            </td>
                                        }
                                        else if (_displayMode == ComparisonDisplayMode.WeeklyOnly)
                                        {
                                            <td style="text-align: right;">@row.WeeklyValue.ToString("C2")</td>
                                        }
                                        else if (_displayMode == ComparisonDisplayMode.DailyOnly)
                                        {
                                            <td style="text-align: right;">@row.DailyValue.ToString("C2")</td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <!-- INSTANT SECTION -->
                    <div>
                        <div class="comparison-section-header">
                            <i class="bi bi-ticket-detailed-fill text-warning"></i> INSTANT SALES STATS
                        </div>
                        <table class="comparison-table">
                            <thead>
                                <tr>
                                    <th style="width: 40%;">Metric Field</th>
                                    @if (_displayMode == ComparisonDisplayMode.Compare)
                                    {
                                        <th style="text-align: right;">Daily</th>
                                        <th style="text-align: right;">Weekly</th>
                                        <th style="text-align: right;">Variance</th>
                                    }
                                    else if (_displayMode == ComparisonDisplayMode.WeeklyOnly)
                                    {
                                        <th style="text-align: right;">Weekly Value</th>
                                    }
                                    else if (_displayMode == ComparisonDisplayMode.DailyOnly)
                                    {
                                        <th style="text-align: right;">Daily Sum</th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in _instantRows)
                                {
                                    <tr>
                                        <td class="fw-bold text-slate-700">@row.Name</td>
                                        @if (_displayMode == ComparisonDisplayMode.Compare)
                                        {
                                            <td style="text-align: right;">@row.DailyValue.ToString("C2")</td>
                                            <td style="text-align: right;">@row.WeeklyValue.ToString("C2")</td>
                                            <td style="text-align: right;">
                                                @if (row.VarianceValue == 0)
                                                {
                                                    <span class="text-success small fw-bold">$0.00</span>
                                                }
                                                else
                                                {
                                                    <span class="text-danger small fw-bold">@(row.VarianceValue > 0 ? "+" : "")@row.VarianceValue.ToString("C2")</span>
                                                }
                                            </td>
                                        }
                                        else if (_displayMode == ComparisonDisplayMode.WeeklyOnly)
                                        {
                                            <td style="text-align: right;">@row.WeeklyValue.ToString("C2")</td>
                                        }
                                        else if (_displayMode == ComparisonDisplayMode.DailyOnly)
                                        {
                                            <td style="text-align: right;">@row.DailyValue.ToString("C2")</td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                @if (!_isHistoricalView)
                {
                    <!-- COMMIT ACTIONS -->
                    <div class="d-flex justify-content-between align-items-center mt-4">
                        <div class="text-muted small">
                            @if (_displayMode == ComparisonDisplayMode.DailyOnly)
                            {
                                <span class="text-success"><i class="bi bi-info-circle-fill me-1"></i> Daily-Only Mode. Ready to save aggregated totals as week ending @_weeklyMeta?.WeekEndingDate?.ToString("MM/dd/yyyy").</span>
                            }
                            else if (_displayMode == ComparisonDisplayMode.WeeklyOnly)
                            {
                                <span class="text-success"><i class="bi bi-info-circle-fill me-1"></i> Weekly-Only Mode. Ready to save weekly invoice values as week ending @_weeklyMeta?.WeekEndingDate?.ToString("MM/dd/yyyy").</span>
                            }
                            else if (_totalDueVariance == 0)
                            {
                                <span class="text-success"><i class="bi bi-check-circle-fill me-1"></i> Ready to commit. All calculations balance.</span>
                            }
                            else
                            {
                                <span class="text-warning"><i class="bi bi-exclamation-triangle-fill me-1"></i> Warning: Discrepancy detected. You can still save if needed.</span>
                            }
                        </div>
                        <div class="d-flex gap-3">
                            <button class="btn-action-secondary" @onclick="ModifyUploads"><i class="bi bi-pencil-square me-1"></i> Modify Uploads</button>
                            <button class="btn-action-primary" @onclick="CommitToDatabase">
                                <i class="bi bi-save me-1"></i> Save & Commit Report
                            </button>
                        </div>
                    </div>
                }
            </div>
        }

        @if (!_isHistoricalView && !_hasDataLoaded)
        {
            <!-- PAST IMPORTED REPORTS HISTORY LIST -->
            <div class="premium-card mt-1">
                <h3 class="fw-bold mb-3 text-slate-800"><i class="bi bi-journal-text text-primary me-2"></i>Imported Weekly Reports History</h3>
                <p class="text-muted small mb-3">Multi-week comparative overview of your committed lottery weekly reports:</p>
                
                @if (!_historicalWeeks.Any())
                {
                    <div class="text-center py-4 text-muted">
                        <i class="bi bi-info-circle fs-3 mb-2 d-block text-secondary"></i>
                        No imported reports found. Complete a week's review above to save your first record.
                    </div>
                }
                else
                {
                    var columns = _historicalWeeks.OrderByDescending(w => w.WeekEndingDate).ToList();
                    <div class="table-responsive">
                        <table class="table table-bordered table-hover text-nowrap align-middle" style="font-size: 0.8rem; border-collapse: collapse;">
                            <thead>
                                <tr class="bg-light">
                                    <th class="fw-bold text-slate-700 sticky-col" style="min-width: 180px; font-size: 0.85rem; padding: 0.5rem;">Metric / Week Ending</th>
                                    @foreach (var col in columns)
                                    {
                                        <th class="text-end fw-bold text-slate-800" style="font-size: 0.85rem; padding: 0.5rem; background-color: #f8fafc;">
                                            <div class="d-flex flex-column align-items-end">
                                                <span>@col.WeekEndingDate.ToString("MM/dd/yyyy")</span>
                                                <span class="text-muted" style="font-size: 0.65rem; font-weight: 500;">
                                                    by @(col.CreatedBy?.Replace("Imported: ", "") ?? "System")
                                                </span>
                                            </div>
                                        </th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                <!-- ONLINE SECTION -->
                                <tr class="fw-bold" style="background-color: #f1f5f9; border-top: 2px solid #cbd5e1; border-bottom: 2px solid #cbd5e1;">
                                    <td class="sticky-col" style="padding: 0.4rem 0.5rem; color: #1e293b; background-color: #f1f5f9 !important;">
                                        <i class="bi bi-globe text-primary me-1"></i> Online Sales
                                    </td>
                                    @foreach (var col in columns) { <td style="background-color: #f1f5f9 !important;"></td> }
                                </tr>
                                <tr>
                                    <td class="text-slate-600 sticky-col" style="padding: 0.35rem 0.5rem;">Net Sales</td>
                                    @foreach (var col in columns) { <td class="text-end" style="padding: 0.35rem 0.5rem;">@col.OnlineNetSales.ToString("C2")</td> }
                                </tr>
                                <tr>
                                    <td class="text-slate-600 sticky-col" style="padding: 0.35rem 0.5rem;">Commission</td>
                                    @foreach (var col in columns) { <td class="text-end text-danger" style="padding: 0.35rem 0.5rem;">(@col.OnlineCommission.ToString("C2"))</td> }
                                </tr>
                                <tr>
                                    <td class="text-slate-600 sticky-col" style="padding: 0.35rem 0.5rem;">Cashes</td>
                                    @foreach (var col in columns) { <td class="text-end text-danger" style="padding: 0.35rem 0.5rem;">(@col.OnlineCashes.ToString("C2"))</td> }
                                </tr>
                                <tr>
                                    <td class="text-slate-600 sticky-col" style="padding: 0.35rem 0.5rem;">Cash Bonus</td>
                                    @foreach (var col in columns) { <td class="text-end text-danger" style="padding: 0.35rem 0.5rem;">(@col.OnlineCashBonus.ToString("C2"))</td> }
                                </tr>
                                <tr>
                                    <td class="text-slate-600 sticky-col" style="padding: 0.35rem 0.5rem;">Claims Bonus</td>
                                    @foreach (var col in columns) { <td class="text-end text-danger" style="padding: 0.35rem 0.5rem;">(@col.OnlineClaimsBonus.ToString("C2"))</td> }
                                </tr>
                                <tr>
                                    <td class="text-slate-600 sticky-col" style="padding: 0.35rem 0.5rem;">Adjustments</td>
                                    @foreach (var col in columns) { <td class="text-end" style="padding: 0.35rem 0.5rem;">@col.OnlineAdjustments.ToString("C2")</td> }
                                </tr>
                                <tr>
                                    <td class="text-slate-600 sticky-col" style="padding: 0.35rem 0.5rem;">Service Fee</td>
                                    @foreach (var col in columns) { <td class="text-end" style="padding: 0.35rem 0.5rem;">@col.OnlineServiceFee.ToString("C2")</td> }
                                </tr>
                                <tr>
                                    <td class="text-slate-600 sticky-col" style="padding: 0.35rem 0.5rem;">Bonding Fee</td>
                                    @foreach (var col in columns) { <td class="text-end" style="padding: 0.35rem 0.5rem;">@col.OnlineBondingFee.ToString("C2")</td> }
                                </tr>
                                <tr class="fw-bold" style="background-color: #f8fafc; border-top: 1.5px solid #cbd5e1; border-bottom: 1.5px solid #cbd5e1;">
                                    <td class="text-slate-800 sticky-col" style="padding: 0.4rem 0.5rem; background-color: #f8fafc !important;">Online Due</td>
                                    @foreach (var col in columns) { <td class="text-end text-slate-800" style="padding: 0.4rem 0.5rem;">@col.OnlineDue.ToString("C2")</td> }
                                </tr>

                                <!-- INSTANT SECTION -->
                                <tr class="fw-bold" style="background-color: #f1f5f9; border-top: 2px solid #cbd5e1; border-bottom: 2px solid #cbd5e1;">
                                    <td class="sticky-col" style="padding: 0.4rem 0.5rem; color: #1e293b; background-color: #f1f5f9 !important;">
                                        <i class="bi bi-ticket-detailed-fill text-warning me-1"></i> Instant Sales
                                    </td>
                                    @foreach (var col in columns) { <td style="background-color: #f1f5f9 !important;"></td> }
                                </tr>
                                <tr>
                                    <td class="text-slate-600 sticky-col" style="padding: 0.35rem 0.5rem;">Gross Sales</td>
                                    @foreach (var col in columns) { <td class="text-end" style="padding: 0.35rem 0.5rem;">@col.InstantGrossSales.ToString("C2")</td> }
                                </tr>
                                <tr>
                                    <td class="text-slate-600 sticky-col" style="padding: 0.35rem 0.5rem;">Return Sales</td>
                                    @foreach (var col in columns) { <td class="text-end text-danger" style="padding: 0.35rem 0.5rem;">(@col.InstantReturnSales.ToString("C2"))</td> }
