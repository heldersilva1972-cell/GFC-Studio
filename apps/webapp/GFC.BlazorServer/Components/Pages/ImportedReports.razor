    private class ComparisonRow
    {
        public string Name { get; }
        public decimal DailyValue { get; }
        public decimal WeeklyValue { get; }
        public decimal VarianceValue => DailyValue - WeeklyValue;
        public decimal Variance => Math.Abs(VarianceValue);

        public ComparisonRow(string name, decimal dailyValue, decimal weeklyValue)
        {
            Name = name;
            DailyValue = dailyValue;
            WeeklyValue = weeklyValue;
        }
    }
