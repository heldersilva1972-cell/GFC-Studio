    private async Task<bool> HasAccess()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        // Auto-register page if missing in AppPages
        var existingPage = PageRepo.GetPageByRoute("/lottery/imported-reports");
        if (existingPage == null)
        {
            try
            {
                PageRepo.AddPage(new AppPage
                {
                    PageName = "Imported Reports",
                    PageRoute = "/lottery/imported-reports",
                    Description = "Upload and compare Daily vs. Weekly Lottery CSV reports",
                    Category = "LOTTERY",
                    RequiresAdmin = false,
                    IsActive = true,
                    DisplayOrder = 110
                });
                existingPage = PageRepo.GetPageByRoute("/lottery/imported-reports");
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Failed to auto-register lottery imported reports page");
            }
        }

        if (user.Identity?.Name?.ToLowerInvariant() == "admin") return true;

        var userIdClaim = user.FindFirst("UserId") ?? user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier);
        if (userIdClaim != null && int.TryParse(userIdClaim.Value, out var userId))
        {
            var permissions = await Task.Run(() => UserService.GetUserPagePermissions(userId));
            return permissions.Any(p => p.PageId == (existingPage?.PageId ?? 0));
        }

        return false;
    }

    private DateTime? GetChecklistEndDate()
    {
        if (_weeklyMeta?.WeekEndingDate.HasValue == true)
        {
            return _weeklyMeta.WeekEndingDate.Value;
        }
        if (_dailyFiles.Any(f => f.ParsedDate.HasValue))
        {
            var maxDate = _dailyFiles.Where(f => f.ParsedDate.HasValue).Select(f => f.ParsedDate.Value).Max();
            int diff = ((int)DayOfWeek.Saturday - (int)maxDate.DayOfWeek + 7) % 7;
            return maxDate.Date.AddDays(diff);
        }
        return null;
    }

    private string GetChecklistTitle()
    {
        if (_weeklyMeta != null && _weeklyMeta.AgentCode != "DAILY-ONLY" && _weeklyMeta.WeekEndingDate.HasValue)
        {
            return "Weekly Coverage Checklist";
        }
        return "Weekly Coverage Checklist (Sunday to Saturday)";
    }

    private string GetChecklistSubtitle()
    {
        var date = GetChecklistEndDate();
        if (date == null) return "";
        if (_weeklyMeta != null && _weeklyMeta.AgentCode != "DAILY-ONLY" && _weeklyMeta.WeekEndingDate.HasValue)
        {
            return $"The uploaded weekly invoice covers the 7-day period ending on {date.Value.ToString("MM/dd/yyyy")} (Wednesday). We verify that daily reports are present:";
        }
        return $"Calculated week ending date Saturday: {date.Value.ToString("MM/dd/yyyy")}. We verify that daily reports are present for this Sunday-Saturday period:";
    }

    private async Task LoadHistoricalWeeks()
    {
        try
        {
            using var db = await DbFactory.CreateDbContextAsync();
            _historicalWeeks = await db.LotteryWeeklyStats
                .Where(w => w.CreatedBy != null && w.CreatedBy.StartsWith("Imported: "))
                .OrderByDescending(w => w.WeekEndingDate)
                .ToListAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading historical lottery stats");
            _errorMessage = "Unable to load historical records. Please contact support.";
        }
    }

    private async Task OnDailyFilesUploaded(InputFileChangeEventArgs e)
    {
        _errorMessage = string.Empty;
        _successMessage = string.Empty;

        foreach (var file in e.GetMultipleFiles())
        {
            try
            {
                using var stream = file.OpenReadStream(maxAllowedSize: 1024 * 1024); // max 1MB
                using var reader = new StreamReader(stream);
                var content = await reader.ReadToEndAsync();
                
                var dailyValues = ExtractDailyReportValues(content);

                _dailyFiles.Add(new UploadedFileContext
                {
                    FileName = file.Name,
                    FileSize = file.Size,
                    Content = content,
                    ParsedDate = dailyValues.ParsedDate,
                    NetOnlineSales = dailyValues.NetOnlineSales,
                    OnlineCashes = dailyValues.OnlineCashes,
                    GrossInstantSales = dailyValues.GrossInstantSales,
                    InstantCashes = dailyValues.InstantCashes
                });
            }
            catch (Exception ex)
            {
                _errorMessage = $"Failed to parse file '{file.Name}': {ex.Message}";
            }
        }

        // Sort chronologically by parsed date
        _dailyFiles = _dailyFiles.OrderBy(f => f.ParsedDate ?? DateTime.MaxValue).ToList();
    }

    private async Task OnWeeklyFileUploaded(InputFileChangeEventArgs e)
    {
        _errorMessage = string.Empty;
        _successMessage = string.Empty;
        var file = e.File;

        try
        {
            using var stream = file.OpenReadStream(maxAllowedSize: 1024 * 1024);
            using var reader = new StreamReader(stream);
            var content = await reader.ReadToEndAsync();

            _weeklyFile = new UploadedFileContext
            {
                FileName = file.Name,
                FileSize = file.Size,
                Content = content
            };

            // Parse metadata
            _weeklyMeta = ParseWeeklyMetadata(file.Name, content);
        }
        catch (Exception ex)
        {
            _errorMessage = $"Failed to parse weekly report: {ex.Message}";
            _weeklyFile = null;
            _weeklyMeta = null;
        }
    }



    private void GoBackToDashboard()
    {
        _hasDataLoaded = false;
        _isHistoricalView = false;
        _activeGroup = null;
        _dailyFiles.Clear();
        _weeklyFile = null;
        _weeklyMeta = null;
        _successMessage = string.Empty;
        _errorMessage = string.Empty;
        LoadStagedReports();
    }

    private void ModifyUploads()
    {
        GoBackToDashboard();
    }

    private void ClearDailyFiles()
    {
        _dailyFiles.Clear();
    }

    private void ToggleSettings()
    {
        _showSettings = !_showSettings;
    }

    private void SaveEmailSettings()
    {
        try
        {
            EmailService.SaveSettings(_emailSettings);
            _successMessage = "Gmail settings saved successfully.";
            _showSettings = false;
        }
        catch (Exception ex)
        {
            _errorMessage = $"Failed to save settings: {ex.Message}";
        }
    }

    private async Task FetchEmails()
    {
        _errorMessage = string.Empty;
        _successMessage = string.Empty;
        _isFetchingEmail = true;
        _syncCompleted = false;
        _syncLogs.Clear();
        _syncStatusMessage = "Starting email sync...";
        _syncCts = new CancellationTokenSource();

        try
        {
            if (string.IsNullOrEmpty(_emailSettings.EmailAddress) || string.IsNullOrEmpty(_emailSettings.AppPassword))
            {
                _errorMessage = "Please configure your Gmail Address and App Password in Gmail Settings first.";
                _showSettings = true;
                _isFetchingEmail = false;
                _syncCompleted = false;
                return;
            }

            var progress = new Progress<string>(status =>
            {
                _syncStatusMessage = status;
                _syncLogs.Insert(0, status);
                InvokeAsync(StateHasChanged);
            });

            var files = await EmailService.FetchLotteryReportsAsync(_emailSettings, progress, _syncCts.Token);
            if (files == null || files.Count == 0)
            {
                _errorMessage = "Sync completed. No new unread lottery report emails found in your Gmail inbox.";
                return;
            }

            int dailyCount = 0;
            int weeklyCount = 0;

            var stagedDir = Path.Combine(AppDomain.CurrentDomain.BaseDirectory, "App_Data", "StagedReports");
            if (!Directory.Exists(stagedDir))
            {
                Directory.CreateDirectory(stagedDir);
            }

            foreach (var f in files)
            {
                // Save to staged folder on disk so they persist across page refreshes
                var filePath = Path.Combine(stagedDir, f.FileName);
                await File.WriteAllTextAsync(filePath, f.Content, _syncCts.Token);

                bool isWeekly = f.Content.Contains("Gross Sales") || f.Content.Contains("Return Sales") || f.Content.Contains("Commission") || f.Content.Contains("TOTAL DUE");

                if (isWeekly) weeklyCount++;
                else dailyCount++;
            }

            // Reload all files from disk staging folder to prevent duplicates in memory lists
            LoadStagedReports();

            if (_emailSettings.AutoCommitEnabled && _weekGroups.Any())
            {
                await AutoCommitAllStagedGroupsAsync();
            }
            else
            {
                _successMessage = $"Successfully fetched and imported {dailyCount} Daily Sales reports and {weeklyCount} Weekly statements from Gmail!";
            }
        }
        catch (OperationCanceledException)
        {
            _errorMessage = "Gmail sync was cancelled by the user.";
        }
        catch (Exception ex)
        {
            _errorMessage = $"Failed to sync email reports: {ex.Message}";
        }
        finally
        {
            _isFetchingEmail = false;
            _syncCompleted = true;
            _syncCts?.Dispose();
            _syncCts = null;
        }
    }

    private async Task AutoCommitAllStagedGroupsAsync()
    {
        int count = 0;
        var groupsToProcess = _weekGroups.ToList();
        foreach (var group in groupsToProcess)
        {
            SelectGroupForProcessing(group);
            await CommitToDatabase();
            count++;
        }
        _hasDataLoaded = false;
        _successMessage = $"⚡ Auto-Commit Active: Automatically processed and committed {count} week statement(s) directly to the database without requiring manual review!";
    }

    private void CancelSync()
    {
        _syncCts?.Cancel();
        _syncStatusMessage = "Cancelling connection...";
    }

    private void RemoveWeeklyFile()
    {
        if (_weeklyFile != null)
        {
            DeleteStagedFileFromDisk(_weeklyFile.FileName);
            var item = _allWeeklyStaged.FirstOrDefault(w => w.FileName == _weeklyFile.FileName);
            if (item != null) _allWeeklyStaged.Remove(item);
        }
        _weeklyFile = null;
        _weeklyMeta = null;
        GroupFilesIntoWeeks();
        
        if (_hasDataLoaded)
        {
            ProcessComparison();
        }
    }

    private void RemoveDailyFile(UploadedFileContext file)
    {
        _dailyFiles.Remove(file);
        DeleteStagedFileFromDisk(file.FileName);
        var item = _allDailyStaged.FirstOrDefault(d => d.FileName == file.FileName);
        if (item != null) _allDailyStaged.Remove(item);
        
        GroupFilesIntoWeeks();

        if (_hasDataLoaded)
        {
            if (_dailyFiles.Any())
            {
                ProcessComparison();
            }
            else
            {
                _hasDataLoaded = false;
            }
        }
    }

    private void ResetPage()
    {
        _dailyFiles.Clear();
        _weeklyFile = null;
        _weeklyMeta = null;
        _hasDataLoaded = false;
        _isHistoricalView = false;
        _activeGroup = null;
        _errorMessage = string.Empty;
        _successMessage = string.Empty;
        _onlineRows.Clear();
        _instantRows.Clear();
        _totalDailyDue = 0;
        _totalWeeklyDue = 0;
        
        ClearStagedReportsFolder();
    }

    private void LoadWeekDetails(LotteryWeeklyStat record)
    {
        _isHistoricalView = true;
        _historicalWeekEndingDate = record.WeekEndingDate;
        _selectedReportAuthor = (record.CreatedBy ?? "Unknown").Replace("Imported: ", "");
        _selectedReportCreatedDate = record.CreatedDate;

        // Populate table rows
        PopulateRowsFromRecord(record);
    }

    private void LoadStagedReports()
    {
        try
        {
            _allDailyStaged.Clear();
            _allWeeklyStaged.Clear();

            var stagedDir = Path.Combine(AppDomain.CurrentDomain.BaseDirectory, "App_Data", "StagedReports");
            if (Directory.Exists(stagedDir))
            {
                var files = Directory.GetFiles(stagedDir, "*.csv");
                if (files.Length > 0)
                {
                    int dailyCount = 0;
                    int weeklyCount = 0;

                    foreach (var path in files)
                    {
                        var content = File.ReadAllText(path);
                        var fileName = Path.GetFileName(path);
                        var fileSize = new FileInfo(path).Length;

                        bool isWeekly = content.Contains("Gross Sales") || content.Contains("Return Sales") || content.Contains("Commission") || content.Contains("TOTAL DUE");

                        if (isWeekly)
                        {
                            _allWeeklyStaged.Add(new UploadedFileContext
                            {
                                FileName = fileName,
                                FileSize = fileSize,
                                Content = content
                            });
                            weeklyCount++;
                        }
                        else
                        {
                            var dailyValues = ExtractDailyReportValues(content);
                            _allDailyStaged.Add(new UploadedFileContext
                            {
                                FileName = fileName,
                                FileSize = fileSize,
                                Content = content,
                                ParsedDate = dailyValues.ParsedDate,
                                NetOnlineSales = dailyValues.NetOnlineSales,
                                OnlineCashes = dailyValues.OnlineCashes,
                                GrossInstantSales = dailyValues.GrossInstantSales,
                                InstantCashes = dailyValues.InstantCashes
                            });
                            dailyCount++;
                        }
                    }

                    GroupFilesIntoWeeks();
                    _successMessage = $"🔔 Auto-Loaded: {dailyCount} Daily reports and {weeklyCount} Weekly statements loaded from background sync staging.";
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load auto-staged reports");
        }
    }

    private void ClearStagedReportsFolder()
    {
        try
        {
            var stagedDir = Path.Combine(AppDomain.CurrentDomain.BaseDirectory, "App_Data", "StagedReports");
            if (Directory.Exists(stagedDir))
            {
                var files = Directory.GetFiles(stagedDir, "*.csv");
                foreach (var file in files)
                {
                    File.Delete(file);
                }
            }
            _allDailyStaged.Clear();
            _allWeeklyStaged.Clear();
            _weekGroups.Clear();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to clean up staged reports directory");
        }
    }

    private void GroupFilesIntoWeeks()
    {
        _weekGroups.Clear();
        var groupsMap = new Dictionary<DateTime, LotteryWeekGroup>();

        // Process daily files
        foreach (var file in _allDailyStaged)
        {
            if (file.ParsedDate.HasValue)
            {
                var Saturday = GetSaturdayEndOfWeek(file.ParsedDate.Value);
                if (!groupsMap.TryGetValue(Saturday, out var group))
                {
                    group = new LotteryWeekGroup { WeekEndingDate = Saturday };
                    groupsMap[Saturday] = group;
                }
                group.DailyFiles.Add(file);
            }
        }

        // Process weekly files
        foreach (var wFile in _allWeeklyStaged)
        {
            var meta = ParseWeeklyMetadata(wFile.FileName, wFile.Content);
            if (meta.WeekEndingDate.HasValue)
            {
                var Saturday = GetSaturdayEndOfWeek(meta.WeekEndingDate.Value);
                if (!groupsMap.TryGetValue(Saturday, out var group))
                {
                    group = new LotteryWeekGroup { WeekEndingDate = Saturday };
                    groupsMap[Saturday] = group;
                }
                group.MatchingWeeklyFile = wFile;
            }
        }

        // Sort groups with most recent week ending date first, excluding already committed historical weeks
        _weekGroups = groupsMap.Values
            .Where(g => !_historicalWeeks.Any(h => h.WeekEndingDate.Date == g.WeekEndingDate.Date))
            .OrderByDescending(g => g.WeekEndingDate)
            .ToList();
    }

    private DateTime GetSaturdayEndOfWeek(DateTime date)
    {
        int diff = ((int)DayOfWeek.Saturday - (int)date.DayOfWeek + 7) % 7;
        return date.Date.AddDays(diff);
    }

    private void SelectGroupForProcessing(LotteryWeekGroup group)
    {
        _activeGroup = group;
        _isDailyOnlyMode = (group.MatchingWeeklyFile == null);
        
        // Copy the group's files into active processing lists
        _dailyFiles = group.DailyFiles.OrderBy(f => f.ParsedDate ?? DateTime.MaxValue).ToList();
        _weeklyFile = group.MatchingWeeklyFile;
        _weeklyMeta = _weeklyFile != null ? ParseWeeklyMetadata(_weeklyFile.FileName, _weeklyFile.Content) : null;
        
        if (_dailyFiles.Any() && _weeklyFile != null)
        {
            _displayMode = ComparisonDisplayMode.Compare;
        }
        else if (_weeklyFile != null)
        {
            _displayMode = ComparisonDisplayMode.WeeklyOnly;
        }
        else
        {
            _displayMode = ComparisonDisplayMode.DailyOnly;
        }

        ProcessComparison();
    }

    private void DeleteStagedFileFromDisk(string fileName)
    {
        try
        {
            var stagedDir = Path.Combine(AppDomain.CurrentDomain.BaseDirectory, "App_Data", "StagedReports");
            var filePath = Path.Combine(stagedDir, fileName);
            if (File.Exists(filePath))
            {
                File.Delete(filePath);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to delete file from staging disk: {FileName}", fileName);
        }
    }

    private class LotteryWeekGroup
    {
        public DateTime WeekEndingDate { get; set; }
        public DateTime WeekStartDate => WeekEndingDate.AddDays(-6);
        public List<UploadedFileContext> DailyFiles { get; set; } = new();
        public UploadedFileContext? MatchingWeeklyFile { get; set; }
    }

    private LotteryWeeklyStat? _recordToDelete = null;

    private void RequestDeleteWeekRecord(LotteryWeeklyStat record)
    {
        _recordToDelete = record;
    }

    private void CancelDeleteRecord()
    {
        _recordToDelete = null;
    }

    private async Task ExecuteDeleteWeekRecord()
    {
        if (_recordToDelete == null) return;
        var record = _recordToDelete;
        _recordToDelete = null;

        try
        {
            using var db = await DbFactory.CreateDbContextAsync();
            db.LotteryWeeklyStats.Remove(record);
            await db.SaveChangesAsync();
            
            _successMessage = $"Successfully deleted record for week ending {record.WeekEndingDate:MM/dd/yyyy}.";
            await LoadHistoricalWeeks();
        }
        catch (Exception ex)
        {
            _errorMessage = $"Failed to delete record: {ex.Message}";
        }
    }

    private void PopulateRowsFromRecord(LotteryWeeklyStat record)
    {
        _onlineRows = new List<ComparisonRow>
        {
            new("Net Sales", record.OnlineNetSales, record.OnlineNetSales),
            new("Commission", record.OnlineCommission, record.OnlineCommission),
            new("Cashes", record.OnlineCashes, record.OnlineCashes),
            new("Cash Bonus", record.OnlineCashBonus, record.OnlineCashBonus),
            new("Claims Bonus", record.OnlineClaimsBonus, record.OnlineClaimsBonus),
            new("Adjustments", record.OnlineAdjustments, record.OnlineAdjustments),
            new("Service Fee", record.OnlineServiceFee, record.OnlineServiceFee),
            new("Bonding Fee", record.OnlineBondingFee, record.OnlineBondingFee),
            new("Online Due", record.OnlineDue, record.OnlineDue)
        };

        _instantRows = new List<ComparisonRow>
        {
            new("Gross Sales", record.InstantGrossSales, record.InstantGrossSales),
            new("Return Sales", record.InstantReturnSales, record.InstantReturnSales),
            new("Commission", record.InstantCommission, record.InstantCommission),
            new("Cashes", record.InstantCashes, record.InstantCashes),
            new("Cash Bonus", record.InstantCashBonus, record.InstantCashBonus),
            new("Claims Bonus", record.InstantClaimsBonus, record.InstantClaimsBonus),
            new("Adjustments", record.InstantAdjustments, record.InstantAdjustments),
            new("Instant Due", record.InstantDue, record.InstantDue)
        };

        _totalDailyDue = record.TotalDue;
        _totalWeeklyDue = record.TotalDue;
        _hasDataLoaded = true;
    }

    private void ProcessComparison()
    {
        _errorMessage = string.Empty;
        _successMessage = string.Empty;

        if (!_dailyFiles.Any() && _weeklyFile == null) return;

        try
        {
            _isDailyOnlyMode = (_weeklyFile == null);

            var dailyData = _dailyFiles.Any() ? ParseDailyFiles(_dailyFiles) : new DailyAggregate();
            LotteryWeeklyStat weeklyData = null;

            if (_weeklyFile != null)
            {
                weeklyData = ParseWeeklyFile(_weeklyFile.FileName, _weeklyFile.Content);
            }
            else
            {
                // Compile daily aggregates into weekly format
                var maxDate = _dailyFiles.Where(f => f.ParsedDate.HasValue).Select(f => f.ParsedDate.Value).Max();
                int diff = ((int)DayOfWeek.Saturday - (int)maxDate.DayOfWeek + 7) % 7;
                var weekEndingDate = maxDate.Date.AddDays(diff);

                weeklyData = new LotteryWeeklyStat
                {
                    WeekEndingDate = weekEndingDate,
                    OnlineNetSales = dailyData.NetOnlineSales,
                    OnlineCommission = dailyData.OnlineCommission,
                    OnlineCashes = dailyData.OnlineCashes,
                    OnlineCashBonus = dailyData.OnlineCashBonus,
                    OnlineClaimsBonus = dailyData.OnlineClaimsBonus,
                    OnlineAdjustments = dailyData.OnlineAdjustments,
                    OnlineServiceFee = dailyData.OnlineServiceFee,
                    OnlineBondingFee = dailyData.OnlineBondingFee,
                    OnlineDue = dailyData.OnlineDue,
                    InstantGrossSales = dailyData.GrossInstantSales,
                    InstantReturnSales = dailyData.InstantReturnSales,
                    InstantCommission = dailyData.InstantCommission,
                    InstantCashes = dailyData.InstantCashes,
                    InstantCashBonus = dailyData.InstantCashBonus,
                    InstantClaimsBonus = dailyData.InstantClaimsBonus,
                    InstantAdjustments = dailyData.InstantAdjustments,
                    InstantDue = dailyData.InstantDue,
                    TotalDue = dailyData.OnlineDue + dailyData.InstantDue
                };

                _weeklyMeta = new WeeklyMetadata
                {
                    AgentCode = "DAILY-ONLY",
                    WeekEndingDate = weekEndingDate
                };
            }

            _onlineRows = new List<ComparisonRow>
            {
                new("Net Sales", dailyData.NetOnlineSales, weeklyData.OnlineNetSales),
                new("Commission", dailyData.OnlineCommission, weeklyData.OnlineCommission),
                new("Cashes", dailyData.OnlineCashes, weeklyData.OnlineCashes),
                new("Cash Bonus", dailyData.OnlineCashBonus, weeklyData.OnlineCashBonus),
                new("Claims Bonus", dailyData.OnlineClaimsBonus, weeklyData.OnlineClaimsBonus),
                new("Adjustments", dailyData.OnlineAdjustments, weeklyData.OnlineAdjustments),
                new("Service Fee", dailyData.OnlineServiceFee, weeklyData.OnlineServiceFee),
                new("Bonding Fee", dailyData.OnlineBondingFee, weeklyData.OnlineBondingFee),
                new("Online Due", dailyData.OnlineDue, weeklyData.OnlineDue)
            };

            _instantRows = new List<ComparisonRow>
            {
                new("Gross Sales", dailyData.GrossInstantSales, weeklyData.InstantGrossSales),
                new("Return Sales", dailyData.InstantReturnSales, weeklyData.InstantReturnSales),
                new("Commission", dailyData.InstantCommission, weeklyData.InstantCommission),
                new("Cashes", dailyData.InstantCashes, weeklyData.InstantCashes),
                new("Cash Bonus", dailyData.InstantCashBonus, weeklyData.InstantCashBonus),
                new("Claims Bonus", dailyData.InstantClaimsBonus, weeklyData.InstantClaimsBonus),
                new("Adjustments", dailyData.InstantAdjustments, weeklyData.InstantAdjustments),
                new("Instant Due", dailyData.InstantDue, weeklyData.InstantDue)
            };

            _totalDailyDue = dailyData.OnlineDue + dailyData.InstantDue;
            _totalWeeklyDue = weeklyData.TotalDue;

            _hasDataLoaded = true;
        }
        catch (Exception ex)
        {
            _errorMessage = $"Comparison processing failed: {ex.Message}";
        }
    }

    private async Task CommitToDatabase()
    {
        if (!_dailyFiles.Any() && _weeklyFile == null) return;

        try
        {
            LotteryWeeklyStat weeklyData;
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var username = authState.User.Identity?.Name ?? "Admin";

            using var db = await DbFactory.CreateDbContextAsync();

            if (_displayMode == ComparisonDisplayMode.DailyOnly)
            {
                // In daily-only mode, we compile the Daily stats into a weekly model
                var dailyData = ParseDailyFiles(_dailyFiles);
                var maxDate = _dailyFiles.Where(f => f.ParsedDate.HasValue).Select(f => f.ParsedDate.Value).Max();
                int diff = ((int)DayOfWeek.Saturday - (int)maxDate.DayOfWeek + 7) % 7;
                var weekEndingDate = maxDate.Date.AddDays(diff);

                weeklyData = new LotteryWeeklyStat
                {
                    WeekEndingDate = weekEndingDate,
                    OnlineNetSales = dailyData.NetOnlineSales,
                    OnlineCommission = dailyData.OnlineCommission,
                    OnlineCashes = dailyData.OnlineCashes,
                    OnlineCashBonus = dailyData.OnlineCashBonus,
                    OnlineClaimsBonus = dailyData.OnlineClaimsBonus,
                    OnlineAdjustments = dailyData.OnlineAdjustments,
                    OnlineServiceFee = dailyData.OnlineServiceFee,
                    OnlineBondingFee = dailyData.OnlineBondingFee,
                    OnlineDue = dailyData.OnlineDue,
                    InstantGrossSales = dailyData.GrossInstantSales,
                    InstantReturnSales = dailyData.InstantReturnSales,
                    InstantCommission = dailyData.InstantCommission,
                    InstantCashes = dailyData.InstantCashes,
                    InstantCashBonus = dailyData.InstantCashBonus,
                    InstantClaimsBonus = dailyData.InstantClaimsBonus,
                    InstantAdjustments = dailyData.InstantAdjustments,
                    InstantDue = dailyData.InstantDue,
                    TotalDue = dailyData.OnlineDue + dailyData.InstantDue
                };
            }
            else
            {
                weeklyData = ParseWeeklyFile(_weeklyFile!.FileName, _weeklyFile!.Content);
            }
            
            // Check for existing record
            var existing = await db.LotteryWeeklyStats.FirstOrDefaultAsync(w => w.WeekEndingDate.Date == weeklyData.WeekEndingDate.Date);
            if (existing != null)
            {
                // Update existing
                existing.OnlineNetSales = weeklyData.OnlineNetSales;
                existing.OnlineCommission = weeklyData.OnlineCommission;
                existing.OnlineCashes = weeklyData.OnlineCashes;
                existing.OnlineCashBonus = weeklyData.OnlineCashBonus;
                existing.OnlineClaimsBonus = weeklyData.OnlineClaimsBonus;
                existing.OnlineAdjustments = weeklyData.OnlineAdjustments;
                existing.OnlineServiceFee = weeklyData.OnlineServiceFee;
                existing.OnlineBondingFee = weeklyData.OnlineBondingFee;
                existing.OnlineDue = weeklyData.OnlineDue;

                existing.InstantGrossSales = weeklyData.InstantGrossSales;
                existing.InstantReturnSales = weeklyData.InstantReturnSales;
                existing.InstantCommission = weeklyData.InstantCommission;
                existing.InstantCashes = weeklyData.InstantCashes;
                existing.InstantCashBonus = weeklyData.InstantCashBonus;
                existing.InstantClaimsBonus = weeklyData.InstantClaimsBonus;
                existing.InstantAdjustments = weeklyData.InstantAdjustments;
                existing.InstantDue = weeklyData.InstantDue;

                existing.TotalDue = weeklyData.TotalDue;
                existing.CreatedBy = "Imported: " + username;
                existing.CreatedDate = DateTime.Now;

                db.LotteryWeeklyStats.Update(existing);
                _successMessage = $"Successfully updated Lottery Weekly Report in database for week ending {weeklyData.WeekEndingDate:MM/dd/yyyy}.";
            }
            else
            {
                // Insert new
                weeklyData.CreatedBy = "Imported: " + username;
                weeklyData.CreatedDate = DateTime.Now;
                await db.LotteryWeeklyStats.AddAsync(weeklyData);
                _successMessage = $"Successfully saved Lottery Weekly Report to database for week ending {weeklyData.WeekEndingDate:MM/dd/yyyy}.";
            }

            await db.SaveChangesAsync();
            await LoadHistoricalWeeks();

            // Discard committed week's active files from disk
            foreach (var f in _dailyFiles)
            {
                DeleteStagedFileFromDisk(f.FileName);
                var item = _allDailyStaged.FirstOrDefault(d => d.FileName == f.FileName);
                if (item != null) _allDailyStaged.Remove(item);
            }
            if (_weeklyFile != null)
            {
                DeleteStagedFileFromDisk(_weeklyFile.FileName);
                var item = _allWeeklyStaged.FirstOrDefault(w => w.FileName == _weeklyFile.FileName);
                if (item != null) _allWeeklyStaged.Remove(item);
            }

            // Re-group remaining staged reports
            GroupFilesIntoWeeks();

            // Clear active comparison variables
            _dailyFiles.Clear();
            _weeklyFile = null;
            _weeklyMeta = null;
            _activeGroup = null;
            _hasDataLoaded = false;
            _onlineRows.Clear();
            _instantRows.Clear();
            _totalDailyDue = 0;
            _totalWeeklyDue = 0;
        }
        catch (Exception ex)
        {
            _errorMessage = $"Failed to save report to database: {ex.Message}";
        }
    }

    // --- PARSING HELPERS ---

    private decimal ParseCurrency(string input)
    {
        if (string.IsNullOrWhiteSpace(input)) return 0;
        
        // Clean symbols
        var clean = input.Replace("$", "").Replace(",", "").Trim();
        
        // Handle negative numbers formatted as (123.45)
        if (clean.StartsWith("(") && clean.EndsWith(")"))
        {
            clean = "-" + clean.Substring(1, clean.Length - 2);
        }

        if (decimal.TryParse(clean, NumberStyles.Any, CultureInfo.InvariantCulture, out var result))
        {
            return result;
        }
        return 0;
    }

    private WeeklyMetadata ParseWeeklyMetadata(string fileName, string csvContent)
    {
        var lines = csvContent.Split(new[] { "\r\n", "\r", "\n" }, StringSplitOptions.None);
        var meta = new WeeklyMetadata();

        // 1. Try to extract date from the filename (e.g. Invoice_Report_Weekly_874147_2430_02072026.CSV)
        var fnMatch = Regex.Match(fileName, @"_(\d{2})(\d{2})(\d{4})\.[Cc][Ss][Vv]$");
        if (fnMatch.Success)
        {
            if (int.TryParse(fnMatch.Groups[1].Value, out var month) &&
                int.TryParse(fnMatch.Groups[2].Value, out var day) &&
                int.TryParse(fnMatch.Groups[3].Value, out var year))
            {
                try
                {
                    var fileDate = new DateTime(year, month, day);
                    // Invoice reports are dated for Sunday when run. Subtract 1 day to get Saturday ending.
                    meta.WeekEndingDate = fileDate.AddDays(-1);
                }
                catch { }
            }
        }

        // 2. Fallback to text searching if not found in filename
        if (!meta.WeekEndingDate.HasValue)
        {
            foreach (var line in lines)
            {
                if (line.Contains("From ") && line.Contains(" to "))
                {
                    var match = Regex.Match(line, @"to\s+(\d{1,2}/\d{1,2}/\d{4})");
                    if (match.Success && DateTime.TryParse(match.Groups[1].Value, out var parsedDate))
                    {
                        meta.WeekEndingDate = parsedDate;
                        break;
                    }
                }
            }
        }

        if (lines.Length >= 2)
        {
            var headers = SplitCsvLine(lines[0]);
            var values = SplitCsvLine(lines[1]);
            
            for (int i = 0; i < Math.Min(headers.Length, values.Length); i++)
            {
                var h = headers[i].Trim().ToLowerInvariant();
                var v = values[i].Trim();
                if (h == "agent") meta.AgentCode = v;
                else if (h == "address") meta.Address = v;
                else if (h == "city") meta.City = v;
            }
        }
        return meta;
    }

    private DateTime? ExtractDailyReportDate(string csvContent)
    {
        return ExtractDailyReportValues(csvContent).ParsedDate;
    }

    private DailyFileValues ExtractDailyReportValues(string csvContent)
    {
        var values = new DailyFileValues();
        var lines = csvContent.Split(new[] { "\r\n", "\r", "\n" }, StringSplitOptions.None);
        bool foundHeader = false;
        foreach (var line in lines)
        {
            var cols = SplitCsvLine(line);
            if (cols.Length == 0) continue;

            var firstCol = cols[0].Trim();

            if (firstCol.Equals("Date", StringComparison.OrdinalIgnoreCase))
            {
                foundHeader = true;
                continue;
            }

            if (foundHeader && !string.IsNullOrEmpty(firstCol))
            {
                if (DateTime.TryParse(firstCol, out var parsedDate))
                {
                    values.ParsedDate = parsedDate;
                    if (cols.Length > 2) values.NetOnlineSales = ParseCurrency(cols[2]);
                    if (cols.Length > 3) values.OnlineCashes = ParseCurrency(cols[3]);
                    if (cols.Length > 4) values.GrossInstantSales = ParseCurrency(cols[4]);
                    if (cols.Length > 5) values.InstantCashes = ParseCurrency(cols[5]);
                    break;
                }
            }
        }
        return values;
    }

    private class DailyFileValues
    {
        public DateTime? ParsedDate { get; set; }
        public decimal NetOnlineSales { get; set; }
        public decimal OnlineCashes { get; set; }
        public decimal GrossInstantSales { get; set; }
        public decimal InstantCashes { get; set; }
    }

    private DailyAggregate ParseDailyFiles(List<UploadedFileContext> files)
    {
        var aggregate = new DailyAggregate();

        foreach (var file in files)
        {
            // If weekly report is uploaded, restrict daily files to the 7-day period ending on WeekEndingDate
            if (_weeklyMeta?.WeekEndingDate.HasValue == true)
            {
                var end = _weeklyMeta.WeekEndingDate.Value.Date;
                var start = end.AddDays(-6);
                if (file.ParsedDate.HasValue && (file.ParsedDate.Value.Date < start || file.ParsedDate.Value.Date > end))
                {
                    continue; // Skip daily files outside the week range
                }
            }

            var lines = file.Content.Split(new[] { "\r\n", "\r", "\n" }, StringSplitOptions.None);
            
            // Look for data rows (usually starting with date after row 7)
            bool foundHeader = false;
            foreach (var line in lines)
            {
                var cols = SplitCsvLine(line);
                if (cols.Length == 0) continue;

                var firstCol = cols[0].Trim();

                // Detect headers
                if (firstCol.Equals("Date", StringComparison.OrdinalIgnoreCase))
                {
                    foundHeader = true;
                    continue;
                }

                if (foundHeader && !string.IsNullOrEmpty(firstCol))
                {
                    // Check if date column represents a valid date (prevents totals line or garbage lines)
                    if (DateTime.TryParse(firstCol, out _))
                    {
                        if (cols.Length > 2) aggregate.NetOnlineSales += ParseCurrency(cols[2]);
                        if (cols.Length > 3) aggregate.OnlineCashes += ParseCurrency(cols[3]);
                        if (cols.Length > 4) aggregate.GrossInstantSales += ParseCurrency(cols[4]);
                        if (cols.Length > 5) aggregate.InstantCashes += ParseCurrency(cols[5]);
                    }
                }
            }
        }

        // Apply derived due balances
        aggregate.OnlineDue = aggregate.NetOnlineSales - aggregate.OnlineCashes;
        aggregate.InstantDue = aggregate.GrossInstantSales - aggregate.InstantCashes;

        return aggregate;
    }

    private LotteryWeeklyStat ParseWeeklyFile(string fileName, string csvContent)
    {
        var stat = new LotteryWeeklyStat();
        
        // Resolve WeekEndingDate using filename and CSV contents
        var meta = ParseWeeklyMetadata(fileName, csvContent);
        stat.WeekEndingDate = meta.WeekEndingDate ?? DateTime.Now;

        var lines = csvContent.Split(new[] { "\r\n", "\r", "\n" }, StringSplitOptions.None);

        for (int i = 0; i < lines.Length; i++)
        {
            var line = lines[i];
            var cols = SplitCsvLine(line);
            if (cols.Length == 0) continue;

            var firstCol = cols[0].Trim().ToUpperInvariant();

            if (firstCol == "INSTANT" && i + 1 < lines.Length)
            {
                var dataCols = SplitCsvLine(lines[i + 1]);
                if (dataCols.Length > 1) stat.InstantGrossSales = ParseCurrency(dataCols[1]);
                if (dataCols.Length > 2) stat.InstantReturnSales = ParseCurrency(dataCols[2]);
                if (dataCols.Length > 3) stat.InstantCommission = ParseCurrency(dataCols[3]);
                if (dataCols.Length > 4) stat.InstantCashes = ParseCurrency(dataCols[4]);
                if (dataCols.Length > 5) stat.InstantCashBonus = ParseCurrency(dataCols[5]);
                if (dataCols.Length > 6) stat.InstantClaimsBonus = ParseCurrency(dataCols[6]);
                if (dataCols.Length > 7) stat.InstantAdjustments = ParseCurrency(dataCols[7]);
                if (dataCols.Length > 10) stat.InstantDue = ParseCurrency(dataCols[10]);
            }
            else if (firstCol == "ONLINE" && i + 1 < lines.Length)
            {
                var dataCols = SplitCsvLine(lines[i + 1]);
                if (dataCols.Length > 1) stat.OnlineNetSales = ParseCurrency(dataCols[1]);
                if (dataCols.Length > 3) stat.OnlineCommission = ParseCurrency(dataCols[3]);
                if (dataCols.Length > 4) stat.OnlineCashes = ParseCurrency(dataCols[4]);
                if (dataCols.Length > 5) stat.OnlineCashBonus = ParseCurrency(dataCols[5]);
                if (dataCols.Length > 6) stat.OnlineClaimsBonus = ParseCurrency(dataCols[6]);
                if (dataCols.Length > 7) stat.OnlineAdjustments = ParseCurrency(dataCols[7]);
                if (dataCols.Length > 8) stat.OnlineServiceFee = ParseCurrency(dataCols[8]);
                if (dataCols.Length > 9) stat.OnlineBondingFee = ParseCurrency(dataCols[9]);
                if (dataCols.Length > 10) stat.OnlineDue = ParseCurrency(dataCols[10]);
            }
            else if (line.Contains("TOTAL DUE:"))
            {
                if (cols.Length > 10) stat.TotalDue = ParseCurrency(cols[10]);
            }
        }

        if (stat.TotalDue == 0)
        {
            stat.TotalDue = stat.OnlineDue + stat.InstantDue;
        }

        return stat;
    }

    private string[] SplitCsvLine(string line)
    {
        var pattern = ",(?=(?:[^\"]*\"[^\"]*\")*[^\"]*$)";
        var parts = Regex.Split(line, pattern);
        for (int i = 0; i < parts.Length; i++)
        {
            parts[i] = parts[i].Trim('"', ' ');
        }
        return parts;
    }

