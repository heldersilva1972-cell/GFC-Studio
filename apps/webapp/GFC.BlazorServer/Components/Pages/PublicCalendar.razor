@page "/public/calendar"
@using GFC.BlazorServer.Components.Shared
@using GFC.BlazorServer.Models
@using GFC.BlazorServer.Services
@inject CalendarSettingsService SettingsService
@layout GFC.BlazorServer.Components.Layout.PublicCalendarLayout
@rendermode InteractiveServer

<PageTitle>Hall Rental Calendar — Gloucester Fraternity Club</PageTitle>

<div class="gfc-pub-cal-page">

    @* ── Header ─────────────────────────────────────────────── *@
    <header class="gfc-pub-cal-header">
        <div class="gfc-pub-cal-header-inner">
            <div class="gfc-pub-cal-logo-wrap">
                <img src="~/images/gfc-logo.png"
                     onerror="this.style.display='none'"
                     alt="Gloucester Fraternity Club"
                     class="gfc-pub-cal-logo" />
                <div class="gfc-pub-cal-title-wrap">
                    <span class="gfc-pub-cal-club">Gloucester Fraternity Club</span>
                    <span class="gfc-pub-cal-subtitle">Hall Rental Calendar</span>
                </div>
            </div>
            <div class="d-flex align-items-center gap-2 flex-wrap">
                @if (_settings.ShowHeaderQuestionButton)
                {
                    <a href="@(!string.IsNullOrWhiteSpace(_settings.HeaderQuestionButtonUrl) ? _settings.HeaderQuestionButtonUrl : "/rentals/apply?mode=inquiry")"
                       target="_blank" rel="noopener"
                       class="gfc-pub-cal-question-btn">
                        ❓ @(!string.IsNullOrWhiteSpace(_settings.HeaderQuestionButtonText) ? _settings.HeaderQuestionButtonText : "Ask a Question")
                    </a>
                }
                @if (_settings.ShowHeaderBookButton)
                {
                    <a href="@(!string.IsNullOrWhiteSpace(_settings.HeaderBookButtonUrl) ? _settings.HeaderBookButtonUrl : "/rentals/apply")"
                       target="_blank" rel="noopener"
                       class="gfc-pub-cal-book-btn">
                        📅 @(!string.IsNullOrWhiteSpace(_settings.HeaderBookButtonText) ? _settings.HeaderBookButtonText : "Book the Hall")
                    </a>
                }
            </div>
        </div>
    </header>

    @* ── Info banner ─────────────────────────────────────────── *@
    <div class="gfc-pub-cal-banner">
        <span>Browse upcoming events. Click any event for details.</span>
    </div>

    @* ── Calendar ────────────────────────────────────────────── *@
    <main class="gfc-pub-cal-main">
        <FullCalendarWrapper Standalone="true" RefreshIntervalMs="300000" />
    </main>

    @* ── Footer ──────────────────────────────────────────────── *@
    <footer class="gfc-pub-cal-footer">
        <span>© @DateTime.Now.Year Gloucester Fraternity Club</span>
        <a href="https://gloucesterfraternityclub.com/" target="_blank" rel="noopener">
            Visit our Website
        </a>
    </footer>
</div>

<style>
    /* ── Reset / Base ─────────────────────────────────────────── */
    .gfc-pub-cal-page {
        min-height: 100vh;
        background: #f5f5f0;
        display: flex;
        flex-direction: column;
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
        color: #1a1a1a;
    }

    /* ── Header ───────────────────────────────────────────────── */
    .gfc-pub-cal-header {
        background: #ffffff;
        border-bottom: 3px solid #C49A49;
        box-shadow: 0 2px 8px rgba(0,0,0,0.06);
        padding: 0 28px;
        flex-shrink: 0;
    }
    .gfc-pub-cal-header-inner {
        max-width: 1160px;
        margin: 0 auto;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 16px 0;
    }
    .gfc-pub-cal-logo-wrap {
        display: flex;
        align-items: center;
        gap: 14px;
    }
    .gfc-pub-cal-logo {
        height: 48px;
        width: auto;
        object-fit: contain;
    }
    .gfc-pub-cal-title-wrap {
        display: flex;
        flex-direction: column;
    }
    .gfc-pub-cal-club {
        color: #1a1a1a;
        font-weight: 800;
        font-size: 1.1rem;
        letter-spacing: -0.01em;
    }
    .gfc-pub-cal-subtitle {
        color: #C49A49;
        font-size: 0.78rem;
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        margin-top: 2px;
    }
    .gfc-pub-cal-book-btn {
        background: #C49A49;
        color: #fff;
        font-weight: 700;
        font-size: 0.9rem;
        padding: 9px 18px;
        border-radius: 8px;
        text-decoration: none;
        transition: background 0.15s, transform 0.1s;
        box-shadow: 0 2px 8px rgba(196,154,73,0.25);
        white-space: nowrap;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }
    .gfc-pub-cal-book-btn:hover {
        background: #a07830;
        transform: translateY(-1px);
        color: #fff;
    }
    .gfc-pub-cal-question-btn {
        background: #ffffff;
        color: #7a5c1e;
        border: 1px solid #C49A49;
        font-weight: 700;
        font-size: 0.9rem;
        padding: 8px 16px;
        border-radius: 8px;
        text-decoration: none;
        transition: background 0.15s, color 0.15s, transform 0.1s;
        white-space: nowrap;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }
    .gfc-pub-cal-question-btn:hover {
        background: #fdfbf7;
        color: #5c4312;
        border-color: #a07830;
        transform: translateY(-1px);
    }

    /* ── Banner ───────────────────────────────────────────────── */
    .gfc-pub-cal-banner {
        background: #fffbf2;
        border-bottom: 1px solid #e8d9b0;
        color: #7a5c1e;
        text-align: center;
        font-size: 0.86rem;
        font-weight: 500;
        padding: 9px 16px;
        flex-shrink: 0;
    }

    /* ── Main ─────────────────────────────────────────────────── */
    .gfc-pub-cal-main {
        flex: 1;
        max-width: 1160px;
        width: 100%;
        margin: 28px auto;
        padding: 28px 32px;
        background: #ffffff;
        border: 1px solid #e4e0d8;
        border-radius: 14px;
        box-shadow: 0 4px 24px rgba(0,0,0,0.07);
    }

    /* ── FullCalendar light theme overrides ─────────────────── */
    .gfc-pub-cal-main .fc { font-family: 'Inter', -apple-system, sans-serif; color: #1a1a1a; }
    .gfc-pub-cal-main .fc-toolbar-title { font-weight: 800; color: #1a1a1a; letter-spacing: -0.01em; }
    .gfc-pub-cal-main .fc-theme-standard td,
    .gfc-pub-cal-main .fc-theme-standard th,
    .gfc-pub-cal-main .fc-theme-standard .fc-scrollgrid { border-color: #ebebeb !important; }
    .gfc-pub-cal-main .fc-col-header-cell-cushion { color: #555; font-weight: 600; font-size: 0.82rem; text-transform: uppercase; letter-spacing: 0.04em; }
    .gfc-pub-cal-main .fc-daygrid-day-number { color: #333; font-weight: 500; }
    .gfc-pub-cal-main .fc-day-today { background: #fffbf0 !important; }
    .gfc-pub-cal-main .fc-daygrid-day.fc-day-today .fc-daygrid-day-number {
        background: #C49A49; color: #fff;
        border-radius: 50%; width: 26px; height: 26px;
        display: flex; align-items: center; justify-content: center; font-weight: 700;
    }
    .gfc-pub-cal-main .fc-day-other .fc-daygrid-day-number { color: #ccc; }
    .gfc-pub-cal-main .fc-list-day-cushion { background: #f9f6ef !important; }
    .gfc-pub-cal-main .fc-list-day-side-text,
    .gfc-pub-cal-main .fc-list-day-text { color: #7a5c1e !important; font-weight: 700; }
    .gfc-pub-cal-main .fc-list-event:hover td { background: #fffbf0; cursor: pointer; }
    .gfc-pub-cal-main .fc-list-empty { color: #999; }

    /* ── Footer ───────────────────────────────────────────────── */
    .gfc-pub-cal-footer {
        background: #fff;
        border-top: 1px solid #e4e0d8;
        padding: 14px 28px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 24px;
        flex-wrap: wrap;
        color: #999;
        font-size: 0.8rem;
        flex-shrink: 0;
    }
    .gfc-pub-cal-footer a {
        color: #C49A49;
        text-decoration: none;
        font-weight: 600;
    }
    .gfc-pub-cal-footer a:hover { opacity: 0.8; }

    /* ── Responsive ───────────────────────────────────────────── */
    @@media (max-width: 640px) {
        .gfc-pub-cal-header {
            padding: 0 12px;
        }
        .gfc-pub-cal-header-inner {
            justify-content: center;
            align-items: center;
            padding: 8px 0;
            text-align: center;
        }
        .gfc-pub-cal-logo-wrap {
            flex-direction: row;
            align-items: center;
            justify-content: center;
            gap: 10px;
        }
        .gfc-pub-cal-logo {
            height: 34px;
        }
        .gfc-pub-cal-club {
            font-size: 0.92rem;
            line-height: 1.1;
        }
        .gfc-pub-cal-subtitle {
            font-size: 0.70rem;
            margin-top: 1px;
        }
        .gfc-pub-cal-book-btn,
        .gfc-pub-cal-question-btn {
            display: none !important; /* Hide top buttons on mobile to avoid clutter; CTA buttons appear contextually in day drawer */
        }
        .gfc-pub-cal-banner {
            display: none; /* Reclaim vertical space on mobile screens */
        }
        .gfc-pub-cal-main {
            margin: 8px 6px;
            padding: 10px 8px;
            border-radius: 8px;
            border: none;
            box-shadow: 0 1px 6px rgba(0,0,0,0.05);
        }
        .gfc-pub-cal-footer {
            flex-direction: column;
            gap: 4px;
            padding: 10px 12px;
        }
    }
</style>

@code {
    private CalendarSettings _settings = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _settings = await SettingsService.GetAsync();
        }
        catch
        {
            _settings = new CalendarSettings();
        }
    }
}
