@page "/public/calendar"
@using GFC.BlazorServer.Components.Shared
@using GFC.BlazorServer.Models
@using GFC.BlazorServer.Services
@inject CalendarSettingsService SettingsService
@layout GFC.BlazorServer.Components.Layout.PublicCalendarLayout
@rendermode InteractiveServer

<PageTitle>Hall Rental Calendar — Gloucester Fraternity Club</PageTitle>

@if (string.Equals(View, "mobile", StringComparison.OrdinalIgnoreCase))
{
    <div class="gfc-pub-cal-mobile-fullscreen-wrapper">
        <div class="gfc-pub-cal-mobile-fullscreen-bar no-print">
            <div class="d-flex align-items-center gap-2">
                <span class="badge bg-primary rounded-pill px-2.5 py-1"><i class="bi bi-phone me-1"></i>Mobile Interactive Preview</span>
                <span class="text-white-50 small d-none d-sm-inline">Gloucester Fraternity Club Hall Rental Calendar</span>
            </div>
            <div class="d-flex align-items-center gap-2">
                @if (_settings.ShowMobileHomeButton && _settings.ShowHeaderHomeButton)
                {
                    <a href="@(!string.IsNullOrWhiteSpace(_settings.HeaderHomeButtonUrl) ? _settings.HeaderHomeButtonUrl : "https://gloucesterfraternityclub.com")" class="btn btn-sm btn-outline-light py-1 px-2.5" title="Return to GFC Home Page">
                        <i class="bi bi-house-door-fill me-1"></i>@(!string.IsNullOrWhiteSpace(_settings.HeaderHomeButtonText) ? _settings.HeaderHomeButtonText : "Home")
                    </a>
                }
                <a href="/public/calendar" class="btn btn-sm btn-outline-light py-1 px-2.5" title="Switch to Full Desktop View">
                    <i class="bi bi-laptop me-1"></i>Desktop View
                </a>
                <button type="button" class="btn btn-sm btn-outline-light py-1 px-2.5" onclick="window.close()" title="Close Window">
                    <i class="bi bi-x-lg me-1"></i>Close
                </button>
            </div>
        </div>

        <div class="gfc-pub-cal-mobile-fullscreen-stage">
            <div class="gfc-pub-cal-phone-chassis shadow-2xl">
                <!-- Phone Top Bar / Dynamic Island / Speaker -->
                <div class="gfc-phone-notch">
                    <div class="gfc-phone-speaker"></div>
                </div>

                <!-- Phone Inner Screen -->
                <div class="gfc-phone-screen">
                    <iframe id="gfcMobileCalendarFrame" src="/public/calendar" style="width:100%; height:100%; border:none; background:#f5f5f0;"></iframe>
                </div>

                <!-- Phone Bottom Bar -->
                <div class="gfc-phone-home-indicator-bar">
                    <div class="gfc-phone-home-bar"></div>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="gfc-pub-cal-page">

        @* ── Header ─────────────────────────────────────────────── *@
        <header class="gfc-pub-cal-header">
            <div class="gfc-pub-cal-header-inner">
                <a href="https://gloucesterfraternityclub.com" class="gfc-pub-cal-logo-wrap text-decoration-none" title="Visit GFC Home Website">
                    <img src="~/images/gfc-logo.png"
                         onerror="this.style.display='none'"
                         alt="Gloucester Fraternity Club"
                         class="gfc-pub-cal-logo" />
                    <div class="gfc-pub-cal-title-wrap">
                        <span class="gfc-pub-cal-club">Gloucester Fraternity Club</span>
                        <span class="gfc-pub-cal-subtitle">Hall Rental Calendar</span>
                    </div>
                </a>
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    @if (_settings.ShowHeaderHomeButton)
                    {
                        <a href="@(!string.IsNullOrWhiteSpace(_settings.HeaderHomeButtonUrl) ? _settings.HeaderHomeButtonUrl : "https://gloucesterfraternityclub.com")"
                           class="gfc-pub-cal-home-btn"
                           title="Return to GFC Home Website">
                            🏠 @(!string.IsNullOrWhiteSpace(_settings.HeaderHomeButtonText) ? _settings.HeaderHomeButtonText : "GFC Home")
                        </a>
                    }
                    @if (_settings.ShowHeaderQuestionButton)
                    {
                        <a href="@(!string.IsNullOrWhiteSpace(_settings.HeaderQuestionButtonUrl) ? _settings.HeaderQuestionButtonUrl : "/rentals/apply?mode=inquiry")"
                           target="_blank" rel="noopener"
                           class="gfc-pub-cal-question-btn">
                            ❓ @(!string.IsNullOrWhiteSpace(_settings.HeaderQuestionButtonText) ? _settings.HeaderQuestionButtonText : "Ask a Question")
                        </a>
                    }
                    @if (_settings.ShowHeaderBookButton)
                    {
                        <a href="@(!string.IsNullOrWhiteSpace(_settings.HeaderBookButtonUrl) ? _settings.HeaderBookButtonUrl : "/rentals/apply")"
                           target="_blank" rel="noopener"
                           class="gfc-pub-cal-book-btn">
                            📅 @(!string.IsNullOrWhiteSpace(_settings.HeaderBookButtonText) ? _settings.HeaderBookButtonText : "Book the Hall")
                        </a>
                    }
                </div>
            </div>
        </header>

        @* ── Info / Notice banner ─────────────────────────────────── *@
        @if (_settings.ShowHeaderNoticeBanner && !string.IsNullOrWhiteSpace(_settings.HeaderNoticeBannerText))
        {
            <div class="gfc-pub-cal-banner">
                <div class="gfc-pub-cal-banner-content">
                    <i class="bi bi-info-circle-fill gfc-pub-cal-banner-icon"></i>
                    <div class="gfc-pub-cal-banner-text">
                        @foreach (var line in _settings.HeaderNoticeBannerText.Split(new[] { "\r\n", "\r", "\n" }, StringSplitOptions.RemoveEmptyEntries))
                        {
                            <p class="mb-1 last-p-no-margin">@line</p>
                        }
                    </div>
                </div>
            </div>
        }

        @* ── Calendar ────────────────────────────────────────────── *@
        <main class="gfc-pub-cal-main">
            <FullCalendarWrapper Standalone="true" RefreshIntervalMs="300000" />
        </main>

        @* ── Footer ──────────────────────────────────────────────── *@
        <footer class="gfc-pub-cal-footer">
            <span>© @DateTime.Now.Year Gloucester Fraternity Club</span>
            <a href="https://gloucesterfraternityclub.com/" target="_blank" rel="noopener">
                Visit our Website
            </a>
        </footer>
    </div>
}

<style>
    /* ── Reset / Base ─────────────────────────────────────────── */
    .gfc-pub-cal-page {
        min-height: 100vh;
        background: #f5f5f0;
        display: flex;
        flex-direction: column;
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
        color: #1a1a1a;
    }

    /* ── Header ───────────────────────────────────────────────── */
    .gfc-pub-cal-header {
        background: #ffffff;
        border-bottom: 3px solid #C49A49;
        box-shadow: 0 2px 8px rgba(0,0,0,0.06);
        padding: 0 28px;
        flex-shrink: 0;
    }
    .gfc-pub-cal-header-inner {
        max-width: 1160px;
        margin: 0 auto;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 16px 0;
    }
    .gfc-pub-cal-logo-wrap {
        display: flex;
        align-items: center;
        gap: 14px;
    }
    .gfc-pub-cal-logo {
        height: 48px;
        width: auto;
        object-fit: contain;
    }
    .gfc-pub-cal-title-wrap {
        display: flex;
        flex-direction: column;
    }
    .gfc-pub-cal-club {
        color: #1a1a1a;
        font-weight: 800;
        font-size: 1.1rem;
        letter-spacing: -0.01em;
    }
    .gfc-pub-cal-subtitle {
        color: #C49A49;
        font-size: 0.78rem;
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        margin-top: 2px;
    }
    .gfc-pub-cal-book-btn {
        background: #C49A49;
        color: #fff;
        font-weight: 700;
        font-size: 0.9rem;
        padding: 9px 18px;
        border-radius: 8px;
        text-decoration: none;
        transition: background 0.15s, transform 0.1s;
        box-shadow: 0 2px 8px rgba(196,154,73,0.25);
        white-space: nowrap;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }
    .gfc-pub-cal-book-btn:hover {
        background: #a07830;
        transform: translateY(-1px);
        color: #fff;
    }
    .gfc-pub-cal-question-btn {
        background: #ffffff;
        color: #7a5c1e;
        border: 1px solid #C49A49;
        font-weight: 700;
        font-size: 0.9rem;
        padding: 8px 16px;
        border-radius: 8px;
        text-decoration: none;
        transition: background 0.15s, color 0.15s, transform 0.1s;
        white-space: nowrap;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }
    .gfc-pub-cal-question-btn:hover {
        background: #fdfbf7;
        color: #5c4312;
        border-color: #a07830;
        transform: translateY(-1px);
    }
    .gfc-pub-cal-home-btn {
        background: #f8fafc;
        color: #334155;
        border: 1px solid #cbd5e1;
        font-weight: 700;
        font-size: 0.9rem;
        padding: 8px 16px;
        border-radius: 8px;
        text-decoration: none;
        transition: background 0.15s, color 0.15s, transform 0.1s;
        white-space: nowrap;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }
    .gfc-pub-cal-home-btn:hover {
        background: #e2e8f0;
        color: #0f172a;
        transform: translateY(-1px);
    }

    /* ── Banner ───────────────────────────────────────────────── */
    .gfc-pub-cal-banner {
        background: #fffbf2;
        border-bottom: 1px solid #e8d9b0;
        color: #7a5c1e;
        padding: 12px 24px;
        flex-shrink: 0;
        display: flex;
        justify-content: center;
    }
    .gfc-pub-cal-banner-content {
        max-width: 1160px;
        width: 100%;
        display: flex;
        align-items: flex-start;
        gap: 12px;
        text-align: left;
    }
    .gfc-pub-cal-banner-icon {
        color: #C49A49;
        font-size: 1.25rem;
        flex-shrink: 0;
        margin-top: 1px;
    }
    .gfc-pub-cal-banner-text {
        font-size: 0.88rem;
        line-height: 1.45;
        font-weight: 500;
        color: #634b17;
    }
    .gfc-pub-cal-banner-text p:last-child {
        margin-bottom: 0 !important;
    }

    /* ── Main ─────────────────────────────────────────────────── */
    .gfc-pub-cal-main {
        flex: 1;
        max-width: 1160px;
        width: 100%;
        margin: 28px auto;
        padding: 28px 32px;
        background: #ffffff;
        border: 1px solid #e4e0d8;
        border-radius: 14px;
        box-shadow: 0 4px 24px rgba(0,0,0,0.07);
    }

    /* ── FullCalendar light theme overrides ─────────────────── */
    .gfc-pub-cal-main .fc { font-family: 'Inter', -apple-system, sans-serif; color: #1a1a1a; }
    .gfc-pub-cal-main .fc-toolbar-title { font-weight: 800; color: #1a1a1a; letter-spacing: -0.01em; }
    .gfc-pub-cal-main .fc-theme-standard td,
    .gfc-pub-cal-main .fc-theme-standard th,
    .gfc-pub-cal-main .fc-theme-standard .fc-scrollgrid { border-color: #ebebeb !important; }
    .gfc-pub-cal-main .fc-col-header-cell-cushion { color: #555; font-weight: 600; font-size: 0.82rem; text-transform: uppercase; letter-spacing: 0.04em; }
    .gfc-pub-cal-main .fc-daygrid-day-number { color: #333; font-weight: 500; }
    .gfc-pub-cal-main .fc-day-today { background: #fffbf0 !important; }
    .gfc-pub-cal-main .fc-daygrid-day.fc-day-today .fc-daygrid-day-number {
        background: #C49A49; color: #fff;
        border-radius: 50%; width: 26px; height: 26px;
        display: flex; align-items: center; justify-content: center; font-weight: 700;
    }
    .gfc-pub-cal-main .fc-day-other .fc-daygrid-day-number { color: #ccc; }
    .gfc-pub-cal-main .fc-list-day-cushion { background: #f9f6ef !important; }
    .gfc-pub-cal-main .fc-list-event:hover td { background: #fffbf0; cursor: pointer; }
    .gfc-pub-cal-main .fc-list-empty { color: #999; }
    .gfc-pub-cal-page .gfc-fc-badge-booked { background: #166534 !important; border: 1px solid #14532d !important; color: #ffffff !important; }
    .gfc-pub-cal-page .gfc-mobile-dot-booked { background-color: #166534 !important; }
    .gfc-pub-cal-page .gfc-fc-badge-pending { background: #fef3c7 !important; border: 1px solid #fcd34d !important; color: #92400e !important; }
    .gfc-pub-cal-page .gfc-mobile-dot-pending { background-color: #d97706 !important; }

    /* ── Footer ───────────────────────────────────────────────── */
    .gfc-pub-cal-footer {
        background: #fff;
        border-top: 1px solid #e4e0d8;
        padding: 14px 28px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 24px;
        flex-wrap: wrap;
        color: #999;
        font-size: 0.8rem;
        flex-shrink: 0;
    }
    .gfc-pub-cal-footer a {
        color: #C49A49;
        text-decoration: none;
        font-weight: 600;
    }
    .gfc-pub-cal-footer a:hover { opacity: 0.8; }

    /* ── Responsive ───────────────────────────────────────────── */
    @@media (max-width: 640px) {
        .gfc-pub-cal-header {
            padding: 0 12px;
        }
        .gfc-pub-cal-header-inner {
            justify-content: center;
            align-items: center;
            padding: 8px 0;
            text-align: center;
        }
        .gfc-pub-cal-logo-wrap {
            flex-direction: row;
            align-items: center;
            justify-content: center;
            gap: 10px;
        }
        .gfc-pub-cal-logo {
            height: 34px;
        }
        .gfc-pub-cal-club {
            font-size: 0.92rem;
            line-height: 1.1;
        }
        .gfc-pub-cal-subtitle {
            font-size: 0.70rem;
            margin-top: 1px;
        }
        .gfc-pub-cal-home-btn,
        .gfc-pub-cal-book-btn,
        .gfc-pub-cal-question-btn {
            display: none !important; /* Hide top buttons on mobile to avoid clutter; CTA buttons appear contextually in day drawer */
        }
        .gfc-pub-cal-banner {
            padding: 10px 14px;
        }
        .gfc-pub-cal-banner-content {
            font-size: 0.80rem;
            gap: 8px;
        }
        .gfc-pub-cal-banner-icon {
            font-size: 1.1rem;
        }
        .gfc-pub-cal-banner-text {
            font-size: 0.80rem;
        }
        .gfc-pub-cal-main {
            margin: 8px 6px;
            padding: 10px 8px;
            border-radius: 8px;
            border: none;
            box-shadow: 0 1px 6px rgba(0,0,0,0.05);
        }
        .gfc-pub-cal-footer {
            flex-direction: column;
            gap: 4px;
            padding: 10px 12px;
        }
    }

    /* ── Mobile Fullscreen Stage & Chassis ──────────────────── */
    .gfc-pub-cal-mobile-fullscreen-wrapper {
        min-height: 100vh;
        background: radial-gradient(circle at top, #1e293b 0%, #0f172a 100%);
        display: flex;
        flex-direction: column;
    }
    .gfc-pub-cal-mobile-fullscreen-bar {
        background: rgba(15, 23, 42, 0.85);
        backdrop-filter: blur(8px);
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        padding: 10px 20px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        z-index: 100;
    }
    .gfc-pub-cal-mobile-fullscreen-stage {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 24px 16px;
    }
    .gfc-pub-cal-phone-chassis {
        width: 380px;
        max-width: 100%;
        background: #1e293b;
        border: 12px solid #0f172a;
        border-radius: 44px;
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5), 0 0 0 1px rgba(255, 255, 255, 0.1);
        overflow: hidden;
        display: flex;
        flex-direction: column;
        height: 780px;
        max-height: calc(100vh - 100px);
        position: relative;
    }
    .gfc-phone-notch {
        height: 24px;
        background: #0f172a;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }
    .gfc-phone-speaker {
        width: 50px;
        height: 4px;
        background: #334155;
        border-radius: 4px;
    }
    .gfc-phone-screen {
        flex: 1;
        overflow: hidden;
        background: #f5f5f0;
        position: relative;
    }
    .gfc-phone-home-indicator-bar {
        height: 20px;
        background: #0f172a;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }
    .gfc-phone-home-bar {
        width: 110px;
        height: 4px;
        background: #64748b;
        border-radius: 3px;
    }
</style>

@code {
    [SupplyParameterFromQuery(Name = "view")]
    public string? View { get; set; }

    private CalendarSettings _settings = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _settings = await SettingsService.GetAsync();
        }
        catch
        {
            _settings = new CalendarSettings();
        }
    }
}
