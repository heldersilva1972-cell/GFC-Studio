@code {
    [SupplyParameterFromQuery(Name = "view")]
    public string? View { get; set; }

    [SupplyParameterFromQuery(Name = "embed")]
    public string? Embed { get; set; }

    [SupplyParameterFromQuery(Name = "inquiry")]
    public string? InquiryQuery { get; set; }

    private bool IsEmbed => 
        string.Equals(Embed, "true", StringComparison.OrdinalIgnoreCase) ||
        string.Equals(Embed, "1", StringComparison.OrdinalIgnoreCase);

    private CalendarSettings _settings = new();

    private bool _showInquiryForm = false;
    private bool _isInquirySubmitted = false;
    private bool _isInquirySubmitting = false;
    private string? _inquiryErrorMessage;
    private string _inquiryContactPreference = "Email";
    private HallRentalRequest _inquiryModel = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _settings = await SettingsService.GetAsync();
        }
        catch
        {
            _settings = new CalendarSettings();
        }

        if (string.Equals(InquiryQuery, "true", StringComparison.OrdinalIgnoreCase) ||
            string.Equals(InquiryQuery, "1", StringComparison.OrdinalIgnoreCase))
        {
            _showInquiryForm = true;
        }
    }

    private void ToggleInquiryForm()
    {
        _showInquiryForm = !_showInquiryForm;
        if (!_showInquiryForm)
        {
            _isInquirySubmitted = false;
            _inquiryErrorMessage = null;
        }
    }

    private void CloseInquiryForm()
    {
        _showInquiryForm = false;
        _isInquirySubmitted = false;
        _inquiryErrorMessage = null;
    }

    private void OnInquiryPhoneChanged(ChangeEventArgs e)
    {
        var raw = e.Value?.ToString() ?? "";
        _inquiryModel.RequesterPhone = FormatPhoneNumber(raw);
    }

    private void OnInquiryDateChanged(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out var dt))
        {
            _inquiryModel.EventDate = dt;
        }
    }

    private static string FormatPhoneNumber(string? input)
    {
        if (string.IsNullOrWhiteSpace(input)) return string.Empty;
        var digits = System.Text.RegularExpressions.Regex.Replace(input, @"\D", "");
        if (digits.Length == 10)
        {
            return $"({digits.Substring(0, 3)}) {digits.Substring(3, 3)}-{digits.Substring(6, 4)}";
        }
        else if (digits.Length == 11 && digits.StartsWith("1"))
        {
            return $"({digits.Substring(1, 3)}) {digits.Substring(4, 3)}-{digits.Substring(7, 4)}";
        }
        else if (digits.Length == 7)
        {
            return $"{digits.Substring(0, 3)}-{digits.Substring(3, 4)}";
        }
        return input.Trim();
    }

    private async Task HandleInquirySubmit()
    {
        _inquiryErrorMessage = null;

        if (string.IsNullOrWhiteSpace(_inquiryModel.ApplicantName))
        {
            _inquiryErrorMessage = "Please provide your name or organization name.";
            return;
        }

        if (string.IsNullOrWhiteSpace(_inquiryModel.RequesterEmail) || !_inquiryModel.RequesterEmail.Contains("@"))
        {
            _inquiryErrorMessage = "Please provide a valid email address so we can reach you.";
            return;
        }

        if (_inquiryContactPreference == "Phone" || _inquiryContactPreference == "Both")
        {
            var digits = new string((_inquiryModel.RequesterPhone ?? "").Where(char.IsDigit).ToArray());
            if (digits.Length < 10)
            {
                _inquiryErrorMessage = "Please provide a valid 10-digit phone number so we can call you.";
                return;
            }
        }

        if (string.IsNullOrWhiteSpace(_inquiryModel.EventDescription))
        {
            _inquiryErrorMessage = "Please enter your question or inquiry message.";
            return;
        }

        _isInquirySubmitting = true;
        try
        {
            var webSettings = await WebsiteSettingsService.GetWebsiteSettingsAsync();
            bool isTest = (webSettings?.EnableSandboxMode == true) || (webSettings?.FormIngestionMode == "Simulation");
            _inquiryModel.RequesterName = _inquiryModel.ApplicantName;
            _inquiryModel.RequestPhoneCall = (_inquiryContactPreference == "Phone" || _inquiryContactPreference == "Both");
            _inquiryModel.PreferredContactMethod = _inquiryContactPreference;

            await RentalService.SubmitGeneralInquiryAsync(_inquiryModel, isTest);
            _isInquirySubmitted = true;
        }
        catch (Exception ex)
        {
            var detail = ex.InnerException != null ? $"{ex.Message} (Details: {ex.InnerException.Message})" : ex.Message;
            _inquiryErrorMessage = "Error submitting inquiry: " + detail;
        }
        finally
        {
            _isInquirySubmitting = false;
        }
    }
}
