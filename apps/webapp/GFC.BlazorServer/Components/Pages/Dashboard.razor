                            <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
                                <div class="card-header bg-white border-0 py-2 d-flex justify-content-between align-items-center">
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="badge bg-primary-subtle text-primary border-0">@note.NoteType</span>
                                        <span class="fw-bold small">@note.ShiftDate.ToString("MMMM dd, yyyy")</span>
                                        <span class="text-muted extra-small">• @note.ShiftType</span>
                                        @if (note.IsRentalHall)
                                        {
                                            <span class="badge bg-info-subtle text-info border-0 ms-2">Rental Hall</span>
                                        }
                                    </div>
                                    <div class="text-muted small">By: <strong>@note.Author</strong></div>
                                </div>
                                <div class="card-body bg-white pt-1 pb-3">
                                    <div class="p-3 bg-light rounded-3 border-start border-3 border-warning italic" style="font-size: 0.95rem; color: #334155;">
                                        "@note.NoteText"
                                    </div>
                                    <div class="mt-3 d-flex justify-content-end">
                                        <button class="btn btn-sm btn-outline-success rounded-pill px-4 fw-bold" @onclick="() => AcknowledgeNote(note)" disabled="@_isAcknowledging">
                                            <i class="bi bi-check2-circle me-1"></i> Acknowledge
                                        </button>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
                <div class="modal-footer bg-white border-0 py-3 rounded-bottom-4">
                    <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-4" @onclick="CloseNoteAlertModal">Close</button>
                    @if (_notesToAcknowledge.Count > 1)
                    {
                        <button type="button" class="btn btn-sm btn-success rounded-pill px-4 shadow-sm fw-bold" @onclick="AcknowledgeAllNotes" disabled="@_isAcknowledging">
                            <i class="bi bi-check-all me-1"></i> Acknowledge All
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show" style="z-index: 2550;"></div>
}
