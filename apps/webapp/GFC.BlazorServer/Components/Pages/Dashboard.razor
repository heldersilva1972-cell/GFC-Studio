    private async Task AcknowledgeNote(ShiftNoteAlert note)
    {
        if (_isAcknowledging) return;
        _isAcknowledging = true;
        try
        {
            var currentUser = AuthStateProvider.GetCurrentUser()?.Username ?? "Admin";
            await FinancialService.AcknowledgeNoteAsync(note.NoteType, note.RecordId, currentUser);
            
            // Remove from local list
            _notesToAcknowledge.Remove(note);
            
            // Update metrics
            if (_metrics?.UnacknowledgedNotes != null)
            {
                var original = _metrics.UnacknowledgedNotes.FirstOrDefault(n => n.RecordId == note.RecordId && n.NoteType == note.NoteType);
                if (original != null) _metrics.UnacknowledgedNotes.Remove(original);
            }
            
            if (!_notesToAcknowledge.Any())
            {
                _showNoteAlertModal = false;
            }
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Error acknowledging note: {ex.Message}");
        }
        finally
        {
            _isAcknowledging = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task AcknowledgeAllNotes()
    {
        if (_isAcknowledging) return;
        _isAcknowledging = true;
        try
        {
            var currentUser = AuthStateProvider.GetCurrentUser()?.Username ?? "Admin";
            foreach (var note in _notesToAcknowledge.ToList())
            {
                await FinancialService.AcknowledgeNoteAsync(note.NoteType, note.RecordId, currentUser);
            }
            
            if (_metrics?.UnacknowledgedNotes != null)
            {
                _metrics.UnacknowledgedNotes.Clear();
            }
            
            _notesToAcknowledge.Clear();
            _showNoteAlertModal = false;
