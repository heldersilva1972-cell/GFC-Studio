@page "/"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Web
@using System.Linq
@using GFC.Core.Interfaces
@using GFC.Core.DTOs
@using GFC.Core.Enums
@using GFC.BlazorServer.Components.Common
@using GFC.BlazorServer.Data.Entities
@using GFC.BlazorServer.Models.Dashboard
@using GFC.BlazorServer.Services
@using GFC.BlazorServer.Services.Controllers
@using GFC.BlazorServer.Services.Dashboard
@using GFC.BlazorServer.Services.Operations
@attribute [Authorize]
@inject IDashboardService DashboardService
@inject IDashboardMetricsService DashboardMetricsService
@inject IMemberQueryService MemberQueryService
@inject ControllerRegistryService ControllerRegistryService
@inject ControllerEventService ControllerEventService
@inject IBlazorSystemSettingsService SystemSettingsService
@inject NavigationManager NavMgr
@inject IControllerClient ControllerClient
@inject DashboardSessionState SessionState
@using GFC.BlazorServer.Components.Shared
@using GFC.Core.Models
@inject IRentalService RentalService
@inject IJSRuntime JS
@inject IDuesYearSettingsRepository DuesYearSettingsRepository
@inject IControllerSyncQueueRepository SyncQueueRepository
@inject ControllerHealthService ControllerHealthService
@inject KeyCardLifecycleService KeyCardLifecycleService
@inject IKeyCardRepository KeyCardRepository
@using GFC.BlazorServer.Services.DataProtection
@inject IDataProtectionService DataProtectionService
@inject IShiftComplianceService ShiftComplianceService

@inject IUserManagementService UserManagementService
@using GFC.BlazorServer.Services
@inject CustomAuthenticationStateProvider AuthStateProvider

@if (_showSplash)
{
    <GfcDashboardSplash IsFadingOut="_isSplashFadingOut" />
}

<div class="dash-page @(_showSplash && !_isSplashFadingOut ? "dash-hidden" : "dash-visible")">
    <VpnSetupNotificationBanner />
















        @if (_isLoading && !_showSplash)
        {
            <div class="dash-loader-wrapper dash-fade-in">
                <div class="dash-loader-spinner">
                    <div class="spinner-ring"></div>
                    <div class="spinner-monogram">GFC</div>
                </div>
                <div class="dash-loader-text">Refreshing Control Center</div>
                <div class="dash-loader-progress">
                    <div class="dash-loader-bar"></div>
                </div>
            </div>
        }
        else if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <div class="alert alert-danger">@_errorMessage</div>
        }
        else
        {
            // Use exact same logic as Members page Quick Stats
            var totalMembers = _memberList?.Count ?? 0;
            var activeMembers = _memberList?.Count(m => m.Status is MemberStatus.Regular or MemberStatus.RegularNonPortuguese or MemberStatus.Life or MemberStatus.Guest) ?? 0;
            var overdueCount = _duesSummary?.UnpaidCount ?? 0;

            <div class="dash-modern-canvas">
                <!-- Header Section -->
                <div class="d-flex justify-content-between align-items-end mb-4 px-2">
                    <div>
                        <h1 class="display-6 fw-extrabold mb-1" style="color: #0f172a; letter-spacing: -0.03em;">Dashboard</h1>
                        <div class="d-flex align-items-center gap-2 text-muted small">
                            <i class="bi bi-shield-check text-success"></i>
                            <span>All systems operational</span>
                            <span class="mx-1">•</span>
                            <span>Welcome, @AuthStateProvider.GetCurrentUser()?.Username</span>
                        </div>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <button type="button" class="btn btn-sm px-3 py-2 rounded-pill bg-white border-0 shadow-sm text-muted fw-semibold" @onclick="ToggleSettingsPanel">
                            <i class="bi bi-sliders2 me-2"></i>Customize
                        </button>
                        <button type="button" class="btn btn-sm px-4 py-2 rounded-pill bg-primary shadow-sm text-white fw-bold d-flex align-items-center" @onclick="RefreshAsync" disabled="@(_isLoading || IsRefreshing)">
                            @if (IsRefreshing)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span>
                                <span>Syncing...</span>
                            }
                            else
                            {
                                <i class="bi bi-arrow-repeat me-2"></i>
                                <span>Refresh</span>
                            }
                        </button>
                    </div>
                </div>

                <!-- Tier 1: Command Ribbon -->
                @if (ShowQuickActionsCard)
                {
                    <div class="command-ribbon px-2">
                        @if (QaShowAddMember && _canAddMember)
                        {
                            <a href="/members/new?returnUrl=/" class="ribbon-item">
                                <div class="ribbon-icon-wrapper icon-blue">
                                    <i class="bi bi-person-plus-fill"></i>
                                </div>
                                <span class="ribbon-label">Add Member</span>
                            </a>
                        }
                        @if (QaShowRecordPayment && _canRecordDues)
                        {
                            <a href="/dues" class="ribbon-item">
                                <div class="ribbon-icon-wrapper icon-green">
                                    <i class="bi bi-cash-stack"></i>
                                </div>
                                <span class="ribbon-label">Record Dues</span>
                            </a>
                        }
                        @if (QaShowOpenDoor && _canManageControllers)
                        {
                            <button type="button" class="ribbon-item border-0 bg-transparent" @onclick="TestSimulatedDoorOpen">
                                <div class="ribbon-icon-wrapper icon-gold">
                                    <i class="bi bi-door-open-fill"></i>
                                </div>
                                <span class="ribbon-label">Open Door</span>
                            </button>
                        }
                        @if (QaShowKeyCards && _canManageKeyCards)
                        {
                            <a href="/keycards" class="ribbon-item">
                                <div class="ribbon-icon-wrapper icon-purple">
                                    <i class="bi bi-person-badge-fill"></i>
                                </div>
                                <span class="ribbon-label">Key Cards</span>
                            </a>
                        }
                        @if (QaShowNewRental && _canManageRentals)
                        {
                            <a href="/admin/hall-management" class="ribbon-item">
                                <div class="ribbon-icon-wrapper icon-rose">
                                    <i class="bi bi-calendar-check-fill"></i>
                                </div>
                                <span class="ribbon-label">New Rental</span>
                            </a>
                        }
                        @if (QaShowBarSales && _canViewInsights)
                        {
                            <a href="/finance/insights" class="ribbon-item">
                                <div class="ribbon-icon-wrapper icon-green">
                                    <i class="bi bi-graph-up-arrow"></i>
                                </div>
                                <span class="ribbon-label">Insights</span>
                            </a>
                        }
                        @if (QaShowSchedule && _canViewStaff)
                        {
                            <a href="/admin/staff-shifts" class="ribbon-item">
                                <div class="ribbon-icon-wrapper icon-purple">
                                    <i class="bi bi-calendar-week"></i>
                                </div>
                                <span class="ribbon-label">Schedule</span>
                            </a>
                        }
                    </div>
                }

                <!-- Tier 2: Pulse Center (Smart Alerts) -->
                <div class="pulse-container px-2">
                    @if (_dataHealth == DataHealthStatus.Critical)
                    {
                        <div class="pulse-tile pulse-danger shadow-sm">
                            <div class="pulse-icon"><i class="bi bi-exclamation-octagon-fill"></i></div>
                            <div class="pulse-content">
                                <div class="pulse-title">CRITICAL: Backup Overdue</div>
                                <div class="pulse-message">No backup recorded for over 3 days. Please rotate USB drives immediately.</div>
                            </div>
                            @if (_hasHostingSecurityAccess)
                            {
                                <div class="pulse-action">
                                    <a href="/admin/operations" class="btn btn-sm btn-outline-danger rounded-pill px-3 fw-bold">Fix Now</a>
                                </div>
                            }
                        </div>
                    }



                    @if (_pendingSyncCount > 0)

                    @foreach (var alert in _alertPreview)
                    {
                        <div class="pulse-tile shadow-sm @(alert.SeverityClass.Contains("danger") ? "pulse-danger" : alert.SeverityClass.Contains("warn") ? "pulse-warning" : "pulse-info")">
                            <div class="pulse-icon">
                                <i class="bi @(alert.SeverityClass.Contains("danger") ? "bi-exclamation-triangle-fill" : "bi-bell-fill")"></i>
                            </div>
                            <div class="pulse-content">
                                <div class="pulse-title">@alert.Title</div>
                                <div class="pulse-message">@alert.Message</div>
                            </div>
                        </div>
                    }
                </div>

                <!-- Tier 3: Widget Canvas (Main Data) -->
                <div class="widget-grid px-2">
                    
                    @if (ShowMembershipCard && _canViewMembers)
                    {
                        <div class="gfc-widget" @onclick="NavigateToSearchMember" style="cursor: pointer;">
                            <div class="widget-header">
                                <div class="widget-title">
                                    <i class="bi bi-people widget-icon"></i>
                                    <span>Membership</span>
                                </div>
                                <i class="bi bi-chevron-right text-muted small"></i>
                            </div>
                            <div class="widget-body">
                                <div class="kpi-value">@totalMembers</div>
                                <div class="kpi-label">Total GFC Members</div>
                                <div class="mt-3 d-flex gap-3">
                                    <div>
                                        <div class="small fw-bold">@activeMembers</div>
                                        <div class="extra-small text-muted">Active</div>
                                    </div>
                                    <div>
                                        <div class="small fw-bold text-danger">@overdueCount</div>
                                        <div class="extra-small text-muted">Overdue</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }

                    @if (ShowAccessControlCard && _canManageControllers)
                    {
                        <div class="gfc-widget" @onclick="NavigateToControllerDiagnostics" style="cursor: pointer;">
                            <div class="widget-header">
                                <div class="widget-title">
                                    <i class="bi bi-door-closed widget-icon"></i>
                                    <span>Access Points</span>
                                </div>
                                <span class="badge rounded-pill bg-primary-subtle text-primary border-0 px-2">@_controllerSnapshots.Count Online</span>
                            </div>
                            <div class="widget-body">
                                <div class="d-flex align-items-center justify-content-between mb-3">
                                    <span class="small text-muted fw-bold uppercase-tracking" style="font-size: 0.65rem;">Daily Traffic</span>
                                    <span class="small text-muted" style="font-size: 0.65rem;">@DateTime.Today.ToString("MMM dd")</span>
                                </div>
                                <div class="kpi-split">
                                    <div class="kpi-stat">
                                        <div class="kpi-stat-label">
                                            <i class="bi bi-person-badge text-primary"></i>
                                            <span>Members</span>
                                        </div>
                                        <div class="kpi-stat-value">@(_metrics?.TodaysMemberEntryCount ?? 0)</div>
                                    </div>
                                    <div class="kpi-divider"></div>
                                    <div class="kpi-stat">
                                        <div class="kpi-stat-label">
                                            <i class="bi bi-door-open" style="color: var(--accent-primary);"></i>
                                            <span>Buzzed In</span>
                                        </div>
                                        <div class="kpi-stat-value" style="color: var(--accent-primary);">@(_metrics?.TodaysBuzzedInCount ?? 0)</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }

                    @if (ShowBarSalesCard && _canViewInsights)
                    {
                        <div class="gfc-widget" @onclick='() => NavMgr.NavigateTo("/finance/insights")' style="cursor: pointer;">
                            <div class="widget-header">
                                <div class="widget-title">
                                    <i class="bi bi-graph-up-arrow widget-icon text-success"></i>
                                    <span>Financial Insights</span>
                                </div>
                            </div>
                            <div class="widget-body">
                                <div class="kpi-value text-success">@(_metrics?.WeeklyBarSales.ToString("C") ?? "$0.00")</div>
                                <div class="kpi-label">Sales This Week</div>
                                <div class="kpi-trend @(_metrics?.WeeklyBarSalesTrend >= 0 ? "trend-up" : "trend-down") mt-2">
                                    <i class="bi @(_metrics?.WeeklyBarSalesTrend >= 0 ? "bi-arrow-up" : "bi-arrow-down") me-1"></i>
                                    @Math.Abs(_metrics?.WeeklyBarSalesTrend ?? 0).ToString("N1")% vs last week
                                </div>
                            </div>
                        </div>
                    }

                    @if (ShowEventsCard && _canManageRentals && _upcomingRentals.Any())
                    {
                        <div class="gfc-widget" @onclick='() => NavMgr.NavigateTo("/admin/hall-management")' style="cursor: pointer;">
                            <div class="widget-header">
                                <div class="widget-title">
                                    <i class="bi bi-calendar-event widget-icon text-info"></i>
                                    <span>Hall Rentals</span>
                                </div>
                                <span class="badge rounded-pill bg-info-subtle text-info border-0 px-2">@_upcomingRentals.Count Upcoming</span>
                            </div>
                            <div class="widget-body">
                                <div class="list-group list-group-flush border-0">
                                    @foreach (var rental in _upcomingRentals.Take(2))
                                    {
                                        <div class="list-group-item px-0 py-2 border-0 bg-transparent">
                                            <div class="d-flex justify-content-between">
                                                <span class="fw-bold small">@rental.ApplicantName</span>
                                                <span class="extra-small text-muted">@rental.RequestedDate.ToString("MMM dd")</span>
                                            </div>
                                            <div class="extra-small text-muted">@rental.StartTime</div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }

                    @if (ShowMissingReportsCard && _canViewShiftAlerts && _missingShifts.Any())
                    {
                        <div class="gfc-widget">
                            <div class="widget-header">
                                <div class="widget-title">
                                    <i class="bi bi-clock-history widget-icon text-warning"></i>
                                    <span>Missing Reports</span>
                                </div>
                                <span class="badge rounded-pill bg-warning-subtle text-warning border-0 px-2">@_missingShifts.Count Alert(s)</span>
                            </div>
                            <div class="widget-body">
                                <div class="kpi-value text-warning">@_missingShifts.Count</div>
                                <div class="kpi-label">Shifts pending entry</div>
                                <div class="list-group list-group-flush border-0 mt-3">
                                    @foreach (var shift in _missingShifts.Take(2))
                                    {
                                        <a href="/mobile/shift-report?date=@(shift.Date.ToString("yyyy-MM-dd"))&shift=@(shift.ShiftType)" class="d-flex align-items-center gap-2 py-2 text-decoration-none border-bottom border-light dash-card-action px-2 rounded-2 mt-1">
                                            <i class="bi bi-exclamation-circle-fill text-warning small"></i>
                                            <span class="small text-dark text-truncate flex-grow-1">@shift.Message</span>
                                            <i class="bi bi-chevron-right extra-small text-muted"></i>
                                        </a>
                                    }
                                    @if (_missingShifts.Count > 2)
                                    {
                                        <a href="/mobile/shift-report" class="small text-muted fst-italic mt-2 d-block text-decoration-none px-2">+ @(_missingShifts.Count - 2) more...</a>
                                    }
                                </div>
                            </div>
                        </div>
                    }

                    @if (ShowBartendersCard && _canViewStaff && _metrics?.TonightBartenders.Any() == true)
                    {
                        <div class="gfc-widget">
                            <div class="widget-header">
                                <div class="widget-title">
                                    <i class="bi bi-person-badge widget-icon text-purple"></i>
                                    <span>Tonight's Staff</span>
                                </div>
                            </div>
                            <div class="widget-body">
                                <div class="d-flex flex-wrap gap-2">
                                    @foreach (var staff in _metrics.TonightBartenders)
                                    {
                                        <div class="d-flex align-items-center gap-2 p-2 bg-light rounded-3 flex-grow-1">
                                            <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 24px; height: 24px; font-size: 0.7rem;">
                                                @staff.Name.Substring(0, 1)
                                            </div>
                                            <div class="small fw-semibold">@staff.Name</div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }

                </div>
            </div>
        }
    </div>
}

<!-- Modern Customization Side Panel -->
<div class="dash-custom-panel @(_showSettingsPanel ? "is-open" : "")">
    <div class="custom-panel-overlay" @onclick="ToggleSettingsPanel"></div>
    <div class="custom-panel-content shadow-lg">
        <div class="panel-header">
            <div>
                <h5 class="mb-1 fw-bold">Customize Dashboard</h5>
                <p class="small text-muted mb-0">Drag to reorder or toggle visibility</p>
            </div>
            <button type="button" class="btn-close" @onclick="ToggleSettingsPanel"></button>
        </div>
        <div class="panel-body p-4">
            <div class="custom-section mb-4">
                <label class="fw-bold small text-uppercase text-muted mb-3 d-block">Main Widgets</label>
                <div class="d-grid gap-2">
                    @if (_canViewMembers)
                    {
                        <div class="custom-toggle-item p-3 border rounded-3 d-flex justify-content-between align-items-center">
                            <div>
                                <div class="fw-semibold">Membership</div>
                                <div class="extra-small text-muted">Overview of members and dues</div>
                            </div>
                            <div class="form-check form-switch m-0">
                                <input class="form-check-input" type="checkbox" role="switch" @bind="ShowMembershipCard" @bind:after="SavePreferencesAsync">
                            </div>
                        </div>
                    }
                    @if (_canManageControllers)
                    {
                        <div class="custom-toggle-item p-3 border rounded-3 d-flex justify-content-between align-items-center">
                            <div>
                                <div class="fw-semibold">Access Points</div>
                                <div class="extra-small text-muted">Controller status and entry logs</div>
                            </div>
                            <div class="form-check form-switch m-0">
                                <input class="form-check-input" type="checkbox" role="switch" @bind="ShowAccessControlCard" @bind:after="SavePreferencesAsync">
                            </div>
                        </div>
                    }
                    @if (_canViewInsights)
                    {
                        <div class="custom-toggle-item p-3 border rounded-3 d-flex justify-content-between align-items-center">
                            <div>
                                <div class="fw-semibold">Financial Insights</div>
                                <div class="extra-small text-muted">Performance analytics and trends</div>
                            </div>
                            <div class="form-check form-switch m-0">
                                <input class="form-check-input" type="checkbox" role="switch" @bind="ShowBarSalesCard" @bind:after="SavePreferencesAsync">
                            </div>
                        </div>
                    }
                    @if (_canViewShiftAlerts)
                    {
                        <div class="custom-toggle-item p-3 border rounded-3 d-flex justify-content-between align-items-center">
                            <div>
                                <div class="fw-semibold">Missing Reports</div>
                                <div class="extra-small text-muted">Alerts when shifts are not submitted</div>
                            </div>
                            <div class="form-check form-switch m-0">
                                <input class="form-check-input" type="checkbox" role="switch" @bind="ShowMissingReportsCard" @bind:after="SavePreferencesAsync">
                            </div>
                        </div>
                    }
                </div>
            </div>

            <div class="custom-section">
                <label class="fw-bold small text-uppercase text-muted mb-3 d-block">Quick Action Ribbon</label>
                <div class="row g-2">
                    @if (_canAddMember)
                    {
                        <div class="col-6">
                            <div class="form-check panel-check p-3 border rounded-3">
                                <input class="form-check-input ms-0 me-2" type="checkbox" @bind="QaShowAddMember" @bind:after="SavePreferencesAsync" id="qa-add-mem">
                                <label class="form-check-label fw-semibold" for="qa-add-mem">Add Member</label>
                            </div>
                        </div>
                    }
                    @if (_canManageControllers)
                    {
                        <div class="col-6">
                            <div class="form-check panel-check p-3 border rounded-3">
                                <input class="form-check-input ms-0 me-2" type="checkbox" @bind="QaShowOpenDoor" @bind:after="SavePreferencesAsync" id="qa-door">
                                <label class="form-check-label fw-semibold" for="qa-door">Open Door</label>
                            </div>
                        </div>
                    }
                    @if (_canViewInsights)
                    {
                        <div class="col-6">
                            <div class="form-check panel-check p-3 border rounded-3">
                                <input class="form-check-input ms-0 me-2" type="checkbox" @bind="QaShowBarSales" @bind:after="SavePreferencesAsync" id="qa-bar">
                                <label class="form-check-label fw-semibold" for="qa-bar">Insights</label>
                            </div>
                        </div>
                    }
                    @if (_canViewStaff)
                    {
                        <div class="col-6">
                            <div class="form-check panel-check p-3 border rounded-3">
                                <input class="form-check-input ms-0 me-2" type="checkbox" @bind="QaShowSchedule" @bind:after="SavePreferencesAsync" id="qa-sched">
                                <label class="form-check-label fw-semibold" for="qa-sched">Schedule</label>
                            </div>
                        </div>
                    }
                    @if (_canManageKeyCards)
                    {
                        <div class="col-6">
                            <div class="form-check panel-check p-3 border rounded-3">
                                <input class="form-check-input ms-0 me-2" type="checkbox" @bind="QaShowKeyCards" @bind:after="SavePreferencesAsync" id="qa-keys">
                                <label class="form-check-label fw-semibold" for="qa-keys">Key Cards</label>
                            </div>
                        </div>
                    }
                    @if (_canManageRentals)
                    {
                        <div class="col-6">
                            <div class="form-check panel-check p-3 border rounded-3">
                                <input class="form-check-input ms-0 me-2" type="checkbox" @bind="QaShowNewRental" @bind:after="SavePreferencesAsync" id="qa-rent">
                                <label class="form-check-label fw-semibold" for="qa-rent">Rentals</label>
                            </div>
                        </div>
                    }
                    @if (_canViewStudio)
                    {
                        <div class="col-6">
                            <div class="form-check panel-check p-3 border rounded-3">
                                <input class="form-check-input ms-0 me-2" type="checkbox" @bind="QaShowStudio" @bind:after="SavePreferencesAsync" id="qa-studio">
                                <label class="form-check-label fw-semibold" for="qa-studio">Studio</label>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
        <div class="panel-footer p-4 border-top bg-light">
            <button type="button" class="btn btn-primary rounded-pill px-5 fw-bold w-100 shadow-sm" @onclick="ToggleSettingsPanel">Save & Close</button>
        </div>
    </div>
</div>
}

<style>
    .dash-page {
        transition: opacity 0.8s ease, transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
    }
    
    .dash-hidden {
        opacity: 0;
        transform: scale(0.98) translateY(10px);
        pointer-events: none;
        height: 0;
        overflow: hidden;
    }
    
    .dash-visible {
        opacity: 1;
        transform: scale(1) translateY(0);
        pointer-events: auto;
    }

    .dash-fade-in {
        opacity: 0;
        animation: dash-fade-in .25s ease forwards;
    }

    @@keyframes dash-fade-in {
        to {
            opacity: 1;
        }
    }

    .dash-card-action {
        cursor: pointer;
        transition: transform .15s ease, box-shadow .15s ease;
    }

    .dash-card-action:hover,
    .dash-card-action:focus-visible {
        transform: translateY(-3px);
        box-shadow: 0 4px 18px rgba(0, 0, 0, 0.12);
    }

    .dash-card-action:focus-visible {
        outline: 2px solid var(--bs-primary);
        outline-offset: 2px;
    }

    .dash-hover-card {
        transition: transform .15s ease, box-shadow .15s ease;
    }

    .dash-hover-card:hover,
    .dash-hover-card:focus-within {
        transform: translateY(-3px);
        box-shadow: 0 4px 18px rgba(0, 0, 0, 0.12);
    }

    .dash-card-header {
        border-bottom: 1px solid rgba(0, 0, 0, 0.05);
        transition: border-color .2s ease;
    }

    .dash-card-action:hover .dash-card-header,
    .dash-card-action:focus-visible .dash-card-header,
    .dash-hover-card:hover .dash-card-header,
    .dash-hover-card:focus-within .dash-card-header {
        border-color: rgba(0, 0, 0, 0.15);
    }

    .dash-pill-hover {
        transition: background-color .2s ease, transform .15s ease;
    }

    .dash-pill-hover:hover,
