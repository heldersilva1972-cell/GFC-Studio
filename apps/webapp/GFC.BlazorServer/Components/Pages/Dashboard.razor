                                                    @member.Status
                                                </span>
                                            </td>
                                            <td class="text-center">
                                                @if (_drawBoardMemberIds.Contains(member.MemberId))
                                                {
                                                    <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1" style="font-size: 0.7rem;">
                                                        <i class="bi bi-shield-check me-1"></i> BOARD
                                                    </span>
                                                }
                                                else if (_drawPaidMemberIds.Contains(member.MemberId))
                                                {
                                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1" style="font-size: 0.7rem;">
                                                        <i class="bi bi-cash-check me-1"></i> PAID
                                                    </span>
                                                }
                                                else if (_drawIsGracePeriodActive && _drawPrevPaidMemberIds.Contains(member.MemberId))
                                                {
                                                    <span class="badge bg-info-subtle text-info border border-info-subtle px-2 py-1" style="font-size: 0.7rem;">
                                                        <i class="bi bi-hourglass-split me-1"></i> GRACE
                                                    </span>
                                                }
                                                else if (GFC.Core.BusinessRules.MemberStatusHelper.NormalizeStatus(member.Status.ToString()) == "LIFE")
                                                {
                                                    <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-2 py-1" style="font-size: 0.7rem;">
                                                        <i class="bi bi-star-fill me-1"></i> LIFE
                                                    </span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
