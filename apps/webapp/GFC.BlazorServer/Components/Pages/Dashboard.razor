    private async Task LoadDashboardAsync(bool includeSplash)
    {
        _showSplash = includeSplash;
        _isSplashFadingOut = false;
        _isLoading = true;
        _errorMessage = null;
        
        // 1. Kick off all core data fetching tasks IN PARALLEL
        var metricsTask = DashboardMetricsService.GetMetricsAsync();
        var rentalsTask = RentalService.GetRentalRequestsAsync();
        var shiftComplianceTask = _canViewShiftAlerts ? ShiftComplianceService.GetMissingShiftsAsync() : Task.FromResult(new List<MissingShiftAlert>());
        var controllerStatusTask = LoadControllerStatusSafeAsync();
        var controllerModeTask = LoadControllerModeAsync();
        var pendingSyncCountTask = SyncQueueRepository.GetPendingCountAsync();
        var outOfSyncCountTask = Task.Run(() => KeyCardRepository.GetOutOfSyncCount());

        try
        {
            // 2. Wait for the primary dashboard metrics - this is the core content
            _metrics = await metricsTask;
            _isLoading = false;

            // 3. Show the UI shell as soon as data is ready
            if (includeSplash)
            {
                _isSplashFadingOut = true;
                StateHasChanged();
                await Task.Delay(150); // Minimal sync for CSS transition
                _showSplash = false;
            }
            StateHasChanged();

            // 4. Secondary data updates (Wait for these in parallel without blocking primary UI)
            await Task.WhenAll(rentalsTask, shiftComplianceTask, pendingSyncCountTask, outOfSyncCountTask);
            
            var allRentals = await rentalsTask;
            var rentalList = allRentals.ToList();
            _upcomingRentals = rentalList.Where(r => r.Status == RentalStatus.Approved && r.RequestedDate.Date >= DateTime.Today).OrderBy(r => r.RequestedDate).Take(3).ToList();
            _pendingRentalCount = rentalList.Count(r => r.Status == RentalStatus.Pending);

            _missingShifts = await shiftComplianceTask;
            _pendingSyncCount = await pendingSyncCountTask;
            _outOfSyncCount = await outOfSyncCountTask;
            
            // 5. Heavy hardware checks (Don't let an offline controller block the entire page load)
            await controllerStatusTask;
            await controllerModeTask;
            _isSimulationMode = !_useRealControllers;

            // Health & Alerts
            _controllerHealthStatus = ControllerHealthService.GetHealthStatus();
            _controllerOnline = _controllerHealthStatus.IsOnline;
            _dataHealth = await DataProtectionService.GetHealthStatusAsync();

            _alertPreview.Clear();
            _importantAlerts.Clear();
            
            var summary = _metrics?.AlertSummary;
            if (summary != null)
            {
                var preview = BuildAlertPreview(summary);
                _alertPreview.AddRange(preview);
                _importantAlerts.AddRange(preview);
            }

            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"[Dashboard] Critical: {ex.Message}");
            _isLoading = false;
            StateHasChanged();
        }
    }

    private async Task RefreshAsync()
    {
        if (IsRefreshing || _isLoading)
        {
            return;
        }

        IsRefreshing = true;
        StateHasChanged();

        try
        {
            await LoadDashboardAsync(includeSplash: false);
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"[Dashboard:refresh] {ex}");
            _errorMessage = "Dashboard refresh failed. Please try again.";
        }
        finally
        {
            IsRefreshing = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private string FormatDate(DateTime? value)
    {
        if (value == null)
        {
            return "Not available";
        }

        var clubTime = value.Value.Kind == DateTimeKind.Utc 
            ? TimeZoneInfo.ConvertTimeFromUtc(value.Value, _systemTimeZone)
            : value.Value;

        return clubTime.ToString("MMM d, yyyy h:mm tt");
    }

    private string FormatShort(DateTime? value)
    {
        if (value == null)
        {
            return "Never";
        }

        var clubTime = value.Value.Kind == DateTimeKind.Utc 
            ? TimeZoneInfo.ConvertTimeFromUtc(value.Value, _systemTimeZone)
            : value.Value;

        return clubTime.ToString("MMM d, h:mm tt");
    }

