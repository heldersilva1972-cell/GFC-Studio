    protected override async Task OnInitializedAsync()
    {
        // Check page permissions in parallel with timezone fetching
        var permissionsTask = Task.Run(() => {
            var currentUser = AuthStateProvider.GetCurrentUser();
            if (currentUser != null)
            {
                var userId = currentUser.UserId;
                var isMasterAdmin = currentUser.Username?.Trim().ToLowerInvariant() == "admin";

                _hasHostingSecurityAccess = isMasterAdmin || UserManagementService.UserHasPageAccess(userId, "/admin/operations");
                
                _canViewMembers = isMasterAdmin || UserManagementService.UserHasPageAccess(userId, "/members");
                _canAddMember = isMasterAdmin || UserManagementService.UserHasPageAccess(userId, "/members/new");
                _canRecordDues = isMasterAdmin || UserManagementService.UserHasPageAccess(userId, "/dues");
                _canManageKeyCards = isMasterAdmin || UserManagementService.UserHasPageAccess(userId, "/keycards");
                _canManageControllers = isMasterAdmin || UserManagementService.UserHasPageAccess(userId, "/controllers");
                _canManageRentals = isMasterAdmin || UserManagementService.UserHasPageAccess(userId, "/admin/hall-management");
                _canViewInsights = isMasterAdmin || UserManagementService.UserHasPageAccess(userId, "/finance/insights");
                _canViewStaff = isMasterAdmin || UserManagementService.UserHasPageAccess(userId, "/admin/staff-shifts");
                _canViewStudio = isMasterAdmin || UserManagementService.UserHasPageAccess(userId, "/studio");
                _canViewShiftAlerts = isMasterAdmin || UserManagementService.UserHasPageAccess(userId, "/widgets/shift-sales-alert");
                _canExportData = isMasterAdmin || UserManagementService.UserHasPageAccess(userId, "/export");
                _canPrintDraw = isMasterAdmin || UserManagementService.UserHasPageAccess(userId, "/print-membership-draw");
                _canSubmitEndOfShift = isMasterAdmin || UserManagementService.UserHasPageAccess(userId, "/mobile/shift-report");
                _canViewLottery = isMasterAdmin || UserManagementService.UserHasPageAccess(userId, "/lottery");
                _canViewBills = isMasterAdmin || UserManagementService.UserHasPageAccess(userId, "/finance/bills");
                _canViewBingoReports = isMasterAdmin || UserManagementService.UserHasPageAccess(userId, "/admin/bingo");
                _canViewBingoExpenses = isMasterAdmin || UserManagementService.UserHasPageAccess(userId, "/admin/bingo/expenses");
                _canViewIncomeStreams = isMasterAdmin || UserManagementService.UserHasPageAccess(userId, "/finance/income");
                _canViewEmployeeHours = isMasterAdmin || UserManagementService.UserHasPageAccess(userId, "/finance/employee-hours");
                _canViewPosAudit = isMasterAdmin || UserManagementService.UserHasPageAccess(userId, "/admin/pos-audit");
            }
        });

        var timezoneTask = Task.Run(async () => {
            try {
                var settings = await SystemSettingsService.GetAsync();
                _systemTimeZoneId = settings.SystemTimeZoneId ?? "Eastern Standard Time";
                _systemTimeZone = TimeZoneInfo.FindSystemTimeZoneById(_systemTimeZoneId);
            } catch {
                _systemTimeZone = TimeZoneInfo.FindSystemTimeZoneById("Eastern Standard Time");
            }
        });

        await Task.WhenAll(permissionsTask, timezoneTask);

        bool showSplash = !SessionState.HasShownSplash;
        if (showSplash) SessionState.HasShownSplash = true;
        
        await LoadDashboardAsync(includeSplash: showSplash);
    }

