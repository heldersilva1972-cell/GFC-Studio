            await InvokeAsync(StateHasChanged);
        }
    }

    private string _systemTimeZoneId = "Eastern Standard Time";
    private bool _showDrawListModal = false;
    private List<MemberListItemDto> _drawListMembers = new();
    private HashSet<int> _drawBoardMemberIds = new();
    private HashSet<int> _drawPaidMemberIds = new();
    private HashSet<int> _drawPrevPaidMemberIds = new();
    private bool _drawIsGracePeriodActive = false;
    private bool _drawSortByName = false;

    private void ToggleDrawSort()
    {
        _drawSortByName = !_drawSortByName;
        OpenDrawListModal();
    }

    private async Task OpenDrawListModal()
    {
        _isLoading = true;
        _errorMessage = null;
        StateHasChanged();

        try
        {
            // Lazy load member data ONLY when the modal is requested
            if (_memberList == null || !_memberList.Any())
            {
                var members = await MemberQueryService.GetMembersAsync(new MemberFilterOptions());
                _memberList = members.ToList();
            }

            var currentYear = DateTime.Today.Year;
            
            // Fetch supporting data for Draw logic if not already present
            if (!_drawPaidMemberIds.Any())
            {
                var dues = await Task.Run(() => DuesRepository.GetDuesForYear(currentYear));
                _drawPaidMemberIds = dues.Where(d => !string.Equals(d.PaymentType, "UNPAID", StringComparison.OrdinalIgnoreCase)).Select(d => d.MemberID).ToHashSet();
                
                var board = await Task.Run(() => BoardRepository.GetAssignmentsByYear(currentYear));
                _drawBoardMemberIds = board.Select(a => a.MemberID).Where(id => id != 0).ToHashSet();

                var settings = await Task.Run(() => DuesYearSettingsRepository.GetSettingsForYear(currentYear));
                _graceEndDate = settings?.GraceEndDate;
                _drawIsGracePeriodActive = _graceEndDate.HasValue && DateTime.Today.Date < _graceEndDate.Value.Date;

                if (_drawIsGracePeriodActive)
                {
                    var prevDues = await Task.Run(() => DuesRepository.GetDuesForYear(currentYear - 1));
                    _drawPrevPaidMemberIds = prevDues.Where(d => d.PaidDate.HasValue && !string.Equals(d.PaymentType, "UNPAID", StringComparison.OrdinalIgnoreCase)).Select(d => d.MemberID).ToHashSet();
                }
            }

            var query = _memberList
                .Where(m => {
                    var normalized = GFC.Core.BusinessRules.MemberStatusHelper.NormalizeStatus(m.Status.ToString());
                    if (normalized is "INACTIVE" or "DECEASED") return false;
                    
                    bool paidCurrent = _drawPaidMemberIds.Contains(m.MemberId);
                    bool paidPrev = _drawPrevPaidMemberIds.Contains(m.MemberId);
                    bool isOnBoard = _drawBoardMemberIds.Contains(m.MemberId);
                    
                    return normalized is "LIFE" || isOnBoard || paidCurrent || (_drawIsGracePeriodActive && paidPrev);
                });

            if (_drawSortByName)
                _drawListMembers = query.OrderBy(m => m.FullName).ToList();
            else
                _drawListMembers = query.OrderBy(m => m.MemberId).ToList();

            _showDrawListModal = true;
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"[Dashboard:OpenDrawList] {ex.Message}");
            _errorMessage = $"Failed to generate view list: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private void CloseDrawListModal()
    {
        _showDrawListModal = false;
        _drawListMembers.Clear();
    }

    private TimeZoneInfo _systemTimeZone = TimeZoneInfo.FindSystemTimeZoneById("Eastern Standard Time");
    private bool _hasHostingSecurityAccess = false;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var settings = await SystemSettingsService.GetAsync();
            _systemTimeZoneId = settings.SystemTimeZoneId ?? "Eastern Standard Time";
            _systemTimeZone = TimeZoneInfo.FindSystemTimeZoneById(_systemTimeZoneId);
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"[Dashboard:timezone] {ex.Message}");
            _systemTimeZone = TimeZoneInfo.FindSystemTimeZoneById("Eastern Standard Time"); // Fallback
        }

        bool showSplash = !SessionState.HasShownSplash;
        if (showSplash) SessionState.HasShownSplash = true;
        
        // Check page permissions with error handling
        try
        {
            var currentUser = AuthStateProvider.GetCurrentUser();
            if (currentUser != null)
            {
                var userId = currentUser.UserId;
                _hasHostingSecurityAccess = UserManagementService.UserHasPageAccess(userId, "/admin/operations");
                
