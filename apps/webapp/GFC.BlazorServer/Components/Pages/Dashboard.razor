        {
            return "Never";
        }

        var clubTime = value.Value.Kind == DateTimeKind.Utc 
            ? TimeZoneInfo.ConvertTimeFromUtc(value.Value, _systemTimeZone)
            : value.Value;

        return clubTime.ToString("MMM d, h:mm tt");
    }

