                _canAddMember = UserManagementService.UserHasPageAccess(userId, "/members/new") || _canViewMembers;
                _canRecordDues = UserManagementService.UserHasPageAccess(userId, "/dues");
                _canManageKeyCards = UserManagementService.UserHasPageAccess(userId, "/keycards") || UserManagementService.UserHasPageAccess(userId, "/mobile/keycards");
                _canManageControllers = UserManagementService.UserHasPageAccess(userId, "/controllers");
                _canManageRentals = UserManagementService.UserHasPageAccess(userId, "/admin/hall-management");
                _canViewInsights = UserManagementService.UserHasPageAccess(userId, "/finance/insights");
                _canViewStaff = UserManagementService.UserHasPageAccess(userId, "/admin/staff-shifts");
                _canViewStudio = UserManagementService.UserHasPageAccess(userId, "/studio");
                _canViewShiftAlerts = UserManagementService.UserHasPageAccess(userId, "/widgets/shift-sales-alert");
                _canExportData = UserManagementService.UserHasPageAccess(userId, "/export");
                _canPrintDraw = UserManagementService.UserHasPageAccess(userId, "/print-membership-draw");
                _canSubmitEndOfShift = UserManagementService.UserHasPageAccess(userId, "/mobile/shift-report") || UserManagementService.UserHasPageAccess(userId, "/operations/end-of-shift");
                _canViewLottery = UserManagementService.UserHasPageAccess(userId, "/finance/lottery-analytics");
            }
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"[Dashboard:permissions] {ex.Message}");
            _hasHostingSecurityAccess = false;
        }
        
        await LoadDashboardAsync(includeSplash: showSplash);
    }

