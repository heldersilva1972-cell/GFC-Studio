@page "/np-queue"
@using Microsoft.AspNetCore.Authorization
@using GFC.Core.Interfaces
@attribute [Authorize]
@inject INpQueueService QueueService
@inject IMemberHistoryService HistoryService
@inject GFC.BlazorServer.Services.CustomAuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JSRuntime
@inject ILogger<NpQueue> Logger

<link href="css/np-queue-modern.css" rel="stylesheet" />

<div class="np-queue-container">
    <div class="d-flex justify-content-between align-items-end mb-4 no-print">
        <div>
            <h1 class="page-title mb-1">Non-Portuguese Queue</h1>
            <p class="text-muted mb-0">Monitor and promote members waiting for Regular status.</p>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-outline-secondary rounded-pill px-3 fw-bold d-flex align-items-center gap-2 shadow-sm"
                    @onclick="PrintQueue">
                <i class="bi bi-printer-fill"></i>
                <span>Print List</span>
            </button>
        </div>
    </div>

    @if (!_loading && !_promoting)
    {
        <div class="queue-stats no-print">
            <div class="stat-card">
                <div class="stat-icon icon-queue">
                    <i class="bi bi-list-ol"></i>
                </div>
                <div class="stat-info">
                    <span class="stat-value">@_entries.Count</span>
                    <span class="stat-label">Queue Size</span>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon icon-slots">
                    <i class="bi bi-door-open-fill"></i>
                </div>
                <div class="stat-info">
                    <span class="stat-value">@_slots</span>
                    <span class="stat-label">Slots Available</span>
                </div>
            </div>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(_operationMessage))
    {
        <div class="alert @(_operationError ? "alert-danger" : "alert-success") d-flex align-items-center mb-4 rounded-4 shadow-sm border-0 no-print">
            <i class="bi @(_operationError ? "bi-exclamation-triangle-fill" : "bi-check-circle-fill") me-2 fs-5"></i>
            <div>@_operationMessage</div>
        </div>
    }

    @if (!_loading && GetPriorityEntry() is var priority && priority != null)
    {
        <div class="priority-promotion-section no-print">
            <div class="priority-card">
                <div class="priority-glow"></div>
                <div class="priority-content">
                    <div class="priority-avatar">@priority.FullName.Substring(0, 1)</div>
                    <div class="priority-info">
                        <div class="priority-badge mb-2">Priority Promotion</div>
                        <h4>@priority.FullName</h4>
                        <div class="priority-meta">
                            <span class="meta-item"><i class="bi bi-clock-history"></i> Applied @(priority.ApplicationDate?.ToString("MMM d, yyyy") ?? "--")</span>
                            <span class="meta-item"><i class="bi bi-shield-check text-success"></i> Dues Paid</span>
                            <span class="meta-item"><i class="bi bi-star-fill text-warning"></i> #@priority.Position in Queue</span>
                            @if (priority.OriginalPosition > 0 && priority.OriginalPosition != priority.Position)
                            {
                                <span class="meta-item text-primary"><i class="bi bi-arrow-left-right"></i> (Original #@priority.OriginalPosition)</span>
                            }
                        </div>
                    </div>
                </div>
                <div class="priority-action">
                    <button class="btn btn-promote-priority" 
                            disabled="@_promoting"
                            @onclick="() => BeginPromotion(priority)">
                        <i class="bi bi-person-plus-fill"></i>
                        Promote to Regular
                    </button>
                </div>
            </div>
        </div>
    }

    @if (_loading)
    {
        <div class="modern-card p-5 text-center">
            <div class="spinner-border text-primary mb-3" role="status"></div>
            <p class="text-muted fw-bold">Synchronizing queue records...</p>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <div class="alert alert-danger rounded-4 border-0 shadow-sm">
            <i class="bi bi-exclamation-octagon-fill me-2"></i>
            @_errorMessage
        </div>
    }
    else
    {
        <div class="modern-card">
            <div class="card-header-modern no-print">
                <h5 class="mb-0 fw-bold"><i class="bi bi-people-fill me-2 text-primary"></i>Waiting List</h5>
                <div class="d-flex gap-2">
                    <span class="badge bg-light text-dark border rounded-pill px-3 py-2">@_entries.Count Total</span>
                </div>
            </div>
            <div class="table-responsive-modern">
                <table class="table-modern">
                    <thead>
                        <tr>
                            <th style="width: 70px;">#</th>
                            <th>Member</th>
                            <th>Applied Date</th>
                            <th>Dues Status</th>
                            <th>Queue Position Note</th>
                            <th class="text-end no-print">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (_entries.Count == 0)
                        {
                            <tr>
                                <td colspan="6">
                                    <div class="empty-state-modern">
                                        <div class="empty-state-icon"><i class="bi bi-clipboard2-x"></i></div>
                                        <h5>Queue is Empty</h5>
                                        <p class="mb-0">There are currently no members in the Non-Portuguese waiting list.</p>
                                    </div>
                                </td>
                            </tr>
                        }
                        else
                        {
                            var topCandidate = GetPriorityEntry();
                            @for (int i = 0; i < _entries.Count; i++)
                            {
                                var entry = _entries[i];
                                var isNextUp = !_promoting && topCandidate == null && entry.Position == 1;
                                var canBumpDown = i < _entries.Count - 1;
                                <tr class="@(isNextUp ? "next-up-anim" : "")">
                                    <td>
                                        <div class="position-badge @(entry.Position == 1 ? "position-1" : "")">
                                            @entry.Position
                                        </div>
                                    </td>
                                    <td>
                                        <div class="member-cell">
                                            <div class="member-avatar">@entry.FullName.Substring(0, 1)</div>
                                            <div class="member-name">@entry.FullName</div>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center text-secondary">
                                            <i class="bi bi-calendar-check me-2"></i>
                                            <span class="fw-semibold">@(entry.ApplicationDate?.ToString("MMM d, yyyy") ?? "--")</span>
                                        </div>
                                    </td>
                                    <td>
                                        @if (entry.CurrentYearPaid)
                                        {
                                            <span class="badge-modern badge-paid">
                                                <i class="bi bi-shield-fill-check"></i> Paid
                                            </span>
                                        }
                                        else
                                        {
                                            <div class="d-flex flex-column">
                                                <span class="badge-modern badge-unpaid mb-1">
                                                    <i class="bi bi-shield-fill-exclamation"></i> Unpaid
                                                </span>
                                                @if (entry.MonthsUnpaid.HasValue)
                                                {
                                                    <span class="text-danger small fw-bold ms-1" style="font-size: 0.7rem;">@entry.MonthsUnpaid.Value mo overdue</span>
                                                }
                                            </div>
                                        }
                                    </td>
                                    <td>
                                        @if (entry.OriginalPosition > 0 && entry.OriginalPosition != entry.Position)
                                        {
                                            <span class="badge bg-light text-secondary border px-2 py-1">
                                                <i class="bi bi-arrow-down-right text-warning me-1"></i>Was #@entry.OriginalPosition
                                                @if (entry.BumpCount > 0)
                                                {
                                                    <span class="text-muted ms-1">(@entry.BumpCount@(entry.BumpCount == 1 ? "x" : "x") shifted)</span>
                                                }
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted small fst-italic">Original #@entry.Position</span>
                                        }
                                    </td>
                                    <td class="text-end no-print">
                                        <div class="d-flex justify-content-end align-items-center gap-2">
                                            @if (canBumpDown)
                                            {
                                                <button class="btn btn-outline-warning btn-sm rounded-pill px-2 py-1"
                                                        title="Bump down 1 position"
                                                        disabled="@_promoting"
                                                        @onclick="() => BumpDown(entry)">
                                                    <i class="bi bi-arrow-down"></i> Bump Down
                                                </button>
                                            }

                                            @if (ShowPromoteButton(entry))
                                            {
                                                @if (topCandidate == null || topCandidate.MemberId != entry.MemberId)
                                                {
                                                    <button class="btn btn-primary btn-sm rounded-pill px-3 fw-bold shadow-sm"
                                                            disabled="@_promoting"
                                                            @onclick="() => BeginPromotion(entry)">
                                                        Promote
                                                    </button>
                                                }
                                                else
                                                {
                                                    <span class="text-primary small fw-bold"><i class="bi bi-arrow-up-circle-fill me-1"></i>In Spotlight</span>
                                                }
                                            }
                                            else if (!entry.CurrentYearPaid)
                                            {
                                                <span class="text-muted small fst-italic" title="Dues unpaid"><i class="bi bi-lock-fill me-1"></i>Dues Unpaid</span>
                                            }
                                            else if (_slots == 0)
                                            {
                                                <span class="text-muted small fst-italic"><i class="bi bi-lock-fill me-1"></i>No Slots</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted small fst-italic">In Queue</span>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@if (_pendingPromotion is not null)
{
    <div class="modal-backdrop fade show" style="background: rgba(15, 23, 42, 0.4); backdrop-filter: blur(4px);"></div>
    <div class="modal d-block" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg rounded-4">
                <div class="modal-header border-bottom-0 pt-4 px-4">
                    <h5 class="modal-title fw-800 text-dark">Confirm Promotion</h5>
                    <button type="button" class="btn-close" @onclick="CancelPromotion"></button>
                </div>
                <div class="modal-body px-4 py-3">
                    <div class="d-flex align-items-center mb-3">
                        <div class="bg-primary bg-opacity-10 p-3 rounded-circle me-3">
                            <i class="bi bi-person-up text-primary fs-3"></i>
                        </div>
                        <div>
                            <p class="mb-0 text-muted">Promoting to Regular status</p>
                            <h5 class="mb-0 fw-bold">@_pendingPromotion.FullName</h5>
                        </div>
                    </div>
                    <p class="text-secondary mb-0">
                        This will advance the member from the <strong>Non-Portuguese Queue</strong> to <strong>Regular Status</strong>. This action will be logged in the member's history.
                    </p>
                </div>
                <div class="modal-footer border-top-0 pb-4 px-4">
                    <button type="button" class="btn btn-light rounded-pill px-4 fw-bold" @onclick="CancelPromotion">Cancel</button>
                    <button type="button" class="btn btn-primary rounded-pill px-4 fw-bold" 
                            disabled="@_promoting"
                            @onclick="ConfirmPromotionAsync">
                        @if (_promoting)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        Confirm Promotion
                    </button>
                </div>
            </div>
        </div>
    </div>
}


@code {
    private bool _loading = true;
    private bool _promoting;
    private int _slots;
    private List<NpQueueEntryDto> _entries = new();
    private string? _errorMessage;
    private string? _operationMessage;
    private bool _operationError;
    private NpQueueEntryDto? _pendingPromotion;

    protected override async Task OnInitializedAsync()
    {
        await LoadQueue();
    }

    private async Task LoadQueue()
    {
        _loading = true;
        _errorMessage = null;
        try
        {
            var queueTask = QueueService.GetQueueAsync();
            var slotsTask = QueueService.GetSlotsAvailableAsync();
            await Task.WhenAll(queueTask, slotsTask);
            _entries = queueTask.Result.ToList();
            _slots = slotsTask.Result;
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"[NPQueue] {ex}");
            _errorMessage = "Unable to load the NP queue right now.";
        }
        finally
        {
            _loading = false;
        }
    }

    private void BeginPromotion(NpQueueEntryDto entry)
    {
        _pendingPromotion = entry;
        _operationMessage = null;
        _operationError = false;
    }

    private void CancelPromotion()
    {
        _pendingPromotion = null;
        _promoting = false;
    }

    private async Task ConfirmPromotionAsync()
    {
        if (_pendingPromotion is null)
        {
            return;
        }

        if (!ShowPromoteButton(_pendingPromotion))
        {
            _operationError = true;
            _operationMessage = "This member is no longer eligible for promotion.";
            _pendingPromotion = null;
            return;
        }

        await Promote(_pendingPromotion);
        _pendingPromotion = null;
    }

    private async Task Promote(NpQueueEntryDto entry)
    {
        _promoting = true;
        _operationMessage = null;
        try
        {
            await QueueService.PromoteAsync(entry.MemberId);

            TryLogHistory(entry.MemberId, "Status", "GUEST (NP)", "REGULAR-NP");

            _operationError = false;
            _operationMessage = "Promotion successful! Updating queue list...";
            
            // Close the modal and stop the spinner so the user can see the list
            _pendingPromotion = null;
            _promoting = false;
            StateHasChanged();

            // Give the user a moment to register the modal closing 
            // before the next person animates into the spotlight
            await Task.Delay(1500);

            await LoadQueue();
            _operationMessage = "Member promoted successfully.";
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"[NPQueue:promote] {ex}");
            _operationError = true;
            _operationMessage = "Unable to promote the selected member.";
            _promoting = false;
        }
    }

    private async Task BumpDown(NpQueueEntryDto entry)
    {
        _operationMessage = null;
        try
        {
            await QueueService.BumpDownAsync(entry.MemberId);
            await LoadQueue();
            _operationError = false;
            _operationMessage = $"{entry.FullName} bumped down 1 position.";
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"[NPQueue:bump] {ex}");
            _operationError = true;
            _operationMessage = "Unable to bump the member down.";
        }
    }

    private async Task PrintQueue()
    {
        if (_entries == null || _entries.Count == 0) return;

        var sb = new System.Text.StringBuilder();
        sb.Append("<!DOCTYPE html><html><head><meta charset='utf-8'/><title>Non-Portuguese Waiting List</title>");
        sb.Append("<style>");
        sb.Append("@page { size: letter portrait; margin: 0.5in; }");
        sb.Append("body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; color: #1e293b; margin: 0; padding: 20px; font-size: 10pt; }");
        sb.Append(".header { border-bottom: 2px solid #0f172a; padding-bottom: 12px; margin-bottom: 16px; display: flex; justify-content: space-between; align-items: flex-end; }");
        sb.Append(".title { font-size: 16pt; font-weight: 800; color: #0f172a; margin: 0 0 4px 0; }");
        sb.Append(".meta { font-size: 9pt; color: #64748b; margin: 0; }");
        sb.Append(".stats { text-align: right; font-size: 9pt; color: #475569; }");
        sb.Append(".stats strong { color: #0f172a; }");
        sb.Append("table { width: 100%; border-collapse: collapse; margin-top: 10px; }");
        sb.Append("th { background-color: #f8fafc; color: #334155; font-size: 8.5pt; text-transform: uppercase; letter-spacing: 0.05em; font-weight: 700; text-align: left; padding: 8px 10px; border-bottom: 2px solid #cbd5e1; }");
        sb.Append("td { padding: 9px 10px; border-bottom: 1px solid #e2e8f0; font-size: 9.5pt; vertical-align: middle; }");
        sb.Append("tr:nth-child(even) td { background-color: #fafbfc; }");
        sb.Append(".rank { font-weight: 800; font-size: 11pt; color: #0f172a; width: 40px; text-align: center; }");
        sb.Append(".name { font-weight: 700; color: #0f172a; }");
        sb.Append(".status-paid { color: #166534; font-weight: 700; }");
        sb.Append(".status-unpaid { color: #b91c1c; font-weight: 700; }");
        sb.Append(".history-tag { font-size: 8.5pt; color: #d97706; font-weight: 600; }");
        sb.Append(".footer { margin-top: 25px; padding-top: 10px; border-top: 1px solid #e2e8f0; font-size: 8pt; color: #94a3b8; text-align: center; }");
        sb.Append("</style></head><body>");

        // Header
        sb.Append("<div class='header'>");
        sb.Append("<div>");
        sb.Append("<h1 class='title'>Non-Portuguese Regular Status – Waiting List</h1>");
        sb.Append($"<p class='meta'>Printed on {DateTime.Now:MMMM d, yyyy h:mm tt} for Board Review</p>");
        sb.Append("</div>");
        sb.Append("<div class='stats'>");
        sb.Append($"<div>Total in Queue: <strong>{_entries.Count}</strong></div>");
        sb.Append($"<div>Available Regular Slots: <strong>{_slots}</strong></div>");
        sb.Append("</div>");
        sb.Append("</div>");

        // Table
        sb.Append("<table><thead><tr>");
        sb.Append("<th style='text-align:center;'>#</th>");
        sb.Append("<th>Member Name</th>");
        sb.Append("<th>Applied Date</th>");
        sb.Append("<th>Dues Status</th>");
        sb.Append("<th>Queue History</th>");
        sb.Append("</tr></thead><tbody>");

        foreach (var entry in _entries)
        {
            sb.Append("<tr>");
            sb.Append($"<td class='rank'>#{entry.Position}</td>");
            sb.Append($"<td class='name'>{System.Net.WebUtility.HtmlEncode(entry.FullName)}</td>");
            sb.Append($"<td>{(entry.ApplicationDate?.ToString("MMM d, yyyy") ?? "--")}</td>");

            if (entry.CurrentYearPaid)
            {
                sb.Append("<td class='status-paid'>✓ Paid</td>");
            }
            else
            {
                var overdueText = entry.MonthsUnpaid.HasValue ? $" ({entry.MonthsUnpaid.Value} mo overdue)" : "";
                sb.Append($"<td class='status-unpaid'>✗ Unpaid{overdueText}</td>");
            }

            if (entry.OriginalPosition > 0 && entry.OriginalPosition != entry.Position)
            {
                var shiftText = entry.BumpCount > 0 ? $", {entry.BumpCount}x shifted" : "";
                sb.Append($"<td class='history-tag'>Was #{entry.OriginalPosition}{shiftText}</td>");
            }
            else
            {
                sb.Append("<td style='color: #94a3b8; font-size: 8.5pt;'>Original Position</td>");
            }

            sb.Append("</tr>");
        }

        sb.Append("</tbody></table>");
        sb.Append("<script>window.onload = function() { window.print(); setTimeout(function() { window.close(); }, 750); };</script>");
        sb.Append("</body></html>");

        var jsonHtml = System.Text.Json.JsonSerializer.Serialize(sb.ToString());
        var script = "var printWin = window.open('', '_blank', 'width=850,height=1000'); if (printWin) { printWin.document.write(" + jsonHtml + "); printWin.document.close(); }";
        await JSRuntime.InvokeVoidAsync("eval", script);
    }

    private bool ShowPromoteButton(NpQueueEntryDto entry)
    {
        if (_slots <= 0 || !entry.CurrentYearPaid) return false;
        
        // A member can be promoted if they are the first member in the queue whose dues are paid!
        var firstPaid = _entries.FirstOrDefault(e => e.CurrentYearPaid);
        return firstPaid != null && firstPaid.MemberId == entry.MemberId;
    }

    private NpQueueEntryDto? GetPriorityEntry()
    {
        if (_slots <= 0) return null;
        // Priority spotlight goes to the very first member in the list whose dues are paid
        return _entries.FirstOrDefault(e => e.CurrentYearPaid);
    }

    private void TryLogHistory(int memberId, string field, string? oldValue, string? newValue)
    {
        try
        {
            if (memberId > 0)
            {
                var currentUser = AuthStateProvider.GetCurrentUser();
                var username = currentUser?.Username ?? "Unknown";
                HistoryService.LogChange(memberId, field, oldValue, newValue, username);
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "[NPQueue] Failed to log history for member {Member}", memberId);
        }
    }
}

