@page "/mobile/liquor/checkout"
@using GFC.Core.Interfaces
@using GFC.Core.Models
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject ILiquorService LiquorService
@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation
@inject CustomAuthenticationStateProvider AuthStateProvider
@using GFC.BlazorServer.Components.Shared.Mobile
@implements IAsyncDisposable

<PageTitle>Liquor Checkout - GFC</PageTitle>

<div class="mobile-checkout-container">
    <!-- FIXED TOP SECTION -->
    <div class="header-nav-stack">
        <!-- PREMIUM HEADER -->
        <header class="app-header px-4 py-3 d-flex align-items-center justify-content-between">
            <button class="btn-icon-back" @onclick='() => Navigation.NavigateTo("/mobile")'>
                <i class="bi bi-arrow-left"></i>
            </button>
            <h1 class="h5 mb-0 fw-black">Bottle Checkout</h1>
            <div style="width: 44px;"></div> <!-- Spacer -->
        </header>
    </div>

    <!-- SCROLLABLE CONTENT -->
    <main class="checkout-scroll-area px-4 pt-4">
        @if (_selectedItem == null)
        {
            <div class="checkout-intro text-center mb-4">
                <i class="bi bi-upc-scan display-4 text-primary opacity-50 mb-3 d-block"></i>
                <h2 class="h5 fw-black">Scan to Checkout</h2>
                <p class="small text-muted">Point your camera at the bottle's barcode to remove it from inventory.</p>
            </div>

            <div class="scanner-wrapper mb-4">
                <div id="checkout-scanner" class="checkout-scanner-frame shadow-lg">
                    @if (!_isScannerActive)
                    {
                        <div class="scanner-off-overlay">
                            <button class="btn btn-primary rounded-pill px-4 py-2 fw-black" @onclick="StartScanner">
                                <i class="bi bi-camera me-2"></i> Open Scanner
                            </button>
                        </div>
                    }
                </div>
                <div class="scanner-decoration"></div>
            </div>

            <div class="manual-lookup-box">
                <div class="divider text-uppercase small fw-black text-muted mb-3" style="letter-spacing: 1.5px; font-size: 0.65rem; text-align: center;">Or Enter Manually</div>
                <div class="input-group modern-input-group p-0">
                    <input type="text" class="form-control border-0 bg-transparent py-3 ps-4" @bind="_manualUpc" @bind:event="oninput" @onkeyup="HandleKeyUp" placeholder="UPC Code..." />
                    <button class="btn btn-primary px-4" @onclick="LookupUpc">
                        <i class="bi bi-search"></i>
                    </button>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(_error))
            {
                <div class="error-toast animate-entrance">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                    <span>@_error</span>
                </div>
            }
        }
        else
        {
            <!-- CONFIRMATION VIEW -->
            <div class="confirmation-container animate-entrance">
                <div class="confirmation-card shadow-lg">
                    <div class="confirmation-img-box">
                        @if (!string.IsNullOrEmpty(_selectedItem.ImageUrl))
                        {
                            <img src="@_selectedItem.ImageUrl" alt="@_selectedItem.Name" />
                        }
                        else
                        {
                            <div class="empty-img">
                                <i class="bi bi-bottle"></i>
                            </div>
                        }
                    </div>

                    <div class="confirmation-details text-center">
                        <span class="category-tag">@_selectedItem.Category</span>
                        <h2 class="h3 fw-black mt-2 mb-1">@_selectedItem.Name</h2>
                        <p class="text-muted fw-bold">Size: @_selectedItem.BottleSize</p>
                        
                        <div class="stock-status @(GetStockClass(_selectedItem.CurrentStock)) mt-3">
                            Current Stock: <span class="fw-black">@_selectedItem.CurrentStock items</span>
                        </div>
                    </div>

                    <div class="confirmation-actions mt-4 gap-3 d-grid">
                        <button class="btn btn-app-primary py-3" @onclick="ConfirmCheckout" disabled="@_isProcessing">
                            @if (_isProcessing) { <span class="spinner-border spinner-border-sm me-2"></span> }
                            <i class="bi bi-check-lg me-2"></i> Confirm & Deduct
                        </button>
                        <button class="btn btn-outline-secondary py-3 border-0 fw-bold" @onclick="CancelSelection">
                            Go Back / Rescan
                        </button>
                    </div>
                </div>
                
                <div class="upc-footer text-center mt-3 text-muted small fw-bold">
                    UPC: @_selectedItem.UpcCode
                </div>
            </div>
        }
    </main>

    <!-- BOTTOM TAB BAR -->
    <div class="fixed-bottom-nav">
        <MobileBottomNav ActiveTab="Liquor Checkout" />
    </div>
</div>

<style>
    .mobile-checkout-container {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        display: flex;
        flex-direction: column;
        background-color: var(--app-bg, #f8f9fa);
        overflow: hidden;
    }

    .header-nav-stack {
        flex-shrink: 0;
        z-index: 1000;
        background: white;
        border-bottom: 1px solid rgba(0, 0, 0, 0.1);
    }

    .checkout-scroll-area {
        flex: 1;
        overflow-y: auto;
        -webkit-overflow-scrolling: touch;
        padding-bottom: 90px;
    }

    .fixed-bottom-nav {
        flex-shrink: 0;
        background: white;
        z-index: 1000;
    }
</style>

@if (_showSuccess)
{
    <div class="success-screen-overlay">
        <div class="success-screen-content animate-slide-up">
            <div class="success-lottie animate-bounce">
                <i class="bi bi-check-circle-fill"></i>
            </div>
            <h2 class="h4 fw-black">Checkout Successful!</h2>
            <p class="text-muted mb-4">Inventory for <strong>@_selectedItem?.Name</strong> has been updated.</p>
            
            <div class="d-grid gap-3 w-100 px-4">
                <button class="btn btn-app-primary py-3" @onclick="ResetCheckout">
                    Check Another Bottle
                </button>
                <button class="btn btn-light py-3 fw-bold" @onclick='() => Navigation.NavigateTo("/mobile")'>
                    Return to Hub
                </button>
            </div>
        </div>
    </div>
}

<style>
    .btn-icon-back {
        width: 44px;
        height: 44px;
        border-radius: 12px;
        background: #f1f5f9;
        border: none;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.25rem;
        color: #1e293b;
    }

    /* Checkout Scanner */
    .scanner-wrapper { position: relative; }
    .checkout-scanner-frame {
        width: 100%;
        aspect-ratio: 1;
        background: #000;
        border-radius: 24px;
        overflow: hidden;
        border: 4px solid #fff;
        position: relative;
        z-index: 2;
    }

    .scanner-decoration {
        position: absolute;
        inset: -15px;
        border: 2px solid #e2e8f0;
        border-radius: 40px;
        z-index: 1;
        pointer-events: none;
    }

    .scanner-off-overlay {
        position: absolute;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        background: radial-gradient(circle, #f8fafc, #e2e8f0);
    }

    /* Manual Lookup */
    .manual-lookup-box { margin-top: 2rem; }
    .error-toast {
        margin-top: 1.5rem;
        background: #fee2e2;
        color: #ef4444;
        padding: 12px 20px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        gap: 12px;
        font-weight: 700;
        font-size: 0.9rem;
    }

    /* Confirmation Card */
    .confirmation-card {
        background: #fff;
        border-radius: 32px;
        padding: 24px;
        margin-bottom: 24px;
    }

    .confirmation-img-box {
        width: 120px;
        height: 120px;
        margin: 0 auto 20px;
        background: #f8fafc;
        border-radius: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
    }

    .confirmation-img-box img { width: 100%; height: 100%; object-fit: contain; }
    .confirmation-img-box .empty-img { font-size: 3rem; color: #cbd5e1; }

    .category-tag {
        background: #f1f5f9;
        color: #64748b;
        padding: 4px 12px;
        border-radius: 50px;
        font-size: 0.7rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .stock-status { font-size: 0.85rem; padding: 10px; border-radius: 12px; }
    .stock-status.normal { background: #dcfce7; color: #166534; }
    .stock-status.low { background: #fee2e2; color: #991b1b; }

    /* Success Overlay */
    .success-screen-overlay {
        position: fixed;
        inset: 0;
        background: rgba(255, 255, 255, 0.6);
        backdrop-filter: blur(10px);
        z-index: 4000;
        display: flex;
        align-items: flex-end;
    }

    .success-screen-content {
        background: #fff;
        width: 100%;
        border-radius: 32px 32px 0 0;
        padding: 40px 0 60px;
        text-align: center;
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .success-lottie {
        width: 80px;
        height: 80px;
        background: #dcfce7;
        color: #22c55e;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 3rem;
        margin-bottom: 20px;
    }

    .animate-bounce {
        animation: bounce-in 0.6s cubic-bezier(0.17, 0.67, 0.83, 0.67);
    }

    @@keyframes bounce-in {
        0% { transform: scale(0); }
        50% { transform: scale(1.2); }
        100% { transform: scale(1); }
    }
</style>

@code {
    private bool _isScannerActive = false;
    private bool _isProcessing = false;
    private bool _showSuccess = false;
    private string? _manualUpc;
    private string? _error;
    private LiquorItem? _selectedItem;

    private async Task StartScanner()
    {
        try {
            _error = null;
            _isScannerActive = true;
            StateHasChanged();
            
            await Task.Delay(300);
            await JSRuntime.InvokeVoidAsync("LiquorScanner.start", "checkout-scanner", DotNetObjectReference.Create(this), "OnScanSuccess");
        }
        catch (Exception ex)
        {
            _error = "Scanner Startup Failed: " + ex.Message;
            _isScannerActive = false;
            StateHasChanged();
        }
    }

    private async Task StopScanner()
    {
        _isScannerActive = false;
        await JSRuntime.InvokeVoidAsync("LiquorScanner.stopAllCameras");
    }

    [JSInvokable]
    public async Task OnScanSuccess(string decodedText)
    {
        _manualUpc = decodedText;
        await LookupUpc();
    }

    private async Task HandleKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await LookupUpc();
        }
    }

    private async Task LookupUpc()
    {
        if (string.IsNullOrEmpty(_manualUpc)) return;

        _error = null;
        var item = await LiquorService.GetItemByUpcAsync(_manualUpc);
        if (item != null)
        {
            _selectedItem = item;
            await StopScanner();
        }
        else
        {
            _error = $"UPC '{_manualUpc}' not found in inventory.";
            _manualUpc = "";
        }
        StateHasChanged();
    }

    private async Task ConfirmCheckout()
    {
        if (_selectedItem == null) return;

        _isProcessing = true;
        try
        {
            var user = AuthStateProvider.GetCurrentUser();
            await LiquorService.CheckoutBottleAsync(_selectedItem.Id, user?.UserId ?? 0);
            _showSuccess = true;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _isProcessing = false;
            StateHasChanged();
        }
    }

    private async Task CancelSelection()
    {
        _selectedItem = null;
        _manualUpc = null;
        _error = null;
        await JSRuntime.InvokeVoidAsync("LiquorScanner.stopAllCameras");
        StateHasChanged();
    }

    private async Task ResetCheckout()
    {
        _selectedItem = null;
        _manualUpc = null;
        _showSuccess = false;
        await JSRuntime.InvokeVoidAsync("LiquorScanner.stopAllCameras");
        StateHasChanged();
        await StartScanner();
    }

    private string GetStockClass(int stock) => stock <= 2 ? "low" : "normal";

    public async ValueTask DisposeAsync()
    {
        try {
            await JSRuntime.InvokeVoidAsync("LiquorScanner.stopAllCameras");
        } catch {}
    }
}
