        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        display: flex;
        flex-direction: column;
        background-color: var(--app-bg, #f8f9fa);
        overflow: hidden;
    }

    .header-nav-stack {
        flex-shrink: 0;
        z-index: 1000;
        background: white;
        border-bottom: 1px solid rgba(0, 0, 0, 0.1);
    }

    .manager-scroll-area {
        flex: 1;
        overflow-y: auto;
        -webkit-overflow-scrolling: touch;
        padding-bottom: 90px;
    }

    .fixed-bottom-nav {
        flex-shrink: 0;
        background: white;
        z-index: 1000;
    }

    .staff-avatar {
        width: 40px;
        height: 40px;
        background: var(--app-primary-gradient);
        color: white;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 800;
        font-size: 1.1rem;
    }

    .modal-backdrop-custom {
        position: fixed;
        top: 0; left: 0; right: 0; bottom: 0;
        background: rgba(0,0,0,0.5);
        z-index: 1040;
    }

    .bottom-sheet {
        position: fixed;
        left: 0; right: 0; bottom: 0;
        background: white;
        border-radius: 24px 24px 0 0;
        z-index: 1050;
        padding-bottom: env(safe-area-inset-bottom);
        box-shadow: 0 -10px 40px rgba(0,0,0,0.1);
    }

    .sheet-handle {
        width: 40px;
        height: 4px;
        background: #ddd;
        border-radius: 2px;
        margin: 12px auto;
    }

    .src-opt {
        flex: 1; border: none; padding: 10px; border-radius: 12px;
        background: transparent; color: #888; font-weight: 600; font-size: 0.8rem;
        transition: all 0.2s;
    }
    .src-opt.active { background: white; color: var(--app-primary); box-shadow: 0 2px 8px rgba(0,0,0,0.05); }

    .modern-select { height: 55px; border-radius: 14px; border: 1px solid #eee; background: #f8f9fa; font-weight: 600; }
    
    .search-input {
        background: #f8f9fa;
        border: 1px solid #eee;
        border-radius: 12px;
        padding: 12px 16px;
        font-size: 0.9rem;
        width: 100%;
    }

    .member-list-scroll {
        max-height: 250px;
        overflow-y: auto;
        border: 1px solid #eee;
        border-radius: 12px;
        background: #fff;
    }

