    .member-item.selected .text-muted { color: rgba(255,255,255,0.8) !important; }
</style>

@code {
    private bool _isLoading = true;
    private string _activeTab = "assignments";
    private DateTime _currentDate = DateTime.Today;
    private List<DateTime> _weekDays = new();
    private List<StaffShift> _shifts = new();
    private List<StaffMember> _activeStaff = new();
    private List<Member> _allMembers = new();
    private SystemSettings _settings = new();

    private bool _showAddStaff = false;
    private bool _isMemberMode = false;
    private bool _isSaving = false;
    private string _newStaffName = "";
    private string _selectedMemberId = "0";
    private string _memberSearch = "";

    // Global Settings Temp
    private DateTime _tempDayStart;
    private DateTime _tempDayEnd;
    private DateTime _tempNightStart;
    private DateTime _tempNightEnd;

    // Custom Shift Override
    private bool _showCustomShiftModal = false;
    private StaffShift? _editingShift;
    private DateTime _customTargetDate;
    private int _customTargetType;
    private DateTime _tempCustomStart;
    private DateTime _tempCustomEnd;
    private bool _useCustomTime;

    protected override async Task OnInitializedAsync()
    {
        _currentDate = DateTime.Today.AddDays(-(int)DateTime.Today.DayOfWeek);
        await LoadData();
    }

    private async Task LoadData()
    {
        _isLoading = true;
        _weekDays.Clear();
        for (int i = 0; i < 7; i++) _weekDays.Add(_currentDate.AddDays(i));

        try
        {
            var shifts = await ShiftService.GetShiftsForRangeAsync(_weekDays.First(), _weekDays.Last());
            _shifts = shifts.ToList();
            
            var staff = await ShiftService.GetActiveStaffMembersAsync();
            _activeStaff = staff.ToList();

            _settings = await SystemSettingsService.GetAsync();
            _tempDayStart = DateTime.Today.Add(_settings.DayShiftStartTime);
            _tempDayEnd = DateTime.Today.Add(_settings.DayShiftEndTime);
            _tempNightStart = DateTime.Today.Add(_settings.NightShiftStartTime);
            _tempNightEnd = DateTime.Today.Add(_settings.NightShiftEndTime);

            var members = await Task.Run(() => MemberRepository.GetAllMembers());
            // [FIX] Status check widened to include all active types (REGULAR, LIFE, etc.) 
            var activeStatuses = new[] { "REGULAR", "REGULAR-NP", "LIFE", "Active" };
            _allMembers = members.Where(m => activeStatuses.Contains(m.Status)).OrderBy(m => m.LastName).ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading data: {ex.Message}");
        }

        _isLoading = false;
    }

    private async Task SaveGlobalShiftSettings()
    {
        _isSaving = true;
        try
        {
            _settings.DayShiftStartTime = _tempDayStart.TimeOfDay;
            _settings.DayShiftEndTime = _tempDayEnd.TimeOfDay;
            _settings.NightShiftStartTime = _tempNightStart.TimeOfDay;
            _settings.NightShiftEndTime = _tempNightEnd.TimeOfDay;

            await SystemSettingsService.UpdateAsync(_settings);
            await JSRuntime.InvokeVoidAsync("alert", "Standard settings updated!");
            await LoadData();
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Save failed: {ex.Message}");
        }
        finally
        {
            _isSaving = false;
        }
    }

    private void OpenCustomShiftModal(StaffShift? shift, DateTime date, int type)
    {
        if (shift == null) return;

        _editingShift = shift;
        _customTargetDate = date;
        _customTargetType = type;
        
        if (shift.CustomStartTime.HasValue && shift.CustomEndTime.HasValue)
        {
            _useCustomTime = true;
            _tempCustomStart = shift.CustomStartTime.Value;
            _tempCustomEnd = shift.CustomEndTime.Value;
        }
        else
        {
            _useCustomTime = false;
            var start = type == 1 ? _settings.DayShiftStartTime : _settings.NightShiftStartTime;
            var end = type == 1 ? _settings.DayShiftEndTime : _settings.NightShiftEndTime;
             _tempCustomStart = date.Date.Add(start);
             _tempCustomEnd = date.Date.Add(end);
             if (type == 2 && end < start) _tempCustomEnd = _tempCustomEnd.AddDays(1);
        }

        _showCustomShiftModal = true;
    }

    private async Task SaveCustomShift()
    {
        if (_editingShift == null) return;

        _isSaving = true;
        try
        {
            if (_useCustomTime)
            {
                _editingShift.CustomStartTime = _tempCustomStart;
                _editingShift.CustomEndTime = _tempCustomEnd;
            }
            else
            {
                _editingShift.CustomStartTime = null;
                _editingShift.CustomEndTime = null;
            }

            await ShiftService.UpdateStaffShiftAsync(_editingShift);
            _showCustomShiftModal = false;
            await LoadData();
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", "Failed to update custom times.");
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task AssignShift(DateTime date, int type, ChangeEventArgs e)
    {
        int staffId = int.Parse(e.Value?.ToString() ?? "0");
        var existing = _shifts.FirstOrDefault(s => s.Date.Date == date.Date && s.ShiftType == type);

        try
        {
            if (staffId == 0)
            {
                if (existing != null)
                {
                    await ShiftService.DeleteStaffShiftAsync(existing.Id);
                }
            }
            else if (staffId == -1)
            {
                // Mark as CLOSED
                if (existing != null)
                {
                    existing.StaffMemberId = default;
                    existing.StaffName = "CLOSED";
                    existing.Status = "Closed";
                    await ShiftService.UpdateStaffShiftAsync(existing);
                }
                else
                {
                    var shift = new StaffShift
                    {
                        Date = date,
                        ShiftType = type,
                        StaffMemberId = default,
                        Status = "Closed"
                    };
                    await ShiftService.CreateStaffShiftAsync(shift);
                }
            }
            else
            {
                var staff = _activeStaff.First(s => s.Id == staffId);
                if (existing != null)
                {
                    existing.StaffMemberId = staffId;
                    existing.StaffName = staff.Name;
                    existing.Status = "Scheduled";
                    await ShiftService.UpdateStaffShiftAsync(existing);
                }
                else
                {
                    var shift = new StaffShift
                    {
                        Date = date,
                        ShiftType = type,
                        StaffMemberId = staffId,
                        StaffName = staff.Name,
                        Status = "Scheduled"
                    };
                    await ShiftService.CreateStaffShiftAsync(shift);
                }
            }
            
            // Refresh local list
            var shifts = await ShiftService.GetShiftsForRangeAsync(_weekDays.First(), _weekDays.Last());
            _shifts = shifts.ToList();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Failed to save shift: {ex.Message}");
        }
    }

    private async Task DeactivateStaff(StaffMember staff)
    {
        if (!await JSRuntime.InvokeAsync<bool>("confirm", $"Mark {staff.Name} as inactive?")) return;

        try
        {
            staff.IsActive = false;
            await ShiftService.UpdateStaffMemberAsync(staff);
            await LoadData();
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Error: {ex.Message}");
        }
    }

    private void OpenAddStaff() { _showAddStaff = true; _newStaffName = ""; _selectedMemberId = "0"; _memberSearch = ""; }
    private void CloseModals() { _showAddStaff = false; _memberSearch = ""; }

    private async Task SaveStaff()
    {
        _isSaving = true;
        try
        {
            if (_isMemberMode)
            {
                if (_selectedMemberId == "0") return;
                var member = _allMembers.First(m => m.MemberID == int.Parse(_selectedMemberId));
                var newStaff = new StaffMember
                {
                    Name = FormatMemberName(member),
                    IsActive = true,
                    CreatedAt = DateTime.UtcNow,
                    MemberId = member.MemberID
                };
                await ShiftService.CreateStaffMemberAsync(newStaff);
            }
            else
            {
                if (string.IsNullOrWhiteSpace(_newStaffName)) return;
                var newStaff = new StaffMember
                {
                    Name = _newStaffName,
                    IsActive = true,
                    CreatedAt = DateTime.UtcNow,
                    MemberId = null
                };
                await ShiftService.CreateStaffMemberAsync(newStaff);
            }

            _showAddStaff = false;
            await LoadData();
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Error: {ex.Message}");
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task PrevWeek() { _currentDate = _currentDate.AddDays(-7); await LoadData(); }
    private async Task NextWeek() { _currentDate = _currentDate.AddDays(7); await LoadData(); }

    private string GetShiftTimeString(StaffShift? shift, string type)
    {
        if (shift != null && shift.Status == "Closed")
        {
            return "CLOSED";
        }

        if (shift != null && shift.CustomStartTime.HasValue && shift.CustomEndTime.HasValue)
        {
            return $"{shift.StartTime:htt} - {shift.EndTime:htt} (CUSTOM)";
        }

        if (type == "Day")
        {
            return $"{_settings.DayShiftStartTime.HoursToTime()} - {_settings.DayShiftEndTime.HoursToTime()}";
        }
        else
        {
            return $"{_settings.NightShiftStartTime.HoursToTime()} - {_settings.NightShiftEndTime.HoursToTime()}";
        }
    }
    private string FormatMemberName(Member member)
    {
        var first = member.FirstName?.Trim() ?? "";
        var last = member.LastName?.Trim() ?? "";
        var middle = member.MiddleName?.Trim() ?? "";
        var suffix = member.Suffix?.Trim() ?? "";

        var mFirst = first;
        var mLast = last;
        var mMiddle = string.IsNullOrWhiteSpace(middle) ? "" : " " + middle[0] + ".";
        var mSuffix = string.IsNullOrWhiteSpace(suffix) ? "" : " " + suffix;

        if (string.IsNullOrWhiteSpace(mLast)) return (mFirst + mMiddle + mSuffix).Trim();
        return $"{mLast}, {mFirst}{mMiddle}{mSuffix}".Trim().Replace("  ", " ");
    }
}

@if (_showCustomShiftModal)
{
    <div class="modal fade show d-block animate-entrance" style="background: rgba(0,0,0,0.6); z-index: 2000;">
        <div class="modal-dialog modal-dialog-centered mx-3">
            <div class="modal-content rounded-4 border-0 shadow-lg">
                <div class="modal-header border-0 pb-0">
                    <h6 class="fw-bold mb-0">Custom Shift Time</h6>
                    <button type="button" class="btn-close" @onclick="() => _showCustomShiftModal = false"></button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-light border small text-muted mb-3 py-2">
                        Adjusting shift for <strong>@_editingShift?.StaffName</strong> on @_customTargetDate.ToString("MMM dd").
                    </div>

                    <div class="form-check form-switch mb-3">
                        <input class="form-check-input" type="checkbox" id="useCustomCheck" @bind="_useCustomTime">
                        <label class="form-check-label fw-bold small" for="useCustomCheck">Override Standard Times</label>
                    </div>

                    @if (_useCustomTime)
                    {
                        <div class="row g-2">
                            <div class="col-6">
                                <label class="x-small fw-bold text-uppercase text-muted">Start Time</label>
                                <input type="time" class="form-control" @bind="_tempCustomStart" />
                            </div>
                            <div class="col-6">
                                <label class="x-small fw-bold text-uppercase text-muted">End Time</label>
                                <input type="time" class="form-control" @bind="_tempCustomEnd" />
                            </div>
                        </div>
                        <p class="x-small text-info mt-2 mb-0"><i class="bi bi-info-circle me-1"></i> This applies only to this specific assignment.</p>
                    }
                    else
                    {
                        <div class="p-3 bg-light rounded-3 text-center">
                            <span class="small text-muted">Using System Default:</span><br/>
                            <span class="fw-bold">@(_customTargetType == 1 ? $"{_settings.DayShiftStartTime.HoursToTime()} - {_settings.DayShiftEndTime.HoursToTime()}" : $"{_settings.NightShiftStartTime.HoursToTime()} - {_settings.NightShiftEndTime.HoursToTime()}")</span>
                        </div>
                    }
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button class="btn btn-primary w-100 rounded-pill" @onclick="SaveCustomShift" disabled="@_isSaving">
                        @if (_isSaving) { <span class="spinner-border spinner-border-sm me-1"></span> }
                        Apply Changes
                    </button>
                </div>
            </div>
        </div>
    </div>
}
