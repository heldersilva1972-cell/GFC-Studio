@page "/mobile/manage-schedule"
@using Microsoft.AspNetCore.Authorization
@using GFC.BlazorServer.Auth
@using GFC.Core.Models
@using GFC.BlazorServer.Services
@using GFC.BlazorServer.Data.Entities
@using GFC.Core.Interfaces
@using GFC.BlazorServer.Components.Shared.Mobile
@using GFC.Core.Helpers
@inject NavigationManager Navigation
@inject IShiftService ShiftService
@inject IMemberRepository MemberRepository
@inject CustomAuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JSRuntime
@inject IBlazorSystemSettingsService SystemSettingsService
@attribute [Authorize]

<PageTitle>bartender schedule manager | GFC Staff</PageTitle>

<div class="mobile-manager-container">
    <!-- FIXED TOP SECTION -->
    <div class="header-nav-stack">
        <!-- HEADER -->
        <header class="app-header bg-white border-bottom">
            <div class="container py-3">
                <div class="d-flex flex-column gap-3">
                    <div class="text-center">
                        <h6 class="mb-0 fw-bold header-title" style="letter-spacing: -0.5px;">Bartender schedule manager</h6>
                    </div>
                    <div class="d-flex justify-content-center">
                        <div class="d-flex bg-light rounded-pill p-1 shadow-sm border" style="width: fit-content;">
                            <button class="btn btn-sm @(_activeTab == "assignments" ? "bg-white shadow-sm fw-bold text-primary" : "text-muted")" 
                                    style="border-radius: 50px; padding: 6px 16px; font-size: 0.75rem; border: none; transition: all 0.2s;"
                                    @onclick='() => _activeTab = "assignments"'>Shifts</button>
                            <button class="btn btn-sm @(_activeTab == "roster" ? "bg-white shadow-sm fw-bold text-primary" : "text-muted")" 
                                    style="border-radius: 50px; padding: 6px 16px; font-size: 0.75rem; border: none; transition: all 0.2s;"
                                    @onclick='() => _activeTab = "roster"'>Roster</button>
                            <button class="btn btn-sm @(_activeTab == "rules" ? "bg-white shadow-sm fw-bold text-primary" : "text-muted")" 
                                    style="border-radius: 50px; padding: 6px 16px; font-size: 0.75rem; border: none; transition: all 0.2s;"
                                    @onclick='() => _activeTab = "rules"'>Rules</button>
                        </div>
                    </div>
                </div>
            </div>
        </header>
    </div>

    <!-- SCROLLABLE CONTENT -->
    <main class="manager-scroll-area">
        <div class="container py-4">
            @if (_isLoading)
            {
                <div class="d-flex justify-content-center py-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                </div>
            }
            else
            {
                @if (_activeTab == "assignments")
                {
                    <div class="animate-entrance">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h6 class="fw-bold mb-0">Weekly Assignments</h6>
                            <div class="d-flex gap-2">
                                <button class="btn btn-xs btn-light" @onclick="PrevWeek"><i class="bi bi-chevron-left"></i></button>
                                <span class="small fw-bold">@_currentDate.ToString("MMM dd")</span>
                                <button class="btn btn-xs btn-light" @onclick="NextWeek"><i class="bi bi-chevron-right"></i></button>
                            </div>
                        </div>

                        @foreach (var day in _weekDays)
                        {
                            var dayShifts = _shifts.Where(s => s.Date.Date == day.Date).ToList();
                            var dayShift = dayShifts.FirstOrDefault(s => s.ShiftType == 1);
                            var nightShift = dayShifts.FirstOrDefault(s => s.ShiftType == 2);

                            <div class="manager-day-card mb-4 bg-white rounded-4 border p-3 shadow-sm">
                                <div class="d-flex justify-content-between align-items-center border-bottom pb-2 mb-3">
                                    <span class="fw-black text-primary">@day.ToString("dddd, MMM dd")</span>
                                    @if(day.Date == DateTime.Today) { <span class="badge bg-primary rounded-pill" style="font-size: 0.6rem;">TODAY</span> }
                                </div>

                                <!-- Day Shift Selector -->
                                <div class="mb-3">
                                    <label class="fw-black text-dark text-uppercase mb-1 d-block" style="font-size: 0.7rem; letter-spacing: 0.5px;">
                                        <i class="bi bi-sun-fill text-warning me-1"></i> 
                                        DAY: 
                                        <button class="btn btn-link p-0 text-decoration-none fw-black" style="font-size: 0.7rem; color: inherit;" @onclick="() => OpenCustomShiftModal(dayShift, day, 1)">
                                            @GetShiftTimeString(dayShift, "Day")
                                            <i class="bi bi-pencil-square ms-1 opacity-50"></i>
                                        </button>
                                    </label>
                                    <select class="form-select border shadow-sm @(dayShift?.Status == "Closed" ? "bg-danger bg-opacity-10 text-danger border-danger" : "bg-white text-dark")" 
                                            style='font-weight: 700;'
                                            value="@(dayShift?.Status == "Closed" ? -1 : (dayShift?.StaffMemberId ?? 0))" 
                                            @onchange="(e) => AssignShift(day, 1, e)">
                                        <option value="0">-- Unassigned --</option>
                                        <option value="-1">-- CLOSED --</option>
                                        @foreach (var staff in _activeStaff)
                                        {
                                            <option value="@staff.Id">@staff.Name</option>
                                        }
                                    </select>
                                </div>

                                <!-- Night Shift Selector -->
                                <div>
                                    <label class="fw-black text-dark text-uppercase mb-1 d-block" style="font-size: 0.7rem; letter-spacing: 0.5px;">
                                        <i class="bi bi-moon-stars-fill text-info me-1"></i> 
                                        NIGHT: 
                                        <button class="btn btn-link p-0 text-decoration-none fw-black" style="font-size: 0.7rem; color: inherit;" @onclick="() => OpenCustomShiftModal(nightShift, day, 2)">
                                            @GetShiftTimeString(nightShift, "Night")
                                            <i class="bi bi-pencil-square ms-1 opacity-50"></i>
                                        </button>
                                    </label>
                                    <select class="form-select border shadow-sm @(nightShift?.Status == "Closed" ? "bg-danger bg-opacity-10 text-danger border-danger" : "bg-white text-dark")" 
                                            style='font-weight: 700;'
                                            value="@(nightShift?.Status == "Closed" ? -1 : (nightShift?.StaffMemberId ?? 0))" 
                                            @onchange="(e) => AssignShift(day, 2, e)">
                                        <option value="0">-- Unassigned --</option>
                                        <option value="-1">-- CLOSED --</option>
                                        @foreach (var staff in _activeStaff)
                                        {
                                            <option value="@staff.Id">@staff.Name</option>
                                        }
                                    </select>
                                </div>
                            </div>
                        }
                    </div>
                }
                else if (_activeTab == "roster")
                {
                    <div class="animate-entrance">
                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <h6 class="fw-bold mb-0">Active Bartenders</h6>
                            <button class="btn btn-primary btn-sm rounded-pill px-3" @onclick="OpenAddStaff">
                                <i class="bi bi-plus-lg me-1"></i> Add
                            </button>
                        </div>

                        @if (!_activeStaff.Any())
                        {
                            <div class="text-center py-5 text-muted">
                                <i class="bi bi-people display-4 opacity-25"></i>
                                <p class="mt-2">No staff added to roster.</p>
                            </div>
                        }

                        @foreach (var staff in _activeStaff)
                        {
                            <div class="app-card mb-2" style="padding: 12px 16px;">
                                <div class="d-flex align-items-center gap-3 w-100">
                                    <div class="staff-avatar">@staff.Name[0]</div>
                                    <div style="flex-grow: 1;">
                                        <h6 class="mb-0 fw-bold">@staff.Name</h6>
                                        <span class="text-muted small">@(staff.MemberId.HasValue ? "GFC Member" : "External Staff")</span>
                                    </div>
                                    <button class="btn btn-light btn-sm rounded-circle" style="width: 32px; height: 32px; padding: 0;" @onclick="() => DeactivateStaff(staff)">
                                        <i class="bi bi-person-x text-danger"></i>
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                }
                else if (_activeTab == "rules")
                {
                    <div class="animate-entrance px-2 d-flex flex-column">
                        <div class="d-flex align-items-center mb-4 bg-white p-3 rounded-4 shadow-sm">
                            <div class="bg-primary bg-opacity-10 p-2 rounded-3 me-3" style="width: 40px; height: 40px; display: flex; align-items: center; justify-content: center;">
                                <i class="bi bi-clock-history text-primary"></i>
                            </div>
                            <h6 class="fw-bold mb-0">Standard Shift Rules</h6>
                        </div>

                        <div class="app-card mb-4 border-0 shadow-sm" style="padding: 24px; display: flex; flex-direction: column;">
                            <p class="text-muted small mb-4">Set the default hours for all bartenders. These times will pre-populate new assignments.</p>
                            
                            <!-- Day Shift -->
                            <div class="mb-4">
                                <div class="d-flex align-items-center mb-3">
                                    <div class="bg-warning bg-opacity-10 p-1 rounded-2 me-2">
                                        <i class="bi bi-sun-fill text-warning" style="font-size: 0.8rem;"></i>
                                    </div>
                                    <h6 class="x-small fw-black text-uppercase text-primary mb-0" style="letter-spacing: 0.5px;">Day Shift Defaults</h6>
                                </div>
                                
                                <div class="row g-2">
                                    <div class="col-6">
                                        <div class="p-2 bg-light rounded-3">
                                            <label class="x-small fw-bold text-muted d-block mb-1">START TIME</label>
                                            <input type="time" class="form-control form-control-sm border-0 bg-transparent p-0 fw-bold" @bind="_tempDayStart" />
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <div class="p-2 bg-light rounded-3">
                                            <label class="x-small fw-bold text-muted d-block mb-1">END TIME</label>
                                            <input type="time" class="form-control form-control-sm border-0 bg-transparent p-0 fw-bold" @bind="_tempDayEnd" />
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Night Shift -->
                            <div class="pt-3 border-top">
                                <div class="d-flex align-items-center mb-3">
                                    <div class="bg-info bg-opacity-10 p-1 rounded-2 me-2">
                                        <i class="bi bi-moon-stars-fill text-info" style="font-size: 0.8rem;"></i>
                                    </div>
                                    <h6 class="x-small fw-black text-uppercase text-info mb-0" style="letter-spacing: 0.5px;">Night Shift Defaults</h6>
                                </div>
                                
                                <div class="row g-2">
                                    <div class="col-6">
                                        <div class="p-2 bg-light rounded-3">
                                            <label class="x-small fw-bold text-muted d-block mb-1">START TIME</label>
                                            <input type="time" class="form-control form-control-sm border-0 bg-transparent p-0 fw-bold" @bind="_tempNightStart" />
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <div class="p-2 bg-light rounded-3">
                                            <label class="x-small fw-bold text-muted d-block mb-1">END TIME</label>
                                            <input type="time" class="form-control form-control-sm border-0 bg-transparent p-0 fw-bold" @bind="_tempNightEnd" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <button class="btn btn-app-primary w-100 rounded-pill py-3 shadow-sm fw-bold mb-5" @onclick="SaveGlobalShiftSettings" disabled="@_isSaving">
                            @if (_isSaving) { <span class="spinner-border spinner-border-sm me-2"></span> }
                            Save Shift Defaults
                        </button>
                    </div>
                }
            }
        </div>
    </main>

    <!-- ADD STAFF MODAL -->
    @if (_showAddStaff)
    {
        <div class="modal-backdrop-custom animate-fade-in" @onclick="CloseModals"></div>
        <div class="bottom-sheet animate-slide-up" style="max-height: 90vh; display: flex; flex-direction: column;">
            <div class="sheet-handle"></div>
            <div class="px-4 pb-2 d-flex justify-content-between align-items-center">
                <h5 class="fw-bold mb-0">Add New Bartender</h5>
                <button type="button" class="btn-close" @onclick="CloseModals" aria-label="Close"></button>
            </div>
            
            <div class="p-4" style="overflow-y: auto; flex: 1;">
                <div class="mb-4">
                    <label class="modern-label mb-2">Source Type</label>
                    <div class="d-flex gap-2 p-1 bg-light rounded-4">
                        <button class='src-opt @(!_isMemberMode ? "active" : "")' @onclick='() => _isMemberMode = false'>External</button>
                        <button class='src-opt @(_isMemberMode ? "active" : "")' @onclick='() => _isMemberMode = true'>GFC Member</button>
                    </div>
                </div>

                @if (_isMemberMode)
                {
                    <div class="mb-4 animate-entrance">
                        <label class="modern-label mb-2">Select Member</label>
                        <div class="member-list-scroll shadow-sm" style="max-height: 350px;">
                            @foreach (var member in _allMembers)
                            {
                                <div class="member-item @(_selectedMemberId == member.MemberID.ToString() ? "selected" : "")" 
                                     @onclick="() => _selectedMemberId = member.MemberID.ToString()">
                                    <div>
                                        <div class="fw-bold">@FormatMemberName(member)</div>
                                    </div>
                                    @if (_selectedMemberId == member.MemberID.ToString())
                                    {
                                        <i class="bi bi-check-circle-fill"></i>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                }
                else
                {
                    <div class="mb-4 animate-entrance">
                        <label class="modern-label mb-2">Display Name</label>
                        <input type="text" class="form-control modern-select" placeholder="e.g. John Smith" @bind="_newStaffName" />
                    </div>
                }

                <div class="d-grid gap-2 mt-4">
                    <button class="btn btn-app-primary py-3 fw-bold" @onclick="SaveStaff" disabled="@(_isSaving || (_isMemberMode && _selectedMemberId == "0") || (!_isMemberMode && string.IsNullOrWhiteSpace(_newStaffName)))">
                        @if(_isSaving) { <span class="spinner-border spinner-border-sm me-2"></span> }
                        Add to Roster
                    </button>
                    <button class="btn btn-light py-3 border-0 rounded-4 text-muted" @onclick="CloseModals">Cancel</button>
                </div>
            </div>
        </div>
    }

    <!-- BOTTOM BAR (Same as Schedule for consistency) -->
    <MobileBottomNav ActiveTab="bartender schedule manager" />
</div>

<style>
