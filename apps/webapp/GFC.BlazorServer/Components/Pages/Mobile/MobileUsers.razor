    private void ToggleQuickOnboard()
    {
        _showQuickOnboard = !_showQuickOnboard;
        if (!_showQuickOnboard) ResetInvite();
    }

    private async Task GenerateInvite()
    {
        _generating = true;
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var currentUserId = 0;
            var userIdClaim = authState.User.FindFirst("UserId") ?? authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier);
            if (userIdClaim != null) int.TryParse(userIdClaim.Value, out currentUserId);

            // Final safeguard for station mode: Use the current admin as the initiator
            int targetUserId = _isStationMode ? currentUserId : _selectedUserId;
            if (targetUserId == 0) return;

            // Generate the modern VpnOnboardingToken (1 hour expiry for mobile generated links)
            var token = await VpnService.CreateOnboardingTokenAsync(targetUserId, 1, _isStationMode);
            var baseUrl = await UrlHelper.GetBaseUrlAsync();
            
            // Fix: Use the correct activation route used by the system
            var stationSfx = _isStationMode ? "&station=true" : "";
            _inviteLink = $"{baseUrl.TrimEnd('/')}/setup/activate?token={token}{stationSfx}";
            _showQr = true;
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Failed to generate access link: {ex.Message}");
        }
        finally
        {
            _generating = false;
        }
    }

    private async Task CopyInvite()
    {
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", _inviteLink);
        _copied = true;
        Toast.ShowSuccess("Link copied to clipboard");
        await Task.Delay(2000);
        _copied = false;
    }

    private void ResetInvite()
    {
        _inviteLink = "";
        _selectedUserId = 0;
        _showQr = false;
        _copied = false;
    }

    private async Task ResetUserDevices(UserListItemDto user)
    {
        if (user.Username.ToLower() == "admin") return;
        
        var confirmed = await JS.InvokeAsync<bool>("confirm", $"Are you sure you want to revoke ALL devices and tokens for {user.Username}?");
        if (!confirmed) return;

        try
        {
            await DeviceTrustService.ResetMobileSetupAsync(user.UserId);
            Toast.ShowSuccess($"Devices revoked for {user.Username}");
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Failed to revoke devices: {ex.Message}");
        }
    }

    private async Task ToggleUserStatus(UserListItemDto user)
    {
        if (user.Username.ToLower() == "admin") return;

        var newStatus = !user.IsActive;
        try
        {
            UserService.UpdateUser(user.UserId, user.Username, null, user.MemberId, user.Notes, null, user.IsAdmin, newStatus);
            await LoadUsers(); // Reload to reflect changes
            Toast.ShowSuccess($"User {(newStatus ? "Activated" : "Deactivated")}");
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Failed to update status: {ex.Message}");
        }
    }

    private async Task OpenRoleModal(UserListItemDto user)
    {
        _selectedUser = user;
        _newIsAdmin = user.IsAdmin;
        _newIsDirector = user.IsDirector;
        
        // Load individual permissions
        var perms = await Task.Run(() => UserService.GetUserPagePermissions(user.UserId));
        _selectedPermissions = perms.Select(p => p.PageId).ToHashSet();
        
        _showRoleModal = true;
    }

    private void CloseModals()
    {
        _showRoleModal = false;
        _showAddModal = false;
        _selectedUser = null;
    }

