    .claim-id { font-size: 0.95rem; font-weight: 800; margin: 0; color: #0f172a; }
    .claim-date { font-size: 0.75rem; color: #94a3b8; font-weight: 600; }

    .status-badge {
        font-size: 0.65rem;
        font-weight: 900;
        padding: 4px 10px;
        border-radius: 20px;
        text-transform: uppercase;
    }
    .status-badge.submitted { background: #fef3c7; color: #92400e; }
    .status-badge.paid { background: #dcfce7; color: #166534; }
    .status-badge.rejected { background: #fee2e2; color: #991b1b; }

    .claim-amount .amount { font-size: 1.25rem; font-weight: 900; color: var(--app-primary); display: block; line-height: 1; }
    .claim-amount .items { font-size: 0.7rem; color: #94a3b8; font-weight: 700; }

    .aging-box { font-size: 0.7rem; font-weight: 800; margin-bottom: 2px; }

    /* PREMIUM MODAL */
    .premium-modal-overlay {
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.4);
        backdrop-filter: blur(8px);
        z-index: 2000;
        display: flex;
        align-items: center; /* Center vertically to feel higher */
        justify-content: center;
        padding: 20px;
    }

    .premium-modal-content {
        background: white;
        width: 100%;
        max-width: 450px;
        border-radius: 32px;
