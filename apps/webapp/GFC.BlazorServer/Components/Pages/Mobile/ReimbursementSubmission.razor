    private string GetAgingText(DateTime created)
    {
        var days = (DateTime.UtcNow - created).Days;
        if (days == 0) return "Just now";
        return $"{days}d pending";
    }

    private string GetAgingColorClass(DateTime created)
    {
        var days = (DateTime.UtcNow - created).Days;
        if (days >= 14) return "text-danger";
        if (days >= 7) return "text-warning";
        return "text-success";
    }

    private string GetWizardTitle()
    {
        if (_newItem.Id > 0) return "Edit Expense";
        if (_step == 3) return "Review & Submit";
        if (_step == 1) return _draftItems.Any() ? "Add Another Item" : "New Request";
        return "Add Expense";
    }

    private string GetCategoryName(int categoryId)
    {
        return _categories.FirstOrDefault(c => c.Id == categoryId)?.Name ?? "Unknown";
    }
