    }

    .modal-handle {
        width: 40px;
        height: 5px;
        background: #e2e8f0;
        border-radius: 10px;
        margin: 12px auto;
    }

    .modal-header-modern {
        padding: 0 24px 16px;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .btn-close-modal {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        background: #f1f5f9;
        border: none;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #64748b;
    }

    .modal-body-scrollable {
        padding: 0 24px 24px;
        overflow-y: auto;
    }

    .premium-field {
        background: #f8fafc;
        border: 2px solid #f1f5f9;
        border-radius: 16px;
        font-weight: 600;
        color: #0f172a !important;
        transition: all 0.2s;
    }
    .premium-field:focus {
        border-color: #0ea5e9;
        background: white;
        box-shadow: 0 0 0 4px rgba(14, 165, 233, 0.1);
    }
    .premium-field option { color: #000 !important; }

    .draft-item-card {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 16px;
        padding: 14px;
    }

    .total-card {
        background: linear-gradient(135deg, #bae6fd 0%, #7dd3fc 100%);
        border-radius: 16px;
        padding: 16px 20px;
        border: 2px solid #0369a1;
    }

    .premium-amount-field {
        border: none;
        background: transparent;
        font-size: 2.5rem;
        font-weight: 900;
        padding: 0;
        color: #0f172a;
        width: 100%;
    }
    .premium-amount-field:focus { outline: none; }

    /* Photo Logic */
    .receipt-thumb-box {
        width: 90px;
        height: 90px;
        border-radius: 20px;
        background: #f1f5f9;
        border: 2px dashed #cbd5e1;
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
        overflow: hidden;
        cursor: pointer;
        flex-shrink: 0;
    }
    .receipt-thumb-box .empty-thumb {
        display: flex;
        flex-direction: column;
        align-items: center;
        color: #94a3b8;
        font-size: 0.6rem;
        font-weight: 800;
    }
    .receipt-thumb-box .empty-thumb i { font-size: 2rem; }
    .receipt-thumb-box img { width: 100%; height: 100%; object-fit: cover; }
    
    .edit-overlay {
        position: absolute;
        bottom: 0; left: 0; right: 0;
        background: rgba(0,0,0,0.4);
        color: white;
        font-size: 0.8rem;
        padding: 2px;
        text-align: center;
    }



    .animate-entrance { animation: fadeIn 0.4s ease-out both; }
    .animate-slide-up { animation: slideUp 0.3s cubic-bezier(0.16, 1, 0.3, 1) both; }

    @@keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
    @@keyframes slideUp { from { transform: translateY(100%); } to { transform: translateY(0); } }
</style>

@code {
    private bool _loading = true;
    private bool _saving = false;
    private string _activeTab = "All";
    private int _step = 1;
    private bool _showWizard = false;
    
    private List<ReimbursementRequest> _allRequests = new();
    private List<ReimbursementRequest> _filteredRequests = new();
    private List<ReimbursementCategory> _categories = new();
    private decimal _outstandingBalance = 0;
    private int _pendingCount = 0;
    
    private ReimbursementRequest _request = new();
    private ReimbursementItemDto _newItem = new();
    private string? _receiptPreview;
    private int? _memberId;

    // MULTI-ITEM DRAFT TRACKING
    private int? _currentDraftId = null;
    private List<ReimbursementItemDto> _draftItems = new();
    private decimal _draftTotal = 0;

    // CAMERA LOGIC
    private bool _isLiveCameraMode = false;
    private bool _isUploadingImage = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        _loading = true;
        try
        {
            var user = AuthStateProvider.GetCurrentUser();
            _memberId = user?.MemberId;
            
            _categories = await ReimbursementService.GetCategoriesAsync();
            
            if (!_categories.Any())
            {
                Logger.LogWarning("Mobile categories empty, trying force seed...");
                _categories = await ReimbursementService.ForceSeedCategoriesAsync();
            }

            // UI LEVEL FALLBACK - If DB still fails, show hardcoded list so they aren't stuck
            if (!_categories.Any())
            {
                _categories = new List<ReimbursementCategory>
                {
                    new() { Id = 1, Name = "Supplies" },
                    new() { Id = 2, Name = "Bar / Kitchen" },
                    new() { Id = 3, Name = "Repairs & Maintenance" },
                    new() { Id = 4, Name = "Events" },
                    new() { Id = 5, Name = "Office" },
                    new() { Id = 6, Name = "Other" }
                };
            }

            if (_memberId.HasValue)
            {
                _allRequests = await ReimbursementService.GetRequestsAsync(memberId: _memberId.Value);
                
                Logger.LogInformation("Loaded {CategoryCount} categories and {RequestCount} requests for mobile.", _categories.Count, _allRequests.Count);
                
                _outstandingBalance = _allRequests.Where(r => r.Status == "Submitted").Sum(r => r.TotalAmount);
                _pendingCount = _allRequests.Count(r => r.Status == "Submitted");
                
                ApplyFilter();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load mobile reimbursements");
        }
        finally
        {
            _loading = false;
        }
    }

    private void SetTab(string tab)
    {
        _activeTab = tab;
        ApplyFilter();
    }

    private void ApplyFilter()
    {
        if (_activeTab == "All")
        {
            _filteredRequests = _allRequests;
        }
        else if (_activeTab == "Paid")
        {
            // Show requests that are marked as Paid OR have a PaidDateUtc set
            _filteredRequests = _allRequests.Where(r => r.Status == "Paid" || r.PaidDateUtc != null).ToList();
        }
        else
        {
            _filteredRequests = _allRequests.Where(r => r.Status == _activeTab).ToList();
        }
    }

    private void StartNewRequest()
    {
        _request = new ReimbursementRequest { RequestDate = DateTime.Today };
        _newItem = new ReimbursementItemDto { ExpenseDate = DateTime.Today, Amount = null };
        _receiptPreview = null;
        _currentDraftId = null;
        _draftItems.Clear();
        _draftTotal = 0;
        _step = 1;
        _showWizard = true;
    }

    private void CloseWizard()
    {
        _showWizard = false;
        _isLiveCameraMode = false;
        _currentDraftId = null;
        _draftItems.Clear();
        _draftTotal = 0;
        _ = JSRuntime.InvokeVoidAsync("LiquorScanner.stopAllCameras");
    }

    private void EditRequest(ReimbursementRequest request)
    {
        _request = request;
        if (request.Items.Any())
        {
            var item = request.Items.First();
            _newItem = new ReimbursementItemDto 
            { 
                Id = item.Id,
                Amount = item.Amount, 
                CategoryId = item.CategoryId, 
                Notes = item.Notes,
                ExpenseDate = item.ExpenseDate
            };
        }
        _receiptPreview = null;
        _step = 1;
        _showWizard = true;
    }

    private async Task SaveEdit()
    {
        if (_memberId == null || _newItem.Amount == null || _newItem.Amount <= 0 || _newItem.CategoryId <= 0) return;
        
        _saving = true;
        try
        {
            await ReimbursementService.UpdateRequestAsync(_request.Id, _memberId.Value, new ReimbursementRequestDto { Notes = _newItem.Notes });
            await ReimbursementService.UpdateItemAsync(_newItem.Id, _memberId.Value, _newItem);
            _showWizard = false;
            await LoadData();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to update reimbursement");
            await JSRuntime.InvokeVoidAsync("alert", "Update failed: " + ex.Message);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task StartLiveCamera()
    {
        try {
            _isLiveCameraMode = true;
            StateHasChanged();
            await Task.Delay(300); 
            await JSRuntime.InvokeVoidAsync("LiquorScanner.startLiveCamera", "live-camera-feed");
        }
        catch (Exception ex) {
            Logger.LogError(ex, "Failed to start camera");
            _isLiveCameraMode = false;
            await JSRuntime.InvokeVoidAsync("alert", "Camera Startup Failed. Please check permissions.");
        }
    }

    private async Task StopLiveCamera()
    {
        _isLiveCameraMode = false;
        await JSRuntime.InvokeVoidAsync("LiquorScanner.stopAllCameras");
    }

    private async Task CaptureLivePhoto()
    {
        if (_isUploadingImage) return;
        _isUploadingImage = true;

        try {
            var dataUrl = await JSRuntime.InvokeAsync<string>("LiquorScanner.takeSnapshot");
            if (!string.IsNullOrEmpty(dataUrl)) {
                _receiptPreview = dataUrl;
                _isLiveCameraMode = false;
            }
        } catch (Exception ex) {
            await JSRuntime.InvokeVoidAsync("alert", "Capture Failed: " + ex.Message);
        } finally {
            _isUploadingImage = false;
        }
    }

    private async Task NextStep()
    {
        if (_newItem.CategoryId <= 0)
        {
            await JSRuntime.InvokeVoidAsync("alert", "Please select a category first.");
            return;
        }
        _step = 2;
    }

    private async Task AddItem()
    {
        if (_newItem.Id > 0)
        {
            await SaveEdit();
            return;
        }
        
        if (_memberId == null || _newItem.Amount == null || _newItem.Amount <= 0 || _newItem.CategoryId <= 0) return;
        
        _saving = true;
        try
        {
            // Create draft if this is the first item
            if (_currentDraftId == null)
            {
                var draft = await ReimbursementService.CreateDraftAsync(_memberId.Value);
                _currentDraftId = draft.Id;
            }

            var item = await ReimbursementService.AddItemAsync(_currentDraftId.Value, _newItem);

            if (!string.IsNullOrEmpty(_receiptPreview))
            {
                var base64Data = _receiptPreview.Split(',')[1];
                var bytes = Convert.FromBase64String(base64Data);
                
                using var stream = new MemoryStream(bytes);
                var asset = await MediaService.CreateMediaAssetAsync(stream, $"receipt_{DateTime.UtcNow.Ticks}.jpg", "Reimbursements", "System");
                
                if (asset != null)
                {
                    await ReimbursementService.AddReceiptAsync(item.Id, asset.StoredFileName, $"uploads/{asset.StoredFileName}", _memberId.Value);
                }
            }

            // Add to draft items list
            _draftItems.Add(new ReimbursementItemDto 
            { 
                Id = item.Id,
                Amount = _newItem.Amount, 
                CategoryId = _newItem.CategoryId, 
                Notes = _newItem.Notes,
                ExpenseDate = _newItem.ExpenseDate
            });
            
            _draftTotal = _draftItems.Sum(i => i.Amount ?? 0);
            
            // Move to summary step
            _step = 3;
            _newItem = new ReimbursementItemDto { ExpenseDate = DateTime.Today };
            _receiptPreview = null;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to add item");
            await JSRuntime.InvokeVoidAsync("alert", "Failed to add item: " + ex.Message);
        }
        finally
        {
            _saving = false;
        }
    }

    private void AddAnotherItem()
    {
        _newItem = new ReimbursementItemDto { ExpenseDate = DateTime.Today };
        _receiptPreview = null;
        _step = 1;
    }

    private async Task SubmitAllItems()
    {
        if (_currentDraftId == null || !_draftItems.Any()) return;
        
        _saving = true;
        try
        {
            await ReimbursementService.SubmitAsync(_currentDraftId.Value);
            
            _showWizard = false;
            _currentDraftId = null;
            _draftItems.Clear();
            _draftTotal = 0;
            await LoadData();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to submit request");
            await JSRuntime.InvokeVoidAsync("alert", "Submission failed: " + ex.Message);
        }
        finally
        {
            _saving = false;
        }
    }

