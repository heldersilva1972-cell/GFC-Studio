@code {
    private bool _isLoading = true;
    private bool _showPaymentModal = false;
    private bool _showSuccessModal = false;
    private bool _isSaving = false;
    private bool _hasActiveCard = false;
    private string _filter = "unpaid";
    private string _searchTerm = "";
    private string _paymentMethod = "CASH";
    private string? _lastPaymentMember;
    private decimal _lastPaymentAmount;
    private int _lastPaymentMemberId;
    private int _currentYear = DateTime.Now.Year;

    private List<DuesListItemDto> _allItems = new();
    private DuesSummaryDto? _summary;
    private DuesYearSettings? _currentYearSettings;
    private DuesListItemDto? _paymentTarget;
    private PaymentFormModel _paymentForm = new();
    
    private int _paidCount = 0;
    private int _unpaidCount = 0;
    private int _waivedCount = 0;
    private decimal _totalCollected = 0;

    private class PaymentFormModel 
    {
        public decimal? Amount { get; set; }
        public DateTime PaidDate { get; set; } = DateTime.Today;
        public string PaymentType { get; set; } = "CASH";
        public string? CheckNumber { get; set; }
        public int Year { get; set; }
        public int NumberOfYears { get; set; } = 1;
        public string? Notes { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        _isLoading = true;
        try
        {
            var year = _currentYear;
            
            // 1. Parallel Fetch using the official DuesInsightService (Mirroring Dues.razor)
            var unpaidTask = DuesInsightService.GetDuesAsync(year, false);
            var paidTask = DuesInsightService.GetDuesAsync(year, true);
            var summaryTask = DuesInsightService.GetSummaryAsync(year);
            var settingsTask = Task.Run(() => DuesYearSettingsRepository.GetSettingsForYear(year));
            
            await Task.WhenAll(unpaidTask, paidTask, summaryTask, settingsTask);
            
            _summary = await summaryTask;
            _currentYearSettings = await settingsTask;
            
            var combined = new List<DuesListItemDto>();
            var unpaidItems = await unpaidTask;
            var paidItems = await paidTask;
            
            if (unpaidItems != null) combined.AddRange(unpaidItems);
            if (paidItems != null) combined.AddRange(paidItems);
            
            _allItems = combined.GroupBy(x => x.MemberId).Select(g => g.First()).ToList();

            // 2. Extract stats from official summary
            if (_summary != null)
            {
                _paidCount = _summary.PaidCount;
                _unpaidCount = _summary.UnpaidCount;
                _waivedCount = _summary.WaivedCount;
                _totalCollected = _summary.AmountCollected;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error mirroring dues data: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private IEnumerable<DuesListItemDto> FilteredItems
    {
        get
        {
            if (!string.IsNullOrWhiteSpace(_searchTerm))
            {
                return _allItems.Where(item => item.FullName.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase));
            }

            return _filter switch
            {
                "paid" => _allItems.Where(i => i.Satisfied && !i.IsWaived),
                "unpaid" => _allItems.Where(i => !i.Satisfied),
                "waived" => _allItems.Where(i => i.IsWaived || i.Status == MemberStatus.Life || i.IsBoardMember),
                _ => _allItems
            };
        }
    }

    private bool IsExempt(DuesListItemDto item) =>
        item.Status == MemberStatus.Life || item.IsBoardMember || item.IsWaived;

    private bool CanRecordPayment(DuesListItemDto item) =>
        !item.Satisfied && !IsExempt(item);

    private void OpenPaymentModal(DuesListItemDto item)
    {
        _paymentTarget = item;
        _paymentForm = new PaymentFormModel
        {
            Amount = null,
            Year = _currentYear,
            NumberOfYears = 1,
            PaymentType = "CASH",
            PaidDate = DateTime.Today
        };
        _showPaymentModal = true;
    }

    private void OpenAdvancePaymentModal(DuesListItemDto item)
    {
        _paymentTarget = item;
        _paymentForm = new PaymentFormModel
        {
            Amount = null,
            Year = _currentYear + 1,
            NumberOfYears = 1,
            PaymentType = "CASH",
            PaidDate = DateTime.Today
        };
        _showPaymentModal = true;
    }

    private void CloseModals()
    {
        _showPaymentModal = false;
        _paymentTarget = null;
    }

    private void CloseSuccessModal()
    {
        _showSuccessModal = false;
        _lastPaymentMember = null;
    }

    private async Task PromptSubmitPayment()
    {
        if (_paymentTarget == null) return;

        if (_paymentForm.Amount == null || _paymentForm.Amount <= 0)
        {
            await JSRuntime.InvokeVoidAsync("alert", "Please enter a valid amount greater than 0.");
            return;
        }

        // MIRRORING Dues.razor logic for checks
        var selectedYears = Enumerable.Range(_paymentForm.Year, _paymentForm.NumberOfYears).ToList();
        var existingPaymentsCount = 0;
        foreach (var y in selectedYears)
        {
            var p = await Task.Run(() => DuesRepo.GetDuesForMemberYear(_paymentTarget.MemberId, y));
            if (p != null) existingPaymentsCount++;
        }
        
        bool isLifeMember = _paymentTarget.Status == MemberStatus.Life;
        bool isBoardMember = _paymentTarget.IsBoardMember;
        var waivers = await Task.Run(() => DuesWaiverRepository.GetWaiversForMember(_paymentTarget.MemberId));
        bool hasManualWaiver = waivers.Any(w => selectedYears.Any(y => y >= w.StartYear && y <= w.EndYear));
        bool hasWaivedPayment = false;
        foreach (var y in selectedYears)
        {
            var p = await Task.Run(() => DuesRepo.GetDuesForMemberYear(_paymentTarget.MemberId, y));
            if (p?.PaymentType?.Equals("WAIVED", StringComparison.OrdinalIgnoreCase) == true) hasWaivedPayment = true;
        }
        
        bool isWaived = isLifeMember || isBoardMember || hasManualWaiver || hasWaivedPayment;

        if (isWaived)
        {
             var confirm = await JSRuntime.InvokeAsync<bool>("confirm", 
                $"WARNING: Member has active waiver/exemption. Recording a payment will REMOVE the waiver(s). Proceed?");
             if (!confirm) return;
        }
        else if (existingPaymentsCount > 0)
        {
             var confirm = await JSRuntime.InvokeAsync<bool>("confirm", 
                $"WARNING: Payment(s) already exist for the selected year range. Replace?");
             if (!confirm) return;
        }

        await SubmitPaymentAsync();
    }

    private async Task SubmitPaymentAsync()
    {
        if (_paymentTarget == null) return;
        _isSaving = true;

        try
        {
            var currentUser = AuthStateProvider.GetCurrentUser();
            
            // 1. Record via Service (Mirroring Dues.razor)
            string finalNotes = _paymentForm.Notes ?? "Mobile Entry";
            if (_paymentForm.PaymentType == "CHECK" && !string.IsNullOrWhiteSpace(_paymentForm.CheckNumber))
            {
                finalNotes += $" (Check #{_paymentForm.CheckNumber})";
            }

            decimal yearlyAmount = (_paymentForm.Amount ?? 0m) / _paymentForm.NumberOfYears;

            for (int i = 0; i < _paymentForm.NumberOfYears; i++)
            {
                int currentYear = _paymentForm.Year + i;
                await DuesServiceEF.RecordPaymentAsync(
                    _paymentTarget.MemberId,
                    currentYear,
                    yearlyAmount,
                    _paymentForm.PaidDate,
                    finalNotes,
                    _paymentForm.PaymentType,
                    currentUser?.UserId);

                // 2. Auto-clear waiver
                try 
                {
                   var waivers = await Task.Run(() => DuesWaiverRepository.GetWaiversForMember(_paymentTarget.MemberId));
                   var activeWaiver = waivers.FirstOrDefault(w => currentYear >= w.StartYear && currentYear <= w.EndYear);
                   if (activeWaiver != null)
                   {
                       await Task.Run(() => DuesWaiverRepository.DeleteWaiver(activeWaiver.WaiverId));
                   }
                }
                catch { /* Secondary fail */ }
            }

            // 3. Setup success modal (Mirroring Dues.razor line 1689)
            _lastPaymentMember = _paymentTarget.FullName;
            _lastPaymentAmount = _paymentForm.Amount ?? 0;
            _lastPaymentMemberId = _paymentTarget.MemberId;
            
            var card = await Task.Run(() => KeyCardRepo.GetActiveMemberCard(_paymentTarget.MemberId));
            _hasActiveCard = card != null && card.IsActive;

            _showPaymentModal = false;
            _showSuccessModal = true;
            await LoadData();
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Record failed: {ex.Message}");
        }
        finally
        {
            _isSaving = false;
        }
    }

    private static string GetStatusBadge(MemberStatus status) => status switch {
        MemberStatus.Regular or MemberStatus.RegularNonPortuguese => "bg-success-subtle text-success",
        MemberStatus.Life => "bg-gold-subtle text-gold",
        MemberStatus.Guest => "bg-warning-subtle text-warning",
        MemberStatus.Inactive => "bg-danger-subtle text-danger",
        _ => "bg-light text-muted"
    };

    private static string GetStatusLabel(MemberStatus status) => status.ToString();
    
    private static string FormatOverdueText(int months) => $"{months} mo";

    private bool CanSetInactive(DuesListItemDto item) =>
        !item.Satisfied && !IsExempt(item) && item.MonthsOverdue >= 15 && !_isSaving;

    private async Task ConfirmAndSetInactive(DuesListItemDto item)
    {
         var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", 
            $"CONFIRM DEACTIVATION:\n\n" +
            $"Are you sure you want to deactivate {item.FullName}?\n" +
            $"They are overdue by {item.MonthsOverdue} months.\n\n" +
            $"This will:\n1. Mark member as INACTIVE\n2. Deactivate their Key Card immediately");
            
         if (!confirmed) return;
         
         _isSaving = true;
         try 
         {
             var member = await Task.Run(() => MemberRepository.GetMemberById(item.MemberId));
             if (member != null) 
             {
                 // 1. Set Inactive
                 member.InactiveDate = DateTime.Today;
                 await MemberService.UpdateMemberStatusAsync(member, "INACTIVE", "Mobile User", false);
                 
                 // 2. Log Note
                 var currentUser = AuthStateProvider.GetCurrentUser();
                 await Task.Run(() => GlobalNoteRepository.InsertNote(new GlobalNote {
                     NoteDate = DateTime.Now,
                     Category = "STATUS CHANGE",
                     Text = $"{item.FullName} (ID {item.MemberId}) set inactive on {DateTime.Today:yyyy-MM-dd} for unpaid dues (Mobile Action) by {currentUser?.Username ?? "Unknown"}."
                 }));

                 // 3. Deactivate Key Card
                 var activeCard = await Task.Run(() => KeyCardRepo.GetActiveMemberCard(item.MemberId));
                 if (activeCard != null && activeCard.IsActive)
                 {
                     await KeyCardLifecycleService.DeactivateCardAsync(
                         activeCard.KeyCardId, 
                         "Member Deactivated", 
                         "Dues > Mobile Deactivate Action", 
                         currentUser?.Username ?? "Unknown",
                         CancellationToken.None);
                 }
                 
                 await JSRuntime.InvokeVoidAsync("alert", $"{item.FullName} has been set to INACTIVE.");
             }
             
             await LoadData();
         }
         catch (Exception ex)
         {
             await JSRuntime.InvokeVoidAsync("alert", $"Deactivation failed: {ex.Message}");
         }
         finally
         {
             _isSaving = false;
         }
    }
}
