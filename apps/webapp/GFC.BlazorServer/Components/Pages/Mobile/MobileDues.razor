@page "/mobile/dues"
@using GFC.Core.Interfaces
@using GFC.Core.Models
@using DuesPaymentModel = GFC.Core.Models.DuesPayment
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject IDuesInsightService DuesInsightService
@inject IDuesRepository DuesRepo
@inject IKeyCardRepository KeyCardRepo
@inject IMemberRepository MemberRepository
@inject IDuesYearSettingsRepository DuesYearSettingsRepository
@inject IDuesWaiverRepository DuesWaiverRepository
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject GFC.BlazorServer.Services.DuesService DuesServiceEF
@inject GFC.BlazorServer.Services.CustomAuthenticationStateProvider AuthStateProvider
@inject MemberService MemberService
@inject IGlobalNoteRepository GlobalNoteRepository
@inject KeyCardLifecycleService KeyCardLifecycleService
@using GFC.Core.Enums
@using GFC.BlazorServer.Components.Shared.Mobile


<PageTitle>Dues & Payments | GFC</PageTitle>

<div class="mobile-dues-container">
    <!-- FIXED TOP SECTION -->
    <div class="header-nav-stack">
        <!-- HEADER -->
        <header class="app-header">
            <div class="container py-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div class="d-flex align-items-center justify-content-center w-100">
                        <h6 class="mb-0 fw-bold header-title">Dues & Payments</h6>
                    </div>
                    <div class="badge bg-primary rounded-pill px-3 py-2">
                        @_currentYear
                    </div>
                </div>
            </div>
        </header>

        <!-- FILTERS (LOCKED) -->
        @if (!_isLoading)
        {
            <div class="top-filter-section">
                <div class="container pt-3">
                    <!-- Search Bar -->
                    <div class="mb-3">
                        <input type="text" class="form-control" placeholder="Search members..." @bind="_searchTerm" @bind:event="oninput" />
                    </div>

                    <!-- Clickable Stats Cards - 4 boxes in 2 rows -->
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <div class="stat-card-compact bg-success bg-opacity-10 border-success @(_filter == "paid" ? "active" : "")" 
                                 @onclick='() => _filter = "paid"'>
                                <div class="stat-value-compact text-success">@_paidCount</div>
                                <div class="stat-label-compact">Paid</div>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="stat-card-compact bg-warning bg-opacity-10 border-warning @(_filter == "unpaid" ? "active" : "")" 
                                 @onclick='() => _filter = "unpaid"'>
                                <div class="stat-value-compact text-warning">@_unpaidCount</div>
                                <div class="stat-label-compact">Unpaid</div>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="stat-card-compact bg-info bg-opacity-10 border-info @(_filter == "waived" ? "active" : "")" 
                                 @onclick='() => _filter = "waived"'>
                                <div class="stat-value-compact text-info">@_waivedCount</div>
                                <div class="stat-label-compact">Waived</div>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="stat-card-compact bg-primary bg-opacity-10 border-primary">
                                <div class="stat-value-compact text-primary">$@_totalCollected.ToString("N2")</div>
                                <div class="stat-label-compact">Collected</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- SCROLLABLE CONTENT -->
    <main class="dues-scroll-area">
        @if (_isLoading)
        {
            <div class="d-flex justify-content-center py-5">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
            </div>
        }
        else
        {
            <div class="container py-2">
                @foreach (var item in FilteredItems)
                {
                    <div class="app-card mb-2" style="padding: 12px 16px;">
                        <div class="d-flex align-items-center gap-3 w-100">
                            <div class="member-avatar">@item.FullName[0]</div>
                            <div style="flex-grow: 1;">
                                <h6 class="mb-0 fw-bold">@item.FullName</h6>
                                <div class="d-flex align-items-center gap-2 flex-wrap">
                                    <span class="badge @(item.Satisfied ? (item.IsWaived ? "bg-info" : "bg-success") : "bg-warning")">
                                        @(item.Satisfied ? (item.IsWaived ? "Waived" : "Paid") : "Unpaid")
                                    </span>
                                    @if(item.AdvanceYearsPaid?.Any() == true) {
                                       <span class="badge bg-light text-dark border">
                                           (+ @string.Join(", ", item.AdvanceYearsPaid.Select(y => $"'{y.ToString().Substring(2)}")))
                                       </span>
                                    }
                                    
                                    @if (!item.Satisfied && !item.IsWaived && item.MonthsOverdue > 0)
                                    {
                                         <span class="badge bg-danger-subtle text-danger border border-danger-subtle">
                                            @FormatOverdueText(item.MonthsOverdue)
                                        </span>
                                    }

                                    <span class="badge @GetStatusBadge(item.Status)">
                                        @GetStatusLabel(item.Status)
                                    </span>
                                    @if(item.Status == MemberStatus.Pending && !string.IsNullOrWhiteSpace(item.PendingReason))
                                    {
                                        <div class="w-100 mt-1 mb-1">
                                            <span class="small text-muted" style="font-size: 0.75rem;"><i class="bi bi-clock-history me-1"></i>@item.PendingReason</span>
                                        </div>
                                    }
                                    @if (item.PaidDate.HasValue)
                                    {
                                        <small class="text-muted">@item.PaidDate.Value.ToString("MMM dd")</small>
                                    }
                                    @if (item.Amount.HasValue && item.Amount > 0)
                                    {
                                        <small class="fw-bold text-primary">$@item.Amount</small>
                                    }
                                </div>
                            </div>
                            @if (CanRecordPayment(item))
                            {
                                <button class="btn btn-primary btn-sm rounded-pill px-3" @onclick="() => OpenPaymentModal(item)">
                                    Pay
                                </button>
                            }
                            else if (item.Satisfied && !item.IsWaived) 
                            {
                                <button class="btn btn-outline-success btn-sm rounded-pill px-2" @onclick="() => OpenAdvancePaymentModal(item)">
                                    Advance
                                </button>
                            }
                            else if (CanSetInactive(item))
                            {
                                 <button class="btn btn-outline-danger btn-sm rounded-pill px-3" @onclick="() => ConfirmAndSetInactive(item)">
                                    Deactivate
                                </button>
                            }
                        </div>
                    </div>
                }

                @if (!FilteredItems.Any())
                {
                    <div class="text-center py-5 text-muted">
                        <i class="bi bi-cash-coin display-4 opacity-25"></i>
                        <p class="mt-2">No records found</p>
                    </div>
                }
            </div>
        }
    </main>

    <!-- BOTTOM BAR -->
    <div class="fixed-bottom-nav">
        <MobileBottomNav ActiveTab="Dues" />
    </div>
</div>

<!-- Payment Modal -->
@if (_showPaymentModal && _paymentTarget != null)
{
    <div class="modal-backdrop-custom" @onclick="CloseModals"></div>
    <div class="bottom-sheet">
        <div class="sheet-handle"></div>
        <div class="p-4">
            <h5 class="fw-bold mb-3">Record Payment</h5>
            
            <div class="mb-3">
                <label class="form-label fw-bold">Member</label>
                <div class="p-2 bg-light rounded">
                    <strong>@_paymentTarget.FullName</strong>
                    <div class="small text-muted">Member ID: @_paymentTarget.MemberId</div>
                </div>
            </div>

            <div class="row g-2">
                <div class="col-12">
                    <label class="form-label fw-bold">Amount</label>
                    <div class="input-group">
                        <span class="input-group-text">$</span>
                        <input type="number" step="0.01" inputmode="decimal" class="form-control fw-bold" @bind="_paymentForm.Amount" placeholder="0.00" />
                    </div>
                </div>
                <div class="col-6">
                    <label class="form-label fw-bold">Start Year</label>
                    <select class="form-select" @bind="_paymentForm.Year">
                        @for (int y = DateTime.Now.Year - 1; y <= DateTime.Now.Year + 5; y++)
                        {
                            <option value="@y">@y</option>
                        }
                    </select>
                </div>
                <div class="col-6">
                    <label class="form-label fw-bold">Yrs to Pay</label>
                    <select class="form-select text-primary fw-bold" @bind="_paymentForm.NumberOfYears">
                        @for (int i = 1; i <= 10; i++)
                        {
                            <option value="@i">@i</option>
                        }
                    </select>
                </div>
            </div>

            <div class="mb-3 mt-3">
                <label class="form-label fw-bold">Method</label>
                <select class="form-select" @bind="_paymentForm.PaymentType">
                    <option value="CASH">Cash</option>
                    <option value="CHECK">Check</option>
                    <option value="CREDIT">Credit Card</option>
                    <option value="VENMO">Venmo</option>
                    <option value="ZELLE">Zelle</option>
                    <option value="OTHER">Other</option>
                </select>
            </div>

            @if (_paymentForm.PaymentType == "CHECK")
            {
                <div class="mb-3">
                    <label class="form-label fw-bold">Check #</label>
                    <input type="text" class="form-control" @bind="_paymentForm.CheckNumber" placeholder="e.g. 1045" />
                </div>
            }

            <div class="mb-3">
                <label class="form-label fw-bold">Payment Date</label>
                <input type="date" class="form-control" @bind="_paymentForm.PaidDate" />
            </div>

            <div class="d-grid gap-2">
                <button class="btn btn-app-primary py-3" @onclick="PromptSubmitPayment" disabled="@_isSaving">
                    @if (_isSaving) { <span class="spinner-border spinner-border-sm me-2"></span> }
                    Record Payment
                </button>
                <button class="btn btn-light py-3" @onclick="CloseModals">Cancel</button>
            </div>
        </div>
    </div>
}

<!-- Success Modal (Mirroring Dues.razor) -->
@if (_showSuccessModal && _lastPaymentMember != null)
{
    <div class="modal-backdrop-custom"></div>
    <div class="bottom-sheet">
        <div class="p-5 text-center">
            <div class="mb-4">
                <i class="bi bi-check-circle-fill text-success" style="font-size: 4rem;"></i>
            </div>
            <h3 class="fw-bold">Payment Recorded!</h3>
            <p class="text-muted">Successfully logged $@_lastPaymentAmount.ToString("N0") for @_lastPaymentMember.</p>
            
            @if (!_hasActiveCard)
            {
                <div class="alert alert-warning border-0 shadow-sm text-start mb-4">
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <i class="bi bi-credit-card-2-front-fill fs-5"></i>
                        <strong class="fw-bold">No Key Card Assigned</strong>
                    </div>
                    <p class="mb-0 small">This member has paid their dues but does not have an active key card. Would you like to assign one now?</p>
                </div>
                
                <div class="d-grid gap-2">
                    <button class="btn btn-primary py-3 fw-bold" @onclick='() => Navigation.NavigateTo($"/mobile/keycards?assignTo={_lastPaymentMemberId}")'>
                        <i class="bi bi-credit-card me-2"></i> Yes, Assign & Activate Card
                    </button>
                    <button class="btn btn-light py-3" @onclick="CloseSuccessModal">No, Close</button>
                </div>
            }
            else
            {
                <div class="d-grid gap-2">
                    <button class="btn btn-light py-3" @onclick="CloseSuccessModal">Close</button>
                </div>
            }
        </div>
    </div>
}

