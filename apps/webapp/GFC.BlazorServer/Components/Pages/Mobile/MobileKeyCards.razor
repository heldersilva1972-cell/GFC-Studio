    }
    .filter-chip.active {
        background: var(--app-primary);
        color: white;
        border-color: var(--app-primary);
    }
    .member-avatar {
        width: 40px;
        height: 40px;
        background: var(--app-primary-gradient);
        color: white;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 800;
