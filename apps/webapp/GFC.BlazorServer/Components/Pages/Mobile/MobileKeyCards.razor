@code {
    private bool _isLoading = true;
    private bool _showAssignModal = false;
    private bool _isSaving = false;
    private string _filter = "active";
    private string _searchTerm = "";
    private int _selectedMemberId = 0;
    private string _newCardNumber = "";
    private string _selectedCardType = "Card";
    private string _assignError = string.Empty;
    private string _assignNotes = string.Empty;

    private List<KeyCard> _allCards = new();
    private List<DashboardDisplayRow> _displayCache = new();
    
    private int _countAll = 0;
    private int _activeCount = 0;
    private int _inactiveCount = 0;
    private int _needingCount = 0;

    private class DashboardDisplayRow
    {
        public int CardId { get; set; }
        public string CardNumber { get; set; } = string.Empty;
        public int MemberId { get; set; }
        public string MemberName { get; set; } = string.Empty;
        public string LastName { get; set; } = string.Empty;
        public string FirstName { get; set; } = string.Empty;
        public bool IsActive { get; set; }
        public string MemberStatus { get; set; } = string.Empty;
        public bool IsEligible { get; set; }
        public bool IsDirector { get; set; }
        public bool IsSyncPending { get; set; }
        public bool IsPaid { get; set; }
        public DateTime? DeactivationDate { get; set; }
        public bool IsDelinquent { get; set; }
        public bool InGracePeriod { get; set; }
        public string? DeactivationReason { get; set; }
        public int Year { get; set; }
        
        // Helper for UI grouping
        public bool HasCard => CardId > 0;
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        _isLoading = true;
        StateHasChanged();

        try
        {
            var year = DateTime.Today.Year;
            
            // 1. Fetch data exactly as desktop does
            var dashboardRowsTask = Task.Run(() => KeyCardDashboardRepository.GetMembersForYear(year));
            var cardsTask = Task.Run(() => KeyCardRepo.GetAll());
            var settingsTask = Task.Run(() => DuesYearSettingsRepository.GetSettingsForYear(year));

            await Task.WhenAll(dashboardRowsTask, cardsTask, settingsTask);

            var dashboardRows = await dashboardRowsTask;
            var cards = await cardsTask;
            var settings = await settingsTask;
            var graceDate = settings?.GraceEndDate?.Date;

            // Accurate check for "Has Card" must match KeyCards.razor's logic: 
            // Anyone in the KeyCards table is NOT in the "Needing" list
            var cardMemberIds = cards.Select(c => c.MemberId).Distinct().ToHashSet();

            var cardListData = new List<DashboardDisplayRow>();
            var needingListData = new List<DashboardDisplayRow>();
            
            // Map All Cards
            foreach (var card in cards)
            {
                var row = dashboardRows.FirstOrDefault(r => r.MemberId == card.MemberId);
                var eligibility = row != null 
                    ? CardService.EvaluateEligibilityForRow(row, year, graceDate)
                    : new KeyCardEligibilityResult(false, false, false, false, false, null, "UNKNOWN", "Member record not found");

                cardListData.Add(new DashboardDisplayRow
                {
                    CardId = card.KeyCardId,
                    CardNumber = card.CardNumber,
                    MemberId = card.MemberId,
                    MemberName = row != null ? $"{row.LastName}, {row.FirstName}" : "Unknown Member",
                    LastName = row?.LastName ?? "Unknown",
                    FirstName = row?.FirstName ?? "Unknown",
                    IsActive = card.IsActive,
                    MemberStatus = row?.MemberStatus ?? "Status Unknown",
                    IsEligible = eligibility.Eligible,
                    IsPaid = eligibility.CurrentYearSatisfied,
                    DeactivationDate = eligibility.GraceEndDate,
                    IsDelinquent = !eligibility.Eligible && !eligibility.GracePeriodActive,
                    InGracePeriod = eligibility.GracePeriodActive && eligibility.PreviousYearSatisfied && !eligibility.CurrentYearSatisfied,
                    DeactivationReason = eligibility.Reason,
                    Year = year
                });
            }

            // Map Needing Cards
            foreach (var row in dashboardRows)
            {
                // Skip if they already have a card in the system (matches web logic)
                if (cardMemberIds.Contains(row.MemberId)) continue;

                var eligibility = CardService.EvaluateEligibilityForRow(row, year, graceDate);
                if (eligibility.Eligible)
                {
                    needingListData.Add(new DashboardDisplayRow
                    {
                        MemberId = row.MemberId,
                        MemberName = $"{row.LastName}, {row.FirstName}",
                        LastName = row.LastName,
                        FirstName = row.FirstName,
                        MemberStatus = row.MemberStatus,
                        IsEligible = true,
                        Year = year
                    });
                }
            }

            // Summarize counts to match web exactly
            _countAll = cards.Count;
            _activeCount = cards.Count(c => c.IsActive);
            _inactiveCount = cards.Count(c => !c.IsActive);
            _needingCount = needingListData.Count;

            _allCards = cards.ToList();
            _displayCache = cardListData.Concat(needingListData).ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Critical Error: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private IEnumerable<DashboardDisplayRow> FilteredDisplayRows
    {
        get
        {
            IEnumerable<DashboardDisplayRow> filtered;

            if (_filter == "needing")
            {
                filtered = _displayCache.Where(r => !r.HasCard && r.IsEligible);
            }
            else if (_filter == "active")
            {
                filtered = _displayCache.Where(r => r.HasCard && r.IsActive);
            }
            else if (_filter == "inactive")
            {
                filtered = _displayCache.Where(r => r.HasCard && !r.IsActive);
            }
            else
            {
                filtered = _displayCache.Where(r => r.HasCard);
            }

            if (!string.IsNullOrWhiteSpace(_searchTerm))
            {
                var search = _searchTerm.ToLower();
                filtered = filtered.Where(r => 
                    r.FirstName.ToLower().Contains(search) || 
                    r.LastName.ToLower().Contains(search) ||
                    (r.CardNumber != null && r.CardNumber.Contains(search)));
            }

            return filtered.OrderBy(r => r.LastName).ThenBy(r => r.FirstName);
        }
    }

    private async Task ReactivateMember(int memberId)
    {
        try
        {
            var member = await Task.Run(() => MemberRepository.GetMemberById(memberId));
            if (member != null)
            {
                member.Status = "REGULAR";
                member.StatusChangeDate = DateTime.Now;
                member.InactiveDate = null;
                await Task.Run(() => MemberRepository.UpdateMember(member));
                await LoadData();
                await JSRuntime.InvokeVoidAsync("alert", $"{member.FirstName} has been reactivated to Regular status.");
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Reactivation Error: {ex.Message}");
        }
    }

    private void QuickAssign(DashboardDisplayRow row)
    {
        _selectedMemberId = row.MemberId;
        _newCardNumber = "";
        _assignNotes = "";
        _selectedCardType = "Card";
        _assignError = string.Empty;
        _showAssignModal = true;
    }

    private void OpenAssignModal()
    {
        _selectedMemberId = 0;
        _newCardNumber = "";
        _assignNotes = "";
        _selectedCardType = "Card";
        _assignError = string.Empty;
        _showAssignModal = true;
    }

    private void CloseModals() => _showAssignModal = false;

    private async Task ToggleCardStatus(KeyCard card)
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User.Identity?.Name ?? "Unknown";

            if (card.IsActive)
            {
                await KeyCardLifecycleService.DeactivateCardAsync(card.KeyCardId, "Manual", "Deactivated via Mobile", user);
            }
            else
            {
                await KeyCardLifecycleService.ReactivateCardAsync(card.KeyCardId, "Reactivated via Mobile", user);
            }

            await LoadData();
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Error: {ex.Message}");
        }
    }

    private async Task AssignCard()
    {
        if (_selectedMemberId == 0 || string.IsNullOrWhiteSpace(_newCardNumber))
        {
            _assignError = "Please select a member and a card.";
            return;
        }

        _isSaving = true;
        _assignError = string.Empty;
        try
        {
            // 0. Check for duplicate card
            var existingCard = await Task.Run(() => KeyCardRepo.GetByCardNumber(_newCardNumber));
            if (existingCard != null)
            {
                _assignError = $"Card #{_newCardNumber} is already assigned to another member.";
                _isSaving = false;
                return;
            }

            // 1. Create or Replace the card in the database
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User.Identity?.Name ?? "Unknown";

            // Check if member already has an active card for automatic replacement logic
            var activeCard = await Task.Run(() => KeyCardRepo.GetActiveMemberCard(_selectedMemberId));
            
            KeyCard newCard;
            if (activeCard != null)
            {
                var notes = string.IsNullOrWhiteSpace(_assignNotes) ? "Replaced via Mobile" : _assignNotes;

                // SAFETY: Deactivate and revoke the OLD card from the controller BEFORE we overwrite the database record
                try 
                {
                    await KeyCardLifecycleService.DeactivateCardAsync(activeCard.KeyCardId, "Card Replaced", $"Replaced by new card #{_newCardNumber}", user);
                }
                catch (Exception syncEx)
                {
                    // Ignore and proceed with replacement if revocation queuing fails
                }

                newCard = await Task.Run(() => KeyCardRepo.ReplaceCard(_selectedMemberId, _newCardNumber, notes, _selectedCardType))!;
                if (long.TryParse(_newCardNumber, out long newNum) && long.TryParse(activeCard.CardNumber, out long oldNum))
                {
                    await KeyHistoryService.LogReplacementAsync(_selectedMemberId, oldNum, newNum, notes, user, _selectedCardType);
                }
            }
            else
            {
                var notes = string.IsNullOrWhiteSpace(_assignNotes) ? "Assigned via Mobile" : _assignNotes;
                newCard = await Task.Run(() => KeyCardRepo.Create(_newCardNumber, _selectedMemberId, notes, _selectedCardType));
                if (long.TryParse(_newCardNumber, out long cardNumberLong))
                {
                    await KeyHistoryService.LogAssignmentAsync(_selectedMemberId, cardNumberLong, notes, user, _selectedCardType);
                }
            }

            // 3. Provision Door Access (Default to all enabled doors)
            using var db = await DbFactory.CreateDbContextAsync();
            var availableDoors = await db.Doors.Where(d => d.IsEnabled).ToListAsync();
            if (availableDoors.Any())
            {
                var updates = availableDoors.Select(d => new MemberDoorAccessUpdateDto 
                {
                     DoorId = d.Id,
                     CardNumber = _newCardNumber,
                     IsEnabled = true,
                     TimeProfileId = 1 // Default 24/7
                }).ToList();
                
                await MemberAccessService.UpdateMemberDoorAccessAsync(_selectedMemberId, updates);
            }

            // 4. Push to Physical Hardware (Instant Sync)
            await KeyCardLifecycleService.SyncCardToControllerAsync(newCard!.KeyCardId, true);

            await LoadData();
            CloseModals();
        }
        catch (Exception ex)
        {
            _assignError = $"Error: {ex.Message}";
        }
        finally
        {
            _isSaving = false;
        }
    }

    private static string GetStatusBadge(string status) => status.ToUpper() switch {
        "REGULAR" or "REGULAR-NP" => "bg-success-subtle text-success",
        "LIFE" => "bg-gold-subtle text-gold",
        "GUEST" => "bg-warning-subtle text-warning",
        "INACTIVE" => "bg-danger-subtle text-danger",
        _ => "bg-light text-muted"
    };
}
