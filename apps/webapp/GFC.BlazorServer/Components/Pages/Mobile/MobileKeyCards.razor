@page "/mobile/keycards"
@attribute [Authorize]
@inject IKeyCardRepository KeyCardRepo
@inject IKeyCardDashboardRepository KeyCardDashboardRepository
@inject IMemberRepository MemberRepository
@inject IDuesYearSettingsRepository DuesYearSettingsRepository
@inject IBoardRepository BoardRepository
@inject KeyCardService CardService
@inject NavigationManager NavManager
@inject IJSRuntime JSRuntime
@inject IDuesInsightService DuesInsightService
@inject KeyCardLifecycleService KeyCardLifecycleService
@inject KeyHistoryService KeyHistoryService
@inject AuthenticationStateProvider AuthStateProvider
@inject IDbContextFactory<GfcDbContext> DbFactory
@inject IMemberAccessService MemberAccessService
@using GFC.Core.Interfaces
@using GFC.Core.Models
@using Microsoft.AspNetCore.Authorization
@using GFC.BlazorServer.Components.Shared.Mobile
@using GFC.Core.Services
@using GFC.BlazorServer.Services
@using GFC.BlazorServer.Models
@using GFC.BlazorServer.Data
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.Authorization

<PageTitle>Key Cards | GFC</PageTitle>

<div class="mobile-keycards-container">
    <!-- FIXED TOP SECTION -->
    <div class="header-nav-stack">
        <!-- HEADER -->
        <header class="app-header">
            <div class="container py-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div class="d-flex align-items-center justify-content-center w-100">
                        <h6 class="mb-0 fw-bold header-title">Key Cards</h6>
                    </div>
                    <button class="btn btn-primary btn-sm rounded-pill px-3" @onclick="OpenAssignModal">
                        <i class="bi bi-plus-lg me-1"></i> Assign
                    </button>
                </div>
            </div>
        </header>

        <!-- FILTERS (LOCKED) -->
        @if (!_isLoading)
        {
            <div class="top-filter-section">
                <div class="container pt-3">
                    <!-- Search Bar -->
                    <div class="mb-3">
                        <input type="text" class="form-control" placeholder="Search members..." @bind="_searchTerm" @bind:event="oninput" />
                    </div>

                    <!-- Simplified Stat Filters (Remaining: All, Active, Inactive, Needing) -->
                    <div class="row g-1 mb-3">
                        <div class="col-3">
                            <div class="stat-card-compact bg-primary bg-opacity-10 border-primary @(_filter == "all" ? "active" : "")" 
                                 @onclick='() => _filter = "all"'>
                                <div class="stat-value-compact text-primary">@_countAll</div>
                                <div class="stat-label-compact">All</div>
                            </div>
                        </div>
                        <div class="col-3">
                            <div class="stat-card-compact bg-success bg-opacity-10 border-success @(_filter == "active" ? "active" : "")" 
                                 @onclick='() => _filter = "active"'>
                                <div class="stat-value-compact text-success">@_activeCount</div>
                                <div class="stat-label-compact">Active</div>
                            </div>
                        </div>
                        <div class="col-3">
                            <div class="stat-card-compact bg-secondary bg-opacity-10 border-secondary @(_filter == "inactive" ? "active" : "")" 
                                 @onclick='() => _filter = "inactive"'>
                                <div class="stat-value-compact text-secondary">@_inactiveCount</div>
                                <div class="stat-label-compact">Inact.</div>
                            </div>
                        </div>
                        <div class="col-3">
                            <div class="stat-card-compact bg-warning bg-opacity-10 border-warning @(_filter == "needing" ? "active" : "")" 
                                 @onclick='() => _filter = "needing"'>
                                <div class="stat-value-compact text-warning">@_needingCount</div>
                                <div class="stat-label-compact">Need</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- SCROLLABLE CONTENT -->
    <main class="keycards-scroll-area">
        @if (_isLoading)
        {
            <div class="d-flex justify-content-center py-5">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
            </div>
        }
        else
        {
            <div class="container py-2">
                @if (_filter == "needing")
                {
                    @foreach (var row in FilteredDisplayRows)
                    {
                        <div class="app-card mb-2" style="padding: 12px 16px;">
                            <div class="d-flex align-items-center gap-3 w-100">
                                <div class="member-avatar">@row.LastName[0]</div>
                                <div style="flex-grow: 1;">
                                    <h6 class="mb-0 fw-bold">@row.LastName, @row.FirstName</h6>
                                    @if (row.MemberStatus == "INACTIVE")
                                    {
                                        <div class="badge bg-danger">INACTIVE MEMBER</div>
                                    }
                                    else
                                    {
                                        <small class="text-muted">Eligible for Card</small>
                                    }
                                </div>
                                <div class="d-flex flex-column gap-1">
                                    @if (row.MemberStatus == "INACTIVE")
                                    {
                                        <button class="btn btn-outline-success btn-sm rounded-pill px-3" @onclick="() => ReactivateMember(row.MemberId)">
                                            Activate
                                        </button>
                                    }
                                    <button class="btn btn-primary btn-sm rounded-pill px-3" @onclick="() => QuickAssign(row)">
                                        Assign
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    @foreach (var row in FilteredDisplayRows)
                    {
                        <div class="app-card mb-2" style="padding: 12px 16px;">
                            <div class="d-flex align-items-center gap-3 w-100">
                                <div class="member-avatar">@row.LastName[0]</div>
                                <div style="flex-grow: 1;">
                                    <h6 class="mb-0 fw-bold">@row.LastName, @row.FirstName</h6>
                                    <div class="d-flex align-items-center gap-2 flex-wrap mb-1">
                                        @if (row.IsSyncPending)
                                        {
                                            <span class="badge bg-warning text-dark border border-warning border-opacity-25 rounded-pill">
                                                <i class="bi bi-hourglass-split me-1"></i>
                                                @(row.IsActive ? "Activating..." : "Deactivating...")
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge @(row.IsActive ? "bg-success-subtle text-success" : "bg-danger-subtle text-danger") border border-@(row.IsActive ? "success" : "danger") border-opacity-25 rounded-pill">
                                                @(row.IsActive ? "Active Card" : "Inactive Card")
                                            </span>
                                        }
                                        <span class="badge @GetStatusBadge(row.MemberStatus)">
                                            @row.MemberStatus
                                        </span>
                                    </div>
                                    <div class="d-flex flex-column gap-1">
                                        <small class="text-muted">#@row.CardNumber</small>
                                        
                                        @if (row.IsDelinquent)
                                        {
                                            <small class="text-danger fw-bold"><i class="bi bi-x-circle-fill me-1"></i>DELINQUENT: Revoke Access</small>
                                        }
                                        else if (row.InGracePeriod)
                                        {
                                            <small class="text-warning fw-bold"><i class="bi bi-clock-history me-1"></i>Grace Period: Ends @(row.DeactivationDate?.ToString("MM/dd") ?? "Soon")</small>
                                        }
                                        else if (!row.IsActive)
                                        {
                                            <small class="text-muted italic"><i class="bi bi-pause-circle me-1"></i>@(row.DeactivationReason ?? "Inactive Card")</small>
                                        }
                                        else if (row.IsPaid)
                                        {
                                            <small class="text-success"><i class="bi bi-shield-check me-1"></i>Dues Paid for @row.Year</small>
                                        }
                                        else if (row.IsActive)
                                        {
                                            <small class="text-danger"><i class="bi bi-exclamation-triangle me-1"></i>UNPAID</small>
                                        }
                                    </div>
                                </div>
                                @if (row.CardId > 0)
                                {
                                    var card = _allCards.FirstOrDefault(c => c.KeyCardId == row.CardId);
                                    if (card != null)
                                    {
                                        <button class="btn btn-light btn-sm rounded-circle" style="width: 32px; height: 32px; padding: 0;" @onclick="() => ToggleCardStatus(card)">
                                            <i class="bi @(card.IsActive ? "bi-x-circle" : "bi-check-circle")"></i>
                                        </button>
                                    }
                                }
                            </div>
                        </div>
                    }
                }

                @if (!FilteredDisplayRows.Any() && _filter != "needing")
                {
                    <div class="text-center py-5 text-muted">
                        <i class="bi bi-credit-card display-4 opacity-25"></i>
                        <p class="mt-2 text-wrap px-4">No cards found matching your search</p>
                    </div>
                }
                
                @if (!FilteredDisplayRows.Any() && _filter == "needing")
                {
                    <div class="text-center py-5 text-muted">
                        <i class="bi bi-check-circle display-4 opacity-25 text-success"></i>
                        <p class="mt-2 text-wrap px-4">All eligible members have active cards!</p>
                    </div>
                }
            </div>
        }
    </main>

    <!-- BOTTOM BAR -->
    <div class="fixed-bottom-nav">
        <MobileBottomNav ActiveTab="Key Cards" />
    </div>
</div>

<!-- Enhanced Assign Modal -->
@if (_showAssignModal)
{
    <div class="modal-backdrop-custom" @onclick="CloseModals"></div>
    <div class="bottom-sheet">
        <div class="sheet-handle"></div>
        <div class="p-4 pt-2">
            <h5 class="fw-bold mb-3 d-flex align-items-center">
                <i class="bi bi-person-badge text-primary me-2"></i>
                Assign Key Card
            </h5>
            
            @if (!string.IsNullOrEmpty(_assignError))
            {
                <div class="alert alert-danger py-2 mb-3 small d-flex align-items-center">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                    @_assignError
                </div>
            }

            <div class="mb-3">
                <label class="form-label fw-bold small text-muted text-uppercase">1. Member</label>
                <select class="form-select" @bind="_selectedMemberId" disabled="@_isSaving">
                    <option value="0">-- Select Member --</option>
                    @foreach (var row in _displayCache.Where(r => !r.HasCard || r.MemberId == _selectedMemberId).OrderBy(r => r.LastName))
                    {
                        <option value="@row.MemberId">@row.FirstName @row.LastName</option>
                    }
                </select>
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold small text-muted text-uppercase">2. Access Device</label>
                <div class="d-flex gap-2 mb-2">
                    <button class="btn @(_selectedCardType == "Card" ? "btn-primary" : "btn-outline-secondary") flex-grow-1" @onclick='() => _selectedCardType = "Card"'>
                        <i class="bi bi-credit-card-2-front me-1"></i> Card
                    </button>
                    <button class="btn @(_selectedCardType == "Fob" ? "btn-primary" : "btn-outline-secondary") flex-grow-1" @onclick='() => _selectedCardType = "Fob"'>
                        <i class="bi bi-key-fill me-1"></i> Fob
                    </button>
                </div>
            </div>

            <div class="mb-4">
                <label class="form-label fw-bold small text-muted text-uppercase">3. Card Number</label>
                <div class="d-grid gap-2">
                    <input type="text" inputmode="numeric" pattern="[0-9]*" class="form-control form-control-lg text-center font-monospace" placeholder="Enter number..." @bind="_newCardNumber" @bind:event="oninput" />
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label-modern">Notes (Optional)</label>
                <textarea class="form-control" rows="2" @bind="_assignNotes" placeholder="Reason for assignment..."></textarea>
            </div>

            <div class="d-grid gap-2">
                <button class="btn btn-app-primary py-3 fw-bold" @onclick="AssignCard" disabled="@(string.IsNullOrEmpty(_newCardNumber) || _selectedMemberId == 0 || _isSaving)">
                    @if (_isSaving) { <span class="spinner-border spinner-border-sm me-2"></span> }
                    <i class="bi bi-shield-check me-2"></i> Confirm & Activate
                </button>
                <button class="btn btn-light py-3" @onclick="CloseModals">Cancel</button>
            </div>
        </div>
    </div>
}

<style>
