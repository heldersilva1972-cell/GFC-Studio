@page "/mobile/analytics"
@using Microsoft.AspNetCore.Authorization
@using GFC.Core.Models
@inject IFinancialAnalyticsService FinancialService
@inject NavigationManager Navigation
@inject IJSRuntime JS
@using GFC.BlazorServer.Components.Shared.Mobile
@attribute [Authorize]

<PageTitle>Analytics | GFC Staff</PageTitle>

<div class="mobile-analytics-container">
    <!-- FIXED TOP SECTION -->
    <div class="header-nav-stack">
        <!-- HEADER -->
        <header class="app-header">
            <div class="container py-3">
                <div class="d-flex align-items-center gap-3">
                    <button class="btn btn-light rounded-3" style="width: 40px; height: 40px; padding: 0;" @onclick='() => Navigation.NavigateTo("/mobile")'>
                        <i class="bi bi-chevron-left"></i>
                    </button>
                    <h6 class="mb-0 fw-bold header-title">Performance Analytics</h6>
                </div>
            </div>
        </header>
    </div>

    <!-- SCROLLABLE CONTENT -->
    <main class="analytics-scroll-area">
        <div class="container py-4">
            @if (Loading)
            {
                <div class="text-center py-5 animate-entrance">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <p class="mt-3 text-muted">Analyzing figures...</p>
                </div>
            }
            else
            {
                <!-- Year Selector -->
                <div class="app-card animate-entrance stagger-1" style="display: block;">
                    <label class="modern-label">Years</label>
                    <div class="d-flex gap-2 flex-wrap mt-2">
                        @foreach (var year in _availableYears)
                        {
                            <button class="year-pill @(_selectedYears.Contains(year) ? "active" : "")"
                                    @onclick="() => ToggleYear(year)">
                                @year
                            </button>
                        }
                    </div>
                </div>

                <!-- Category Selector -->
                <div class="app-card animate-entrance stagger-1" style="display: block; margin-top: -10px;">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <label class="modern-label mb-0">Include Revenue From</label>
                        <button class="btn btn-link btn-sm p-0 text-decoration-none fw-bold" style="font-size: 0.7rem;" @onclick="ResetCategories">Reset</button>
                    </div>
                    <div class="d-flex gap-2 flex-wrap mt-2">
                        @foreach (var cat in _availableCategories)
                        {
                            <button class="cat-pill @(_selectedCategories.Contains(cat) ? "active" : "")"
                                    @onclick="() => ToggleCategory(cat)">
                                <i class="bi @GetCategoryIcon(cat) me-1"></i> @cat
                            </button>
                        }
                    </div>
                </div>

                <!-- Chart Display -->
                <div class="app-card animate-entrance stagger-2" style="display: block; padding: 15px;">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div class="d-flex flex-column">
                            <h6 class="fw-bold mb-0" style="font-size: 0.85rem;">Revenue Comparison</h6>
                            <span class="text-muted" style="font-size: 0.65rem;">@(_chartType == "line" ? "Trend Analysis" : "Volume Comparison")</span>
                        </div>
                        
                        <div class="d-flex p-1 bg-light rounded-pill" style="border: 1px solid #eee;">
                            <button class="btn btn-sm btn-icon-sm @(_chartType == "bar" ? "bg-white shadow-sm" : "text-muted")" 
                                    style="border-radius: 50px; padding: 2px 8px; font-size: 0.7rem; border: none;"
                                    @onclick='() => SetChartType("bar")'>
                                <i class="bi bi-bar-chart-fill"></i>
                            </button>
                            <button class="btn btn-sm btn-icon-sm @(_chartType == "line" ? "bg-white shadow-sm" : "text-muted")" 
                                    style="border-radius: 50px; padding: 2px 8px; font-size: 0.7rem; border: none;"
                                    @onclick='() => SetChartType("line")'>
                                <i class="bi bi-graph-up"></i>
                            </button>
                        </div>
                    </div>
                    <div class="chart-container">
                        <canvas id="mobileAnalyticsChart"></canvas>
                    </div>
                </div>

                <!-- Quick Stats -->
                <div class="row g-2 mb-2 animate-entrance stagger-3">
                    @foreach (var year in _selectedYears.OrderByDescending(y => y))
                    {
                        var total = GetYearTotal(year);
                        var previousYear = _selectedYears.OrderByDescending(y => y).Skip(1).FirstOrDefault();
                        var previousTotal = previousYear > 0 ? GetYearTotal(previousYear) : 0;
                        var growth = previousTotal > 0 ? ((total - previousTotal) / previousTotal) * 100 : 0;

                        <div class="col-6">
                            <div class="app-card" style="display: block; padding: 16px; margin-bottom: 0; background: @(year == _selectedYears.Max() ? "rgba(13, 110, 253, 0.04)" : "white"); border: 1px solid @(year == _selectedYears.Max() ? "rgba(13, 110, 253, 0.1)" : "transparent");">
                                <div class="stat-year" style="font-size: 0.65rem; color: var(--app-text-muted); font-weight: 700; text-transform: uppercase;">@year Total</div>
                                <div class="stat-value" style="font-size: 1.2rem; font-weight: 800; color: var(--app-text);">@total.ToString("C0")</div>
                                @if (previousYear > 0)
                                {
                                    <div class="stat-growth mt-1 @(growth >= 0 ? "text-success" : "text-danger")" style="font-size: 0.7rem; font-weight: 700;">
                                        <i class="bi bi-@(growth >= 0 ? "arrow-up" : "arrow-down")-short"></i>
                                        @growth.ToString("N1")% vs @previousYear
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>

                <!-- Monthly Averages -->
                <div class="app-card animate-entrance stagger-4" style="display: block;">
                    <label class="modern-label mb-3">Monthly Targets</label>
                    @foreach (var year in _selectedYears.OrderByDescending(y => y))
                    {
                        var total = GetYearTotal(year);
                        var avg = total / 12;
                        
                        <div class="d-flex justify-content-between align-items-center mb-2 p-3 rounded-4" style="background: @(year == _selectedYears.Max() ? "rgba(13, 110, 253, 0.05)" : "#f8f9fa");">
                            <div class="d-flex align-items-center gap-2">
                                <span class="badge @(year == _selectedYears.Max() ? "bg-primary" : "bg-secondary") rounded-pill">@year</span>
                                <span class="small text-muted fw-bold">AVG/MONTH</span>
                            </div>
                            <span class="fw-bold">@avg.ToString("C0")</span>
                        </div>
                    }
                </div>
            }
        </div>
    </main>

    <!-- BOTTOM BAR -->
    <div class="fixed-bottom-nav">
        <MobileBottomNav ActiveTab="Analytics" />
    </div>
</div>

<style>
    .mobile-analytics-container {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        display: flex;
        flex-direction: column;
        background-color: var(--app-bg, #f8f9fa);
        overflow: hidden;
    }

    .header-nav-stack {
        flex-shrink: 0;
        z-index: 1000;
        background: white;
        border-bottom: 1px solid rgba(0, 0, 0, 0.1);
    }

    .analytics-scroll-area {
        flex: 1;
        overflow-y: auto;
        -webkit-overflow-scrolling: touch;
        padding-bottom: 90px;
    }

    .fixed-bottom-nav {
        flex-shrink: 0;
        background: white;
        z-index: 1000;
    }
</style>

<style>
    .year-pill, .cat-pill {
        padding: 8px 14px;
        border-radius: 12px;
        border: 1px solid #e9ecef;
        background: #f8f9fa;
        font-weight: 700;
        font-size: 0.75rem;
        color: var(--app-text-muted);
        transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        display: flex;
        align-items: center;
        gap: 4px;
    }

    .year-pill.active, .cat-pill.active {
        background: var(--app-primary);
        border-color: var(--app-primary);
        color: white;
        box-shadow: 0 4px 12px rgba(13, 110, 253, 0.2);
    }

    .chart-container {
        position: relative;
        height: 250px;
        width: 100%;
    }
</style>

@code {
    private bool Loading = true;
    private List<int> _availableYears = new();
    private List<int> _selectedYears = new();
    private List<string> _availableCategories = new() { "Bar Sales", "Lottery", "Hall Rentals", "Membership Dues" };
    private List<string> _selectedCategories = new() { "Bar Sales" };
    private Dictionary<int, Dictionary<int, decimal>> _monthlyData = new(); // Year -> Month -> Amount
    private bool _chartRendered = false;
    private string _chartType = "bar";

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!Loading && !_chartRendered && _monthlyData.Any())
        {
            await RenderChart();
            _chartRendered = true;
        }
    }

    private async Task SetChartType(string type)
    {
        _chartType = type;
        await RenderChart();
    }

    private async Task LoadData()
    {
        Loading = true;
        
        _availableYears = await FinancialService.GetAvailableYearsAsync();
        if (!_availableYears.Contains(DateTime.Now.Year))
            _availableYears.Insert(0, DateTime.Now.Year);
        
        _availableYears = _availableYears.OrderByDescending(y => y).Take(5).ToList();
        
        _selectedYears = new List<int> { DateTime.Now.Year };
        if (_availableYears.Count > 1)
            _selectedYears.Add(_availableYears[1]);

        await RefreshMonthlyData();
        Loading = false;
    }

    private async Task RefreshMonthlyData()
    {
        _monthlyData.Clear();

        foreach (var year in _selectedYears)
        {
            var request = new FinancialAnalyticsRequest
            {
                IncomeTypes = _selectedCategories,
                Years = new List<int> { year },
                Period = "year",
                GroupBy = "month"
            };

            var dataPoints = await FinancialService.GetAggregatedDataAsync(request);
            var monthlyTotals = new Dictionary<int, decimal>();

            for (int month = 1; month <= 12; month++)
            {
                var total = dataPoints
                    .Where(p => p.Year == year && p.Date.Month == month)
                    .Sum(p => p.Amount);
                monthlyTotals[month] = total;
            }

            _monthlyData[year] = monthlyTotals;
        }

        _chartRendered = false;
    }

    private async Task ToggleCategory(string cat)
    {
        if (_selectedCategories.Contains(cat))
        {
            if (_selectedCategories.Count > 1)
                _selectedCategories.Remove(cat);
        }
        else
        {
            _selectedCategories.Add(cat);
        }
        await RefreshMonthlyData();
        await RenderChart();
    }

    private async Task ResetCategories()
    {
        _selectedCategories = new List<string>(_availableCategories);
        await RefreshMonthlyData();
        await RenderChart();
    }

    private string GetCategoryIcon(string cat) => cat switch
    {
        "Bar Sales" => "bi-cup-straw",
        "Lottery" => "bi-ticket-perforated",
        "Hall Rentals" => "bi-calendar-event",
        "Membership Dues" => "bi-person-vcard",
        _ => "bi-cash-coin"
    };

    private async Task ToggleYear(int year)
    {
        if (_selectedYears.Contains(year))
        {
            if (_selectedYears.Count > 1)
                _selectedYears.Remove(year);
        }
        else
        {
            _selectedYears.Add(year);
        }

        _selectedYears = _selectedYears.OrderByDescending(y => y).ToList();
        await RefreshMonthlyData();
        await RenderChart();
    }

    private async Task RenderChart()
    {
        var labels = new List<string> { "Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec" };
        var datasets = new List<object>();

        var colors = new[] { "#3b82f6", "#10b981", "#f59e0b", "#8b5cf6", "#ef4444" };
        int colorIndex = 0;

        foreach (var year in _selectedYears.OrderByDescending(y => y))
        {
            var data = new List<decimal>();
            for (int month = 1; month <= 12; month++)
            {
                data.Add(GetMonthlyRevenue(year, month));
            }

            var color = colors[colorIndex % colors.Length];
            datasets.Add(new
            {
                label = year.ToString(),
                data = data,
                color = color,
                bg = _chartType == "bar" ? color : "transparent",
                borderColor = color,
                borderWidth = _chartType == "bar" ? 0 : 3,
                tension = 0.3,
                borderRadius = _chartType == "bar" ? 4 : 0
            });

            colorIndex++;
        }

        await JS.InvokeVoidAsync("financialCharts.renderChart", "mobileAnalyticsChart", new
        {
            type = _chartType,
            labels = labels,
            datasets = datasets,
            stacked = false
        });
    }

    private decimal GetMonthlyRevenue(int year, int month)
    {
        if (_monthlyData.TryGetValue(year, out var months))
        {
            if (months.TryGetValue(month, out var amount))
                return amount;
        }
        return 0;
    }

    private decimal GetYearTotal(int year)
    {
        if (_monthlyData.TryGetValue(year, out var months))
        {
            return months.Values.Sum();
        }
        return 0;
    }
}
