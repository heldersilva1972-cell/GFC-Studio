@page "/mobile"
@using Microsoft.AspNetCore.Authorization
@using GFC.BlazorServer.Auth
@using GFC.Core.Interfaces
@inject NavigationManager Navigation
@inject CustomAuthenticationStateProvider AuthStateProvider
@inject IUserManagementService UserService
@inject IJSRuntime JSRuntime
@attribute [Authorize]

<PageTitle>Staff Portal | GFC</PageTitle>

<div class="mobile-app-container">
    <!-- HEADER -->
    <header class="app-header">
        <div class="container py-3">
            <div class="d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center gap-3">
                    <div class="user-avatar shadow-sm" style="background: var(--app-primary-gradient); width: 44px; height: 44px; border-radius: 12px; display: flex; align-items: center; justify-content: center;">
                        <i class="bi bi-person-fill text-white fs-4"></i>
                    </div>
                    <div>
                        <h6 class="mb-0 fw-bold header-title">@Username</h6>
                        <div class="d-flex align-items-center gap-1">
                            <span class="small text-muted fw-medium" style="font-size: 0.7rem;">Staff Member</span>
                        </div>
                    </div>
                </div>
                <div class="d-flex gap-2">
                    <button class="btn btn-light rounded-3" style="width: 40px; height: 40px; padding: 0;" @onclick="GoHome">
                        <i class="bi bi-house-door"></i>
                    </button>
                    <button class="btn btn-danger-soft rounded-3" style="width: 40px; height: 40px; padding: 0;" @onclick="HandleLogout">
                        <i class="bi bi-box-arrow-right"></i>
                    </button>
                </div>
            </div>
        </div>
    </header>

    <!-- CONTENT -->
    <main class="container py-4 flex-grow-1">
        <div class="welcome-section mb-4 animate-entrance">
            <h4 class="fw-bold mb-1">Staff Portal</h4>
            <p class="text-muted small">Access your shift tools and analytics.</p>
        </div>

        @if (IsLoading)
        {
            <div class="d-flex justify-content-center py-5">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
            </div>
        }
        else
        {
            <div class="portal-grid">
                <div class="app-card animate-entrance stagger-1" @onclick='() => NavigateTo("/mobile/schedule")'>
                    <div class="card-icon-box" style="background: rgba(245, 158, 11, 0.1); color: #f59e0b;">
                        <i class="bi bi-calendar-event-fill"></i>
                    </div>
                    <div style="flex-grow: 1;">
                        <h6 class="fw-bold mb-0">Schedule</h6>
                        <p class="small text-muted mb-0">View bartender rotations</p>
                    </div>
                    <i class="bi bi-chevron-right text-muted opacity-50"></i>
                </div>

                @if (HasAccessTo("Shift Report"))
                {
                    <div class="app-card animate-entrance stagger-1" @onclick='() => NavigateTo("/mobile/shift-report")'>
                        <div class="card-icon-box" style="background: rgba(12, 166, 120, 0.1); color: #0ca678;">
                            <i class="bi bi-clipboard-check-fill"></i>
                        </div>
                        <div style="flex-grow: 1;">
                            <h6 class="fw-bold mb-0">Shift Report</h6>
                            <p class="small text-muted mb-0">Record bar & lottery sales</p>
                        </div>
                        <i class="bi bi-chevron-right text-muted opacity-50"></i>
                    </div>
                }

                @if (HasAccessTo("Liquor Checkout"))
                {
                    <div class="app-card animate-entrance stagger-1" @onclick='() => NavigateTo("/mobile/liquor/checkout")'>
                        <div class="card-icon-box" style="background: rgba(239, 68, 68, 0.1); color: #ef4444;">
                            <i class="bi bi-qr-code-scan"></i>
                        </div>
                        <div style="flex-grow: 1;">
                            <h6 class="fw-bold mb-0">Liquor Checkout</h6>
                            <p class="small text-muted mb-0">Scan bottle removals</p>
                        </div>
                        <i class="bi bi-chevron-right text-muted opacity-50"></i>
                    </div>
                }

                @if (HasAccessTo("Liquor Manager"))
                {
                    <div class="app-card animate-entrance stagger-2" @onclick='() => NavigateTo("/mobile/liquor/manage")'>
                        <div class="card-icon-box" style="background: rgba(79, 70, 229, 0.1); color: #4f46e5;">
                            <i class="bi bi-boxes"></i>
                        </div>
                        <div style="flex-grow: 1;">
                            <h6 class="fw-bold mb-0">Liquor Manager</h6>
                            <p class="small text-muted mb-0">Manage stock & alerts</p>
                        </div>
                        <i class="bi bi-chevron-right text-muted opacity-50"></i>
                    </div>
                }

                @if (HasAccessTo("Analytics"))
                {
                    <div class="app-card animate-entrance stagger-2" @onclick='() => NavigateTo("/mobile/analytics")'>
                        <div class="card-icon-box" style="background: rgba(34, 139, 230, 0.1); color: #228be6;">
                            <i class="bi bi-graph-up-arrow"></i>
                        </div>
                        <div style="flex-grow: 1;">
                            <h6 class="fw-bold mb-0">Analytics</h6>
                            <p class="small text-muted mb-0">View monthly performance</p>
                        </div>
                        <i class="bi bi-chevron-right text-muted opacity-50"></i>
                    </div>
                }

                @if (IsAdmin)
                {
                    <div class="app-card animate-entrance stagger-3" @onclick='() => NavigateTo("/mobile/manage-schedule")'>
                        <div class="card-icon-box" style="background: rgba(139, 92, 246, 0.1); color: #8b5cf6;">
                            <i class="bi bi-person-gear"></i>
                        </div>
                        <div style="flex-grow: 1;">
                            <h6 class="fw-bold mb-0">Manage Schedule</h6>
                            <p class="small text-muted mb-0">Assign bartenders & roster</p>
                        </div>
                        <i class="bi bi-chevron-right text-muted opacity-50"></i>
                    </div>
                }
            </div>

            @if (!HasAnyMobileTools)
            {
                <div class="app-card animate-entrance" style="display: block; text-align: center; padding: 40px 20px;">
                    <i class="bi bi-shield-lock-fill display-5 text-primary opacity-25 mb-3"></i>
                    <h6 class="fw-bold">No Active Tools</h6>
                    <p class="small text-muted mb-4 px-3">Your account needs permissions to view staff tools.</p>
                    <button class="btn btn-app-primary w-100 py-3" @onclick="RefreshData" disabled="@IsRefreshing">
                        @if (IsRefreshing)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                            <span>Syncing...</span>
                        }
                        else
                        {
                            <i class="bi bi-arrow-repeat me-2"></i>
                            <span>Sync Account</span>
                        }
                    </button>
                </div>
            }
        }
    </main>

    <!-- BOTTOM BAR -->
    <nav class="app-nav-bar">
        <div class="container nav-tabs-container">
                <button class="nav-tab-item active" style="border: none; background: none;">
                <i class="bi bi-grid-fill"></i>
                <span class="small" style="font-size: 0.65rem; font-weight: 600;">Hub</span>
            </button>
            <button class="nav-tab-item" style="border: none; background: none;" @onclick='() => NavigateTo("/mobile/schedule")'>
                <i class="bi bi-calendar-event"></i>
                <span class="small" style="font-size: 0.65rem; font-weight: 600;">Schedule</span>
            </button>
            <button class="nav-tab-item" style="border: none; background: none;" @onclick='() => NavigateTo("/mobile/shift-report")' disabled="@(!HasAccessTo("Shift Report"))">
                <i class="bi bi-calendar-check"></i>
                <span class="small" style="font-size: 0.65rem; font-weight: 600;">Reports</span>
            </button>
            <button class="nav-tab-item" style="border: none; background: none;" @onclick='() => Navigation.NavigateTo("/mobile/analytics")' disabled="@(!HasAccessTo("Analytics"))">
                <i class="bi bi-graph-up-arrow"></i>
                <span class="small" style="font-size: 0.65rem; font-weight: 600;">Analytics</span>
            </button>
            @if (IsAdmin)
            {
                <button class="nav-tab-item" style="border: none; background: none;" @onclick='() => NavigateTo("/mobile/manage-schedule")'>
                    <i class="bi bi-gear"></i>
                    <span class="small" style="font-size: 0.65rem; font-weight: 600;">Admin</span>
                </button>
            }
        </div>
    </nav>
</div>

<style>
    .btn-danger-soft {
        background-color: #fce8e8;
        color: #dc3545;
        border: none;
    }
    .btn-danger-soft:active {
        background-color: #dc3545;
        color: white;
    }
</style>

@code {
    private string Username { get; set; } = "...";
    private bool IsLoading { get; set; } = true;
    private HashSet<string> UserRoutes { get; set; } = new();
    
    private bool IsAdmin { get; set; }
    private bool HasAnyMobileTools => IsAdmin || UserRoutes.Any(r => r.Contains("mobile"));

    private bool IsRefreshing { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await RefreshData();
    }

    private async Task RefreshData()
    {
        IsRefreshing = true;
        
        // Reliability Fix: Forcefully reload user record from the database 
        // to pick up changes in IsAdmin or Account status without logout.
        await AuthStateProvider.RefreshUserAsync();
        
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        Username = user.Identity?.Name ?? "Guest";
        IsAdmin = user.IsInRole("Admin");
        
        var currentAppUser = AuthStateProvider.GetCurrentUser();
        if (currentAppUser != null)
        {
            if (currentAppUser.IsAdmin) IsAdmin = true;
            
            var permissions = await Task.Run(() => UserService.GetUserPagePermissions(currentAppUser.UserId));
            UserRoutes = permissions.Select(p => p.Page?.PageRoute?.ToLower() ?? "").ToHashSet();
        }
        
        IsLoading = false;
        IsRefreshing = false;
        StateHasChanged();
    }

    private bool HasAccessTo(string featureName)
    {
        if (IsAdmin) return true;

        // Create a cleaned set of routes for easier matching (no slashes)
        var cleanRoutes = UserRoutes.Select(r => r.Trim('/').ToLower()).ToHashSet();

        return featureName switch
        {
            "Schedule" => cleanRoutes.Contains("mobile/schedule"),
            "Shift Report" => cleanRoutes.Contains("mobile/shift-report"),
            "Liquor Checkout" => cleanRoutes.Contains("mobile/liquor/checkout"),
            "Liquor Manager" => cleanRoutes.Contains("mobile/liquor/manage"),
            "Analytics" => cleanRoutes.Contains("mobile/analytics"),
            _ => false
        };
    }

    private void NavigateTo(string route)
    {
        Navigation.NavigateTo(route);
    }

    private void GoHome()
    {
        Navigation.NavigateTo("/mobile");
    }

    private async Task HandleLogout()
    {
        try
        {
            var token = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "gfc_device_token");
            await AuthStateProvider.LogoutAsync(token);
            await JSRuntime.InvokeVoidAsync("localStorage.removeItem", "gfc_device_token");
            await JSRuntime.InvokeVoidAsync("window.setCookie", "GFC_DeviceTrustToken", "", -1);
            await Task.Delay(100);
            Navigation.NavigateTo("/login", forceLoad: true);
        }
        catch
        {
            Navigation.NavigateTo("/login", forceLoad: true);
        }
    }
}
