@page "/mobile"
@using Microsoft.AspNetCore.Authorization
@using GFC.BlazorServer.Auth
@using GFC.Core.Interfaces
@inject NavigationManager Navigation
@inject CustomAuthenticationStateProvider AuthStateProvider
@inject IUserManagementService UserService
@inject IShiftComplianceService ShiftComplianceService
@inject IJSRuntime JSRuntime
@using GFC.BlazorServer.Services.Operations
@using GFC.BlazorServer.Components.Shared.Mobile
@attribute [Authorize]

<PageTitle>GFC Portal | GFC</PageTitle>

<div class="mobile-hub-container">
    <!-- FIXED TOP SECTION -->
    <div class="header-nav-stack">
        <!-- HEADER -->
        <header class="app-header">
            <div class="container py-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div class="d-flex align-items-center gap-3">
                        <div class="user-avatar shadow-sm" style="background: var(--app-primary-gradient); width: 44px; height: 44px; border-radius: 12px; display: flex; align-items: center; justify-content: center;">
                            <i class="bi bi-person-fill text-white fs-4"></i>
                        </div>
                        <div>
                            <h6 class="mb-0 fw-bold header-title">@Username</h6>
                            <div class="d-flex align-items-center gap-1">
                                <span class="small text-muted fw-medium" style="font-size: 0.7rem;">Staff Member</span>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </header>
    </div>

    <!-- SCROLLABLE CONTENT -->
    <main class="hub-scroll-area">
        <div class="container py-4">
            <div class="welcome-section mb-4 animate-entrance">
                <h4 class="fw-bold mb-1">GFC Portal</h4>
                <p class="text-muted small">Access your shift tools and analytics.</p>
            </div>

            @if (!IsLoading && _missingShifts.Any() && HasAccessTo("Shift Sales Alert"))
            {
                <div class="alert alert-warning border-0 shadow-sm rounded-4 mb-4 animate-entrance" style="background: rgba(245, 158, 11, 0.1); border-left: 4px solid #f59e0b !important;">
                    <div class="d-flex align-items-center gap-3">
                        <div class="rounded-circle bg-warning d-flex align-items-center justify-content-center" style="min-width: 40px; height: 40px;">
                            <i class="bi bi-clock-history text-white fs-5"></i>
                        </div>
                        <div style="flex-grow: 1;">
                            <div class="fw-bold text-dark small text-uppercase" style="letter-spacing: 0.5px;">Shift Sales Alert</div>
                            <div class="text-muted" style="font-size: 0.75rem;">@_missingShifts.Count report(s) are missing from the last 48 hours.</div>
                        </div>
                        <button class="btn btn-warning btn-sm rounded-pill fw-bold px-3" @onclick='() => NavigateTo("/mobile/shift-report")'>Fix</button>
                    </div>
                </div>
            }

            @if (IsLoading)
            {
                <div class="d-flex justify-content-center py-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                </div>
            }
            else
            {
                <div class="portal-grid">
                    @if (HasAccessTo("Bartenders schedule"))
                    {
                        <div class="app-card animate-entrance stagger-1" @onclick='() => NavigateTo("/mobile/schedule")'>
                            <div class="card-icon-box" style="background: rgba(245, 158, 11, 0.1); color: #f59e0b;">
                                <i class="bi bi-calendar-event-fill"></i>
                            </div>
                            <div style="flex-grow: 1;">
                                <h6 class="fw-bold mb-0">Bartenders schedule</h6>
                                <p class="small text-muted mb-0">View bartender rotations</p>
                            </div>
                            <i class="bi bi-chevron-right text-muted opacity-50"></i>
                        </div>
                    }

                    @if (HasAccessTo("End of shift sales"))
                    {
                        <div class="app-card animate-entrance stagger-1" @onclick='() => NavigateTo("/mobile/shift-report")'>
                            <div class="card-icon-box" style="background: rgba(12, 166, 120, 0.1); color: #0ca678;">
                                <i class="bi bi-clipboard-check-fill"></i>
                            </div>
                            <div style="flex-grow: 1;">
                                <h6 class="fw-bold mb-0">End of shift sales</h6>
                                <p class="small text-muted mb-0">Record bar & lottery sales</p>
                            </div>
                            <i class="bi bi-chevron-right text-muted opacity-50"></i>
                        </div>
                    }

                    @if (HasAccessTo("Bartender liquor checkout"))
                    {
                        <div class="app-card animate-entrance stagger-1" @onclick='() => NavigateTo("/mobile/liquor/checkout")'>
                            <div class="card-icon-box" style="background: rgba(239, 68, 68, 0.1); color: #ef4444;">
                                <i class="bi bi-qr-code-scan"></i>
                            </div>
                            <div style="flex-grow: 1;">
                                <h6 class="fw-bold mb-0">Bartender liquor checkout</h6>
                                <p class="small text-muted mb-0">Scan bottle removals</p>
                            </div>
                            <i class="bi bi-chevron-right text-muted opacity-50"></i>
                        </div>
                    }

                    @if (HasAccessTo("liquor inventory manager"))
                    {
                        <div class="app-card animate-entrance stagger-2" @onclick='() => NavigateTo("/mobile/liquor/manage")'>
                            <div class="card-icon-box" style="background: rgba(79, 70, 229, 0.1); color: #4f46e5;">
                                <i class="bi bi-boxes"></i>
                            </div>
                            <div style="flex-grow: 1;">
                                <h6 class="fw-bold mb-0">Liquor inventory manager</h6>
                                <p class="small text-muted mb-0">Manage stock & alerts</p>
                            </div>
                            <i class="bi bi-chevron-right text-muted opacity-50"></i>
                        </div>
                    }

                    @if (HasAccessTo("income charts"))
                    {
                        <div class="app-card animate-entrance stagger-2" @onclick='() => NavigateTo("/mobile/analytics")'>
                            <div class="card-icon-box" style="background: rgba(34, 139, 230, 0.1); color: #228be6;">
                                <i class="bi bi-graph-up-arrow"></i>
                            </div>
                            <div style="flex-grow: 1;">
                                <h6 class="fw-bold mb-0">Income charts</h6>
                                <p class="small text-muted mb-0">View monthly performance</p>
                            </div>
                            <i class="bi bi-chevron-right text-muted opacity-50"></i>
                        </div>
                    }

                    @if (HasAccessTo("Mobile Key Cards"))
                    {
                        <div class="app-card animate-entrance stagger-2" @onclick='() => NavigateTo("/mobile/keycards")'>
                            <div class="card-icon-box" style="background: rgba(236, 72, 153, 0.1); color: #ec4899;">
                                <i class="bi bi-credit-card"></i>
                            </div>
                            <div style="flex-grow: 1;">
                                <h6 class="fw-bold mb-0">Key Cards</h6>
                                <p class="small text-muted mb-0">Manage member access cards</p>
                            </div>
                            <i class="bi bi-chevron-right text-muted opacity-50"></i>
                        </div>
                    }

                    @if (HasAccessTo("Mobile Dues & Payments"))
                    {
                        <div class="app-card animate-entrance stagger-2" @onclick='() => NavigateTo("/mobile/dues")'>
                            <div class="card-icon-box" style="background: rgba(16, 185, 129, 0.1); color: #10b981;">
                                <i class="bi bi-cash-coin"></i>
                            </div>
                            <div style="flex-grow: 1;">
                                <h6 class="fw-bold mb-0">Dues & Payments</h6>
                                <p class="small text-muted mb-0">Track membership payments</p>
                            </div>
                            <i class="bi bi-chevron-right text-muted opacity-50"></i>
                        </div>
                    }

                    @if (HasAccessTo("bartender schedule manager"))
                    {
                        <div class="app-card animate-entrance stagger-3" @onclick='() => NavigateTo("/mobile/manage-schedule")'>
                            <div class="card-icon-box" style="background: rgba(139, 92, 246, 0.1); color: #8b5cf6;">
                                <i class="bi bi-person-gear"></i>
                            </div>
                            <div style="flex-grow: 1;">
                                <h6 class="fw-bold mb-0">Bartender schedule manager</h6>
                                <p class="small text-muted mb-0">Assign bartenders & roster</p>
                            </div>
                            <i class="bi bi-chevron-right text-muted opacity-50"></i>
                        </div>
                    }

                    @if (HasAccessTo("Mobile User Management"))
                    {
                        <div class="app-card animate-entrance stagger-3" @onclick='() => NavigateTo("/mobile/users")'>
                            <div class="card-icon-box" style="background: rgba(245, 158, 11, 0.1); color: #f59e0b;">
                                <i class="bi bi-people-fill"></i>
                            </div>
                            <div style="flex-grow: 1;">
                                <h6 class="fw-bold mb-0">Mobile User Management</h6>
                                <p class="small text-muted mb-0">Manage roles & device onboarding</p>
                            </div>
                            <i class="bi bi-chevron-right text-muted opacity-50"></i>
                        </div>
                    }

                    @if (!HasAnyMobileTools && !IsLoading)
                    {
                        <div class="empty-state text-center py-5 w-100">
                            <i class="bi bi-shield-lock display-1 text-muted opacity-25"></i>
                            <p class="mt-3 fw-bold text-muted">No permissions found.</p>
                            <p class="small text-muted px-4">You are logged in as <strong>@Username</strong> but do not have access to any mobile tools yet.</p>
                        </div>
                    }
                </div>
            }
        </div>
    </main>

    <!-- BOTTOM BAR -->
    <div class="fixed-bottom-nav">
        <MobileBottomNav ActiveTab="Home" />
    </div>
</div>

<style>
    .mobile-hub-container {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        display: flex;
        flex-direction: column;
        background-color: var(--app-bg, #f8f9fa);
        overflow: hidden;
    }

    .header-nav-stack {
        flex-shrink: 0;
        z-index: 1000;
        background: white;
        border-bottom: 1px solid rgba(0, 0, 0, 0.1);
    }

    .hub-scroll-area {
        flex: 1;
        overflow-y: auto;
        -webkit-overflow-scrolling: touch;
        padding-bottom: 90px;
    }

    .btn-danger-soft {
        background-color: #fce8e8;
        color: #dc3545;
        border: none;
    }
    .btn-danger-soft:active {
        background-color: #dc3545;
        color: white;
    }

    .fixed-bottom-nav {
        flex-shrink: 0;
        background: white;
        z-index: 1000;
    }
</style>

@code {
    private string Username { get; set; } = "...";
    private bool IsLoading { get; set; } = true;
    private HashSet<string> UserRoutes { get; set; } = new();
    private List<MissingShiftAlert> _missingShifts = new();
    
    private bool IsAdmin { get; set; }
    private bool HasAnyMobileTools => IsAdmin || UserRoutes.Any(r => r.Contains("mobile"));

    private bool IsRefreshing { get; set; }

    protected override async Task OnInitializedAsync()
    {
        // 1. Instant check for current state
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        var currentAppUser = AuthStateProvider.GetCurrentUser();

        // [FIX] Ensure Username is set even if the AppUser object is still loading
        Username = user.Identity?.Name ?? currentAppUser?.Username ?? "Guest";

        if (user.Identity?.IsAuthenticated == true)
        {
            IsAdmin = currentAppUser?.IsAdmin ?? false;
            
            if (currentAppUser != null) 
            {
                var permissions = UserService.GetUserPagePermissions(currentAppUser.UserId);
                UserRoutes = permissions.Select(p => p.Page?.PageRoute?.ToLower() ?? "").ToHashSet();
            }
            
            
            if (HasAccessTo("Shift Sales Alert"))
            {
                _missingShifts = await ShiftComplianceService.GetMissingShiftsAsync();
            }
            
            IsLoading = false; 
        }

        // 2. Background refresh to catch any recent permission changes
        _ = RefreshData();
    }

    private async Task RefreshData()
    {
        try
        {
            IsRefreshing = true;
            StateHasChanged();
            
            await AuthStateProvider.RefreshUserAsync();
            
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            var currentAppUser = AuthStateProvider.GetCurrentUser();

            // [FIX] Consistent username resolution
            Username = user.Identity?.Name ?? currentAppUser?.Username ?? "Guest";
            
            if (currentAppUser != null)
            {
                IsAdmin = currentAppUser.IsAdmin;
                var permissions = UserService.GetUserPagePermissions(currentAppUser.UserId);
                UserRoutes = permissions.Select(p => p.Page?.PageRoute?.ToLower() ?? "").ToHashSet();

                if (HasAccessTo("Shift Sales Alert"))
                {
                    _missingShifts = await ShiftComplianceService.GetMissingShiftsAsync();
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Hub Refresh Error: {ex.Message}");
        }
        finally
        {
            IsLoading = false;
            IsRefreshing = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private bool HasAccessTo(string featureName)
    {
        if (IsAdmin) return true;

        // Create a cleaned set of routes for easier matching (no slashes)
        var cleanRoutes = UserRoutes.Select(r => r.Trim('/').ToLower()).ToHashSet();

        return featureName switch
        {
            "Bartenders schedule" => cleanRoutes.Contains("mobile/schedule"),
            "End of shift sales" => cleanRoutes.Contains("mobile/shift-report"),
            "Bartender liquor checkout" => cleanRoutes.Contains("mobile/liquor/checkout"),
            "liquor inventory manager" => cleanRoutes.Contains("mobile/liquor/manage"),
            "income charts" => cleanRoutes.Contains("mobile/analytics"),
            "Mobile Key Cards" => cleanRoutes.Contains("mobile/keycards"),
            "Mobile Dues & Payments" => cleanRoutes.Contains("mobile/dues"),
            "bartender schedule manager" => cleanRoutes.Contains("mobile/manage-schedule"),
            "Mobile User Management" => cleanRoutes.Contains("mobile/users"),
            "Shift Sales Alert" => cleanRoutes.Contains("widgets/shift-sales-alert") || cleanRoutes.Contains("mobile/shift-report"),
            _ => false
        };
    }

    private void NavigateTo(string route)
    {
        Navigation.NavigateTo(route);
    }

    private void GoHome()
    {
        Navigation.NavigateTo("/mobile");
    }

    private async Task HandleLogout()
    {
        try
        {
            var token = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "gfc_device_token");
            await AuthStateProvider.LogoutAsync(token);
            await JSRuntime.InvokeVoidAsync("localStorage.removeItem", "gfc_device_token");
            await JSRuntime.InvokeVoidAsync("window.setCookie", "GFC_DeviceTrustToken", "", -1);
            await Task.Delay(100);
            Navigation.NavigateTo("/login", forceLoad: true);
        }
        catch
        {
            Navigation.NavigateTo("/login", forceLoad: true);
        }
    }
}
