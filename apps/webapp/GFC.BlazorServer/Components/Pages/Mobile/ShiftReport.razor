@page "/mobile/shift-report"
@using Microsoft.AspNetCore.Authorization
@using GFC.BlazorServer.Auth
@using GFC.Core.Interfaces
@using GFC.Core.Models
@using GFC.BlazorServer.Data
@using Microsoft.EntityFrameworkCore
@inject NavigationManager Navigation
@inject CustomAuthenticationStateProvider AuthStateProvider
@inject ILotteryShiftRepository LotteryRepo
@inject IDbContextFactory<GfcDbContext> DbFactory
@inject IJSRuntime JSRuntime
@inject IAuditLogger AuditLogger
@inject IUserManagementService UserService
@attribute [Authorize]

<PageTitle>End of Shift | GFC Mobile</PageTitle>

<div class="glass-page-container mobile-version">
    <NavigationLock ConfirmExternalNavigation="@HasUnsavedChanges" OnBeforeInternalNavigation="OnBeforeInternalNavigation" />
    
    @if (_showUnsavedModal)
    {
        <div class="glass-modal-overlay">
            <div class="glass-modal-card animate-zoom-in">
                <div class="glass-modal-header-icon warning">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                </div>
                <h3 class="fw-black text-dark mb-2 text-uppercase">@_modalTitle</h3>
                <p class="text-muted mb-4 px-3">@_modalMessage</p>
                <div class="glass-modal-actions">
                    <button type="button" class="btn-modal btn-modal-stay" @onclick="() => _showUnsavedModal = false">
                        STAY HERE
                    </button>
                    <button type="button" class="btn-modal btn-modal-leave" @onclick="ProceedWithAction">
                        DISCARD & CONTINUE
                    </button>
                </div>
            </div>
        </div>
    }

    <div class="page-content-wrapper">
        
        <!-- HEADER is now provided by MainLayout with the drawer -->
        <div class="px-3 pt-4 mb-4 d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center gap-2">
                <button class="btn btn-link text-primary p-0 me-1" @onclick="HandleCancel">
                    <i class="bi bi-chevron-left fs-4"></i>
                </button>
                <h1 class="h4 fw-black mb-0">End of Shift</h1>
            </div>
            <div class="header-date">
                <input type="date" class="form-control form-control-sm border-0 bg-white-glass fw-bold rounded-pill px-3 shadow-sm" 
                       @bind-value="ReportDate" @bind-value:after="OnDateChanged"
                       max="@DateTime.Today.ToString("yyyy-MM-dd")"
                       disabled="@IsLocked" />
            </div>
        </div>

        @if (Submitted)
        {
            <div class="p-4 text-center mt-5">
                <div class="success-icon-box mb-4 mx-auto shadow-lg">
                    <i class="bi bi-check2-circle"></i>
                </div>
                <h2 class="fw-black mb-2">Report Secured!</h2>
                <p class="text-muted mb-5">Your end-of-shift data has been successfully recorded in the audit logs.</p>
                <div class="d-grid gap-3">
                    <button class="btn btn-primary rounded-pill py-3 fw-bold shadow" @onclick="HandleCancel">
                        <i class="bi bi-speedometer2 me-2"></i> Dashboard
                    </button>
                    <button class="btn btn-link text-muted text-decoration-none small" @onclick="() => Submitted = false">
                        <i class="bi bi-pencil-square me-1"></i> Edit Shift Report
                    </button>
                </div>
            </div>
        }
        else if (Loading)
        {
            <div class="d-flex flex-column align-items-center justify-content-center py-5 mt-5">
                <div class="loader-ring mb-3"></div>
                <span class="text-muted fw-bold text-uppercase" style="letter-spacing: 0.1em;">Loading Shift State...</span>
            </div>
        }
        else
        {
            <div class="px-3 pb-5">
                @if (!string.IsNullOrEmpty(_validationError))
                {
                    <div class="alert alert-danger border-0 shadow-lg rounded-4 mb-4 d-flex align-items-center gap-3 py-3 px-4 glass-error animate-slide-up">
                        <div class="bg-danger p-2 rounded-circle shadow-sm">
                            <i class="bi bi-exclamation-triangle-fill text-white fs-5"></i>
                        </div>
                        <div>
                            <div class="fw-black text-primary text-uppercase small" style="letter-spacing: 0.05em;">Action Required</div>
                            <div class="text-muted fw-bold" style="font-size: 0.9rem;">@_validationError</div>
                        </div>
                    </div>
                }

                @if (!string.IsNullOrEmpty(_lockErrorMessage))
                {
                    <div class="alert alert-warning border-0 shadow-lg rounded-4 mb-4 d-flex align-items-center gap-3 py-3 px-4 glass-warning animate-slide-up">
                        <div class="bg-warning p-2 rounded-circle shadow-sm">
                            <i class="bi bi-lock-fill text-dark fs-5"></i>
                        </div>
                        <div>
                            <div class="fw-black text-primary text-uppercase small" style="letter-spacing: 0.05em;">Access Restricted</div>
                            <div class="text-muted fw-bold" style="font-size: 0.85rem;">@_lockErrorMessage</div>
                        </div>
                    </div>
                }

                <div class="row g-4 mb-5">
                    <!-- LEFT COLUMN: CONFIG & SALES -->
                    <div class="col-12 col-lg-6">
                        @if (!IsRentalHall)
                        {
                            <!-- SHIFT SELECT -->
                            <div class="form-glass-card shadow-sm p-4 mb-4 @(string.IsNullOrEmpty(ShiftType) && _showValidation ? "border-danger" : "")">
                                <label class="section-label mb-3">SELECT YOUR SHIFT</label>
                                <div class="shift-selector-inline">
                                    <button class='shift-btn-large @(ShiftType == "Day" ? "active" : "")' @onclick='() => SetShift("Day")' disabled="@IsLocked">
                                        <div class="d-flex flex-column align-items-center">
                                            <div><i class="bi bi-sun-fill me-2 fs-5"></i> DAY SHIFT</div>
                                            @if (_dayMainSubmitted) { 
                                                <span class="badge bg-success bg-opacity-10 text-success border border-success rounded-pill mt-1" style="font-size: 0.6rem;">SUBMITTED</span> 
                                            }
                                        </div>
                                    </button>
                                    <button class='shift-btn-large @(ShiftType == "Night" ? "active" : "")' @onclick='() => SetShift("Night")' disabled="@IsLocked">
                                        <div class="d-flex flex-column align-items-center">
                                            <div><i class="bi bi-moon-stars-fill me-2 fs-5"></i> NIGHT SHIFT</div>
                                            @if (_nightMainSubmitted) { 
                                                <span class="badge bg-success bg-opacity-10 text-success border border-success rounded-pill mt-1" style="font-size: 0.6rem;">SUBMITTED</span> 
                                            }
                                        </div>
                                    </button>
                                </div>
                            </div>
                        }

                        <!-- BAR LOCATION -->
                        <div class="form-glass-card shadow-sm p-3 mb-4 @(IsRentalHall ? "hall-active-card border-primary" : "")">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <label class="section-label @(IsRentalHall ? "text-primary" : "text-muted") mb-0">BAR LOCATION</label>
                                @if (_hallSubmitted) {
                                    <span class="badge bg-primary bg-opacity-10 text-primary border border-primary rounded-pill px-2 py-1" style="font-size: 0.65rem;">RENTAL SUBMITTED</span>
                                }
                                <button type="button" class='btn btn-sm @(IsRentalHall ? "btn-danger" : "btn-indigo") rounded-pill px-3 fw-bold' @onclick="ToggleRentalHall" disabled="@IsLocked">
                                    <i class="bi @(IsRentalHall ? "bi-arrow-left-circle" : "bi-building-up") me-1"></i> @(IsRentalHall ? "EXIT RENTAL HALL SALES" : "ENTER RENTAL HALL SALES")
                                </button>
                            </div>
                            @if (!IsRentalHall)
                            {
                                <p class="small text-muted mb-0 fw-semibold" style="font-size: 0.75rem;">Standard bar location active.</p>
                            }
                        </div>

                        @if (!string.IsNullOrEmpty(ShiftType))
                        {
                            <div class="row g-3 mb-4">
                                <div class="col-6">
                                    <div class="form-glass-card shadow-sm p-4 h-100 config-accent">
                                        <div class="d-flex justify-content-between align-items-center mb-3">
                                            <label class="section-label text-truncate mb-0">CONFIG</label>
                                            <i class="bi bi-clock fs-5 text-indigo opacity-25"></i>
                                        </div>
                                        <label class="form-label small fw-black text-muted text-uppercase mb-1">Hours</label>
                                        <div class="input-group-modern @(TotalHours == null && _showValidation ? "border-danger" : "")">
                                            <input type="number" step="0.25" class="form-input-modern" placeholder="0.00" 
                                                   inputmode="decimal" @bind-value="TotalHours" disabled="@IsLocked" />
                                            <span class="input-unit">Hr</span>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="form-glass-card shadow-sm p-4 h-100 sales-accent">
                                        <div class="d-flex justify-content-between align-items-center mb-3">
                                            <label class="section-label mb-0">SALES</label>
                                            <i class="bi bi-cup-straw fs-5 text-primary opacity-25"></i>
                                        </div>
                                        <label class="form-label small fw-black text-muted text-uppercase mb-1">Total</label>
                                        <div class="input-group-modern @(BarSales == null && _showValidation ? "border-danger" : "")">
                                            <span class="input-addon text-primary opacity-50 px-0">$</span>
                                            <input type="number" step="0.01" class="form-input-modern" placeholder="0.00" 
                                                   inputmode="decimal" @bind-value="BarSales" disabled="@IsLocked" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                    <!-- RIGHT COLUMN: LOTTERY & NOTES -->
                    <div class="col-12 col-lg-6">
                        @if (!string.IsNullOrEmpty(ShiftType))
                        {
                            @if (!IsRentalHall)
                            {
                                <!-- LOTTERY RECONCILIATION -->
                                <div class="form-glass-card shadow-sm p-4 mb-4 lotto-accent">
                                    <div class="d-flex justify-content-between align-items-center mb-3">
                                        <label class="section-label">LOTTERY RECONCILIATION</label>
                                        <i class="bi bi-ticket-perforated fs-4 text-success opacity-25"></i>
                                    </div>
                                    <div class="row g-3">
                                        <div class="col-12 col-md-6 col-lg-12">
                                            <label class="form-label small fw-black text-muted text-uppercase mb-1">① Net Sales (Ticket)</label>
                                            <div class="input-group-modern">
                                                <input type="number" step="0.01" class="form-input-modern" placeholder="0.00" 
                                                       @bind-value="LottoSales" @bind-value:event="oninput" inputmode="decimal" />
                                            </div>
                                        </div>
                                        <div class="col-12 col-md-6 col-lg-12">
                                            <label class="form-label small fw-black text-muted text-uppercase mb-1">② Cashes (Payouts)</label>
                                            <div class="input-group-modern">
                                                <input type="number" step="0.01" class="form-input-modern" placeholder="0.00" 
                                                       @bind-value="LottoCashes" @bind-value:event="oninput" inputmode="decimal" />
                                            </div>
                                        </div>
                                        <div class="col-12 col-md-6 col-lg-12">
                                            <label class="form-label small fw-black text-muted text-uppercase mb-1">③ Net Due (Ticket)</label>
                                            <div class="input-group-modern">
                                                <button type="button" class="btn-sign-toggle @(LottoNetDue < 0 ? "is-negative" : "")" 
                                                        @onclick="ToggleLottoNetDueSign" title="Toggle Negative/Positive">
                                                    @(LottoNetDue < 0 ? "-" : "+")
                                                </button>
                                                <input type="text" class="form-input-modern text-primary ps-1" placeholder="0.00" 
                                                       @bind-value="LottoNetDue" @bind-value:event="oninput" inputmode="decimal" />
                                            </div>
                                        </div>
                                        <div class="col-12 col-md-6 col-lg-12 border-top-mobile pt-3-mobile">
                                            <label class="form-label small fw-black text-muted text-uppercase mb-1">④ Beginning Cash</label>
                                            <div class="input-group-modern">
                                                <input type="number" step="1" class="form-input-modern" placeholder="0" @bind-value="LottoOpeningCash" inputmode="numeric" />
                                            </div>
                                        </div>
                                        <div class="col-12 col-md-6 col-lg-12">
                                            <label class="form-label small fw-black text-muted text-uppercase mb-1">⑤ Backup Bag added</label>
                                            <div class="input-group-modern">
                                                <span class="input-addon text-warning opacity-50">+</span>
                                                <input type="number" step="1" class="form-input-modern" placeholder="0" @bind-value="LottoBackupBag" inputmode="numeric" />
                                            </div>
                                        </div>
                                        <div class="col-12 col-md-6 col-lg-12">
                                            <label class="form-label small fw-black text-success text-uppercase mb-1">⑥ Ending Cash (Counted)</label>
                                            <div class="input-group-modern">
                                                <span class="input-addon text-success">$</span>
                                                <input type="number" step="0.01" class="form-input-modern fw-bold text-success" placeholder="0.00" 
                                                       @bind-value="LottoCashCounted" @bind-value:event="oninput" inputmode="decimal" />
                                            </div>
                                        </div>
                                    </div>
                                    
                                    <!-- RESULTS CARDS -->
                                    <div class="row g-2 mt-4">
                                        <div class="col-12 mb-2">
                                            <div class="sim-res-card alt-glass shadow-sm">
                                                <span class="sim-res-label">DRAWER EXPECTED</span>
                                                <span class="sim-res-val">$@(LottoDrawerValue.ToString("N2"))</span>
                                                <div class="small-math text-muted mt-1" style="font-size: 0.6rem; opacity: 0.7;">
                                                    Start: $@((LottoOpeningCash ?? 0).ToString("N2")) + Sales: $@(((LottoSales ?? 0) - (ShiftType == "Night" ? _prevDaySales : 0)).ToString("N2")) - Payouts: $@(((LottoCashes ?? 0) - (ShiftType == "Night" ? _prevDayCashes : 0)).ToString("N2")) + Bag: $@((LottoBackupBag ?? 0).ToString("N2"))
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-6">
                                            <div class="sim-res-card @(LottoDiscrepancy == 0 ? "exact" : LottoDiscrepancy > 0 ? "over" : "short")">
                                                <span class="sim-res-label">VARIANCE</span>
                                                <span class="sim-res-val">@((LottoDiscrepancy == 0 ? "$0.00" : (LottoDiscrepancy < 0 ? "(" : "") + "$" + Math.Abs(LottoDiscrepancy).ToString("N2") + (LottoDiscrepancy < 0 ? ")" : "")))</span>
                                            </div>
                                        </div>
                                        <div class="col-6">
                                            <div class="sim-res-card house">
                                                <span class="sim-res-label">ENVELOPE</span>
                                                <span class="sim-res-val">$@(LottoEnvelopeAmount.ToString("N2"))</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }

                            <!-- NOTES -->
                            <div class="form-glass-card shadow-sm p-4 mb-4">
                                <label class="small text-muted fw-bold text-uppercase mb-2">Shift Notes & Discrepancies</label>
                                <textarea class="form-control-modern" rows="4" placeholder="Type details here..." 
                                          @bind="Notes" disabled="@IsLocked"></textarea>
                            </div>

                            <!-- SUBMIT -->
                            <div class="d-grid gap-3">
                                <button class="btn @(ExistingEntryFound ? "btn-indigo" : "btn-action-submit") py-3 fw-bold shadow-lg" 
                                        disabled="@(IsSubmitting || IsLocked)" @onclick="HandleSubmit">
                                    @if (IsSubmitting) {
                                        <span class="spinner-border spinner-border-sm me-2"></span>
                                        <span>SECURING DATA...</span>
                                    } else {
                                        <i class="bi @(ExistingEntryFound ? "bi-check-all" : "bi-cloud-upload-fill") me-2"></i>
                                        <span>@(ExistingEntryFound ? "UPDATE EXISTING REPORT" : "SUBMIT SHIFT REPORT")</span>
                                    }
                                </button>
                                <button class="btn btn-outline-secondary rounded-pill py-3 fw-bold" @onclick="ResetSelection">
                                    <i class="bi bi-arrow-counterclockwise me-1"></i> CLEAR SELECTION
                                </button>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<style>
    .glass-page-container {
        --c-glass-bg: var(--bg-surface);
        --c-glass-border: var(--glass-border);
        --c-accent-primary: #0d6efd;
        --c-accent-success: #198754;
        --c-text-primary: var(--text-primary);
        --c-text-muted: var(--text-muted);
        --c-accent-indigo: #6366f1;

        min-height: 100vh;
        background: var(--bg-primary);
        font-family: 'Inter', system-ui, -apple-system, sans-serif;
        color: var(--c-text-primary);
        padding-bottom: 2rem;
    }

    .mobile-app-header {
        background: var(--bg-secondary);
        backdrop-filter: blur(10px);
        border-bottom: 1px solid var(--glass-border);
        position: sticky;
        top: 0;
        z-index: 100;
        transition: all 0.3s ease;
    }

    @@media (min-width: 992px) {
        .mobile-app-header {
            padding-top: 0.5rem !important;
            padding-bottom: 0.5rem !important;
            margin-bottom: 1.5rem !important;
        }
        .mobile-app-header h1 {
            font-size: 1.25rem;
        }
    }

    .bg-white-glass { background: var(--bg-surface); backdrop-filter: blur(5px); }

    .fw-black { font-weight: 900; }

    .form-glass-card {
        background: var(--bg-surface);
        backdrop-filter: blur(12px);
        border: 1.5px solid var(--glass-border);
        border-radius: 20px;
        box-shadow: var(--card-shadow);
    }

    .section-label {
        font-weight: 900;
        font-size: 0.85rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--c-accent-primary);
        border-left: 4px solid var(--c-accent-primary);
        padding-left: 12px;
        display: block;
    }

    .lotto-accent .section-label { color: var(--c-accent-success); border-color: var(--c-accent-success); }
    .sales-accent .section-label { color: var(--c-accent-primary); border-color: var(--c-accent-primary); }
    .config-accent .section-label { color: var(--c-accent-indigo); border-color: var(--c-accent-indigo); }

    .shift-selector-inline { display: flex; gap: 0.75rem; }
    
    .shift-btn-large {
        flex: 1;
        border: 2px solid var(--glass-border);
        background: var(--bg-surface);
        padding: 1rem 0.5rem;
        border-radius: 16px;
        font-weight: 900;
        font-size: 0.85rem;
        color: var(--c-text-muted);
        transition: all 0.2s ease;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .shift-btn-large.active {
        border-color: var(--c-accent-primary);
        background: rgba(13, 110, 253, 0.1);
        color: var(--c-accent-primary);
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.2);
    }

    .hall-toggle-btn.active {
        border-color: var(--c-accent-indigo);
        background: rgba(99, 102, 241, 0.1);
        color: var(--c-accent-indigo);
    }

    .hall-active-card { border-color: rgba(99, 102, 241, 0.4) !important; background: rgba(99, 102, 241, 0.05) !important; }

    .input-group-modern {
        background: var(--bg-primary);
        border-radius: 12px;
        display: flex;
        align-items: center;
        padding: 0.65rem 1rem;
        border: 1px solid var(--glass-border);
        transition: all 0.2s ease;
    }

    .input-group-modern.big { padding: 0.85rem 1.25rem; }
    .input-group-modern:focus-within { border-color: var(--c-accent-primary); box-shadow: 0 0 0 4px rgba(13, 110, 253, 0.1); }

    .form-input-modern { border: none; outline: none; width: 100%; background: transparent; font-weight: 700; color: var(--c-text-primary); font-size: 1.1rem; }
    .big .form-input-modern { font-size: 1.5rem; }

    .input-addon { font-weight: 800; font-size: 1.2rem; margin-right: 0.75rem; }
    .input-unit { font-weight: 900; color: var(--c-text-muted); font-size: 0.9rem; text-transform: uppercase; margin-left: 0.75rem; }

    .sim-res-card {
        background: var(--bg-primary); border: 1px solid var(--glass-border); border-radius: 16px; padding: 12px;
        display: flex; flex-direction: column; align-items: center; text-align: center;
        box-shadow: var(--card-shadow);
    }
    .sim-res-label { font-size: 0.6rem; font-weight: 800; color: var(--c-text-muted); text-transform: uppercase; margin-bottom: 2px; }
    .sim-res-val { font-size: 1.1rem; font-weight: 900; color: var(--c-text-primary); }

    .sim-res-card.short { border-top: 4px solid #e11d48; background: rgba(225, 29, 72, 0.05); }
    .sim-res-card.short .sim-res-val { color: #fb7185; }

    .sim-res-card.exact { border-top: 4px solid #16a34a; background: rgba(22, 163, 74, 0.05); }
    .sim-res-card.exact .sim-res-val { color: #4ade80; }

    .sim-res-card.over { border-top: 4px solid #0ea5e9; background: rgba(14, 165, 233, 0.05); }
    .sim-res-card.over .sim-res-val { color: #38bdf8; }

    .sim-res-card.house .sim-res-val { color: #34d399; }
    
    .sim-res-card.alt-glass { border-top: 4px solid #6366f1; background: rgba(99, 102, 241, 0.08); }
    .sim-res-card.alt-glass .sim-res-val { color: #4f46e5; }
    .sim-res-card.alt-glass .sim-res-label { color: #6366f1; border-bottom-color: rgba(99, 102, 241, 0.1); }
    
    .small-math { font-family: 'SFMono-Regular', Consolas, 'Liberation Mono', Menlo, monospace; }

    .form-control-modern { width: 100%; border-radius: 16px; border: 1px solid var(--glass-border); background: var(--bg-primary); color: var(--c-text-primary); padding: 1rem; font-weight: 600; min-height: 100px; }

    .btn-action-submit { background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%); color: white !important; border: none; border-radius: 999px; }
    .btn-indigo { background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%); color: white !important; border: none; border-radius: 999px; }

    .success-icon-box { background: linear-gradient(135deg, #10b981 0%, #059669 100%); width: 80px; height: 80px; border-radius: 50%; color: white; font-size: 3rem; display: flex; align-items: center; justify-content: center; }

    .animate-slide-up { animation: slideUp 0.4s ease-out; }
    @@keyframes slideUp { from { transform: translateY(20px); opacity: 0; } to { transform: translateY(0); opacity: 1; } }

    .loader-ring { width: 48px; height: 48px; border: 5px solid var(--glass-border); border-bottom-color: var(--c-accent-primary); border-radius: 50%; animation: rotation 1s linear infinite; }
    @@keyframes rotation { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }

    .glass-error { background: rgba(239, 68, 68, 0.1); border-left: 4px solid #ef4444 !important; }
    .glass-warning { background: rgba(245, 158, 11, 0.1); border-left: 4px solid #f59e0b !important; }

    .btn-sign-toggle { background: #f1f5f9; border: 1px solid #e2e8f0; border-radius: 8px; width: 32px; height: 32px; display: flex; align-items: center; justify-content: center; font-weight: 900; font-size: 1.2rem; color: #64748b; margin-right: 4px; transition: all 0.2s; }
    .btn-sign-toggle.is-negative { background: #fee2e2; border-color: #fecaca; color: #ef4444; }
    .btn-sign-toggle:active { transform: scale(0.9); }
        .glass-page-container.mobile-version {
            padding-top: 1rem;
            display: flex;
            flex-direction: column;
        }
        .page-content-wrapper {
            max-width: 1100px;
            margin: 0 auto;
            width: 100%;
        }
        .form-glass-card {
            margin-bottom: 0 !important;
        }
        .px-3.pb-5 {
            padding-bottom: 1rem !important;
        }
        /* Ensure columns in the same row align nicely */
        .row.g-4 {
            display: flex;
            align-items: stretch;
        }
        .col-lg-6 {
            display: flex;
            flex-direction: column;
            gap: 1.5rem;
        }
    }

    /* Mobile Utility Fixes */
    .border-top-mobile { border-top: 1px solid var(--glass-border); }
    .pt-3-mobile { padding-top: 1rem; }

    @@media (min-width: 768px) {
        .border-top-mobile { border-top: none; }
        .pt-3-mobile { padding-top: 0; }
    }

    /* CUSTOM PROFESSIONAL MODAL */
    .glass-modal-overlay { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.4); backdrop-filter: blur(8px); z-index: 9999; display: flex; align-items: center; justify-content: center; padding: 1.5rem; }
    .glass-modal-card { background: white; border-radius: 28px; width: 100%; max-width: 400px; padding: 2.5rem 1.5rem; text-align: center; box-shadow: 0 25px 50px -12px rgba(0,0,0,0.25); border: 1px solid rgba(255,255,255,0.3); }
    .glass-modal-header-icon { width: 80px; height: 80px; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 1.5rem; font-size: 2.5rem; }
    .glass-modal-header-icon.warning { background: #fff7ed; color: #f97316; border: 4px solid #ffedd5; }
    .btn-modal { width: 100%; border-radius: 16px; padding: 1rem; font-weight: 800; border: none; margin-bottom: 0.75rem; transition: all 0.2s; }
    .btn-modal-stay { background: #3b82f6; color: white; box-shadow: 0 10px 15px -3px rgba(59, 130, 246, 0.3); }
    .btn-modal-leave { background: #f8fafc; color: #64748b; border: 1px solid #e2e8f0; }
    .animate-zoom-in { animation: zoomIn 0.3s ease-out; }
    @@keyframes zoomIn { from { transform: scale(0.9); opacity: 0; } to { transform: scale(1); opacity: 1; } }
</style>

@code {
    private decimal? BarSales { get; set; }
    private decimal? LottoSales { get; set; }
    private decimal? LottoCashes { get; set; }
    private decimal? LottoNetDue { get; set; }
    private decimal? LottoOpeningCash { get; set; }
    private decimal? LottoBackupBag { get; set; }
    private decimal? LottoCashCounted { get; set; }
    private decimal? TotalHours { get; set; }
    
    private string? ShiftType { get; set; }
    private DateTime ReportDate { get; set; } = DateTime.Today;
    private string? Notes { get; set; }
    private bool IsRentalHall { get; set; } = false;

    private bool Loading { get; set; } = true;
    private bool IsSubmitting { get; set; } = false;
    private bool Submitted { get; set; } = false;
    private bool ExistingEntryFound { get; set; } = false;
    private bool IsLocked { get; set; } = false;
    private string? _validationError { get; set; }
    private string? _lockErrorMessage { get; set; }
    private bool _showValidation = false;
    private bool _showUnsavedModal = false;
    private string? _pendingNavigationUrl;
    private string _modalTitle = "Unsaved Changes";
    private string _modalMessage = "You have entered data. Leaving now will lose your progress.";
    private Action? _onModalConfirm;

    private bool _dayMainSubmitted;
    private bool _nightMainSubmitted;
    private bool _hallSubmitted;

    private BarSaleEntry? ExistingBarEntry { get; set; }
    private LotteryShift? ExistingLottoEntry { get; set; }
    private AppUser? CurrentUser { get; set; }

    // Original values for tracking changes
    private decimal? _originalBarSales;
    private decimal? _originalLottoSales;
    private decimal? _originalLottoCashes;
    private decimal? _originalLottoNetDue;
    private decimal? _originalLottoOpeningCash;
    private decimal? _originalLottoBackupBag;
    private decimal? _originalLottoCashCounted;
    private decimal? _originalTotalHours;
    private string? _originalNotes;

    private bool HasUnsavedChanges => 
        !Loading && !Submitted && !string.IsNullOrEmpty(ShiftType) &&
        (BarSales != _originalBarSales ||
         LottoSales != _originalLottoSales ||
         LottoCashes != _originalLottoCashes ||
         LottoNetDue != _originalLottoNetDue ||
         LottoOpeningCash != _originalLottoOpeningCash ||
         LottoBackupBag != _originalLottoBackupBag ||
         LottoCashCounted != _originalLottoCashCounted ||
         TotalHours != _originalTotalHours ||
         Notes != _originalNotes);

    // Shift Delta Tracking (for cumulative machine reports)
    private decimal _prevDaySales { get; set; } = 0;
    private decimal _prevDayCashes { get; set; } = 0;

    // Math Logic
    private decimal LottoDrawerValue {
        get {
            decimal salesDelta = (LottoSales ?? 0) - (ShiftType == "Night" ? _prevDaySales : 0); 
            decimal cashesDelta = (LottoCashes ?? 0) - (ShiftType == "Night" ? _prevDayCashes : 0);
            return (LottoOpeningCash ?? 0) + salesDelta - cashesDelta + (LottoBackupBag ?? 0);
        }
    }
    private decimal LottoDiscrepancy => (LottoCashCounted ?? 0) - LottoDrawerValue;
    private decimal LottoTotalSurplus => Math.Max(0, (LottoCashCounted ?? 0) - 1200);
    private decimal LottoEnvelopeAmount => Math.Max(0, LottoTotalSurplus - (LottoBackupBag ?? 0));

    protected override async Task OnInitializedAsync()
    {
        CurrentUser = AuthStateProvider.GetCurrentUser();
        if (CurrentUser == null) { Navigation.NavigateTo("/login"); return; }
        ApplyBusinessDayLogic();
        await UpdateShiftAvailability();
        await CheckExisting();
        Loading = false;
    }

    private void ApplyBusinessDayLogic()
    {
        var now = DateTime.Now;
        if (now.Hour < 5) ReportDate = DateTime.Today.AddDays(-1);
    }

    private async Task OnDateChanged()
    {
        await UpdateShiftAvailability();
        await CheckExisting();
    }

    private async Task SetShift(string type)
    {
        _lockErrorMessage = null;
        ShiftType = type;
        await CheckExisting();
        if (IsLocked) {
             _lockErrorMessage = "Access Restricted: This existing report is locked.";
             ResetSelection();
        }
    }

    private async Task ToggleRentalHall()
    {
        if (IsRentalHall && HasUnsavedChanges)
        {
            _modalTitle = "Unsaved Rental Data";
            _modalMessage = "You are about to exit the Rental Hall report. Any unsaved sales or notes will be lost. Continue?";
            _onModalConfirm = () => {
                ExecuteToggleRentalHall();
            };
            _showUnsavedModal = true;
            return;
        }

        ExecuteToggleRentalHall();
    }

    private void ExecuteToggleRentalHall()
    {
        IsRentalHall = !IsRentalHall;
        _lockErrorMessage = null;
        ShiftType = IsRentalHall ? "Hall" : null;
        _ = UpdateShiftAvailability();
        _ = CheckExisting();
        if (IsLocked) {
             _lockErrorMessage = "Access Restricted: This existing report is locked.";
             ResetSelection();
        }
    }

    private void ResetSelection()
    {
        ShiftType = null; BarSales = null; TotalHours = null; LottoSales = null; LottoCashes = null; LottoNetDue = null; 
        LottoBackupBag = 0; LottoCashCounted = null; Notes = null; ExistingEntryFound = false; IsLocked = false;
    }

    private async Task UpdateShiftAvailability()
    {
        try {
            using var db = await DbFactory.CreateDbContextAsync();
            _dayMainSubmitted = await db.BarSaleEntries.AnyAsync(e => (e.AdjustedSaleDate ?? e.SaleDate).Date == ReportDate.Date && e.Shift == "Day" && !e.IsRentalHall);
            _nightMainSubmitted = await db.BarSaleEntries.AnyAsync(e => (e.AdjustedSaleDate ?? e.SaleDate).Date == ReportDate.Date && e.Shift == "Night" && !e.IsRentalHall);
            _hallSubmitted = await db.BarSaleEntries.AnyAsync(e => (e.AdjustedSaleDate ?? e.SaleDate).Date == ReportDate.Date && e.IsRentalHall);
        } catch { }
    }

    private async Task CheckExisting()
    {
        ExistingBarEntry = null; ExistingLottoEntry = null; ExistingEntryFound = false; IsLocked = false;
        _prevDaySales = 0; _prevDayCashes = 0;
        if (string.IsNullOrEmpty(ShiftType)) return;

        try {
            using var db = await DbFactory.CreateDbContextAsync();
            ExistingBarEntry = await db.BarSaleEntries.FirstOrDefaultAsync(e => (e.AdjustedSaleDate ?? e.SaleDate).Date == ReportDate.Date && e.Shift == ShiftType && e.IsRentalHall == IsRentalHall);
            var lottoShifts = LotteryRepo.GetByDateRange(ReportDate, ReportDate);
            ExistingLottoEntry = lottoShifts.FirstOrDefault(s => s.ShiftType == ShiftType);

            if (ShiftType == "Night") {
                var dayShift = lottoShifts.FirstOrDefault(s => s.ShiftType == "Day");
                if (dayShift != null) { _prevDaySales = dayShift.TotalSales; _prevDayCashes = dayShift.TotalPayouts; }
            }

            if (ExistingBarEntry != null || ExistingLottoEntry != null) {
                ExistingEntryFound = true;
                BarSales = ExistingBarEntry?.TotalSales;
                TotalHours = ExistingBarEntry?.TotalHours;
                if (ExistingLottoEntry != null) {
                    LottoSales = ExistingLottoEntry.TotalSales; LottoCashes = ExistingLottoEntry.TotalPayouts;
                    LottoNetDue = ExistingLottoEntry.NetDue; LottoOpeningCash = ExistingLottoEntry.StartingCash;
                    LottoBackupBag = ExistingLottoEntry.BackupBagAmount; LottoCashCounted = ExistingLottoEntry.EndingCash;
                }
                Notes = ExistingBarEntry?.Notes ?? ExistingLottoEntry?.Notes;
                
                // Set originals for change tracking
                _originalBarSales = BarSales; _originalLottoSales = LottoSales; _originalLottoCashes = LottoCashes;
                _originalLottoNetDue = LottoNetDue; _originalLottoOpeningCash = LottoOpeningCash;
                _originalLottoBackupBag = LottoBackupBag; _originalLottoCashCounted = LottoCashCounted;
                _originalTotalHours = TotalHours; _originalNotes = Notes;

                var createdTime = ExistingBarEntry?.CreatedAt ?? ExistingLottoEntry?.CreatedDate ?? DateTime.UtcNow;
                if (createdTime < DateTime.UtcNow.AddHours(-2) && !CurrentUser.IsAdmin && (ExistingBarEntry?.CreatedBy != CurrentUser.Username)) IsLocked = true;
            } else {
                BarSales = null; TotalHours = null; LottoSales = null; LottoCashes = null; LottoNetDue = null; LottoBackupBag = 0; LottoCashCounted = null; Notes = null;
                LottoOpeningCash = await GetCarryoverCash();

                // Set originals for new entry
                _originalBarSales = null; _originalLottoSales = null; _originalLottoCashes = null;
                _originalLottoNetDue = null; _originalLottoOpeningCash = LottoOpeningCash;
                _originalLottoBackupBag = 0; _originalLottoCashCounted = null;
                _originalTotalHours = null; _originalNotes = null;
            }
        } catch { }
    }

    private async Task<decimal> GetCarryoverCash()
    {
        try {
            using var db = await DbFactory.CreateDbContextAsync();
            if (ShiftType == "Night") {
                var day = await db.LotteryShifts.AsNoTracking().FirstOrDefaultAsync(s => s.ShiftDate.Date == ReportDate.Date && s.ShiftType == "Day");
                if (day == null) return 0;
                decimal surplus = Math.Max(0, day.EndingCash - 1200);
                decimal returnToBag = Math.Min(surplus, day.BackupBagAmount);
                return day.EndingCash - returnToBag - day.EnvelopeAmount;
            }
            return 1200;
        } catch { return 1200; }
    }

    private async Task HandleSubmit()
    {
        if (BarSales == null || TotalHours == null || (!IsRentalHall && LottoSales == null)) {
            _validationError = "Required fields are missing. Please ensure all fields are filled out.";
            _showValidation = true;
            return;
        }

        IsSubmitting = true;
        try {
            using var db = await DbFactory.CreateDbContextAsync();
            if (ExistingBarEntry != null) {
                var entry = await db.BarSaleEntries.FindAsync(ExistingBarEntry.Id);
                if (entry != null) {
                    entry.TotalSales = BarSales ?? 0; entry.TotalHours = TotalHours; entry.Notes = Notes;
                    entry.ModifiedBy = CurrentUser?.Username; entry.ModifiedDate = DateTime.UtcNow;
                    await db.SaveChangesAsync();
                }
            } else {
                db.BarSaleEntries.Add(new BarSaleEntry {
                    SaleDate = DateTime.Now, AdjustedSaleDate = ReportDate, TotalSales = BarSales ?? 0,
                    TotalHours = TotalHours, IsRentalHall = IsRentalHall, Shift = ShiftType, Notes = Notes,
                    CreatedBy = CurrentUser?.Username, CreatedAt = DateTime.UtcNow
                });
                await db.SaveChangesAsync();
            }

            if (!IsRentalHall) {
                if (ExistingLottoEntry != null) {
                    ExistingLottoEntry.TotalSales = LottoSales ?? 0; ExistingLottoEntry.TotalPayouts = LottoCashes ?? 0;
                    ExistingLottoEntry.NetDue = LottoNetDue ?? 0; ExistingLottoEntry.StartingCash = LottoOpeningCash ?? 0;
                    ExistingLottoEntry.BackupBagAmount = LottoBackupBag ?? 0; ExistingLottoEntry.EndingCash = LottoCashCounted ?? 0;
                    ExistingLottoEntry.EnvelopeAmount = LottoEnvelopeAmount; ExistingLottoEntry.Notes = Notes;
                    LotteryRepo.Update(ExistingLottoEntry);
                } else {
                    LotteryRepo.Create(new LotteryShift {
                        ShiftDate = ReportDate, EmployeeName = CurrentUser?.Username ?? "Unknown", ShiftType = ShiftType,
                        TotalSales = LottoSales ?? 0, TotalPayouts = LottoCashes ?? 0, NetDue = LottoNetDue ?? 0,
                        StartingCash = LottoOpeningCash ?? 0, BackupBagAmount = LottoBackupBag ?? 0, EndingCash = LottoCashCounted ?? 0,
                        EnvelopeAmount = LottoEnvelopeAmount, Notes = Notes, CreatedBy = CurrentUser?.Username, CreatedDate = DateTime.UtcNow, Status = "Submitted"
                    });
                }
            }

            AuditLogger.Log(ExistingEntryFound ? "Shift Report Corrected" : "Shift Report Submitted", CurrentUser?.UserId, null, $"Date: {ReportDate:yyyy-MM-dd}, Shift: {ShiftType}");
            Submitted = true;
        } catch (Exception ex) {
            _validationError = "Error saving report: " + ex.Message;
        } finally {
            IsSubmitting = false;
        }
    }

    private void ToggleLottoNetDueSign()
    {
        if (LottoNetDue != null)
        {
            LottoNetDue = -LottoNetDue;
            StateHasChanged();
        }
        else
        {
            // If empty, assume we want to start entering a negative value
            // (Note: This is a UI hint; the bind will handle the next input)
        }
    }

    private async Task OnBeforeInternalNavigation(LocationChangingContext context)
    {
        if (HasUnsavedChanges)
        {
            context.PreventNavigation();
            _pendingNavigationUrl = context.TargetLocation;
            _modalTitle = "Unsaved Changes";
            _modalMessage = "You have sales data in progress. Leaving now will permanently discard your work.";
            _onModalConfirm = () => {
                Submitted = true;
                Navigation.NavigateTo(_pendingNavigationUrl ?? "/mobile");
            };
            _showUnsavedModal = true;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void ProceedWithAction()
    {
        _showUnsavedModal = false;
        _onModalConfirm?.Invoke();
    }

    private void HandleCancel() => Navigation.NavigateTo("/mobile");
}
