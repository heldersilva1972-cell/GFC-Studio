@page "/mobile/shift-report"
@using Microsoft.AspNetCore.Authorization
@using GFC.BlazorServer.Auth
@using GFC.Core.Interfaces
@using GFC.Core.Models
@using GFC.BlazorServer.Data
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<GfcDbContext> DbFactory
@inject NavigationManager Navigation
@inject CustomAuthenticationStateProvider AuthStateProvider
@inject ILotteryShiftRepository LotteryRepo
@inject IJSRuntime JSRuntime
@inject IAuditLogger AuditLogger
@inject IUserManagementService UserService
@attribute [Authorize]

<PageTitle>End of Shift | GFC Mobile</PageTitle>

<div class="viewport-fixed-hud">
    <div class="px-3 pt-4 mb-2 d-flex justify-content-between align-items-center">
        <div class="d-flex align-items-center gap-2">
            <button class="btn-home-pill" @onclick="HandleCancel">
                <i class="bi bi-house-fill me-1"></i> HOME
            </button>
            <h1 class="h5 fw-black mb-0 ms-2">End of Shift</h1>
        </div>
        <div class="d-flex align-items-center gap-2">
            <button class="btn-guide-pill" @onclick="() => _showGuide = true" title="Lottery Calculation Guide">
                <i class="bi bi-question-circle-fill me-1"></i> GUIDE
            </button>
            <button class="btn-home-pill btn-logout-danger ms-1" @onclick="HandleManualLogout" title="Sign Out">
                <i class="bi bi-box-arrow-right"></i>
            </button>
        </div>
    </div>
        
</div>

<div class="tablet-body">
<div class="glass-page-container mobile-version">
    <NavigationLock ConfirmExternalNavigation="@HasUnsavedChanges" OnBeforeInternalNavigation="OnBeforeInternalNavigation" />
    <style>
        /* HARD TABLET-ONLY OVERRIDES: Nuking all phone-sized logic */
        .glass-page-container.mobile-version { 
            max-width: none !important; 
            width: 100% !important; 
            margin: 0 !important; 
            padding: 0 !important;
            border-radius: 0 !important;
            box-shadow: none !important;
        }
        .page-content-wrapper { 
            max-width: none !important; 
            width: 100% !important; 
            margin: 0 !important; 
            padding: 0 !important;
        }
        /* Lock the viewport for touch devices */
        body { overflow: hidden !important; width: 100vw !important; height: 100vh !important; }
    </style>
    
    @if (Submitted && !IsSubmitting)
    {
        <div class="glass-modal-overlay success-overlay">
            <div class="glass-modal-card animate-zoom-in">
                <div class="glass-modal-header-icon success">
                    <i class="bi bi-check-circle-fill"></i>
                </div>
                <h3 class="fw-black text-dark mb-2">REPORT SECURED</h3>
                <p class="text-muted mb-4 px-3">Shift data successfully recorded. Returning to portal...</p>
                <div class="d-flex justify-content-center">
                    <div class="spinner-border text-success spinner-border-sm" role="status"></div>
                </div>
            </div>
        </div>
    }

    @if (_showSubmitConfirm)
    {
        <div class="glass-modal-overlay">
            <div class="glass-modal-card animate-zoom-in" style="max-width: 450px;">
                <div class="glass-modal-header-icon success mb-3" style="background: rgba(13, 110, 253, 0.05); color: #0d6efd; border-color: rgba(13, 110, 253, 0.1);">
                    <i class="bi bi-send-fill"></i>
                </div>
                <h3 class="fw-black text-dark mb-1 text-uppercase">Review & Submit</h3>
                <p class="text-muted small mb-4">Please verify these numbers before securing the report.</p>
                
                <div class="text-start bg-light rounded-4 p-3 mb-4 border">
                    <div class="math-row opacity-75 mb-1" style="font-size: 0.75rem;">
                        <span class="fw-bold"><i class="bi bi-clock me-2"></i>Hours:</span>
                        <span class="fw-black">@((TotalHours ?? 0).ToString("N2"))</span>
                    </div>
                    <div class="math-row opacity-75 mb-1" style="font-size: 0.75rem;">
                        <span class="fw-bold"><i class="bi bi-cash-stack me-2"></i>Bar Sales:</span>
                        <span class="fw-black">@((BarSales ?? 0).ToString("C2"))</span>
                    </div>
                    <div class="math-row border-top pt-2" style="font-size: 0.8rem;">
                        <span class="fw-bold text-primary"><i class="bi bi-ticket-perforated me-2"></i>Lottery Variance:</span>
                        <span class="fw-black @(LottoDiscrepancy == 0 ? "text-success" : "text-danger")">
                            @((LottoDiscrepancy == 0 ? "$0.00" : (LottoDiscrepancy > 0 ? "+" : "-") + "$" + Math.Abs(LottoDiscrepancy).ToString("N2")))
                        </span>
                    </div>
                </div>

                <div class="d-flex flex-column gap-2">
                    <button type="button" class="btn btn-primary w-100 py-3 rounded-pill fw-black shadow-sm" @onclick="ProceedWithSubmit">
                        <i class="bi bi-check2-circle me-2"></i> CONFIRM & SUBMIT
                    </button>
                    <button type="button" class="btn btn-light w-100 py-3 rounded-pill fw-bold text-muted border" @onclick="() => _showSubmitConfirm = false">
                        BACK TO EDIT
                    </button>
                </div>
            </div>
        </div>
    }

    @if (_showUnsavedModal)
    {
        <div class="glass-modal-overlay">
            <div class="glass-modal-card animate-zoom-in">
                <div class="glass-modal-header-icon warning">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                </div>
                <h3 class="fw-black text-dark mb-2 text-uppercase">@_modalTitle</h3>
                <p class="text-muted mb-4 px-3">@_modalMessage</p>
                <div class="glass-modal-actions">
                    <button type="button" class="btn-modal btn-modal-stay" @onclick="() => _showUnsavedModal = false">
                        STAY HERE
                    </button>
                    <button type="button" class="btn-modal btn-modal-leave" @onclick="ProceedWithAction">
                        DISCARD & CONTINUE
                    </button>
                </div>
            </div>
        </div>
    }

    <div class="page-content-wrapper">

        @if (Submitted)
        {
            <div class="p-4 text-center mt-5">
                <div class="success-icon-box mb-4 mx-auto shadow-lg">
                    <i class="bi bi-check2-circle"></i>
                </div>
                <h2 class="fw-black mb-2">Report Secured!</h2>
                <p class="text-muted mb-5">Your end-of-shift data has been successfully recorded in the audit logs.</p>
                <div class="d-grid gap-3">
                    <button class="btn btn-primary rounded-pill py-3 fw-bold shadow" @onclick="HandleCancel">
                        <i class="bi bi-speedometer2 me-2"></i> Dashboard
                    </button>
                    <button class="btn btn-link text-muted text-decoration-none small" @onclick="() => Submitted = false">
                        <i class="bi bi-pencil-square me-1"></i> Edit Shift Report
                    </button>
                </div>
            </div>
        }
        else if (Loading)
        {
            <div class="d-flex flex-column align-items-center justify-content-center py-5 mt-5">
                <div class="loader-ring mb-3"></div>
                <span class="text-muted fw-bold text-uppercase" style="letter-spacing: 0.1em;">Loading Shift State...</span>
            </div>
        }
        else
        {
            <!-- TOP FULL-WIDTH HEADER -->
            <div class="col-12 mb-2 animate-slide-up">
                    <div class="form-glass-card shadow-lg p-2 border-start border-4 border-primary">
                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                            <div class="d-flex align-items-center gap-3">
                                <div class="hud-item-modern d-flex align-items-center gap-2">
                                    <span class="fw-black text-muted text-uppercase" style="font-size: 0.65rem; white-space: nowrap;"><i class="bi bi-calendar-check me-1"></i> DATE</span>
                                    <div class="d-flex align-items-center bg-light rounded-3 px-2 gap-1">
                                        <input type="date" class="border-0 bg-transparent py-1 fw-black fs-6" 
                                               @bind-value="ReportDate" @bind-value:after="OnDateChanged"
                                               max="@DateTime.Today.ToString("yyyy-MM-dd")"
                                               disabled="@IsLocked" style="width: 140px; outline: none;" />
                                        <span class="badge bg-primary bg-opacity-25 text-primary fw-black text-uppercase p-2" style="font-size: 0.75rem; min-width: 100px;">@ReportDate.ToString("dddd")</span>
                                    </div>
                                </div>
                                <div class="hud-item-modern d-flex align-items-center gap-2">
                                    <span class="fw-black text-muted text-uppercase" style="font-size: 0.65rem; white-space: nowrap;"><i class="bi bi-clock-history me-1"></i> SHIFT WORKING</span>
                                    <div class="d-flex shadow-sm rounded-4 overflow-hidden border border-2 bg-white p-1 gap-1">
                                        <button class='btn py-2 px-3 rounded-3 fw-black border-0 d-flex flex-column align-items-center justify-content-center gap-1 @(ShiftType == "Day" ? "btn-primary shadow" : "btn-light text-muted")' @onclick='() => SetShift("Day")' disabled="@IsLocked" style="font-size: 0.75rem; min-width: 90px;">
                                            <div><i class="bi bi-sun-fill @(ShiftType == "Day" ? "text-warning" : "")"></i> DAY</div>
                                            @if (_dayMainSubmitted) { <span class="badge bg-success" style="font-size: 0.5rem; letter-spacing: 0.05em; padding: 2px 4px;">DONE</span> }
                                            else if (_dayMainHasData) { <span class="badge bg-warning text-dark" style="font-size: 0.5rem; letter-spacing: 0.05em; padding: 2px 4px;">SAVING</span> }
                                        </button>
                                        <button class='btn py-2 px-3 rounded-3 fw-black border-0 d-flex flex-column align-items-center justify-content-center gap-1 @(ShiftType == "Night" ? "btn-primary shadow" : "btn-light text-muted")' @onclick='() => SetShift("Night")' disabled="@IsLocked" style="font-size: 0.75rem; min-width: 90px;">
                                            <div><i class="bi bi-moon-stars-fill @(ShiftType == "Night" ? "text-warning" : "")"></i> NIGHT</div>
                                            @if (_nightMainSubmitted) { <span class="badge bg-success" style="font-size: 0.5rem; letter-spacing: 0.05em; padding: 2px 4px;">DONE</span> }
                                            else if (_nightMainHasData) { <span class="badge bg-warning text-dark" style="font-size: 0.5rem; letter-spacing: 0.05em; padding: 2px 4px;">SAVING</span> }
                                        </button>
                                    </div>
                                </div>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <button type="button" class='btn btn-md @(IsRentalHall ? "btn-danger" : "btn-indigo") rounded-4 px-3 py-2 fw-black shadow-sm text-uppercase' @onclick="ToggleRentalHall" disabled="@IsLocked" style="min-width: 250px; font-size: 0.7rem;">
                                    <i class="bi @(IsRentalHall ? "bi-building-up" : "bi-shop") me-2"></i> @(IsRentalHall ? "RETURN TO DOWNSTAIRS BAR SALES ENTRY" : "UPSTAIRS BAR SALES ENTRY")
                                </button>
                                @if (IsLocked) {
                                    <div class="bg-warning text-dark px-4 py-3 rounded-4 fw-black shadow-sm"><i class="bi bi-lock-fill me-2 fs-5"></i> LOCKED</div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
                <!-- MAIN WORKSPACE: 2 COLUMNS -->
                <div class="tablet-grid">
                    <div class="tablet-col-left">
                        @if (string.IsNullOrEmpty(ShiftType))
                        {
                            <div class="d-flex flex-column align-items-center justify-content-center p-5 h-100 animate-slide-up">
                                <div class="welcome-icon mb-4">
                                    <i class="bi bi-clock-history"></i>
                                </div>
                                <h2 class="fw-black text-dark mb-2">SELECT YOUR SHIFT</h2>
                                <p class="text-muted text-center mb-5 fs-5">Pick a shift to begin entering your end-of-shift report.</p>
                                
                                <div class="d-flex gap-4 w-100 justify-content-center">
                                    <button class="btn btn-lg btn-outline-primary rounded-4 p-4 d-flex flex-column align-items-center gap-2 shadow-sm flex-fill max-w-250 animate-bounce-in position-relative" @onclick='() => SetShift("Day")'>
                                        @if (_dayMainSubmitted) {
                                            <div class="status-ribbon success"><i class="bi bi-check-circle-fill me-1"></i> COMPLETED</div>
                                        } else if (_dayMainHasData) {
                                            <div class="status-ribbon warning"><i class="bi bi-clock-history me-1"></i> IN PROGRESS</div>
                                        }
                                        <i class="bi bi-sun-fill fs-1 mt-2 @(_dayMainSubmitted ? "text-success" : "")"></i>
                                        <span class="fw-black text-uppercase letter-spacing-1">Day Shift</span>
                                    </button>
                                    <button class="btn btn-lg btn-outline-primary rounded-4 p-4 d-flex flex-column align-items-center gap-2 shadow-sm flex-fill max-w-250 animate-bounce-in position-relative" style="animation-delay: 0.1s;" @onclick='() => SetShift("Night")'>
                                        @if (_nightMainSubmitted) {
                                            <div class="status-ribbon success"><i class="bi bi-check-circle-fill me-1"></i> COMPLETED</div>
                                        } else if (_nightMainHasData) {
                                            <div class="status-ribbon warning"><i class="bi bi-clock-history me-1"></i> IN PROGRESS</div>
                                        }
                                        <i class="bi bi-moon-stars-fill fs-1 mt-2 @(_nightMainSubmitted ? "text-success" : "")"></i>
                                        <span class="fw-black text-uppercase letter-spacing-1">Night Shift</span>
                                    </button>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="form-glass-card p-3 mb-2">
                                <div class="d-flex justify-content-between align-items-center mb-2 border-bottom border-2 pb-1">
                                    <label class="section-label mb-0 fw-black text-primary" style="font-size: 0.75rem;"><i class="bi bi-shop me-2"></i> BAR REGISTER SALES & LABOR</label>
                                    @if (TotalHours > 0 && BarSales > 0) {
                                        <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 rounded-pill px-2" style="font-size: 0.55rem; letter-spacing: 0.05em;"><i class="bi bi-check-circle-fill me-1"></i> SECTION COMPLETE</span>
                                    }
                                </div>
                                <div class="d-flex flex-column gap-2 mb-2">
                                    <div class='input-group-modern @(_activeField == "Hours" ? "focused" : "") @(TotalHours > 0 ? "active" : "")' @onclick='() => ActivateField("Hours")' style="height: 75px; padding: 12px 18px;">
                                        <div class="d-flex align-items-center justify-content-between w-100">
                                            <div class="d-flex flex-column">
                                                <span class="fw-black text-muted text-uppercase" style="font-size: 0.8rem; letter-spacing: 0.05em;">TOTAL HOURS WORKED</span>
                                                <span class="text-muted small" style="font-size: 0.6rem;">EMPLOYEE LABOR TIME <i class="bi bi-clock"></i></span>
                                            </div>
                                            <div class="d-flex align-items-center">
                                                <input type="text" class="form-input-modern text-end fw-black" style="font-size: 1.8rem; width: 140px;" value='@(TotalHours?.ToString("N2") ?? "")' readonly placeholder="0.00" />
                                            </div>
                                        </div>
                                    </div>
                                    <div class='input-group-modern @(_activeField == "BarSales" ? "focused" : "") @(BarSales > 0 ? "active" : "")' @onclick='() => ActivateField("BarSales")' style="height: 75px; padding: 12px 18px;">
                                        <div class="d-flex align-items-center justify-content-between w-100">
                                            <div class="d-flex flex-column">
                                                <span class="fw-black text-muted text-uppercase" style="font-size: 0.8rem; letter-spacing: 0.05em;">BAR REGISTER SALES</span>
                                                <span class="text-muted small" style="font-size: 0.6rem;">TOTAL FROM Z-REPORT <i class="bi bi-cash-register"></i></span>
                                            </div>
                                            <div class="d-flex align-items-center">
                                                <span class="input-addon text-muted" style="font-size: 1.4rem;">$</span>
                                                <input type="text" class="form-input-modern text-end fw-black" style="font-size: 1.8rem; width: 140px;" value='@(BarSales?.ToString("N2") ?? "")' readonly placeholder="0.00" />
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            @if (!IsRentalHall)
                            {
                                <div class="form-glass-card p-3 mb-2">
                                    <div class="d-flex justify-content-between align-items-center mb-2 border-bottom border-2 pb-1">
                                        <label class="section-label mb-0 fw-black text-indigo" style="font-size: 0.75rem;"><i class="bi bi-ticket-perforated me-2"></i> LOTTERY RECONCILIATION</label>
                                        @if (LottoSales > 0 && LottoCashes > 0 && LottoCashCounted > 0 && _lottoSignConfirmed) {
                                            <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 rounded-pill px-2" style="font-size: 0.55rem; letter-spacing: 0.05em;"><i class="bi bi-check-circle-fill me-1"></i> SECTION COMPLETE</span>
                                        }
                                    </div>
                                    <div class="row g-2">
                                        <div class="col-12 d-flex flex-wrap gap-2">
                                            <div class='input-group-modern flex-fill @(_activeField == "LottoOpeningCash" ? "focused" : "") @(LottoOpeningCash > 0 ? "active" : "")' @onclick='() => ActivateField("LottoOpeningCash")'>
                                                <div class="d-flex align-items-center justify-content-between w-100">
                                                    <div class="d-flex flex-column">
                                                        <span class="fw-black text-muted text-uppercase" style="font-size: 1.0rem; line-height: 1.1;">Beginning Drawer Cash</span>
                                                        <span class="text-muted fw-bold small" style="font-size: 0.65rem;">(STARTING DRAWER CASH)</span>
                                                    </div>
                                                    <div class="d-flex align-items-center">
                                                        <span class="input-addon text-muted" style="font-size: 1.2rem;">$</span>
                                                        <input type="text" class="form-input-modern text-end fw-black" style="font-size:1.5rem; width: 130px;" value='@(LottoOpeningCash?.ToString("N2") ?? "")' readonly placeholder="0.00" />
                                                    </div>
                                                </div>
                                            </div>
                                            <div class='input-group-modern flex-fill @(_activeField == "LottoSales" ? "focused" : "") @(LottoSales > 0 ? "active" : "")' @onclick='() => ActivateField("LottoSales")'>
                                                <div class="d-flex align-items-center justify-content-between w-100">
                                                    <div class="d-flex flex-column">
                                                        <span class="fw-black text-success text-uppercase" style="font-size: 1.1rem; line-height: 1.0;">Net Sales</span>
                                                        <span class="fw-bold text-success small" style="font-size: 0.65rem;">(FROM REPORT 50)</span>
                                                    </div>
                                                    <div class="d-flex align-items-center">
                                                        <span class="input-addon text-success" style="font-size: 1.2rem;">$</span>
                                                        <input type="text" class="form-input-modern text-end fw-black" style="font-size: 1.5rem; width: 130px;" value='@(LottoSales?.ToString("N2") ?? "")' readonly placeholder="0.00" />
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-12 d-flex flex-wrap gap-2">
                                            <div class='input-group-modern flex-fill @(_activeField == "LottoCashes" ? "focused" : "") @(LottoCashes > 0 ? "active" : "")' @onclick='() => ActivateField("LottoCashes")'>
                                                <div class="d-flex align-items-center justify-content-between w-100">
                                                    <div class="d-flex flex-column">
                                                        <span class="fw-black text-danger text-uppercase" style="font-size: 1.1rem; line-height: 1.0;">Cashes</span>
                                                        <span class="fw-bold text-danger small" style="font-size: 0.65rem;">(FROM REPORT 50)</span>
                                                    </div>
                                                    <div class="d-flex align-items-center">
                                                        <span class="input-addon text-danger" style="font-size: 1.2rem;">$</span>
                                                        <input type="text" class="form-input-modern text-end fw-black" style="font-size: 1.5rem; width: 130px;" value='@(LottoCashes?.ToString("N2") ?? "")' readonly placeholder="0.00" />
                                                    </div>
                                                </div>
                                            </div>
                                            <div class='input-group-modern flex-fill @(_activeField == "LottoNetDue" ? "focused" : "") @(LottoNetDue != null && LottoNetDue != 0 && _lottoSignConfirmed ? "active" : "")' @onclick='() => ActivateField("LottoNetDue")'>
                                                <div class="d-flex align-items-center justify-content-between w-100">
                                                    <div class="d-flex flex-column">
                                                        <div class="d-flex align-items-center gap-2">
                                                            <span class="fw-black text-primary text-uppercase" style="font-size: 1.1rem; line-height: 1.0;">Net Due</span>
                                                            @if (LottoNetDue < 0 && _lottoSignConfirmed) {
                                                                <span class="badge bg-danger rounded-pill px-2 py-1" style="font-size: 0.6rem;">NEGATIVE (-)</span>
                                                            } else if (LottoNetDue > 0 && _lottoSignConfirmed) {
                                                                <span class="badge bg-success rounded-pill px-2 py-1" style="font-size: 0.6rem;">POSITIVE (+)</span>
                                                            }
                                                        </div>
                                                        <span class="fw-bold text-primary small" style="font-size: 0.65rem;">(FROM REPORT 50)</span>
                                                    </div>
                                                    <div class="d-flex align-items-center">
                                                        <span class="input-addon text-primary" style="font-size: 1.2rem;">$</span>
                                                        <input type="text" class="form-input-modern text-end fw-black @(LottoNetDue < 0 ? "text-danger" : LottoNetDue > 0 ? "text-success" : "")" style="font-size: 1.5rem; width: 130px;" value='@((LottoNetDue < 0 ? "-" : "") + Math.Abs(LottoNetDue ?? 0).ToString("N2"))' readonly placeholder="0.00" />
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-12 d-flex flex-wrap gap-2">
                                            <div class='input-group-modern flex-fill @(_activeField == "LottoInstantTickets" ? "focused" : "") @(LottoInstantTickets > 0 ? "active" : "")' @onclick='() => ActivateField("LottoInstantTickets")'>
                                                <div class="d-flex align-items-center justify-content-between w-100">
                                                    <div class="d-flex flex-column">
                                                        <div class="d-flex align-items-center">
                                                            <i class="bi bi-ticket-perforated-fill text-purple me-1" style="font-size: 1rem;"></i>
                                                            <span class="fw-black text-purple text-uppercase" style="font-size: 1.1rem; line-height: 1.0;">Tickets</span>
                                                        </div>
                                                        <span class="fw-bold text-purple small" style="font-size: 0.65rem;">(FROM REPORT 34)</span>
                                                    </div>
                                                    <div class="d-flex align-items-center">
                                                        <span class="input-addon text-purple" style="font-size: 1.2rem;">$</span>
                                                        <input type="text" class="form-input-modern text-purple fw-black text-end" style="font-size: 1.5rem; width: 130px;" value='@(LottoInstantTickets?.ToString("N2") ?? "")' readonly placeholder="0.00" />
                                                    </div>
                                                </div>
                                            </div>
                                            <div class='input-group-modern flex-fill @(_activeField == "LottoBackupBag" ? "focused" : "") @(LottoBackupBag > 0 ? "active" : "")' @onclick='() => ActivateField("LottoBackupBag")'>
                                                <div class="d-flex align-items-center justify-content-between w-100">
                                                    <div class="d-flex flex-column">
                                                        <span class="fw-black text-muted text-uppercase" style="font-size: 0.95rem; line-height: 1.1;">Removed From Backup Money Bag</span>
                                                        <span class="text-muted fw-bold small" style="font-size: 0.65rem;">(MONEY REMOVED FROM THE BAG TO ADD TO CASH DRAWER)</span>
                                                    </div>
                                                    <div class="d-flex align-items-center">
                                                        <span class="input-addon text-muted" style="font-size: 1.2rem;">$</span>
                                                        <input type="text" class="form-input-modern text-end fw-black" style="font-size:1.5rem; width: 130px;" value='@(LottoBackupBag?.ToString("N2") ?? "")' readonly placeholder="0.00" />
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="separator-dots my-2"><span></span><span></span><span></span></div>

                                    <div class="d-flex flex-column mt-2">
                                        <div class='input-group-modern @(_activeField == "LottoCashCounted" ? "focused" : "") @(LottoCashCounted > 0 ? "active" : "") border-primary border-opacity-25' @onclick='() => ActivateField("LottoCashCounted")' style="background: rgba(13, 110, 253, 0.02); height: 90px; padding: 15px 20px;">
                                            <div class="d-flex justify-content-between align-items-center w-100 h-100">
                                                <div class="d-flex flex-column justify-content-center">
                                                    <span class="fw-black text-primary text-uppercase" style="letter-spacing: 0.05em; font-size: 1.15rem; line-height: 1;">ENDING DRAWER CASH</span>
                                                    <span class="text-primary fw-bold small opacity-75 mt-1" style="font-size: 0.7rem;">CASH COUNTED IN DRAWER</span>
                                                </div>
                                                <div class="d-flex align-items-center h-100">
                                                    <span class="text-primary fw-black me-3" style="font-size: 2rem;">$</span>
                                                    <input type="text" class="form-input-modern text-end fw-black" style="font-size: 2.5rem; width: 180px; color: var(--bs-primary) !important;" value='@(LottoCashCounted?.ToString("N2") ?? "")' readonly placeholder="0.00" />
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }

                            <div class="form-glass-card shadow-sm p-3 mb-3">
                                <label class="small text-muted fw-bold text-uppercase mb-2" style="font-size:0.65rem;">Shift Notes &amp; Discrepancies</label>
                                <textarea class="form-control-modern" rows="3" placeholder="Type details here..." @bind="Notes" disabled="@IsLocked"></textarea>
                            </div>
                        }
                    </div>

                <!-- ===== RIGHT COLUMN: KEYPAD AREA ===== -->
                <div class="tablet-col-right">
                    @if (!string.IsNullOrEmpty(ShiftType) && !IsRentalHall)
                    {
                        <div class="sim-res-card-unified shadow-lg mb-3 @(LottoDiscrepancy == 0 ? "exact" : LottoDiscrepancy > 0 ? "over" : "short")">
                            <div class="summary-header">
                                <i class="bi bi-calculator-fill me-2 opacity-50"></i> LOTTERY RECONCILIATION SUMMARY
                            </div>
                            <div class="math-flow-table p-2">
                                <div class="math-row opacity-60 mb-1" style="font-size: 0.6rem;">
                                    <span>🏦 STARTING CASH</span>
                                    <span class="fw-bold">@((LottoOpeningCash ?? 0).ToString("C2"))</span>
                                </div>
                                <div class="math-row opacity-50 ps-2" style="font-size: 0.55rem;">
                                    <span><i class="bi bi-plus small"></i> Sales (RPT 50)</span>
                                    <span>+@((LottoSalesActivity).ToString("N2"))</span>
                                </div>
                                <div class="math-row opacity-50 ps-2" style="font-size: 0.55rem;">
                                    <span><i class="bi bi-dash small"></i> Cashes (RPT 50)</span>
                                    <span>-@((LottoCashes ?? 0).ToString("N2"))</span>
                                </div>
                                <div class="math-row opacity-50 ps-2 mb-1" style="font-size: 0.55rem;">
                                    <span><i class="bi bi-dash small"></i> Tickets (RPT 34)</span>
                                    <span>-@((LottoInstantTickets ?? 0).ToString("N2"))</span>
                                </div>
                                
                                <div class="math-row border-top mt-1 pt-1 mb-1 @(LottoNetMade >= 0 ? "text-success" : "text-danger")" style="font-size: 0.7rem;">
                                    <span class="fw-bold">⚡ LOTTERY NET REV</span>
                                    <span class="fw-black">@(LottoNetMade >= 0 ? "+" : "")@(LottoNetMade.ToString("C2"))</span>
                                </div>
                                <div class="math-row total-expected border-top border-primary border-opacity-10 mt-1 pt-1">
                                    <span class="fw-black text-primary" style="font-size: 0.65rem;">🎯 EXPECTED DRAWER</span>
                                    <span class="fw-black text-primary fs-5">@(LottoDrawerValue.ToString("C2"))</span>
                                </div>
                                <div class="math-row text-muted opacity-60 mt-0">
                                    <span class="small fw-bold">💵 MINUS COUNT</span>
                                    <span class="small fw-bold">-@((LottoCashCounted ?? 0).ToString("C2"))</span>
                                </div>
                            </div>
                            <div class="variance-footer-banner py-3 shadow-sm" style="display: block !important;">
                                <div class="v-label fw-black mb-0">LOTTERY VARIANCE</div>
                                <div class="v-value fs-2 fw-black">@((LottoDiscrepancy == 0 ? "$0.00" : (LottoDiscrepancy > 0 ? "+" : "-") + "$" + Math.Abs(LottoDiscrepancy).ToString("N2")))</div>
                            </div>
                        </div>
                    }

                    <div class="keypad-container shadow-lg animate-slide-up" style="animation-delay: 0.3s;">
                        <div class="keypad-header">
                            @if (_activeField == "LottoNetDue" && LottoNetDue != 0 && LottoNetDue != null) {
                                <div class="px-2 py-2 bg-warning bg-opacity-10 border border-warning border-opacity-30 rounded-4 mb-2 animate-bounce-in shadow-sm">
                                    <p class="text-center fw-black text-dark mb-2 text-uppercase" style="font-size: 0.7rem;">Is this a Negative Value?</p>
                                    <div class="d-flex gap-2">
                                        <button class='btn flex-fill py-3 fw-black shadow-sm @(LottoNetDue < 0 && _lottoSignConfirmed ? "btn-danger active" : "btn-light border")' @onclick="() => SetLottoSign(-1)" style="font-size: 0.85rem;">
                                            <i class="bi bi-dash-circle-fill"></i> YES(-)
                                        </button>
                                        <button class='btn flex-fill py-3 fw-black shadow-sm @(LottoNetDue > 0 && _lottoSignConfirmed ? "btn-success active" : "btn-light border")' @onclick="() => SetLottoSign(1)" style="font-size: 0.85rem;">
                                            <i class="bi bi-plus-circle-fill"></i> NO(+)
                                        </button>
                                    </div>
                                </div>
                            } 
                            
                            @* Keypad titles removed for cleaner look *@
                        </div>
                        
                        <div class="keypad-grid">
                            <button class="key-btn" @onclick='() => KeyPressed("1")'>1</button>
                            <button class="key-btn" @onclick='() => KeyPressed("2")'>2</button>
                            <button class="key-btn" @onclick='() => KeyPressed("3")'>3</button>
                            
                            <button class="key-btn" @onclick='() => KeyPressed("4")'>4</button>
                            <button class="key-btn" @onclick='() => KeyPressed("5")'>5</button>
                            <button class="key-btn" @onclick='() => KeyPressed("6")'>6</button>
                            
                            <button class="key-btn" @onclick='() => KeyPressed("7")'>7</button>
                            <button class="key-btn" @onclick='() => KeyPressed("8")'>8</button>
                            <button class="key-btn" @onclick='() => KeyPressed("9")'>9</button>
                            
                            <button class="key-btn ivory-btn" @onclick='TogglePolarity'><i class="bi bi-plus-minus"></i></button>
                            <button class="key-btn" @onclick='() => KeyPressed("0")'>0</button>
                            <button class="key-btn" @onclick='() => KeyPressed(".")'>.</button>

                            <button class="key-btn btn-clear" style="grid-column: span 3; height: 55px !important; font-size: 1.2rem !important;" @onclick='ClearCurrentField'>
                                <i class="bi bi-backspace-fill me-2"></i> CLEAR FIELD
                            </button>
                        </div>
                        
                        <div class="keypad-actions mt-2 p-2 pt-0">
                            @if (_activeField == "LottoNetDue" && !_lottoSignConfirmed && LottoNetDue != 0 && LottoNetDue != null) {
                                <div class="alert alert-warning p-2 rounded-4 text-center mb-2 animate-pulse">
                                    <i class="bi bi-exclamation-triangle-fill me-2"></i> MUST CHOOSE <strong>YES</strong> OR <strong>NO</strong> ABOVE
                                </div>
                            }
                            <div class="row g-2">
                                <div class="col-6">
                                    <button class="btn btn-secondary w-100 py-3 rounded-4 fw-black" @onclick="PrevField" disabled='@(_activeField == "LottoNetDue" && !_lottoSignConfirmed && LottoNetDue != 0 && LottoNetDue != null)'><i class="bi bi-arrow-left"></i> PREV</button>
                                </div>
                                <div class="col-6">
                                    <button class="btn btn-primary w-100 py-3 rounded-4 fw-black" @onclick="NextField" disabled='@(_activeField == "LottoNetDue" && !_lottoSignConfirmed && LottoNetDue != 0 && LottoNetDue != null)'>NEXT <i class="bi bi-arrow-right"></i></button>
                                </div>
                                <div class="col-12 mt-2">
                                    <button class="btn btn-action-submit w-100 py-4 rounded-4 fw-black fs-5 shadow" 
                                            disabled="@(IsSubmitting || IsLocked || (_activeField == "LottoNetDue" && !_lottoSignConfirmed && LottoNetDue != 0 && LottoNetDue != null))" @onclick="HandleFinalConfirm">
                                        <i class="bi bi-send-check-fill me-2"></i> SUBMIT REPORT
                                    </button>
                                    @if (ExistingEntryFound && !IsLocked) {
                                        <p class="text-center mt-2 mb-0 small text-success fw-bold"><i class="bi bi-clock-history"></i> Still editable for 1 hour after entry.</p>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        }
    </div>
</div>
</div>

<!-- ============================
     LOTTERY CALCULATION GUIDE
     ============================ -->
@if (_showGuide)
{
    <div class="guide-backdrop" @onclick="() => _showGuide = false"></div>
    <div class="guide-panel">
        <div class="guide-panel-inner">
            <div class="guide-header">
                <div>
                    <h4 class="fw-black mb-0" style="color:white;"><i class="bi bi-ticket-perforated me-2 text-warning"></i>Lottery Calculation Guide</h4>
                    <p style="color:rgba(255,255,255,0.7); font-size:0.8rem;" class="mb-0 mt-1">What to enter · How the math works · What each result means</p>
                </div>
                <button class="btn btn-sm btn-outline-light rounded-pill" @onclick="() => _showGuide = false">
                    <i class="bi bi-x-lg me-1"></i> Close
                </button>
            </div>

            <div class="guide-body">

                <!-- MODE SELECT INFO -->
                <div class="guide-section">
                    <div class="guide-section-title"><i class="bi bi-info-circle-fill me-1 text-primary"></i> HOW SHIFT CARRY OVER WORKS</div>
                    <p class="small text-muted mb-0">This system uses <strong>Shift Carry Over</strong> to link the Day and Night shifts together. Because lottery machines report <em>cumulative totals</em> (not per-shift), the Night bartender enters the full machine numbers and the system automatically subtracts the Day shift's contribution to isolate each shift's performance.</p>
                </div>

                <!-- MAIN GUIDE CONTENT -->
                <div class="guide-two-col">
                    <div class="guide-section">
                        <div class="guide-section-title"><i class="bi bi-receipt me-1"></i> FROM THE TICKET — ENTER THESE 3 LINES</div>
                        <div class="text-center p-3 border rounded-3 bg-light" style="font-size:0.78rem;">
                            <div class="fw-black mb-2" style="letter-spacing:0.05em;">THE LOTTERY</div>
                            <div class="text-muted small">DAILY INVOICE REPORT</div>
                            <div class="mt-2 text-start" style="font-size:0.75rem;">
                                <div class="d-flex justify-content-between"><span>TOTAL SALES</span><span>1,504.00</span></div>
                                <div class="d-flex justify-content-between text-success fw-bold"><span>★ NET SALES</span><span>1,504.00</span></div>
                                <div class="d-flex justify-content-between text-danger fw-bold"><span>★ CASHES</span><span>−944.50</span></div>
                                <div class="d-flex justify-content-between text-primary fw-bold"><span>★ NET DUE</span><span>476.38</span></div>
                            </div>
                        </div>
                        <div class="mt-2 text-muted" style="font-size:0.75rem;">— Also enter <strong>Tickets (Inst. Rpt 34)</strong> if applicable</div>
                    </div>

                    <div>
                        <div class="guide-section">
                            <div class="guide-section-title">HOW THE SYSTEM CALCULATES</div>
                            <div class="math-step">
                                <div class="math-step-header"><span class="math-step-num">STEP 1</span><span class="math-step-name">What should be in the drawer?</span></div>
                                <div class="math-chain">
                                    <div class="mc-pill mc-open">① BEGIN</div><div class="mc-op">+</div>
                                    <div class="mc-pill mc-sales">② SALES</div><div class="mc-op">−</div>
                                    <div class="mc-pill mc-cash">③ CASHES</div><div class="mc-op">−</div>
                                    <div class="mc-pill mc-tickets">④ TICKETS</div><div class="mc-op">+</div>
                                    <div class="mc-pill mc-bag">⑥ BAG</div><div class="mc-op">=</div>
                                    <div class="mc-pill mc-result">EXPECTED</div>
                                </div>
                                <div class="math-example">e.g. $1,200 + $1,504 − $944.50 − $0 + $0 = <strong>$1,759.50 expected</strong></div>
                            </div>
                            <div class="math-step mt-3">
                                <div class="math-step-header"><span class="math-step-num">STEP 2</span><span class="math-step-name">Is the drawer right?</span></div>
                                <div class="math-chain">
                                    <div class="mc-pill mc-counted">⑦ ENDING CASH</div><div class="mc-op">−</div>
                                    <div class="mc-pill mc-result">EXPECTED</div><div class="mc-op">=</div>
                                    <div class="mc-pill mc-variance">VARIANCE</div>
                                </div>
                                <div class="math-example">e.g. $1,759.50 − $1,759.50 = <strong>$0.00 variance</strong> ✓</div>
                            </div>
                            <div class="math-step mt-3">
                                <div class="math-step-header"><span class="math-step-num">STEP 3</span><span class="math-step-name">Settlement: Shift Carry Over Mode</span></div>
                                <div class="p-3 rounded-3 border bg-white shadow-sm border-start border-4 border-primary">
                                    <div class="d-flex align-items-center gap-2 mb-2">
                                        <span class="badge bg-primary">SHIFT CARRY OVER MODE</span>
                                        <span class="text-muted" style="font-size:0.7rem;"><em>Linked Day &amp; Night Audits</em></span>
                                    </div>
                                    <p class="small text-muted mb-3">This mode links the Day and Night shifts together so that <strong>one full day of lottery profit is settled at the end of the Night shift</strong>. The Day bartender does not pull an envelope — they hand the entire drawer to the Night bartender as their opening cash.</p>

                                    <div class="d-flex flex-column gap-2">
                                        <!-- DAY SHIFT -->
                                        <div class="p-2 rounded-2 bg-light border">
                                            <div class="fw-black text-primary mb-1" style="font-size:0.7rem; letter-spacing:0.05em;"><i class="bi bi-sun-fill me-1 text-warning"></i> DAY SHIFT</div>
                                            <ul class="small text-muted mb-1 ps-3">
                                                <li><strong>Opening cash</strong> is whatever is in the drawer at the start of the day (typically $1,200).</li>
                                                <li>Enter your ticket numbers as normal (Net Sales, Cashes, Tickets, Net Due).</li>
                                                <li><strong>No envelope is pulled.</strong> Your entire counted cash stays in the drawer.</li>
                                                <li>The system records your Day shift totals so Night can subtract them from the cumulative machine report.</li>
                                            </ul>
                                            <div class="math-chain mt-1">
                                                <div class="mc-pill mc-open">① $1,200 BEGIN</div><div class="mc-op">+</div>
                                                <div class="mc-pill mc-sales">DAY NET MADE</div><div class="mc-op">=</div>
                                                <div class="mc-pill mc-result">NIGHT OPENING CASH</div>
                                            </div>
                                        </div>

                                        <!-- NIGHT SHIFT -->
                                        <div class="p-2 rounded-2 bg-light border">
                                            <div class="fw-black text-primary mb-1" style="font-size:0.7rem; letter-spacing:0.05em;"><i class="bi bi-moon-stars-fill me-1 text-indigo"></i> NIGHT SHIFT</div>
                                            <ul class="small text-muted mb-1 ps-3">
                                                <li><strong>Opening cash</strong> is automatically carried over from the Day shift's final count.</li>
                                                <li>Enter the <em>cumulative</em> machine totals from the ticket (the machine doesn't reset between shifts).</li>
                                                <li>The system subtracts the Day shift's numbers to isolate only the Night shift's performance.</li>
                                                <li>Your variance is checked against the <em>full day's</em> expected drawer, not just your shift.</li>
                                                <li><strong>Pull one envelope</strong> at the end of Night to return the drawer to $1,200.</li>
                                            </ul>
                                            <div class="math-chain mt-1">
                                                <div class="mc-pill mc-counted">⑦ NIGHT COUNT</div><div class="mc-op">−</div>
                                                <div class="mc-pill mc-result" style="background:#f1f5f9;color:#475569;">$1,200</div><div class="mc-op">=</div>
                                                <div class="mc-pill mc-result">ENVELOPE (PULL)</div>
                                            </div>
                                        </div>

                                        <!-- WHY IT EXISTS -->
                                        <div class="p-2 rounded-2" style="background:#eff6ff; border:1px solid #bfdbfe;">
                                            <div class="fw-black mb-1" style="font-size:0.7rem; color:#1d4ed8; letter-spacing:0.05em;"><i class="bi bi-lightbulb-fill me-1 text-warning"></i> WHY THIS MODE EXISTS</div>
                                            <p class="small text-muted mb-0">Lottery machines report <em>cumulative totals</em> — they don't reset between Day and Night shifts. Without Carry Over mode, the Night bartender would appear to cover the entire day's worth of sales, which isn't fair. This mode correctly isolates each shift's contribution and holds the <strong>Night shift responsible for the full day's settlement</strong>.</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
}

<style>
    .glass-page-container {
        --c-glass-bg: var(--bg-surface);
        --c-glass-border: var(--glass-border);
        --c-accent-primary: #0d6efd;
        --c-accent-success: #198754;
        --c-text-primary: var(--text-primary);
        --c-text-muted: var(--text-muted);
        --c-accent-indigo: #6366f1;

        min-height: 100vh;
        background: var(--bg-primary);
        font-family: 'Inter', system-ui, -apple-system, sans-serif;
        color: var(--c-text-primary);
        padding-bottom: 2rem;
    }

    .mobile-app-header {
        background: var(--bg-secondary);
        backdrop-filter: blur(10px);
        border-bottom: 1px solid var(--glass-border);
        position: sticky;
        top: 0;
        z-index: 100;
        transition: all 0.3s ease;
    }

    @@media (min-width: 992px) {
        .mobile-app-header {
            padding-top: 0.5rem !important;
            padding-bottom: 0.5rem !important;
            margin-bottom: 1.5rem !important;
        }
        .mobile-app-header h1 {
            font-size: 1.25rem;
        }
