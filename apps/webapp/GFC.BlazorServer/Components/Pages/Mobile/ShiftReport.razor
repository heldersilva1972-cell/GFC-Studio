@page "/mobile/shift-report"
@using Microsoft.AspNetCore.Authorization
@using GFC.BlazorServer.Auth
@using GFC.Core.Interfaces
@using GFC.Core.Models
@using GFC.BlazorServer.Data
@using Microsoft.EntityFrameworkCore
@inject NavigationManager Navigation
@inject CustomAuthenticationStateProvider AuthStateProvider
@inject ILotteryShiftRepository LotteryRepo
@inject IDbContextFactory<GfcDbContext> DbFactory
@inject IJSRuntime JSRuntime
@inject IAuditLogger AuditLogger
@inject IUserManagementService UserService
@attribute [Authorize]

<PageTitle>End of Shift | GFC Mobile</PageTitle>

<div class="viewport-fixed-hud">
    <div class="px-3 pt-4 mb-2 d-flex justify-content-between align-items-center">
        <div class="d-flex align-items-center gap-2">
            <button class="btn-home-pill" @onclick="HandleCancel">
                <i class="bi bi-house-fill me-1"></i> HOME
            </button>
            <h1 class="h5 fw-black mb-0 ms-2">End of Shift</h1>
        </div>
        <div class="d-flex align-items-center gap-2">
            <button class="btn-guide-pill" @onclick="() => _showGuide = true" title="Lottery Calculation Guide">
                <i class="bi bi-question-circle-fill me-1"></i> GUIDE
            </button>
            <button class="btn-home-pill btn-logout-danger ms-1" @onclick="HandleManualLogout" title="Sign Out">
                <i class="bi bi-box-arrow-right"></i>
            </button>
            <div class="header-date ms-1">
                <input type="date" class="form-control form-control-sm border-0 bg-white-glass fw-bold rounded-pill px-3 shadow-sm" 
                       @bind-value="ReportDate" @bind-value:after="OnDateChanged"
                       max="@DateTime.Today.ToString("yyyy-MM-dd")"
                       disabled="@IsLocked" />
            </div>
        </div>
    </div>
        
        @if (!string.IsNullOrEmpty(ShiftType) && !IsRentalHall && !Submitted && !Loading)
        {
            <div class="px-3 pb-2 animate-slide-up" style="margin-top: -5px;">
                <div class="form-check form-switch d-flex align-items-center justify-content-center py-2 px-3 rounded-pill bg-white-glass shadow-sm border border-primary border-opacity-10">
                    <input class="form-check-input me-3" type="checkbox" role="switch" id="carryOverToggle" 
                           @bind="_shiftCarryOverEnabled" @bind:after="RefreshOpeningCash" disabled="@IsLocked" style="cursor: pointer; width: 2.22rem; height: 1.1rem;">
                    <label class="form-check-label fw-black text-primary small mt-1" for="carryOverToggle" style="letter-spacing: 0.05em; font-size: 0.65rem; cursor: pointer;">
                        SHIFT CARRY OVER DRAWER
                    </label>
                </div>
            </div>
        }

</div>

<div class="tablet-body">
<div class="glass-page-container mobile-version">
    <NavigationLock ConfirmExternalNavigation="@HasUnsavedChanges" OnBeforeInternalNavigation="OnBeforeInternalNavigation" />
    
    @if (Submitted && !IsSubmitting)
    {
        <div class="glass-modal-overlay success-overlay">
            <div class="glass-modal-card animate-zoom-in">
                <div class="glass-modal-header-icon success">
                    <i class="bi bi-check-circle-fill"></i>
                </div>
                <h3 class="fw-black text-dark mb-2">REPORT SECURED</h3>
                <p class="text-muted mb-4 px-3">Shift data successfully recorded. Returning to portal...</p>
                <div class="d-flex justify-content-center">
                    <div class="spinner-border text-success spinner-border-sm" role="status"></div>
                </div>
            </div>
        </div>
    }

    @if (_showUnsavedModal)
    {
        <div class="glass-modal-overlay">
            <div class="glass-modal-card animate-zoom-in">
                <div class="glass-modal-header-icon warning">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                </div>
                <h3 class="fw-black text-dark mb-2 text-uppercase">@_modalTitle</h3>
                <p class="text-muted mb-4 px-3">@_modalMessage</p>
                <div class="glass-modal-actions">
                    <button type="button" class="btn-modal btn-modal-stay" @onclick="() => _showUnsavedModal = false">
                        STAY HERE
                    </button>
                    <button type="button" class="btn-modal btn-modal-leave" @onclick="ProceedWithAction">
                        DISCARD & CONTINUE
                    </button>
                </div>
            </div>
        </div>
    }

    <div class="page-content-wrapper">

        @if (Submitted)
        {
            <div class="p-4 text-center mt-5">
                <div class="success-icon-box mb-4 mx-auto shadow-lg">
                    <i class="bi bi-check2-circle"></i>
                </div>
                <h2 class="fw-black mb-2">Report Secured!</h2>
                <p class="text-muted mb-5">Your end-of-shift data has been successfully recorded in the audit logs.</p>
                <div class="d-grid gap-3">
                    <button class="btn btn-primary rounded-pill py-3 fw-bold shadow" @onclick="HandleCancel">
                        <i class="bi bi-speedometer2 me-2"></i> Dashboard
                    </button>
                    <button class="btn btn-link text-muted text-decoration-none small" @onclick="() => Submitted = false">
                        <i class="bi bi-pencil-square me-1"></i> Edit Shift Report
                    </button>
                </div>
            </div>
        }
        else if (Loading)
        {
            <div class="d-flex flex-column align-items-center justify-content-center py-5 mt-5">
                <div class="loader-ring mb-3"></div>
                <span class="text-muted fw-bold text-uppercase" style="letter-spacing: 0.1em;">Loading Shift State...</span>
            </div>
        }
        else
        {
            <div class="tablet-grid">

                @if (!string.IsNullOrEmpty(_validationError))
                {
                    <div class="alert alert-danger border-0 shadow-lg rounded-4 mb-2 d-flex align-items-center gap-3 py-3 px-4 glass-error animate-slide-up" style="grid-column: 1/-1;">
                        <div class="bg-danger p-2 rounded-circle shadow-sm"><i class="bi bi-exclamation-triangle-fill text-white fs-5"></i></div>
                        <div>
                            <div class="fw-black text-primary text-uppercase small" style="letter-spacing: 0.05em;">Action Required</div>
                            <div class="text-muted fw-bold" style="font-size: 0.9rem;">@_validationError</div>
                        </div>
                    </div>
                }
                @if (!string.IsNullOrEmpty(_lockErrorMessage))
                {
                    <div class="alert alert-warning border-0 shadow-lg rounded-4 mb-2 d-flex align-items-center gap-3 py-3 px-4 glass-warning animate-slide-up" style="grid-column: 1/-1;">
                        <div class="bg-warning p-2 rounded-circle shadow-sm"><i class="bi bi-lock-fill text-dark fs-5"></i></div>
                        <div>
                            <div class="fw-black text-primary text-uppercase small" style="letter-spacing: 0.05em;">Access Restricted</div>
                            <div class="text-muted fw-bold" style="font-size: 0.85rem;">@_lockErrorMessage</div>
                        </div>
                    </div>
                }

                <!-- ===== LEFT COLUMN: ALL INPUTS ===== -->
                <div class="tablet-col-left">
                    @if (!IsRentalHall)
                    {
                        <div class="form-glass-card shadow-sm p-3 @(string.IsNullOrEmpty(ShiftType) && _showValidation ? "border-danger" : "")">
                            <label class="section-label mb-2">SELECT YOUR SHIFT</label>
                            <div class="shift-selector-inline">
                                <button class='shift-btn-large @(ShiftType == "Day" ? "active" : "")' @onclick='() => SetShift("Day")' disabled="@IsLocked">
                                    <div class="d-flex flex-column align-items-center">
                                        <div><i class="bi bi-sun-fill me-2 fs-5"></i> DAY SHIFT</div>
                                        @if (_dayMainSubmitted) { <span class="badge bg-success bg-opacity-10 text-success border border-success rounded-pill mt-1" style="font-size: 0.6rem;">SUBMITTED</span> }
                                    </div>
                                </button>
                                <button class='shift-btn-large @(ShiftType == "Night" ? "active" : "")' @onclick='() => SetShift("Night")' disabled="@IsLocked">
                                    <div class="d-flex flex-column align-items-center">
                                        <div><i class="bi bi-moon-stars-fill me-2 fs-5"></i> NIGHT SHIFT</div>
                                        @if (_nightMainSubmitted) { <span class="badge bg-success bg-opacity-10 text-success border border-success rounded-pill mt-1" style="font-size: 0.6rem;">SUBMITTED</span> }
                                    </div>
                                </button>
                            </div>
                        </div>
                    }

                    <div class="form-glass-card shadow-sm p-3 @(IsRentalHall ? "hall-active-card border-primary" : "")">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <label class="section-label @(IsRentalHall ? "text-primary" : "text-muted") mb-0">BAR LOCATION</label>
                            @if (_hallSubmitted) { <span class="badge bg-primary bg-opacity-10 text-primary border border-primary rounded-pill px-2 py-1" style="font-size: 0.65rem;">RENTAL SUBMITTED</span> }
                            <button type="button" class='btn btn-sm @(IsRentalHall ? "btn-danger" : "btn-indigo") rounded-pill px-3 fw-bold' @onclick="ToggleRentalHall" disabled="@IsLocked">
                                <i class="bi @(IsRentalHall ? "bi-arrow-left-circle" : "bi-building-up") me-1"></i> @(IsRentalHall ? "EXIT HALL" : "RENTAL HALL")
                            </button>
                        </div>
                        @if (!IsRentalHall) { <p class="small text-muted mb-0 fw-semibold" style="font-size: 0.75rem;">Standard bar location active.</p> }
                    </div>

                    @if (!string.IsNullOrEmpty(ShiftType))
                    {
                        <div class="row g-2">
                            <div class="col-6">
                                <div class="form-glass-card shadow-sm p-3 h-100 config-accent">
                                    <label class="section-label mb-1" style="font-size: 0.6rem;">HOURS WORKED</label>
                                    <div class="input-group-modern @(TotalHours == null && _showValidation ? "border-danger" : "")">
                                        <input type="number" step="0.25" class="form-input-modern" placeholder="0.00" inputmode="decimal" @bind-value="TotalHours" disabled="@IsLocked" />
                                        <span class="input-unit">Hr</span>
                                    </div>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="form-glass-card shadow-sm p-3 h-100 sales-accent">
                                    <label class="section-label mb-1" style="font-size: 0.6rem;">BAR SALES</label>
                                    <div class="input-group-modern @(BarSales == null && _showValidation ? "border-danger" : "")">
                                        <span class="input-addon text-primary opacity-50 px-0">$</span>
                                        <input type="number" step="0.01" class="form-input-modern" placeholder="0.00" inputmode="decimal" @bind-value="BarSales" disabled="@IsLocked" />
                                    </div>
                                </div>
                            </div>
                        </div>

                        @if (!IsRentalHall)
                        {
                            <div class="form-glass-card shadow-sm p-3 lotto-accent">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <label class="section-label">LOTTERY RECONCILIATION</label>
                                    <i class="bi bi-ticket-perforated fs-5 text-success opacity-25"></i>
                                </div>
                                <div class="row g-2">
                                    <div class="col-12">
                                        <label class="form-label small fw-black text-primary text-uppercase mb-1">① Beginning Cash</label>
                                        <div class="input-group-modern">
                                            <input type="number" step="0.01" class="form-input-modern fw-bold" placeholder="0.00" @bind-value="LottoOpeningCash" inputmode="decimal" />
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <label class="form-label small fw-black text-muted text-uppercase mb-1">② Net Sales <span class="text-success fw-black" style="font-size: 0.6rem;">(RPT 50)</span></label>
                                        <div class="input-group-modern">
                                            <input type="number" step="0.01" class="form-input-modern" placeholder="0.00" @bind-value="LottoSales" @bind-value:event="oninput" inputmode="decimal" />
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <label class="form-label small fw-black text-muted text-uppercase mb-1">③ Cashes <span class="text-success fw-black" style="font-size: 0.6rem;">(RPT 50)</span></label>
                                        <div class="input-group-modern">
                                            <input type="number" step="0.01" class="form-input-modern" placeholder="0.00" @bind-value="LottoCashes" @bind-value:event="oninput" inputmode="decimal" />
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <label class="form-label small fw-black text-muted text-uppercase mb-1">④ Tickets <span class="text-indigo fw-black" style="font-size: 0.6rem;">(RPT 34)</span></label>
                                        <div class="input-group-modern">
                                            <input type="number" step="0.01" class="form-input-modern" placeholder="0.00" @bind-value="LottoInstantTickets" @bind-value:event="oninput" inputmode="decimal" />
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <label class="form-label small fw-black text-muted text-uppercase mb-1">⑤ Net Due <span class="text-success fw-black" style="font-size: 0.6rem;">(RPT 50)</span></label>
                                        <div class="input-group-modern">
                                            <button type="button" class="btn-sign-toggle @(LottoNetDue < 0 ? "is-negative" : "")" @onclick="ToggleLottoNetDueSign">@(LottoNetDue < 0 ? "-" : "+")</button>
                                            <input type="number" step="0.01" class="form-input-modern text-primary ps-1" placeholder="0.00" @bind-value="LottoNetDue" @bind-value:event="oninput" inputmode="decimal" />
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <label class="form-label small fw-black text-muted text-uppercase mb-1">⑥ Backup Bag</label>
                                        <div class="input-group-modern">
                                            <span class="input-addon text-warning opacity-50">+</span>
                                            <input type="number" step="0.01" class="form-input-modern" placeholder="0.00" @bind-value="LottoBackupBag" inputmode="decimal" />
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <label class="form-label small fw-black text-success text-uppercase mb-1">⑦ Ending Cash</label>
                                        <div class="input-group-modern">
                                            <span class="input-addon text-success">$</span>
                                            <input type="number" step="0.01" class="form-input-modern fw-bold text-success" placeholder="0.00" @bind-value="LottoCashCounted" @bind-value:event="oninput" inputmode="decimal" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                </div>

                <!-- ===== RIGHT COLUMN: SUMMARY + NOTES + SUBMIT ===== -->
                <div class="tablet-col-right">
                    @if (!string.IsNullOrEmpty(ShiftType) && !IsRentalHall)
                    {
                        <div class="sim-res-card-unified shadow-lg @(LottoDiscrepancy == 0 ? "exact" : LottoDiscrepancy > 0 ? "over" : "short")">
                            <div class="summary-header">
                                <i class="bi bi-calculator-fill me-2 opacity-50"></i> SHIFT ACCOUNTABILITY SUMMARY
                            </div>
                            <div class="math-flow-table p-3">
                                @{
                                    decimal sAct = (ShiftType == "Night" && (LottoSales == null || LottoSales == 0)) ? 0 : (LottoSales ?? 0) - (ShiftType == "Night" ? _prevDaySales : 0);
                                    decimal cAct = (ShiftType == "Night" && (LottoCashes == null || LottoCashes == 0)) ? 0 : (LottoCashes ?? 0) - (ShiftType == "Night" ? _prevDayCashes : 0);
                                    decimal tAct = (ShiftType == "Night" && (LottoInstantTickets == null || LottoInstantTickets == 0)) ? 0 : (LottoInstantTickets ?? 0) - (ShiftType == "Night" ? _prevDayTickets : 0);
                                    decimal netMade = sAct - cAct - tAct;
                                }
                                <div class="math-row">
                                    <span>🏦 BEGINNING CASH</span>
                                    <span class="fw-bold">$@((LottoOpeningCash ?? 0).ToString("N2"))</span>
                                </div>
                                <div class="math-row @(netMade >= 0 ? "text-success" : "text-danger")">
                                    <span>⚡ NET CASH MADE IN SHIFT</span>
                                    <span class="fw-black">@(netMade >= 0 ? "+" : "")$@(netMade.ToString("N2"))</span>
                                </div>
                                <div class="math-row total-expected border-top border-2 border-primary border-opacity-10 mt-2 pt-2">
                                    <span class="fw-black text-primary">🎯 TOTAL DRAWER EXPECTED</span>
                                    <span class="fw-black text-primary fs-5">$@(LottoDrawerValue.ToString("N2"))</span>
                                </div>
                                <div class="math-row text-muted opacity-75 mt-1">
                                    <span class="small fw-bold">💵 MINUS YOUR CASH COUNT</span>
                                    <span class="small fw-bold">-$@((LottoCashCounted ?? 0).ToString("N2"))</span>
                                </div>
                            </div>
                            <div class="variance-footer-banner py-3">
                                <div class="v-label">YOUR SHIFT VARIANCE</div>
                                <div class="v-value fs-2 fw-black">@((LottoDiscrepancy == 0 ? "$0.00" : (LottoDiscrepancy > 0 ? "+" : "-") + "$" + Math.Abs(LottoDiscrepancy).ToString("N2")))</div>
                            </div>
                        </div>

                        @if (!(_shiftCarryOverEnabled && ShiftType == "Day"))
                        {
                            <div class="sim-res-card house shadow-sm py-2">
                                <div class="d-flex justify-content-center align-items-center gap-2">
                                    <span class="sim-res-label mb-0">ENVELOPE (PULL FOR LOTTERY)</span>
                                    <span class="sim-res-val fs-4">$@(LottoEnvelopeAmount.ToString("N2"))</span>
                                </div>
                            </div>
                        }
                    }

                    <div class="form-glass-card shadow-sm p-3">
                        <label class="small text-muted fw-bold text-uppercase mb-2" style="font-size: 0.65rem;">Shift Notes &amp; Discrepancies</label>
                        <textarea class="form-control-modern" rows="3" placeholder="Type details here..." @bind="Notes" disabled="@IsLocked"></textarea>
                    </div>

                    @if (!string.IsNullOrEmpty(ShiftType))
                    {
                        <div class="d-grid gap-2">
                            <button class="btn @(ExistingEntryFound ? "btn-indigo" : "btn-action-submit") py-3 fw-bold shadow-lg"
                                    disabled="@(IsSubmitting || IsLocked)" @onclick="HandleSubmit">
                                @if (IsSubmitting) {
                                    <span class="spinner-border spinner-border-sm me-2"></span><span>SECURING DATA...</span>
                                } else {
                                    <i class="bi @(ExistingEntryFound ? "bi-check-all" : "bi-cloud-upload-fill") me-2"></i>
                                    <span>@(ExistingEntryFound ? "UPDATE REPORT" : "SUBMIT SHIFT")</span>
                                }
                            </button>
                            <button class="btn btn-outline-secondary rounded-pill py-2 fw-bold" @onclick="ResetSelection">
                                <i class="bi bi-arrow-counterclockwise me-1"></i> CLEAR
                            </button>
                        </div>
                    }
                </div>

            </div> <!-- end tablet-grid -->
        }
    </div>
</div>
</div>

<!-- ============================
     LOTTERY CALCULATION GUIDE
     ============================ -->
@if (_showGuide)
{
    <div class="guide-backdrop" @onclick="() => _showGuide = false"></div>
    <div class="guide-panel">
        <div class="guide-panel-inner">
            <div class="guide-header">
                <div>
                    <h4 class="fw-black mb-0" style="color:white;"><i class="bi bi-ticket-perforated me-2 text-warning"></i>Lottery Calculation Guide</h4>
                    <p style="color:rgba(255,255,255,0.7); font-size:0.8rem;" class="mb-0 mt-1">What to enter · How the math works · What each result means</p>
                </div>
                <button class="btn btn-sm btn-outline-light rounded-pill" @onclick="() => _showGuide = false">
                    <i class="bi bi-x-lg me-1"></i> Close
                </button>
            </div>

            <div class="guide-body">

                <!-- INTERACTIVE SIMULATOR -->
                <div class="simulator-toggle-area mb-4">
                    @if (!_showSim)
                    {
                        <button class="btn btn-warning w-100 py-3 rounded-pill shadow-sm fw-bold border-3" style="border-style:dashed;" @onclick="() => _showSim = true">
                            <i class="bi bi-calculator-fill me-2"></i> Open Interactive Math Checker (Practice Mode)
                        </button>
                    }
                    else
                    {
                        <div class="simulator-card">
                            <div class="sim-header">
                                <div>
                                    <h5 class="fw-bold mb-0 text-white"><i class="bi bi-cpu me-2 text-warning"></i>Practice Math Checker</h5>
                                    <p class="mb-0 text-white-50" style="font-size:0.7rem;">Test actual ticket numbers here to see the results (not saved)</p>
                                </div>
                                <button class="btn btn-sm btn-outline-light rounded-pill px-3" @onclick="() => _showSim = false">
                                    <i class="bi bi-x-lg me-1"></i> Hide
                                </button>
                            </div>
                            <div class="sim-body">
                                <div class="row g-3">
                                    <div class="col-6">
                                        <label class="sim-label">① Beginning Cash</label>
                                        <div class="input-group input-group-sm"><span class="input-group-text bg-light">$</span><input type="number" class="form-control" @bind="_simOpening" @bind:event="oninput" /></div>
                                    </div>
                                    <div class="col-6">
                                        <label class="sim-label">② Net Sales (Ticket)</label>
                                        <div class="input-group input-group-sm"><span class="input-group-text bg-light">$</span><input type="number" class="form-control" @bind="_simNetSales" @bind:event="oninput" /></div>
                                    </div>
                                    <div class="col-6">
                                        <label class="sim-label">③ Cashes (Ticket)</label>
                                        <div class="input-group input-group-sm"><span class="input-group-text bg-light">$</span><input type="number" class="form-control" @bind="_simCashes" @bind:event="oninput" /></div>
                                    </div>
                                    <div class="col-6">
                                        <label class="sim-label">④ Tickets / Instant (RPT 34)</label>
                                        <div class="input-group input-group-sm"><span class="input-group-text bg-light">$</span><input type="number" class="form-control" @bind="_simTickets" @bind:event="oninput" /></div>
                                    </div>
                                    <div class="col-6">
                                        <label class="sim-label">⑤ Net Due (Ticket)</label>
                                        <div class="input-group input-group-sm"><span class="input-group-text bg-light">$</span><input type="number" step="0.01" class="form-control" @bind="_simNetDue" @bind:event="oninput" /></div>
                                    </div>
                                    <div class="col-6">
                                        <label class="sim-label">⑥ Backup Bag Added</label>
                                        <div class="input-group input-group-sm"><span class="input-group-text bg-light">$</span><input type="number" class="form-control" @bind="_simBag" @bind:event="oninput" /></div>
                                    </div>
                                    <div class="col-12">
                                        <label class="sim-label">⑦ Ending Cash (Your Count)</label>
                                        <div class="input-group input-group-sm"><span class="input-group-text bg-success text-white">$</span><input type="number" class="form-control fw-bold" @bind="_simCounted" @bind:event="oninput" /></div>
                                    </div>
                                </div>

                                @{
                                    decimal simExpected = (_simOpening ?? 0) + (_simNetSales ?? 0) - (_simCashes ?? 0) - (_simTickets ?? 0) + (_simBag ?? 0);
                                    decimal simVariance = (_simCounted ?? 0) - simExpected;
                                    decimal simEnvelope = (_simCounted ?? 0) - 1200m;
                                }
                                <div class="sim-result-area mt-3">
                                    <div class="sim-res-row">
                                        <span class="sim-res-label">🎯 DRAWER EXPECTED</span>
                                        <span class="sim-res-val">$@simExpected.ToString("N2")</span>
                                    </div>
                                    <div class="sim-res-row @(simVariance == 0 ? "text-success" : simVariance > 0 ? "text-primary" : "text-danger")">
                                        <span class="sim-res-label">📊 VARIANCE</span>
                                        <span class="sim-res-val fw-black">@(simVariance == 0 ? "✓ $0.00 EXACT" : (simVariance > 0 ? "+" : "") + "$" + simVariance.ToString("N2"))</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <!-- MODE SELECT INFO -->
                <div class="guide-section">
                    <div class="guide-section-title"><i class="bi bi-info-circle-fill me-1 text-primary"></i> HOW SHIFT CARRY OVER WORKS</div>
                    <p class="small text-muted mb-0">This system uses <strong>Shift Carry Over</strong> to link the Day and Night shifts together. Because lottery machines report <em>cumulative totals</em> (not per-shift), the Night bartender enters the full machine numbers and the system automatically subtracts the Day shift's contribution to isolate each shift's performance.</p>
                </div>

                <!-- MAIN GUIDE CONTENT -->
                <div class="guide-two-col">
                    <div class="guide-section">
                        <div class="guide-section-title"><i class="bi bi-receipt me-1"></i> FROM THE TICKET — ENTER THESE 3 LINES</div>
                        <div class="text-center p-3 border rounded-3 bg-light" style="font-size:0.78rem;">
                            <div class="fw-black mb-2" style="letter-spacing:0.05em;">THE LOTTERY</div>
                            <div class="text-muted small">DAILY INVOICE REPORT</div>
                            <div class="mt-2 text-start" style="font-size:0.75rem;">
                                <div class="d-flex justify-content-between"><span>TOTAL SALES</span><span>1,504.00</span></div>
                                <div class="d-flex justify-content-between text-success fw-bold"><span>★ NET SALES</span><span>1,504.00</span></div>
                                <div class="d-flex justify-content-between text-danger fw-bold"><span>★ CASHES</span><span>−944.50</span></div>
                                <div class="d-flex justify-content-between text-primary fw-bold"><span>★ NET DUE</span><span>476.38</span></div>
                            </div>
                        </div>
                        <div class="mt-2 text-muted" style="font-size:0.75rem;">— Also enter <strong>Tickets (Inst. Rpt 34)</strong> if applicable</div>
                    </div>

                    <div>
                        <div class="guide-section">
                            <div class="guide-section-title">HOW THE SYSTEM CALCULATES</div>
                            <div class="math-step">
                                <div class="math-step-header"><span class="math-step-num">STEP 1</span><span class="math-step-name">What should be in the drawer?</span></div>
                                <div class="math-chain">
                                    <div class="mc-pill mc-open">① BEGIN</div><div class="mc-op">+</div>
                                    <div class="mc-pill mc-sales">② SALES</div><div class="mc-op">−</div>
                                    <div class="mc-pill mc-cash">③ CASHES</div><div class="mc-op">−</div>
                                    <div class="mc-pill mc-tickets">④ TICKETS</div><div class="mc-op">+</div>
                                    <div class="mc-pill mc-bag">⑥ BAG</div><div class="mc-op">=</div>
                                    <div class="mc-pill mc-result">EXPECTED</div>
                                </div>
                                <div class="math-example">e.g. $1,200 + $1,504 − $944.50 − $0 + $0 = <strong>$1,759.50 expected</strong></div>
                            </div>
                            <div class="math-step mt-3">
                                <div class="math-step-header"><span class="math-step-num">STEP 2</span><span class="math-step-name">Is the drawer right?</span></div>
                                <div class="math-chain">
                                    <div class="mc-pill mc-counted">⑦ ENDING CASH</div><div class="mc-op">−</div>
                                    <div class="mc-pill mc-result">EXPECTED</div><div class="mc-op">=</div>
                                    <div class="mc-pill mc-variance">VARIANCE</div>
                                </div>
                                <div class="math-example">e.g. $1,759.50 − $1,759.50 = <strong>$0.00 variance</strong> ✓</div>
                            </div>
                            <div class="math-step mt-3">
                                <div class="math-step-header"><span class="math-step-num">STEP 3</span><span class="math-step-name">Settlement: Shift Carry Over Mode</span></div>
                                <div class="p-3 rounded-3 border bg-white shadow-sm border-start border-4 border-primary">
                                    <div class="d-flex align-items-center gap-2 mb-2">
                                        <span class="badge bg-primary">SHIFT CARRY OVER MODE</span>
                                        <span class="text-muted" style="font-size:0.7rem;"><em>Linked Day &amp; Night Audits</em></span>
                                    </div>
                                    <p class="small text-muted mb-3">This mode links the Day and Night shifts together so that <strong>one full day of lottery profit is settled at the end of the Night shift</strong>. The Day bartender does not pull an envelope — they hand the entire drawer to the Night bartender as their opening cash.</p>

                                    <div class="d-flex flex-column gap-2">
                                        <!-- DAY SHIFT -->
                                        <div class="p-2 rounded-2 bg-light border">
                                            <div class="fw-black text-primary mb-1" style="font-size:0.7rem; letter-spacing:0.05em;"><i class="bi bi-sun-fill me-1 text-warning"></i> DAY SHIFT</div>
                                            <ul class="small text-muted mb-1 ps-3">
                                                <li><strong>Opening cash</strong> is whatever is in the drawer at the start of the day (typically $1,200).</li>
                                                <li>Enter your ticket numbers as normal (Net Sales, Cashes, Tickets, Net Due).</li>
                                                <li><strong>No envelope is pulled.</strong> Your entire counted cash stays in the drawer.</li>
                                                <li>The system records your Day shift totals so Night can subtract them from the cumulative machine report.</li>
                                            </ul>
                                            <div class="math-chain mt-1">
                                                <div class="mc-pill mc-open">① $1,200 BEGIN</div><div class="mc-op">+</div>
                                                <div class="mc-pill mc-sales">DAY NET MADE</div><div class="mc-op">=</div>
                                                <div class="mc-pill mc-result">NIGHT OPENING CASH</div>
                                            </div>
                                        </div>

                                        <!-- NIGHT SHIFT -->
                                        <div class="p-2 rounded-2 bg-light border">
                                            <div class="fw-black text-primary mb-1" style="font-size:0.7rem; letter-spacing:0.05em;"><i class="bi bi-moon-stars-fill me-1 text-indigo"></i> NIGHT SHIFT</div>
                                            <ul class="small text-muted mb-1 ps-3">
                                                <li><strong>Opening cash</strong> is automatically carried over from the Day shift's final count.</li>
                                                <li>Enter the <em>cumulative</em> machine totals from the ticket (the machine doesn't reset between shifts).</li>
                                                <li>The system subtracts the Day shift's numbers to isolate only the Night shift's performance.</li>
                                                <li>Your variance is checked against the <em>full day's</em> expected drawer, not just your shift.</li>
                                                <li><strong>Pull one envelope</strong> at the end of Night to return the drawer to $1,200.</li>
                                            </ul>
                                            <div class="math-chain mt-1">
                                                <div class="mc-pill mc-counted">⑦ NIGHT COUNT</div><div class="mc-op">−</div>
                                                <div class="mc-pill mc-result" style="background:#f1f5f9;color:#475569;">$1,200</div><div class="mc-op">=</div>
                                                <div class="mc-pill mc-result">ENVELOPE (PULL)</div>
                                            </div>
                                        </div>

                                        <!-- WHY IT EXISTS -->
                                        <div class="p-2 rounded-2" style="background:#eff6ff; border:1px solid #bfdbfe;">
                                            <div class="fw-black mb-1" style="font-size:0.7rem; color:#1d4ed8; letter-spacing:0.05em;"><i class="bi bi-lightbulb-fill me-1 text-warning"></i> WHY THIS MODE EXISTS</div>
                                            <p class="small text-muted mb-0">Lottery machines report <em>cumulative totals</em> — they don't reset between Day and Night shifts. Without Carry Over mode, the Night bartender would appear to cover the entire day's worth of sales, which isn't fair. This mode correctly isolates each shift's contribution and holds the <strong>Night shift responsible for the full day's settlement</strong>.</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
}

