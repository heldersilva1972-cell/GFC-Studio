</style>

@code {
    private decimal? BarSales { get; set; }
    private decimal? LottoSales { get; set; }
    private decimal? LottoCashes { get; set; }
    private decimal? LottoInstantTickets { get; set; }
    private decimal? LottoNetDue { get; set; }
    private decimal? LottoOpeningCash { get; set; }
    private decimal? LottoBackupBag { get; set; }
    private decimal? LottoCashCounted { get; set; }
    private decimal? TotalHours { get; set; }
    
    private string? ShiftType { get; set; }
    private DateTime ReportDate { get; set; } = DateTime.Today;
    private string? Notes { get; set; }
    private bool IsRentalHall { get; set; } = false;
    private bool _shiftCarryOverEnabled = true;
    private bool _originalShiftCarryOverEnabled = true;

    private bool Loading { get; set; } = true;
    private bool IsSubmitting { get; set; } = false;
    private bool Submitted { get; set; } = false;
    private bool ExistingEntryFound { get; set; } = false;
    private bool IsLocked { get; set; } = false;
    private string? _validationError { get; set; }
    private string? _lockErrorMessage { get; set; }
    private bool _showValidation = false;
    private bool _showUnsavedModal = false;
    private bool _showHudMath = false;
    private bool _showGuide = false;
    private bool _showSim = false;
    // Guide simulator fields
    private decimal? _simOpening;
    private decimal? _simNetSales;
    private decimal? _simCashes;
    private decimal? _simTickets;
    private decimal? _simNetDue;
    private decimal? _simBag;
    private decimal? _simCounted;
    private string? _pendingNavigationUrl;
    private string _modalTitle = "Unsaved Changes";
    private string _modalMessage = "You have entered data. Leaving now will lose your progress.";
    private Action? _onModalConfirm;

    private bool _dayMainSubmitted;
    private bool _nightMainSubmitted;
    private bool _hallSubmitted;

    private BarSaleEntry? ExistingBarEntry { get; set; }
    private LotteryShift? ExistingLottoEntry { get; set; }
    private AppUser? CurrentUser { get; set; }

    // Original values for tracking changes
    private decimal? _originalBarSales;
    private decimal? _originalLottoSales;
    private decimal? _originalLottoCashes;
    private decimal? _originalLottoInstantTickets;
    private decimal? _originalLottoNetDue;
    private decimal? _originalLottoOpeningCash;
    private decimal? _originalLottoBackupBag;
    private decimal? _originalLottoCashCounted;
    private decimal? _originalTotalHours;
    private string? _originalNotes;

    private bool HasUnsavedChanges => 
        !Loading && !Submitted && !string.IsNullOrEmpty(ShiftType) &&
        (BarSales != _originalBarSales ||
         LottoSales != _originalLottoSales ||
         LottoCashes != _originalLottoCashes ||
         LottoInstantTickets != _originalLottoInstantTickets ||
         LottoNetDue != _originalLottoNetDue ||
         LottoOpeningCash != _originalLottoOpeningCash ||
         LottoBackupBag != _originalLottoBackupBag ||
         LottoCashCounted != _originalLottoCashCounted ||
         TotalHours != _originalTotalHours ||
         Notes != _originalNotes ||
         _shiftCarryOverEnabled != _originalShiftCarryOverEnabled);

    // Shift Delta Tracking (for cumulative machine reports)
    private decimal _prevDaySales { get; set; } = 0;
    private decimal _prevDayCashes { get; set; } = 0;
    private decimal _prevDayTickets { get; set; } = 0;
    private decimal _prevDayNetDue { get; set; } = 0; // Tracks the shift contribution
    private decimal _prevDayBag { get; set; } = 0;

    // Math Logic
    private decimal LottoDrawerValue {
        get {
            decimal salesActivity = (ShiftType == "Night" && (LottoSales == null || LottoSales == 0)) ? 0 : (LottoSales ?? 0) - (ShiftType == "Night" ? _prevDaySales : 0);
            decimal cashesActivity = (ShiftType == "Night" && (LottoCashes == null || LottoCashes == 0)) ? 0 : (LottoCashes ?? 0) - (ShiftType == "Night" ? _prevDayCashes : 0);
            decimal ticketsActivity = (ShiftType == "Night" && (LottoInstantTickets == null || LottoInstantTickets == 0)) ? 0 : (LottoInstantTickets ?? 0) - (ShiftType == "Night" ? _prevDayTickets : 0);
            return (LottoOpeningCash ?? 0) + salesActivity - cashesActivity - ticketsActivity + (LottoBackupBag ?? 0);
        }
    }
    private decimal LottoDiscrepancy => (LottoCashCounted ?? 0) - LottoDrawerValue;
    private decimal LottoTotalSurplus => Math.Max(0, (LottoCashCounted ?? 0) - 1200);
    private decimal LottoEnvelopeAmount {
        get {
            if (ShiftType == "Day" && _shiftCarryOverEnabled) return 0;
            decimal dayBags = (ShiftType == "Night" && _shiftCarryOverEnabled) ? _prevDayBag : 0;
            return Math.Max(0, LottoTotalSurplus - (LottoBackupBag ?? 0) - dayBags);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        CurrentUser = AuthStateProvider.GetCurrentUser();
        if (CurrentUser == null) { Navigation.NavigateTo("/login"); return; }
        ApplyBusinessDayLogic();
        await UpdateShiftAvailability();
        await CheckExisting();
        Loading = false;
    }

    private void ApplyBusinessDayLogic()
    {
        var now = DateTime.Now;
        if (now.Hour < 5) ReportDate = DateTime.Today.AddDays(-1);
    }

    private async Task OnDateChanged()
    {
        await UpdateShiftAvailability();
        await CheckExisting();
    }

    private async Task SetShift(string type)
    {
        _lockErrorMessage = null;
        ShiftType = type;
        await CheckExisting();
        if (IsLocked) {
             _lockErrorMessage = "Access Restricted: This existing report is locked.";
             ResetSelection();
        }
    }

    private async Task ToggleRentalHall()
    {
        if (IsRentalHall && HasUnsavedChanges)
        {
            _modalTitle = "Unsaved Rental Data";
            _modalMessage = "You are about to exit the Rental Hall report. Any unsaved sales or notes will be lost. Continue?";
            _onModalConfirm = () => {
                ExecuteToggleRentalHall();
            };
            _showUnsavedModal = true;
            return;
        }

        ExecuteToggleRentalHall();
    }

    private void ExecuteToggleRentalHall()
    {
        IsRentalHall = !IsRentalHall;
        _lockErrorMessage = null;
        ShiftType = IsRentalHall ? "Hall" : null;
        _ = UpdateShiftAvailability();
        _ = CheckExisting();
        if (IsLocked) {
             _lockErrorMessage = "Access Restricted: This existing report is locked.";
             ResetSelection();
        }
    }

    private void ResetSelection()
    {
        ShiftType = null; BarSales = null; TotalHours = null; LottoSales = null; LottoCashes = null; LottoInstantTickets = null; LottoNetDue = null; 
        LottoBackupBag = 0; LottoCashCounted = null; Notes = null; ExistingEntryFound = false; IsLocked = false;
    }

    private async Task UpdateShiftAvailability()
    {
        try {
            using var db = await DbFactory.CreateDbContextAsync();
            _dayMainSubmitted = await db.BarSaleEntries.AnyAsync(e => (e.AdjustedSaleDate ?? e.SaleDate).Date == ReportDate.Date && e.Shift == "Day" && !e.IsRentalHall);
            _nightMainSubmitted = await db.BarSaleEntries.AnyAsync(e => (e.AdjustedSaleDate ?? e.SaleDate).Date == ReportDate.Date && e.Shift == "Night" && !e.IsRentalHall);
            _hallSubmitted = await db.BarSaleEntries.AnyAsync(e => (e.AdjustedSaleDate ?? e.SaleDate).Date == ReportDate.Date && e.IsRentalHall);
        } catch { }
    }

    private async Task CheckExisting()
    {
        ExistingBarEntry = null; ExistingLottoEntry = null; ExistingEntryFound = false; IsLocked = false;
        _prevDaySales = 0; _prevDayCashes = 0; _prevDayTickets = 0; _prevDayBag = 0;
        if (string.IsNullOrEmpty(ShiftType)) return;

        try {
            using var db = await DbFactory.CreateDbContextAsync();
            ExistingBarEntry = await db.BarSaleEntries.FirstOrDefaultAsync(e => (e.AdjustedSaleDate ?? e.SaleDate).Date == ReportDate.Date && e.Shift == ShiftType && e.IsRentalHall == IsRentalHall);
            var lottoShifts = LotteryRepo.GetByDateRange(ReportDate, ReportDate);
            ExistingLottoEntry = lottoShifts.FirstOrDefault(s => s.ShiftType == ShiftType);

            if (ShiftType == "Night") {
                var dayShift = lottoShifts.FirstOrDefault(s => s.ShiftType == "Day");
                if (dayShift != null) { 
                    _prevDaySales = dayShift.TotalSales; 
                    _prevDayCashes = dayShift.TotalPayouts;
                    _prevDayTickets = dayShift.TotalCancels; 
                    _prevDayNetDue = dayShift.NetDue;
                    _prevDayBag = dayShift.BackupBagAmount;
                }
            }

            if (ExistingBarEntry != null || ExistingLottoEntry != null) {
                ExistingEntryFound = true;
                BarSales = ExistingBarEntry?.TotalSales;
                TotalHours = ExistingBarEntry?.TotalHours;
                if (ExistingLottoEntry != null) {
                    LottoSales = ExistingLottoEntry.TotalSales; LottoCashes = ExistingLottoEntry.TotalPayouts;
                    LottoInstantTickets = ExistingLottoEntry.TotalCancels;
                    LottoNetDue = ExistingLottoEntry.NetDue; LottoOpeningCash = ExistingLottoEntry.StartingCash;
                    LottoBackupBag = ExistingLottoEntry.BackupBagAmount; LottoCashCounted = ExistingLottoEntry.EndingCash;
                    // Note: In an existing report, we may want to see if it was originally 'Carry Over'
                    // For now, we trust the UI state, but usually EnvelopeAmount == 0 on Day Shift is a hint.
                }
                Notes = ExistingBarEntry?.Notes ?? ExistingLottoEntry?.Notes;
                
                // Set originals for change tracking
                _originalBarSales = BarSales; _originalLottoSales = LottoSales; 
                _originalLottoCashes = LottoCashes; _originalLottoInstantTickets = LottoInstantTickets;
                _originalLottoNetDue = LottoNetDue; _originalLottoOpeningCash = LottoOpeningCash;
                _originalLottoBackupBag = LottoBackupBag; _originalLottoCashCounted = LottoCashCounted;
                _originalTotalHours = TotalHours; _originalNotes = Notes;
                _originalShiftCarryOverEnabled = _shiftCarryOverEnabled;

                var createdTime = ExistingBarEntry?.CreatedAt ?? ExistingLottoEntry?.CreatedDate ?? DateTime.UtcNow;
                if (createdTime < DateTime.UtcNow.AddHours(-2) && !CurrentUser.IsAdmin && (ExistingBarEntry?.CreatedBy != CurrentUser.Username)) IsLocked = true;
            } else {
                BarSales = null; TotalHours = null; LottoSales = null; 
                LottoCashes = null; LottoInstantTickets = null; LottoNetDue = null; 
                LottoBackupBag = 0; LottoCashCounted = null; Notes = null;
                LottoOpeningCash = await GetCarryoverCash();

                // Set originals for new entry
                _originalBarSales = null; _originalLottoSales = null; _originalLottoCashes = null;
                _originalLottoInstantTickets = null;
                _originalLottoNetDue = null; _originalLottoOpeningCash = LottoOpeningCash;
                _originalLottoBackupBag = 0; _originalLottoCashCounted = null;
                _originalTotalHours = null; _originalNotes = null;
                _originalShiftCarryOverEnabled = _shiftCarryOverEnabled;
            }
        } catch { }
    }

    private async Task<decimal> GetCarryoverCash()
    {
        try {
            using var db = await DbFactory.CreateDbContextAsync();
            if (ShiftType == "Night") {
                var day = await db.LotteryShifts.AsNoTracking().FirstOrDefaultAsync(s => s.ShiftDate.Date == ReportDate.Date && s.ShiftType == "Day");
                if (day == null) return 1200;
                
                if (_shiftCarryOverEnabled) {
                    return day.EndingCash;
                }
                
                decimal surplus = Math.Max(0, day.EndingCash - 1200);
                decimal returnToBag = Math.Min(surplus, day.BackupBagAmount);
                return day.EndingCash - returnToBag - day.EnvelopeAmount;
            }
            return 1200;
        } catch { return 1200; }
    }

    private async Task RefreshOpeningCash() {
        LottoOpeningCash = await GetCarryoverCash();
        StateHasChanged();
    }

    private async Task HandleSubmit()
    {
        if (BarSales == null || TotalHours == null || (!IsRentalHall && LottoSales == null)) {
            _validationError = "Required fields are missing. Please ensure all fields are filled out.";
            _showValidation = true;
            return;
        }

        IsSubmitting = true;
        try {
            using var db = await DbFactory.CreateDbContextAsync();
            if (ExistingBarEntry != null) {
                var entry = await db.BarSaleEntries.FindAsync(ExistingBarEntry.Id);
                if (entry != null) {
                    entry.TotalSales = BarSales ?? 0; entry.TotalHours = TotalHours; entry.Notes = Notes;
                    entry.ModifiedBy = CurrentUser?.Username; entry.ModifiedAt = DateTime.UtcNow;
                    await db.SaveChangesAsync();
                }
            } else {
                db.BarSaleEntries.Add(new BarSaleEntry {
                    SaleDate = DateTime.Now, AdjustedSaleDate = ReportDate, TotalSales = BarSales ?? 0,
                    TotalHours = TotalHours, IsRentalHall = IsRentalHall, Shift = ShiftType, Notes = Notes,
                    CreatedBy = CurrentUser?.Username, CreatedAt = DateTime.UtcNow
                });
                await db.SaveChangesAsync();
            }

            if (!IsRentalHall) {
                if (ExistingLottoEntry != null) {
                    ExistingLottoEntry.TotalSales = LottoSales ?? 0; ExistingLottoEntry.TotalPayouts = LottoCashes ?? 0;
                    ExistingLottoEntry.TotalCancels = LottoInstantTickets ?? 0;
                    ExistingLottoEntry.NetDue = LottoNetDue ?? 0; ExistingLottoEntry.StartingCash = LottoOpeningCash ?? 0;
                    ExistingLottoEntry.BackupBagAmount = LottoBackupBag ?? 0; ExistingLottoEntry.EndingCash = LottoCashCounted ?? 0;
                    ExistingLottoEntry.EnvelopeAmount = LottoEnvelopeAmount; ExistingLottoEntry.Notes = Notes;
                    LotteryRepo.Update(ExistingLottoEntry);
                } else {
                    LotteryRepo.Create(new LotteryShift {
                        ShiftDate = ReportDate, EmployeeName = CurrentUser?.Username ?? "Unknown", ShiftType = ShiftType,
                        TotalSales = LottoSales ?? 0, TotalPayouts = LottoCashes ?? 0, 
                        TotalCancels = LottoInstantTickets ?? 0,
                        NetDue = LottoNetDue ?? 0,
                        StartingCash = LottoOpeningCash ?? 0, BackupBagAmount = LottoBackupBag ?? 0, EndingCash = LottoCashCounted ?? 0,
                        EnvelopeAmount = LottoEnvelopeAmount, Notes = Notes, CreatedBy = CurrentUser?.Username, CreatedDate = DateTime.UtcNow, Status = "Submitted"
                    });
                }
            }

            AuditLogger.Log(ExistingEntryFound ? "Shift Report Corrected" : "Shift Report Submitted", CurrentUser?.UserId, null, $"Date: {ReportDate:yyyy-MM-dd}, Shift: {ShiftType}");
            
            Submitted = true;
            StateHasChanged();
            await Task.Delay(2500);
            Navigation.NavigateTo("/mobile");
        } catch (Exception ex) {
            _validationError = "Error saving report: " + ex.Message;
        } finally {
            IsSubmitting = false;
        }
    }

    private void ToggleLottoNetDueSign()
    {
        if (LottoNetDue != null)
        {
            LottoNetDue = -LottoNetDue;
            StateHasChanged();
        }
        else
        {
            // If empty, assume we want to start entering a negative value
            // (Note: This is a UI hint; the bind will handle the next input)
        }
    }

    private async Task OnBeforeInternalNavigation(LocationChangingContext context)
    {
        if (HasUnsavedChanges)
        {
            context.PreventNavigation();
            _pendingNavigationUrl = context.TargetLocation;
            _modalTitle = "Unsaved Changes";
            _modalMessage = "You have sales data in progress. Leaving now will permanently discard your work.";
            _onModalConfirm = () => {
                Submitted = true;
                Navigation.NavigateTo(_pendingNavigationUrl ?? "/mobile");
            };
            _showUnsavedModal = true;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void ProceedWithAction()
    {
        _showUnsavedModal = false;
        _onModalConfirm?.Invoke();
    }

    private void HandleCancel() => Navigation.NavigateTo("/mobile");

    private async Task HandleManualLogout()
    {
        try
        {
            var token = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "gfc_device_token");
            await AuthStateProvider.LogoutAsync(token);
            await JSRuntime.InvokeVoidAsync("localStorage.removeItem", "gfc_device_token");
            await JSRuntime.InvokeVoidAsync("window.setCookie", "GFC_DeviceTrustToken", "", -1);
            await Task.Delay(100);
            Navigation.NavigateTo("/login", forceLoad: true);
        }
        catch
        {
            Navigation.NavigateTo("/login", forceLoad: true);
        }
    }
}
