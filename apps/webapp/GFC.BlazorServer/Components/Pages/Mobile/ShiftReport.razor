    private bool ShouldShowSignConfirmation {
        get {
            // Only show for Net Due if it's currently being edited and hasn't been signed off yet
            if (_activeField != "LottoNetDue" || _lottoSignConfirmed) return false;
            
            // Only show if there's actually a non-zero value to "sign"
            if (string.IsNullOrEmpty(_currentBuffer) || (LottoNetDue == null || LottoNetDue == 0)) return false;
            
            return true;
        }
    }

    private string GetFieldDisplayName(string field) => field switch {
        "Hours" => "Hours Worked",
        "BarSales" => "Total Bar Sales",
        "LottoOpeningCash" => "Lottery Beginning Cash",
        "LottoSales" => "Lottery Net Sales (RPT 50)",
        "LottoCashes" => "Lottery Cashes (RPT 50)",
        "LottoInstantTickets" => "Lottery Tickets (RPT 34)",
        "LottoNetDue" => "Lottery Net Due (RPT 50)",
        "LottoBackupBag" => "Removed From Backup Money Bag",
        "LottoCashCounted" => "Ending Cash Counted",
        _ => "Entry"
    };

    private void ActivateField(string field) {
        if (IsLocked) return;
        
        // Only block jumping to other fields if the sign confirmation prompt is actually active and blocking the screen
        if (ShouldShowSignConfirmation) {
            return; 
        }

        _activeField = field;
        _fieldFreshlyActivated = true; // Use this to allow backspace on existing value but clear on typing a digit

        decimal? currentVal = GetRawFieldValue(field);
        if (currentVal != null) {
            _currentBuffer = Math.Abs(currentVal.Value).ToString("F2");
        } else {
            _currentBuffer = "";
        }
        
        _lottoSignConfirmed = true; // Default true for existing values
        StateHasChanged();
    }

    private void KeyPressed(string key) {
        if (IsLocked || string.IsNullOrEmpty(_activeField)) return;
        
        // Intelligent Clear: If the field was just selected, typing a digit should start fresh
        if (_fieldFreshlyActivated) {
            _currentBuffer = "";
            _fieldFreshlyActivated = false;
            // If we're starting a brand new 'Net Due' entry, reset the sign to positive
            if (_activeField == "LottoNetDue") LottoNetDue = 0;
        }

        // Basic buffer logic for decimal entry
        if (key == "." && _currentBuffer.Contains(".")) return;
        
        // Prevent more than 2 decimal digits
        if (_currentBuffer.Contains("."))
        {
            var parts = _currentBuffer.Split('.');
            if (parts.Length > 1 && parts[1].Length >= 2) return;
        }

        _currentBuffer += key;
        
        if (decimal.TryParse(_currentBuffer, out decimal val)) {
            if (_activeField == "LottoNetDue") {
                // Neutral zero doesn't need a sign confirmation
                _lottoSignConfirmed = (val == 0); 
            }
            UpdateFieldValue(_activeField, val);
            _ = AutoSave();
        }
    }

    private void BackspaceCurrentField() {
        if (IsLocked || string.IsNullOrEmpty(_activeField)) return;
        
        // If they hit backspace, they chose to edit the existing value, so don't clear it on the next digit
        _fieldFreshlyActivated = false;

        if (!string.IsNullOrEmpty(_currentBuffer)) {
            _currentBuffer = _currentBuffer.Substring(0, _currentBuffer.Length - 1);
        }
        
        // If backspacing clears the whole thing, reset sign to positive for the next entry
        if (string.IsNullOrEmpty(_currentBuffer) && _activeField == "LottoNetDue") {
             LottoNetDue = 0;
        }

        decimal? val = null;
        if (!string.IsNullOrEmpty(_currentBuffer) && decimal.TryParse(_currentBuffer, out decimal parseVal)) {
            val = parseVal;
        }
        
        if (_activeField == "LottoNetDue") {
            // Always treat an empty or zero field as confirmed (neutral) or reset it
            _lottoSignConfirmed = (val == null || val == 0);
        }
        UpdateFieldValue(_activeField, val);
        _ = AutoSave();
    }

    private decimal? GetRawFieldValue(string field) {
        return field switch {
            "Hours" => TotalHours,
            "BarSales" => BarSales,
            "LottoOpeningCash" => LottoOpeningCash,
            "LottoSales" => LottoSales,
            "LottoCashes" => LottoCashes,
            "LottoInstantTickets" => LottoInstantTickets,
            "LottoNetDue" => LottoNetDue,
            "LottoBackupBag" => LottoBackupBag,
            "LottoCashCounted" => LottoCashCounted,
            _ => null
        };
    }

    private string GetInputDisplay(string field) {
        if (_activeField == field && !string.IsNullOrEmpty(_currentBuffer)) {
             // For Net Due, we still need the sign indicator even in buffer mode
             if (field == "LottoNetDue") return (LottoNetDue < 0 ? "-" : "") + _currentBuffer;
             return _currentBuffer;
        }
        
        decimal? val = GetRawFieldValue(field);
        if (val == null) return "";
        
        if (field == "LottoNetDue") return (val < 0 ? "-" : "") + Math.Abs(val.Value).ToString("N2");
        return val.Value.ToString("N2");
    }

    private void ClearCurrentField() {
        _currentBuffer = "";
        UpdateFieldValue(_activeField, null);
        _ = AutoSave();
    }

    private void NextField() {
        var fields = IsRentalHall 
            ? new[] { "Hours", "BarSales" }
            : new[] { "Hours", "BarSales", "LottoOpeningCash", "LottoSales", "LottoCashes", "LottoNetDue", "LottoInstantTickets", "LottoBackupBag", "LottoCashCounted" };
            
        var idx = Array.IndexOf(fields, _activeField);
        if (idx < fields.Length - 1) {
             ActivateField(fields[idx + 1]);
        } else if (idx == fields.Length - 1) {
             _ = HandleFinalConfirm();
        }
    }
    
    private void PrevField() {
        var fields = IsRentalHall 
            ? new[] { "Hours", "BarSales" }
            : new[] { "Hours", "BarSales", "LottoOpeningCash", "LottoSales", "LottoCashes", "LottoNetDue", "LottoInstantTickets", "LottoBackupBag", "LottoCashCounted" };
            
        var idx = Array.IndexOf(fields, _activeField);
        if (idx > 0) ActivateField(fields[idx - 1]);
    }

    private void TogglePolarity() {
        if (IsLocked || string.IsNullOrEmpty(_activeField)) return;
        
        switch(_activeField) {
            case "Hours": TotalHours = -(TotalHours ?? 0); break;
            case "BarSales": BarSales = -(BarSales ?? 0); break;
            case "LottoOpeningCash": LottoOpeningCash = -(LottoOpeningCash ?? 0); break;
            case "LottoSales": LottoSales = -(LottoSales ?? 0); break;
            case "LottoCashes": LottoCashes = -(LottoCashes ?? 0); break;
            case "LottoInstantTickets": LottoInstantTickets = -(LottoInstantTickets ?? 0); break;
            case "LottoBackupBag": LottoBackupBag = -(LottoBackupBag ?? 0); break;
            case "LottoCashCounted": LottoCashCounted = -(LottoCashCounted ?? 0); break;
            case "LottoNetDue": LottoNetDue = -(LottoNetDue ?? 0); break;
        }
        _currentBuffer = ""; 
        _ = AutoSave();
        StateHasChanged();
    }

    private void UpdateFieldValue(string field, decimal? val) {
        switch(field) {
            case "Hours": TotalHours = val; break;
            case "BarSales": BarSales = val; break;
            case "LottoOpeningCash": LottoOpeningCash = val; break;
            case "LottoSales": LottoSales = val; break;
            case "LottoCashes": LottoCashes = val; break;
            case "LottoInstantTickets": LottoInstantTickets = val; break;
            case "LottoBackupBag": LottoBackupBag = val; break;
            case "LottoCashCounted": LottoCashCounted = val; break;
            case "LottoNetDue": LottoNetDue = (LottoNetDue < 0) ? -(val ?? 0) : val; break;
        }
        StateHasChanged(); // Instant UI Response
    }

    private async Task AutoSave() {
        // Implementation of auto-save to DB
        // For now, we reuse the HandleSubmit logic but without the redirect
        await SilentSave();
    }

    private async Task SilentSave() {
        try {
            _isSaving = true;
            using var db = await DbFactory.CreateDbContextAsync();
            var existingBar = await db.BarSaleEntries.FirstOrDefaultAsync(e => (e.AdjustedSaleDate ?? e.SaleDate).Date == ReportDate.Date && e.Shift == ShiftType && e.IsRentalHall == IsRentalHall);
            
            if (existingBar != null) {
                existingBar.TotalSales = BarSales ?? 0; existingBar.TotalHours = TotalHours; existingBar.Notes = Notes;
                existingBar.ModifiedBy = CurrentUser?.Username; existingBar.ModifiedAt = DateTime.UtcNow;
                await db.SaveChangesAsync();
            } else if ((BarSales != null && BarSales > 0) || (TotalHours != null && TotalHours > 0)) {
                // ONLY CREATE if there is actual non-zero activity
                db.BarSaleEntries.Add(new BarSaleEntry {
                    SaleDate = DateTime.Now, AdjustedSaleDate = ReportDate, TotalSales = BarSales ?? 0,
                    TotalHours = TotalHours, IsRentalHall = IsRentalHall, Shift = ShiftType, Notes = Notes,
                    CreatedBy = CurrentUser?.Username, CreatedAt = DateTime.UtcNow
                });
                await db.SaveChangesAsync();
                ExistingEntryFound = true;
            }

            if (!IsRentalHall) {
                var lottoShifts = LotteryRepo.GetByDateRange(ReportDate, ReportDate);
                var existingLotto = lottoShifts.FirstOrDefault(s => s.ShiftType == ShiftType);
                if (existingLotto != null) {
                    existingLotto.TotalSales = LottoSales ?? 0; existingLotto.TotalPayouts = LottoCashes ?? 0;
                    existingLotto.TotalCancels = LottoInstantTickets ?? 0;
                    existingLotto.NetDue = LottoNetDue ?? 0; existingLotto.StartingCash = LottoOpeningCash ?? 0;
                    existingLotto.BackupBagAmount = LottoBackupBag ?? 0; existingLotto.EndingCash = LottoCashCounted ?? 0;
                    existingLotto.EnvelopeAmount = LottoEnvelopeAmount; existingLotto.Notes = Notes;
                    LotteryRepo.Update(existingLotto);
                } else if ((LottoSales != null && LottoSales > 0) || (LottoCashes != null && LottoCashes > 0) || (LottoNetDue != null && LottoNetDue != 0) || (LottoCashCounted != null && LottoCashCounted > 0)) {
                    // ONLY CREATE if there is actual non-zero lottery activity
                    LotteryRepo.Create(new LotteryShift {
                        ShiftDate = ReportDate, EmployeeName = CurrentUser?.Username ?? "Unknown", ShiftType = ShiftType,
                        TotalSales = LottoSales ?? 0, TotalPayouts = LottoCashes ?? 0, TotalCancels = LottoInstantTickets ?? 0,
                        NetDue = LottoNetDue ?? 0, StartingCash = LottoOpeningCash ?? 0, BackupBagAmount = LottoBackupBag ?? 0,
                        EndingCash = LottoCashCounted ?? 0, EnvelopeAmount = LottoEnvelopeAmount, Notes = Notes,
                        CreatedBy = CurrentUser?.Username, CreatedDate = DateTime.UtcNow, Status = "Draft"
                    });
                    ExistingEntryFound = true;
                }
            }
        } catch { /* Silent fail for auto-save background */ }
        finally {
             _isSaving = false;
             await InvokeAsync(StateHasChanged);
        }
    }

    private async Task HandleFinalConfirm() {
        bool lottoIncomplete = !IsRentalHall && (
            LottoSales == null || 
            LottoCashes == null || 
            LottoNetDue == null || 
            LottoInstantTickets == null ||
            LottoOpeningCash == null ||
            LottoCashCounted == null
        );

        if (BarSales == null || BarSales <= 0 || TotalHours == null || TotalHours <= 0 || lottoIncomplete) {
            _validationError = "Required fields are missing. Please enter values for all lottery boxes (even if zero).";
            _showValidation = true;

            // Auto-Focus the first field that needs attention
            if (TotalHours == null || TotalHours <= 0) ActivateField("Hours");
            else if (BarSales == null || BarSales <= 0) ActivateField("BarSales");
            else if (!IsRentalHall) {
                if (LottoOpeningCash == null) ActivateField("LottoOpeningCash");
                else if (LottoSales == null) ActivateField("LottoSales");
                else if (LottoCashes == null) ActivateField("LottoCashes");
                else if (LottoNetDue == null) ActivateField("LottoNetDue");
                else if (LottoInstantTickets == null) ActivateField("LottoInstantTickets");
                else if (LottoCashCounted == null) ActivateField("LottoCashCounted");
            }

            return;
        }
        _showSubmitConfirm = true;
    }

