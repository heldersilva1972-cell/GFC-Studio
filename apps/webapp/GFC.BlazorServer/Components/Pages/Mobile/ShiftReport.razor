    }
    .sim-res-label { font-size: 0.6rem; font-weight: 800; color: var(--c-text-muted); text-transform: uppercase; margin-bottom: 2px; }
    .sim-res-val { font-size: 1.1rem; font-weight: 900; color: var(--c-text-primary); }

    .sim-res-card.short { border-top: 4px solid #e11d48; background: rgba(225, 29, 72, 0.05); }
