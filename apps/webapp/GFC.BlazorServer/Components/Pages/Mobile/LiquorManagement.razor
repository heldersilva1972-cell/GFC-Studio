        font-size: 1.1rem;
    }

    .history-icon.checkout { background: #fee2e2; color: #ef4444; }
    .history-icon.restock { background: #dcfce7; color: #22c55e; }
    .history-icon.adjustment { background: #eff6ff; color: #3b82f6; }

    .history-info { flex: 1; }
    .history-top { display: flex; justify-content: space-between; align-items: center; }
    .history-bottom { font-size: 0.75rem; color: #94a3b8; }
    .change { font-weight: 800; font-family: monospace; }
    .change.plus { color: #22c55e; }
    .change.minus { color: #ef4444; }

    /* Modal Styling */
    .modal-overlay {
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,0.5);
        display: flex;
        align-items: flex-end;
        z-index: 1000;
    }

    .modal-content-modern {
        background: white;
        width: 100%;
        border-radius: 30px 30px 0 0;
        padding: 2rem;
        max-height: 90vh;
        overflow-y: auto;
    }

    .modal-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; }
    .modal-header h2 { font-size: 1.25rem; font-weight: 800; margin: 0; }
    .btn-close-modal { background: #f1f5f9; border: none; width: 32px; height: 32px; border-radius: 50%; }

    .counter-input {
        display: flex;
        align-items: center;
        background: #f1f5f9;
        border-radius: 10px;
        overflow: hidden;
    }

    .counter-input button { border: none; background: transparent; padding: 0.5rem 1rem; color: #4f46e5; }
    .counter-input input { border: none; background: transparent; width: 40px; text-align: center; font-weight: 700; color: #1e293b; }

    /* Light Theme for Controls */
    .form-control, .form-select, .modern-control {
        background: #f1f5f9 !important;
        border: 1px solid #cbd5e1 !important;
        color: #0f172a !important;
        border-radius: 12px;
        padding: 0.75rem 1rem;
        font-weight: 600;
    }

    .form-control::placeholder { color: #94a3b8 !important; }

    /* Counter Styling Fix */
    .card-meta { font-size: 0.75rem; color: #334155; font-weight: 500; margin-bottom: 0.4rem; }
    .limit-label { font-size: 0.7rem; color: #475569; font-weight: 600; }
    .text-muted { color: #475569 !important; }

    .image-uploader-modern {
        width: 100%;
        border-radius: 18px;
        background: #f1f5f9;
        overflow: hidden;
        border: 2px dashed #cbd5e1;
        aspect-ratio: 4/3;
    }

    .upload-zone {
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
    }

    .preview-container {
        position: relative;
        width: 100%;
        height: 100%;
    }

    .preview-img {
        width: 100%;
        height: 100%;
        object-fit: contain;
    }

    .preview-actions {
        position: absolute;
        bottom: 12px;
        left: 12px;
        right: 12px;
        display: flex;
        gap: 10px;
    }

    .btn-retake {
        flex: 1;
        background: rgba(255,255,255,0.9);
        color: #1e293b;
        padding: 8px;
        border-radius: 10px;
        text-align: center;
        font-weight: 700;
        font-size: 0.8rem;
        cursor: pointer;
        backdrop-filter: blur(4px);
    }

    .btn-delete {
        background: rgba(239, 68, 68, 0.9);
        color: white;
        border: none;
        width: 36px;
        height: 36px;
        border-radius: 10px;
        backdrop-filter: blur(4px);
    }

    .modal-scanner-box {
        width: 100%;
        border-radius: 14px;
        background: #000;
        overflow: hidden;
    }
</style>

@code {
    private string _activeTab = "inventory";
    private string _searchTerm = "";
    private List<LiquorItem> _items = new();
    private List<LiquorTransaction> _recentTransactions = new();
    private LiquorNotificationRule _myRules = new();
    
    private bool _showEditModal = false;
    private LiquorItem _editingItem = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        _items = (await LiquorService.GetAllItemsAsync()).ToList();
        _recentTransactions = (await LiquorService.GetRecentTransactionsAsync()).ToList();
        
        var user = AuthStateProvider.GetCurrentUser();
        if (user != null)
        {
            _myRules = (await LiquorService.GetNotificationRuleAsync(user.UserId)) ?? new LiquorNotificationRule { UserId = user.UserId };
        }
    }

    private IEnumerable<LiquorItem> FilteredItems => string.IsNullOrWhiteSpace(_searchTerm) 
        ? _items 
        : _items.Where(i => i.Name.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase) || i.Category.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase));

    private void OpenAddModal()
    {
        _editingItem = new LiquorItem { BottleSize = "750ml", Category = "Whiskey", CurrentStock = 1, MinStockLimit = 2 };
        _showEditModal = true;
    }

    private void OpenEditModal(LiquorItem item)
    {
        // Clone for safe editing
        _editingItem = new LiquorItem {
            Id = item.Id,
            Name = item.Name,
            Description = item.Description,
            UpcCode = item.UpcCode,
            BottleSize = item.BottleSize,
            Category = item.Category,
            ImageUrl = item.ImageUrl,
            CurrentStock = item.CurrentStock,
            MinStockLimit = item.MinStockLimit,
            IsActive = item.IsActive
        };
        _showEditModal = true;
    }

    private async Task SaveItem()
    {
        if (_editingItem.Id == 0)
        {
            await LiquorService.CreateItemAsync(_editingItem);
        }
        else
        {
            await LiquorService.UpdateItemAsync(_editingItem);
        }
        
        _showEditModal = false;
        await LoadData();
    }

    private async Task DeleteCurrent()
    {
        if (_editingItem.Id != 0)
        {
            await LiquorService.DeleteItemAsync(_editingItem.Id);
            _showEditModal = false;
            await LoadData();
        }
    }

    private async Task SaveRules()
    {
        await LiquorService.UpsertNotificationRuleAsync(_myRules);
        // Show toast
    }

    private void CloseModal()
    {
        _showEditModal = false;
        _isModalScannerActive = false;
    }

    private bool _isModalScannerActive = false;

    private async Task StartBarcodeScan()
    {
        _isModalScannerActive = true;
        StateHasChanged();
        await JSRuntime.InvokeVoidAsync("LiquorScanner.startModal", DotNetObjectReference.Create(this));
    }

    private async Task StopModalScanner()
    {
        _isModalScannerActive = false;
        await JSRuntime.InvokeVoidAsync("LiquorScanner.stopModal");
    }

    [JSInvokable]
    public void OnModalScanSuccess(string decodedText)
    {
        _editingItem.UpcCode = decodedText;
        _isModalScannerActive = false;
        StateHasChanged();
    }

    private string GetStockClass(int stock, int limit)
    {
        if (stock == 0) return "critical";
        if (stock <= limit) return "low";
        return "normal";
    }

    private string GetTxIcon(string type) => type switch {
        "Checkout" => "bi-dash-circle",
        "Restock" => "bi-plus-circle",
        _ => "bi-gear"
    };

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;

        try
        {
            // [FIX] Read file into base64 for immediate UI preview before server-side save
            var buffer = new byte[file.Size];
            await file.OpenReadStream(1024 * 1024 * 5).ReadAsync(buffer);
            var base64 = Convert.ToBase64String(buffer);
            _editingItem.ImageUrl = $"data:{file.ContentType};base64,{base64}";
            StateHasChanged();

            // Background upload to permanent storage
            var memoryStream = new MemoryStream(buffer);
            var asset = await MediaService.CreateMediaAssetAsync(memoryStream, file.Name, "LiquorReference", "System");
            _editingItem.ImageUrl = asset.FilePath;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            // Error handling
            Console.WriteLine(ex.Message);
        }
    }
}
