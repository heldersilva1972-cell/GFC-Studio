@code {
    private bool _isLoading = true;
    private string? _activeTab = null; 
    private List<LiquorItem> _items = new();
    private List<LiquorVendor> _vendors = new();
    private int _unpaidCount = 0;

    // Feature state mirrored from desktop hub for logic parity
    private Dictionary<int, int> _cart = new(); 
    private Dictionary<int, int> _stockCounts = new();
    private LiquorItem? _selectedCountItem;
    private string _countEntry = "0";
    private string _searchQuery = "";
    private string _searchTerm = "";
    private int _filterVendorId = 0;
    private bool _isAlphabeticalView = true;
    private List<LiquorOrder> _activeOrders = new();
    private List<LiquorOrder> _unpaidOrders = new();
    private List<LiquorOrder> _orderHistory = new();
    private List<LiquorTransaction> _auditHistory = new();
    private bool _isOrderingHistory = true;

    // Safety Guard State
    private bool _showExitConfirm = false;
    private string? _pendingTab = null;
    private bool _isExitingToPortal = false;

    private AppUser? _currentUser;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        if (user.Identity?.IsAuthenticated == true)
        {
             var userIdStr = user.FindFirst("UserId")?.Value ?? user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
             if (int.TryParse(userIdStr, out var userId))
             {
                 _currentUser = new AppUser { Username = user.Identity.Name ?? "Staff", UserId = userId };
             }
        }
        await RefreshDataAsync();
    }

    private async Task RefreshDataAsync()
    {
        _isLoading = true;
        var allItems = await LiquorService.GetAllItemsAsync();
        _items = allItems.ToList();
        
        var allVendors = await LiquorService.GetAllVendorsAsync();
        _vendors = allVendors.ToList();
        
        var allOrders = (await LiquorService.GetAllOrdersAsync()).OrderByDescending(o => o.OrderDate).ToList();
        _activeOrders = allOrders.Where(o => o.Status == "Placed").ToList();
        _unpaidOrders = allOrders.Where(o => o.Status == "Received" && !o.IsPaid).ToList();
        _orderHistory = allOrders.Where(o => o.Status == "Received").ToList();
        _unpaidCount = _unpaidOrders.Count;
        
        var allTransactions = await LiquorService.GetRecentTransactionsAsync(100);
        _auditHistory = allTransactions.Where(t => t.TransactionType == "Reconcile" || t.TransactionType == "Adjustment").ToList();
        
        _isLoading = false;
        StateHasChanged();
    }

    private void NavigateToPortal()
    {
        bool hasUnsavedChanges = (_activeTab == "ordering" && _cart.Any()) || 
                                 (_activeTab == "count" && _stockCounts.Any());
                                 
        if (hasUnsavedChanges)
        {
            _isExitingToPortal = true;
            _pendingTab = null;
            _showExitConfirm = true;
            StateHasChanged();
            return;
        }
        
        Navigation.NavigateTo("/mobile");
    }

    private void SetTab(string? tab) 
    {
        // Safety Guard: Check for unsaved changes before switching
        if (_activeTab != null && (tab != _activeTab))
        {
            bool hasUnsavedChanges = (_activeTab == "ordering" && _cart.Any()) || 
                                     (_activeTab == "count" && _stockCounts.Any());
                                     
            if (hasUnsavedChanges)
            {
                _pendingTab = tab;
                _isExitingToPortal = false;
                _showExitConfirm = true;
                StateHasChanged();
                return;
            }
        }

        ProcessTabSwitch(tab);
    }

    private void CancelExit()
    {
        _showExitConfirm = false;
        _pendingTab = null;
        _isExitingToPortal = false;
    }

    private void ConfirmExit()
    {
        _showExitConfirm = false;
        
        if (_isExitingToPortal)
        {
             Navigation.NavigateTo("/mobile");
        }
        else
        {
            ProcessTabSwitch(_pendingTab);
        }
    }

    private void ProcessTabSwitch(string? tab)
    {
        _activeTab = tab;
        _searchQuery = "";
        _searchTerm = "";
        StateHasChanged();
    }

    // -- Ordering Logic --
    private int GetCartQuantity(int itemId) => _cart.ContainsKey(itemId) ? _cart[itemId] : 0;
    private void AddToCart(int itemId, int qty) { if (_cart.ContainsKey(itemId)) _cart[itemId] += qty; else _cart[itemId] = qty; if (_cart[itemId] <= 0) _cart.Remove(itemId); }
    private decimal GetCartTotal()
    {
        decimal total = 0;
        foreach (var entry in _cart.Where(e => e.Value > 0))
        {
            var item = _items.FirstOrDefault(i => i.Id == entry.Key);
            if (item != null) total += item.CurrentPrice * entry.Value;
        }
        return total;
    }

    private decimal GetVendorMin(LiquorVendor? vendor)
    {
        if (vendor == null) return 0;
        var freshVendor = _vendors.FirstOrDefault(v => v.Id == vendor.Id);
        return freshVendor?.MinimumOrderAmount ?? 0;
    }
    private async Task CreateOrderAsync(int vendorId)
    {
        if (_currentUser == null) return;
        var vendorItemsInCart = _items.Where(i => i.VendorId == vendorId && _cart.ContainsKey(i.Id)).ToList();
        if (!vendorItemsInCart.Any()) return;
        
        var orderItems = vendorItemsInCart.Select(i => new LiquorOrderItem { 
            LiquorItemId = i.Id, 
            Quantity = _cart[i.Id], 
            UnitPriceAtTimeOfOrder = i.CurrentPrice 
        }).ToList();

        decimal total = orderItems.Sum(oi => oi.UnitPriceAtTimeOfOrder * oi.Quantity);

        var order = new LiquorOrder { 
            VendorId = vendorId, 
            OrderDate = DateTime.Now, 
            Status = "Placed", 
            IsPaid = false, 
            ItemsTotal = total,
            TotalCost = total,
            UserId = _currentUser.UserId,
            OrderItems = orderItems 
        };

        await LiquorService.CreateOrderAsync(order);
        foreach (var item in vendorItemsInCart) _cart.Remove(item.Id);
        await RefreshDataAsync();
    }

    private async Task PlaceAllOrders()
    {
        if (!_cart.Any()) return;
        
        var vendorIds = _items.Where(i => _cart.ContainsKey(i.Id) && i.VendorId.HasValue)
                             .Select(i => i.VendorId!.Value)
                             .Distinct()
                             .ToList();

        foreach (var vId in vendorIds)
        {
            await CreateOrderAsync(vId);
        }
        
        _activeTab = "receiving"; // Switch to receiving view so they see the placed orders
        StateHasChanged();
    }

    // -- Receiving & Payments --
    private async Task MarkReceived(int orderId) { await LiquorService.UpdateOrderStatusAsync(orderId, "Received"); await RefreshDataAsync(); }
    private async Task MarkPaid(int orderId) 
    { 
        if (_currentUser == null) return;
        var order = _unpaidOrders.FirstOrDefault(o => o.Id == orderId);
        if (order == null) return;
        await LiquorService.MarkOrderAsPaidAsync(orderId, DateTime.Now, order.TotalCost, _currentUser.UserId); 
        await RefreshDataAsync(); 
    }

    // -- Stock Count Logic (Inline Session Workflow) --
    private void AdjustSessionCount(int itemId, int delta)
    {
        if (!_stockCounts.ContainsKey(itemId))
        {
            var item = _items.FirstOrDefault(i => i.Id == itemId);
            if (item == null) return;
            _stockCounts[itemId] = item.CurrentStock;
        }

        _stockCounts[itemId] += delta;
        if (_stockCounts[itemId] < 0) _stockCounts[itemId] = 0;
        StateHasChanged();
    }

    private async Task SubmitFullReconciliation()
    {
        if (!_stockCounts.Any() || _currentUser == null) return;
        
        var auditEntries = _stockCounts.Select(kvp => new GFC.Core.Models.StockReconcileEntry { 
            ItemId = kvp.Key, 
            ActualCount = kvp.Value 
        }).ToList();
        
        await LiquorService.ReconcileStockAsync(auditEntries, _currentUser.UserId); 
        _stockCounts.Clear();
        await RefreshDataAsync();
        _activeTab = null;
    }
}
