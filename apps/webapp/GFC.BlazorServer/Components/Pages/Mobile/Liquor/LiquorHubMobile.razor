@code {
    private bool _isLoading = true;
    private string? _activeTab = null; 
    private List<LiquorItem> _items = new();
    private List<LiquorVendor> _vendors = new();
    private int _unpaidCount = 0;

    // Feature state mirrored from desktop hub for logic parity
    private Dictionary<int, int> _cart = new(); 
    private Dictionary<int, int> _stockCounts = new();
    private LiquorItem? _selectedCountItem;
    private string _countEntry = "0";
    private string _searchQuery = "";
    private string _searchTerm = "";
    private int _filterVendorId = 0;
    private bool _isAlphabeticalView = true;
    private List<LiquorOrder> _activeOrders = new();
    private List<LiquorOrder> _unpaidOrders = new();
    private List<LiquorOrder> _orderHistory = new();
    private List<LiquorTransaction> _auditHistory = new();
    private string _historySubTab = "orders";
    private string _analyticsSubTab = "overview";
    private int _analyticsYear = DateTime.Now.Year;

    // Safety Guard State
    private bool _showExitConfirm = false;
    private string? _pendingTab = null;
    private bool _isExitingToPortal = false;

    // Setup Management State
    private string _setupSubTab = "items";
    private bool _showSetupForm = false;
    private bool _showPriceHistoryModal = false;
    private LiquorItem _editItem = new();
    private LiquorVendor _editVendor = new();
    private LiquorNotificationRule _notifRule = new();
    private bool _isSaving = false;

    // Analytics State
    private List<ProductTrendDTO> _trends = new();

    private AppUser? _currentUser;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        if (user.Identity?.IsAuthenticated == true)
        {
             var userIdStr = user.FindFirst("UserId")?.Value 
                          ?? user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value
                          ?? user.FindFirst("sub")?.Value;
                          
             if (int.TryParse(userIdStr, out var userId))
             {
                 _currentUser = new AppUser { Username = user.Identity.Name ?? "Staff", UserId = userId };
             }
             else
             {
                 // Fallback: try to find any claim that looks like an ID
                 var idClaim = user.Claims.FirstOrDefault(c => c.ValueType == System.Security.Claims.ClaimValueTypes.Integer || c.Type.Contains("id", StringComparison.OrdinalIgnoreCase));
                 if (idClaim != null && int.TryParse(idClaim.Value, out var fallbackId))
                 {
                     _currentUser = new AppUser { Username = user.Identity.Name ?? "Staff", UserId = fallbackId };
                 }
             }
        }
        await RefreshDataAsync();
    }

    private async Task RefreshDataAsync()
    {
        _isLoading = true;
        var allItems = await LiquorService.GetAllItemsAsync();
        _items = allItems.ToList();
        
        var allVendors = await LiquorService.GetAllVendorsAsync();
        _vendors = allVendors.ToList();
        
        var allOrders = (await LiquorService.GetAllOrdersAsync()).OrderByDescending(o => o.OrderDate).ToList();
        _activeOrders = allOrders.Where(o => o.Status == "Placed").ToList();
        _unpaidOrders = allOrders.Where(o => o.Status == "Received" && !o.IsPaid).ToList();
        _orderHistory = allOrders.Where(o => o.Status == "Received").ToList();
        _unpaidCount = _unpaidOrders.Count;
        
        var allTransactions = await LiquorService.GetRecentTransactionsAsync(100);
        _auditHistory = allTransactions.ToList();
        
        _trends = await LiquorService.GetProductTrendsAsync(30);

        if (_currentUser != null)
        {
            _notifRule = (await LiquorService.GetNotificationRuleAsync(_currentUser.UserId)) 
                         ?? new LiquorNotificationRule { UserId = _currentUser.UserId };
        }

        _isLoading = false;
        StateHasChanged();
    }

    private double GetOuncesFromSize(string? size)
    {
        if (string.IsNullOrEmpty(size)) return 0;
        var s = size.ToLower().Replace(" ", "");
        if (s.Contains("750ml")) return 25.36;
        if (s == "1l" || s.Contains("1000ml")) return 33.81;
        if (s.Contains("1.75l")) return 59.17;
        if (s.Contains("375ml")) return 12.68;
        if (s.Contains("50ml")) return 1.69;
        if (s.Contains("355ml")) return 12.0;
        if (s.Contains("187ml")) return 6.32;
        if (s.Contains("12oz")) return 12.0;
        if (s.Contains("16oz")) return 16.0;
        if (s.Contains("10oz")) return 10.0;
        return 0;
    }

    private class PriceChangeInfo {
        public string Delta { get; set; } = "";
        public string Date { get; set; } = "";
        public bool IsIncrease { get; set; }
    }

    private PriceChangeInfo? GetPriceChangeInfo(int itemId, string label)
    {
        var logs = _auditHistory.Where(t => t.ItemId == itemId && t.TransactionType == "Update" && !string.IsNullOrEmpty(t.Notes)).ToList();
        foreach (var log in logs)
        {
            // Parse notes: e.g. "Bottle Cost: $10.00 -> $12.00" or "Drink Price: $5.00 -> $6.00"
            // We want to be retro-compatible with "Cost:" and "Price:"
            var targetLabel = label;
            if (label.Equals("Bottle Cost", StringComparison.OrdinalIgnoreCase)) targetLabel = "Cost";
            if (label.Equals("Drink Price", StringComparison.OrdinalIgnoreCase)) targetLabel = "Price";

            if (log.Notes!.Contains(targetLabel, StringComparison.OrdinalIgnoreCase))
            {
                var parts = log.Notes.Split('|');
                var exactPart = parts.FirstOrDefault(p => p.Contains(targetLabel, StringComparison.OrdinalIgnoreCase));
                if (exactPart != null && exactPart.Contains("->"))
                {
                    var arrowParts = exactPart.Split("->");
                    if (arrowParts.Length == 2)
                    {
                        var oldStr = new string(arrowParts[0].Where(c => char.IsDigit(c) || c == '.').ToArray());
                        var newStr = new string(arrowParts[1].Where(c => char.IsDigit(c) || c == '.').ToArray());
                        
                        if (decimal.TryParse(oldStr, out var oldVal) && decimal.TryParse(newStr, out var newVal))
                        {
                            var diff = newVal - oldVal;
                            if (Math.Abs(diff) < 0.001m) continue;

                            return new PriceChangeInfo {
                                Delta = (diff > 0 ? "+" : "") + diff.ToString("C"),
                                Date = log.Timestamp.ToLocalTime().ToString("MMM dd, yyyy"),
                                IsIncrease = diff > 0
                            };
                        }
                    }
                }
            }
        }
        return null;
    }

    private bool _showOrderConfirm = false;
    private List<OrderConfirmationSummary> _orderSummary = new();
    private int? _singleOrderVendorId = null;
    
    // History Filters
    private int _historyYearFilter = 0;
    private int _historyVendorFilter = 0;
    private string _historyProductSearch = "";
    private int _historyPurchaseProductId = 0;
    private HashSet<int> _expandedHistoryOrders = new();
    
    private void ToggleHistoryOrder(int orderId)
    {
        if (_expandedHistoryOrders.Contains(orderId))
            _expandedHistoryOrders.Remove(orderId);
        else
            _expandedHistoryOrders.Add(orderId);
    }

    private LiquorOrder? _orderToReceive;
    private string _receiveInvoiceNumber = "";
    private decimal _receiveTotalDue = 0;

    private LiquorOrder? _orderToPay;
    private decimal _actualPaidAmount = 0;
    private DateTime _paidDate = DateTime.Now;

    public class OrderConfirmationSummary
    {
        public string VendorName { get; set; } = "";
        public int ItemCount { get; set; }
        public decimal Total { get; set; }
    }

    private async Task PrintOrder(int id)
    {
        await JS.InvokeVoidAsync("open", $"/liquor/print-order/{id}", "_blank");
    }

    private void NavigateToPortal()
    {
        bool hasUnsavedChanges = (_activeTab == "ordering" && _cart.Any()) || 
                                 (_activeTab == "count" && _stockCounts.Any());
                                 
        if (hasUnsavedChanges)
        {
            _isExitingToPortal = true;
            _pendingTab = null;
            _showExitConfirm = true;
            StateHasChanged();
            return;
        }
        
        Navigation.NavigateTo("/mobile");
    }

    private void SetTab(string? tab) 
    {
        // Safety Guard: Check for unsaved changes before switching
        if (_activeTab != null && (tab != _activeTab))
        {
            bool hasUnsavedChanges = (_activeTab == "ordering" && _cart.Any()) || 
                                     (_activeTab == "count" && _stockCounts.Any());
                                     
            if (hasUnsavedChanges)
            {
                _pendingTab = tab;
                _isExitingToPortal = false;
                _showExitConfirm = true;
                StateHasChanged();
                return;
            }
        }

        ProcessTabSwitch(tab);
    }

    private void CancelExit()
    {
        _showExitConfirm = false;
        _pendingTab = null;
        _isExitingToPortal = false;
    }

    private void ConfirmExit()
    {
        _showExitConfirm = false;
        
        if (_isExitingToPortal)
        {
             Navigation.NavigateTo("/mobile");
        }
        else
        {
            ProcessTabSwitch(_pendingTab);
        }
    }

    private void ProcessTabSwitch(string? tab)
    {
        _activeTab = tab;
        _searchQuery = "";
        _searchTerm = "";
        StateHasChanged();
    }

    // -- Ordering Logic --
    private int GetCartQuantity(int itemId) => _cart.ContainsKey(itemId) ? _cart[itemId] : 0;
    private void AddToCart(int itemId, int qty) { if (_cart.ContainsKey(itemId)) _cart[itemId] += qty; else _cart[itemId] = qty; if (_cart[itemId] <= 0) _cart.Remove(itemId); }
    private decimal GetCartTotal()
    {
        decimal total = 0;
        foreach (var entry in _cart.Where(e => e.Value > 0))
        {
            var item = _items.FirstOrDefault(i => i.Id == entry.Key);
            if (item != null) 
            {
                total += item.CurrentPrice * entry.Value;
                if (item.IsBeer) total += (0.05m * item.PackSize) * entry.Value;
            }
        }
        return total;
    }

    private decimal GetVendorMin(LiquorVendor? vendor)
    {
        if (vendor == null) return 0;
        var freshVendor = _vendors.FirstOrDefault(v => v.Id == vendor.Id);
        return freshVendor?.MinimumOrderAmount ?? 0;
    }
    private async Task CreateOrderAsync(int vendorId)
    {
        if (_currentUser == null) return;
        var vendorItemsInCart = _items.Where(i => i.VendorId == vendorId && _cart.ContainsKey(i.Id)).ToList();
        if (!vendorItemsInCart.Any()) return;
        
        var orderItems = vendorItemsInCart.Select(i => new LiquorOrderItem { 
            LiquorItemId = i.Id, 
            Quantity = _cart[i.Id], 
            UnitPriceAtTimeOfOrder = i.CurrentPrice, 
            BottleFeeAtTimeOfOrder = 0 // Removed fee
        }).ToList();

        decimal itemsTotal = orderItems.Sum(oi => oi.UnitPriceAtTimeOfOrder * oi.Quantity);
        decimal feesTotal = 0; // Removed fee

        var order = new LiquorOrder { 
            VendorId = vendorId, 
            OrderDate = DateTime.Now, 
            Status = "Placed", 
            IsPaid = false, 
            ItemsTotal = itemsTotal,
            AdditionalCosts = feesTotal,
            TotalCost = itemsTotal + feesTotal,
            UserId = _currentUser.UserId,
            OrderItems = orderItems 
        };

        await LiquorService.CreateOrderAsync(order);
        foreach (var item in vendorItemsInCart) _cart.Remove(item.Id);
        await RefreshDataAsync();
    }

    private void ShowOrderConfirmation(int? vendorId = null)
    {
        _singleOrderVendorId = vendorId;
        _orderSummary.Clear();

        var targetVendors = vendorId.HasValue 
            ? _vendors.Where(v => v.Id == vendorId.Value).ToList()
            : _vendors.Where(v => _items.Any(i => i.VendorId == v.Id && _cart.ContainsKey(i.Id) && _cart[i.Id] > 0)).ToList();

        foreach (var vendor in targetVendors)
        {
            var cartItems = _items.Where(i => i.VendorId == vendor.Id && _cart.ContainsKey(i.Id) && _cart[i.Id] > 0).ToList();
            if (cartItems.Any())
            {
                decimal vTotal = cartItems.Sum(i => i.CurrentPrice * _cart[i.Id]); // Removed fee
                
                _orderSummary.Add(new OrderConfirmationSummary {
                    VendorName = vendor.Name,
                    ItemCount = cartItems.Sum(i => _cart[i.Id]),
                    Total = vTotal
                });
            }
        }

        if (_orderSummary.Any())
        {
            _showOrderConfirm = true;
            StateHasChanged();
        }
    }

    private async Task ConfirmAndPlaceOrders()
    {
        _showOrderConfirm = false;
        
        if (_singleOrderVendorId.HasValue)
        {
            await CreateOrderAsync(_singleOrderVendorId.Value);
        }
        else
        {
            var vendorIds = _orderSummary.Select(s => _vendors.First(v => v.Name == s.VendorName).Id).ToList();
            foreach (var vId in vendorIds)
            {
                await CreateOrderAsync(vId);
            }
            _activeTab = "receiving";
        }

        _singleOrderVendorId = null;
        _orderSummary.Clear();
        StateHasChanged();
    }

    private async Task PlaceAllOrders()
    {
        ShowOrderConfirmation();
        await Task.CompletedTask;
    }

    // -- Receiving & Payments --
    private async Task StartReceiptAsync(LiquorOrder order)
    {
        _orderToReceive = order;
        _receiveInvoiceNumber = "";
        _receiveTotalDue = 0; // Default to zero for manual entry
        StateHasChanged();
    }

    private async Task ConfirmReceiptAsync()
    {
        if (_orderToReceive == null || _currentUser == null) return;
        
        // Final sanity check for mandatory fields
        if (string.IsNullOrWhiteSpace(_receiveInvoiceNumber) || _receiveTotalDue <= 0) return;
        
        // Calculate discrepancy (Tax + Fees)
        var additionalCosts = _receiveTotalDue - _orderToReceive.ItemsTotal;
        
        // 1. Update order meta
        await LiquorService.UpdateOrderStatusAsync(_orderToReceive.Id, "Received", _receiveInvoiceNumber, 0, additionalCosts);
        
        // 2. Process stock arrival
        await LiquorService.ReceiveOrderAsync(_orderToReceive.Id, _currentUser.UserId);
        
        _orderToReceive = null;
        await RefreshDataAsync();
        
        // Confirmation Alert
        await JS.InvokeVoidAsync("alert", "Order marked as RECEIVED! Inventory has been updated.");
        
        _activeTab = null; // Back to Dashboard
        StateHasChanged();
    }

    private async Task MarkReceived(int orderId) { 
        var order = _activeOrders.FirstOrDefault(o => o.Id == orderId);
        if (order != null) await StartReceiptAsync(order);
    }
    private void OpenPaymentModal(LiquorOrder order)
    {
        _orderToPay = order;
        _actualPaidAmount = order.TotalCost;
        _paidDate = DateTime.Now;
    }

    private async Task ConfirmPaymentAsync()
    {
        if (_orderToPay == null || _currentUser == null) return;
        
        await LiquorService.MarkOrderAsPaidAsync(_orderToPay.Id, _paidDate, _actualPaidAmount, _currentUser.UserId);
        _orderToPay = null;
        await RefreshDataAsync();
    }

    // -- Setup Tool Logic (NEW Master Hub Parity) --
    private string _newVendorName = "";
    private LiquorItem _newItem = new();
    private bool _showVendorModal = false;
    private bool _showAddItemModal = false;
    private bool _isEditMode = false;

    private async Task AddNewVendor()
    {
        if (string.IsNullOrEmpty(_newVendorName)) return;
        await LiquorService.CreateVendorAsync(new LiquorVendor { Name = _newVendorName, MinimumOrderAmount = 300 });
        _newVendorName = "";
        await RefreshDataAsync();
    }

    private void EditProduct(LiquorItem item)
    {
        _newItem = item;
        _isEditMode = true;
        _showAddItemModal = true;
    }

    private void CloseItemModal()
    {
        _newItem = new LiquorItem();
        _isEditMode = false;
        _showAddItemModal = false;
    }

    private async Task SaveItemAsync()
    {
        if (string.IsNullOrEmpty(_newItem.Name)) return;
        
        if (_isEditMode)
            await LiquorService.UpdateItemAsync(_newItem, _currentUser?.UserId);
        else
            await LiquorService.CreateItemAsync(_newItem, _currentUser?.UserId);

        CloseItemModal();
        await RefreshDataAsync();
    }

    private async Task DeleteVendor(int id) { await LiquorService.DeleteVendorAsync(id); await RefreshDataAsync(); }

    private async Task BatchUpdateVendors()
    {
        foreach(var vendor in _vendors) await LiquorService.UpdateVendorAsync(vendor);
        _showVendorModal = false;
        await RefreshDataAsync();
    }

    private async Task BatchUpdateItems()
    {
        if (_isSaving) return;
        _isSaving = true;
        StateHasChanged();

        try 
        {
            await LiquorService.BulkSaveLiquorItemsAsync(_items, _currentUser?.UserId);
            
            // Short delay to ensure DB transaction isolation doesn't hide the new audit logs from the next fetch
            await Task.Delay(300);
            await RefreshDataAsync();
        }
        finally
        {
            _isSaving = false;
            StateHasChanged();
        }
    }

    private async Task SaveNotificationRule()
    {
        await LiquorService.UpsertNotificationRuleAsync(_notifRule);
        await RefreshDataAsync();
        // Feedback would be nice here
    }

    // -- Stock Count Logic (Inline Session Workflow) --

    private void AdjustSessionCount(int itemId, int delta)
    {
        if (!_stockCounts.ContainsKey(itemId))
        {
            var item = _items.FirstOrDefault(i => i.Id == itemId);
            if (item == null) return;
            _stockCounts[itemId] = item.CurrentStock;
        }

        _stockCounts[itemId] += delta;
        if (_stockCounts[itemId] < 0) _stockCounts[itemId] = 0;
        StateHasChanged();
    }

    private async Task SubmitFullReconciliation()
    {
        if (!_stockCounts.Any() || _currentUser == null) return;
        
        var auditEntries = _stockCounts.Select(kvp => new GFC.Core.Models.StockReconcileEntry { 
            ItemId = kvp.Key, 
            ActualCount = kvp.Value 
        }).ToList();
        
        await LiquorService.ReconcileStockAsync(auditEntries, _currentUser.UserId); 
        _stockCounts.Clear();
        await RefreshDataAsync();
        _activeTab = null;
    }
}
