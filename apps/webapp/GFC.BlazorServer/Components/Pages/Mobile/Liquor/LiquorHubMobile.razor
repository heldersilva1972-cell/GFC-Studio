@page "/mobile/liquor/hub"
@using Microsoft.AspNetCore.Authorization
@using GFC.Core.Interfaces
@using GFC.Core.Models
@inject NavigationManager Navigation
@inject ILiquorService LiquorService
@attribute [Authorize]

<PageTitle>Liquor HUB | Mobile</PageTitle>

<div class="mobile-hub-container">
    <!-- HEADER -->
    <div class="fixed-top-header">
        <div class="d-flex align-items-center gap-3 p-4 bg-white border-bottom animate-entrance">
            <button class="btn btn-icon-round bg-light border-0" @onclick='() => Navigation.NavigateTo("/mobile")'>
                <i class="bi bi-house-door-fill text-muted"></i>
            </button>
            <div>
                <h4 class="mb-0 fw-black text-uppercase tracking-wider">LIQUOR HUB</h4>
                <div class="extra-small text-muted fw-bold">BAR & INVENTORY MANAGEMENT</div>
            </div>
        </div>
    </div>

    <!-- MAIN SCROLL AREA -->
    <main class="hub-scroll-area p-4">
        <div class="container-fluid" style="margin-top: 100px; padding-bottom: 120px;">
            
            <div class="welcome-banner mb-4 animate-entrance emerald-gradient rounded-4 p-4 shadow-sm text-white">
                <h5 class="fw-bold mb-1">Stock Dashboard</h5>
                <p class="small mb-0 opacity-75">Select a task below to manage bar inventory.</p>
            </div>

            <div class="mobile-app-grid">
                <!-- ROW 1 -->
                <div class="app-card animate-entrance stagger-1" @onclick='() => Navigation.NavigateTo("/liquor/hub?Tab=ordering")'>
                    <div class="icon-orb emerald">
                        <i class="bi bi-cart-plus-fill"></i>
                    </div>
                    <div class="card-content">
                        <h6 class="fw-black mb-0">ORDERING LIST</h6>
                        <p class="extra-small text-muted mb-0">Build your next vendor order</p>
                    </div>
                </div>

                <div class="app-card animate-entrance stagger-1" @onclick='() => Navigation.NavigateTo("/liquor/hub?Tab=active")'>
                    <div class="icon-orb blue">
                        <i class="bi bi-truck"></i>
                    </div>
                    <div class="card-content">
                        <h6 class="fw-black mb-0">RECEIVE ORDER</h6>
                        <p class="extra-small text-muted mb-0">Mark shipments into inventory</p>
                    </div>
                </div>

                <!-- ROW 2 -->
                <div class="app-card animate-entrance stagger-2" @onclick='() => Navigation.NavigateTo("/liquor/hub?Tab=unpaid")'>
                    <div class="icon-orb red">
                        @if (_unpaidCount > 0)
                        {
                            <span class="badge rounded-pill bg-danger border border-white pulse-badge">@_unpaidCount</span>
                        }
                        <i class="bi bi-cash-stack"></i>
                    </div>
                    <div class="card-content">
                        <h6 class="fw-black mb-0">UNPAID INVOICES</h6>
                        <p class="extra-small text-muted mb-0">Confirm vendor check payments</p>
                    </div>
                </div>

                <div class="app-card animate-entrance stagger-2" @onclick='() => Navigation.NavigateTo("/liquor/hub?Tab=count")'>
                    <div class="icon-orb indigo">
                        <i class="bi bi-clipboard-check-fill"></i>
                    </div>
                    <div class="card-content">
                        <h6 class="fw-black mb-0">STOCK COUNT</h6>
                        <p class="extra-small text-muted mb-0">Reconcile physical inventory</p>
                    </div>
                </div>

                <!-- ROW 3 -->
                <div class="app-card animate-entrance stagger-3" @onclick='() => Navigation.NavigateTo("/liquor/hub?Tab=history")'>
                    <div class="icon-orb amber">
                        <i class="bi bi-journal-text"></i>
                    </div>
                    <div class="card-content">
                        <h6 class="fw-black mb-0">ORDER HISTORY</h6>
                        <p class="extra-small text-muted mb-0">View all completed orders</p>
                    </div>
                </div>

                <div class="app-card animate-entrance stagger-3" @onclick='() => Navigation.NavigateTo("/liquor/hub?Tab=setup")'>
                    <div class="icon-orb purple">
                        <i class="bi bi-gear-fill"></i>
                    </div>
                    <div class="card-content">
                        <h6 class="fw-black mb-0">HUB SETUP</h6>
                        <p class="extra-small text-muted mb-0">Product alerts & Vendor settings</p>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <!-- FOOTER NAV -->
    <div class="fixed-bottom-nav">
        <div class="d-flex justify-content-around align-items-center py-3 bg-white border-top">
             <button class="nav-item-mobile active">
                 <i class="bi bi-grid-fill"></i>
                 <span>Dashboard</span>
             </button>
             <button class="nav-item-mobile" @onclick='() => Navigation.NavigateTo("/mobile")'>
                 <i class="bi bi-chevron-left"></i>
                 <span>Back to Portal</span>
             </button>
        </div>
    </div>
</div>

<style>
    .mobile-hub-container {
        position: fixed;
        top: 0; left: 0; right: 0; bottom: 0;
        background: #fdfdfd;
        overflow: hidden;
    }

    .fixed-top-header {
        position: fixed;
        top: 0; left: 0; right: 0;
        z-index: 1000;
        background: white;
    }

    .fixed-bottom-nav {
         position: fixed;
         bottom: 0; left: 0; right: 0;
         z-index: 1000;
         box-shadow: 0 -10px 40px rgba(0,0,0,0.05);
    }

    .hub-scroll-area {
        height: 100vh;
        overflow-y: auto;
        -webkit-overflow-scrolling: touch;
    }

    .emerald-gradient {
        background: linear-gradient(135deg, #10b981 0%, #059669 100%);
    }

    .mobile-app-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1.25rem;
    }

    .app-card {
        background: white;
        border-radius: 1.25rem;
        padding: 1.5rem;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        border: 1px solid rgba(0,0,0,0.05);
        box-shadow: 0 4px 15px rgba(0,0,0,0.03);
        transition: transform 0.2s;
    }

    .app-card:active {
        transform: scale(0.95);
        background: #f8f9fa;
    }

    .icon-orb {
        width: 60px;
        height: 60px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        margin-bottom: 1rem;
        position: relative;
    }

    .icon-orb.emerald { background: rgba(16, 185, 129, 0.1); color: #10b981; }
    .icon-orb.blue { background: rgba(14, 165, 233, 0.1); color: #0ea5e9; }
    .icon-orb.red { background: rgba(239, 68, 68, 0.1); color: #ef4444; }
    .icon-orb.indigo { background: rgba(79, 70, 229, 0.1); color: #4f46e5; }
    .icon-orb.amber { background: rgba(245, 158, 11, 0.1); color: #f59e0b; }
    .icon-orb.purple { background: rgba(139, 92, 246, 0.1); color: #8b5cf6; }

    .pulse-badge {
        position: absolute;
        top: -5px; right: -5px;
        font-size: 0.7rem;
        animation: pulse 2s infinite;
    }

    @@keyframes pulse {
        0% { transform: scale(1); box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.7); }
        70% { transform: scale(1.1); box-shadow: 0 0 0 10px rgba(239, 68, 68, 0); }
        100% { transform: scale(1); box-shadow: 0 0 0 0 rgba(239, 68, 68, 0); }
    }

    .nav-item-mobile {
         background: none; border: none;
         display: flex; flex-direction: column;
         align-items: center; gap: 4px;
         color: #64748b;
         font-size: 0.75rem;
         font-weight: 700;
         padding: 0 1rem;
    }
    .nav-item-mobile.active { color: #10b981; }
    .nav-item-mobile i { font-size: 1.25rem; }

    .tracking-wider { letter-spacing: 1px; }

    /* ANIMATIONS */
    .animate-entrance {
        animation: entrance 0.4s ease-out forwards;
        opacity: 0;
    }
    .stagger-1 { animation-delay: 0.1s; }
    .stagger-2 { animation-delay: 0.2s; }
    .stagger-3 { animation-delay: 0.3s; }

    @@keyframes entrance {
        from { opacity: 0; transform: translateY(20px); }
        to { opacity: 1; transform: translateY(0); }
    }
</style>

@code {
    private int _unpaidCount = 0;

    protected override async Task OnInitializedAsync()
    {
        var orders = await LiquorService.GetAllOrdersAsync();
        _unpaidCount = orders.Count(o => !o.IsPaid && o.Status == "Received");
    }
}
