@page "/mobile/liquor/history"
@using Microsoft.AspNetCore.Authorization
@using GFC.Core.Interfaces
@using GFC.Core.Models
@inject NavigationManager Navigation
@inject ILiquorService LiquorService
@attribute [Authorize]

<PageTitle>Order History | Mobile</PageTitle>

<div class="mobile-history-container">
    <!-- HEADER -->
    <header class="fixed-header bg-white shadow-sm px-4 py-3">
        <div class="d-flex align-items-center gap-3">
            <button class="btn btn-icon-round bg-light border-0" @onclick='() => Navigation.NavigateTo("/mobile/liquor/hub")'>
                <i class="bi bi-chevron-left"></i>
            </button>
            <h5 class="mb-0 fw-black text-uppercase">ORDER HISTORY</h5>
        </div>
    </header>

    <!-- CONTENT -->
    <main class="hub-scroll-area p-4" style="margin-top: 80px; padding-bottom: 120px;">
        @if (_orders == null)
        {
            <div class="p-5 text-center"><div class="spinner-border text-amber"></div></div>
        }
        else if (!_orders.Any())
        {
            <div class="empty-state p-5 text-center">
                <i class="bi bi-journal-text display-4 text-muted opacity-25"></i>
                <h6 class="mt-3 fw-bold text-muted">No completed orders</h6>
            </div>
        }
        else
        {
            <div class="row g-3">
                @foreach (var order in _orders)
                {
                    <div class="col-12 col-md-6">
                        <div class="history-card animate-entrance shadow-sm p-4 rounded-4 border-0">
                            <div class="d-flex justify-content-between mb-2">
                                <span class="badge @(order.IsPaid ? "bg-success-subtle text-success" : "bg-warning-subtle text-warning") fw-bold">
                                    @(order.IsPaid ? "COMPLETED & PAID" : "PENDING PAYMENT")
                                </span>
                                <span class="extra-small fw-bold text-muted">@order.OrderDate.ToString("MM/dd/yy")</span>
                            </div>
                            <h5 class="fw-black mb-1">@order.Vendor?.Name</h5>
                            <div class="extra-small text-muted mb-3">Invoice #@(order.InvoiceNumber ?? "N/A")</div>
                            
                            <div class="d-flex justify-content-between align-items-center border-top pt-3 mt-1">
                                <div>
                                    <div class="extra-small text-muted fw-bold text-uppercase">Total Cost</div>
                                    <div class="h5 fw-black text-dark mb-0">@order.TotalCost.ToString("C")</div>
                                </div>
                                <div class="text-end">
                                    <div class="extra-small text-muted fw-bold text-uppercase">Paid Date</div>
                                    <div class="small fw-bold text-success mb-0">@(order.PaidDate?.ToString("MM/dd/yy") ?? "--")</div>
                                </div>
                            </div>
                            
                            @if (order.PaidByUser != null)
                            {
                                <div class="mt-2 extra-small text-muted text-center italic-font">
                                    <i class="bi bi-person-check-fill me-1"></i> Paid by @order.PaidByUser.Username
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    </main>
</div>

<style>
    .mobile-history-container {
        position: fixed;
        top: 0; left: 0; right: 0; bottom: 0;
        background: #fdfdfd;
        overflow-y: auto;
    }

    .fixed-header {
        position: fixed;
        top: 0; left: 0; right: 0;
        height: 80px;
        z-index: 1000;
        border-bottom: 1px solid rgba(0,0,0,0.05);
    }

    .history-card {
        background: white;
        border: 1px solid rgba(0,0,0,0.05);
    }

    .btn-icon-round {
        width: 45px; height: 45px;
        border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
    }

    .italic-font { font-style: italic; }

    .animate-entrance {
        animation: entrance 0.4s ease-out forwards;
        opacity: 0;
    }
    @@keyframes entrance {
        from { opacity: 0; transform: translateY(20px); }
        to { opacity: 1; transform: translateY(0); }
    }
</style>

@code {
    private List<LiquorOrder>? _orders;

    protected override async Task OnInitializedAsync()
    {
        var all = await LiquorService.GetAllOrdersAsync();
        _orders = all.OrderByDescending(o => o.OrderDate).ToList();
    }
}
