@code {
    [Parameter]
    public bool InHub { get; set; } = false;

    private List<LiquorItem> _items = new();
    private List<LiquorVendor> _vendors = new();
    private string _searchTerm = "";
    private string _categoryFilter = "ALL";
    private int _selectedVendorFilter = 0;
    private bool _showWatchlistOnly = false;

    // Modals
    private bool _showQuoteModal = false;
    private LiquorVendorQuote _activeQuote = new();
    private LiquorItem? _quoteTargetItem;

    private bool _showWatchlistModal = false;
    private LiquorItem _newWatchlistItem = new();

    private bool _showHistoryModal = false;
    private LiquorItem? _selectedItemForHistory;
    private List<LiquorPriceHistory> _historyLogs = new();

    private bool _showManageQuotesModal = false;
    private LiquorItem? _selectedItemForQuotes;
    private bool _isLoading = true;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        try
        {
            _isLoading = true;
            _errorMessage = null;

            var itemsTask = LiquorService.GetWholesaleItemsAsync(includeWatchlist: true);
            var vendorsTask = LiquorService.GetAllVendorsAsync();
            await Task.WhenAll(itemsTask, vendorsTask);

            _items = (await itemsTask).ToList();
            _vendors = (await vendorsTask).OrderBy(v => v.Name).ToList();
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private List<LiquorItem> FilteredItems
    {
        get
        {
            var query = _items.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(_searchTerm))
            {
                var term = _searchTerm.Trim().ToLowerInvariant();
                query = query.Where(i => 
                    i.Name.ToLowerInvariant().Contains(term) ||
                    (i.Category?.ToLowerInvariant().Contains(term) ?? false) ||
                    (i.BottleSize?.ToLowerInvariant().Contains(term) ?? false) ||
                    (i.UpcCode?.ToLowerInvariant().Contains(term) ?? false)
                );
            }

            if (_categoryFilter == "LIQUOR")
            {
                query = query.Where(i => !i.IsBeer && !i.OrderByCaseOnly);
            }
            else if (_categoryFilter == "BEER")
            {
                query = query.Where(i => i.IsBeer || i.OrderByCaseOnly);
            }
            else if (_categoryFilter == "PROMOS")
            {
                query = query.Where(i => i.Quotes.Any(q => q.IsDealActive));
            }

            if (_selectedVendorFilter > 0)
            {
                query = query.Where(i => i.Quotes.Any(q => q.VendorId == _selectedVendorFilter));
            }

            if (_showWatchlistOnly)
            {
                query = query.Where(i => i.IsWatchlistOnly);
            }

            return query.ToList();
        }
    }

    private int TotalActiveDeals => _items.Sum(i => i.Quotes.Count(q => q.IsDealActive));

    private int ItemsWithCheaperOptions
    {
        get
        {
            int count = 0;
            foreach (var item in _items)
            {
                var quotes = item.Quotes.ToList();
                var preferred = quotes.FirstOrDefault(q => q.IsPreferredVendor) ?? quotes.FirstOrDefault();
                if (preferred != null)
                {
                    bool hasCheaperBottle = !item.OrderByCaseOnly && quotes.Any(q => q.Id != preferred.Id && q.EffectiveBottlePrice > 0 && q.EffectiveBottlePrice < preferred.EffectiveBottlePrice);
                    bool hasCheaperCase = quotes.Any(q => q.Id != preferred.Id && q.EffectiveCasePrice > 0 && q.EffectiveCasePrice < preferred.EffectiveCasePrice);
                    if (hasCheaperBottle || hasCheaperCase)
                    {
                        count++;
                    }
                }
            }
            return count;
        }
    }

    private LiquorVendorQuote? GetBestQuote(LiquorItem item, List<LiquorVendorQuote> quotes)
    {
        if (quotes.Count == 0) return null;
        if (!item.OrderByCaseOnly)
        {
            return quotes
                .OrderBy(q => q.EffectiveBottlePrice > 0 ? q.EffectiveBottlePrice : decimal.MaxValue)
                .ThenBy(q => q.EffectiveCasePrice > 0 ? q.EffectiveCasePrice : decimal.MaxValue)
                .FirstOrDefault();
        }

        return quotes
            .OrderBy(q => q.EffectiveCasePrice > 0 ? q.EffectiveCasePrice : decimal.MaxValue)
            .ThenBy(q => q.EffectiveBottlePrice > 0 ? q.EffectiveBottlePrice : decimal.MaxValue)
            .FirstOrDefault();
    }

    private void OpenAddQuoteModal()
    {
        _quoteTargetItem = null;
        _activeQuote = new LiquorVendorQuote
        {
            PackSize = 1,
            IsCaseOnly = false
        };
        _showQuoteModal = true;
    }

    private void OpenAddQuoteForItem(LiquorItem item)
    {
        _quoteTargetItem = item;
        _activeQuote = new LiquorVendorQuote
        {
            Id = 0,
            LiquorItemId = item.Id,
            VendorId = 0,
            PackSize = item.PackSize > 0 ? item.PackSize : 1,
            IsCaseOnly = item.OrderByCaseOnly,
            IsPreferredVendor = false
        };
        _showQuoteModal = true;
    }

    private void OnVendorSelectionChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var selectedVendorId) && _quoteTargetItem != null)
        {
            _activeQuote.VendorId = selectedVendorId;
            var existingForVendor = _quoteTargetItem.Quotes.FirstOrDefault(q => q.VendorId == selectedVendorId);
            if (existingForVendor != null)
            {
                _activeQuote.Id = existingForVendor.Id;
                _activeQuote.BottlePrice = existingForVendor.BottlePrice;
                _activeQuote.CasePrice = existingForVendor.CasePrice;
                _activeQuote.IsCaseOnly = existingForVendor.IsCaseOnly;
                _activeQuote.PackSize = existingForVendor.PackSize;
                _activeQuote.IsPreferredVendor = existingForVendor.IsPreferredVendor;
                _activeQuote.HasDeal = existingForVendor.HasDeal;
                _activeQuote.DealType = existingForVendor.DealType;
                _activeQuote.DealDescription = existingForVendor.DealDescription;
                _activeQuote.DealMinQty = existingForVendor.DealMinQty;
                _activeQuote.DealFreeQty = existingForVendor.DealFreeQty;
                _activeQuote.DealPrice = existingForVendor.DealPrice;
                _activeQuote.DealStartDate = existingForVendor.DealStartDate;
                _activeQuote.DealEndDate = existingForVendor.DealEndDate;
            }
            else
            {
                _activeQuote.Id = 0;
            }
        }
    }

    private void EditSpecificQuote(LiquorVendorQuote quote)
    {
        _quoteTargetItem = _items.FirstOrDefault(i => i.Id == quote.LiquorItemId);
        _activeQuote = quote;
        _showManageQuotesModal = false;
        _showQuoteModal = true;
    }

    private async Task SaveCurrentQuote()
    {
        if (_activeQuote.LiquorItemId == 0 && _quoteTargetItem != null)
        {
            _activeQuote.LiquorItemId = _quoteTargetItem.Id;
        }

        if (_activeQuote.LiquorItemId == 0 || _activeQuote.VendorId == 0)
        {
            return;
        }

        await LiquorService.SaveQuoteAsync(_activeQuote);
        _showQuoteModal = false;
        await LoadDataAsync();
    }

    private async Task DeleteCurrentQuote()
    {
        if (_activeQuote.Id > 0)
        {
            await LiquorService.DeleteQuoteAsync(_activeQuote.Id);
            _showQuoteModal = false;
            await LoadDataAsync();
        }
    }

    private async Task PromptSwitchActiveVendor(LiquorVendorQuote quote)
    {
        await LiquorService.SetPreferredVendorQuoteAsync(quote.Id, syncWithItemVendor: false);
        await LoadDataAsync();
    }

    private async Task SetActiveQuote(LiquorVendorQuote quote)
    {
        await LiquorService.SetPreferredVendorQuoteAsync(quote.Id, syncWithItemVendor: false);
        await LoadDataAsync();
        _showManageQuotesModal = false;
    }

    private void OpenAddWatchlistModal()
    {
        _newWatchlistItem = new LiquorItem
        {
            PackSize = 1,
            OrderByCaseOnly = false
        };
        _showWatchlistModal = true;
    }

    private async Task SaveWatchlistItem()
    {
        if (string.IsNullOrWhiteSpace(_newWatchlistItem.Name)) return;

        await LiquorService.CreateWatchlistItemAsync(_newWatchlistItem);
        _showWatchlistModal = false;
        await LoadDataAsync();
    }

    private async Task PromoteWatchlistItem(LiquorItem item)
    {
        await LiquorService.PromoteWatchlistItemAsync(item.Id);
        await LoadDataAsync();
    }

    private async Task ViewPriceHistory(LiquorItem item)
    {
        _selectedItemForHistory = item;
        _historyLogs = (await LiquorService.GetPriceHistoryAsync(itemId: item.Id)).ToList();
        _showHistoryModal = true;
    }

    private void ViewItemQuotes(LiquorItem item)
    {
        _selectedItemForQuotes = item;
        _showManageQuotesModal = true;
    }

    private async Task PrintReport()
    {
        await JSRuntime.InvokeVoidAsync("window.print");
    }

    // Packaging Specs Quick Edit
    private bool _showPackagingModal = false;
    private LiquorItem? _targetPackagingItem;
    private int _editPackagingPackSize = 1;
    private bool _editPackagingCaseOnly = false;

    private void OpenEditPackagingModal(LiquorItem item)
    {
        _targetPackagingItem = item;
        _editPackagingPackSize = item.PackSize > 0 ? item.PackSize : 1;
        _editPackagingCaseOnly = item.OrderByCaseOnly;
        _showPackagingModal = true;
    }

    private async Task SavePackagingSpecsAsync()
    {
        if (_targetPackagingItem == null) return;

        await LiquorService.UpdateItemPackagingAsync(_targetPackagingItem.Id, _editPackagingPackSize, _editPackagingCaseOnly);
        _showPackagingModal = false;
        await LoadDataAsync();
    }
}
