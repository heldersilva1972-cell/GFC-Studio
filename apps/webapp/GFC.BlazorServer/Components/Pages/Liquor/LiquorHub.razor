                                                 SMTP ENGINE
                                             </button>
                                             <button class="btn btn-sm rounded-pill flex-grow-1 @(_settings.EmailProvider == GFC.Core.Enums.EmailProvider.Resend ? "btn-primary shadow-sm fw-black" : "btn-link text-muted text-decoration-none fw-bold")" 
