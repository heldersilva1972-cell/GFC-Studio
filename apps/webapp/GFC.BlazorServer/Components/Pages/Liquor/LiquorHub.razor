            // Re-fetch vendor to be sure we have the latest
            var vendor = _vendors.FirstOrDefault(v => v.Id == order.VendorId);
            if (vendor == null) return;

            await LiquorService.ResendOrderEmailAsync(order.Id);
            TriggerSuccess("EMAIL RESENT", $"The order form has been resent to {vendor.Email}");
            await RefreshDataAsync();
