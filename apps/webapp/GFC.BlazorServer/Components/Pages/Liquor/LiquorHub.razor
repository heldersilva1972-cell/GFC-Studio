                                                    <th class="text-center">Bottle / Case Cost</th>
                                                    <th class="text-center">Drink Price</th>
                                                    <th class="text-center" style="width: 10%;">Yield Rule</th>
                                                    <th class="text-end pe-4" style="width: 8%;">Actions</th>
                                                </tr>
                                            </thead>
                                            <tbody>
