                                PAID INVOICES
                            </button>
                            <button class="btn btn-sm rounded-pill px-4 @(_historySubTab == "purchases" ? "btn-primary shadow-sm fw-black" : "btn-link text-muted text-decoration-none fw-bold")" 
                                    @onclick='() => _historySubTab = "purchases"'>
                                PURCHASE HISTORY
                            </button>
                            <button class="btn btn-sm rounded-pill px-4 @(_historySubTab == "activity" ? "btn-primary shadow-sm fw-black" : "btn-link text-muted text-decoration-none fw-bold")" 
                                    @onclick='() => _historySubTab = "activity"'>
                                ACTIVITY & PRICE LOG
                            </button>
                        </div>
                    </div>

                    @if (_historySubTab == "orders")
                    {
                        <div class="d-flex flex-wrap gap-2 mb-0 p-3 bg-light rounded-4 border">
                            <select class="form-select w-auto fw-bold" @bind="_historyYearFilter">
                                <option value="0">All Years</option>
                                @foreach (var year in _historyOrders.Select(o => o.OrderDate.Year).Distinct().OrderByDescending(y => y))
                                {
                                    <option value="@year">@year</option>
                                }
