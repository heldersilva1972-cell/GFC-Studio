                                                 <div class="row g-2 mb-3">
                                                     <div class="col-6"><input type="text" class="form-control form-control-sm border-2 rounded-3 fw-bold" placeholder="User" @bind="_settings.SmtpUsername" @bind:event="oninput" @bind:after="FlagEmailDirty" /></div>
                                                     <div class="col-6"><input type="password" class="form-control form-control-sm border-2 rounded-3 fw-bold" placeholder="Pass" @bind="_settings.SmtpPassword" @bind:event="oninput" @bind:after="FlagEmailDirty" /></div>
