    private double GetOuncesFromSize(string? size)
    {
        if (string.IsNullOrEmpty(size)) return 0;
        var s = size.ToLower().Replace(" ", "");
        if (s.Contains("750ml")) return 25.36;
        if (s == "1l" || s.Contains("1000ml")) return 33.81;
        if (s.Contains("1.75l")) return 59.17;
        if (s.Contains("375ml")) return 12.68;
        if (s.Contains("50ml")) return 1.69;
        if (s.Contains("355ml")) return 12.0;
        if (s.Contains("187ml")) return 6.32;
        if (s.Contains("12oz")) return 12.0;
        if (s.Contains("16oz")) return 16.0;
        if (s.Contains("10oz")) return 10.0;
        return 0;
    }

    private decimal GetProfitPerDrink(LiquorItem i) {
        if (i.RetailPrice <= 0) return 0;
        if (i.IsUnitBased) {
            var unitCost = i.PackSize > 0 ? i.CurrentPrice / i.PackSize : 0;
            return i.RetailPrice - unitCost;
        } else {
            var totalOz = GetOuncesFromSize(i.BottleSize);
            var costPerOz = totalOz > 0 ? i.CurrentPrice / (decimal)totalOz : 0;
            return i.RetailPrice - (costPerOz * i.PourSize);
        }
    }
