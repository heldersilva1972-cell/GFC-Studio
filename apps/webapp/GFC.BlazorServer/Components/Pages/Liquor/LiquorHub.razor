                                                                <span class="badge rounded-pill fw-black px-3 py-2 border" style="background: #e0f2fe; color: #0369a1; border-color: #bae6fd !important; font-size: 0.65rem; letter-spacing: 0.5px;">GLOBAL</span>
                                                            }
                                                        </td>
                                                        <td class="text-end pe-4">
                                                            <button class="btn btn-sm btn-icon text-danger border-0" @onclick="() => DeleteItemAsync(item.Id)">
                                                                <i class="bi bi-trash3"></i>
                                                            </button>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    } 
                    else if (_activeSetupTab == "vendors") 
                    {
                        <div class="d-flex justify-content-between align-items-center animate-slide-down mb-4">
