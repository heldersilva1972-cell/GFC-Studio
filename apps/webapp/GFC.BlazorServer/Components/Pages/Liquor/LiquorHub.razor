                                             </button>
                                         </div>

                                         @if (_settings.EmailProvider == GFC.Core.Enums.EmailProvider.Resend)
                                         {
                                             <div class="animate-fade-in">
                                                 <div class="mb-3">
                                                     <label class="extra-small fw-black text-muted text-uppercase mb-1">Resend API Key</label>
