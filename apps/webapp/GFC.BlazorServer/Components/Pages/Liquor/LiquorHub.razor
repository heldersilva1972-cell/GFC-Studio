                                                        <div class="mb-0">@stat.TotalQty <span class="extra-small text-muted">CASES</span></div>
                                                        <div class="extra-small text-primary opacity-75">(@(stat.TotalQty * stat.Item.PackSize) TOTAL UNITS)</div>
                                                    }
                                                    else
                                                    {
                                                        <span>@stat.TotalQty <span class="extra-small text-muted">BOTTLES</span></span>
                                                    }
                                                </td>
                                                <td class="text-end fw-black text-primary pe-3">@stat.TotalSpent.ToString("C")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    }
                </div>
            </div>
        } else if (_activeTab == "setup") {
