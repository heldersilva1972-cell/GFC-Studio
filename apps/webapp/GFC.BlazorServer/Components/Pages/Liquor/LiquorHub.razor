    private async Task CalculateMonthlyProfitabilityAsync()
    {
        _calculatingProfitability = true;
        StateHasChanged();

        try
        {
            using var db = await DbFactory.CreateDbContextAsync();

            // Define Month Start and End Date
            var start = new DateTime(_profitabilityYear, _profitabilityMonth, 1);
            var end = start.AddMonths(1); // Non-inclusive boundary
            var lastDay = start.AddMonths(1).AddTicks(-1); // Inclusive last moment of month

            // 0. Load available distinct terminals from database if not loaded yet
            if (!_availableTerminals.Any())
            {
                var terminals = await db.PosSales
                    .AsNoTracking()
                    .Select(s => s.TerminalName)
                    .Distinct()
                    .ToListAsync();
                _availableTerminals = terminals
                    .Where(t => !string.IsNullOrWhiteSpace(t) && !t.Contains("(TRAINING)"))
                    .OrderBy(t => t)
                    .ToList();
            }

            // 1. Load active POS categories if not loaded yet
            if (!_posCategories.Any())
            {
                var activeCategories = await db.PosCategories
                    .Where(c => c.IsActive && !c.IsModifierCategory)
                    .OrderBy(c => c.DisplayOrder)
                    .Select(c => c.Name)
                    .ToListAsync();
                
                _posCategories = activeCategories.Where(name => !string.IsNullOrWhiteSpace(name)).ToList();
                if (!_posCategories.Contains("UNCATEGORIZED"))
                {
                    _posCategories.Add("UNCATEGORIZED");
                }
                
                // Initialize default selections if we didn't load any from local storage
                if (!_hasLoadedPrefs)
                {
                    foreach (var catName in _posCategories)
                    {
                        var upperName = catName.ToUpper();
                        var dbCat = db.PosCategories.FirstOrDefault(c => c.Name == catName);
                        if ((dbCat != null && dbCat.InventoryTrackType == 1) ||
                            upperName.Contains("BEER") || 
                            upperName.Contains("LIQUOR") || 
                            upperName.Contains("WINE") || 
                            upperName.Contains("MIXED") ||
                            upperName.Contains("DRINK"))
                        {
                            _selectedPosCategories.Add(catName);
                        }
                    }
                }
            }

            // 2. Fetch POS Sales and aggregate category totals
            var salesQuery = db.PosSales
                .Where(s => s.Timestamp >= start && s.Timestamp < end && !s.IsVoided);

            if (_selectedTerminal != "ALL")
            {
                salesQuery = salesQuery.Where(s => s.TerminalName == _selectedTerminal);
            }

            var sales = await salesQuery.ToListAsync();

            // Initialize/reset category sales totals dictionary
            _posCategorySalesTotals = _posCategories.ToDictionary(cat => cat, cat => 0m);

            foreach (var sale in sales)
            {
                if (string.IsNullOrEmpty(sale.ItemsJson)) continue;
                
                try
                {
                    var items = System.Text.Json.JsonSerializer.Deserialize<List<GFC.BlazorServer.Components.Pages.Admin.Pos.PosTerminal.ProductItem>>(sale.ItemsJson);
                    if (items != null)
                    {
                        foreach (var item in items)
                        {
                            var cleanName = item.Name?.Trim() ?? "";
                            if (cleanName.Contains("DEPOSIT", StringComparison.OrdinalIgnoreCase) ||
                                cleanName.Contains("CORRECTION", StringComparison.OrdinalIgnoreCase) ||
                                cleanName.Contains("NO SALE", StringComparison.OrdinalIgnoreCase) ||
                                cleanName.Contains("CREDIT", StringComparison.OrdinalIgnoreCase) ||
                                cleanName.Contains("PAYOUT", StringComparison.OrdinalIgnoreCase) ||
                                cleanName.Contains("TOKEN", StringComparison.OrdinalIgnoreCase))
                            {
                                continue;
                            }

                            var catName = string.IsNullOrWhiteSpace(item.Category) ? "UNCATEGORIZED" : item.Category.ToUpper();
                            
                            var matchedCat = _posCategories.FirstOrDefault(c => c.Equals(catName, StringComparison.OrdinalIgnoreCase));
                            if (matchedCat != null)
                            {
                                _posCategorySalesTotals[matchedCat] += (item.Price * item.Quantity);
                            }
                            else
                            {
                                if (_posCategorySalesTotals.ContainsKey("UNCATEGORIZED"))
                                {
                                    _posCategorySalesTotals["UNCATEGORIZED"] += (item.Price * item.Quantity);
                                }
                            }
                        }
                    }
                }
                catch
                {
                    // Ignore JSON parsing errors on isolated transactions
                }
            }

            // Sum up sales for selected categories
            _profitSales = _posCategorySalesTotals
                .Where(kvp => _selectedPosCategories.Contains(kvp.Key))
                .Sum(kvp => kvp.Value);

            // 3. Fetch Total Vendor Purchases (Received liquor orders during this period)
            _profitPurchases = await db.LiquorOrders
                .Where(o => o.Status == "Received" && o.OrderDate >= start && o.OrderDate < end)
                .SumAsync(o => o.TotalCost);

            // 4. Calculate Beginning and Ending Inventory Value ONLY for items in the Liquor Pool
            var allItems = await db.LiquorItems.Where(i => i.IsActive && !i.ParentItemId.HasValue).ToListAsync();
            var categories = await db.PosCategories.ToListAsync();
            
            var liquorItems = allItems.Where(item => {
                if (item.InventoryTrackType == 1 || item.InventoryTrackType == 2) return true; // Force Liquor
                if (item.InventoryTrackType == 3) return false; // Force Food/General
                
                // Inherit Category Default
                var cat = categories.FirstOrDefault(c => c.Name.Equals(item.Category, StringComparison.OrdinalIgnoreCase));
                if (cat != null)
                {
                    return cat.InventoryTrackType == 1; // 1 represents Liquor destination
                }
                return true; // Default to true for items in Liquor Hub
            }).ToList();

            var liquorItemIds = liquorItems.Select(i => i.Id).ToHashSet();

            // Fetch all transactions that occurred AFTER the month's start/end dates
            // to roll back CurrentStock and find historical counts
            var startTransactions = await db.LiquorTransactions
                .Where(t => t.Timestamp >= start && liquorItemIds.Contains(t.ItemId))
                .ToListAsync();

            var endTransactions = startTransactions
                .Where(t => t.Timestamp >= end)
                .ToList();

            decimal begValue = 0;
            decimal endValue = 0;

            foreach (var item in liquorItems)
            {
                // Rollback to Month End: subtract any deltas that happened AFTER the month ended
                int endQtyChange = endTransactions.Where(t => t.ItemId == item.Id).Sum(t => t.ChangeAmount);
                int endQty = item.CurrentStock - endQtyChange;
                if (endQty < 0) endQty = 0;
                endValue += endQty * item.CurrentPrice;

                // Rollback to Month Start: subtract all deltas that happened AFTER the month started
                int startQtyChange = startTransactions.Where(t => t.ItemId == item.Id).Sum(t => t.ChangeAmount);
                int startQty = item.CurrentStock - startQtyChange;
                if (startQty < 0) startQty = 0;
                begValue += startQty * item.CurrentPrice;
            }

            _profitBegValue = begValue;
            _profitEndValue = endValue;

            // 5. Compute COGS, profit, and pour cost
            _profitCOGS = _profitBegValue + _profitPurchases - _profitEndValue;
            if (_profitCOGS < 0) _profitCOGS = 0; // Guard against negative cost anomalies

            _profitGrossProfit = _profitSales - _profitCOGS;
            _profitPourCost = _profitSales > 0 ? (_profitCOGS / _profitSales) * 100 : 0;
            _profitMargin = _profitSales > 0 ? (_profitGrossProfit / _profitSales) * 100 : 0;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error calculating profitability: {ex.Message}");
        }
        finally
        {
            _calculatingProfitability = false;
            StateHasChanged();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                // Load category filters
                var savedCategories = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "gfc_liquor_profit_selected_categories");
                if (!string.IsNullOrEmpty(savedCategories))
                {
                    var list = System.Text.Json.JsonSerializer.Deserialize<List<string>>(savedCategories);
                    if (list != null && list.Any())
                    {
                        _selectedPosCategories = new HashSet<string>(list);
                        _hasLoadedPrefs = true;
                    }
                }

                // Load terminal preference
                var savedTerminal = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "gfc_liquor_profit_selected_terminal");
                if (!string.IsNullOrEmpty(savedTerminal))
                {
                    _selectedTerminal = savedTerminal;
                }

                // Re-run profitability calculation to apply loaded preferences
                await CalculateMonthlyProfitabilityAsync();
            }
            catch
            {
                // LocalStorage might not be available during prerendering or if sandbox throws
            }
        }
    }

