                                <h5 class="fw-black text-uppercase mb-1">Email Logic & Automation</h5>
                                <p class="small text-muted mb-0">Configure the sender address and global signature for all vendor orders.</p>
                            </div>
                            <button class="btn btn-primary rounded-pill px-4 fw-black shadow-sm" @onclick="() => SaveEmailSettingsAsync()" disabled="@_isSaving">
                                @if (_isSaving) { <span class="spinner-border spinner-border-sm me-1"></span> <span>SAVING...</span> }
                                else { <i class="bi bi-check-lg me-1"></i> <span>SAVE EMAIL LOGIC</span> }
                            </button>
                        </div>
                        <div class="row g-5">
                             <div class="col-lg-5">
                                 <div class="card bg-light border-0 rounded-5 p-4 h-100">
