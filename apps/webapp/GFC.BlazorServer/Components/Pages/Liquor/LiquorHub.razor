                            <button class="btn btn-white border ms-auto px-4 fw-bold" @onclick="() => { _historyYearFilter = 0; _historyVendorFilter = 0; _historyProductSearch = string.Empty; }"><i class="bi bi-eraser-fill"></i> Clear</button>
                        </div>
                    }
                    else if (_historySubTab == "purchases")
                    {
                        var purchaseCounts = _historyOrders.Where(o => o.IsPaid)
                            .SelectMany(o => o.OrderItems)
                            .GroupBy(i => i.LiquorItemId)
                            .ToDictionary(g => g.Key, g => g.Sum(i => i.Quantity));
                        
