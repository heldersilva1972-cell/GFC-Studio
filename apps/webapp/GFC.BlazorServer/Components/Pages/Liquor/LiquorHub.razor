                                                     </div>
                                                     <div class="col-4">
                                                         <input type="number" class="form-control form-control-sm border-2 rounded-3 fw-bold" placeholder="Port" @bind="_settings.SmtpPort" @bind:event="oninput" @bind:after="FlagEmailDirty" />
