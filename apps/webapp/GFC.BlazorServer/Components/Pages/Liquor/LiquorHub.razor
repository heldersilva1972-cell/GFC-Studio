@page "/liquor/hub"
@using GFC.Core.Interfaces
@using GFC.Core.Models
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components
@using GFC.BlazorServer.Auth
@attribute [Authorize]
@inject ILiquorService LiquorService
@inject IJSRuntime JSRuntime
@inject NavigationManager NavMgr
@inject CustomAuthenticationStateProvider AuthStateProvider
@inject IBlazorSystemSettingsService SystemSettingsService

<PageTitle>Liquor Hub | GFC</PageTitle>

<!-- ADD ITEM MODAL -->
@if (_showAddItemModal)
{
    <div class="modal-backdrop-modern animate-fade-in shadow-lg">
        <div class="modal-card animate-slide-up shadow-lg" style="max-width: 500px; border: none;">
            <div class="modal-header bg-white py-4 d-flex justify-content-between align-items-center px-4 border-bottom border-2">
                <div class="d-flex align-items-center">
                    <div class="bg-primary-subtle p-2 rounded-3 me-3">
                         <i class="bi bi-plus-circle-fill text-primary fs-4"></i>
                    </div>
                    <h4 class="mb-0 fw-black text-uppercase tracking-wider text-primary">ADD NEW PRODUCT</h4>
                </div>
                <button class="btn btn-sm btn-outline-secondary rounded-pill px-3 fw-black" @onclick="() => _showAddItemModal = false">CLOSE</button>
            </div>
            <div class="modal-body p-4 bg-light-subtle">
                <div class="row g-3">
                    <div class="col-12">
                        <label class="small fw-bold text-muted mb-1">Product Name</label>
                        <input type="text" class="form-control rounded-pill border-2" @bind="_newItem.Name" placeholder="e.g. Grey Goose" />
                    </div>
                    <div class="col-6">
                        <label class="small fw-bold text-muted mb-1">Bottle/Can Size</label>
                        <select class="form-select rounded-pill border-2" @bind="_newItem.BottleSize">
                            <option value="">-- Choose Size --</option>
                            <option value="50ml">50ml</option>
                            <option value="187ml">187ml</option>
                            <option value="355ml">355ml</option>
                            <option value="375ml">375ml</option>
                            <option value="750ml">750ml</option>
                            <option value="1L">1L</option>
                            <option value="1.75L">1.75L</option>
                            <option value="12oz">12oz (Can/Bottle)</option>
                            <option value="16oz">16oz (Pint)</option>
                        </select>
                    </div>
                    <div class="col-6">
                        <label class="small fw-bold text-muted mb-1">Pack Size</label>
                        <input type="number" class="form-control rounded-pill border-2" onfocus="this.select();" @bind="_newItem.PackSize" />
                    </div>

                    <div class="col-12">
                         <div class="form-check form-switch bg-light p-3 rounded-pill border ms-0">
                            <input class="form-check-input ms-0 me-2" type="checkbox" id="isUnitBasedNew" @bind="_newItem.IsUnitBased">
                            <label class="form-check-label fw-bold text-dark small" for="isUnitBasedNew">
                                Sold by Unit (e.g., Red Bull, High Noon, Beer)
                            </label>
                        </div>
                    </div>

                    @if (_newItem.IsUnitBased)
                    {
                        <div class="col-12">
                             <div class="alert alert-info rounded-4 border-0 d-flex align-items-center gap-3 py-3 mb-2 animate-fade-in shadow-sm">
                                 <div class="bg-white p-2 rounded-3 text-info shadow-sm">
                                     <i class="bi bi-box-seam-fill fs-5"></i>
                                 </div>
                                 <div>
                                     <div class="fw-black text-uppercase text-info mb-1" style="font-size: 0.65rem;">Pack Size Required</div>
                                     <p class="mb-0 text-muted fw-bold" style="font-size: 0.6rem; line-height: 1.2;">Please specify how many individual units come in a case (e.g. 24 for beer cases) in the Pack Size field above.</p>
                                 </div>
                             </div>
                        </div>
                    }

                    <div class="col-12">
                        <label class="small fw-bold text-muted mb-1">Primary Vendor</label>
                        <select class="form-select rounded-pill border-2" @bind="_newItem.VendorId">
                            <option value="">-- No Vendor --</option>
                            @foreach (var v in _vendors) { <option value="@v.Id">@v.Name</option> }
                        </select>
                    </div>

                    <div class="col-6">
                        <label class="small fw-bold text-muted mb-1">Min Stock Limit</label>
                        <input type="number" class="form-control rounded-pill border-2" onfocus="this.select();" @bind="_newItem.MinStockLimit" />
                    </div>
                    <div class="col-6">
                        <label class="small fw-bold text-muted mb-1">Bottle/Case Cost ($)</label>
                        <input type="number" class="form-control rounded-pill border-2" onfocus="this.select();" @bind="_newItem.CurrentPrice" step="0.01" />
                    </div>

                    <div class="col-6">
                        <label class="small fw-bold text-muted mb-1">Min Order Qty</label>
                        <input type="number" class="form-control rounded-pill border-2" onfocus="this.select();" @bind="_newItem.MinimumOrderQuantity" />
                    </div>
                    <div class="col-6">
                        <label class="small fw-bold text-muted mb-1">Drink Price ($)</label>
                        <input type="number" class="form-control rounded-pill border-2" onfocus="this.select();" @bind="_newItem.RetailPrice" step="0.01" />
                    </div>

                    <div class="col-6">
                        <label class="small fw-bold text-muted mb-1">Shot oz</label>
                        <input type="number" class="form-control rounded-pill border-2" onfocus="this.select();" @bind="_newItem.PourSize" step="0.1" disabled="@_newItem.IsUnitBased" />
                    </div>

                    <div class="col-12 mt-2">
                        <div class="bg-light p-3 rounded-4 border">
                            <div class="form-check form-switch p-0 d-flex align-items-center justify-content-between mb-2">
                                <div>
                                    <h6 class="fw-black text-uppercase mb-0" style="font-size: 0.75rem;">Product is Active</h6>
                                    <p class="extra-small text-muted mb-0" style="font-size: 0.65rem;">Uncheck to hide from inventory lists</p>
                                </div>
                                <input class="form-check-input ms-0" type="checkbox" style="width: 40px; height: 20px;" @bind="_newItem.IsActive" id="itemActiveCheckNew">
                            </div>

                            <div class="form-check form-switch p-0 d-flex align-items-center justify-content-between">
                                <div>
                                    <h6 class="fw-black text-uppercase mb-0 text-primary" style="font-size: 0.75rem;">Product is Beer</h6>
                                    <p class="extra-small text-muted mb-0" style="font-size: 0.65rem;">Adds bottle return fee on orders</p>
                                </div>
                                <input class="form-check-input ms-0" type="checkbox" style="width: 40px; height: 20px;" @bind="_newItem.IsBeer" id="itemBeerCheckNew">
                            </div>
                        </div>
                    </div>
                </div>
                <button class="btn btn-primary w-100 rounded-pill fw-black py-3 mt-4 shadow" @onclick="CreateItemAsync">CREATE PRODUCT RECORD</button>
            </div>
        </div>
    </div>
}

<!-- EDIT ITEM MODAL -->
@if (_itemToEdit != null)
{
    <div class="modal-backdrop-modern animate-fade-in shadow-lg">
        <div class="modal-card animate-slide-up shadow-lg" style="max-width: 600px; border: none;">
            <div class="modal-header bg-white py-4 d-flex justify-content-between align-items-center px-4 border-bottom border-2">
                <div class="d-flex align-items-center">
                    <div class="bg-info-subtle p-2 rounded-3 me-3">
                         <i class="bi bi-pencil-square text-info fs-4"></i>
                    </div>
                    <h3 class="mb-0 fw-black text-uppercase tracking-wider text-info">EDIT PRODUCT</h3>
                </div>
                <button class="btn btn-sm btn-outline-secondary rounded-pill px-3 fw-black" @onclick="() => _itemToEdit = null">CLOSE</button>
            </div>
            <div class="modal-body p-4 bg-light-subtle">
                 <div class="mb-3">
                    <label class="small fw-bold text-muted mb-1">Product Name</label>
                    <input type="text" class="form-control rounded-pill border-2" @bind="_itemToEdit.Name" />
                </div>
                <div class="row g-2 mb-3">
                    <div class="col-6">
                        <label class="small fw-bold text-muted mb-1">Bottle/Can Size</label>
                        <select class="form-select rounded-pill border-2" @bind="_itemToEdit.BottleSize">
                            <option value="">-- Choose Size --</option>
                            <option value="50ml">50ml</option>
                            <option value="187ml">187ml</option>
                            <option value="355ml">355ml</option>
                            <option value="375ml">375ml</option>
                            <option value="750ml">750ml</option>
                            <option value="1L">1L</option>
                            <option value="1.75L">1.75L</option>
                            <option value="12oz">12oz (Can/Bottle)</option>
                            <option value="16oz">16oz (Pint)</option>
                        </select>
                    </div>
                    <div class="col-6">
                        <label class="small fw-bold text-muted mb-1">Min Stock Limit</label>
                        <input type="number" class="form-control rounded-pill border-2" onfocus="this.select();" @bind="_itemToEdit.MinStockLimit" />
                    </div>
                    <div class="col-6">
                        <label class="small fw-bold text-muted mb-1">Bottle/Case Cost ($)</label>
                        <input type="number" class="form-control rounded-pill border-2" onfocus="this.select();" @bind="_itemToEdit.CurrentPrice" step="0.01" />
                    </div>
                </div>
                 <div class="row g-2 mb-3">
                    <div class="col-6">
                        <label class="small fw-bold text-muted mb-1">Min Order Qty</label>
                        <input type="number" class="form-control rounded-pill border-2 text-center" step="1" onfocus="this.select();"
                               value="@((int)_itemToEdit.MinimumOrderQuantity)" 
                               @oninput="e => { if(int.TryParse(e.Value?.ToString(), out var res)) _itemToEdit.MinimumOrderQuantity = res; }" />
                    </div>
                    <div class="col-6">
                        <label class="small fw-bold text-muted mb-1">Pack Size (e.g. 24)</label>
                        <input type="number" class="form-control rounded-pill border-2" onfocus="this.select();" @bind="_itemToEdit.PackSize" />
                    </div>
                </div>
                 <div class="mb-3">
                    <div class="form-check form-switch bg-light p-3 rounded-pill border">
                        <input class="form-check-input ms-0 me-2" type="checkbox" id="edit-isUnitBased" @bind="_itemToEdit.IsUnitBased">
                        <label class="form-check-label fw-bold text-dark small" for="edit-isUnitBased">
                            Item is sold by individual UNIT instead of OUNCES
                        </label>
                    </div>
                </div>

                @if (_itemToEdit.IsUnitBased)
                {
                    <div class="mb-3">
                         <div class="alert alert-info rounded-4 border-0 d-flex align-items-center gap-3 py-3 mb-0 animate-fade-in shadow-sm">
                             <div class="bg-white p-2 rounded-3 text-info shadow-sm">
                                 <i class="bi bi-box-seam-fill fs-5"></i>
                             </div>
                             <div>
                                 <div class="fw-black text-uppercase text-info mb-1" style="font-size: 0.65rem;">Pack Size Configuration</div>
                                 <p class="mb-0 text-muted fw-bold" style="font-size: 0.6rem; line-height: 1.2;">This item is currently tracked as individual units. Ensure the Pack Size (e.g. 24) is correctly set for accurate stock calculations.</p>
                             </div>
                         </div>
                    </div>
                }
                 <div class="row g-2 mb-3">
                    <div class="col-6">
                        <label class="small fw-bold text-muted mb-1">Drink Price (Sale)</label>
                        <input type="number" class="form-control rounded-pill border-2" onfocus="this.select();" @bind="_itemToEdit.RetailPrice" step="0.01" />
                    </div>
                    @if (!_itemToEdit.IsUnitBased)
                    {
                        <div class="col-6">
                            <label class="small fw-bold text-muted mb-1">Shot Size (oz)</label>
                            <input type="number" class="form-control rounded-pill border-2" onfocus="this.select();" @bind="_itemToEdit.PourSize" step="0.1" />
                        </div>
                    }
                </div>
                 <div class="mb-4">
                    <label class="small fw-bold text-muted mb-1">Primary Vendor</label>
                    <select class="form-select rounded-pill border-2" @bind="_itemToEdit.VendorId">
                        <option value="">-- No Vendor --</option>
                        @foreach (var v in _vendors)
                        {
                            <option value="@v.Id">@v.Name</option>
                        }
                    </select>
                </div>
                 <div class="mt-4">
                    <div class="bg-light p-3 rounded-4 border">
                        <div class="form-check form-switch p-0 d-flex align-items-center justify-content-between mb-2">
                            <div>
                                <h6 class="fw-black text-uppercase mb-0" style="font-size: 0.75rem;">Product is Active</h6>
                                <p class="extra-small text-muted mb-0" style="font-size: 0.65rem;">Uncheck to hide from inventory lists</p>
                            </div>
                            <input class="form-check-input ms-0" type="checkbox" style="width: 40px; height: 20px;" @bind="_itemToEdit.IsActive" id="itemActiveCheck">
                        </div>

                        <div class="form-check form-switch p-0 d-flex align-items-center justify-content-between">
                            <div>
                                <h6 class="fw-black text-uppercase mb-0 text-primary" style="font-size: 0.75rem;">Product is Beer</h6>
                                <p class="extra-small text-muted mb-0" style="font-size: 0.65rem;">Adds bottle return fee on orders</p>
                            </div>
                            <input class="form-check-input ms-0" type="checkbox" style="width: 40px; height: 20px;" @bind="_itemToEdit.IsBeer" id="itemBeerCheck">
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer d-flex gap-2 p-4">
                <button class="btn btn-light rounded-pill flex-grow-1 fw-bold" @onclick="() => _itemToEdit = null">CANCEL</button>
                <button class="btn btn-primary rounded-pill flex-grow-1 fw-black" @onclick="SaveEditAsync">SAVE CHANGES</button>
            </div>
        </div>
    </div>
}

<div class="liquor-hub-container">
    <!-- Price Log Modal (Desktop) -->
    @if (_showPriceHistoryModal)
    {
        <div class="modal d-block animate-fade-in" style="background: rgba(0,0,0,0.6); backdrop-filter: blur(8px); z-index: 9999;">
            <div class="modal-dialog modal-lg modal-dialog-centered">
                <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
                    <div class="modal-header bg-white text-dark p-4 border-bottom">
                        <div>
                            <h4 class="modal-title fw-black mb-0 text-dark"><i class="bi bi-clock-history me-2 text-primary"></i>Financial Audit Log</h4>
                            <p class="text-muted small mb-0 mt-1">Timeline of recent bottle cost and drink price adjustments.</p>
                        </div>
                        <button type="button" class="btn-close" @onclick="() => _showPriceHistoryModal = false"></button>
                    </div>
                    <div class="modal-body p-0" style="max-height: 70vh; overflow-y: auto; background: #ffffff;">
                        @if (!_auditHistory.Any(l => l.TransactionType == "Update"))
                        {
                            <div class="p-5 text-center text-muted">
                                <i class="bi bi-calendar-x display-4 opacity-25"></i>
                                <h5 class="mt-3">No price history found.</h5>
                                <p class="small">New price updates will be logged here automatically.</p>
                            </div>
                        }
                        else
                        {
                            <div class="p-4">
                                @foreach (var log in _auditHistory.Where(l => l.TransactionType == "Update").OrderByDescending(l => l.Timestamp))
                                {
                                    <div class="card border-0 shadow-sm rounded-4 mb-3 p-3 hover-lift transition-base border-start border-4 @(log.Notes?.Contains("Cost") == true ? "border-primary" : "border-info")">
                                        <div class="row align-items-center">
                                            <div class="col-md-5">
                                                <div class="d-flex align-items-center">
                                                     <div class="rounded-3 p-2 me-3" style="background: @(log.Notes?.Contains("Cost") == true ? "#eff6ff" : "#ecfeff");">
                                                        <i class="bi @(log.Notes?.Contains("Cost") == true ? "bi-cash-coin text-primary" : "bi-receipt text-info")" style="font-size: 1.5rem;"></i>
                                                    </div>
                                                    <div>
                                                        <div class="fw-black">@log.Item?.Name</div>
                                                        <div class="extra-small text-muted text-uppercase tracking-wider">@log.Item?.BottleSize</div>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-md-4">
                                                 <div class="rounded-3 p-2 px-3 small border border-1" style="background: @(log.Notes?.Contains("Cost") == true ? "#f8fafc" : "#f0f9ff");">
                                                    <span class="fw-bold d-block text-muted" style="font-size: 0.6rem;">MODIFICATION DETAILS</span>
                                                    <span class="text-dark fw-bold">@log.Notes</span>
                                                </div>
                                            </div>
                                            <div class="col-md-3 text-end">
                                                <div class="fw-black text-dark" style="font-size: 0.75rem;">@log.Timestamp.ToLocalTime().ToString("MMM dd, yyyy")</div>
                                                <div class="extra-small text-muted mt-1">
                                                    By <span class="fw-bold">@(log.User?.Username ?? "System")</span>
                                                    <span class="opacity-50 ms-1 px-2 py-0 bg-white rounded-pill border">ID: @log.UserId</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                    <div class="modal-footer bg-white p-3 border-top d-flex justify-content-between align-items-center">
                         <div class="small text-muted">
                            Connected as: <span class="fw-black text-dark">@(_currentUser?.Username ?? "Staff")</span> (ID: #@(_currentUser?.UserId.ToString() ?? "0"))
                        </div>
                         <button class="btn btn-primary px-5 rounded-pill fw-black shadow" @onclick="() => _showPriceHistoryModal = false">CLOSE LOG</button>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Success Confirmation Modal (Desktop) -->
    @if (_showSuccessModal)
    {
        <div class="modal d-block animate-fade-in" style="background: rgba(0,0,0,0.5); backdrop-filter: blur(8px); z-index: 10000;">
            <div class="modal-dialog modal-sm modal-dialog-centered">
                <div class="modal-content border-0 shadow-lg rounded-4 p-4 text-center bg-white">
                    <div class="mb-4 mt-2">
                        <i class="bi bi-check-circle-fill text-success display-2"></i>
                    </div>
                    <h3 class="fw-black text-dark mb-2 text-uppercase tracking-wider">@_successTitle</h3>
                    <p class="text-muted fw-bold mb-4">@_successMessage</p>
                    <button class="btn btn-success btn-lg w-100 rounded-pill fw-black shadow-sm" @onclick="CloseSuccess">
                        GOT IT
                    </button>
                </div>
            </div>
        </div>
    }

    <!-- Header -->
    <div class="hub-header d-flex justify-content-between align-items-end mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1">
                    <li class="breadcrumb-item"><a href="/" class="text-decoration-none text-muted">Dashboard</a></li>
                    <li class="breadcrumb-item active">Liquor</li>
                </ol>
            </nav>
            <h1 class="display-6 fw-black mb-1" style="color: #334155; letter-spacing: -0.03em;">Liquor Ordering & Inventory</h1>
            <div class="d-flex align-items-center gap-2 text-muted small">
                <i class="bi bi-cart-check text-success"></i>
                <span>Managed by @_currentUser?.Username</span>
                <span class="mx-1">•</span>
                <span>@_vendors.Count Vendors active</span>
            </div>
        </div>
        <div class="d-flex gap-2 mb-1">
             <button class="btn btn-sm px-3 py-2 rounded-pill bg-white border shadow-sm text-dark fw-bold" @onclick="RefreshDataAsync">
                <i class="bi bi-arrow-repeat me-2"></i>Refresh
            </button>
            <button class="btn btn-sm px-4 py-2 rounded-pill btn-primary text-white shadow-sm fw-bold ms-2 hover-lift transition-base" @onclick="() => _showPriceHistoryModal = true">
                <i class="bi bi-clock-history me-2"></i>PRICE LOG
            </button>
        </div>
    </div>

    <!-- Tabs -->
    <div class="nav-pills-modern mb-4">
        <button class="pill-item @(_activeTab == "ordering" ? "active" : "")" @onclick='() => _activeTab = "ordering"'>
            <i class="bi bi-cart-plus"></i> Ordering List
            @if (_items.Any(i => i.CurrentStock <= i.MinStockLimit))
            {
                <span class="pill-badge bg-danger pulse-animation">@_items.Count(i => i.CurrentStock <= i.MinStockLimit)</span>
            }
        </button>
        <button class="pill-item @(_activeTab == "active" ? "active" : "")" @onclick='() => _activeTab = "active"'>
            <i class="bi bi-truck"></i> Pending Arrival
            @if (_pendingOrders.Any())
            {
                <span class="pill-badge bg-primary">@_pendingOrders.Count</span>
            }
        </button>
        <button class="pill-item @(_activeTab == "unpaid" ? "active" : "")" @onclick='() => _activeTab = "unpaid"'>
            <i class="bi bi-cash-stack"></i> Unpaid Invoices
            @if (_historyOrders.Any(o => !o.IsPaid))
            {
                <span class="pill-badge bg-danger">@_historyOrders.Count(o => !o.IsPaid)</span>
            }
        </button>
        <button class="pill-item @(_activeTab == "history" ? "active" : "")" @onclick='() => _activeTab = "history"'>
            <i class="bi bi-file-earmark-spreadsheet"></i> Order History
        </button>
        <button class="pill-item @(_activeTab == "backorders" ? "active" : "")" @onclick='() => _activeTab = "backorders"'>
            <i class="bi bi-clock-history"></i> Backorders
            @if (_pendingBackorders.Any())
            {
                <span class="pill-badge bg-warning text-dark">@_pendingBackorders.Count</span>
            }
        </button>
        <button class="pill-item @(_activeTab == "count" ? "active" : "")" @onclick='() => _activeTab = "count"'>
            <i class="bi bi-clipboard-check"></i> Stock Check
        </button>
        <button class="pill-item @(_activeTab == "analytics" ? "active" : "")" @onclick='() => _activeTab = "analytics"'>
            <i class="bi bi-bar-chart-line"></i> Analytics & Stats
        </button>
        <button class="pill-item @(_activeTab == "setup" ? "active" : "")" @onclick='() => { _activeTab = "setup"; _activeSetupTab = "items"; }'>
            <i class="bi bi-gear"></i> Setup
        </button>
    </div>

    @if (_isLoading)
    {
        <div class="d-flex flex-column align-items-center justify-content-center py-5">
            <div class="spinner-border text-primary mb-3" role="status"></div>
            <div class="text-muted">Loading Liquor Data...</div>
        </div>
    }
    else
    {
        @if (_activeTab == "count")
        {
            <div class="count-view animate-fade-in p-3">
                <div class="row g-4">
                    <div class="col-lg-7">
                        <div class="card border-0 shadow-sm rounded-4 h-100 overflow-hidden bg-white">
                            <div class="card-header bg-white p-4 border-0 d-flex justify-content-between align-items-center">
                                <div>
                                    <h5 class="fw-black mb-0 text-uppercase tracking-wider">STOCK RECONCILE</h5>
                                    <div class="extra-small text-muted fw-bold">Tap a bottle to enter physical count</div>
                                </div>
                                <div class="search-box-pill border rounded-pill px-3 bg-light d-flex align-items-center">
                                    <i class="bi bi-search text-muted me-2"></i>
                                    <input type="text" class="border-0 bg-transparent py-2 px-1" placeholder="Search..." onfocus="this.select()" @bind="_searchTerm" @bind:event="oninput" style="outline:none; width: 140px;" />
                                </div>
                            </div>
                            <div class="card-body p-0 scroll-y-hub" style="max-height: 550px;">
                                <div class="px-4 py-2 bg-light border-bottom d-flex align-items-center gap-2">
                                     <button class="btn btn-xs rounded-pill px-3 fw-black @(!_filterBeerOnly ? "btn-dark" : "btn-outline-dark")" style="font-size: 0.6rem;" @onclick="() => _filterBeerOnly = false">ALL</button>
                                     <button class="btn btn-xs rounded-pill px-3 fw-black @(_filterBeerOnly ? "btn-amber" : "btn-outline-amber")" style="font-size: 0.6rem;" @onclick="() => _filterBeerOnly = true">BEER</button>
                                </div>
                                <div class="list-group list-group-flush">
                                    @foreach (var item in _items.Where(i => (string.IsNullOrEmpty(_searchTerm) || i.Name.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase)) && (!_filterBeerOnly || i.IsBeer)).OrderBy(i => i.Name))
                                    {
                                        <div class="list-group-item list-group-item-action border-0 mb-1 rounded-3 mx-2 @(_selectedCountItem?.Id == item.Id ? "bg-primary text-white shadow-lg selected-count-hub" : "") @(_stockCounts.ContainsKey(item.Id) ? "border-start border-4 border-success-subtle" : "")" 
                                             @onclick="() => SelectCountItem(item)" style="cursor: pointer;">
                                            <div class="d-flex justify-content-between align-items-center p-2">
                                                <div>
                                                    <div class="fw-black text-uppercase @(_selectedCountItem?.Id == item.Id ? "text-white" : "text-dark")">@item.Name</div>
                                                    <div class="extra-small @(_selectedCountItem?.Id == item.Id ? "text-white opacity-75" : "text-muted fw-bold")">Expected: @item.CurrentStock @item.BottleSize</div>
                                                </div>
                                                <div class="d-flex gap-2">
                                                    @if (_stockCounts.TryGetValue(item.Id, out var val))
                                                    {
                                                        <span class="badge rounded-pill @(val == item.CurrentStock ? "bg-white text-success" : "bg-white text-danger") px-3 py-2 fw-black">@val</span>
                                                    }
                                                    else
                                                    {
                                                        <button class="btn btn-sm btn-outline-primary fw-bold rounded-pill px-3" @onclick:stopPropagation="true" @onclick="() => MatchExpectedStock(item)">MATCH</button>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Right Column: Numpad Entry -->
                    <div class="col-lg-5">
                       @if (_selectedCountItem != null)
                        {
                            <div class="card border-0 shadow-lg rounded-4 p-4 text-center animate-slide-up sticky-top bg-white" style="top: 20px;">
                                <h6 class="text-muted fw-bold small text-uppercase mb-1">RECORDING COUNT</h6>
                                <h4 class="fw-black text-dark mb-4">@_selectedCountItem.Name</h4>

                                <div class="display-value-hub h1 fw-black text-primary mb-4 p-4 bg-light rounded-4 border shadow-inner" style="font-size: 4rem;">
                                    @_countEntry
                                </div>

                                <div class="row g-2 mb-4">
                                    @foreach (var key in new[] { "1", "2", "3", "4", "5", "6", "7", "8", "9", "C", "0", "DEL" })
                                    {
                                        <div class="col-4">
                                            <button class="btn btn-lg w-100 fw-black @(key == "DEL" ? "btn-danger-light" : (key == "C" ? "btn-secondary-light" : "btn-light border")) shadow-sm" 
                                                    style="height: 80px; font-size: 1.8rem;" 
                                                    @onclick="() => HandleNumpad(key)">@key</button>
                                        </div>
                                    }
                                </div>

                                <div class="d-grid gap-2">
                                    <button class="btn btn-primary btn-lg fw-black py-3 rounded-pill shadow-lg" @onclick="ConfirmSingleCount">SAVE BOTTLE COUNT</button>
                                    <button class="btn btn-link text-muted fw-bold text-decoration-none" @onclick="() => _selectedCountItem = null">Cancel Selection</button>
                                </div>
                            </div>
                        }
                        else if (_stockCounts.Any())
                        {
                            <div class="card border-0 shadow rounded-4 p-5 text-center text-white bg-gradient-success-hub">
                                <i class="bi bi-clipboard2-check-fill display-2 mb-3"></i>
                                <h2 class="fw-black mb-1">@_stockCounts.Count Items Auditied</h2>
                                <p class="opacity-75 mb-4 px-3">Pressing the button below will permanently adjust the shelf inventory totals in the master hub.</p>
                                <button class="btn btn-white btn-lg fw-black w-100 py-3 rounded-pill shadow-lg text-success" @onclick="SubmitFullReconciliation" style="background: white;">
                                    CONFIRM RECONCILIATION
                                </button>
                                <button class="btn btn-link text-white-50 text-decoration-none mt-3 small fw-bold" @onclick="() => _stockCounts.Clear()">Clear and restart audit</button>
                            </div>
                        }
                        else
                        {
                             <div class="card border-0 shadow-sm rounded-4 p-5 text-center bg-white h-100 d-flex flex-column justify-content-center opacity-75">
                                 <i class="bi bi-hand-index-thumb display-1 text-muted opacity-25 mb-3"></i>
                                 <h5 class="fw-bold text-muted">Awaiting Item Selection</h5>
                                 <p class="small text-muted px-4">Tap a product from the list to start physical reconciliation.</p>
                             </div>
                        }
                    </div>
                </div>
            </div>
        }
        else if (_activeTab == "ordering")
        {
            <div class="ordering-view animate-fade-in">
                <div class="row">
                    <div class="col-lg-8 overflow-y-auto no-scrollbar" style="max-height: calc(100vh - 250px); overflow-x: hidden;">
                        @if (!_items.Any())
                        {
                            <div class="alert alert-info rounded-4 border-0 shadow-sm p-4 text-center">
                                <i class="bi bi-info-circle display-4 d-block mb-3"></i>
                                <h5>No items to order.</h5>
                                <p class="mb-0">Please add liquor items and assign them to vendors in the Setup tab.</p>
                            </div>
                        }
                        else
                        {
                            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4 bg-white p-3 rounded-4 shadow-sm sticky-top" style="top: 0px; z-index: 100;">
                                <div class="d-flex align-items-center gap-3 flex-grow-1" style="max-width: 500px;">
                                    <div class="input-group input-group-sm">
                                        <span class="input-group-text bg-transparent border-0 pe-1">
                                            <i class="bi bi-search text-muted"></i>
                                        </span>
                                        <input type="text" class="form-control border-0 bg-transparent ps-1" placeholder="Search products..." onfocus="this.select()" @bind="_searchTerm" @bind:event="oninput" />
                                    </div>
                                    @if (!_isAlphabeticalView)
                                    {
                                        <div class="vr mx-2"></div>
                                        <select class="form-select form-select-sm rounded-pill border-2" style="width: 150px;" @bind="_filterVendorId">
                                            <option value="0">All Vendors</option>
                                            @foreach (var v in _vendors)
                                            {
                                                <option value="@v.Id">@v.Name</option>
                                            }
                                        </select>
                                    }
                                    <div class="vr mx-2"></div>
                                    <div class="row g-0 rounded-pill border bg-light p-1" style="min-width: 280px; height: 38px;">
                                        <div class="col-6">
                                            <button class="btn btn-sm w-100 h-100 rounded-pill border-0 @(!_isAlphabeticalView ? "btn-primary shadow-sm" : "btn-link text-muted text-decoration-none") text-uppercase fw-bold" style="font-size: 0.65rem;" @onclick="() => _isAlphabeticalView = false">BY VENDOR</button>
                                        </div>
                                        <div class="col-6">
                                            <button class="btn btn-sm w-100 h-100 rounded-pill border-0 @(_isAlphabeticalView ? "btn-primary shadow-sm" : "btn-link text-muted text-decoration-none") text-uppercase fw-bold" style="font-size: 0.65rem;" @onclick="() => _isAlphabeticalView = true">BY PRODUCT</button>
                                        </div>
                                    </div>
                                </div>
                                <div class="badge bg-primary rounded-pill px-3">@_items.Count(i => (_isAlphabeticalView || _filterVendorId == 0 || i.VendorId == _filterVendorId) && (string.IsNullOrEmpty(_searchTerm) || i.Name.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase)) && (!_filterBeerOnly || i.IsBeer)) Products</div>
                                
                                <div class="vr mx-1"></div>
                                <div class="d-flex align-items-center gap-1 bg-light rounded-pill p-1 border">
                                    <button class="btn btn-sm rounded-pill px-3 fw-black @(!_filterBeerOnly ? "btn-white shadow-sm" : "text-muted")" style="font-size: 0.65rem;" @onclick="() => _filterBeerOnly = false">ALL</button>
                                    <button class="btn btn-sm rounded-pill px-3 fw-black @(_filterBeerOnly ? "btn-amber shadow-sm" : "text-muted")" style="font-size: 0.65rem;" @onclick="() => _filterBeerOnly = true"><i class="bi bi-cup-straw me-1"></i>BEER ONLY</button>
                                </div>
                            </div>
                            
                            @if (_isAlphabeticalView)
                            {
                                <div class="row g-3 animate-fade-in">
                                    @foreach (var item in _items.Where(i => i.VendorId.HasValue && (string.IsNullOrEmpty(_searchTerm) || i.Name.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase)) && (!_filterBeerOnly || i.IsBeer)).OrderBy(i => i.Name))
                                    {
                                        <div class="col-md-6">
                                            <div class="order-item-card @(item.CurrentStock <= item.MinStockLimit ? "low-stock" : "") @(GetCartQuantity(item.Id) > 0 ? "selected-for-order" : "")">
                                                <div class="d-flex align-items-center gap-3">
                                                  <div class="product-info flex-grow-1">
                                                    <div class="d-flex justify-content-between align-items-center">
                                                        <div>
                                                            <h5 class="fw-black mb-0 text-dark">@item.Name</h5>
                                                            <div class="small text-muted d-flex align-items-center gap-2">
                                                                <span>@item.BottleSize</span>
                                                                @if (item.PackSize > 1)
                                                                {
                                                                    <span class="badge bg-light text-dark border extra-small">Case of @item.PackSize</span>
                                                                }
                                                                <span class="dot"></span>
                                                                <span>@item.CurrentPrice.ToString("C")</span>
                                                            </div>
                                                        </div>
                                                        <div class="stock-pill @(item.CurrentStock == 0 ? "empty" : (item.CurrentStock <= item.MinStockLimit ? "low" : "ok"))">
                                                            <div class="stock-label">STOCK</div>
                                                            <div class="stock-number">@item.CurrentStock</div>
                                                        </div>
                                                    </div>
                                                  </div>
                                                  <div class="quantity-control px-2 @(GetCartQuantity(item.Id) > 0 && GetCartQuantity(item.Id) < item.MinimumOrderQuantity ? "border border-danger rounded-3" : "")">
                                                      <button class="btn btn-sm btn-icon" @onclick="() => AdjustCartQuantity(item.Id, -1)">-</button>
                                                      <input type="number" class="qty-input" value="@GetCartQuantity(item.Id)" onfocus="this.select()" @oninput="e => SetCartQuantity(item.Id, e.Value)" />
                                                      <button class="btn btn-sm btn-icon" @onclick="() => AdjustCartQuantity(item.Id, 1)">+</button>
                                                  </div>
                                                </div>
                                                @if (GetCartQuantity(item.Id) > 0 && GetCartQuantity(item.Id) < item.MinimumOrderQuantity)
                                                {
                                                    <div class="text-danger extra-small fw-bold text-end pe-2 mt-1 pulse-animation">
                                                        <i class="bi bi-info-circle"></i> MIN ORDER: @item.MinimumOrderQuantity
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                @foreach (var vendorGroup in _items.Where(i => i.VendorId.HasValue && (_filterVendorId == 0 || i.VendorId == _filterVendorId) && (string.IsNullOrEmpty(_searchTerm) || i.Name.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase)) && (!_filterBeerOnly || i.IsBeer)).GroupBy(i => i.Vendor))
                                {
                                    <div class="vendor-block mb-4">
                                        <div class="vendor-header d-flex justify-content-between align-items-center mb-3">
                                            <h3 class="h5 fw-black m-0 text-uppercase tracking-wider">@(vendorGroup.Key?.Name ?? "Unassigned")</h3>
                                            <div class="badge bg-light text-muted border px-3">@vendorGroup.Count() Items</div>
                                        </div>
                                        <div class="row g-3">
                                            @foreach (var item in vendorGroup.OrderBy(i => i.Name))
                                            {
                                                <div class="col-md-6">
                                                    <div class="order-item-card @(item.CurrentStock <= item.MinStockLimit ? "low-stock" : "") @(GetCartQuantity(item.Id) > 0 ? "selected-for-order" : "")">
                                                        <div class="d-flex align-items-center gap-3">
                                                            <div class="product-info flex-grow-1">
                                                                <div class="d-flex justify-content-between align-items-center">
                                                                    <div>
                                                                        <h5 class="fw-black mb-0 text-dark">@item.Name</h5>
                                                                        <div class="small text-muted d-flex align-items-center gap-2">
                                                                            <span>@item.BottleSize</span>
                                                                            @if (item.PackSize > 1) { <span class="badge bg-light text-dark border extra-small">Case of @item.PackSize</span> }
                                                                            <span class="dot"></span>
                                                                            <span>@item.CurrentPrice.ToString("C")</span>
                                                                        </div>
                                                                    </div>
                                                                    <div class="stock-pill @(item.CurrentStock == 0 ? "empty" : (item.CurrentStock <= item.MinStockLimit ? "low" : "ok"))">
                                                                        <div class="stock-label">STOCK</div>
                                                                        <div class="stock-number">@item.CurrentStock</div>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                            <div class="quantity-control px-2 @(GetCartQuantity(item.Id) > 0 && GetCartQuantity(item.Id) < item.MinimumOrderQuantity ? "border border-danger rounded-3" : "")">
                                                                <button class="btn btn-sm btn-icon" @onclick="() => AdjustCartQuantity(item.Id, -1)">-</button>
                                                                <input type="number" class="qty-input" value="@GetCartQuantity(item.Id)" onfocus="this.select()" @oninput="e => SetCartQuantity(item.Id, e.Value)" />
                                                                <button class="btn btn-sm btn-icon" @onclick="() => AdjustCartQuantity(item.Id, 1)">+</button>
                                                            </div>
                                                        </div>
                                                        @if (GetCartQuantity(item.Id) > 0 && GetCartQuantity(item.Id) < item.MinimumOrderQuantity)
                                                        {
                                                            <div class="text-danger extra-small fw-bold text-end pe-2 mt-1 pulse-animation">
                                                                <i class="bi bi-info-circle"></i> MIN ORDER: @item.MinimumOrderQuantity
                                                            </div>
                                                        }
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }
                            }
                        }
                    </div>
                    
                    <div class="col-lg-4">
                        <div class="cart-sidebar sticky-top" style="top: 20px; z-index: 10;">
                            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                                <div class="card-header bg-white border-bottom p-3">
                                    <h5 class="mb-0 fw-black d-flex align-items-center text-primary">
                                        <i class="bi bi-cart4 me-2"></i> Current Order
                                    </h5>
                                </div>
                                <div class="card-body p-0">
                                    @if (!_cart.Any(v => v.Value > 0))
                                    {
                                        <div class="text-center py-5 text-muted">
                                            <i class="bi bi-cart-x display-6 mb-2 opacity-50"></i>
                                            <p class="small mb-0">Your order is currently empty.</p>
                                        </div>
                                    }
                                    else
                                    {
                                        var cartItems = _cart.Where(e => e.Value > 0)
                                            .Select(e => new { Item = _items.FirstOrDefault(i => i.Id == e.Key), Qty = e.Value })
                                            .Where(x => x.Item != null)
                                            .OrderBy(x => x.Item!.Vendor?.Name)
                                            .ToList();

                                        <div class="cart-scroll-area p-4" style="max-height: 500px; overflow-y: auto;">
                                            @foreach (var vGroup in cartItems.GroupBy(x => x.Item!.Vendor))
                                            {
                                                <div class="vendor-cart-group mb-4 pb-3 border-bottom border-light">
                                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                                        <span class="extra-small fw-black text-uppercase text-primary tracking-wider">@vGroup.Key?.Name (@vGroup.Sum(x => x.Qty * x.Item!.CurrentPrice).ToString("C"))</span>
                                                        @if (vGroup.Sum(x => x.Qty * x.Item!.CurrentPrice) < GetVendorMin(vGroup.Key))
                                                        {
                                                            <span class="badge bg-danger pulse-animation" style="font-size: 0.6rem;">
                                                                WAIT! NEED @((GetVendorMin(vGroup.Key) - vGroup.Sum(x => x.Qty * x.Item!.CurrentPrice)).ToString("C")) MORE
                                                            </span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge bg-success" style="font-size: 0.6rem;">MIN MET</span>
                                                        }
                                                    </div>
                                                    @foreach (var x in vGroup)
                                                    {
                                                        <div class="d-flex justify-content-between align-items-center mb-1">
                                                            <div class="small text-muted flex-grow-1">
                                                                <span class="fw-bold text-dark">@x.Qty ×</span> @x.Item!.Name
                                                            </div>
                                                            <div class="small fw-bold">@((x.Item.CurrentPrice * x.Qty).ToString("C"))</div>
                                                        </div>
                                                    }
                                                    <div class="d-flex justify-content-between mt-2 pt-2 border-top border-light opacity-75">
                                                        <span class="extra-small fw-bold">@vGroup.Key?.Name Total</span><span class="small fw-black ms-2">@vGroup.Sum(x => x.Qty * x.Item!.CurrentPrice).ToString("C")</span>
                                                         <button class="btn btn-xs btn-outline-primary rounded-pill fw-black px-2 ms-auto" @onclick="() => ShowOrderConfirmation(vGroup.Key?.Id)" disabled="@(vGroup.Sum(x => x.Qty * x.Item!.CurrentPrice) < GetVendorMin(vGroup.Key))">Order</button>

                                                    </div>
                                                </div>
                                            }
                                        </div>
                                        <div class="cart-summary bg-light p-4">
                                            <div class="d-flex justify-content-between mb-3">
                                                <span class="text-muted fw-bold">Grand Total</span>
                                                <span class="h4 fw-black text-primary mb-0">@GetCartTotal().ToString("C")</span>
                                            </div>
                                            @{ var canOrderAll = cartItems.GroupBy(x => x.Item!.Vendor).All(g => g.Sum(x => x.Qty * x.Item!.CurrentPrice) >= GetVendorMin(g.Key)); }
                                            <button class="btn btn-primary w-100 py-3 rounded-pill fw-black shadow-lg" 
                                                    @onclick="SubmitOrderAsync" 
                                                    disabled="@(!canOrderAll)">
                                                PLACE ALL ORDERS
                                            </button>
                                            @if (!canOrderAll)
                                            {
                                                <div class="extra-small text-danger text-center mt-2 fw-bold">
                                                    <i class="bi bi-info-circle"></i> Some vendors haven't met their minimum order.
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
        else if (_activeTab == "backorders")
        {
            <div class="backorders-view animate-fade-in">
                <div class="card border-0 shadow-sm rounded-4 overflow-hidden border-top border-4 border-warning">
                    <div class="card-header bg-white p-4 border-0 pb-0 d-flex justify-content-between align-items-center">
                         <div>
                            <h4 class="fw-black mb-1 text-uppercase tracking-wider">PENDING BACKORDERS</h4>
                            <p class="small text-muted mb-0">These items were previously marked as backordered and are still owed by the vendors.</p>
                         </div>
                    </div>
                    <div class="table-responsive p-4">
                        @if (!_pendingBackorders.Any())
                        {
                            <div class="text-center py-5 text-muted">
                                <i class="bi bi-check-circle display-1 opacity-25 mb-3"></i>
                                <h4 class="fw-black">All Backorders Resolved!</h4>
                                <p>You have no pending items waiting to arrive from previous orders.</p>
                            </div>
                        }
                        else
                        {
                            <table class="table table-hover align-middle mb-0">
                                <thead class="bg-light">
                                    <tr class="extra-small text-muted uppercase-tracking">
                                        <th class="ps-4">Date Ordered</th>
                                        <th>Vendor</th>
                                        <th>Product Name</th>
                                        <th class="text-center">Quantity Owed</th>
                                        <th class="text-end pe-4">Stock Adjustment</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var oi in _pendingBackorders)
                                    {
                                        <tr>
                                            <td class="ps-4">
                                                <div class="fw-bold">@oi.Order?.OrderDate.ToString("MMM dd, yyyy")</div>
                                                <div class="extra-small text-muted">Order ID: #@oi.OrderId</div>
                                            </td>
                                            <td><span class="fw-black text-primary">@oi.Order?.Vendor?.Name</span></td>
                                            <td>
                                                <div class="fw-bold text-dark">@oi.LiquorItem?.Name</div>
                                                <div class="extra-small text-muted">@oi.LiquorItem?.BottleSize</div>
                                            </td>
                                            <td class="text-center">
                                                <span class="fs-4 fw-black text-dark">@oi.Quantity</span>
                                            </td>
                                            <td class="text-end pe-4">
                                                <button class="btn btn-warning rounded-pill px-4 fw-black shadow-sm"
                                                        @onclick="() => ResolveBackorder(oi)">
                                                    MARK RECEIVED
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                    </div>
                </div>
            </div>
        }
        else if (_activeTab == "active")
        {
            <div class="active-orders animate-fade-in">
                 @if (!_pendingOrders.Any())
                {
                    <div class="text-center py-5 text-muted">
                        <i class="bi bi-check2-circle display-1 opacity-25 mb-3"></i>
                        <h4 class="fw-black">No Pending Orders</h4>
                        <p>All your orders have been received and stocked.</p>
                    </div>
                }
                else
                {
                    @foreach (var dateGroup in _pendingOrders.GroupBy(o => o.OrderDate.ToLocalTime().Date).OrderByDescending(g => g.Key))
                    {
                        var groupDate = dateGroup.Key;
                        <div class="d-flex justify-content-between align-items-center mb-3 mt-4">
                            <h5 class="fw-black text-uppercase text-dark mb-0">Daily Orders: @groupDate.ToString("MMM dd, yyyy")</h5>
                            <button class="btn btn-outline-primary rounded-pill fw-bold" @onclick='async () => await JSRuntime.InvokeVoidAsync("open", $"/liquor/print-batch/{groupDate.ToString("yyyy-MM-dd")}", "_blank")'>
                                <i class="bi bi-printer me-2"></i>PRINT DAILY BATCH SHEET
                            </button>
                        </div>
                        <div class="row g-4 mb-4">
                            @foreach (var order in dateGroup)
                            {
                                <div class="col-md-6 col-xl-4">
                                    <div class="card border-0 shadow-sm rounded-4 h-100">
                                        <div class="card-header bg-light border-0 p-3 d-flex justify-content-between align-items-center">
                                            <div class="fw-black text-uppercase tracking-wider small">@order.Vendor?.Name</div>
                                            <div class="badge bg-primary rounded-pill">@order.Status</div>
                                        </div>
                                        <div class="card-body p-4">
                                            <div class="d-flex justify-content-between mb-3">
                                                <div>
                                                    <div class="extra-small text-muted text-uppercase fw-bold">Date Placed</div>
                                                    <div class="fw-bold">@order.OrderDate.ToString("MMM dd, yyyy")</div>
                                                </div>
                                                <div class="text-end">
                                                    <div class="extra-small text-muted text-uppercase fw-bold">Order Value</div>
                                                    <div class="h5 fw-black text-dark mb-0">@order.TotalCost.ToString("C")</div>
                                                </div>
                                            </div>
                                            
                                            <div class="small fw-bold text-muted mb-2">Order Items:</div>
                                            <div class="list-group list-group-flush mb-4 overflow-auto" style="max-height: 150px;">
                                                @foreach (var oi in order.OrderItems)
                                                {
                                                    <div class="list-group-item px-0 py-1 border-0 bg-transparent d-flex justify-content-between">
                                                        <span class="small">@oi.Quantity&times; @oi.LiquorItem?.Name</span>
                                                        <span class="extra-small text-muted">@((oi.UnitPriceAtTimeOfOrder * oi.Quantity).ToString("C"))</span>
                                                    </div>
                                                }
                                            </div>

                                             <div class="d-flex align-items-center justify-content-between mb-4 mt-3 pt-3 border-top">
                                                <div class="d-flex align-items-center gap-2">
                                                    @if (order.IsEmailed)
                                                    {
                                                        <div class="badge bg-success-subtle text-success rounded-pill px-3 border border-success extra-small fw-black" title="Last sent: @(order.LastEmailedDate?.ToString("MM/dd HH:mm"))">
                                                            <i class="bi bi-envelope-check-fill me-1"></i> EMAILED
                                                        </div>
                                                    }
                                                    else if (!string.IsNullOrEmpty(order.Vendor?.Email))
                                                    {
                                                        <div class="badge bg-light text-muted rounded-pill px-3 border extra-small fw-black">
                                                            <i class="bi bi-envelope-slash me-1"></i> LOGGED ONLY
                                                        </div>
                                                    }
                                                </div>
                                                @if (!string.IsNullOrEmpty(order.Vendor?.Email))
                                                {
                                                    <button class="btn btn-sm btn-link text-primary text-decoration-none fw-black p-0 extra-small" @onclick="() => ResendOrderEmailAsync(order)">
                                                        <i class="bi bi-send-fill me-1"></i> RESEND EMAIL
                                                    </button>
                                                }
                                             </div>

                                             <div class="d-flex gap-2">
                                                 <button class="btn btn-outline-primary rounded-pill fw-bold border-2" title="Print Order Sheet" @onclick="() => PrintOrder(order.Id)">
                                                     <i class="bi bi-printer"></i>
                                                 </button>
                                                 @if (!string.IsNullOrEmpty(order.Vendor?.Email))
                                                 {
                                                     <button class="btn btn-outline-primary rounded-pill fw-bold border-2 ms-0" title="Email Order Again" @onclick="() => ResendOrderEmailAsync(order)">
                                                         <i class="bi bi-envelope"></i>
                                                     </button>
                                                 }
                                                 <button class="btn btn-success flex-grow-1 rounded-pill fw-black py-2 shadow-sm" @onclick="() => StartReceiptAsync(order)">
                                                     MARK AS RECEIVED
                                                 </button>
                                             </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                }
            </div>
        }
        else if (_activeTab == "unpaid")
        {
            <div class="history-view animate-fade-in">
                <div class="card border-0 shadow-sm rounded-4 overflow-hidden border-top border-4 border-danger">
                    <div class="card-header bg-white p-4 border-0 pb-0">
                         <h4 class="fw-black mb-1">Open Bills & Unpaid Invoices</h4>
                         <p class="small text-muted mb-0">These orders have arrived, but the club still owes the vendor for them.</p>
                    </div>
                    <div class="table-responsive p-4">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="bg-light">
                                <tr>
                                    <th class="ps-4">Date</th>
                                    <th>Vendor</th>
                                    <th>Invoice #</th>
                                    <th>Invoice Total</th>
                                    <th>Payment Status</th>
                                    <th class="text-end pe-4">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var order in _historyOrders.Where(o => !o.IsPaid))
                                {
                                    <tr>
                                        <td class="ps-4">
                                            <div class="fw-bold">@order.OrderDate.ToString("MMM dd, yyyy")</div>
                                            <div class="extra-small text-muted">Placed by @order.User?.Username</div>
                                        </td>
                                        <td><span class="fw-bold">@order.Vendor?.Name</span></td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(order.InvoiceNumber))
                                            {
                                                <span class="badge bg-light text-dark border fw-bold px-3">@order.InvoiceNumber</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted small">N/A</span>
                                            }
                                        </td>
                                        <td class="fw-black text-dark">@order.TotalCost.ToString("C")</td>
                                        <td>
                                             <button class="btn btn-outline-danger btn-sm rounded-pill px-3 fw-bold border-2" @onclick="() => OpenPaymentModal(order)">
                                                 Mark as Paid
                                              </button>
                                         </td>
                                        <td class="text-end pe-4 d-flex align-items-center justify-content-end gap-2">
                                             @if (!string.IsNullOrEmpty(order.Vendor?.Email))
                                             {
                                                 <button class="btn btn-sm btn-icon border-0 @(order.IsEmailed ? "text-success" : "text-muted")" title="Resend Email" @onclick="() => ResendOrderEmailAsync(order)">
                                                     <i class="bi @(order.IsEmailed ? "bi-envelope-check" : "bi-envelope")"></i>
                                                 </button>
                                             }
                                             <button class="btn btn-sm btn-icon border-0" title="Print Sheet" @onclick="() => PrintOrder(order.Id)">
                                                 <i class="bi bi-printer"></i>
                                             </button>
                                         </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
        else if (_activeTab == "history")
        {
            <div class="history-view animate-fade-in shadow-sm rounded-4 bg-white p-4">
                <!-- Sub-Tab Toggle -->
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div class="d-flex gap-2 p-1 bg-light rounded-pill border">
                        <button class="btn btn-sm rounded-pill px-4 @(_historySubTab == "orders" ? "btn-primary shadow-sm fw-black" : "btn-link text-muted text-decoration-none fw-bold")" 
                                @onclick='() => _historySubTab = "orders"'>
                            PAID INVOICES
                        </button>
                        <button class="btn btn-sm rounded-pill px-4 @(_historySubTab == "purchases" ? "btn-primary shadow-sm fw-black" : "btn-link text-muted text-decoration-none fw-bold")" 
                                @onclick='() => _historySubTab = "purchases"'>
                            PURCHASE HISTORY
                        </button>
                        <button class="btn btn-sm rounded-pill px-4 @(_historySubTab == "activity" ? "btn-primary shadow-sm fw-black" : "btn-link text-muted text-decoration-none fw-bold")" 
                                @onclick='() => _historySubTab = "activity"'>
                            ACTIVITY & PRICE LOG
                        </button>
                    </div>
                </div>

                @if (_historySubTab == "orders")
                {
                    <div class="d-flex flex-wrap gap-2 mb-3 p-3 bg-light rounded-4 border">
                        <select class="form-select w-auto fw-bold" @bind="_historyYearFilter">
                            <option value="0">All Years</option>
                            @foreach (var year in _historyOrders.Select(o => o.OrderDate.Year).Distinct().OrderByDescending(y => y))
                            {
                                <option value="@year">@year</option>
                            }
                        </select>
                        <select class="form-select w-auto fw-bold" @bind="_historyVendorFilter">
                            <option value="0">All Vendors</option>
                            @foreach (var v in _vendors.OrderBy(v => v.Name))
                            {
                                <option value="@v.Id">@v.Name</option>
                            }
                        </select>
                        <input type="text" class="form-control fw-bold" style="max-width: 250px;" placeholder="Search Product..." @bind="_historyProductSearch" @bind:event="oninput" />
                        <button class="btn btn-white border ms-auto px-4 fw-bold" @onclick="() => { _historyYearFilter = 0; _historyVendorFilter = 0; _historyProductSearch = string.Empty; }"><i class="bi bi-eraser-fill"></i> Clear</button>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="bg-light">
                                <tr class="extra-small text-muted text-uppercase tracking-wider">
                                    <th class="ps-3">Date</th>
                                    <th>Vendor</th>
                                    <th>Invoice #</th>
                                    <th>Total Cost</th>
                                    <th>Payment Date</th>
                                    <th class="text-end pe-3">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    var filteredHistoryList = _historyOrders.Where(o => o.IsPaid);
                                    if (_historyYearFilter > 0) filteredHistoryList = filteredHistoryList.Where(o => o.OrderDate.Year == _historyYearFilter);
                                    if (_historyVendorFilter > 0) filteredHistoryList = filteredHistoryList.Where(o => o.VendorId == _historyVendorFilter);
                                    if (!string.IsNullOrWhiteSpace(_historyProductSearch))
                                    {
                                        filteredHistoryList = filteredHistoryList.Where(o => o.OrderItems.Any(i => i.LiquorItem != null && i.LiquorItem.Name.Contains(_historyProductSearch, StringComparison.OrdinalIgnoreCase)));
                                    }
                                }
                                @if (!filteredHistoryList.Any())
                                {
                                    <tr><td colspan="6" class="text-center py-5 text-muted fw-bold">No completed orders found matching those filters.</td></tr>
                                }
                                @foreach (var order in filteredHistoryList.OrderByDescending(o => o.OrderDate))
                                {
                                    bool isExpanded = _expandedHistoryOrders.Contains(order.Id);
                                    <tr style="cursor: pointer;" @onclick="() => ToggleHistoryOrder(order.Id)">
                                        <td class="ps-3">
                                            <div class="fw-bold">@order.OrderDate.ToString("MMM dd, yyyy")</div>
                                            <div class="extra-small text-muted">By @order.User?.Username</div>
                                        </td>
                                        <td><span class="fw-black">@order.Vendor?.Name</span></td>
                                        <td><span class="badge border bg-light text-dark fw-bold">@order.InvoiceNumber</span></td>
                                        <td class="fw-black text-primary">@order.TotalCost.ToString("C")</td>
                                        <td>
                                            <div class="small fw-bold text-success"><i class="bi bi-check-circle-fill me-1"></i> @(order.PaidDate?.ToString("MM/dd/yy"))</div>
                                        </td>
                                        <td class="text-end pe-3 d-flex align-items-center justify-content-end gap-2">
                                             @if (!string.IsNullOrEmpty(order.Vendor?.Email))
                                             {
                                                 <button class="btn btn-sm btn-icon border-0 @(order.IsEmailed ? "text-success" : "text-muted")" title="Resend Email" @onclick="() => ResendOrderEmailAsync(order)" @onclick:stopPropagation>
                                                     <i class="bi @(order.IsEmailed ? "bi-envelope-check" : "bi-envelope")"></i>
                                                 </button>
                                             }
                                             <button class="btn btn-sm btn-outline-primary rounded-pill border-2 fw-black" @onclick="() => PrintOrder(order.Id)" @onclick:stopPropagation><i class="bi bi-printer"></i></button>
                                             <i class="bi @(isExpanded ? "bi-chevron-up" : "bi-chevron-down") text-muted fw-bold ms-3"></i>
                                         </td>
                                    </tr>
                                    @if (isExpanded)
                                    {
                                        <tr>
                                            <td colspan="6" class="p-0 border-0">
                                                <div class="bg-light p-3 border-bottom shadow-inner">
                                                    <h6 class="fw-black text-uppercase extra-small text-muted mb-3">Order Contents</h6>
                                                    <div class="row g-2">
                                                        @foreach (var item in order.OrderItems)
                                                        {
                                                            bool matchesSearch = !string.IsNullOrWhiteSpace(_historyProductSearch) && 
                                                                               item.LiquorItem?.Name.Contains(_historyProductSearch, StringComparison.OrdinalIgnoreCase) == true;
                                                            
                                                            <div class="col-md-6 col-lg-4">
                                                                <div class="card rounded-3 border-0 shadow-sm p-2 @(matchesSearch ? "border-start border-3 border-primary bg-primary-subtle" : "bg-white")">
                                                                    <div class="d-flex justify-content-between align-items-center">
                                                                        <div>
                                                                            <div class="fw-bold" style="font-size: 0.85rem;">@item.LiquorItem?.Name</div>
                                                                            <div class="text-muted" style="font-size: 0.7rem;">@item.LiquorItem?.BottleSize | @item.UnitPriceAtTimeOfOrder.ToString("C")</div>
                                                                        </div>
                                                                        <div class="text-end ms-2">
                                                                            <div class="fw-black">@item.Quantity &times;</div>
                                                                            <div class="fw-bold text-primary" style="font-size: 0.8rem;">@((item.Quantity * item.UnitPriceAtTimeOfOrder).ToString("C"))</div>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        }
                                                    </div>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else if (_historySubTab == "purchases")
                {
                    var purchaseCounts = _historyOrders.Where(o => o.IsPaid)
                        .SelectMany(o => o.OrderItems)
                        .GroupBy(i => i.LiquorItemId)
                        .ToDictionary(g => g.Key, g => g.Sum(i => i.Quantity));
                    
                    <div class="d-flex flex-wrap gap-2 mb-4 p-3 bg-light rounded-4 border">
                        <div class="input-group" style="max-width: 450px;">
                            <select class="form-select fw-bold" @bind="_historyPurchaseProductId">
                                <option value="0">-- Select a Product to view Purchase History --</option>
                                @foreach (var item in _items.Where(i => purchaseCounts.ContainsKey(i.Id)).OrderBy(i => i.Name))
                                {
                                    <option value="@item.Id">@item.Name (Qty Total: @purchaseCounts[item.Id])</option>
                                }
                            </select>
                            <button class="btn btn-white border px-4 fw-bold" @onclick="() => _historyPurchaseProductId = 0" title="Clear Search"><i class="bi bi-eraser-fill"></i> Clear</button>
                        </div>
                    </div>
                    
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="bg-light">
                                <tr class="extra-small text-muted text-uppercase tracking-wider">
                                    <th class="ps-3">Order Date</th>
                                    <th>Vendor</th>
                                    <th>Invoice #</th>
                                    <th class="text-center">Quantity</th>
                                    <th class="text-end">Unit Cost</th>
                                    <th class="text-end">Subtotal</th>
                                    <th class="text-end pe-3">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (_historyPurchaseProductId == 0)
                                {
                                    <tr><td colspan="7" class="text-center py-5 text-muted fw-bold">Please select a product from the dropdown above.</td></tr>
                                }
                                else
                                {
                                    var purchaseExhibits = _historyOrders
                                        .Where(o => o.IsPaid)
                                        .SelectMany(o => o.OrderItems.Where(i => i.LiquorItemId == _historyPurchaseProductId).Select(i => new { Order = o, Item = i }))
                                        .OrderByDescending(x => x.Order.OrderDate)
                                        .ToList();

                                    if (!purchaseExhibits.Any())
                                    {
                                        <tr><td colspan="7" class="text-center py-5 text-danger fw-bold">No purchase records found for this product.</td></tr>
                                    }
                                    
                                    @foreach(var record in purchaseExhibits)
                                    {
                                        <tr>
                                            <td class="ps-3 fw-bold">@record.Order.OrderDate.ToString("MMM dd, yyyy")</td>
                                            <td class="fw-black">@record.Order.Vendor?.Name</td>
                                            <td><span class="badge border bg-light text-dark fw-bold">@record.Order.InvoiceNumber</span></td>
                                            <td class="text-center fw-black">@record.Item.Quantity &times;</td>
                                            <td class="text-end">@record.Item.UnitPriceAtTimeOfOrder.ToString("C")</td>
                                            <td class="text-end fw-bold text-primary">@((record.Item.Quantity * record.Item.UnitPriceAtTimeOfOrder).ToString("C"))</td>
                                            <td class="text-end pe-3">
                                                <button class="btn btn-sm btn-outline-primary rounded-pill border-2 fw-black" @onclick="() => PrintOrder(record.Order.Id)"><i class="bi bi-printer"></i></button>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="bg-light">
                                <tr class="extra-small text-muted text-uppercase tracking-wider">
                                    <th class="ps-3">Timestamp</th>
                                    <th>Product</th>
                                    <th>Action Type</th>
                                    <th class="text-center">Count Change</th>
                                    <th>Audit Details / Notes</th>
                                    <th class="text-end pe-3">Performed By</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!_recentTransactions.Any())
                                {
                                    <tr>
                                        <td colspan="6" class="text-center py-5 text-muted">No system activity has been recorded yet.</td>
                                    </tr>
                                }
                                @foreach (var tx in _recentTransactions.OrderByDescending(t => t.Timestamp))
                                {
                                    <tr>
                                        <td class="ps-3">
                                            <div class="fw-bold">@tx.Timestamp.ToLocalTime().ToString("MM/dd")</div>
                                            <div class="extra-small text-muted opacity-75">@tx.Timestamp.ToLocalTime().ToString("h:mm tt")</div>
                                        </td>
                                        <td class="fw-black text-dark">@(tx.Item?.Name ?? "Product #" + tx.ItemId)</td>
                                        <td>
                                            <span class="badge rounded-pill pt-1 px-3 @(tx.TransactionType switch { "Update" => "bg-primary", "Restock" => "bg-success", "Checkout" => "bg-danger", _ => "bg-secondary" })" style="font-size: 0.65rem; font-weight: 800;">
                                                @tx.TransactionType.ToUpper()
                                            </span>
                                        </td>
                                        <td class="text-center fw-black">
                                            @if (tx.ChangeAmount != 0)
                                            {
                                                <span class="@(tx.ChangeAmount > 0 ? "text-success" : "text-danger")">@(tx.ChangeAmount > 0 ? "+" : "")@tx.ChangeAmount</span>
                                            }
                                            else { <span class="text-muted opacity-25">-</span> }
                                        </td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(tx.Notes))
                                            {
                                                <div class="extra-small fw-bold text-dark bg-light p-2 rounded-3 border">
                                                    @tx.Notes
                                                </div>
                                            }
                                            else { <span class="text-muted extra-small">None</span> }
                                        </td>
                                        <td class="text-end pe-3 fw-bold small">
                                            @(tx.User?.Username ?? "System Auto")
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        }
        else if (_activeTab == "analytics")
        {
            <div class="analytics-view animate-fade-in">
                <!-- Sub-Tab Toggle -->
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div class="d-flex align-items-center gap-3">
                        <h5 class="fw-black text-uppercase mb-0 tracking-wider">Analytics & Reports</h5>
                        <button class="btn btn-outline-primary btn-xs rounded-pill px-3 fw-bold shadow-sm" style="font-size: 0.65rem; height: 32px;" @onclick="() => _showVendorModal = true">
                            <i class="bi bi-people-fill me-1"></i> MANAGE VENDORS
                        </button>
                        <button class="btn btn-outline-info btn-xs rounded-pill px-3 fw-bold shadow-sm" style="font-size: 0.65rem; height: 32px;" @onclick="() => _showProfitGuideModal = true">
                             <i class="bi bi-lightbulb-fill me-1"></i> PROFITABILITY GUIDE
                        </button>
                    </div>
                    <div class="d-flex gap-2 p-1 bg-light rounded-pill border">
                        <button class="btn btn-sm rounded-pill px-4 @(_analyticsSubTab == "overview" ? "btn-primary shadow-sm fw-black" : "btn-link text-muted text-decoration-none fw-bold")" 
                                @onclick='() => _analyticsSubTab = "overview"'>
                            CURRENT INVENTORY
                        </button>
                        <button class="btn btn-sm rounded-pill px-4 @(_analyticsSubTab == "yearly" ? "btn-primary shadow-sm fw-black" : "btn-link text-muted text-decoration-none fw-bold")" 
                                @onclick='() => _analyticsSubTab = "yearly"'>
                            YEARLY PURCHASES
                        </button>
                    </div>
                </div>

                @if (_analyticsSubTab == "overview")
                {
                    <!-- Vendor Inventory Breakdown (Top Hero) -->
                    <div class="card border-0 shadow-sm rounded-4 p-4 mb-4 border-top border-4 border-primary">
                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <div>
                                <h5 class="fw-black mb-1">VENDOR INVENTORY VALUE</h5>
                                <p class="small text-muted mb-0">Total cost of inventory currently held per vendor.</p>
                            </div>
                            <div class="text-end">
                                <div class="extra-small text-muted fw-bold">TOTAL ASSETS</div>
                                <div class="h3 fw-black text-primary mb-0">@_items.Sum(i => i.CurrentStock * i.CurrentPrice).ToString("C0")</div>
                            </div>
                        </div>
                        
                        <div class="row g-3">
                            @foreach (var vGroup in _items.GroupBy(i => i.Vendor?.Name ?? "No Vendor").OrderByDescending(g => g.Sum(x => x.CurrentStock * x.CurrentPrice)).Take(6))
                            {
                                var groupVal = vGroup.Sum(x => x.CurrentStock * x.CurrentPrice);
                                if (groupVal <= 0) continue;
                                <div class="col-md-2">
                                    <div class="p-3 border rounded-4 bg-light h-100 shadow-inner">
                                        <div class="extra-small text-muted fw-bold text-truncate mb-1">@vGroup.Key</div>
                                        <div class="h5 fw-black text-dark mb-0">@groupVal.ToString("C0")</div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>

                <div class="card border-0 shadow-sm rounded-4 p-4">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h5 class="fw-black mb-0">Brand Profit Analysis</h5>
                        <div class="btn-group btn-group-sm rounded-pill border shadow-sm p-1">
                            <button class="btn btn-link text-decoration-none px-3 @(_statSortMode == "performance" ? "bg-dark text-white rounded-pill" : "text-muted")" @onclick='() => _statSortMode = "performance"'>Best Sellers</button>
                            <button class="btn btn-link text-decoration-none px-3 @(_statSortMode == "profit" ? "bg-dark text-white rounded-pill" : "text-muted")" @onclick='() => _statSortMode = "profit"'>By Profit</button>
                            <button class="btn btn-link text-decoration-none px-3 @(_statSortMode == "value" ? "bg-dark text-white rounded-pill" : "text-muted")" @onclick='() => _statSortMode = "value"'>By Value</button>
                            <button class="btn btn-link text-decoration-none px-3 @(_statSortMode == "name" ? "bg-dark text-white rounded-pill" : "text-muted")" @onclick='() => _statSortMode = "name"'>A-Z</button>
                        </div>
                    </div>
                    
                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead class="bg-light">
                                <tr class="extra-small text-muted uppercase-tracking">
                                    <th style="width: 5%;">#ID</th>
                                    <th style="width: 25%;">Product</th>
                                    <th class="text-center">Cost/Drink</th>
                                    <th class="text-center">Price(Member)</th>
                                    <th class="text-center">Profit/Drink</th>
                                    <th class="text-center">Popularity</th><th class="text-center">Servings</th>
                                    <th class="text-end">Margin Health</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    var sortedItems = _statSortMode switch {
                                        "performance" => _items.OrderByDescending(i => GetProfitPerDrink(i) * (_itemOrderCounts.ContainsKey(i.Id) ? _itemOrderCounts[i.Id] : 0)),
                                        "profit" => _items.OrderByDescending(i => GetProfitPerDrink(i)),
                                        "value" => _items.OrderByDescending(i => i.CurrentStock * i.CurrentPrice),
                                        _ => _items.OrderBy(i => i.Name)
                                    };
                                }
                                @foreach (var item in sortedItems)
                                {
                                    decimal costPerPurSellUnit;
                                    int unitsPerMainUnit;
                                    decimal marginPercent;
                                    decimal profitPerDrink;

                                    if (item.IsUnitBased)
                                    {
                                        unitsPerMainUnit = item.PackSize;
                                        costPerPurSellUnit = item.PackSize > 0 ? (item.CurrentPrice / item.PackSize) : 0;
                                        profitPerDrink = item.RetailPrice - costPerPurSellUnit;
                                        marginPercent = item.RetailPrice > 0 ? (profitPerDrink / item.RetailPrice) * 100 : 0;
                                    }
                                    else
                                    {
                                        var totalOz = GetOuncesFromSize(item.BottleSize);
                                        var costPerOz = totalOz > 0 ? item.CurrentPrice / (decimal)totalOz : 0;
                                        costPerPurSellUnit = costPerOz * item.PourSize;
                                        profitPerDrink = item.RetailPrice - costPerPurSellUnit;
                                        unitsPerMainUnit = (int)(totalOz / (double)(item.PourSize > 0 ? item.PourSize : 1));
                                        marginPercent = item.RetailPrice > 0 ? (profitPerDrink / item.RetailPrice) * 100 : 0;
                                    }

                                     <tr>
                                         <td class="text-muted extra-small">@item.Id</td>
                                         <td>
                                            <div class="fw-bold text-dark">@item.Name</div>
                                            <div class="extra-small text-muted">@(item.IsUnitBased ? "Priced by Unit" : item.BottleSize) • @item.CurrentStock @(item.CurrentStock == 1 ? "bottle" : "bottles")</div>
                                        </td>
                                        <td class="text-center">@costPerPurSellUnit.ToString("C2")</td>
                                        <td class="text-center fw-bold">@item.RetailPrice.ToString("C2")</td>
                                        <td class="text-center text-success fw-bold">@profitPerDrink.ToString("C2")</td>
                                        <td class="text-center">
                                             <div class="badge bg-light text-dark border rounded-pill px-3">
                                                 <i class="bi bi-graph-up-arrow text-primary me-1 small"></i>
                                                 @(_itemOrderCounts.ContainsKey(item.Id) ? _itemOrderCounts[item.Id] : 0)
                                             </div>
                                         </td>
                                         <td class="text-center">@unitsPerMainUnit @(item.IsUnitBased ? "" : "drinks")</td>
                                        <td class="text-end">
                                            @if (item.RetailPrice == 0)
                                            {
                                                <span class="badge bg-light text-muted border">No Price</span>
                                            }
                                            else
                                            {
                                                var marginColor = marginPercent < 70 ? "text-danger" : marginPercent < 85 ? "text-warning" : "text-success";
                                                var barColor = marginPercent < 70 ? "bg-danger" : marginPercent < 85 ? "bg-warning" : "bg-success";
                                                
                                                <div class="d-flex align-items-center justify-content-end gap-2">
                                                    <span class="extra-small fw-bold @marginColor">@marginPercent.ToString("F0")%</span>
                                                    <div class="progress" style="width: 60px; height: 6px;">
                                                        <div class="progress-bar @barColor" style="width: @marginPercent%"></div>
                                                    </div>
                                                </div>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
                }
                else if (_analyticsSubTab == "yearly")
                {
                    <div class="card border-0 shadow-sm rounded-4 p-4">
                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <h5 class="fw-black mb-0">Total Purchases by Year</h5>
                            <select class="form-select fw-bold w-auto" @bind="_analyticsYear">
                                @{ var distinctYears = _historyOrders.Where(o => o.IsPaid).Select(o => o.OrderDate.Year).Distinct().OrderByDescending(y => y).ToList(); }
                                @if (!distinctYears.Any())
                                {
                                    distinctYears.Add(DateTime.Now.Year);
                                }
                                @foreach (var y in distinctYears)
                                {
                                    <option value="@y">@y</option>
                                }
                            </select>
                        </div>
                        
                        @{
                            var yearlyOrders = _historyOrders.Where(o => o.OrderDate.Year == _analyticsYear && o.IsPaid).ToList();
                            var totalSpent = yearlyOrders.Sum(o => o.TotalCost);
                            var totalUnits = yearlyOrders.SelectMany(o => o.OrderItems).Sum(i => i.Quantity * (i.LiquorItem?.PackSize ?? 1));
                            
                            var itemStats = yearlyOrders.SelectMany(o => o.OrderItems)
                                .GroupBy(i => i.LiquorItemId)
                                .Select(g => new { 
                                    Item = _items.FirstOrDefault(x => x.Id == g.Key), 
                                    TotalQty = g.Sum(x => x.Quantity), 
                                    TotalSpent = g.Sum(x => x.Quantity * x.UnitPriceAtTimeOfOrder) 
                                })
                                .Where(x => x.Item != null)
                                .OrderByDescending(x => x.TotalSpent)
                                .ToList();
                        }
                        
                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <div class="p-4 bg-light rounded-4 border text-center shadow-inner">
                                    <h6 class="extra-small text-muted fw-bold text-uppercase mb-2">Total Liquor Expenses for @_analyticsYear</h6>
                                    <h1 class="fw-black mb-0 text-danger">@totalSpent.ToString("C")</h1>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="p-4 bg-light rounded-4 border text-center shadow-inner">
                                    <h6 class="extra-small text-muted fw-bold text-uppercase mb-2">Total Units Purchased in @_analyticsYear</h6>
                                    <h1 class="fw-black mb-0 text-primary">@totalUnits</h1>
                                </div>
                            </div>
                        </div>

                        <div class="table-responsive">
                            <table class="table table-hover align-middle">
                                <thead class="bg-light">
                                    <tr class="extra-small text-muted text-uppercase tracking-wider">
                                        <th class="ps-3">Product Name</th>
                                        <th class="text-center">Annual Quantity Ordered</th>
                                        <th class="text-end pe-3">Total Capital Spent</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (!itemStats.Any())
                                    {
                                        <tr><td colspan="3" class="text-center py-5 text-muted fw-bold">No completed orders found for @_analyticsYear.</td></tr>
                                    }
                                    @foreach (var stat in itemStats)
                                    {
                                        <tr>
                                            <td class="fw-bold text-dark ps-3">
                                                @stat.Item.Name
                                                <div class="extra-small text-muted">@stat.Item.BottleSize</div>
                                            </td>
                                            <td class="text-center fw-black">
                                                @if (stat.Item.IsUnitBased && stat.Item.PackSize > 1)
                                                {
                                                    <div class="mb-0">@stat.TotalQty <span class="extra-small text-muted">CASES</span></div>
                                                    <div class="extra-small text-primary opacity-75">(@(stat.TotalQty * stat.Item.PackSize) TOTAL UNITS)</div>
                                                }
                                                else
                                                {
                                                    <span>@stat.TotalQty <span class="extra-small text-muted">BOTTLES</span></span>
                                                }
                                            </td>
                                            <td class="text-end fw-black text-primary pe-3">@stat.TotalSpent.ToString("C")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }
            </div> @* Closes the analytics-view div *@
        } @* Closes else if (_activeTab == "analytics") *@
        else if (_activeTab == "setup")
        {
            <div class="setup-view animate-fade-in">
                <!-- SETUP SUB-TABS -->
                <div class="d-flex gap-2 mb-4 bg-white p-2 rounded-pill shadow-sm sticky-top overflow-auto" style="top: 0px; z-index: 100; white-space: nowrap;">
                    <button class="btn btn-sm rounded-pill px-4 fw-black @(_activeSetupTab == "items" ? "btn-primary shadow-sm" : "text-muted")" @onclick='() => _activeSetupTab = "items"'>
                        <i class="bi bi-box-seam me-1"></i> PRODUCTS
                    </button>
                    <button class="btn btn-sm rounded-pill px-4 fw-black @(_activeSetupTab == "vendors" ? "btn-primary shadow-sm" : "text-muted")" @onclick='() => _activeSetupTab = "vendors"'>
                        <i class="bi bi-person-badge me-1"></i> VENDORS
                    </button>
                    <button class="btn btn-sm rounded-pill px-4 fw-black @(_activeSetupTab == "email" ? "btn-primary shadow-sm" : "text-muted")" @onclick='() => _activeSetupTab = "email"'>
                        <i class="bi bi-envelope-at me-1"></i> EMAIL SETUP
                    </button>
                </div>

                @if (_activeSetupTab == "items")
                {
                    <div class="row g-4">
                        <!-- FULL WIDTH: ITEM MAPPING & PRICING -->
                        <div class="col-12">
                            <div class="card border-0 shadow-sm rounded-4 p-4">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <div>
                                        <h5 class="fw-black text-uppercase mb-1">Item Mapping & Pricing</h5>
                                        <p class="small text-muted mb-0">Assign vendors to your items and set the current purchase price.</p>
                                    </div>
                                    <div class="d-flex gap-2">
                                         <button class="btn btn-outline-primary px-4 rounded-pill fw-black" @onclick="() => _showPriceHistoryModal = true"><i class="bi bi-clock-history me-1"></i>PRICE LOG</button>
                                         <button class="btn btn-outline-primary px-4 rounded-pill fw-black" @onclick='() => _activeSetupTab = "vendors"'>MANAGE VENDORS</button>
                                         <button class="btn btn-success px-4 rounded-pill fw-black" @onclick="() => _showAddItemModal = true"><i class="bi bi-plus-lg me-1"></i>ADD NEW ITEM</button>
                                         <div class="vr mx-2"></div>
                                         <button class="btn btn-primary rounded-pill px-4 fw-black shadow-sm" @onclick="BatchUpdateItems" disabled="@_isSaving">
                                            @if (_isSaving) { <span class="spinner-border spinner-border-sm me-1"></span> <span>SAVING...</span> }
                                            else { <span>SAVE ALL CHANGES</span> }
                                        </button>
                                    </div>
                                </div>
                                
                                <div class="table-responsive mt-3" style="max-height: 70vh; overflow-y: auto;">
                                     <table class="table table-hover align-middle mb-0">
                                        <thead class="sticky-top bg-white shadow-sm" style="z-index: 5;">
                                            <tr class="small text-muted uppercase-tracking border-bottom">
                                                <th style="width: 5%;">#ID</th>
                                                <th style="width: 25%;">Product</th>
                                                <th style="width: 15%;">Vendor</th>
                                                <th class="text-center" style="width: 10%;">Min Stock</th>
                                                <th class="text-center">Bottle / Case Cost</th>
                                                <th class="text-center">Drink Price</th>
                                                <th class="text-center" style="width: 10%;">Shot Size</th>
                                                <th class="text-end pe-4" style="width: 8%;">Actions</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var item in _items.OrderBy(i => i.Name))
                                            {
                                                <tr>
                                                    <td class="text-muted fw-bold">@item.Id</td>
                                                    <td>
                                                        <div class="fw-bold">@item.Name</div>
                                                        <div class="extra-small text-muted">@item.BottleSize</div>
                                                    </td>
                                                    <td>
                                                        <select class="form-select form-select-sm border-0 bg-light rounded-3 fw-bold" 
                                                                style="font-size: 0.75rem;"
                                                                @onchange="e => UpdateItemVendor(item, e.Value)">
                                                            <option value="">-- No Vendor --</option>
                                                            @foreach(var v in _vendors) { <option value="@v.Id" selected="@(item.VendorId == v.Id)">@v.Name</option> }
                                                        </select>
                                                    </td>
                                                    <td class="text-center">
                                                        <input type="number" class="form-control form-control-sm border-0 bg-light rounded-3 text-center fw-bold mx-auto" 
                                                               style="width: 60px; font-size: 0.75rem;"
                                                               onfocus="this.select();"
                                                               @bind="item.MinStockLimit" @bind:event="oninput" />
                                                    </td>
                                                    <td class="text-center">
                                                         <div class="input-group input-group-sm justify-content-center">
                                                            <span class="input-group-text border-0 bg-transparent fw-bold">$</span>
                                                            <input type="number" class="form-control form-control-sm border-0 bg-light rounded-3 fw-black text-center" 
                                                                   style="max-width: 80px;"
                                                                   onfocus="this.select();"
                                                                   @bind="item.CurrentPrice" @bind:event="oninput" step="0.01" />
                                                         </div>
                                                    </td>
                                                    <td class="text-center">
                                                         <div class="input-group input-group-sm justify-content-center">
                                                            <span class="input-group-text border-0 bg-transparent fw-bold">$</span>
                                                            <input type="number" class="form-control form-control-sm border-0 bg-light rounded-3 fw-black text-center" 
                                                                   style="max-width: 80px;"
                                                                   onfocus="this.select();"
                                                                   @bind="item.RetailPrice" @bind:event="oninput" step="0.01" />
                                                         </div>
                                                    </td>
                                                    <td class="text-center">
                                                         <div class="input-group input-group-sm justify-content-center">
                                                            <input type="number" class="form-control form-control-sm border-0 bg-light rounded-3 fw-bold text-center" 
                                                                   style="max-width: 60px;"
                                                                   onfocus="this.select();"
                                                                   @bind="item.PourSize" @bind:event="oninput" step="0.1" />
                                                            <span class="input-group-text border-0 bg-transparent extra-small fw-bold">oz</span>
                                                         </div>
                                                    </td>
                                                    <td class="text-end pe-4">
                                                        <button class="btn btn-sm btn-icon text-danger border-0" @onclick="() => DeleteItemAsync(item.Id)">
                                                            <i class="bi bi-trash3"></i>
                                                        </button>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                }
                else if (_activeSetupTab == "vendors")
                {
                    <div class="row g-4">
                        <div class="col-md-5">
                            <div class="card border-0 shadow-sm rounded-4 p-4 sticky-top" style="top: 80px;">
                                <h5 class="fw-black mb-1">ADD VENDOR</h5>
                                <p class="small text-muted mb-4">Create a new partner for ordering.</p>
                                
                                <div class="row g-2 mb-2">
                                    <div class="col-8">
                                        <input type="text" class="form-control form-control-sm rounded-pill border-2" @bind="_newVendorName" placeholder="Vendor Name" />
                                    </div>
                                    <div class="col-4">
                                         <div class="bg-light rounded-pill border-2 border d-flex align-items-center px-3 h-100">
                                            <span class="extra-small text-muted fw-bold me-2">MIN $</span>
                                            <input type="number" class="form-control border-0 bg-transparent p-0 extra-small fw-bold text-center" onfocus="this.select();" @bind="_newVendorMinOrder" />
                                        </div>
                                    </div>
                                </div>
                                <div class="row g-2 mb-2">
                                    <div class="col-5"><input type="tel" class="form-control form-control-sm rounded-pill border-2" @bind="_newVendorPhone" placeholder="Phone" /></div>
                                    <div class="col-7"><input type="email" class="form-control form-control-sm rounded-pill border-2" @bind="_newVendorEmail" placeholder="Email Address" /></div>
                                </div>
                                <div class="input-group input-group-sm">
                                    <input type="text" class="form-control rounded-pill-start border-2 border-end-0" @bind="_newVendorWebsite" placeholder="Website URL" />
                                    <button class="btn btn-primary rounded-pill-end px-4 fw-bold" @onclick="CreateVendorAsync">ADD VENDOR</button>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-7">
                            <div class="scroll-y-hub p-1" style="max-height: 70vh; overflow-y: auto;">
                                @foreach (var v in _vendors.OrderBy(v => v.Name))
                                {
                                    <div class="px-3 py-3 border rounded-4 bg-white mb-3 shadow-sm border-start border-5 border-primary">
                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                            <input type="text" class="form-control form-control-sm border-0 fw-black text-primary bg-transparent p-0" 
                                                   style="font-size: 1.1rem; box-shadow: none;"
                                                   @bind="v.Name" @bind:event="oninput" 
                                                   @bind:after="() => LiquorService.UpdateVendorAsync(v)" />
                                             <button class="btn btn-sm text-danger border-0 p-0" @onclick="() => DeleteVendorAsync(v.Id)">
                                                <i class="bi bi-trash3"></i>
                                            </button>
                                        </div>
                                        <div class="row g-2">
                                            <div class="col-4">
                                                <label class="extra-small fw-bold text-muted d-block mb-1">PHONE</label>
                                                <input type="tel" class="form-control form-control-sm border-1 rounded-3 bg-light extra-small fw-bold" 
                                                       @bind="v.PhoneNumber" @bind:event="oninput" @bind:after="() => LiquorService.UpdateVendorAsync(v)" />
                                            </div>
                                            <div class="col-4">
                                                <label class="extra-small fw-bold text-muted d-block mb-1">EMAIL</label>
                                                <input type="email" class="form-control form-control-sm border-1 rounded-3 bg-light extra-small fw-bold" 
                                                       @bind="v.Email" @bind:event="oninput" @bind:after="() => LiquorService.UpdateVendorAsync(v)" />
                                            </div>
                                            <div class="col-4">
                                                <label class="extra-small fw-bold text-muted d-block mb-1">MIN ORDER</label>
                                                <input type="number" class="form-control form-control-sm border-1 rounded-3 bg-light extra-small fw-bold text-center" 
                                                       @onchange='(e) => HandleVendorMinOrderChange(v, e.Value)' value="@v.MinimumOrderAmount" onfocus="this.select();" />
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
                else if (_activeSetupTab == "email")
                {
                    <div class="card border-0 shadow-sm rounded-4 p-5 animate-slide-up">
                         <div class="d-flex justify-content-between align-items-start mb-5 pb-4 border-bottom">
                             <div>
                                 <h4 class="fw-black text-uppercase mb-1 tracking-wider">Email Configuration</h4>
                                 <p class="text-muted mb-0">Manage how orders are electronically dispatched to your brewery and liquor partners.</p>
                             </div>
                             <div class="text-end">
                                 <button class="btn btn-primary rounded-pill px-5 py-3 fw-black shadow-lg" @onclick="SaveEmailSettingsAsync" disabled="@_isSavingSettings">
                                     @if (_isSavingSettings) { <span class="spinner-border spinner-border-sm me-2"></span> <span>SAVING...</span> }
                                     else { <i class="bi bi-cloud-check-fill me-2"></i> <span>SAVE EMAIL LOGIC</span> }
                                 </button>
                                 @if (_isSavingSettings) { <div class="extra-small text-primary fw-bold mt-2 animate-pulse">Synchronizing with system core...</div> }
                             </div>
                         </div>

                         <div class="row g-5">
                             <div class="col-lg-4">
                                 <div class="card bg-light border-0 rounded-5 p-4 h-100">
                                     <div class="d-flex justify-content-between align-items-center mb-4">
                                         <div class="d-flex align-items-center gap-3">
                                             <div class="bg-primary bg-opacity-10 p-3 rounded-4">
                                                 <i class="bi bi-toggle-on text-primary fs-3"></i>
                                             </div>
                                             <div>
                                                 <h6 class="fw-black text-uppercase mb-0">System Status</h6>
                                                 <p class="extra-small text-muted fw-bold mb-0">Master switch for automation</p>
                                             </div>
                                         </div>
                                         <div class="form-check form-switch fs-4">
                                             <input class="form-check-input" type="checkbox" role="switch" @bind="_settings.LiquorEmailEnabled">
                                         </div>
                                     </div>
                                     
                                     <div class="alert @(_settings.LiquorEmailEnabled ? "alert-success" : "alert-warning") border-0 rounded-4 py-3 shadow-none mb-4">
                                         <div class="d-flex align-items-center gap-3">
                                             <i class="bi @(_settings.LiquorEmailEnabled ? "bi-check-circle-fill" : "bi-exclamation-triangle-fill") fs-4"></i>
                                             <div class="extra-small fw-bold">
                                                 @if (_settings.LiquorEmailEnabled) { <span>System is ARMED. Emails will be prepared for dispatch.</span> }
                                                 else { <span>System is COLD. Electronic dispatch is disabled.</span> }
                                             </div>
                                         </div>
                                     </div>

                                     <div class="bg-white p-4 rounded-5 shadow-sm border">
                                         <h6 class="fw-black text-uppercase extra-small text-muted mb-4 tracking-wider"><i class="bi bi-cpu me-2"></i> SMTP ENGINE</h6>
                                         <div class="mb-3">
                                             <label class="extra-small fw-black text-muted text-uppercase mb-1">Outgoing Host</label>
                                             <input type="text" class="form-control form-control-sm border-2 rounded-3 fw-bold" placeholder="smtp.gmail.com" @bind="_settings.SmtpHost" />
                                         </div>
                                         <div class="mb-3">
                                             <label class="extra-small fw-black text-muted text-uppercase mb-1">SMTP Port</label>
                                             <input type="number" class="form-control form-control-sm border-2 rounded-3 fw-bold" placeholder="587" @bind="_settings.SmtpPort" />
                                         </div>
                                         <div class="mb-3">
                                             <label class="extra-small fw-black text-muted text-uppercase mb-1">Username / Email</label>
                                             <input type="text" class="form-control form-control-sm border-2 rounded-3 fw-bold" @bind="_settings.SmtpUsername" />
                                         </div>
                                         <div class="mb-3">
                                             <label class="extra-small fw-black text-muted text-uppercase mb-1">Password / App Key</label>
                                             <input type="password" class="form-control form-control-sm border-2 rounded-3 fw-bold" @bind="_settings.SmtpPassword" />
                                         </div>
                                         <div class="mb-3 d-flex align-items-center justify-content-between bg-light p-2 rounded-3">
                                             <label class="extra-small fw-black text-muted text-uppercase mb-0">Use SSL/TLS Protection</label>
                                             <div class="form-check form-switch pt-1">
                                                 <input class="form-check-input" type="checkbox" role="switch" @bind="_settings.SmtpEnableSsl">
                                             </div>
                                         </div>
                                         <div class="mb-3 pt-2 border-top">
                                             <label class="extra-small fw-black text-muted text-uppercase mb-1">Sender Address (FROM)</label>
                                             <input type="email" class="form-control form-control-sm border-2 rounded-3 fw-bold" placeholder="orders@yourclub.com" @bind="_settings.SmtpFromAddress" />
                                         </div>
                                         <div class="mb-0">
                                             <label class="extra-small fw-black text-muted text-uppercase mb-1">Sender Display Name</label>
                                             <input type="text" class="form-control form-control-sm border-2 rounded-3 fw-bold" placeholder="GFC Liquor HUB" @bind="_settings.SmtpFromName" />
                                         </div>
                                     </div>
                                 </div>
                             </div>

                             <div class="col-lg-8">
                                 <label class="extra-small fw-black text-muted text-uppercase mb-2 tracking-wider">Global Order Signature & Footer</label>
                                 <p class="extra-small text-muted fw-bold mb-3">This message appears at the bottom of every order email sent to vendors.</p>
                                 <textarea class="form-control rounded-4 border-2 p-4 fw-bold shadow-inner" 
                                           style="min-height: 380px; font-family: 'Courier New', monospace; font-size: 0.9rem;" 
                                           placeholder="Example: Regards, The GFC Management. Please deliver to side entrance..."
                                           @bind="_settings.LiquorEmailSignature"></textarea>
                                 <div class="d-flex justify-content-between mt-3">
                                     <span class="extra-small text-muted fw-bold">Total Characters: @(_settings?.LiquorEmailSignature?.Length ?? 0)</span>
                                     <span class="extra-small text-primary fw-black text-uppercase">HTML supported (limited)</span>
                                 </div>
                             </div>
                         </div>
                    </div>
                }
            </div>
        }
    }
}

<!-- Receipt Modal -->
@if (_orderToReceive != null)
{
    <div class="modal-backdrop-modern animate-fade-in">
        <div class="modal-card animate-slide-up shadow-lg">
            <div class="modal-header bg-success text-white py-4">
                <h3 class="mb-0 fw-black text-uppercase tracking-wider">RECEIVING: @(_orderToReceive.Vendor?.Name)</h3>
                <button class="btn-close btn-close-white" @onclick="() => _orderToReceive = null"></button>
            </div>
            <div class="modal-body p-4">
                <p class="small text-muted mb-4">Confirm final invoice details before finalizing shipment into inventory.</p>
                
                <div class="row g-3 mb-4">
                    <div class="col-12">
                         <label class="small fw-black text-muted mb-2 text-uppercase tracking-wider">Review Items (@_orderToReceive.OrderItems.Count)</label>
                         <div class="card rounded-3 border bg-light overflow-hidden">
                             <div class="list-group list-group-flush overflow-auto" style="max-height: 250px;">
                                 @foreach (var oi in _orderToReceive.OrderItems)
                                 {
                                     <div class="list-group-item bg-white d-flex justify-content-between align-items-center py-2 px-3 border-light @(oi.IsBackordered ? "opacity-50" : "")">
                                         <div class="d-flex align-items-center gap-3">
                                             <div class="fw-black text-dark" style="min-width: 40px;">@oi.Quantity&times;</div>
                                             <div>
                                                 <div class="fw-bold @(oi.IsBackordered ? "text-decoration-line-through text-muted" : "text-dark")">@oi.LiquorItem?.Name</div>
                                                 @if (oi.IsBackordered)
                                                 {
                                                     <span class="badge bg-warning text-dark extra-small rounded-pill px-2">BACKORDERED</span>
                                                 }
                                             </div>
                                         </div>
                                         <button class="btn btn-sm @(oi.IsBackordered ? "btn-primary" : "btn-outline-warning") rounded-pill px-3 fw-bold" 
                                                 @onclick="() => oi.IsBackordered = !oi.IsBackordered">
                                             @(oi.IsBackordered ? "UNDO" : "BACKORDER")
                                         </button>
                                     </div>
                                 }
                             </div>
                         </div>
                    </div>

                    <div class="col-md-6">
                        <label class="small fw-bold text-muted mb-1">Invoice Number</label>
                        <input type="text" class="form-control fw-bold" @bind="_receiveInvoiceNumber" @bind:event="oninput" placeholder="INV-0000..." />
                    </div>
                    <div class="col-md-6">
                        <label class="small fw-bold text-muted mb-1">Actual Total Amount (Due on Invoice)</label>
                        <div class="input-group">
                            <span class="input-group-text">$</span>
                            <input type="number" class="form-control fw-bold text-dark text-center" onfocus="this.select();" 
                                   @bind="_receiveTotalDue" @bind:event="oninput" step="0.01" />
                        </div>
                    </div>
                </div>

                <div class="p-3 bg-light rounded-3 mb-4">
                    @{
                        var receivedTotal = _orderToReceive.OrderItems.Where(i => !i.IsBackordered).Sum(i => i.UnitPriceAtTimeOfOrder * i.Quantity);
                    }
                    <div class="d-flex justify-content-between mb-1">
                        <span class="text-muted">Calculated Received Total</span>
                        <span class="fw-bold">@(receivedTotal.ToString("C"))</span>
                    </div>
                    <div class="d-flex justify-content-between h3 fw-black text-dark mb-0">
                        <span>Invoice Amount</span>
                        <span>@(_receiveTotalDue.ToString("C"))</span>
                    </div>
                </div>

                <div class="alert alert-warning small border-0 py-2">
                    <i class="bi bi-info-circle me-1"></i> Clicking confirm will automatically increase your stock on hand by the ordered amounts.
                </div>
            </div>
            <div class="modal-footer p-3 bg-light d-flex gap-2">
                <button class="btn btn-light border fw-bold flex-grow-1" @onclick="() => _orderToReceive = null">Cancel</button>
                <button class="btn btn-success fw-black flex-grow-1 shadow-sm" 
                        @onclick="ConfirmReceiptAsync" 
                        disabled="@(string.IsNullOrWhiteSpace(_receiveInvoiceNumber) || _receiveTotalDue <= 0)">
                    @((string.IsNullOrWhiteSpace(_receiveInvoiceNumber) || _receiveTotalDue <= 0) ? "ENTER INVOICE TO CONFIRM" : "CONFIRM RECEIVE")
                </button>
            </div>
        </div>
    </div>
}

<!-- Payment Modal -->
@if (_orderToPay != null)
{
    <div class="modal-backdrop-modern animate-fade-in">
        <div class="modal-card animate-slide-up shadow-lg border-danger border-top border-5">
            <div class="modal-header bg-white py-4 d-flex justify-content-between align-items-center">
                <div>
                     <h3 class="mb-0 fw-black text-uppercase text-danger">CONFIRM PAYMENT</h3>
                     <div class="small text-muted">Invoice #@(_orderToPay.InvoiceNumber ?? "N/A") from @_orderToPay.Vendor?.Name</div>
                </div>
                <button class="btn-close" @onclick="() => _orderToPay = null"></button>
            </div>
            <div class="modal-body p-4">
                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label class="small fw-bold text-muted mb-1">Check/Entry Date</label>
                        <input type="date" class="form-control fw-bold" @bind="_paidDate" />
                    </div>
                    <div class="col-md-6">
                        <label class="small fw-bold text-muted mb-1">Actual Amount Paid</label>
                        <div class="input-group">
                            <span class="input-group-text">$</span>
                            <input type="number" class="form-control fw-bold text-dark text-center" onfocus="this.select();" 
                                   @bind="_actualPaidAmount" @bind:event="oninput" step="0.01" />
                        </div>
                    </div>
                </div>

                <div class="p-4 bg-light rounded-4 text-center mb-0">
                    <div class="extra-small text-muted text-uppercase fw-bold mb-1">Invoice Total Due</div>
                    <div class="h2 fw-black text-dark">@_orderToPay.TotalCost.ToString("C")</div>
                </div>
                
                <div class="text-center mt-3 mb-0">
                    <i class="bi bi-person-check-fill text-primary"></i> 
                    <span class="extra-small fw-bold text-muted">WILL BE LOGGED AS PAID BY: <span class="text-primary">@_currentUser?.Username</span></span>
                </div>
            </div>
            <div class="modal-footer p-3 bg-light d-flex gap-2">
                <button class="btn btn-light border fw-bold flex-grow-1" @onclick="() => _orderToPay = null">Cancel</button>
                <button class="btn btn-danger fw-black flex-grow-1 shadow-sm" 
                        disabled="@(_actualPaidAmount <= 0)" 
                        @onclick="ConfirmPaymentAsync">
                    @(_actualPaidAmount <= 0 ? "ENTER AMOUNT" : "CONFIRM PAYMENT")
                </button>
            </div>
        </div>
    </div>
}
 
 <!-- Order Confirmation Modal (Desktop) -->
 @if (_showOrderConfirm)
 {
     <div class="modal-backdrop-modern animate-fade-in" style="z-index: 9999;">
         <div class="modal-card animate-slide-up shadow-lg border-primary border-top border-5" style="max-width: 600px;">
             <div class="modal-header bg-white py-4 d-flex justify-content-between align-items-center border-bottom">
                 <div>
                      <h3 class="mb-0 fw-black text-uppercase text-primary">@(_singleOrderVendorId.HasValue ? "CONFIRM VENDOR ORDER" : "CONFIRM BULK ORDER")</h3>
                      <div class="small text-muted">Please review vendor order totals (estimated cost)</div>
                 </div>
                 <button class="btn-close" @onclick="() => _showOrderConfirm = false"></button>
             </div>
             <div class="modal-body p-4" style="max-height: 60vh; overflow-y: auto;">
                 <div class="order-summary-list mb-4">
                     @foreach (var summary in _orderSummary)
                     {
                         <div class="d-flex justify-content-between align-items-center p-3 bg-light rounded-4 mb-2 border border-light shadow-sm">
                             <div>
                                 <div class="fw-black text-primary text-uppercase small">@summary.VendorName</div>
                                 <div class="extra-small text-muted fw-bold">PROCESSED: @summary.ItemCount BOTTLES/UNITS</div>
                             </div>
                             <div class="text-end">
                                 <div class="fw-black text-dark fs-5">@summary.Total.ToString("C")</div>
                             </div>
                         </div>
                     }
                 </div>
 
                 <div class="p-4 bg-primary text-white rounded-4 text-center shadow">
                     <div class="extra-small opacity-75 fw-black text-uppercase mb-1">Estimated Grand Total</div>
                     <div class="display-6 fw-black">@_orderSummary.Sum(s => s.Total).ToString("C")</div>
                     <div class="fw-bold mt-1" style="font-size: 0.75rem; color: rgba(255,255,255,0.8);">*Estimate only. Excludes taxes, fees, and returned empties.</div>
                 </div>
                               <div class="alert alert-info mt-4 border-0 py-3 rounded-4 shadow-sm">
                       <div class="d-flex align-items-center gap-3">
                          <i class="bi bi-info-circle-fill fs-4 text-primary"></i>
                          <div class="small fw-bold text-dark">Confirming will split your cart into separate vendor orders and record them in "Pending Arrival".</div>
                       </div>
                  </div>

                  @if (_settings?.LiquorEmailEnabled == true)
                  {
                      <div class="card border-0 rounded-4 bg-light p-3 mt-3 shadow-sm border-start border-primary border-4">
                          <div class="d-flex justify-content-between align-items-center mb-3">
                              <div class="d-flex align-items-center gap-2">
                                  <div class="bg-primary bg-opacity-10 p-2 rounded-3">
                                      <i class="bi bi-envelope-paper-fill text-primary"></i>
                                  </div>
                                  <div>
                                      <h6 class="fw-black text-uppercase mb-0 small">Direct Vendor Dispatch</h6>
                                      <div class="extra-small text-muted fw-bold">Electronic order delivery</div>
                                  </div>
                              </div>
                              <div class="form-check form-switch">
                                  <input class="form-check-input" type="checkbox" role="switch" style="cursor: pointer;" @bind="_emailThisOrder">
                                  <label class="form-check-label extra-small fw-black text-primary text-uppercase ms-1">Email Order</label>
                              </div>
                          </div>

                          @if (_emailThisOrder)
                          {
                              <div class="animate-fade-in">
                                  <label class="extra-small fw-black text-muted text-uppercase mb-2 tracking-wider">Special Instructions for Vendor</label>
                                  <textarea class="form-control rounded-3 border-2 p-3 fw-bold bg-white" rows="3" 
                                            placeholder="Example: Gate code is 1234, please leave by the side door..." 
                                            @bind="_orderInstructions"></textarea>
                                  <div class="extra-small text-primary mt-2 fw-bold">
                                      <i class="bi bi-info-circle-fill"></i> This message will be included in the email body.
                                  </div>
                              </div>
                          }
                      </div>
                  }
              </div>
              <div class="modal-footer p-4 bg-light d-flex gap-3">
                  <button class="btn btn-light border fw-bold flex-grow-1 rounded-pill py-3" @onclick="() => _showOrderConfirm = false">CANCEL & EDIT</button>
                  <button class="btn btn-primary fw-black flex-grow-1 shadow rounded-pill py-3" @onclick="ConfirmAndPlaceOrders">@(_singleOrderVendorId.HasValue ? "CONFIRM & PLACE ORDER" : "CONFIRM & PLACE ALL ORDERS")</button>
             </div>
         </div>
     </div>
 }

 <!-- PROFITABILITY GUIDE MODAL -->
 @if (_showProfitGuideModal)
 {
     <div class="modal-backdrop-modern animate-fade-in" style="z-index: 9999;">
         <div class="modal-card animate-slide-up shadow-lg border-info border-top border-5" style="max-width: 800px;">
             <div class="modal-header bg-white py-4 d-flex justify-content-between align-items-center border-bottom px-4">
                 <div class="d-flex align-items-center">
                     <div class="bg-info-subtle p-2 rounded-3 me-3">
                          <i class="bi bi-lightbulb-fill text-info fs-4"></i>
                     </div>
                     <div>
                         <h4 class="mb-0 fw-black text-uppercase tracking-wider text-info">BAR PROFITABILITY GUIDE</h4>
                         <div class="extra-small text-muted fw-bold">Strategic Margin Targets & Pricing Decisions</div>
                     </div>
                 </div>
                 <button class="btn btn-sm btn-outline-secondary rounded-pill px-3 fw-black" @onclick="() => _showProfitGuideModal = false">CLOSE</button>
             </div>
             
             <div class="modal-body p-4 bg-light-subtle" style="max-height: 75vh; overflow-y: auto;">
                 <div class="alert alert-primary rounded-4 border-0 p-3 mb-4 shadow-sm fw-bold small">
                    To keep the club profitable and ensure you aren't losing money to "price creep," you should categorize your inventory into these three margin ranges based on your "Safety Buffer."
                 </div>

                 <!-- 1. SPIRITS -->
                 <div class="card border-0 rounded-4 shadow-sm mb-4 overflow-hidden">
                     <div class="card-header bg-dark text-white p-3 fw-black">1. SPIRITS & LIQUOR (THE PROFIT DRIVERS)</div>
                     <div class="card-body p-3">
                         <p class="small text-muted mb-3">Liquor has the highest markup because it requires the most "overhead" (ice, mixers, glassware, and washing).</p>
                         <table class="table table-sm table-borderless mb-0">
                             <thead>
                                 <tr class="extra-small text-uppercase text-muted fw-bold">
                                     <th>Margin Health</th>
                                     <th>Status</th>
                                     <th>Business Meaning</th>
                                 </tr>
                             </thead>
                             <tbody class="small">
                                 <tr>
                                     <td><span class="badge bg-success-subtle text-success w-100 py-2">80% - 95%</span></td>
                                     <td class="fw-bold">Healthy</td>
                                     <td>Standard for well drinks and mid-shelf (Tito's, Bacardi).</td>
                                 </tr>
                                 <tr>
                                     <td><span class="badge bg-warning-subtle text-warning w-100 py-2">70% - 79%</span></td>
                                     <td class="fw-bold">Warning</td>
                                     <td>Common for "Premium" pours (Jameson, Crown Royal).</td>
                                 </tr>
                                 <tr>
                                     <td><span class="badge bg-danger-subtle text-danger w-100 py-2">Below 70%</span></td>
                                     <td class="fw-bold text-danger">Action</td>
                                     <td>Increase Price. You are "trading dollars" after mixer costs.</td>
                                 </tr>
                             </tbody>
                         </table>
                     </div>
                 </div>

                 <!-- 2. BEER -->
                 <div class="card border-0 rounded-4 shadow-sm mb-4 overflow-hidden">
                     <div class="card-header bg-warning text-dark p-3 fw-black" style="background-color: #fbbf24 !important;">2. DOMESTIC BEER (THE HIGH-VOLUME STAPLES)</div>
                     <div class="card-body p-3">
                         <p class="small text-muted mb-3">Beer is a "low-labor" serve, so you can afford tighter margins, but volume makes drop-offs impactful.</p>
                         <table class="table table-sm table-borderless mb-0">
                             <thead>
                                 <tr class="extra-small text-uppercase text-muted fw-bold">
                                     <th>Margin Health</th>
                                     <th>Status</th>
                                     <th>Business Meaning</th>
                                 </tr>
                             </thead>
                             <tbody class="small">
                                 <tr>
                                     <td><span class="badge bg-success-subtle text-success w-100 py-2">70% - 75%</span></td>
                                     <td class="fw-bold">Healthy</td>
                                     <td>Where your Bud Light sat now ($3.25). Perfect.</td>
                                 </tr>
                                 <tr>
                                     <td><span class="badge bg-warning-subtle text-warning w-100 py-2">60% - 69%</span></td>
                                     <td class="fw-bold">Warning</td>
                                     <td>Happens when "Post-Offs" end. Monitor closely.</td>
                                 </tr>
                                 <tr>
                                     <td><span class="badge bg-danger-subtle text-danger w-100 py-2">Below 60%</span></td>
                                     <td class="fw-bold text-danger">Action</td>
                                     <td>Increase Price. You aren't clearing enough per case to cover costs.</td>
                                 </tr>
                             </tbody>
                         </table>
                     </div>
                 </div>

                 <!-- 3. PREMIUMS -->
                 <div class="card border-0 rounded-4 shadow-sm mb-4 overflow-hidden border-start border-5 border-info">
                     <div class="card-header bg-info text-white p-3 fw-black">3. CANNED "PREMIUMS" (RED BULL, HIGH NOON)</div>
                     <div class="card-body p-3">
                         <p class="small text-muted mb-3">Most dangerous items due to high Unit Cost. If not priced aggressively, they eat overall bar profit.</p>
                         <table class="table table-sm table-borderless mb-0">
                             <thead>
                                 <tr class="extra-small text-uppercase text-muted fw-bold">
                                     <th>Margin Health</th>
                                     <th>Status</th>
                                     <th>Business Meaning</th>
                                 </tr>
                             </thead>
                             <tbody class="small">
                                 <tr>
                                     <td><span class="badge bg-success-subtle text-success w-100 py-2">65% - 75%</span></td>
                                     <td class="fw-bold">Healthy</td>
                                     <td>Target for Red Bull and High Noon.</td>
                                 </tr>
                                 <tr>
                                     <td><span class="badge bg-warning-subtle text-warning w-100 py-2">55% - 64%</span></td>
                                     <td class="fw-bold">Warning</td>
                                     <td>Common if you sell these at "Beer Prices."</td>
                                 </tr>
                                 <tr>
                                     <td><span class="badge bg-danger-subtle text-danger w-100 py-2">Below 55%</span></td>
                                     <td class="fw-bold text-danger">Action</td>
                                     <td>Immediate Hike. These should always be priced higher than beer.</td>
                                 </tr>
                             </tbody>
                         </table>
                     </div>
                 </div>

                 <!-- SUMMARY SUMMARY -->
                 <div class="bg-white p-4 rounded-4 border shadow-sm border-top border-4 border-primary">
                     <h6 class="fw-black text-uppercase mb-3 tracking-wider">Tracker Decision Matrix</h6>
                     <div class="row g-3">
                         <div class="col-md-4">
                             <div class="p-3 bg-light rounded-3 text-center border h-100">
                                 <div class="extra-small fw-black text-warning text-uppercase mb-1">Domestic Beer</div>
                                 <div class="small fw-bold">If Orange (under 65%)</div>
                                 <div class="fw-black text-dark h5 mt-1 mb-0">Raise $0.25</div>
                             </div>
                         </div>
                         <div class="col-md-4">
                             <div class="p-3 bg-light rounded-3 text-center border h-100">
                                 <div class="extra-small fw-black text-warning text-uppercase mb-1">Standard Liquor</div>
                                 <div class="small fw-bold">If Orange (under 75%)</div>
                                 <div class="fw-black text-dark h5 mt-1 mb-0">Raise $0.50</div>
                             </div>
                         </div>
                         <div class="col-md-4">
                             <div class="p-3 bg-light rounded-3 text-center border h-100">
                                 <div class="extra-small fw-black text-danger text-uppercase mb-1">Premiums / Energy</div>
                                 <div class="small fw-bold">If Red (under 55%)</div>
                                 <div class="fw-black text-dark h5 mt-1 mb-0">Raise $1.00</div>
                             </div>
                         </div>
                     </div>
                 </div>
             </div>
             <div class="modal-footer p-3 bg-light">
                 <button class="btn btn-primary w-100 rounded-pill py-2 fw-black shadow" @onclick="() => _showProfitGuideModal = false">I UNDERSTAND</button>
             </div>
         </div>
     </div>
 }
</div>
<style>
    .liquor-hub-container {
        padding: 20px;
        color: #1e293b;
        font-family: 'Inter', sans-serif;
    }

    .fw-extrabold { font-weight: 800; }
    .fw-black { font-weight: 900; }
    
    .nav-pills-modern {
        display: flex;
        gap: 10px;
        overflow-x: auto;
        padding-bottom: 5px;
    }

    .pill-item {
        border: none;
        background: #f1f5f9;
        color: #64748b;
        padding: 10px 20px;
        border-radius: 50px;
        font-weight: 700;
        font-size: 0.9rem;
        display: flex;
        align-items: center;
        gap: 8px;
        white-space: nowrap;
        transition: all 0.2s;
        position: relative;
    }

    .pill-item.active {
        background: #fff;
        color: #0d6efd;
        border: 2px solid #0d6efd;
        box-shadow: 0 4px 12px rgba(13, 110, 253, 0.1);
    }

    .pill-badge {
        font-size: 0.75rem;
        padding: 3px 8px;
        border-radius: 30px;
        color: #fff;
        font-weight: 800;
        margin-left: 5px;
    }

    .stock-pill {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        min-width: 60px;
        padding: 5px 10px;
        border-radius: 12px;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
    }

    .stock-pill.ok { background: #f0fdf4; border-color: #bbf7d0; color: #166534; }
    .stock-pill.low { background: #fffbeb; border-color: #fef3c7; color: #b45309; }
    .stock-pill.empty { background: #fef2f2; border-color: #fee2e2; color: #b91c1c; }

    .stock-label { font-size: 0.6rem; font-weight: 800; opacity: 0.7; letter-spacing: 0.05em; }
    .stock-number { font-size: 1.25rem; font-weight: 900; line-height: 1.1; }

    .order-item-card {
        background: #fff;
        padding: 15px;
        border-radius: 16px;
        border: 1px solid #f1f5f9;
        box-shadow: 0 4px 6px rgba(0,0,0,0.02);
        transition: all 0.2s;
    }

    .order-item-card.low-stock {
        border-left: 4px solid #ef4444;
    }

    .order-item-card.selected-for-order {
        background: #f0f7ff;
        border: 2px solid #0d6efd;
        box-shadow: 0 4px 12px rgba(13, 110, 253, 0.1);
    }

    .item-img {
        width: 50px;
        height: 50px;
        border-radius: 12px;
        background: #f8fafc;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
    }

    .item-img img { width: 100%; height: 100%; object-fit: contain; }
    .item-img i { font-size: 1.5rem; color: #cbd5e1; }

    .quantity-control {
        display: flex;
        align-items: center;
        background: #f8fafc;
        border-radius: 12px;
        padding: 4px;
        border: 1px solid #e2e8f0;
    }

    .qty-input {
        width: 40px;
        border: none;
        background: transparent;
        text-align: center;
        font-weight: 900;
        outline: none;
    }

    /* Hide spin buttons for all number inputs */
    input::-webkit-outer-spin-button,
    input::-webkit-inner-spin-button {
        -webkit-appearance: none;
        margin: 0;
    }
    input[type=number] {
        -moz-appearance: textfield;
    }

    .btn-icon {
        width: 24px;
        height: 24px;
        border-radius: 6px;
        background: #fff;
        border: 1px solid #e2e8f0;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
        padding: 0;
    }

    .vendor-block .vendor-header {
        border-bottom: 2px solid #f1f5f9;
        padding-bottom: 8px;
    }

    .animate-fade-in { animation: fadeIn 0.3s ease forwards; }
    @@keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }

    .modal-backdrop-modern {
        position: fixed;
        inset: 0;
        background: rgba(15, 23, 42, 0.4);
        backdrop-filter: blur(4px);
        z-index: 2000;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .modal-card {
        background: #fff;
        width: 100%;
        max-width: 600px;
        border-radius: 24px;
        overflow: hidden;
    }

    .tracking-wider { letter-spacing: 0.1em; }

    /* Count View Styles */
    .scroll-y-hub::-webkit-scrollbar { width: 4px; }
    .scroll-y-hub::-webkit-scrollbar-thumb { background: #e2e8f0; border-radius: 10px; }
    
