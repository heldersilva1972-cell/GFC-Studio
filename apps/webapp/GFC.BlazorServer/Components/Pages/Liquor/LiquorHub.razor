    private string _activeTab = "ordering";
    private string _activeSetupTab = "email";
    private string _statSortMode = "performance";
    private List<LiquorItem> _items = new();
    private List<LiquorItem> _childItems = new();
    private List<PosCategory> _categories = new();
    private List<LiquorVendor> _vendors = new();
    private List<LiquorOrder> _pendingOrders = new();
    private List<LiquorOrder> _historyOrders = new();
    private Dictionary<int, int> _itemOrderCounts = new();
    private List<LiquorTransaction> _recentTransactions = new();
    private List<LiquorTransaction> _auditHistory = new();
    private DateTime? _lastReconcileDate;
    private string _historySubTab = "orders";
    private int _historyYearFilter = 0;
    private int _historyVendorFilter = 0;
    private string _historyProductSearch = "";
    private int _historyPurchaseProductId = 0;
    private string _analyticsSubTab = "overview";
    private int _analyticsYear = DateTime.Now.Year;
    private HashSet<int> _expandedHistoryOrders = new();
    
    // Monthly Profitability / Pour Cost state
    private int _profitabilityMonth = DateTime.Now.Month;
    private int _profitabilityYear = DateTime.Now.Year;
    private bool _calculatingProfitability = false;
    private decimal _profitSales = 0;
    private decimal _profitPurchases = 0;
    private decimal _profitBegValue = 0;
    private decimal _profitEndValue = 0;
    private decimal _profitCOGS = 0;
    private decimal _profitGrossProfit = 0;
    private decimal _profitPourCost = 0;
    private decimal _profitMargin = 0;
    private List<string> _posCategories = new();
    private HashSet<string> _selectedPosCategories = new();
    private Dictionary<string, decimal> _posCategorySalesTotals = new();
    private bool _hasLoadedPrefs = false;
    private List<string> _availableTerminals = new();
    private string _selectedTerminal = "ALL";
    
    private void ToggleHistoryOrder(int orderId)
    {
        if (_expandedHistoryOrders.Contains(orderId))
            _expandedHistoryOrders.Remove(orderId);
        else
            _expandedHistoryOrders.Add(orderId);
    }
    
    private Dictionary<int, int> _cart = new(); // ItemId -> Quantity

    private void AddItemsToOrderFromPrediction(Dictionary<int, int> itemsToAdd)
    {
        foreach (var kvp in itemsToAdd)
        {
            if (kvp.Value > 0)
            {
                _cart[kvp.Key] = kvp.Value;
            }
        }
        _activeTab = "ordering";
        StateHasChanged();
    }

    private AppUser? _currentUser;
    private bool _showPriceHistoryModal = false;
    private bool _showProfitGuideModal = false;
    private bool _showReviewModal = false;
    private bool _isSaving = false;
