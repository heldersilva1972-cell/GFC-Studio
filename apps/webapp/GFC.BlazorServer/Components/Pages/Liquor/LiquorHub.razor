                                                                 placeholder="re_123456789..." 
                                                                 @bind="_settings.ResendApiKey" />
                                                          <button class="btn btn-outline-secondary border-2 rounded-end-3" type="button" @onclick="() => _showResendKey = !_showResendKey">
                                                              <i class="bi @(_showResendKey ? "bi-eye-slash" : "bi-eye")"></i>
                                                          </button>
                                                      </div>
                                                     <p class="extra-small text-muted mt-2 mb-0">Use your API Key from the Resend.com dashboard.</p>
                                                 </div>
                                             </div>
                                         }
                                         else
                                         {
                                             <div class="animate-fade-in">
                                                 <div class="row g-2 mb-3">
                                                     <div class="col-8">
                                                         <label class="extra-small fw-black text-muted text-uppercase mb-1">Outgoing Host</label>
