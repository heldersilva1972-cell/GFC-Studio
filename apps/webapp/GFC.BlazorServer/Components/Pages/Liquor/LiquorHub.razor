                                         <div class="d-flex align-items-center gap-3">
                                             <div class="bg-primary bg-opacity-10 p-3 rounded-4">
                                                 <i class="bi bi-toggle-on text-primary fs-3"></i>
                                             </div>
                                             <div>
                                                 <h6 class="fw-black text-uppercase mb-0">System Status</h6>
                                                 <p class="extra-small text-muted fw-bold mb-0">Master switch for automation</p>
                                             </div>
                                         </div>
                                         <div class="form-check form-switch fs-4">
                                             <input class="form-check-input" type="checkbox" role="switch" @bind="_settings.LiquorEmailEnabled">
                                         </div>
                                     </div>
                                     
                                     <div class="alert @(_settings.LiquorEmailEnabled ? "alert-success" : "alert-warning") border-0 rounded-4 py-3 shadow-none mb-4">
                                         <div class="d-flex align-items-center gap-3">
                                             <i class="bi @(_settings.LiquorEmailEnabled ? "bi-check-circle-fill" : "bi-exclamation-triangle-fill") fs-4"></i>
                                             <div class="extra-small fw-bold">
                                                 @if (_settings.LiquorEmailEnabled) { <span>System is ARMED. Emails will be prepared for dispatch.</span> }
