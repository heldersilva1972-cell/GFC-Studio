                                                   @bind="_settings.LiquorEmailSignature" @bind:event="oninput" @bind:after="FlagEmailDirty"></textarea>
                                     </div>

                                     <div class="mb-3">
                                         <label class="extra-small fw-black text-muted text-uppercase mb-2 tracking-wider">Email System Footer</label>
                                         <input type="text" class="form-control rounded-pill border-2 px-3 py-2 small fw-bold" 
                                                @bind="_settings.LiquorEmailFooter" @bind:event="oninput" @bind:after="FlagEmailDirty" />
                                     </div>

                                     <div class="mb-4">
                                         <label class="extra-small fw-black text-muted text-uppercase mb-1">CC Notifications</label>
                                         <input type="email" class="form-control form-control-sm border-2 rounded-3 fw-bold" @bind="_settings.LiquorEmailCc" @bind:event="oninput" @bind:after="FlagEmailDirty" />
                                     </div>

                                     <div class="mt-auto">
                                         <button class="btn btn-primary w-100 rounded-pill fw-black py-3 shadow hover-lift transition-base" @onclick="SaveEmailSettingsAsync" disabled="@_isSaving">
                                             @if (_isSaving) { <span class="spinner-border spinner-border-sm me-2"></span> }
                                             <i class="bi bi-shield-check me-2"></i> SAVE EMAIL LOGIC
                                         </button>
                                     </div>
                                 </div>
                             </div>
                        </div>
                    } 
                    else if (_activeSetupTab == "settings") 
                    {
                        <div class="d-flex justify-content-between align-items-center animate-slide-down mb-4">
