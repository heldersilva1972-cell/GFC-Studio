    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrEmpty(Tab)) _activeTab = Tab;
        
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        if (user.Identity?.IsAuthenticated == true)
        {
             var userIdStr = user.FindFirst("UserId")?.Value 
                          ?? user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value
                          ?? user.FindFirst("sub")?.Value;
                           
             if (int.TryParse(userIdStr, out var userId))
             {
                 _currentUser = new AppUser { Username = user.Identity.Name ?? "Staff", UserId = userId };
             }
             else
             {
                 var idClaim = user.Claims.FirstOrDefault(c => c.ValueType == System.Security.Claims.ClaimValueTypes.Integer || c.Type.Contains("id", StringComparison.OrdinalIgnoreCase));
                 if (idClaim != null && int.TryParse(idClaim.Value, out var fallbackId))
                 {
                     _currentUser = new AppUser { Username = user.Identity.Name ?? "Staff", UserId = fallbackId };
                 }
             }
        }
        _settings = await SystemSettingsService.GetAsync();
        await RefreshDataAsync();
    }

    private async Task RefreshDataAsync()
    {
        _isLoading = true;
        
        var allItems = await LiquorService.GetAllItemsAsync();
        _items = allItems.ToList();
        
        var allVendors = await LiquorService.GetAllVendorsAsync();
        _vendors = allVendors.ToList();
        
        var allOrders = await LiquorService.GetAllOrdersAsync();
        _pendingOrders = allOrders.Where(o => o.Status == "Placed").ToList();
        _historyOrders = allOrders.Where(o => o.Status != "Placed").OrderByDescending(o => o.OrderDate).ToList();
        
        // Calculate order counts for performance metrics
        _itemOrderCounts = _historyOrders
            .SelectMany(o => o.OrderItems)
            .GroupBy(i => i.LiquorItemId)
            .ToDictionary(g => g.Key, g => g.Sum(x => x.Quantity));
        
        _pendingBackorders = (await LiquorService.GetPendingBackordersAsync()).ToList();

        // Fetch a larger set for audit purposes (Price changes)
        var recentTx = await LiquorService.GetRecentTransactionsAsync(500);
        _recentTransactions = recentTx.ToList();
        _auditHistory = _recentTransactions; 
        
        _isLoading = false;
        StateHasChanged();
    }

    // -- Stock Count Logic --

    private void SelectCountItem(LiquorItem item)
    {
        _selectedCountItem = item;
        _countEntry = _stockCounts.ContainsKey(item.Id) ? _stockCounts[item.Id].ToString() : "0";
    }

    private void MatchExpectedStock(LiquorItem item)
    {
        _stockCounts[item.Id] = item.CurrentStock;
        StateHasChanged();
    }

    private void HandleNumpad(string key)
    {
        if (key == "C") _countEntry = "0";
        else if (key == "DEL") 
        {
            if (_countEntry.Length > 1) _countEntry = _countEntry.Substring(0, _countEntry.Length -1);
            else _countEntry = "0";
        }
        else
        {
            if (_countEntry == "0") _countEntry = key;
            else if (_countEntry.Length < 4) _countEntry += key;
        }
    }

    private void ConfirmSingleCount()
    {
        if (_selectedCountItem == null) return;
        if (int.TryParse(_countEntry, out var val))
        {
            _stockCounts[_selectedCountItem.Id] = val;
            _selectedCountItem = null;
            _countEntry = "0";
        }
    }

    private async Task SubmitFullReconciliation()
    {
        if (!_stockCounts.Any() || _currentUser == null) return;
        
        var auditEntries = _stockCounts.Select(kvp => new GFC.Core.Models.StockReconcileEntry 
        { 
            ItemId = kvp.Key, 
            ActualCount = kvp.Value 
        }).ToList();

        await LiquorService.ReconcileStockAsync(auditEntries, _currentUser.UserId);
        
        _stockCounts.Clear();
        await RefreshDataAsync();
        _activeTab = "ordering"; // Head back to see what's low now
    }

    // -- Ordering Logic --

    private int GetCartQuantity(int itemId) => _cart.ContainsKey(itemId) ? _cart[itemId] : 0;

    private void SetCartQuantity(int itemId, object val)
    {
        if (int.TryParse(val?.ToString(), out var qty))
        {
            _cart[itemId] = Math.Max(0, qty);
        }
    }

    private void AdjustCartQuantity(int itemId, int delta)
    {
        var current = GetCartQuantity(itemId);
        _cart[itemId] = Math.Max(0, current + delta);
    }

    private decimal GetCartTotal()
    {
        decimal total = 0;
        foreach (var entry in _cart.Where(e => e.Value > 0))
        {
            var item = _items.FirstOrDefault(i => i.Id == entry.Key);
            if (item != null) 
            {
                total += item.CurrentPrice * entry.Value;
                if (item.IsBeer) total += (0.05m * item.PackSize) * entry.Value;
            }
        }
        return total;
    }

    private int? _singleOrderVendorId = null;
    private void ShowOrderConfirmation(int? vendorId = null)
    {
        _singleOrderVendorId = vendorId;
        if (!_cart.Any(v => v.Value > 0)) return;
        _orderSummary.Clear();

        var cartItems = _cart.Where(e => e.Value > 0)
            .Select(e => new { Item = _items.FirstOrDefault(i => i.Id == e.Key), Qty = e.Value })
            .Where(x => x.Item != null && (!vendorId.HasValue || x.Item.VendorId == vendorId.Value))
            .ToList();

        foreach (var vGroup in cartItems.GroupBy(x => x.Item!.Vendor))
        {
            decimal vTotal = 0;
            int vQty = 0;
            foreach (var x in vGroup)
            {
                vTotal += x.Item!.CurrentPrice * x.Qty;
                if (x.Item.IsBeer) vTotal += (0.05m * x.Item.PackSize) * x.Qty;
                vQty += x.Qty;
            }

            _orderSummary.Add(new OrderConfirmationSummary {
                VendorName = vGroup.Key?.Name ?? "Unknown",
                ItemCount = vQty,
                Total = vTotal
            });
        }

        if (_orderSummary.Any())
        {
            _showOrderConfirm = true;
            StateHasChanged();
        }
    }

    private async Task ConfirmAndPlaceOrders()
    {
        _showOrderConfirm = false;
        
        // Group cart by Vendor
        var itemsInCart = _cart.Where(e => e.Value > 0).ToList();
        
        if (_singleOrderVendorId.HasValue)
        {
            var vendorId = _singleOrderVendorId.Value;
            var vendorItems = itemsInCart
                .Select(e => _items.FirstOrDefault(i => i.Id == e.Key))
                .Where(i => i != null && i.VendorId == vendorId)
                .ToList();
            
            await PlaceVendorOrderAsync(_vendors.FirstOrDefault(v => v.Id == vendorId), vendorItems!, _emailThisOrder);
            _singleOrderVendorId = null;
        }
        else
        {
            var cartByVendor = itemsInCart
                .GroupBy(e => _items.FirstOrDefault(i => i.Id == e.Key)?.VendorId)
                .Where(g => g.Key.HasValue)
                .ToList();

            foreach (var vendorGroup in cartByVendor)
            {
                var vendorId = vendorGroup.Key!.Value;
                var vendorItems = vendorGroup.Select(e => _items.First(i => i.Id == e.Key)).ToList();
                await PlaceVendorOrderAsync(_vendors.FirstOrDefault(v => v.Id == vendorId), vendorItems, _emailThisOrder);
            }
        }
        
        // Reset email state
        _emailThisOrder = false;
        _orderInstructions = "";
        
        await RefreshDataAsync();
        _activeTab = "active";
        StateHasChanged();
    }

    private async Task SubmitOrderAsync()
