    private async Task TogglePosCategory(string categoryName, ChangeEventArgs e)
    {
        bool isChecked = (bool)(e.Value ?? false);
        if (isChecked)
            _selectedPosCategories.Add(categoryName);
        else
            _selectedPosCategories.Remove(categoryName);

        // Save to LocalStorage
        try
        {
            var json = System.Text.Json.JsonSerializer.Serialize(_selectedPosCategories.ToList());
            await JSRuntime.InvokeVoidAsync("localStorage.setItem", "gfc_liquor_profit_selected_categories", json);
            _hasLoadedPrefs = true;
        }
        catch { }

        // Recalculate profit sales from category totals in memory
        _profitSales = _posCategorySalesTotals
            .Where(kvp => _selectedPosCategories.Contains(kvp.Key))
            .Sum(kvp => kvp.Value);

        // Re-compute COGS and Pour Cost
        _profitCOGS = _profitBegValue + _profitPurchases - _profitEndValue;
        if (_profitCOGS < 0) _profitCOGS = 0;

        _profitGrossProfit = _profitSales - _profitCOGS;
        _profitPourCost = _profitSales > 0 ? (_profitCOGS / _profitSales) * 100 : 0;
        _profitMargin = _profitSales > 0 ? (_profitGrossProfit / _profitSales) * 100 : 0;
        
        StateHasChanged();
    }
