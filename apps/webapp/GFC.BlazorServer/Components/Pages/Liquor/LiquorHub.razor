    private async Task SaveEmailSettingsAsync()
    {
        if (_settings == null) return;

        // Server-side validation for Resend Key
        if (_settings.EmailProvider == EmailProvider.Resend && !string.IsNullOrEmpty(_settings.ResendApiKey))
        {
            if (!_settings.ResendApiKey.StartsWith("re_"))
            {
                TriggerError("INVALID KEY", "Resend API Keys must follow the standard format starting with 're_'.");
                return;
            }
        }

        try {
            await SystemSettingsService.UpdateAsync(_settings);
            TriggerSuccess("SETTINGS SAVED", "Liquor Email Configuration has been updated.");
        }
        catch (Exception ex) {
            Console.WriteLine($"Error saving email settings: {ex.Message}");
            TriggerError("SAVE FAILED", $"Configuration error: {ex.Message}");
        }
        finally {

        }
    }

