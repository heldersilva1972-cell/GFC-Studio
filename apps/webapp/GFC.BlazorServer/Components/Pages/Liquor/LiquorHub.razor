                                         <div class="d-flex gap-2 p-1 bg-light rounded-pill border mb-4">
                                             <button class="btn btn-sm rounded-pill flex-grow-1 @(_settings.EmailProvider == GFC.Core.Enums.EmailProvider.SMTP ? "btn-dark shadow-sm fw-black" : "btn-link text-muted text-decoration-none fw-bold")" 
