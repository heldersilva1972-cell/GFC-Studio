                                <div class="col-md-6">
                                    <div class="p-4 bg-light rounded-4 border text-center shadow-inner">
                                        <h6 class="extra-small text-muted fw-bold text-uppercase mb-2">Total Liquor Expenses for @_analyticsYear</h6>
                                        <h1 class="fw-black mb-0 text-danger">@totalSpent.ToString("C")</h1>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="p-4 bg-light rounded-4 border text-center shadow-inner">
                                        <h6 class="extra-small text-muted fw-bold text-uppercase mb-2">Total Units Purchased in @_analyticsYear</h6>
                                        <h1 class="fw-black mb-0 text-primary">@totalUnits</h1>
                                    </div>
                                </div>
                            </div>

                            <div class="table-responsive">
                                <table class="table table-hover align-middle">
                                    <thead class="bg-light sticky-top" style="z-index: 10;">
                                        <tr class="extra-small text-muted text-uppercase tracking-wider">
                                            <th class="ps-3">Product Name</th>
                                            <th class="text-center">Annual Quantity Ordered</th>
                                            <th class="text-end pe-3">Total Capital Spent</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (!itemStats.Any())
                                        {
                                            <tr><td colspan="3" class="text-center py-5 text-muted fw-bold">No completed orders found for @_analyticsYear.</td></tr>
                                        }
                                        @foreach (var stat in itemStats)
                                        {
                                            <tr>
                                                <td class="fw-bold text-dark ps-3">
                                                    @stat.Item.Name
                                                    <div class="extra-small text-muted">@stat.Item.BottleSize</div>
                                                </td>
