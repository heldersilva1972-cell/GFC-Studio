                             <div class="col-lg-6">
                                 <div class="card border-0 rounded-4 p-4 h-100 shadow-sm">
                                     <div class="mb-3">
                                         <label class="extra-small fw-black text-muted text-uppercase mb-2 tracking-wider">Manager Signature Note</label>
