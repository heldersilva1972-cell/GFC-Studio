    private async Task ResendOrderEmailAsync(LiquorOrder order)
    {
        if (order.Vendor == null || string.IsNullOrEmpty(order.Vendor.Email))
        {
            TriggerError("MISSING EMAIL", "This vendor does not have a registered email address.");
            return;
        }

        try 
        {
            _emailErrorMessage = "";
            // Re-fetch vendor to be sure we have the latest
            var vendor = _vendors.FirstOrDefault(v => v.Id == order.VendorId);
            if (vendor == null) return;

            var result = await LiquorService.ResendOrderEmailAsync(order.Id);
            
            if (result.Success)
            {
                TriggerSuccess("EMAIL RESENT", $"The order form has been resent to {vendor.Email}");
                await RefreshDataAsync();
            }
            else
            {
                _emailErrorMessage = result.ErrorMessage ?? "Unknown delivery failure.";
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[LIQUOR HUB ERROR] {DateTime.Now}: {ex}");
            _emailErrorMessage = $"Internal Error: {ex.Message}";
            StateHasChanged();
        }
    }

    private async Task TestConnectionAsync()
    {
        if (_settings == null) return;
        
        // Validation check before test
        if (_settings.EmailProvider == EmailProvider.Resend && !string.IsNullOrEmpty(_settings.ResendApiKey) && !_settings.ResendApiKey.StartsWith("re_"))
        {
            _testConnectionSuccess = false;
            _testConnectionMessage = "Invalid API Key format. Must start with 're_'";
            return;
        }

        _isTestingConnection = true;
        _testConnectionMessage = "";
        StateHasChanged();

        try
        {
            var result = await SystemSettingsService.TestEmailConnectionAsync(_settings);
            _testConnectionSuccess = result.Success;
            _testConnectionMessage = result.Message;
        }
        catch (Exception ex)
        {
            _testConnectionSuccess = false;
            _testConnectionMessage = $"Connection failed: {ex.Message}";
        }
        finally
        {
            _isTestingConnection = false;
            StateHasChanged();
        }
    }
