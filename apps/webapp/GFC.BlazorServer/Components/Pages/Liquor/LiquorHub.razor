    private async Task ConfirmReceiptAsync()
    {
        if (_orderToReceive == null || _currentUser == null) return;
        
        // Final sanity check for mandatory fields
        if (string.IsNullOrWhiteSpace(_receiveInvoiceNumber) || _receiveTotalDue <= 0) return;
        
        // Calculate discrepancy (Tax + Fees) on RECEIVED items only
        var receivedItemsTotal = _orderToReceive.OrderItems.Where(i => !i.IsBackordered).Sum(i => i.UnitPriceAtTimeOfOrder * i.Quantity);
        var additionalCosts = _receiveTotalDue - receivedItemsTotal;
        
        // 0. Save backorder status
        var backorderedIds = _orderToReceive.OrderItems.Where(i => i.IsBackordered).Select(i => i.Id).ToList();
        await LiquorService.UpdateOrderItemsBackorderAsync(_orderToReceive.Id, backorderedIds);

        // 1. Update order meta
        await LiquorService.UpdateOrderStatusAsync(_orderToReceive.Id, "Received", _receiveInvoiceNumber, 0, additionalCosts);
        
        // 2. Process stock arrival (Skips backordered items based on updated DB state)
        await LiquorService.ReceiveOrderAsync(_orderToReceive.Id, _currentUser.UserId);
        
        _orderToReceive = null;
        await RefreshDataAsync();
        
        // Custom Confirmation
        TriggerSuccess("ORDER RECEIVED", "Inventory has been updated and the invoice recorded.");
        
        _activeTab = null; // Back to Dashboard
    }

