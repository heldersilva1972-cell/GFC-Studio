@page "/liquor/hub"
@using GFC.Core.Interfaces
@using GFC.Core.Models
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components
@using GFC.BlazorServer.Auth
@attribute [Authorize]
@inject ILiquorService LiquorService
@inject IJSRuntime JSRuntime
@inject GFC.BlazorServer.Services.IBlazorSystemSettingsService SystemSettingsService
@inject CustomAuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavigationManager
@implements IDisposable
<PageTitle>Liquor Hub | GFC</PageTitle>

<!-- Price Log Modal -->
@if (_showPriceHistoryModal)
{
    <div class="modal d-block animate-fade-in" style="background: rgba(0,0,0,0.6); backdrop-filter: blur(8px); z-index: 9999;">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="modal-header bg-white text-dark p-4 border-bottom">
                    <div>
                        <h4 class="modal-title fw-black mb-0 text-dark"><i class="bi bi-clock-history me-2 text-primary"></i>Financial Audit Log</h4>
                        <p class="text-muted small mb-0 mt-1">Timeline of recent bottle cost and drink price adjustments.</p>
                    </div>
                    <button type="button" class="btn-close" @onclick="() => _showPriceHistoryModal = false"></button>
                </div>
                <div class="modal-body p-0" style="max-height: 70vh; overflow-y: auto; background: #ffffff;">
                    @if (!_auditHistory.Any(l => l.TransactionType == "Update"))
                    {
                        <div class="p-5 text-center text-muted">
                            <i class="bi bi-calendar-x display-4 opacity-25"></i>
                            <h5 class="mt-3">No price history found.</h5>
                            <p class="small">New price updates will be logged here automatically.</p>
                        </div>
                    }
                    else
                    {
                        <div class="p-4">
                            @foreach (var log in _auditHistory.Where(l => l.TransactionType == "Update").OrderByDescending(l => l.Timestamp))
                            {
                                <div class="card border-0 shadow-sm rounded-4 mb-3 p-3 hover-lift transition-base border-start border-4 @(log.Notes?.Contains("Cost") == true ? "border-primary" : "border-info")">
                                    <div class="row align-items-center">
                                        <div class="col-md-5">
                                            <div class="d-flex align-items-center">
                                                    <div class="rounded-3 p-2 me-3" style="background: @(log.Notes?.Contains("Cost") == true ? "#eff6ff" : "#ecfeff");">
                                                    <i class="bi @(log.Notes?.Contains("Cost") == true ? "bi-cash-coin text-primary" : "bi-receipt text-info")" style="font-size: 1.5rem;"></i>
                                                </div>
                                                <div>
                                                    <div class="fw-black">@log.Item?.Name</div>
                                                    <div class="extra-small text-muted text-uppercase tracking-wider">@log.Item?.BottleSize</div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                                <div class="rounded-3 p-2 px-3 small border border-1" style="background: @(log.Notes?.Contains("Cost") == true ? "#f8fafc" : "#f0f9ff");">
                                                <span class="fw-bold d-block text-muted" style="font-size: 0.6rem;">MODIFICATION DETAILS</span>
                                                <span class="text-dark fw-bold">@log.Notes</span>
                                            </div>
                                        </div>
                                        <div class="col-md-3 text-end">
                                            <div class="fw-black text-dark" style="font-size: 0.75rem;">@log.Timestamp.ToLocalTime().ToString("MMM dd, yyyy")</div>
                                            <div class="extra-small text-muted mt-1">
                                                By <span class="fw-bold">@(log.User?.Username ?? "Staff")</span>
                                                <span class="opacity-50 ms-1 px-2 py-0 bg-white rounded-pill border">ID: @log.UserId</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
                <div class="modal-footer bg-white p-3 border-top d-flex justify-content-between align-items-center">
                        <div class="small text-muted">
                        Connected as: <span class="fw-black text-dark">@(_currentUser?.Username ?? "Staff")</span> (ID: #@(_currentUser?.UserId.ToString() ?? "0"))
                    </div>
                        <button class="btn btn-primary px-5 rounded-pill fw-black shadow" @onclick="() => _showPriceHistoryModal = false">CLOSE LOG</button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Success Confirmation Modal -->
@if (_showSuccessModal)
{
    <div class="modal d-block animate-fade-in" style="background: rgba(0,0,0,0.5); backdrop-filter: blur(8px); z-index: 10000;">
        <div class="modal-dialog modal-sm modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg rounded-4 p-4 text-center bg-white">
                <div class="mb-4 mt-2">
                    <i class="bi bi-check-circle-fill text-success display-2"></i>
                </div>
                <h3 class="fw-black text-dark mb-2 text-uppercase tracking-wider">@_successTitle</h3>
                <p class="text-muted fw-bold mb-4">@_successMessage</p>
                <button class="btn btn-success btn-lg w-100 rounded-pill fw-black shadow-sm" @onclick="() => CloseSuccess()">
                    GOT IT
                </button>
            </div>
        </div>
    </div>
}

<!-- PROFITABILITY GUIDE MODAL -->
@if (_showProfitGuideModal)
{
    <div class="modal-backdrop-modern animate-fade-in" style="z-index: 9999;">
        <div class="modal-card animate-slide-up shadow-lg border-info border-top border-5" style="max-width: 800px;">
            <div class="modal-header bg-white py-4 d-flex justify-content-between align-items-center border-bottom px-4">
                <div class="d-flex align-items-center">
                    <div class="bg-info-subtle p-2 rounded-3 me-3">
                            <i class="bi bi-lightbulb-fill text-info fs-4"></i>
                    </div>
                    <div>
                        <h4 class="mb-0 fw-black text-uppercase tracking-wider text-info">BAR PROFITABILITY GUIDE</h4>
                        <div class="extra-small text-muted fw-bold">Strategic Margin Targets & Pricing Decisions</div>
                    </div>
                </div>
                <button class="btn btn-sm btn-outline-secondary rounded-pill px-3 fw-black" @onclick="() => _showProfitGuideModal = false">CLOSE</button>
            </div>
            
            <div class="modal-body p-4 bg-light-subtle" style="max-height: 75vh; overflow-y: auto;">
                <div class="alert alert-primary rounded-4 border-0 p-3 mb-4 shadow-sm fw-bold small">
                    To keep the club profitable and ensure you aren't losing money to "price creep," you should categorize your inventory into these three margin ranges based on your "Safety Buffer."
                </div>

                <!-- 1. SPIRITS -->
                <div class="card border-0 rounded-4 shadow-sm mb-4 overflow-hidden">
                    <div class="card-header bg-dark text-white p-3 fw-black">1. SPIRITS & LIQUOR (THE PROFIT DRIVERS)</div>
                    <div class="card-body p-3">
                        <p class="small text-muted mb-3">Liquor has the highest markup because it requires the most "overhead" (ice, mixers, glassware, and washing).</p>
                        <table class="table table-sm table-borderless mb-0">
                            <thead>
                                <tr class="extra-small text-uppercase text-muted fw-bold">
                                    <th>Margin Health</th>
                                    <th>Status</th>
                                    <th>Business Meaning</th>
                                </tr>
                            </thead>
                            <tbody class="small">
                                <tr>
                                    <td><span class="badge bg-success-subtle text-success w-100 py-2">80% - 95%</span></td>
                                    <td class="fw-bold">Healthy</td>
                                    <td>Standard for well drinks and mid-shelf (Tito's, Bacardi).</td>
                                </tr>
                                <tr>
                                    <td><span class="badge bg-warning-subtle text-warning w-100 py-2">70% - 79%</span></td>
                                    <td class="fw-bold">Warning</td>
                                    <td>Common for "Premium" pours (Jameson, Crown Royal).</td>
                                </tr>
                                <tr>
                                    <td><span class="badge bg-danger-subtle text-danger w-100 py-2">Below 70%</span></td>
                                    <td class="fw-bold text-danger">Action</td>
                                    <td>Increase Price. You are "trading dollars" after mixer costs.</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- 2. BEER -->
                <div class="card border-0 rounded-4 shadow-sm mb-4 overflow-hidden">
                    <div class="card-header bg-warning text-dark p-3 fw-black" style="background-color: #fbbf24 !important;">2. DOMESTIC BEER (THE HIGH-VOLUME STAPLES)</div>
                    <div class="card-body p-3">
                        <p class="small text-muted mb-3">Beer is a "low-labor" serve, so you can afford tighter margins, but volume makes drop-offs impactful.</p>
                        <table class="table table-sm table-borderless mb-0">
                            <thead>
                                <tr class="extra-small text-uppercase text-muted fw-bold">
                                    <th>Margin Health</th>
                                    <th>Status</th>
                                    <th>Business Meaning</th>
                                </tr>
                            </thead>
                            <tbody class="small">
                                <tr>
                                    <td><span class="badge bg-success-subtle text-success w-100 py-2">70% - 75%</span></td>
                                    <td class="fw-bold">Healthy</td>
                                    <td>Where your Bud Light sat now ($3.25). Perfect.</td>
                                </tr>
                                <tr>
                                    <td><span class="badge bg-warning-subtle text-warning w-100 py-2">60% - 69%</span></td>
                                    <td class="fw-bold">Warning</td>
                                    <td>Happens when "Post-Offs" end. Monitor closely.</td>
                                </tr>
                                <tr>
                                    <td><span class="badge bg-danger-subtle text-danger w-100 py-2">Below 60%</span></td>
                                    <td class="fw-bold text-danger">Action</td>
                                    <td>Increase Price. You aren't clearing enough per case to cover costs.</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- 3. PREMIUMS -->
                <div class="card border-0 rounded-4 shadow-sm mb-4 overflow-hidden border-start border-5 border-info">
                    <div class="card-header bg-info text-white p-3 fw-black">3. CANNED "PREMIUMS" (RED BULL, HIGH NOON)</div>
                    <div class="card-body p-3">
                        <p class="small text-muted mb-3">Most dangerous items due to high Unit Cost. If not priced aggressively, they eat overall bar profit.</p>
                        <table class="table table-sm table-borderless mb-0">
                            <thead>
                                <tr class="extra-small text-uppercase text-muted fw-bold">
                                    <th>Margin Health</th>
                                    <th>Status</th>
                                    <th>Business Meaning</th>
                                </tr>
                            </thead>
                            <tbody class="small">
                                <tr>
                                    <td><span class="badge bg-success-subtle text-success w-100 py-2">65% - 75%</span></td>
                                    <td class="fw-bold">Healthy</td>
                                    <td>Target for Red Bull and High Noon.</td>
                                </tr>
                                <tr>
                                    <td><span class="badge bg-warning-subtle text-warning w-100 py-2">55% - 64%</span></td>
                                    <td class="fw-bold">Warning</td>
                                    <td>Common if you sell these at "Beer Prices."</td>
                                </tr>
                                <tr>
                                    <td><span class="badge bg-danger-subtle text-danger w-100 py-2">Below 55%</span></td>
                                    <td class="fw-bold text-danger">Action</td>
                                    <td>Immediate Hike. These should always be priced higher than beer.</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- SUMMARY SUMMARY -->
                <div class="bg-white p-4 rounded-4 border shadow-sm border-top border-4 border-primary">
                    <h6 class="fw-black text-uppercase mb-3 tracking-wider">Tracker Decision Matrix</h6>
                    <div class="row g-3">
                        <div class="col-md-4">
                            <div class="p-3 bg-light rounded-3 text-center border h-100">
                                <div class="extra-small fw-black text-warning text-uppercase mb-1">Domestic Beer</div>
                                <div class="small fw-bold">If Orange (under 65%)</div>
                                <div class="fw-black text-dark h5 mt-1 mb-0">Raise $0.25</div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="p-3 bg-light rounded-3 text-center border h-100">
                                <div class="extra-small fw-black text-warning text-uppercase mb-1">Standard Liquor</div>
                                <div class="small fw-bold">If Orange (under 75%)</div>
                                <div class="fw-black text-dark h5 mt-1 mb-0">Raise $0.50</div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="p-3 bg-light rounded-3 text-center border h-100">
                                <div class="extra-small fw-black text-danger text-uppercase mb-1">Premiums / Energy</div>
                                <div class="small fw-bold">If Red (under 55%)</div>
                                <div class="fw-black text-dark h5 mt-1 mb-0">Raise $1.00</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer p-3 bg-light">
                <button class="btn btn-primary w-100 rounded-pill py-2 fw-black shadow" @onclick="() => _showProfitGuideModal = false">I UNDERSTAND</button>
            </div>
        </div>
    </div>
}

<!-- ADD ITEM MODAL -->
@if (_showAddItemModal)
{
    <div class="modal-backdrop-modern animate-fade-in shadow-lg">
        <div class="modal-card animate-slide-up shadow-lg" style="max-width: 500px; border: none;">
            <div class="modal-header bg-white py-4 d-flex justify-content-between align-items-center px-4 border-bottom border-2">
                <div class="d-flex align-items-center">
                    <div class="bg-primary-subtle p-2 rounded-3 me-3">
                         <i class="bi bi-plus-circle-fill text-primary fs-4"></i>
                    </div>
                    <h4 class="mb-0 fw-black text-uppercase tracking-wider text-primary">ADD NEW PRODUCT</h4>
                </div>
                <button class="btn btn-sm btn-outline-secondary rounded-pill px-3 fw-black" @onclick="() => _showAddItemModal = false">CLOSE</button>
            </div>
            <div class="modal-body p-4 bg-light-subtle">
                <div class="row g-3">
                    <div class="col-12">
                        <label class="small fw-bold text-muted mb-1">Product Name</label>
                        <input type="text" class="form-control rounded-pill border-2" @bind="_newItem.Name" placeholder="e.g. Grey Goose" />
                    </div>
                    <div class="col-6">
                        <label class="small fw-bold text-muted mb-1">Bottle/Can Size</label>
                        <select class="form-select rounded-pill border-2" @bind="_newItem.BottleSize">
                            <option value="">-- Choose Size --</option>
                            <option value="50ml">50ml</option>
                            <option value="187ml">187ml</option>
                            <option value="355ml">355ml</option>
                            <option value="375ml">375ml</option>
                            <option value="750ml">750ml</option>
                            <option value="1L">1L</option>
                            <option value="1.75L">1.75L</option>
                            <option value="12oz">12oz (Can/Bottle)</option>
                            <option value="16oz">16oz (Pint)</option>
                        </select>
                    </div>
                    <div class="col-6">
                        <label class="small fw-bold text-muted mb-1">Pack Size</label>
                        <input type="number" class="form-control rounded-pill border-2" onfocus="this.select();" @bind="_newItem.PackSize" />
                    </div>

                    <div class="col-12">
                         <div class="form-check form-switch bg-light p-3 rounded-pill border ms-0">
                            <input class="form-check-input ms-0 me-2" type="checkbox" id="isUnitBasedNew" @bind="_newItem.IsUnitBased">
                            <label class="form-check-label fw-bold text-dark small" for="isUnitBasedNew">
                                Sold by Unit (e.g., Red Bull, High Noon, Beer)
                            </label>
                        </div>
                    </div>

                    @if (_newItem.IsUnitBased)
                    {
                        <div class="col-12">
                             <div class="alert alert-info rounded-4 border-0 d-flex align-items-center gap-3 py-3 mb-2 animate-fade-in shadow-sm">
                                 <div class="bg-white p-2 rounded-3 text-info shadow-sm">
                                     <i class="bi bi-box-seam-fill fs-5"></i>
                                 </div>
                                 <div>
                                     <div class="fw-black text-uppercase text-info mb-1" style="font-size: 0.65rem;">Pack Size Required</div>
                                     <p class="mb-0 text-muted fw-bold" style="font-size: 0.6rem; line-height: 1.2;">Please specify how many individual units come in a case (e.g. 24 for beer cases) in the Pack Size field above.</p>
                                 </div>
                             </div>
                        </div>
                    }

                    <div class="col-12">
                        <label class="small fw-bold text-muted mb-1">Primary Vendor</label>
                        <select class="form-select rounded-pill border-2" @bind="_newItem.VendorId">
                            <option value="">-- No Vendor --</option>
                            @foreach (var v in _vendors) { <option value="@v.Id">@v.Name</option> }
                        </select>
                    </div>

                    <div class="col-6">
                        <label class="small fw-bold text-muted mb-1">Min Stock Limit</label>
                        <input type="number" class="form-control rounded-pill border-2" onfocus="this.select();" @bind="_newItem.MinStockLimit" />
                    </div>
                    <div class="col-6">
                        <label class="small fw-bold text-muted mb-1">Bottle/Case Cost ($)</label>
                        <input type="number" class="form-control rounded-pill border-2" onfocus="this.select();" @bind="_newItem.CurrentPrice" step="0.01" />
                    </div>

                    <div class="col-6">
                        <label class="small fw-bold text-muted mb-1">Min Order Qty</label>
                        <input type="number" class="form-control rounded-pill border-2" onfocus="this.select();" @bind="_newItem.MinimumOrderQuantity" />
                    </div>
                    <div class="col-6">
                        <label class="small fw-bold text-muted mb-1">Drink Price ($)</label>
                        <input type="number" class="form-control rounded-pill border-2" onfocus="this.select();" @bind="_newItem.RetailPrice" step="0.01" />
                    </div>

                    <div class="col-6">
                        <label class="small fw-bold text-muted mb-1">Shot oz</label>
                        <input type="number" class="form-control rounded-pill border-2" onfocus="this.select();" @bind="_newItem.PourSize" step="0.1" disabled="@_newItem.IsUnitBased" />
                    </div>

                    <div class="col-12 mt-2">
                        <div class="bg-light p-3 rounded-4 border">
                            <div class="form-check form-switch p-0 d-flex align-items-center justify-content-between mb-2">
                                <div>
                                    <h6 class="fw-black text-uppercase mb-0" style="font-size: 0.75rem;">Product is Active</h6>
                                    <p class="extra-small text-muted mb-0" style="font-size: 0.65rem;">Uncheck to hide from inventory lists</p>
                                </div>
                                <input class="form-check-input ms-0" type="checkbox" style="width: 40px; height: 20px;" @bind="_newItem.IsActive" id="itemActiveCheckNew">
                            </div>

                            <div class="form-check form-switch p-0 d-flex align-items-center justify-content-between">
                                <div>
                                    <h6 class="fw-black text-uppercase mb-0 text-primary" style="font-size: 0.75rem;">Product is Beer</h6>
                                    <p class="extra-small text-muted mb-0" style="font-size: 0.65rem;">Adds bottle return fee on orders</p>
                                </div>
                                <input class="form-check-input ms-0" type="checkbox" style="width: 40px; height: 20px;" @bind="_newItem.IsBeer" id="itemBeerCheckNew">
                            </div>
                        </div>
                    </div>
                </div>
                <button class="btn btn-primary w-100 rounded-pill fw-black py-3 mt-4 shadow" @onclick="() => CreateItemAsync()">CREATE PRODUCT RECORD</button>
            </div>
        </div>
    </div>
}

<!-- EDIT ITEM MODAL -->
@if (_itemToEdit != null)
{
    <div class="modal-backdrop-modern animate-fade-in shadow-lg">
        <div class="modal-card animate-slide-up shadow-lg" style="max-width: 600px; border: none;">
            <div class="modal-header bg-white py-4 d-flex justify-content-between align-items-center px-4 border-bottom border-2">
                <div class="d-flex align-items-center">
                    <div class="bg-info-subtle p-2 rounded-3 me-3">
                         <i class="bi bi-pencil-square text-info fs-4"></i>
                    </div>
                    <h3 class="mb-0 fw-black text-uppercase tracking-wider text-info">EDIT PRODUCT</h3>
                </div>
                <button class="btn btn-sm btn-outline-secondary rounded-pill px-3 fw-black" @onclick="() => _itemToEdit = null">CLOSE</button>
            </div>
            <div class="modal-body p-4 bg-light-subtle">
                 <div class="mb-3">
                    <label class="small fw-bold text-muted mb-1">Product Name</label>
                    <input type="text" class="form-control rounded-pill border-2" @bind="_itemToEdit.Name" />
                </div>
                <div class="row g-2 mb-3">
                    <div class="col-6">
                        <label class="small fw-bold text-muted mb-1">Bottle/Can Size</label>
                        <select class="form-select rounded-pill border-2" @bind="_itemToEdit.BottleSize">
                            <option value="">-- Choose Size --</option>
                            <option value="50ml">50ml</option>
                            <option value="187ml">187ml</option>
                            <option value="355ml">355ml</option>
                            <option value="375ml">375ml</option>
                            <option value="750ml">750ml</option>
                            <option value="1L">1L</option>
                            <option value="1.75L">1.75L</option>
                            <option value="12oz">12oz (Can/Bottle)</option>
                            <option value="16oz">16oz (Pint)</option>
                        </select>
                    </div>
                    <div class="col-6">
                        <label class="small fw-bold text-muted mb-1">Min Stock Limit</label>
                        <input type="number" class="form-control rounded-pill border-2" onfocus="this.select();" @bind="_itemToEdit.MinStockLimit" />
                    </div>
                    <div class="col-6">
                        <label class="small fw-bold text-muted mb-1">Bottle/Case Cost ($)</label>
                        <input type="number" class="form-control rounded-pill border-2" onfocus="this.select();" @bind="_itemToEdit.CurrentPrice" step="0.01" />
                    </div>
                </div>
                 <div class="row g-2 mb-3">
                    <div class="col-6">
                        <label class="small fw-bold text-muted mb-1">Min Order Qty</label>
                        <input type="number" class="form-control rounded-pill border-2 text-center" step="1" onfocus="this.select();"
                               value="@((int)_itemToEdit.MinimumOrderQuantity)" 
                               @oninput="e => { if(int.TryParse(e.Value?.ToString(), out var res)) _itemToEdit.MinimumOrderQuantity = res; }" />
                    </div>
                    <div class="col-6">
                        <label class="small fw-bold text-muted mb-1">Pack Size (e.g. 24)</label>
                        <input type="number" class="form-control rounded-pill border-2" onfocus="this.select();" @bind="_itemToEdit.PackSize" />
                    </div>
                </div>
                 <div class="mb-3">
                    <div class="form-check form-switch bg-light p-3 rounded-pill border">
                        <input class="form-check-input ms-0 me-2" type="checkbox" id="edit-isUnitBased" @bind="_itemToEdit.IsUnitBased">
                        <label class="form-check-label fw-bold text-dark small" for="edit-isUnitBased">
                            Item is sold by individual UNIT instead of OUNCES
                        </label>
                    </div>
                </div>

                @if (_itemToEdit.IsUnitBased)
                {
                    <div class="mb-3">
                         <div class="alert alert-info rounded-4 border-0 d-flex align-items-center gap-3 py-3 mb-0 animate-fade-in shadow-sm">
                             <div class="bg-white p-2 rounded-3 text-info shadow-sm">
                                 <i class="bi bi-box-seam-fill fs-5"></i>
                             </div>
                             <div>
                                 <div class="fw-black text-uppercase text-info mb-1" style="font-size: 0.65rem;">Pack Size Configuration</div>
                                 <p class="mb-0 text-muted fw-bold" style="font-size: 0.6rem; line-height: 1.2;">This item is currently tracked as individual units. Ensure the Pack Size (e.g. 24) is correctly set for accurate stock calculations.</p>
                             </div>
                         </div>
                    </div>
                }
                 <div class="row g-2 mb-3">
                    <div class="col-6">
                        <label class="small fw-bold text-muted mb-1">Drink Price (Sale)</label>
                        <input type="number" class="form-control rounded-pill border-2" onfocus="this.select();" @bind="_itemToEdit.RetailPrice" step="0.01" />
                    </div>
                    @if (!_itemToEdit.IsUnitBased)
                    {
                        <div class="col-6">
                            <label class="small fw-bold text-muted mb-1">Yield Rule</label>
                            <div class="bg-light p-2 px-3 rounded-pill text-navy small fw-black border border-navy border-opacity-10 text-center">
                                GLOBAL @(_settings?.GlobalLiquorPourSize.ToString("F2") ?? "1.50")oz
                            </div>
                        </div>
                    }
                </div>
                 <div class="mb-4">
                    <label class="small fw-bold text-muted mb-1">Primary Vendor</label>
                    <select class="form-select rounded-pill border-2" @bind="_itemToEdit.VendorId">
                        <option value="">-- No Vendor --</option>
                        @foreach (var v in _vendors)
                        {
                            <option value="@v.Id">@v.Name</option>
                        }
                    </select>
                </div>
                 <div class="mt-4">
                    <div class="bg-light p-3 rounded-4 border">
                        <div class="form-check form-switch p-0 d-flex align-items-center justify-content-between mb-2">
                            <div>
                                <h6 class="fw-black text-uppercase mb-0" style="font-size: 0.75rem;">Product is Active</h6>
                                <p class="extra-small text-muted mb-0" style="font-size: 0.65rem;">Uncheck to hide from inventory lists</p>
                            </div>
                            <input class="form-check-input ms-0" type="checkbox" style="width: 40px; height: 20px;" @bind="_itemToEdit.IsActive" id="itemActiveCheck">
                        </div>

                        <div class="form-check form-switch p-0 d-flex align-items-center justify-content-between">
                            <div>
                                <h6 class="fw-black text-uppercase mb-0 text-primary" style="font-size: 0.75rem;">Product is Beer</h6>
                                <p class="extra-small text-muted mb-0" style="font-size: 0.65rem;">Adds bottle return fee on orders</p>
                            </div>
                            <input class="form-check-input ms-0" type="checkbox" style="width: 40px; height: 20px;" @bind="_itemToEdit.IsBeer" id="itemBeerCheck">
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer d-flex gap-2 p-4">
                <button class="btn btn-light rounded-pill flex-grow-1 fw-bold" @onclick="() => _itemToEdit = null">CANCEL</button>
                <button class="btn btn-primary rounded-pill flex-grow-1 fw-black" @onclick="() => SaveEditAsync()">SAVE CHANGES</button>
            </div>
        </div>
    </div>
}

<div class="liquor-hub-layout">
    <aside class="hub-sidebar">
        <div class="hub-logo">
            <div class="logo-text">Liquor<span>Hub</span></div>
        </div>
        
        <nav class="hub-nav">
            <button class="hub-nav-item @(_activeTab == "ordering" ? "active" : "")" data-tab="ordering" @onclick='() => _activeTab = "ordering"'>
                <i class="bi bi-cart-plus"></i>
                <span>Ordering List</span>
                @if (_items.Any(i => i.CurrentStock <= i.MinStockLimit))
                {
                    <span class="hub-badge">@_items.Count(i => i.CurrentStock <= i.MinStockLimit)</span>
                }
            </button>

            <button class="hub-nav-item @(_activeTab == "active" ? "active" : "")" data-tab="active" @onclick='() => _activeTab = "active"'>
                <i class="bi bi-truck"></i>
                <span>Pending Arrival</span>
                @if (_pendingOrders.Any())
                {
                    <span class="hub-badge">@_pendingOrders.Count</span>
                }
            </button>

            <button class="hub-nav-item @(_activeTab == "unpaid" ? "active" : "")" data-tab="unpaid" @onclick='() => _activeTab = "unpaid"'>
                <i class="bi bi-cash-stack"></i>
                <span>Unpaid Invoices</span>
                @if (_historyOrders.Any(o => !o.IsPaid))
                {
                    <span class="hub-badge">@_historyOrders.Count(o => !o.IsPaid)</span>
                }
            </button>

            <button class="hub-nav-item @(_activeTab == "history" ? "active" : "")" data-tab="history" @onclick='() => _activeTab = "history"'>
                <i class="bi bi-file-earmark-spreadsheet"></i>
                <span>Order History</span>
            </button>

            <button class="hub-nav-item @(_activeTab == "backorders" ? "active" : "")" data-tab="backorders" @onclick='() => _activeTab = "backorders"'>
                <i class="bi bi-clock-history"></i>
                <span>Backorders</span>
                @if (_pendingBackorders.Any())
                {
                    <span class="hub-badge">@_pendingBackorders.Count</span>
                }
            </button>

            <button class="hub-nav-item @(_activeTab == "count" ? "active" : "")" data-tab="reconcile" @onclick='() => _activeTab = "count"'>
                <i class="bi bi-clipboard-check"></i>
                <span>Stock Check</span>
            </button>

            <button class="hub-nav-item @(_activeTab == "analytics" ? "active" : "")" data-tab="analytics" @onclick='() => _activeTab = "analytics"'>
                <i class="bi bi-bar-chart-line"></i>
                <span>Analytics & Stats</span>
            </button>

            <button class="hub-nav-item @(_activeTab == "setup" ? "active" : "")" data-tab="setup" @onclick='() => { _activeTab = "setup"; _activeSetupTab = "items"; }'>
                <i class="bi bi-gear"></i>
                <span>Hub Setup</span>
            </button>
        </nav>

        <div class="hub-sidebar-footer">
            <button class="btn-exit-hub" @onclick='() => NavigationManager.NavigateTo("/")'>
                <i class="bi bi-box-arrow-left"></i>
                <span>Exit Hub</span>
            </button>
        </div>
    </aside>

    <main class="hub-main-content">
        @if (!string.IsNullOrEmpty(_emailErrorMessage))
        {
            <div class="alert alert-danger mx-4 mt-3 mb-0 rounded-4 border-0 shadow-sm animate-fade-in d-flex align-items-center" style="z-index: 1000;">
                <i class="bi bi-exclamation-triangle-fill fs-4 me-3"></i>
                <div class="flex-grow-1">
                    <div class="fw-black text-uppercase small tracking-wider mb-1">Email Delivery Failed</div>
                    <div class="fw-bold small opacity-75">@_emailErrorMessage</div>
                </div>
                <button type="button" class="btn-close ms-auto" @onclick="() => _emailErrorMessage = string.Empty"></button>
            </div>
        }
        <header class="hub-top-bar">
            <div class="hub-breadcrumb">
                <span class="text-muted fw-bold">POS System</span>
                <i class="bi bi-chevron-right mx-2 small opacity-50"></i>
                <span class="fw-black text-uppercase tracking-wider">@_activeTab</span>
            </div>
            <div class="hub-top-actions d-flex gap-2">
                <button class="btn btn-sm px-3 py-2 rounded-pill bg-white border shadow-sm text-dark fw-bold" @onclick="() => RefreshDataAsync()">
                    <i class="bi bi-arrow-repeat me-2"></i>Refresh
                </button>
                <button class="btn btn-sm px-4 py-2 rounded-pill btn-primary text-white shadow-sm fw-bold hover-lift transition-base" @onclick="() => _showPriceHistoryModal = true">
                    <i class="bi bi-clock-history me-2"></i>PRICE LOG
                </button>
            </div>
        </header>

        <div class="hub-scroll-body">

    @if (_isLoading)
    {
        <div class="d-flex flex-column align-items-center justify-content-center py-5">
            <div class="spinner-border text-primary mb-3" role="status"></div>
            <div class="text-muted">Loading Liquor Data...</div>
        </div>
    } else {
        @if (_activeTab == "count")
        {
            <div class="count-view animate-fade-in h-100 d-flex flex-column">
                <div class="tab-fixed-header pb-0">
                    <div class="audit-progress-container border shadow-sm">
                        <div class="d-flex justify-content-between align-items-end mb-3">
                            <div>
                                <h4 class="fw-black text-uppercase tracking-wider mb-1">Stock Audit In-Progress</h4>
                                <p class="small text-muted mb-0 fw-bold">
                                    <i class="bi bi-info-circle me-1"></i> 
                                    Inventory counts are pre-filled with system expectations. **Adjust only the items that do not match the shelf.**
                                    @if (_lastReconcileDate.HasValue)
                                    {
                                        <span class="ms-2 text-primary opacity-75">| Last Full Audit: @_lastReconcileDate.Value.ToLocalTime().ToString("MMM dd, h:mm tt")</span>
                                    }
                                </p>
                            </div>
                            <div class="text-end">
                                <div class="h3 fw-black text-primary mb-0">@(Math.Round((double)_stockCounts.Count / (_items.Count(i => (!_filterBeerOnly || i.IsBeer)) > 0 ? _items.Count(i => (!_filterBeerOnly || i.IsBeer)) : 1) * 100))%</div>
                                <div class="extra-small text-muted fw-black text-uppercase">Audit Completion</div>
                            </div>
                        </div>
                        <div class="reconcile-progress-bar mb-4">
                            <div class="reconcile-progress-fill" style="width: @((double)_stockCounts.Count / (_items.Count(i => (!_filterBeerOnly || i.IsBeer)) > 0 ? _items.Count(i => (!_filterBeerOnly || i.IsBeer)) : 1) * 100)%"></div>
                        </div>
                        
                        <div class="d-flex justify-content-between align-items-center">
                            <div class="d-flex gap-2">
                                <div class="search-box-pill border rounded-pill px-3 bg-light d-flex align-items-center shadow-inner">
                                    <i class="bi bi-search text-muted me-2"></i>
                                    <input type="text" class="border-0 bg-transparent py-2 px-1 fw-bold" placeholder="Find product..." onfocus="this.select()" @bind="_searchTerm" @bind:event="oninput" style="outline:none; width: 220px;" />
                                </div>
                                <button class="btn btn-sm rounded-pill px-3 fw-black @(!_filterBeerOnly ? "btn-dark shadow" : "btn-outline-secondary")" style="font-size: 0.75rem;" @onclick="() => _filterBeerOnly = false">ALL LIQUOR</button>
                                <button class="btn btn-sm rounded-pill px-3 fw-black @(_filterBeerOnly ? "btn-amber shadow" : "btn-outline-amber")" style="font-size: 0.75rem;" @onclick="() => _filterBeerOnly = true">BEER ONLY</button>
                            </div>
                            <div class="d-flex gap-2">
                                <button class="btn btn-outline-danger rounded-pill px-3 fw-black btn-sm" @onclick="() => _stockCounts.Clear()">
                                    <i class="bi bi-trash3 me-1"></i> RESET AUDIT
                                </button>
                                <button class="btn btn-success rounded-pill px-4 fw-black shadow-sm btn-sm" @onclick="() => _showReviewModal = true" disabled="@(!_stockCounts.Any())">
                                    <i class="bi bi-shield-lock-fill me-1"></i> COMMIT RECONCILIATION
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="tab-scroll-area custom-scrollbar pb-5">
                    <div class="row g-2">
                        @foreach (var item in _items.Where(i => (string.IsNullOrEmpty(_searchTerm) || i.Name.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase)) && (!_filterBeerOnly || i.IsBeer)).OrderBy(i => i.Name))
                        {
                            var hasCount = _stockCounts.TryGetValue(item.Id, out var actual);
                            var variance = hasCount ? actual - item.CurrentStock : 0;
                            
                            <div class="col-xxl-3 col-xl-4 col-md-6">
                                <div class="reconcile-card @(hasCount ? "touched" : "")">
                                    <div class="flex-grow-1">
                                        <h6 class="fw-black text-dark text-uppercase mb-1 tracking-tighter" style="font-size: 0.85rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">@item.Name</h6>
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="extra-small fw-bold text-muted">
                                                <span class="opacity-75">Expected:</span> <span class="text-dark">@item.CurrentStock</span>
                                            </div>
                                            @if (hasCount)
                                            {
                                                <div class="variance-badge @(variance == 0 ? "perfect" : (variance < 0 ? "missing" : "over"))">
                                                    @if (variance == 0) { <i class="bi bi-check-circle-fill"></i> }
                                                    else if (variance < 0) { <span>-@Math.Abs(variance)</span> }
                                                    else { <span>+@variance</span> }
                                                </div>
                                            }
                                        </div>
                                    </div>
                                    
                                    <div class="actual-input-group d-flex align-items-center" style="width: auto;">
                                        <button class="btn-qty-adj minus" @onclick="() => AdjustItemCount(item.Id, -1, item.CurrentStock)">-</button>
                                        <input type="number" class="actual-input-hub" 
                                               id="audit-input-@item.Id"
                                               value="@(hasCount ? actual : item.CurrentStock)" 
                                               @onchange="@(e => UpdateItemCount(item.Id, e.Value))"
                                               @onkeydown="@(e => HandleAuditKeyDown(e, item.Id))"
                                               onfocus="this.select()" />
                                        <button class="btn-qty-adj plus" @onclick="() => AdjustItemCount(item.Id, 1, item.CurrentStock)">+</button>
                                    </div>
                                    
                                    <div class="d-flex flex-column gap-1">
                                        @if (hasCount && actual != item.CurrentStock)
                                        {
                                            <button class="btn btn-xs btn-outline-warning border rounded-3 p-1 px-2 fw-black shadow-sm" style="font-size: 0.55rem;" @onclick="() => _stockCounts.Remove(item.Id)">
                                                UNDO
                                            </button>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                @if (_showReviewModal)
                {
                    <div class="modal-backdrop-modern animate-fade-in" style="z-index: 3000;">
                        <div class="modal-card animate-slide-up shadow-lg border-primary border-top border-5" style="max-width: 700px;">
                            <div class="modal-header bg-white py-4 px-4 border-bottom">
                                <div class="d-flex align-items-center">
                                    <div class="bg-primary-subtle p-2 rounded-3 me-3">
                                        <i class="bi bi-clipboard-check text-primary fs-4"></i>
                                    </div>
                                    <div>
                                        <h4 class="mb-0 fw-black text-uppercase tracking-wider">Review Audit Summary</h4>
                                        <div class="extra-small text-muted fw-bold">Confirm these variances before updating system stock</div>
                                    </div>
                                </div>
                                <button class="btn btn-close" @onclick="() => _showReviewModal = false"></button>
                            </div>
                            <div class="modal-body p-4 bg-light-subtle" style="max-height: 60vh; overflow-y: auto;">
                                @{
                                    var discrepancies = _stockCounts
                                        .Select(kvp => new { Item = _items.FirstOrDefault(i => i.Id == kvp.Key), Actual = kvp.Value })
                                        .Where(x => x.Item != null && x.Actual != x.Item.CurrentStock)
                                        .ToList();
                                }

                                @if (!discrepancies.Any())
                                {
                                    <div class="alert alert-success rounded-4 border-0 p-4 text-center">
                                        <i class="bi bi-check-circle-fill display-5 d-block mb-3"></i>
                                        <h5 class="fw-black">Perfect Audit!</h5>
                                        <p class="mb-0">All physical stock matches the system expectations perfectly.</p>
                                    </div>
                                }
                                else
                                {
                                    <div class="row g-2">
                                        @foreach (var d in discrepancies.OrderBy(x => x.Actual - x.Item!.CurrentStock))
                                        {
                                            var diff = d.Actual - d.Item!.CurrentStock;
                                            <div class="col-12">
                                                <div class="d-flex justify-content-between align-items-center bg-white p-3 rounded-4 border shadow-sm">
                                                    <div>
                                                        <div class="fw-black text-dark">@d.Item.Name</div>
                                                        <div class="extra-small text-muted fw-bold">Exp: @d.Item.CurrentStock | Actual: @d.Actual</div>
                                                    </div>
                                                    <div class="variance-badge @(diff < 0 ? "missing" : "over") px-3 py-2 fs-6">
                                                        @(diff > 0 ? "+" : "")@diff Units
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                            <div class="modal-footer p-4 bg-white border-top d-flex gap-3">
                                <button class="btn btn-light btn-lg flex-grow-1 rounded-pill fw-bold" @onclick="() => _showReviewModal = false">GO BACK</button>
                                <button class="btn btn-primary btn-lg flex-grow-1 rounded-pill fw-black shadow-lg" @onclick="() => ConfirmReconciliationAsync()" disabled="@_isSaving">
                                    @if (_isSaving) { <span class="spinner-border spinner-border-sm me-2"></span> }
                                    COMMIT UPDATES
                                </button>
                            </div>
                        </div>
                    </div>
                }
            </div>
        } else if (_activeTab == "ordering") {
            <div class="ordering-view animate-fade-in d-flex flex-column h-100 overflow-hidden" style="min-height: 0;">
                @if (!_items.Any())
                {
                    <div class="tab-fixed-header">
                        <div class="alert alert-info rounded-4 border-0 shadow-sm p-4 text-center">
                            <i class="bi bi-info-circle display-4 d-block mb-3"></i>
                            <h5>No items to order.</h5>
                            <p class="mb-0">Please add liquor items and assign them to vendors in the Setup tab.</p>
                        </div>
                    </div>
                }
                else
                {
                    <div class="tab-fixed-header">
                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 bg-white p-3 rounded-4 shadow-sm">
                            <div class="d-flex align-items-center gap-3 flex-grow-1" style="max-width: 500px;">
                                    <div class="input-group input-group-sm">
                                        <span class="input-group-text bg-transparent border-0 pe-1">
                                            <i class="bi bi-search text-muted"></i>
                                        </span>
                                        <input type="text" class="form-control border-0 bg-transparent ps-1" placeholder="Search products..." onfocus="this.select()" @bind="_searchTerm" @bind:event="oninput" />
                                    </div>
                                    @if (!_isAlphabeticalView)
                                    {
                                        <div class="vr mx-2"></div>
                                        <select class="form-select form-select-sm rounded-pill border-2" style="width: 150px;" @bind="_filterVendorId">
                                            <option value="0">All Vendors</option>
                                            @foreach (var v in _vendors)
                                            {
                                                <option value="@v.Id">@v.Name</option>
                                            }
                                        </select>
                                    }
                                    <div class="vr mx-2"></div>
                                    <div class="row g-0 rounded-pill border bg-light p-1" style="min-width: 280px; height: 38px;">
                                        <div class="col-6">
                                            <button class="btn btn-sm w-100 h-100 rounded-pill border-0 @(!_isAlphabeticalView ? "btn-primary shadow-sm" : "btn-link text-muted text-decoration-none") text-uppercase fw-bold" style="font-size: 0.65rem;" @onclick="() => _isAlphabeticalView = false">BY VENDOR</button>
                                        </div>
                                        <div class="col-6">
                                            <button class="btn btn-sm w-100 h-100 rounded-pill border-0 @(_isAlphabeticalView ? "btn-primary shadow-sm" : "btn-link text-muted text-decoration-none") text-uppercase fw-bold" style="font-size: 0.65rem;" @onclick="() => _isAlphabeticalView = true">BY PRODUCT</button>
                                        </div>
                                    </div>
                                </div>
                                <div class="badge bg-primary rounded-pill px-3">@_items.Count(i => (_isAlphabeticalView || _filterVendorId == 0 || i.VendorId == _filterVendorId) && (string.IsNullOrEmpty(_searchTerm) || i.Name.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase)) && (!_filterBeerOnly || i.IsBeer)) Products</div>
                                
                            <div class="vr mx-1"></div>
                            <div class="d-flex align-items-center gap-1 bg-light rounded-pill p-1 border">
                                <button class="btn btn-sm rounded-pill px-3 fw-black @(!_filterBeerOnly ? "btn-white shadow-sm" : "text-muted")" style="font-size: 0.65rem;" @onclick="() => _filterBeerOnly = false">ALL</button>
                                <button class="btn btn-sm rounded-pill px-3 fw-black @(_filterBeerOnly ? "btn-amber shadow-sm" : "text-muted")" style="font-size: 0.65rem;" @onclick="() => _filterBeerOnly = true"><svg width='1.1em' height='1.1em' viewBox='0 0 16 16' fill='currentColor' style='display: inline-block; vertical-align: -0.15em;' xmlns='http://www.w3.org/2000/svg'><path d='M9.5 2H6.5V4.5C6 5 5.5 5.5 5.5 6.5V14H10.5V6.5C10.5 5.5 10 5 9.5 4.5V2Z'/></svg> BEER ONLY</button>
                            </div>
                        </div>
                    </div>

                    <div class="p-0 d-flex flex-column flex-grow-1" style="min-height: 0; overflow: hidden;">
                        <div class="row g-0 flex-grow-1" style="min-height: 0; height: 100%;">
                            <!-- LEFT SIDE: PRODUCTS (SCROLLABLE) -->
                            <div class="col-lg-8 d-flex flex-column border-end bg-white h-100" style="min-height: 0; overflow: hidden;">
                                <div class="tab-scroll-area p-4 custom-scrollbar">
                                    @if (_isAlphabeticalView)
                                    {
                                        <div class="row g-3 animate-fade-in">
                                            @foreach (var item in _items.Where(i => i.VendorId.HasValue && (string.IsNullOrEmpty(_searchTerm) || i.Name.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase)) && (!_filterBeerOnly || i.IsBeer)).OrderBy(i => i.Name))
                                            {
                                                <div class="col-md-6">
                                                    <div class="order-item-card @(item.CurrentStock <= item.MinStockLimit ? "low-stock" : "") @(GetCartQuantity(item.Id) > 0 ? "selected-for-order" : "")">
                                                        <div class="d-flex align-items-center gap-3">
                                                          <div class="product-info flex-grow-1">
                                                            <div class="d-flex justify-content-between align-items-center">
                                                                <div>
                                                                    <h5 class="fw-black mb-0 text-dark">@item.Name</h5>
                                                                    <div class="small text-muted d-flex align-items-center gap-2">
                                                                        <span>@item.BottleSize</span>
                                                                        @if (item.PackSize > 1) { <span class="badge bg-light text-dark border extra-small">Case of @item.PackSize</span> }
                                                                        <span class="dot"></span>
                                                                        <span>@item.CurrentPrice.ToString("C")</span>
                                                                    </div>
                                                                </div>
                                                                <div class="stock-pill @(item.CurrentStock == 0 ? "empty" : (item.CurrentStock <= item.MinStockLimit ? "low" : "ok"))">
                                                                    <div class="d-flex align-items-center justify-content-center gap-1">
                                                                        @if (item.PackSize > 1)
                                                                        {
                                                                            <div class="stock-unit-group" title="Full Cases">
                                                                                <span class="stock-icon"><i class="bi bi-box-seam"></i></span>
                                                                                <span class="stock-value">@(item.CurrentStock / item.PackSize)</span>
                                                                            </div>
                                                                            <div class="stock-divider"></div>
                                                                            <div class="stock-unit-group" title="Individual Bottles">
                                                                                <span class="stock-icon"><svg width='1.1em' height='1.1em' viewBox='0 0 16 16' fill='currentColor' style='display: inline-block; vertical-align: -0.15em;' xmlns='http://www.w3.org/2000/svg'><path d='M9.5 2H6.5V4.5C6 5 5.5 5.5 5.5 6.5V14H10.5V6.5C10.5 5.5 10 5 9.5 4.5V2Z'/></svg></span>
                                                                                <span class="stock-value">@(item.CurrentStock % item.PackSize)</span>
                                                                            </div>
                                                                        }
                                                                        else
                                                                        {
                                                                            <span class="stock-value">@item.CurrentStock</span>
                                                                            <span class="stock-icon-small"><svg width='1.1em' height='1.1em' viewBox='0 0 16 16' fill='currentColor' style='display: inline-block; vertical-align: -0.15em;' xmlns='http://www.w3.org/2000/svg'><path d='M9.5 2H6.5V4.5C6 5 5.5 5.5 5.5 6.5V14H10.5V6.5C10.5 5.5 10 5 9.5 4.5V2Z'/></svg></span>
                                                                        }
                                                                    </div>
                                                                </div>
                                                            </div>
                                                          </div>
                                                          <div class="quantity-control px-2 @(GetCartQuantity(item.Id) > 0 && GetCartQuantity(item.Id) < item.MinimumOrderQuantity ? "border border-danger rounded-3" : "")">
                                                              <button class="btn btn-sm btn-icon" @onclick="() => AdjustCartQuantity(item.Id, -1)">-</button>
                                                               <div class="qty-display d-flex flex-column align-items-center justify-content-center" style="min-width: 65px; line-height: 1;">
                                                                   @if (item.PackSize > 1)
                                                                   {
                                                                       <span class="fw-black text-primary" style="font-size: 1rem;">@(GetCartQuantity(item.Id) / item.PackSize) cs</span>
                                                                       <span class="extra-small text-muted" style="font-size: 0.55rem;">(@GetCartQuantity(item.Id) units)</span>
                                                                   }
                                                                   else
                                                                   {
                                                                       <span class="fw-black text-dark" style="font-size: 1.1rem;">@GetCartQuantity(item.Id)</span>
                                                                       <span class="extra-small text-muted" style="font-size: 0.55rem;">units</span>
                                                                   }
                                                               </div>
                                                              <button class="btn btn-sm btn-icon" @onclick="() => AdjustCartQuantity(item.Id, 1)">+</button>
                                                          </div>
                                                        </div>
                                                        @if (GetCartQuantity(item.Id) > 0 && GetCartQuantity(item.Id) < item.MinimumOrderQuantity)
                                                        {
                                                            <div class="text-danger extra-small fw-bold text-end pe-2 mt-1 pulse-animation">
                                                                <i class="bi bi-info-circle"></i> MIN ORDER: @item.MinimumOrderQuantity
                                                            </div>
                                                        }
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        @foreach (var vendorGroup in _items.Where(i => i.VendorId.HasValue && (_filterVendorId == 0 || i.VendorId == _filterVendorId) && (string.IsNullOrEmpty(_searchTerm) || i.Name.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase)) && (!_filterBeerOnly || i.IsBeer)).GroupBy(i => i.Vendor?.Name ?? "Unassigned"))
                                        {
                                            <div class="vendor-block mb-4">
                                                <div class="vendor-header d-flex justify-content-between align-items-center mb-2 px-1 border-bottom pb-2">
                                                    <h3 class="fw-black m-0 text-uppercase tracking-wider text-primary" style="font-size: 0.95rem;">@vendorGroup.Key</h3>
                                                    <div class="badge bg-primary bg-opacity-10 text-primary border-primary border-opacity-25 border px-3" style="font-size: 0.65rem;">@vendorGroup.Count() Items</div>
                                                </div>
                                                <div class="row g-3">
                                                    @foreach (var item in vendorGroup.OrderBy(i => i.Name))
                                                    {
                                                        <div class="col-md-6">
                                                            <div class="order-item-card @(item.CurrentStock <= item.MinStockLimit ? "low-stock" : "") @(GetCartQuantity(item.Id) > 0 ? "selected-for-order" : "")">
                                                                <div class="d-flex align-items-center gap-3">
                                                                  <div class="product-info flex-grow-1">
                                                                    <div class="d-flex justify-content-between align-items-center">
                                                                        <div>
                                                                            <h5 class="fw-black mb-0 text-dark">@item.Name</h5>
                                                                            <div class="small text-muted d-flex align-items-center gap-2">
                                                                                <span>@item.BottleSize</span>
                                                                                @if (item.PackSize > 1) { <span class="badge bg-light text-dark border extra-small">Case of @item.PackSize</span> }
                                                                                <span class="dot"></span>
                                                                                <span>@item.CurrentPrice.ToString("C")</span>
                                                                            </div>
                                                                        </div>
                                                                        <div class="stock-pill @(item.CurrentStock == 0 ? "empty" : (item.CurrentStock <= item.MinStockLimit ? "low" : "ok"))">
                                                                            <div class="d-flex align-items-center justify-content-center gap-1">
                                                                                @if (item.PackSize > 1)
                                                                                {
                                                                                    <div class="stock-unit-group" title="Full Cases">
                                                                                        <span class="stock-icon"><i class="bi bi-box-seam"></i></span>
                                                                                        <span class="stock-value">@(item.CurrentStock / item.PackSize)</span>
                                                                                    </div>
                                                                                    <div class="stock-divider"></div>
                                                                                    <div class="stock-unit-group" title="Individual Bottles">
                                                                                        <span class="stock-icon"><svg width='1.1em' height='1.1em' viewBox='0 0 16 16' fill='currentColor' style='display: inline-block; vertical-align: -0.15em;' xmlns='http://www.w3.org/2000/svg'><path d='M9.5 2H6.5V4.5C6 5 5.5 5.5 5.5 6.5V14H10.5V6.5C10.5 5.5 10 5 9.5 4.5V2Z'/></svg></span>
                                                                                        <span class="stock-value">@(item.CurrentStock % item.PackSize)</span>
                                                                                    </div>
                                                                                }
                                                                                else
                                                                                {
                                                                                    <span class="stock-value">@item.CurrentStock</span>
                                                                                    <span class="stock-icon-small"><svg width='1.1em' height='1.1em' viewBox='0 0 16 16' fill='currentColor' style='display: inline-block; vertical-align: -0.15em;' xmlns='http://www.w3.org/2000/svg'><path d='M9.5 2H6.5V4.5C6 5 5.5 5.5 5.5 6.5V14H10.5V6.5C10.5 5.5 10 5 9.5 4.5V2Z'/></svg></span>
                                                                                }
                                                                            </div>
                                                                        </div>
                                                                    </div>
                                                                  </div>
                                                                  <div class="quantity-control px-2 @(GetCartQuantity(item.Id) > 0 && GetCartQuantity(item.Id) < item.MinimumOrderQuantity ? "border border-danger rounded-3" : "")">
                                                                      <button class="btn btn-sm btn-icon" @onclick="() => AdjustCartQuantity(item.Id, -1)">-</button>
                                                                       <div class="qty-display d-flex flex-column align-items-center justify-content-center" style="min-width: 65px; line-height: 1;">
                                                                           @if (item.PackSize > 1)
                                                                           {
                                                                               <span class="fw-black text-primary" style="font-size: 1rem;">@(GetCartQuantity(item.Id) / item.PackSize) cs</span>
                                                                               <span class="extra-small text-muted" style="font-size: 0.55rem;">(@GetCartQuantity(item.Id) units)</span>
                                                                           }
                                                                           else
                                                                           {
                                                                               <span class="fw-black text-dark" style="font-size: 1.1rem;">@GetCartQuantity(item.Id)</span>
                                                                               <span class="extra-small text-muted" style="font-size: 0.55rem;">units</span>
                                                                           }
                                                                       </div>
                                                                      <button class="btn btn-sm btn-icon" @onclick="() => AdjustCartQuantity(item.Id, 1)">+</button>
                                                                  </div>
                                                                </div>
                                                                @if (GetCartQuantity(item.Id) > 0 && GetCartQuantity(item.Id) < item.MinimumOrderQuantity)
                                                                {
                                                                    <div class="text-danger extra-small fw-bold text-end pe-2 mt-1 pulse-animation">
                                                                        <i class="bi bi-info-circle"></i> MIN ORDER: @item.MinimumOrderQuantity
                                                                    </div>
                                                                }
                                                            </div>
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                        }
                                    }
                                </div>
                            </div>
                            
                            <!-- RIGHT SIDE: CART (SCROLLABLE SIDEBAR) -->
                            <div class="col-lg-4 d-flex flex-column bg-light bg-opacity-50 h-100" style="min-height: 0; overflow: hidden;">
                                <div class="card border-0 shadow-none bg-transparent d-flex flex-column h-100" style="min-height: 0; overflow: hidden;">
                                    <div class="card-header bg-white border-bottom p-4">
                                        <h5 class="mb-0 fw-black d-flex align-items-center text-primary">
                                            <i class="bi bi-cart4 me-2"></i> Current Order
                                        </h5>
                                    </div>
                                    <div class="card-body p-0 d-flex flex-column flex-grow-1" style="min-height: 0; overflow: hidden;">
                                        @if (!_cart.Any(v => v.Value > 0))
                                        {
                                            <div class="text-center py-5 px-4 animate-fade-in flex-grow-1 d-flex flex-column justify-content-center">
                                                <i class="bi bi-cart-x display-6 mb-2 opacity-50"></i>
                                                <p class="small mb-0">Your order is currently empty.</p>
                                            </div>
                                        }
                                        else
                                        {
                                            var cartItems = _cart.Where(e => e.Value > 0)
                                                .Select(e => new { Item = _items.FirstOrDefault(i => i.Id == e.Key), Qty = e.Value })
                                                .Where(x => x.Item != null)
                                                .OrderBy(x => x.Item!.Vendor?.Name)
                                                .ToList();

                                            <div class="tab-scroll-area p-4 custom-scrollbar">
                                                @foreach (var vGroup in cartItems.GroupBy(x => x.Item!.VendorId))
                                                {
                                                    var vendor = vGroup.First().Item!.Vendor;
                                                    var vTotal = vGroup.Sum(x => (x.Item!.PackSize > 0 ? (decimal)x.Qty / x.Item.PackSize : x.Qty) * x.Item.CurrentPrice + (x.Item.IsBeer ? 0.05m * x.Qty : 0));
                                                    var vMin = GetVendorMin(vendor);

                                                    <div class="vendor-cart-group mb-4 pb-3 border-bottom border-light">
                                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                                            <span class="extra-small fw-black text-uppercase text-primary tracking-wider">@vendor?.Name (@vTotal.ToString("C"))</span>
                                                            @if (vTotal < vMin)
                                                            {
                                                                <span class="badge bg-danger pulse-animation" style="font-size: 0.6rem;">
                                                                    WAIT! NEED @((vMin - vTotal).ToString("C")) MORE
                                                                </span>
                                                            }
                                                            else
                                                            {
                                                                <span class="badge bg-success" style="font-size: 0.6rem;">MIN MET</span>
                                                            }
                                                        </div>
                                                        @foreach (var x in vGroup)
                                                        {
                                                            var purchaseQty = x.Item!.PackSize > 1 ? (decimal)x.Qty / x.Item.PackSize : x.Qty;
                                                            var lineTotal = (purchaseQty * x.Item.CurrentPrice) + (x.Item.IsBeer ? 0.05m * x.Qty : 0);
                                                            <div class="d-flex justify-content-between align-items-center mb-1">
                                                                <div class="small text-muted flex-grow-1">
                                                                    <span class="fw-bold text-dark">@(x.Item.PackSize > 1 ? purchaseQty : x.Qty) @(x.Item.PackSize > 1 ? "cs" : "×")</span> @x.Item.Name
                                                                </div>
                                                                <div class="small fw-bold">@lineTotal.ToString("C")</div>
                                                            </div>
                                                        }
                                                        <div class="d-flex justify-content-between mt-2 pt-2 border-top border-light opacity-75">
                                                            <span class="extra-small fw-bold">@vendor?.Name Total</span><span class="small fw-black ms-2">@vTotal.ToString("C")</span>
                                                             <button class="btn btn-xs btn-outline-primary rounded-pill fw-black px-2 ms-auto" @onclick="() => ShowOrderConfirmation(vendor?.Id)" disabled="@(vTotal < vMin)">Order</button>
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                            <div class="cart-summary bg-white border-top p-4">
                                                <div class="d-flex justify-content-between mb-3">
                                                    <span class="text-muted fw-bold">Grand Total</span>
                                                    <span class="h4 fw-black text-primary mb-0">@GetCartTotal().ToString("C")</span>
                                                </div>
                                                                                                 @{ 
                                                     var canOrderAll = cartItems.GroupBy(x => x.Item!.VendorId)
                                                         .All(g => g.Sum(x => (x.Item!.PackSize > 0 ? (decimal)x.Qty / x.Item.PackSize : x.Qty) * x.Item.CurrentPrice + (x.Item.IsBeer ? 0.05m * x.Qty : 0)) >= GetVendorMin(g.First().Item!.Vendor)); 
                                                 }
                                                <button class="btn btn-primary w-100 py-3 rounded-pill fw-black shadow-lg" 
                                                        @onclick="() => SubmitOrderAsync()" 
                                                        disabled="@(!canOrderAll)">
                                                    PLACE ALL ORDERS
                                                </button>
                                                @if (!canOrderAll)
                                                {
                                                    <div class="alert alert-warning mt-3 border-0 rounded-4 p-2 extra-small text-center fw-bold">
                                                        <i class="bi bi-exclamation-circle me-1"></i> Some vendor minimums have not been met.
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        } else if (_activeTab == "backorders") {
            <div class="backorders-view animate-fade-in d-flex flex-column h-100 overflow-hidden">
                <div class="tab-fixed-header">
                    <h4 class="fw-black mb-1 text-uppercase tracking-wider">PENDING BACKORDERS</h4>
                    <p class="small text-muted mb-0">These items were previously marked as backordered and are still owed by the vendors.</p>
                </div>
                <div class="tab-scroll-area">
                    <div class="card border-0 shadow-sm rounded-4 overflow-hidden border-top border-4 border-warning">
                        <div class="table-responsive p-4">
                            @if (!_pendingBackorders.Any())
                            {
                                <div class="text-center py-5 text-muted">
                                    <i class="bi bi-check-circle display-1 opacity-25 mb-3"></i>
                                    <h4 class="fw-black">All Backorders Resolved!</h4>
                                    <p>You have no pending items waiting to arrive from previous orders.</p>
                                </div>
                            }
                            else
                            {
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="bg-light sticky-top">
                                        <tr class="extra-small text-muted uppercase-tracking">
                                            <th class="ps-4">Date Ordered</th>
                                            <th>Vendor</th>
                                            <th>Product Name</th>
                                            <th class="text-center">Quantity Owed</th>
                                            <th class="text-end pe-4">Stock Adjustment</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var oi in _pendingBackorders)
                                        {
                                            <tr>
                                                <td class="ps-4">
                                                    <div class="fw-bold">@oi.Order?.OrderDate.ToString("MMM dd, yyyy")</div>
                                                    <div class="extra-small text-muted">Order ID: #@oi.OrderId</div>
                                                </td>
                                                <td><span class="fw-black text-primary">@oi.Order?.Vendor?.Name</span></td>
                                                <td>
                                                    <div class="fw-bold text-dark">@oi.LiquorItem?.Name</div>
                                                    <div class="extra-small text-muted">@oi.LiquorItem?.BottleSize</div>
                                                </td>
                                                <td class="text-center">
                                                    <span class="fs-4 fw-black text-dark">@oi.Quantity</span>
                                                </td>
                                                <td class="text-end pe-4">
                                                    <button class="btn btn-warning rounded-pill px-4 fw-black shadow-sm"
                                                            @onclick="() => ResolveBackorder(oi)">
                                                        MARK RECEIVED
                                                    </button>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            }
                        </div>
                    </div>
                </div>
            </div>
        } else if (_activeTab == "active") {
            <div class="active-orders animate-fade-in d-flex flex-column h-100 overflow-hidden">
                 @if (!_pendingOrders.Any())
                {
                    <div class="tab-fixed-header text-center py-5 text-muted">
                        <i class="bi bi-check2-circle display-1 opacity-25 mb-3"></i>
                        <h4 class="fw-black">No Pending Orders</h4>
                        <p>All your orders have been received and stocked.</p>
                    </div>
                }
                else
                {
                    <div class="tab-fixed-header">
                        <h4 class="fw-black mb-1 text-uppercase tracking-wider">ACTIVE ORDERS</h4>
                        <p class="small text-muted mb-0">Manage orders that have been placed but not yet received.</p>
                    </div>
                    <div class="tab-scroll-area">
                        @foreach (var dateGroup in _pendingOrders.GroupBy(o => o.OrderDate.ToLocalTime().Date).OrderByDescending(g => g.Key))
                        {
                            var groupDate = dateGroup.Key;
                            <div class="d-flex justify-content-between align-items-center mb-3 mt-4">
                                <h5 class="fw-black text-uppercase text-dark mb-0">Daily Orders: @groupDate.ToString("MMM dd, yyyy")</h5>
                                <button class="btn btn-outline-primary rounded-pill fw-bold" @onclick='async () => await JSRuntime.InvokeVoidAsync("open", $"/liquor/print-batch/{groupDate.ToString("yyyy-MM-dd")}", "_blank")'>
                                    <i class="bi bi-printer me-2"></i>PRINT DAILY BATCH SHEET
                                </button>
                            </div>
                            <div class="row g-4 mb-4">
                                @foreach (var order in dateGroup)
                                {
                                    <div class="col-md-6 col-xl-4">
                                        <div class="card border-0 shadow-sm rounded-4 h-100">
                                            <div class="card-header bg-light border-0 p-3 d-flex justify-content-between align-items-center">
                                                <div class="fw-black text-uppercase tracking-wider small">@order.Vendor?.Name</div>
                                                <div class="badge bg-primary rounded-pill">@order.Status</div>
                                            </div>
                                            <div class="card-body p-4">
                                                <div class="d-flex justify-content-between mb-3">
                                                    <div>
                                                        <div class="extra-small text-muted text-uppercase fw-bold">Date Placed</div>
                                                        <div class="fw-bold">@order.OrderDate.ToString("MMM dd, yyyy")</div>
                                                    </div>
                                                    <div class="text-end">
                                                        <div class="extra-small text-muted text-uppercase fw-bold">Order Value</div>
                                                        <div class="h5 fw-black text-dark mb-0">@order.TotalCost.ToString("C")</div>
                                                    </div>
                                                </div>
                                                
                                                <div class="small fw-bold text-muted mb-2">Order Items:</div>
                                                <div class="list-group list-group-flush mb-4 overflow-auto" style="max-height: 150px;">
                                                    @foreach (var oi in order.OrderItems)
                                                    {
                                                        var packSize = oi.LiquorItem?.PackSize ?? 1;
                                                        var purchaseQty = packSize > 1 ? (decimal)oi.Quantity / packSize : oi.Quantity;
                                                        var lineTotal = (purchaseQty * oi.UnitPriceAtTimeOfOrder) + (oi.BottleFeeAtTimeOfOrder * oi.Quantity);
                                                        
                                                        <div class="list-group-item px-0 py-1 border-0 bg-transparent d-flex justify-content-between">
                                                            <span class="small">
                                                                <span class="fw-bold">@(packSize > 1 ? purchaseQty : oi.Quantity) @(packSize > 1 ? "cs" : "×")</span> @oi.LiquorItem?.Name
                                                            </span>
                                                            <span class="extra-small text-muted">@lineTotal.ToString("C")</span>
                                                        </div>
                                                    }
                                                </div>

                                                 <div class="d-flex align-items-center justify-content-between mb-4 mt-3 pt-3 border-top">
                                                    <div class="d-flex align-items-center gap-2">
                                                        @if (order.IsEmailed)
                                                        {
                                                            if (order.LastEmailedDate == null)
                                                            {
                                                                <div class="badge bg-info-subtle text-info rounded-pill px-3 border border-info extra-small fw-black pulse-animation">
                                                                    <i class="bi bi-hourglass-split me-1"></i> SENDING...
                                                                </div>
                                                            }
                                                            else
                                                            {
                                                                <div class="badge bg-success-subtle text-success rounded-pill px-3 border border-success extra-small fw-black">
                                                                    <i class="bi bi-envelope-check-fill me-1"></i> EMAILED @(order.LastEmailedDate?.ToLocalTime().ToString("MM/dd h:mm tt"))
                                                                </div>
                                                            }
                                                        }
                                                        else if (!string.IsNullOrEmpty(order.Vendor?.Email))
                                                        {
                                                            <div class="badge bg-light text-muted rounded-pill px-3 border extra-small fw-black" title="Order was saved to history but no email was dispatched to the vendor.">
                                                                <i class="bi bi-journal-text me-1"></i> LOGGED (NO EMAIL)
                                                            </div>
                                                        }
                                                    </div>
                                                 </div>

                                                 <div class="d-flex gap-2">
                                                     <button class="btn btn-outline-primary rounded-pill fw-bold border-2" title="Print Order Sheet" @onclick="() => PrintOrder(order.Id)">
                                                         <i class="bi bi-printer"></i>
                                                     </button>
                                                     @if (!string.IsNullOrEmpty(order.Vendor?.Email))
                                                     {
                                                         <button class="btn btn-outline-primary rounded-pill fw-bold border-2 ms-0" title="Email Order Again" @onclick="() => ResendOrderEmailAsync(order)">
                                                             <i class="bi bi-envelope"></i>
                                                         </button>
                                                     }
                                                     <button class="btn btn-success flex-grow-1 rounded-pill fw-black py-2 shadow-sm" @onclick="() => StartReceiptAsync(order)">
                                                         MARK AS RECEIVED
                                                     </button>
                                                 </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        } else if (_activeTab == "unpaid") {
            <div class="history-view animate-fade-in d-flex flex-column h-100 overflow-hidden">
                <div class="tab-fixed-header">
                     <h4 class="fw-black mb-1">Open Bills & Unpaid Invoices</h4>
                     <p class="small text-muted mb-0">These orders have arrived, but the club still owes the vendor for them.</p>
                </div>
                <div class="tab-scroll-area">
                    <div class="card border-0 shadow-sm rounded-4 overflow-hidden border-top border-4 border-danger">
                        <div class="table-responsive p-4">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="bg-light sticky-top">
                                    <tr>
                                        <th class="ps-4">Date</th>
                                        <th>Vendor</th>
                                        <th>Invoice #</th>
                                        <th>Invoice Total</th>
                                        <th>Payment Status</th>
                                        <th class="text-end pe-4">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var order in _historyOrders.Where(o => !o.IsPaid))
                                    {
                                        <tr>
                                            <td class="ps-4">
                                                <div class="fw-bold">@order.OrderDate.ToString("MMM dd, yyyy")</div>
                                                <div class="extra-small text-muted">Placed by @order.User?.Username</div>
                                            </td>
                                            <td><span class="fw-bold">@order.Vendor?.Name</span></td>
                                            <td>
                                                @if (!string.IsNullOrEmpty(order.InvoiceNumber))
                                                {
                                                    <span class="badge bg-light text-dark border fw-bold px-3">@order.InvoiceNumber</span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted small">N/A</span>
                                                }
                                            </td>
                                            <td class="fw-black text-dark">@order.TotalCost.ToString("C")</td>
                                            <td>
                                                 <button class="btn btn-outline-danger btn-sm rounded-pill px-3 fw-bold border-2" @onclick="() => OpenPaymentModal(order)">
                                                     Mark as Paid
                                                  </button>
                                             </td>
                                            <td class="text-end pe-4 d-flex align-items-center justify-content-end gap-2">
                                                 @if (!string.IsNullOrEmpty(order.Vendor?.Email))
                                                 {
                                                     <button class="btn btn-sm btn-icon border-0 @(order.IsEmailed ? "text-success" : "text-muted")" title="Resend Email" @onclick="() => ResendOrderEmailAsync(order)">
                                                         <i class="bi @(order.IsEmailed ? "bi-envelope-check" : "bi-envelope")"></i>
                                                     </button>
                                                 }
                                                 <button class="btn btn-sm btn-icon border-0" title="Print Sheet" @onclick="() => PrintOrder(order.Id)">
                                                     <i class="bi bi-printer"></i>
                                                 </button>
                                             </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        } else if (_activeTab == "history") {
            <div class="history-view animate-fade-in d-flex flex-column h-100 overflow-hidden">
                <div class="tab-fixed-header">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div class="d-flex gap-2 p-1 bg-light rounded-pill border">
                            <button class="btn btn-sm rounded-pill px-4 @(_historySubTab == "orders" ? "btn-primary shadow-sm fw-black" : "btn-link text-muted text-decoration-none fw-bold")" 
                                    @onclick='() => _historySubTab = "orders"'>
                                PAID INVOICES
                            </button>
                            <button class="btn btn-sm rounded-pill px-4 @(_historySubTab == "purchases" ? "btn-primary shadow-sm fw-black" : "btn-link text-muted text-decoration-none fw-bold")" 
                                    @onclick='() => _historySubTab = "purchases"'>
                                PURCHASE HISTORY
                            </button>
                            <button class="btn btn-sm rounded-pill px-4 @(_historySubTab == "activity" ? "btn-primary shadow-sm fw-black" : "btn-link text-muted text-decoration-none fw-bold")" 
                                    @onclick='() => _historySubTab = "activity"'>
                                ACTIVITY & PRICE LOG
                            </button>
                        </div>
                    </div>

                    @if (_historySubTab == "orders")
                    {
                        <div class="d-flex flex-wrap gap-2 mb-0 p-3 bg-light rounded-4 border">
                            <select class="form-select w-auto fw-bold" @bind="_historyYearFilter">
                                <option value="0">All Years</option>
                                @foreach (var year in _historyOrders.Select(o => o.OrderDate.Year).Distinct().OrderByDescending(y => y))
                                {
                                    <option value="@year">@year</option>
                                }
                            </select>
                            <select class="form-select w-auto fw-bold" @bind="_historyVendorFilter">
                                <option value="0">All Vendors</option>
                                @foreach (var v in _vendors.OrderBy(v => v.Name))
                                {
                                    <option value="@v.Id">@v.Name</option>
                                }
                            </select>
                            <input type="text" class="form-control fw-bold" style="max-width: 250px;" placeholder="Search Product..." @bind="_historyProductSearch" @bind:event="oninput" />
                            <button class="btn btn-white border ms-auto px-4 fw-bold" @onclick="() => { _historyYearFilter = 0; _historyVendorFilter = 0; _historyProductSearch = string.Empty; }"><i class="bi bi-eraser-fill"></i> Clear</button>
                        </div>
                    }
                    else if (_historySubTab == "purchases")
                    {
                        var purchaseCounts = _historyOrders.Where(o => o.IsPaid)
                            .SelectMany(o => o.OrderItems)
                            .GroupBy(i => i.LiquorItemId)
                            .ToDictionary(g => g.Key, g => g.Sum(i => i.Quantity));
                        
                        <div class="d-flex flex-wrap gap-2 mb-0 p-3 bg-light rounded-4 border">
                            <div class="input-group" style="max-width: 450px;">
                                <select class="form-select fw-bold" @bind="_historyPurchaseProductId">
                                    <option value="0">-- Select a Product to view Purchase History --</option>
                                    @foreach (var item in _items.Where(i => purchaseCounts.ContainsKey(i.Id)).OrderBy(i => i.Name))
                                    {
                                        <option value="@item.Id">@item.Name (Qty Total: @purchaseCounts[item.Id])</option>
                                    }
                                </select>
                                <button class="btn btn-white border px-4 fw-bold" @onclick="() => _historyPurchaseProductId = 0" title="Clear Search"><i class="bi bi-eraser-fill"></i> Clear</button>
                            </div>
                        </div>
                    }
                </div>

                <div class="tab-scroll-area">
                    <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white p-4">
                        @if (_historySubTab == "orders")
                        {
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="bg-light sticky-top">
                                        <tr class="extra-small text-muted text-uppercase tracking-wider">
                                            <th class="ps-3">Date</th>
                                            <th>Vendor</th>
                                            <th>Invoice #</th>
                                            <th>Total Cost</th>
                                            <th>Payment Date</th>
                                            <th class="text-end pe-3">Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @{
                                            var filteredHistoryList = _historyOrders.Where(o => o.IsPaid);
                                            if (_historyYearFilter > 0) filteredHistoryList = filteredHistoryList.Where(o => o.OrderDate.Year == _historyYearFilter);
                                            if (_historyVendorFilter > 0) filteredHistoryList = filteredHistoryList.Where(o => o.VendorId == _historyVendorFilter);
                                            if (!string.IsNullOrWhiteSpace(_historyProductSearch))
                                            {
                                                filteredHistoryList = filteredHistoryList.Where(o => o.OrderItems.Any(i => i.LiquorItem != null && i.LiquorItem.Name.Contains(_historyProductSearch, StringComparison.OrdinalIgnoreCase)));
                                            }
                                        }
                                        @if (!filteredHistoryList.Any())
                                        {
                                            <tr><td colspan="6" class="text-center py-5 text-muted fw-bold">No completed orders found matching those filters.</td></tr>
                                        }
                                        @foreach (var order in filteredHistoryList.OrderByDescending(o => o.OrderDate))
                                        {
                                            bool isExpanded = _expandedHistoryOrders.Contains(order.Id);
                                            <tr style="cursor: pointer;" @onclick="() => ToggleHistoryOrder(order.Id)">
                                                <td class="ps-3">
                                                    <div class="fw-bold">@order.OrderDate.ToString("MMM dd, yyyy")</div>
                                                    <div class="extra-small text-muted">By @order.User?.Username</div>
                                                </td>
                                                <td><span class="fw-black">@order.Vendor?.Name</span></td>
                                                <td><span class="badge border bg-light text-dark fw-bold">@order.InvoiceNumber</span></td>
                                                <td class="fw-black text-primary">@order.TotalCost.ToString("C")</td>
                                                <td>
                                                    <div class="small fw-bold text-success"><i class="bi bi-check-circle-fill me-1"></i> @(order.PaidDate?.ToString("MM/dd/yy"))</div>
                                                </td>
                                                <td class="text-end pe-3 d-flex align-items-center justify-content-end gap-2">
                                                     @if (!string.IsNullOrEmpty(order.Vendor?.Email))
                                                     {
                                                         <button class="btn btn-sm btn-icon border-0 @(order.IsEmailed ? "text-success" : "text-muted")" title="Resend Email" @onclick="() => ResendOrderEmailAsync(order)" @onclick:stopPropagation>
                                                             <i class="bi @(order.IsEmailed ? "bi-envelope-check" : "bi-envelope")"></i>
                                                         </button>
                                                     }
                                                     <button class="btn btn-sm btn-outline-primary rounded-pill border-2 fw-black" @onclick="() => PrintOrder(order.Id)" @onclick:stopPropagation><i class="bi bi-printer"></i></button>
                                                     <i class="bi @(isExpanded ? "bi-chevron-up" : "bi-chevron-down") text-muted fw-bold ms-3"></i>
                                                 </td>
                                            </tr>
                                            @if (isExpanded)
                                            {
                                                <tr>
                                                    <td colspan="6" class="p-0 border-0">
                                                        <div class="bg-light p-3 border-bottom shadow-inner">
                                                            <h6 class="fw-black text-uppercase extra-small text-muted mb-3">Order Contents</h6>
                                                            <div class="row g-2">
                                                                @foreach (var item in order.OrderItems)
                                                                {
                                                                    bool matchesSearch = !string.IsNullOrWhiteSpace(_historyProductSearch) && 
                                                                                       item.LiquorItem?.Name.Contains(_historyProductSearch, StringComparison.OrdinalIgnoreCase) == true;
                                                                    
                                                                    <div class="col-md-6 col-lg-4">
                                                                        <div class="card rounded-3 border-0 shadow-sm p-2 @(matchesSearch ? "border-start border-3 border-primary bg-primary-subtle" : "bg-white")">
                                                                            <div class="d-flex justify-content-between align-items-center">
                                                                                <div>
                                                                                    <div class="fw-bold" style="font-size: 0.85rem;">@item.LiquorItem?.Name</div>
                                                                                    <div class="text-muted" style="font-size: 0.7rem;">@item.LiquorItem?.BottleSize | @item.UnitPriceAtTimeOfOrder.ToString("C")</div>
                                                                                </div>
                                                                                <div class="text-end ms-2">
                                                                                    @{
                                                                                        var packSize = item.LiquorItem?.PackSize ?? 1;
                                                                                        var purchaseQty = packSize > 1 ? (decimal)item.Quantity / packSize : item.Quantity;
                                                                                        var subtotal = (purchaseQty * item.UnitPriceAtTimeOfOrder) + (item.BottleFeeAtTimeOfOrder * item.Quantity);
                                                                                    }
                                                                                    <div class="fw-black">@purchaseQty @(packSize > 1 ? "cs" : "×")</div>
                                                                                    <div class="fw-bold text-primary" style="font-size: 0.8rem;">@subtotal.ToString("C")</div>
                                                                                </div>
                                                                            </div>
                                                                        </div>
                                                                    </div>
                                                                }
                                                            </div>
                                                        </div>
                                                    </td>
                                                </tr>
                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else if (_historySubTab == "purchases")
                        {
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="bg-light sticky-top">
                                        <tr class="extra-small text-muted text-uppercase tracking-wider">
                                            <th class="ps-3">Order Date</th>
                                            <th>Vendor</th>
                                            <th>Invoice #</th>
                                            <th class="text-center">Quantity</th>
                                            <th class="text-end">Unit Cost</th>
                                            <th class="text-end">Subtotal</th>
                                            <th class="text-end pe-3">Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (_historyPurchaseProductId == 0)
                                        {
                                            <tr><td colspan="7" class="text-center py-5 text-muted fw-bold">Please select a product from the dropdown above.</td></tr>
                                        }
                                        else
                                        {
                                            @foreach (var order in _historyOrders.Where(o => o.IsPaid && o.OrderItems.Any(oi => oi.LiquorItemId == _historyPurchaseProductId)).OrderByDescending(o => o.OrderDate))
                                            {
                                                var item = order.OrderItems.First(oi => oi.LiquorItemId == _historyPurchaseProductId);
                                                var packSize = item.LiquorItem?.PackSize ?? 1;
                                                var purchaseQty = packSize > 1 ? (decimal)item.Quantity / packSize : item.Quantity;
                                                var subtotal = (purchaseQty * item.UnitPriceAtTimeOfOrder) + (item.BottleFeeAtTimeOfOrder * item.Quantity);
                                                
                                                <tr>
                                                    <td class="ps-3 fw-bold">@order.OrderDate.ToString("MM/dd/yyyy")</td>
                                                    <td class="fw-bold">@order.Vendor?.Name</td>
                                                    <td><span class="badge border bg-light text-dark fw-bold">@order.InvoiceNumber</span></td>
                                                    <td class="text-center fw-black">@purchaseQty @(packSize > 1 ? "cs" : "units")</td>
                                                    <td class="text-end">@item.UnitPriceAtTimeOfOrder.ToString("C")</td>
                                                    <td class="text-end fw-bold text-primary">@subtotal.ToString("C")</td>
                                                    <td class="text-end pe-3">
                                                        <button class="btn btn-sm btn-icon text-muted" @onclick="() => PrintOrder(order.Id)"><i class="bi bi-printer"></i></button>
                                                    </td>
                                                </tr>
                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="bg-light sticky-top">
                                        <tr class="extra-small text-muted text-uppercase tracking-wider">
                                            <th class="ps-3">Timestamp</th>
                                            <th>Product</th>
                                            <th>Action Type</th>
                                            <th class="text-center">Count Change</th>
                                            <th>Audit Details / Notes</th>
                                            <th class="text-end pe-3">Performed By</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (!_recentTransactions.Any())
                                        {
                                            <tr>
                                                <td colspan="6" class="text-center py-5 text-muted">No system activity has been recorded yet.</td>
                                            </tr>
                                        }
                                        @foreach (var tx in _recentTransactions.OrderByDescending(t => t.Timestamp))
                                        {
                                            <tr>
                                                <td class="ps-3">
                                                    <div class="fw-bold">@tx.Timestamp.ToLocalTime().ToString("MM/dd")</div>
                                                    <div class="extra-small text-muted opacity-75">@tx.Timestamp.ToLocalTime().ToString("h:mm tt")</div>
                                                </td>
                                                <td class="fw-black text-dark">@(tx.Item?.Name ?? "Product #" + tx.ItemId)</td>
                                                <td>
                                                    <span class="badge rounded-pill pt-1 px-3 @(tx.TransactionType switch { "Update" => "bg-primary", "Restock" => "bg-success", "Checkout" => "bg-danger", _ => "bg-secondary" })" style="font-size: 0.65rem; font-weight: 800;">
                                                        @tx.TransactionType.ToUpper()
                                                    </span>
                                                </td>
                                                <td class="text-center fw-black">
                                                    @if (tx.ChangeAmount != 0)
                                                    {
                                                        <span class="@(tx.ChangeAmount > 0 ? "text-success" : "text-danger")">@(tx.ChangeAmount > 0 ? "+" : "")@tx.ChangeAmount</span>
                                                    }
                                                    else { <span class="text-muted opacity-25">-</span> }
                                                </td>
                                                <td>
                                                    @if (!string.IsNullOrEmpty(tx.Notes))
                                                    {
                                                        <div class="extra-small fw-bold text-dark bg-light p-2 rounded-3 border">
                                                            @tx.Notes
                                                        </div>
                                                    }
                                                    else { <span class="text-muted extra-small">None</span> }
                                                </td>
                                                <td class="text-end pe-3 fw-bold small">
                                                    @(tx.User?.Username ?? "System Auto")
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </div>
            </div>
        } else if (_activeTab == "analytics") {
            <div class="analytics-view animate-fade-in d-flex flex-column h-100 overflow-hidden">
                <div class="tab-fixed-header">
                    <!-- Sub-Tab Toggle -->
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div class="d-flex align-items-center gap-3">
                            <h5 class="fw-black text-uppercase mb-0 tracking-wider">Analytics & Reports</h5>
                            <button class="btn btn-outline-info btn-xs rounded-pill px-3 fw-bold shadow-sm" style="font-size: 0.65rem; height: 32px;" @onclick="() => _showProfitGuideModal = true">
                                 <i class="bi bi-lightbulb-fill me-1"></i> PROFITABILITY GUIDE
                            </button>
                        </div>
                        <div class="d-flex gap-2 p-1 bg-light rounded-pill border">
                            <button class="btn btn-sm rounded-pill px-4 @(_analyticsSubTab == "overview" ? "btn-primary shadow-sm fw-black" : "btn-link text-muted text-decoration-none fw-bold")" 
                                    @onclick='() => _analyticsSubTab = "overview"'>
                                CURRENT INVENTORY
                            </button>
                            <button class="btn btn-sm rounded-pill px-4 @(_analyticsSubTab == "yearly" ? "btn-primary shadow-sm fw-black" : "btn-link text-muted text-decoration-none fw-bold")" 
                                    @onclick='() => _analyticsSubTab = "yearly"'>
                                YEARLY PURCHASES
                            </button>
                        </div>
                    </div>

                    @if (_analyticsSubTab == "overview")
                    {
                        <!-- Vendor Inventory Breakdown (Top Hero) -->
                        <div class="card border-0 shadow-sm rounded-4 p-3 mb-3 border-top border-4 border-primary">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <div>
                                    <h6 class="fw-black mb-0 text-uppercase tracking-wider">VENDOR INVENTORY VALUE</h6>
                                    <p class="extra-small text-muted mb-0 fw-bold">Current inventory cost held per vendor.</p>
                                </div>
                                <div class="text-end">
                                    <div class="extra-small text-muted fw-bold" style="font-size: 0.6rem;">TOTAL ASSETS</div>
                                    <div class="h4 fw-black text-primary mb-0">@_items.Sum(i => i.CurrentStock * i.CurrentPrice).ToString("C0")</div>
                                </div>
                            </div>
                            
                            <div class="row g-2">
                                @foreach (var vGroup in _items.GroupBy(i => i.Vendor?.Name ?? "No Vendor").OrderByDescending(g => g.Sum(x => x.CurrentStock * x.CurrentPrice)).Take(6))
                                {
                                    var groupVal = vGroup.Sum(x => x.CurrentStock * x.CurrentPrice);
                                    if (groupVal <= 0) continue;
                                    <div class="col-md-2">
                                        <div class="p-2 border rounded-3 bg-light h-100 shadow-inner">
                                            <div class="extra-small text-muted fw-bold text-truncate mb-1" style="font-size: 0.6rem;">@vGroup.Key</div>
                                            <div class="h6 fw-black text-dark mb-0">@groupVal.ToString("C0")</div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>

                <div class="tab-scroll-area">
                    @if (_analyticsSubTab == "overview")
                    {
                        <div class="card border-0 shadow-sm rounded-4 p-3">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <h6 class="fw-black mb-0 text-uppercase tracking-wider">Brand Profit Analysis</h6>
                                <div class="btn-group btn-group-sm rounded-pill border shadow-sm p-1">
                                    <button class="btn btn-link text-decoration-none px-3 @(_statSortMode == "performance" ? "bg-dark text-white rounded-pill" : "text-muted")" @onclick='() => _statSortMode = "performance"'>Best Sellers</button>
                                    <button class="btn btn-link text-decoration-none px-3 @(_statSortMode == "profit" ? "bg-dark text-white rounded-pill" : "text-muted")" @onclick='() => _statSortMode = "profit"'>By Profit</button>
                                    <button class="btn btn-link text-decoration-none px-3 @(_statSortMode == "value" ? "bg-dark text-white rounded-pill" : "text-muted")" @onclick='() => _statSortMode = "value"'>By Value</button>
                                    <button class="btn btn-link text-decoration-none px-3 @(_statSortMode == "name" ? "bg-dark text-white rounded-pill" : "text-muted")" @onclick='() => _statSortMode = "name"'>A-Z</button>
                                </div>
                            </div>
                            
                            <div class="table-responsive">
                                <table class="table table-sm table-hover align-middle mb-0">
                                    <thead class="bg-light sticky-top" style="z-index: 10;">
                                        <tr class="text-dark uppercase-tracking border-bottom" style="font-size: 0.75rem; height: 40px;">
                                            <th class="ps-3 fw-black" style="width: 5%;">#ID</th>
                                            <th class="fw-black" style="width: 25%;">Product</th>
                                            <th class="text-center fw-black">Cost</th>
                                            <th class="text-center fw-black">Price</th>
                                            <th class="text-center fw-black">Profit</th>
                                            <th class="text-center fw-black">Sales</th>
                                            <th class="text-center fw-black">Yield</th>
                                            <th class="text-end pe-3 fw-black">Margin Health</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @{
                                            var sortedItems = _statSortMode switch {
                                                "performance" => _items.OrderByDescending(i => GetProfitPerDrink(i) * (_itemOrderCounts.ContainsKey(i.Id) ? _itemOrderCounts[i.Id] : 0)),
                                                "profit" => _items.OrderByDescending(i => GetProfitPerDrink(i)),
                                                "value" => _items.OrderByDescending(i => i.CurrentStock * i.CurrentPrice),
                                                _ => _items.OrderBy(i => i.Name)
                                            };
                                        }
                                        @foreach (var item in sortedItems)
                                        {
                                            decimal costPerPurSellUnit;
                                            int unitsPerMainUnit;
                                            decimal marginPercent;
                                            decimal profitPerDrink;

                                            if (item.IsUnitBased)
                                            {
                                                unitsPerMainUnit = item.PackSize;
                                                costPerPurSellUnit = item.PackSize > 0 ? (item.CurrentPrice / item.PackSize) : 0;
                                                profitPerDrink = item.RetailPrice - costPerPurSellUnit;
                                                marginPercent = item.RetailPrice > 0 ? (profitPerDrink / item.RetailPrice) * 100 : 0;
                                            }
                                            else
                                            {
                                                decimal globalPour = _settings?.GlobalLiquorPourSize ?? 1.5m;
                                                var totalOz = GetOuncesFromSize(item.BottleSize);
                                                var costPerOz = totalOz > 0 ? item.CurrentPrice / (decimal)totalOz : 0;
                                                costPerPurSellUnit = costPerOz * globalPour;
                                                profitPerDrink = item.RetailPrice - costPerPurSellUnit;
                                                unitsPerMainUnit = (int)(totalOz / (double)(globalPour > 0 ? globalPour : 1));
                                                marginPercent = item.RetailPrice > 0 ? (profitPerDrink / item.RetailPrice) * 100 : 0;
                                            }

                                             <tr style="height: 45px;">
                                                 <td class="ps-3 text-muted" style="font-size: 0.65rem;">@item.Id</td>
                                                 <td>
                                                    <div class="fw-bold text-dark small">@item.Name</div>
                                                    <div class="extra-small text-muted" style="font-size: 0.6rem;">@(item.IsUnitBased ? "Unit" : item.BottleSize) • @item.CurrentStock @(item.CurrentStock == 1 ? "btl" : "btls")</div>
                                                </td>
                                                <td class="text-center small">@costPerPurSellUnit.ToString("C2")</td>
                                                <td class="text-center fw-bold small">@item.RetailPrice.ToString("C2")</td>
                                                <td class="text-center text-success fw-bold small">@profitPerDrink.ToString("C2")</td>
                                                <td class="text-center">
                                                     <div class="badge bg-light text-dark border rounded-pill px-2" style="font-size: 0.6rem;">
                                                         <i class="bi bi-graph-up-arrow text-primary me-1" style="font-size: 0.5rem;"></i>
                                                         @(_itemOrderCounts.ContainsKey(item.Id) ? _itemOrderCounts[item.Id] : 0)
                                                     </div>
                                                 </td>
                                                 <td class="text-center extra-small fw-bold text-muted">@unitsPerMainUnit @(item.IsUnitBased ? "ut" : "oz")</td>
                                                <td class="text-end pe-3">
                                                    @if (item.RetailPrice == 0)
                                                    {
                                                        <span class="badge bg-light text-muted border" style="font-size: 0.6rem;">N/A</span>
                                                    }
                                                    else
                                                    {
                                                        var marginColor = marginPercent < 70 ? "text-danger" : marginPercent < 85 ? "text-warning" : "text-success";
                                                        var barColor = marginPercent < 70 ? "bg-danger" : marginPercent < 85 ? "bg-warning" : "bg-success";
                                                        
                                                        <div class="d-flex align-items-center justify-content-end gap-2">
                                                            <span class="extra-small fw-bold @marginColor" style="font-size: 0.65rem;">@marginPercent.ToString("F0")%</span>
                                                            <div class="progress" style="width: 50px; height: 5px;">
                                                                <div class="progress-bar @barColor" style="width: @marginPercent%"></div>
                                                            </div>
                                                        </div>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    }
                    else if (_analyticsSubTab == "yearly")
                    {
                        <div class="card border-0 shadow-sm rounded-4 p-4">
                            <div class="d-flex justify-content-between align-items-center mb-4">
                                <h5 class="fw-black mb-0">Total Purchases by Year</h5>
                                <select class="form-select fw-bold w-auto" @bind="_analyticsYear">
                                    @{ var distinctYears = _historyOrders.Where(o => o.IsPaid).Select(o => o.OrderDate.Year).Distinct().OrderByDescending(y => y).ToList(); }
                                    @if (!distinctYears.Any())
                                    {
                                        distinctYears.Add(DateTime.Now.Year);
                                    }
                                    @foreach (var y in distinctYears)
                                    {
                                        <option value="@y">@y</option>
                                    }
                                </select>
                            </div>
                            
                            @{
                                var yearlyOrders = _historyOrders.Where(o => o.OrderDate.Year == _analyticsYear && o.IsPaid).ToList();
                                var totalSpent = yearlyOrders.Sum(o => o.TotalCost);
                                var totalUnits = yearlyOrders.SelectMany(o => o.OrderItems).Sum(i => i.Quantity * (i.LiquorItem?.PackSize ?? 1));
                                
                                var itemStats = yearlyOrders.SelectMany(o => o.OrderItems)
                                    .GroupBy(i => i.LiquorItemId)
                                    .Select(g => new { 
                                        Item = _items.FirstOrDefault(x => x.Id == g.Key), 
                                        TotalQty = g.Sum(x => x.Quantity), 
                                        TotalSpent = g.Sum(x => x.Quantity * x.UnitPriceAtTimeOfOrder) 
                                    })
                                    .Where(x => x.Item != null)
                                    .OrderByDescending(x => x.TotalSpent)
                                    .ToList();
                            }
                            
