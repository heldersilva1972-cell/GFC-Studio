    private void HandleAuditKeyDown(KeyboardEventArgs e, int currentId)
    {
        if (e.Key == "Enter" || e.Key == "Tab")
        {
            var filteredItems = _items.Where(i => (string.IsNullOrEmpty(_searchTerm) || i.Name.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase)) && (!_filterBeerOnly || i.IsBeer)).OrderBy(i => i.Name).ToList();
            var currentIndex = filteredItems.FindIndex(i => i.Id == currentId);
            if (currentIndex >= 0 && currentIndex < filteredItems.Count - 1)
            {
                var nextId = filteredItems[currentIndex + 1].Id;
                _ = JSRuntime.InvokeVoidAsync("eval", $@"document.getElementById('audit-input-{nextId}')?.focus(); document.getElementById('audit-input-{nextId}')?.select();");
            }
        }
    }

    private async Task ConfirmReconciliationAsync()
    {
        if (_isSaving) return;
        _isSaving = true;
        try {
            await SubmitFullReconciliation();
            _showReviewModal = false;
        } finally {
            _isSaving = false;
        }
    }

