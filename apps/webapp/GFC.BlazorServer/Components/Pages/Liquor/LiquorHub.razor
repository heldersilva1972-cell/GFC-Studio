                                                     <label class="extra-small fw-black text-muted text-uppercase mb-1">Username / Email</label>
                                                     <input type="text" class="form-control form-control-sm border-2 rounded-3 fw-bold" @bind="_settings.SmtpUsername" />
                                                 </div>
                                                 <div class="mb-3">
                                                     <label class="extra-small fw-black text-muted text-uppercase mb-1">Password / App Key</label>
                                                     <input type="password" class="form-control form-control-sm border-2 rounded-3 fw-bold" @bind="_settings.SmtpPassword" />
                                                 </div>
                                                 <div class="mb-3 d-flex align-items-center justify-content-between bg-light p-2 rounded-3">
                                                     <label class="extra-small fw-black text-muted text-uppercase mb-0">Use SSL/TLS</label>
                                                     <div class="form-check form-switch pt-1">
                                                         <input class="form-check-input" type="checkbox" role="switch" @bind="_settings.SmtpEnableSsl">
                                                     </div>
                                                 </div>
                                             </div>
                                         }

