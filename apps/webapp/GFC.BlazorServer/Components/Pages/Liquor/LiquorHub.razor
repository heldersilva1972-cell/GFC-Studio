                                                <span class="extra-small text-muted fw-bold me-2">MIN $</span>
                                                <input type="number" class="form-control border-0 bg-transparent p-0 extra-small fw-bold text-center" onfocus="this.select();" @bind="_newVendorMinOrder" />
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row g-2 mb-2">
                                        <div class="col-5"><input type="tel" class="form-control form-control-sm rounded-pill border-2" @bind="_newVendorPhone" placeholder="Phone" /></div>
                                        <div class="col-7"><input type="email" class="form-control form-control-sm rounded-pill border-2" @bind="_newVendorEmail" placeholder="Email Address" /></div>
                                    </div>
                                    <div class="input-group input-group-sm">
                                        <input type="text" class="form-control rounded-pill-start border-2 border-end-0" @bind="_newVendorWebsite" placeholder="Website URL" />
                                        <button class="btn btn-primary rounded-pill-end px-4 fw-bold" @onclick="CreateVendorAsync">ADD VENDOR</button>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-7">
                                @foreach (var v in _vendors.OrderBy(v => v.Name))
                                {
                                    <div class="px-3 py-3 border rounded-4 bg-white mb-3 shadow-sm border-start border-5 border-primary">
                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                            <input type="text" class="form-control form-control-sm border-0 fw-black text-primary bg-transparent p-0" 
                                                   style="font-size: 1.1rem; box-shadow: none;"
                                                   @bind="v.Name" @bind:event="oninput" 
                                                   @bind:after="() => LiquorService.UpdateVendorAsync(v)" />
