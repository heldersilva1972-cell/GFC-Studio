@code {
    // Route parameters
    [Parameter][SupplyParameterFromQuery] public string? Tab { get; set; }

    private bool _isLoading = true;
    private string _activeTab = "ordering";
    private string _activeSetupTab = "products";
    private string _statSortMode = "profit";
    private string _searchQuery = "";
    private List<LiquorItem> _items = new();
    private List<LiquorVendor> _vendors = new();
    private List<LiquorOrder> _pendingOrders = new();
    private List<LiquorOrder> _historyOrders = new();
    
    private Dictionary<int, int> _cart = new(); // ItemId -> Quantity
    private AppUser? _currentUser;
    
    // Count State
    private Dictionary<int, int> _stockCounts = new();
    private LiquorItem? _selectedCountItem;
    private string _countEntry = "0";
    
    // Setup state
    private List<LiquorOrder> _recentOrders = new();
    private LiquorItem _newItem = new() { Name = "", BottleSize = "750ml", MinStockLimit = 6, IsActive = true };
    private string _newVendorName = "";
    private int _filterVendorId = 0;
    private string _searchTerm = "";
    private bool _isAlphabeticalView = false;
    private LiquorOrder? _orderToReceive;
    private string _receiveInvoiceNumber = "";
    private decimal _receiveTotalDue = 0;

    private LiquorOrder? _orderToPay;
    private decimal _actualPaidAmount = 0;
    private DateTime _paidDate = DateTime.Now;

    // Edit state
    private LiquorItem? _itemToEdit;

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrEmpty(Tab)) _activeTab = Tab;
        
        await LoadUserDataAsync();
        await RefreshDataAsync();
    }

    private async Task LoadUserDataAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        if (user.Identity?.IsAuthenticated == true)
        {
             var userIdStr = user.FindFirst("UserId")?.Value ?? user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
             if (int.TryParse(userIdStr, out var userId))
             {
                 // We need to look up the AppUser object or just use the ID
                 // For now let's mock it for the header display
                 _currentUser = new AppUser { Username = user.Identity.Name ?? "Staff", UserId = userId };
             }
        }
    }

    private async Task RefreshDataAsync()
    {
        _isLoading = true;
        
        var allItems = await LiquorService.GetAllItemsAsync();
        _items = allItems.ToList();
        
        var allVendors = await LiquorService.GetAllVendorsAsync();
        _vendors = allVendors.ToList();
        
        var allOrders = await LiquorService.GetAllOrdersAsync();
        _pendingOrders = allOrders.Where(o => o.Status == "Placed").ToList();
        _historyOrders = allOrders.Where(o => o.Status != "Placed").OrderByDescending(o => o.OrderDate).ToList();
        
        _isLoading = false;
        StateHasChanged();
    }

    // -- Stock Count Logic --

    private void SelectCountItem(LiquorItem item)
    {
        _selectedCountItem = item;
        _countEntry = _stockCounts.ContainsKey(item.Id) ? _stockCounts[item.Id].ToString() : "0";
    }

    private void MatchExpectedStock(LiquorItem item)
    {
        _stockCounts[item.Id] = item.CurrentStock;
        StateHasChanged();
    }

    private void HandleNumpad(string key)
    {
        if (key == "C") _countEntry = "0";
        else if (key == "DEL") 
        {
            if (_countEntry.Length > 1) _countEntry = _countEntry.Substring(0, _countEntry.Length -1);
            else _countEntry = "0";
        }
        else
        {
            if (_countEntry == "0") _countEntry = key;
            else if (_countEntry.Length < 4) _countEntry += key;
        }
    }

    private void ConfirmSingleCount()
    {
        if (_selectedCountItem == null) return;
        if (int.TryParse(_countEntry, out var val))
        {
            _stockCounts[_selectedCountItem.Id] = val;
            _selectedCountItem = null;
            _countEntry = "0";
        }
    }

    private async Task SubmitFullReconciliation()
    {
        if (!_stockCounts.Any() || _currentUser == null) return;
        
        var auditEntries = _stockCounts.Select(kvp => new GFC.Core.Models.StockReconcileEntry 
        { 
            ItemId = kvp.Key, 
            ActualCount = kvp.Value 
        }).ToList();

        await LiquorService.ReconcileStockAsync(auditEntries, _currentUser.UserId);
        
        _stockCounts.Clear();
        await RefreshDataAsync();
        _activeTab = "ordering"; // Head back to see what's low now
    }

    // -- Ordering Logic --

    private int GetCartQuantity(int itemId) => _cart.ContainsKey(itemId) ? _cart[itemId] : 0;

    private void SetCartQuantity(int itemId, object val)
    {
        if (int.TryParse(val?.ToString(), out var qty))
        {
            _cart[itemId] = Math.Max(0, qty);
        }
    }

    private void AdjustCartQuantity(int itemId, int delta)
    {
        var current = GetCartQuantity(itemId);
        _cart[itemId] = Math.Max(0, current + delta);
    }

    private decimal GetCartTotal()
    {
        decimal total = 0;
        foreach (var entry in _cart.Where(e => e.Value > 0))
        {
            var item = _items.FirstOrDefault(i => i.Id == entry.Key);
            if (item != null) total += item.CurrentPrice * entry.Value;
        }
        return total;
    }

    private async Task SubmitOrderAsync()
    {
        if (!_cart.Any(v => v.Value > 0) || _currentUser == null) return;
        
        // Group cart by Vendor
        var itemsInCart = _cart.Where(e => e.Value > 0).ToList();
        var cartByVendor = itemsInCart
            .GroupBy(e => _items.FirstOrDefault(i => i.Id == e.Key)?.VendorId)
            .Where(g => g.Key.HasValue)
            .ToList();

        if (!cartByVendor.Any()) return;

        foreach (var vendorGroup in cartByVendor)
        {
            var vendorId = vendorGroup.Key!.Value;
            var vendorItems = vendorGroup.Select(e => _items.First(i => i.Id == e.Key)).ToList();
            await PlaceVendorOrderAsync(_vendors.FirstOrDefault(v => v.Id == vendorId), vendorItems);
        }
        
        _cart.Clear();
        await RefreshDataAsync();
        _activeTab = "active";
        await JSRuntime.InvokeVoidAsync("alert", "Orders placed successfully.");
    }

    private async Task PlaceVendorOrderAsync(LiquorVendor? vendor, List<LiquorItem> items)
    {
        if (vendor == null || _currentUser == null) return;
        
        var order = new LiquorOrder
        {
            VendorId = vendor.Id,
            UserId = _currentUser.UserId,
            Status = "Placed",
            OrderDate = DateTime.UtcNow,
            ItemsTotal = 0
        };

        foreach (var item in items)
        {
            var qty = GetCartQuantity(item.Id);
            if (qty <= 0) continue;
            
            order.OrderItems.Add(new LiquorOrderItem
            {
                LiquorItemId = item.Id,
                Quantity = qty,
                UnitPriceAtTimeOfOrder = item.CurrentPrice
            });
            order.ItemsTotal += item.CurrentPrice * qty;
        }

        if (!order.OrderItems.Any()) return;
        
        order.TotalCost = order.ItemsTotal;
        await LiquorService.CreateOrderAsync(order);
        
        // Clean partial cart for this vendor
        foreach(var item in items) { _cart.Remove(item.Id); }
        
        await RefreshDataAsync();
        _activeTab = "active";
    }

    // -- Receiving Logic --

    private async Task StartReceiptAsync(LiquorOrder order)
    {
        _orderToReceive = order;
        _receiveInvoiceNumber = "";
        _receiveTotalDue = order.ItemsTotal; // Default to expected total
    }

    private async Task ConfirmReceiptAsync()
    {
        if (_orderToReceive == null || _currentUser == null) return;
        
        // Final sanity check for mandatory fields
        if (string.IsNullOrWhiteSpace(_receiveInvoiceNumber) || _receiveTotalDue <= 0) return;
        
        // Calculate discrepancy (Tax + Fees)
        var additionalCosts = _receiveTotalDue - _orderToReceive.ItemsTotal;
        
        // 1. Update order meta
        await LiquorService.UpdateOrderStatusAsync(_orderToReceive.Id, "Received", _receiveInvoiceNumber, 0, additionalCosts);
        
        // 2. Process stock arrival
        await LiquorService.ReceiveOrderAsync(_orderToReceive.Id, _currentUser.UserId);
        
        _orderToReceive = null;
        await RefreshDataAsync();
        _activeTab = "unpaid";
    }

    private void OpenPaymentModal(LiquorOrder order)
    {
        _orderToPay = order;
        _actualPaidAmount = order.TotalCost;
        _paidDate = DateTime.Now;
    }

    private async Task ConfirmPaymentAsync()
    {
        if (_orderToPay == null || _currentUser == null) return;
        
        await LiquorService.MarkOrderAsPaidAsync(_orderToPay.Id, _paidDate, _actualPaidAmount, _currentUser.UserId);
        _orderToPay = null;
        await RefreshDataAsync();
    }

