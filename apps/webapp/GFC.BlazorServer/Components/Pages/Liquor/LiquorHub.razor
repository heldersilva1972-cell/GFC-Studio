                                                       @bind="v.PhoneNumber" @bind:event="oninput" @bind:after="() => LiquorService.UpdateVendorAsync(v)" />
                                            </div>
                                            <div class="col-4">
                                                <label class="extra-small fw-bold text-muted d-block mb-1">EMAIL</label>
                                                <input type="email" class="form-control form-control-sm border-1 rounded-3 bg-light extra-small fw-bold" 
                                                       @bind="v.Email" @bind:event="oninput" @bind:after="() => LiquorService.UpdateVendorAsync(v)" />
                                            </div>
                                            <div class="col-4">
                                                <label class="extra-small fw-bold text-muted d-block mb-1">MIN ORDER</label>
                                                <input type="number" class="form-control form-control-sm border-1 rounded-3 bg-light extra-small fw-bold text-center" 
