                                @if (_isSaving) { <span class="spinner-border spinner-border-sm me-1"></span> <span>SAVING...</span> }
                                else { <i class="bi bi-check-lg me-1"></i> <span>SAVE SETTINGS</span> }
                            </button>
                        </div>
                        <div class="row g-4 animate-slide-up">
                            <div class="col-md-6">
                                <div class="card border-0 shadow-sm rounded-4 p-4 h-100">
                                    <h6 class="extra-small fw-black text-muted text-uppercase mb-4 tracking-wider">Yield & Pour Standards</h6>
                                    
                                    <div class="p-4 bg-light rounded-4 mb-4">
                                        <label class="extra-small fw-black text-muted text-uppercase mb-2 d-block ms-1">Global Shot Size (oz)</label>
                                        <div class="input-group input-group-lg">
                                            <input type="number" step="0.05" class="form-control border-0 shadow-sm rounded-start-3 fw-black" 
                                                   @bind="_settings.GlobalLiquorPourSize" />
                                            <span class="input-group-text border-0 bg-white shadow-sm rounded-end-3 fw-bold text-muted">OZ</span>
                                        </div>
                                        <p class="extra-small text-muted mt-3 mb-0" style="line-height: 1.4;">
                                            <i class="bi bi-info-circle me-1"></i>
                                            This value is used to calculate the **Expected Yield** from a bottle. Changing this will affect all "Expected vs Actual" reports in the Hub.
                                        </p>
                                    </div>

                                    <div class="p-4 bg-light rounded-4">
                                        <h6 class="small fw-black mb-3 text-uppercase">Yield Logic</h6>
                                        <p class="extra-small text-muted mb-0">
                                            The system calculates yield using: <br/>
                                            <code>(Bottle Size in ML / 29.57) / Global Shot Size</code>
                                        </p>
                                    </div>
                                </div>
                            </div>
                            
                            <div class="col-md-6">
                                 <div class="card border-0 shadow-sm rounded-4 p-4 h-100 bg-primary bg-opacity-10 border border-primary border-opacity-10">
                                     <h6 class="extra-small fw-black text-primary text-uppercase mb-4 tracking-wider">System Guidance</h6>
                                     <div class="d-flex gap-3 mb-4">
                                         <div class="display-6 text-primary"><i class="bi bi-lightbulb"></i></div>
                                         <div>
                                             <p class="small fw-bold text-primary mb-1">Consistency is Key</p>
                                             <p class="extra-small text-muted mb-0">Ensure your bartenders are trained to the same @(_settings?.GlobalLiquorPourSize ?? 1.5m)oz standard to maintain inventory accuracy.</p>
                                         </div>
                                     </div>
                                     <div class="alert alert-white border-0 shadow-sm rounded-3">
                                         <p class="extra-small mb-0 fw-bold"><i class="bi bi-shield-check text-success me-2"></i>Yield calculations are processed in real-time during shift close-outs.</p>
                                     </div>
                                 </div>
                            </div>
                        </div>
                    }
                </div>
            }
            </div>
        }

<!-- Receipt Modal -->
@if (_orderToReceive != null)
{
    <div class="modal-backdrop-modern animate-fade-in">
        <div class="modal-card animate-slide-up shadow-lg">
            <div class="modal-header bg-success text-white py-4">
                <h3 class="mb-0 fw-black text-uppercase tracking-wider">RECEIVING: @(_orderToReceive.Vendor?.Name)</h3>
                <button class="btn-close btn-close-white" @onclick="() => _orderToReceive = null"></button>
            </div>
            <div class="modal-body p-4">
                <p class="small text-muted mb-4">Confirm final invoice details before finalizing shipment into inventory.</p>
                
                <div class="row g-3 mb-4">
                    <div class="col-12">
                         <label class="small fw-black text-muted mb-2 text-uppercase tracking-wider">Review Items (@_orderToReceive.OrderItems.Count)</label>
                         <div class="card rounded-3 border bg-light overflow-hidden">
                             <div class="list-group list-group-flush overflow-auto" style="max-height: 250px;">
                                 @foreach (var oi in _orderToReceive.OrderItems)
                                 {
                                     <div class="list-group-item bg-white d-flex justify-content-between align-items-center py-2 px-3 border-light @(oi.IsBackordered ? "opacity-50" : "")">
                                         <div class="d-flex align-items-center gap-3">
                                             <div class="fw-black text-dark" style="min-width: 40px;">@oi.Quantity&times;</div>
                                             <div>
                                                 <div class="fw-bold @(oi.IsBackordered ? "text-decoration-line-through text-muted" : "text-dark")">@oi.LiquorItem?.Name</div>
                                                 @if (oi.IsBackordered)
                                                 {
                                                     <span class="badge bg-warning text-dark extra-small rounded-pill px-2">BACKORDERED</span>
                                                 }
                                             </div>
                                         </div>
                                         <button class="btn btn-sm @(oi.IsBackordered ? "btn-primary" : "btn-outline-warning") rounded-pill px-3 fw-bold" 
                                                 @onclick="() => oi.IsBackordered = !oi.IsBackordered">
                                             @(oi.IsBackordered ? "UNDO" : "BACKORDER")
                                         </button>
                                     </div>
                                 }
                             </div>
                         </div>
                    </div>

                    <div class="col-md-6">
                        <label class="small fw-bold text-muted mb-1">Invoice Number (Optional)</label>
                        <input type="text" class="form-control fw-bold" @bind="_receiveInvoiceNumber" @bind:event="oninput" placeholder="INV-0000..." />
                    </div>
                    <div class="col-md-6">
                        <label class="small fw-bold text-muted mb-1">Actual Total Amount (Due on Invoice)</label>
                        <div class="input-group">
                            <span class="input-group-text">$</span>
                            <input type="number" class="form-control fw-bold text-dark text-center" onfocus="this.select();" 
                                   @bind="_receiveTotalDue" @bind:event="oninput" step="0.01" />
                        </div>
                    </div>
                </div>

                <div class="p-3 bg-light rounded-3 mb-4">
                    @{
                        var receivedTotal = _orderToReceive.OrderItems.Where(i => !i.IsBackordered).Sum(i => i.UnitPriceAtTimeOfOrder * i.Quantity);
                    }
                    <div class="d-flex justify-content-between mb-1">
                        <span class="text-muted">Calculated Received Total</span>
                        <span class="fw-bold">@(receivedTotal.ToString("C"))</span>
                    </div>
                    <div class="d-flex justify-content-between h3 fw-black text-dark mb-0">
                        <span>Invoice Amount</span>
                        <span>@(_receiveTotalDue.ToString("C"))</span>
                    </div>
                </div>

                <div class="alert alert-warning small border-0 py-2">
                    <i class="bi bi-info-circle me-1"></i> Clicking confirm will automatically increase your stock on hand by the ordered amounts.
                </div>
            </div>
            <div class="modal-footer p-3 bg-light d-flex gap-2">
                <button class="btn btn-light border fw-bold flex-grow-1" @onclick="() => _orderToReceive = null">Cancel</button>
                <button class="btn btn-success fw-black flex-grow-1 shadow-sm" 
                        @onclick="() => ConfirmReceiptAsync()" 
                        disabled="@(_receiveTotalDue <= 0)">
                    @((_receiveTotalDue <= 0) ? "ENTER AMOUNT TO CONFIRM" : "CONFIRM RECEIVE")
                </button>
            </div>
        </div>
    </div>
}

<!-- Payment Modal -->
@if (_orderToPay != null)
{
    <div class="modal-backdrop-modern animate-fade-in">
        <div class="modal-card animate-slide-up shadow-lg border-danger border-top border-5">
            <div class="modal-header bg-white py-4 d-flex justify-content-between align-items-center">
                <div>
                     <h3 class="mb-0 fw-black text-uppercase text-danger">CONFIRM PAYMENT</h3>
                     <div class="small text-muted">Invoice #@(_orderToPay.InvoiceNumber ?? "N/A") from @_orderToPay.Vendor?.Name</div>
                </div>
                <button class="btn-close" @onclick="() => _orderToPay = null"></button>
            </div>
            <div class="modal-body p-4">
                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label class="small fw-bold text-muted mb-1">Check/Entry Date</label>
                        <input type="date" class="form-control fw-bold" @bind="_paidDate" />
