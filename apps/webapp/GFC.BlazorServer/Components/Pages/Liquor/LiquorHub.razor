    private decimal GetLineTotal(LiquorItem item, int qty)
    {
        decimal lineTotal = 0;
        decimal casePrice = (item.CasePrice.HasValue && item.CasePrice.Value > 0) 
            ? item.CasePrice.Value 
            : item.CurrentPrice;

        decimal bottlePrice = (item.CasePrice.HasValue && item.CasePrice.Value > 0)
            ? item.CurrentPrice
            : (item.PackSize > 0 ? (item.CurrentPrice / item.PackSize) : item.CurrentPrice);

        if (item.PackSize > 1)
        {
            int cases = qty / item.PackSize;
            int bottles = qty % item.PackSize;
            decimal effectiveCasePrice = (item.BulkDiscountThreshold.HasValue && item.BulkDiscountPrice.HasValue && cases >= item.BulkDiscountThreshold.Value)
                ? item.BulkDiscountPrice.Value
                : casePrice;
            lineTotal = (cases * effectiveCasePrice) + (bottles * bottlePrice);
        }
        else
        {
            lineTotal = item.CurrentPrice * qty;
        }
        if (item.IsBeer) lineTotal += 0.05m * qty;
        return lineTotal;
    }

