    public class OrderConfirmationSummary
    {
        public string VendorName { get; set; } = "";
        public int ItemCount { get; set; }
        public decimal Total { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrEmpty(Tab)) _activeTab = Tab;
        
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        if (user.Identity?.IsAuthenticated == true)
        {
             var userIdStr = user.FindFirst("UserId")?.Value 
                          ?? user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value
                          ?? user.FindFirst("sub")?.Value;
                           
             if (int.TryParse(userIdStr, out var userId))
             {
                 _currentUser = new AppUser { Username = user.Identity.Name ?? "Staff", UserId = userId };
             }
             else
             {
                 var idClaim = user.Claims.FirstOrDefault(c => c.ValueType == System.Security.Claims.ClaimValueTypes.Integer || c.Type.Contains("id", StringComparison.OrdinalIgnoreCase));
                 if (idClaim != null && int.TryParse(idClaim.Value, out var fallbackId))
                 {
                     _currentUser = new AppUser { Username = user.Identity.Name ?? "Staff", UserId = fallbackId };
                 }
             }
        }
        _settings = await SystemSettingsService.GetAsync();
        await RefreshDataAsync();
        
        // Start the auto-refresh loop for background status updates
        _ = AutoRefreshLoop();
    }

    private async Task AutoRefreshLoop()
    {
        while (!_isDisposed)
        {
            await Task.Delay(4000); // Check every 4 seconds
            if (!_isDisposed && _pendingOrders.Any(o => o.IsEmailed && o.LastEmailedDate == null))
            {
                await RefreshDataAsync(silent: true);
            }
        }
    }

    public void Dispose() => _isDisposed = true;

    private async Task RefreshDataAsync() => await RefreshDataAsync(false);

    private async Task RefreshDataAsync(bool silent)
    {
        if (!silent)
        {
            _isLoading = true;
            StateHasChanged();
        }
        
        // PHASE 1: Critical Data (Required for main dashboard and ordering)
        // We only wait for items and vendors to let the user start working immediately
        var settingsTask = SystemSettingsService.GetAsync();
        var itemsTask = LiquorService.GetAllItemsAsync();
        var vendorsTask = LiquorService.GetAllVendorsAsync();
        
        await Task.WhenAll(settingsTask, itemsTask, vendorsTask);
        
        _settings = await settingsTask;
        _items = (await itemsTask).ToList();
        _vendors = (await vendorsTask).ToList();

        // Reveal the UI as soon as critical data is ready
        _isLoading = false;
        StateHasChanged();

        // PHASE 2: Heavy Background Data (History, Trends, Transactions, Backorders)
        _ = Task.Run(async () => {
            try {
                var ordersTask = LiquorService.GetAllOrdersAsync();
                var recentTxTask = LiquorService.GetRecentTransactionsAsync(500);
                var backordersTask = LiquorService.GetPendingBackordersAsync();

                await Task.WhenAll(ordersTask, recentTxTask, backordersTask);

                var allOrders = (await ordersTask).ToList();
                var recentTransactions = (await recentTxTask).ToList();
                var pendingBackorders = (await backordersTask).ToList();

                // Heavy processing done on background thread, NOT blocking the UI thread
                var pendingOrders = allOrders.Where(o => o.Status == "Placed").ToList();
                var historyOrders = allOrders.Where(o => o.Status != "Placed").OrderByDescending(o => o.OrderDate).ToList();
                
                var itemOrderCounts = historyOrders
                    .SelectMany(o => o.OrderItems)
                    .GroupBy(i => i.LiquorItemId)
                    .ToDictionary(g => g.Key, g => g.Sum(x => x.Quantity));
                
                var lastReconcileDate = recentTransactions
                    .Where(t => t.TransactionType == "Reconcile")
                    .OrderByDescending(t => t.Timestamp)
                    .Select(t => (DateTime?)t.Timestamp)
                    .FirstOrDefault();

                // Final state update on UI thread
                await InvokeAsync(() => {
                    _pendingBackorders = pendingBackorders;
                    _pendingOrders = pendingOrders;
                    _historyOrders = historyOrders;
                    _itemOrderCounts = itemOrderCounts;
                    _recentTransactions = recentTransactions;
                    _auditHistory = _recentTransactions; 
                    _lastReconcileDate = lastReconcileDate;
                    
                    StateHasChanged();
                });
            }
            catch (Exception ex) {
                Console.WriteLine($"[LiquorHub] Background load failed: {ex.Message}");
            }
        });
    }

    // -- Stock Count Logic --

    private void SelectCountItem(LiquorItem item)
    {
        _selectedCountItem = item;
        _countEntry = _stockCounts.ContainsKey(item.Id) ? _stockCounts[item.Id].ToString() : "0";
    }

    private void MatchExpectedStock(LiquorItem item)
    {
        _stockCounts[item.Id] = item.CurrentStock;
        StateHasChanged();
    }

    private void HandleNumpad(string key)
    {
        if (key == "C") _countEntry = "0";
        else if (key == "DEL") 
        {
            if (_countEntry.Length > 1) _countEntry = _countEntry.Substring(0, _countEntry.Length -1);
            else _countEntry = "0";
        }
        else
        {
            if (_countEntry == "0") _countEntry = key;
            else if (_countEntry.Length < 4) _countEntry += key;
        }
    }

    private void ConfirmSingleCount()
    {
        if (_selectedCountItem == null) return;
        if (int.TryParse(_countEntry, out var val))
        {
            _stockCounts[_selectedCountItem.Id] = val;
            _selectedCountItem = null;
            _countEntry = "0";
        }
    }

    private void UpdateItemCount(int itemId, object? value)
    {
        if (value == null || string.IsNullOrWhiteSpace(value.ToString()))
        {
            _stockCounts.Remove(itemId);
            return;
        }

        if (int.TryParse(value.ToString(), out var res))
        {
            _stockCounts[itemId] = res;
        }
    }

    private void MatchRemainingItems()
    {
        var visibleItems = _items.Where(i => (string.IsNullOrEmpty(_searchTerm) || i.Name.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase)) && (!_filterBeerOnly || i.IsBeer));
        foreach (var item in visibleItems)
        {
            if (!_stockCounts.ContainsKey(item.Id))
            {
                _stockCounts[item.Id] = item.CurrentStock;
            }
        }
        StateHasChanged();
    }

    private void AdjustItemCount(int itemId, int delta, int expected)
    {
        if (!_stockCounts.ContainsKey(itemId))
        {
            // If they click +/- on an uncounted item, start at expected + delta
            _stockCounts[itemId] = expected + delta;
        }
        else
        {
            _stockCounts[itemId] += delta;
        }
        
        if (_stockCounts[itemId] < 0) _stockCounts[itemId] = 0;
    }
    private async Task SubmitFullReconciliation()
    {
        if (_currentUser == null) return;
        
        // Use current stock for anything not explicitly changed in the audit
        var auditEntries = _items.Select(item => new GFC.Core.Models.StockReconcileEntry 
        { 
            ItemId = item.Id, 
            ActualCount = _stockCounts.TryGetValue(item.Id, out var actual) ? actual : item.CurrentStock
        }).ToList();

        await LiquorService.ReconcileStockAsync(auditEntries, _currentUser.UserId);
        
        _stockCounts.Clear();
        await RefreshDataAsync();
        _activeTab = "ordering"; 
    }

    // -- Ordering Logic --

    private int GetCartQuantity(int itemId) => _cart.ContainsKey(itemId) ? _cart[itemId] : 0;

    private void SetCartQuantity(int itemId, object val)
    {
        if (int.TryParse(val?.ToString(), out var qty))
        {
            _cart[itemId] = Math.Max(0, qty);
        }
    }

    private void AdjustCartQuantity(int itemId, int delta)
    {
        var item = _items.FirstOrDefault(i => i.Id == itemId);
        int step = (item != null && item.PackSize > 1) ? item.PackSize : 1;
        var current = GetCartQuantity(itemId);
        _cart[itemId] = Math.Max(0, current + (delta * step));
    }

    private decimal GetCartTotal()
    {
        decimal total = 0;
        foreach (var entry in _cart.Where(e => e.Value > 0))
        {
            var item = _items.FirstOrDefault(i => i.Id == entry.Key);
            if (item != null) 
            {
                var purchaseUnits = item.PackSize > 0 ? (decimal)entry.Value / item.PackSize : entry.Value;
                total += item.CurrentPrice * purchaseUnits;
                
                // 5c bottle fee is per individual unit, not per case or multiplied by packsize again
                if (item.IsBeer) total += 0.05m * entry.Value;
            }
        }
        return total;
    }

    private int? _singleOrderVendorId = null;
    private void ShowOrderConfirmation(int? vendorId = null)
    {
        _singleOrderVendorId = vendorId;
        if (!_cart.Any(v => v.Value > 0)) return;
        _orderSummary.Clear();

        var cartItems = _cart.Where(e => e.Value > 0)
            .Select(e => new { Item = _items.FirstOrDefault(i => i.Id == e.Key), Qty = e.Value })
            .Where(x => x.Item != null && (!vendorId.HasValue || x.Item.VendorId == vendorId.Value))
            .ToList();

        foreach (var vGroup in cartItems.GroupBy(x => x.Item!.VendorId))
        {
            var vendor = vGroup.First().Item!.Vendor;
            decimal vTotal = 0;
            int vQty = 0;
            foreach (var x in vGroup)
            {
                var purchaseUnits = x.Item!.PackSize > 0 ? (decimal)x.Qty / x.Item.PackSize : x.Qty;
                vTotal += x.Item.CurrentPrice * purchaseUnits;
                if (x.Item.IsBeer) vTotal += 0.05m * x.Qty;
                vQty += x.Qty;
            }

            _orderSummary.Add(new OrderConfirmationSummary {
                VendorName = vendor?.Name ?? "Unknown",
                ItemCount = vQty,
                Total = vTotal
            });
        }

        if (_orderSummary.Any())
        {
            _showOrderConfirm = true;
            StateHasChanged();
        }
    }

    private async Task ConfirmAndPlaceOrders()
    {
        _showOrderConfirm = false;
        
        // Group cart by Vendor
        var itemsInCart = _cart.Where(e => e.Value > 0).ToList();
        
        if (_singleOrderVendorId.HasValue)
        {
            var vendorId = _singleOrderVendorId.Value;
            var vendorItems = itemsInCart
                .Select(e => _items.FirstOrDefault(i => i.Id == e.Key))
                .Where(i => i != null && i.VendorId == vendorId)
                .ToList();
            
            await PlaceVendorOrderAsync(_vendors.FirstOrDefault(v => v.Id == vendorId), vendorItems!, _emailThisOrder);
            _singleOrderVendorId = null;
        }
        else
        {
            var cartByVendor = itemsInCart
                .GroupBy(e => _items.FirstOrDefault(i => i.Id == e.Key)?.VendorId)
                .Where(g => g.Key.HasValue)
                .ToList();

            foreach (var vendorGroup in cartByVendor)
            {
                var vendorId = vendorGroup.Key!.Value;
                var vendorItems = vendorGroup.Select(e => _items.First(i => i.Id == e.Key)).ToList();
                await PlaceVendorOrderAsync(_vendors.FirstOrDefault(v => v.Id == vendorId), vendorItems, _emailThisOrder);
            }
        }
        
        // Reset email state
        _emailThisOrder = false;
        _orderInstructions = "";
        
        await RefreshDataAsync();
        _activeTab = "active";
        StateHasChanged();
    }

    private async Task SubmitOrderAsync()
    {
        ShowOrderConfirmation();
        await Task.CompletedTask;
    }

    private async Task PlaceVendorOrderAsync(LiquorVendor? vendor, List<LiquorItem> items, bool sendEmail = false)
    {
        if (vendor == null || _currentUser == null) return;
        
        var order = new LiquorOrder
        {
            VendorId = vendor.Id,
            UserId = _currentUser.UserId,
            Status = "Placed",
            OrderDate = DateTime.UtcNow,
            ItemsTotal = 0,
            AdditionalCosts = 0,
            SpecialInstructions = _orderInstructions
        };

        foreach (var item in items)
        {
            var qty = GetCartQuantity(item.Id);
            if (qty <= 0) continue;
            
            var purchaseUnits = item.PackSize > 0 ? (decimal)qty / item.PackSize : qty;
            var lineTotal = item.CurrentPrice * purchaseUnits;
            if (item.IsBeer) lineTotal += 0.05m * qty;

            order.OrderItems.Add(new LiquorOrderItem
            {
                LiquorItemId = item.Id,
                Quantity = qty,
                UnitPriceAtTimeOfOrder = item.CurrentPrice,
                BottleFeeAtTimeOfOrder = item.IsBeer ? 0.05m : 0 
            });
            order.ItemsTotal += lineTotal;
        }

        if (!order.OrderItems.Any()) return;
        
        order.TotalCost = order.ItemsTotal + order.AdditionalCosts;
        
        // Trigger create (this handles the email dispatch in background)
        await LiquorService.CreateOrderAsync(order, sendEmail);
        
        // Clean partial cart for this vendor
        foreach(var item in items) { _cart.Remove(item.Id); }
        
        await RefreshDataAsync();
        _activeTab = "active";
    }

    // -- Receiving Logic --

    private async Task StartReceiptAsync(LiquorOrder order)
    {
        _orderToReceive = order;
        _receiveInvoiceNumber = "";
        _receiveTotalDue = 0; // Default to zero for manual entry
    }

    private async Task ConfirmReceiptAsync()
    {
        if (_orderToReceive == null || _currentUser == null) return;
        
        // Final sanity check for mandatory fields
        if (string.IsNullOrWhiteSpace(_receiveInvoiceNumber) || _receiveTotalDue <= 0) return;
        
        // Calculate discrepancy (Tax + Fees) on RECEIVED items only
        var receivedItemsTotal = _orderToReceive.OrderItems.Where(i => !i.IsBackordered).Sum(i => i.UnitPriceAtTimeOfOrder * i.Quantity);
        var additionalCosts = _receiveTotalDue - receivedItemsTotal;
        
        // 0. Save backorder status
        var backorderedIds = _orderToReceive.OrderItems.Where(i => i.IsBackordered).Select(i => i.Id).ToList();
        await LiquorService.UpdateOrderItemsBackorderAsync(_orderToReceive.Id, backorderedIds);

        // 1. Update order meta
        await LiquorService.UpdateOrderStatusAsync(_orderToReceive.Id, "Received", _receiveInvoiceNumber, 0, additionalCosts);
        
        // 2. Process stock arrival (Skips backordered items based on updated DB state)
        await LiquorService.ReceiveOrderAsync(_orderToReceive.Id, _currentUser.UserId);
        
        _orderToReceive = null;
        await RefreshDataAsync();
        
        // Custom Confirmation
        TriggerSuccess("ORDER RECEIVED", "Inventory has been updated and the invoice recorded.");
        
        _activeTab = null; // Back to Dashboard
    }

    private async Task ResolveBackorder(LiquorOrderItem oi)
    {
        if (_currentUser == null) return;
        
        await LiquorService.ResolveBackorderAsync(oi.Id, _currentUser.UserId);
        await RefreshDataAsync();
        TriggerSuccess("BACKORDER RESOLVED", $"{oi.LiquorItem?.Name} has been received into inventory.");
    }

    private void OpenPaymentModal(LiquorOrder order)
    {
        _orderToPay = order;
        _actualPaidAmount = order.TotalCost;
        _paidDate = DateTime.Now;
    }

    private async Task ConfirmPaymentAsync()
    {
        if (_orderToPay == null || _currentUser == null) return;
        
        await LiquorService.MarkOrderAsPaidAsync(_orderToPay.Id, _paidDate, _actualPaidAmount, _currentUser.UserId);
        _orderToPay = null;
        await RefreshDataAsync();
    }

    // -- Setup Logic --

    private async Task CreateVendorAsync()
    {
        if (string.IsNullOrWhiteSpace(_newVendorName)) return;
        
        await LiquorService.CreateVendorAsync(new LiquorVendor { 
            Name = _newVendorName,
            MinimumOrderAmount = _newVendorMinOrder,
