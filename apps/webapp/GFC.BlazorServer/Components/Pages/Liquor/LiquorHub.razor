            <div class="modal-footer p-3 bg-light d-flex gap-2">
                <button class="btn btn-light border fw-bold flex-grow-1" @onclick="() => _orderToPay = null">Cancel</button>
                <button class="btn btn-danger fw-black flex-grow-1 shadow-sm" 
                        disabled="@(_actualPaidAmount <= 0)" 
                        @onclick="() => ConfirmPaymentAsync()">
                    @(_actualPaidAmount <= 0 ? "ENTER AMOUNT" : "CONFIRM PAYMENT")
                </button>
            </div>
        </div>
    </div>
}
 
 <!-- Order Confirmation Modal (Desktop) -->
 @if (_showOrderConfirm)
 {
     <div class="modal-backdrop-modern animate-fade-in" style="z-index: 9999;">
