    private async Task PlaceVendorOrderAsync(LiquorVendor? vendor, List<LiquorItem> items, bool sendEmail = false)
    {
        if (vendor == null || _currentUser == null) return;
        
        var order = new LiquorOrder
        {
            VendorId = vendor.Id,
            UserId = _currentUser.UserId,
            Status = "Placed",
            OrderDate = DateTime.UtcNow,
            ItemsTotal = 0,
            AdditionalCosts = 0,
            SpecialInstructions = _orderInstructions
        };

        foreach (var item in items)
        {
            var qty = GetCartQuantity(item.Id);
            if (qty <= 0) continue;
            
            order.OrderItems.Add(new LiquorOrderItem
            {
                LiquorItemId = item.Id,
                Quantity = qty,
                UnitPriceAtTimeOfOrder = item.CurrentPrice,
                BottleFeeAtTimeOfOrder = 0 // Removed fee
            });
            order.ItemsTotal += item.CurrentPrice * qty;
            // AdditionalCosts stays 0
        }

        if (!order.OrderItems.Any()) return;
        
        order.TotalCost = order.ItemsTotal + order.AdditionalCosts;
        
        // Trigger create (this handles the email dispatch in background)
        await LiquorService.CreateOrderAsync(order, sendEmail);
        
        // Clean partial cart for this vendor
        foreach(var item in items) { _cart.Remove(item.Id); }
        
        await RefreshDataAsync();
        _activeTab = "active";
    }

    // -- Receiving Logic --

    private async Task StartReceiptAsync(LiquorOrder order)
    {
        _orderToReceive = order;
