                            </div>
                        </div>
                    }
                </div>

                <div class="tab-scroll-area">
                    <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white p-4">
                        @if (_historySubTab == "orders")
                        {
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="bg-light sticky-top">
                                        <tr class="extra-small text-muted text-uppercase tracking-wider">
                                            <th class="ps-3">Date</th>
                                            <th>Vendor</th>
                                            <th>Invoice #</th>
                                            <th>Total Cost</th>
                                            <th>Payment Date</th>
                                            <th class="text-end pe-3">Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @{
                                            var filteredHistoryList = _historyOrders.Where(o => o.IsPaid);
                                            if (_historyYearFilter > 0) filteredHistoryList = filteredHistoryList.Where(o => o.OrderDate.Year == _historyYearFilter);
                                            if (_historyVendorFilter > 0) filteredHistoryList = filteredHistoryList.Where(o => o.VendorId == _historyVendorFilter);
                                            if (!string.IsNullOrWhiteSpace(_historyProductSearch))
                                            {
                                                filteredHistoryList = filteredHistoryList.Where(o => o.OrderItems.Any(i => i.LiquorItem != null && i.LiquorItem.Name.Contains(_historyProductSearch, StringComparison.OrdinalIgnoreCase)));
                                            }
                                        }
                                        @if (!filteredHistoryList.Any())
                                        {
                                            <tr><td colspan="6" class="text-center py-5 text-muted fw-bold">No completed orders found matching those filters.</td></tr>
                                        }
                                        @foreach (var order in filteredHistoryList.OrderByDescending(o => o.OrderDate))
                                        {
                                            bool isExpanded = _expandedHistoryOrders.Contains(order.Id);
                                            <tr style="cursor: pointer;" @onclick="() => ToggleHistoryOrder(order.Id)">
                                                <td class="ps-3">
                                                    <div class="fw-bold">@order.OrderDate.ToString("MMM dd, yyyy")</div>
                                                    <div class="extra-small text-muted">By @order.User?.Username</div>
                                                </td>
                                                <td><span class="fw-black">@order.Vendor?.Name</span></td>
                                                <td><span class="badge border bg-light text-dark fw-bold">@order.InvoiceNumber</span></td>
                                                <td class="fw-black text-primary">@order.TotalCost.ToString("C")</td>
                                                <td>
                                                    <div class="small fw-bold text-success"><i class="bi bi-check-circle-fill me-1"></i> @(order.PaidDate?.ToString("MM/dd/yy"))</div>
                                                </td>
                                                <td class="text-end pe-3 d-flex align-items-center justify-content-end gap-2">
                                                     @if (!string.IsNullOrEmpty(order.Vendor?.Email))
                                                     {
                                                         <button class="btn btn-sm btn-icon border-0 @(order.IsEmailed ? "text-success" : "text-muted")" title="Resend Email" @onclick="() => ResendOrderEmailAsync(order)" @onclick:stopPropagation>
                                                             <i class="bi @(order.IsEmailed ? "bi-envelope-check" : "bi-envelope")"></i>
                                                         </button>
                                                     }
                                                     <button class="btn btn-sm btn-outline-primary rounded-pill border-2 fw-black" @onclick="() => PrintOrder(order.Id)" @onclick:stopPropagation><i class="bi bi-printer"></i></button>
                                                     <i class="bi @(isExpanded ? "bi-chevron-up" : "bi-chevron-down") text-muted fw-bold ms-3"></i>
                                                 </td>
                                            </tr>
                                            @if (isExpanded)
                                            {
                                                <tr>
                                                    <td colspan="6" class="p-0 border-0">
                                                        <div class="bg-light p-3 border-bottom shadow-inner">
                                                            <h6 class="fw-black text-uppercase extra-small text-muted mb-3">Order Contents</h6>
                                                            <div class="row g-2">
                                                                @foreach (var item in order.OrderItems)
                                                                {
                                                                    bool matchesSearch = !string.IsNullOrWhiteSpace(_historyProductSearch) && 
                                                                                       item.LiquorItem?.Name.Contains(_historyProductSearch, StringComparison.OrdinalIgnoreCase) == true;
                                                                    
                                                                    <div class="col-md-6 col-lg-4">
                                                                        <div class="card rounded-3 border-0 shadow-sm p-2 @(matchesSearch ? "border-start border-3 border-primary bg-primary-subtle" : "bg-white")">
                                                                            <div class="d-flex justify-content-between align-items-center">
                                                                                <div>
                                                                                    <div class="fw-bold" style="font-size: 0.85rem;">@item.LiquorItem?.Name</div>
                                                                                    <div class="text-muted" style="font-size: 0.7rem;">@item.LiquorItem?.BottleSize | @item.UnitPriceAtTimeOfOrder.ToString("C")</div>
                                                                                </div>
                                                                                <div class="text-end ms-2">
                                                                                    @{
                                                                                        var packSize = item.LiquorItem?.PackSize ?? 1;
                                                                                        var purchaseQty = packSize > 1 ? (decimal)item.Quantity / packSize : item.Quantity;
                                                                                        var subtotal = (purchaseQty * item.UnitPriceAtTimeOfOrder) + (item.BottleFeeAtTimeOfOrder * item.Quantity);
                                                                                    }
                                                                                    <div class="fw-black">@purchaseQty @(packSize > 1 ? "cs" : "×")</div>
                                                                                    <div class="fw-bold text-primary" style="font-size: 0.8rem;">@subtotal.ToString("C")</div>
                                                                                </div>
                                                                            </div>
                                                                        </div>
                                                                    </div>
                                                                }
                                                            </div>
                                                        </div>
                                                    </td>
                                                </tr>
                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else if (_historySubTab == "purchases")
                        {
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="bg-light sticky-top">
                                        <tr class="extra-small text-muted text-uppercase tracking-wider">
                                            <th class="ps-3">Order Date</th>
                                            <th>Vendor</th>
                                            <th>Invoice #</th>
                                            <th class="text-center">Quantity</th>
                                            <th class="text-end">Unit Cost</th>
                                            <th class="text-end">Subtotal</th>
                                            <th class="text-end pe-3">Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (_historyPurchaseProductId == 0)
                                        {
                                            <tr><td colspan="7" class="text-center py-5 text-muted fw-bold">Please select a product from the dropdown above.</td></tr>
                                        }
                                        else
                                        {
                                            @foreach (var order in _historyOrders.Where(o => o.IsPaid && o.OrderItems.Any(oi => oi.LiquorItemId == _historyPurchaseProductId)).OrderByDescending(o => o.OrderDate))
                                            {
                                                var item = order.OrderItems.First(oi => oi.LiquorItemId == _historyPurchaseProductId);
                                                var packSize = item.LiquorItem?.PackSize ?? 1;
                                                var purchaseQty = packSize > 1 ? (decimal)item.Quantity / packSize : item.Quantity;
                                                var subtotal = (purchaseQty * item.UnitPriceAtTimeOfOrder) + (item.BottleFeeAtTimeOfOrder * item.Quantity);
                                                
                                                <tr>
                                                    <td class="ps-3 fw-bold">@order.OrderDate.ToString("MM/dd/yyyy")</td>
                                                    <td class="fw-bold">@order.Vendor?.Name</td>
                                                    <td><span class="badge border bg-light text-dark fw-bold">@order.InvoiceNumber</span></td>
                                                    <td class="text-center fw-black">@purchaseQty @(packSize > 1 ? "cs" : "units")</td>
                                                    <td class="text-end">@item.UnitPriceAtTimeOfOrder.ToString("C")</td>
                                                    <td class="text-end fw-bold text-primary">@subtotal.ToString("C")</td>
                                                    <td class="text-end pe-3">
                                                        <button class="btn btn-sm btn-icon text-muted" @onclick="() => PrintOrder(order.Id)"><i class="bi bi-printer"></i></button>
                                                    </td>
                                                </tr>
                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="bg-light sticky-top">
                                        <tr class="extra-small text-muted text-uppercase tracking-wider">
                                            <th class="ps-3">Timestamp</th>
                                            <th>Product</th>
                                            <th>Action Type</th>
                                            <th class="text-center">Count Change</th>
                                            <th>Audit Details / Notes</th>
                                            <th class="text-end pe-3">Performed By</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (!_recentTransactions.Any())
                                        {
                                            <tr>
                                                <td colspan="6" class="text-center py-5 text-muted">No system activity has been recorded yet.</td>
                                            </tr>
                                        }
                                        @foreach (var tx in _recentTransactions.Where(t => string.IsNullOrEmpty(t.Notes) || !t.Notes.StartsWith("POS Sale")).OrderByDescending(t => t.Timestamp))
                                        {
                                            <tr>
                                                <td class="ps-3">
                                                    <div class="fw-bold">@tx.Timestamp.ToLocalTime().ToString("MM/dd")</div>
                                                    <div class="extra-small text-muted opacity-75">@tx.Timestamp.ToLocalTime().ToString("h:mm tt")</div>
                                                </td>
                                                <td class="fw-black text-dark">@(tx.Item?.Name ?? "Product #" + tx.ItemId)</td>
                                                <td>
                                                    <span class="badge rounded-pill pt-1 px-3 @(tx.TransactionType switch { "Update" => "bg-primary", "Restock" => "bg-success", "Checkout" => "bg-danger", _ => "bg-secondary" })" style="font-size: 0.65rem; font-weight: 800;">
                                                        @tx.TransactionType.ToUpper()
                                                    </span>
                                                </td>
                                                <td class="text-center fw-black">
                                                    @if (tx.ChangeAmount != 0)
                                                    {
                                                        <span class="@(tx.ChangeAmount > 0 ? "text-success" : "text-danger")">@(tx.ChangeAmount > 0 ? "+" : "")@tx.ChangeAmount</span>
                                                    }
                                                    else { <span class="text-muted opacity-25">-</span> }
                                                </td>
                                                <td>
                                                    @if (!string.IsNullOrEmpty(tx.Notes))
                                                    {
                                                        <div class="extra-small fw-bold text-dark bg-light p-2 rounded-3 border">
                                                            @tx.Notes
                                                        </div>
                                                    }
                                                    else { <span class="text-muted extra-small">None</span> }
                                                </td>
                                                <td class="text-end pe-3 fw-bold small">
                                                    @(tx.User?.Username ?? "System Auto")
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </div>
            </div>
        } else if (_activeTab == "analytics") {
            <div class="analytics-view animate-fade-in d-flex flex-column h-100 overflow-hidden">
                <div class="tab-fixed-header">
                    <!-- Sub-Tab Toggle -->
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div class="d-flex align-items-center gap-3">
                            <h5 class="fw-black text-uppercase mb-0 tracking-wider">Analytics & Reports</h5>
                            <button class="btn btn-outline-info btn-xs rounded-pill px-3 fw-bold shadow-sm" style="font-size: 0.65rem; height: 32px;" @onclick="() => _showProfitGuideModal = true">
                                 <i class="bi bi-lightbulb-fill me-1"></i> PROFITABILITY GUIDE
                            </button>
                        </div>
                        <div class="d-flex gap-2 p-1 bg-light rounded-pill border">
                            <button class="btn btn-sm rounded-pill px-4 @(_analyticsSubTab == "overview" ? "btn-primary shadow-sm fw-black" : "btn-link text-muted text-decoration-none fw-bold")" 
                                    @onclick='() => _analyticsSubTab = "overview"'>
                                CURRENT INVENTORY
                            </button>
                            <button class="btn btn-sm rounded-pill px-4 @(_analyticsSubTab == "yearly" ? "btn-primary shadow-sm fw-black" : "btn-link text-muted text-decoration-none fw-bold")" 
                                    @onclick='() => _analyticsSubTab = "yearly"'>
                                YEARLY PURCHASES
                            </button>
                            <button class="btn btn-sm rounded-pill px-4 @(_analyticsSubTab == "profitability" ? "btn-primary shadow-sm fw-black" : "btn-link text-muted text-decoration-none fw-bold")" 
                                    @onclick='async () => { _analyticsSubTab = "profitability"; await CalculateMonthlyProfitabilityAsync(); }'>
                                MONTHLY SUMMARY
                            </button>
                        </div>
                    </div>

                    @if (_analyticsSubTab == "overview")
                    {
                        <!-- Vendor Inventory Breakdown (Top Hero) -->
                        <div class="card border-0 shadow-sm rounded-4 p-3 mb-3 border-top border-4 border-primary">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <div>
                                    <h6 class="fw-black mb-0 text-uppercase tracking-wider">VENDOR INVENTORY VALUE</h6>
                                    <p class="extra-small text-muted mb-0 fw-bold">Current inventory cost held per vendor.</p>
                                </div>
                                <div class="text-end">
                                    <div class="extra-small text-muted fw-bold" style="font-size: 0.6rem;">TOTAL ASSETS</div>
                                    <div class="h4 fw-black text-primary mb-0">@_items.Sum(i => i.CurrentStock * i.CurrentPrice).ToString("C0")</div>
                                </div>
                            </div>
                            
                            <div class="row g-2">
                                @foreach (var vGroup in _items.GroupBy(i => i.Vendor?.Name ?? "No Vendor").OrderByDescending(g => g.Sum(x => x.CurrentStock * x.CurrentPrice)).Take(6))
                                {
                                    var groupVal = vGroup.Sum(x => x.CurrentStock * x.CurrentPrice);
                                    if (groupVal <= 0) continue;
                                    <div class="col-md-2">
                                        <div class="p-2 border rounded-3 bg-light h-100 shadow-inner">
                                            <div class="extra-small text-muted fw-bold text-truncate mb-1" style="font-size: 0.6rem;">@vGroup.Key</div>
                                            <div class="h6 fw-black text-dark mb-0">@groupVal.ToString("C0")</div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>

                <div class="tab-scroll-area">
                    @if (_analyticsSubTab == "overview")
                    {
                        <div class="card border-0 shadow-sm rounded-4 p-3">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <h6 class="fw-black mb-0 text-uppercase tracking-wider">Brand Profit Analysis</h6>
                                <div class="btn-group btn-group-sm rounded-pill border shadow-sm p-1">
                                    <button class="btn btn-link text-decoration-none px-3 @(_statSortMode == "performance" ? "bg-dark text-white rounded-pill" : "text-muted")" @onclick='() => _statSortMode = "performance"'>Best Sellers</button>
                                    <button class="btn btn-link text-decoration-none px-3 @(_statSortMode == "profit" ? "bg-dark text-white rounded-pill" : "text-muted")" @onclick='() => _statSortMode = "profit"'>By Profit</button>
                                    <button class="btn btn-link text-decoration-none px-3 @(_statSortMode == "value" ? "bg-dark text-white rounded-pill" : "text-muted")" @onclick='() => _statSortMode = "value"'>By Value</button>
                                    <button class="btn btn-link text-decoration-none px-3 @(_statSortMode == "name" ? "bg-dark text-white rounded-pill" : "text-muted")" @onclick='() => _statSortMode = "name"'>A-Z</button>
                                </div>
                            </div>
                            
                            <div class="table-responsive">
                                <table class="table table-sm table-hover align-middle mb-0">
                                    <thead class="bg-light sticky-top" style="z-index: 10;">
                                        <tr class="text-dark uppercase-tracking border-bottom" style="font-size: 0.75rem; height: 40px;">
                                            <th class="ps-3 fw-black" style="width: 5%;">#ID</th>
                                            <th class="fw-black" style="width: 25%;">Product</th>
                                            <th class="text-center fw-black">Cost</th>
                                            <th class="text-center fw-black">Price</th>
                                            <th class="text-center fw-black">Profit</th>
                                            <th class="text-center fw-black">Sales</th>
                                            <th class="text-center fw-black">Yield</th>
                                            <th class="text-end pe-3 fw-black">Margin Health</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @{
                                            var sortedItems = _statSortMode switch {
                                                "performance" => _items.OrderByDescending(i => GetProfitPerDrink(i) * (_itemOrderCounts.ContainsKey(i.Id) ? _itemOrderCounts[i.Id] : 0)),
                                                "profit" => _items.OrderByDescending(i => GetProfitPerDrink(i)),
                                                "value" => _items.OrderByDescending(i => i.CurrentStock * i.CurrentPrice),
                                                _ => _items.OrderBy(i => i.Name)
                                            };
                                        }
                                        @foreach (var item in sortedItems)
                                        {
                                            decimal costPerPurSellUnit;
                                            int unitsPerMainUnit;
                                            decimal marginPercent;
                                            decimal profitPerDrink;
                                            var childGlass = _childItems.FirstOrDefault(c => c.ParentItemId == item.Id);
                                            var pourVolume = item.PourVolumeOunces ?? childGlass?.PourVolumeOunces;
                                            bool isWineByGlass = childGlass != null && item.BottleVolumeOunces.HasValue && pourVolume.HasValue && pourVolume.Value > 0;

                                            if (isWineByGlass)
                                            {
                                                unitsPerMainUnit = (int)(item.BottleVolumeOunces.Value / pourVolume.Value);
                                                costPerPurSellUnit = (item.CurrentPrice / item.BottleVolumeOunces.Value) * pourVolume.Value;
                                                profitPerDrink = childGlass.RetailPrice - costPerPurSellUnit;
                                                marginPercent = childGlass.RetailPrice > 0 ? (profitPerDrink / childGlass.RetailPrice) * 100 : 0;
                                            }
                                            else if (item.IsUnitBased)
                                            {
                                                unitsPerMainUnit = item.PackSize;
                                                costPerPurSellUnit = item.PackSize > 0 ? (item.CurrentPrice / item.PackSize) : 0;
                                                profitPerDrink = item.RetailPrice - costPerPurSellUnit;
                                                marginPercent = item.RetailPrice > 0 ? (profitPerDrink / item.RetailPrice) * 100 : 0;
                                            }
                                            else
                                            {
                                                decimal globalPour = _settings?.GlobalLiquorPourSize ?? 1.5m;
                                                var totalOz = GetOuncesFromSize(item.BottleSize);
                                                var costPerOz = totalOz > 0 ? item.CurrentPrice / (decimal)totalOz : 0;
                                                costPerPurSellUnit = costPerOz * globalPour;
                                                profitPerDrink = item.RetailPrice - costPerPurSellUnit;
                                                unitsPerMainUnit = (int)(totalOz / (double)(globalPour > 0 ? globalPour : 1));
                                                marginPercent = item.RetailPrice > 0 ? (profitPerDrink / item.RetailPrice) * 100 : 0;
                                            }

                                             <tr style="height: 45px;">
                                                 <td class="ps-3 text-muted" style="font-size: 0.65rem;">@item.Id</td>
                                                 <td>
                                                    <div class="fw-bold text-dark small">@item.Name</div>
                                                    @if (isWineByGlass)
                                                    {
                                                        <div class="extra-small text-muted" style="font-size: 0.6rem;">Wine (Glass: @pourVolume.Value ounces) • @item.CurrentStock @(item.CurrentStock == 1 ? "bottle" : "bottles")</div>
                                                    }
                                                    else
                                                    {
                                                        <div class="extra-small text-muted" style="font-size: 0.6rem;">@(item.IsUnitBased ? "Unit" : item.BottleSize) • @item.CurrentStock @(item.CurrentStock == 1 ? "bottle" : "bottles")</div>
                                                    }
                                                </td>
                                                <td class="text-center small">@costPerPurSellUnit.ToString("C2")</td>
                                                <td class="text-center fw-bold small">@(isWineByGlass ? childGlass.RetailPrice.ToString("C2") : item.RetailPrice.ToString("C2"))</td>
                                                <td class="text-center text-success fw-bold small">@profitPerDrink.ToString("C2")</td>
                                                <td class="text-center">
                                                     <div class="badge bg-light text-dark border rounded-pill px-2" style="font-size: 0.6rem;">
                                                         <i class="bi bi-graph-up-arrow text-primary me-1" style="font-size: 0.55rem;"></i>
                                                         @(_itemOrderCounts.ContainsKey(item.Id) ? _itemOrderCounts[item.Id] : 0)
                                                     </div>
                                                 </td>
                                                 <td class="text-center extra-small fw-bold text-muted">
                                                     @if (isWineByGlass)
                                                     {
                                                         <span>@unitsPerMainUnit glasses</span>
                                                     }
                                                     else
                                                     {
                                                         <span>@unitsPerMainUnit @(item.IsUnitBased ? "units" : "ounces")</span>
                                                     }
                                                 </td>
                                                <td class="text-end pe-3">
                                                    @if (item.RetailPrice == 0 && !isWineByGlass)
                                                    {
                                                        <span class="badge bg-light text-muted border" style="font-size: 0.6rem;">N/A</span>
                                                    }
                                                    else
                                                    {
                                                        var marginColor = marginPercent < 70 ? "text-danger" : marginPercent < 85 ? "text-warning" : "text-success";
                                                        var barColor = marginPercent < 70 ? "bg-danger" : marginPercent < 85 ? "bg-warning" : "bg-success";
                                                        
                                                        <div class="d-flex align-items-center justify-content-end gap-2">
                                                            <span class="extra-small fw-bold @marginColor" style="font-size: 0.65rem;">@marginPercent.ToString("F0")%</span>
                                                            <div class="progress" style="width: 50px; height: 5px;">
                                                                <div class="progress-bar @barColor" style="width: @marginPercent%"></div>
                                                            </div>
                                                        </div>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    }
                    else if (_analyticsSubTab == "yearly")
                    {
                        <div class="card border-0 shadow-sm rounded-4 p-4">
                            <div class="d-flex justify-content-between align-items-center mb-4">
                                <h5 class="fw-black mb-0">Total Purchases by Year</h5>
                                <select class="form-select fw-bold w-auto" @bind="_analyticsYear">
                                    @{ var distinctYears = _historyOrders.Where(o => o.IsPaid).Select(o => o.OrderDate.Year).Distinct().OrderByDescending(y => y).ToList(); }
                                    @if (!distinctYears.Any())
                                    {
                                        distinctYears.Add(DateTime.Now.Year);
                                    }
                                    @foreach (var y in distinctYears)
                                    {
                                        <option value="@y">@y</option>
                                    }
                                </select>
                            </div>
                            
                            @{
                                var yearlyOrders = _historyOrders.Where(o => o.OrderDate.Year == _analyticsYear && o.IsPaid).ToList();
                                var totalSpent = yearlyOrders.Sum(o => o.TotalCost);
                                var totalUnits = yearlyOrders.SelectMany(o => o.OrderItems).Sum(i => i.Quantity * (i.LiquorItem?.PackSize ?? 1));
                                
                                var itemStats = yearlyOrders.SelectMany(o => o.OrderItems)
                                    .GroupBy(i => i.LiquorItemId)
                                    .Select(g => new { 
                                        Item = _items.FirstOrDefault(x => x.Id == g.Key), 
                                        TotalQty = g.Sum(x => x.Quantity), 
                                        TotalSpent = g.Sum(x => x.Quantity * x.UnitPriceAtTimeOfOrder) 
                                    })
                                    .Where(x => x.Item != null)
                                    .OrderByDescending(x => x.TotalSpent)
                                    .ToList();
                            }
                            
                            <div class="row g-3 mb-4">
                                <div class="col-md-6">
                                    <div class="p-4 bg-light rounded-4 border text-center shadow-inner">
                                        <h6 class="extra-small text-muted fw-bold text-uppercase mb-2">Total Liquor Expenses for @_analyticsYear</h6>
                                        <h1 class="fw-black mb-0 text-danger">@totalSpent.ToString("C")</h1>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="p-4 bg-light rounded-4 border text-center shadow-inner">
                                        <h6 class="extra-small text-muted fw-bold text-uppercase mb-2">Total Units Purchased in @_analyticsYear</h6>
                                        <h1 class="fw-black mb-0 text-primary">@totalUnits</h1>
                                    </div>
                                </div>
                            </div>

                            <div class="table-responsive">
                                <table class="table table-hover align-middle">
                                    <thead class="bg-light sticky-top" style="z-index: 10;">
                                        <tr class="extra-small text-muted text-uppercase tracking-wider">
                                            <th class="ps-3">Product Name</th>
                                            <th class="text-center">Annual Quantity Ordered</th>
                                            <th class="text-end pe-3">Total Capital Spent</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (!itemStats.Any())
                                        {
                                            <tr><td colspan="3" class="text-center py-5 text-muted fw-bold">No completed orders found for @_analyticsYear.</td></tr>
                                        }
                                        @foreach (var stat in itemStats)
                                        {
                                            <tr>
                                                <td class="fw-bold text-dark ps-3">
                                                    @stat.Item.Name
                                                    <div class="extra-small text-muted">@stat.Item.BottleSize</div>
                                                </td>
                                                <td class="text-center fw-black">
                                                    @if (stat.Item.IsUnitBased && stat.Item.PackSize > 1)
                                                    {
                                                        <div class="mb-0">@stat.TotalQty <span class="extra-small text-muted">CASES</span></div>
                                                        <div class="extra-small text-primary opacity-75">(@(stat.TotalQty * stat.Item.PackSize) TOTAL UNITS)</div>
                                                    }
                                                    else
                                                    {
                                                        <span>@stat.TotalQty <span class="extra-small text-muted">BOTTLES</span></span>
                                                    }
                                                </td>
                                                <td class="text-end fw-black text-primary pe-3">@stat.TotalSpent.ToString("C")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    }
                    else if (_analyticsSubTab == "profitability")
                    {
                        <div class="card border-0 shadow-sm rounded-4 p-4">
                            <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
                                <div>
                                    <h5 class="fw-black mb-1 text-dark">Monthly Bar Profitability & Pour Cost</h5>
                                    <p class="small text-muted mb-0">Analyzes gross sales, vendor purchases, and inventory value shifts specifically for liquor pool items.</p>
                                </div>
                                <div class="d-flex align-items-center gap-2">
                                      <select class="form-select fw-bold border-2 rounded-pill px-3 text-center" style="min-width: 155px; text-align-last: center; cursor: pointer;" @bind:get="_selectedTerminal" @bind:set="async val => { _selectedTerminal = val; await SaveTerminalPrefAsync(val); await CalculateMonthlyProfitabilityAsync(); }">
                                          <option value="ALL">All Terminals</option>
                                          @foreach (var term in _availableTerminals)
                                          {
                                              <option value="@term">@term</option>
                                          }
                                      </select>
                                      <select class="form-select fw-bold border-2 rounded-pill px-3 text-center" style="min-width: 145px; text-align-last: center; cursor: pointer;" @bind:get="_profitabilityMonth" @bind:set="async val => { _profitabilityMonth = val; await CalculateMonthlyProfitabilityAsync(); }">
                                          @for (int m = 1; m <= 12; m++)
                                          {
                                              <option value="@m">@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(m)</option>
                                          }
                                      </select>
                                      <select class="form-select fw-bold border-2 rounded-pill px-3 text-center" style="min-width: 100px; text-align-last: center; cursor: pointer;" @bind:get="_profitabilityYear" @bind:set="async val => { _profitabilityYear = val; await CalculateMonthlyProfitabilityAsync(); }">
                                          @for (int y = DateTime.Now.Year; y >= 2020; y--)
                                          {
                                              <option value="@y">@y</option>
                                          }
                                      </select>
                                  </div>
                            </div>

                            @if (_calculatingProfitability)
                            {
                                <div class="text-center py-5">
                                    <div class="spinner-border text-primary mb-3" role="status"></div>
                                    <div class="text-muted fw-bold">Aggregating sales, purchases, and audit snapshots...</div>
                                </div>
                            }
                            else
                            {
                                <div class="row g-3 mb-4">
                                    <div class="col-md-3">
                                        <div class="p-3 bg-light rounded-4 border text-center shadow-sm">
                                            <h6 class="extra-small text-muted fw-bold text-uppercase mb-2" style="font-size: 0.65rem; letter-spacing: 0.5px;">Gross Bar Sales</h6>
                                            <h2 class="fw-black mb-0 text-dark">@_profitSales.ToString("C")</h2>
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <div class="p-3 bg-light rounded-4 border text-center shadow-sm">
                                            <h6 class="extra-small text-muted fw-bold text-uppercase mb-2" style="font-size: 0.65rem; letter-spacing: 0.5px;">Cost of Goods Sold (COGS)</h6>
                                            <h2 class="fw-black mb-0 text-danger">@_profitCOGS.ToString("C")</h2>
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <div class="p-3 bg-light rounded-4 border text-center shadow-sm">
                                            <h6 class="extra-small text-muted fw-bold text-uppercase mb-2" style="font-size: 0.65rem; letter-spacing: 0.5px;">Gross Bar Profit</h6>
                                            <h2 class="fw-black mb-0 text-success">@_profitGrossProfit.ToString("C")</h2>
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        @{
                                            var pourCostColor = _profitPourCost > 30 ? "text-danger" : _profitPourCost > 25 ? "text-warning" : "text-success";
                                        }
                                        <div class="p-3 bg-light rounded-4 border text-center shadow-sm">
                                            <h6 class="extra-small text-muted fw-bold text-uppercase mb-2" style="font-size: 0.65rem; letter-spacing: 0.5px;">Pour Cost / Profit Margin</h6>
                                            <h2 class="fw-black mb-0 @pourCostColor">@_profitPourCost.ToString("F1")% / @_profitMargin.ToString("F1")%</h2>
                                        </div>
                                    </div>
                                </div>

                                <div class="row g-4">
                                    <div class="col-lg-8">
                                        <h6 class="fw-black text-uppercase tracking-wider mb-3 text-dark" style="font-size: 0.75rem;"><i class="bi bi-calculator me-1 text-primary"></i> COGS Calculation Detail</h6>
                                        <div class="table-responsive border rounded-4 overflow-hidden mb-4">
                                            <table class="table table-striped table-hover mb-0 align-middle">
                                                <tbody>
                                                    <tr>
                                                        <td class="ps-3 py-3 fw-bold text-muted small">Beginning Inventory Value (@(new DateTime(_profitabilityYear, _profitabilityMonth, 1).ToString("MMM dd, yyyy")))</td>
                                                        <td class="text-end pe-3 fw-black text-dark">@_profitBegValue.ToString("C")</td>
                                                    </tr>
                                                    <tr>
                                                        <td class="ps-3 py-3 fw-bold text-muted small">Plus: Liquor Orders Received</td>
                                                        <td class="text-end pe-3 fw-black text-primary">+ @_profitPurchases.ToString("C")</td>
                                                    </tr>
                                                    <tr>
                                                        <td class="ps-3 py-3 fw-bold text-muted small">Minus: Ending Inventory Value (@(new DateTime(_profitabilityYear, _profitabilityMonth, DateTime.DaysInMonth(_profitabilityYear, _profitabilityMonth)).ToString("MMM dd, yyyy")))</td>
                                                        <td class="text-end pe-3 fw-black text-danger">- @_profitEndValue.ToString("C")</td>
                                                    </tr>
                                                    <tr class="table-dark">
                                                        <td class="ps-3 py-3 fw-black">Cost of Goods Sold (COGS)</td>
                                                        <td class="text-end pe-3 fw-black text-white">@_profitCOGS.ToString("C")</td>
                                                    </tr>
                                                </tbody>
                                            </table>
                                        </div>
                                        <div class="card border-0 bg-light-subtle rounded-4 p-3 border mt-3">
                                            <h6 class="fw-black text-primary mb-2" style="font-size: 0.8rem;"><i class="bi bi-info-circle-fill me-1"></i> Understanding COGS & Pour Cost</h6>
                                            <div class="row g-3">
                                                <div class="col-md-6">
                                                    <div class="small fw-bold text-dark mb-1">How COGS is Calculated:</div>
                                                    <div class="extra-small text-muted" style="line-height: 1.4;">
                                                        <strong>Cost of Goods Sold (COGS)</strong> measures the cost value of the inventory actually used/sold during the month:
                                                        <div class="font-monospace mt-1 p-1 bg-light rounded text-center" style="font-size: 0.65rem;">COGS = Beginning Inventory + Orders Received - Ending Inventory</div>
                                                        If your beginning stock was $10k, you received $5k in orders, and ended with $8k, your COGS is <strong>$7,000</strong>.
                                                    </div>
                                                </div>
                                                <div class="col-md-6">
                                                    <div class="small fw-bold text-dark mb-1">What the values tell you:</div>
                                                    <div class="extra-small text-muted" style="line-height: 1.4;">
                                                        <ul class="ps-3 mb-0">
                                                            <li><strong>Pour Cost %:</strong> The percentage of sales revenue spent on inventory. Lower is better. A 20% pour cost means you spent $0.20 to make $1.00 of sales.</li>
                                                            <li><strong>Beginning vs Ending:</strong> If ending value is lower than beginning, you used more stock than you purchased. If higher, you built up inventory.</li>
                                                        </ul>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-lg-4">
                                        <h6 class="fw-black text-uppercase tracking-wider mb-3 text-dark" style="font-size: 0.75rem;"><i class="bi bi-filter-square me-1 text-primary"></i> Include Sales from POS Categories:</h6>
                                        <div class="p-3 bg-light rounded-4 border overflow-auto" style="max-height: 250px;">
                                            @if (!_posCategories.Any())
                                            {
                                                <div class="small text-muted italic p-2">No categories found. Sync Clover/POS system or verify categories in Admin tab.</div>
                                            }
                                            else
                                            {
                                                @foreach (var cat in _posCategories)
                                                {
                                                    var total = _posCategorySalesTotals.ContainsKey(cat) ? _posCategorySalesTotals[cat] : 0m;
                                                    <div class="form-check mb-2">
                                                        <input class="form-check-input" type="checkbox" id="poscat-@cat" 
                                                               checked="@_selectedPosCategories.Contains(cat)" 
                                                               @onchange="@(async (e) => await TogglePosCategory(cat, e))" style="cursor: pointer;" />
                                                        <label class="form-check-label fw-bold text-dark small" for="poscat-@cat" style="cursor: pointer;">
                                                            @cat <span class="text-muted fw-normal">(@total.ToString("C"))</span>
                                                        </label>
                                                    </div>
                                                }
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
            } else if (_activeTab == "products") {
                <div class="setup-view animate-fade-in d-flex flex-column h-100 overflow-hidden">
                    <div class="tab-fixed-header p-4 pb-0">
                        <div class="d-flex justify-content-between align-items-center animate-slide-down">
                            <div>
                                <h5 class="fw-black text-uppercase mb-1" style="color: #6366f1;">Item Mapping & Pricing</h5>
                                <p class="small text-muted mb-0">Assign vendors to your items and set the current purchase price.</p>
                            </div>
                            <div class="d-flex gap-2 align-items-center">
                                <div class="badge rounded-pill fw-black px-4 py-2 border shadow-sm" style="background: #eff6ff; color: #1e40af; border-color: #bfdbfe !important;">
                                    <i class="bi bi-info-circle me-1"></i> Global Shot: <span class="fw-black">@(_settings?.GlobalLiquorPourSize.ToString("F2") ?? "1.50")oz</span>
                                </div>
                                <button class="btn btn-outline-primary px-4 rounded-pill fw-black" @onclick="() => _showPriceHistoryModal = true"><i class="bi bi-clock-history me-1"></i>PRICE LOG</button>
                                <button class="btn btn-success px-4 rounded-pill fw-black" @onclick="() => _showAddItemModal = true"><i class="bi bi-plus-lg me-1"></i>ADD NEW ITEM</button>
                                <div class="vr mx-2"></div>
                                <button class="btn btn-primary rounded-pill px-4 fw-black shadow-sm" @onclick="BatchUpdateItems" disabled="@_isSaving">
                                    @if (_isSaving) { <span class="spinner-border spinner-border-sm me-1"></span> <span>SAVING...</span> }
                                    else { <span>SAVE ALL CHANGES</span> }
                                </button>
                            </div>
                        </div>
                        <!-- Filter Toolbar -->
                        <div class="d-flex justify-content-between align-items-center mt-3 p-3 bg-white rounded-4 border shadow-sm animate-slide-down">
                            <div class="d-flex gap-3 align-items-center">
                                <div class="form-check form-switch mb-0 d-flex align-items-center gap-2">
                                    <input class="form-check-input" type="checkbox" id="showArchivedProductsSwitch" checked="@_showArchivedProducts" @onchange="ToggleShowArchivedProducts" style="cursor: pointer; width: 36px; height: 18px;" />
                                    <label class="form-check-label small fw-black text-muted text-uppercase mb-0" for="showArchivedProductsSwitch" style="cursor: pointer; select-layout: none; line-height: 1;">Show Archived Products</label>
                                </div>
                            </div>
                            <div class="text-muted extra-small fw-bold text-uppercase">
                                Total Products: @(_items?.Count ?? 0)
                            </div>
                        </div>
                    </div>
                    <div class="tab-scroll-area flex-grow-1 overflow-auto custom-scrollbar p-4 pt-0">
                        <div class="row g-4">
                            <div class="col-12">
                                <div class="card border-0 shadow-sm rounded-4 p-0 overflow-hidden">
                                    <div class="table-responsive">
                                         <table class="table table-hover align-middle mb-0">
                                            <thead class="sticky-top bg-white shadow-sm" style="z-index: 5;">
                                                <tr class="small text-muted uppercase-tracking border-bottom">
                                                    <th style="width: 5%;">#ID</th>
                                                    <th style="width: 25%;">Product</th>
                                                    <th style="width: 15%;">Vendor</th>
                                                    <th class="text-center" style="width: 10%;">Min Stock</th>
                                                    <th class="text-center">Bottle / Case Cost</th>
                                                    <th class="text-center">Drink Price</th>
                                                    <th class="text-center" style="width: 10%;">Yield Rule</th>
                                                    <th class="text-end pe-4" style="width: 8%;">Actions</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var item in _items.OrderBy(i => i.Name))
                                                {
                                                    var childGlassItem = _childItems.FirstOrDefault(c => c.ParentItemId == item.Id);
                                                    <tr class="@(!item.IsActive ? "bg-warning-subtle" : "")">
                                                         <td class="text-muted fw-bold">@item.Id</td>
                                                         <td>
                                                              <div class="d-flex align-items-center gap-2">
                                                                  <div class="fw-bold">@item.Name</div>
                                                                  @if (!item.IsActive)
                                                                  {
                                                                      <span class="badge bg-danger rounded-pill extra-small" style="font-size: 0.6rem; padding: 2px 6px;">INACTIVE</span>
                                                                  }
                                                              </div>
                                                              <div class="d-flex align-items-center gap-2 mt-1">
                                                                  <span class="extra-small text-muted">@item.BottleSize</span>
                                                                  @if (childGlassItem != null)
                                                                  {
                                                                      var pourOz = item.PourVolumeOunces ?? childGlassItem.PourVolumeOunces ?? 5.0m;
                                                                      <span class="badge fw-bold border" style="color: #db2777 !important; background-color: rgba(219, 39, 119, 0.1) !important; border-color: rgba(219, 39, 119, 0.25) !important; font-size: 0.6rem; padding: 2px 6px; border-radius: 4px; letter-spacing: 0.3px;"><i class="bi bi-glass-slate me-1"></i>BY THE GLASS (@pourOz.ToString("F1") oz)</span>
                                                                  }
                                                                  @if (item.PackSize > 1)
                                                                  {
                                                                      @if (item.AllowLooseReconciliation)
                                                                      {
                                                                          <span class="badge bg-success bg-opacity-10 text-success fw-bold border border-success border-opacity-25" style="font-size: 0.6rem; padding: 2px 6px; border-radius: 4px; letter-spacing: 0.3px;"><i class="bi bi-check2-circle me-1"></i>LOOSE AUDIT</span>
                                                                      }
                                                                      else
                                                                      {
                                                                          <span class="badge bg-secondary bg-opacity-10 text-secondary fw-bold border border-secondary border-opacity-25" style="font-size: 0.6rem; padding: 2px 6px; border-radius: 4px; letter-spacing: 0.3px;"><i class="bi bi-box-seam me-1"></i>CASE ONLY</span>
                                                                      }
                                                                  }
                                                                  @if (item.OrderByCaseOnly)
                                                                  {
                                                                      <span class="badge bg-primary bg-opacity-10 text-primary fw-bold border border-primary border-opacity-25" style="font-size: 0.6rem; padding: 2px 6px; border-radius: 4px; letter-spacing: 0.3px;"><i class="bi bi-cart-check me-1"></i>ORDER BY CASE ONLY</span>
                                                                  }
                                                              </div>
                                                          </td>
                                                         <td>
                                                             <select class="form-select form-select-sm border-0 bg-light rounded-3 fw-bold" 
                                                                     style="font-size: 0.75rem;"
                                                                     @onchange="e => UpdateItemVendor(item, e.Value)">
                                                                 <option value="">-- No Vendor --</option>
                                                                 @foreach(var v in _vendors) { <option value="@v.Id" selected="@(item.VendorId == v.Id)">@v.Name</option> }
                                                             </select>
                                                         </td>
                                                         <td class="text-center">
                                                             <input type="number" class="form-control form-control-sm border-0 bg-light rounded-3 text-center fw-bold mx-auto" 
                                                                    style="width: 60px; font-size: 0.75rem;"
                                                                    onfocus="this.select();"
                                                                    @bind="item.MinStockLimit" @bind:event="oninput" />
                                                         </td>
                                                         <td class="text-center">
                                                              <div class="input-group input-group-sm justify-content-center">
                                                                 <span class="input-group-text border-0 bg-transparent fw-bold">$</span>
                                                                 <input type="number" class="form-control form-control-sm border-0 bg-light rounded-3 fw-black text-center" 
                                                                        style="max-width: 80px;"
                                                                        onfocus="this.select();"
                                                                        @bind="item.CurrentPrice" @bind:event="oninput" step="0.01" />
                                                              </div>
                                                         </td>
                                                         <td class="text-center">
                                                              <div class="input-group input-group-sm justify-content-center">
                                                                 <span class="input-group-text border-0 bg-transparent fw-bold">$</span>
                                                                 <input type="number" class="form-control form-control-sm border-0 bg-light rounded-3 fw-black text-center" 
                                                                        style="max-width: 80px;"
                                                                        onfocus="this.select();"
                                                                        @bind="item.RetailPrice" @bind:event="oninput" step="0.01" />
                                                              </div>
                                                         </td>
                                                         <td class="text-center">
                                                             @if (childGlassItem != null)
                                                             {
                                                                 <span class="badge rounded-pill fw-black px-3 py-2 border" style="background: #fdf2f8; color: #db2777; border-color: #fbcfe8 !important; font-size: 0.65rem; letter-spacing: 0.5px;">BY GLASS</span>
                                                             }
                                                             else if (item.IsUnitBased)
                                                             {
                                                                 <span class="badge rounded-pill fw-black px-3 py-2" style="background: #f1f5f9; color: #475569; font-size: 0.65rem; letter-spacing: 0.5px;">UNIT</span>
                                                             }
                                                             else
                                                             {
                                                                 <span class="badge rounded-pill fw-black px-3 py-2 border" style="background: #e0f2fe; color: #0369a1; border-color: #bae6fd !important; font-size: 0.65rem; letter-spacing: 0.5px;">GLOBAL</span>
                                                             }
                                                         </td>
                                                        <td class="text-end pe-4">
