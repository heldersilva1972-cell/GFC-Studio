                                                            </select>
                                                        </td>
                                                        <td class="text-center">
                                                            <input type="number" class="form-control form-control-sm border-0 bg-light rounded-3 text-center fw-bold mx-auto" 
                                                                   style="width: 60px; font-size: 0.75rem;"
                                                                   onfocus="this.select();"
                                                                   @bind="item.MinStockLimit" @bind:event="oninput" />
                                                        </td>
                                                        <td class="text-center">
                                                             <div class="input-group input-group-sm justify-content-center">
                                                                <span class="input-group-text border-0 bg-transparent fw-bold">$</span>
                                                                <input type="number" class="form-control form-control-sm border-0 bg-light rounded-3 fw-black text-center" 
                                                                       style="max-width: 80px;"
                                                                       onfocus="this.select();"
                                                                       @bind="item.CurrentPrice" @bind:event="oninput" step="0.01" />
                                                             </div>
                                                        </td>
                                                        <td class="text-center">
                                                             <div class="input-group input-group-sm justify-content-center">
                                                                <span class="input-group-text border-0 bg-transparent fw-bold">$</span>
                                                                <input type="number" class="form-control form-control-sm border-0 bg-light rounded-3 fw-black text-center" 
                                                                       style="max-width: 80px;"
                                                                       onfocus="this.select();"
