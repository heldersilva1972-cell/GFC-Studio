                                                @if (_calendarSettings.ShowHeaderQuestionButton)
                                                {
                                                    <div class="row g-1.5 mt-1">
                                                        <div class="col-6">
                                                            <input type="text" class="form-control form-control-sm" style="font-size:0.75rem;" @bind="_calendarSettings.HeaderQuestionButtonText" placeholder="Label" />
                                                        </div>
                                                        <div class="col-6">
                                                            <input type="text" class="form-control form-control-sm" style="font-size:0.75rem;" @bind="_calendarSettings.HeaderQuestionButtonUrl" placeholder="URL" />
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Card 3: Event Detail Modal & Mobile Display Rules -->
