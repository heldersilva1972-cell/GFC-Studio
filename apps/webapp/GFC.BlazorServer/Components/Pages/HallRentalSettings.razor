            @* ========================================================================= *@
            @* TAB: WEB APP CALENDAR & LIST DISPLAY *@
            @* ========================================================================= *@
            @if (string.Equals(_activeTab, "webapp_calendar", StringComparison.OrdinalIgnoreCase))
            {
                <div class="tab-pane-card animate-fade-in">
                    <div class="row g-4">
                        <!-- Left Column: Month Calendar Grid Display Settings -->
                        <div class="col-lg-6">
                            <div class="card border rounded-4 p-4 shadow-sm bg-white h-100">
                                <div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
                                    <div>
                                        <h5 class="fw-bold mb-0 text-dark">
                                            <i class="bi bi-calendar3 text-primary me-2"></i>Month Calendar Grid Display
                                        </h5>
                                        <small class="text-muted">Configure how events appear on the Studio internal Month Calendar grid</small>
                                    </div>
                                </div>

