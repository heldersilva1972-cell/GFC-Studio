                                                    <input type="text" class="form-control form-control-sm font-monospace" placeholder="A/V Equipment" @bind="_settings.AvEquipmentCalendarDisplayName" disabled="@(!_settings.PushServicesToDescription || !_settings.PushAvEquipmentToDescription)" />
                                                    <small class="text-muted d-block mt-1" style="font-size: 0.68rem;">Shown on calendar event description</small>
