                                                    <span class="badge bg-light text-secondary border fw-normal" style="font-size: 0.65rem;">
                                                        @((_editableEventTypeLists.FirstOrDefault(l => l.Id == currentCard.EventTypeListId) ?? _editableEventTypeLists.FirstOrDefault(l => l.IsDefault) ?? _editableEventTypeLists.FirstOrDefault())?.Options.Count ?? 0) types
                                                    </span>
