                                                <input class="form-check-input" type="checkbox" role="switch" id="fShowGuests" @bind="_webSettings.ShowGuestCountField" />
                                                <label class="form-check-label small text-muted ms-1" for="fShowGuests">@(_webSettings.ShowGuestCountField ? "Shown" : "Hidden")</label>
                                            </div>
                                        </div>
