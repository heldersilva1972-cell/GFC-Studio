                            <div class="d-flex align-items-center gap-3">
                                <div class="rounded-circle d-flex align-items-center justify-content-center p-3 @(_firebaseConfigured ? "bg-success bg-opacity-10 text-success" : "bg-warning bg-opacity-10 text-warning")" style="width: 54px; height: 54px;">
                                    <i class="bi @(_firebaseConfigured ? "bi-check-circle-fill fs-2" : "bi-exclamation-triangle-fill fs-2")"></i>
                                </div>
