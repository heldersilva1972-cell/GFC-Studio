                                                    <input type="text" class="form-control form-control-sm font-monospace" placeholder="Kitchen Access" @bind="_settings.KitchenUsageCalendarDisplayName" disabled="@(!_settings.PushServicesToDescription || !_settings.PushKitchenUsageToDescription)" />
                                                    <small class="text-muted d-block mt-1" style="font-size: 0.68rem;">Shown on calendar event description</small>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- A/V Equipment -->
                                        <div class="col-md-4">
                                            <div class="p-3 rounded-3 border bg-white shadow-sm h-100 d-flex flex-column justify-content-between">
                                                <div>
                                                    <div class="d-flex align-items-center justify-content-between mb-2">
                                                        <div class="d-flex align-items-center gap-1">
                                                            <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle px-2 py-0 small" style="font-size: 0.68rem;">
                                                                <i class="bi bi-speaker me-1"></i>A/V
                                                            </span>
                                                            <span class="fw-bold text-dark small">A/V Equipment</span>
                                                        </div>
                                                        <div class="form-check form-switch mb-0">
                                                            <input class="form-check-input" type="checkbox" role="switch" id="pushAvService" @bind="_settings.PushAvEquipmentToDescription" disabled="@(!_settings.PushServicesToDescription)" />
