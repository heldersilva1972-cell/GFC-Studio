    private async Task HandleServiceAccountKeyUpload(InputFileChangeEventArgs e)
    {
        try
        {
            var file = e.File;
            if (file == null) return;

            using var stream = file.OpenReadStream(maxAllowedSize: 1024 * 500);
            using var reader = new System.IO.StreamReader(stream);
            var jsonContent = await reader.ReadToEndAsync();

            using var doc = System.Text.Json.JsonDocument.Parse(jsonContent);
            var root = doc.RootElement;

            if (root.TryGetProperty("client_email", out var emailElem))
            {
                _settings.ServiceAccountEmail = emailElem.GetString() ?? "";
            }
            if (root.TryGetProperty("private_key", out var keyElem))
            {
                _settings.ServiceAccountPrivateKey = keyElem.GetString() ?? "";
            }

            _settings.EnableWriteApi = true;
            _feedbackMessage = $"Key file uploaded successfully! Service Account: {_settings.ServiceAccountEmail}";
            _feedbackSuccess = true;
            ToastService.ShowSuccess("Google Service Account Key imported successfully!");
        }
        catch (Exception ex)
        {
            _feedbackMessage = $"Failed to parse Service Account JSON: {ex.Message}";
            _feedbackSuccess = false;
            ToastService.ShowError($"Key upload error: {ex.Message}");
        }
    }

