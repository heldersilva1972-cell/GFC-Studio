                                        {
                                            <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                                                <span class="small text-secondary fw-semibold">Requirement:</span>
                                                <div class="d-flex p-1 bg-light rounded-pill border" style="min-width: 170px;">
                                                    <button type="button" class="btn btn-sm rounded-pill flex-fill py-1 px-2 @(_webSettings.RequireGuestCount ? "btn-primary fw-bold shadow-sm" : "btn-light text-muted border-0")" @onclick="() => _webSettings.RequireGuestCount = true">Required</button>
                                                    <button type="button" class="btn btn-sm rounded-pill flex-fill py-1 px-2 @(!_webSettings.RequireGuestCount ? "btn-dark fw-bold shadow-sm" : "btn-light text-muted border-0")" @onclick="() => _webSettings.RequireGuestCount = false">Optional</button>
