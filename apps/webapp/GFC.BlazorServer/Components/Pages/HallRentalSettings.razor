                                    <i class="bi @(_sandboxTestSuccess ? "bi-check-circle-fill text-success" : "bi-exclamation-triangle-fill text-danger") fs-5 flex-shrink-0"></i>
                                    <div>
                                        <strong>@(_sandboxTestSuccess ? "Sandbox Connection Verified!" : "Sandbox Connection Issue:")</strong>
                                        <div class="mt-1">@_sandboxTestFeedback</div>
                                    </div>
                                </div>
