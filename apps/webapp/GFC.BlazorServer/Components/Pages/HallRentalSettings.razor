@page "/hall-rentals/settings"
@using GFC.Core.Models
@using GFC.Core.Interfaces
@using GFC.BlazorServer.Services
@using Microsoft.AspNetCore.Components.Forms
@inject IGoogleCalendarService CalendarService
@inject GFC.BlazorServer.Services.CalendarSettingsService CalendarSettingsService
@inject IUserManagementService UserService
@inject IRentalService RentalService
@inject GFC.Core.Interfaces.IWebsiteSettingsService WebsiteSettingsService
@inject IRentalEmailDispatcher RentalEmailDispatcher
@inject GFC.BlazorServer.Services.CustomAuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject IToastService ToastService
@inject IWebHostEnvironment WebHostEnvironment
@inject IFirebaseNotificationService FirebaseNotificationService
@attribute [Authorize]
@rendermode InteractiveServer

<NavigationLock OnBeforeInternalNavigation="OnBeforeInternalNavigation" ConfirmExternalNavigation="@HasUnsavedChanges" />

<div class="rental-settings-page-wrapper">
    @if (!_hasPageAccess && !_isAdmin)
    {
        <div class="access-denied-panel text-center py-5 bg-white rounded-4 border shadow-sm my-4">
            <div class="bg-light rounded-circle shadow-sm d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px;">
                <i class="bi bi-shield-lock-fill text-danger fs-1"></i>
            </div>
            <h3 class="fw-bold text-dark">Access Restricted</h3>
            <p class="text-muted">You do not have permission to view Hall Rental Settings. Please contact your system administrator.</p>
            <a href="/hall-rentals" class="btn btn-outline-primary mt-2">
                <i class="bi bi-arrow-left me-1"></i>Back to Hall Rentals
            </a>
        </div>
    }
    else if (_isLoading)
    {
        <div class="text-center py-5 bg-white rounded-4 border shadow-sm my-4">
            <div class="spinner-border text-primary mb-3" style="width: 3rem; height: 3rem;" role="status"></div>
            <h5 class="fw-bold text-dark">Loading Rental Settings...</h5>
            <p class="text-muted small">Retrieving rooms, pricing tiers, Google Calendar connections, and system preferences.</p>
        </div>
    }
    else
    {
        <!-- TOP PAGE HEADER (FIXED) -->
        <div class="page-header-card bg-white rounded-4 border p-3 px-4 shadow-sm mb-3 flex-shrink-0">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="p-3 rounded-3 bg-primary bg-opacity-10 text-primary border border-primary border-opacity-10">
                        <i class="bi bi-sliders2-vertical fs-3"></i>
                    </div>
                    <div>
                        <div class="d-flex align-items-center gap-2 flex-wrap">
                            <h2 class="fw-bold mb-0 text-dark">Hall Rental &amp; Calendar Settings</h2>
                            <span class="badge bg-success border px-2 py-1 small">
                                <i class="bi bi-broadcast me-1"></i>LIVE PRODUCTION
                            </span>
                            <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 px-2.5 py-1 small fw-bold">
                                <i class="bi bi-grid-3x3-gap-fill me-1"></i>Tier &amp; Day Matrix Engine
                            </span>
                        </div>
                        <p class="text-muted small mb-0 mt-1">Configure event spaces, pricing rules, Google Calendar integration, public booking forms, and testing simulations.</p>
                    </div>
                </div>
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <button type="button" class="btn btn-outline-secondary d-flex align-items-center gap-2 shadow-sm" @onclick="GoBackToHallRentals">
                        <i class="bi bi-arrow-left"></i>
                        <span>Back to Rentals</span>
                    </button>
                    <button type="button" class="btn btn-primary d-flex align-items-center gap-2 px-4 shadow-sm fw-semibold" @onclick="SaveAllSettings" disabled="@_isSaving">
                        @if (_isSaving)
                        {
                            <span class="spinner-border spinner-border-sm"></span>
                            <span>Saving...</span>
                        }
                        else
                        {
                            <i class="bi bi-check2-circle fs-5"></i>
                            <span>Save All Settings</span>
                        }
                    </button>
                </div>
            </div>

            <!-- FEEDBACK ALERT -->
            @if (!string.IsNullOrEmpty(_feedbackMessage))
            {
                <div class="alert @(_feedbackSuccess ? "alert-success" : "alert-danger") alert-dismissible fade show mt-3 mb-0 d-flex align-items-center gap-2 shadow-sm" role="alert">
                    <i class="bi @(_feedbackSuccess ? "bi-check-circle-fill text-success" : "bi-exclamation-triangle-fill text-danger") fs-5"></i>
                    <div>@_feedbackMessage</div>
                    <button type="button" class="btn-close" @onclick="() => _feedbackMessage = null"></button>
                </div>
            }
        </div>

        <!-- NAVIGATION TABS (FIXED) -->
        <div class="tabs-nav-card bg-white rounded-4 border p-2 shadow-sm mb-3 flex-shrink-0">
            <ul class="nav nav-pills gap-2 flex-nowrap overflow-x-auto p-1">
                <li class="nav-item">
                    <button type="button" class="nav-link py-2 px-3 fw-semibold d-flex align-items-center gap-2 @(string.Equals(_activeTab, "matrix_tiers", StringComparison.OrdinalIgnoreCase) ? "active bg-primary text-white shadow-sm" : "text-secondary")" @onclick='() => SelectTab("matrix_tiers")'>
                        <i class="bi bi-grid-3x3-gap-fill text-warning @(string.Equals(_activeTab, "matrix_tiers", StringComparison.OrdinalIgnoreCase) ? "text-white" : "")"></i>
                        <span>Tier &amp; Day Matrix Pricing</span>
                    </button>
                </li>
                <li class="nav-item">
                    <button type="button" class="nav-link py-2 px-3 fw-semibold d-flex align-items-center gap-2 @(string.Equals(_activeTab, "calendar", StringComparison.OrdinalIgnoreCase) ? "active bg-primary text-white shadow-sm" : "text-secondary")" @onclick='() => SelectTab("calendar")'>
                        <i class="bi bi-google text-danger"></i>
                        <span>Google Calendar Sync</span>
                    </button>
                </li>
                <li class="nav-item">
                    <button type="button" class="nav-link py-2 px-3 fw-semibold d-flex align-items-center gap-2 @(string.Equals(_activeTab, "webapp_calendar", StringComparison.OrdinalIgnoreCase) ? "active bg-primary text-white shadow-sm" : "text-secondary")" @onclick='() => SelectTab("webapp_calendar")'>
                        <i class="bi bi-calendar3-range text-primary"></i>
                        <span>Web App Calendar &amp; List Display</span>
                    </button>
                </li>
                <li class="nav-item">
                    <button type="button" class="nav-link py-2 px-3 fw-semibold d-flex align-items-center gap-2 @(string.Equals(_activeTab, "form_intake", StringComparison.OrdinalIgnoreCase) ? "active bg-primary text-white shadow-sm" : "text-secondary")" @onclick='() => SelectTab("form_intake")'>
                        <i class="bi bi-file-earmark-text"></i>
                        <span>Public Form &amp; Rules</span>
                    </button>
                </li>
                <li class="nav-item">
                    <button type="button" class="nav-link py-2 px-3 fw-semibold d-flex align-items-center gap-2 @(string.Equals(_activeTab, "policies", StringComparison.OrdinalIgnoreCase) ? "active bg-primary text-white shadow-sm" : "text-secondary")" @onclick='() => SelectTab("policies")'>
                        <i class="bi bi-shield-check"></i>
                        <span>📜 Policies &amp; Agreements</span>
                    </button>
                </li>
                <li class="nav-item">
                    <button type="button" class="nav-link py-2 px-3 fw-semibold d-flex align-items-center gap-2 @(string.Equals(_activeTab, "emails", StringComparison.OrdinalIgnoreCase) ? "active bg-primary text-white shadow-sm" : "text-secondary")" @onclick='() => SelectTab("emails")'>
                        <i class="bi bi-envelope-gear-fill"></i>
                        <span>Email Logic &amp; Automation</span>
                    </button>
                </li>
                <li class="nav-item">
                    <button type="button" class="nav-link py-2 px-3 fw-semibold d-flex align-items-center gap-2 @(string.Equals(_activeTab, "pricing_guide", StringComparison.OrdinalIgnoreCase) ? "active bg-primary text-white shadow-sm" : "text-secondary")" @onclick='() => SelectTab("pricing_guide")'>
                        <i class="bi bi-bar-chart-fill"></i>
                        <span>📊 Pricing Guide &amp; Chart</span>
                    </button>
                </li>
                <li class="nav-item">
                    <button type="button" class="nav-link py-2 px-3 fw-semibold d-flex align-items-center gap-2 @(string.Equals(_activeTab, "preview", StringComparison.OrdinalIgnoreCase) ? "active bg-primary text-white shadow-sm" : "text-secondary")" @onclick='() => SelectTab("preview")'>
                        <i class="bi bi-display"></i>
                        <span>Live Form Preview</span>
                    </button>
                </li>
                <li class="nav-item">
                    <button type="button" class="nav-link py-2 px-3 fw-semibold d-flex align-items-center gap-2 @(string.Equals(_activeTab, "calendar_preview", StringComparison.OrdinalIgnoreCase) ? "active bg-primary text-white shadow-sm" : "text-secondary")" @onclick='() => SelectTab("calendar_preview")'>
                        <i class="bi bi-calendar3-range @(string.Equals(_activeTab, "calendar_preview", StringComparison.OrdinalIgnoreCase) ? "text-white" : "text-primary")"></i>
                        <span>📅 Public Calendar Settings</span>
                    </button>
                </li>
                <li class="nav-item">
                    <button type="button" class="nav-link py-2 px-3 fw-semibold d-flex align-items-center gap-2 @(string.Equals(_activeTab, "embeds", StringComparison.OrdinalIgnoreCase) ? "active bg-primary text-white shadow-sm" : "text-secondary")" @onclick='() => SelectTab("embeds")'>
                        <i class="bi bi-wordpress text-primary @(string.Equals(_activeTab, "embeds", StringComparison.OrdinalIgnoreCase) ? "text-white" : "")"></i>
                        <span>WordPress &amp; Embeds</span>
                    </button>
                </li>
                <li class="nav-item">
                    <button type="button" class="nav-link py-2 px-3 fw-semibold d-flex align-items-center gap-2 @(string.Equals(_activeTab, "mobile_push", StringComparison.OrdinalIgnoreCase) ? "active bg-primary text-white shadow-sm" : "text-secondary")" @onclick='() => SelectTab("mobile_push")'>
                        <i class="bi bi-phone-vibrate-fill text-success @(string.Equals(_activeTab, "mobile_push", StringComparison.OrdinalIgnoreCase) ? "text-white" : "")"></i>
                        <span>📱 GFC Connect Push Alerts</span>
                    </button>
                </li>
            </ul>
        </div>

        <!-- ACTIVE TAB CONTENT PANES (COMPLETELY ISOLATED) -->
        <div class="tab-content-container">

            @* ========================================================================= *@
            @* TAB: CALENDAR PREVIEW & PUBLIC DISPLAY SETTINGS *@
            @* ========================================================================= *@
            @if (string.Equals(_activeTab, "calendar_preview", StringComparison.OrdinalIgnoreCase))
            {
                <div class="tab-pane-card animate-fade-in">

                    @* Top Header Bar (Compact & Space Efficient) *@
                    <div class="card rounded-3 px-3 py-2.5 mb-3 shadow-sm" style="background:#fffbf2; border:1px solid #e8d9b0;">
                        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                            <div class="d-flex align-items-center gap-2">
                                <div class="rounded-circle d-flex align-items-center justify-content-center" style="width: 32px; height: 32px; background: rgba(196,154,73,0.18); color: #7a5c1e;">
                                    <i class="bi bi-calendar-range-fill"></i>
                                </div>
                                <div>
                                    <div class="d-flex align-items-center gap-2">
                                        <h6 class="fw-bold mb-0 text-dark" style="color:#7a5c1e !important;">
                                            Public Calendar &amp; Live Display Configuration
                                        </h6>
                                        <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25" style="font-size:0.7rem;">
                                            <i class="bi bi-eye-fill me-1"></i>What The Public Sees
                                        </span>
                                    </div>
                                    <small class="text-muted" style="font-size:0.75rem;">
                                        This simulates the live calendar displayed to the public on your website. Use the buttons on the right to preview in full screen.
                                    </small>
                                </div>
                            </div>
                            <div class="d-flex align-items-center gap-2 flex-wrap">
                                <div class="btn-group btn-group-sm">
                                    <a href="@(_calendarPreviewDeviceMode == "mobile" ? "/public/calendar?view=mobile" : "/public/calendar")" target="_blank" class="btn btn-sm btn-outline-secondary d-flex align-items-center gap-1.5 fw-semibold py-1 px-2.5">
                                        <i class="bi bi-box-arrow-up-right"></i> Open Full Screen @(_calendarPreviewDeviceMode == "mobile" ? "(Phone)" : "(Desktop)")
                                    </a>
                                    <button type="button" class="btn btn-sm btn-outline-secondary dropdown-toggle dropdown-toggle-split py-1 px-2" data-bs-toggle="dropdown" aria-expanded="false">
                                        <span class="visually-hidden">Toggle Dropdown</span>
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                        <li>
                                            <a class="dropdown-item small d-flex align-items-center gap-2 py-1.5" href="/public/calendar" target="_blank">
                                                <i class="bi bi-laptop text-primary"></i> Desktop Full Screen
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item small d-flex align-items-center gap-2 py-1.5" href="/public/calendar?view=mobile" target="_blank">
                                                <i class="bi bi-phone text-success"></i> Phone (Mobile) Full Screen
                                            </a>
                                        </li>
                                    </ul>
                                </div>
                                <button class="btn btn-sm fw-semibold d-flex align-items-center gap-1.5 py-1 px-2.5"
                                        style="background:#C49A49; color:#fff; border:none;"
                                        @onclick="CopyWordPressEmbedCode">
                                    <i class="bi bi-wordpress"></i> Embed Code
                                </button>
                                <button type="button" class="btn btn-sm btn-primary d-flex align-items-center gap-1.5 fw-semibold py-1 px-3 shadow-sm" @onclick="SaveCalendarSettings">
                                    <i class="bi bi-check2-circle"></i> Save Settings
                                </button>
                            </div>
                        </div>
                    </div>

                    @* Maximized 2-Column Studio Layout *@
                    <div class="row g-3 align-items-stretch">

                        <!-- Left Column: Compact Settings & Display Controls -->
                        <div class="col-xl-5 col-lg-5 col-md-12">
                            <div class="d-flex flex-column gap-3">

                                <!-- Card 1: Grid Layout & Field Display Ordering -->
                                <div class="card border rounded-3 p-3 shadow-sm bg-white">
                                    <div class="d-flex align-items-center justify-content-between mb-2 pb-2 border-bottom">
                                        <span class="fw-bold small text-dark d-flex align-items-center gap-1.5">
                                            <i class="bi bi-calendar3 text-primary"></i> Cell Layout &amp; Card Fields
                                        </span>
                                        <span class="badge bg-light text-muted border" style="font-size:0.7rem;">Month View</span>
                                    </div>

                                    <!-- Cell Layout Mode -->
                                    <div class="mb-2.5">
                                        <div class="d-flex p-1 bg-light rounded-pill border">
                                            <button type="button" class="btn btn-sm rounded-pill flex-fill py-1 px-2 @(_calendarSettings.MonthDisplayMode != "compact" ? "btn-primary fw-bold shadow-sm" : "btn-light text-muted border-0")" style="font-size:0.75rem;" @onclick='() => SetPublicMonthDisplayMode("multiline")'>
                                                <i class="bi bi-card-text me-1"></i>Multi-Line Card
                                            </button>
                                            <button type="button" class="btn btn-sm rounded-pill flex-fill py-1 px-2 @(_calendarSettings.MonthDisplayMode == "compact" ? "btn-primary fw-bold shadow-sm" : "btn-light text-muted border-0")" style="font-size:0.75rem;" @onclick='() => SetPublicMonthDisplayMode("compact")'>
                                                <i class="bi bi-dash-square me-1"></i>Compact Single Pill
                                            </button>
                                        </div>
                                    </div>

                                    <!-- Field Ordering List -->
                                    @if ((_calendarSettings.MonthCalendarFields?.Count(f => f.IsEnabled) ?? 0) == 0)
                                    {
                                        <div class="alert alert-danger py-1.5 px-2.5 small rounded-2 mb-2 d-flex align-items-center gap-2" style="font-size:0.78rem;">
                                            <i class="bi bi-exclamation-octagon-fill"></i>
                                            <div><strong>Required:</strong> Enable at least 1 field for month cards.</div>
                                        </div>
                                    }

                                    <div class="list-group list-group-flush rounded-2 border overflow-hidden mb-2">
                                        @for (int pIdx = 0; pIdx < (_calendarSettings.MonthCalendarFields?.OrderBy(f => f.Order).ToList().Count ?? 0); pIdx++)
                                        {
                                            var orderedPublic = _calendarSettings.MonthCalendarFields!.OrderBy(f => f.Order).ToList();
                                            var pField = orderedPublic[pIdx];
                                            var currentIdx = pIdx;
                                            var totalCount = orderedPublic.Count;

                                            <div class="list-group-item px-2.5 py-1.5 d-flex align-items-center justify-content-between gap-2 @(pField.IsEnabled ? "bg-white" : "bg-light text-muted")" style="font-size:0.8rem;">
                                                <div class="d-flex align-items-center gap-2 flex-grow-1 min-w-0">
                                                    <div class="btn-group-vertical btn-group-sm" role="group">
                                                        <button type="button" class="btn btn-outline-secondary py-0 px-1.5" style="line-height:1; font-size:0.65rem;" disabled="@(currentIdx == 0)" @onclick="() => MovePublicMonthField(pField, -1)" title="Move Up">
                                                            <i class="bi bi-chevron-up"></i>
                                                        </button>
                                                        <button type="button" class="btn btn-outline-secondary py-0 px-1.5" style="line-height:1; font-size:0.65rem;" disabled="@(currentIdx == totalCount - 1)" @onclick="() => MovePublicMonthField(pField, 1)" title="Move Down">
                                                            <i class="bi bi-chevron-down"></i>
                                                        </button>
                                                    </div>
                                                    <span class="badge @(pField.IsEnabled ? "bg-primary" : "bg-secondary") rounded-pill px-1.5 py-0.5" style="font-size: 0.68rem; min-width: 22px;">
                                                        #@(currentIdx + 1)
                                                    </span>
                                                    <div class="text-truncate">
                                                        <span class="fw-semibold @(pField.IsEnabled ? "text-dark" : "text-muted")">@pField.Label</span>
                                                    </div>
                                                </div>

                                                <div class="form-check form-switch mb-0">
                                                    <input class="form-check-input" type="checkbox" role="switch" id="@($"pField_{pField.FieldKey}")" @bind="pField.IsEnabled" />
                                                </div>
                                            </div>
                                        }
                                    </div>

                                    <!-- Status Badges & Applications Visibility -->
                                    <div class="p-2.5 bg-light rounded-2 border">
                                        <div class="form-check form-switch mb-2">
                                            <input class="form-check-input" type="checkbox" id="showPendingAppsToggle" @bind="_calendarSettings.ShowPendingApplications" />
                                            <label class="form-check-label small fw-semibold text-dark" for="showPendingAppsToggle">
                                                Display Pending Bookings on Grid
                                            </label>
                                        </div>

                                        <div class="row g-2">
                                            <div class="col-6">
                                                <div class="form-check form-switch mb-1">
                                                    <input class="form-check-input" type="checkbox" id="showApprovedBadgeToggle" @bind="_calendarSettings.ShowApprovedBadge" />
                                                    <label class="form-check-label small text-muted" style="font-size:0.75rem;" for="showApprovedBadgeToggle">Approved Badge</label>
                                                </div>
                                                @if (_calendarSettings.ShowApprovedBadge)
                                                {
                                                    <input type="text" class="form-control form-control-sm" style="font-size:0.75rem; padding: 2px 6px;" @bind="_calendarSettings.ApprovedBadgeText" placeholder="RESERVED" />
                                                }
                                            </div>
                                            <div class="col-6">
                                                <div class="form-check form-switch mb-1">
                                                    <input class="form-check-input" type="checkbox" id="showPendingBadgeToggle" @bind="_calendarSettings.ShowPendingBadge" />
                                                    <label class="form-check-label small text-muted" style="font-size:0.75rem;" for="showPendingBadgeToggle">Pending Badge</label>
                                                </div>
                                                @if (_calendarSettings.ShowPendingBadge)
                                                {
                                                    <input type="text" class="form-control form-control-sm" style="font-size:0.75rem; padding: 2px 6px;" @bind="_calendarSettings.PendingBadgeText" placeholder="PENDING" />
                                                }
                                            </div>
                                            <div class="col-12 mt-2 pt-2 border-top">
                                                <div class="form-check form-switch mb-1">
                                                    <input class="form-check-input" type="checkbox" id="showPartialBadgeToggle" @bind="_calendarSettings.ShowPartialAvailabilityBadge" />
                                                    <label class="form-check-label small fw-semibold text-success" style="font-size:0.75rem;" for="showPartialBadgeToggle">
                                                        <i class="bi bi-calendar-check me-1"></i>Partial Day "Slot Open" Indicator
                                                    </label>
                                                </div>
                                                <small class="text-muted d-block" style="font-size:0.70rem; line-height:1.3;">Shows a subtle green indicator on booked days that still have open rental slots.</small>
                                                @if (_calendarSettings.ShowPartialAvailabilityBadge)
                                                {
                                                    <div class="mt-1">
                                                        <input type="text" class="form-control form-control-sm" style="font-size:0.75rem; padding: 2px 6px;" @bind="_calendarSettings.PartialAvailabilityBadgeText" placeholder="Slot Open" />
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Card 2: Top Notice Banner & Header Action Buttons -->
                                <div class="card border rounded-3 p-3 shadow-sm bg-white">
                                    <div class="d-flex align-items-center justify-content-between mb-2 pb-2 border-bottom">
                                        <span class="fw-bold small text-dark d-flex align-items-center gap-1.5">
                                            <i class="bi bi-window-dock text-primary"></i> Notice Banner &amp; Header CTA
                                        </span>
                                    </div>

                                    <!-- Top Notice Banner -->
                                    <div class="p-2.5 bg-light rounded-2 border mb-2.5">
                                        <div class="form-check form-switch mb-1.5">
                                            <input class="form-check-input" type="checkbox" id="showNoticeBannerToggle" @bind="_calendarSettings.ShowHeaderNoticeBanner" />
                                            <label class="form-check-label small fw-semibold text-dark" for="showNoticeBannerToggle">
                                                Notice Banner (Top of Page)
                                            </label>
                                        </div>
                                        @if (_calendarSettings.ShowHeaderNoticeBanner)
                                        {
                                            <textarea class="form-control form-control-sm mt-1" rows="2" style="font-size:0.78rem;" @bind="_calendarSettings.HeaderNoticeBannerText" placeholder="Thank you for visiting our Calendar of Events..."></textarea>
                                        }
                                    </div>

                                    <!-- Header Buttons -->
                                    <div class="row g-2">
                                        <!-- Header Home -->
                                        <div class="col-12">
                                            <div class="p-2 bg-light rounded-2 border">
                                                <div class="form-check form-switch mb-1">
                                                    <input class="form-check-input" type="checkbox" id="hdrHomeToggle" @bind="_calendarSettings.ShowHeaderHomeButton" />
                                                    <label class="form-check-label small fw-semibold text-dark" style="font-size:0.78rem;" for="hdrHomeToggle">
                                                        Header "GFC Home" Button
                                                    </label>
                                                </div>
                                                @if (_calendarSettings.ShowHeaderHomeButton)
                                                {
                                                    <div class="row g-1.5 mt-1">
                                                        <div class="col-6">
                                                            <input type="text" class="form-control form-control-sm" style="font-size:0.75rem;" @bind="_calendarSettings.HeaderHomeButtonText" placeholder="Label" />
                                                        </div>
                                                        <div class="col-6">
                                                            <input type="text" class="form-control form-control-sm" style="font-size:0.75rem;" @bind="_calendarSettings.HeaderHomeButtonUrl" placeholder="URL" />
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                        </div>

                                        <!-- Header Book -->
                                        <div class="col-12">
                                            <div class="p-2 bg-light rounded-2 border">
                                                <div class="form-check form-switch mb-1">
                                                    <input class="form-check-input" type="checkbox" id="hdrBookToggle" @bind="_calendarSettings.ShowHeaderBookButton" />
                                                    <label class="form-check-label small fw-semibold text-dark" style="font-size:0.78rem;" for="hdrBookToggle">
                                                        Header "Book Hall" Button
                                                    </label>
                                                </div>
                                                @if (_calendarSettings.ShowHeaderBookButton)
                                                {
                                                    <div class="row g-1.5 mt-1">
                                                        <div class="col-6">
                                                            <input type="text" class="form-control form-control-sm" style="font-size:0.75rem;" @bind="_calendarSettings.HeaderBookButtonText" placeholder="Label" />
                                                        </div>
                                                        <div class="col-6">
                                                            <input type="text" class="form-control form-control-sm" style="font-size:0.75rem;" @bind="_calendarSettings.HeaderBookButtonUrl" placeholder="URL" />
                                                        </div>
                                                    </div>
                                                }
                                            </div>
