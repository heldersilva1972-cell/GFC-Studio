                                </div>
                                <p class="text-muted small mb-3">
                                    Upload the client file named <code class="text-success fw-bold">google-services.json</code>. Automatically placed into <code class="text-dark">apps/GFC-Connect/app/google-services.json</code>.
                                </p>

                                <div class="p-4 border border-2 border-dashed rounded-4 text-center bg-light mb-3 flex-grow-1 d-flex flex-column justify-content-center align-items-center">
                                    <i class="bi bi-android2 text-success display-6 mb-2"></i>
                                    <span class="fw-bold text-dark mb-1 small">Select google-services.json File</span>
                                    <span class="text-muted mb-3" style="font-size:0.75rem;">From Firebase Console → Project Settings → General (Your Apps)</span>
                                    
                                    <div class="position-relative">
                                        <InputFile OnChange="HandleGoogleServicesFileUpload" accept=".json" class="form-control form-control-sm" />
                                    </div>
                                    @if (_isUploadingGoogleServices)
                                    {
                                        <div class="mt-2 text-success small fw-semibold">
                                            <span class="spinner-border spinner-border-sm me-1"></span> Installing to GFC-Connect/app/...
                                        </div>
                                    }
                                </div>

                                <div class="bg-light p-2.5 rounded-3 border mb-3">
                                    <div class="d-flex justify-content-between align-items-center small">
                                        <span class="text-muted"><i class="bi bi-folder-check text-success me-1"></i>Auto Destination:</span>
                                        <code class="text-dark fw-bold" style="font-size:0.75rem;">apps/GFC-Connect/app/google-services.json</code>
                                    </div>
                                </div>

                                @if (!string.IsNullOrEmpty(_googleServicesProjectId))
                                {
                                    <div class="alert alert-success py-2 px-3 small border-0 mb-0 d-flex align-items-center gap-2">
                                        <i class="bi bi-check-circle-fill text-success"></i>
                                        <span>Installed for project: <strong>@_googleServicesProjectId</strong> (com.gfc.connect)</span>
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- How-To Guide for Server Migrations -->
                        <div class="col-12">
                            <div class="card border rounded-4 shadow-sm bg-white p-4">
                                <h5 class="fw-bold text-dark mb-3"><i class="bi bi-journal-bookmark-fill text-primary me-2"></i>How to Configure Firebase on Any New Server in 3 Clicks</h5>
                                <div class="row g-3">
                                    <div class="col-md-4">
                                        <div class="p-3 bg-light rounded-3 border h-100">
                                            <div class="fw-bold text-primary mb-1">1. Open Firebase Console</div>
                                            <p class="text-muted small mb-0">Go to <a href="https://console.firebase.google.com/" target="_blank" class="fw-semibold">console.firebase.google.com</a> and open your <strong>GFC Connect</strong> project.</p>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="p-3 bg-light rounded-3 border h-100">
                                            <div class="fw-bold text-primary mb-1">2. Download the 2 Files</div>
                                            <p class="text-muted small mb-0">Download <strong>google-services.json</strong> under General tab, and <strong>Private Key</strong> under Service Accounts tab.</p>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="p-3 bg-light rounded-3 border h-100">
                                            <div class="fw-bold text-primary mb-1">3. Select Files Above</div>
                                            <p class="text-muted small mb-0">Click the upload boxes above. GFC Studio instantly puts both files in their exact folders automatically!</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- BOTTOM SAVE ACTION BAR (FIXED) -->
        <div class="bottom-action-bar bg-white rounded-4 border p-3 shadow-sm mt-3 flex-shrink-0 d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div class="d-flex align-items-center gap-2 text-muted small">
                <i class="bi bi-info-circle-fill text-primary"></i>
                <span>All modifications across all tabs will be saved simultaneously.</span>
            </div>
            <div class="d-flex align-items-center gap-2">
                <button type="button" class="btn btn-outline-secondary px-3" @onclick="GoBackToHallRentals">
                    Cancel &amp; Return
                </button>
                <button type="button" class="btn btn-primary btn-lg px-4 shadow-sm fw-bold d-flex align-items-center gap-2" @onclick="SaveAllSettings" disabled="@_isSaving">
                    @if (_isSaving)
                    {
                        <span class="spinner-border spinner-border-sm"></span>
                        <span>Saving Changes...</span>
                    }
                    else
                    {
                        <i class="bi bi-check2-circle fs-5"></i>
                        <span>Save All Settings</span>
                    }
                </button>
            </div>
        </div>
    }
</div>

<!-- DELETE FEED CONFIRMATION MODAL -->
@if (_showDeleteFeedConfirm && _feedToDelete != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.45); z-index: 1060;" role="dialog">
        <div class="modal-dialog modal-dialog-centered" style="max-width: 440px;" role="document">
            <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="modal-body p-4 text-center">
                    <div class="p-3 rounded-circle bg-danger-subtle text-danger d-inline-flex mb-3">
                        <i class="bi bi-trash3-fill fs-3"></i>
                    </div>
                    <h5 class="fw-bold mb-2 text-dark">Remove Calendar Feed?</h5>
                    <p class="text-muted small mb-3">
