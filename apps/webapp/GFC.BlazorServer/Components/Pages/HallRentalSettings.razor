                                            <button type="button" class="btn btn-sm rounded-pill flex-fill py-1 px-2 @(!_webSettings.RequireApplicantName ? "btn-dark fw-bold shadow-sm" : "btn-light text-muted border-0")" @onclick="() => _webSettings.RequireApplicantName = false">Optional</button>
