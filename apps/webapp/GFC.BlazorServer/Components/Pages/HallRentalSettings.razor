    private void MoveGoogleTitleField(CalendarFieldDisplayConfig item, int direction)
    {
        var ordered = _settings.EventTitleFields.OrderBy(f => f.Order).ToList();
        int idx = ordered.IndexOf(item);
        int newIdx = idx + direction;
        if (newIdx >= 0 && newIdx < ordered.Count)
        {
            var target = ordered[newIdx];
            int tempOrder = item.Order;
            item.Order = target.Order;
            target.Order = tempOrder;
            if (item.Order == target.Order)
            {
                for (int i = 0; i < ordered.Count; i++) ordered[i].Order = i + 1;
                // Re-swap
                ordered = _settings.EventTitleFields.OrderBy(f => f.Order).ToList();
                idx = ordered.IndexOf(item);
                newIdx = idx + direction;
                if (newIdx >= 0 && newIdx < ordered.Count)
                {
                    target = ordered[newIdx];
                    tempOrder = item.Order;
                    item.Order = target.Order;
                    target.Order = tempOrder;
                }
            }
            StateHasChanged();
        }
    }

