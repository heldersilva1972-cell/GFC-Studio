                                    <button type="button" class="btn btn-sm btn-link text-primary text-decoration-none p-0 fw-bold small" @onclick="() => _showEmbedInstructions = !_showEmbedInstructions">
                                        <i class="bi bi-question-circle me-1"></i>@(_showEmbedInstructions ? "Hide Guide" : "Step-by-Step Guide")
                                    </button>
                                </div>
                                <p class="small text-muted mb-3">
                                    Embed your booking form into your website once. Any future changes you make in GFC Studio update <strong>automatically</strong> without needing to re-embed.
                                </p>
                                <button type="button" class="btn btn-primary w-100 py-2 shadow-sm d-flex align-items-center justify-content-center gap-2 mb-2" @onclick="CopyEmbedCode">
                                    <i class="bi bi-clipboard-check"></i>
                                    <span>Copy Embed Code (iframe)</span>
                                </button>

                                @if (_showEmbedInstructions)
                                {
                                    <div class="mt-3 p-3 bg-white rounded-3 border small animate-fade-in">
                                        <h6 class="fw-bold text-dark mb-2"><i class="bi bi-journal-text text-primary me-1"></i>How to add to WordPress:</h6>
                                        <ol class="ps-3 mb-2 text-secondary" style="line-height: 1.5;">
                                            <li>Click <strong>"Copy Embed Code"</strong> above.</li>
                                            <li>Log in to your <strong>WordPress Admin Dashboard</strong>.</li>
                                            <li>Go to <strong>Pages &gt; Add New</strong> (or edit your existing <em>Hall Rentals</em> page).</li>
                                            <li>In the block editor, click the <strong>(+) Add Block</strong> button.</li>
                                            <li>Search for and select the <strong>Custom HTML</strong> block.</li>
                                            <li><strong>Paste</strong> the embed code into the block.</li>
                                            <li>Click <strong>Publish</strong> or <strong>Update</strong>.</li>
                                        </ol>
                                        <div class="p-2 bg-success bg-opacity-10 text-success rounded border border-success border-opacity-25" style="font-size: 0.76rem;">
                                            <i class="bi bi-check-circle-fill me-1"></i><strong>That's it!</strong> You only need to do this once. All pricing, rooms, rules, and schedules stay synced in real time.
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }

            @* ========================================================================= *@
            @* TAB 5: POLICIES & AGREEMENTS *@
            @* ========================================================================= *@
            @if (string.Equals(_activeTab, "policies", StringComparison.OrdinalIgnoreCase))
            {
                <div class="tab-pane-card animate-fade-in">
                    <div class="row g-4">
                        <div class="col-lg-8">
                            <!-- Policy List Header -->
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <div>
                                    <h5 class="fw-bold mb-0 text-dark">
                                        <i class="bi bi-shield-fill-check text-primary me-2"></i>Dynamic Rental Policies &amp; Agreements
                                    </h5>
                                    <small class="text-muted">Configure standalone policies (e.g. Terms &amp; Conditions) or attach policies directly to specific add-on services.</small>
                                </div>
                                <button type="button" class="btn btn-primary px-3 shadow-sm d-flex align-items-center gap-2" @onclick="AddNewPolicy">
                                    <i class="bi bi-plus-circle-fill"></i>
                                    <span>Add New Policy</span>
                                </button>
                            </div>

                            @if (_editablePolicies.Count == 0)
                            {
                                <div class="card border rounded-4 p-5 text-center bg-white shadow-sm mb-4">
                                    <i class="bi bi-shield-slash fs-1 text-muted mb-2"></i>
                                    <h6 class="fw-bold text-dark">No Policies Configured</h6>
                                    <p class="text-muted small mb-3">Add a policy or reset to default policies.</p>
                                    <div>
                                        <button type="button" class="btn btn-sm btn-primary" @onclick="AddNewPolicy">
                                            <i class="bi bi-plus-lg me-1"></i>Add Policy
                                        </button>
                                    </div>
                                </div>
                            }
                            else
                            {
                                @foreach (var policy in _editablePolicies)
                                {
                                    <div class="card border rounded-4 p-4 shadow-sm bg-white mb-4 position-relative">
                                        <div class="d-flex justify-content-between align-items-start gap-2 mb-3">
                                            <div class="flex-grow-1">
                                                <div class="row g-2 align-items-center">
                                                    <div class="col-md-7">
                                                        <label class="form-label small fw-bold text-dark mb-1">Policy Title / Header</label>
                                                        <input type="text" class="form-control fw-bold" placeholder="e.g. Terms and Conditions Agreement" @bind="policy.Title" />
                                                    </div>
                                                    <div class="col-md-5">
                                                        <label class="form-label small fw-bold text-dark mb-1">Display &amp; Visibility Rule</label>
                                                        <select class="form-select form-select-sm fw-semibold" @bind="policy.DisplayMode">
                                                            <option value="Always">🌐 Always Display on Booking Form</option>
                                                            <option value="QuestionTriggered">❓ Display Only when Yes to Question</option>
                                                            <option value="AddonTriggered">⚡ Only Display when Add-on is Selected</option>
                                                            <option value="Hidden">🚫 Hidden / Disabled (Do Not Display)</option>
                                                        </select>
                                                    </div>
                                                </div>
                                            </div>
                                            <button type="button" class="btn btn-outline-danger btn-sm rounded-circle p-2 mt-4" title="Remove Policy" @onclick="() => RemovePolicy(policy)" disabled="@(_editablePolicies.Count <= 1)">
                                                <i class="bi bi-trash3"></i>
                                            </button>
                                        </div>

                                        @if (string.Equals(policy.DisplayMode, "QuestionTriggered", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <div class="alert alert-warning py-3 px-3 small rounded-3 mb-3 border-warning d-flex flex-column gap-3">
                                                <div class="d-flex align-items-center gap-2">
                                                    <i class="bi bi-question-circle-fill text-warning fs-5"></i>
                                                    <span><strong>Yes/No Question Configuration:</strong> The main policy body below is always visible. When applicant selects <strong>"Yes"</strong>, you can optionally display an additional notice.</span>
                                                </div>
                                                <div>
                                                    <label class="form-label small fw-bold text-dark mb-1">Question Asked to Applicant:</label>
                                                    <input type="text" class="form-control form-control-sm fw-bold" placeholder="e.g. Do you require setup time prior to your event start time listed above?" @bind="policy.PromptQuestion" />
                                                </div>
                                                <div class="p-3 bg-white rounded-3 border">
                                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                                        <div class="d-flex align-items-center gap-2">
                                                            <div class="form-check form-switch mb-0">
                                                                <input class="form-check-input" type="checkbox" role="switch" id="@($"showExtra_{policy.Id}")" @bind="policy.ShowExtraNoteOnYes" />
                                                                <label class="form-check-label small fw-bold text-dark" for="@($"showExtra_{policy.Id}")">Display Additional Notice on "Yes"</label>
                                                            </div>
                                                        </div>
                                                        @if (policy.ShowExtraNoteOnYes)
                                                        {
                                                            <div class="form-check form-switch mb-0">
                                                                <input class="form-check-input" type="checkbox" role="switch" id="@($"hl_{policy.Id}")" @bind="policy.HighlightOnYes" />
                                                                <label class="form-check-label small fw-bold text-dark" for="@($"hl_{policy.Id}")">Highlight in Amber/Yellow</label>
                                                            </div>
                                                        }
                                                    </div>
                                                    @if (policy.ShowExtraNoteOnYes)
                                                    {
                                                        <textarea class="form-control form-control-sm" rows="2" placeholder="e.g. Extra setup time is subject to availability; we will contact you to review details and confirm what's possible." @bind="policy.ExtraNoteOnYes"></textarea>
                                                        <small class="text-muted mt-1 d-block" style="font-size: 0.75rem;">This note will expand below the policy text when the applicant clicks "Yes".</small>
                                                    }
                                                    else
                                                    {
                                                        <small class="text-muted d-block" style="font-size: 0.75rem;"><em>No additional notice will be shown when applicant selects "Yes".</em></small>
                                                    }
                                                </div>
                                            </div>
                                        }
                                        else if (string.Equals(policy.DisplayMode, "AddonTriggered", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <div class="alert alert-info py-2 px-3 small rounded-3 mb-3 border-info d-flex align-items-center justify-content-between flex-wrap gap-2">
                                                <div class="d-flex align-items-center gap-2">
                                                    <i class="bi bi-link-45deg fs-5 text-primary"></i>
                                                    <span><strong>Trigger Condition:</strong> Display this policy ONLY when applicant selects this add-on:</span>
                                                </div>
                                                <div style="min-width: 200px;">
                                                    <select class="form-select form-select-sm fw-bold" @bind="policy.AssociatedAddonId">
                                                        <option value="">-- Select Associated Add-on --</option>
                                                        @foreach (var addon in _editableAddons)
                                                        {
                                                            <option value="@addon.Id">@addon.Name (@($"${addon.Fee:N2}"))</option>
                                                        }
                                                    </select>
                                                </div>
                                            </div>
                                        }

                                        <div class="mb-3">
                                            <label class="form-label small fw-bold text-dark mb-1">Policy Contract Body / Terms</label>
                                            <textarea class="form-control font-monospace small" rows="5" style="font-size: 0.85rem; line-height: 1.5;" placeholder="Enter legal terms or conditions..." @bind="policy.Content"></textarea>
                                        </div>

                                        <div class="row g-2 align-items-center pt-2 border-top">
                                            <div class="col-md-9">
                                                <label class="form-label small fw-bold text-dark mb-1">Acknowledgment Checkbox Label</label>
                                                <input type="text" class="form-control form-control-sm" placeholder="e.g. I Agree to the Terms and Conditions above" @bind="policy.CheckboxLabel" />
                                            </div>
                                            <div class="col-md-3 text-md-end">
                                                <div class="form-check form-switch mt-3 d-inline-block">
                                                    <input class="form-check-input" type="checkbox" role="switch" id="@($"req_{policy.Id}")" @bind="policy.IsRequired" />
                                                    <label class="form-check-label small fw-bold text-dark" for="@($"req_{policy.Id}")">Required (*)</label>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            }
                        </div>

                        <div class="col-lg-4">
                            <!-- Policy URL & General Acknowledgment -->
                            <div class="card border rounded-4 p-4 shadow-sm bg-white mb-4">
                                <h5 class="fw-bold text-dark mb-2">
                                    <i class="bi bi-link-45deg text-primary me-2"></i>Official Policy Web Link
                                </h5>
                                <p class="small text-muted mb-3">
                                    URL to the comprehensive policy page on your main website.
                                </p>
                                <div class="mb-3">
                                    <label class="form-label small fw-bold text-dark mb-1">External Policy URL</label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light"><i class="bi bi-globe2 text-secondary"></i></span>
                                        <input type="url" class="form-control" placeholder="https://gloucesterfraternityclub.com/hall-rentals/hall-rental-policy/" @bind="_webSettings.RentalPolicyUrl" />
                                    </div>
                                </div>

                                <div class="mb-0">
                                    <label class="form-label small fw-bold text-dark mb-1">General Agreement Checkbox Text</label>
                                    <textarea class="form-control" rows="3" @bind="_webSettings.RentalFormRulesText"></textarea>
                                    <small class="text-muted" style="font-size: 0.75rem;">Label on the final policy checkbox.</small>
                                </div>
                            </div>

                            <!-- Electronic Signature & Payment Window Notice -->
                            <div class="card border rounded-4 p-4 shadow-sm bg-white mb-4">
                                <h5 class="fw-bold text-dark mb-2">
                                    <i class="bi bi-pen-fill text-primary me-2"></i>Electronic Signature &amp; Payment Window
                                </h5>
                                <p class="small text-muted mb-3">
                                    Notice shown directly under the applicant electronic signature field informing them of their payment deadline once approved.
                                </p>
                                <div class="mb-0">
                                    <label class="form-label small fw-bold text-dark mb-1">Payment Window Notice Text</label>
                                    <textarea class="form-control" rows="4" @bind="_webSettings.RentalPaymentWindowNotice"></textarea>
                                </div>
                            </div>

                            <!-- Real-time Sync Callout -->
                            <div class="card border border-success border-opacity-25 rounded-4 p-4 shadow-sm bg-success bg-opacity-10">
                                <div class="d-flex align-items-start gap-2">
                                    <i class="bi bi-lightning-charge-fill text-success fs-4 flex-shrink-0"></i>
                                    <div>
                                        <h6 class="fw-bold text-success mb-1">Live Synchronization</h6>
                                        <p class="small text-dark mb-0" style="font-size: 0.82rem; line-height: 1.4;">
                                            Any edits made in this tab update immediately on your public application form and all embedded WordPress widgets upon clicking <strong>"Save All Settings"</strong>.
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }

            @* ========================================================================= *@
            @* TAB 6: EMAIL LOGIC & AUTOMATION *@
            @* ========================================================================= *@
            @if (string.Equals(_activeTab, "emails", StringComparison.OrdinalIgnoreCase))
            {
                <div class="tab-pane-card animate-fade-in">
                    <!-- TOP BANNER & INSTRUCTIONS ACCORDION -->
                    <div class="card border rounded-4 p-4 shadow-sm bg-white mb-4">
                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
                            <div class="d-flex align-items-center gap-3">
                                <div class="bg-primary bg-opacity-10 p-3 rounded-4 text-primary">
                                    <i class="bi bi-envelope-gear-fill fs-3"></i>
                                </div>
                                <div>
                                    <h5 class="fw-bold mb-0 text-dark">Hall Rental Email Logic &amp; Automation</h5>
                                    <p class="text-muted small mb-0 mt-1">Configure your website domain mailer (SMTP or Resend API), staff alerts, and automated applicant confirmation responses.</p>
                                </div>
                            </div>
                            <button type="button" class="btn btn-sm btn-outline-info rounded-pill px-3 fw-bold" @onclick="() => _showEmailInstructions = !_showEmailInstructions">
                                <i class="bi bi-info-circle me-1"></i>@(_showEmailInstructions ? "Hide Setup Instructions" : "View Setup Instructions & Guide")
                            </button>
                        </div>

                        @if (_showEmailInstructions)
                        {
                            <div class="alert alert-info border-0 rounded-4 p-4 mb-0 animate-fade-in">
                                <h6 class="fw-bold text-dark mb-2"><i class="bi bi-mortarboard-fill me-2 text-primary"></i>How to Setup Website Domain Email for Hall Rentals:</h6>
                                <div class="row g-3 small text-dark">
                                    <div class="col-md-6">
                                        <div class="p-3 bg-white rounded-3 border h-100">
                                            <strong class="d-block text-primary mb-1"><i class="bi bi-server me-1"></i>Option 1: Custom SMTP (Standard Mail Server)</strong>
                                            <ul class="mb-0 ps-3">
                                                <li><strong>SMTP Host:</strong> Your mail server (e.g. <code>mail.gloucesterfraternityclub.com</code>, <code>smtp.office365.com</code>, or <code>smtp.gmail.com</code>).</li>
                                                <li><strong>Port:</strong> Use <strong>587</strong> with TLS/SSL enabled (recommended) or <strong>465</strong> for SSL.</li>
                                                <li><strong>Username &amp; Password:</strong> Your full mailbox email and account / app password.</li>
                                                <li><strong>Sender Email:</strong> Must match or be authorized by your mail server (e.g. <code>rentals@gloucesterfraternityclub.com</code>).</li>
                                            </ul>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="p-3 bg-white rounded-3 border h-100">
                                            <strong class="d-block text-primary mb-1"><i class="bi bi-lightning-charge me-1"></i>Option 2: Resend API (High Reliability Cloud)</strong>
                                            <ul class="mb-0 ps-3">
                                                <li><strong>API Key:</strong> Generate a key from <a href="https://resend.com" target="_blank" class="fw-bold text-decoration-none">Resend.com</a> starting with <code>re_...</code>.</li>
                                                <li><strong>Domain Verification:</strong> Add DKIM and SPF DNS records in your domain registrar for optimal deliverability.</li>
                                                <li><strong>Sender Email:</strong> Set to any verified domain address (e.g. <code>rentals@gloucesterfraternityclub.com</code>).</li>
                                            </ul>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                    <div class="row g-4 mb-4">
                        <!-- Left Column: Delivery Engine & Sender Profile -->
                        <div class="col-lg-6">
                            <div class="card border rounded-4 p-4 shadow-sm bg-white h-100">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <h6 class="fw-bold text-dark text-uppercase small tracking-wider mb-0">
                                        <i class="bi bi-cpu text-primary me-2"></i>1. Outgoing Delivery Engine
                                    </h6>
                                    <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-10">Website Mailer</span>
                                </div>

                                <!-- Engine Mode Selector Pills -->
                                <div class="d-flex gap-2 p-1 bg-light rounded-pill border mb-3">
                                    <button type="button" class="btn btn-sm rounded-pill flex-grow-1 @(_webSettings.RentalEmailProvider == "SMTP" ? "btn-dark shadow-sm fw-bold" : "btn-link text-muted text-decoration-none")" 
                                            @onclick='() => _webSettings.RentalEmailProvider = "SMTP"'>
                                        <i class="bi bi-hdd-network me-1"></i>SMTP Server
                                    </button>
                                    <button type="button" class="btn btn-sm rounded-pill flex-grow-1 @(_webSettings.RentalEmailProvider == "Resend" ? "btn-primary shadow-sm fw-bold" : "btn-link text-muted text-decoration-none")" 
                                            @onclick='() => _webSettings.RentalEmailProvider = "Resend"'>
                                        <i class="bi bi-cloud-arrow-up me-1"></i>Resend API
                                    </button>
                                </div>

                                @if (_webSettings.RentalEmailProvider == "Resend")
                                {
                                    <div class="animate-fade-in p-3 bg-light rounded-3 border mb-3">
                                        <label class="form-label small fw-bold text-dark mb-1">Resend API Key</label>
                                        <div class="input-group input-group-sm">
                                            <input type="@(_showRentalResendKey ? "text" : "password")" class="form-control font-monospace fw-bold" placeholder="re_xxxxxxxxxxxxxx" @bind="_webSettings.RentalResendApiKey" />
                                            <button type="button" class="btn btn-outline-secondary" @onclick="() => _showRentalResendKey = !_showRentalResendKey">
                                                <i class="bi @(_showRentalResendKey ? "bi-eye-slash" : "bi-eye")"></i>
                                            </button>
                                        </div>
                                        <small class="text-muted d-block mt-1">Get your API key from your Resend Dashboard with sending permissions.</small>
                                    </div>
                                }
                                else
                                {
                                    <div class="animate-fade-in p-3 bg-light rounded-3 border mb-3">
                                        <div class="row g-2 mb-2">
                                            <div class="col-8">
                                                <label class="form-label small text-muted mb-1">SMTP Host / Server</label>
                                                <input type="text" class="form-control form-control-sm fw-bold" placeholder="mail.gloucesterfraternityclub.com" @bind="_webSettings.RentalSmtpHost" />
                                            </div>
                                            <div class="col-4">
                                                <label class="form-label small text-muted mb-1">Port</label>
                                                <input type="number" class="form-control form-control-sm text-center fw-bold" placeholder="587" @bind="_webSettings.RentalSmtpPort" />
                                            </div>
                                        </div>
                                        <div class="row g-2 mb-2">
                                            <div class="col-6">
                                                <label class="form-label small text-muted mb-1">SMTP Username / Mailbox</label>
                                                <input type="text" class="form-control form-control-sm fw-bold" placeholder="rentals@gloucesterfraternityclub.com" @bind="_webSettings.RentalSmtpUsername" />
                                            </div>
                                            <div class="col-6">
                                                <label class="form-label small text-muted mb-1">SMTP Password</label>
                                                <input type="password" class="form-control form-control-sm fw-bold" placeholder="••••••••••••" @bind="_webSettings.RentalSmtpPassword" />
                                            </div>
                                        </div>
                                        <div class="form-check form-switch mt-2 mb-0">
                                            <input class="form-check-input" type="checkbox" role="switch" id="smtpSslSw" @bind="_webSettings.RentalSmtpEnableSsl" />
                                            <label class="form-check-label small fw-bold text-dark" for="smtpSslSw">Enable TLS / SSL Encryption (Recommended on Port 587)</label>
                                        </div>
                                    </div>
                                }

                                <!-- Sender Profile Configuration -->
                                <div class="row g-2 mb-3">
                                    <div class="col-md-6">
                                        <label class="form-label small fw-bold text-dark mb-1">Sender Email Address (From)</label>
                                        <input type="email" class="form-control form-control-sm fw-bold" placeholder="rentals@gloucesterfraternityclub.com" @bind="_webSettings.RentalSenderEmail" />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label small fw-bold text-dark mb-1">Sender Display Name</label>
                                        <input type="text" class="form-control form-control-sm fw-bold" placeholder="Gloucester Fraternity Club - Hall Rentals" @bind="_webSettings.RentalSenderName" />
                                    </div>
                                    <div class="col-12">
                                        <label class="form-label small fw-bold text-dark mb-1">Optional CC Copy Address</label>
                                        <input type="email" class="form-control form-control-sm" placeholder="e.g. records@gloucesterfraternityclub.com" @bind="_webSettings.RentalEmailCc" />
                                        <small class="text-muted">Receive a carbon copy of all outgoing applicant confirmations.</small>
                                    </div>
                                </div>

                                <!-- Live Connection / Email Tester Tool -->
                                <div class="p-3 bg-light rounded-3 border mt-auto">
                                    <label class="form-label small fw-bold text-dark mb-1"><i class="bi bi-send-check text-primary me-1"></i>Test Connection &amp; Send Test Email</label>
                                    <div class="input-group input-group-sm mb-2">
                                        <input type="email" class="form-control" placeholder="Enter recipient email (e.g. your email)" @bind="_rentalEmailTestAddress" />
                                        <button type="button" class="btn btn-primary fw-bold" @onclick="TestRentalEmailConnectionAsync" disabled="@_isTestingRentalEmail">
                                            @if (_isTestingRentalEmail)
                                            {
                                                <span class="spinner-border spinner-border-sm me-1"></span>
                                                <span>Sending...</span>
                                            }
                                            else
                                            {
                                                <i class="bi bi-send me-1"></i>
                                                <span>Test Send</span>
                                            }
                                        </button>
                                    </div>

                                    @if (!string.IsNullOrEmpty(_rentalEmailTestMessage))
                                    {
                                        <div class="alert @(_rentalEmailTestSuccess ? "alert-success" : "alert-danger") py-2 px-3 small rounded-3 mb-0 d-flex align-items-center gap-2">
                                            <i class="bi @(_rentalEmailTestSuccess ? "bi-check-circle-fill text-success" : "bi-exclamation-triangle-fill text-danger")"></i>
                                            <div>@_rentalEmailTestMessage</div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>

                        <!-- Right Column: Staff Recipients & Notification Triggers -->
                        <div class="col-lg-6">
                            <div class="card border rounded-4 p-4 shadow-sm bg-white h-100">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <div>
                                        <h6 class="fw-bold text-dark text-uppercase small tracking-wider mb-0">
                                            <i class="bi bi-people-fill text-primary me-2"></i>2. Staff &amp; Management Recipients
                                        </h6>
                                        <small class="text-muted">Individual email boxes that receive rental booking alerts</small>
                                    </div>
                                    <button type="button" class="btn btn-sm btn-primary shadow-sm" @onclick="AddNewRecipient">
                                        <i class="bi bi-plus-lg me-1"></i>Add Recipient
                                    </button>
                                </div>

                                @if (_editableRecipients.Count == 0)
                                {
                                    <div class="text-center py-4 bg-light rounded-4 border mb-3">
                                        <i class="bi bi-envelope-plus fs-2 text-muted d-block mb-2"></i>
                                        <p class="text-muted small mb-3">No staff recipients added yet.</p>
                                        <button type="button" class="btn btn-sm btn-primary" @onclick="AddNewRecipient">+ Add First Email</button>
                                    </div>
                                }
                                else
                                {
                                    <div class="d-flex flex-column gap-2 mb-3">
                                        @for (int rIdx = 0; rIdx < _editableRecipients.Count; rIdx++)
                                        {
                                            var currentIndex = rIdx;
                                            <div class="d-flex align-items-center gap-2 p-2 bg-light rounded-3 border">
                                                <span class="badge bg-primary rounded-circle">@(currentIndex + 1)</span>
                                                <input type="email" class="form-control form-control-sm" placeholder="e.g. manager@gloucesterfraternityclub.com" 
                                                       value="@_editableRecipients[currentIndex]" 
                                                       @onchange="(e) => UpdateRecipient(currentIndex, e.Value?.ToString())" />
                                                <button type="button" class="btn btn-outline-danger btn-sm rounded-circle p-1" title="Remove Recipient" @onclick="() => RemoveRecipient(currentIndex)" disabled="@(_editableRecipients.Count <= 1)">
                                                    <i class="bi bi-trash3"></i>
                                                </button>
                                            </div>
                                        }
                                    </div>
                                }

                                <div class="p-3 bg-light rounded-3 border mt-auto">
                                    <h6 class="fw-bold text-dark mb-2"><i class="bi bi-bell-fill text-warning me-2"></i>Notification Triggers</h6>
                                    <div class="d-flex flex-column gap-2">
                                        <div class="form-check form-switch">
                                            <input class="form-check-input" type="checkbox" role="switch" id="tNotifyNew" @bind="_webSettings.NotifyOnNewSubmission" />
                                            <label class="form-check-label fw-bold text-dark small" for="tNotifyNew">New Public Rental Submissions</label>
                                        </div>
                                        <div class="form-check form-switch">
                                            <input class="form-check-input" type="checkbox" role="switch" id="tNotifyPay" @bind="_webSettings.NotifyOnPaymentRecorded" />
                                            <label class="form-check-label fw-bold text-dark small" for="tNotifyPay">Payment &amp; Deposit Recorded Alerts</label>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- FULL-WIDTH SECTION: APPLICANT AUTO-RESPONDER TEMPLATE -->
                    <div class="card border rounded-4 p-4 shadow-sm bg-white mb-4">
                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
                            <div>
                                <h5 class="fw-bold text-dark mb-0"><i class="bi bi-reply-fill text-primary me-2"></i>3. Outgoing Applicant Auto-Responder</h5>
                                <small class="text-muted">Automated confirmation receipt sent to applicant immediately upon form submission from your website email</small>
                            </div>
                            <div class="form-check form-switch mb-0">
                                <input class="form-check-input" type="checkbox" role="switch" id="tSendConf" @bind="_webSettings.SendApplicantConfirmation" />
                            </div>
                        </div>

                        <div class="p-3 rounded-3 mb-3 @(_webSettings.SendApplicantConfirmation ? "bg-success bg-opacity-10 border border-success" : "bg-light border text-muted")">
                            <div class="d-flex align-items-center gap-2">
                                <i class="bi @(_webSettings.SendApplicantConfirmation ? "bi-check-circle-fill text-success" : "bi-x-circle text-secondary") fs-5"></i>
                                <span class="fw-bold small text-dark">
                                    @(_webSettings.SendApplicantConfirmation ? "Auto-Responder is ACTIVE & ENABLED" : "Auto-Responder is DISABLED")
                                </span>
                            </div>
                            <small class="text-muted d-block mt-1">When active, the applicant will receive this customized email confirmation from <strong>@(_webSettings.RentalSenderEmail)</strong>.</small>
                        </div>

                        @if (_webSettings.SendApplicantConfirmation)
                        {
                            <div class="row g-4">
                                <div class="col-lg-6">
                                    <div class="mb-3">
                                        <label class="form-label small fw-bold text-dark mb-1">Email Subject Line</label>
                                        <input type="text" class="form-control fw-bold" placeholder="Your Gloucester Fraternity Club Hall Rental Request" @bind="_webSettings.ApplicantConfirmationEmailSubject" />
                                    </div>

                                    <div class="mb-3">
                                        <div class="d-flex justify-content-between align-items-center mb-1">
                                            <label class="form-label small fw-bold text-dark mb-0">Email Message Body</label>
                                            <span class="badge bg-light text-muted border">Dynamic Tags Available</span>
                                        </div>
                                        <div class="d-flex gap-1 flex-wrap mb-2">
                                            <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2 small" @onclick='() => InsertTag("{ApplicantName}")'>+ {ApplicantName}</button>
                                            <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2 small" @onclick='() => InsertTag("{EventDate}")'>+ {EventDate}</button>
                                            <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2 small" @onclick='() => InsertTag("{RoomSelected}")'>+ {RoomSelected}</button>
                                            <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2 small" @onclick='() => InsertTag("{TotalPrice}")'>+ {TotalPrice}</button>
                                            <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2 small" @onclick='() => InsertTag("{DepositAmount}")'>+ {DepositAmount}</button>
                                            <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2 small" @onclick='() => InsertTag("{ClubPhone}")'>+ {ClubPhone}</button>
                                        </div>
                                        <textarea class="form-control font-monospace small" rows="8" placeholder="Dear {ApplicantName}, thank you for your rental request for {RoomSelected} on {EventDate}..." @bind="_webSettings.ApplicantConfirmationEmailBody"></textarea>
                                    </div>
                                </div>

                                <div class="col-lg-6">
                                    <!-- Live Sample Email Preview -->
                                    <div class="p-3 bg-light rounded-4 border h-100 d-flex flex-column">
                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                            <strong class="text-dark small"><i class="bi bi-eye me-1"></i>Sample Email Output Preview:</strong>
                                            <span class="badge bg-primary">Live Output</span>
                                        </div>
                                        <div class="p-3 bg-white rounded-3 border small text-dark flex-grow-1" style="white-space: pre-wrap; font-size: 0.85rem;">@GetSampleAutoResponderOutput()</div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                    <!-- FULL-WIDTH SECTION: BOOKING APPROVED & CALENDAR CONFIRMED TEMPLATE -->
                    <div class="card border rounded-4 p-4 shadow-sm bg-white mb-4">
                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
                            <div>
                                <h5 class="fw-bold text-dark mb-0"><i class="bi bi-calendar-check-fill text-success me-2"></i>4. Booking Approved &amp; Calendar Confirmed Email</h5>
                                <small class="text-muted">Automated notification sent to applicant when an admin approves their booking and confirms their date on the calendar</small>
                            </div>
                            <div class="form-check form-switch mb-0">
                                <input class="form-check-input" type="checkbox" role="switch" id="tSendApproval" @bind="_webSettings.SendBookingApprovalEmail" />
                            </div>
                        </div>

                        <div class="p-3 rounded-3 mb-3 @(_webSettings.SendBookingApprovalEmail ? "bg-success bg-opacity-10 border border-success" : "bg-light border text-muted")">
                            <div class="d-flex align-items-center gap-2">
                                <i class="bi @(_webSettings.SendBookingApprovalEmail ? "bi-check-circle-fill text-success" : "bi-x-circle text-secondary") fs-5"></i>
                                <span class="fw-bold small text-dark">
                                    @(_webSettings.SendBookingApprovalEmail ? "Approval Notification is ENABLED (Sends upon booking approval)" : "Approval Notification is DISABLED (No email sent on approval)")
                                </span>
                            </div>
                        </div>

                        @if (_webSettings.SendBookingApprovalEmail)
                        {
                            <div class="row g-4">
                                <div class="col-lg-6">
                                    <div class="mb-3">
                                        <label class="form-label small fw-bold text-dark mb-1">Approval Email Subject Line</label>
                                        <input type="text" class="form-control fw-bold" placeholder="Booking Approved &amp; Reserved - {ClubName} Hall Rental" @bind="_webSettings.BookingApprovalEmailSubject" />
                                    </div>

                                    <div class="mb-3">
                                        <div class="d-flex justify-content-between align-items-center mb-1">
                                            <label class="form-label small fw-bold text-dark mb-0">Approval Email Message Body</label>
                                            <span class="badge bg-light text-muted border">Dynamic Tags Available</span>
                                        </div>
                                        <div class="d-flex gap-1 flex-wrap mb-2">
                                            <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2 small" @onclick='() => InsertApprovalTag("{ApplicantName}")'>+ {ApplicantName}</button>
                                            <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2 small" @onclick='() => InsertApprovalTag("{EventDate}")'>+ {EventDate}</button>
                                            <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2 small" @onclick='() => InsertApprovalTag("{StartTime}")'>+ {StartTime}</button>
                                            <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2 small" @onclick='() => InsertApprovalTag("{EndTime}")'>+ {EndTime}</button>
                                            <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2 small" @onclick='() => InsertApprovalTag("{RoomSelected}")'>+ {RoomSelected}</button>
                                            <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2 small" @onclick='() => InsertApprovalTag("{TotalPrice}")'>+ {TotalPrice}</button>
                                            <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2 small" @onclick='() => InsertApprovalTag("{DepositAmount}")'>+ {DepositAmount}</button>
                                            <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2 small" @onclick='() => InsertApprovalTag("{ClubPhone}")'>+ {ClubPhone}</button>
                                        </div>
                                        <textarea class="form-control font-monospace small" rows="8" placeholder="Dear {ApplicantName}, your booking for {RoomSelected} on {EventDate} is approved..." @bind="_webSettings.BookingApprovalEmailBody"></textarea>
                                    </div>
                                </div>

                                <div class="col-lg-6">
                                    <div class="p-3 bg-light rounded-4 border h-100 d-flex flex-column">
                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                            <strong class="text-dark small"><i class="bi bi-eye me-1"></i>Sample Approval Email Preview:</strong>
                                            <span class="badge bg-success">Live Output</span>
                                        </div>
                                        <div class="p-3 bg-white rounded-3 border small text-dark flex-grow-1" style="white-space: pre-wrap; font-size: 0.85rem;">@GetSampleApprovalEmailOutput()</div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                    <!-- FULL-WIDTH SECTION: PAYMENT REMINDER TEMPLATE -->
                    <div class="card border rounded-4 p-4 shadow-sm bg-white mb-4">
                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
                            <div>
                                <h5 class="fw-bold text-dark mb-0"><i class="bi bi-credit-card-2-front-fill text-warning me-2"></i>5. Payment &amp; Deposit Reminder Email</h5>
                                <small class="text-muted">Template used when clicking "Send Payment Reminder" on bookings with an unpaid balance</small>
                            </div>
                        </div>

                        <div class="row g-4">
                            <div class="col-lg-6">
                                <div class="mb-3">
                                    <label class="form-label small fw-bold text-dark mb-1">Reminder Email Subject Line</label>
                                    <input type="text" class="form-control fw-bold" placeholder="Payment Reminder - {ClubName} Hall Rental for {EventDate}" @bind="_webSettings.PaymentReminderEmailSubject" />
                                </div>

                                <div class="mb-3">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <label class="form-label small fw-bold text-dark mb-0">Reminder Email Message Body</label>
                                        <span class="badge bg-light text-muted border">Dynamic Tags Available</span>
                                    </div>
                                    <div class="d-flex gap-1 flex-wrap mb-2">
                                        <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2 small" @onclick='() => InsertReminderTag("{ApplicantName}")'>+ {ApplicantName}</button>
                                        <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2 small" @onclick='() => InsertReminderTag("{EventDate}")'>+ {EventDate}</button>
                                        <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2 small" @onclick='() => InsertReminderTag("{TotalPrice}")'>+ {TotalPrice}</button>
                                        <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2 small" @onclick='() => InsertReminderTag("{AmountPaid}")'>+ {AmountPaid}</button>
                                        <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2 small" @onclick='() => InsertReminderTag("{RemainingBalance}")'>+ {RemainingBalance}</button>
                                        <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2 small" @onclick='() => InsertReminderTag("{ClubPhone}")'>+ {ClubPhone}</button>
                                    </div>
                                    <textarea class="form-control font-monospace small" rows="8" placeholder="Dear {ApplicantName}, this is a reminder regarding your balance of ${RemainingBalance}..." @bind="_webSettings.PaymentReminderEmailBody"></textarea>
                                </div>
                            </div>

                            <div class="col-lg-6">
                                <div class="p-3 bg-light rounded-4 border h-100 d-flex flex-column">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <strong class="text-dark small"><i class="bi bi-eye me-1"></i>Sample Payment Reminder Preview:</strong>
                                        <span class="badge bg-warning text-dark">Live Output</span>
                                    </div>
                                    <div class="p-3 bg-white rounded-3 border small text-dark flex-grow-1" style="white-space: pre-wrap; font-size: 0.85rem;">@GetSampleReminderEmailOutput()</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- FULL-WIDTH SECTION: MODIFICATION REASON & NOTE PRESETS -->
                    <div class="card border rounded-4 p-4 shadow-sm bg-white mb-4">
                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
                            <div>
                                <h5 class="fw-bold text-dark mb-0"><i class="bi bi-chat-left-quote-fill text-primary me-2"></i>6. Modification Reason &amp; Admin Note Quick-Picks</h5>
                                <small class="text-muted">Predefined quick-select notes available in dropdown menus when modifying bookings or communicating with applicants</small>
                            </div>
                            <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-3 shadow-sm" @onclick="AddNewReasonPreset">
                                <i class="bi bi-plus-lg me-1"></i>Add Preset Reason
                            </button>
                        </div>

                        <p class="small text-muted mb-3">
                            These preset reasons populate the dropdown selector in the <strong>Confirm Booking Modifications</strong> modal and email dialogs. Staff can choose a preset or type a custom note.
                        </p>

                        <div class="row g-2">
                            @for (int rIdx = 0; rIdx < _editableReasonPresets.Count; rIdx++)
                            {
                                var currentIdx = rIdx;
                                <div class="col-md-6">
                                    <div class="d-flex align-items-center gap-2 p-2 bg-light rounded-3 border">
                                        <i class="bi bi-grip-vertical text-muted"></i>
                                        <input type="text" class="form-control form-control-sm" 
                                               value="@_editableReasonPresets[currentIdx]" 
                                               @onchange="(e) => UpdateReasonPreset(currentIdx, e.Value?.ToString())" 
                                               placeholder="e.g. Applied member pricing discount" />
                                        <button type="button" class="btn btn-outline-danger btn-sm rounded-circle p-1" 
                                                title="Delete preset" 
                                                @onclick="() => RemoveReasonPreset(currentIdx)" 
                                                disabled="@(_editableReasonPresets.Count <= 1)">
                                            <i class="bi bi-trash3"></i>
                                        </button>
                                    </div>
                                </div>
                            }
                        </div>

