@if (_showQualificationEditorModal && _editingQualificationCard != null)
{
    var qConfig = _editingQualificationCard.Qualification;
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.75); z-index: 1065;" role="dialog">
        <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable" role="document">
            <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="modal-header bg-white border-bottom p-3 px-4">
                    <div class="d-flex align-items-center gap-2">
                        <div class="p-2 rounded-3 bg-warning bg-opacity-10 text-dark border border-warning border-opacity-25">
                            <i class="bi bi-patch-question-fill text-warning fs-4"></i>
                        </div>
                        <div>
                            <h5 class="modal-title fw-bold text-dark mb-0">"Do I Qualify?" Questionnaire &amp; Rules Editor</h5>
                            <small class="text-muted">Configuring qualification criteria for tier: <strong class="text-dark">@_editingQualificationCard.Title</strong></small>
                        </div>
                    </div>
                    <button type="button" class="btn-close" @onclick="() => _showQualificationEditorModal = false"></button>
                </div>
                <div class="modal-body p-4 bg-light">
                    <!-- Global Questionnaire Switch & General Text -->
                    <div class="card border-0 shadow-sm rounded-4 p-3 bg-white mb-4">
                        <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom flex-wrap gap-2">
                            <div class="d-flex align-items-center gap-2">
                                <span class="badge @(qConfig.IsEnabled ? "bg-success" : "bg-secondary") px-2.5 py-1">
                                    @(qConfig.IsEnabled ? "ACTIVE & ENFORCED" : "DISABLED")
                                </span>
                                <strong class="text-dark">Require Qualification Wizard on Public Application</strong>
                            </div>
                            <div class="form-check form-switch mb-0">
                                <input class="form-check-input" type="checkbox" role="switch" id="qualModalEnabledSw" @bind="qConfig.IsEnabled" />
                                <label class="form-check-label small fw-bold text-dark ms-1" for="qualModalEnabledSw">
                                    @(qConfig.IsEnabled ? "Enabled" : "Disabled")
                                </label>
                            </div>
                        </div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label small fw-bold text-dark mb-1">Questionnaire Modal Title</label>
                                <input type="text" class="form-control form-control-sm fw-bold" placeholder="e.g. Do I Qualify for Non-Profit / Community Rates?" @bind="qConfig.ModalTitle" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-bold text-dark mb-1">Description / Summary Instruction</label>
                                <input type="text" class="form-control form-control-sm" placeholder="e.g. To qualify, an applicant must answer YES to at least one category in Section 1, and YES to all criteria in Section 2." @bind="qConfig.Description" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-bold text-dark mb-1">Passing Success Badge Text</label>
                                <input type="text" class="form-control form-control-sm text-success fw-semibold" placeholder="e.g. You Qualify for this Rate" @bind="qConfig.PassBadgeText" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-bold text-dark mb-1">Failing / Incomplete Badge Text</label>
                                <input type="text" class="form-control form-control-sm text-danger fw-semibold" placeholder="e.g. Does Not Meet Rate Qualification" @bind="qConfig.FailBadgeText" />
                            </div>
                        </div>
                    </div>

                    <!-- SECTION 1: QUALIFYING ENTITIES / CAUSES (ANY OR LOGIC) -->
                    <div class="card border-0 shadow-sm rounded-4 p-3 bg-white mb-4">
                        <div class="d-flex justify-content-between align-items-center mb-2 pb-2 border-bottom flex-wrap gap-2">
                            <div>
                                <h6 class="fw-bold text-dark mb-0 d-flex align-items-center gap-2">
                                    <span class="badge bg-primary text-white rounded-circle p-1" style="width: 24px; height: 24px; display: inline-flex; align-items: center; justify-content: center;">1</span>
                                    <span>Section 1: Qualifying Entity or Cause (Categories)</span>
                                </h6>
                                <small class="text-muted">Applicant must answer YES to at least the required minimum number of categories below.</small>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <div class="d-flex align-items-center gap-1">
                                    <span class="small fw-bold text-muted">Min YES Required:</span>
                                    <input type="number" class="form-control form-control-sm text-center fw-bold" style="width: 60px;" min="1" max="10" @bind="qConfig.Section1MinRequiredYes" />
                                </div>
                                <button type="button" class="btn btn-sm btn-outline-primary fw-semibold" @onclick="() => AddQuestionToSection(qConfig.Section1Questions)">
                                    <i class="bi bi-plus-circle me-1"></i>Add Category Question
                                </button>
                            </div>
                        </div>

                        <div class="row g-2 mb-3">
                            <div class="col-md-6">
                                <label class="form-label small text-muted mb-1">Section 1 Header Title</label>
                                <input type="text" class="form-control form-control-sm" @bind="qConfig.Section1Title" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small text-muted mb-1">Section 1 Subtitle / Instruction</label>
                                <input type="text" class="form-control form-control-sm" @bind="qConfig.Section1Subtitle" />
                            </div>
                        </div>

                        <div class="d-flex flex-column gap-3">
                            @if (qConfig.Section1Questions.Count == 0)
                            {
                                <div class="p-3 text-center rounded-3 bg-light border text-muted small">
                                    No category questions configured. Click "Add Category Question" to create one.
                                </div>
                            }
                            @for (int i = 0; i < qConfig.Section1Questions.Count; i++)
                            {
                                var q = qConfig.Section1Questions[i];
                                var idx = i;
                                <div class="p-3 rounded-3 border @(q.IsActive ? "bg-light" : "bg-light opacity-75 border-secondary-subtle")">
                                    <div class="d-flex justify-content-between align-items-center mb-2 flex-wrap gap-2">
                                        <div class="d-flex align-items-center gap-2 flex-grow-1 me-2">
                                            <span class="badge bg-secondary text-white rounded-pill px-2">#@(idx + 1)</span>
                                            <input type="text" class="form-control form-control-sm fw-bold" placeholder="Category Title (e.g. Registered Non-Profit / Civic Entity)" @bind="q.Title" />
                                        </div>
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="form-check form-switch mb-0">
                                                <input class="form-check-input" type="checkbox" role="switch" id="@($"q1_sw_{q.Id}")" @bind="q.IsActive" />
                                                <label class="form-check-label small fw-semibold text-dark" for="@($"q1_sw_{q.Id}")">
                                                    @(q.IsActive ? "Active" : "Disabled")
                                                </label>
                                            </div>
                                            <button type="button" class="btn btn-outline-danger btn-sm rounded-circle p-1" style="width: 28px; height: 28px;" title="Delete Question" @onclick="() => qConfig.Section1Questions.Remove(q)">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </div>
                                    </div>
                                    <div class="row g-2">
                                        <div class="col-md-7">
                                            <label class="form-label small text-muted mb-0">Description / Criteria Explanation</label>
                                            <textarea class="form-control form-control-sm" rows="2" placeholder="Explain what constitutes qualification for this category..." @bind="q.Description"></textarea>
                                        </div>
                                        <div class="col-md-5">
                                            <label class="form-label small text-muted mb-0">Required Attachment / Proof Note</label>
                                            <textarea class="form-control form-control-sm" rows="2" placeholder="e.g. Attach: IRS Determination Letter or state non-profit certificate." @bind="q.RequiredAttachmentNote"></textarea>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- SECTION 2: INTEGRITY & TERMS CRITERIA (ALL YES LOGIC) -->
                    <div class="card border-0 shadow-sm rounded-4 p-3 bg-white mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-2 pb-2 border-bottom flex-wrap gap-2">
                            <div>
                                <h6 class="fw-bold text-dark mb-0 d-flex align-items-center gap-2">
                                    <span class="badge bg-success text-white rounded-circle p-1" style="width: 24px; height: 24px; display: inline-flex; align-items: center; justify-content: center;">2</span>
                                    <span>Section 2: Event Integrity &amp; Terms (Mandatory Criteria)</span>
                                </h6>
                                <small class="text-muted">Applicant must answer <strong class="text-dark">YES to ALL</strong> criteria in this section to qualify.</small>
                            </div>
                            <button type="button" class="btn btn-sm btn-outline-success fw-semibold" @onclick="() => AddQuestionToSection(qConfig.Section2Questions)">
                                <i class="bi bi-plus-circle me-1"></i>Add Term / Integrity Criterion
                            </button>
                        </div>

                        <div class="row g-2 mb-3">
                            <div class="col-md-6">
                                <label class="form-label small text-muted mb-1">Section 2 Header Title</label>
                                <input type="text" class="form-control form-control-sm" @bind="qConfig.Section2Title" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small text-muted mb-1">Section 2 Subtitle / Instruction</label>
                                <input type="text" class="form-control form-control-sm" @bind="qConfig.Section2Subtitle" />
                            </div>
                        </div>

                        <div class="d-flex flex-column gap-3">
                            @if (qConfig.Section2Questions.Count == 0)
                            {
                                <div class="p-3 text-center rounded-3 bg-light border text-muted small">
                                    No integrity terms configured. Click "Add Term / Integrity Criterion" to create one.
                                </div>
                            }
                            @for (int i = 0; i < qConfig.Section2Questions.Count; i++)
                            {
                                var q = qConfig.Section2Questions[i];
                                var idx = i;
                                <div class="p-3 rounded-3 border @(q.IsActive ? "bg-light" : "bg-light opacity-75 border-secondary-subtle")">
                                    <div class="d-flex justify-content-between align-items-center mb-2 flex-wrap gap-2">
                                        <div class="d-flex align-items-center gap-2 flex-grow-1 me-2">
                                            <span class="badge bg-secondary text-white rounded-pill px-2">#@(idx + 1)</span>
                                            <input type="text" class="form-control form-control-sm fw-bold" placeholder="Criterion Title (e.g. Dedicated Purpose, No Private Profit)" @bind="q.Title" />
                                        </div>
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="form-check form-switch mb-0">
                                                <input class="form-check-input" type="checkbox" role="switch" id="@($"q2_sw_{q.Id}")" @bind="q.IsActive" />
                                                <label class="form-check-label small fw-semibold text-dark" for="@($"q2_sw_{q.Id}")">
                                                    @(q.IsActive ? "Active" : "Disabled")
                                                </label>
                                            </div>
                                            <button type="button" class="btn btn-outline-danger btn-sm rounded-circle p-1" style="width: 28px; height: 28px;" title="Delete Criterion" @onclick="() => qConfig.Section2Questions.Remove(q)">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </div>
                                    </div>
                                    <div class="row g-2">
                                        <div class="col-12">
                                            <label class="form-label small text-muted mb-0">Criterion Description &amp; Agreement Terms</label>
                                            <textarea class="form-control form-control-sm" rows="2" placeholder="Specify the integrity rule or compliance requirement..." @bind="q.Description"></textarea>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-white border-top p-3 px-4 d-flex justify-content-between">
                    <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill px-4" @onclick="() => _showQualificationEditorModal = false">
                        Done Editing
                    </button>
                    <button type="button" class="btn btn-primary btn-sm rounded-pill px-4 shadow-sm fw-bold" @onclick="() => _showQualificationEditorModal = false">
                        <i class="bi bi-check2-circle me-1"></i>Apply &amp; Return to Matrix
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@* ========================================================================= *@
@* MODAL: OCCASION / EVENT TYPE LISTS MANAGER *@
@* ========================================================================= *@
@if (_showEventListsModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(15, 23, 42, 0.65); backdrop-filter: blur(4px); z-index: 1060;" role="dialog">
        <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="modal-header bg-gradient bg-primary text-white p-4">
                    <div>
                        <h5 class="modal-title fw-bold mb-1 d-flex align-items-center gap-2">
                            <i class="bi bi-collection-fill"></i>
                            <span>Manage Occasion &amp; Event Type Lists</span>
                        </h5>
                        <p class="small text-white-50 mb-0">Create customized occasion dropdown lists (e.g. Standard Celebrations, Non-Profit Causes) and assign them to specific pricing matrix tiers.</p>
                    </div>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => _showEventListsModal = false"></button>
                </div>
                <div class="modal-body p-4 bg-light" style="max-height: 75vh;">
                    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                        <div class="small text-muted">
                            <strong>@_editableEventTypeLists.Count</strong> list preset@(_editableEventTypeLists.Count == 1 ? "" : "s") configured. Select a list to edit its occasion options.
                        </div>
                        <div class="d-flex gap-2">
                            <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-3" @onclick="ResetEventListsToDefault">
                                <i class="bi bi-arrow-counterclockwise me-1"></i>Reset to System Defaults
                            </button>
                            <button type="button" class="btn btn-sm btn-primary rounded-pill px-3 shadow-sm fw-bold" @onclick="AddNewEventTypeList">
                                <i class="bi bi-plus-lg me-1"></i>Create New List Preset
                            </button>
                        </div>
                    </div>

                    <div class="row g-4">
                        <!-- Left column: Lists navigator -->
                        <div class="col-md-4">
                            <div class="card border rounded-3 p-2 bg-white shadow-sm h-100">
                                <div class="list-group list-group-flush">
                                    @foreach (var list in _editableEventTypeLists)
                                    {
                                        var isSelected = _selectedEventListId == list.Id;
                                        <button type="button" class="list-group-item list-group-item-action p-3 rounded-3 mb-2 border @(isSelected ? "border-primary bg-primary bg-opacity-10 shadow-sm" : "bg-light border-light")"
                                                @onclick="() => SelectEventListForEdit(list.Id)">
                                            <div class="d-flex justify-content-between align-items-start mb-1">
                                                <span class="fw-bold @(isSelected ? "text-primary" : "text-dark")" style="font-size: 0.9rem;">
                                                    @list.Name
                                                </span>
                                                @if (list.IsDefault)
                                                {
                                                    <span class="badge bg-primary rounded-pill" style="font-size: 0.65rem;">Default</span>
                                                }
                                            </div>
                                            <div class="small text-muted text-truncate mb-2" style="font-size: 0.75rem;">
                                                @(string.IsNullOrWhiteSpace(list.Description) ? "No description provided" : list.Description)
                                            </div>
                                            <div class="d-flex justify-content-between align-items-center">
                                                <span class="badge bg-white text-secondary border fw-normal" style="font-size: 0.7rem;">
                                                    <i class="bi bi-check2-square text-success me-1"></i>@list.Options.Count options
                                                </span>
                                                @if (!list.IsDefault && _editableEventTypeLists.Count > 1)
                                                {
                                                    <button type="button" class="btn btn-link text-danger p-0 small text-decoration-none" title="Delete list" @onclick:stopPropagation="true" @onclick="() => DeleteEventTypeList(list)">
                                                        <i class="bi bi-trash small"></i> Delete
                                                    </button>
                                                }
                                            </div>
                                        </button>
                                    }
                                </div>
                            </div>
                        </div>

                        <!-- Right column: Active List Details & Options Manager -->
                        <div class="col-md-8">
                            @{
                                var activeList = _editableEventTypeLists.FirstOrDefault(l => l.Id == _selectedEventListId) ?? _editableEventTypeLists.FirstOrDefault();
                            }
                            @if (activeList != null)
                            {
                                <div class="card border rounded-3 p-4 bg-white shadow-sm">
                                    <div class="row g-3 mb-4 pb-3 border-bottom">
                                        <div class="col-md-7">
                                            <label class="form-label small fw-bold text-dark mb-1">List Preset Name</label>
                                            <input type="text" class="form-control fw-bold" @bind="activeList.Name" placeholder="e.g. Standard Celebrations" />
                                        </div>
                                        <div class="col-md-5 d-flex flex-column justify-content-end">
                                            <div class="form-check form-switch mb-2">
                                                <input class="form-check-input" type="checkbox" role="switch" id="@($"sw_deflist_{activeList.Id}")" 
                                                       checked="@activeList.IsDefault" 
                                                       @onchange="(e) => SetAsDefaultEventList(activeList, (bool)(e.Value ?? false))" />
                                                <label class="form-check-label small fw-semibold text-dark" for="@($"sw_deflist_{activeList.Id}")">
                                                    Default List for Unassigned Tiers
                                                </label>
                                            </div>
                                        </div>
                                        <div class="col-12">
                                            <label class="form-label small fw-bold text-dark mb-1">Description / Audience Context</label>
                                            <input type="text" class="form-control form-control-sm text-secondary" @bind="activeList.Description" placeholder="e.g. For general celebrations, birthdays, weddings, reunions" />
                                        </div>
                                    </div>

                                    <!-- Add New Option Input -->
                                    <div class="mb-3">
                                        <label class="form-label small fw-bold text-dark mb-1 d-flex justify-content-between">
                                            <span><i class="bi bi-plus-circle text-primary me-1"></i>Add Event Type / Occasion Option</span>
                                            <span class="badge bg-light text-secondary border fw-normal">@activeList.Options.Count total items</span>
                                        </label>
                                        <div class="input-group">
                                            <input type="text" class="form-control" placeholder="Type occasion name and press Add or Enter (e.g. Charity Gala / Annual Fundraiser)..." 
                                                   @bind="_newEventOptionText" 
                                                   @bind:event="oninput"
                                                   @onkeydown="(e) => HandleNewOptionKeyDown(e, activeList)" />
                                            <button type="button" class="btn btn-primary px-4 fw-semibold" @onclick="() => AddOptionToEventList(activeList)">
                                                <i class="bi bi-plus-lg me-1"></i>Add Option
                                            </button>
                                        </div>
                                    </div>

                                    <!-- Options List (Drag/Move & Remove) -->
                                    <div class="border rounded-3 p-2 bg-light" style="max-height: 380px; overflow-y: auto;">
                                        @if (activeList.Options.Count == 0)
                                        {
                                            <div class="p-4 text-center text-muted small">
                                                <i class="bi bi-inbox fs-3 d-block mb-1"></i>
                                                No occasion options in this list yet. Add some above.
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="d-flex flex-column gap-2">
                                                @for (int i = 0; i < activeList.Options.Count; i++)
                                                {
                                                    var optIdx = i;
                                                    var optVal = activeList.Options[optIdx];
                                                    <div class="d-flex align-items-center gap-2 p-2 bg-white rounded-3 border shadow-xs">
                                                        <span class="badge bg-light text-muted border rounded-pill px-2" style="font-size: 0.72rem; min-width: 28px;">
                                                            @(optIdx + 1)
                                                        </span>
                                                        <input type="text" class="form-control form-control-sm border-0 flex-grow-1 fw-semibold text-dark" 
                                                               value="@optVal" 
                                                               @onchange="(e) => UpdateOptionInEventList(activeList, optIdx, e.Value?.ToString())" />
                                                        
                                                        <div class="d-flex gap-1">
                                                            <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-1" title="Move Up" 
                                                                    disabled="@(optIdx == 0)" 
                                                                    @onclick="() => MoveOptionInEventList(activeList, optIdx, -1)">
                                                                <i class="bi bi-chevron-up"></i>
                                                            </button>
                                                            <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-1" title="Move Down" 
                                                                    disabled="@(optIdx == activeList.Options.Count - 1)" 
                                                                    @onclick="() => MoveOptionInEventList(activeList, optIdx, 1)">
                                                                <i class="bi bi-chevron-down"></i>
                                                            </button>
                                                            <button type="button" class="btn btn-sm btn-outline-danger py-0 px-2" title="Remove option" 
                                                                    @onclick="() => RemoveOptionFromEventList(activeList, optIdx)">
                                                                <i class="bi bi-x-lg"></i>
                                                            </button>
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-white border-top p-3 px-4 d-flex justify-content-between">
                    <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill px-4" @onclick="() => _showEventListsModal = false">
                        Done Editing
                    </button>
                    <button type="button" class="btn btn-primary btn-sm rounded-pill px-4 shadow-sm fw-bold" @onclick="() => _showEventListsModal = false">
                        <i class="bi bi-check2-circle me-1"></i>Apply &amp; Return
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [SupplyParameterFromQuery(Name = "tab")]
    public string? UrlTab { get; set; }

    private bool _hasPageAccess = true;
    private bool _isAdmin = false;
    private bool _isLoading = true;
    private bool _isSaving = false;

    // Unsaved Changes Tracking & Navigation Guard
    private string? _initialSnapshot;
    private bool _showUnsavedChangesModal = false;
    private string? _pendingNavigationTarget;
    private bool _forceNavigate = false;

    private bool HasUnsavedChanges => !_isLoading && _initialSnapshot != null && _initialSnapshot != GenerateStateSnapshot();

    private string GenerateStateSnapshot()
    {
        try
        {
            var data = new
            {
                Settings = _settings,
                Web = _webSettings != null ? System.Text.Json.JsonSerializer.Serialize(_webSettings) : null,
                Rooms = _editableRooms,
                Addons = _editableAddons,
                Schedules = _editableDaySchedules,
                Policies = _editablePolicies,
                Recipients = _editableRecipients,
                TierCards = _editableTierCards,
                ReasonPresets = _editableReasonPresets,
                MonthFields = _editableMonthFields,
                ListColumns = _editableListColumns,
                EventTypeLists = _editableEventTypeLists
            };
            return System.Text.Json.JsonSerializer.Serialize(data);
        }
        catch
        {
            return string.Empty;
        }
    }

    private void OnBeforeInternalNavigation(Microsoft.AspNetCore.Components.Routing.LocationChangingContext context)
    {
        if (_forceNavigate)
        {
            return;
        }

        if (HasUnsavedChanges)
        {
            context.PreventNavigation();
            _pendingNavigationTarget = context.TargetLocation;
            _showUnsavedChangesModal = true;
            StateHasChanged();
        }
    }

    private void StayAndKeepEditing()
    {
        _showUnsavedChangesModal = false;
        _pendingNavigationTarget = null;
    }

    private void DiscardChangesAndLeave()
    {
        _showUnsavedChangesModal = false;
        _forceNavigate = true;
        var target = _pendingNavigationTarget ?? "/hall-rentals";
        _pendingNavigationTarget = null;
        Navigation.NavigateTo(target);
    }

    private async Task SaveAndLeaveAsync()
    {
        var saved = await SaveAllSettingsInternalAsync();
        if (saved)
        {
            _showUnsavedChangesModal = false;
            _forceNavigate = true;
            var target = _pendingNavigationTarget ?? "/hall-rentals";
            _pendingNavigationTarget = null;
            Navigation.NavigateTo(target);
        }
    }

    private string _activeTab = "pricing";
    private string _previewDevice = "desktop";
    private string? _feedbackMessage;
    private bool _feedbackSuccess = true;

    private void SelectTab(string tab)
    {
        _activeTab = tab;
        StateHasChanged();
    }

