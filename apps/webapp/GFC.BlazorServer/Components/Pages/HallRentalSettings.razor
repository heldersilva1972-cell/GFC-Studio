                                                    <button type="button" class="btn btn-sm rounded-pill flex-fill py-1 px-2 @(_webSettings.RequireAlternateDate ? "btn-primary fw-bold shadow-sm" : "btn-light text-muted border-0")" @onclick="() => _webSettings.RequireAlternateDate = true">Required</button>
                                                    <button type="button" class="btn btn-sm rounded-pill flex-fill py-1 px-2 @(!_webSettings.RequireAlternateDate ? "btn-dark fw-bold shadow-sm" : "btn-light text-muted border-0")" @onclick="() => _webSettings.RequireAlternateDate = false">Optional</button>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>

                            <!-- Embed Widget Box -->
                            <div class="card border rounded-4 p-4 shadow-sm bg-light">
