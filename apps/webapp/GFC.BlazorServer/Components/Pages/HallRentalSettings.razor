                                                        <input class="form-check-input" type="checkbox" id="modalBookToggle" @bind="_calendarSettings.ShowModalBookButton" />
                                                        <label class="form-check-label small text-dark" style="font-size:0.75rem;" for="modalBookToggle">Show Modal "Book" Button</label>
                                                    </div>
                                                    <div class="form-check form-switch mb-0">
                                                        <input class="form-check-input" type="checkbox" id="modalQuestionToggle" @bind="_calendarSettings.ShowModalQuestionButton" />
                                                        <label class="form-check-label small text-dark" style="font-size:0.75rem;" for="modalQuestionToggle">Show Modal "Ask Question" Button</label>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>

                                    <!-- Mobile Phone Engine -->
                                    <div class="p-2.5 bg-light rounded-2 border">
                                        <label class="form-label small fw-bold text-dark mb-1 d-block" style="font-size:0.78rem;">
                                            <i class="bi bi-phone me-1"></i>Mobile Display Engine
                                        </label>
                                        <div class="d-flex p-1 bg-white rounded-pill border mb-2">
                                            <button type="button" class="btn btn-sm rounded-pill flex-fill py-1 px-2 @(_calendarSettings.MobileDisplayMode == "drawer" ? "btn-primary fw-bold" : "btn-light text-muted border-0")" style="font-size:0.75rem;" @onclick='() => _calendarSettings.MobileDisplayMode = "drawer"'>
                                                <i class="bi bi-calendar2-day me-1"></i>Mini + Drawer
                                            </button>
                                            <button type="button" class="btn btn-sm rounded-pill flex-fill py-1 px-2 @(_calendarSettings.MobileDisplayMode == "standard" ? "btn-primary fw-bold" : "btn-light text-muted border-0")" style="font-size:0.75rem;" @onclick='() => _calendarSettings.MobileDisplayMode = "standard"'>
                                                <i class="bi bi-grid-3x3 me-1"></i>Standard Grid
                                            </button>
                                        </div>

                                        <div class="form-check form-switch mb-1">
                                            <input class="form-check-input" type="checkbox" id="mobileHomeToggle" @bind="_calendarSettings.ShowMobileHomeButton" />
                                            <label class="form-check-label small text-muted" style="font-size:0.75rem;" for="mobileHomeToggle">Show "GFC Home" Button on Mobile</label>
                                        </div>
                                        <div class="form-check form-switch mb-1">
                                            <input class="form-check-input" type="checkbox" id="mobileBookSlotToggle" @bind="_calendarSettings.MobileShowBookAvailableSlot" />
                                            <label class="form-check-label small text-muted" style="font-size:0.75rem;" for="mobileBookSlotToggle">Show "Book Available Slot" Button</label>
                                        </div>
                                        <div class="form-check form-switch mb-0">
                                            <input class="form-check-input" type="checkbox" id="mobileInqSlotToggle" @bind="_calendarSettings.MobileShowQuestionAvailableSlot" />
                                            <label class="form-check-label small text-muted" style="font-size:0.75rem;" for="mobileInqSlotToggle">Show "Ask Question" Button</label>
                                        </div>
                                    </div>
                                </div>

                                <!-- Card 4: Event Colors & Categorization Theme -->
                                <div class="card border rounded-3 p-3 shadow-sm bg-white">
                                    <div class="d-flex align-items-center justify-content-between mb-2 pb-2 border-bottom">
                                        <span class="fw-bold small text-dark d-flex align-items-center gap-1.5">
                                            <i class="bi bi-palette text-primary"></i> Event Colors &amp; Visual Styling
                                        </span>
                                        <span class="badge bg-light text-muted border" style="font-size:0.7rem;">Color Palettes</span>
                                    </div>

                                    <!-- 10 Curated Pre-defined Color Combination Themes -->
                                    <div class="p-2.5 bg-light rounded-2 border mb-2.5">
                                        <div class="d-flex align-items-center justify-content-between mb-1.5">
                                            <label class="form-label small fw-bold text-dark mb-0 d-flex align-items-center gap-1.5" style="font-size:0.78rem;">
                                                <i class="bi bi-stars text-warning"></i> Curated Color Combinations (10 Themes)
                                            </label>
                                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle" style="font-size:0.65rem;">1-Click Apply</span>
                                        </div>
                                        <small class="text-muted d-block mb-2" style="font-size:0.70rem; line-height:1.3;">
                                            Select a professionally harmonized palette crafted specifically for clean contrast and legibility on the calendar grid.
                                        </small>

                                        <div class="d-flex flex-column gap-1.5" style="max-height: 220px; overflow-y: auto; padding-right: 2px;">
                                            @foreach (var preset in GFC.BlazorServer.Models.CalendarSettings.GetDefaultColorPresets())
                                            {
                                                bool isCurrentMatch = string.Equals(_calendarSettings.PrimaryColor, preset.PrimaryColor, StringComparison.OrdinalIgnoreCase) &&
                                                                      string.Equals(_calendarSettings.ClubEventColor, preset.ClubColor, StringComparison.OrdinalIgnoreCase) &&
                                                                      string.Equals(_calendarSettings.SecondarySpaceEventColor, preset.SecondaryColor, StringComparison.OrdinalIgnoreCase);

                                                <button type="button" 
                                                        class="btn btn-sm text-start p-1.5 rounded-2 d-flex align-items-center justify-content-between gap-2 border @(isCurrentMatch ? "border-primary bg-white shadow-sm ring-1 ring-primary" : "bg-white border-light-subtle hover-bg-light")"
                                                        style="transition: all 0.15s ease;"
                                                        @onclick="() => ApplyColorPreset(preset)">
                                                    <div class="min-w-0 flex-grow-1">
                                                        <div class="d-flex align-items-center gap-1.5 mb-0.5">
                                                            <span class="fw-bold text-dark text-truncate" style="font-size:0.75rem;">@preset.Name</span>
                                                            @if (isCurrentMatch)
                                                            {
                                                                <span class="badge bg-success text-white py-0 px-1" style="font-size:0.62rem;"><i class="bi bi-check2"></i> Active</span>
                                                            }
                                                        </div>
                                                        <div class="text-muted text-truncate" style="font-size:0.67rem; line-height:1.2;">@preset.Description</div>
                                                    </div>

                                                    <!-- Visual Tri-Color Swatch Pill -->
                                                    <div class="d-flex align-items-center gap-1 flex-shrink-0 p-1 bg-light rounded-pill border" title="Standard Rentals / Club Functions / Meeting Rooms">
                                                        <span class="rounded-circle d-inline-block border shadow-xs" style="width:13px; height:13px; background-color:@preset.PrimaryColor;"></span>
                                                        <span class="rounded-circle d-inline-block border shadow-xs" style="width:13px; height:13px; background-color:@preset.ClubColor;"></span>
                                                        <span class="rounded-circle d-inline-block border shadow-xs" style="width:13px; height:13px; background-color:@preset.SecondaryColor;"></span>
                                                    </div>
                                                </button>
                                            }
                                        </div>
                                    </div>

                                    <!-- Custom Color Adjustments -->
                                    <!-- Standard Rental Events Color -->
                                    <div class="p-2.5 bg-light rounded-2 border mb-2.5">
                                        <div class="d-flex align-items-center justify-content-between mb-1">
                                            <label class="form-label small fw-bold text-dark mb-0 d-block" style="font-size:0.78rem;">
                                                <i class="bi bi-calendar-event me-1"></i>Standard Rental Events
                                            </label>
                                            <span class="badge bg-white text-muted border" style="font-size:0.65rem;">Rentals</span>
                                        </div>

                                        <!-- Quick Color Swatches -->
                                        <div class="d-flex align-items-center gap-1.5 flex-wrap mb-2 p-1.5 bg-white rounded-2 border">
                                            @foreach (var sw in GFC.BlazorServer.Models.CalendarSettings.GetStandardRentalSwatches())
                                            {
                                                bool isSel = string.Equals(_calendarSettings.PrimaryColor, sw.BackgroundColor, StringComparison.OrdinalIgnoreCase);
                                                <button type="button" 
                                                        class="rounded-circle border @(isSel ? "border-dark shadow-sm ring-2 ring-primary" : "border-light-subtle")" 
                                                        style="width:20px; height:20px; background-color:@sw.BackgroundColor; cursor:pointer; padding:0; outline:none;" 
                                                        title="@sw.Name (@sw.BackgroundColor)"
                                                        @onclick="() => { _calendarSettings.PrimaryColor = sw.BackgroundColor; _calendarSettings.TextColor = sw.TextColor; }"></button>
                                            }
                                        </div>

                                        <div class="row g-2">
                                            <div class="col-6">
                                                <label class="form-label text-muted mb-1" style="font-size:0.70rem;">Background</label>
                                                <div class="d-flex align-items-center gap-1.5">
                                                    <input type="color" class="form-control form-control-color form-control-sm p-0 border" style="width:34px; height:28px;" @bind="_calendarSettings.PrimaryColor" @bind:event="oninput" />
                                                    <input type="text" class="form-control form-control-sm font-monospace" style="font-size:0.72rem; padding: 2px 6px;" @bind="_calendarSettings.PrimaryColor" @bind:event="oninput" />
                                                </div>
                                            </div>
                                            <div class="col-6">
                                                <label class="form-label text-muted mb-1" style="font-size:0.70rem;">Text Color</label>
                                                <div class="d-flex align-items-center gap-1.5">
                                                    <input type="color" class="form-control form-control-color form-control-sm p-0 border" style="width:34px; height:28px;" @bind="_calendarSettings.TextColor" @bind:event="oninput" />
                                                    <input type="text" class="form-control form-control-sm font-monospace" style="font-size:0.72rem; padding: 2px 6px;" @bind="_calendarSettings.TextColor" @bind:event="oninput" />
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Internal Club Events & Secondary Spaces Color Coding Toggle -->
                                    <div class="p-2.5 bg-light rounded-2 border">
                                        <div class="form-check form-switch mb-1.5">
                                            <input class="form-check-input" type="checkbox" id="colorCodeClubToggle" @bind="_calendarSettings.ColorCodeClubEvents" />
                                            <label class="form-check-label small fw-bold text-dark" style="font-size:0.78rem;" for="colorCodeClubToggle">
                                                Color-Code Internal Club Events &amp; Meetings
                                            </label>
                                        </div>
                                        <small class="text-muted d-block mb-2" style="font-size:0.70rem; line-height:1.3;">
                                            When enabled, internal club functions and office meetings render with distinct custom colors instead of standard rental gold.
                                        </small>

                                        @if (_calendarSettings.ColorCodeClubEvents)
                                        {
                                            <div class="d-flex flex-column gap-2 pt-1">
                                                <!-- Club Events (Function Hall) -->
                                                <div class="bg-white p-2.5 rounded-2 border">
                                                    <div class="d-flex align-items-center justify-content-between mb-1.5">
                                                        <span class="badge rounded-pill" style="background:#f3e8ff; color:#6b21a8; font-size:0.70rem; border:1px solid #d8b4fe;">
                                                            <i class="bi bi-star-fill me-1"></i>Club Events (Function Hall)
                                                        </span>
                                                        <small class="text-muted" style="font-size:0.68rem;">10 Color Swatches</small>
                                                    </div>

                                                    <!-- 10 Club Event Presets -->
                                                    <div class="d-flex align-items-center gap-1.5 flex-wrap mb-2 p-1.5 bg-light rounded-2 border">
                                                        @foreach (var sw in GFC.BlazorServer.Models.CalendarSettings.GetClubEventSwatches())
                                                        {
                                                            bool isSel = string.Equals(_calendarSettings.ClubEventColor, sw.BackgroundColor, StringComparison.OrdinalIgnoreCase);
                                                            <button type="button" 
                                                                    class="rounded-circle border @(isSel ? "border-dark shadow-sm ring-2 ring-primary" : "border-light-subtle")" 
                                                                    style="width:20px; height:20px; background-color:@sw.BackgroundColor; cursor:pointer; padding:0; outline:none;" 
                                                                    title="@sw.Name (@sw.BackgroundColor)"
                                                                    @onclick="() => { _calendarSettings.ClubEventColor = sw.BackgroundColor; _calendarSettings.ClubEventTextColor = sw.TextColor; }"></button>
                                                        }
                                                    </div>

                                                    <div class="row g-2 mt-0">
                                                        <div class="col-6">
                                                            <label class="form-label text-muted mb-1" style="font-size:0.70rem;">Background</label>
                                                            <div class="d-flex align-items-center gap-1.5">
                                                                <input type="color" class="form-control form-control-color form-control-sm p-0 border" style="width:34px; height:28px;" @bind="_calendarSettings.ClubEventColor" @bind:event="oninput" />
                                                                <input type="text" class="form-control form-control-sm font-monospace" style="font-size:0.72rem; padding: 2px 6px;" @bind="_calendarSettings.ClubEventColor" @bind:event="oninput" />
                                                            </div>
                                                        </div>
                                                        <div class="col-6">
                                                            <label class="form-label text-muted mb-1" style="font-size:0.70rem;">Text Color</label>
                                                            <div class="d-flex align-items-center gap-1.5">
                                                                <input type="color" class="form-control form-control-color form-control-sm p-0 border" style="width:34px; height:28px;" @bind="_calendarSettings.ClubEventTextColor" @bind:event="oninput" />
                                                                <input type="text" class="form-control form-control-sm font-monospace" style="font-size:0.72rem; padding: 2px 6px;" @bind="_calendarSettings.ClubEventTextColor" @bind:event="oninput" />
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>

                                                <!-- Secondary Space Events (Office / Meeting Room) -->
                                                <div class="bg-white p-2.5 rounded-2 border">
                                                    <div class="d-flex align-items-center justify-content-between mb-1.5">
                                                        <span class="badge rounded-pill" style="background:#e0f2fe; color:#0369a1; font-size:0.70rem; border:1px solid #7dd3fc;">
                                                            <i class="bi bi-building me-1"></i>Secondary Spaces (Office / Meetings)
                                                        </span>
                                                        <small class="text-muted" style="font-size:0.68rem;">10 Color Swatches</small>
                                                    </div>

                                                    <!-- 10 Secondary Space Presets -->
                                                    <div class="d-flex align-items-center gap-1.5 flex-wrap mb-2 p-1.5 bg-light rounded-2 border">
                                                        @foreach (var sw in GFC.BlazorServer.Models.CalendarSettings.GetSecondarySpaceSwatches())
                                                        {
                                                            bool isSel = string.Equals(_calendarSettings.SecondarySpaceEventColor, sw.BackgroundColor, StringComparison.OrdinalIgnoreCase);
                                                            <button type="button" 
                                                                    class="rounded-circle border @(isSel ? "border-dark shadow-sm ring-2 ring-primary" : "border-light-subtle")" 
                                                                    style="width:20px; height:20px; background-color:@sw.BackgroundColor; cursor:pointer; padding:0; outline:none;" 
                                                                    title="@sw.Name (@sw.BackgroundColor)"
                                                                    @onclick="() => { _calendarSettings.SecondarySpaceEventColor = sw.BackgroundColor; _calendarSettings.SecondarySpaceEventTextColor = sw.TextColor; }"></button>
                                                        }
                                                    </div>

                                                    <div class="row g-2 mt-0">
                                                        <div class="col-6">
                                                            <label class="form-label text-muted mb-1" style="font-size:0.70rem;">Background</label>
                                                            <div class="d-flex align-items-center gap-1.5">
                                                                <input type="color" class="form-control form-control-color form-control-sm p-0 border" style="width:34px; height:28px;" @bind="_calendarSettings.SecondarySpaceEventColor" @bind:event="oninput" />
                                                                <input type="text" class="form-control form-control-sm font-monospace" style="font-size:0.72rem; padding: 2px 6px;" @bind="_calendarSettings.SecondarySpaceEventColor" @bind:event="oninput" />
                                                            </div>
                                                        </div>
                                                        <div class="col-6">
                                                            <label class="form-label text-muted mb-1" style="font-size:0.70rem;">Text Color</label>
                                                            <div class="d-flex align-items-center gap-1.5">
                                                                <input type="color" class="form-control form-control-color form-control-sm p-0 border" style="width:34px; height:28px;" @bind="_calendarSettings.SecondarySpaceEventTextColor" @bind:event="oninput" />
                                                                <input type="text" class="form-control form-control-sm font-monospace" style="font-size:0.72rem; padding: 2px 6px;" @bind="_calendarSettings.SecondarySpaceEventTextColor" @bind:event="oninput" />
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>

                            </div>
                        </div>

                        <!-- Right Column: Sticky / Maximized Interactive Live Preview -->
                        <div class="col-xl-7 col-lg-7 col-md-12">
                            <div class="card border rounded-3 p-3 shadow-sm bg-white h-100 d-flex flex-column" style="min-height: 720px;">
                                
                                <!-- Top Preview Toolbar -->
                                <div class="d-flex align-items-center justify-content-between mb-2.5 pb-2 border-bottom flex-wrap gap-2">
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="fw-bold small text-dark d-flex align-items-center gap-1.5">
                                            <i class="bi bi-display text-primary"></i> Live Interactive Preview
                                        </span>
                                        <span class="badge bg-success-subtle text-success border border-success-subtle" style="font-size:0.7rem;">Live Sync</span>
                                    </div>

                                    <div class="d-flex align-items-center gap-2">
                                        <!-- Device Mode Switcher -->
                                        <div class="btn-group btn-group-sm p-0.5 bg-light border rounded-pill" role="group">
                                            <button type="button" class="btn btn-sm rounded-pill px-2.5 py-1 @(_calendarPreviewDeviceMode == "desktop" ? "btn-primary fw-bold shadow-sm" : "btn-light text-muted border-0")" style="font-size:0.75rem;" @onclick='() => { _calendarPreviewDeviceMode = "desktop"; StateHasChanged(); }'>
                                                <i class="bi bi-laptop me-1"></i> Desktop
                                            </button>
                                            <button type="button" class="btn btn-sm rounded-pill px-2.5 py-1 @(_calendarPreviewDeviceMode == "mobile" ? "btn-primary fw-bold shadow-sm" : "btn-light text-muted border-0")" style="font-size:0.75rem;" @onclick='() => { _calendarPreviewDeviceMode = "mobile"; StateHasChanged(); }'>
                                                <i class="bi bi-phone me-1"></i> Phone
                                            </button>
                                        </div>

                                        <!-- Direct Fullscreen Popout for currently viewed device -->
                                        <a href="@(_calendarPreviewDeviceMode == "mobile" ? "/public/calendar?view=mobile" : "/public/calendar")" target="_blank" class="btn btn-sm btn-outline-secondary d-flex align-items-center gap-1.5 py-1 px-2.5" style="font-size:0.75rem;" title="Open currently selected view in full screen interactive window">
                                            <i class="bi bi-box-arrow-up-right"></i>
                                            <span class="d-none d-sm-inline">Popout</span>
                                        </a>

                                        <!-- Sync Events Button -->
                                        <button type="button" class="btn btn-sm btn-outline-secondary d-flex align-items-center gap-1.5 py-1 px-2.5" style="font-size:0.75rem;" @onclick="RefreshGoogleEvents" disabled="@_isRefreshingEvents">
                                            @if (_isRefreshingEvents)
                                            {
                                                <span class="spinner-border spinner-border-sm" style="width: 0.8rem; height: 0.8rem;"></span>
                                                <span>Syncing...</span>
                                            }
                                            else
                                            {
                                                <i class="bi bi-arrow-clockwise"></i>
                                                <span>Sync Events</span>
                                            }
                                        </button>
                                    </div>
                                </div>

                                <!-- Preview Content Canvas -->
                                <div class="flex-grow-1 d-flex flex-column">
                                    @if (_calendarPreviewDeviceMode == "mobile")
                                    {
                                        <!-- Realistic Smartphone Preview Container (Using Isolated IFrame Engine) -->
                                        <div class="d-flex justify-content-center align-items-center py-2 bg-light rounded-3 border flex-grow-1" style="min-height: 640px;">
                                            <div class="gfc-mobile-simulator-frame shadow-lg" style="width: 360px; max-width: 100%; border: 10px solid #2d3748; border-radius: 36px; overflow: hidden; background: #ffffff; box-shadow: 0 14px 36px rgba(0,0,0,0.18);">
                                                <!-- Phone Top Notch / Speaker -->
                                                <div class="d-flex justify-content-center align-items-center py-1.5 bg-dark text-white" style="border-bottom: 1px solid #1a202c;">
                                                    <div style="width: 50px; height: 4px; background: #718096; border-radius: 4px;"></div>
                                                </div>

                                                <!-- Simulated Mobile Screen Content (Real Public View) -->
                                                <div style="height: 580px; width: 100%; overflow: hidden; background: #ffffff;">
                                                    <iframe src="/public/calendar" style="width: 100%; height: 100%; border: none;"></iframe>
                                                </div>

