    // =========================================================================
    // GFC CONNECT MOBILE PUSH ALERTS & FIREBASE BACKING METHODS
    // =========================================================================
    private bool _firebaseConfigured = false;
    private string? _firebaseProjectId;
    private string? _firebaseClientEmail;
    private string? _pastedFirebaseJson;
    private bool _isUploadingFirebase = false;
    private bool _isSendingPushTest = false;
    private string? _firebaseTestResult;
    private bool _firebaseTestSuccess = false;

    private void CheckFirebaseStatus()
    {
        try
        {
            var credentialsPath = Path.Combine(WebHostEnvironment.ContentRootPath, "App_Data", "firebase-adminsdk.json");
            if (!File.Exists(credentialsPath))
            {
                var fallbackPath = Path.Combine(WebHostEnvironment.ContentRootPath, "App_Data", "service-account.json");
                if (File.Exists(fallbackPath)) credentialsPath = fallbackPath;
            }

            if (File.Exists(credentialsPath))
            {
                var json = File.ReadAllText(credentialsPath);
                using var doc = System.Text.Json.JsonDocument.Parse(json);
                var root = doc.RootElement;
                _firebaseProjectId = root.TryGetProperty("project_id", out var p) ? p.GetString() : null;
                _firebaseClientEmail = root.TryGetProperty("client_email", out var e) ? e.GetString() : null;
                _firebaseConfigured = !string.IsNullOrWhiteSpace(_firebaseProjectId) && !string.IsNullOrWhiteSpace(_firebaseClientEmail);
            }
            else
            {
                _firebaseConfigured = false;
                _firebaseProjectId = null;
                _firebaseClientEmail = null;
            }
        }
        catch (Exception ex)
        {
            _firebaseConfigured = false;
            System.Diagnostics.Debug.WriteLine($"[FirebaseStatus] Error: {ex.Message}");
        }
    }

    private async Task HandleFirebaseFileUpload(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;

        _isUploadingFirebase = true;
        _firebaseTestResult = null;
        StateHasChanged();

        try
        {
            using var stream = file.OpenReadStream(maxAllowedSize: 1024 * 512);
            using var reader = new StreamReader(stream);
            var content = await reader.ReadToEndAsync();

            await SaveFirebaseJsonContentAsync(content);
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"File upload failed: {ex.Message}");
        }
        finally
        {
            _isUploadingFirebase = false;
            StateHasChanged();
        }
    }

    private async Task SavePastedFirebaseJson()
    {
        if (string.IsNullOrWhiteSpace(_pastedFirebaseJson))
        {
            ToastService.ShowWarning("Please paste your Firebase Service Account JSON first.");
            return;
        }

        try
        {
            await SaveFirebaseJsonContentAsync(_pastedFirebaseJson);
            _pastedFirebaseJson = string.Empty;
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Failed to save JSON: {ex.Message}");
        }
    }

    private async Task SaveFirebaseJsonContentAsync(string jsonContent)
    {
        using var doc = System.Text.Json.JsonDocument.Parse(jsonContent);
        var root = doc.RootElement;

        if (!root.TryGetProperty("project_id", out _) || !root.TryGetProperty("client_email", out _) || !root.TryGetProperty("private_key", out _))
        {
            throw new InvalidOperationException("Invalid Firebase key: JSON must contain 'project_id', 'client_email', and 'private_key'.");
        }

        var appDataDir = Path.Combine(WebHostEnvironment.ContentRootPath, "App_Data");
        if (!Directory.Exists(appDataDir))
        {
            Directory.CreateDirectory(appDataDir);
        }

        var targetPath = Path.Combine(appDataDir, "firebase-adminsdk.json");
        await File.WriteAllTextAsync(targetPath, jsonContent);

        CheckFirebaseStatus();
        ToastService.ShowSuccess($"Firebase credentials active! Project: {_firebaseProjectId}");
    }

    private async Task SendHallRentalTestPush()
    {
        _isSendingPushTest = true;
        _firebaseTestResult = null;
        StateHasChanged();

        try
        {
            var testCount = await FirebaseNotificationService.BroadcastAsync(
                "🔔 Hall Rental Push Test",
                $"Hall Rental test alert sent from GFC Studio at {DateTime.Now:h:mm tt}.",
                new Dictionary<string, string>
                {
                    { "category", "inquiry" },
                    { "action", "hall_rental_test" },
                    { "timestamp", DateTime.UtcNow.ToString("o") }
                }
            );

            if (_firebaseConfigured)
            {
                _firebaseTestSuccess = true;
                _firebaseTestResult = $"Push notification broadcast dispatched to {testCount} registered device(s) via Firebase HTTP v1 API!";
                ToastService.ShowSuccess(_firebaseTestResult);
            }
            else
            {
                _firebaseTestSuccess = false;
                _firebaseTestResult = "Notification queued in Simulated Mode. Upload or paste your firebase-adminsdk.json key above to enable real network delivery to devices.";
                ToastService.ShowWarning(_firebaseTestResult);
            }
        }
        catch (Exception ex)
        {
            _firebaseTestSuccess = false;
            _firebaseTestResult = $"Push test failed: {ex.Message}";
            ToastService.ShowError(_firebaseTestResult);
        }
        finally
        {
            _isSendingPushTest = false;
            StateHasChanged();
        }
    }

    private bool _googleServicesConfigured = false;
    private string? _googleServicesProjectId;
    private bool _isUploadingGoogleServices = false;

    private void CheckGoogleServicesStatus()
    {
        try
        {
            var targetPath = Path.GetFullPath(Path.Combine(WebHostEnvironment.ContentRootPath, "..", "..", "GFC-Connect", "app", "google-services.json"));
            if (File.Exists(targetPath))
            {
                var json = File.ReadAllText(targetPath);
                using var doc = System.Text.Json.JsonDocument.Parse(json);
                if (doc.RootElement.TryGetProperty("project_info", out var pInfo) && pInfo.TryGetProperty("project_id", out var pId))
                {
                    _googleServicesProjectId = pId.GetString();
                    _googleServicesConfigured = !string.IsNullOrWhiteSpace(_googleServicesProjectId) && _googleServicesProjectId != "123456789012";
                }
            }
            else
            {
                _googleServicesConfigured = false;
                _googleServicesProjectId = null;
            }
        }
        catch
        {
            _googleServicesConfigured = false;
            _googleServicesProjectId = null;
        }
    }

    private async Task HandleGoogleServicesFileUpload(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;

        _isUploadingGoogleServices = true;
        StateHasChanged();

        try
        {
            using var stream = file.OpenReadStream(maxAllowedSize: 1024 * 512);
            using var reader = new StreamReader(stream);
            var content = await reader.ReadToEndAsync();

            using var doc = System.Text.Json.JsonDocument.Parse(content);
            if (!doc.RootElement.TryGetProperty("project_info", out _) || !doc.RootElement.TryGetProperty("client", out _))
            {
                throw new InvalidOperationException("Invalid google-services.json: File must be the client configuration file downloaded from Firebase Console.");
            }

            var targetPath = Path.GetFullPath(Path.Combine(WebHostEnvironment.ContentRootPath, "..", "..", "GFC-Connect", "app", "google-services.json"));
            var dir = Path.GetDirectoryName(targetPath);
            if (!string.IsNullOrEmpty(dir) && !Directory.Exists(dir))
            {
                Directory.CreateDirectory(dir);
            }

            await File.WriteAllTextAsync(targetPath, content);
            CheckGoogleServicesStatus();
            ToastService.ShowSuccess("google-services.json installed successfully into GFC Connect mobile app!");
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Failed to install google-services.json: {ex.Message}");
        }
        finally
        {
            _isUploadingGoogleServices = false;
            StateHasChanged();
        }
    }
