                            <span class="d-block mt-1 text-dark" style="font-size:0.82rem;">
                                No. Once embedded, the iframe securely loads live data from GFC Studio in real time. Whenever you edit pricing matrices, questions, cancellation policies, or event rules in GFC Studio and save, your WordPress pages update immediately for external visitors.
                            </span>
                        </div>
                    </div>
                </div>
            }

            @* ========================================================================= *@
            @* TAB: GFC CONNECT MOBILE PUSH ALERTS & FIREBASE SETUP *@
            @* ========================================================================= *@
            @if (string.Equals(_activeTab, "mobile_push", StringComparison.OrdinalIgnoreCase))
            {
                <div class="tab-pane-card animate-fade-in">
                    <!-- Top Status Banner -->
