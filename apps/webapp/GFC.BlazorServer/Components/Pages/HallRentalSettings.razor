    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrWhiteSpace(UrlTab))
        {
            _activeTab = UrlTab.ToLowerInvariant();
        }

        await CheckPermissions();
        if (_hasPageAccess || _isAdmin)
        {
            await LoadSettings();
        }
        _isLoading = false;
    }

    private async Task CheckPermissions()
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            _isAdmin = user.IsInRole("Admin") || user.Identity?.Name?.ToLower() == "admin";

            if (_isAdmin)
            {
                _hasPageAccess = true;
                return;
            }

            var userIdClaim = user.FindFirst("UserId") ?? user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier);
            if (userIdClaim != null && int.TryParse(userIdClaim.Value, out var userId))
            {
                var permissions = UserService.GetUserPagePermissions(userId);
                var allPages = UserService.GetAllPages();
                
                // Allow access if user has direct permission to /hall-rentals/settings OR /hall-rentals
                var settingsPage = allPages.FirstOrDefault(p => p.PageRoute.TrimStart('/').ToLower() == "hall-rentals/settings");
                var hallRentalsPage = allPages.FirstOrDefault(p => p.PageRoute.TrimStart('/').ToLower() == "hall-rentals");

                _hasPageAccess = (settingsPage != null && permissions.Any(p => p.PageId == settingsPage.PageId)) ||
                                 (hallRentalsPage != null && permissions.Any(p => p.PageId == hallRentalsPage.PageId));
            }
        }
        catch
        {
            _hasPageAccess = false;
        }
    }

    private async Task LoadSettings()
    {
        try
        {
            try
            {
                _settings = await CalendarService.GetSettingsAsync();
            }
            catch (Exception cEx)
            {
                _settings = new GoogleCalendarSettings();
                System.Diagnostics.Debug.WriteLine($"Warning: CalendarService.GetSettingsAsync failed: {cEx.Message}");
            }

            try
            {
                _webSettings = await WebsiteSettingsService.GetWebsiteSettingsAsync();
            }
            catch (Exception wEx)
            {
                _webSettings = new WebsiteSettings();
                System.Diagnostics.Debug.WriteLine($"Warning: WebsiteSettingsService.GetWebsiteSettingsAsync failed: {wEx.Message}");
            }

            if (_settings.Feeds.Count == 0 && !string.IsNullOrWhiteSpace(_settings.PublicCalendarUrl))
            {
                _settings.Feeds.Add(new CalendarFeedConfig
                {
                    Name = string.IsNullOrWhiteSpace(_settings.CalendarName) ? "Primary Calendar" : _settings.CalendarName,
                    Url = _settings.PublicCalendarUrl,
                    Color = "#0d6efd",
                    IsEnabled = true
                });
            }

            if (_webSettings != null)
            {
                _editableRooms = _webSettings.GetRoomsList();
                _editableAddons = _webSettings.GetAddonsList();
                _editableDaySchedules = _webSettings.GetDaySchedulesList();
                _editablePolicies = _webSettings.GetPoliciesList();
                _editableRecipients = _webSettings.GetRecipientsList();
                _editableTierCards = _webSettings.GetTierCardsList();
                _editableReasonPresets = _webSettings.GetModificationReasonPresetsList();
                if (_editableRecipients.Count == 0)
                {
                    _editableRecipients.Add("manager@gloucesterfraternityclub.com");
                }

                // If no specific tab was requested in the URL, default to the active engine's tab
                if (string.IsNullOrWhiteSpace(UrlTab) || _activeTab == "pricing" || _activeTab == "matrix_tiers")
                {
                    _activeTab = _webSettings.UseLegacyPricingEngine ? "pricing" : "matrix_tiers";
                }
            }

            RecalculateManualTestQuote();
            _initialSnapshot = GenerateStateSnapshot();
        }
        catch (Exception ex)
        {
            _feedbackMessage = $"Error loading settings: {ex.Message}";
            _feedbackSuccess = false;
        }
        finally
        {
            _isLoading = false;
        }
    }

