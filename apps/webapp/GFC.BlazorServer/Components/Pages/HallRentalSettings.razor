                                                            <label class="form-check-label text-muted" for="modalTitleToggle">Title</label>
                                                        </div>
                                                    </div>
                                                    <div class="col-6">
                                                        <div class="form-check form-switch mb-0">
                                                            <input class="form-check-input" type="checkbox" id="modalStatusToggle" @bind="_calendarSettings.ShowModalStatus" />
                                                            <label class="form-check-label text-muted" for="modalStatusToggle">Status</label>
                                                        </div>
                                                    </div>
                                                    <div class="col-6">
                                                        <div class="form-check form-switch mb-0">
                                                            <input class="form-check-input" type="checkbox" id="modalTimeToggle" @bind="_calendarSettings.ShowModalTime" />
                                                            <label class="form-check-label text-muted" for="modalTimeToggle">Time</label>
                                                        </div>
                                                    </div>
                                                    <div class="col-6">
                                                        <div class="form-check form-switch mb-0">
                                                            <input class="form-check-input" type="checkbox" id="modalLocToggle" @bind="_calendarSettings.ShowModalLocation" />
                                                            <label class="form-check-label text-muted" for="modalLocToggle">Location</label>
                                                        </div>
                                                    </div>
                                                    <div class="col-6">
                                                        <div class="form-check form-switch mb-0">
                                                            <input class="form-check-input" type="checkbox" id="modalDescToggle" @bind="_calendarSettings.ShowModalDescription" />
                                                            <label class="form-check-label text-muted" for="modalDescToggle">Details/Notes</label>
                                                        </div>
                                                    </div>
                                                    <div class="col-6">
                                                        <div class="form-check form-switch mb-0">
                                                            <input class="form-check-input" type="checkbox" id="modalSourceToggle" @bind="_calendarSettings.ShowModalSource" />
                                                            <label class="form-check-label text-muted" for="modalSourceToggle">Source</label>
                                                        </div>
                                                    </div>
                                                </div>

                                                <!-- Modal Buttons -->
                                                <div class="mt-2 pt-2 border-top">
