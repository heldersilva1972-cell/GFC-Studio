                            <div class="flex-grow-1">
                                <div class="d-flex align-items-center gap-3">
                                    <i class="bi @(_webSettings.EnableSandboxMode ? "bi-shield-fill-check text-warning fs-1" : "bi-shield-x text-secondary fs-1")"></i>
                                    <div>
                                        <h4 class="fw-bold mb-0 text-dark">Sandbox &amp; Test Mode Master Switch</h4>
                                        @if (_webSettings.EnableSandboxMode)
                                        {
                                            <span class="badge bg-warning text-dark px-3 py-1 fs-6 shadow-sm mt-1 fw-bold"><i class="bi bi-shield-lock-fill me-1"></i>SANDBOX ACTIVE &mdash; SAFETY SHIELD ON</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary px-3 py-1 fs-6 mt-1"><i class="bi bi-broadcast me-1"></i>LIVE PRODUCTION MODE</span>
                                        }
                                    </div>
                                </div>
                                <p class="small text-muted mb-0 mt-3">
                                    @if (_webSettings.EnableSandboxMode)
                                    {
                                        <span class="text-dark"><strong>Safety Shield Engaged:</strong> All test rental requests (from manual tests, presets, or public forms) are isolated. Real customers are not contacted, and events are pushed only to your designated <strong>Test Google Calendar</strong>.</span>
                                    }
                                    else
                                    {
                                        <span>Toggle this switch <strong>ON</strong> to safely test submissions, quotes, email routing, and Google Calendar pushes in a secure sandbox without affecting real customers.</span>
                                    }
                                </p>
                            </div>
                            <div class="form-check form-switch form-switch-lg text-end ps-0" style="min-width: 120px;">
                                <div class="d-flex flex-column align-items-end">
                                    <input class="form-check-input ms-0" type="checkbox" role="switch" id="sandboxMasterToggle" style="width: 4rem; height: 2.2rem; cursor: pointer;" @bind="_webSettings.EnableSandboxMode" />
                                    <label class="small fw-bold text-dark mt-2 text-nowrap" for="sandboxMasterToggle">@(_webSettings.EnableSandboxMode ? "Sandbox ON" : "Sandbox OFF")</label>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- TEST CALENDAR SETTINGS -->
                    <div class="card border rounded-4 p-4 mb-4 bg-white shadow-sm">
                        <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                            <div class="d-flex align-items-center gap-2">
                                <i class="bi bi-google text-danger fs-4"></i>
                                <div>
                                    <h5 class="fw-bold mb-0 text-dark">Sandbox Test Google Calendar Configuration</h5>
                                    <small class="text-muted">Target calendar used exclusively when Sandbox Mode is active</small>
                                </div>
                            </div>
                            @if (!string.IsNullOrEmpty(_settings.ServiceAccountEmail))
                            {
                                <span class="badge bg-success-subtle text-success border border-success px-2 py-1">
                                    <i class="bi bi-shield-check me-1"></i>Service Account Active
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-warning-subtle text-dark border border-warning px-2 py-1">
                                    <i class="bi bi-exclamation-triangle me-1"></i>Service Account JSON Needed
                                </span>
                            }
                        </div>
                        
                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label class="form-label small fw-bold text-dark mb-1">
                                    <i class="bi bi-calendar-event me-1 text-primary"></i>Test Google Calendar ID (For Bookings / Write API)
                                </label>
                                <input type="text" class="form-control font-monospace form-control-sm" placeholder="e.g. 7f6dc846...@@group.calendar.google.com" @bind="_webSettings.SandboxGoogleCalendarId" />
                                <small class="text-muted d-block mt-1" style="font-size: 0.75rem;">From Google Calendar Settings &gt; Integrate calendar &gt; <strong>Calendar ID</strong></small>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-bold text-dark mb-1">
                                    <i class="bi bi-link-45deg me-1 text-primary"></i>Test Calendar iCal Feed URL (For Availability Conflict Sync)
                                </label>
                                <input type="text" class="form-control font-monospace form-control-sm" placeholder="https://calendar.google.com/calendar/ical/.../basic.ics" @bind="_webSettings.SandboxCalendarFeedUrl" />
                                <small class="text-muted d-block mt-1" style="font-size: 0.75rem;">For private calendars: Google Calendar &gt; Integrate calendar &gt; <strong>Secret address in iCal format</strong></small>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-bold text-dark mb-1">
                                    <i class="bi bi-envelope-at me-1 text-primary"></i>Test Recipient Email Override
                                </label>
                                <input type="text" class="form-control form-control-sm" placeholder="your-email@domain.com" @bind="_webSettings.SandboxTestEmail" />
                                <small class="text-muted d-block mt-1" style="font-size: 0.75rem;">During sandbox tests, all applicant emails &amp; staff notices are safely redirected to this address.</small>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-bold text-dark mb-1">
                                    <i class="bi bi-shield-lock me-1 text-success"></i>Google Service Account in Use
                                </label>
                                <input type="text" class="form-control form-control-sm font-monospace bg-light" readonly value="@(!string.IsNullOrWhiteSpace(_settings.ServiceAccountEmail) ? _settings.ServiceAccountEmail : "No service account JSON loaded")" />
                                <small class="text-muted d-block mt-1" style="font-size: 0.75rem;">Share your test calendar with this email with <strong>"Make changes to events"</strong> permission.</small>
                            </div>
                        </div>

                        <!-- Sandbox Direct Connection Test Button -->
                        <div class="pt-2 border-top d-flex flex-column gap-2">
                            <button class="btn btn-outline-primary w-100 py-2 shadow-sm d-flex align-items-center justify-content-center gap-2 fw-bold" type="button" @onclick="TestSandboxCalendarConnectionAsync" disabled="@(string.IsNullOrEmpty(_settings.ServiceAccountEmail) || _isTestingSandboxCal)">
                                @if (_isTestingSandboxCal)
                                {
                                    <span class="spinner-border spinner-border-sm"></span>
                                    <span>Testing Sandbox Google Calendar API Write Access...</span>
                                }
