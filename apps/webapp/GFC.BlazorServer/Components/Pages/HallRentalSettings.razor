                                            <button type="button" class="btn btn-sm rounded-pill flex-fill py-1 px-2 @(_webSettings.RequireEmail ? "btn-primary fw-bold shadow-sm" : "btn-light text-muted border-0")" @onclick="() => _webSettings.RequireEmail = true">Required</button>
                                            <button type="button" class="btn btn-sm rounded-pill flex-fill py-1 px-2 @(!_webSettings.RequireEmail ? "btn-dark fw-bold shadow-sm" : "btn-light text-muted border-0")" @onclick="() => _webSettings.RequireEmail = false">Optional</button>
                                        </div>
                                    </div>

                                    <!-- Phone -->
                                    <div class="list-group-item p-3 d-flex justify-content-between align-items-center bg-white">
                                        <div>
                                            <div class="fw-bold text-dark small">Phone Number</div>
                                            <small class="text-muted" style="font-size: 0.75rem;">Direct contact number</small>
                                        </div>
                                        <div class="d-flex p-1 bg-light rounded-pill border" style="min-width: 170px;">
                                            <button type="button" class="btn btn-sm rounded-pill flex-fill py-1 px-2 @(_webSettings.RequirePhone ? "btn-primary fw-bold shadow-sm" : "btn-light text-muted border-0")" @onclick="() => _webSettings.RequirePhone = true">Required</button>
                                            <button type="button" class="btn btn-sm rounded-pill flex-fill py-1 px-2 @(!_webSettings.RequirePhone ? "btn-dark fw-bold shadow-sm" : "btn-light text-muted border-0")" @onclick="() => _webSettings.RequirePhone = false">Optional</button>
