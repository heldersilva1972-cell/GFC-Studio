                                                <div class="fw-bold text-dark small">Event Type / Occasion</div>
                                                <small class="text-muted" style="font-size: 0.75rem;">Dropdown options for applicants</small>
                                            </div>
                                            <div class="d-flex p-1 bg-light rounded-pill border" style="min-width: 170px;">
                                                <button type="button" class="btn btn-sm rounded-pill flex-fill py-1 px-2 @(_webSettings.RequireEventType ? "btn-primary fw-bold shadow-sm" : "btn-light text-muted border-0")" @onclick="() => _webSettings.RequireEventType = true">Required</button>
                                                <button type="button" class="btn btn-sm rounded-pill flex-fill py-1 px-2 @(!_webSettings.RequireEventType ? "btn-dark fw-bold shadow-sm" : "btn-light text-muted border-0")" @onclick="() => _webSettings.RequireEventType = false">Optional</button>
                                            </div>
                                        </div>
                                        <div class="pt-2 border-top mt-2 d-flex justify-content-between align-items-center">
                                            <small class="text-muted" style="font-size: 0.72rem;">
                                                <i class="bi bi-collection text-primary me-1"></i>@_editableEventTypeLists.Count List Preset@(_editableEventTypeLists.Count == 1 ? "" : "s") Configured
                                            </small>
                                            <button type="button" class="btn btn-sm btn-outline-primary py-0 px-2 fw-semibold" style="font-size: 0.72rem;" @onclick="OpenEventListsModal">
                                                <i class="bi bi-pencil-square me-1"></i>Edit Occasion Lists
                                            </button>
                                        </div>
                                    </div>

                                    <!-- Mailing Address -->
                                    <div class="list-group-item p-3 bg-white">
                                        <div class="d-flex justify-content-between align-items-center mb-2">
