                                    <!-- Guest Count -->
                                    <div class="list-group-item p-3 bg-white">
                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                            <div>
                                                <div class="fw-bold text-dark small">Guest Count</div>
                                                <small class="text-muted" style="font-size: 0.75rem;">Estimated attendance</small>
