                                        <button type="button" class="btn btn-sm rounded-pill flex-fill py-1 px-3 @(_webSettings?.MonthCalendarDisplayMode != "compact" ? "btn-primary fw-bold shadow-sm" : "btn-light text-muted border-0")" @onclick='() => SetMonthDisplayMode("multiline")'>
                                            <i class="bi bi-card-text me-1"></i>Multi-Line Card (Expanded)
                                        </button>
                                        <button type="button" class="btn btn-sm rounded-pill flex-fill py-1 px-3 @(_webSettings?.MonthCalendarDisplayMode == "compact" ? "btn-primary fw-bold shadow-sm" : "btn-light text-muted border-0")" @onclick='() => SetMonthDisplayMode("compact")'>
                                            <i class="bi bi-dash-square me-1"></i>Compact Single-Line Pill
                                        </button>
                                    </div>
                                    <small class="text-muted d-block mt-2">
                                        @(_webSettings?.MonthCalendarDisplayMode != "compact" 
                                            ? "Multi-line mode displays configured fields as separate stacked lines inside each calendar day box." 
                                            : "Compact mode displays standard single-line condensed badges.")
                                    </small>
                                </div>

                                <!-- Month Calendar Fields Re-ordering List -->
                                <div class="d-flex align-items-center justify-content-between mb-2">
                                    <span class="small fw-bold text-dark"><i class="bi bi-list-check text-primary me-1"></i>Visible Month Grid Card Fields &amp; Order:</span>
                                    <small class="text-muted">Only enabled items appear</small>
