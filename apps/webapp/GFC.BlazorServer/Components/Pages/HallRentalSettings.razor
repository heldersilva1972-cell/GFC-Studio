                                        <i class="bi bi-bell-fill text-warning"></i>
                                        <span>Send Live Test Push Alert</span>
                                    }
                                </button>
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(_firebaseTestResult))
                        {
                            <div class="alert @(_firebaseTestSuccess ? "alert-success" : "alert-warning") border-0 shadow-sm mt-3 mb-0 d-flex align-items-center gap-2">
                                <i class="bi @(_firebaseTestSuccess ? "bi-check-circle-fill" : "bi-exclamation-circle-fill") fs-5"></i>
                                <span class="small fw-semibold">@_firebaseTestResult</span>
                            </div>
                        }
                    </div>

                    <div class="row g-4 mb-4">
                        <!-- UPLOADER 1: Server Gateway Private Key -->
                        <div class="col-lg-6">
                            <div class="card border rounded-4 shadow-sm bg-white p-4 h-100 d-flex flex-column">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="p-2 rounded-3 bg-primary bg-opacity-10 text-primary">
                                            <i class="bi bi-server fs-5"></i>
                                        </div>
                                        <h5 class="fw-bold text-dark mb-0">1. Server Key (Private Key)</h5>
                                    </div>
                                    <span class="badge @(_firebaseConfigured ? "bg-success" : "bg-warning text-dark") px-2 py-1 small">
                                        @(_firebaseConfigured ? "🟢 Installed" : "⚠️ Needed")
                                    </span>
                                </div>
                                <p class="text-muted small mb-3">
                                    Upload the Service Account key (starts with <code class="text-primary fw-bold">gfc-connect-*-adminsdk-*.json</code>). Automatically placed into <code class="text-dark">App_Data/firebase-adminsdk.json</code>.
                                </p>

                                <div class="p-4 border border-2 border-dashed rounded-4 text-center bg-light mb-3 flex-grow-1 d-flex flex-column justify-content-center align-items-center">
                                    <i class="bi bi-key-fill text-primary display-6 mb-2"></i>
                                    <span class="fw-bold text-dark mb-1 small">Select Service Account JSON File</span>
                                    <span class="text-muted mb-3" style="font-size:0.75rem;">From Firebase Console → Project Settings → Service Accounts</span>
                                    
                                    <div class="position-relative">
                                        <InputFile OnChange="HandleFirebaseFileUpload" accept=".json" class="form-control form-control-sm" />
                                    </div>
                                    @if (_isUploadingFirebase)
                                    {
                                        <div class="mt-2 text-primary small fw-semibold">
                                            <span class="spinner-border spinner-border-sm me-1"></span> Installing to App_Data...
                                        </div>
                                    }
                                </div>

                                <div class="bg-light p-2.5 rounded-3 border mb-3">
                                    <div class="d-flex justify-content-between align-items-center small">
                                        <span class="text-muted"><i class="bi bi-folder-check text-success me-1"></i>Auto Destination:</span>
                                        <code class="text-dark fw-bold" style="font-size:0.75rem;">App_Data/firebase-adminsdk.json</code>
                                    </div>
                                </div>

                                <details class="mt-auto">
                                    <summary class="text-primary small fw-semibold cursor-pointer mb-2">Or paste JSON text directly</summary>
                                    <div class="mb-2">
                                        <textarea class="form-control form-control-sm font-monospace" rows="4" placeholder="Paste { &quot;type&quot;: &quot;service_account&quot;, ... } here..." @bind="_pastedFirebaseJson" style="font-size: 0.75rem;"></textarea>
                                    </div>
                                    <button type="button" class="btn btn-primary btn-sm w-100 fw-bold rounded-pill" @onclick="SavePastedFirebaseJson">
                                        <i class="bi bi-check2-circle me-1"></i> Save &amp; Activate Key
                                    </button>
                                </details>
                            </div>
                        </div>

                        <!-- UPLOADER 2: Android App Client Config -->
                        <div class="col-lg-6">
                            <div class="card border rounded-4 shadow-sm bg-white p-4 h-100 d-flex flex-column">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="p-2 rounded-3 bg-success bg-opacity-10 text-success">
                                            <i class="bi bi-phone fs-5"></i>
                                        </div>
                                        <h5 class="fw-bold text-dark mb-0">2. App Config (google-services.json)</h5>
                                    </div>
                                    <span class="badge @(_googleServicesConfigured ? "bg-success" : "bg-warning text-dark") px-2 py-1 small">
                                        @(_googleServicesConfigured ? "🟢 Installed" : "⚠️ Needed")
