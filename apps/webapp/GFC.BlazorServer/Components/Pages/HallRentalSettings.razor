                                    <div class="small text-muted mt-1">Coalition Room + Kitchen ($300)</div>
                                </button>
                            </div>
                            <div class="col-md-4">
                                <button type="button" class="btn btn-outline-info w-100 p-3 text-start rounded-4 h-100 shadow-sm" @onclick='() => RunModalSimulation("youth")'>
                                    <div class="fw-bold fs-6"><i class="bi bi-trophy-fill text-primary me-2"></i>Youth Sports Banquet</div>
                                    <div class="small text-muted mt-1">Youth Org Rate + A/V ($200)</div>
                                </button>
                            </div>
                        </div>

                        <!-- CUSTOM TEST INTAKE -->
                        <div class="p-4 bg-light rounded-4 border">
                            <h6 class="fw-bold text-dark mb-3"><i class="bi bi-sliders me-2 text-secondary"></i>Custom Test Application:</h6>
                            
                            <div class="row g-3 mb-3">
                                <div class="col-md-3">
                                    <label class="form-label small fw-bold mb-1">Applicant Name</label>
                                    <input type="text" class="form-control form-control-sm" @bind="_manualTestModel.ApplicantName" />
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label small fw-bold mb-1">Event Type</label>
                                    <input type="text" class="form-control form-control-sm" @bind="_manualTestModel.EventType" />
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label small fw-bold mb-1">Room Selection</label>
                                    <select class="form-select form-select-sm" @bind="_manualTestModel.RoomSelected" @bind:after="RecalculateManualTestQuote">
                                        @foreach (var r in (_editableRooms.Any() ? _editableRooms : (_webSettings?.GetRoomsList() ?? new List<RentalRoomOption>())))
                                        {
                                            <option value="@r.Name">@r.Name (Capacity: @r.Capacity)</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label small fw-bold mb-1">Event Date</label>
                                    <input type="date" class="form-control form-control-sm" @bind="_manualTestModel.EventDate" />
                                </div>
                            </div>

                            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 pt-3 border-top">
                                <div class="d-flex align-items-center gap-3">
                                    <span class="small text-muted">Calculated Quote:</span>
                                    <span class="fs-4 fw-bold text-success">$@_manualTestModel.TotalPrice.ToString("F2")</span>
                                </div>
                                <button type="button" class="btn btn-warning fw-bold px-4 py-2 shadow-sm text-dark" @onclick="SubmitManualTestSimulation" disabled="@_isSubmittingManualTest">
                                    @if (_isSubmittingManualTest)
                                    {
                                        <span class="spinner-border spinner-border-sm me-1"></span>
                                        <span>Processing...</span>
                                    }
                                    else
                                    {
                                        <i class="bi bi-send-check-fill me-1"></i>
                                        <span>Submit Custom Test &amp; Push to Google Calendar</span>
                                    }
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- REAL-TIME DIAGNOSTIC EXECUTION LOG -->
                    @if (_modalSimulationLogs.Any())
                    {
                        <div class="card border rounded-4 p-4 mb-4 shadow-sm bg-white">
                            <div class="d-flex justify-content-between align-items-center border-bottom pb-2 mb-3">
                                <h6 class="fw-bold text-dark mb-0"><i class="bi bi-terminal-fill text-primary me-2"></i>Real-Time Simulation Diagnostics Log</h6>
                                <button type="button" class="btn btn-sm btn-outline-secondary py-1 px-3" style="font-size: 0.8rem;" @onclick="() => _modalSimulationLogs.Clear()">Clear Log</button>
                            </div>
                            <div style="max-height: 240px; overflow-y: auto; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 12px; line-height: 1.7;">
                                @foreach (var log in _modalSimulationLogs)
                                {
                                    <div class="py-1 text-dark" style="font-size: 0.88rem; border-bottom: 1px dashed #e2e8f0;">@log</div>
                                }
                            </div>
                        </div>
                    }

                    <!-- DATA CLEANUP UTILITY -->
                    <div class="d-flex justify-content-between align-items-center p-4 bg-white rounded-4 border shadow-sm">
                        <div>
                            <h6 class="fw-bold small text-dark mb-1"><i class="bi bi-trash3-fill text-danger me-2"></i>Reset Sandbox Test Submissions</h6>
                            <span class="small text-muted">Safely remove all simulated applications and purge test calendar entries.</span>
                        </div>
                        <button type="button" class="btn btn-outline-danger btn-sm px-4 py-2 shadow-sm fw-semibold" @onclick="CleanUpTestRecords">
                            <i class="bi bi-trash3 me-1"></i> Clean Up All Test Submissions
                        </button>
                    </div>
                </div>
            }

            @* ========================================================================= *@
            @* TAB: PRICING GUIDE & CHART *@
            @* ========================================================================= *@
            @if (string.Equals(_activeTab, "pricing_guide", StringComparison.OrdinalIgnoreCase))
            {
                <div class="tab-pane-card animate-fade-in bg-white rounded-4 border p-4 shadow-sm">
                    <GFC.BlazorServer.Components.Shared.RentalPricingGuideView 
                        Settings="_webSettings" 
                        ShowFullPageLink="true" 
                        OnCustomGuideSaved="HandleCustomGuideSaved" />
                </div>
            }

            @* ========================================================================= *@
            @* TAB 6: LIVE PREVIEW *@
            @* ========================================================================= *@
            @if (string.Equals(_activeTab, "preview", StringComparison.OrdinalIgnoreCase))
            {
                <div class="tab-pane-card animate-fade-in bg-white rounded-4 border p-4 shadow-sm">
                    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                        <div class="text-start">
                            <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-globe me-2 text-primary"></i>Live Public Application Form Preview</h5>
                            <small class="text-muted">Exact render of what applicants see when visiting your website</small>
                        </div>
                        <div class="btn-group shadow-sm" role="group">
                            <button type="button" class="btn btn-sm @(_previewDevice == "desktop" ? "btn-primary" : "btn-outline-secondary")" @onclick='() => _previewDevice = "desktop"'>
                                <i class="bi bi-display me-1"></i> Desktop View
                            </button>
                            <button type="button" class="btn btn-sm @(_previewDevice == "mobile" ? "btn-primary" : "btn-outline-secondary")" @onclick='() => _previewDevice = "mobile"'>
                                <i class="bi bi-phone me-1"></i> Mobile View
                            </button>
                            <a href="/rentals/apply" target="_blank" class="btn btn-sm btn-outline-secondary">
                                <i class="bi bi-box-arrow-up-right me-1"></i> Open Full Page
                            </a>
                        </div>
                    </div>

                    <div class="preview-viewport-container mx-auto" style="@(_previewDevice == "mobile" ? "max-width: 400px; border: 8px solid #cbd5e1; border-radius: 36px; padding: 4px; background: #f8fafc; box-shadow: 0 16px 40px rgba(0,0,0,0.15);" : "max-width: 1000px; border: 1px solid #cbd5e1; border-radius: 16px; box-shadow: 0 8px 30px rgba(0,0,0,0.06); overflow: hidden;")">
                        @if (_previewDevice == "desktop")
                        {
                            <div class="bg-light px-3 py-2 border-bottom d-flex align-items-center gap-2 text-muted small">
                                <div class="d-flex gap-1">
                                    <span class="rounded-circle bg-danger d-inline-block" style="width: 10px; height: 10px;"></span>
                                    <span class="rounded-circle bg-warning d-inline-block" style="width: 10px; height: 10px;"></span>
                                    <span class="rounded-circle bg-success d-inline-block" style="width: 10px; height: 10px;"></span>
                                </div>
                                <div class="bg-white rounded px-3 py-1 border text-truncate flex-grow-1 text-center font-monospace" style="font-size: 0.8rem;">
                                    https://gloucesterfraternityclub.com/rentals/apply
                                </div>
                            </div>
                        }
                        <div style="height: 680px; overflow-y: auto; background: #ffffff; border-radius: @(_previewDevice == "mobile" ? "24px" : "0");">
                            <iframe src="/rentals/apply?embed=true" style="width: 100%; height: 100%; border: none;"></iframe>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- BOTTOM SAVE ACTION BAR (FIXED) -->
        <div class="bottom-action-bar bg-white rounded-4 border p-3 shadow-sm mt-3 flex-shrink-0 d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div class="d-flex align-items-center gap-2 text-muted small">
                <i class="bi bi-info-circle-fill text-primary"></i>
                <span>All modifications across all tabs will be saved simultaneously.</span>
            </div>
            <div class="d-flex align-items-center gap-2">
                <button type="button" class="btn btn-outline-secondary px-3" @onclick="GoBackToHallRentals">
                    Cancel &amp; Return
                </button>
                <button type="button" class="btn btn-primary btn-lg px-4 shadow-sm fw-bold d-flex align-items-center gap-2" @onclick="SaveAllSettings" disabled="@_isSaving">
                    @if (_isSaving)
                    {
                        <span class="spinner-border spinner-border-sm"></span>
                        <span>Saving Changes...</span>
                    }
                    else
                    {
                        <i class="bi bi-check2-circle fs-5"></i>
                        <span>Save All Settings</span>
                    }
                </button>
            </div>
        </div>
    }
</div>

<!-- DELETE FEED CONFIRMATION MODAL -->
@if (_showDeleteFeedConfirm && _feedToDelete != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.45); z-index: 1060;" role="dialog">
        <div class="modal-dialog modal-dialog-centered" style="max-width: 440px;" role="document">
            <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="modal-body p-4 text-center">
                    <div class="p-3 rounded-circle bg-danger-subtle text-danger d-inline-flex mb-3">
                        <i class="bi bi-trash3-fill fs-3"></i>
                    </div>
                    <h5 class="fw-bold mb-2 text-dark">Remove Calendar Feed?</h5>
                    <p class="text-muted small mb-3">
                        Are you sure you want to remove <strong class="text-dark">@_feedToDelete.Name</strong>? Events from this calendar feed will no longer sync.
                    </p>
                    <div class="d-flex justify-content-center gap-2">
                        <button type="button" class="btn btn-light px-3" @onclick="CancelDeleteFeed">Cancel</button>
                        <button type="button" class="btn btn-danger px-4 shadow-sm" @onclick="ConfirmDeleteFeed">Yes, Remove</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<!-- UNSAVED CHANGES CONFIRMATION MODAL -->
@if (_showUnsavedChangesModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.65); z-index: 1070;" role="dialog">
        <div class="modal-dialog modal-dialog-centered" style="max-width: 480px;" role="document">
            <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="modal-header bg-warning text-dark p-3 px-4 border-0">
                    <h5 class="modal-title fw-bold mb-0 d-flex align-items-center gap-2">
                        <i class="bi bi-exclamation-triangle-fill text-dark"></i>
                        <span>Unsaved Changes Detected</span>
                    </h5>
                    <button type="button" class="btn-close" @onclick="StayAndKeepEditing"></button>
                </div>
                <div class="modal-body p-4">
                    <p class="text-dark fw-semibold mb-1">You have unsaved changes in Hall Rental Settings.</p>
                    <p class="text-muted small mb-0">
                        If you leave now without saving, any modifications made to room rates, day schedules, policies, emails, or calendar connections will be discarded.
                    </p>
                </div>
                <div class="modal-footer bg-light border-top p-3 px-4 d-flex justify-content-between flex-wrap gap-2">
                    <button type="button" class="btn btn-outline-secondary btn-sm px-3 rounded-pill" @onclick="StayAndKeepEditing">
                        <i class="bi bi-pencil me-1"></i>Stay &amp; Keep Editing
                    </button>
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-outline-danger btn-sm px-3 rounded-pill" @onclick="DiscardChangesAndLeave">
                            <i class="bi bi-trash me-1"></i>Discard &amp; Leave
                        </button>
                        <button type="button" class="btn btn-primary btn-sm px-3 rounded-pill shadow-sm fw-bold" @onclick="SaveAndLeaveAsync" disabled="@_isSaving">
                            @if (_isSaving)
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span>
                                <span>Saving...</span>
                            }
                            else
                            {
                                <i class="bi bi-check2-circle me-1"></i>
                                <span>Save &amp; Leave</span>
                            }
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

