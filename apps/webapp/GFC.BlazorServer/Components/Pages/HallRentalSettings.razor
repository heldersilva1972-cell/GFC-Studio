                                                        <div class="d-flex align-items-center gap-1">
                                                            <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle px-2 py-0 small" style="font-size: 0.68rem;">
                                                                <i class="bi bi-fire me-1"></i>KITCHEN
                                                            </span>
                                                            <span class="fw-bold text-dark small">Kitchen Access</span>
                                                        </div>
