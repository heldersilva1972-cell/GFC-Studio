    }

    private void ToggleRoomForDay(DayOfWeekScheduleConfig day, string roomName)
    {
        if (day.AllowedRoomNames == null || day.AllowedRoomNames.Count == 0)
        {
            day.AllowedRoomNames = _editableRooms.Select(r => r.Name).ToList();
            day.AllowedRoomNames.RemoveAll(n => string.Equals(n, roomName, StringComparison.OrdinalIgnoreCase));
        }
        else if (day.AllowedRoomNames.Contains("__NONE__"))
        {
            day.AllowedRoomNames.Clear();
            day.AllowedRoomNames.Add(roomName);
        }
        else
        {
            if (day.AllowedRoomNames.Contains(roomName, StringComparer.OrdinalIgnoreCase))
            {
                day.AllowedRoomNames.RemoveAll(n => string.Equals(n, roomName, StringComparison.OrdinalIgnoreCase));
                if (day.AllowedRoomNames.Count == 0)
                {
                    day.AllowedRoomNames.Add("__NONE__");
                }
            }
            else
            {
                day.AllowedRoomNames.Add(roomName);
                if (day.AllowedRoomNames.Count >= _editableRooms.Count)
                {
                    day.AllowedRoomNames.Clear();
                }
            }
        }
    }

    private static int ParseTimeStrToMinutes(string? timeStr)
    {
        if (string.IsNullOrWhiteSpace(timeStr)) return 0;
        var trimmed = timeStr.Trim();
        if (trimmed.Equals("12:00 Midnight", StringComparison.OrdinalIgnoreCase) || trimmed.Equals("Midnight", StringComparison.OrdinalIgnoreCase))
        {
            return 24 * 60;
        }
        if (DateTime.TryParse(trimmed, out var dt))
        {
            int min = dt.Hour * 60 + dt.Minute;
            if (min == 0 && (trimmed.Contains("12", StringComparison.OrdinalIgnoreCase) || trimmed.Contains("Midnight", StringComparison.OrdinalIgnoreCase)))
            {
                return 24 * 60;
            }
            return min;
        }
        return 0;
    }

    private string? GetSlotValidationWarning(DayOfWeekScheduleConfig day)
    {
        if (day.Slots == null || day.Slots.Count == 0) return null;

        for (int i = 0; i < day.Slots.Count; i++)
        {
            var slot = day.Slots[i];
            int startMin = ParseTimeStrToMinutes(slot.StartTime);
            int endMin = ParseTimeStrToMinutes(slot.EndTime);

            if (endMin <= startMin)
            {
                return $"Slot '{slot.Label}': End time ({slot.EndTime}) must be after start time ({slot.StartTime}).";
            }
        }

        if (day.Slots.Count > 1)
        {
            for (int i = 0; i < day.Slots.Count; i++)
            {
                var s1 = day.Slots[i];
                int start1 = ParseTimeStrToMinutes(s1.StartTime);
                int end1 = ParseTimeStrToMinutes(s1.EndTime);

                for (int j = i + 1; j < day.Slots.Count; j++)
                {
                    var s2 = day.Slots[j];
                    int start2 = ParseTimeStrToMinutes(s2.StartTime);
                    int end2 = ParseTimeStrToMinutes(s2.EndTime);

                    if (Math.Max(start1, start2) < Math.Min(end1, end2))
                    {
                        return $"Time conflict: '{s1.Label}' ({s1.StartTime} - {s1.EndTime}) overlaps with '{s2.Label}' ({s2.StartTime} - {s2.EndTime}).";
                    }
                }
            }
        }

        return null;
    }

