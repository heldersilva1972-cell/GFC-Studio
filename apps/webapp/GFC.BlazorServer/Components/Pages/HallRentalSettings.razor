                                        var currentIdx = lIdx;
                                        var totalCount = orderedColumns.Count;

                                        <div class="list-group-item p-3 d-flex align-items-center justify-content-between gap-3 @(col.IsEnabled ? "bg-white" : "bg-light text-muted")">
