    private bool IsRoomAllowedForDay(DayOfWeekScheduleConfig day, string roomName)
    {
        if (day.AllowedRoomNames == null || day.AllowedRoomNames.Count == 0) return true;
        if (day.AllowedRoomNames.Contains("__NONE__")) return false;
        return day.AllowedRoomNames.Contains(roomName, StringComparer.OrdinalIgnoreCase);
    }

    private void EnableAllRoomsForDay(DayOfWeekScheduleConfig day)
    {
        day.AllowedRoomNames.Clear();
    }

