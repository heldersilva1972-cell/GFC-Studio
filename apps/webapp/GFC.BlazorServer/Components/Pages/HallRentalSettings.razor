                                        <i class="bi bi-exclamation-octagon-fill fs-5"></i>
                                        <div><strong>Selection Required:</strong> At least one field must be enabled for the Month Calendar grid.</div>
                                    </div>
                                }

                                <div class="list-group list-group-flush rounded-3 border overflow-hidden">
                                    @for (int mIdx = 0; mIdx < _editableMonthFields.OrderBy(f => f.Order).ToList().Count; mIdx++)
                                    {
                                        var orderedMonth = _editableMonthFields.OrderBy(f => f.Order).ToList();
                                        var mField = orderedMonth[mIdx];
                                        var currentIdx = mIdx;
                                        var totalCount = orderedMonth.Count;

                                        <div class="list-group-item p-3 d-flex align-items-center justify-content-between gap-3 @(mField.IsEnabled ? "bg-white" : "bg-light text-muted")">
                                            <div class="d-flex align-items-center gap-3 flex-grow-1">
                                                <div class="btn-group-vertical btn-group-sm" role="group">
                                                    <button type="button" class="btn btn-outline-secondary py-0 px-2" disabled="@(currentIdx == 0)" @onclick="() => MoveMonthField(mField, -1)" title="Move Up">
                                                        <i class="bi bi-chevron-up"></i>
                                                    </button>
                                                    <button type="button" class="btn btn-outline-secondary py-0 px-2" disabled="@(currentIdx == totalCount - 1)" @onclick="() => MoveMonthField(mField, 1)" title="Move Down">
                                                        <i class="bi bi-chevron-down"></i>
                                                    </button>
                                                </div>
                                                <span class="badge @(mField.IsEnabled ? "bg-primary" : "bg-secondary") rounded-pill px-2 py-1" style="font-size: 0.75rem; min-width: 28px;">
                                                    #@(currentIdx + 1)
