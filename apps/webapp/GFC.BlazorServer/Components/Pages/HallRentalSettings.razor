@page "/hall-rentals/settings"
@using GFC.Core.Models
@using GFC.Core.Interfaces
@using GFC.BlazorServer.Services
@using Microsoft.AspNetCore.Components.Forms
@inject IGoogleCalendarService CalendarService
@inject IUserManagementService UserService
@inject IRentalService RentalService
@inject GFC.Core.Interfaces.IWebsiteSettingsService WebsiteSettingsService
@inject IRentalEmailDispatcher RentalEmailDispatcher
@inject GFC.BlazorServer.Services.CustomAuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject IToastService ToastService
@attribute [Authorize]
@rendermode InteractiveServer

<NavigationLock OnBeforeInternalNavigation="OnBeforeInternalNavigation" ConfirmExternalNavigation="@HasUnsavedChanges" />

<div class="rental-settings-page-wrapper">
    @if (!_hasPageAccess && !_isAdmin)
    {
        <div class="access-denied-panel text-center py-5 bg-white rounded-4 border shadow-sm my-4">
            <div class="bg-light rounded-circle shadow-sm d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px;">
                <i class="bi bi-shield-lock-fill text-danger fs-1"></i>
            </div>
            <h3 class="fw-bold text-dark">Access Restricted</h3>
            <p class="text-muted">You do not have permission to view Hall Rental Settings. Please contact your system administrator.</p>
            <a href="/hall-rentals" class="btn btn-outline-primary mt-2">
                <i class="bi bi-arrow-left me-1"></i>Back to Hall Rentals
            </a>
        </div>
    }
    else if (_isLoading)
    {
        <div class="text-center py-5 bg-white rounded-4 border shadow-sm my-4">
            <div class="spinner-border text-primary mb-3" style="width: 3rem; height: 3rem;" role="status"></div>
            <h5 class="fw-bold text-dark">Loading Rental Settings...</h5>
            <p class="text-muted small">Retrieving rooms, pricing tiers, Google Calendar connections, and sandbox state.</p>
        </div>
    }
    else
    {
        <!-- TOP PAGE HEADER (FIXED) -->
        <div class="page-header-card bg-white rounded-4 border p-3 px-4 shadow-sm mb-3 flex-shrink-0">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="p-3 rounded-3 bg-primary bg-opacity-10 text-primary border border-primary border-opacity-10">
                        <i class="bi bi-sliders2-vertical fs-3"></i>
                    </div>
                    <div>
                        <div class="d-flex align-items-center gap-2 flex-wrap">
                            <h2 class="fw-bold mb-0 text-dark">Hall Rental &amp; Calendar Settings</h2>
                            @if (_webSettings?.EnableSandboxMode == true)
                            {
                                <span class="badge bg-warning text-dark border border-warning px-2 py-1 small fw-bold">
                                    <i class="bi bi-shield-fill-check me-1"></i>SANDBOX MODE
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-success border px-2 py-1 small">
                                    <i class="bi bi-broadcast me-1"></i>LIVE PRODUCTION
                                </span>
                            }

                            <!-- MASTER PRICING ENGINE SELECTOR -->
                            @if (_webSettings != null)
                            {
                                <div class="ms-2 p-1 bg-light border rounded-pill d-inline-flex align-items-center shadow-sm">
                                    <button type="button" 
                                            class="btn btn-sm rounded-pill px-3 py-1 fw-bold @(!_webSettings.UseLegacyPricingEngine ? "btn-success text-white shadow-sm" : "btn-light text-muted border-0")" 
                                            @onclick="() => SetPricingEngine(false)">
                                        <i class="bi bi-grid-3x3-gap-fill me-1"></i>✨ Matrix Tier Engine (New)
                                    </button>
                                    <button type="button" 
                                            class="btn btn-sm rounded-pill px-3 py-1 fw-bold @(_webSettings.UseLegacyPricingEngine ? "btn-secondary text-white shadow-sm" : "btn-light text-muted border-0")" 
                                            @onclick="() => SetPricingEngine(true)">
                                        <i class="bi bi-tag-fill me-1"></i>Legacy Engine
                                    </button>
                                </div>
                            }
                        </div>
                        <p class="text-muted small mb-0 mt-1">Configure event spaces, pricing rules, Google Calendar integration, public booking forms, and testing simulations.</p>
                    </div>
                </div>
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <button type="button" class="btn btn-outline-secondary d-flex align-items-center gap-2 shadow-sm" @onclick="GoBackToHallRentals">
                        <i class="bi bi-arrow-left"></i>
                        <span>Back to Rentals</span>
                    </button>
                    <button type="button" class="btn btn-primary d-flex align-items-center gap-2 px-4 shadow-sm fw-semibold" @onclick="SaveAllSettings" disabled="@_isSaving">
                        @if (_isSaving)
                        {
                            <span class="spinner-border spinner-border-sm"></span>
                            <span>Saving...</span>
                        }
                        else
                        {
                            <i class="bi bi-check2-circle fs-5"></i>
                            <span>Save All Settings</span>
                        }
                    </button>
                </div>
            </div>

            <!-- FEEDBACK ALERT -->
            @if (!string.IsNullOrEmpty(_feedbackMessage))
            {
                <div class="alert @(_feedbackSuccess ? "alert-success" : "alert-danger") alert-dismissible fade show mt-3 mb-0 d-flex align-items-center gap-2 shadow-sm" role="alert">
                    <i class="bi @(_feedbackSuccess ? "bi-check-circle-fill text-success" : "bi-exclamation-triangle-fill text-danger") fs-5"></i>
                    <div>@_feedbackMessage</div>
                    <button type="button" class="btn-close" @onclick="() => _feedbackMessage = null"></button>
                </div>
            }
        </div>

        <!-- NAVIGATION TABS (FIXED) -->
        <div class="tabs-nav-card bg-white rounded-4 border p-2 shadow-sm mb-3 flex-shrink-0">
            <ul class="nav nav-pills gap-2 flex-nowrap overflow-x-auto p-1">
                @if (_webSettings?.UseLegacyPricingEngine != false)
                {
                    <li class="nav-item">
                        <button type="button" class="nav-link py-2 px-3 fw-semibold d-flex align-items-center gap-2 @(string.Equals(_activeTab, "pricing", StringComparison.OrdinalIgnoreCase) ? "active bg-primary text-white shadow-sm" : "text-secondary")" @onclick='() => SelectTab("pricing")'>
                            <i class="bi bi-tag-fill"></i>
                            <span>Rental Pricing &amp; Rates</span>
                        </button>
                    </li>
                    <li class="nav-item">
                        <button type="button" class="nav-link py-2 px-3 fw-semibold d-flex align-items-center gap-2 @(string.Equals(_activeTab, "schedule_slots", StringComparison.OrdinalIgnoreCase) ? "active bg-primary text-white shadow-sm" : "text-secondary")" @onclick='() => SelectTab("schedule_slots")'>
                            <i class="bi bi-calendar2-range"></i>
                            <span>📅 Day Schedules &amp; Time Slots</span>
                        </button>
                    </li>
                }
                else
                {
                    <li class="nav-item">
                        <button type="button" class="nav-link py-2 px-3 fw-semibold d-flex align-items-center gap-2 @(string.Equals(_activeTab, "matrix_tiers", StringComparison.OrdinalIgnoreCase) ? "active bg-primary text-white shadow-sm" : "text-secondary")" @onclick='() => SelectTab("matrix_tiers")'>
                            <i class="bi bi-grid-3x3-gap-fill text-primary @(string.Equals(_activeTab, "matrix_tiers", StringComparison.OrdinalIgnoreCase) ? "text-white" : "")"></i>
                            <span>Tier &amp; Day Matrix Pricing</span>
                        </button>
                    </li>
                }
                <li class="nav-item">
                    <button type="button" class="nav-link py-2 px-3 fw-semibold d-flex align-items-center gap-2 @(string.Equals(_activeTab, "calendar", StringComparison.OrdinalIgnoreCase) ? "active bg-primary text-white shadow-sm" : "text-secondary")" @onclick='() => SelectTab("calendar")'>
                        <i class="bi bi-google text-danger"></i>
                        <span>Google Calendar Sync</span>
                    </button>
                </li>
                <li class="nav-item">
                    <button type="button" class="nav-link py-2 px-3 fw-semibold d-flex align-items-center gap-2 @(string.Equals(_activeTab, "form_intake", StringComparison.OrdinalIgnoreCase) ? "active bg-primary text-white shadow-sm" : "text-secondary")" @onclick='() => SelectTab("form_intake")'>
                        <i class="bi bi-file-earmark-text"></i>
                        <span>Public Form &amp; Rules</span>
                    </button>
                </li>
                <li class="nav-item">
                    <button type="button" class="nav-link py-2 px-3 fw-semibold d-flex align-items-center gap-2 @(string.Equals(_activeTab, "policies", StringComparison.OrdinalIgnoreCase) ? "active bg-primary text-white shadow-sm" : "text-secondary")" @onclick='() => SelectTab("policies")'>
                        <i class="bi bi-shield-check"></i>
                        <span>📜 Policies &amp; Agreements</span>
                    </button>
                </li>
                <li class="nav-item">
                    <button type="button" class="nav-link py-2 px-3 fw-semibold d-flex align-items-center gap-2 @(string.Equals(_activeTab, "emails", StringComparison.OrdinalIgnoreCase) ? "active bg-primary text-white shadow-sm" : "text-secondary")" @onclick='() => SelectTab("emails")'>
                        <i class="bi bi-envelope-gear-fill"></i>
                        <span>Email Logic &amp; Automation</span>
                    </button>
                </li>
                <li class="nav-item">
                    <button type="button" class="nav-link py-2 px-3 fw-semibold d-flex align-items-center gap-2 @(string.Equals(_activeTab, "simulator", StringComparison.OrdinalIgnoreCase) ? "active bg-warning text-dark shadow-sm fw-bold border border-warning" : "text-dark")" @onclick='() => SelectTab("simulator")'>
                        <i class="bi bi-shield-check text-warning"></i>
                        <span>🧪 Sandbox &amp; Testing</span>
                    </button>
                </li>
                <li class="nav-item">
                    <button type="button" class="nav-link py-2 px-3 fw-semibold d-flex align-items-center gap-2 @(string.Equals(_activeTab, "pricing_guide", StringComparison.OrdinalIgnoreCase) ? "active bg-primary text-white shadow-sm" : "text-secondary")" @onclick='() => SelectTab("pricing_guide")'>
                        <i class="bi bi-bar-chart-fill"></i>
                        <span>📊 Pricing Guide &amp; Chart</span>
                    </button>
                </li>
                <li class="nav-item">
                    <button type="button" class="nav-link py-2 px-3 fw-semibold d-flex align-items-center gap-2 @(string.Equals(_activeTab, "preview", StringComparison.OrdinalIgnoreCase) ? "active bg-primary text-white shadow-sm" : "text-secondary")" @onclick='() => SelectTab("preview")'>
                        <i class="bi bi-display"></i>
                        <span>Live Form Preview</span>
                    </button>
                </li>
            </ul>
        </div>

        <!-- ACTIVE TAB CONTENT PANES (COMPLETELY ISOLATED) -->
        <div class="tab-content-container">
            
            @* ========================================================================= *@
            @* TAB 1: ROOMS, SPACES & PRICING *@
            @* ========================================================================= *@
            @if (string.Equals(_activeTab, "pricing", StringComparison.OrdinalIgnoreCase))
            {
                <div class="tab-pane-card animate-fade-in">
                    <!-- Base Timing & Deposit Rules -->
                    <div class="card border rounded-4 p-4 mb-4 bg-white shadow-sm">
                        <h5 class="fw-bold text-dark mb-3"><i class="bi bi-clock-history text-primary me-2"></i>Base Rental Duration &amp; Overtime Rules</h5>
                        <div class="row g-4">
                            <div class="col-md-3">
                                <label class="form-label fw-semibold text-dark small mb-1">Standard Function Duration</label>
                                <div class="input-group">
                                    <input type="number" class="form-control fw-bold" @bind="_webSettings.BaseFunctionHours" min="1" max="24" />
                                    <span class="input-group-text bg-light text-muted">Hours</span>
                                </div>
                                <small class="text-muted">Standard event time included in base room rate.</small>
                            </div>

                            <div class="col-md-3">
                                <label class="form-label fw-semibold text-dark small mb-1">Allow Extra / Overtime Hours?</label>
                                <div class="d-flex p-1 bg-light rounded-pill border mb-1">
                                    <button type="button" class="btn btn-sm rounded-pill flex-fill py-1 px-2 @(_webSettings.AllowAdditionalHours ? "btn-primary fw-bold shadow-sm" : "btn-light text-muted border-0")" @onclick="() => _webSettings.AllowAdditionalHours = true">Enabled</button>
                                    <button type="button" class="btn btn-sm rounded-pill flex-fill py-1 px-2 @(!_webSettings.AllowAdditionalHours ? "btn-dark fw-bold shadow-sm" : "btn-light text-muted border-0")" @onclick="() => _webSettings.AllowAdditionalHours = false">Disabled</button>
                                </div>
                                <small class="text-muted">@(_webSettings.AllowAdditionalHours ? "Applicants can book additional hours." : $"Strictly limited to {_webSettings.BaseFunctionHours ?? 5} hours max.")</small>
                            </div>

                            <div class="col-md-3">
                                <label class="form-label fw-semibold text-dark small mb-1">Additional Hour Rate</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light text-muted">$</span>
                                    <input type="number" class="form-control fw-bold" @bind="_webSettings.AdditionalHourRate" disabled="@(!_webSettings.AllowAdditionalHours)" />
                                    <span class="input-group-text bg-light text-muted">/ hr</span>
                                </div>
                                <small class="text-muted">Rate charged per extra hour over standard.</small>
                            </div>

                            <div class="col-md-3">
                                <label class="form-label fw-semibold text-dark small mb-1">Maximum Total Duration</label>
                                <div class="input-group">
                                    <input type="number" class="form-control fw-bold" @bind="_webSettings.MaxHallRentalDurationHours" min="1" max="24" disabled="@(!_webSettings.AllowAdditionalHours)" />
                                    <span class="input-group-text bg-light text-muted">Hours</span>
                                </div>
                                <small class="text-muted">Hard cap limit for rental applications.</small>
                            </div>

                            <div class="col-12 mt-2 pt-2 border-top">
                                <div class="row align-items-center">
                                    <div class="col-md-6 col-lg-4">
                                        <label class="form-label fw-semibold text-dark small mb-1">Refundable Security Deposit</label>
                                        <div class="input-group">
                                            <span class="input-group-text bg-light text-muted">$</span>
                                            <input type="number" class="form-control fw-bold" @bind="_webSettings.SecurityDepositAmount" />
                                        </div>
                                    </div>
                                    <div class="col-md-6 col-lg-8">
                                        <div class="form-check mt-3">
                                            <input class="form-check-input" type="checkbox" id="depToggle" @bind="_webSettings.RequireSecurityDeposit" />
                                            <label class="form-check-label fw-semibold text-dark small" for="depToggle">Require security deposit on public booking applications</label>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Rental Pricing Categories Grid -->
                    <div class="d-flex justify-content-between align-items-center mb-3 mt-4">
                        <div>
                            <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-tag-fill text-primary me-2"></i>Function Hall Rental Pricing Categories &amp; Rates</h5>
                            <small class="text-muted">Configure pricing tiers and renter categories (Standard, Coalition, Youth Organizations) for Function Hall rentals</small>
                        </div>
                        <div class="d-flex align-items-center gap-2 flex-wrap">
                            <button type="button" class="btn btn-outline-primary px-3 shadow-sm d-flex align-items-center gap-2" @onclick='() => SelectTab("pricing_guide")'>
                                <i class="bi bi-bar-chart-fill"></i>
                                <span>Preview / Edit Pricing Guide</span>
                            </button>
                            <button type="button" class="btn btn-primary px-3 shadow-sm d-flex align-items-center gap-2" @onclick="AddNewRoom">
                                <i class="bi bi-plus-circle-fill"></i>
                                <span>Add Rental Category / Tier</span>
                            </button>
                        </div>
                    </div>

                    <div class="row g-3 mb-4">
                        @foreach (var room in _editableRooms)
                        {
                            <div class="col-lg-6">
                                <div class="card border rounded-4 p-3 h-100 shadow-sm bg-white position-relative">
                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <div class="flex-grow-1 me-2">
                                            <input type="text" class="form-control form-control-lg fw-bold text-dark border-0 bg-light mb-1" placeholder="Category Name (e.g. Function Hall - Standard Rate)" @bind="room.Name" />
                                            <input type="text" class="form-control form-control-sm border-0 text-muted" placeholder="Description / subtitle (e.g. Standard event rental rate)" @bind="room.Description" />
                                        </div>
                                        <button type="button" class="btn btn-outline-danger btn-sm rounded-circle p-2" title="Remove Category" @onclick="() => RemoveRoom(room)" disabled="@(_editableRooms.Count <= 1)">
                                            <i class="bi bi-trash3"></i>
                                        </button>
                                    </div>

                                    <div class="row g-2 mt-2 pt-2 border-top">
                                        <div class="col-4">
                                            <label class="form-label small text-muted mb-1"><i class="bi bi-people me-1"></i>Max Guests</label>
                                            <input type="number" class="form-control form-control-sm text-center fw-bold" @bind="room.Capacity" />
                                        </div>
                                        <div class="col-4">
                                            <label class="form-label small text-success fw-semibold mb-1"><i class="bi bi-tag-fill me-1"></i>Non-Member</label>
                                            <div class="input-group input-group-sm">
                                                <span class="input-group-text bg-success bg-opacity-10 text-success fw-bold">$</span>
                                                <input type="number" class="form-control text-center fw-bold" @bind="room.NonMemberRate" />
                                            </div>
                                        </div>
                                        <div class="col-4">
                                            <label class="form-label small text-primary fw-semibold mb-1"><i class="bi bi-star-fill me-1"></i>Member Rate</label>
                                            <div class="input-group input-group-sm">
                                                <span class="input-group-text bg-primary bg-opacity-10 text-primary fw-bold">$</span>
                                                <input type="number" class="form-control text-center fw-bold" @bind="room.MemberRate" />
                                            </div>
                                        </div>
                                    </div>

                                    <div class="d-flex justify-content-between align-items-center mt-3 pt-2 border-top">
                                        @if (room.IsDefault)
                                        {
                                            <span class="badge bg-primary text-white py-1 px-3 rounded-pill small">
                                                <i class="bi bi-star-fill text-warning me-1"></i>Default Selected Category on Form
                                            </span>
                                        }
                                        else
                                        {
                                            <button type="button" class="btn btn-sm btn-link text-decoration-none text-muted p-0 small" @onclick="() => SetDefaultRoom(room)">
                                                <i class="bi bi-star me-1 text-secondary"></i>Set as Default Form Selection
                                            </button>
                                        }
                                        <small class="text-muted">ID: @room.Id</small>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                    <!-- Add-on Services Management -->
                    <div class="d-flex justify-content-between align-items-center mb-3 mt-4">
                        <div>
                            <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-patch-plus-fill text-primary me-2"></i>Add-on Services &amp; Amenities</h5>
                            <small class="text-muted">Optional services applicants can request during booking</small>
                        </div>
                        <button type="button" class="btn btn-outline-primary btn-sm px-3 shadow-sm d-flex align-items-center gap-1" @onclick="AddNewAddon">
                            <i class="bi bi-plus-lg"></i>
                            <span>Add New Amenity</span>
                        </button>
                    </div>

                    <div class="row g-3">
                        @foreach (var addon in _editableAddons)
                        {
                            var isBarService = addon.Id == "addon_bar" || addon.Name.Contains("Bar", StringComparison.OrdinalIgnoreCase);
                            <div class="col-lg-4 col-md-6">
                                <div class="card border rounded-4 p-3 h-100 shadow-sm bg-white d-flex flex-column">
                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <div class="flex-grow-1 me-2">
                                            <div class="d-flex align-items-center gap-1 mb-1">
                                                @if (isBarService)
                                                {
                                                    <span class="badge bg-warning text-dark border border-warning px-2 py-0 small" style="font-size: 0.65rem;">
                                                        <i class="bi bi-cup-straw me-1"></i>BAR / ALCOHOL
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-light text-secondary border px-2 py-0 small" style="font-size: 0.65rem;">
                                                        ADD-ON
                                                    </span>
                                                }
                                            </div>
                                            <input type="text" class="form-control fw-bold border-0 bg-light" placeholder="Service Name (e.g. Bar Service)" @bind="addon.Name" />
                                        </div>
                                        <button type="button" class="btn btn-outline-danger btn-sm rounded-circle p-1" title="Remove Amenity" @onclick="() => RemoveAddon(addon)">
                                            <i class="bi bi-x-lg"></i>
                                        </button>
                                    </div>
                                    <div class="mb-2 flex-grow-1">
                                        <label class="form-label small text-muted mb-1" style="font-size: 0.72rem;">Description &amp; Policy Notice:</label>
                                        <textarea class="form-control form-control-sm border-0 bg-light text-secondary" rows="4" placeholder="Description or rules presented to applicants..." @bind="addon.Description" style="font-size: 0.8rem; line-height: 1.4;"></textarea>
                                    </div>
                                    <div class="d-flex justify-content-between align-items-center pt-2 border-top mt-auto">
                                        <small class="text-muted" style="font-size: 0.7rem;">ID: @addon.Id</small>
                                        <div class="input-group input-group-sm" style="max-width: 140px;">
                                            <span class="input-group-text bg-light fw-semibold">$ Fee</span>
                                            <input type="number" class="form-control fw-bold text-end" @bind="addon.Fee" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }

            @* ========================================================================= *@
            @* TAB 2: DAY SCHEDULES & TIME SLOTS *@
            @* ========================================================================= *@
            @if (string.Equals(_activeTab, "schedule_slots", StringComparison.OrdinalIgnoreCase))
            {
                <div class="tab-pane-card animate-fade-in">
                    <div class="card border rounded-4 p-4 mb-4 bg-white shadow-sm">
                        <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                            <div>
                                <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-calendar-week text-primary me-2"></i>Day-of-Week Schedule &amp; Dynamic Time Slot Periods</h5>
                                <p class="text-muted small mb-0 mt-1">Configure rental availability, allowed rooms, and multi-period time slots (e.g. Morning 8am-12pm &amp; Evening 2pm-8pm) for each day of the week.</p>
                            </div>
                            <div class="d-flex gap-2">
                                <button type="button" class="btn btn-sm btn-outline-primary shadow-sm" @onclick="ResetDaySchedulesToDefault">
                                    <i class="bi bi-arrow-counterclockwise me-1"></i>Reset to Standard Week
                                </button>
                            </div>
                        </div>

                        <div class="d-flex flex-column gap-3">
                            @foreach (var day in _editableDaySchedules)
                            {
                                var warningMsg = GetSlotValidationWarning(day);
                                <div class="card border rounded-4 p-3 shadow-sm @(day.IsAvailable ? "bg-white border-primary-subtle" : "bg-light opacity-75")">
                                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 pb-2 border-bottom">
                                        <div class="d-flex align-items-center gap-3">
                                            <div class="form-check form-switch mb-0">
                                                <input class="form-check-input" type="checkbox" role="switch" id="@($"day_toggle_{day.DayOfWeek}")" @bind="day.IsAvailable" />
                                            </div>
                                            <div>
                                                <h6 class="fw-bold mb-0 text-dark @(!day.IsAvailable ? "text-decoration-line-through text-muted" : "")">
                                                    @day.DayOfWeek
                                                </h6>
                                                <small class="text-muted">@(day.IsAvailable ? "Available for Public Bookings" : "Closed / Unavailable for Rentals")</small>
                                            </div>
                                        </div>

                                        @if (day.IsAvailable)
                                        {
                                            <div class="d-flex align-items-center gap-2">
                                                <button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => AddSlotToDay(day)">
                                                    <i class="bi bi-plus-circle me-1"></i>Add Time Slot
                                                </button>
                                            </div>
                                        }
                                    </div>

                                    @if (day.IsAvailable)
                                    {
                                        @if (_webSettings?.UseLegacyPricingEngine != false)
                                        {
                                            <!-- Allowed Rooms Selection for this day (Legacy Mode) -->
                                            <div class="pt-2 pb-3 border-bottom">
                                                <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-2">
                                                    <div class="d-flex align-items-center gap-2">
                                                        <span class="small fw-bold text-dark"><i class="bi bi-door-open-fill text-primary me-1"></i>Allowed Rooms on @day.DayOfWeek:</span>
                                                        <span class="badge bg-secondary bg-opacity-10 text-dark border small px-2">Click badge to toggle</span>
                                                    </div>
                                                    <div class="d-flex gap-2">
                                                        <button type="button" class="btn btn-link btn-sm text-primary p-0 text-decoration-none small" style="font-size: 0.75rem;" @onclick="() => EnableAllRoomsForDay(day)">
                                                            <i class="bi bi-check-all me-1"></i>Enable All
                                                        </button>
                                                        <span class="text-muted small">|</span>
                                                        <button type="button" class="btn btn-link btn-sm text-secondary p-0 text-decoration-none small" style="font-size: 0.75rem;" @onclick="() => DisableAllRoomsForDay(day)">
                                                            <i class="bi bi-slash-circle me-1"></i>Disable All
                                                        </button>
                                                    </div>
                                                </div>
                                                <div class="d-flex flex-wrap gap-2">
                                                    @foreach (var room in _editableRooms)
                                                    {
                                                        var isRoomActive = IsRoomAllowedForDay(day, room.Name);
                                                        <button type="button" 
                                                                class="btn btn-sm d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill @(isRoomActive ? "btn-success shadow-sm border-success text-white fw-bold" : "btn-light border border-secondary-subtle text-muted")"
                                                                style="cursor: pointer; transition: all 0.15s ease-in-out;"
                                                                title="@(isRoomActive ? $"Click to disable {room.Name} on {day.DayOfWeek}" : $"Click to allow {room.Name} on {day.DayOfWeek}")"
                                                                @onclick="() => ToggleRoomForDay(day, room.Name)">
                                                            @if (isRoomActive)
                                                            {
                                                                <i class="bi bi-check-circle-fill text-white fs-6"></i>
                                                                <span>@room.Name</span>
                                                                <span class="badge bg-white text-success rounded-pill px-2 py-0" style="font-size: 0.7rem; letter-spacing: 0.5px;">ALLOWED</span>
                                                            }
                                                            else
                                                            {
                                                                <i class="bi bi-x-circle text-danger fs-6"></i>
                                                                <span class="text-muted text-decoration-line-through">@room.Name</span>
                                                                <span class="badge bg-secondary text-white rounded-pill px-2 py-0" style="font-size: 0.7rem; letter-spacing: 0.5px;">DISABLED</span>
                                                            }
                                                        </button>
                                                    }
                                                </div>
                                            </div>
                                        }

                                        <div class="pt-3">
                                            <div class="row g-2 align-items-center">
                                                @if (day.Slots.Count == 0)
                                                {
                                                    <div class="col-12">
                                                        <div class="p-2 bg-light rounded text-muted small d-flex justify-content-between align-items-center">
                                                            <span><i class="bi bi-clock me-1"></i>Open Booking: Applicant selects any valid start &amp; end time up to max duration limit.</span>
                                                            <button type="button" class="btn btn-sm btn-link text-primary p-0" @onclick="() => AddSlotToDay(day)">+ Define Specific Time Slots (e.g. 8am-12pm, 2pm-8pm)</button>
                                                        </div>
                                                    </div>
                                                }
                                                else
                                                {
                                                    @for (int sIdx = 0; sIdx < day.Slots.Count; sIdx++)
                                                    {
                                                        var slot = day.Slots[sIdx];
                                                        var currentSlotIdx = sIdx;
                                                        <div class="col-lg-6">
                                                            <div class="p-2 bg-light rounded-3 border d-flex align-items-center justify-content-between gap-2">
                                                                <div class="d-flex align-items-center gap-2 flex-grow-1">
                                                                    <span class="badge bg-primary rounded-pill text-nowrap">Slot #@(currentSlotIdx + 1)</span>
                                                                    <input type="text" class="form-control form-control-sm fw-bold" placeholder="Slot Label" style="min-width: 140px; flex: 1 1 auto;" @bind="slot.Label" />
                                                                    <select class="form-select form-select-sm fw-semibold" style="width: 130px; flex-shrink: 0;" @bind="slot.StartTime">
                                                                        @foreach (var t in _timeOptions)
                                                                        {
                                                                            <option value="@t">@t</option>
                                                                        }
                                                                    </select>
                                                                    <span class="text-muted small px-1">to</span>
                                                                    <select class="form-select form-select-sm fw-semibold" style="width: 130px; flex-shrink: 0;" @bind="slot.EndTime">
                                                                        @foreach (var t in _timeOptions)
                                                                        {
                                                                            <option value="@t">@t</option>
                                                                        }
                                                                    </select>
                                                                </div>
                                                                <button type="button" class="btn btn-outline-danger btn-sm p-1 rounded-circle" title="Remove Time Slot" @onclick="() => RemoveSlotFromDay(day, currentSlotIdx)">
                                                                    <i class="bi bi-trash3"></i>
                                                                </button>
                                                            </div>
                                                        </div>
                                                    }
                                                }
                                            </div>

                                            @if (!string.IsNullOrEmpty(warningMsg))
                                            {
                                                <div class="alert alert-danger py-2 px-3 mt-2 mb-0 small d-flex align-items-center gap-2 rounded-3 border-danger shadow-sm">
                                                    <i class="bi bi-exclamation-triangle-fill text-danger fs-6"></i>
                                                    <span class="fw-semibold">@warningMsg</span>
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }

            @* ========================================================================= *@
            @* TAB: TIER & DAY MATRIX PRICING (MATRIX ENGINE) *@
            @* ========================================================================= *@
            @if (string.Equals(_activeTab, "matrix_tiers", StringComparison.OrdinalIgnoreCase))
            {
                <div class="tab-pane-card animate-fade-in">
                    <div class="card border rounded-4 p-4 mb-4 bg-white shadow-sm">
                        <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                            <div>
                                <div class="d-flex align-items-center gap-2">
                                    <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-grid-3x3-gap-fill text-warning me-2"></i>Tier &amp; Day Matrix Rate Configuration</h5>
                                    <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-2 py-1 small fw-bold">Active Engine</span>
                                </div>
                                <p class="text-muted small mb-0 mt-1">Configure pricing tiers (Non-Members, Members, Non-Profits), per-day rental rates, and renter-type associations matching the Pricing Guide Chart.</p>
                            </div>
                            <div class="d-flex gap-2">
                                <button type="button" class="btn btn-sm btn-outline-secondary shadow-sm" @onclick="ResetTierCardsToDefault">
                                    <i class="bi bi-arrow-counterclockwise me-1"></i>Reset to Standard 3-Column Preset
                                </button>
                                <button type="button" class="btn btn-sm btn-primary shadow-sm" @onclick="AddNewTierCard">
                                    <i class="bi bi-plus-circle me-1"></i>Add Pricing Tier Card
                                </button>
                            </div>
                        </div>

                        <!-- 3-Column / Responsive Grid matching image -->
                        <div class="row g-4">
                            @foreach (var card in _editableTierCards)
                            {
                                var currentCard = card;
                                <div class="col-lg-4 col-md-6">
                                    <div class="card border rounded-4 overflow-hidden shadow-sm h-100 bg-white" style="border-top: 5px solid @currentCard.ThemeColor !important;">
                                        <!-- Header Banner -->
                                        <div class="p-3 text-center border-bottom" style="background: rgba(15, 23, 42, 0.02);">
                                            <div class="d-flex justify-content-between align-items-center mb-2">
                                                <div class="d-flex align-items-center gap-1">
                                                    <input type="color" class="form-control form-control-color p-0 border-0" style="width: 22px; height: 22px; cursor: pointer;" @bind="currentCard.ThemeColor" title="Choose Accent Color" />
                                                    <span class="badge bg-light text-dark border small" style="font-size: 0.7rem;">Theme</span>
                                                </div>
                                                <div class="d-flex align-items-center gap-1">
                                                    <div class="form-check form-switch mb-0">
                                                        <input class="form-check-input" type="checkbox" role="switch" @bind="currentCard.IsEnabled" title="Enable/Disable this Tier" />
                                                    </div>
                                                    @if (_editableTierCards.Count > 1)
                                                    {
                                                        <button type="button" class="btn btn-outline-danger btn-sm p-1 rounded-circle" style="width: 26px; height: 26px; line-height: 1;" title="Delete Card" @onclick="() => RemoveTierCard(currentCard)">
                                                            <i class="bi bi-trash3" style="font-size: 0.75rem;"></i>
                                                        </button>
                                                    }
                                                </div>
                                            </div>

                                            <input type="text" class="form-control form-control-sm text-center fw-bold fs-6 text-dark border-0 bg-transparent mb-1" style="letter-spacing: 0.5px;" @bind="currentCard.Title" placeholder="TIER TITLE" />
                                            <input type="text" class="form-control form-control-sm text-center text-muted border-0 bg-transparent small p-0" @bind="currentCard.Subtitle" placeholder="Subtitle / Description" />
                                        </div>

                                        <!-- Card Body: Rates & Days Grid -->
                                        <div class="p-3 d-flex flex-column gap-2">
                                            <!-- Associated Renter Type Selector -->
                                            <div class="p-2 rounded-3 bg-light border mb-1">
                                                <label class="form-label small text-muted fw-semibold mb-1 d-block" style="font-size: 0.72rem;">ASSOCIATED RENTER TYPE</label>
                                                <select class="form-select form-select-sm fw-semibold" @bind="currentCard.AssociatedRenterType">
                                                    <option value="Non-Member">Non-Member</option>
                                                    <option value="Member">GFC Member</option>
                                                    <option value="NonProfit">Non-Profit / Charity</option>
                                                    <option value="Custom">Custom Group / Other</option>
                                                </select>
                                            </div>

                                            <!-- Day Rates Table -->
                                            <div class="table-responsive">
                                                <table class="table table-sm align-middle mb-0">
                                                    <thead class="table-light">
                                                        <tr style="font-size: 0.75rem;">
                                                            <th>Day of Week</th>
                                                            <th style="width: 65px;" class="text-center">Avail</th>
                                                            <th style="width: 110px;" class="text-end">Rate ($)</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        <!-- Monday -->
                                                        <tr>
                                                            <td class="fw-semibold text-dark small">Monday</td>
                                                            <td class="text-center">
                                                                <div class="form-check form-switch d-inline-block mb-0">
                                                                    <input class="form-check-input" type="checkbox" role="switch" @bind="currentCard.MondayAvailable" />
                                                                </div>
                                                            </td>
                                                            <td class="text-end">
                                                                <div class="input-group input-group-sm">
                                                                    <span class="input-group-text bg-light text-muted p-1">$</span>
                                                                    <input type="number" class="form-control text-end fw-bold p-1 @(!currentCard.MondayAvailable ? "text-muted bg-light opacity-50" : "text-dark")" disabled="@(!currentCard.MondayAvailable)" @bind="currentCard.MondayRate" />
                                                                </div>
                                                            </td>
                                                        </tr>
                                                        <!-- Tuesday -->
                                                        <tr>
                                                            <td class="fw-semibold text-dark small">Tuesday</td>
                                                            <td class="text-center">
                                                                <div class="form-check form-switch d-inline-block mb-0">
                                                                    <input class="form-check-input" type="checkbox" role="switch" @bind="currentCard.TuesdayAvailable" />
                                                                </div>
                                                            </td>
                                                            <td class="text-end">
                                                                <div class="input-group input-group-sm">
                                                                    <span class="input-group-text bg-light text-muted p-1">$</span>
                                                                    <input type="number" class="form-control text-end fw-bold p-1 @(!currentCard.TuesdayAvailable ? "text-muted bg-light opacity-50" : "text-dark")" disabled="@(!currentCard.TuesdayAvailable)" @bind="currentCard.TuesdayRate" />
                                                                </div>
                                                            </td>
                                                        </tr>
                                                        <!-- Wednesday -->
                                                        <tr>
                                                            <td class="fw-semibold text-dark small">Wednesday</td>
                                                            <td class="text-center">
                                                                <div class="form-check form-switch d-inline-block mb-0">
                                                                    <input class="form-check-input" type="checkbox" role="switch" @bind="currentCard.WednesdayAvailable" />
                                                                </div>
                                                            </td>
                                                            <td class="text-end">
                                                                <div class="input-group input-group-sm">
                                                                    <span class="input-group-text bg-light text-muted p-1">$</span>
                                                                    <input type="number" class="form-control text-end fw-bold p-1 @(!currentCard.WednesdayAvailable ? "text-muted bg-light opacity-50" : "text-dark")" disabled="@(!currentCard.WednesdayAvailable)" @bind="currentCard.WednesdayRate" />
                                                                </div>
                                                            </td>
                                                        </tr>
                                                        <!-- Thursday -->
                                                        <tr>
                                                            <td class="fw-semibold text-dark small">Thursday</td>
                                                            <td class="text-center">
                                                                <div class="form-check form-switch d-inline-block mb-0">
                                                                    <input class="form-check-input" type="checkbox" role="switch" @bind="currentCard.ThursdayAvailable" />
                                                                </div>
                                                            </td>
                                                            <td class="text-end">
                                                                <div class="input-group input-group-sm">
                                                                    <span class="input-group-text bg-light text-muted p-1">$</span>
                                                                    <input type="number" class="form-control text-end fw-bold p-1 @(!currentCard.ThursdayAvailable ? "text-muted bg-light opacity-50" : "text-dark")" disabled="@(!currentCard.ThursdayAvailable)" @bind="currentCard.ThursdayRate" />
                                                                </div>
                                                            </td>
                                                        </tr>
                                                        <!-- Friday -->
                                                        <tr>
                                                            <td class="fw-semibold text-dark small">Friday</td>
                                                            <td class="text-center">
                                                                <div class="form-check form-switch d-inline-block mb-0">
                                                                    <input class="form-check-input" type="checkbox" role="switch" @bind="currentCard.FridayAvailable" />
                                                                </div>
                                                            </td>
                                                            <td class="text-end">
                                                                <div class="input-group input-group-sm">
                                                                    <span class="input-group-text bg-light text-muted p-1">$</span>
                                                                    <input type="number" class="form-control text-end fw-bold p-1 @(!currentCard.FridayAvailable ? "text-muted bg-light opacity-50" : "text-dark")" disabled="@(!currentCard.FridayAvailable)" @bind="currentCard.FridayRate" />
                                                                </div>
                                                            </td>
                                                        </tr>
                                                        <!-- Saturday -->
                                                        <tr>
                                                            <td class="fw-semibold text-dark small">Saturday</td>
                                                            <td class="text-center">
                                                                <div class="form-check form-switch d-inline-block mb-0">
                                                                    <input class="form-check-input" type="checkbox" role="switch" @bind="currentCard.SaturdayAvailable" />
                                                                </div>
                                                            </td>
                                                            <td class="text-end">
                                                                <div class="input-group input-group-sm">
                                                                    <span class="input-group-text bg-light text-muted p-1">$</span>
                                                                    <input type="number" class="form-control text-end fw-bold p-1 @(!currentCard.SaturdayAvailable ? "text-muted bg-light opacity-50" : "text-dark")" disabled="@(!currentCard.SaturdayAvailable)" @bind="currentCard.SaturdayRate" />
                                                                </div>
                                                            </td>
                                                        </tr>
                                                        <!-- Sunday -->
                                                        <tr>
                                                            <td class="fw-semibold text-dark small">Sunday</td>
                                                            <td class="text-center">
                                                                <div class="form-check form-switch d-inline-block mb-0">
                                                                    <input class="form-check-input" type="checkbox" role="switch" @bind="currentCard.SundayAvailable" />
                                                                </div>
                                                            </td>
                                                            <td class="text-end">
                                                                <div class="input-group input-group-sm">
                                                                    <span class="input-group-text bg-light text-muted p-1">$</span>
                                                                    <input type="number" class="form-control text-end fw-bold p-1 @(!currentCard.SundayAvailable ? "text-muted bg-light opacity-50" : "text-dark")" disabled="@(!currentCard.SundayAvailable)" @bind="currentCard.SundayRate" />
                                                                </div>
                                                            </td>
                                                        </tr>
                                                    </tbody>
                                                </table>
                                            </div>

                                            <!-- Special Sub-Groups (Optional) -->
                                            @if (currentCard.SubGroups.Count > 0)
                                            {
                                                <div class="pt-2 border-top">
                                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                                        <span class="small fw-bold text-muted" style="font-size: 0.7rem;">SPECIAL SUB-GROUPS / CAUSES</span>
                                                    </div>
                                                    @foreach (var sub in currentCard.SubGroups)
                                                    {
                                                        var curSub = sub;
                                                        <div class="d-flex align-items-center gap-1 mb-1">
                                                            <input type="text" class="form-control form-control-sm p-1" style="font-size: 0.75rem;" @bind="curSub.Name" placeholder="Group Name" />
                                                            <div class="input-group input-group-sm" style="width: 90px;">
                                                                <span class="input-group-text p-1 text-muted">$</span>
                                                                <input type="number" class="form-control text-end fw-bold p-1" style="font-size: 0.75rem;" @bind="curSub.Rate" />
                                                            </div>
                                                            <button type="button" class="btn btn-outline-danger btn-sm p-0 rounded-circle" style="width: 20px; height: 20px; line-height: 1;" @onclick="() => currentCard.SubGroups.Remove(curSub)">
                                                                <i class="bi bi-x" style="font-size: 0.75rem;"></i>
                                                            </button>
                                                        </div>
                                                    }
                                                </div>
                                            }

                                            <!-- Dedicated Time Slot Blocks for this Tier (Optional) -->
                                            <div class="pt-2 border-top">
                                                <div class="d-flex justify-content-between align-items-center mb-1">
                                                    <span class="small fw-bold text-muted" style="font-size: 0.7rem;"><i class="bi bi-clock-history me-1 text-primary"></i>TIME SLOT PERIODS</span>
                                                    <button type="button" class="btn btn-link btn-sm p-0 text-decoration-none small" style="font-size: 0.72rem;" @onclick="() => AddSlotToTierCard(currentCard)">
                                                        <i class="bi bi-plus-circle me-1"></i>Add Slot
                                                    </button>
                                                </div>
                                                @if (currentCard.TimeSlots.Count == 0)
                                                {
                                                    <div class="p-2 rounded bg-light border text-muted small" style="font-size: 0.72rem;">
                                                        <i class="bi bi-info-circle me-1"></i>Standard duration booking (no fixed slots). Click +Add Slot to define specific blocks (e.g. 12pm-5pm).
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div class="d-flex flex-column gap-1">
                                                        @for (int slotIdx = 0; slotIdx < currentCard.TimeSlots.Count; slotIdx++)
                                                        {
                                                            var s = currentCard.TimeSlots[slotIdx];
                                                            var idx = slotIdx;
                                                            <div class="d-flex align-items-center gap-1 p-1 bg-light rounded border">
                                                                <input type="text" class="form-control form-control-sm p-1 fw-semibold" style="font-size: 0.75rem; min-width: 80px;" placeholder="Label" @bind="s.Label" />
                                                                <select class="form-select form-select-sm p-1" style="font-size: 0.72rem; width: 95px;" @bind="s.StartTime">
                                                                    @foreach (var t in _timeOptions)
                                                                    {
                                                                        <option value="@t">@t</option>
                                                                    }
                                                                </select>
                                                                <span class="text-muted small" style="font-size: 0.7rem;">-</span>
                                                                <select class="form-select form-select-sm p-1" style="font-size: 0.72rem; width: 95px;" @bind="s.EndTime">
                                                                    @foreach (var t in _timeOptions)
                                                                    {
                                                                        <option value="@t">@t</option>
                                                                    }
                                                                </select>
                                                                <button type="button" class="btn btn-outline-danger btn-sm p-0 rounded-circle ms-auto" style="width: 20px; height: 20px; line-height: 1;" title="Remove Slot" @onclick="() => currentCard.TimeSlots.RemoveAt(idx)">
                                                                    <i class="bi bi-x" style="font-size: 0.75rem;"></i>
                                                                </button>
                                                            </div>
                                                        }
                                                    </div>
                                                }
                                            </div>

                                            <div class="mt-1">
                                                <button type="button" class="btn btn-link btn-sm p-0 text-decoration-none small" style="font-size: 0.75rem;" @onclick="() => AddSubGroupToCard(currentCard)">
                                                    <i class="bi bi-plus-circle me-1"></i>Add Special Sub-Group
                                                </button>
                                            </div>

                                            <!-- Footer Note -->
                                            <div class="pt-2 border-top mt-1">
                                                <label class="form-label small text-muted mb-1" style="font-size: 0.7rem;">FOOTER / TERMS CAPTION</label>
                                                <input type="text" class="form-control form-control-sm text-center text-muted small" @bind="currentCard.FooterNote" placeholder="e.g. Standard Booking T&C" />
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>

                        <!-- Base Duration & Overtime Rules in Matrix Mode -->
                        <div class="card border rounded-4 p-4 mb-4 bg-white shadow-sm">
                            <h5 class="fw-bold text-dark mb-3"><i class="bi bi-clock-history text-primary me-2"></i>Base Rental Duration &amp; Overtime Rules</h5>
                            <div class="row g-4">
                                <div class="col-md-3">
                                    <label class="form-label fw-semibold text-dark small mb-1">Standard Function Duration</label>
                                    <div class="input-group">
                                        <input type="number" class="form-control fw-bold" @bind="_webSettings.BaseFunctionHours" min="1" max="24" />
                                        <span class="input-group-text bg-light text-muted">Hours</span>
                                    </div>
                                    <small class="text-muted">Standard event time included in base rate.</small>
                                </div>

                                <div class="col-md-3">
                                    <label class="form-label fw-semibold text-dark small mb-1">Allow Extra / Overtime Hours?</label>
                                    <div class="d-flex p-1 bg-light rounded-pill border mb-1">
                                        <button type="button" class="btn btn-sm rounded-pill flex-fill py-1 px-2 @(_webSettings.AllowAdditionalHours ? "btn-primary fw-bold shadow-sm" : "btn-light text-muted border-0")" @onclick="() => _webSettings.AllowAdditionalHours = true">Enabled</button>
                                        <button type="button" class="btn btn-sm rounded-pill flex-fill py-1 px-2 @(!_webSettings.AllowAdditionalHours ? "btn-dark fw-bold shadow-sm" : "btn-light text-muted border-0")" @onclick="() => _webSettings.AllowAdditionalHours = false">Disabled</button>
                                    </div>
                                    <small class="text-muted">@(_webSettings.AllowAdditionalHours ? "Applicants can book additional hours." : $"Strictly limited to {_webSettings.BaseFunctionHours ?? 5} hours max.")</small>
                                </div>

                                <div class="col-md-3">
                                    <label class="form-label fw-semibold text-dark small mb-1">Additional Hour Rate</label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light text-muted">$</span>
                                        <input type="number" class="form-control fw-bold" @bind="_webSettings.AdditionalHourRate" disabled="@(!_webSettings.AllowAdditionalHours)" />
                                        <span class="input-group-text bg-light text-muted">/ hr</span>
                                    </div>
                                    <small class="text-muted">Rate charged per extra hour over standard.</small>
                                </div>

                                <div class="col-md-3">
                                    <label class="form-label fw-semibold text-dark small mb-1">Maximum Total Duration</label>
                                    <div class="input-group">
                                        <input type="number" class="form-control fw-bold" @bind="_webSettings.MaxHallRentalDurationHours" min="1" max="24" disabled="@(!_webSettings.AllowAdditionalHours)" />
                                        <span class="input-group-text bg-light text-muted">Hours</span>
                                    </div>
                                    <small class="text-muted">Hard cap limit for rental applications.</small>
                                </div>

                                <div class="col-12 mt-2 pt-2 border-top">
                                    <div class="row align-items-center">
                                        <div class="col-md-6 col-lg-4">
                                            <label class="form-label fw-semibold text-dark small mb-1">Refundable Security Deposit</label>
                                            <div class="input-group">
                                                <span class="input-group-text bg-light text-muted">$</span>
                                                <input type="number" class="form-control fw-bold" @bind="_webSettings.SecurityDepositAmount" />
                                            </div>
                                            <small class="text-muted">Deposit required upon contract signing.</small>
                                        </div>
                                        <div class="col-md-6 col-lg-8">
                                            <div class="form-check mt-3">
                                                <input class="form-check-input" type="checkbox" id="depToggleMatrix" @bind="_webSettings.RequireSecurityDeposit" />
                                                <label class="form-check-label fw-semibold text-dark small" for="depToggleMatrix">Require security deposit on public booking applications</label>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Add-on Services & Amenities Management in Matrix Mode -->
                        <div class="card border rounded-4 p-4 mb-4 bg-white shadow-sm">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <div>
                                    <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-patch-plus-fill text-primary me-2"></i>Add-on Services &amp; Amenities</h5>
                                    <small class="text-muted">Configure optional add-ons and services applicants can select during booking (Bar, Kitchen, AV, etc.)</small>
                                </div>
                                <button type="button" class="btn btn-outline-primary btn-sm px-3 shadow-sm d-flex align-items-center gap-1" @onclick="AddNewAddon">
                                    <i class="bi bi-plus-lg"></i>
                                    <span>Add New Amenity</span>
                                </button>
                            </div>

                            <div class="row g-3">
                                @foreach (var addon in _editableAddons)
                                {
                                    var isBarService = addon.Id == "addon_bar" || addon.Name.Contains("Bar", StringComparison.OrdinalIgnoreCase);
                                    <div class="col-lg-4 col-md-6">
                                        <div class="card border rounded-4 p-3 h-100 shadow-sm bg-white d-flex flex-column">
                                            <div class="d-flex justify-content-between align-items-start mb-2">
                                                <div class="flex-grow-1 me-2">
                                                    <div class="d-flex align-items-center gap-1 mb-1">
                                                        @if (isBarService)
                                                        {
                                                            <span class="badge bg-warning text-dark border border-warning px-2 py-0 small" style="font-size: 0.65rem;">
                                                                <i class="bi bi-cup-straw me-1"></i>BAR / ALCOHOL
                                                            </span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge bg-light text-secondary border px-2 py-0 small" style="font-size: 0.65rem;">
                                                                ADD-ON
                                                            </span>
                                                        }
                                                    </div>
                                                    <input type="text" class="form-control fw-bold border-0 bg-light" placeholder="Service Name (e.g. Bar Service)" @bind="addon.Name" />
                                                </div>
                                                <button type="button" class="btn btn-outline-danger btn-sm rounded-circle p-1" title="Remove Amenity" @onclick="() => RemoveAddon(addon)">
                                                    <i class="bi bi-x-lg"></i>
                                                </button>
                                            </div>
                                            <div class="mb-2 flex-grow-1">
                                                <label class="form-label small text-muted mb-1" style="font-size: 0.72rem;">Description &amp; Policy Notice:</label>
                                                <textarea class="form-control form-control-sm border-0 bg-light text-secondary" rows="3" placeholder="Description or rules presented to applicants..." @bind="addon.Description" style="font-size: 0.8rem; line-height: 1.4;"></textarea>
                                            </div>
                                            <div class="d-flex justify-content-between align-items-center pt-2 border-top mt-auto">
                                                <small class="text-muted" style="font-size: 0.7rem;">ID: @addon.Id</small>
                                                <div class="input-group input-group-sm" style="max-width: 140px;">
                                                    <span class="input-group-text bg-light fw-semibold">$ Fee</span>
                                                    <input type="number" class="form-control fw-bold text-end" @bind="addon.Fee" />
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }

            @* ========================================================================= *@
            @* TAB 3: GOOGLE CALENDAR INTEGRATION & WRITE API *@
            @* ========================================================================= *@
            @if (string.Equals(_activeTab, "calendar", StringComparison.OrdinalIgnoreCase))
            {
                <div class="tab-pane-card animate-fade-in">
                    <div class="row g-4">
                        <!-- Left Column: Primary iCal Feeds -->
                        <div class="col-lg-7">
                            <div class="card border rounded-4 p-4 shadow-sm bg-white h-100">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <div>
                                        <div class="d-flex align-items-center gap-2">
                                            <i class="bi bi-calendar-range-fill text-primary fs-5"></i>
                                            <h5 class="fw-bold mb-0 text-dark">Availability &amp; Conflict Sync Feeds</h5>
                                        </div>
                                        <small class="text-muted">Reads your Google Calendar (.ics) to automatically block already-booked dates on your public form</small>
                                    </div>
                                    <button class="btn btn-sm btn-primary shadow-sm" type="button" @onclick="AddNewFeed">
                                        <i class="bi bi-plus-lg me-1"></i>Add Calendar Feed
                                    </button>
                                </div>

                                <div class="alert alert-light border py-2 px-3 small rounded-3 mb-3 text-secondary" style="font-size: 0.78rem;">
                                    <i class="bi bi-info-circle-fill text-primary me-1"></i>
                                    <strong>Private Calendar Note:</strong> In Google Calendar, go to <em>Settings &amp; Sharing &gt; Integrate calendar</em> and copy the <strong>"Secret address in iCal format"</strong>. Paste it into the Feed URL box below.
                                </div>

                                @if (_settings.Feeds.Count == 0)
                                {
                                    <div class="text-center py-5 bg-light rounded-4 border">
                                        <i class="bi bi-calendar-plus fs-1 text-muted d-block mb-2"></i>
                                        <p class="text-muted small mb-3">No calendar feeds added yet.</p>
                                        <button class="btn btn-sm btn-primary" @onclick="AddNewFeed">Add Your First Calendar</button>
                                    </div>
                                }
                                else
                                {
                                    @for (int i = 0; i < _settings.Feeds.Count; i++)
                                    {
                                        var index = i;
                                        var feed = _settings.Feeds[index];

                                        <div class="card border rounded-3 p-3 mb-3 bg-light shadow-sm">
                                            <div class="d-flex justify-content-between align-items-center mb-2">
                                                <div class="d-flex align-items-center gap-2">
                                                    <span class="badge rounded-circle p-2" style="background-color: @feed.Color; width: 14px; height: 14px;"> </span>
                                                    <strong class="text-dark">Calendar Feed #@(index + 1)</strong>
                                                    @if (!string.IsNullOrEmpty(feed.LastStatus))
                                                    {
                                                        <span class="badge bg-white text-muted border small">@feed.LastStatus</span>
                                                    }
                                                </div>
                                                <div class="d-flex align-items-center gap-2">
                                                    <div class="form-check form-switch mb-0">
                                                        <input class="form-check-input" type="checkbox" role="switch" @bind="feed.IsEnabled" title="Enable/Disable this calendar" />
                                                    </div>
                                                    <button class="btn btn-sm btn-outline-danger rounded-circle p-1" style="width: 28px; height: 28px;" @onclick="() => PromptDeleteFeed(index)" title="Remove this calendar">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                </div>
                                            </div>

                                            <div class="row g-2">
                                                <div class="col-md-5">
                                                    <label class="form-label small fw-bold text-dark mb-1">Calendar Display Name</label>
                                                    <input type="text" class="form-control form-control-sm" placeholder="e.g. Main Hall Rentals" @bind="feed.Name" />
                                                    <small class="text-muted d-block" style="font-size: 0.72rem;">Internal label for this feed</small>
                                                </div>
                                                <div class="col-md-7">
                                                    <label class="form-label small fw-bold text-dark mb-1">
                                                        <span>iCal URL (Secret or Public .ics)</span>
                                                    </label>
                                                    <div class="input-group input-group-sm">
                                                        <input type="text" class="form-control font-monospace" placeholder="https://calendar.google.com/calendar/ical/.../basic.ics" @bind="feed.Url" />
                                                        <button class="btn btn-outline-primary" type="button" @onclick="() => TestSingleFeed(feed)">
                                                            <i class="bi bi-arrow-repeat me-1"></i>Test Feed
                                                        </button>
                                                    </div>
                                                    <small class="text-muted d-block" style="font-size: 0.72rem;">Google Calendar &gt; Integrate calendar &gt; <em>Secret address in iCal format</em></small>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                }

                                <!-- Auto Sync Options -->
                                <div class="p-3 bg-light rounded-3 border mt-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
                                    <div>
                                        <strong class="text-dark d-block small">Background Auto-Sync</strong>
                                        <span class="text-muted" style="font-size: 0.8rem;">Keep local calendar cache fresh automatically.</span>
                                    </div>
                                    <div class="d-flex align-items-center gap-2">
                                        <select class="form-select form-select-sm" style="width: 160px;" @bind="_settings.SyncIntervalMinutes">
                                            <option value="15">Every 15 Minutes</option>
                                            <option value="30">Every 30 Minutes</option>
                                            <option value="60">Every 1 Hour</option>
                                            <option value="360">Every 6 Hours</option>
                                        </select>
                                        <div class="form-check form-switch mb-0">
                                            <input class="form-check-input" type="checkbox" role="switch" id="syncSw" @bind="_settings.AutoSyncEnabled" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Right Column: 2-Way Google Service Account Write API (Live Production) -->
                        <div class="col-lg-5">
                            <div class="card border rounded-4 p-4 shadow-sm bg-white h-100">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <div class="d-flex align-items-center gap-2">
                                        <i class="bi bi-cloud-arrow-up-fill text-success fs-4"></i>
                                        <h5 class="fw-bold mb-0 text-dark">Live Booking Write API</h5>
                                    </div>
                                    @if (!string.IsNullOrEmpty(_settings.ServiceAccountEmail))
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success px-2 py-1"><i class="bi bi-check-circle-fill me-1"></i>Key Configured</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary border px-2 py-1">Optional</span>
                                    }
                                </div>
                                <p class="small text-muted mb-3">
                                    Directly creates event bookings on your <strong>Google Calendar</strong> via Google Cloud REST API when an application is approved (Live Production Mode).
                                </p>

                                <div class="p-3 bg-light rounded-3 border mb-3">
                                    <label class="form-label small fw-bold text-dark mb-1">
                                        <i class="bi bi-calendar-event me-1 text-primary"></i>Live Google Calendar ID
                                    </label>
                                    <input type="text" class="form-control form-control-sm font-monospace" placeholder="e.g. your-live-calendar@group.calendar.google.com or primary" @bind="_settings.PrimaryGoogleCalendarId" />
                                    <small class="text-muted d-block mt-1" style="font-size: 0.78rem;">Found under Google Calendar Settings &gt; Integrate calendar &gt; <strong>Calendar ID</strong>.</small>
                                </div>

                                <div class="p-3 bg-light rounded-3 border mb-3">
                                    <label class="form-label small fw-bold text-dark mb-1">
                                        <i class="bi bi-key-fill me-1 text-warning"></i>Google Service Account JSON Key
                                    </label>
                                    <InputFile OnChange="HandleServiceAccountKeyUpload" class="form-control form-control-sm" accept=".json" />
                                    
                                    @if (!string.IsNullOrEmpty(_settings.ServiceAccountEmail))
                                    {
                                        <div class="p-2 bg-white rounded border mt-2 small">
                                            <strong class="text-success"><i class="bi bi-shield-check me-1"></i>Service Account Email:</strong>
                                            <div class="font-monospace text-dark text-truncate" style="font-size: 0.8rem;">@_settings.ServiceAccountEmail</div>
                                            <div class="text-muted mt-1" style="font-size: 0.75rem;">
                                                <strong>Required:</strong> Share your Google Calendar with this email and assign permission: <strong>"Make changes to events"</strong>.
                                            </div>
                                        </div>
                                    }
                                </div>

                                <button class="btn btn-outline-primary w-100 py-2 shadow-sm d-flex align-items-center justify-content-center gap-2 fw-bold" type="button" @onclick="TestWriteApiAccess" disabled="@(string.IsNullOrEmpty(_settings.ServiceAccountEmail) || _isTestingWrite)">
                                    @if (_isTestingWrite)
                                    {
                                        <span class="spinner-border spinner-border-sm"></span>
                                        <span>Testing Live Google Calendar API...</span>
                                    }
                                    else
                                    {
                                        <i class="bi bi-check2-circle"></i>
                                        <span>Test Live Google Calendar Write API</span>
                                    }
                                </button>

                                @if (!string.IsNullOrEmpty(_writeTestFeedback))
                                {
                                    <div class="alert @(_writeTestSuccess ? "alert-success" : "alert-danger") d-flex align-items-start gap-2 mt-3 mb-0 py-2 small shadow-sm">
                                        <i class="bi @(_writeTestSuccess ? "bi-check-circle-fill text-success" : "bi-exclamation-triangle-fill text-danger") fs-5 flex-shrink-0"></i>
                                        <div>
                                            <strong>@(_writeTestSuccess ? "API Connection Verified!" : "Connection Issue:")</strong>
                                            <div>@_writeTestFeedback</div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- Full Width Row: Google Calendar Privacy & Field Visibility Controls -->
                        <div class="col-12">
                            <div class="card border rounded-4 p-4 shadow-sm bg-white">
                                <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="p-2 rounded-3 bg-primary bg-opacity-10 text-primary">
                                            <i class="bi bi-shield-lock-fill fs-5"></i>
                                        </div>
                                        <div>
                                            <h5 class="fw-bold mb-0 text-dark">Google Calendar Privacy &amp; Display Control</h5>
                                            <small class="text-muted">Choose exactly what information from rental applications appears on your Google Calendar event</small>
                                        </div>
                                    </div>
                                    <div class="d-flex align-items-center gap-2 flex-wrap">
                                        <div class="btn-group btn-group-sm" role="group">
                                            <button type="button" class="btn btn-outline-primary" @onclick='() => SetCalendarPrivacyPreset("all")'>All Details</button>
                                            <button type="button" class="btn btn-outline-success" @onclick='() => SetCalendarPrivacyPreset("standard")'>Standard Management</button>
                                            <button type="button" class="btn btn-outline-secondary" @onclick='() => SetCalendarPrivacyPreset("privacy")'>Privacy Safe / Public</button>
                                        </div>
                                        <div class="d-flex align-items-center gap-2 ms-2">
                                            <label class="form-label small fw-bold text-dark mb-0 text-nowrap"><i class="bi bi-eye-slash me-1"></i>Privacy Mode:</label>
                                            <select class="form-select form-select-sm fw-semibold" style="width: 170px;" @bind="_settings.GoogleEventVisibility">
                                                <option value="default">Default (Inherited)</option>
                                                <option value="private">🔒 Private (Internal Only)</option>
                                                <option value="public">🌐 Public (Visible)</option>
                                            </select>
                                        </div>
                                    </div>
                                </div>

                                <div class="alert alert-info py-2 px-3 small rounded-3 mb-4 d-flex align-items-center gap-2">
                                    <i class="bi bi-info-circle-fill flex-shrink-0 fs-5"></i>
                                    <div>
                                        <strong>Privacy Control:</strong> Select what form data should sync to Google Calendar. Unchecked items will be kept internal to GFC Studio only.
                                    </div>
                                </div>

                                <div class="row g-3">
                                    <div class="col-md-4">
                                        <div class="p-3 bg-light rounded-3 border h-100">
                                            <div class="form-check form-switch mb-1">
                                                <input class="form-check-input" type="checkbox" role="switch" id="pushNameTitle" @bind="_settings.PushApplicantNameToTitle" />
                                                <label class="form-check-label fw-bold text-dark small" for="pushNameTitle">Applicant Name in Title</label>
                                            </div>
                                            <small class="text-muted d-block">e.g. "PENDING: John Doe (Wedding)" vs "PENDING: Wedding"</small>
                                        </div>
                                    </div>

                                    <div class="col-md-4">
                                        <div class="p-3 bg-light rounded-3 border h-100">
                                            <div class="form-check form-switch mb-1">
                                                <input class="form-check-input" type="checkbox" role="switch" id="pushNameDesc" @bind="_settings.PushApplicantNameToDescription" />
                                                <label class="form-check-label fw-bold text-dark small" for="pushNameDesc">Applicant Name in Description</label>
                                            </div>
                                            <small class="text-muted d-block">Display the applicant / organization name in event notes.</small>
                                        </div>
                                    </div>

                                    <div class="col-md-4">
                                        <div class="p-3 bg-light rounded-3 border h-100">
                                            <div class="form-check form-switch mb-1">
                                                <input class="form-check-input" type="checkbox" role="switch" id="pushPhone" @bind="_settings.PushApplicantPhoneToDescription" />
                                                <label class="form-check-label fw-bold text-dark small" for="pushPhone">Phone Number</label>
                                            </div>
                                            <small class="text-muted d-block">Keep private or show contact phone on the calendar.</small>
                                        </div>
                                    </div>

                                    <div class="col-md-4">
                                        <div class="p-3 bg-light rounded-3 border h-100">
                                            <div class="form-check form-switch mb-1">
                                                <input class="form-check-input" type="checkbox" role="switch" id="pushEmail" @bind="_settings.PushApplicantEmailToDescription" />
                                                <label class="form-check-label fw-bold text-dark small" for="pushEmail">Email Address</label>
                                            </div>
                                            <small class="text-muted d-block">Keep private or show applicant email on the calendar.</small>
                                        </div>
                                    </div>

                                    <div class="col-md-4">
                                        <div class="p-3 bg-light rounded-3 border h-100">
                                            <div class="form-check form-switch mb-1">
                                                <input class="form-check-input" type="checkbox" role="switch" id="pushQuote" @bind="_settings.PushPricingQuoteToDescription" />
                                                <label class="form-check-label fw-bold text-dark small" for="pushQuote">Financial Quote &amp; Price</label>
                                            </div>
                                            <small class="text-muted d-block">Display total calculated price ($) in event description.</small>
                                        </div>
                                    </div>

                                    <div class="col-md-4">
                                        <div class="p-3 bg-light rounded-3 border h-100">
                                            <div class="form-check form-switch mb-1">
                                                <input class="form-check-input" type="checkbox" role="switch" id="pushGuests" @bind="_settings.PushGuestCountToDescription" />
                                                <label class="form-check-label fw-bold text-dark small" for="pushGuests">Guest Attendance Count</label>
                                            </div>
                                            <small class="text-muted d-block">Include estimated guest count in event notes.</small>
                                        </div>
                                    </div>

                                    <div class="col-md-4">
                                        <div class="p-3 bg-light rounded-3 border h-100">
                                            <div class="form-check form-switch mb-1">
                                                <input class="form-check-input" type="checkbox" role="switch" id="pushServices" @bind="_settings.PushServicesToDescription" />
                                                <label class="form-check-label fw-bold text-dark small" for="pushServices">Requested Services</label>
                                            </div>
                                            <small class="text-muted d-block">Include bartender, kitchen, and A/V equipment requests.</small>
                                        </div>
                                    </div>

                                    <div class="col-md-4">
                                        <div class="p-3 bg-light rounded-3 border h-100">
                                            <div class="form-check form-switch mb-1">
                                                <input class="form-check-input" type="checkbox" role="switch" id="pushAddress" @bind="_settings.PushAddressToDescription" />
                                                <label class="form-check-label fw-bold text-dark small" for="pushAddress">Applicant Mailing Address</label>
                                            </div>
                                            <small class="text-muted d-block">Include street address in calendar event notes.</small>
                                        </div>
                                    </div>

                                    <div class="col-md-4">
                                        <div class="p-3 bg-light rounded-3 border h-100">
                                            <div class="form-check form-switch mb-1">
                                                <input class="form-check-input" type="checkbox" role="switch" id="pushNotes" @bind="_settings.PushNotesToDescription" />
                                                <label class="form-check-label fw-bold text-dark small" for="pushNotes">Applicant Notes &amp; Requests</label>
                                            </div>
                                            <small class="text-muted d-block">Include special instructions submitted on the form.</small>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }

            @* ========================================================================= *@
            @* TAB 4: PUBLIC FORM & RULES *@
            @* ========================================================================= *@
            @if (string.Equals(_activeTab, "form_intake", StringComparison.OrdinalIgnoreCase))
            {
                <div class="tab-pane-card animate-fade-in">
                    <div class="row g-4">
                        <div class="col-lg-8">
                            <div class="card border rounded-4 p-4 shadow-sm bg-white mb-4">
                                <h5 class="fw-bold text-dark mb-3"><i class="bi bi-pencil-square text-primary me-2"></i>Public Application Form Content</h5>
                                
                                <div class="mb-3">
                                    <label class="form-label small fw-bold text-dark mb-1">Page / Form Title</label>
                                    <input type="text" class="form-control" @bind="_webSettings.RentalFormTitle" />
                                </div>

                                <div class="mb-3">
                                    <label class="form-label small fw-bold text-dark mb-1">Subtitle / Organization Header</label>
                                    <input type="text" class="form-control" @bind="_webSettings.RentalFormSubtitle" />
                                </div>

                                <div class="mb-3">
                                    <label class="form-label small fw-bold text-dark mb-1">Contact &amp; Location Header Bar</label>
                                    <input type="text" class="form-control" @bind="_webSettings.RentalFormIntroText" />
                                </div>

                                <div class="mb-3">
                                    <label class="form-label small fw-bold text-dark mb-1">Terms &amp; Rental Rules Agreement Text</label>
                                    <textarea class="form-control" rows="4" @bind="_webSettings.RentalFormRulesText"></textarea>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label small fw-bold text-dark mb-1">Submission Success Message</label>
                                    <textarea class="form-control" rows="3" @bind="_webSettings.RentalFormSuccessMessage"></textarea>
                                </div>
                            </div>
                        </div>

                        <div class="col-lg-4">
                            <div class="card border rounded-4 p-4 shadow-sm bg-white mb-4">
                                <h5 class="fw-bold text-dark mb-1"><i class="bi bi-ui-checks-grid text-primary me-2"></i>Form Fields &amp; Requirements</h5>
                                <p class="small text-muted mb-3">Choose whether each field is <strong>Required</strong> or <strong>Optional</strong> for applicants before submitting.</p>
                                
                                <div class="list-group list-group-flush rounded-3 border overflow-hidden">
                                    <!-- Full Name -->
                                    <div class="list-group-item p-3 d-flex justify-content-between align-items-center bg-white">
                                        <div>
                                            <div class="fw-bold text-dark small">Applicant Full Name</div>
                                            <small class="text-muted" style="font-size: 0.75rem;">Identity or Organization</small>
                                        </div>
                                        <div class="d-flex p-1 bg-light rounded-pill border" style="min-width: 170px;">
                                            <button type="button" class="btn btn-sm rounded-pill flex-fill py-1 px-2 @(_webSettings.RequireApplicantName ? "btn-primary fw-bold shadow-sm" : "btn-light text-muted border-0")" @onclick="() => _webSettings.RequireApplicantName = true">Required</button>
