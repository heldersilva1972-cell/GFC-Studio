    private async Task<bool> SaveAllSettingsInternalAsync()
    {
        _isSaving = true;
        _feedbackMessage = null;
        try
        {
            // Strict Validation Rule: At least 1 field must be selected for Google Calendar title, Month Grid, and Schedule List view
            if (_settings.EventTitleFields == null || _settings.EventTitleFields.Count(f => f.IsEnabled) == 0)
            {
                _feedbackSuccess = false;
                _feedbackMessage = "Cannot save: Please select at least one field to display in Google Calendar event titles.";
                ToastService.ShowError("Google Calendar Title requires at least one enabled field.");
                _isSaving = false;
                return false;
            }

            if (_editableMonthFields.Count(f => f.IsEnabled) == 0)
            {
                _feedbackSuccess = false;
                _feedbackMessage = "Cannot save: Please select at least one field to display on the Month Calendar grid cards.";
                ToastService.ShowError("Month Calendar grid requires at least one enabled field.");
                _isSaving = false;
                return false;
            }

            if (_editableListColumns.Count(c => c.IsEnabled) == 0)
            {
                _feedbackSuccess = false;
                _feedbackMessage = "Cannot save: Please select at least one column to display in the Schedule List view table.";
                ToastService.ShowError("Schedule List view requires at least one enabled column.");
                _isSaving = false;
                return false;
            }

            // Validate schedule overlaps on available days
            foreach (var day in _editableDaySchedules.Where(d => d.IsAvailable))
            {
                var warning = GetSlotValidationWarning(day);
                if (!string.IsNullOrEmpty(warning))
                {
                    _feedbackSuccess = false;
                    _feedbackMessage = $"Cannot save: {day.DayOfWeek} has schedule conflicts: {warning}";
                    ToastService.ShowError($"Please fix schedule overlap on {day.DayOfWeek} before saving.");
                    _isSaving = false;
                    return false;
                }
            }

            if (_webSettings != null)
            {
                _webSettings.RoomsJson = System.Text.Json.JsonSerializer.Serialize(_editableRooms);
                _webSettings.AddonsJson = System.Text.Json.JsonSerializer.Serialize(_editableAddons);
                _webSettings.DaySchedulesJson = System.Text.Json.JsonSerializer.Serialize(_editableDaySchedules);
                _webSettings.PoliciesJson = System.Text.Json.JsonSerializer.Serialize(_editablePolicies);
                _webSettings.TierCardsJson = System.Text.Json.JsonSerializer.Serialize(_editableTierCards);
                _webSettings.SetEventTypeLists(_editableEventTypeLists);
                _webSettings.SetModificationReasonPresetsList(_editableReasonPresets);
                _webSettings.SetRecipientsList(_editableRecipients);
                _webSettings.MonthCalendarFields = _editableMonthFields;
                _webSettings.ScheduleListColumns = _editableListColumns;
                await WebsiteSettingsService.UpdateWebsiteSettingsAsync(_webSettings);
            }

            var firstEnabled = _settings.Feeds.FirstOrDefault(f => f.IsEnabled);
            if (firstEnabled != null && string.IsNullOrWhiteSpace(_settings.PublicCalendarUrl))
            {
                _settings.PublicCalendarUrl = firstEnabled.Url;
                _settings.CalendarName = firstEnabled.Name;
            }

            await CalendarService.SaveSettingsAsync(_settings);

            if (_calendarSettings != null)
            {
                await CalendarSettingsService.SaveAsync(_calendarSettings);
            }

            _initialSnapshot = GenerateStateSnapshot();
            _feedbackMessage = "Hall rental, room pricing, day schedules, email triggers, and calendar sync settings saved successfully.";
            _feedbackSuccess = true;
            ToastService.ShowSuccess("All settings updated successfully.");
            return true;
        }
        catch (Exception ex)
        {
            _feedbackSuccess = false;
            var fullDetails = ex.InnerException != null ? $"{ex.Message} --> Inner: {ex.InnerException.Message}" : ex.Message;
            _feedbackMessage = $"Failed to save settings: {fullDetails}";
            ToastService.ShowError($"Error saving settings: {fullDetails}");
            return false;
        }
        finally
        {
            _isSaving = false;
        }
    }

