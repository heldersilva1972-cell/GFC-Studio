                    </div>
                </div>
            }

            @* ========================================================================= *@
            @* TAB 6: 🧪 SANDBOX & TESTING HUB *@
            @* ========================================================================= *@
            @if (string.Equals(_activeTab, "simulator", StringComparison.OrdinalIgnoreCase))
            {
                <div class="tab-pane-card animate-fade-in">
                    <!-- HERO MASTER SAFETY SWITCH -->
                    <div class="card rounded-4 p-4 mb-4 shadow-sm @(_webSettings.EnableSandboxMode ? "border-warning border-2 bg-warning bg-opacity-10" : "border bg-white")">
