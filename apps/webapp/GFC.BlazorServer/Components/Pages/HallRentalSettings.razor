    private string GetGoogleTitlePreview()
    {
        var enabled = _settings.EventTitleFields.Where(f => f.IsEnabled).OrderBy(f => f.Order).ToList();
        if (!enabled.Any()) return "PENDING: (No fields selected - please enable at least 1 field)";

        var segments = new List<string>();
        foreach (var f in enabled)
        {
            switch (f.FieldKey)
            {
                case "applicant_name": segments.Add("Jane Doe"); break;
                case "event_type": segments.Add("Birthday Party"); break;
                case "room_location": segments.Add("Main Function Hall"); break;
                case "time_window": segments.Add("2:00 PM - 7:00 PM"); break;
                case "services":
                    var srvList = new List<string>();
                    if (_settings.PushBarServiceToDescription) srvList.Add(!string.IsNullOrWhiteSpace(_settings.BarServiceCalendarDisplayName) ? _settings.BarServiceCalendarDisplayName : "Bar / Bartender Service");
                    if (_settings.PushKitchenUsageToDescription) srvList.Add(!string.IsNullOrWhiteSpace(_settings.KitchenUsageCalendarDisplayName) ? _settings.KitchenUsageCalendarDisplayName : "Kitchen Access");
                    if (_settings.PushAvEquipmentToDescription) srvList.Add(!string.IsNullOrWhiteSpace(_settings.AvEquipmentCalendarDisplayName) ? _settings.AvEquipmentCalendarDisplayName : "A/V Equipment");
                    if (srvList.Any()) segments.Add(string.Join(", ", srvList));
                    break;
                case "guest_count": segments.Add("75 Guests"); break;
                case "pricing_quote": segments.Add("$450.00"); break;
                case "contact_phone": segments.Add("(978) 555-0123"); break;
                case "contact_email": segments.Add("jane@example.com"); break;
            }
        }
        return $"PENDING: {string.Join(" | ", segments)}";
    }

