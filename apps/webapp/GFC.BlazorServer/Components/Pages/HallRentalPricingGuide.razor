@code {
    private WebsiteSettings? _settings;
    private GfcRateSheetModel? _model;
    private GfcRateSheetModel? _originalModel;
    private bool _isLoading = true;
    private bool _isSaving = false;
    private bool _isEditing = false;
    private bool _showSaveConfirm = false;
    private bool _isEmbedded = false;
    private bool _isAuthenticated = false;

    protected override async Task OnInitializedAsync()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);

        if (query.TryGetValue("embed", out var embedVal) && (embedVal == "true" || embedVal == "1"))
        {
            _isEmbedded = true;
        }

        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            _isAuthenticated = authState.User?.Identity?.IsAuthenticated == true;
        }
        catch
        {
            _isAuthenticated = false;
        }

        await LoadDataAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                await JSRuntime.InvokeVoidAsync("eval", $"if (window.GfcRentalTracker) {{ window.GfcRentalTracker.init('Pricing Guide', {(_isEmbedded ? "true" : "false")}); }}");
            }
            catch { }
        }
    }

    private async Task LoadDataAsync()
    {
        _isLoading = true;
        try
        {
            _settings = await SettingsService.GetWebsiteSettingsAsync();
            _model = _settings.GetRateSheetModel();
            _originalModel = CloneModel(_model);
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Failed to load rate sheet: {ex.Message}");
            _model = GfcRateSheetModel.GetDefault();
            _originalModel = CloneModel(_model);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task ConfirmAndSaveRateSheetAsync()
    {
        _showSaveConfirm = false;
        await SaveRateSheetAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task SaveRateSheetAsync()
    {
        if (_model == null) return;

        // Re-verify authentication state before saving
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            _isAuthenticated = authState.User?.Identity?.IsAuthenticated == true;
        }
        catch { }

        if (!_isAuthenticated)
        {
            ToastService.ShowError("Unauthorized: You must be logged into GFC Studio to save changes.");
            _isEditing = false;
            await InvokeAsync(StateHasChanged);
            return;
        }

        _isSaving = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            _settings ??= await SettingsService.GetWebsiteSettingsAsync();
            _settings.SetRateSheetModel(_model);
            await SettingsService.UpdateWebsiteSettingsAsync(_settings);
            _originalModel = CloneModel(_model);
            _isEditing = false;
            ToastService.ShowSuccess("Pricing guide & rate sheet saved successfully!");
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Failed to save rate sheet: {ex.Message}");
        }
        finally
        {
            _isSaving = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void CancelEditing()
    {
        _showSaveConfirm = false;
        if (_originalModel != null)
        {
            _model = CloneModel(_originalModel);
        }
        _isEditing = false;
    }

    private void ToggleDayAvail(GfcRateDayRow day, int col)
    {
        if (col == 1)
        {
            day.Col1IsUnavailable = !day.Col1IsUnavailable;
            if (day.Col1IsUnavailable) day.Col1Price = "Not Available";
            else day.Col1Price = "$500";
        }
        else if (col == 2)
        {
            day.Col2IsUnavailable = !day.Col2IsUnavailable;
            if (day.Col2IsUnavailable) day.Col2Price = "Not Available";
            else day.Col2Price = "$400";
        }
        else if (col == 3)
        {
            day.Col3IsUnavailable = !day.Col3IsUnavailable;
            if (day.Col3IsUnavailable) day.Col3Price = "Not Available";
            else day.Col3Price = "$150";
        }
    }

    private async Task CopyEmbedSnippet()
    {
        var baseUrl = Navigation.BaseUri.TrimEnd('/');
        var iframeId = "gfc-pricing-guide-frame";
        var snippet = $"<iframe id=\"{iframeId}\" src=\"{baseUrl}/hall-rentals/pricing-guide?embed=true\" width=\"100%\" height=\"950\" frameborder=\"0\" scrolling=\"no\" style=\"width:100%; min-height:950px; border:none; display:block; overflow:hidden;\" title=\"Gloucester Fraternity Club – Hall Rental Pricing Guide\"></iframe>";
        try
        {
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", snippet);
            ToastService.ShowSuccess("WordPress embed code copied to clipboard!");
        }
        catch
        {
            ToastService.ShowInfo($"Embed code ready: {snippet}");
        }
    }

    private void AddBarService()
    {
        if (_model == null) return;
        _model.BarServices.Add(new GfcServiceOptionItem
        {
            Name = "New Bar Option",
            Price = "$100",
            Description = "Description of bar option or beverage service."
        });
    }

    private void RemoveBarService(GfcServiceOptionItem item)
    {
        if (_model == null) return;
        _model.BarServices.Remove(item);
    }

    private void AddAdditionalService()
    {
        if (_model == null) return;
        _model.AdditionalServices.Add(new GfcServiceOptionItem
        {
            Name = "New Additional Service",
            Price = "$100",
            Description = "Description of additional service."
        });
    }

    private void RemoveAdditionalService(GfcServiceOptionItem item)
    {
        if (_model == null) return;
        _model.AdditionalServices.Remove(item);
    }

    private async Task ClosePage()
    {
        try
        {
            // If opened via window.open (e.g. from calendar or external launcher), close it
            var closed = await JSRuntime.InvokeAsync<bool>("eval", @"
                if (window.opener && !window.opener.closed) {
                    window.close();
                    true;
                } else if (history.length > 1) {
                    history.back();
                    true;
                } else {
                    false;
                }
            ");

            if (!closed)
            {
                Navigation.NavigateTo("/hall-rentals");
            }
        }
        catch
        {
            Navigation.NavigateTo("/hall-rentals");
        }
    }

    private static GfcRateSheetModel CloneModel(GfcRateSheetModel src)
    {
        var json = JsonSerializer.Serialize(src);
        return JsonSerializer.Deserialize<GfcRateSheetModel>(json) ?? GfcRateSheetModel.GetDefault();
    }
}
