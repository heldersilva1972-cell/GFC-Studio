@page "/hall-rentals/pricing-guide"
@using GFC.Core.Models
@using GFC.Core.Interfaces
@using GFC.BlazorServer.Components.Shared
@using System.Text.Json
@inject IWebsiteSettingsService SettingsService
@inject NavigationManager Navigation
@inject IToastService ToastService
@layout GFC.BlazorServer.Components.Layout.EmptyLayout
@attribute [Authorize]
@rendermode InteractiveServer

<div class="standalone-pricing-guide-window min-vh-100 bg-light py-3 px-2 px-md-4">
    <div class="mx-auto" style="max-width: 960px;">
        <!-- Clean Standalone Bar -->
        <div class="d-flex justify-content-between align-items-center mb-3 no-print p-2 bg-white rounded-3 border shadow-sm">
            <div class="d-flex align-items-center gap-2">
                <span class="fw-bold text-dark"><i class="bi bi-bar-chart-fill text-primary me-2"></i>GFC Hall Rental Pricing Guide</span>
            </div>
            <button class="btn btn-sm btn-outline-secondary" onclick="window.close()" title="Close Tab">
                <i class="bi bi-x-lg me-1"></i>Close Window
            </button>
        </div>

    @if (_isLoading)
    {
        <div class="text-center py-5 bg-white rounded-4 border shadow-sm">
            <div class="spinner-border text-primary mb-2" role="status"></div>
            <div class="text-muted small">Loading Pricing Guide...</div>
        </div>
    }
    else
    {
        <RentalPricingGuideView Settings="_settings" ShowFullPageLink="false" OnCustomGuideSaved="HandleCustomGuideSaved" />
    }
    </div>
</div>

@code {
    private WebsiteSettings? _settings;
    private bool _isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadSettingsAsync();
    }

    private async Task LoadSettingsAsync()
    {
        _isLoading = true;
        try
        {
            _settings = await SettingsService.GetWebsiteSettingsAsync();
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Failed to load settings: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task HandleCustomGuideSaved(RentalPricingGuideModel model)
    {
        if (_settings != null)
        {
            _settings.PricingGuideJson = JsonSerializer.Serialize(model);
            await SettingsService.UpdateWebsiteSettingsAsync(_settings);
        }
    }
}
