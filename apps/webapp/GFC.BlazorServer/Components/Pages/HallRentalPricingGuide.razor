@page "/hall-rentals/pricing-guide"
@page "/rentals/pricing-guide"
@using GFC.Core.Models
@using GFC.Core.Interfaces
@using GFC.BlazorServer.Services
@using System.Text.Json
@using Microsoft.AspNetCore.WebUtilities
@inject IWebsiteSettingsService SettingsService
@inject NavigationManager Navigation
@inject IToastService ToastService
@inject IJSRuntime JSRuntime
@inject CustomAuthenticationStateProvider AuthStateProvider
@layout GFC.BlazorServer.Components.Layout.EmptyLayout
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@rendermode InteractiveServer

<script src="/js/gfc-rental-tracker.js"></script>

<div class="gfc-rate-sheet-page @(_isEmbedded ? "p-0 bg-transparent" : "min-vh-100 bg-slate-100 py-3 py-md-4 px-2 px-md-3")">
    <div class="mx-auto" style="@(_isEmbedded ? "max-width: 100%;" : "max-width: 900px;")">

        <!-- Top Admin Toolbar (Visible ONLY to authenticated GFC Studio staff, never on public/embeds) -->
        @if (!_isEmbedded && _isAuthenticated)
        {
            <div class="d-flex justify-content-between align-items-center mb-3 p-3 bg-white rounded-4 border shadow-sm no-print flex-wrap gap-2">
                <div class="d-flex align-items-center gap-2">
                    <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 px-2.5 py-1">
                        <i class="bi bi-shield-check me-1"></i>Official Rate Sheet
                    </span>
                    <span class="text-muted small d-none d-sm-inline">Gloucester Fraternity Club</span>
                </div>
                
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    @if (_isEditing)
                    {
                        <button type="button" class="btn btn-sm btn-success fw-bold d-flex align-items-center gap-1.5 shadow-sm px-3" @onclick="() => _showSaveConfirm = true" disabled="@_isSaving">
                            @if (_isSaving)
                            {
                                <span class="spinner-border spinner-border-sm"></span>
                                <span>Saving...</span>
                            }
                            else
                            {
                                <i class="bi bi-check2-circle"></i>
                                <span>Save Changes</span>
                            }
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="CancelEditing">
                            <span>Cancel</span>
                        </button>
                    }
                    else
                    {
                        <button type="button" class="btn btn-sm btn-primary d-flex align-items-center gap-1.5 shadow-sm fw-semibold px-3" @onclick="() => _isEditing = true">
                            <i class="bi bi-pencil-square"></i>
                            <span>Edit Rate Sheet</span>
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-secondary d-flex align-items-center gap-1.5 shadow-sm" @onclick="CopyEmbedSnippet">
                            <i class="bi bi-code-slash text-primary"></i>
                            <span>Copy WP Embed Code</span>
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-secondary" onclick="window.print()" title="Print Rate Sheet">
                            <i class="bi bi-printer"></i>
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-secondary d-flex align-items-center gap-1.5 shadow-sm" @onclick="ClosePage" title="Close / Return to Hall Rentals">
                            <i class="bi bi-x-lg"></i>
                            <span>Close</span>
                        </button>
                    }
                </div>
            </div>
        }

        <!-- CONFIRMATION MODAL -->
        @if (_showSaveConfirm)
        {
            <div class="modal fade show d-block" tabindex="-1" style="background: rgba(15, 23, 42, 0.65); backdrop-filter: blur(4px); z-index: 1060;" role="dialog">
                <div class="modal-dialog modal-dialog-centered" style="max-width: 480px;">
                    <div class="modal-content border-0 shadow-2xl rounded-4 overflow-hidden">
                        <div class="modal-header bg-light border-bottom px-4 py-3">
                            <h5 class="modal-title fw-bold text-dark d-flex align-items-center gap-2 mb-0">
                                <i class="bi bi-question-circle-fill text-primary"></i>
                                <span>Confirm Save Changes</span>
                            </h5>
                            <button type="button" class="btn-close" @onclick="() => _showSaveConfirm = false"></button>
                        </div>
                        <div class="modal-body px-4 py-4 text-center">
                            <div class="mb-3">
                                <i class="bi bi-shield-check text-success" style="font-size: 3rem;"></i>
                            </div>
                            <h6 class="fw-bold text-dark mb-2">Save Hall Rental Pricing Guide?</h6>
                            <p class="text-muted small mb-0">
                                This will update the official pricing sheet and immediately sync live rates to the Gloucester Fraternity Club website.
                            </p>
                        </div>
                        <div class="modal-footer bg-light border-top px-4 py-3 d-flex justify-content-end gap-2">
                            <button type="button" class="btn btn-sm btn-outline-secondary px-3" @onclick="() => _showSaveConfirm = false" disabled="@_isSaving">
                                Cancel
                            </button>
                            <button type="button" class="btn btn-sm btn-success fw-bold px-4 shadow-sm d-flex align-items-center gap-1.5" @onclick="ConfirmAndSaveRateSheetAsync" disabled="@_isSaving">
                                @if (_isSaving)
                                {
                                    <span class="spinner-border spinner-border-sm"></span>
                                    <span>Saving...</span>
                                }
                                else
                                {
                                    <i class="bi bi-check-lg"></i>
                                    <span>Yes, Save Changes</span>
                                }
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }

        @if (_isLoading)
        {
            <div class="text-center py-5 bg-white rounded-4 border shadow-sm">
                <div class="spinner-border text-primary mb-2" role="status"></div>
                <div class="text-muted small">Loading Official Rate Sheet...</div>
            </div>
        }
        else if (_model != null)
        {
            <!-- MAIN CARD CHASSIS -->
            <div class="gfc-rate-sheet-card shadow-2xl rounded-4 overflow-hidden border">
                
                <!-- 1. HEADER BANNER -->
                <div class="gfc-rate-header px-4 py-4 text-center position-relative">
                    @if (_isEditing)
                    {
                        <div class="mx-auto" style="max-width: 540px;">
                            <label class="form-label text-muted small fw-bold mb-1">Sheet Title</label>
                            <input type="text" class="form-control form-control-sm text-center fw-bold bg-white text-dark border mb-2" @bind="_model.HeaderTitle" placeholder="Header Title (e.g. GLOUCESTER FRATERNITY CLUB)" />
                            <label class="form-label text-muted small fw-bold mb-1">Sheet Subtitle</label>
                            <input type="text" class="form-control form-control-sm text-center bg-white text-muted border" @bind="_model.HeaderSubtitle" placeholder="Subtitle (e.g. Hall Rental Rates & Standard Time Blocks)" />
                        </div>
                    }
                    else
                    {
                        <h2 class="gfc-header-title fw-bolder mb-1 letter-spacing-1 text-dark">@_model.HeaderTitle</h2>
                        <p class="gfc-header-subtitle mb-0 text-muted small fw-semibold">@_model.HeaderSubtitle</p>
                    }
                </div>

                <!-- 2. TIME BLOCKS CAPSULES STRIP -->
                <div class="gfc-time-strip p-3 p-md-4 border-bottom">
                    @if (_isEditing)
                    {
                        <div class="bg-light p-3 rounded-3 border">
                            <div class="row g-2 mb-3">
                                <div class="col-md-6">
                                    <label class="form-label text-muted small fw-bold mb-1">Time Blocks Section Title</label>
                                    <input type="text" class="form-control form-control-sm fw-bold" @bind="_model.TimeBlockTitle" placeholder="e.g. STANDARD TIME BLOCKS (APPLIES ALL DAYS)" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label text-muted small fw-bold mb-1">Section Subtitle / Description</label>
                                    <input type="text" class="form-control form-control-sm" @bind="_model.TimeBlockDescription" placeholder="e.g. Rentals are reserved in 6-hour fixed blocks." />
                                </div>
                            </div>
                            <div class="row g-2">
                                <div class="col-sm-6">
                                    <div class="p-2.5 bg-white rounded-2 border">
                                        <label class="form-label text-muted small fw-bold mb-1">First Block (e.g. Daytime)</label>
                                        <div class="d-flex gap-2">
                                            <input type="text" class="form-control form-control-sm fw-semibold" @bind="_model.DaytimeBlockTitle" placeholder="Title (e.g. Daytime Block:)" />
                                            <input type="text" class="form-control form-control-sm text-primary fw-bold" @bind="_model.DaytimeBlockHours" placeholder="Hours (e.g. 10:00 AM – 4:00 PM)" />
                                        </div>
                                    </div>
                                </div>
                                <div class="col-sm-6">
                                    <div class="p-2.5 bg-white rounded-2 border">
                                        <label class="form-label text-muted small fw-bold mb-1">Second Block (e.g. Evening)</label>
                                        <div class="d-flex gap-2">
                                            <input type="text" class="form-control form-control-sm fw-semibold" @bind="_model.EveningBlockTitle" placeholder="Title (e.g. Evening Block:)" />
                                            <input type="text" class="form-control form-control-sm text-primary fw-bold" @bind="_model.EveningBlockHours" placeholder="Hours (e.g. 5:00 PM – 11:00 PM)" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
                            <div>
                                <div class="fw-bolder text-dark small letter-spacing-1">@_model.TimeBlockTitle</div>
                                <div class="text-muted small" style="font-size: 0.82rem;">@_model.TimeBlockDescription</div>
                            </div>

                            <!-- Time block pills -->
                            <div class="d-flex align-items-center gap-2 flex-wrap">
                                <!-- Daytime Block Pill -->
                                <div class="gfc-capsule-pill shadow-sm">
                                    <div class="gfc-capsule-label">@_model.DaytimeBlockTitle</div>
                                    <div class="gfc-capsule-hours">@_model.DaytimeBlockHours</div>
                                </div>

                                <!-- Evening Block Pill -->
                                <div class="gfc-capsule-pill shadow-sm">
                                    <div class="gfc-capsule-label">@_model.EveningBlockTitle</div>
                                    <div class="gfc-capsule-hours">@_model.EveningBlockHours</div>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <!-- 3. MAIN RATES TABLE -->
                <div class="gfc-table-container px-3 px-md-4 py-2">
                    <div class="table-responsive">
                        <table class="table gfc-rate-table align-middle mb-0">
                            <thead>
                                <tr>
                                    <th class="ps-2 py-3 text-muted fw-bold" style="width: 28%; font-size: 0.85rem;">DAY</th>
                                    <th class="text-end py-3" style="width: 24%;">
                                        @if (_isEditing)
                                        {
                                            <input type="text" class="form-control form-control-sm text-end fw-bold" @bind="_model.Col1Header" />
                                        }
                                        else
                                        {
                                            <span class="fw-bolder text-dark" style="font-size: 0.95rem;">@_model.Col1Header</span>
                                        }
                                    </th>
                                    <th class="text-end py-3" style="width: 24%;">
                                        @if (_isEditing)
                                        {
                                            <input type="text" class="form-control form-control-sm text-end fw-bold" @bind="_model.Col2Header" />
                                        }
                                        else
                                        {
                                            <span class="fw-bolder text-dark" style="font-size: 0.95rem;">@_model.Col2Header</span>
                                        }
                                    </th>
                                    <th class="text-end pe-2 py-3" style="width: 24%;">
                                        @if (_isEditing)
                                        {
                                            <input type="text" class="form-control form-control-sm text-end fw-bold" @bind="_model.Col3Header" />
                                        }
                                        else
                                        {
                                            <span class="fw-bolder text-dark" style="font-size: 0.95rem;">@_model.Col3Header</span>
                                        }
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var day in _model.Days)
                                {
                                    <tr class="gfc-table-row">
                                        <td class="ps-2 py-3 fw-bold text-dark fs-6">
                                            @day.DayName
                                        </td>

                                        <!-- Col 1 (Non-Members) -->
                                        <td class="text-end py-3">
                                            @if (_isEditing)
                                            {
                                                <div class="d-flex align-items-center justify-content-end gap-1">
                                                    <input type="text" class="form-control form-control-sm text-end fw-bold" style="width: 100px;" @bind="day.Col1Price" />
                                                    <button type="button" class="btn btn-xs @(day.Col1IsUnavailable ? "btn-danger" : "btn-outline-secondary")" @onclick="() => ToggleDayAvail(day, 1)" title="Toggle Availability">
                                                        <i class="bi bi-slash-circle"></i>
                                                    </button>
                                                </div>
                                            }
                                            else
                                            {
                                                @if (day.Col1IsUnavailable || string.Equals(day.Col1Price, "Not Available", StringComparison.OrdinalIgnoreCase))
                                                {
                                                    <span class="text-muted fst-italic" style="font-size: 0.88rem;">Not Available</span>
                                                }
                                                else
                                                {
                                                    <span class="fw-bolder text-dark fs-6 font-monospace">@day.Col1Price</span>
                                                }
                                            }
                                        </td>

                                        <!-- Col 2 (Members) -->
                                        <td class="text-end py-3">
                                            @if (_isEditing)
                                            {
                                                <div class="d-flex align-items-center justify-content-end gap-1">
                                                    <input type="text" class="form-control form-control-sm text-end fw-bold" style="width: 100px;" @bind="day.Col2Price" />
                                                    <button type="button" class="btn btn-xs @(day.Col2IsUnavailable ? "btn-danger" : "btn-outline-secondary")" @onclick="() => ToggleDayAvail(day, 2)" title="Toggle Availability">
                                                        <i class="bi bi-slash-circle"></i>
                                                    </button>
                                                </div>
                                            }
                                            else
                                            {
                                                @if (day.Col2IsUnavailable || string.Equals(day.Col2Price, "Not Available", StringComparison.OrdinalIgnoreCase))
                                                {
                                                    <span class="text-muted fst-italic" style="font-size: 0.88rem;">Not Available</span>
                                                }
                                                else
                                                {
                                                    <span class="fw-bolder text-dark fs-6 font-monospace">@day.Col2Price</span>
                                                }
                                            }
                                        </td>

                                        <!-- Col 3 (Non-Profits) -->
                                        <td class="text-end pe-2 py-3">
                                            @if (_isEditing)
                                            {
                                                <div class="d-flex align-items-center justify-content-end gap-1">
                                                    <input type="text" class="form-control form-control-sm text-end fw-bold" style="width: 100px;" @bind="day.Col3Price" />
                                                    <button type="button" class="btn btn-xs @(day.Col3IsUnavailable ? "btn-danger" : "btn-outline-secondary")" @onclick="() => ToggleDayAvail(day, 3)" title="Toggle Availability">
                                                        <i class="bi bi-slash-circle"></i>
                                                    </button>
                                                </div>
                                            }
                                            else
                                            {
                                                @if (day.Col3IsUnavailable || string.Equals(day.Col3Price, "Not Available", StringComparison.OrdinalIgnoreCase))
                                                {
                                                    <span class="text-muted fst-italic" style="font-size: 0.88rem;">Not Available</span>
                                                }
                                                else
                                                {
                                                    <span class="fw-bolder text-dark fs-6 font-monospace">@day.Col3Price</span>
                                                }
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- 4. BOTTOM ADD-ON CARDS (MODERN FLOATING ACCENTS) -->
                <div class="px-3 px-md-4 py-3 bg-light bg-opacity-50 border-top">
                    <div class="row g-3">
                        <!-- Bar Service Options Card (Signature Gold Accent) -->
                        <div class="col-md-6">
                            <div class="gfc-modern-option-card gfc-card-gold h-100 shadow-sm rounded-4 overflow-hidden bg-white border">
                                <div class="gfc-option-card-header gfc-gold-header px-3 py-2 text-white d-flex align-items-center justify-content-between">
                                    @if (_isEditing)
                                    {
                                        <input type="text" class="form-control form-control-xs fw-bold text-white bg-transparent border-0 p-0" @bind="_model.BarCardTitle" placeholder="Card Title" />
                                    }
                                    else
                                    {
                                        <span class="fw-bolder small letter-spacing-1 text-white">
                                            <i class="bi bi-cup-straw me-1.5"></i>@_model.BarCardTitle
                                        </span>
                                    }
                                </div>
                                <div class="p-3">
                                    @if (_model.BarServices != null && _model.BarServices.Count > 0)
                                    {
                                        @for (int i = 0; i < _model.BarServices.Count; i++)
                                        {
                                            var item = _model.BarServices[i];
                                            <div class="@(i > 0 ? "pt-3 mt-3 border-top" : "")">
                                                @if (_isEditing)
                                                {
                                                    <div class="d-flex justify-content-between align-items-center gap-2 mb-1.5">
                                                        <input type="text" class="form-control form-control-sm fw-bold" @bind="item.Name" placeholder="Option Name (e.g. Bar Service Package)" />
                                                        <input type="text" class="form-control form-control-sm fw-bold text-end" style="width: 90px;" @bind="item.Price" placeholder="Price" />
                                                        <button type="button" class="btn btn-sm btn-outline-danger px-2" @onclick="() => RemoveBarService(item)" title="Remove this option">
                                                            <i class="bi bi-trash"></i>
                                                        </button>
                                                    </div>
                                                    <textarea class="form-control form-control-sm text-muted" rows="2" @bind="item.Description" placeholder="Description of this service option"></textarea>
                                                }
                                                else
                                                {
                                                    <div class="d-flex justify-content-between align-items-start gap-2 mb-1">
                                                        <span class="fw-bold text-dark fs-6">@item.Name</span>
                                                        <span class="badge bg-warning-subtle text-dark border border-warning-subtle fw-bolder fs-6 font-monospace px-2.5 py-1">@item.Price</span>
                                                    </div>
                                                    <div class="text-muted small" style="font-size: 0.80rem; line-height: 1.45;">
                                                        @foreach (var line in (item.Description ?? "").Split(new[] { "\r\n", "\r", "\n" }, StringSplitOptions.RemoveEmptyEntries))
                                                        {
                                                            <div>@line</div>
                                                        }
                                                    </div>
                                                }
                                            </div>
                                        }
                                    }
                                    else if (!_isEditing)
                                    {
                                        <div class="text-muted small fst-italic py-2">No bar options configured.</div>
                                    }

                                    @if (_isEditing)
                                    {
                                        <div class="mt-3 pt-2 border-top">
                                            <button type="button" class="btn btn-xs btn-outline-warning text-dark fw-semibold d-flex align-items-center gap-1 shadow-sm" @onclick="AddBarService">
                                                <i class="bi bi-plus-circle"></i>
                                                <span>Add Bar Service Option</span>
                                            </button>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>

                        <!-- Additional Services Card (Forest Green Accent) -->
                        <div class="col-md-6">
                            <div class="gfc-modern-option-card gfc-card-green h-100 shadow-sm rounded-4 overflow-hidden bg-white border">
                                <div class="gfc-option-card-header gfc-green-header px-3 py-2 text-white d-flex align-items-center justify-content-between">
                                    @if (_isEditing)
                                    {
                                        <input type="text" class="form-control form-control-xs fw-bold text-white bg-transparent border-0 p-0" @bind="_model.AddonCardTitle" placeholder="Card Title" />
                                    }
                                    else
                                    {
                                        <span class="fw-bolder small letter-spacing-1 text-white">
                                            <i class="bi bi-stars me-1.5"></i>@_model.AddonCardTitle
                                        </span>
                                    }
                                </div>
                                <div class="p-3">
                                    @if (_model.AdditionalServices != null && _model.AdditionalServices.Count > 0)
                                    {
                                        @for (int i = 0; i < _model.AdditionalServices.Count; i++)
                                        {
                                            var item = _model.AdditionalServices[i];
                                            <div class="@(i > 0 ? "pt-3 mt-3 border-top" : "")">
                                                @if (_isEditing)
                                                {
                                                    <div class="d-flex justify-content-between align-items-center gap-2 mb-1.5">
                                                        <input type="text" class="form-control form-control-sm fw-bold" @bind="item.Name" placeholder="Service Name (e.g. Day-Before Decorating)" />
                                                        <input type="text" class="form-control form-control-sm fw-bold text-end" style="width: 90px;" @bind="item.Price" placeholder="Price" />
                                                        <button type="button" class="btn btn-sm btn-outline-danger px-2" @onclick="() => RemoveAdditionalService(item)" title="Remove this service">
                                                            <i class="bi bi-trash"></i>
                                                        </button>
                                                    </div>
                                                    <textarea class="form-control form-control-sm text-muted" rows="2" @bind="item.Description" placeholder="Description of this additional service"></textarea>
                                                }
                                                else
                                                {
                                                    <div class="d-flex justify-content-between align-items-start gap-2 mb-1">
                                                        <span class="fw-bold text-dark fs-6">@item.Name</span>
                                                        <span class="badge bg-success-subtle text-success border border-success-subtle fw-bolder fs-6 font-monospace px-2.5 py-1">@item.Price</span>
                                                    </div>
                                                    <div class="text-muted small" style="font-size: 0.80rem; line-height: 1.45;">
                                                        @foreach (var line in (item.Description ?? "").Split(new[] { "\r\n", "\r", "\n" }, StringSplitOptions.RemoveEmptyEntries))
                                                        {
                                                            <div>@line</div>
                                                        }
                                                    </div>
                                                }
                                            </div>
                                        }
                                    }
                                    else if (!_isEditing)
                                    {
                                        <div class="text-muted small fst-italic py-2">No additional services configured.</div>
                                    }

                                    @if (_isEditing)
                                    {
                                        <div class="mt-3 pt-2 border-top">
                                            <button type="button" class="btn btn-xs btn-outline-success fw-semibold d-flex align-items-center gap-1 shadow-sm" @onclick="AddAdditionalService">
                                                <i class="bi bi-plus-circle"></i>
                                                <span>Add Additional Service</span>
                                            </button>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 5. FOOTER DISCLAIMER -->
                <div class="p-3 p-md-4 bg-white border-top text-muted small" style="font-size: 0.78rem; line-height: 1.5;">
                    @if (_isEditing)
                    {
                        <textarea class="form-control form-control-sm text-muted" rows="2" @bind="_model.FooterDisclaimer"></textarea>
                    }
                    else
                    {
                        <span>@_model.FooterDisclaimer</span>
                    }
                </div>
            </div>
        }
    </div>
</div>

<style>
    .letter-spacing-1 {
        letter-spacing: 0.04em;
    }

    /* Outer Chassis - Light, Soft, Floating */
    .gfc-rate-sheet-card {
        background: #ffffff;
        border: 1px solid #e8e6df !important;
        box-shadow: 0 12px 36px -6px rgba(0, 0, 0, 0.05), 0 2px 8px rgba(0, 0, 0, 0.02);
    }

    /* Top Light Elegant Header */
    .gfc-rate-header {
        background: linear-gradient(180deg, #faf9f5 0%, #f4f1e8 100%);
        border-bottom: 1.5px solid #e8e3d5;
    }
    .gfc-header-title {
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
        font-size: 1.35rem;
        letter-spacing: 0.06em;
        color: #1e293b !important;
    }
    .gfc-header-subtitle {
        color: #78716c !important;
        font-size: 0.88rem;
    }

    /* Time Blocks Strip - Light & Subtle */
    .gfc-time-strip {
        background: #ffffff;
        border-color: #f1efe9 !important;
    }
    .gfc-capsule-pill {
        background: #faf8f5;
        color: #1e293b;
        padding: 6px 16px;
