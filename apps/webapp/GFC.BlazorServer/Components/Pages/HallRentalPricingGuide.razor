@page "/hall-rentals/pricing-guide"
@page "/rentals/pricing-guide"
@using GFC.Core.Models
@using GFC.Core.Interfaces
@using GFC.BlazorServer.Components.Shared
@using System.Text.Json
@using Microsoft.AspNetCore.WebUtilities
@inject IWebsiteSettingsService SettingsService
@inject NavigationManager Navigation
@inject IToastService ToastService
@layout GFC.BlazorServer.Components.Layout.EmptyLayout
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@rendermode InteractiveServer

<div class="standalone-pricing-guide-window @(_isEmbedded ? "p-0 bg-transparent" : "min-vh-100 bg-light py-3 px-2 px-md-4")">
    <div class="mx-auto" style="@(_isEmbedded ? "max-width: 100%;" : "max-width: 960px;")">
        <!-- Clean Standalone Bar (Hidden during embed or print) -->
        @if (!_isEmbedded)
        {
            <div class="d-flex justify-content-between align-items-center mb-3 no-print p-2 bg-white rounded-3 border shadow-sm">
                <div class="d-flex align-items-center gap-2">
                    <span class="fw-bold text-dark"><i class="bi bi-bar-chart-fill text-primary me-2"></i>GFC Hall Rental Pricing Guide</span>
                </div>
                <button class="btn btn-sm btn-outline-secondary" onclick="window.close()" title="Close Tab">
                    <i class="bi bi-x-lg me-1"></i>Close Window
                </button>
            </div>
        }

    @if (_isLoading)
    {
        <div class="text-center py-5 bg-white rounded-4 border shadow-sm">
            <div class="spinner-border text-primary mb-2" role="status"></div>
            <div class="text-muted small">Loading Pricing Guide...</div>
        </div>
    }
    else
    {
        <RentalPricingGuideView 
            Settings="_settings" 
            ShowFullPageLink="false" 
            HideToolbar="_isEmbedded"
            InitialSectionFilter="@_sectionFilter"
            InitialMode="@_initialMode"
            OnCustomGuideSaved="HandleCustomGuideSaved" />
    }
    </div>
</div>

@code {
    private WebsiteSettings? _settings;
    private bool _isLoading = true;
    private bool _isEmbedded = false;
    private string? _sectionFilter = null;
    private string? _initialMode = null;

    protected override async Task OnInitializedAsync()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);

        if (query.TryGetValue("embed", out var embedVal) && embedVal == "true")
        {
            _isEmbedded = true;
        }

        if (query.TryGetValue("section", out var sectionVal))
        {
            _sectionFilter = sectionVal.ToString();
        }

        if (query.TryGetValue("mode", out var modeVal))
        {
            _initialMode = modeVal.ToString();
        }

        await LoadSettingsAsync();
    }

    private async Task LoadSettingsAsync()
    {
        _isLoading = true;
        try
        {
            _settings = await SettingsService.GetWebsiteSettingsAsync();
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Failed to load settings: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task HandleCustomGuideSaved(RentalPricingGuideModel model)
    {
        if (_settings != null)
        {
            _settings.PricingGuideJson = JsonSerializer.Serialize(model);
            await SettingsService.UpdateWebsiteSettingsAsync(_settings);
        }
    }
}
