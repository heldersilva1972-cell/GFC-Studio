</style>

@code {
    private decimal? BarSales { get; set; }
    private decimal? LottoSales { get; set; }
    private decimal? LottoCashes { get; set; }
    private decimal? LottoNetDue { get; set; }
    private decimal? LottoCashCounted { get; set; }
    private decimal? TotalHours { get; set; }
    
    private string? ShiftType { get; set; }
    private DateTime ReportDate { get; set; } = DateTime.Today;
    private string? Notes { get; set; }
    private bool _dayMainSubmitted { get; set; }
    private bool _nightMainSubmitted { get; set; }
    private bool _hallSubmitted { get; set; }
    private bool _isOwner { get; set; }
    private string? _createdByName { get; set; }
    
    private bool Loading { get; set; } = true;
    private bool IsSubmitting { get; set; } = false;
    private bool Submitted { get; set; } = false;
    private bool ExistingEntryFound { get; set; } = false;
    private bool IsLocked { get; set; } = false;
    private bool _showValidation { get; set; } = false;
    private bool IsRentalHall { get; set; } = false;
    private bool IsEarlyMorning => DateTime.Now.Hour < 5;
    private bool IsFromMobile => ExistingEntryFound && (TotalHours == null || (ExistingLottoEntry != null && ExistingLottoEntry.NetDue == 0 && ExistingLottoEntry.EndingCash == 0));

    private BarSaleEntry? ExistingBarEntry { get; set; }
    private LotteryShift? ExistingLottoEntry { get; set; }
    private AppUser? CurrentUser { get; set; }

    private decimal LottoDrawerValue => (LottoSales ?? 0) - (LottoCashes ?? 0);
    private decimal LottoDiscrepancy => (LottoCashCounted ?? 0) - LottoDrawerValue;

    protected override async Task OnInitializedAsync()
    {
        CurrentUser = AuthStateProvider.GetCurrentUser();
        if (CurrentUser == null)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        ApplyBusinessDayLogic();
        await UpdateShiftAvailability();
        await CheckExisting();
        Loading = false;
    }

    private void ApplyBusinessDayLogic()
    {
        var now = DateTime.Now;
        var totalMinutes = now.Hour * 60 + now.Minute;

        if (totalMinutes < 300) // Before 5 AM (yesterday's night shift)
        {
            ReportDate = DateTime.Today.AddDays(-1);
        }
        else
        {
            ReportDate = DateTime.Today;
        }
        
        // ShiftType remains null to force selection
    }

    private string? _lockErrorMessage { get; set; }

    private async Task SetShift(string type)
    {
        _lockErrorMessage = null;
        ShiftType = type;
        await CheckExisting();
        
        if (IsLocked)
        {
            if (!_isOwner)
            {
                _lockErrorMessage = $"This report was submitted by '{_createdByName}' and can only be modified by them.";
            }
            else
            {
                _lockErrorMessage = "The 2-hour correction window for your report has expired.";
            }
            ResetSelection();
            return;
        }

        // Logic: Main Bar is locked if both shifts are done and we are not in Rental Hall mode
        if (!IsRentalHall && !ExistingEntryFound && _dayMainSubmitted && _nightMainSubmitted)
        {
            _lockErrorMessage = "Main Bar reporting is complete for today. Please select 'Hall Rental Bar' if you need to file a rental report.";
            ResetSelection();
        }
    }

    private async Task ToggleRentalHall()
    {
        IsRentalHall = !IsRentalHall;
        
        // Force update of submission flags (badges) for the new context
        await UpdateShiftAvailability();
        
        if (IsRentalHall)
        {
            ShiftType = "Hall"; // Fixed shift for rental hall
        }
        else
        {
            ResetSelection(); // Reset everything when going back to main bar
        }
        
        // Check if anything exists for the new combo
        await CheckExisting();

        if (IsLocked)
        {
            _lockErrorMessage = "Access Restricted: The existing report for this context is locked.";
            ResetSelection();
        }
    }

    private async Task UpdateShiftAvailability()
    {
        if (ReportDate.Date > DateTime.Today)
        {
            ReportDate = DateTime.Today;
        }
        
        try
        {
            using var db = await DbFactory.CreateDbContextAsync();
            
            _dayMainSubmitted = await db.BarSaleEntries
                .AnyAsync(e => (e.AdjustedSaleDate ?? e.SaleDate).Date == ReportDate.Date && e.Shift == "Day" && !e.IsRentalHall);
            
            _nightMainSubmitted = await db.BarSaleEntries
                .AnyAsync(e => (e.AdjustedSaleDate ?? e.SaleDate).Date == ReportDate.Date && e.Shift == "Night" && !e.IsRentalHall);

            _hallSubmitted = await db.BarSaleEntries
                .AnyAsync(e => (e.AdjustedSaleDate ?? e.SaleDate).Date == ReportDate.Date && e.IsRentalHall);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[UpdateShiftAvailability:Error] {ex.Message}");
        }
    }

    private void ResetSelection()
    {
        ShiftType = null;
        BarSales = null;
        TotalHours = null;
        LottoSales = null;
        LottoCashes = null;
        LottoNetDue = null;
        LottoCashCounted = null;
        Notes = null;
        ExistingEntryFound = false;
        IsLocked = false;
        _isOwner = false;
        _createdByName = null;
        _showValidation = false;
        ExistingBarEntry = null;
        ExistingLottoEntry = null;
        // We don't clear _lockErrorMessage here so the user can see why it was reset
    }

    private async Task CheckExisting()
    {
        ExistingEntryFound = false;
        IsLocked = false;
        ExistingBarEntry = null;
        ExistingLottoEntry = null;

        try
        {
            using var db = await DbFactory.CreateDbContextAsync();
            
            // Look for existing Bar Entry
            ExistingBarEntry = await db.BarSaleEntries
                .FirstOrDefaultAsync(e => (e.AdjustedSaleDate ?? e.SaleDate).Date == ReportDate.Date && 
                                         e.Shift == ShiftType && 
                                         e.IsRentalHall == IsRentalHall);

            // Look for existing Lottery Entry
            var lottoShifts = LotteryRepo.GetByDateRange(ReportDate, ReportDate);
            ExistingLottoEntry = lottoShifts.FirstOrDefault(s => s.ShiftType == ShiftType);

            if (ExistingBarEntry != null || ExistingLottoEntry != null)
            {
                ExistingEntryFound = true;
                
                // Populate data
                BarSales = ExistingBarEntry?.TotalSales;
                TotalHours = ExistingBarEntry?.TotalHours;
                
                if (ExistingLottoEntry != null)
                {
                    LottoSales = ExistingLottoEntry.TotalSales;
                    LottoCashes = ExistingLottoEntry.TotalPayouts;
                    LottoNetDue = ExistingLottoEntry.NetDue;
                    LottoCashCounted = ExistingLottoEntry.EndingCash;
                }
                
                // Context preservation
                Notes = ExistingBarEntry?.Notes ?? ExistingLottoEntry?.Notes;
                _createdByName = ExistingBarEntry?.CreatedBy ?? ExistingLottoEntry?.CreatedBy;

                // Check 2-Hour Lock
                var cutoff = DateTime.UtcNow.AddHours(-2);
                var createdTime = ExistingBarEntry?.CreatedAt ?? ExistingLottoEntry?.CreatedDate ?? DateTime.UtcNow;
                
                // Only the creator can edit
                _isOwner = _createdByName == CurrentUser?.Username;
                
                if (createdTime < cutoff || !_isOwner)
                {
                    IsLocked = true;
                }
            }
            else
            {
                // No existing entry for this context - start clean for input
                BarSales = null;
                LottoSales = null;
                LottoCashes = null;
                LottoNetDue = null;
                LottoCashCounted = null;
                TotalHours = null;
                Notes = null;
                _isOwner = true; // New entries belong to the current user
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[ShiftReport:Error] {ex.Message}");
        }
    }

    private async Task HandleSubmit()
    {
        if (ReportDate.Date > DateTime.Today)
        {
            _lockErrorMessage = "You cannot select or submit reports for future dates.";
            _showValidation = true;
            return;
        }

        if (string.IsNullOrEmpty(ShiftType))
        {
            if (!IsRentalHall && _dayMainSubmitted && _nightMainSubmitted)
            {
                _lockErrorMessage = "Main Bar reporting is already complete for today. Please select 'Hall Rental Bar' to proceed with a rental report.";
            }
            else
            {
                _lockErrorMessage = "Please select your Shift (Day or Night) before submitting.";
            }
            _showValidation = true;
            return;
        }

        if (BarSales == null || TotalHours == null || 
            (!IsRentalHall && (LottoSales == null || LottoCashes == null || LottoNetDue == null || LottoCashCounted == null)))
        {
            await JSRuntime.InvokeVoidAsync("alert", "Please fill in all required sales and hours fields.");
            return;
        }

        IsSubmitting = true;
        try
        {
            using var db = await DbFactory.CreateDbContextAsync();

            // 1. Bar Sales
            if (ExistingBarEntry != null)
            {
                var entry = await db.BarSaleEntries.FindAsync(ExistingBarEntry.Id);
                if (entry != null)
                {
                    entry.TotalSales = BarSales ?? 0;
                    entry.TotalHours = TotalHours;
                    entry.IsRentalHall = IsRentalHall;
                    entry.Notes = Notes;
                    entry.ModifiedBy = CurrentUser?.Username;
                    entry.ModifiedDate = DateTime.UtcNow;
                    await db.SaveChangesAsync();
                }
            }
            else
            {
                var entry = new BarSaleEntry
                {
                    SaleDate = DateTime.Now,
                    AdjustedSaleDate = ReportDate,
                    TotalSales = BarSales ?? 0,
                    TotalHours = TotalHours,
                    IsRentalHall = IsRentalHall,
                    Shift = ShiftType,
                    Notes = Notes,
                    CreatedBy = CurrentUser?.Username,
                    CreatedAt = DateTime.UtcNow
                };
                db.BarSaleEntries.Add(entry);
                await db.SaveChangesAsync();
            }

            // 2. Lottery Sales (Only if not Rental Hall)
            if (!IsRentalHall)
            {
                if (ExistingLottoEntry != null)
                {
                    ExistingLottoEntry.TotalSales = LottoSales ?? 0;
                    ExistingLottoEntry.TotalPayouts = LottoCashes ?? 0;
                    ExistingLottoEntry.NetDue = LottoNetDue ?? 0;
                    ExistingLottoEntry.EndingCash = LottoCashCounted ?? 0;
                    ExistingLottoEntry.Notes = Notes;
                    ExistingLottoEntry.ModifiedBy = CurrentUser?.Username;
                    ExistingLottoEntry.ModifiedDate = DateTime.UtcNow;
                    LotteryRepo.Update(ExistingLottoEntry);
                }
                else
                {
                    var lotto = new LotteryShift
                    {
                        ShiftDate = ReportDate,
                        EmployeeName = CurrentUser?.Username ?? "Unknown",
                        ShiftType = ShiftType,
                        TotalSales = LottoSales ?? 0,
                        TotalPayouts = LottoCashes ?? 0,
                        NetDue = LottoNetDue ?? 0,
                        EndingCash = LottoCashCounted ?? 0,
                        Notes = Notes,
                        CreatedBy = CurrentUser?.Username,
                        CreatedDate = DateTime.UtcNow,
                        Status = "Submitted"
                    };
                    LotteryRepo.Create(lotto);
                }
            }

            AuditLogger.Log("Shift Report Submitted", CurrentUser?.UserId, null, $"Date: {ReportDate:yyyy-MM-dd}, Shift: {ShiftType}");
            
            Submitted = true;
            await UpdateShiftAvailability(); // Refresh badges
            await CheckExisting(); // Refresh state
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", "Error saving report: " + ex.Message);
        }
        finally
        {
            IsSubmitting = false;
        }
    }

    private async Task HandleKeyPress(KeyboardEventArgs e, string nextFieldId)
    {
        if (e.Key == "Enter")
        {
            if (nextFieldId == "submitBtn")
            {
                await HandleSubmit();
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("eval", $"document.getElementById('{nextFieldId}').focus()");
            }
        }
    }

    private void GoToDashboard() => Navigation.NavigateTo("/");
}
