</style>

@code {
    private readonly List<StatusChip> _statusChips = new()
    {
        new("all", "All", "#1f2937"),
        new("regular", "Regular", "#14b8a6"),
        new("pending", "Pending", "#6366f1"),
        new("guest", "Guest", "#6b7280"),
        new("life", "Life", "#d6b33d"),
        new("npqueue", "NP-Regular", "#2563eb"),
        new("pastdue", "Unpaid", "#f97316"),
        new("inactive", "Inactive", "#ef4444"),
        new("deceased", "Deceased", "#475569")
    };

    private List<MemberCardModel> _allMembers = new();
    private List<MemberCardModel> _filteredMembers = new();
    private string _searchTerm = string.Empty;
    private string _statusFilter = "all";
    private string _sortOption = "name";
    private bool HasActiveFilters =>
        !string.IsNullOrWhiteSpace(_searchTerm) || !IsChipActive("all");
    private bool _isLoading = true;
    private string? _errorMessage;
    private CancellationTokenSource? _debounceCts;

    private string _activeTab = "directory";
    private List<MemberChangeHistory>? _memberHistory;
    private bool _loadingHistory = false;

    private async Task SetTab(string tab)
    {
        _activeTab = tab;
        if (tab == "activity" && _memberHistory == null)
        {
            await LoadHistoryAsync();
        }
    }

    private async Task LoadHistoryAsync()
    {
        _loadingHistory = true;
        StateHasChanged();
        try
        {
            _memberHistory = await HistoryRepository.GetGlobalHistoryAsync(100);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load member activity feed in Member Directory");
        }
        finally
        {
            _loadingHistory = false;
            StateHasChanged();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        _isLoading = true;
        await LoadMembersAsync();
    }

    protected override void OnParametersSet()
    {
        var uri = NavManager.ToAbsoluteUri(NavManager.Uri);
        if (Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query).TryGetValue("status", out var statusVal))
        {
            var requestedStatus = statusVal.ToString().ToLowerInvariant();
            if (_statusChips.Any(c => c.Value == requestedStatus))
            {
                _statusFilter = requestedStatus;
                ApplyFilters();
            }
        }
    }

    private async Task LoadMembersAsync()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            var year = DateTime.Today.Year;
            var listTask = MemberQueryService.GetMembersAsync(new MemberFilterOptions());
            var detailsTask = Task.Run(() => MemberRepository.GetAllMembers());
            var cardsTask = Task.Run(() => KeyCardRepository.GetAll());
            var allDuesTask = Task.Run(() => DuesRepository.GetAllDues());
            var allBoardTask = Task.Run(() => BoardRepository.GetAllAssignments());
            var settingsTask = Task.Run(() => DuesYearSettingsRepository.GetSettingsForYear(year));
            var waiversTask = Task.Run(() => DuesWaiverRepository.GetAllWaivers());

            await Task.WhenAll(
                listTask, detailsTask, cardsTask, 
                allDuesTask, allBoardTask, settingsTask, waiversTask
            );

            var list = listTask.Result;
            var detailsLookup = detailsTask.Result.ToDictionary(m => m.MemberID);
            var allCards = cardsTask.Result;
            
            var allDues = allDuesTask.Result;
            var duesLookup = allDues.GroupBy(d => d.MemberID).ToDictionary(g => g.Key, g => g.ToList());
            var allBoard = allBoardTask.Result;
            var boardLookup = allBoard.GroupBy(a => a.MemberID).ToDictionary(g => g.Key, g => g.Select(a => a.TermYear).ToHashSet());

            var duesCurrent = allDues.Where(d => d.Year == year).ToDictionary(d => d.MemberID);
            var duesPrev = allDues.Where(d => d.Year == year - 1).ToDictionary(d => d.MemberID);
            var boardCurrent = allBoard.Where(a => a.TermYear == year).Select(a => a.MemberID).ToHashSet();
            var boardPrev = allBoard.Where(a => a.TermYear == year - 1).Select(a => a.MemberID).ToHashSet();

            var settings = settingsTask.Result;
            var allWaivers = waiversTask.Result;
            
            // Build waiver lookup: memberId -> set of years covered by waivers
            var waiverYearsByMember = allWaivers
                .GroupBy(w => w.MemberId)
                .ToDictionary(
                    g => g.Key,
                    g => g.SelectMany(w => Enumerable.Range(w.StartYear, w.EndYear - w.StartYear + 1)).ToHashSet()
                );

            var activeCardByMember = allCards
                .Where(c => c.IsActive)
                .GroupBy(c => c.MemberId)
                .ToDictionary(g => g.Key, g => g.First());
            
            // Secondary lookup for inactive cards if no active one exists
            var anyCardByMember = allCards
                .GroupBy(c => c.MemberId)
                .ToDictionary(g => g.Key, g => g.First());

            _allMembers = list
                .Select(item =>
                {
                    detailsLookup.TryGetValue(item.MemberId, out var detail);
                    var status = item.Status;
                    var normalized = MemberStatusHelper.NormalizeStatus(detail?.Status ?? status.ToString());
                    var isLife = status == MemberStatus.Life;
                    var isBoard = boardCurrent.Contains(item.MemberId);
                    
                    // Determine Dues Status logic (matching KeyCardService rules)
                    // Check if member has waiver for current/previous year
                    bool hasCurrentWaiver = waiverYearsByMember.TryGetValue(item.MemberId, out var memberWaiverYears) && memberWaiverYears.Contains(year);
                    bool hasPrevWaiver = waiverYearsByMember.TryGetValue(item.MemberId, out var memberPrevWaiverYears) && memberPrevWaiverYears.Contains(year - 1);
                    
                    bool currentPaid = isBoard || isLife || hasCurrentWaiver || (duesCurrent.TryGetValue(item.MemberId, out var dc) && KeyCardService.IsDuesSatisfied(dc.PaymentType, dc.PaidDate));
                    bool prevPaid = isBoard || isLife || hasPrevWaiver || (duesPrev.TryGetValue(item.MemberId, out var dp) && KeyCardService.IsDuesSatisfied(dp.PaymentType, dp.PaidDate));
                    
                    // Calculate Overdue Years count
                    int overdueYears = 0;
                    if (!isLife)
                    {
                        int startYear = detail?.AcceptedDate?.Year ?? detail?.ApplicationDate?.Year ?? year;
                        if (startYear > year) startYear = year;
                        
                        // Count backwards to find last satisfied year
                        for (int y = year; y >= startYear; y--)
                        {
                            bool yPaid = (boardLookup.TryGetValue(item.MemberId, out var by) && by.Contains(y)) ||
                                         (waiverYearsByMember.TryGetValue(item.MemberId, out var wy) && wy.Contains(y)) ||
                                         (duesLookup.TryGetValue(item.MemberId, out var dm) && dm.Any(d => d.Year == y && KeyCardService.IsDuesSatisfied(d.PaymentType, d.PaidDate)));
                            
                            if (yPaid) break;
                            overdueYears++;
                        }
                    }

                    int totalOverdueMonths = 0;
                    if (overdueYears > 0)
                    {
                        // Calculate months as: (Full Years missing excluding current) * 12 + Current month
                        // e.g. If March 2026 and missing 2026 only: 3 MOS
                        //      If March 2026 and missing 2025/2026: 15 MOS (1 YR, 3 MOS)
                        totalOverdueMonths = ((overdueYears - 1) * 12) + DateTime.Today.Month;
                    }

                    string GetDurationLabel(int months)
                    {
                        if (months <= 0) return string.Empty;
                        int yrs = months / 12;
                        int mos = months % 12;
                        
                        if (yrs > 0)
                        {
                            string yrPart = yrs == 1 ? "1 YR" : $"{yrs} YRS";
                            string moPart = mos == 0 ? "" : (mos == 1 ? ", 1 MO" : $", {mos} MOS");
                            return $"({yrPart}{moPart})";
                        }
                        return mos == 1 ? "(1 MO)" : $"({mos} MOS)";
                    }
                    
                    if (detail == null) return null;
                    var eligibility = CardService.GetEligibilityBulk(detail, year, settings, currentPaid, prevPaid);

                    string duesStatus = "Paid";
                    if (status == MemberStatus.Inactive || status == MemberStatus.Deceased || status == MemberStatus.Rejected)
                    {
                        duesStatus = "None";
                        overdueYears = 0;
                    }
                    else if (status == MemberStatus.Pending)
                    {
                        duesStatus = "Pending";
                    }
                    else if (isLife)
                    {
                        duesStatus = "Life";
                        overdueYears = 0;
                    }
                    else if (isBoard)
                    {
                        duesStatus = "Paid"; // Board members have paid status by privilege
                        overdueYears = 0;
                    }
                    else if (hasCurrentWaiver)
                    {
                        duesStatus = "Waived";
                        overdueYears = 0;
                    }
                    else if (eligibility.GracePeriodActive && !eligibility.CurrentYearSatisfied && eligibility.PreviousYearSatisfied)
                    {
                        // Being in grace period means only the current year is unpaid
                        duesStatus = $"In Grace Period {GetDurationLabel(totalOverdueMonths)}";
                    }
                    else if (!eligibility.Eligible || !currentPaid)
                    {
                        duesStatus = $"Past Due {GetDurationLabel(totalOverdueMonths)}";
                    }

                    // Enrich with card details
                    string? cardNumber = null;
                    bool? cardActive = null;

                    if (activeCardByMember.TryGetValue(item.MemberId, out var activeCard))
                    {
                        cardNumber = activeCard.CardNumber;
                        cardActive = true;
                    }
                    else if (anyCardByMember.TryGetValue(item.MemberId, out var anyCard))
                    {
                        cardNumber = anyCard.CardNumber;
                        cardActive = anyCard.IsActive;
                    }

                    return new MemberCardModel
                    {
                        MemberId = item.MemberId,
                        FullName = detail is null
                            ? item.FullName
                            : BuildFullName(detail.FirstName, detail.MiddleName, detail.LastName, detail.Suffix),
                        Status = status,
                        City = detail?.City,
                        Email = detail?.Email,
                        Phone = detail?.Phone ?? detail?.CellPhone,
                        MemberSince = item.MemberSince,
                        RegularSince = item.RegularSince,
                        ApplicationDate = item.ApplicationDate,
                        IsNonPortuguese = item.IsNonPortuguese,
                        HasKeyCard = !string.IsNullOrEmpty(cardNumber),
                        InactiveDate = item.InactiveDate,
                        DuesStatus = duesStatus,
                        OverdueMonths = totalOverdueMonths,
                        IsBoardMember = isBoard,
                        NormalizedStatus = normalized,
                        CardNumber = cardNumber,
                        CardIsActive = cardActive,
                        DateOfDeath = detail?.DateOfDeath
                    };
                })
                .Where(m => m != null)
                .Cast<MemberCardModel>()
                .ToList();

            ApplyFilters();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "[Members] Unable to load members");
            _errorMessage = "Unable to load members.";
            _allMembers = new();
            _filteredMembers = new();
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private void ApplyFilters(ChangeEventArgs? _ = null)
    {
        IEnumerable<MemberCardModel> query = _allMembers;

        if (!string.IsNullOrWhiteSpace(_searchTerm))
        {
            var term = _searchTerm.Trim();
            query = query.Where(m =>
                (!string.IsNullOrWhiteSpace(m.FullName) && m.FullName.Contains(term, StringComparison.OrdinalIgnoreCase)) ||
                m.MemberId.ToString().Contains(term, StringComparison.OrdinalIgnoreCase) ||
                (!string.IsNullOrWhiteSpace(m.Email) && m.Email.Contains(term, StringComparison.OrdinalIgnoreCase)) ||
                (!string.IsNullOrWhiteSpace(m.Phone) && m.Phone.Contains(term, StringComparison.OrdinalIgnoreCase)));
        }

        query = query.Where(MatchesStatusFilter);

        query = _sortOption switch
        {
            "status" => query.OrderBy(m => GetStatusLabel(m.Status)).ThenBy(m => m.FullName),
            "dues" => query.OrderBy(m => m.DuesStatus).ThenBy(m => m.FullName),
            "id" => query.OrderBy(m => m.MemberId),
            "applied" => query.OrderByDescending(m => m.ApplicationDate).ThenBy(m => m.FullName),
            "accepted" => query.OrderByDescending(m => m.MemberSince).ThenBy(m => m.FullName),
            _ => query.OrderBy(m => m.FullName)
        };

        _filteredMembers = query.ToList();
        StateHasChanged();
    }

    private int GetFilterCount(string value)
    {
        if (_allMembers == null) return 0;
        if (value == "all") return _allMembers.Count;
        return _allMembers.Count(m => MatchesFilterValue(m, value));
    }

    private bool MatchesStatusFilter(MemberCardModel member) => MatchesFilterValue(member, _statusFilter);

    private bool MatchesFilterValue(MemberCardModel member, string filter) => filter switch
    {
        "regular" => member.Status == MemberStatus.Regular,
        "guest" => member.Status == MemberStatus.Guest,
        "life" => member.Status == MemberStatus.Life,
        "pending" => member.Status == MemberStatus.Pending,
        "npqueue" => member.Status == MemberStatus.RegularNonPortuguese,
        "pastdue" => member.DuesStatus.StartsWith("Past Due", StringComparison.OrdinalIgnoreCase),
        "inactive" => member.Status is MemberStatus.Inactive or MemberStatus.Rejected,
        "deceased" => member.Status == MemberStatus.Deceased,
        _ => true
    };

    private void OnSearchChanged()
    {
        _debounceCts?.Cancel();
        var cts = new CancellationTokenSource();
        _debounceCts = cts;

        _ = Task.Run(async () =>
        {
            try
            {
                await Task.Delay(200, cts.Token);
                if (!cts.IsCancellationRequested)
                {
                    ApplyFilters();
                }
            }
            catch (TaskCanceledException)
            {
                // ignore
            }
        });
    }

    private void ClearSearch()
    {
        _searchTerm = string.Empty;
        ApplyFilters();
    }

    private void ClearFilters()
    {
        _searchTerm = string.Empty;
        _statusFilter = "all";
        ApplyFilters();
    }

    private void SetStatusFilter(string value)
    {
        _statusFilter = value;
        ApplyFilters();
    }

    private bool IsChipActive(string value) => string.Equals(_statusFilter, value, StringComparison.OrdinalIgnoreCase);

    private readonly HashSet<int> _selectedMemberIds = new();

    private int SelectedCount => _selectedMemberIds.Count;

    private bool IsSelected(int memberId) => _selectedMemberIds.Contains(memberId);

    private bool IsAllVisibleSelected =>
        _filteredMembers.Count > 0 && _filteredMembers.All(m => _selectedMemberIds.Contains(m.MemberId));

    private string GetMemberDisplayName(MemberCardModel member) =>
        string.IsNullOrWhiteSpace(member.FullName) ? $"Member {member.MemberId}" : member.FullName;

    private void OnMemberRowClick(int memberId)
    {
        NavigateToMember(memberId);
    }

    private void OnRowKeyDown(KeyboardEventArgs e, int memberId)
    {
        if (e.Key == "Enter" || e.Key == " " || e.Key == "Spacebar")
        {
            NavigateToMember(memberId);
        }
    }

    private EventCallback<MouseEventArgs> CreateRowClickCallback(int memberId) =>
        EventCallback.Factory.Create<MouseEventArgs>(this, () => OnMemberRowClick(memberId));

    private void ToggleSelection(ChangeEventArgs e, int memberId)
    {
        var isChecked = e.Value is bool value && value;

        if (isChecked)
        {
            _selectedMemberIds.Add(memberId);
        }
        else
        {
            _selectedMemberIds.Remove(memberId);
        }
    }

    private EventCallback<ChangeEventArgs> CreateSelectionCallback(int memberId) =>
        EventCallback.Factory.Create<ChangeEventArgs>(this, e => ToggleSelection(e, memberId));

    private void ToggleSelectAll(ChangeEventArgs e)
    {
        var isChecked = e.Value is bool value && value;

        if (isChecked)
        {
            foreach (var member in _filteredMembers)
            {
                _selectedMemberIds.Add(member.MemberId);
            }
        }
        else
        {
            foreach (var member in _filteredMembers)
            {
                _selectedMemberIds.Remove(member.MemberId);
            }
        }
    }

    private void ClearSelection()
    {
        if (_selectedMemberIds.Count == 0)
        {
            return;
        }

        _selectedMemberIds.Clear();
    }

    private static string GetStatusLabel(MemberStatus status) => status switch
    {
        MemberStatus.Regular => "Regular",
        MemberStatus.RegularNonPortuguese => "NP-Regular",
        MemberStatus.Guest => "Guest",
        MemberStatus.Life => "Life",
        MemberStatus.Inactive => "Inactive",
        MemberStatus.Deceased => "Deceased",
        MemberStatus.Rejected => "Rejected",
        MemberStatus.Pending => "Pending",
        _ => "Unknown"
    };

    private static string FormatDate(DateTime? value) =>
        value?.ToString("MMM d, yyyy", CultureInfo.InvariantCulture) ?? "—";

    private string GetStatusBadgeClass(MemberStatus status) => status switch
    {
        MemberStatus.Regular => "status-regular",
        MemberStatus.RegularNonPortuguese => "status-regular-np",
        MemberStatus.Guest => "status-guest",
        MemberStatus.Life => "status-life",
        MemberStatus.Inactive => "status-inactive",
        MemberStatus.Deceased => "status-deceased",
        MemberStatus.Rejected => "status-rejected",
        MemberStatus.Pending => "status-regular-np", // Neutral/Pending color
        _ => "status-guest"
    };

    private string GetDuesBadgeClass(string dues)
    {
        if (string.IsNullOrWhiteSpace(dues)) return "dues-waived";
        var d = dues.Trim().ToLowerInvariant();
        
        if (d == "paid") return "dues-paid";
        if (d.Contains("past due") || d.Contains("overdue") || d == "suspended") return "dues-overdue";
        if (d.Contains("grace period")) return "dues-overdue"; // Keeping orange for grace but label differs
        if (d == "waived") return "dues-waived";
        if (d == "life") return "dues-life";
        if (d == "pending") return "status-regular-np";
        
        return "dues-waived";
    }

    private string GetDuesLabel(string dues)
    {
        if (string.IsNullOrWhiteSpace(dues)) return "Dues —";
        
        // Map "Past Due" to "Overdue" for the UI
        if (dues.StartsWith("Past Due", StringComparison.OrdinalIgnoreCase))
        {
            return dues.Replace("Past Due", "Overdue");
        }
        
        return dues;
    }

    private void NavigateToMember(int memberId) =>
        NavManager.NavigateTo($"/members/{memberId}");

    private void NavigateToAdd() =>
        NavManager.NavigateTo("/members/new");

    public void Dispose()
    {

        _debounceCts?.Cancel();
        _debounceCts?.Dispose();
    }



    private sealed record StatusChip(string Value, string Label, string Color);

    private sealed class MemberCardModel
    {
        public int MemberId { get; set; }
        public string FullName { get; set; } = string.Empty;
        public MemberStatus Status { get; set; }
        public string NormalizedStatus { get; set; } = string.Empty;
        public string? City { get; set; }
        public string? Email { get; set; }
        public string? Phone { get; set; }
        public DateTime? MemberSince { get; set; }
        public DateTime? RegularSince { get; set; }
        public DateTime? ApplicationDate { get; set; }
        public bool IsNonPortuguese { get; set; }
        public bool HasKeyCard { get; set; }
        public DateTime? InactiveDate { get; set; }
        public DateTime? DateOfDeath { get; set; }
        public string DuesStatus { get; set; } = "Paid";
        public int OverdueMonths { get; set; }
        public bool IsBoardMember { get; set; }
        public string? CardNumber { get; set; }
        public bool? CardIsActive { get; set; }
    }
    
    private static string BuildFullName(string? firstName, string? middleName, string? lastName, string? suffix)
    {
        var first = firstName?.Trim() ?? "";
        var last = lastName?.Trim() ?? "";
        var middle = middleName?.Trim() ?? "";
        var suf = suffix?.Trim() ?? "";

        var mFirst = first;
        var mLast = last;
        var mMiddle = string.IsNullOrWhiteSpace(middle) ? "" : " " + middle[0] + ".";
        var mSuffix = string.IsNullOrWhiteSpace(suf) ? "" : " " + suf;

        if (string.IsNullOrWhiteSpace(mLast)) return (mFirst + mMiddle + mSuffix).Trim();
        return $"{mLast}, {mFirst}{mMiddle}{mSuffix}".Trim().Replace("  ", " ");
    }
}
