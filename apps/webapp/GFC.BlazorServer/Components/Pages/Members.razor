@page "/members"
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@using System.Globalization
@using GFC.Core.BusinessRules
@using GFC.Core.DTOs
@using GFC.Core.Enums
@using GFC.Core.Interfaces
@using GFC.Core.Models
@inject IMemberQueryService MemberQueryService
@inject IMemberRepository MemberRepository
@inject ILogger<Members> Logger
@inject NavigationManager NavManager
@inject IKeyCardRepository KeyCardRepository
@inject IDuesRepository DuesRepository
@inject IBoardRepository BoardRepository
@inject IDuesYearSettingsRepository DuesYearSettingsRepository
@inject IDuesWaiverRepository DuesWaiverRepository
@inject KeyCardService CardService
@inject GFC.Core.Interfaces.IHistoryRepository HistoryRepository

@implements IDisposable

<div class="members-dashboard-container">
    <div class="fixed-top-section">
        <div class="sticky-header-top">
            <div class="d-flex justify-content-between align-items-center mb-3 px-2 flex-wrap gap-2">
                <div>
                    <h1 class="page-title-modern mb-1">Member Directory</h1>
                    <p class="text-muted mb-0">Comprehensive list and management of the club membership</p>
                </div>
                <div class="btn-group rounded-pill border shadow-sm p-1 bg-white">
                    <button class="btn btn-sm @(_activeTab == "directory" ? "btn-dark rounded-pill px-3 fw-bold" : "btn-link text-muted text-decoration-none px-3")" @onclick='() => SetTab("directory")'>
                        <i class="bi bi-people-fill me-1"></i>Directory List
                    </button>
                    <button class="btn btn-sm @(_activeTab == "activity" ? "btn-dark rounded-pill px-3 fw-bold" : "btn-link text-muted text-decoration-none px-3")" @onclick='() => SetTab("activity")'>
                        <i class="bi bi-clock-history me-1"></i>Activity Log
                    </button>
                </div>
            </div>
        @if (_activeTab == "directory")
        {
            <!-- 1. INSIGHT HEADER: Tightened Metric Cards -->
            <div class="row g-3 mb-3">
                <div class="col-md-3">
                    <div class="metric-card-modern tight glass-blue scale-in">
                        <div class="metric-icon-box small">
                            <i class="bi bi-people-fill"></i>
                        </div>
                        <div class="metric-content">
                            <span class="metric-label">Total Members</span>
                            <h3 class="metric-value">@_allMembers.Count</h3>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="metric-card-modern tight glass-green scale-in" style="animation-delay: 0.1s;">
                        <div class="metric-icon-box small">
                            <i class="bi bi-check-circle-fill"></i>
                        </div>
                        <div class="metric-content">
                            <span class="metric-label">Active Paid</span>
                            <h3 class="metric-value">@_allMembers.Count(m => (m.Status is MemberStatus.Regular or MemberStatus.RegularNonPortuguese or MemberStatus.Life or MemberStatus.Guest) && (m.DuesStatus is "Paid" or "Waived" or "Life"))</h3>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="metric-card-modern tight glass-orange scale-in" style="animation-delay: 0.2s;">
                        <div class="metric-icon-box small">
                            <i class="bi bi-credit-card-2-front-fill"></i>
                        </div>
                        <div class="metric-content">
                            <span class="metric-label">With Cards</span>
                            <h3 class="metric-value">@_allMembers.Count(m => !string.IsNullOrEmpty(m.CardNumber))</h3>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="metric-card-modern tight glass-purple scale-in" style="animation-delay: 0.3s;">
                        <div class="metric-icon-box small">
                            <i class="bi bi-person-plus-fill"></i>
                        </div>
                        <div class="metric-content d-flex align-items-center">
                            <button class="btn btn-add-member-minimal" @onclick="NavigateToAdd">
                                <i class="bi bi-plus-lg me-1"></i> Add Member
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 2. CONTROL CENTER: Unified Filter Bar (Tightened) -->
            <div class="control-center-glass tight slide-in-bottom">
                <div class="row g-3 align-items-center">
                    <div class="col-lg-5">
                        <div class="search-input-wrapper">
                            <i class="bi bi-search search-icon"></i>
                            <input type="text" 
                                   class="form-control-modern slim" 
                                   placeholder="Search members..."
                                   @bind="_searchTerm"
                                   @bind:event="oninput"
                                   @bind:after="OnSearchChanged"
                                   disabled="@_isLoading" />
                            @if (!string.IsNullOrWhiteSpace(_searchTerm))
                            {
                                <button class="btn-search-clear" @onclick="ClearSearch">
                                    <i class="bi bi-x"></i>
                                </button>
                            }
                        </div>
                    </div>
                    <div class="col-lg-3">
                        <div class="sort-wrapper">
                            <i class="bi bi-sort-down-alt sort-icon"></i>
                            <select class="form-select-modern slim" @bind="_sortOption" @bind:after="() => ApplyFilters()">
                                <option value="name">Sort by Name</option>
                                <option value="applied">Recent Applications</option>
                                <option value="accepted">Membership Date</option>
                                <option value="status">Status</option>
                                <option value="dues">Dues Status</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-lg-4 text-end">
                        <div class="filter-indicators">
                            @if (HasActiveFilters)
                            {
                                <button class="btn-clear-all slim" @onclick="ClearFilters">
                                    <i class="bi bi-filter-left me-1"></i> Reset
                                </button>
                            }
                        </div>
                    </div>
                </div>

                <div class="status-chips-scroll mt-2">
                    @foreach (var chip in _statusChips)
                    {
                        var count = GetFilterCount(chip.Value);
                        <button class="status-chip-modern slim @(IsChipActive(chip.Value) ? "active" : "")" 
                                @onclick="() => SetStatusFilter(chip.Value)"
                                disabled="@_isLoading">
                            <span class="chip-label">@chip.Label</span>
                            <span class="chip-count">@count</span>
                        </button>
                    }
                </div>
            </div>
        }
        </div>
    </div>

    <div class="scrollable-member-list">
        @if (_activeTab == "directory")
        {
            <!-- 3. MAIN LIST -->
            @if (_isLoading)
            {
                <div class="loading-overlay">
                    <div class="loader-modern"></div>
                    <p class="text-muted mt-3">Gathering member data...</p>
                </div>
            }
            else if (!string.IsNullOrWhiteSpace(_errorMessage))
            {
                <div class="alert alert-danger glass-morphic border-danger mt-4 scale-in">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-exclamation-triangle-fill fs-4 me-3"></i>
                        <div>
                            <h5 class="alert-heading mb-1">Connection Error</h5>
                            <p class="mb-0">@_errorMessage</p>
                        </div>
                        <button class="btn btn-danger ms-auto" type="button" @onclick="LoadMembersAsync">
                            <i class="bi bi-arrow-clockwise me-1"></i> Retry
                        </button>
                    </div>
                </div>
            }
            else if (_filteredMembers.Count == 0)
            {
                <div class="empty-state-modern scale-in">
                    <div class="empty-icon">
                        <i class="bi bi-people"></i>
                    </div>
                    <h3>No members found</h3>
                    <p>Adjust your search or filters to see results.</p>
                </div>
            }
            else
            {
                <div class="member-grid-modern">
                    @foreach (var member in _filteredMembers)
                    {
                        bool isOverdue = member.DuesStatus.Contains("Past Due", StringComparison.OrdinalIgnoreCase) || 
                                         member.DuesStatus.Contains("Overdue", StringComparison.OrdinalIgnoreCase);

                        <div class="member-card-simplified scale-in @(isOverdue ? "is-overdue" : "")" @onclick="() => NavigateToMember(member.MemberId)">
                            <div class="card-body-simple">
                                <div class="d-flex justify-content-between align-items-start mb-3">
                                    <div class="name-id-group">
                                        <span class="member-id-tag">#@member.MemberId</span>
                                        <h4 class="member-name-simple">@member.FullName</h4>
                                    </div>
                                    <div class="status-pill-group">
                                        <span class="badge-modern @GetStatusBadgeClass(member.Status)">
                                            @GetStatusLabel(member.Status)
                                        </span>
                                    </div>
                                </div>

                                <div class="d-flex justify-content-between align-items-center mt-auto">
                                    <div class="dues-info d-flex align-items-center">
                                        <span class="badge-modern @GetDuesBadgeClass(member.DuesStatus)">
                                            @if (isOverdue)
                                            {
                                                <i class="bi bi-exclamation-triangle-fill me-1"></i>
                                            }
                                            @GetDuesLabel(member.DuesStatus)
                                        </span>
                                        @if (member.MemberSince.HasValue)
                                        {
                                            <span class="member-since-simple ms-2">Since @member.MemberSince.Value.Year</span>
                                        }
                                    </div>
                                    
                                    <div class="card-info-simple">
                                        @if (!string.IsNullOrEmpty(member.CardNumber))
                                        {
                                            <div class="card-display-simple">
                                                <i class="bi bi-credit-card-2-front me-1"></i>
                                                <span class="card-num-simple">@member.CardNumber</span>
                                                <span class="card-status-dot @(member.CardIsActive == true ? "active" : "inactive")"></span>
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="no-card-simple">No Card</span>
                                        }
                                    </div>
                                </div>
                            </div>
                            <div class="card-action-overlay">
                                <span>View Profile <i class="bi bi-arrow-right ms-1"></i></span>
                            </div>
                        </div>
                    }
                </div>

                <div class="list-footer-minimal mt-5">
                    Total Results: <strong>@_filteredMembers.Count</strong> members
                </div>
            }
        }
        else if (_activeTab == "activity")
        {
            <div class="card border-0 shadow-sm rounded-4 p-4 glass-morphic">
                <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
                    <div>
                        <h4 class="fw-bold mb-1 text-dark">Global Member Activity Feed</h4>
                        <p class="small text-muted mb-0">Track real-time membership changes, status transitions, dues payments, and waivers.</p>
                    </div>
                    <button class="btn btn-sm btn-outline-secondary rounded-pill px-3" @onclick="LoadHistoryAsync">
                        @if (_loadingHistory)
                        {
                            <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                        }
                        else
                        {
                            <i class="bi bi-arrow-repeat me-1"></i>
                        }
                        Refresh Feed
                    </button>
                </div>
                <div class="table-responsive border rounded-4 overflow-hidden bg-white shadow-sm">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light uppercase-tracking text-dark" style="font-size: 0.75rem; height: 42px;">
                            <tr>
                                <th class="ps-3 fw-bold" style="width: 15%;">Date</th>
                                <th class="fw-bold" style="width: 25%;">Member</th>
                                <th class="fw-bold" style="width: 15%;">Field</th>
                                <th class="fw-bold" style="width: 30%;">Change Details</th>
                                <th class="text-end pe-3 fw-bold" style="width: 15%;">Changed By</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (_loadingHistory && _memberHistory == null)
                            {
                                <tr>
                                    <td colspan="5" class="text-center py-5">
                                        <div class="spinner-border text-primary mb-3"></div>
                                        <div class="text-muted fw-bold">Retrieving activity log from server...</div>
                                    </td>
                                </tr>
                            }
                            else if (_memberHistory == null || !_memberHistory.Any())
                            {
                                <tr>
                                    <td colspan="5" class="text-center py-5 text-muted">
                                        <div class="empty-icon fs-2 text-muted mb-2"><i class="bi bi-clock-history"></i></div>
                                        <div>No member changes found in the activity feed.</div>
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var change in _memberHistory)
                                {
                                    <tr style="height: 48px;">
                                        <td class="ps-3 text-muted small">@change.ChangeDate.ToLocalTime().ToString("MM/dd HH:mm")</td>
                                        <td>
                                            <a href="/members/@change.MemberID" class="fw-bold text-dark text-decoration-none hover-primary small">
                                                @change.MemberName
                                            </a>
                                        </td>
                                        <td>
                                            <span class="badge bg-light text-dark border rounded-pill px-2 py-1" style="font-size: 0.65rem;">@change.FieldName</span>
                                        </td>
                                        <td class="small">
                                            @if (string.Equals(change.FieldName, "Member Created", StringComparison.OrdinalIgnoreCase))
                                            {
                                                <span class="text-success"><i class="bi bi-person-plus-fill me-1"></i> New member registered: <strong>@change.NewValue</strong></span>
                                            }
                                            else if (string.Equals(change.FieldName, "Dues Paid", StringComparison.OrdinalIgnoreCase))
                                            {
                                                <span class="text-primary"><i class="bi bi-cash-coin me-1"></i> <strong>@change.NewValue</strong></span>
                                            }
                                            else if (string.Equals(change.FieldName, "Waiver Granted", StringComparison.OrdinalIgnoreCase))
                                            {
                                                <span class="text-warning"><i class="bi bi-gift-fill me-1"></i> <strong>@change.NewValue</strong></span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">@change.OldValue</span> 
                                                <i class="bi bi-arrow-right mx-1 text-muted"></i> 
                                                <span class="fw-bold text-dark">@change.NewValue</span>
                                            }
                                        </td>
                                        <td class="text-end pe-3 font-monospace small fw-bold text-muted">@change.ChangedBy</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </div>
</div>

<style>
    :root {
        --gfc-bg: #f8fafc;
        --gfc-surface: #ffffff;
        --gfc-border: #e2e8f0;
        --gfc-primary: #3b82f6;
        --gfc-success: #10b981;
        --gfc-warning: #f59e0b;
        --gfc-danger: #ef4444;
        --gfc-text-main: #1e293b;
        --gfc-text-muted: #64748b;
        --gfc-glass-bg: rgba(255, 255, 255, 0.7);
        --gfc-shadow: 0 4px 6px -1px rgba(0,0,0,0.1), 0 2px 4px -2px rgba(0,0,0,0.1);
    }

    .glass-morphic {
        background: rgba(255, 255, 255, 0.7) !important;
        backdrop-filter: blur(10px) !important;
        -webkit-backdrop-filter: blur(10px) !important;
        border: 1px solid rgba(255, 255, 255, 0.3) !important;
    }

    .members-dashboard-container {
        max-width: 1400px;
        margin: 0 auto;
        height: calc(100vh - 110px); /* Constrain height to viewport minus top-bar */
        display: flex;
        flex-direction: column;
        overflow: hidden; /* The container itself doesn't scroll */
    }

    .page-title-modern {
        font-size: 1.75rem;
        font-weight: 700;
        color: var(--gfc-text-main);
        letter-spacing: -0.025em;
    }

    .fixed-top-section {
        flex-shrink: 0;
        background: #f8fafc;
        z-index: 10;
        padding: 0.5rem 0.5rem 0 0.5rem;
    }

    .scrollable-member-list {
        flex: 1;
        overflow-y: auto;
        padding: 1rem 0.5rem 2rem 0.5rem;
        /* Smooth scrolling for cards */
        scroll-behavior: smooth;
    }

    /* --- Metric Cards --- */
    .metric-card-modern {
        background: var(--gfc-surface);
        border: 1px solid var(--gfc-border);
        border-radius: 1.25rem;
        padding: 1.25rem;
        display: flex;
        align-items: center;
        gap: 1.25rem;
        box-shadow: var(--gfc-shadow);
        transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
        position: relative;
        overflow: hidden;
    }

    .metric-card-modern.tight {
        padding: 0.75rem 1.25rem;
    }

    .metric-card-modern:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 20px -5px rgba(0,0,0,0.05);
    }

    .metric-icon-box {
        width: 48px;
        height: 48px;
        border-radius: 1rem;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.35rem;
        flex-shrink: 0;
    }

    .metric-icon-box.small {
        width: 40px;
        height: 40px;
        font-size: 1.15rem;
    }

    .glass-blue { border-left: 4px solid var(--gfc-primary); }
    .glass-blue .metric-icon-box { background: rgba(59, 130, 246, 0.1); color: var(--gfc-primary); }

    .glass-green { border-left: 4px solid var(--gfc-success); }
    .glass-green .metric-icon-box { background: rgba(16, 185, 129, 0.1); color: var(--gfc-success); }

    .glass-orange { border-left: 4px solid var(--gfc-warning); }
    .glass-orange .metric-icon-box { background: rgba(245, 158, 11, 0.1); color: var(--gfc-warning); }

    .glass-purple { border-left: 4px solid #8b5cf6; }
    .glass-purple .metric-icon-box { background: rgba(139, 92, 246, 0.1); color: #8b5cf6; }

    .metric-label { font-size: 0.75rem; color: var(--gfc-text-muted); font-weight: 700; display: block; text-transform: uppercase; letter-spacing: 0.02em; }
    .metric-value { font-size: 1.5rem; font-weight: 800; color: var(--gfc-text-main); margin: 0; line-height: 1.1; }

    .btn-add-member-minimal {
        background: var(--gfc-primary);
        color: white;
        border: none;
        border-radius: 0.75rem;
        padding: 0.5rem 0.85rem;
        font-weight: 700;
        font-size: 0.85rem;
        display: flex;
        align-items: center;
        gap: 0.4rem;
        transition: all 0.2s ease;
    }

    .btn-add-member-minimal:hover {
        background: #2563eb;
        box-shadow: 0 4px 12px rgba(37, 99, 235, 0.3);
    }

    /* --- Control Center --- */
    .control-center-glass {
        background: var(--gfc-glass-bg);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid rgba(255, 255, 255, 0.4);
        border-radius: 1.25rem;
        padding: 1.25rem;
        box-shadow: 0 10px 15px -3px rgba(0,0,0,0.05);
    }

    .control-center-glass.tight {
        padding: 0.75rem 1.25rem;
    }

    .search-input-wrapper { position: relative; }
    .search-icon { position: absolute; left: 1rem; top: 50%; transform: translateY(-50%); color: var(--gfc-text-muted); }
    .form-control-modern {
        background: white;
        border: 1px solid var(--gfc-border);
        border-radius: 0.85rem;
        padding: 0.65rem 1rem 0.65rem 2.75rem;
        font-size: 0.9rem;
        width: 100%;
        transition: all 0.2s ease;
    }

    .form-control-modern.slim {
        padding-top: 0.5rem;
        padding-bottom: 0.5rem;
    }

    .form-control-modern:focus {
        border-color: var(--gfc-primary);
        box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
        outline: none;
    }

    .sort-wrapper { position: relative; }
    .sort-icon { position: absolute; left: 0.85rem; top: 50%; transform: translateY(-50%); color: var(--gfc-text-muted); pointer-events: none; }
    .form-select-modern {
        background: white;
        border: 1px solid var(--gfc-border);
        border-radius: 0.85rem;
        padding: 0.65rem 1rem 0.65rem 2.25rem;
        font-size: 0.9rem;
        width: 100%;
        cursor: pointer;
        appearance: none;
    }

    .form-select-modern.slim {
        padding-top: 0.5rem;
        padding-bottom: 0.5rem;
    }

    .status-chips-scroll {
        display: flex;
        gap: 0.5rem;
        overflow-x: auto;
        padding-bottom: 0.25rem;
        scrollbar-width: none;
    }
    .status-chips-scroll::-webkit-scrollbar { display: none; }

    .status-chip-modern {
        background: white;
        border: 1px solid var(--gfc-border);
        border-radius: 2rem;
        padding: 0.4rem 1rem;
        font-size: 0.8rem;
        font-weight: 700;
        color: var(--gfc-text-muted);
        white-space: nowrap;
        display: flex;
        align-items: center;
        gap: 0.4rem;
        transition: all 0.2s ease;
    }

    .status-chip-modern.slim {
        padding-top: 0.25rem;
        padding-bottom: 0.25rem;
    }

    .status-chip-modern:hover { border-color: var(--gfc-primary); color: var(--gfc-primary); }
    .status-chip-modern.active {
        background: var(--gfc-primary);
        color: white;
        border-color: var(--gfc-primary);
        box-shadow: 0 4px 10px rgba(59, 130, 246, 0.3);
    }

    .btn-clear-all.slim {
        padding: 0.4rem 1rem;
        font-size: 0.8rem;
        border-radius: 0.75rem;
    }

    .status-chip-modern:hover { border-color: var(--gfc-primary); color: var(--gfc-primary); }
    .status-chip-modern.active {
        background: var(--gfc-primary);
        color: white;
        border-color: var(--gfc-primary);
        box-shadow: 0 4px 10px rgba(59, 130, 246, 0.3);
    }

    .chip-count {
        background: rgba(0, 0, 0, 0.05);
        padding: 0.1rem 0.5rem;
        border-radius: 1rem;
        font-size: 0.75rem;
    }
    .active .chip-count { background: rgba(255, 255, 255, 0.2); }

    /* --- Member Grid --- */
    .member-grid-modern {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr;
        gap: 1rem;
    }

    .member-card-simplified {
        background: var(--gfc-surface);
        border: 1px solid var(--gfc-border);
        border-radius: 1.25rem;
        position: relative;
        overflow: hidden;
        cursor: pointer;
        transition: all 0.25s cubic-bezier(0.165, 0.84, 0.44, 1);
        box-shadow: 0 2px 8px rgba(0,0,0,0.03);
        display: flex;
        flex-direction: column;
    }

    .member-card-simplified:hover {
        transform: translateY(-4px);
        border-color: var(--gfc-primary);
        box-shadow: 0 12px 24px -8px rgba(0,0,0,0.08);
    }

    .member-card-simplified.is-overdue {
        border-left: 5px solid var(--gfc-danger);
        background: linear-gradient(to right, rgba(239, 68, 68, 0.05), var(--gfc-surface));
    }

    .member-card-simplified.is-overdue:hover {
        border-color: var(--gfc-danger);
        box-shadow: 0 12px 24px -8px rgba(239, 68, 68, 0.15);
    }

    .card-body-simple {
        padding: 1.25rem;
        flex: 1;
        display: flex;
        flex-direction: column;
    }

    .name-id-group {
        display: flex;
        flex-direction: column;
    }

    .member-id-tag {
        font-size: 0.75rem;
        font-weight: 800;
        color: var(--gfc-text-muted);
        text-transform: uppercase;
        letter-spacing: 0.05em;
        margin-bottom: 0.15rem;
    }

    .member-name-simple {
        font-size: 1.15rem;
        font-weight: 800;
        color: var(--gfc-text-main);
        margin: 0;
        line-height: 1.2;
    }

    .member-since-simple {
        font-size: 0.75rem;
        color: var(--gfc-text-muted);
