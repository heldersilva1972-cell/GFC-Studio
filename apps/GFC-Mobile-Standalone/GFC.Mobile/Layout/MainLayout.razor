@inherits LayoutComponentBase
@using Blazored.Toast.Configuration
@using Blazored.Toast
@using GFC.Mobile.Auth
@inject IJSRuntime JSRuntime
@inject ICustomAuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@implements IDisposable

<div class="page mobile-layout">
    <BlazoredToasts Position="ToastPosition.TopRight"
                    Timeout="5"
                    IconType="IconType.FontAwesome"
                    SuccessClass="success-toast-override"
                    ErrorClass="error-toast-override" />

    <CascadingAuthenticationState>
        <AuthorizeView>
            <Authorized>
                <IdleHandler OnIdle="HandleIdle" />
            </Authorized>
        </AuthorizeView>
    </CascadingAuthenticationState>

    <main>
        <article class="content">
            @Body
        </article>
    </main>
</div>

@code {
    private async Task HandleIdle()
    {
        Console.WriteLine("[IDLE] 15 minute threshold reached. Logging out...");
        await AuthStateProvider.LogoutAsync();
        Navigation.NavigateTo("/login");
    }

    public void Dispose()
    {
        // Cleanup if needed
    }
}

<style>
    .mobile-layout {
        background-color: var(--bg-primary);
        color: var(--text-primary);
        min-height: 100vh;
        width: 100%;
        margin: 0;
        padding: 0;
        position: relative;
        overflow-x: hidden;
    }
    
    .content {
        padding: 0;
        margin: 0;
        width: 100%;
    }
</style>
