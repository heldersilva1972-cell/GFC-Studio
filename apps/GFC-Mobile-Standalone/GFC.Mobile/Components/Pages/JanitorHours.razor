@page "/mobile/janitor-hours"
@using Microsoft.AspNetCore.Authorization
@using GFC.Core.Interfaces
@using GFC.Core.Models
@using GFC.Core.DTOs
@inject IMobileReportingService ReportingService
@inject NavigationManager Navigation
@inject ICustomAuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JSRuntime
@attribute [Authorize]

<PageTitle>Janitor Hours | GFC Mobile</PageTitle>

<MobileHubHeader IsConnected="@_isCircutAlive" StatusText="@_syncStatus" LastSynced="@_lastSyncedAt" Username="@Username" />

<div class="container animate-entrance d-flex align-items-center justify-content-center" style="min-height: calc(100vh - 120px); padding-top: 2rem; padding-bottom: 2rem;">
    <div class="row justify-content-center w-100">
        <div class="col-12" style="max-width: 450px;">
            
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden mb-0">
                <div class="card-header bg-primary text-white p-3 border-0">
                    <div class="d-flex align-items-center gap-3">
                        <div class="rounded-circle bg-white d-flex align-items-center justify-content-center shadow-sm" style="width: 40px; height: 40px;">
                            <i class="bi bi-brush fs-5 text-primary"></i>
                        </div>
                        <div>
                            <h6 class="fw-bold mb-0">Record Janitorial Hours</h6>
                            <div class="d-flex align-items-center gap-1 opacity-75" style="font-size: 0.75rem;">
                                <span class="opacity-75">Employee: </span>
                                <span class="fw-black text-uppercase">@(string.IsNullOrEmpty(_displayName) ? Username : _displayName)</span>
                            </div>
                        </div>
                    </div>
                </div>
                
                <div class="card-body p-4 bg-white">
                    @if (IsSuccess)
                    {
                        <div class="text-center py-5">
                            <div class="success-icon-box mb-4 mx-auto shadow-lg animate-bounce-in">
                                <i class="bi bi-check2-circle text-success fs-1"></i>
                            </div>
                            <h3 class="fw-black mb-2">Hours Secured!</h3>
                            <p class="text-muted mb-4">Your entry for @ReportDate.ToString("MMMM dd, yyyy") has been recorded.</p>
                            
                            <div class="d-flex align-items-center justify-content-center gap-2 text-primary fw-bold">
                                <div class="spinner-border spinner-border-sm" role="status"></div>
                                <span>Logging out securely...</span>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="mb-2">
                            <label class="form-label fw-bold text-uppercase small text-muted mb-1" style="font-size: 0.65rem; letter-spacing: 0.05em;">Work Date</label>
                            <div class="input-group-modern py-2 px-3 rounded-4 shadow-sm border bg-light">
                                <div class="d-flex align-items-center justify-content-between w-100">
                                    <div class="d-flex align-items-center gap-3">
                                        <i class="bi bi-calendar3 text-primary fs-5"></i>
                                        <input type="date" class="border-0 bg-transparent fw-bold fs-6 text-dark" style="outline: none;" 
                                               value="@ReportDate.ToString("yyyy-MM-dd")" @onchange="OnDateChanged" />
                                    </div>
                                    <div class="badge bg-primary rounded-pill px-3 py-1 fw-black text-uppercase" style="font-size: 0.6rem;">
                                        @ReportDate.DayOfWeek
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="mb-2">
                            <label class="form-label fw-bold text-uppercase small text-muted mb-1" style="font-size: 0.65rem; letter-spacing: 0.05em;">Hours Worked</label>
                            <div class="input-group-modern p-0 rounded-4 shadow-sm border bg-white @(IsHoursFocused ? "ring-2 ring-primary border-primary" : "")" style="height: 70px;">
                                <div class="d-flex align-items-center justify-content-between w-100 h-100 px-3">
                                    <div class="d-flex flex-column">
                                        <span class="fw-black text-muted" style="font-size: 0.75rem;">DAILY TOTAL</span>
                                        <span class="text-muted" style="font-size: 0.6rem;">Hours worked today</span>
                                    </div>
                                    <div class="d-flex align-items-center">
                                        <div class="form-input-modern text-end pe-1 fw-black text-primary" style="font-size: 2.2rem;">
                                            @(string.IsNullOrEmpty(_hoursInput) ? "0.0" : _hoursInput)
                                        </div>
                                        <div class="ms-1 border-end border-3 border-primary animate-pulse" style="height: 1.8rem;"></div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- CUSTOM TOUCH KEYPAD -->
                        <div class="keypad-container mb-2">
                            <div class="keypad-grid">
                                <button class="key-btn" @onclick='() => KeyPressed("1")'>1</button>
                                <button class="key-btn" @onclick='() => KeyPressed("2")'>2</button>
                                <button class="key-btn" @onclick='() => KeyPressed("3")'>3</button>
                                
                                <button class="key-btn" @onclick='() => KeyPressed("4")'>4</button>
                                <button class="key-btn" @onclick='() => KeyPressed("5")'>5</button>
                                <button class="key-btn" @onclick='() => KeyPressed("6")'>6</button>
                                
                                <button class="key-btn" @onclick='() => KeyPressed("7")'>7</button>
                                <button class="key-btn" @onclick='() => KeyPressed("8")'>8</button>
                                <button class="key-btn" @onclick='() => KeyPressed("9")'>9</button>
                                
                                <button class="key-btn ivory-btn" @onclick='BackspaceCurrentField'><i class="bi bi-backspace"></i></button>
                                <button class="key-btn" @onclick='() => KeyPressed("0")'>0</button>
                                <button class="key-btn" @onclick='() => KeyPressed(".")'>.</button>
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(ErrorMessage))
                        {
                            <div class="alert alert-danger border-0 rounded-4 mb-2 d-flex align-items-center gap-2 py-2">
                                <i class="bi bi-exclamation-circle-fill"></i>
                                <span class="small fw-bold">@ErrorMessage</span>
                            </div>
                        }

                        <button class="btn btn-primary w-100 rounded-pill py-2 fw-black fs-6 shadow-lg d-flex align-items-center justify-content-center gap-2" 
                                disabled="@(IsSubmitting || TotalHours <= 0)" @onclick="PreCheckSubmit">
                            @if (IsSubmitting)
                            {
                                <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                                <span>VERIFYING...</span>
                            }
                            else
                            {
                                <i class="bi bi-send-fill"></i>
                                <span>SUBMIT HOURS</span>
                            }
                        </button>
                    }
                </div>
            </div>
            
        </div>
    </div>
</div>

@if (_showCorrectionModal)
{
    <div class="modal-backdrop-custom animate-fade-in" @onclick="() => _showCorrectionModal = false"></div>
    <div class="correction-sheet animate-slide-up">
        <div class="sheet-handle"></div>
        <div class="p-4 text-center">
            <div class="alert-icon-box mb-3 mx-auto shadow-sm">
                <i class="bi bi-exclamation-triangle-fill text-warning fs-3"></i>
            </div>
            <h4 class="fw-black text-dark mb-2">RECORD CONFLICT</h4>
            <div class="px-3 mb-4">
                <p class="text-muted mb-1"><strong>@_existingHours.ToString("N1") Hours</strong> have been submitted already for this date.</p>
                <p class="small text-muted opacity-75">Do you want to make a correction to <strong>@TotalHours.ToString("N1") Hours</strong>?</p>
            </div>
            
            <div class="d-grid gap-2">
                <button class="btn btn-primary py-3 rounded-pill fw-black shadow-sm" @onclick="() => ProceedWithSave(true)">
                    YES, UPDATE HOURS
                </button>
                <button class="btn btn-light py-3 rounded-pill fw-bold text-muted border" @onclick="() => _showCorrectionModal = false">
                    NO, KEEP PREVIOUS
                </button>
            </div>
        </div>
    </div>
}

<style>
    body { background-color: #f8fafc; }
    .fw-black { font-weight: 900; }
    .animate-entrance { animation: slideUp 0.4s cubic-bezier(0.16, 1, 0.3, 1); }
    .animate-bounce-in { animation: bounceIn 0.5s cubic-bezier(0.34, 1.56, 0.64, 1); }
    .animate-fade-in { animation: fadeIn 0.2s ease-out; }
    .animate-slide-up { animation: slideUp 0.3s cubic-bezier(0.16, 1, 0.3, 1); }

    .modal-backdrop-custom {
        position: fixed; top: 0; left: 0; right: 0; bottom: 0;
        background: rgba(0,0,0,0.4); backdrop-filter: blur(4px); z-index: 1060;
    }

    .correction-sheet {
        position: fixed; top: 50%; left: 50%; transform: translate(-50%, -50%);
        width: 90%; max-width: 400px;
        background: white; border-radius: 32px;
        z-index: 1070; overflow: hidden;
        box-shadow: 0 20px 60px rgba(0,0,0,0.3);
    }
    .sheet-handle { display: none; }

    .alert-icon-box {
        width: 60px; height: 60px;
        background: #fffbeb;
        border: 2px solid #fef3c7;
        border-radius: 20px;
        display: flex; align-items: center; justify-content: center;
    }
    
    .input-group-modern { transition: all 0.2s ease; }
    .success-icon-box {
        width: 80px; height: 80px;
        background: #f0fdf4;
        color: #10b981;
        border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        border: 4px solid #d1fae5;
    }

    @@keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
    @@keyframes slideUp {
        from { transform: translateY(20px); opacity: 0; }
        to { transform: translateY(0); opacity: 1; }
    }
    @@keyframes bounceIn {
        from { transform: scale(0.8); opacity: 0; }
        to { transform: scale(1); opacity: 1; }
    }
    
    /* KEYPAD STYLES FROM SHIFT REPORT */
    .keypad-container {
        background: #f1f5f9;
        border-radius: 20px;
        padding: 15px;
        border: 1px solid #e2e8f0;
    }

    .keypad-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 8px;
    }

    .key-btn {
        height: 52px;
        border-radius: 16px;
        border: none;
        background: white;
        color: #1e293b;
        font-size: 1.5rem;
        font-weight: 900;
        box-shadow: 0 4px 0 #e2e8f0;
        transition: all 0.1s;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .key-btn:active {
        transform: translateY(3px);
        box-shadow: 0 1px 0 #e2e8f0;
        background: #f8fafc;
    }

    .ivory-btn { color: #64748b; background: #f8fafc; }

    /* Remove keypad spinners */
    input::-webkit-outer-spin-button,
    input::-webkit-inner-spin-button {
      -webkit-appearance: none;
      margin: 0;
    }
    input[type=number] {
      -moz-appearance: textfield;
    }
</style>

@code {
    private string Username { get; set; } = "...";
    private DateTime ReportDate { get; set; } = DateTime.Today;
    private decimal TotalHours { get; set; }
    private string _hoursInput = "";
    private bool IsSubmitting { get; set; }
    private bool IsSuccess { get; set; }
    private string? ErrorMessage { get; set; }
    private bool IsHoursFocused { get; set; }
    private bool _showCorrectionModal { get; set; }
    private decimal _existingHours { get; set; }
    private string _displayName { get; set; } = "";
    private AppUser? currentAppUser { get; set; }
    private bool _isCircutAlive = true;
    private string? _syncStatus = null;
    private DateTime? _lastSyncedAt;

    protected override async Task OnInitializedAsync()
    {
        currentAppUser = AuthStateProvider.GetCurrentUser();
        Username = currentAppUser?.Username ?? "Staff Member";
        
        // In the standalone app, we don't have direct DB access to get member name here, 
        // but we can potentially get it from the user service or DTO.
        // For now, we'll use Username as fallback.
    }

    private void KeyPressed(string key)
    {
        if (key == "." && _hoursInput.Contains(".")) return;
        if (_hoursInput.Length >= 6) return;
        
        _hoursInput += key;
        if (decimal.TryParse(_hoursInput, out var val))
        {
            TotalHours = val;
        }
    }

    private void BackspaceCurrentField()
    {
        if (_hoursInput.Length > 0)
        {
            _hoursInput = _hoursInput.Substring(0, _hoursInput.Length - 1);
            if (string.IsNullOrEmpty(_hoursInput))
            {
                TotalHours = 0;
            }
            else if (decimal.TryParse(_hoursInput, out var val))
            {
                TotalHours = val;
            }
        }
    }

    private void OnDateChanged(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out var date))
        {
            ReportDate = date;
        }
    }

    private async Task PreCheckSubmit()
    {
        if (TotalHours <= 0)
        {
            ErrorMessage = "Please enter hours worked.";
            return;
        }

        IsSubmitting = true;
        ErrorMessage = null;

        try
        {
            var user = AuthStateProvider.GetCurrentUser();
            if (user == null)
            {
                ErrorMessage = "User session lost. Please login again.";
                return;
            }

            var existing = await ReportingService.GetShiftReportDataAsync(ReportDate, "Janitor", false);

            if (existing != null && existing.ExistingEntryFound)
            {
                _existingHours = existing.TotalHours ?? 0m;
                _showCorrectionModal = true;
                IsSubmitting = false;
            }
            else
            {
                await ProceedWithSave(false);
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = "Error during verification.";
            Console.WriteLine($"Janitor PreCheck Error: {ex.Message}");
            IsSubmitting = false;
        }
    }

    private async Task ProceedWithSave(bool isCorrection)
    {
        IsSubmitting = true;
        _showCorrectionModal = false;

        try
        {
            var user = AuthStateProvider.GetCurrentUser();
            if (user == null) return;

            var data = new MobileShiftData
            {
                Date = ReportDate,
                ShiftType = "Janitor",
                IsRentalHall = false,
                TotalHours = TotalHours,
                Status = "Submitted",
                ModifiedBy = user.Username
            };

            var success = await ReportingService.SubmitFinalReportAsync(data, user.Username);

            if (success)
            {
                _lastSyncedAt = DateTime.Now;
                _syncStatus = "Synced";
                IsSuccess = true;
                StateHasChanged();
                
                // Auto-logout after 2 seconds
                await Task.Delay(2000);
                await HandleLogout();
            }
            else
            {
                ErrorMessage = "An error occurred while saving. Please try again.";
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = "An error occurred while saving. Please try again.";
            Console.WriteLine($"Janitor Submit Error: {ex.Message}");
        }
        finally
        {
            IsSubmitting = false;
        }
    }

    private async Task HandleLogout()
    {
        try
        {
            var token = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "gfc_device_token");
            await AuthStateProvider.LogoutAsync(token);
            await JSRuntime.InvokeVoidAsync("localStorage.removeItem", "gfc_device_token");
            await JSRuntime.InvokeVoidAsync("window.setCookie", "GFC_DeviceTrustToken", "", -1);
            await Task.Delay(100);
            Navigation.NavigateTo("/login", forceLoad: true);
        }
        catch
        {
            Navigation.NavigateTo("/login", forceLoad: true);
        }
    }

    private void ResetForm()
    {
        TotalHours = 0;
        _hoursInput = "";
        IsSuccess = false;
        ErrorMessage = null;
    }
}
