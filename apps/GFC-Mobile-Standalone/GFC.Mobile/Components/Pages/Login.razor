@page "/login"
@using GFC.Mobile.Auth
@using GFC.Core.Interfaces
@using GFC.Core.Models
@using GFC.Core.Models.Security
@using Microsoft.JSInterop
@using Microsoft.AspNetCore.Authorization
@attribute [AllowAnonymous]
@inject ICustomAuthenticationStateProvider AuthStateProvider
@inject IDeviceTrustService DeviceTrustService
@inject IUserManagementService UserManagementService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject HttpClient Http
@implements IDisposable

<style>
    .connection-status {
        font-size: 0.8rem;
        padding: 4px 12px;
        border-radius: 12px;
        margin-top: 8px;
        display: inline-block;
    }
    .connection-status.checking { background: #e9ecef; color: #495057; }
    .connection-status.error { background: #f8d7da; color: #721c24; border: 1px solid #f5c6cb; }
    
    .spinner-tiny {
        display: inline-block;
        width: 10px;
        height: 10px;
        border: 2px solid #ccc;
        border-top-color: #333;
        border-radius: 50%;
        animation: spin 1s linear infinite;
        vertical-align: middle;
        margin-right: 5px;
    }
</style>

<PageTitle>Login - GFC Mobile</PageTitle>

<div class="login-container">
    <div class="login-card">
        <div class="login-header text-center mb-4">
            <h1 class="text-white fw-bold mb-2">GFC Mobile</h1>
            <p class="text-white-50">Please sign in to continue</p>
        </div>

        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="alert alert-danger px-3 py-2 rounded-3 mb-4 animate-shake" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>@_error
            </div>
        }

        @if (_loginMode == LoginMode.FastGrid && !_showConfirmation)
        {
            <div class="fast-login-grid w-100 animate-fade-in">
                <h6 class="text-white text-center mb-3 text-uppercase ls-1 fw-bold opacity-75">Select Your Identity</h6>
                <div class="user-grid">
                    @if (!_fastLoginUsers.Any())
                    {
                        <div class="col-span-2 text-center py-4">
                            <i class="bi bi-person-x text-white-50" style="font-size: 2rem;"></i>
                            <p class="text-white-50 mt-2 small">No mobile-authorized users found.<br/>Please connect to the server to download identities.</p>
                        </div>
                    }
                    else
                    {
                        @foreach (var user in _fastLoginUsers)
                        {
                            <button class="user-btn" @onclick="() => ProceedToLogin(user)" disabled="@_isSubmitting">
                                @if (_isSubmitting && _confirmingUser?.UserId == user.UserId)
                                {
                                    <div class="spinner-border spinner-border-sm"></div>
                                }
                                else
                                {
                                    <div class="user-name">@user.Username</div>
                                }
                            </button>
                        }
                    }
                </div>
                <div class="text-center mt-4 border-top border-white border-opacity-10 pt-3">
                    <button class="btn btn-link btn-sm text-white-50 text-decoration-none" @onclick='() => SetMode(LoginMode.PassCode)'>
                        <i class="bi bi-keyboard me-1"></i> Manual Login
                    </button>
                </div>
            </div>
        }
        else
        {
            <EditForm Model="_model" OnValidSubmit="HandleLoginAsync" class="login-form">
                <DataAnnotationsValidator />
                <div class="mb-3">
                    <label class="form-label" for="username">Username</label>
                    <InputText id="username" @bind-Value="_model.Username" class="form-control form-control-lg" placeholder="Enter username" autocomplete="username" />
                </div>
                
                <div class="mb-4">
                    <label class="form-label" for="password">Passcode</label>
                    <InputText id="password" type="password" @bind-Value="_model.Password" class="form-control form-control-lg ls-wide text-center fw-bold" placeholder="••••••" autocomplete="current-password" />
                </div>

                <div class="d-grid gap-2">
                    <button type="submit" class="btn btn-primary btn-lg shadow-sm py-3 fw-bold text-uppercase ls-1" disabled="@_isSubmitting">
                        @if (_isSubmitting)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                            <span>Validating...</span>
                        }
                        else
                        {
                            <span>Sign In</span>
                        }
                    </button>
                </div>
                
                @if (_fastLoginUsers.Any() || _loginMode == LoginMode.PassCode)
                {
                    <div class="text-center mt-3">
                        <button type="button" class="btn btn-link btn-sm text-white-50" @onclick='() => SetMode(LoginMode.FastGrid)'>
                            Back to User List
                        </button>
                    </div>
                }
            </EditForm>
        }
    </div>
    <div class="text-center mt-3 opacity-50">
        <small class="text-white">Revision: @VersionService.GetRevision()</small>
    </div>
</div>

<style>
    .login-container {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        min-height: 100vh;
        background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%);
        padding: 1.5rem;
    }

    .login-card {
        background: rgba(15, 23, 42, 0.9);
        backdrop-filter: blur(20px);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 2rem;
        padding: 2.5rem 2rem;
        width: 100%;
        max-width: 450px;
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
    }

    .login-card .form-label {
        color: #ffffff !important;
        font-weight: 700 !important;
        font-size: 1rem !important;
        margin-bottom: 0.5rem !important;
        display: block !important;
    }

    .login-card .form-control {
        background: #f8fafc !important;
        border: 2px solid #e2e8f0 !important;
        border-radius: 0.75rem !important;
        padding: 0.75rem 1rem !important;
        font-size: 1rem !important;
        color: #1e293b !important;
    }

    .login-card .btn-primary {
        background: #3b82f6 !important;
        border: none !important;
        border-radius: 0.75rem !important;
    }

    .ls-wide {
        letter-spacing: 0.4rem;
    }
    .ls-1 {
        letter-spacing: 1px;
    }

    /* Fast Grid */
    .user-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 12px;
        max-height: 400px;
        overflow-y: auto;
        padding-bottom: 0.5rem;
    }
    
    .col-span-2 {
        grid-column: span 2;
    }

    .user-btn {
        background: #312e81; /* Indigo-900 */
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 12px;
        padding: 20px 10px;
        color: white;
        font-weight: 700;
        transition: all 0.2s ease;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
    }

    .user-btn:hover {
        background: #4338ca; /* Indigo-700 */
        transform: translateY(-2px);
        border-color: #6366f1;
        box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.2);
    }
    
    .user-name {
        text-transform: uppercase;
        letter-spacing: 0.5px;
        font-size: 0.85rem;
    }

    .animate-fade-in {
        animation: fadeIn 0.3s ease-in;
    }

    @@keyframes fadeIn {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
    }

    .animate-shake {
        animation: shake 0.5s cubic-bezier(.36,.07,.19,.97) both;
    }

    @@keyframes shake {
        10%, 90% { transform: translate3d(-1px, 0, 0); }
        20%, 80% { transform: translate3d(2px, 0, 0); }
        30%, 50%, 70% { transform: translate3d(-4px, 0, 0); }
        40%, 60% { transform: translate3d(4px, 0, 0); }
    }
</style>

@code {
    [Inject] private IVersionService VersionService { get; set; } = default!;
    private LoginModel _model = new();
    private bool _isSubmitting = false;
    private string? _error;
    private bool _isStationMode = false;
    private LoginMode _loginMode = LoginMode.FastGrid;
    private List<UserListItemDto> _fastLoginUsers = new();
    private UserListItemDto? _confirmingUser = null;
    private bool _showConfirmation = false;
    private bool _isCheckingConnection = true;
    private bool _serverReachable = true;

    private enum LoginMode { PassCode, FastGrid }

    protected override async Task OnInitializedAsync()
    {
        // Fire and forget connection check to avoid blocking the UI
        _ = CheckConnectionAsync();

        try {
            // ALWAYS fetch authorized mobile users for the login grid
            var allUsers = await UserManagementService.GetMobileAuthorizedUsersAsync();
            _fastLoginUsers = allUsers.Where(u => u.IsActive).ToList();
            
            // Subscribe to automatic background updates (Reconciliation Logic)
            if (UserManagementService is GFC.Mobile.Services.MobileUserManagementService mobileService)
            {
                mobileService.OnUsersUpdated += HandleUsersUpdated;
            }

            // Default to FastGrid unless Station Mode overrides it
            _loginMode = LoginMode.FastGrid;

            // Check station identity cookie
            var stationToken = await JSRuntime.InvokeAsync<string>("window.getCookie", "GFC_StationIdentity");
            if (!string.IsNullOrEmpty(stationToken))
            {
                var station = await DeviceTrustService.GetDeviceByTokenAsync(stationToken);
                if (station != null && station.IsStation)
                {
                    _isStationMode = true;
                    if (!string.IsNullOrEmpty(station.AuthorizedUserIdsCsv))
                    {
                        var ids = station.AuthorizedUserIdsCsv.Split(',').Select(int.Parse).ToList();
                        _fastLoginUsers = allUsers.Where(u => ids.Contains(u.UserId) && u.IsActive).ToList();
                    }
                }
            }
        } catch { }
    }

    private async void HandleUsersUpdated()
    {
        try {
            var allUsers = await UserManagementService.GetUsersAsync();
            var activeUsers = allUsers.Where(u => u.IsActive).ToList();
            
            // [UX FIX] Only re-render if the user list has actually changed.
            // This prevents "flickering" that steals clicks during background sync.
            if (_fastLoginUsers.Count != activeUsers.Count || !_fastLoginUsers.All(u => activeUsers.Any(a => a.UserId == u.UserId)))
            {
                _fastLoginUsers = activeUsers;
                await InvokeAsync(StateHasChanged);
            }
        } catch { }
    }

    public void Dispose()
    {
        // Cleanup subscription
        if (UserManagementService is GFC.Mobile.Services.MobileUserManagementService mobileService)
        {
            mobileService.OnUsersUpdated -= HandleUsersUpdated;
        }
    }


    private async Task CheckConnectionAsync()
    {
        try {
            _isCheckingConnection = true;
            await InvokeAsync(StateHasChanged);
            var response = await Http.GetAsync($"{Http.BaseAddress}api/health");
            _serverReachable = response.IsSuccessStatusCode;
        } catch {
            _serverReachable = false;
        } finally {
            _isCheckingConnection = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task HandleLoginAsync()
    {
        _error = null;
        _isSubmitting = true;
        try {
            var result = await AuthStateProvider.LoginAsync(_model.Username, _model.Password, true);
            if (result.Success)
            {
                Navigation.NavigateTo("/");
            }
            else
            {
                _error = "Invalid credentials";
            }
        } catch (Exception ex) {
            if (ex.Message.Contains("Failed to fetch"))
            {
                _error = "Connection blocked by browser. Please use HTTP instead of HTTPS for both App and Server, or check CORS settings.";
            }
            else
            {
                _error = $"Sign in error: {ex.Message}";
            }
            Console.WriteLine($"[LOGIN EXCEPTION] {ex}");
        } finally {
            _isSubmitting = false;
        }
    }

    private async Task ProceedToLogin(UserListItemDto user)
    {
        if (_isSubmitting || user == null) return;
        
        _confirmingUser = user;
        _isSubmitting = true;
        _error = null;
        StateHasChanged();
        
        try {
            var result = await AuthStateProvider.LoginWithUserAsync(user.UserId);
            if (result.Success)
            {
                Navigation.NavigateTo("/");
            }
            else
            {
                _error = "Login failed. Please try manual login.";
                _loginMode = LoginMode.PassCode;
                _model.Username = user.Username;
            }
        } catch (Exception ex) {
            _error = $"Login error: {ex.Message}";
        } finally {
            _isSubmitting = false;
            StateHasChanged();
        }
    }

    private void SetMode(LoginMode mode)
    {
        _loginMode = mode;
        _error = null;
    }

    public class LoginModel
    {
        public string Username { get; set; } = "";
        public string Password { get; set; } = "";
    }
}
