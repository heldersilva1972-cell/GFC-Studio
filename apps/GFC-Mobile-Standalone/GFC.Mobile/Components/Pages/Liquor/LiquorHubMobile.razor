    // -- Ordering Logic --
    private int GetCartQuantity(int itemId) => _cart.ContainsKey(itemId) ? _cart[itemId] : 0;
    private void AddToCart(int itemId, int qty) { if (_cart.ContainsKey(itemId)) _cart[itemId] += qty; else _cart[itemId] = qty; if (_cart[itemId] <= 0) _cart.Remove(itemId); }

    private void AdjustCartCases(int itemId, int delta, int packSize)
    {
        var current = GetCartQuantity(itemId);
        var currentCases = current / packSize;
        var currentBottles = current % packSize;
        var newCases = Math.Max(0, currentCases + delta);
        _cart[itemId] = (newCases * packSize) + currentBottles;
        if (_cart[itemId] <= 0) _cart.Remove(itemId);
    }

    private void AdjustCartBottles(int itemId, int delta, int packSize)
    {
        var current = GetCartQuantity(itemId);
        var currentCases = current / packSize;
        var currentBottles = current % packSize;
        var newBottles = Math.Max(0, currentBottles + delta);
        _cart[itemId] = (currentCases * packSize) + newBottles;
        if (_cart[itemId] <= 0) _cart.Remove(itemId);
    }

    private decimal GetLineTotal(LiquorItem item, int qty)
    {
        decimal lineTotal = 0;
        decimal casePrice = (item.CasePrice.HasValue && item.CasePrice.Value > 0) 
            ? item.CasePrice.Value 
            : item.CurrentPrice;

        decimal bottlePrice = (item.CasePrice.HasValue && item.CasePrice.Value > 0)
            ? item.CurrentPrice
            : (item.PackSize > 0 ? (item.CurrentPrice / item.PackSize) : item.CurrentPrice);

        if (item.PackSize > 1)
        {
            int cases = qty / item.PackSize;
            int bottles = qty % item.PackSize;
            decimal effectiveCasePrice = (item.BulkDiscountThreshold.HasValue && item.BulkDiscountPrice.HasValue && cases >= item.BulkDiscountThreshold.Value)
                ? item.BulkDiscountPrice.Value
                : casePrice;
            lineTotal = (cases * effectiveCasePrice) + (bottles * bottlePrice);
        }
        else
        {
            lineTotal = item.CurrentPrice * qty;
        }
        if (item.IsBeer) lineTotal += 0.05m * qty;
        return lineTotal;
    }

    private decimal GetVendorCartTotal(int vendorId)
    {
        decimal total = 0;
        var vendorItems = _items.Where(i => i.VendorId == vendorId && _cart.ContainsKey(i.Id) && _cart[i.Id] > 0);
        foreach (var item in vendorItems)
        {
            total += GetLineTotal(item, _cart[item.Id]);
        }
        return total;
    }

    private decimal GetCartTotal()
    {
        decimal total = 0;
        foreach (var entry in _cart.Where(e => e.Value > 0))
        {
            var item = _items.FirstOrDefault(i => i.Id == entry.Key);
            if (item != null) 
            {
                total += GetLineTotal(item, entry.Value);
            }
        }
        return total;
    }

    private decimal GetVendorMin(LiquorVendor? vendor)
    {
        if (vendor == null) return 0;
        var freshVendor = _vendors.FirstOrDefault(v => v.Id == vendor.Id);
        return freshVendor?.MinimumOrderAmount ?? 0;
    }
    private async Task CreateOrderAsync(int vendorId)
    {
        if (_currentUser == null) return;
        var vendorItemsInCart = _items.Where(i => i.VendorId == vendorId && _cart.ContainsKey(i.Id)).ToList();
        if (!vendorItemsInCart.Any()) return;
        
        var orderItems = vendorItemsInCart.Select(i => {
            decimal effPrice = i.CasePrice ?? 0;
            if (i.PackSize > 1 && i.CasePrice.HasValue && i.CasePrice.Value > 0)
            {
                int cases = _cart[i.Id] / i.PackSize;
                if (i.BulkDiscountThreshold.HasValue && i.BulkDiscountPrice.HasValue && cases >= i.BulkDiscountThreshold.Value)
                {
                    effPrice = i.BulkDiscountPrice.Value;
                }
            }
            return new LiquorOrderItem { 
                LiquorItemId = i.Id, 
                Quantity = _cart[i.Id], 
                UnitPriceAtTimeOfOrder = i.CurrentPrice, 
                CasePriceAtTimeOfOrder = effPrice > 0 ? effPrice : i.CasePrice,
                BottleFeeAtTimeOfOrder = i.IsBeer ? 0.05m : 0
            };
        }).ToList();

        decimal itemsTotal = 0;
        foreach (var oi in orderItems)
        {
            var item = vendorItemsInCart.First(i => i.Id == oi.LiquorItemId);
            decimal lineTotal = GetLineTotal(item, oi.Quantity);
            itemsTotal += lineTotal;
        }

        var order = new LiquorOrder { 
            VendorId = vendorId, 
            OrderDate = DateTime.Now, 
            Status = "Placed", 
            IsPaid = false, 
            ItemsTotal = itemsTotal,
            AdditionalCosts = 0,
            TotalCost = itemsTotal,
            UserId = _currentUser.UserId,
            OrderItems = orderItems,
            SpecialInstructions = "Placed via Mobile"
        };

        await LiquorService.CreateOrderAsync(order, sendEmail: true);
        foreach (var item in vendorItemsInCart) _cart.Remove(item.Id);
        await RefreshDataAsync();
    }

    private void ShowOrderConfirmation(int? vendorId = null)
    {
        _singleOrderVendorId = vendorId;
        _orderSummary.Clear();

        var targetVendors = vendorId.HasValue 
            ? _vendors.Where(v => v.Id == vendorId.Value).ToList()
            : _vendors.Where(v => _items.Any(i => i.VendorId == v.Id && _cart.ContainsKey(i.Id) && _cart[i.Id] > 0)).ToList();

        foreach (var vendor in targetVendors)
        {
            var cartItems = _items.Where(i => i.VendorId == vendor.Id && _cart.ContainsKey(i.Id) && _cart[i.Id] > 0).ToList();
            if (cartItems.Any())
            {
                decimal vTotal = GetVendorCartTotal(vendor.Id);
                
                _orderSummary.Add(new OrderConfirmationSummary {
                    VendorName = vendor.Name,
                    ItemCount = cartItems.Sum(i => _cart[i.Id]),
                    Total = vTotal
                });
            }
        }

        if (_orderSummary.Any())
        {
            _showOrderConfirm = true;
            StateHasChanged();
        }
    }

