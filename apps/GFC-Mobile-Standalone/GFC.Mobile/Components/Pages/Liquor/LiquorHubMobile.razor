    // -- Stock Count Logic (Inline Session Workflow) --

    private void AdjustSessionCount(int itemId, int delta)
    {
        if (!_stockCounts.ContainsKey(itemId))
        {
            var item = _items.FirstOrDefault(i => i.Id == itemId);
            if (item == null) return;
            _stockCounts[itemId] = item.CurrentStock;
        }

        _stockCounts[itemId] += delta;
        if (_stockCounts[itemId] < 0) _stockCounts[itemId] = 0;
        StateHasChanged();
    }

    private void SetAuditLocation(string loc)
    {
        _auditLocation = loc;
        _stockCounts.Clear();
        _barStockCounts.Clear();
        StateHasChanged();
    }

    private decimal GetLocationStockValue(int itemId, string location)
    {
        var ls = _locationStocks.FirstOrDefault(s => s.ItemId == itemId && s.LocationName == location);
        return ls?.Stock ?? 0;
    }

    private int GetBarFullBottles(int itemId)
    {
        decimal total = _barStockCounts.TryGetValue(itemId, out var val) ? val : GetLocationStockValue(itemId, _auditLocation);
        return (int)Math.Truncate(total);
    }

    private void SetBarFullBottles(int itemId, object val)
    {
        if (decimal.TryParse(val?.ToString(), out var btls))
        {
            decimal currentOpen = GetBarOpenBottleLevel(itemId);
            _barStockCounts[itemId] = Math.Max(0, Math.Truncate(btls)) + currentOpen;
            StateHasChanged();
        }
    }

    private void AdjustBarFullBottles(int itemId, int delta)
    {
        decimal current = _barStockCounts.TryGetValue(itemId, out var val) ? val : GetLocationStockValue(itemId, _auditLocation);
        decimal currentOpen = current - Math.Truncate(current);
        decimal newFull = Math.Max(0, Math.Truncate(current) + delta);
        _barStockCounts[itemId] = newFull + currentOpen;
        StateHasChanged();
    }

    private decimal GetBarOpenBottleLevel(int itemId)
    {
        decimal total = _barStockCounts.TryGetValue(itemId, out var val) ? val : GetLocationStockValue(itemId, _auditLocation);
        return total - Math.Truncate(total);
    }

    private void SetBarOpenBottleLevel(int itemId, decimal level)
    {
        decimal current = _barStockCounts.TryGetValue(itemId, out var val) ? val : GetLocationStockValue(itemId, _auditLocation);
        decimal full = Math.Truncate(current);
        _barStockCounts[itemId] = full + level;
        StateHasChanged();
    }

    private async Task SubmitFullReconciliation()
    {
        if (_currentUser == null) return;
        
        var auditEntries = _items.Select(item => {
            decimal actualValue = 0;
            if (_auditLocation == "MAIN_STORAGE")
            {
                actualValue = _stockCounts.TryGetValue(item.Id, out var actual) ? actual : item.CurrentStock;
            }
            else
            {
                actualValue = _barStockCounts.TryGetValue(item.Id, out var actual) ? actual : GetLocationStockValue(item.Id, _auditLocation);
            }
            return new GFC.Core.Models.StockReconcileEntry 
            { 
                ItemId = item.Id, 
                ActualCount = (int)Math.Round(actualValue),
                ActualCountDecimal = actualValue
            };
        }).ToList();
        
        await LiquorService.ReconcileLocationStockAsync(_auditLocation, auditEntries, _currentUser.UserId); 
        _lastSyncedAt = DateTime.Now;
        _syncStatus = "Synced";
        _stockCounts.Clear();
        _barStockCounts.Clear();
        await RefreshDataAsync();
        _activeTab = null;
    }

