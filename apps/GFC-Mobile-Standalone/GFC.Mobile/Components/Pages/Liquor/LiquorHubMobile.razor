    private async Task CaptureLivePhoto()
    {
        if (_isUploadingImage) return;
        
        _isUploadingImage = true;
        StateHasChanged();

        try
        {
            string? dataUrl = await JS.InvokeAsync<string>("LiquorScanner.takeSnapshot");

            if (!string.IsNullOrEmpty(dataUrl))
            {
                _newItem.ImageUrl = dataUrl;
                _isLiveCameraMode = false;
                StateHasChanged();

                // Convert DataURL to bytes for actual upload
                var parts = dataUrl.Split(',');
                var base64Data = parts[1];
                var bytes = Convert.FromBase64String(base64Data);
                
                using var stream = new MemoryStream(bytes);
                await ProcessAndUploadImage(stream, "LiveCapture.jpg");
            }
        }
        catch (Exception ex)
        {
            _error = "Capture Error: " + ex.Message;
        }
        finally
        {
            _isUploadingImage = false;
            _isLiveCameraMode = false;
            StateHasChanged();
        }
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;

        _isUploadingImage = true;
        _error = null;
        StateHasChanged();

        try
        {
            // 1. Show local preview
            var resizedFile = await file.RequestImageFileAsync("image/jpeg", 400, 400);
            using var previewStream = resizedFile.OpenReadStream(1024 * 1024 * 5);
            var buffer = new byte[resizedFile.Size];
            await previewStream.ReadAsync(buffer);
            var base64 = Convert.ToBase64String(buffer);
            _newItem.ImageUrl = $"data:image/jpeg;base64,{base64}";
            StateHasChanged();

            // 2. High Res Upload
            using var fullStream = new MemoryStream();
            await file.OpenReadStream(1024 * 1024 * 20).CopyToAsync(fullStream);
            fullStream.Position = 0;
            
            await ProcessAndUploadImage(fullStream, file.Name);
        }
        catch (Exception ex)
        {
            _error = "Image Processing Error: " + ex.Message;
        }
        finally
        {
            _isUploadingImage = false;
            StateHasChanged();
        }
    }

    private async Task ProcessAndUploadImage(Stream inputData, string fileName)
    {
        try
        {
            using var image = await SixLabors.ImageSharp.Image.LoadAsync(inputData);
            
            // Standardize size
            int maxWidth = 800;
            if (image.Width > maxWidth)
            {
                image.Mutate(x => x.Resize(new ResizeOptions { Mode = ResizeMode.Max, Size = new SixLabors.ImageSharp.Size(maxWidth, maxWidth) }));
            }

            using var compressedStream = new MemoryStream();
            await image.SaveAsync(compressedStream, new JpegEncoder { Quality = 85 });
            compressedStream.Position = 0;

            var asset = await MediaService.CreateMediaAssetAsync(compressedStream, $"{Guid.NewGuid()}_{fileName}", "LiquorReference", "System");
            if (asset != null)
            {
                _newItem.ImageUrl = $"/uploads/{asset.StoredFileName}";
            }
        }
        catch (Exception ex)
        {
             _error = "Upload Error: " + ex.Message;
        }
    }



