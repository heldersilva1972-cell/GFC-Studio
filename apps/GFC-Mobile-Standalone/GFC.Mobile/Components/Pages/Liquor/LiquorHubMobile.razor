@page "/mobile/liquor/hub"
@using Microsoft.AspNetCore.Authorization
@using GFC.Core.Interfaces
@using GFC.Core.Models

@inject NavigationManager Navigation
@inject ILiquorService LiquorService
@inject ICustomAuthenticationStateProvider AuthStateProvider
@inject IUserManagementService UserService
@inject IJSRuntime JS
@inject GFC.Core.Interfaces.IMediaAssetService MediaService
@inject ISystemSettingsService SystemSettingsService
@using SixLabors.ImageSharp
@using SixLabors.ImageSharp.Processing
@using SixLabors.ImageSharp.Formats.Jpeg
@implements IDisposable
@attribute [Authorize]

<PageTitle>Liquor HUB | Mobile</PageTitle>

@if (!string.IsNullOrEmpty(_errorMessage))
{
    <div class="alert alert-danger m-4" style="z-index: 9999; position: relative;">
        <h4>CRASH DETECTED</h4>
        <pre>@_errorMessage</pre>
    </div>
}

<div class="mobile-hub-container">
<MobileHubHeader IsConnected="@_isCircutAlive" Username="@(_currentUser?.Username ?? "Staff")" />



    <!-- MAIN HUB AREA -->
    <main class="hub-scroll-area p-4">
        <div class="container-fluid" style="margin-top: 80px; padding-bottom: 0;">
            @if (_activeTab == null)
            {
                <div class="dashboard-scroller scroll-y-hub pt-2" style="height: calc(100vh - 160px); overflow-y: auto; -webkit-overflow-scrolling: touch;">
                    <div class="welcome-banner mb-4 animate-entrance emerald-gradient rounded-4 p-4 shadow-lg text-white d-flex justify-content-between align-items-center">
                        <div>
                            <h5 class="fw-black mb-1">Stock Intelligence</h5>
                            <p class="small mb-0 opacity-75">@_items.Count total products tracked</p>
                        </div>
                        <div class="text-end">
                            <div class="extra-small opacity-75 fw-bold text-uppercase">Shelf Value</div>
                            <h4 class="fw-black mb-0">@_items.Sum(i => i.CurrentStock * i.CurrentPrice).ToString("C0")</h4>
                        </div>
                    </div>

                <div class="mobile-app-grid">
                    @if (HasAccessToTab("insight"))
                    {
                    <div class="app-card animate-entrance stagger-1" @onclick='() => SetTab("analytics")'>
                        <div class="icon-orb purple"><i class="bi bi-graph-up-arrow"></i></div>
                        <div class="card-content">
                            <h6 class="fw-black mb-0">INSIGHTS</h6>
                            <p class="extra-small text-muted mb-0">Usage & Trends</p>
                        </div>
                    </div>
                    }

                    @if (HasAccessToTab("ordering"))
                    {
                    <div class="app-card animate-entrance stagger-1" @onclick='() => SetTab("ordering")'>
                        <div class="icon-orb emerald">
                            @if (_items.Any(i => i.CurrentStock <= i.MinStockLimit))
                            {
                                <span class="badge rounded-pill bg-danger border border-white pulse-badge">@_items.Count(i => i.CurrentStock <= i.MinStockLimit)</span>
                            }
                            <i class="bi bi-cart-plus-fill"></i>
                        </div>
                        <div class="card-content">
                            <h6 class="fw-black mb-0">ORDERING</h6>
                            <p class="extra-small text-muted mb-0">Build vendor orders</p>
                        </div>
                    </div>
                    }


                    @if (HasAccessToTab("unpaid"))
                    {
                    <div class="app-card animate-entrance stagger-2" @onclick='() => SetTab("unpaid")'>
                        <div class="icon-orb red">
                            @if (_unpaidCount > 0)
                            {
                                <span class="badge rounded-pill bg-danger border border-white pulse-badge">@_unpaidCount</span>
                            }
                            <i class="bi bi-cash-stack"></i>
                        </div>
                        <div class="card-content">
                            <h6 class="fw-black mb-0">UNPAID INVOICES</h6>
                            <p class="extra-small text-muted mb-0">Confirm vendor check payments</p>
                        </div>
                    </div>
                    }

                    @if (HasAccessToTab("count"))
                    {
                    <div class="app-card animate-entrance stagger-2" @onclick='() => SetTab("count")'>
                        <div class="icon-orb indigo"><i class="bi bi-clipboard-check-fill"></i></div>
                        <div class="card-content">
                            <h6 class="fw-black mb-0">STOCK COUNT</h6>
                            <p class="extra-small text-muted mb-0">Reconcile physical inventory</p>
                        </div>
                    </div>
                    }

                    @if (HasAccessToTab("history"))
                    {
                    <div class="app-card animate-entrance stagger-2" @onclick='() => SetTab("backorders")'>
                        <div class="icon-orb amber">
                            @if (_pendingBackorders.Count > 0)
                            {
                                <span class="badge rounded-pill bg-warning text-dark border border-white pulse-badge">@_pendingBackorders.Count</span>
                            }
                            <i class="bi bi-clock-history"></i>
                        </div>
                        <div class="card-content">
                            <h6 class="fw-black mb-0">BACKORDERS</h6>
                            <p class="extra-small text-muted mb-0">Track & receive owed items</p>
                        </div>
                    </div>
                    }

                    @if (HasAccessToTab("history"))
                    {
                    <div class="app-card animate-entrance stagger-3" @onclick='() => SetTab("history")'>
                        <div class="icon-orb amber"><i class="bi bi-clock-history"></i></div>
                        <div class="card-content">
                            <h6 class="fw-black mb-0">VIEW HISTORY</h6>
                            <p class="extra-small text-muted mb-0">Audit logs & past orders</p>
                        </div>
                    </div>
                    }

                    @if (HasAccessToTab("setup"))
                    {
                    <div class="app-card animate-entrance stagger-3" @onclick='() => SetTab("setup")'>
                        <div class="icon-orb blue"><i class="bi bi-gear-fill"></i></div>
                        <div class="card-content">
                            <h6 class="fw-black mb-0">HUB SETUP</h6>
                            <p class="extra-small text-muted mb-0">Products & Settings</p>
                        </div>
                    </div>
                    }
                </div>
            </div>
            }
            else if (_activeTab == "count")
            {
                <div class="count-view animate-entrance d-flex flex-column" style="height: calc(100vh - 110px);">
                    <div class="audit-summary-bar bg-white border-bottom p-2 px-4 d-flex justify-content-between align-items-center mb-2 rounded-4 shadow-sm" style="min-height: 70px;">
                        <div class="d-flex align-items-center gap-3">
                            <div class="d-flex flex-column">
                                <span class="extra-small text-muted fw-black text-uppercase" style="font-size: 0.55rem;">Audit Progress</span>
                                @{
                                    var countedCount = _auditLocation == "MAIN_STORAGE" ? _stockCounts.Count : _barStockCounts.Count;
                                }
                                <span class="fw-black mb-0" style="font-size: 0.9rem;">@countedCount / @(_items.Count) ITEMS</span>
                            </div>
                            <div class="vr opacity-25" style="height: 25px;"></div>
                            <div class="d-flex bg-light rounded-pill p-1 border">
                                <button class="btn btn-xs rounded-pill px-2 fw-black @(_auditLocation == "MAIN_STORAGE" ? "btn-primary shadow-sm text-white fw-bold" : "text-muted")" style="font-size: 0.65rem;" @onclick='() => SetAuditLocation("MAIN_STORAGE")'>MAIN</button>
                                <button class="btn btn-xs rounded-pill px-2 fw-black @(_auditLocation == "DOWNSTAIRS_BAR" ? "btn-primary shadow-sm text-white fw-bold" : "text-muted")" style="font-size: 0.65rem;" @onclick='() => SetAuditLocation("DOWNSTAIRS_BAR")'>DOWNSTAIRS</button>
                                <button class="btn btn-xs rounded-pill px-2 fw-black @(_auditLocation == "UPSTAIRS_BAR" ? "btn-primary shadow-sm text-white fw-bold" : "text-muted")" style="font-size: 0.65rem;" @onclick='() => SetAuditLocation("UPSTAIRS_BAR")'>UPSTAIRS</button>
                            </div>
                        </div>
                        <div class="d-flex gap-2">
                            <button class="btn btn-light px-3 py-2 rounded-pill fw-bold text-muted small" @onclick="() => { _stockCounts.Clear(); _barStockCounts.Clear(); }">RESET</button>
                            <button class="btn btn-primary px-4 py-2 rounded-pill fw-black shadow-sm" @onclick="SubmitFullReconciliation" disabled="@(_auditLocation == "MAIN_STORAGE" ? !_stockCounts.Any() : !_barStockCounts.Any())" style="font-size: 0.85rem;">
                                <i class="bi bi-cloud-upload me-2"></i>SAVE CHANGES
                            </button>
                        </div>
                    </div>

                    <div class="flex-grow-1 overflow-hidden d-flex flex-column">
                        <div class="card rounded-4 border-0 shadow-sm overflow-hidden d-flex flex-column h-100">
                            <div class="p-2 bg-white border-bottom shadow-sm d-flex align-items-center gap-2">
                                <div class="input-group flex-grow-1">
                                    <span class="input-group-text bg-light border-0"><i class="bi bi-search"></i></span>
                                    <input type="text" class="form-control bg-light border-0 fw-bold py-2" placeholder="Quick find bottle..." onfocus="this.select()" @bind="_searchQuery" @bind:event="oninput" />
                                </div>
                                <div class="d-flex bg-light rounded-pill p-1 border">
                                    <button class="btn btn-xs rounded-pill px-2 fw-black @(!_filterBeerOnly ? "btn-dark shadow-sm" : "text-muted")" style="font-size: 0.55rem;" @onclick="() => _filterBeerOnly = false">ALL</button>
                                    <button class="btn btn-xs rounded-pill px-2 fw-black @(_filterBeerOnly ? "btn-amber shadow-sm" : "text-muted")" style="font-size: 0.55rem;" @onclick="() => _filterBeerOnly = true">BEER</button>
                                </div>
                            </div>
                            <div class="p-0 scroll-y-hub flex-grow-1" style="overflow-y: auto;">
                                @foreach (var item in _items.Where(i => (string.IsNullOrEmpty(_searchQuery) || i.Name.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase)) && (!_filterBeerOnly || i.IsBeer)).OrderBy(i => i.Name))
                                {
                                    bool isAdjusted = _auditLocation == "MAIN_STORAGE" ? _stockCounts.ContainsKey(item.Id) : _barStockCounts.ContainsKey(item.Id);
                                    var expectedVal = _auditLocation == "MAIN_STORAGE" ? item.CurrentStock : GetLocationStockValue(item.Id, _auditLocation);
                                    var currentVal = isAdjusted 
                                        ? (_auditLocation == "MAIN_STORAGE" ? (decimal)_stockCounts[item.Id] : _barStockCounts[item.Id]) 
                                        : expectedVal;
                                    var diff = isAdjusted ? (currentVal - expectedVal) : 0;

                                    <div class='count-item-card d-flex align-items-stretch border-bottom @(isAdjusted ? "selected-for-audit" : "")' style="min-height: 80px;">
                                        <div class='count-item-info p-2 px-3 d-flex align-items-center gap-3 flex-grow-1 @(isAdjusted ? "bg-transparent" : "bg-white")'>
                                            <div class="stock-pill @(expectedVal <= 0 ? "empty" : expectedVal <= item.MinStockLimit ? "low" : "ok")" style="min-width: 65px; padding: 4px 8px;">
                                                <div class="d-flex align-items-center justify-content-center gap-1">
                                                    @if (_auditLocation == "MAIN_STORAGE" && item.PackSize > 1)
                                                    {
                                                        <div class="stock-unit-group" title="Full Cases">
                                                            <span class="stock-icon"><i class="bi bi-box-seam"></i></span>
                                                            <span class="stock-value">@((int)expectedVal / item.PackSize)</span>
                                                        </div>
                                                        <div class="stock-divider"></div>
                                                        <div class="stock-unit-group" title="Individual Bottles">
                                                            <span class="stock-icon"><svg width='1.1em' height='1.1em' viewBox='0 0 16 16' fill='currentColor' style='display: inline-block; vertical-align: -0.15em;' xmlns='http://www.w3.org/2000/svg'><path d='M9.5 2H6.5V4.5C6 5 5.5 5.5 5.5 6.5V14H10.5V6.5C10.5 5.5 10 5 9.5 4.5V2Z'/></svg></span>
                                                            <span class="stock-value">@((int)expectedVal % item.PackSize)</span>
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <span class="stock-value">@expectedVal.ToString("F1")</span>
                                                        <span class="stock-icon-small"><svg width='1.1em' height='1.1em' viewBox='0 0 16 16' fill='currentColor' style='display: inline-block; vertical-align: -0.15em;' xmlns='http://www.w3.org/2000/svg'><path d='M9.5 2H6.5V4.5C6 5 5.5 5.5 5.5 6.5V14H10.5V6.5C10.5 5.5 10 5 9.5 4.5V2Z'/></svg></span>
                                                    }
                                                </div>
                                            </div>
                                            <div class="flex-grow-1">
                                                <div class="fw-black text-uppercase mb-0 fs-6 lh-sm">@item.Name</div>
                                                <div class="extra-small text-muted fw-bold" style="font-size: 0.55rem;">SIZE: @item.BottleSize | LIMIT: @item.MinStockLimit</div>
                                            </div>
                                        </div>

                                        <div class="count-item-controls d-flex align-items-center border-start px-4 bg-white" style="min-width: 380px;">
                                            <div class="stock-chip w-100">
                                                @if (_auditLocation == "MAIN_STORAGE")
                                                {
                                                    @if (item.PackSize > 1)
                                                    {
                                                        <div class="stock-unit-control-group d-flex align-items-center gap-2">
                                                            <!-- CASE CONTROL -->
                                                            <button class="btn-audit" @onclick="() => AdjustSessionCount(item.Id, -item.PackSize)"><i class="bi bi-dash"></i></button>
                                                            <div class="audit-control-block">
                                                                <span class="audit-control-label">Cases</span>
                                                                <span class="audit-control-value @(isAdjusted ? "is-changed" : "")">@((int)currentVal / item.PackSize)</span>
                                                            </div>
                                                            <button class="btn-audit" @onclick="() => AdjustSessionCount(item.Id, item.PackSize)"><i class="bi bi-plus"></i></button>
                                                        </div>

                                                        @if (item.AllowLooseReconciliation)
                                                        {
                                                            <div class="stock-chip-divider"></div>

                                                            <div class="stock-unit-control-group d-flex align-items-center gap-2">
                                                                <!-- BOTTLE CONTROL -->
                                                                <button class="btn-audit" @onclick="() => AdjustSessionCount(item.Id, -1)"><i class="bi bi-dash"></i></button>
                                                                <div class="audit-control-block">
                                                                    <span class="audit-control-label">Bottles</span>
                                                                    <span class="audit-control-value @(isAdjusted ? "is-changed" : "")">@((int)currentVal % item.PackSize)</span>
                                                                </div>
                                                                <button class="btn-audit" @onclick="() => AdjustSessionCount(item.Id, 1)"><i class="bi bi-plus"></i></button>
                                                            </div>
                                                        }
                                                    }
                                                    else
                                                    {
                                                        <div class="d-flex align-items-center justify-content-center w-100 gap-3">
                                                            <button class="btn-audit" style="width: 50px; height: 50px;" @onclick="() => AdjustSessionCount(item.Id, -1)"><i class="bi bi-dash-lg"></i></button>
                                                            <div class="audit-control-block" style="min-width: 80px;">
                                                                <span class="audit-control-label">Actual</span>
                                                                <span class="audit-control-value @(isAdjusted ? "is-changed" : "")" style="font-size: 1.8rem;">@((int)currentVal)</span>
                                                            </div>
                                                            <button class="btn-audit" style="width: 50px; height: 50px;" @onclick="() => AdjustSessionCount(item.Id, 1)"><i class="bi bi-plus-lg"></i></button>
                                                        </div>
                                                    }
                                                }
                                                else
                                                {
                                                    <!-- Visual open bottle selector for Bar audit -->
                                                    <div class="d-flex flex-column w-100 gap-2">
                                                        <div class="d-flex align-items-center justify-content-between w-100">
                                                            <span class="text-secondary fw-bold small">@(item.IsUnitBased ? "Count:" : "Full Bottles:")</span>
                                                            <div class="d-flex align-items-center">
                                                                <button class="btn-audit" style="width: 35px; height: 35px;" @onclick="() => AdjustBarFullBottles(item.Id, -1)"><i class="bi bi-dash-lg"></i></button>
                                                                <div class="mx-3 fw-black fs-5">@GetBarFullBottles(item.Id)</div>
                                                                <button class="btn-audit" style="width: 35px; height: 35px;" @onclick="() => AdjustBarFullBottles(item.Id, 1)"><i class="bi bi-plus-lg"></i></button>
                                                            </div>
                                                        </div>
                                                        @if (!item.IsUnitBased)
                                                        {
                                                            <div class="d-flex flex-wrap gap-1">
                                                                @{
                                                                    var currentLevel = GetBarOpenBottleLevel(item.Id);
                                                                }
                                                                <button class="btn btn-xs @(currentLevel == 0 ? "btn-dark text-white fw-bold" : "btn-outline-secondary") rounded-pill px-2 py-0.5" style="font-size: 0.65rem;" @onclick="() => SetBarOpenBottleLevel(item.Id, 0)">Empty</button>
                                                                <button class="btn btn-xs @(currentLevel == 0.25m ? "btn-primary text-white fw-bold" : "btn-outline-secondary") rounded-pill px-2 py-0.5" style="font-size: 0.65rem;" @onclick="() => SetBarOpenBottleLevel(item.Id, 0.25m)">1/4</button>
                                                                <button class="btn btn-xs @(currentLevel == 0.5m ? "btn-primary text-white fw-bold" : "btn-outline-secondary") rounded-pill px-2 py-0.5" style="font-size: 0.65rem;" @onclick="() => SetBarOpenBottleLevel(item.Id, 0.5m)">1/2</button>
                                                                <button class="btn btn-xs @(currentLevel == 0.75m ? "btn-primary text-white fw-bold" : "btn-outline-secondary") rounded-pill px-2 py-0.5" style="font-size: 0.65rem;" @onclick="() => SetBarOpenBottleLevel(item.Id, 0.75m)">3/4</button>
                                                                
                                                                @for (int t = 1; t <= 9; t++)
                                                                {
                                                                    decimal lvl = t / 10.0m;
                                                                    <button class="btn btn-xs @(currentLevel == lvl ? "btn-primary text-white fw-bold" : "btn-outline-secondary") rounded-3 px-1.5 py-0.5" style="min-width: 25px; font-size: 0.65rem;" @onclick="() => SetBarOpenBottleLevel(item.Id, lvl)">.@t</button>
                                                                }
                                                            </div>
                                                        }
                                                    </div>
                                                }
                                            </div>
                                        </div>

                                        <div class="count-item-adjustment d-flex align-items-center justify-content-center border-start bg-light" style="min-width: 90px;">
                                            <div class="text-center">
                                                <div class="extra-small text-muted fw-bold text-uppercase mb-0" style="font-size: 0.5rem; opacity: 0.6;">Adjustment</div>
                                                <div class="fw-900 mb-0 @(diff < 0 ? "text-danger" : diff > 0 ? "text-success" : "text-muted")" style="font-size: 1.25rem;">
                                                    @(diff > 0 ? "+" : "")@diff.ToString("F2")
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
            else if (_activeTab == "ordering")
            {
                <div class="ordering-view animate-entrance">
                    <div class="d-flex justify-content-between align-items-center mb-4 bg-white p-3 rounded-4 shadow-sm gap-2">
                         <div class="input-group flex-grow-1">
                            <span class="input-group-text bg-light border-0"><i class="bi bi-search text-muted"></i></span>
                            <input type="text" class="form-control bg-light border-0" placeholder="Search bottles..." onfocus="this.select()" @bind="_searchTerm" @bind:event="oninput" />
                        </div>
                        <div class="d-flex bg-light rounded-pill p-1 border">
                             <button class="btn btn-sm rounded-pill px-3 fw-black @(!_filterBeerOnly ? "btn-white shadow-sm" : "text-muted")" style="font-size: 0.6rem;" @onclick="() => _filterBeerOnly = false">ALL</button>
                             <button class="btn btn-sm rounded-pill px-3 fw-black @(_filterBeerOnly ? "btn-amber shadow-sm" : "text-muted")" style="font-size: 0.6rem;" @onclick="() => _filterBeerOnly = true">BEER</button>
                        </div>
                        <div class="vr mx-1 opacity-25"></div>
                        <div class="row g-0 rounded-pill border bg-light p-1" style="min-width: 200px;">
                            <div class="col-6">
                                <button class="btn btn-sm w-100 rounded-pill @(_isAlphabeticalView ? "btn-primary shadow-sm" : "btn-link text-muted") text-uppercase fw-bold" style="font-size: 0.6rem;" @onclick="() => _isAlphabeticalView = true">LIST</button>
                            </div>
                            <div class="col-6">
                                <button class="btn btn-sm w-100 rounded-pill @(!_isAlphabeticalView ? "btn-primary shadow-sm" : "btn-link text-muted") text-uppercase fw-bold" style="font-size: 0.6rem;" @onclick="() => _isAlphabeticalView = false">VENDOR</button>
                            </div>
                        </div>
                    </div>

                    <div class="row g-4">
                        <div class="col-md-7 col-lg-8">
                            <div class="scroll-y-hub" style="max-height: 65vh; overflow-y: auto; padding-right: 1.5rem;">
                                @if (_isAlphabeticalView)
                                {
                                    <div class="row g-3">
                                        @foreach (var item in _items.Where(i => (string.IsNullOrEmpty(_searchTerm) || i.Name.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase)) && (!_filterBeerOnly || i.IsBeer)).OrderBy(i => i.Name))
                                        {
                                            <div class="col-12 col-sm-6 col-lg-4">
                                                <div class="order-item-card card rounded-4 border-0 shadow-sm mb-3 overflow-hidden @(GetCartQuantity(item.Id) > 0 ? "selected-for-order" : "")" style="padding: 0 !important;">
                                                    <div class="order-item-info p-3 d-flex flex-column align-items-center text-center w-100">
                                                        <div class="stock-pill @(item.CurrentStock <= 0 ? "empty" : item.CurrentStock <= item.MinStockLimit ? "low" : "ok") mb-2">
                                                            <div class="d-flex align-items-center justify-content-center gap-1">
                                                                @if (item.PackSize > 1)
                                                                {
                                                                    <div class="stock-unit-group">
                                                                        <span class="stock-icon"><i class="bi bi-box-seam"></i></span>
                                                                        <span class="stock-value">@(item.CurrentStock / item.PackSize)</span>
                                                                    </div>
                                                                    <div class="stock-divider"></div>
                                                                    <div class="stock-unit-group">
                                                                        <span class="stock-icon"><svg width='1.1em' height='1.1em' viewBox='0 0 16 16' fill='currentColor' style='display: inline-block; vertical-align: -0.15em;' xmlns='http://www.w3.org/2000/svg'><path d='M9.5 2H6.5V4.5C6 5 5.5 5.5 5.5 6.5V14H10.5V6.5C10.5 5.5 10 5 9.5 4.5V2Z'/></svg></span>
                                                                        <span class="stock-value">@(item.CurrentStock % item.PackSize)</span>
                                                                    </div>
                                                                }
                                                                else
                                                                {
                                                                    <span class="stock-value">@item.CurrentStock</span>
                                                                    <span class="stock-icon-small"><svg width='1.1em' height='1.1em' viewBox='0 0 16 16' fill='currentColor' style='display: inline-block; vertical-align: -0.15em;' xmlns='http://www.w3.org/2000/svg'><path d='M9.5 2H6.5V4.5C6 5 5.5 5.5 5.5 6.5V14H10.5V6.5C10.5 5.5 10 5 9.5 4.5V2Z'/></svg></span>
                                                                }
                                                            </div>
                                                        </div>
                                                        <h5 class="fw-black text-uppercase mb-1 fs-6 lh-sm">@item.Name</h5>
                                                        <div class="extra-small text-muted fw-bold" style="font-size: 0.55rem;">
                                                            SIZE: @item.BottleSize | Bottle: @item.CurrentPrice.ToString("C")
                                                            @if (item.CasePrice.HasValue && item.CasePrice.Value > 0)
                                                            {
                                                                <span> | Case: @item.CasePrice.Value.ToString("C")</span>
                                                            }
                                                        </div>
                                                    </div>
                                                    <div class="order-item-controls d-flex flex-column align-items-center justify-content-center bg-light border-top w-100 py-2 gap-2" style="background-color: #fafbfc !important;">
                                                        @if (item.PackSize > 1)
                                                        {
                                                            <div class="d-flex align-items-center justify-content-center w-100 gap-2 px-3">
                                                                <span class="extra-small fw-bold text-uppercase text-primary" style="font-size: 0.6rem; min-width: 45px; text-align: right;">Cases</span>
                                                                <button class="btn-audit" style="width: 32px; height: 32px; font-size: 0.8rem;" @onclick='() => AdjustCartCases(item.Id, -1, item.PackSize)' @onclick:stopPropagation="true"><i class="bi bi-dash"></i></button>
                                                                <div class="fw-black px-1 text-center" style="min-width: 30px; font-size: 0.95rem;">@(GetCartQuantity(item.Id) / item.PackSize)</div>
