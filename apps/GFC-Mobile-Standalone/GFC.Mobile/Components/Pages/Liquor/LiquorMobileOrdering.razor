@page "/mobile/liquor/ordering"
@using Microsoft.AspNetCore.Authorization
@using GFC.Core.Interfaces
@using GFC.Core.Models
@inject NavigationManager Navigation
@inject ILiquorService LiquorService
@attribute [Authorize]

<PageTitle>Mobile Ordering | GFC</PageTitle>

<div class="mobile-ordering-container">
    <!-- HEADER -->
    <header class="fixed-header bg-white shadow-sm px-4 py-3">
        <div class="d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center gap-3">
                <button class="btn btn-icon-round bg-light border-0" @onclick='() => Navigation.NavigateTo("/mobile/liquor/hub")'>
                    <i class="bi bi-chevron-left"></i>
                </button>
                <div>
                    <h5 class="mb-0 fw-black text-uppercase">ORDERING LIST</h5>
                    <div class="extra-small text-muted fw-bold">Items to replenishment</div>
                </div>
            </div>
            @if (_currentOrderItems.Any())
            {
                <button class="btn btn-emerald btn-sm rounded-pill fw-black px-3" @onclick="CreateOrder">
                    FINALIZE (@_currentOrderItems.Count)
                </button>
            }
        </div>
    </header>

    <!-- CONTENT -->
    <main class="hub-scroll-area p-4" style="margin-top: 80px; padding-bottom: 120px;">
        <div class="search-bar-inline p-3 bg-white rounded-4 shadow-sm mb-4">
             <div class="input-group">
                 <span class="input-group-text bg-transparent border-0"><i class="bi bi-search"></i></span>
                 <input type="text" class="form-control border-0" placeholder="Find item to add..." @bind="_searchTerm" @bind:event="oninput" />
             </div>
        </div>

        @if (_searchResults != null && !string.IsNullOrWhiteSpace(_searchTerm))
        {
            <div class="results-popover shadow-sm rounded-4 overflow-hidden mb-4 animate-entrance">
                @foreach (var item in _searchResults.Take(5))
                {
                    <div class="p-3 bg-white border-bottom d-flex justify-content-between align-items-center" @onclick="() => AddToOrder(item)">
                        <div>
                            <div class="fw-bold">@item.Name</div>
                            <div class="extra-small text-muted">Stock: @item.CurrentStock @(item.IsUnitBased? "Units" : "Bottles")</div>
                        </div>
                        <i class="bi bi-plus-circle-fill text-emerald fs-4"></i>
                    </div>
                }
            </div>
        }

        <div class="current-order-section">
            <h6 class="fw-black text-muted text-uppercase mb-3 px-2">CURRENT ORDER DRAFT</h6>
            
            @if (!_currentOrderItems.Any())
            {
                <div class="p-5 text-center bg-white rounded-4 border border-dashed border-2">
                    <i class="bi bi-cart3 display-4 text-muted opacity-25"></i>
                    <p class="mt-3 text-muted small">Search above to add items to your new order.</p>
                </div>
            }
            else
            {
                @foreach (var oi in _currentOrderItems)
                {
                    <div class="ordering-item-card animate-entrance d-flex justify-content-between align-items-center">
                        <div class="info">
                            <div class="fw-black text-dark text-uppercase">@(oi.LiquorItem?.Name ?? "Item")</div>
                            <div class="extra-small text-muted fw-bold">VENDOR: @(oi.LiquorItem?.Vendor?.Name?.ToUpper() ?? "N/A")</div>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                             <button class="btn btn-icon-sm bg-light" @onclick="() => UpdateQty(oi, -1)">-</button>
                             @if (oi.LiquorItem?.PackSize > 1)
                             {
                                 var casesVal = oi.Quantity / oi.LiquorItem.PackSize;
                                 <span class="fw-black px-2">@casesVal @(casesVal == 1 ? "case" : "cases")</span>
                             }
                             else
                             {
                                 @if (oi.LiquorItem?.OrderByCaseOnly == true)
                                 {
                                     <span class="fw-black px-2">@oi.Quantity @(oi.Quantity == 1 ? "case" : "cases")</span>
                                 }
                                 else
                                 {
                                     <span class="fw-black px-2">@oi.Quantity @(oi.Quantity == 1 ? "bottle" : "bottles")</span>
                                 }
                             }
                             <button class="btn btn-icon-sm bg-light" @onclick="() => UpdateQty(oi, 1)">+</button>
                        </div>
                    </div>
                }
            }
        </div>
    </main>

    <!-- MOBILE ORDER MODAL (VENDORS) -->
     @if (_showFinalizeModal)
     {
         <div class="modal-backdrop-custom" @onclick="() => _showFinalizeModal = false"></div>
         <div class="bottom-sheet">
            <div class="sheet-handle"></div>
            <div class="p-4">
                <h5 class="fw-black text-emerald text-uppercase mb-1">Finalize Order</h5>
                <p class="small text-muted mb-4">Select the Vendor for this new order.</p>

                <div class="list-group list-group-flush mb-4 scroll-y-max">
                    @foreach (var vendor in _vendors)
                    {
                        <button class="list-group-item list-group-item-action py-3 d-flex justify-content-between align-items-center" @onclick="() => SubmitOrderBatch(vendor.Id)">
                            <span class="fw-bold">@vendor.Name</span>
                            <i class="bi bi-chevron-right text-muted"></i>
                        </button>
                    }
                </div>

                <div class="d-grid">
                    <button class="btn btn-light btn-lg fw-bold rounded-pill" @onclick="() => _showFinalizeModal = false">
                        Cancel
                    </button>
                </div>
            </div>
         </div>
     }
</div>

<style>
    .mobile-ordering-container {
        position: fixed;
        top: 0; left: 0; right: 0; bottom: 0;
        background: #f8fafc;
        overflow-y: auto;
    }
    
    .fixed-header {
        position: fixed;
        top: 0; left: 0; right: 0;
        z-index: 1000;
        border-bottom: 1px solid rgba(0,0,0,0.05);
    }

    .btn-emerald { background: #10b981; color: white; }
    .text-emerald { color: #10b981; }

    .search-bar-inline {
        border: 1px solid rgba(0,0,0,0.05);
    }

    .ordering-item-card {
        background: white;
        border-radius: 1rem;
        padding: 1.25rem;
        margin-bottom: 0.75rem;
        border: 1px solid rgba(0,0,0,0.05);
        box-shadow: 0 2px 8px rgba(0,0,0,0.02);
        border-left: 5px solid #10b981;
        width: 100%;
    }

    .scroll-y-max {
        max-height: 250px;
        overflow-y: auto;
    }

    .btn-icon-sm {
        width: 32px; height: 32px;
        border-radius: 8px;
        border: none;
        display: flex; align-items: center; justify-content: center;
        font-weight: 800;
    }

    /* MODAL */
    .modal-backdrop-custom {
        position: fixed;
        top: 0; left: 0; right: 0; bottom: 0;
        background: rgba(0,0,0,0.4);
        z-index: 2000;
        backdrop-filter: blur(2px);
    }
    .bottom-sheet {
        position: fixed;
        left: 10px; right: 10px; bottom: 10px;
        background: white;
        border-radius: 2rem;
        z-index: 2001;
        padding-bottom: env(safe-area-inset-bottom);
        box-shadow: 0 -20px 40px rgba(0,0,0,0.2);
        animation: slideUp 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .sheet-handle {
        width: 40px; height: 5px; background: #eee;
        border-radius: 5px; margin: 15px auto;
    }

    @@keyframes slideUp {
        from { transform: translateY(100%); }
        to { transform: translateY(0); }
    }
</style>

@code {
    private List<LiquorItem>? _items;
    private List<LiquorVendor> _vendors = new();
    private List<PosCategory> _categories = new();
    private List<LiquorOrderItem> _currentOrderItems = new();
    private string _searchTerm = "";
    private bool _showFinalizeModal = false;

    private bool IsLiquorInventoryItem(LiquorItem item)
    {
        if (item.ParentItemId.HasValue) return false;
        if (item.InventoryTrackType == 2) return true;
        if (item.InventoryTrackType == 1 || item.InventoryTrackType == 3) return false;

        if (string.IsNullOrEmpty(item.Category)) return true;
        var cat = _categories.FirstOrDefault(c => string.Equals(c.Name, item.Category, StringComparison.OrdinalIgnoreCase));
        if (cat != null)
        {
            return cat.InventoryTrackType == 1;
        }
        return true;
    }

    private List<LiquorItem>? _searchResults => _items?
        .Where(i => !string.IsNullOrWhiteSpace(_searchTerm) && i.Name.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase))
        .ToList();

    protected override async Task OnInitializedAsync()
    {
        var categoriesList = await LiquorService.GetAllCategoriesAsync();
        _categories = categoriesList.ToList();

        var all = await LiquorService.GetAllItemsAsync();
        _items = all.Where(i => IsLiquorInventoryItem(i)).ToList();
        var vendors = await LiquorService.GetAllVendorsAsync();
        _vendors = vendors.ToList();

        // Locally link Vendor objects to resolve names inside views
        foreach (var item in _items)
        {
            if (item.VendorId.HasValue)
            {
                item.Vendor = _vendors.FirstOrDefault(v => v.Id == item.VendorId.Value);
            }
        }
    }

    private void AddToOrder(LiquorItem item)
    {
        var existing = _currentOrderItems.FirstOrDefault(oi => oi.LiquorItemId == item.Id);
        int step = item.PackSize > 1 ? item.PackSize : 1;
        if (existing != null)
        {
            existing.Quantity += step;
        }
        else
        {
            _currentOrderItems.Add(new LiquorOrderItem { LiquorItemId = item.Id, LiquorItem = item, Quantity = step });
        }
        _searchTerm = "";
    }

    private void UpdateQty(LiquorOrderItem oi, int delta)
    {
        int step = (oi.LiquorItem != null && oi.LiquorItem.PackSize > 1) ? oi.LiquorItem.PackSize : 1;
        oi.Quantity += delta * step;
        if (oi.Quantity <= 0) _currentOrderItems.Remove(oi);
    }

    private void CreateOrder()
    {
        _showFinalizeModal = true;
    }

    private async Task SubmitOrderBatch(int vendorId)
    {
        var vendorItems = _currentOrderItems.Where(x => x.LiquorItem?.VendorId == vendorId).ToList();
        if (!vendorItems.Any()) return;
        
        decimal itemsTotal = 0;
        foreach (var oi in vendorItems)
        {
            var item = oi.LiquorItem;
            if (item != null)
            {
                decimal lineTotal = 0;
                decimal casePrice = (item.CasePrice.HasValue && item.CasePrice.Value > 0) 
                    ? item.CasePrice.Value 
                    : (item.CurrentPrice * (item.PackSize > 0 ? item.PackSize : 1));

                decimal effectiveCasePrice = casePrice;
                if (item.PackSize > 1)
                {
                    int cases = oi.Quantity / item.PackSize;
                    int bottles = oi.Quantity % item.PackSize;
                    if (item.BulkDiscountThreshold.HasValue && item.BulkDiscountPrice.HasValue && cases >= item.BulkDiscountThreshold.Value)
                    {
                        effectiveCasePrice = item.BulkDiscountPrice.Value;
                    }
                    lineTotal = (cases * effectiveCasePrice) + (bottles * item.CurrentPrice);
                }
                else
                {
                    lineTotal = item.CurrentPrice * oi.Quantity;
                    effectiveCasePrice = item.CurrentPrice;
                }
                if (item.IsBeer) lineTotal += 0.05m * oi.Quantity;
                itemsTotal += lineTotal;
                
                oi.UnitPriceAtTimeOfOrder = item.CurrentPrice;
                oi.CasePriceAtTimeOfOrder = effectiveCasePrice;
                oi.BottleFeeAtTimeOfOrder = item.IsBeer ? 0.05m : 0;
            }
        }

        var order = new LiquorOrder
        {
            VendorId = vendorId,
            UserId = 1, // Default mobile user ID
            OrderDate = DateTime.Now,
            Status = "Placed",
            ItemsTotal = itemsTotal,
            TotalCost = itemsTotal,
            OrderItems = vendorItems.Select(oi => new LiquorOrderItem 
            { 
                LiquorItemId = oi.LiquorItemId, 
                Quantity = oi.Quantity,
                UnitPriceAtTimeOfOrder = oi.UnitPriceAtTimeOfOrder,
                CasePriceAtTimeOfOrder = oi.CasePriceAtTimeOfOrder,
                BottleFeeAtTimeOfOrder = oi.BottleFeeAtTimeOfOrder
            }).ToList(),
            SpecialInstructions = "Placed via Mobile"
        };
        var created = await LiquorService.CreateOrderAsync(order, sendEmail: true);
        _currentOrderItems.RemoveAll(x => x.LiquorItem?.VendorId == vendorId);
        Navigation.NavigateTo("/mobile/liquor/hub");
    }
}
