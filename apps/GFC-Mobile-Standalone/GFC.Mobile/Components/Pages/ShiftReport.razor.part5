        100% { transform: scale(1); border-color: #e2e8f0; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1); }
    }

    .shift-choice-btn-tactile {
        flex: 1;
        max-width: 250px;
        background: #fff;
        border: 2.5px solid #e2e8f0;
        border-radius: 32px;
        padding: 3rem 1rem;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1.5rem;
        transition: all 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
        box-shadow: 0 10px 25px -5px rgba(0,0,0,0.05), 0 8px 10px -6px rgba(0,0,0,0.05);
        cursor: pointer;
        position: relative;
    }

    .shift-choice-btn-tactile i { font-size: 4rem; }
    .shift-choice-btn-tactile .btn-label-text { font-weight: 900; text-transform: uppercase; letter-spacing: 0.1em; color: #1e293b; font-size: 1rem; }

    .shift-choice-btn-tactile:hover {
        transform: translateY(-12px) scale(1.02);
        border-color: #2563eb;
        box-shadow: 0 25px 50px -12px rgba(37, 99, 235, 0.4);
        z-index: 10;
    }

    .shift-choice-btn-tactile:active {
        transform: translateY(4px) scale(0.95);
        background: #f8fafc;
        box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1);
    }

    .upstairs-btn-theme {
        border-color: rgba(99, 102, 241, 0.2);
    }
    .upstairs-btn-theme:hover {
        border-color: #6366f1;
        box-shadow: 0 25px 50px -12px rgba(99, 102, 241, 0.4);
    }

    .pulse-indigo {
        animation: pulse-indigo-glow 3s infinite ease-in-out;
    }

    @@keyframes pulse-indigo-glow {
        0% { transform: scale(1); box-shadow: 0 4px 15px rgba(99, 102, 241, 0.2); }
        50% { transform: scale(1.02); box-shadow: 0 10px 30px rgba(99, 102, 241, 0.4); border-color: #818cf8; }
        100% { transform: scale(1); box-shadow: 0 4px 15px rgba(99, 102, 241, 0.2); }
    }
    /* FINAL ENVELOPE HEADER PILL */
    .final-envelope-card-pill {
        background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
        color: white;
        border-radius: 50px;
        padding: 4px 4px 4px 8px;
        display: flex;
        align-items: center;
        gap: 0;
        min-width: 160px;
        transition: all 0.3s ease;
        box-shadow: 0 4px 12px -2px rgba(245, 158, 11, 0.4);
    }
    .final-envelope-card-pill.has-value {
        box-shadow: 0 8px 25px -5px rgba(245, 158, 11, 0.7);
        animation: envelope-pill-pulse 1.5s infinite ease-in-out;
    }
    @@keyframes envelope-pill-pulse {
        0%   { transform: scale(1);    box-shadow: 0 8px 25px -5px rgba(245, 158, 11, 0.6); }
        50%  { transform: scale(1.06); box-shadow: 0 14px 40px -5px rgba(245, 158, 11, 1.0), 0 0 0 8px rgba(245, 158, 11, 0.25); }
        100% { transform: scale(1);    box-shadow: 0 8px 25px -5px rgba(245, 158, 11, 0.6); }
    }
    .final-envelope-card-pill label { color: rgba(255,255,255,0.85) !important; }
    .final-envelope-card-pill div { color: white !important; }
    .pill-icon-box {
        background: rgba(255,255,255,0.2);
        width: 40px;
        height: 40px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        margin-left: 8px;
    }
    .pill-icon-box i { color: white !important; }
    /* PREMIUM SUCCESS ANIMATION */
    .premium-success-wrapper {
        display: flex;
        justify-content: center;
        margin-bottom: 2rem;
    }
    .checkmark-svg {
        width: 80px;
        height: 80px;
        border-radius: 50%;
        display: block;
        stroke-width: 3;
        stroke: #fff;
        stroke-miterlimit: 10;
        box-shadow: inset 0px 0px 0px #10b981;
        animation: fill .4s ease-in-out .4s forwards, scale .3s ease-in-out .9s both;
    }
    .checkmark-circle {
        stroke-dasharray: 166;
        stroke-dashoffset: 166;
        stroke-width: 3;
        stroke-miterlimit: 10;
        stroke: #10b981;
        fill: none;
        animation: stroke 0.6s cubic-bezier(0.65, 0, 0.45, 1) forwards;
    }
    .checkmark-check {
        transform-origin: 50% 50%;
        stroke-dasharray: 48;
        stroke-dashoffset: 48;
        animation: stroke 0.3s cubic-bezier(0.65, 0, 0.45, 1) 0.8s forwards;
    }
    @@keyframes stroke { 100% { stroke-dashoffset: 0; } }
    @@keyframes scale { 0%, 100% { transform: none; } 50% { transform: scale3d(1.1, 1.1, 1); } }
    @@keyframes fill { 100% { box-shadow: inset 0px 0px 0px 50px #10b981; } }

    .success-ripple {
        position: absolute;
        width: 80px;
        height: 80px;
        border-radius: 50%;
        border: 4px solid #10b981;
        animation: ripple-out 1.5s infinite;
        opacity: 0;
    }
    @@keyframes ripple-out {
        0% { transform: scale(1); opacity: 0.5; }
        100% { transform: scale(1.8); opacity: 0; }
    }
</style>

@code {
    [Parameter]
    [SupplyParameterFromQuery(Name = "date")]
    public string? QueryDate { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "shift")]
    public string? QueryShift { get; set; }

    private decimal? BarSales { get; set; }
    private decimal? LottoSales { get; set; }
    private decimal? LottoCashes { get; set; }
    private decimal? LottoInstantTickets { get; set; }
    private decimal? LottoNetDue { get; set; }
    private decimal? LottoOpeningCash { get; set; }
    private decimal? LottoBackupBag { get; set; }
    private decimal? LottoCashCounted { get; set; }
    private decimal? TotalHours { get; set; }
    
    private string? ShiftType { get; set; }
    private DateTime ReportDate { get; set; } = DateTime.Today;
    private string? Notes { get; set; }
    private bool IsRentalHall { get; set; } = false;

    private bool Loading { get; set; } = true;
    private bool IsSubmitting { get; set; } = false;
    private bool Submitted { get; set; } = false;
    private bool ExistingEntryFound { get; set; } = false;
    private bool IsLocked { get; set; } = false;
    
    // UI Visual Locking Logic
    private bool IsDayLocked => _dayMainHasData && CurrentUser != null && !CurrentUser.IsAdmin && _dayCloser != CurrentUser.Username;
    private bool IsNightLocked => _nightMainHasData && CurrentUser != null && !CurrentUser.IsAdmin && _nightCloser != CurrentUser.Username;
    private bool IsHallLocked => _hallSubmitted && CurrentUser != null && !CurrentUser.IsAdmin && _hallCloser != CurrentUser.Username;
    private bool IsReadyToSubmit => 
        (IsRentalHall ? (BarSales ?? 0) > 0 : 
        ((BarSales ?? 0) > 0 && (TotalHours ?? 0) > 0 && (LottoSales ?? 0) != 0 && (LottoCashes ?? 0) != 0 && (LottoCashCounted ?? 0) > 0));

    private readonly global::System.Threading.SemaphoreSlim _saveLock = new(1, 1);
    private string? _validationError { get; set; }
    private string? _lockErrorMessage { get; set; }
    private bool _showValidation = false;
    private bool _showUnsavedModal = false;
    private bool _showHudMath = false;
    private bool _showSubmitConfirm = false;
    private bool _showZeroConfirmation = false;
    private List<(string Id, string Label)> _zeroWarningList = new();
    private List<string> _zeroFields = new();
    private bool _showFocusModal = false;
    private bool _showDistributionSlip = false;
    private bool _showRecoveryModal = false;
    private dynamic? _localDraft;
    private bool _lottoSignConfirmed = true; 
    private Action? _onModalConfirm;

    private string? _pendingNavigationUrl;
    private string _modalTitle = "Unsaved Changes";
    private string _modalMessage = "You have entered data. Leaving now will lose your progress.";

    private string? _activeField = null; // No default focus until user picks a field
    private string _currentBuffer = "";
    private bool _isSaving = false;
    private bool _initialized = false;
    private bool _fieldFreshlyActivated = false;
    private bool _isGuidedMode = true; 
    private global::System.Threading.CancellationTokenSource? _autoSaveCts;
    private bool _hasLocalChanges = false;
    private string? _syncStatus = null; // "Synced", "Saving...", "Offline Backup"
    private bool _hasUpdate = false;
    private DateTime? _lastSyncedAt;
    private decimal _totalBagDebt = 0; // Cumulative debt to bag from previous shifts + current day shift
    private bool _rescueMode = false; // True if Night is missing Day's starting data
    private List<(DateTime Date, string Shift, decimal Amount)> _debtBreakdown = new(); // Breakdown of unpaid bag debt
    private string? _selectedWorker;
    private string? _lockOwner;
    private GFC.Core.Models.AppUser? CurrentUser { get; set; }
    private string _currentUsername => CurrentUser?.Username ?? "Unknown";

    private bool ShouldShowSignConfirmation {
        get {
            // Only show for Net Due if it's currently being edited and hasn't been signed off yet
            if (_activeField != "LottoNetDue" || _lottoSignConfirmed) return false;
            
            // Only show if there's actually a non-zero value to "sign"
            if (string.IsNullOrEmpty(_currentBuffer) || (LottoNetDue == null || LottoNetDue == 0)) return false;
            
            return true;
        }
    }

    private string GetFieldDisplayName(string field) => field switch {
        "Hours" => "Hours Worked",
        "BarSales" => "Total Bar Sales",
        "LottoOpeningCash" => "Lottery Beginning Cash",
        "LottoSales" => "Lottery Net Sales (RPT 50)",
        "LottoCashes" => "Lottery Cashes (RPT 50)",
        "LottoInstantTickets" => "Lottery Tickets (RPT 34)",
        "LottoNetDue" => "Lottery Net Due (RPT 50)",
        "LottoBackupBag" => "Removed From Backup Money Bag",
        "LottoCashCounted" => "Ending Cash Counted",
        _ => "Entry"
    };

    private record FieldGuide(string Title, string Instruction, string SubInstruction, string Source, string Icon, string Theme, string LineNumber);

    private FieldGuide GetFocusGuide() => _activeField switch {
        "Hours" => new FieldGuide("Hours Worked", "How many total hours did you work tonight?", "Enter hours and minutes (e.g., 8.5 for 8h 30m).", "PAYROLL", "bi-clock-fill", "primary", "N/A"),
        "BarSales" => new FieldGuide("Register Sales", "Enter the Total Net Sales from your bar register Z-Report.", "", "Z-REPORT", "bi-cash-register", "primary", "TOTAL"),
        "LottoOpeningCash" => new FieldGuide("Beginning Drawer Cash", "Confirm the starting cash in your lottery drawer.", "The current value is automatically carried over from the previous shift. It is recommended you count this to verify the amount is accurate. If this value is not correct update it with the correct amount.", "DRAWER", "bi-bank2", "primary", "N/A"),
        "LottoSales" => new FieldGuide("Net Sales", "Find the line labeled 'NET SALES' on Report 50.", "Enter that value below.", "RPT 50", "bi-ticket-perforated-fill", "success", "36"),
        "LottoCashes" => new FieldGuide("Cashes", "Find the 'CASHES' line on Report 50.", "Enter that value below.", "RPT 50", "bi-dash-circle-fill", "danger", "22"),
        "LottoNetDue" => new FieldGuide("Net Due", "Find the 'NET DUE' line at the very bottom of Report 50.", "Enter that value below. NOTE: This may be a negative number. Select Positive (+) or Negative (-) using the buttons above the keypad.", "RPT 50", "bi-calculator-fill", "primary", "BOTTOM"),
        "LottoInstantTickets" => new FieldGuide("Instant Tickets", "Find the line labeled TOTALS at the bottom of Report 34.", "Enter that value below.", "RPT 34", "bi-safe2-fill", "purple", "TOTAL"),
        "LottoBackupBag" => new FieldGuide("Backup Bag", "How much money did you take FROM the backup bag?", "If no money was taken out of the backup bag, leave value at 0.", "MONEY BAG", "bi-exclamation-triangle-fill", "warning", "N/A"),
        "LottoCashCounted" => new FieldGuide("TOTAL CASH COUNTED FROM LOTTERY DRAWER", "The total amount of money counted from the lottery drawer must be entered.", "Do not subtract any amount from this value.", "PHYSICAL CASH", "bi-info-circle-fill", "danger", "N/A"),
        _ => new FieldGuide("Entry Needed", "Please enter the requested value.", "", "REPORT", "bi-pencil-square", "primary", "")
    };



    private void ActivateField(string field) {
        if (IsLocked) return;
        
        // Only block jumping to other fields if the sign confirmation prompt is actually active and blocking the screen
        if (ShouldShowSignConfirmation) {
            return; 
        }

        _activeField = field;
        _showFocusModal = _isGuidedMode; 
        _fieldFreshlyActivated = true; // Use this to allow backspace on existing value but clear on typing a digit

        decimal? currentVal = GetRawFieldValue(field);
        if (currentVal != null) {
            _currentBuffer = Math.Abs(currentVal.Value).ToString("F2");
        } else {
            _currentBuffer = "";
        }
        
        _lottoSignConfirmed = true; // Default true for existing values
        StateHasChanged();
    }

    private void KeyPressed(string key) {
        if (IsLocked || string.IsNullOrEmpty(_activeField)) return;
        
        // Intelligent Clear: If the field was just selected, typing a digit should start fresh
        if (_fieldFreshlyActivated) {
            _currentBuffer = "";
            _fieldFreshlyActivated = false;
            // If we're starting a brand new 'Net Due' entry, reset the sign to positive
            if (_activeField == "LottoNetDue") LottoNetDue = 0;
        }

        // Basic buffer logic for decimal entry
        if (key == "." && _currentBuffer.Contains(".")) return;
        
        // Prevent more than 2 decimal digits
        if (_currentBuffer.Contains("."))
        {
            var parts = _currentBuffer.Split('.');
            if (parts.Length > 1 && parts[1].Length >= 2) return;
        }

        _currentBuffer += key;
        
        if (decimal.TryParse(_currentBuffer, out decimal val)) {
            if (_activeField == "LottoNetDue") {
                // Neutral zero doesn't need a sign confirmation
                _lottoSignConfirmed = (val == 0); 
            }
            UpdateFieldValue(_activeField, val);
            _ = DebouncedAutoSave();
        }
    }

    private void BackspaceCurrentField() {
        if (IsLocked || string.IsNullOrEmpty(_activeField)) return;
        
        // If they hit backspace, they chose to edit the existing value, so don't clear it on the next digit
        _fieldFreshlyActivated = false;

        if (!string.IsNullOrEmpty(_currentBuffer)) {
            _currentBuffer = _currentBuffer.Substring(0, _currentBuffer.Length - 1);
        }
        
        // If backspacing clears the whole thing, reset sign to positive for the next entry
        if (string.IsNullOrEmpty(_currentBuffer) && _activeField == "LottoNetDue") {
             LottoNetDue = 0;
        }

        decimal? val = null;
        if (!string.IsNullOrEmpty(_currentBuffer) && decimal.TryParse(_currentBuffer, out decimal parseVal)) {
            val = parseVal;
        }
        
        if (_activeField == "LottoNetDue") {
            // Always treat an empty or zero field as confirmed (neutral) or reset it
            _lottoSignConfirmed = (val == null || val == 0);
        }
        UpdateFieldValue(_activeField, val);
        _ = DebouncedAutoSave();
    }

    private decimal? GetRawFieldValue(string field) {
        return field switch {
            "Hours" => TotalHours,
            "BarSales" => BarSales,
            "LottoOpeningCash" => LottoOpeningCash,
            "LottoSales" => LottoSales,
            "LottoCashes" => LottoCashes,
            "LottoInstantTickets" => LottoInstantTickets,
            "LottoNetDue" => LottoNetDue,
            "LottoBackupBag" => LottoBackupBag,
            "LottoCashCounted" => LottoCashCounted,
            _ => null
        };
    }

    private string? GetInputDisplay(string field) {
        if (_activeField == field && !string.IsNullOrEmpty(_currentBuffer)) {
             // For Net Due, we still need the sign indicator even in buffer mode
             if (field == "LottoNetDue") return (LottoNetDue < 0 ? "- " : "") + _currentBuffer;
             return _currentBuffer;
        }
        
        decimal? val = field switch {
            "RescueSales" => _prevDaySales,
            "RescueCashes" => _prevDayCashes,
            "RescueTickets" => _prevDayTickets,
            _ => GetRawFieldValue(field)
        };
        if (val == null || (val == 0 && (field.StartsWith("Rescue")))) return "";
        
        if (field == "LottoNetDue") return (val < 0 ? "- " : "") + Math.Abs(val.Value).ToString("N2");
        return val.Value.ToString("N2");
    }

    private void ClearCurrentField() {
        _currentBuffer = "";
        UpdateFieldValue(_activeField, null);
        _ = DebouncedAutoSave();
    }

    private void NextField() {
        var fields = IsRentalHall 
            ? new[] { "BarSales" }
            : new[] { "Hours", "BarSales", "LottoOpeningCash", "LottoSales", "LottoCashes", "LottoNetDue", "LottoInstantTickets", "LottoBackupBag", "LottoCashCounted" };
            
        var idx = Array.IndexOf(fields, _activeField);
        if (idx < fields.Length - 1) {
             ActivateField(fields[idx + 1]);
        } else if (idx == fields.Length - 1) {
             _showFocusModal = false;
             _ = HandleFinalConfirm();
        } else {
             _showFocusModal = false;
        }
    }
