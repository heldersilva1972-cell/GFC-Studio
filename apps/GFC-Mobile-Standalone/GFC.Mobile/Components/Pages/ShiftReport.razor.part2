                    <div class="tablet-col-left">
                        @if (string.IsNullOrEmpty(ShiftType))
                        {
                            <div class="d-flex flex-column align-items-center justify-content-center p-5 h-100 animate-slide-up">
                                <div class="welcome-icon mb-4">
                                    <i class="bi bi-clock-history"></i>
                                </div>
                                <h2 class="fw-black text-dark mb-2">SELECT YOUR SHIFT</h2>
                                <p class="text-muted text-center mb-4 fs-5">Pick a shift to begin entering your end-of-shift report.</p>

                                @if (!string.IsNullOrEmpty(_lockErrorMessage))
                                {
                                    <p class="text-danger fw-bold text-center mb-4">@_lockErrorMessage</p>
                                }
                                
                                <div class="d-flex flex-column gap-5 w-100 align-items-center">
                                    <!-- DOWNSTAIRS BAR SECTION -->
                                    <div class="d-flex flex-column align-items-center gap-3 w-100">
                                        <div class="text-uppercase fw-black text-muted small letter-spacing-2 opacity-75">
                                            <i class="bi bi-shop me-2"></i> Downstairs Bar
                                        </div>
                                        <div class="d-flex gap-4 justify-content-center w-100 max-w-600">
                                            <button class='shift-choice-btn-tactile animate-bounce-in @(!_dayMainSubmitted ? "pulse-attention" : "completed-btn")' style='opacity: 1; cursor: pointer' @onclick='() => SetShift("Day")'>
                                                @if (_dayMainSubmitted) {
                                                    <div class="completed-badge"><i class="bi bi-check-circle-fill"></i></div>
                                                } else if (_dayMainHasData) {
                                                    <div class="status-indicator-dot warning"></div>
                                                }
                                                @if (IsDayLocked) {
                                                    <div class="view-only-badge"><i class="bi bi-eye-fill"></i> VIEW ONLY</div>
                                                }
                                                <i class="bi bi-sun-fill @(_dayMainSubmitted ? "text-success" : "text-warning")"></i>
                                                <span class="btn-label-text">Day Shift</span>
                                                <div class="shift-btn-status-footer">
                                                    @if (_dayMainSubmitted) { 
                                                        <span class="status-tag-text success">@(_dayMainModified ? "UPDATED BY" : "CLOSED BY")@(_dayMainModified ? " ✏️" : "")</span> 
                                                        @if (!string.IsNullOrEmpty(_dayCloser)) { <span class="user-pill success">@_dayCloser.ToUpper()</span> }
                                                    } else if (_dayMainHasData) {
                                                        <span class="status-tag-text warning">@(ShiftType == "Day" ? "CORRECTING..." : "DRAFT / IN PROGRESS")</span>
                                                        @if (!string.IsNullOrEmpty(_dayCloser)) { <span class="user-pill warning">@_dayCloser.ToUpper()</span> }
                                                    }
                                                </div>
                                            </button>
                                            <button class='shift-choice-btn-tactile animate-bounce-in @(!_nightMainSubmitted ? "pulse-attention" : "completed-btn")' style='animation-delay: 0.1s; opacity: 1; cursor: pointer' @onclick='() => SetShift("Night")'>
                                                @if (_nightMainSubmitted) {
                                                    <div class="completed-badge"><i class="bi bi-check-circle-fill"></i></div>
                                                } else if (_nightMainHasData) {
                                                    <div class="status-indicator-dot warning"></div>
                                                }
                                                @if (IsNightLocked) {
                                                    <div class="view-only-badge"><i class="bi bi-eye-fill"></i> VIEW ONLY</div>
                                                }
                                                <i class="bi bi-moon-stars-fill @(_nightMainSubmitted ? "text-success" : "text-primary")"></i>
                                                <span class="btn-label-text">Night Shift</span>
                                                <div class="shift-btn-status-footer">
                                                    @if (_nightMainSubmitted) { 
                                                        <span class="status-tag-text success">@(_nightMainModified ? "UPDATED BY" : "CLOSED BY")@(_nightMainModified ? " ✏️" : "")</span> 
                                                        @if (!string.IsNullOrEmpty(_nightCloser)) { <span class="user-pill success">@_nightCloser.ToUpper()</span> }
                                                    } else if (_nightMainHasData) {
                                                        <span class="status-tag-text warning">@(ShiftType == "Night" ? "CORRECTING..." : "DRAFT / IN PROGRESS")</span>
                                                        @if (!string.IsNullOrEmpty(_nightCloser)) { <span class="user-pill warning">@_nightCloser.ToUpper()</span> }
                                                    }
                                                </div>
                                            </button>
                                        </div>
                                    </div>

                                    <!-- OR SEPARATOR -->
                                    <div class="d-flex align-items-center gap-3 w-100 max-w-400 opacity-50">
                                        <hr class="flex-grow-1 border-2" />
                                        <span class="fw-black text-muted small">OR</span>
                                        <hr class="flex-grow-1 border-2" />
                                    </div>

                                    <!-- UPSTAIRS BAR SECTION -->
                                    <div class="d-flex flex-column align-items-center gap-3 w-100">
                                        <div class="text-uppercase fw-black text-muted small letter-spacing-2 opacity-75">
                                            <i class="bi bi-building-up me-2 text-indigo"></i> Rental Hall / Upstairs
                                        </div>
                                        <button class='shift-choice-btn-tactile animate-bounce-in upstairs-btn-theme w-100 max-w-400 @(!_hallSubmitted ? "pulse-attention" : "completed-btn")' style='animation-delay: 0.2s; opacity: 1; cursor: pointer' @onclick="ExecuteToggleRentalHall">
                                            @if (_hallSubmitted) {
                                                <div class="completed-badge"><i class="bi bi-check-circle-fill"></i></div>
                                            }
                                            @if (IsHallLocked) {
                                                <div class="view-only-badge"><i class="bi bi-eye-fill"></i> VIEW ONLY</div>
                                            }
                                            <i class="bi bi-building-up @(_hallSubmitted ? "text-success" : "text-indigo")"></i>
                                            <span class="btn-label-text">Upstairs Bar Entry</span>
                                            <div class="shift-btn-status-footer">
                                                @if (_hallSubmitted) { 
                                                    <span class="status-tag-text success">CLOSED BY</span> 
                                                    @if (!string.IsNullOrEmpty(_hallCloser)) { <span class="user-pill success">@_hallCloser.ToUpper()</span> }
                                                }
                                            </div>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="form-glass-card p-3 mb-2">
                                <div class="d-flex justify-content-between align-items-center mb-2 border-bottom border-2 pb-1">
                                    @if ((TotalHours ?? 0) > 0 || (BarSales ?? 0) > 0) {
                                        <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 rounded-pill px-2" style="font-size: 0.55rem; letter-spacing: 0.05em;"><i class="bi bi-check-circle-fill me-1"></i> DATA ENTERED</span>
                                    }
                                </div>
                                <div class="d-flex flex-column gap-1 mb-2">
                                    @if (!IsRentalHall)
                                    {
                                        <div class='input-group-modern @(_activeField == "Hours" ? "focused" : "") @(TotalHours != null && TotalHours != 0 && _activeField != "Hours" ? "active" : (_activeField != "Hours" && _showValidation ? "validation-pulse" : ""))' @onclick='() => ActivateField("Hours")' style="height: 55px; padding: 8px 15px;">
                                            <div class="d-flex align-items-center justify-content-between w-100">
                                                <div class="d-flex flex-column">
                                                    <span class='fw-black text-muted text-uppercase @(_activeField == "Hours" ? "focused-label" : "")' style="font-size: 0.7rem; letter-spacing: 0.05em;">HOURS WORKED</span>
                                                    <span class="text-muted small" style="font-size: 0.55rem;">LABOR TIME <i class="bi bi-clock"></i></span>
                                                </div>
                                                <div class="d-flex align-items-center">
                                                    <div class="form-input-modern text-end pe-1" style="font-size: 1.4rem;">@GetInputDisplay("Hours")</div>
                                                    @if (_activeField == "Hours") { <div class="ms-1 border-end border-3 border-primary animate-pulse" style="height: 1.4rem;"></div> }
                                                </div>
                                            </div>
                                        </div>
                                    }
                                    <div class='input-group-modern @(_activeField == "BarSales" ? "focused" : "") @(BarSales != null && BarSales != 0 && _activeField != "BarSales" ? "active" : (_activeField != "BarSales" && _showValidation ? "validation-pulse" : ""))' @onclick='() => ActivateField("BarSales")' style="height: @(IsRentalHall ? "80px" : "55px"); padding: 8px 15px;">
                                        <div class="d-flex align-items-center justify-content-between w-100">
                                            <div class="d-flex flex-column">
                                                <span class='fw-black text-muted text-uppercase @(_activeField == "BarSales" ? "focused-label" : "")' style="font-size: @(IsRentalHall ? "0.95rem" : "0.7rem"); letter-spacing: 0.05em;">REGISTER SALES</span>
                                                <span class="text-muted small" style="font-size: 0.55rem;">TOTAL Z-REPORT <i class="bi bi-cash-register"></i></span>
                                            </div>
                                            <div class="d-flex align-items-center">
                                                <span class="input-addon text-muted" style="font-size: @(IsRentalHall ? "1.5rem" : "1.1rem");">$</span>
                                                <div class="form-input-modern text-end pe-1" style="font-size: @(IsRentalHall ? "2.2rem" : "1.4rem"); line-height: 1;">@GetInputDisplay("BarSales")</div>
                                                @if (_activeField == "BarSales") { <div class="ms-1 border-end border-3 border-primary animate-pulse" style="height: @(IsRentalHall ? "2.2rem" : "1.4rem");"></div> }
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            @if (!IsRentalHall)
                            {
                                <div class="form-glass-card shadow-sm p-3 mb-2">
                                    <div class="d-flex justify-content-between align-items-center mb-1 border-bottom border-2 pb-1">
                                        <label class="section-label mb-0 fw-black text-indigo" style="font-size: 0.7rem;"><i class="bi bi-ticket-perforated me-2"></i> LOTTERY RECONCILIATION</label>
                                    </div>
                                    <div class="d-flex flex-column gap-1">
                                        <!-- ROW 1: OPENING CASH -->
                                        <div class='input-group-modern @(_activeField == "LottoOpeningCash" ? "focused" : (LottoOpeningCash != null ? "active" : (_showValidation ? "validation-pulse" : "")))' @onclick='() => ActivateField("LottoOpeningCash")' style="height: 60px;">
                                            <div class="d-flex align-items-center justify-content-between w-100">
                                                <div class="d-flex flex-column">
                                                    <span class='fw-black text-muted text-uppercase @(_activeField == "LottoOpeningCash" ? "focused-label" : "")' style="font-size: 0.75rem; line-height: 1.1;">Beginning Drawer Cash</span>
                                                    <span class="text-muted fw-bold small opacity-75" style="font-size: 0.55rem;">(STARTING CASH)</span>
                                                </div>
                                                <div class="d-flex align-items-center">
                                                    <span class="input-addon text-muted opacity-50 me-2" style="font-size: 1rem;">$</span>
                                                    <div class="form-input-modern text-end pe-1">@GetInputDisplay("LottoOpeningCash")</div>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- RESCUE MODE (NIGHT ONLY) -->
                                        @if (ShiftType == "Night" && !_dayMainHasData)
                                        {
                                            <div class="alert alert-warning border border-warning border-opacity-25 rounded-3 p-2 d-flex flex-column gap-1 mb-0 animate-bounce-in">
                                                <div class="fw-black text-warning small" style="font-size: 0.6rem;"><i class="bi bi-exclamation-triangle-fill me-1"></i> DAY SHIFT DATA MISSING — ENTER ENDING TOTALS FROM FIRST SHIFT</div>
                                                <div class="d-flex gap-2">
                                                    <div class='input-group-modern mini-rescue flex-fill @(_activeField == "RescueSales" ? "focused" : (_prevDaySales > 0 ? "active" : ""))' @onclick='() => ActivateField("RescueSales")' style="height: 45px; border-style: dashed; padding: 2px 8px;">
                                                        <span class="fw-black opacity-50 pe-1" style="font-size: 0.5rem;">NET SALES:</span>
                                                        <div class="form-input-modern text-end" style="font-size: 0.9rem;">@GetInputDisplay("RescueSales")</div>
                                                    </div>
                                                    <div class='input-group-modern mini-rescue flex-fill @(_activeField == "RescueCashes" ? "focused" : (_prevDayCashes > 0 ? "active" : ""))' @onclick='() => ActivateField("RescueCashes")' style="height: 45px; border-style: dashed; padding: 2px 8px;">
                                                        <span class="fw-black opacity-50 pe-1" style="font-size: 0.5rem;">CASHES:</span>
                                                        <div class="form-input-modern text-end" style="font-size: 0.9rem;">@GetInputDisplay("RescueCashes")</div>
                                                    </div>
                                                    <div class='input-group-modern mini-rescue flex-fill @(_activeField == "RescueTickets" ? "focused" : (_prevDayTickets > 0 ? "active" : ""))' @onclick='() => ActivateField("RescueTickets")' style="height: 45px; border-style: dashed; padding: 2px 8px;">
                                                        <span class="fw-black opacity-50 pe-1" style="font-size: 0.5rem;">TICKETS:</span>
                                                        <div class="form-input-modern text-end" style="font-size: 0.9rem;">@GetInputDisplay("RescueTickets")</div>
                                                    </div>
                                                </div>
                                            </div>
                                        }

                                        <!-- SALES -->
                                        <div class='input-group-modern @(_activeField == "LottoSales" ? "focused" : (LottoSales != null && LottoSales != 0 ? "active" : (_showValidation ? "validation-pulse" : "")))' @onclick='() => ActivateField("LottoSales")' style="height: 60px;">
                                            <div class="d-flex align-items-center justify-content-between w-100">
                                                <div class="d-flex flex-column">
                                                    <span class='fw-black text-success text-uppercase @(_activeField == "LottoSales" ? "focused-label" : "")' style="font-size: 0.75rem; line-height: 1.1;">Net Sales</span>
                                                    <span class="text-success fw-bold small opacity-75" style="font-size: 0.55rem;">(RPT 50)</span>
                                                </div>
                                                <div class="d-flex align-items-center">
                                                    <span class="input-addon text-success opacity-50 me-2" style="font-size: 1rem;">$</span>
                                                    <div class="form-input-modern text-end pe-1">@GetInputDisplay("LottoSales")</div>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- CASHES -->
                                        <div class='input-group-modern @(_activeField == "LottoCashes" ? "focused" : (LottoCashes != null && LottoCashes != 0 ? "active" : (_showValidation ? "validation-pulse" : "")))' @onclick='() => ActivateField("LottoCashes")' style="height: 60px;">
                                            <div class="d-flex align-items-center justify-content-between w-100">
                                                <div class="d-flex flex-column">
                                                    <span class='fw-black text-danger text-uppercase @(_activeField == "LottoCashes" ? "focused-label" : "")' style="font-size: 0.75rem; line-height: 1.1;">Cashes</span>
                                                    <span class="text-danger fw-bold small opacity-75" style="font-size: 0.55rem;">(RPT 50)</span>
                                                </div>
                                                <div class="d-flex align-items-center">
                                                    <span class="input-addon text-danger opacity-50 me-2" style="font-size: 1rem;">$</span>
                                                    <div class="form-input-modern text-end pe-1">@GetInputDisplay("LottoCashes")</div>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- NET DUE -->
                                        <div class='input-group-modern @(_activeField == "LottoNetDue" ? "focused" : (LottoNetDue != null && LottoNetDue != 0 && _lottoSignConfirmed ? "active" : (_showValidation ? "validation-pulse" : "")))' @onclick='() => ActivateField("LottoNetDue")' style="height: 60px;">
                                            <div class="d-flex align-items-center justify-content-between w-100">
                                                <div class="d-flex flex-column">
                                                    <span class='fw-black text-primary text-uppercase @(_activeField == "LottoNetDue" ? "focused-label" : "")' style="font-size: 0.75rem; line-height: 1.1;">Net Due</span>
                                                    <span class="text-primary fw-bold small opacity-75" style="font-size: 0.55rem;">(FROM REPORT 50)</span>
                                                </div>
                                                <div class="d-flex align-items-center">
                                                    <span class="input-addon text-primary opacity-50 me-2" style="font-size: 1rem;">$</span>
                                                    <div class="form-input-modern text-end pe-1 @(LottoNetDue < 0 ? "text-danger" : LottoNetDue > 0 ? "text-success" : "")">@GetInputDisplay("LottoNetDue")</div>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- TICKETS -->
                                        <div class='input-group-modern @(_activeField == "LottoInstantTickets" ? "focused" : (LottoInstantTickets != null && LottoInstantTickets != 0 ? "active" : (_showValidation ? "validation-pulse" : "")))' @onclick='() => ActivateField("LottoInstantTickets")' style="height: 60px;">
                                            <div class="d-flex align-items-center justify-content-between w-100">
                                                <div class="d-flex flex-column">
                                                    <span class='fw-black text-purple text-uppercase @(_activeField == "LottoInstantTickets" ? "focused-label" : "")' style="font-size: 0.75rem; line-height: 1.1;">Instant Tickets</span>
                                                    <span class="text-purple fw-bold small opacity-75" style="font-size: 0.55rem;">(RPT 34)</span>
                                                </div>
                                                <div class="d-flex align-items-center">
                                                    <span class="input-addon text-purple opacity-50 me-2" style="font-size: 1rem;">$</span>
                                                    <div class="form-input-modern text-end pe-1 text-purple">@GetInputDisplay("LottoInstantTickets")</div>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- BACKUP BAG -->
                                        <div class='input-group-modern @(_activeField == "LottoBackupBag" ? "focused" : (LottoBackupBag != null ? "active" : (_showValidation ? "validation-pulse" : "")))' @onclick='() => ActivateField("LottoBackupBag")' style="height: 60px;">
                                            <div class="d-flex align-items-center justify-content-between w-100">
                                                <div class="d-flex flex-column">
                                                    <span class='fw-black text-muted text-uppercase @(_activeField == "LottoBackupBag" ? "focused-label" : "")' style="font-size: 0.7rem; line-height: 1.1;">Backup Bag</span>
                                                    <span class="text-muted fw-bold small opacity-75" style="font-size: 0.5rem;">(BAG ADDITION)</span>
                                                </div>
                                                <div class="d-flex align-items-center">
                                                    <span class="input-addon text-muted opacity-50 me-2" style="font-size: 0.9rem;">$</span>
                                                    <div class="form-input-modern text-end pe-1">@GetInputDisplay("LottoBackupBag")</div>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- ENDING CASH -->
                                        <div class='input-group-modern @(_activeField == "LottoCashCounted" ? "focused" : (LottoCashCounted != null && LottoCashCounted != 0 ? "active" : (_showValidation ? "validation-pulse" : ""))) border-primary border-opacity-25' @onclick='() => ActivateField("LottoCashCounted")' style="background: rgba(13, 110, 253, 0.02); height: 75px;">
                                            <div class="d-flex justify-content-between align-items-center w-100 shadow-sm rounded-4 px-3" style="background: white;">
                                                <div class="d-flex flex-column justify-content-center">
                                                    <span class='fw-black text-primary text-uppercase @(_activeField == "LottoCashCounted" ? "focused-label" : "")' style="font-size: 0.85rem;">TOTAL CASH COUNTED FROM DRAWER</span>
                                                    <span class="text-muted fw-bold small" style="font-size: 0.52rem;">(TOTAL CASH IN DRAWER)</span>
                                                </div>
                                                <div class="d-flex align-items-center">
                                                    <span class="text-primary fw-black me-2" style="font-size: 1.4rem;">$</span>
                                                    <div class="form-input-modern text-end pe-1" style="font-size: 1.8rem; color: var(--bs-primary) !important;">@GetInputDisplay("LottoCashCounted")</div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }

                            <div class="form-glass-card shadow-sm p-3 mb-3">
                                <label class="small text-muted fw-bold text-uppercase mb-2" style="font-size:0.65rem;">Shift Notes &amp; Discrepancies</label>
                                <textarea class="form-control-modern" rows="3" placeholder="Type details here..." @bind="Notes" disabled="@IsLocked"></textarea>
                            </div>
                        }
                    </div>

                <!-- ===== RIGHT COLUMN: KEYPAD AREA ===== -->
                @if (!string.IsNullOrEmpty(ShiftType)) {
                    <div class="tablet-col-right">
                        @if (!IsRentalHall)
                        {
                            <div class="sim-res-card-unified shadow-lg mb-1 @(LottoDiscrepancy == 0 ? "exact" : LottoDiscrepancy > 0 ? "over" : "short")" style="min-height: auto;">
                                <div class="summary-header" style="font-size: 0.65rem; white-space: nowrap; padding: 2px;">
                                    <i class="bi bi-calculator-fill me-2 opacity-50"></i> LOTTERY SUMMARY
                                </div>
                                 <div class="math-flow-table p-2">
                                     <div class="math-row opacity-60 mb-1" style="font-size: 0.75rem;">
                                         <span class="fw-bold">🏦 STARTING CASH</span>
                                         <span class="fw-black">@((LottoOpeningCash ?? 0).ToString("C2"))</span>
                                     </div>
                                     <div class="math-row opacity-50 ps-2" style="font-size: 0.65rem; line-height: 1;">
                                         <span>+ Sales (RPT 50)</span>
                                         <span class="fw-bold">+@((Math.Abs(LottoSalesActivity)).ToString("N2"))</span>
                                     </div>
                                     <div class="math-row opacity-50 ps-2" style="font-size: 0.65rem; line-height: 1;">
                                         <span>- Cashes (RPT 50)</span>
                                         <span class="fw-bold">-@((Math.Abs((ShiftType == "Night" ? (LottoCashes ?? 0) - _prevDayCashes : (LottoCashes ?? 0)))).ToString("N2"))</span>
                                     </div>
                                     <div class="math-row opacity-50 ps-2 mb-1" style="font-size: 0.65rem; line-height: 1;">
                                         <span>- Tickets (RPT 34)</span>
                                         <span class="fw-bold">-@((Math.Abs((ShiftType == "Night" ? (LottoInstantTickets ?? 0) - _prevDayTickets : (LottoInstantTickets ?? 0)))).ToString("N2"))</span>
                                     </div>
                                     @if (LottoBackupBag > 0)
                                     {
                                         <div class="math-row text-primary py-1 px-2 rounded-2 mt-2 mb-1" style="font-size: 0.7rem; background: rgba(13, 110, 253, 0.05); border: 1px dashed rgba(13, 110, 253, 0.2);">
                                             <span class="fw-black text-uppercase">💰 From Backup Bag</span>
                                             <span class="fw-black">+@((LottoBackupBag ?? 0).ToString("C2"))</span>
                                         </div>
                                     }
                                     
                                     <div class="math-row border-top mt-1 pt-1 mb-1 @(LottoNetMade >= 0 ? "text-success" : "text-danger")" style="font-size: 0.85rem;">
                                         <span class="fw-black">NET REGISTER SALES</span>
                                         <span class="fw-black">@(LottoNetMade >= 0 ? "+" : "-")@(Math.Abs(LottoNetMade).ToString("C2"))</span>
                                     </div>
                                     <div class="math-row total-expected border-top border-primary border-opacity-10 mt-1 pt-1">
                                         <span class="fw-black text-primary" style="font-size: 0.75rem;">🎯 EXPECTED DRAWER</span>
                                         <span class="fw-black text-primary fs-5">@(LottoDrawerValue.ToString("C2"))</span>
                                     </div>
                                     <div class="math-row text-muted opacity-60 mt-0">
                                         <span class="small fw-bold">💵 COUNTED DRAWER</span>
                                         <span class="small fw-bold fs-6">@((LottoCashCounted ?? 0).ToString("C2"))</span>
                                     </div>
                                 </div>
                                 <div class="variance-footer-banner py-2 shadow-sm @(LottoDiscrepancy == 0 ? "bg-success" : "bg-danger")" style="display: block !important; border-bottom-left-radius: 22px; border-bottom-right-radius: 22px;">
                                     <div class="v-label fw-black mb-0" style="font-size: 0.65rem;">LOTTERY VARIANCE</div>
                                     <div class="v-value fs-2 fw-black text-white">@((LottoDiscrepancy == 0 ? "$0.00" : (LottoDiscrepancy > 0 ? "+" : "-") + Math.Abs(LottoDiscrepancy).ToString("C2")))</div>
                                 </div>
                            </div>
