        background: white;
        border-radius: 50px;
        height: 70px;
        border: 1px solid rgba(0,0,0,0.05);
        margin-top: 5px;
    }

    .header-summary-dropdown {
        position: absolute;
        top: 100%;
        right: 0;
        width: 260px;
        z-index: 4000;
        margin-top: 15px;
        background: #1e293b !important;
        padding: 20px !important;
        border-radius: 24px !important;
        animation: slide-down 0.2s cubic-bezier(0.4, 0, 0.2, 1);
