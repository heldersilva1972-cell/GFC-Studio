    // MATH
    private int AdmissionCount => AdmissionPacks.Sum(p => p.Sold);
    private decimal TotalAdmissionRevenue => AdmissionPacks.Sum(p => p.Sold * p.Price);
    private decimal TotalFloorRevenue => Sheets.Sum(s => s.ManualSold * s.Price);
    private decimal TotalGross => TotalAdmissionRevenue + TotalFloorRevenue;
    private decimal TotalPrizes => Sheets.Sum(s => s.Games.Sum(g => CalculateGamePayout(s, g)));
    
    // The "Standard Program" is the revenue reserved for the Base games ($15 + extra squares)
    private decimal StandardProgramRevenue => (AdmissionCount * _bingoSettings.BasePrice) + (TotalExtraCards * _bingoSettings.CardPrice);

    private int TotalExtraCards => AdmissionPacks.Sum(p => p.Sold * (GetAdmitCount(p.Name) - 9) / 3);

    // Standard Program Lottery (5% of the Standard Revenue)
    private decimal StandardLotteryFee => StandardProgramRevenue * 0.05m;
    
    // Total Lottery is Standard Lottery + Individual Lotteries for Specials
    private decimal TotalLotteryTake => StandardLotteryFee + Sheets.Where(s => !s.IsAdmissionOnly).Sum(CalculateLotteryTake);
    
    // Admission Only Club Profit (Remainder of Standard Program Revenue after paying its prizes)
    private decimal AdmissionClubProfit => StandardProgramRevenue > 0
        ? StandardProgramRevenue - StandardLotteryFee - Sheets.Where(s => s.IsAdmissionOnly).Sum(s => s.Games.Sum(g => CalculateGamePayout(s, g)))
        : 0m;

    private decimal TotalClubTake => Sheets.Where(s => !s.IsAdmissionOnly).Sum(CalculateClubTake) + AdmissionClubProfit;
    
    private decimal TotalNetProceeds => TotalGross - TotalPrizes - TotalLotteryTake;

    private decimal CalculateLotteryTake(BingoSheet sheet) 
    {
        // For specials, we calculate lottery based on their total sold (including the portion inside packs)
        // This is correct because we subtracted their price from the "Standard Program" revenue above.
        return (sheet.Sold * sheet.Price) * sheet.LotteryPercentage;
    }

    private decimal CalculateClubTake(BingoSheet sheet)
    {
        var gross = sheet.Sold * sheet.Price;
        if (sheet.PayoutMode == 1) // 50/50 Split (Sequential)
        {
            var afterLottery = gross - CalculateLotteryTake(sheet);
            return afterLottery * sheet.ClubPercentage;
        }
        return gross * sheet.ClubPercentage;
    }

    private decimal CalculateSheetNet(BingoSheet sheet)
    {
        var gross = sheet.Sold * sheet.Price;
        var lottery = CalculateLotteryTake(sheet);
        var prizes = sheet.Games.Sum(g => CalculateGamePayout(sheet, g));
        
        return gross - lottery - prizes;
    }

    private decimal GetCurrentPayoutPercentage()
    {
        if (_bingoSettings.PayoutTiers == null || !_bingoSettings.PayoutTiers.Any()) return 100m;
        
        var admissions = AdmissionCount;
        var tier = _bingoSettings.PayoutTiers
            .Where(t => t.MinAdmissions <= admissions)
            .OrderByDescending(t => t.MinAdmissions)
            .FirstOrDefault();
            
        return tier?.PayoutPercentage ?? _bingoSettings.PayoutTiers.Min(t => t.PayoutPercentage);
    }



    private decimal CalculateGamePayout(BingoSheet sheet, BingoGame game)
    {
        if (sheet.PayoutMode == 1 || sheet.PayoutMode == 2)
        {
            var gross = sheet.Sold * sheet.Price;
            decimal availableForPrizes;

            if (sheet.PayoutMode == 1) // Sequential
            {
                // For the prize calculation, we must deduct the THEORETICAL lottery and club take
                // from the total gross, even if those sheets were included in admission.
                var theoreticalLottery = gross * sheet.LotteryPercentage;
                var theoreticalClub = (gross - theoreticalLottery) * sheet.ClubPercentage;
                availableForPrizes = gross - theoreticalLottery - theoreticalClub;
            }
            else // Mode 2: Additive (Gross %)
            {
                var totalDeductionPercent = sheet.LotteryPercentage + sheet.ClubPercentage;
                availableForPrizes = gross * (1 - totalDeductionPercent);
            }
            
            var gameCount = sheet.Games?.Count ?? 1;
            if (gameCount == 0) gameCount = 1;

            return availableForPrizes / gameCount;
        }

        // Mode 0: Fixed Prize (Tiered)
        if (game.IsVariablePayout) return game.Payout;

        var basePrize = game.DefaultPayout;
        var tierPercentage = GetCurrentPayoutPercentage();
        return basePrize * (tierPercentage / 100m);
    }



    // PERSISTENCE
    private async Task SaveDraftAsync()
    {
        var key = $"gfc_bingo_draft_{SessionDate:yyyyMMdd}";
        var data = new BingoDraft { AdmissionPacks = AdmissionPacks, Sheets = Sheets };
        await JSRuntime.InvokeVoidAsync("window.gfcSetAsync", key, data);
        _lastSavedTime = DateTime.Now;
        _lastSavedText = "SAVED LOCALLY";
        StateHasChanged();
    }

    private async Task LoadDraftAsync()
    {
        try 
        {
            var key = $"gfc_bingo_draft_{SessionDate:yyyyMMdd}";
            var draft = await JSRuntime.InvokeAsync<BingoDraft>("window.gfcGetAsync", key);
            
            if (draft != null)
            {
                foreach (var dPack in draft.AdmissionPacks)
                {
                    var p = AdmissionPacks.FirstOrDefault(x => x.Id == dPack.Id);
                    if (p != null) p.Sold = dPack.Sold;
                }
                foreach (var dSheet in draft.Sheets)
                {
                    var s = Sheets.FirstOrDefault(x => x.ColorName == dSheet.ColorName);
                    if (s != null)
                    {
                        s.ManualSold = dSheet.ManualSold;
                        s.IsClosedOut = dSheet.IsClosedOut;
                        foreach (var dGame in dSheet.Games)
                        {
                            var g = s.Games.FirstOrDefault(x => x.Name == dGame.Name);
                            if (g != null) 
                            {
                                g.Payout = dGame.Payout;
                                g.WinnerCount = dGame.WinnerCount;
                            }
                        }
                    }
                }
                RecalculateSheetTotals();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Draft error: {ex.Message}");
            // Don't remove it, let's keep it in case it's a temporary issue
        }
    }

    private async Task CloseOutColorAsync()
    {
        if (_selectedSheet == null) return;
        
        // Save locally first
        await SaveDraftAsync();
        
        // Prepare session object for the server
        var session = PrepareSessionObject();
        session.Status = "Partial"; // Indicate this is an incremental update
        
        _showCloseOutConfirmation = false;
        var success = await ReportingService.SubmitBingoSessionAsync(session, _currentUsername);
        
        if (success)
        {
            _selectedSheet.IsClosedOut = true;
        }
        
        _selectedSheet = null;
        StateHasChanged();
    }

    private BingoSession PrepareSessionObject()
    {
        return new BingoSession
        {
            SessionDate = SessionDate,
            AdmissionCount = AdmissionCount,
            TotalGrossReceipts = TotalGross,
            TotalPrizesPaid = TotalPrizes,
            TotalLotteryTake = TotalLotteryTake,
            TotalClubTake = TotalClubTake,
            Status = "Submitted",
            AdmissionEntries = AdmissionPacks.Where(p => p.Sold > 0).Select(p => new BingoAdmissionEntry
            {
                AdmissionDefinitionId = p.Id,
                Quantity = p.Sold,
                PriceAtTime = p.Price
            }).ToList(),
            GameEntries = Sheets.SelectMany(s => s.Games.Select(g => new BingoGameEntry
            {
                SheetColor = s.ColorName,
                GameName = g.Name,
                SheetsSold = s.Sold,
                PricePerSheet = s.Price,
                GrossReceipts = s.Sold * s.Price,
                PrizePaid = CalculateGamePayout(s, g),
                LotteryPercent = s.LotteryPercentage,
                ClubPercent = s.ClubPercentage,
                LotteryTake = (s.Sold * s.Price) * s.LotteryPercentage,
                ClubTake = s.PayoutMode == 1 ? ((s.Sold * s.Price) - ((s.Sold * s.Price) * s.LotteryPercentage)) * s.ClubPercentage : (s.Sold * s.Price) * s.ClubPercentage,
                NetProceeds = CalculateSheetNet(s) / s.Games.Count 
            })).ToList()
        };
    }

