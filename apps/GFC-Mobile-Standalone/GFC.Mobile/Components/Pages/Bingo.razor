    private async Task SavePullTabEntry()
    {
        _pullTabValidationError = "";
        try
        {
            var errors = new List<string>();
            if (_editingPullTab.GameDefinitionId == 0)
            {
                errors.Add("Please select a Game Type.");
            }
            if (string.IsNullOrWhiteSpace(_editingPullTab.SellerName))
            {
                errors.Add("Please enter a Seller Name.");
            }
            if (string.IsNullOrWhiteSpace(_editingPullTab.SerialNumber))
            {
                errors.Add("Please enter a Serial Number.");
            }

            if (errors.Any())
            {
                _pullTabValidationError = string.Join(" | ", errors);
                return;
            }

            if (_isEditMode)
            {
                var existing = _pullTabEntries.FirstOrDefault(e => e.GlobalId == _editingPullTab.GlobalId);
                if (existing != null)
                {
                    existing.GameDefinitionId = _editingPullTab.GameDefinitionId;
                    existing.SelectedPrizeOptionId = _editingPullTab.SelectedPrizeOptionId;
                    existing.SellerName = _editingPullTab.SellerName;
                    existing.SerialNumber = _editingPullTab.SerialNumber;
                    existing.TicketsIssued = _editingPullTab.TicketsIssued;
                    existing.TicketsReturned = _editingPullTab.TicketsReturned;
                    existing.PrizesPaid = _editingPullTab.PrizesPaid;
                    existing.StartingBank = _editingPullTab.StartingBank;
                    existing.CashReceived = _editingPullTab.CashReceived;
                }
            }
            else
            {
                _pullTabEntries.Add(_editingPullTab);
            }

            UpdatePreviousSellers();
            _showPullTabModal = false;
            _activeField = "";
            _showFloatingKeypad = false;
            await SaveDraftAsync();
            _needsSync = true;
            StateHasChanged();
            await ShowToast("Saved", "Pull Tab Entry saved successfully.", "success");
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", "Error saving entry: " + ex.Message + "\n" + ex.StackTrace);
        }
    }

