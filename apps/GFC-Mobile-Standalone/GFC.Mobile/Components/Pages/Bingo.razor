@if (_showBeanoReportModal)
{
    <div class="modal-backdrop-custom animate-fade-in" style="z-index: 9000;" @onclick="async () => { await SaveDraftAsync(); _showBeanoReportModal = false; }"></div>
    <div class="sheet-detail-modal animate-zoom-in shadow-lg border-top border-primary" style="z-index: 9500; max-width: 650px; border-top-width: 8px !important; top: 50%; left: 50%; transform: translate(-50%, -50%); display: flex; flex-direction: column; max-height: 90vh; border-radius: 24px; background: white;">
        <div class="detail-header d-flex justify-content-between align-items-center p-4 border-bottom bg-light" style="border-top-left-radius: 16px; border-top-right-radius: 16px;">
            <h5 class="fw-black text-uppercase mb-0 d-flex align-items-center gap-2" style="letter-spacing: -0.02em; color: #0f172a !important;">
                <i class="bi bi-file-earmark-spreadsheet-fill text-primary fs-4"></i> BEANO FINANCIAL REPORT
            </h5>
            <button type="button" class="btn-close" @onclick="async () => { await SaveDraftAsync(); _showBeanoReportModal = false; }" aria-label="Close"></button>
        </div>
        <div class="detail-body p-4 overflow-auto bg-light" style="flex: 1;">
            @{
                var unmappedFloorGross = Sheets
                    .Where(s => (s.ManualSold > 0 || (s.IsIncludedInAdmission && !s.IsAdmissionOnly)) && s.ColorName != _wtaColor && s.ColorName != _progColor)
                    .Sum(s => s.Sold * s.Price);
                var wtaObjForTotal = Sheets.FirstOrDefault(s => s.ColorName == _wtaColor);
                var progObjForTotal = Sheets.FirstOrDefault(s => s.ColorName == _progColor);
                decimal wGross = wtaObjForTotal != null ? (wtaObjForTotal.Sold * wtaObjForTotal.Price) : 0;
                decimal pGross = progObjForTotal != null ? (progObjForTotal.Sold * progObjForTotal.Price) : 0;
                decimal combinedFloorAndSpecialTotal = unmappedFloorGross + wGross + pGross;

                decimal grossBeanoReceipts = StandardProgramRevenue + combinedFloorAndSpecialTotal + _beanoSuppliesSales + _beanoOtherReceipts;
                decimal taxPaid = grossBeanoReceipts * 0.05m;
                decimal totalPrizesPaid = TotalPrizes;
                decimal totalExpenditures = taxPaid + totalPrizesPaid + _beanoOtherExpenses.Sum(e => e.Amount);
                decimal netProfit = grossBeanoReceipts - totalExpenditures;
                decimal pullTabNetProceeds = TotalPullTabSales - TotalPullTabPrizes;
                decimal totalFundsAvailable = _beanoUnexpendedNetProfit + netProfit + pullTabNetProceeds + _beanoInterest + _beanoGameBank + _beanoOthers;
                decimal totalDisbursements = _beanoDisbursements.Sum(d => d.Amount);
                decimal finalUnexpended = totalFundsAvailable - totalDisbursements;
                decimal breakdownSum = _beanoCheckbookBalance + _beanoSavingsBalance + _beanoCdBalance;
                bool breakdownDiff = Math.Abs(breakdownSum - finalUnexpended) > 0.05m;
            }
            
            <!-- GENERAL OCCASION INFORMATION -->
            <div class="card border border-light-subtle rounded-4 p-3 shadow-sm mb-4" style="background: white;">
                <h6 class="fw-black text-primary text-uppercase mb-3" style="font-size: 0.8rem; letter-spacing: 0.05em;">GENERAL OCCASION INFORMATION</h6>
                <div class="row g-2">
                    <div class="col-4">
                        <label class="form-label fw-bold text-muted small mb-0">Day of Occasion</label>
                        <div class="fw-black text-dark">@SessionDate.ToString("dddd")</div>
                    </div>
                    <div class="col-4">
                        <label class="form-label fw-bold text-muted small mb-0">Date of Occasion</label>
                        <div class="fw-black text-dark">@SessionDate.ToString("MM/dd/yyyy")</div>
                    </div>
                    <div class="col-4">
                        <label class="form-label fw-bold text-muted small mb-0">Number of Players</label>
                        <div class="mt-1"><span style="background: #eff6ff; color: #1d4ed8; border: 1px solid #bfdbfe; border-radius: 6px; padding: 2px 8px; display: inline-block; font-weight: 700; font-size: 0.85rem;">@AdmissionCount</span></div>
                    </div>
                </div>
            </div>

            <!-- SCHEDULE 1: INCOME STATEMENT -->
            <div class="card border border-light-subtle rounded-4 p-3 shadow-sm mb-4" style="background: white;">
                <h6 class="fw-black text-primary text-uppercase mb-3" style="font-size: 0.8rem; letter-spacing: 0.05em;">SCHEDULE 1: BEANO INCOME STATEMENT</h6>
                
                <!-- A. RECEIPTS -->
                <div class="border-bottom pb-3 mb-3">
                    <div class="fw-bold text-uppercase text-secondary mb-2 small" style="letter-spacing: 0.05em;">A. Receipts</div>
                    
                    <!-- 1. Admission Cards -->
                    <div class="d-flex justify-content-between align-items-center mb-2" style="font-size: 0.85rem;">
                        <span class="text-muted">1. Admission Cards:</span>
                        <span class="fw-bold text-dark">@TotalPacksSold cards @@ @_bingoSettings.BasePrice.ToString("C2") = <span style="background: #eff6ff; color: #1d4ed8; border: 1px solid #bfdbfe; border-radius: 6px; padding: 2px 8px; display: inline-block; font-weight: 700;">@((TotalPacksSold * _bingoSettings.BasePrice).ToString("C2"))</span></span>
                    </div>
                    
                    <!-- 2. Extra Regular Cards -->
                    <div class="d-flex justify-content-between align-items-center mb-2" style="font-size: 0.85rem;">
                        <span class="text-muted">2. Extra Regular Cards:</span>
                        <span class="fw-bold text-dark">@TotalExtraCards cards @@ @_bingoSettings.CardPrice.ToString("C2") = <span style="background: #eff6ff; color: #1d4ed8; border: 1px solid #bfdbfe; border-radius: 6px; padding: 2px 8px; display: inline-block; font-weight: 700;">@((TotalExtraCards * _bingoSettings.CardPrice).ToString("C2"))</span></span>
                    </div>

                    <!-- 3. Floor Sheets & Special Games Group -->
                    <div class="bg-light p-3 rounded-4 mb-3 mt-3 border">
                        <div class="mb-2">
                            <span class="fw-black text-dark text-uppercase" style="font-size: 0.7rem; letter-spacing: 0.05em;">3. Floor Sheets & Special Games</span>
                        </div>

                        <!-- Floor Sheets (Manual Sales & Admission Specials) -->
                        @foreach (var sheet in Sheets.Where(s => 
                            (s.ManualSold > 0 || (s.IsIncludedInAdmission && !s.IsAdmissionOnly)) && 
                            s.ColorName != _wtaColor && 
                            s.ColorName != _progColor))
                        {
                            <div class="d-flex justify-content-between align-items-center mb-1 ps-2" style="font-size: 0.8rem;">
                                <span class="text-muted">Floor Sheets (@sheet.ColorName):</span>
                                <span class="fw-bold text-dark">@sheet.Sold sheets @@ @sheet.Price.ToString("C2") = <span style="background: #eff6ff; color: #1d4ed8; border: 1px solid #bfdbfe; border-radius: 6px; padding: 2px 8px; display: inline-block; font-weight: 700; font-size: 0.75rem;">@((sheet.Sold * sheet.Price).ToString("C2"))</span></span>
                            </div>
                        }

                        <!-- Special Games Mappings & Selector -->
                        <div class="border-top mt-2 pt-2">
                            <span class="fw-bold text-secondary text-uppercase d-block mb-2" style="font-size: 0.65rem; letter-spacing: 0.05em;">Special Games Sheet Mapping</span>
                            <div class="row g-2 mb-2" style="font-size: 0.75rem;">
                                <div class="col-6">
                                    <label class="fw-bold text-muted mb-0.5">W.T.A. Sheet</label>
                                    <select class="form-select form-select-sm fw-bold" @bind="_wtaColor">
                                        <option value="">-- SELECT SHEET --</option>
                                        @foreach (var s in Sheets.Where(sheet => !sheet.IsAdmissionOnly && (sheet.ColorName == _wtaColor || sheet.ColorName != _progColor)))
                                        {
                                            <option value="@s.ColorName">@s.ColorName (@s.Price.ToString("C0"))</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-6">
                                    <label class="fw-bold text-muted mb-0.5">Progressive Sheet</label>
                                    <select class="form-select form-select-sm fw-bold" @bind="_progColor">
                                        <option value="">-- SELECT SHEET --</option>
                                        @foreach (var s in Sheets.Where(sheet => !sheet.IsAdmissionOnly && (sheet.ColorName == _progColor || sheet.ColorName != _wtaColor)))
                                        {
                                            <option value="@s.ColorName">@s.ColorName (@s.Price.ToString("C0"))</option>
                                        }
                                    </select>
                                </div>
                            </div>

                            <!-- Special Games Table Preview -->
                            <table class="table table-sm table-borderless mb-0 mt-2" style="font-size: 0.75rem; vertical-align: middle;">
                                <thead>
                                    <tr class="text-uppercase fw-bold text-muted" style="font-size: 0.6rem; border-bottom: 1px solid rgba(0,0,0,0.08);">
                                        <th>Special Game</th>
                                        <th>Color</th>
                                        <th class="text-center">Cards</th>
                                        <th class="text-end">Price</th>
                                        <th class="text-end">Total</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{
                                        var w = Sheets.FirstOrDefault(s => s.ColorName == _wtaColor);
                                        var p = Sheets.FirstOrDefault(s => s.ColorName == _progColor);
                                    }
                                    <tr>
                                        <td class="fw-bold">W.T.A.</td>
                                        <td>@(w?.ColorName ?? "Unmapped")</td>
                                        <td class="text-center">@(w?.Sold ?? 0)</td>
                                        <td class="text-end">@(w?.Price.ToString("C2") ?? "$0.00")</td>
                                        <td class="text-end fw-bold"><span style="background: #eff6ff; color: #1d4ed8; border: 1px solid #bfdbfe; border-radius: 6px; padding: 2px 8px; display: inline-block; font-weight: 700; font-size: 0.75rem;">@wGross.ToString("C2")</span></td>
                                    </tr>
                                    <tr>
                                        <td class="fw-bold">Progressive</td>
                                        <td>@(p?.ColorName ?? "Unmapped")</td>
                                        <td class="text-center">@(p?.Sold ?? 0)</td>
                                        <td class="text-end">@(p?.Price.ToString("C2") ?? "$0.00")</td>
                                        <td class="text-end fw-bold"><span style="background: #eff6ff; color: #1d4ed8; border: 1px solid #bfdbfe; border-radius: 6px; padding: 2px 8px; display: inline-block; font-weight: 700; font-size: 0.75rem;">@pGross.ToString("C2")</span></td>
                                    </tr>
                                </tbody>
                            </table>
                            
                            <!-- Total Row at the bottom -->
                            <div class="d-flex justify-content-between align-items-center mt-3 pt-2 border-top" style="font-size: 0.85rem;">
                                <span class="fw-black text-dark text-uppercase">Total Floor & Special Games:</span>
                                <span style="background: #eff6ff; color: #1d4ed8; border: 1px solid #bfdbfe; border-radius: 6px; padding: 4px 10px; display: inline-block; font-weight: 800; font-size: 0.9rem;">@combinedFloorAndSpecialTotal.ToString("C2")</span>
                            </div>
                        </div>
                    </div>

                    <!-- 4. Sale of Beano Supplies -->
                    <div class="d-flex justify-content-between align-items-center mb-2" style="font-size: 0.85rem;">
                        <span class="text-muted small">4. Sale of Beano Supplies ($):</span>
                        <div style="width: 120px;">
                            <input type="number" step="0.01" id="input-BeanoSuppliesSales" class="form-control form-control-sm fw-bold border text-end" @onclick='() => ActivateField("BeanoSuppliesSales")' @bind="_beanoSuppliesSales" readonly />
                        </div>
                    </div>

                    <!-- 5. Other Receipts -->
                    <div class="d-flex justify-content-between align-items-center mb-3" style="font-size: 0.85rem;">
                        <span class="text-muted small">5. Other Receipts ($):</span>
                        <div style="width: 120px;">
                            <input type="number" step="0.01" id="input-BeanoOtherReceipts" class="form-control form-control-sm fw-bold border text-end" @onclick='() => ActivateField("BeanoOtherReceipts")' @bind="_beanoOtherReceipts" readonly />
                        </div>
                    </div>

                    <!-- 6. GROSS BEANO RECEIPTS -->
                    <div class="d-flex justify-content-between align-items-center mt-3 pt-2 border-top">
                        <span class="fw-black text-dark uppercase" style="font-size: 0.8rem;">6. GROSS BEANO RECEIPTS:</span>
                        <span style="background: #eff6ff; color: #1d4ed8; border: 1px solid #bfdbfe; border-radius: 8px; padding: 6px 12px; display: inline-block; font-weight: 900; font-size: 1.05rem;">@grossBeanoReceipts.ToString("C2")</span>
                    </div>
                </div>

                <!-- B. EXPENDITURES -->
                <div class="border-bottom pb-3 mb-3">
                    <div class="fw-bold text-uppercase text-secondary mb-2 small" style="letter-spacing: 0.05em;">B. Expenditures</div>
                    
                    <!-- 1. Tax Paid to MSLC -->
                    <div class="d-flex justify-content-between align-items-center mb-3" style="font-size: 0.85rem;">
                        <span class="text-muted small">1. Tax Paid to M.S.L.C. (5%):</span>
                        <span style="background: #eff6ff; color: #1d4ed8; border: 1px solid #bfdbfe; border-radius: 6px; padding: 2px 8px; display: inline-block; font-weight: 700; font-size: 0.8rem;">@taxPaid.ToString("C2")</span>
                    </div>

                    <!-- 2. Prizes -->
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="text-muted small">2. Prizes (Schedule 3 Total):</span>
                        <span class="fw-bold text-danger"><span style="background: #eff6ff; color: #1d4ed8; border: 1px solid #bfdbfe; border-radius: 6px; padding: 2px 8px; display: inline-block; font-weight: 700; font-size: 0.8rem;">@totalPrizesPaid.ToString("C2")</span></span>
                    </div>

                    <!-- 3-10. Other Expenses Grid -->
                    <div class="p-3 bg-light rounded-4 mb-3 border">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="fw-black text-dark text-uppercase" style="font-size: 0.65rem; letter-spacing: 0.05em;">3–10. Other Expenses</span>
                            <button class="btn btn-sm btn-primary rounded-pill fw-black px-3 py-1" style="font-size: 0.6rem;" @onclick="() => { _beanoOtherExpenses.Add(new BeanoExpense()); StateHasChanged(); }">
                                <i class="bi bi-plus-circle-fill"></i> ADD EXPENSE
                            </button>
                        </div>

                        @if (!_beanoOtherExpenses.Any())
                        {
                            <div class="text-center py-2 text-muted small fw-semibold">No other expenses added yet.</div>
                        }
                        else
                        {
                            <div class="d-flex flex-column gap-2">
                                @for (int i = 0; i < _beanoOtherExpenses.Count; i++)
                                {
                                    var idx = i;
                                    var exp = _beanoOtherExpenses[idx];
                                    <div class="row g-1 align-items-center p-2 rounded bg-white border">
                                        <div class="col-4">
                                            <input type="text" class="form-control form-control-sm small border-0 p-1 bg-light fw-bold" placeholder="Description/Payee" @bind="exp.Payee" />
                                        </div>
                                        <div class="col-3">
                                            <input type="text" class="form-control form-control-sm small border-0 p-1 bg-light fw-bold" placeholder="Reason" @bind="exp.Description" />
                                        </div>
                                        <div class="col-2">
                                            <input type="text" id="input-BeanoExpenseCheck_@idx" class="form-control form-control-sm small border-0 p-1 bg-light fw-bold" placeholder="Ck #" @onclick='() => ActivateField($"BeanoExpenseCheck_{idx}")' @bind="exp.CheckNumber" readonly />
                                        </div>
                                        <div class="col-2">
                                            <input type="number" step="0.01" id="input-BeanoExpenseAmount_@idx" class="form-control form-control-sm small border-0 p-1 bg-light fw-bold text-end" placeholder="Amount" @onclick='() => ActivateField($"BeanoExpenseAmount_{idx}")' @bind="exp.Amount" readonly />
                                        </div>
                                        <div class="col-1 text-center">
                                            <button class="btn btn-link text-danger p-0" @onclick="() => { _beanoOtherExpenses.RemoveAt(idx); StateHasChanged(); }">
                                                <i class="bi bi-trash-fill"></i>
                                            </button>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>

                    <!-- 11. TOTAL BEANO EXPENDITURES -->
                    <div class="d-flex justify-content-between align-items-center mt-3 pt-2 border-top">
                        <span class="fw-black text-dark uppercase" style="font-size: 0.8rem;">11. TOTAL EXPENDITURES:</span>
                        <span style="background: #eff6ff; color: #b91c1c; border: 1px solid #fca5a5; border-radius: 8px; padding: 6px 12px; display: inline-block; font-weight: 900; font-size: 1.05rem;">@totalExpenditures.ToString("C2")</span>
                    </div>
                </div>

                <!-- C. NET PROFIT (OR LOSS) -->
                <div class="p-3 rounded-4 mt-1 text-center d-flex justify-content-between align-items-center" style="background: @(netProfit >= 0 ? "rgba(22, 163, 74, 0.08)" : "rgba(220, 38, 38, 0.08)"); border: 1px solid @(netProfit >= 0 ? "rgba(22, 163, 74, 0.2)" : "rgba(220, 38, 38, 0.2)") !important;">
                     <span class="fw-black text-dark uppercase" style="font-size: 0.8rem;">C. NET PROFIT (OR LOSS):</span>
                     <span style="background: @(netProfit >= 0 ? "#ecfdf5" : "#fef2f2"); color: @(netProfit >= 0 ? "#047857" : "#b91c1c"); border: 1px solid @(netProfit >= 0 ? "#a7f3d0" : "#fca5a5"); border-radius: 8px; padding: 6px 12px; display: inline-block; font-weight: 900; font-size: 1.15rem;">@netProfit.ToString("C2")</span>
                </div>
            </div>

            <!-- SCHEDULE 2: DISPOSITION & ACCOUNTING -->
            <div class="card border border-light-subtle rounded-4 p-3 shadow-sm mb-4" style="background: white;">
                <h6 class="fw-black text-primary text-uppercase mb-3" style="font-size: 0.8rem; letter-spacing: 0.05em;">SCHEDULE 2: DISPOSITION & ACCOUNTING FOR NET PROFITS</h6>
                
                <!-- 1. Unexpended Net Profit (Previous) -->
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <span class="text-muted small">1. Unexpended Net Profit (Previous):</span>
                    <div style="width: 120px;">
                        <input type="number" step="0.01" id="input-BeanoUnexpendedNetProfit" class="form-control form-control-sm fw-bold border text-end" style="background: #eff6ff; color: #1d4ed8;" @onclick='() => ActivateField("BeanoUnexpendedNetProfit")' @bind="_beanoUnexpendedNetProfit" readonly />
                    </div>
                </div>

                <!-- 2. Net Beano Profit (Loss) -->
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <span class="text-muted small">2. Net Beano Profit (Loss):</span>
                    <span style="background: #eff6ff; color: #1d4ed8; border: 1px solid #bfdbfe; border-radius: 6px; padding: 2px 8px; display: inline-block; font-weight: 700; font-size: 0.8rem;">@netProfit.ToString("C2")</span>
                </div>

                <!-- 3. Net Proceeds Charity Tickets -->
                <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
                    <span class="text-muted small">3. Proceeds from Charity Game Tickets:</span>
                    <span style="background: #eff6ff; color: #1d4ed8; border: 1px solid #bfdbfe; border-radius: 6px; padding: 2px 8px; display: inline-block; font-weight: 700; font-size: 0.8rem;">@pullTabNetProceeds.ToString("C2")</span>
                </div>

                <!-- 4. Other Income -->
                <div class="bg-light p-3 rounded-4 mb-3 border">
                    <span class="fw-black text-dark text-uppercase d-block mb-2" style="font-size: 0.65rem; letter-spacing: 0.05em;">4. Other Income</span>
                    <div class="row g-2">
                        <div class="col-4">
                            <label class="form-label fw-bold text-muted extra-small mb-0">4a. Interest ($)</label>
                            <input type="number" step="0.01" id="input-BeanoInterest" class="form-control form-control-sm fw-bold border" @onclick='() => ActivateField("BeanoInterest")' @bind="_beanoInterest" readonly />
                        </div>
                        <div class="col-4">
                            <label class="form-label fw-bold text-muted extra-small mb-0">4b. Game Bank ($)</label>
                            <input type="number" step="0.01" id="input-BeanoGameBank" class="form-control form-control-sm fw-bold border" @onclick='() => ActivateField("BeanoGameBank")' @bind="_beanoGameBank" readonly />
                        </div>
                        <div class="col-4">
                            <label class="form-label fw-bold text-muted extra-small mb-0">4c. Others ($)</label>
                            <input type="number" step="0.01" id="input-BeanoOthers" class="form-control form-control-sm fw-bold border" @onclick='() => ActivateField("BeanoOthers")' @bind="_beanoOthers" readonly />
                        </div>
                    </div>
                </div>

                <!-- 5. TOTAL FUNDS AVAILABLE -->
                <div class="d-flex justify-content-between align-items-center pb-3 mb-3 border-bottom">
                    <span class="fw-black text-dark uppercase" style="font-size: 0.8rem;">5. TOTAL FUNDS AVAILABLE FOR DISBURSEMENT:</span>
                    <span style="background: #eff6ff; color: #1d4ed8; border: 1px solid #bfdbfe; border-radius: 8px; padding: 6px 12px; display: inline-block; font-weight: 900; font-size: 1.05rem;">@totalFundsAvailable.ToString("C2")</span>
                </div>

                <!-- DISBURSEMENTS GRID -->
                <div class="p-3 bg-light rounded-4 mb-3 border">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="fw-black text-dark text-uppercase" style="font-size: 0.65rem; letter-spacing: 0.05em;">Disbursements</span>
                        <button class="btn btn-sm btn-primary rounded-pill fw-black px-3 py-1" style="font-size: 0.6rem;" @onclick="() => { _beanoDisbursements.Add(new BeanoDisbursement { Date = DateTime.Today }); StateHasChanged(); }">
                            <i class="bi bi-plus-circle-fill"></i> ADD DISBURSEMENT
                        </button>
                    </div>

                    @if (!_beanoDisbursements.Any())
                    {
                        <div class="text-center py-2 text-muted small fw-semibold">No disbursements added yet.</div>
                    }
                    else
                    {
                        <div class="d-flex flex-column gap-2">
                            @for (int i = 0; i < _beanoDisbursements.Count; i++)
                            {
                                var idx = i;
                                var disb = _beanoDisbursements[idx];
                                <div class="row g-1 align-items-center p-2 rounded bg-white border" style="font-size: 0.75rem;">
                                    <div class="col-3">
                                        <input type="date" class="form-control form-control-sm border-0 p-0.5 bg-light fw-bold" style="font-size: 0.7rem;" value="@disb.Date.ToString("yyyy-MM-dd")" @onchange="(e) => { if (DateTime.TryParse(e.Value?.ToString(), out var dt)) disb.Date = dt; }" />
                                    </div>
                                    <div class="col-3">
                                        <input type="text" class="form-control form-control-sm border-0 p-0.5 bg-light fw-bold" style="font-size: 0.7rem;" placeholder="Payee/Reason" @bind="disb.Payee" />
                                    </div>
                                    <div class="col-2">
                                        <input type="text" id="input-BeanoDisbursementCheck_@idx" class="form-control form-control-sm border-0 p-0.5 bg-light fw-bold" style="font-size: 0.7rem;" placeholder="Ck #" @onclick='() => ActivateField($"BeanoDisbursementCheck_{idx}")' @bind="disb.CheckNumber" readonly />
                                    </div>
                                    <div class="col-3">
                                        <input type="number" step="0.01" id="input-BeanoDisbursementAmount_@idx" class="form-control form-control-sm border-0 p-0.5 bg-light fw-bold text-end" style="font-size: 0.7rem;" placeholder="Amount" @onclick='() => ActivateField($"BeanoDisbursementAmount_{idx}")' @bind="disb.Amount" readonly />
                                    </div>
                                    <div class="col-1 text-center">
                                        <button class="btn btn-link text-danger p-0" @onclick="() => { _beanoDisbursements.RemoveAt(idx); StateHasChanged(); }">
                                            <i class="bi bi-trash-fill"></i>
                                        </button>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>

                <!-- 6. TOTAL DISBURSEMENTS -->
                <div class="d-flex justify-content-between align-items-center pb-3 mb-3 border-bottom">
                    <span class="fw-black text-dark uppercase" style="font-size: 0.8rem;">6. TOTAL DISBURSEMENTS FROM ABOVE:</span>
                    <span style="background: #fef2f2; color: #b91c1c; border: 1px solid #fca5a5; border-radius: 8px; padding: 6px 12px; display: inline-block; font-weight: 900; font-size: 1.05rem;">@totalDisbursements.ToString("C2")</span>
                </div>

                <!-- 7. UNEXPENDED NET PROFIT -->
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <span class="fw-black text-dark uppercase" style="font-size: 0.8rem;">7. UNEXPENDED NET PROFIT:</span>
                    <span style="background: @(finalUnexpended >= 0 ? "#ecfdf5" : "#fef2f2"); color: @(finalUnexpended >= 0 ? "#047857" : "#b91c1c"); border: 1px solid @(finalUnexpended >= 0 ? "#a7f3d0" : "#fca5a5"); border-radius: 8px; padding: 6px 12px; display: inline-block; font-weight: 900; font-size: 1.05rem;">@finalUnexpended.ToString("C2")</span>
                </div>

                <!-- 7a, 7b, 7c Breakdown -->
                <div class="p-3 bg-light rounded-4 border">
                    <span class="fw-black text-dark text-uppercase d-block mb-2" style="font-size: 0.65rem; letter-spacing: 0.05em;">Breakdown of Balances</span>
                    <div class="row g-2">
                        <div class="col-4">
                            <label class="form-label fw-bold text-muted extra-small mb-0">7a. Checkbook ($)</label>
                            <input type="number" step="0.01" id="input-BeanoCheckbookBalance" class="form-control form-control-sm fw-bold border" @onclick='() => ActivateField("BeanoCheckbookBalance")' @bind="_beanoCheckbookBalance" readonly />
                        </div>
                        <div class="col-4">
                            <label class="form-label fw-bold text-muted extra-small mb-0">7b. Savings ($)</label>
                            <input type="number" step="0.01" id="input-BeanoSavingsBalance" class="form-control form-control-sm fw-bold border" @onclick='() => ActivateField("BeanoSavingsBalance")' @bind="_beanoSavingsBalance" readonly />
                        </div>
                        <div class="col-4">
                            <label class="form-label fw-bold text-muted extra-small mb-0">7c. CD ($)</label>
                            <input type="number" step="0.01" id="input-BeanoCdBalance" class="form-control form-control-sm fw-bold border" @onclick='() => ActivateField("BeanoCdBalance")' @bind="_beanoCdBalance" readonly />
                        </div>
                    </div>

                    @if (breakdownDiff)
                    {
                        <div class="alert alert-warning py-1 px-2 mb-0 mt-3 rounded shadow-sm text-center fw-bold small animate-pulse">
                            <i class="bi bi-exclamation-triangle-fill me-1"></i> Balance warning: Sum of 7a, 7b, 7c (@breakdownSum.ToString("C2")) does not match Line 7 (@finalUnexpended.ToString("C2")).
                        </div>
                    }
                </div>

                <!-- Total Deposit for this Occasion -->
                @{
                    decimal totalDeposit = grossBeanoReceipts + pullTabNetProceeds - totalPrizesPaid;
                }
                <div class="d-flex justify-content-between align-items-center mt-3 pt-3 border-top">
                    <span class="fw-black text-dark uppercase" style="font-size: 0.8rem;">TOTAL DEPOSIT FOR THIS OCCASION:</span>
                    <span style="background: #eff6ff; color: #1d4ed8; border: 1px solid #bfdbfe; border-radius: 8px; padding: 6px 12px; display: inline-block; font-weight: 900; font-size: 1.05rem;">@totalDeposit.ToString("C2")</span>
                </div>
            </div>

            <!-- SCHEDULE 3: SUMMARY OF BEANO PRIZES -->
            <div class="card border border-light-subtle rounded-4 p-3 shadow-sm mb-4" style="background: white;">
                <h6 class="fw-black text-primary text-uppercase mb-3" style="font-size: 0.8rem; letter-spacing: 0.05em;">SCHEDULE 3: SUMMARY OF BEANO PRIZES</h6>
                
                <!-- Special Games Prizes -->
                @{
                    var wtaSheetObj = Sheets.FirstOrDefault(s => s.ColorName == _wtaColor);
                    var progSheetObj = Sheets.FirstOrDefault(s => s.ColorName == _progColor);

                    decimal wtaPrizes = wtaSheetObj?.Games.Sum(g => CalculateGamePayout(wtaSheetObj, g)) ?? 0;
                    decimal progPrizes = progSheetObj?.Games.Sum(g => CalculateGamePayout(progSheetObj, g)) ?? 0;
                }
                <div class="d-flex justify-content-between align-items-center mb-2" style="font-size: 0.85rem;">
                    <span class="text-muted">Prize Distribution WTA (@(wtaSheetObj?.ColorName ?? "Unmapped")):</span>
                    <span style="background: #eff6ff; color: #1d4ed8; border: 1px solid #bfdbfe; border-radius: 6px; padding: 2px 8px; display: inline-block; font-weight: 700; font-size: 0.8rem;">@wtaPrizes.ToString("C2")</span>
                </div>
                <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom" style="font-size: 0.85rem;">
                    <span class="text-muted">Prize Distribution Progressive (@(progSheetObj?.ColorName ?? "Unmapped")):</span>
                    <span style="background: #eff6ff; color: #1d4ed8; border: 1px solid #bfdbfe; border-radius: 6px; padding: 2px 8px; display: inline-block; font-weight: 700; font-size: 0.8rem;">@progPrizes.ToString("C2")</span>
                </div>

                <!-- PROGRESSIVE GAMES AND LEDGER -->
                @{
                    var progGame = progSheetObj?.Games.FirstOrDefault(g => g.IsProgressive);
                    bool isProgressiveActive = progSheetObj != null && progSheetObj.Sold > 0 && progGame != null && progGame.BallsCalled > 0;
                    string callsDisplay = isProgressiveActive && progGame != null ? progGame.BallsCalled.ToString() : "";
                    string amountDisplay = isProgressiveActive && progGame != null ? CalculateGamePayout(progSheetObj, progGame).ToString("C2") : "";
                    
                    decimal progGross = progSheetObj != null ? (progSheetObj.Sold * progSheetObj.Price) : 0m;
                    decimal deductTax = progGross * 0.05m;
                    decimal prizesPaid = progSheetObj?.Games.Sum(g => CalculateGamePayoutRawShare(progSheetObj, g) * g.WinnerCount) ?? 0;
                    decimal profitToLicensee = _beanoProgBeginningBalance + progGross - deductTax - prizesPaid;
                    decimal carryoverAmount = profitToLicensee;
                }
                <div class="mb-4 p-3 bg-light rounded-4 border border-light-subtle">
                    <div class="fw-bold text-uppercase text-secondary mb-2 small" style="letter-spacing: 0.05em; font-size: 0.7rem;">Progressive Game Status</div>
                    <table class="table table-sm table-bordered text-center mb-3 bg-white" style="font-size: 0.8rem; border-radius: 8px; overflow: hidden; border: 1px solid rgba(0,0,0,0.08);">
                        <thead class="table-light">
                            <tr class="text-uppercase text-muted" style="font-size: 0.65rem;">
                                <th># Of Calls</th>
                                <th>$ Amount</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td class="fw-black text-dark">@callsDisplay</td>
                                <td class="fw-black text-primary">@amountDisplay</td>
                            </tr>
                        </tbody>
                    </table>

                    <div class="fw-bold text-uppercase text-secondary mb-2 small" style="letter-spacing: 0.05em; font-size: 0.7rem;">Progressive Ledger</div>
                    <table class="table table-sm table-borderless align-middle mb-0" style="font-size: 0.8rem; vertical-align: middle;">
                        <tbody>
                            <tr>
                                <td class="text-muted">Beginning Balance ($):</td>
                                <td class="text-end" style="width: 130px;">
                                    <input type="number" step="0.01" id="input-BeanoProgBeginningBalance" 
                                           class="form-control form-control-sm fw-bold border text-end @(_activeField == "BeanoProgBeginningBalance" ? "border-primary bg-white" : "bg-white")" 
                                           style="font-size: 0.8rem; height: 30px;"
                                           @onclick='() => ActivateField("BeanoProgBeginningBalance")' 
                                           @bind="_beanoProgBeginningBalance" readonly />
                                </td>
                            </tr>
                            <tr>
                                <td class="text-muted">Gr. Receipts - Sch. 1:</td>
                                <td class="text-end fw-bold text-dark">@progGross.ToString("C2")</td>
                            </tr>
                            <tr>
                                <td class="text-muted">Deduct: 5% Tax:</td>
                                <td class="text-end fw-bold text-danger">-@deductTax.ToString("C2")</td>
                            </tr>
                            <tr>
                                <td class="text-muted">Prizes Paid:</td>
                                <td class="text-end fw-bold text-danger">-@prizesPaid.ToString("C2")</td>
                            </tr>
                            <tr class="border-top" style="border-top: 1px dashed rgba(0,0,0,0.12) !important;">
                                <td class="fw-bold text-dark">Profit to Licensee:</td>
                                <td class="text-end fw-black @(profitToLicensee >= 0 ? "text-success" : "text-danger")">@profitToLicensee.ToString("C2")</td>
                            </tr>
                            <tr>
                                <td class="fw-bold text-dark">Carryover Amount:</td>
                                <td class="text-end fw-black @(carryoverAmount >= 0 ? "text-primary" : "text-danger")">@carryoverAmount.ToString("C2")</td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <!-- Standard Games Prizes Grouped by Base Payout (Option A) -->
                <div class="fw-bold text-uppercase text-secondary mb-2 small mt-3" style="letter-spacing: 0.05em; font-size: 0.7rem;">Standard Games Prizes</div>
                @{
                    var standardSheets = Sheets.Where(s => 
                        s.ColorName != _wtaColor && 
                        s.ColorName != _progColor);
                    
                    var standardGamesGrouped = standardSheets
                        .SelectMany(s => s.Games.Select(g => {
                            var rawShare = CalculateGamePayoutRawShare(s, g);
                            var rawTotal = rawShare * g.WinnerCount;
                            var finalTotal = CalculateGamePayout(s, g);
                            var breakage = CalculateGameTotalBreakage(s, g);
                            return new { 
                                SheetColor = s.ColorName,
                                Game = g, 
                                RawShare = rawShare,
                                RawTotal = rawTotal,
                                Breakage = breakage,
                                Payout = finalTotal
                            };
                        }))
                        .Where(x => x.Payout > 0 || x.RawTotal > 0)
                        .GroupBy(x => x.RawShare)
                        .OrderBy(g => g.Key)
                        .ToList();

                    decimal standardBaseTotal = 0;
                }
                @if (standardGamesGrouped.Any())
                {
                    @foreach (var g in standardGamesGrouped)
                    {
                        var count = g.Count();
                        var baseShare = g.Key;
                        var totalBase = g.Sum(x => x.RawTotal);
                        var totalBreakage = g.Sum(x => x.Breakage);
                        standardBaseTotal += totalBase;
                        
                        var gameType = count == 1 ? (g.First().Game.PayoutMode == 1 ? "50/50" : (g.First().Game.PayoutMode == 2 ? "Additive" : "Fixed")) : "";
                        var desc = count == 1 
                            ? $"1 game @ {baseShare.ToString("C2")} ({gameType}, {g.First().SheetColor})"
                            : $"{count} game(s) @ {baseShare.ToString("C2")}";

                        <div class="d-flex justify-content-between align-items-center mb-2" style="font-size: 0.85rem;">
                            <div class="d-flex align-items-center gap-2">
                                <span class="text-muted">@desc:</span>
                                @if (totalBreakage != 0)
                                {
                                    <span style="color: #b45309; background: #fffbeb; border: 1px solid #fde68a; font-weight: 800; font-size: 0.68rem; padding: 1px 6px; border-radius: 4px;">
                                        @(totalBreakage > 0 ? "+" : "")@totalBreakage.ToString("C2") Breakage
                                    </span>
                                }
                            </div>
                            <span style="background: #eff6ff; color: #1d4ed8; border: 1px solid #bfdbfe; border-radius: 6px; padding: 2px 8px; display: inline-block; font-weight: 700; font-size: 0.8rem;">@totalBase.ToString("C2")</span>
                        </div>
                    }
                }
                else
                {
                    <div class="text-muted small mb-2" style="font-size: 0.85rem;">No standard game payouts recorded.</div>
                }

                <!-- Cash Door Prizes -->
                @{
                    decimal doorPrizesTotal = _doorPrizeAmount * _doorPrizeCount;
                    
                    // Calculate base (raw) prizes for specials as well to guarantee perfect mathematical balancing
                    decimal wtaBase = wtaSheetObj?.Games.Sum(g => CalculateGamePayoutRawShare(wtaSheetObj, g) * g.WinnerCount) ?? 0;
                    decimal progBase = progSheetObj?.Games.Sum(g => CalculateGamePayoutRawShare(progSheetObj, g) * g.WinnerCount) ?? 0;
                    
                    decimal totalBasePrizesCombined = wtaBase + progBase + standardBaseTotal + doorPrizesTotal;
                }
                <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom" style="font-size: 0.85rem;">
                    <span class="text-muted">Total Cash Door Prizes (@_doorPrizeCount games):</span>
                    <span style="background: #eff6ff; color: #1d4ed8; border: 1px solid #bfdbfe; border-radius: 6px; padding: 2px 8px; display: inline-block; font-weight: 700; font-size: 0.8rem;">@doorPrizesTotal.ToString("C2")</span>
                </div>

                <!-- Total Base Prizes -->
                <div class="d-flex justify-content-between align-items-center mb-2" style="font-size: 0.85rem;">
                    <span class="fw-bold text-dark">Total Base Prizes:</span>
                    <span style="background: #f1f5f9; color: #334155; border: 1px solid #cbd5e1; border-radius: 6px; padding: 2px 8px; display: inline-block; font-weight: 700; font-size: 0.8rem;">@totalBasePrizesCombined.ToString("C2")</span>
                </div>

                <!-- Payout Breakage -->
                <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom" style="font-size: 0.85rem;">
                    <span class="text-muted">Payout Breakage:</span>
                    <span style="background: #eff6ff; color: #b45309; border: 1px solid #fde68a; border-radius: 6px; padding: 2px 8px; display: inline-block; font-weight: 700; font-size: 0.8rem;">@TotalSessionBreakage.ToString("C2")</span>
                </div>

                <!-- Grand Total Prizes -->
                <div class="d-flex justify-content-between align-items-center">
                    <span class="fw-black text-dark uppercase" style="font-size: 0.8rem;">GRAND TOTAL CASH PRIZES:</span>
                    <span style="background: #fef2f2; color: #b91c1c; border: 1px solid #fca5a5; border-radius: 8px; padding: 6px 12px; display: inline-block; font-weight: 900; font-size: 1.05rem;">@totalPrizesPaid.ToString("C2")</span>
                </div>
            </div>

        </div>
        <div class="detail-footer p-4 border-top bg-light d-flex gap-2" style="border-bottom-left-radius: 16px; border-bottom-right-radius: 16px;">
            <button class="btn btn-primary flex-grow-1 py-3 rounded-pill fw-black shadow text-uppercase" style="font-size: 0.85rem; letter-spacing: 0.05em;" @onclick="async () => { await SaveDraftAsync(); _showBeanoReportModal = false; }">
                SAVE & CLOSE REPORT
            </button>
        </div>
    </div>
}

<!-- ADD/EDIT PULL TAB MODAL -->
@if (_showPullTabModal)
{
    <div class="admission-modal-overlay @(_showFloatingKeypad ? "keypad-open" : "")" @onclick="ClosePullTabModal">
        <div class="admission-modal-content shadow-lg" style="max-width: 550px;" @onclick:stopPropagation>
             <div class="modal-header-compact">
                <h5 class="fw-black mb-0">@(_sessionState == "Closed" ? "VIEW PULL TAB GAME" : (_isEditMode ? "EDIT PULL TAB GAME" : "ADD PULL TAB GAME"))</h5>
                <button class="btn-close-compact" @onclick="ClosePullTabModal">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
            
            <div class="modal-body-compact p-3">
                @if (!string.IsNullOrEmpty(_pullTabValidationError))
                {
                    <div class="alert alert-danger py-2 px-3 mb-2 rounded-3 fw-bold small text-center shadow-sm">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>@_pullTabValidationError
                    </div>
                }
                <div class="row g-2">
                    <!-- Game Selection -->
                    <div class="col-6">
                        <label class="form-label fw-bold text-uppercase text-muted mb-1" style="font-size: 0.6rem;">Game Type</label>
                        <select class="form-select fw-black text-primary border" style="height: 40px; border-radius: 10px; font-size: 0.8rem; padding: 4px 8px;"
                                value="@_editingPullTab.GameDefinitionId" @onchange="OnPullTabGameChanged" disabled="@(_sessionState == "Closed")">
                            <option value="0">-- SELECT GAME --</option>
                            @foreach (var def in _pullTabDefinitions)
                            {
                                <option value="@def.Id">@def.GameName (@def.TicketPrice.ToString("C2") / ticket)</option>
                            }
                        </select>
                    </div>

                    <!-- Seller Name (Combobox using datalist) -->
                    <div class="col-6">
                        <label class="form-label fw-bold text-uppercase text-muted mb-1" style="font-size: 0.6rem;">Seller Name</label>
                        <input type="text" class="form-control fw-black text-dark border" style="height: 40px; border-radius: 10px; font-size: 0.8rem; padding: 8px;"
                               list="seller-names-list" placeholder="Enter name..."
                               @bind="_editingPullTab.SellerName" disabled="@(_sessionState == "Closed")" />
                        <datalist id="seller-names-list">
                            @foreach (var name in _previousSellers)
                            {
                                <option value="@name" />
                            }
                        </datalist>
                    </div>

                    <!-- Serial Number -->
                    <div class="col-6">
                        <label class="form-label fw-bold text-uppercase text-muted mb-1" style="font-size: 0.6rem;">Serial Number</label>
                        <input type="text" class="form-control fw-black text-dark border" style="height: 40px; border-radius: 10px; font-size: 0.8rem; padding: 8px;"
                               @bind="_editingPullTab.SerialNumber" placeholder="e.g. SN12345" disabled="@(_sessionState == "Closed")" />
                    </div>

                    <!-- Starting Bank -->
                    <div class="col-6">
                        <label class="form-label fw-bold text-uppercase text-muted mb-1" style="font-size: 0.6rem;">Starting Bank ($)</label>
                        <div class="form-control fw-black text-dark border d-flex align-items-center justify-content-between @(_activeField == "PullTab_StartingBank" ? "border-primary bg-light" : "")" 
                             style="height: 40px; border-radius: 10px; cursor: pointer; padding: 8px; font-size: 0.85rem;"
                             @onclick='() => { if (_sessionState != "Closed") ActivateField("PullTab_StartingBank"); }'>
                             <span>
                                 @if (_activeField == "PullTab_StartingBank")
                                 {
                                     @_currentBuffer
                                     <span class="cursor-blink">|</span>
                                 }
                                 else
                                 {
                                     @_editingPullTab.StartingBank.ToString("C2")
                                 }
                             </span>
                             @if (_activeField == "PullTab_StartingBank" && _sessionState != "Closed")
                             {
                                 <i class="bi bi-calculator text-primary small"></i>
                             }
                        </div>
                    </div>

                    <!-- Tickets Issued -->
                    <div class="col-6">
                        <label class="form-label fw-bold text-uppercase text-muted mb-1" style="font-size: 0.6rem;">Tickets Issued</label>
                        <div class="form-control fw-black text-dark border d-flex align-items-center justify-content-between @(_activeField == "PullTab_TicketsIssued" ? "border-primary bg-light" : "")" 
                             style="height: 40px; border-radius: 10px; cursor: pointer; padding: 8px; font-size: 0.85rem;"
                             @onclick='() => { if (_sessionState != "Closed") ActivateField("PullTab_TicketsIssued"); }'>
                             <span>
                                 @if (_activeField == "PullTab_TicketsIssued")
                                 {
                                     @_currentBuffer
                                     <span class="cursor-blink">|</span>
                                 }
                                 else
                                 {
                                     @_editingPullTab.TicketsIssued.ToString("N0")
                                 }
                             </span>
                             @if (_activeField == "PullTab_TicketsIssued" && _sessionState != "Closed")
                             {
                                 <i class="bi bi-calculator text-primary small"></i>
                             }
                        </div>
                    </div>

                    <!-- Tickets Returned -->
                    <div class="col-6">
                        <label class="form-label fw-bold text-uppercase text-muted mb-1" style="font-size: 0.6rem;">Tickets Returned</label>
                        <div class="form-control fw-black text-dark border d-flex align-items-center justify-content-between @(_activeField == "PullTab_TicketsReturned" ? "border-primary bg-light" : "")" 
                             style="height: 40px; border-radius: 10px; cursor: pointer; padding: 8px; font-size: 0.85rem;"
                             @onclick='() => { if (_sessionState != "Closed") ActivateField("PullTab_TicketsReturned"); }'>
                             <span>
                                 @if (_activeField == "PullTab_TicketsReturned")
                                 {
                                     @_currentBuffer
                                     <span class="cursor-blink">|</span>
                                 }
                                 else
                                 {
                                     @_editingPullTab.TicketsReturned.ToString("N0")
                                 }
                             </span>
                             @if (_activeField == "PullTab_TicketsReturned" && _sessionState != "Closed")
                             {
                                 <i class="bi bi-calculator text-primary small"></i>
                             }
                        </div>
                    </div>

                    <!-- Winner Option Dropdown -->
                    <div class="col-12">
                        <label class="form-label fw-bold text-uppercase text-muted mb-1" style="font-size: 0.6rem;">Winner Option (Prize)</label>
                        <select class="form-select fw-black text-primary border" style="height: 40px; border-radius: 10px; font-size: 0.8rem; padding: 4px 8px;"
                                value="@_editingPullTab.SelectedPrizeOptionId" @onchange="OnPullTabPrizeChanged" disabled="@(_sessionState == "Closed")">
                            <option value="">-- SELECT PRIZE --</option>
                            @foreach (var opt in _activePrizeOptions)
                            {
                                <option value="@opt.Id">@opt.OptionLabel (@opt.PayoutAmount.ToString("C2"))</option>
                            }
                        </select>
                    </div>

                    <!-- Prizes Paid (Override) -->
                    <div class="col-6">
                        <label class="form-label fw-bold text-uppercase text-muted mb-1" style="font-size: 0.6rem;">Prizes Paid ($)</label>
                        <div class="form-control fw-black text-danger border d-flex align-items-center justify-content-between @(_activeField == "PullTab_PrizesPaid" ? "border-primary bg-light" : "")" 
                             style="height: 40px; border-radius: 10px; cursor: pointer; padding: 8px; font-size: 0.85rem;"
                             @onclick='() => { if (_sessionState != "Closed") ActivateField("PullTab_PrizesPaid"); }'>
                            <span>
                                @if (_activeField == "PullTab_PrizesPaid")
                                {
                                    @_currentBuffer
                                    <span class="cursor-blink">|</span>
                                }
                                else
                                {
                                    @_editingPullTab.PrizesPaid.ToString("C2")
                                }
                            </span>
                            @if (_activeField == "PullTab_PrizesPaid" && _sessionState != "Closed")
                            {
                                <i class="bi bi-calculator text-primary small"></i>
                            }
                        </div>
                    </div>

                    @if (_activeMinorCount > 0)
                    {
                        <div class="col-12 mt-1">
                            <div class="p-2 bg-light rounded-4 border border-light shadow-sm">
                                <h6 class="fw-black text-muted text-uppercase mb-1" style="font-size: 0.55rem; letter-spacing: 0.05em;">Prize Payout Breakdown</h6>
                                
                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="fw-bold text-dark" style="font-size: 0.75rem;">
                                        Small Winners (@_activeMinorAmt.ToString("C2") ea) Paid:
                                    </span>
                                    <div class="d-flex align-items-center gap-2">
                                        <button class="btn btn-outline-secondary rounded-circle fw-black d-flex align-items-center justify-content-center border-2" 
                                                style="width: 28px; height: 28px; font-size: 1rem; padding: 0; line-height: 1;" 
                                                @onclick="DecrementMinorPrizes" disabled="@(_minorPrizesPaidCount <= 0 || _sessionState == "Closed")" @onclick:preventDefault="true">-</button>
                                        <span class="fw-black text-dark px-1" style="font-size: 0.95rem; min-width: 20px; text-align: center;">@_minorPrizesPaidCount</span>
                                        <button class="btn btn-outline-secondary rounded-circle fw-black d-flex align-items-center justify-content-center border-2" 
                                                style="width: 28px; height: 28px; font-size: 1rem; padding: 0; line-height: 1;" 
                                                @onclick="IncrementMinorPrizes" disabled="@(_minorPrizesPaidCount >= _activeMinorCount || _sessionState == "Closed")" @onclick:preventDefault="true">+</button>
                                        <span class="text-muted fw-bold extra-small">/ @_activeMinorCount</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }

                    <!-- Cash Received -->
                    <div class="col-6">
                        <label class="form-label fw-bold text-uppercase text-muted mb-1" style="font-size: 0.6rem;">Cash Received ($)</label>
                        <div class="form-control fw-black text-success border d-flex align-items-center justify-content-between @(_activeField == "PullTab_CashReceived" ? "border-primary bg-light" : "")" 
                             style="height: 40px; border-radius: 10px; cursor: pointer; padding: 8px; font-size: 1rem;"
                             @onclick='() => { if (_sessionState != "Closed") ActivateField("PullTab_CashReceived"); }'>
                            <span>
                                @if (_activeField == "PullTab_CashReceived")
                                {
                                    @_currentBuffer
                                    <span class="cursor-blink">|</span>
                                }
                                else
                                {
                                    @_editingPullTab.CashReceived.ToString("C2")
                                }
                            </span>
                            @if (_activeField == "PullTab_CashReceived" && _sessionState != "Closed")
                            {
                                <i class="bi bi-calculator text-success small"></i>
                            }
                        </div>
                    </div>

                    <!-- Math Preview Card -->
                    <div class="col-12">
                        <div class="p-2 bg-light rounded-4 border border-light">
                            <h6 class="fw-black text-muted text-uppercase mb-1" style="font-size: 0.55rem; letter-spacing: 0.05em;">Calculations Preview</h6>
                            <div class="d-flex justify-content-between mb-0.5" style="font-size: 0.7rem;">
                                <span class="text-muted fw-bold">Tickets Sold:</span>
                                <span class="fw-black text-dark">@GetTicketsSold(_editingPullTab)</span>
                            </div>
                            <div class="d-flex justify-content-between mb-0.5" style="font-size: 0.7rem;">
                                <span class="text-muted fw-bold">Gross Receipts:</span>
                                <span class="fw-black text-dark">@GetGrossReceipts(_editingPullTab).ToString("C2")</span>
                            </div>
                            <div class="d-flex justify-content-between mb-0.5" style="font-size: 0.7rem;">
                                <span class="text-muted fw-bold">Club Profit:</span>
                                <span class="fw-black text-success">@GetNetCashDue(_editingPullTab).ToString("C2")</span>
                            </div>
                            <div class="d-flex justify-content-between" style="font-size: 0.7rem;">
                                <span class="text-muted fw-bold">Over/Short:</span>
                                <span class="fw-black @(GetOverShort(_editingPullTab) < 0 ? "text-danger" : "text-success")">@GetOverShort(_editingPullTab).ToString("C2")</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="modal-footer-compact p-3 bg-light rounded-bottom-4 d-flex gap-2">
                @if (_sessionState == "Closed")
                {
                    <button class="btn btn-dark w-100 rounded-pill fw-black py-3 shadow" @onclick="ClosePullTabModal">
                        CLOSE
                    </button>
                }
                else
                {
                    <button class="btn btn-secondary rounded-pill fw-black py-3 px-4" @onclick="ClosePullTabModal">
                        CANCEL
                    </button>
                    <button class="btn btn-primary flex-grow-1 rounded-pill fw-black py-3 shadow" @onclick="SavePullTabEntry">
                        SAVE GAME ENTRY
                    </button>
                }
            </div>
        </div>
    </div>
}

@code {
    private List<PullTabGameDefinition> _pullTabDefinitions = new();
    private List<PullTabGameEntry> _pullTabEntries = new();
    private List<string> _previousSellers = new();
    private bool _showPullTabModal = false;
    private bool _isEditMode = false;
    private PullTabGameEntry _editingPullTab = new();
    private List<PullTabPrizeOption> _activePrizeOptions = new();
    private string _pullTabValidationError = "";

    private int GetTicketsSold(PullTabGameEntry entry) => entry.TicketsIssued - entry.TicketsReturned;
    private decimal GetGrossReceipts(PullTabGameEntry entry)
    {
        var def = _pullTabDefinitions.FirstOrDefault(d => d.Id == entry.GameDefinitionId);
        return GetTicketsSold(entry) * (def?.TicketPrice ?? 0);
    }
    private decimal GetExpectedPrize(PullTabGameEntry entry)
    {
        if (entry.SelectedPrizeOptionId == null) return 0;
        var def = _pullTabDefinitions.FirstOrDefault(d => d.Id == entry.GameDefinitionId);
        var opt = def?.PrizeOptions?.FirstOrDefault(o => o.Id == entry.SelectedPrizeOptionId);
        return opt?.PayoutAmount ?? 0;
    }
    private decimal GetExpectedEnvelopeCash(PullTabGameEntry entry)
    {
        var gross = GetGrossReceipts(entry);
        var expectedPrize = GetExpectedPrize(entry);
        bool paidFromDrawer = entry.CashReceived < (gross - (expectedPrize / 2));
        return paidFromDrawer ? (gross - expectedPrize) : gross;
    }
    private decimal GetNetCashDue(PullTabGameEntry entry)
    {
        var gross = GetGrossReceipts(entry);
        var expectedPrize = GetExpectedPrize(entry);
        var overShort = GetOverShort(entry);
        return (gross - expectedPrize) + overShort;
    }
    private decimal GetOverShort(PullTabGameEntry entry)
    {
        var gross = GetGrossReceipts(entry);
        var expectedPrize = GetExpectedPrize(entry);
        bool paidFromDrawer = entry.CashReceived < (gross - (expectedPrize / 2));
        if (paidFromDrawer)
        {
            return (entry.CashReceived - entry.StartingBank) - (gross - expectedPrize);
        }
        else
        {
            return (entry.CashReceived - entry.StartingBank) - gross + (expectedPrize - entry.PrizesPaid);
        }
    }

    private decimal TotalPullTabSales => _pullTabEntries.Sum(GetGrossReceipts);
    private decimal TotalPullTabPrizes => _pullTabEntries.Sum(e => e.PrizesPaid);
    private decimal TotalPullTabNet => _pullTabEntries.Sum(GetNetCashDue);
    private decimal TotalPullTabOverShort => _pullTabEntries.Sum(GetOverShort);

