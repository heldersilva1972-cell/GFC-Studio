    }

    .entry-val {
        font-weight: 900;
        font-size: 1.4rem;
        min-width: 60px;
        text-align: center;
        border-radius: 12px;
        padding: 6px 12px;
        border: 2px solid transparent;
        background: #f1f5f9;
