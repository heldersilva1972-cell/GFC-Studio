        border: 3px solid #e2e8f0;
        color: #1e293b;
    }

    .entry-val-large.focused {
        border-color: var(--bs-primary);
        color: var(--bs-primary);
        box-shadow: 0 8px 20px rgba(13, 110, 253, 0.15);
    }

    .entry-val-large.focused-success {
        border-color: var(--bs-success);
        color: var(--bs-success);
        box-shadow: 0 8px 20px rgba(25, 135, 84, 0.15);
    }

    .bg-success-subtle { background-color: rgba(25, 135, 84, 0.08) !important; }

    .tile-stat-multi {
        display: flex;
        background: #f8fafc;
        border-radius: 16px;
        overflow: hidden;
        border: 1px solid rgba(0,0,0,0.05);
    }

    .stat-main {
        flex: 1.2;
        padding: 8px 12px;
        background: white;
        border-right: 1px solid #f1f5f9;
        transition: all 0.2s;
    }

    .stat-main.focused {
        background: #eff6ff;
        border: 2px solid #3b82f6;
    }

    .stat-main label {
        display: block;
        font-size: 0.5rem;
        font-weight: 900;
        color: #94a3b8;
        margin-bottom: 2px;
    }

    .stat-main .val {
        font-size: 1.4rem;
        font-weight: 950;
        color: #1e293b;
        display: flex;
        align-items: center;
