        border-radius: 20px;
        padding: 10px 15px;
        display: flex;
        align-items: center;
        gap: 15px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.05);
        cursor: pointer;
        transition: transform 0.2s;
        border: 1px solid rgba(13, 110, 253, 0.1);
        height: auto;
        min-height: 70px;
    }

    .floor-sales-summary-bar:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(0,0,0,0.08);
    }

    .pack-badge.floor {
        border-color: rgba(25, 135, 84, 0.2);
    }

    .pack-badge.floor.has-data {
        border-color: #198754;
        box-shadow: 0 4px 10px rgba(25, 135, 84, 0.1);
    }

    .pack-badge.floor.has-data .pack-val {
