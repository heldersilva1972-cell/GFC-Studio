    }

    .footer-stat .label {
        display: block;
        font-size: 0.5rem;
        font-weight: 800;
        color: #94a3b8;
    }

    .footer-stat .value {
        font-weight: 900;
        font-size: 0.75rem;
    }

    .section-divider {
        display: flex;
        align-items: center;
        gap: 10px;
        color: #94a3b8;
        font-size: 0.6rem;
        font-weight: 900;
        letter-spacing: 0.1em;
    }

    .section-divider::after {
        background: rgba(0,0,0,0.05);
    }

    .admissions-expanded-list {
        display: flex;
        flex-direction: column;
        gap: 0;
    }

    .admission-entry-row {
        cursor: pointer;
        transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        border: 1px solid rgba(0,0,0,0.05) !important;
    }

    .admission-entry-row:hover {
        background: #f8fafc;
    }

    .bg-light-primary {
        background-color: rgba(13, 110, 253, 0.03) !important;
    }

    .bg-light-soft {
        background-color: rgba(0, 0, 0, 0.02);
    }

    .admission-summary-bar {
        background: white;
        border-radius: 20px;
        padding: 12px 20px;
        display: flex;
        align-items: center;
        gap: 20px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.05);
        cursor: pointer;
        transition: transform 0.2s;
    }

    .admission-summary-bar:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(0,0,0,0.08);
    }

    .summary-left {
        display: flex;
        gap: 30px;
    }

    .summary-item.main {
        display: flex;
        flex-direction: column;
    }

    .summary-item.main label {
        font-size: 0.6rem;
        font-weight: 900;
        color: #94a3b8;
        text-transform: uppercase;
        margin-bottom: 0px;
    }

    .summary-item.main .val {
        font-size: 1.5rem;
        font-weight: 950;
        color: #1e293b;
        line-height: 1;
    }

    .summary-divider {
        width: 2px;
        height: 40px;
        background: #f1f5f9;
    }

    .summary-right {
        flex: 1;
        display: flex;
        gap: 10px;
