@code {
    private bool Loading { get; set; } = true;
    private bool _isCircutAlive = true;
    private string _syncStatus = "Synced";
    private string _currentUsername = "...";
    private DateTime SessionDate { get; set; } = DateTime.Today;
    private Timer? _inactivityTimer;
    private Timer? _syncTimer;
    private DateTime _lastActivity = DateTime.Now;
    
    private string _activeField = "";
    private string _currentBuffer = "";
    private bool _showAdmissionPopup = false;
    private bool _showFloorSalesPopup = false;
    private bool _showCancelSessionConfirmation = false;
    private bool _hasBlockingOpenSession = false;
    private DateTime? _blockingSessionDate;
    private bool _showFloatingKeypad = false;
    private bool _showSummaryDetail = false;
    private bool _isOffline = false;
    private bool _isSyncing = false;
    private bool _needsSync = false;
    private bool _entryModeIsDollars = true;
    private bool _useManualScaling = true;
    private decimal _payoutPercentage = 100m;
    private void ToggleEntryMode(bool isDollars)
    {
        _entryModeIsDollars = isDollars;
        _currentBuffer = ""; // Clear buffer on toggle
    }
    private async Task OnScalingModeChanged(ChangeEventArgs e)
    {
        if (bool.TryParse(e.Value?.ToString(), out var val))
        {
            _useManualScaling = val;
            RecalculateSheetTotals();
            _needsSync = true;
            await SaveDraftAsync();
        }
    }
    private async Task OnPayoutPercentageChanged(ChangeEventArgs e)
    {
        if (decimal.TryParse(e.Value?.ToString(), out var val))
        {
            _payoutPercentage = Math.Clamp(val, 1, 500);
            RecalculateSheetTotals();
            _needsSync = true;
            await SaveDraftAsync();
        }
    }
    private async Task ShowToast(string title, string message, string type = "success")
    {
        await JSRuntime.InvokeVoidAsync("Swal.fire", new {
            title = title,
            text = message,
            icon = type,
            timer = 2000,
            showConfirmButton = false,
            toast = true,
            position = "top-end"
        });
    }
    private DateTime? _lastSavedTime;
    private BingoSheet? _selectedSheet;
    private AdmissionPack? _selectedPackDetail;
    private bool _showAdmissionAudit = false;
    private bool _isStdExpanded = false;
    private BingoSettingsDto _bingoSettings = new();
    private bool _showScalingTiers = false;
    private bool _showSessionLockedNotice = false;
    private string _sessionState = "NotStarted";
    private bool _sessionEntered = true;
    private bool _showDirectoryModal = false;
    private List<SessionHistoryItem> _historyItems = new();
    private string _lockedAction = "";
    private string _lockedColor = "";

    private BingoPayoutTierDto? GetCurrentTier()
    {
        if (_bingoSettings.PayoutTiers == null || !_bingoSettings.PayoutTiers.Any()) return null;
        var admissions = AdmissionCount;
        return _bingoSettings.PayoutTiers
            .Where(t => t.MinAdmissions <= admissions)
            .OrderByDescending(t => t.MinAdmissions)
            .FirstOrDefault();
    }

    private int GetAdmitCount(string name)
    {
        try {
            var parts = name.Split(' ');
            if (int.TryParse(parts.Last(), out var val)) return val;
            return 9;
        } catch { return 9; }
    }

    private bool _showCloseOutConfirmation = false;
    private void RequestCloseOut() => _showCloseOutConfirmation = true;
    private void CancelCloseOut() => _showCloseOutConfirmation = false;

    private void ShowLockedSessionNotice(string action)
    {
        _lockedAction = action;
        _showSessionLockedNotice = true;
        StateHasChanged();
    }

    private void OpenAdditionalSalesEntry()
    {
        if (_sessionState == "Closed")
        {
            ShowLockedSessionNotice("Additional Sales");
            return;
        }
        CloseAllModals();
        _showFloorSalesPopup = true;
        StateHasChanged();
    }

    private void OpenAdmissionEntry()
    {
        if (_sessionState == "Closed")
        {
            ShowLockedSessionNotice("Admission Counts");
            return;
        }
        CloseAllModals();
        _showAdmissionPopup = true;
        StateHasChanged();
    }

    private void CloseAllModals()
    {
        _selectedSheet = null;
        _showAdmissionPopup = false;
        _showFloorSalesPopup = false;
        _selectedPackDetail = null;
        _showScalingTiers = false;
        _showAdmissionAudit = false;
        _showFloatingKeypad = false;
        _activeField = "";
    }

    private bool _openedFromSummary = false;
    private void OpenSheetFromSummary(BingoSheet sheet)
    {
        CloseAllModals();
        _openedFromSummary = true;
        _selectedSheet = sheet;
        StateHasChanged();
    }

    private void OpenSheetDetail(BingoSheet sheet)
    {
        CloseAllModals();
        _openedFromSummary = false;
        _selectedSheet = sheet;
        StateHasChanged();
    }

    private void HandleSheetModalClose()
    {
        if (_openedFromSummary)
        {
            _selectedSheet = null;
            _showAdmissionAudit = true;
        }
        else
        {
            _selectedSheet = null;
        }
        StateHasChanged();
    }

    private void ToggleAdmissions() 
    { 
        var wasOpen = _showAdmissionPopup;
        CloseAllModals();
        _showAdmissionPopup = !wasOpen;
    }
    private void OpenAdmissionAudit()
    {
        CloseAllModals();
        _showAdmissionAudit = true;
        StateHasChanged();
    }

    private void CloseKeypad()
    {
        _showFloatingKeypad = false;
        _activeField = "";
        _currentBuffer = "";
        StateHasChanged();
    }
    private void CloseEntryModals() => CloseAllModals();

    private List<AdmissionPack> AdmissionPacks { get; set; } = new();

    private List<BingoSheet> Sheets { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        _currentUsername = authState.User.Identity?.Name ?? "Staff";
        
        try 
        {
            _isOffline = false;
            // 1. ALWAYS ATTEMPT TO FETCH LATEST FROM SERVER
            var programTask = ReportingService.GetBingoProgramAsync();
            var admissionsTask = ReportingService.GetBingoAdmissionsAsync();
            var settingsTask = ReportingService.GetBingoSettingsAsync();
            
            await Task.WhenAll(programTask, admissionsTask, settingsTask);
            
            var program = await programTask;
            var admissions = await admissionsTask;
            _bingoSettings = await settingsTask;

            if (program != null && program.Any())
            {
                Sheets = program.Select(p => {
                    var games = p.Games.OrderBy(g => g.DisplayOrder).Select(g => new BingoGame 
                    { 
                        Name = g.GameName,
                        DefaultPayout = g.DefaultPayout,
                        IsVariablePayout = g.IsVariablePayout,
                        Payout = g.DefaultPayout,
                        PayoutMode = g.PayoutMode,
                        IsProgressive = g.IsProgressive,
                        CurrentBallGoal = g.CurrentProgressiveBallGoal,
                        JackpotAmount = g.ProgressiveJackpotAmount,
                        ConsolationAmount = g.ProgressiveConsolationAmount
                    }).ToList();

                    // FALLBACK: If no games are defined, create a default "Main Game" 
                    // so the user can still enter winners and balls in the tracker.
                    if (!games.Any())
                    {
                        games.Add(new BingoGame { 
                            Name = "Standard Game", 
                            PayoutMode = p.PayoutMode,
                            DefaultPayout = p.DefaultPrice // Use sheet price as default if no games
                        });
                    }

                    return new BingoSheet 
                    { 
                        ColorName = p.ColorName, 
                        DisplayColor = p.DisplayColor,
                        Price = p.DefaultPrice,
                        PayoutMode = p.PayoutMode,
                        IsAdmissionOnly = p.IsAdmissionOnly,
                        IsIncludedInAdmission = p.IsIncludedInAdmission,
                        LotteryPercentage = p.LotteryPercentage,
                        ClubPercentage = p.ClubPercentage,
                        Games = games
                    };
                }).ToList();
            }

            if (admissions != null && admissions.Any())
            {
                AdmissionPacks = admissions.Select(a => new AdmissionPack 
                { 
                    Id = a.Id, 
                    Name = a.Name, 
                    DisplayColor = a.DisplayColor, 
                    Price = a.Price
                }).ToList();
            }

            if (Sheets.Any() && AdmissionPacks.Any())
            {
                var setup = new BingoSetupCache 
                { 
                    Sheets = Sheets, 
                    AdmissionPacks = AdmissionPacks,
                    Settings = _bingoSettings 
                };
                await JSRuntime.InvokeVoidAsync("window.gfcSetAsync", "gfc_bingo_setup_cache", setup);
            }

            // Timers
            _inactivityTimer = new Timer(CheckInactivity, null, 60000, 60000);
            _syncTimer = new Timer(async _ => await BackgroundSyncAsync(), null, 30000, 30000);

            await JSRuntime.InvokeVoidAsync("eval", @"
                window.resetBingoTimer = () => { DotNet.invokeMethodAsync('GFC.Mobile', 'ResetInactivityTimer'); };
                window.addEventListener('mousedown', window.resetBingoTimer);
                window.addEventListener('touchstart', window.resetBingoTimer);
                window.addEventListener('keypress', window.resetBingoTimer);
            ");
        }
        catch (Exception ex)
        {
            _isOffline = true;
            // 3. IF OFFLINE OR SERVER ERROR, FALLBACK TO LOCAL CACHE
            Console.WriteLine($"Offline fallback: {ex.Message}");
            var cachedSetup = await JSRuntime.InvokeAsync<BingoSetupCache>("window.gfcGetAsync", "gfc_bingo_setup_cache");
            
            if (cachedSetup != null)
            {
                Sheets = cachedSetup.Sheets;
                AdmissionPacks = cachedSetup.AdmissionPacks;
                if (cachedSetup.Settings != null) _bingoSettings = cachedSetup.Settings;
            }
            else if (!Sheets.Any())
            {
                InitializeDefaultProgram();
            }
        }

        if (!AdmissionPacks.Any())
        {
            AdmissionPacks = new List<AdmissionPack> { new AdmissionPack { Id = 1, Name = "Standard Pack 9", DisplayColor = "#3b82f6", Price = 20 } };
        }

        _activeField = "Pack_" + AdmissionPacks[0].Id;

        await LoadDraftAsync();
        Loading = false;
    }

    private async Task RefreshBingoProgram()
    {
        _isSyncing = true;
        StateHasChanged();
        try
        {
            var program = await ReportingService.GetBingoProgramAsync();
            if (program != null && program.Any())
            {
                Sheets = program.Select(p => {
                    var games = p.Games.OrderBy(g => g.DisplayOrder).Select(g => new BingoGame 
                    { 
                        Name = g.GameName,
                        IsProgressive = g.IsProgressive,
                        JackpotAmount = g.ProgressiveJackpotAmount,
                        ConsolationAmount = g.ProgressiveConsolationAmount,
                        DefaultPayout = g.DefaultPayout,
                        CurrentBallGoal = g.CurrentProgressiveBallGoal,
                        Payout = g.IsProgressive ? g.ProgressiveConsolationAmount : g.DefaultPayout,
                        PayoutMode = g.PayoutMode,
                        IsVariablePayout = g.IsVariablePayout,
                        ClubPercentage = g.ClubPercentage
                    }).ToList();

                    if (!games.Any())
                    {
                        games.Add(new BingoGame { 
                            Name = "Standard Game", 
                            DefaultPayout = p.DefaultPrice * 50, 
                            Payout = p.DefaultPrice * 50,
                            PayoutMode = p.PayoutMode
                        });
                    }

                    return new BingoSheet 
                    { 
                        ColorName = p.ColorName, 
                        DisplayColor = p.DisplayColor,
                        IsIncludedInAdmission = p.IsIncludedInAdmission,
                        Price = p.DefaultPrice,
                        PayoutMode = p.PayoutMode,
                        IsAdmissionOnly = p.IsAdmissionOnly,
                        LotteryPercentage = p.LotteryPercentage,
                        ClubPercentage = p.ClubPercentage,
                        Games = games
                    };
                }).ToList();
                
                await ShowToast("Bingo Program Updated", "The latest game definitions have been downloaded.");
            }
        }
        catch (Exception ex)
        {
            await ShowToast("Update Failed", "Could not reach the server to refresh the program.", "danger");
        }
        finally
        {
            _isSyncing = false;
            StateHasChanged();
        }
    }

