        z-index: 8000;
        animation: slide-up 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }

    @@keyframes slide-up {
        from { transform: translateY(100px) scale(0.9); opacity: 0; }
        to { transform: translateY(0) scale(1); opacity: 1; }
    }

    .header-summary-dropdown {
        position: absolute;
        top: 100%;
        right: 0;
        width: 220px;
        z-index: 4000;
        margin-top: 10px;
        animation: slide-down 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    }

    @@keyframes slide-down {
        from { transform: translateY(-10px); opacity: 0; }
        to { transform: translateY(0); opacity: 1; }
    }

    /* SHEET DETAIL MODAL */
    .sheet-detail-modal {
        position: fixed;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 95%;
        max-width: 550px;
        max-height: 90vh;
        background: white;
        border-radius: 32px;
        z-index: 5000;
        box-shadow: 0 30px 90px rgba(0,0,0,0.4);
        overflow: hidden;
        border: 1px solid rgba(255,255,255,0.2);
        display: flex;
        flex-direction: column;
    }

    .detail-header {
        padding: 15px 20px;
