</style>

@if (_selectedSheet != null)
{
    var sheetRoundingBreakage = _selectedSheet.Games.Sum(g => CalculateGameRoundingAdjustment(_selectedSheet, g));
    var sheetManualBreakage = _selectedSheet.Games.Sum(g => CalculateGameManualAdjustmentBreakage(_selectedSheet, g));
    var sheetTotalBreakage = sheetRoundingBreakage + sheetManualBreakage;

    <div class="modal-backdrop-custom animate-fade-in" style="z-index: 4500;" @onclick="() => _selectedSheet = null"></div>
    <div class="sheet-detail-modal animate-zoom-in @(_showFloatingKeypad ? "keypad-open" : "")">
        <div class="detail-header" style="background: @_selectedSheet.DisplayColor">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h2 class="fw-black text-uppercase mb-0" style="letter-spacing: -0.02em; color: @(_selectedSheet.ColorName.ToLower() == "white" ? "#1e293b" : "white"); text-shadow: @(_selectedSheet.ColorName.ToLower() == "white" ? "0 0 1px rgba(255,255,255,0.8)" : "0 1px 2px rgba(0,0,0,0.2)")">@_selectedSheet.ColorName</h2>
                    <div class="d-flex align-items-center gap-2 mt-1">
                        <span class="badge bg-white bg-opacity-20 rounded-pill px-3 py-1 fw-bold" style="font-size: 0.65rem;">
                            @_selectedSheet.Price.ToString("C2") PER SHEET
                        </span>
                        @if (_selectedSheet.PayoutMode == 1)
                        {
                            <span class="badge bg-warning text-dark rounded-pill px-3 py-1 fw-bold" style="font-size: 0.65rem;">50/50 MODE</span>
                        }
                        else if (_selectedSheet.PayoutMode == 2)
                        {
                            <span class="badge bg-info text-dark rounded-pill px-3 py-1 fw-bold" style="font-size: 0.65rem;">GROSS % MODE</span>
                        }
                    </div>
                </div>
                <button class="btn btn-link text-white p-0 border-0 fs-3" @onclick="() => _selectedSheet = null">
                    <i class="bi bi-x-circle-fill"></i>
                </button>
            </div>
        </div>

        <div class="detail-body">
            @if (_selectedSheet.IsClosedOut)
            {
                @if (_selectedSheet.IsSynced)
                {
                    <div class="alert alert-success py-2 mb-3 rounded-4 d-flex align-items-center justify-content-center gap-2 border-0 shadow-sm animate-fade-in" style="background: rgba(16, 185, 129, 0.1); border: 1px solid rgba(16, 185, 129, 0.2) !important;">
                        <i class="bi bi-check-circle-fill text-success"></i>
                        <span class="fw-black text-uppercase text-success" style="font-size: 0.75rem;">This color is marked as COMPLETED</span>
                    </div>
                }
                else
                {
                    <div class="alert alert-warning py-2 mb-3 rounded-4 d-flex align-items-center justify-content-center gap-2 border-0 shadow-sm animate-fade-in" style="background: rgba(245, 158, 11, 0.1); border: 1px solid rgba(245, 158, 11, 0.2) !important;">
                        <i class="bi bi-cloud-arrow-up-fill text-warning"></i>
                        <span class="fw-black text-uppercase text-warning" style="font-size: 0.75rem;">Completed Offline (PENDING SYNC)</span>
                    </div>
                }
            }

            <!-- SOLD BREAKDOWN -->
            <div class="row g-2 mb-3">
                @if (!_selectedSheet.IsAdmissionOnly)
                {
                    <div class="@(_selectedSheet.IsIncludedInAdmission ? "col-6" : "col-12")">
                        <div class="math-card text-center mb-0 h-100 p-2">
                            <label class="math-label d-block mb-1">Additional Purchased</label>
                            <div class="math-val fs-4">@_selectedSheet.ManualSold</div>
                        </div>
                    </div>
                }
                @if (_selectedSheet.IsIncludedInAdmission)
                {
                    <div class="@(_selectedSheet.IsAdmissionOnly ? "col-12" : "col-6")">
                        <div class="math-card text-center mb-0 h-100 p-2">
                            <label class="math-label d-block mb-1">Admission Sold</label>
                            <div class="math-val fs-4">@AdmissionCount</div>
                        </div>
                    </div>
                }
                @if (!_selectedSheet.IsAdmissionOnly)
                {
                    <div class="col-6">
                        <div class="math-card text-center mb-0 h-100 p-2">
                            <label class="math-label d-block mb-1">Lottery</label>
                            <div class="math-val text-danger fw-bold" style="font-size: 0.9rem;">-@CalculateLotteryTake(_selectedSheet).ToString("C2")</div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="math-card text-center mb-0 h-100 p-2">
                            <label class="math-label d-block mb-1">Club Profit</label>
                            @{
                                var clubTake = CalculateClubTake(_selectedSheet);
                                var clubTakeClass = clubTake >= 0 ? "text-success" : "text-danger";
                                var clubTakeSign = clubTake >= 0 ? "+" : "";
                            }
                            <div class="math-val @clubTakeClass fw-bold" style="font-size: 0.9rem;">@clubTakeSign@clubTake.ToString("C2")</div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="col-12 mt-1">
                        <div class="alert alert-info py-1 mb-0 text-center" style="font-size: 0.7rem;">
                            <i class="bi bi-info-circle me-1"></i> PART OF THE ADMISSION PACKAGE
                        </div>
                    </div>
                }
            </div>

            <!-- MATH BREAKDOWN -->
            @if (!_selectedSheet.IsAdmissionOnly)
            {
                <div class="math-card">
                    <div class="math-row">
                        <span class="math-label">Gross Revenue (@_selectedSheet.Sold sheets)</span>
                        <span class="math-val">@((_selectedSheet.Sold * _selectedSheet.Price).ToString("C2"))</span>
                    </div>
                    @if (_selectedSheet.IsIncludedInAdmission)
                    {
                        <div class="math-row opacity-75">
                            <span class="math-label small">Included from Admissions</span>
                            <span class="math-val small text-muted">@((AdmissionCount * _selectedSheet.Price).ToString("C2"))</span>
                        </div>
                        @if (_selectedSheet.ManualSold > 0)
                        {
                            <div class="math-row opacity-75">
                                <span class="math-label small">Extra Floor Sales</span>
                                <span class="math-val small text-muted">@((_selectedSheet.ManualSold * _selectedSheet.Price).ToString("C2"))</span>
                            </div>
                        }
                    }
                    
                    <div class="math-row">
                        <span class="math-label">Lottery Fee (@(_selectedSheet.LotteryPercentage * 100)% )</span>
                        <span class="math-val neg">- @CalculateLotteryTake(_selectedSheet).ToString("C2")</span>
                    </div>


                    <div class="math-row">
                        <span class="math-label">Total Prizes Paid</span>
                        <span class="math-val neg">- @_selectedSheet.Games.Sum(g => CalculateGamePayout(_selectedSheet, g)).ToString("C2")</span>
                    </div>

                    <div class="math-row total">
                        <span class="math-label text-dark">Net Club Profit</span>
                        @{
                            var sheetNet = CalculateSheetNet(_selectedSheet);
                            var netClass = sheetNet >= 0 ? "pos" : "neg";
                        }
                        <span class="math-val @netClass">@sheetNet.ToString("C2")</span>
                    </div>
                </div>
            }
            else
            {
                <div class="math-card py-3 text-center border-2" style="background: #f8fafc; border-style: dashed; border-color: #3b82f6;">
                    <div class="mb-2">
                        <i class="bi bi-gift text-primary" style="font-size: 2rem; opacity: 0.5;"></i>
                    </div>
                    <label class="math-label d-block mb-1 text-primary fw-black" style="font-size: 0.65rem;">STANDARD PROGRAM</label>
                    <div class="text-dark fw-black fs-5 text-uppercase">Included with Admission</div>
                    <small class="text-muted d-block mt-1 mx-auto" style="max-width: 250px; font-size: 0.65rem;">This color is provided to every player and funded by the door money.</small>
                </div>
            }

            <!-- GAME PAYOUTS -->
            <div class="d-flex justify-content-between align-items-end mb-2 px-1">
                <label class="math-label mb-0">Game Payout Details</label>
                @if (_selectedSheet.IsAdmissionOnly)
                {
                    <button class="btn btn-link p-0 text-primary fw-bold extra-small" style="text-decoration: none; font-size: 0.6rem;" @onclick="() => _showScalingTiers = true">
                        <i class="bi bi-diagram-3-fill me-1"></i>VIEW TIERS
                    </button>
                }
            </div>

            @if (_selectedSheet.IsAdmissionOnly && GetCurrentPayoutPercentage() < 100m)
            {
                <div class="p-2 mb-2 rounded-4 bg-warning bg-opacity-10 border border-warning border-opacity-25" style="font-size: 0.7rem;">
                    <div class="d-flex align-items-start gap-2">
                        <div class="bg-warning bg-opacity-20 rounded-circle p-1 d-flex align-items-center justify-content-center" style="width: 24px; height: 24px;">
                            <i class="bi bi-exclamation-triangle-fill text-warning" style="font-size: 0.8rem;"></i>
                        </div>
                        <div>
                            <div class="fw-black text-dark text-uppercase mb-0" style="letter-spacing: 0.05em; font-size: 0.65rem;">Attendance Adjustment Active</div>
                            <div class="text-muted fw-bold" style="line-height: 1.2; font-size: 0.65rem;">
                                Prizes scaled to <span class="text-dark">@GetCurrentPayoutPercentage().ToString("N1")%</span> (@AdmissionCount players). 
                            </div>
                        </div>
                    </div>
                </div>
            }

            <div class="tile-games-list">
                @foreach (var game in _selectedSheet.Games)
                {
                    var gameIdx = _selectedSheet.Games.IndexOf(game);
                    <div id="game-row-@(_selectedSheet.ColorName)-@(gameIdx)" class="game-detail-item d-flex flex-column align-items-stretch p-3 rounded-4 mb-3 border @(game.IsVariablePayout ? "bg-primary-subtle border-primary border-opacity-25" : "bg-white border-light")" style="margin-bottom: 12px; gap: 8px;">
                        <!-- Top Row: Name, Inputs, Payout -->
                        <div class="d-flex justify-content-between align-items-center gap-2">
                            <!-- Left: Name -->
                            <div class="flex-grow-1" style="min-width: 0;">
                                <div class="d-flex align-items-center gap-2">
                                    <span class="fw-black text-dark d-block text-truncate" style="font-size: 0.9rem;">@game.Name</span>
                                    @if (game.IsVariablePayout)
                                    {
                                        <span class="badge bg-primary rounded-pill extra-small px-2" style="font-size: 0.5rem;">VARIABLE</span>
                                    }
                                </div>
                                <div class="extra-small text-muted fw-bold">
                                    @if (!game.IsProgressive && game.PayoutMode != 0)
                                    {
                                        <span class="text-uppercase" style="font-size: 0.6rem;">CALCULATED @(game.PayoutMode == 1 ? "50/50" : "PERCENTAGE")</span>
                                    }
                                    else if (!game.IsProgressive && game.IsVariablePayout)
                                    {
                                        <span class="text-uppercase" style="font-size: 0.6rem;">MANUAL ENTRY</span>
                                    }
                                    else if (!game.IsProgressive)
                                    {
                                        var pct = _selectedSheet.IsAdmissionOnly ? GetCurrentPayoutPercentage() : 100m;
                                        if (pct < 100m)
                                        {
                                            <span class="text-primary" style="font-size: 0.55rem;">@($"{pct:N1}% OF {game.DefaultPayout:C2} BASE")</span>
                                        }
                                        else
                                        {
                                            <span class="text-uppercase" style="font-size: 0.6rem;">STANDARD PRIZE</span>
                                        }
                                    }
                                </div>
                            </div>

                            <!-- Center-Right: Interactive Inputs -->
                            <div class="d-flex align-items-center gap-3">
                                <!-- WINNER INPUT -->
                                <div class="d-flex flex-column align-items-center" @onclick:stopPropagation="true" @onclick='() => ActivateField(_selectedSheet.ColorName + "_Winner_" + _selectedSheet.Games.IndexOf(game))'>
                                    <label class="extra-small text-muted fw-bold mb-1" style="font-size: 0.55rem; letter-spacing: 0.05em;">WINNERS</label>
                                    <div class="form-control form-control-sm text-center fw-black border-2 d-flex align-items-center justify-content-center @(_activeField == (_selectedSheet.ColorName + "_Winner_" + _selectedSheet.Games.IndexOf(game)) ? "border-primary bg-white text-primary shadow-sm" : "bg-light")" 
                                         style="width: 50px; height: 35px; border-radius: 10px; font-size: 1.1rem; cursor: pointer;">
                                        @if (_activeField == (_selectedSheet.ColorName + "_Winner_" + _selectedSheet.Games.IndexOf(game)))
                                        {
                                            <div class="d-flex align-items-center">
                                                <span class="@(_currentBuffer == "" ? "ghost-value" : "")">@(_currentBuffer == "" ? game.WinnerCount.ToString() : _currentBuffer)</span>
                                                <span class="cursor-blink">|</span>
                                            </div>
                                        }
                                        else
                                        {
                                            @game.WinnerCount
                                        }
                                    </div>
                                </div>

                                <!-- PAYOUT / WINNER INPUT -->
                                <div class="d-flex align-items-center gap-1">
                                    <div class="d-flex flex-column align-items-center" @onclick:stopPropagation="true" @onclick='() => ActivateField(_selectedSheet.ColorName + "_Override_" + _selectedSheet.Games.IndexOf(game))'>
                                        <label class="extra-small text-muted fw-bold mb-1" style="font-size: 0.55rem; letter-spacing: 0.05em;">PAYOUT/WINNER</label>
                                        <div class="form-control form-control-sm text-center fw-black border-2 d-flex align-items-center justify-content-center @(_activeField == (_selectedSheet.ColorName + "_Override_" + _selectedSheet.Games.IndexOf(game)) ? "border-primary bg-white text-primary shadow-sm" : "bg-light")" 
                                             style="width: 80px; height: 35px; border-radius: 10px; font-size: 1rem; cursor: pointer;">
                                            @{
                                                var shareVal = CalculateGamePayoutFinalShare(_selectedSheet, game);
                                            }
                                            @if (_activeField == (_selectedSheet.ColorName + "_Override_" + _selectedSheet.Games.IndexOf(game)))
                                            {
                                                <div class="d-flex align-items-center text-primary">
                                                    <span>$</span>
                                                    <span class="@(_currentBuffer == "" ? "ghost-value" : "")">@(_currentBuffer == "" ? shareVal.ToString("N2") : _currentBuffer)</span>
                                                    <span class="cursor-blink">|</span>
                                                </div>
                                            }
                                            else
                                            {
                                                <span class="@(game.CustomPayoutOverride.HasValue ? "text-success fw-black" : "")">$@shareVal.ToString("N2")</span>
                                            }
                                        </div>
                                    </div>

                                    @if (game.CustomPayoutOverride.HasValue)
                                    {
                                        <button class="btn btn-sm btn-outline-danger border-2 rounded-circle p-0 d-flex align-items-center justify-content-center mt-3 shadow-sm animate-pulse" 
                                                style="width: 28px; height: 28px;" 
                                                @onclick:stopPropagation="true" 
                                                @onclick="() => { game.CustomPayoutOverride = null; RecalculateSheetTotals(); }">
                                            <i class="bi bi-arrow-counterclockwise" style="font-size: 0.8rem; -webkit-text-stroke: 0.5px;"></i>
                                        </button>
                                    }
                                </div>

                                @if (game.IsProgressive)
                                {
                                    <!-- BALLS CALLED INPUT -->
                                    <div class="d-flex flex-column align-items-center" @onclick:stopPropagation="true" @onclick='() => ActivateField(_selectedSheet.ColorName + "_Balls_" + _selectedSheet.Games.IndexOf(game))'>
                                        <label class="extra-small text-muted fw-bold mb-1" style="font-size: 0.55rem; letter-spacing: 0.05em;">BALLS</label>
                                        <div class="form-control form-control-sm text-center fw-black border-2 d-flex align-items-center justify-content-center @(_activeField == (_selectedSheet.ColorName + "_Balls_" + _selectedSheet.Games.IndexOf(game)) ? "border-primary bg-white text-primary shadow-sm" : "bg-light")" 
                                             style="width: 50px; height: 35px; border-radius: 10px; font-size: 1.1rem; cursor: pointer;">
                                            @if (_activeField == (_selectedSheet.ColorName + "_Balls_" + _selectedSheet.Games.IndexOf(game)))
                                            {
                                                <div class="d-flex align-items-center">
                                                    <span class="@(_currentBuffer == "" ? "ghost-value" : "")">@(_currentBuffer == "" ? (game.BallsCalled == 0 ? "-" : game.BallsCalled.ToString()) : _currentBuffer)</span>
                                                    <span class="cursor-blink">|</span>
                                                </div>
                                            }
                                            else
                                            {
                                                @(game.BallsCalled == 0 ? "-" : game.BallsCalled)
                                            }
                                        </div>
                                    </div>
                                }
                            </div>

                            <!-- Right: Payout -->
                            <div class="text-end ms-2" style="min-width: 100px;">
                                @{
                                    var totalPayout = CalculateGamePayout(_selectedSheet, game);
                                    var perWinner = game.WinnerCount > 0 ? totalPayout / game.WinnerCount : totalPayout;
                                    var origShare = CalculateGamePayoutRoundedShare(_selectedSheet, game);
                                    var origTotal = origShare * game.WinnerCount;
                                    var rawShare = CalculateGamePayoutRawShare(_selectedSheet, game);
                                    var rawTotal = rawShare * game.WinnerCount;
                                    var roundingAdjustment = CalculateGameRoundingAdjustment(_selectedSheet, game);
                                }
                                
                                @if (_selectedSheet.PayoutMode == 0 && game.IsVariablePayout)
                                {
                                    <div class="input-group input-group-sm ms-auto" style="width: 100px;" @onclick:stopPropagation="true">
                                        <span class="input-group-text bg-white border-primary border-opacity-25 fw-bold p-1">$</span>
                                        <input type="number" inputmode="decimal" class="form-control border-primary border-opacity-25 fw-black text-primary p-1" 
                                               value="@game.Payout" 
                                               @onchange="@(e => { if (decimal.TryParse(e.Value?.ToString(), out var v)) { game.Payout = v; RecalculateSheetTotals(); } })"
                                               @onfocus="OnInputFocus" />
                                    </div>
                                }
                                else
                                {
                                    @if (game.CustomPayoutOverride.HasValue)
                                    {
                                        <div class="fw-black text-success fs-5" style="line-height: 1;">@totalPayout.ToString("C2")</div>
                                    }
                                    else
                                    {
                                        <div class="fw-black text-primary fs-5" style="line-height: 1;">@totalPayout.ToString("C2")</div>
                                    }
                                }

                                <div class="mt-1 extra-small fw-bold text-dark opacity-75" style="font-size: 0.62rem; line-height: 1.2;">
                                    @if ((_selectedSheet.IsAdmissionOnly || (!game.IsProgressive && game.IncludeInTargetProfit)) && !game.CustomPayoutOverride.HasValue)
                                    {
                                        var payoutVal = CalculateGamePayout(_selectedSheet, game);
                                        if (payoutVal < game.DefaultPayout)
                                        {
                                            <div class="mb-1 text-primary fw-black" style="font-size: 0.65rem;">
                                                @if (_selectedSheet.IsAdmissionOnly)
                                                {
                                                    <span>Scaled from @game.DefaultPayout.ToString("C2") (@(GetCurrentPayoutPercentage().ToString("F0"))% Scale)</span>
                                                }
                                                else
                                                {
                                                    var isMin = game.MinimumPayout > 0 && payoutVal == game.MinimumPayout;
                                                    <span>Scaled by sales (Target: @(_targetProfitPercentage.ToString("F0"))% Profit@(isMin ? " | Minimum Payout" : ""))</span>
                                                }
                                            </div>
                                        }
                                    }
                                    Orig Calc: <span class="text-decoration-underline text-dark fw-bold">@origTotal.ToString("C2")</span>
                                    @if (game.WinnerCount > 1)
                                    {
                                        <span class="text-muted"> (@origShare.ToString("C2") ea)</span>
                                    }
                                    @if (roundingAdjustment != 0)
                                    {
                                        <div class="mt-1 fw-extrabold" style="font-size: 0.58rem; color: #b45309; letter-spacing: 0.02em;">
                                            Exact: @rawTotal.ToString("C2") (@(roundingAdjustment > 0 ? "+" : "")@roundingAdjustment.ToString("C2") Round)
                                        </div>
                                    }
                                </div>

                                @if (game.WinnerCount > 1)
                                {
                                    <div class="mt-1 bg-primary bg-opacity-10 rounded-3 px-2 py-0.5 d-inline-block border border-primary border-opacity-20 shadow-sm">
                                        <span class="fw-black text-primary" style="font-size: 0.7rem !important;">@perWinner.ToString("C2")</span>
                                        <span class="extra-small fw-bold text-primary opacity-75 ms-1" style="font-size: 0.5rem;">EACH</span>
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- System Calc Helper Label and Breakage Info when Custom Payout is active -->
                        @if (game.CustomPayoutOverride.HasValue)
                        {
                            var systemShare = CalculateSystemGamePayoutRoundedShare(_selectedSheet, game);
                            var manualBreakage = CalculateGameManualAdjustmentBreakage(_selectedSheet, game);
                            var isDecrease = game.CustomPayoutOverride.Value <= systemShare;
                            <div class="d-flex flex-column gap-2 mt-1 px-1 text-dark fw-semibold" style="font-size: 0.65rem; border-top: 1px dashed rgba(0,0,0,0.05); padding-top: 6px;">
                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="d-flex align-items-center gap-2">
                                        <span><i class="bi bi-info-circle me-1"></i> System Calc: <strong class="text-primary">@systemShare.ToString("C2")</strong> each</span>
                                        <button class="btn btn-outline-danger btn-sm rounded-pill px-2 py-0.5 fw-black text-uppercase shadow-sm d-flex align-items-center gap-1 border-2" 
                                                style="font-size: 0.55rem; line-height: 1; height: auto; padding: 2px 8px !important;" 
                                                @onclick:stopPropagation="true" 
                                                @onclick="() => { game.CustomPayoutOverride = null; RecalculateSheetTotals(); }">
                                            <i class="bi bi-arrow-counterclockwise" style="font-size: 0.6rem;"></i> Reset
                                        </button>
                                    </span>
                                    @if (isDecrease)
                                    {
                                        <span class="badge bg-primary text-white fw-black px-3 py-2 shadow" style="font-size: 0.75rem; letter-spacing: 0.02em;">
                                            Base Redefined ($0.00 Breakage)
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge text-white fw-black px-3 py-2 shadow" style="font-size: 0.75rem; letter-spacing: 0.02em; background-color: #64748b !important;">
                                            Manual Adj: @(manualBreakage > 0 ? "+" : "")@manualBreakage.ToString("C2") Breakage
                                        </span>
                                    }
                                </div>
                            </div>
                        }

                        <!-- Bottom Row: Progressive Details (Full Width below Name/Inputs) -->
                        @if (game.IsProgressive)
                        {
                            <div class="mt-3 p-3 rounded-4 bg-primary bg-opacity-10 border border-primary border-opacity-25 shadow-sm animate-zoom-in">
                                <div class="d-flex flex-column gap-2">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div class="d-flex align-items-center text-primary fw-bold" style="font-size: 0.75rem;">
                                            <i class="bi bi-rocket-takeoff-fill me-2"></i> JACKPOT GOAL:
                                        </div>
                                        <span class="badge bg-primary text-white rounded-pill px-3 py-1 fw-black" style="font-size: 0.75rem;">
                                            @(game.CurrentBallGoal > 0 ? $"{game.CurrentBallGoal} BALLS OR LESS" : "NOT SET")
                                        </span>
                                    </div>
                                    
                                    <div class="d-flex justify-content-between align-items-center border-top border-primary border-opacity-10 pt-2 mt-1">
                                        <span class="text-muted fw-bold" style="font-size: 0.7rem;">BALLS CALLED:</span>
                                        <span class="fw-black text-dark" style="font-size: 0.85rem;">
                                            @(game.BallsCalled > 0 ? $"{game.BallsCalled} Balls" : "Pending Entry...")
                                        </span>
                                    </div>

                                    @if (game.BallsCalled > 0)
                                    {
                                        <div class="mt-2 text-center">
                                            @if (game.BallsCalled <= game.CurrentBallGoal)
                                            {
                                                <span class="badge bg-success text-white rounded-pill px-3 py-2 fw-black d-inline-flex align-items-center gap-1 shadow-sm animate-pulse w-100 justify-content-center" style="font-size: 0.75rem;">
                                                    🏆 JACKPOT WON!
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary text-white rounded-pill px-3 py-2 fw-bold d-inline-flex align-items-center gap-1 w-100 justify-content-center" style="font-size: 0.65rem; background-color: #64748b !important;">
                                                    Consolation Prize (Goal Not Met)
                                                </span>
                                            }
                                        </div>
                                    }

                                    <div class="d-flex justify-content-end mt-2 pt-2 border-top border-primary border-opacity-10">
                                        <button type="button" class="btn btn-outline-primary rounded-pill px-3 py-1 fw-bold shadow-sm d-flex align-items-center gap-1.5" 
                                                style="font-size: 0.65rem; border-width: 1.5px; padding: 3px 10px !important;" 
                                                @onclick="() => LoadProgressiveHistoryAsync(game.Name, _selectedSheet.ColorName)">
                                            <i class="bi bi-clock-history"></i> HISTORY LOG
                                        </button>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>

            <!-- BREAKAGE ACCOUNTING CARD -->
            @if (sheetTotalBreakage != 0)
            {
                <div class="math-card p-3 rounded-4 mb-3 border border-secondary border-opacity-25" style="background: rgba(15, 23, 42, 0.02);">
                    <label class="math-label mb-2 text-dark d-block fw-black" style="font-size: 0.65rem;"><i class="bi bi-calculator-fill me-1"></i> Breakage Accounting</label>
                    <div class="math-row">
                        <span class="math-label small text-dark">System Rounding Breakage</span>
                        <span class="math-val fw-bold text-dark">@sheetRoundingBreakage.ToString("C2")</span>
                    </div>
                    @if (sheetManualBreakage != 0)
                    {
                        <div class="math-row">
                            <span class="math-label small text-dark">Manual Adjustment Breakage</span>
                            <span class="math-val fw-bold text-dark">@sheetManualBreakage.ToString("C2")</span>
                        </div>
                    }
                    <div class="math-row total" style="border-top-color: rgba(15, 23, 42, 0.1);">
                        <span class="math-label text-dark">Total Color Breakage</span>
                        <span class="math-val text-dark font-black" style="font-size: 1.1rem;">@sheetTotalBreakage.ToString("C2")</span>
                    </div>
                </div>
            }

        </div>

        <!-- Pinned, Non-Scrollable Footer: Always visible on tablet screens -->
        <div class="detail-footer bg-light p-3 border-top" style="border-bottom-left-radius: 32px; border-bottom-right-radius: 32px; z-index: 10;">
            <button class="btn btn-light w-100 py-3 rounded-pill fw-black border-2 shadow-sm" style="height: 50px;" @onclick="HandleSheetModalClose">
                @(_openedFromSummary ? "RETURN TO SUMMARY" : "CLOSE")
            </button>
        </div>
    </div>
}

@if (_showCloseOutConfirmation && _selectedSheet != null)
{
    <div class="modal-backdrop-custom animate-fade-in" style="z-index: 8000;"></div>
    <div class="sheet-detail-modal animate-zoom-in" style="z-index: 8500; max-width: 400px; height: auto !important; top: 50%; transform: translate(-50%, -50%); border-top: 8px solid #10b981;">
        <div class="detail-body p-4 text-center">
            <div class="mb-3 text-success">
                <i class="bi bi-check-circle-fill" style="font-size: 3rem;"></i>
            </div>
            <h4 class="fw-black text-uppercase mb-2">Finalize @_selectedSheet.ColorName?</h4>
            <p class="text-muted small mb-4">This will save all sales and payouts for this color to the server and mark the sheet as completed.</p>
            
            <div class="bg-light rounded-4 p-3 mb-4 text-start">
                <div class="d-flex justify-content-between mb-1">
                    <span class="extra-small fw-bold text-muted">TOTAL SOLD</span>
                    <span class="fw-black">@_selectedSheet.Sold</span>
                </div>
                <div class="d-flex justify-content-between">
                    <span class="extra-small fw-bold text-muted">TOTAL PRIZES</span>
                    <span class="fw-black text-danger">@_selectedSheet.Games.Sum(g => CalculateGamePayout(_selectedSheet, g)).ToString("C2")</span>
                </div>
            </div>

            <div class="d-flex flex-column gap-2">
                <button class="btn btn-success py-3 rounded-pill fw-black shadow shadow-sm" @onclick="CloseOutColorAsync">
                    FINALIZE & SAVE TO SERVER
                </button>
                <button class="btn btn-link text-muted fw-bold text-decoration-none" @onclick="CancelCloseOut">
                    GO BACK
                </button>
            </div>
        </div>
    </div>
}

@if (_selectedPackDetail != null)
{
    var basePack = AdmissionPacks.OrderBy(p => GetAdmitCount(p.Name)).FirstOrDefault();
    var basePrice = basePack?.Price ?? 15.00m;
    var baseCount = 9;
    var currentAdmitCount = GetAdmitCount(_selectedPackDetail.Name);
    var extraCount = currentAdmitCount - baseCount;
    var extraPrice = _selectedPackDetail.Price - basePrice;

    <div class="modal-backdrop-custom animate-fade-in" style="z-index: 5500;" @onclick="() => _selectedPackDetail = null"></div>
    <div class="sheet-detail-modal animate-zoom-in" style="z-index: 6000; border-top: 8px solid #3b82f6;">
        <div class="detail-header bg-primary bg-opacity-10 text-dark">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h2 class="fw-black text-uppercase mb-0" style="letter-spacing: -0.02em;">@_selectedPackDetail.Name</h2>
                    <span class="badge bg-primary rounded-pill px-3 py-1 fw-bold text-uppercase" style="font-size: 0.65rem;">ADMISSION STRUCTURE</span>
                </div>
                <button class="btn btn-link text-muted p-0 border-0 fs-3" @onclick="() => _selectedPackDetail = null">
                    <i class="bi bi-x-circle-fill"></i>
                </button>
            </div>
        </div>

        <div class="detail-body">
            <!-- PACK COMPOSITION -->
            <div class="math-card">
                <div class="math-row">
                    <span class="math-label">Base Admission (9 Squares)</span>
                    <span class="math-val">@basePrice.ToString("C2")</span>
                </div>
                @if (extraCount > 0)
                {
                    <div class="math-row">
                        <span class="math-label">Additional Cards (@extraCount Squares)</span>
                        <span class="math-val">@extraPrice.ToString("C2")</span>
                    </div>
                }
                <div class="math-row total">
                    <span class="math-label text-dark">Total Pack Price</span>
                    <span class="math-val text-primary">@_selectedPackDetail.Price.ToString("C2")</span>
                </div>
            </div>

            @if (_selectedPackDetail.Sold > 0)
            {
                <!-- SESSION TOTAL FOR THIS PACK -->
                <div class="section-divider mb-3"><span>SESSION TOTALS (@_selectedPackDetail.Sold SOLD)</span></div>
                <div class="math-card" style="background: #eff6ff; border-color: #bfdbfe;">
                    <div class="math-row">
                        <span class="math-label">Base Revenue (@(_selectedPackDetail.Sold) @baseCount-packs)</span>
                        <span class="math-val">@((_selectedPackDetail.Sold * basePrice).ToString("C2"))</span>
                    </div>
                    @if (extraCount > 0)
                    {
                        <div class="math-row">
                            <span class="math-label">Add-on Revenue (@(_selectedPackDetail.Sold * extraCount) extra cards)</span>
                            <span class="math-val">@((_selectedPackDetail.Sold * extraPrice).ToString("C2"))</span>
                        </div>
                    }
                    <div class="math-row total" style="border-top-color: #bfdbfe;">
                        <span class="math-label text-primary">Total Revenue</span>
                        <span class="math-val text-primary" style="font-size: 1.4rem;">@((_selectedPackDetail.Sold * _selectedPackDetail.Price).ToString("C2"))</span>
                    </div>
                </div>
            }

            <button class="btn btn-outline-primary w-100 py-3 rounded-pill fw-black mt-2" @onclick="() => _selectedPackDetail = null">
                CLOSE BREAKDOWN
            </button>
        </div>
    </div>
}

@if (_showAdmissionAudit)
{
    var baseRate = _bingoSettings.BasePrice;
    var cardRate = _bingoSettings.CardPrice;
    var currentScaling = GetCurrentPayoutPercentage();
    var tSold = AdmissionPacks.Sum(p => p.Sold);
    
    decimal tBaseRev = 0;
    decimal tExtraRev = 0;
    int tExtraCards = 0;

    foreach (var p in AdmissionPacks)
    {
        if (p.Sold <= 0) continue;
        var pSize = GetAdmitCount(p.Name);
        var pExtraCards = Math.Max(0, (pSize - 9) / 3);
        var pBasePortionPerUnit = baseRate + (pExtraCards * cardRate);
        var pAddOnPortionPerUnit = p.Price - pBasePortionPerUnit;

        tBaseRev += p.Sold * pBasePortionPerUnit;
        tExtraRev += p.Sold * pAddOnPortionPerUnit;
        tExtraCards += p.Sold * (pSize - 9);
    }
    
    var tFloorRev = Sheets.Sum(s => s.ManualSold * s.Price);
    var tFloorCount = Sheets.Sum(s => s.ManualSold);
    var tGrandRev = tBaseRev + tExtraRev + tFloorRev;

    <div class="full-screen-summary animate-fade-in">
        <div class="summary-header d-flex justify-content-between align-items-center px-4 py-3 bg-white border-bottom">
            <div class="d-flex align-items-center gap-3">
                <div class="summary-icon-box bg-primary text-white">
                    <i class="bi bi-graph-up-arrow"></i>
                </div>
                <div>
                    <h4 class="fw-black mb-0 text-uppercase">Bingo Session Summary</h4>
                    <span class="text-muted extra-small fw-bold">@SessionDate.ToLongDateString() | @tSold TOTAL PLAYERS</span>
                </div>
            </div>
            <button class="btn btn-light rounded-pill px-4 fw-black border-2" @onclick="() => _showAdmissionAudit = false">
                <i class="bi bi-x-lg me-2"></i> CLOSE SUMMARY
            </button>
        </div>

        <div class="summary-content flex-grow-1 p-4 overflow-auto">
            <div class="container-fluid px-0">
                <!-- TOP LEVEL KPI CARDS -->
                <div class="row g-3 mb-4">
                    <div class="col-lg col-md-4">
                        <div class="kpi-card">
                            <label>TOTAL GROSS RECEIPTS</label>
                            <div class="val">@TotalGross.ToString("C2")</div>
                            <span class="text-muted fw-bold" style="font-size: 0.55rem; display: block; margin-top: 2px;">BINGO RECEIPTS (PULL TABS EXCLUDED)</span>
                        </div>
                    </div>
                    <div class="col-lg col-md-4">
                        <div class="kpi-card">
                            <label>TOTAL PRIZES PAID</label>
                            <div class="val text-danger">@TotalPrizes.ToString("C2")</div>
                            <span class="text-muted fw-bold" style="font-size: 0.55rem; display: block; margin-top: 2px;">BINGO GAMES: @(Sheets.Sum(s => s.Games.Sum(g => CalculateGamePayout(s, g))).ToString("C2")) | DOOR PRIZES: @((_doorPrizeAmount * _doorPrizeCount).ToString("C2"))</span>
                        </div>
                    </div>
                    <div class="col-lg col-md-4">
                        <div class="kpi-card text-muted">
                            <label>TOTAL LOTTERY FEES</label>
                            <div class="val text-muted">@TotalLotteryTake.ToString("C2")</div>
                            <span class="text-muted fw-bold" style="font-size: 0.55rem; display: block; margin-top: 2px;">BINGO FEES (PULL TABS EXCLUDED)</span>
                        </div>
                    </div>
                    <div class="col-lg col-md-6">
                        <div class="kpi-card text-warning" style="border-color: rgba(245,158,11,0.2); background: rgba(245,158,11,0.03);">
                            <label class="text-warning">TOTAL OVER/SHORT & BREAKAGE</label>
                            <div class="val text-warning">@((TotalSessionBreakage + TotalPullTabOverShort).ToString("C2"))</div>
                            <span class="text-muted fw-bold" style="font-size: 0.55rem; display: block; margin-top: 2px;">BREAKAGE: @TotalSessionBreakage.ToString("C2") | PULL TABS O/S: @TotalPullTabOverShort.ToString("C2")</span>
                        </div>
                    </div>
                    <div class="col-lg col-md-6">
                        <div class="kpi-card highlight">
                            <label>NET CLUB PROFIT</label>
                            <div class="val">@((TotalClubTake + TotalPullTabNet).ToString("C2"))</div>
                            <span class="text-white-50 fw-bold" style="font-size: 0.55rem; display: block; margin-top: 2px;">BINGO: @TotalClubTake.ToString("C2") | PULL TABS: @TotalPullTabNet.ToString("C2")</span>
                        </div>
                    </div>
                </div>

                <div class="row g-4">
                    <!-- LEFT COLUMN: ACCOUNTING & ADMISSIONS -->
                    <div class="col-lg-4">
                        <div class="summary-section-card h-100">
                            <div class="section-header-compact">
                                <i class="bi bi-cash-coin me-2"></i> ADMISSION ACCOUNTING
                            </div>
                            <div class="p-3">
                                <div class="accounting-row">
                                    <div>
                                        <span class="d-block">Core Admission Fees</span>
                                        <small class="text-muted fw-bold" style="font-size: 0.6rem;">@tSold PLAYERS @@ @baseRate.ToString("C2")</small>
                                    </div>
                                    <span class="fw-black">@tBaseRev.ToString("C2")</span>
                                </div>
                                <div class="accounting-row">
                                    <div>
                                        <span class="d-block">Included Special Cards</span>
                                        <small class="text-muted fw-bold" style="font-size: 0.6rem;">VALUE WITHIN ADMISSION PACKS</small>
                                    </div>
                                    <span class="fw-black">@tExtraRev.ToString("C2")</span>
                                </div>
                                <div class="accounting-row mb-3">
                                    <div>
                                        <span class="d-block">Separately Purchased</span>
                                        <small class="text-muted fw-bold" style="font-size: 0.6rem;">ADDITIONAL FLOOR SALES (@tFloorCount SHEETS)</small>
                                    </div>
                                    <span class="fw-black">@tFloorRev.ToString("C2")</span>
                                </div>
                                <div class="p-2 bg-light rounded-3 mb-3" style="font-size: 0.75rem;">
                                    <div class="d-flex justify-content-between mb-1 text-muted">
                                        <span>Base 9-Pack Rate</span>
                                        <span>@baseRate.ToString("C2")</span>
                                    </div>
                                    <div class="d-flex justify-content-between text-muted">
                                        <span>Extra Square Rate (3 Sq)</span>
                                        <span>@cardRate.ToString("C2")</span>
                                    </div>
                                </div>
                                <div class="accounting-total text-primary">
                                    <span>Total Session Revenue</span>
                                    <span>@tGrandRev.ToString("C2")</span>
                                </div>
                            </div>

                            <div class="section-header-compact mt-3">
                                <i class="bi bi-info-circle me-2"></i> PAYOUT SCALING
                            </div>
                            <div class="p-3">
                                <div class="p-3 rounded-4 @(currentScaling < 100 ? "bg-warning bg-opacity-10 border border-warning" : "bg-success bg-opacity-10 border border-success")">
                                    <div class="fw-black text-uppercase mb-1" style="font-size: 0.7rem;">Active Payout Scale</div>
                                    <div class="d-flex align-items-baseline gap-2">
                                        <span class="fs-2 fw-black">@currentScaling.ToString("N1")%</span>
                                        <span class="extra-small fw-bold text-muted">(@tSold Players)</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- RIGHT COLUMN: SHEET PERFORMANCE TABLE -->
                    <div class="col-lg-8">
                        <div class="summary-section-card h-100">
                            <div class="section-header-compact">
                                <i class="bi bi-grid-3x3-gap-fill me-2"></i> COLOR SHEET PERFORMANCE
                            </div>
                            <div class="p-0">
                                <table class="table summary-table-detailed mb-0">
                                    <thead>
                                        <tr>
                                            <th>SHEET COLOR</th>
                                            <th class="text-center">MODE</th>
                                            <th class="text-center">ADMISSION</th>
                                            <th class="text-center">ADDITIONAL</th>
                                            <th class="text-center">TOTAL SOLD</th>
                                            <th class="text-end">GROSS</th>
                                            <th class="text-end">PRIZES</th>
                                            <th class="text-end">NET PROFIT</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @{
                                            var standardSheets = Sheets.Where(s => s.IsAdmissionOnly).ToList();
                                            var otherSheets = Sheets.Where(s => !s.IsAdmissionOnly).ToList();
                                            
                                            if (standardSheets.Any())
                                            {
                                                var totalStdGross = standardSheets.Sum(s => GetAllocatedAdmissionGross(s) + (s.ManualSold * s.Price));
                                                var totalStdPrizes = standardSheets.Sum(s => s.Games.Sum(g => CalculateGamePayout(s, g)));
                                                var totalStdNet = standardSheets.Sum(CalculateSheetNet);
                                                var totalStdAdmission = AdmissionCount;

                                                <tr class="bg-primary bg-opacity-5" @onclick="() => _isStdExpanded = !_isStdExpanded" style="cursor: pointer;">
                                                    <td>
                                                        <div class="d-flex align-items-center gap-2">
                                                            <i class="bi @(_isStdExpanded ? "bi-chevron-down" : "bi-chevron-right") text-primary"></i>
                                                            <div class="color-dot bg-primary"></div>
                                                            <span class="fw-black text-uppercase text-primary">STANDARD PROGRAM</span>
                                                            <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25" style="font-size: 0.55rem; padding: 2px 6px;">@standardSheets.Count COLORS</span>
                                                        </div>
                                                    </td>
                                                    <td class="text-center"><span class="extra-small fw-bold text-muted">FIXED/BASE</span></td>
                                                    <td class="text-center">@totalStdAdmission</td>
                                                    <td class="text-center">0</td>
                                                    <td class="text-center fw-bold">@totalStdAdmission</td>
                                                    <td class="text-end fw-black text-primary">@totalStdGross.ToString("C2")</td>
                                                    <td class="text-end fw-black text-danger">@totalStdPrizes.ToString("C2")</td>
                                                    <td class="text-end fw-black text-success">@totalStdNet.ToString("C2")</td>
                                                </tr>

                                                @if (_isStdExpanded)
                                                {
                                                    @foreach (var s in standardSheets)
                                                    {
                                                        var sPrizes = s.Games.Sum(g => CalculateGamePayout(s, g));
                                                        var sNet = CalculateSheetNet(s);
                                                        var sGross = GetAllocatedAdmissionGross(s);

                                                        <tr class="bg-light bg-opacity-50 extra-small" @onclick="() => OpenSheetFromSummary(s)">
                                                            <td class="ps-5">
                                                                <div class="d-flex align-items-center gap-2">
                                                                    <div class="color-dot" style="background: @s.DisplayColor; width: 8px; height: 8px;"></div>
                                                                    <span class="fw-bold">@s.ColorName</span>
                                                                </div>
                                                            </td>
                                                            <td class="text-center text-muted">FIXED</td>
                                                            <td class="text-center">@AdmissionCount</td>
                                                            <td class="text-center">-</td>
                                                            <td class="text-center">@AdmissionCount</td>
                                                            <td class="text-end text-muted">@sGross.ToString("C2")</td>
                                                            <td class="text-end text-danger fw-bold">@sPrizes.ToString("C2")</td>
                                                            <td class="text-end fw-bold text-success">@sNet.ToString("C2")</td>
                                                        </tr>
                                                    }
                                                }
                                            }

                                            @foreach (var s in otherSheets)
                                            {
                                                var sAdmission = s.IsIncludedInAdmission ? AdmissionCount : 0;
                                                var sManual = s.ManualSold;
                                                var sGross = GetAllocatedAdmissionGross(s) + (sManual * s.Price);
                                                var sPrizes = s.Games.Sum(g => CalculateGamePayout(s, g));
                                                var sNet = CalculateSheetNet(s);
                                                
                                                <tr class="summary-row-clickable" @onclick="() => OpenSheetFromSummary(s)">
                                                    <td>
                                                        <div class="d-flex align-items-center gap-2">
                                                            <div class="color-dot" style="background: @s.DisplayColor"></div>
                                                            <span class="fw-black text-uppercase">@s.ColorName</span>
                                                            @if (s.IsIncludedInAdmission)
                                                            {
                                                                <span class="badge bg-info bg-opacity-10 text-info border border-info border-opacity-25" style="font-size: 0.55rem; padding: 2px 6px;">INCLUDED</span>
                                                            }
                                                        </div>
                                                    </td>
                                                    <td class="text-center">
                                                        <span class="extra-small fw-bold text-muted">
                                                            @(s.PayoutMode == 0 ? "FIXED" : s.PayoutMode == 1 ? "50/50" : "GROSS %")
                                                        </span>
                                                    </td>
                                                    <td class="text-center">@sAdmission</td>
                                                    <td class="text-center">@(sManual > 0 ? sManual.ToString() : "0")</td>
                                                    <td class="text-center fw-bold">@(sAdmission + sManual)</td>
                                                    <td class="text-end fw-bold">@sGross.ToString("C2")</td>
                                                    <td class="text-end fw-bold text-danger">@sPrizes.ToString("C2")</td>
                                                    <td class="text-end fw-black @(sNet >= 0 ? "text-success" : "text-danger")">@sNet.ToString("C2")</td>
                                                </tr>
                                            }

                                            @if (_doorPrizeAmount > 0 && _doorPrizeCount > 0)
                                            {
                                                <tr class="bg-light bg-opacity-25">
                                                    <td>
                                                        <div class="d-flex align-items-center gap-2">
                                                            <div class="color-dot bg-pink" style="background: #ec4899; width: 10px; height: 10px; border-radius: 50%;"></div>
                                                            <span class="fw-black text-uppercase text-pink" style="color: #ec4899 !important;">DOOR PRIZES</span>
                                                        </div>
                                                    </td>
                                                    <td class="text-center"><span class="extra-small fw-bold text-muted">SPECIAL</span></td>
                                                    <td class="text-center">-</td>
                                                    <td class="text-center">@_doorPrizeCount</td>
                                                    <td class="text-center fw-bold">@_doorPrizeCount</td>
                                                    <td class="text-end fw-bold">-</td>
                                                    <td class="text-end fw-black text-danger">@((_doorPrizeAmount * _doorPrizeCount).ToString("C2"))</td>
                                                    <td class="text-end fw-black text-danger">-@((_doorPrizeAmount * _doorPrizeCount).ToString("C2"))</td>
                                                </tr>
                                            }
                                        }
                                    </tbody>
                                    <tfoot>
                                        <tr class="table-light">
                                            <th colspan="2">SESSION TOTALS</th>
                                            <th class="text-center">@AdmissionCount <br/><small class="text-muted">PLAYERS</small></th>
                                            <th class="text-center">@Sheets.Sum(s => s.ManualSold) <br/><small class="text-muted">ADDITIONAL</small></th>
                                            <th></th>
                                            <th class="text-end">@TotalGross.ToString("C2")</th>
                                            <th class="text-end text-danger">@TotalPrizes.ToString("C2")</th>
                                            <th class="text-end text-success fs-5">@TotalClubTake.ToString("C2")</th>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>
                            
                            <div class="section-header-compact mt-4">
                                <i class="bi bi-ticket-detailed-fill me-2"></i> PULL TAB PERFORMANCE
                            </div>
                            <div class="table-responsive bg-white">
                                <table class="table summary-table-detailed mb-0" style="font-size: 0.75rem;">
                                    <thead>
                                        <tr>
                                            <th class="ps-3">GAME TYPE / SELLER</th>
                                            <th>SERIAL</th>
                                            <th class="text-center">SOLD</th>
                                            <th class="text-end">GROSS</th>
                                            <th class="text-end">PRIZES</th>
                                            <th class="text-end">START BANK</th>
                                            <th class="text-end">CASH RCVD</th>
                                            <th class="text-end">NET PROFIT</th>
                                            <th class="text-end">OVER/SHORT</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (!_pullTabEntries.Any())
                                        {
                                            <tr>
                                                <td colspan="9" class="text-center text-muted py-3">No Pull Tab entries recorded for this session.</td>
                                            </tr>
                                        }
                                        else
                                        {
                                            @foreach (var entry in _pullTabEntries)
                                            {
                                                var def = _pullTabDefinitions.FirstOrDefault(d => d.Id == entry.GameDefinitionId);
                                                var ticketsSold = GetTicketsSold(entry);
                                                var gross = GetGrossReceipts(entry);
                                                var net = GetNetCashDue(entry);
                                                var overShort = GetOverShort(entry);
                                                var netProfit = gross - entry.PrizesPaid;
                                                <tr>
                                                    <td class="ps-3 py-2">
                                                        <span class="badge rounded-pill text-white me-2" style="background: #8b5cf6; font-size: 0.6rem;">@(def?.GameName ?? "Unknown")</span>
                                                        <span class="fw-bold">@entry.SellerName</span>
                                                    </td>
                                                    <td class="py-2">@entry.SerialNumber</td>
                                                    <td class="text-center fw-bold py-2">@ticketsSold <small class="text-muted">(@entry.TicketsIssued/@entry.TicketsReturned)</small></td>
                                                    <td class="text-end fw-bold py-2">@gross.ToString("C2")</td>
                                                    <td class="text-end text-danger fw-bold py-2">@entry.PrizesPaid.ToString("C2")</td>
                                                    <td class="text-end text-muted py-2">@entry.StartingBank.ToString("C2")</td>
                                                    <td class="text-end py-2">@entry.CashReceived.ToString("C2")</td>
                                                    <td class="text-end text-success fw-bold py-2">@netProfit.ToString("C2")</td>
                                                    <td class="text-end fw-black py-2 @(overShort < 0 ? "text-danger" : "text-success")">@overShort.ToString("C2")</td>
                                                </tr>
                                            }
                                        }
                                    </tbody>
                                    <tfoot>
                                        <tr class="table-light">
                                            <th colspan="2" class="ps-3">PULL TAB TOTALS</th>
                                            <th class="text-center">@_pullTabEntries.Sum(GetTicketsSold)</th>
                                            <th class="text-end text-purple">@TotalPullTabSales.ToString("C2")</th>
                                            <th class="text-end text-danger">@TotalPullTabPrizes.ToString("C2")</th>
                                            <th class="text-end text-muted">@_pullTabEntries.Sum(e => e.StartingBank).ToString("C2")</th>
                                            <th class="text-end">@_pullTabEntries.Sum(e => e.CashReceived).ToString("C2")</th>
                                            <th class="text-end text-success">@((TotalPullTabSales - TotalPullTabPrizes).ToString("C2"))</th>
                                            <th class="text-end fw-black @(TotalPullTabOverShort < 0 ? "text-danger" : "text-success")">@TotalPullTabOverShort.ToString("C2")</th>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- GAME BY GAME DETAILS -->
                <div class="row mt-4 mb-5">
                    <div class="col-12">
                        <div class="summary-section-card">
                            <div class="section-header-compact">
                                <i class="bi bi-list-stars me-2"></i> INDIVIDUAL GAME PAYOUT DETAILS
                            </div>
                            <div class="p-3">
                                <div class="row g-3">
                                    @foreach (var s in Sheets)
                                    {
                                        <div class="col-md-6 col-lg-3">
                                            <div class="game-group-box border rounded-4 p-3 h-100">
                                                <div class="d-flex align-items-center gap-2 mb-2 pb-2 border-bottom">
                                                    <div class="color-dot" style="background: @s.DisplayColor"></div>
                                                    <span class="fw-black text-uppercase" style="font-size: 0.75rem;">@s.ColorName</span>
                                                </div>
                                                @foreach (var g in s.Games)
                                                {
                                                    var totalPayout = CalculateGamePayout(s, g);
                                                    var perWinner = g.WinnerCount > 0 ? totalPayout / g.WinnerCount : totalPayout;
                                                    
                                                    <div class="mb-2 border-bottom border-light pb-1">
                                                        <div class="d-flex justify-content-between align-items-center extra-small">
                                                            <span class="text-muted fw-bold">@g.Name</span>
                                                            <span class="fw-black text-primary">@totalPayout.ToString("C2")</span>
                                                        </div>
                                                        @if (g.WinnerCount > 1)
                                                        {
                                                            <div class="d-flex justify-content-between align-items-center mt-2" style="font-size: 0.8rem;">
                                                                <span class="badge bg-primary text-white py-1 px-2 fw-black shadow-sm">
                                                                    <i class="bi bi-people-fill me-1"></i> @g.WinnerCount WINNERS
                                                                </span>
                                                                <span class="text-primary fw-black">@perWinner.ToString("C2") EACH</span>
                                                            </div>
                                                        }
                                                        else if (g.WinnerCount == 1)
                                                        {
                                                            <div class="mt-1 text-muted fw-bold" style="font-size: 0.7rem;">
                                                                <i class="bi bi-person-fill"></i> SINGLE WINNER
                                                            </div>
                                                        }
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@if (_showScalingTiers)
{
    <div class="modal-backdrop-custom animate-fade-in" style="z-index: 7000;" @onclick="() => _showScalingTiers = false"></div>
    <div class="sheet-detail-modal animate-zoom-in" style="z-index: 7500; max-width: 400px; border-top: 8px solid #1e293b;">
        <div class="detail-header bg-dark text-white">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h3 class="fw-black text-uppercase mb-0" style="letter-spacing: -0.02em;">Payout Scaling</h3>
                    <span class="badge bg-white bg-opacity-20 rounded-pill px-3 py-1 fw-bold text-uppercase" style="font-size: 0.6rem;">@(_useManualScaling ? "Manual Mode" : "Attendance Rules")</span>
                </div>
                <button class="btn btn-link text-white p-0 border-0 fs-3" @onclick="() => _showScalingTiers = false">
                    <i class="bi bi-x-circle-fill"></i>
                </button>
            </div>
        </div>
        <div class="detail-body p-0">
            @if (_useManualScaling)
            {
                <div class="p-4 bg-light border-bottom text-center">
                    <div class="text-muted fw-bold extra-small text-uppercase mb-1">Active Scaling Mode</div>
                    <div class="h5 fw-black text-danger text-uppercase mb-0">MANUAL OVERRIDE</div>
                </div>
                <div class="p-4" style="background: white;">
                    <div class="d-flex justify-content-between align-items-center p-3 mb-2 rounded-4 bg-danger text-white shadow-lg border-0" 
                         style="transition: all 0.2s;">
                        <div class="d-flex align-items-center gap-3">
                            <div class="rounded-circle d-flex align-items-center justify-content-center bg-white text-danger" style="width: 40px; height: 40px;">
                                <i class="bi bi-sliders fs-5"></i>
                            </div>
                            <div>
                                <div class="fw-black text-uppercase" style="font-size: 0.8rem;">Manual Rate</div>
                                <div class="fw-bold extra-small text-white-50">CURRENT ACTIVE OVERRIDE</div>
                            </div>
                        </div>
                        <div class="text-end">
                            <div class="fs-4 fw-black">@_payoutPercentage.ToString("N0")%</div>
                            <div class="fw-bold extra-small text-white-50">PRIZE RATE</div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center p-3 mb-2 rounded-4 bg-light border border-light-subtle">
                        <div class="d-flex align-items-center gap-3">
                            <div class="rounded-circle d-flex align-items-center justify-content-center bg-primary bg-opacity-10 text-primary" style="width: 40px; height: 40px;">
                                <i class="bi bi-percent fs-5"></i>
                            </div>
                            <div>
                                <div class="fw-black text-uppercase text-dark" style="font-size: 0.8rem;">Target Profit Margin</div>
                                <div class="fw-bold extra-small text-muted">MARGIN FROM ADMISSIONS</div>
                            </div>
                        </div>
                        <div class="text-end">
                            <div class="fs-4 fw-black text-primary">@_targetProfitPercentage.ToString("F0")%</div>
                            <div class="fw-bold extra-small text-muted">DESIRED PROFIT</div>
                        </div>
                    </div>
                </div>
                <div class="p-4 pt-0">
                    <div class="alert alert-warning py-2 rounded-3 border-0 mb-4" style="font-size: 0.65rem;">
                        <i class="bi bi-exclamation-triangle-fill me-1"></i>
                        Prizes are currently scaling by the manually configured rate of @_payoutPercentage% instead of automatic attendance rules.
                        <strong>Target Profit Margin (@_targetProfitPercentage.ToString("F0")%):</strong> Represents the desired profit margin of admission revenues. Changing the Target Profit Margin automatically recalculates the Payout Scale required, and vice versa.
                    </div>
                    <button class="btn btn-dark w-100 py-3 rounded-pill fw-black shadow-lg" @onclick="() => _showScalingTiers = false">
                        CLOSE RULES
                    </button>
                </div>
            }
            else
            {
                <div class="p-4 bg-light border-bottom text-center">
                    <div class="text-muted fw-bold extra-small text-uppercase mb-1">Current Session Attendance</div>
                    <div class="display-5 fw-black text-primary">@AdmissionCount</div>
                    <div class="fw-bold text-primary opacity-75 small">PLAYERS</div>
                </div>
                <div class="p-4" style="background: white;">
                    @foreach (var tier in _bingoSettings.PayoutTiers.OrderBy(t => t.MinAdmissions))
                    {
                        var isCurrent = tier == GetCurrentTier();
                        <div class="d-flex justify-content-between align-items-center p-3 mb-2 rounded-4 @(isCurrent ? "bg-primary text-white shadow-lg border-0" : "bg-light border border-light-subtle")" 
                             style="transition: all 0.2s;">
                            <div class="d-flex align-items-center gap-3">
                                <div class="rounded-circle d-flex align-items-center justify-content-center @(isCurrent ? "bg-white text-primary" : "bg-secondary bg-opacity-10 text-secondary")" style="width: 40px; height: 40px;">
                                    <i class="bi @(isCurrent ? "bi-check-lg" : "bi-people-fill") fs-5"></i>
                                </div>
                                <div>
                                    <div class="fw-black text-uppercase" style="font-size: 0.85rem;">@(tier.MinAdmissions)+ Players</div>
                                    <div class="fw-bold extra-small @(isCurrent ? "text-white-50" : "text-muted")">@(isCurrent ? "CURRENT ACTIVE TIER" : "Minimum Requirement")</div>
                                </div>
                            </div>
                            <div class="text-end">
                                <div class="fs-4 fw-black">@tier.PayoutPercentage.ToString("N0")%</div>
                                <div class="fw-bold extra-small @(isCurrent ? "text-white-50" : "text-muted")">PRIZE RATE</div>
                            </div>
                        </div>
                    }
                </div>
                <div class="p-4 pt-0">
                    <div class="alert alert-info py-2 rounded-3 border-0 mb-4" style="font-size: 0.65rem;">
                        <i class="bi bi-info-circle-fill me-1"></i>
                        Prizes scale automatically based on total admissions sold to ensure session stability.
                        <strong>Target Profit Margin:</strong> In manual mode, you can customize standard payout scaling to target a specific profit percentage on admission sales.
                    </div>
                    <button class="btn btn-dark w-100 py-3 rounded-pill fw-black shadow-lg" @onclick="() => _showScalingTiers = false">
                        CLOSE RULES
                    </button>
                </div>
            }
        </div>
    </div>
}

