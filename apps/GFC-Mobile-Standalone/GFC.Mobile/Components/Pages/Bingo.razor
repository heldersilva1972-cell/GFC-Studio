    private async Task StartSession()
    {
        await CheckForBlockingOpenSessionAsync();
        if (_hasBlockingOpenSession)
        {
            await ShowToast("Blocked", "Cannot start session while another session is open.", "error");
            return;
        }
        _sessionState = "Open";
        await SaveDraftAsync();
        await ShowToast("Session Opened", "Bingo session has been successfully opened for today.");
    }

    private void PromptCancelSession()
    {
        _showCancelSessionConfirmation = true;
        StateHasChanged();
    }

    private async Task CancelActiveSessionAsync()
    {
        _showCancelSessionConfirmation = false;
        
        // 1. Delete local draft
        var key = $"gfc_bingo_draft_{SessionDate:yyyyMMdd}";
        await JSRuntime.InvokeVoidAsync("window.gfcSetAsync", key, (object?)null);
        
        // 2. Call backend delete session endpoint if online
        try
        {
            var success = await ReportingService.CancelBingoSessionAsync(SessionDate);
            if (success)
            {
                await ShowToast("Session Cancelled", "The session draft was successfully removed from the server.");
            }
            else
            {
                await ShowToast("Cleared Locally", "Draft cleared locally, but server cancellation was offline.", "warning");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[BINGO] Error calling cancel endpoint: {ex.Message}");
            await ShowToast("Cleared Locally", "Draft cleared locally, but server cancellation failed.", "warning");
        }

        // 3. Reset all variables
        _sessionState = "NotStarted";
        _sessionEntered = false;
        foreach (var p in AdmissionPacks)
        {
            p.Sold = 0;
        }
        foreach (var s in Sheets)
        {
            s.ManualSold = 0;
            s.IsClosedOut = false;
            s.IsSynced = false;
            foreach (var g in s.Games)
            {
                g.WinnerCount = 1;
                g.BallsCalled = 0;
                g.CustomPayoutOverride = null;
            }
        }
        RecalculateSheetTotals();
        _needsSync = false;
        
        await CheckForBlockingOpenSessionAsync();
        StateHasChanged();
    }

    private async Task UnlockSession()
    {
        await CheckForBlockingOpenSessionAsync();
        if (_hasBlockingOpenSession)
        {
            await ShowToast("Blocked", "Cannot unlock session while another session is open.", "error");
            return;
        }
        _sessionState = "Open";
        foreach (var s in Sheets) s.IsClosedOut = false;
        await SaveDraftAsync();
        await ShowToast("Session Unlocked", "You can now make corrections. Remember to lock it when finished.", "info");
    }

    private async Task CloseEntireSession()
    {
        // 1. Total Attendance Check
        var totalAttendance = AdmissionPacks.Sum(p => p.Sold);
        if (totalAttendance <= 0)
        {
            await JSRuntime.InvokeVoidAsync("Swal.fire", new {
                title = "Lock Blocked",
                text = "Cannot lock a session with 0 total attendance.",
                icon = "error",
                confirmButtonText = "OK"
            });
            return;
        }

        // 2. Progressive Games Ball Count Check
        var missingProgressives = new List<string>();
        foreach (var s in Sheets)
        {
            foreach (var g in s.Games)
            {
                if (g.IsProgressive && g.BallsCalled <= 0)
                {
                    missingProgressives.Add($"{s.ColorName} - {g.Name}");
                }
            }
        }

        if (missingProgressives.Any())
        {
            var msg = "Please enter the balls called for these progressive games: " + string.Join(", ", missingProgressives);
            await JSRuntime.InvokeVoidAsync("Swal.fire", new {
                title = "Balls Called Required",
                text = msg,
                icon = "error",
                confirmButtonText = "OK"
            });
            return;
        }

        _sessionState = "Closed";
        foreach (var s in Sheets) s.IsClosedOut = true;
        
        await SaveDraftAsync();
        
        var session = PrepareSessionObject();
        session.Status = "Closed";
        
        try
        {
            var success = await ReportingService.SubmitBingoSessionAsync(session, _currentUsername);
            if (success)
            {
                foreach (var s in Sheets) s.IsSynced = true;
                await SaveDraftAsync();
                await ShowToast("Session Locked & Synced", "All games closed out and finalized to the server!");
            }
            else
            {
                await ShowToast("Session Locked", "Saved locally in offline mode. Will sync when online.", "warning");
            }
        }
        catch
        {
            await ShowToast("Session Locked", "Saved locally in offline mode. Will sync when online.", "warning");
        }
        
        await CheckForBlockingOpenSessionAsync();
        StateHasChanged();
    }

    private async Task ActivateField(string field)
    {
        if (_sessionState == "Closed")
        {
            await ShowToast("Session Locked", "This session is finalized. Tap 'UNLOCK' to make corrections.", "warning");
            return;
        }

        _activeField = field;
        _currentBuffer = "";
        _showFloatingKeypad = true;

        // Auto-scroll modal row into view
        if (_showFloorSalesPopup && field.EndsWith("_Sold"))
        {
            var color = field.Split('_')[0];
            await JSRuntime.InvokeVoidAsync("eval", $"document.getElementById('floor-row-{color}')?.scrollIntoView({{ behavior: 'smooth', block: 'center' }})");
        }
        else if (_showAdmissionPopup && field.StartsWith("Pack_"))
        {
            var id = field.Replace("Pack_", "");
            await JSRuntime.InvokeVoidAsync("eval", $"document.getElementById('admin-row-{id}')?.scrollIntoView({{ behavior: 'smooth', block: 'center' }})");
        }
        else if (_selectedSheet != null && (field.Contains("_Winner_") || field.Contains("_Override_") || field.Contains("_Balls_")))
        {
            var parts = field.Split('_');
            var color = parts[0];
            var idx = parts[2];
            await JSRuntime.InvokeVoidAsync("eval", $"document.getElementById('game-row-{color}-{idx}')?.scrollIntoView({{ behavior: 'smooth', block: 'center' }})");
        }
    }

    private void KeyPressed(string key)
    {
        _currentBuffer += key;
        UpdateFieldValue();
        _ = SaveDraftAsync();
    }

    private void BackspaceCurrentField()
    {
        if (_currentBuffer.Length > 0)
        {
            _currentBuffer = _currentBuffer.Substring(0, _currentBuffer.Length - 1);
            UpdateFieldValue();
            _ = SaveDraftAsync();
        }
    }

    private void UpdateFieldValue()
    {
        if (_activeField.StartsWith("Pack_"))
        {
            if (int.TryParse(_activeField.Replace("Pack_", ""), out var id))
            {
                var pack = AdmissionPacks.FirstOrDefault(p => p.Id == id);
                if (pack != null)
                {
                    if (int.TryParse(_currentBuffer, out var val)) pack.Sold = val;
                    else pack.Sold = 0;
                    
                    RecalculateSheetTotals();
                    _needsSync = true;
                }
            }
        }
        else if (_activeField.Contains("_Winner_"))
        {
            var parts = _activeField.Split('_');
            var color = parts[0];
            var gameIdx = int.Parse(parts[2]);
            
            var sheet = Sheets.FirstOrDefault(s => s.ColorName == color);
            if (sheet != null && gameIdx < sheet.Games.Count)
            {
                if (int.TryParse(_currentBuffer, out var val)) sheet.Games[gameIdx].WinnerCount = val;
                else sheet.Games[gameIdx].WinnerCount = 1;
                
                RecalculateSheetTotals();
            }
        }
        else if (_activeField.Contains("_Override_"))
        {
            var parts = _activeField.Split('_');
            var color = parts[0];
            var gameIdx = int.Parse(parts[2]);
            
            var sheet = Sheets.FirstOrDefault(s => s.ColorName == color);
            if (sheet != null && gameIdx < sheet.Games.Count)
            {
                var game = sheet.Games[gameIdx];
                var originalShare = CalculateGamePayoutRoundedShare(sheet, game);

                if (decimal.TryParse(_currentBuffer, out var val))
                {
                    if (val < originalShare)
                    {
                        game.CustomPayoutOverride = null;
                        _ = ShowToast("Below Minimum", $"Payout cannot be less than the calculated system share of {originalShare:C2}.", "warning");
                    }
                    else
                    {
                        game.CustomPayoutOverride = val;
                    }
                }
                else
                {
                    game.CustomPayoutOverride = null;
                }
                
                RecalculateSheetTotals();
            }
        }
        else if (_activeField.Contains("_Balls_"))
        {
            var parts = _activeField.Split('_');
            var color = parts[0];
            var gameIdx = int.Parse(parts[2]);
            
            var sheet = Sheets.FirstOrDefault(s => s.ColorName == color);
            if (sheet != null && gameIdx < sheet.Games.Count)
            {
                if (int.TryParse(_currentBuffer, out var val)) sheet.Games[gameIdx].BallsCalled = val;
                else sheet.Games[gameIdx].BallsCalled = 0;
            }
        }
        else
        {
            var parts = _activeField.Split('_');
            var color = parts[0];
            var type = parts[1];
            
            var sheet = Sheets.FirstOrDefault(s => s.ColorName == color);
            if (sheet == null) return;

            if (type == "Sold")
            {
                if (decimal.TryParse(_currentBuffer, out var val))
                {
                    if (_entryModeIsDollars)
                    {
                        sheet.ManualSold = (int)(val / sheet.Price);
                    }
                    else
                    {
                        sheet.ManualSold = (int)val;
                    }
                }
                else
                {
                    sheet.ManualSold = 0;
                }
                
                RecalculateSheetTotals();
                _needsSync = true;
            }
        }
    }

    private void RecalculateSheetTotals()
    {
        foreach (var sheet in Sheets)
        {
            // Reset to manual entry
            sheet.Sold = sheet.ManualSold;
            
            // Add quantity from ALL admission packs IF this sheet is marked as "Included in Admission"
            if (sheet.IsIncludedInAdmission)
            {
                sheet.Sold += AdmissionPacks.Sum(p => p.Sold);
            }
            
            // Recalculate payouts for all games in this sheet
            foreach(var g in sheet.Games) g.Payout = CalculateGamePayout(sheet, g);
        }
    }

    private void HandleNext()
    {
        if (_activeField.StartsWith("Pack_"))
        {
            if (int.TryParse(_activeField.Replace("Pack_", ""), out var id))
            {
                var index = AdmissionPacks.FindIndex(p => p.Id == id);
                if (index < AdmissionPacks.Count - 1) ActivateField("Pack_" + AdmissionPacks[index + 1].Id);
                else if (_showAdmissionPopup) ActivateField("Pack_" + AdmissionPacks[0].Id); // Loop in modal
                else ActivateField(Sheets[0].ColorName + "_Sold");
            }
        }
        else
        {
            var parts = _activeField.Split('_');
            var color = parts[0];
            var sheetIndex = Sheets.FindIndex(s => s.ColorName == color);
            
            if (_activeField.Contains("_Winner_"))
            {
                var gameIdx = int.Parse(parts[2]);
                ActivateField(color + "_Override_" + gameIdx);
            }
            else if (_activeField.Contains("_Override_"))
            {
                var gameIdx = int.Parse(parts[2]);
                var sheet = Sheets[sheetIndex];
                
                if (sheet.Games[gameIdx].IsProgressive)
                {
                    ActivateField(color + "_Balls_" + gameIdx);
                }
                else
                {
                    // Skip Balls and go to next game or next sheet
                    if (gameIdx < sheet.Games.Count - 1) ActivateField(color + "_Winner_" + (gameIdx + 1));
                    else if (_openedFromSummary) CloseAllModals();
                    else HandleNextSheet(sheetIndex);
                }
            }
            else if (_activeField.Contains("_Balls_"))
            {
                var gameIdx = int.Parse(parts[2]);
                var sheet = Sheets[sheetIndex];
                
                if (gameIdx < sheet.Games.Count - 1)
                {
                    ActivateField(color + "_Winner_" + (gameIdx + 1));
                }
                else
                {
                    // End of games for this sheet
                    if (_openedFromSummary) CloseAllModals();
                    else HandleNextSheet(sheetIndex);
                }
            }
            else // _Sold
            {
                if (_showFloorSalesPopup)
                {
                    var floorSheets = Sheets.Where(s => !s.IsAdmissionOnly).ToList();
                    var floorIdx = floorSheets.FindIndex(s => s.ColorName == color);
                    if (floorIdx != -1 && floorIdx < floorSheets.Count - 1)
                    {
                        ActivateField(floorSheets[floorIdx + 1].ColorName + "_Sold");
                    }
                    else
                    {
                        ActivateField(floorSheets[0].ColorName + "_Sold"); // Loop in modal
                    }
                }
                else
                {
                    if (sheetIndex < Sheets.Count - 1) ActivateField(Sheets[sheetIndex + 1].ColorName + "_Sold");
                    else ActivateField("Pack_" + AdmissionPacks[0].Id);
                }
            }
        }
    }

    private void HandleNextSheet(int currentSheetIndex)
    {
        if (currentSheetIndex < Sheets.Count - 1) ActivateField(Sheets[currentSheetIndex + 1].ColorName + "_Sold");
        else ActivateField("Pack_" + AdmissionPacks[0].Id);
    }

    private async Task OnDateChanged(ChangeEventArgs e)
