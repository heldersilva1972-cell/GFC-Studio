        height: 1.2rem;
        background: var(--bs-primary);
        margin-left: 2px;
        animation: blink 1s infinite;
    }

    @@keyframes blink {
        0%, 100% { opacity: 1; }
        50% { opacity: 0; }
    }

    /* Layout Constraints */
    .tablet-body {
        overflow-y: auto !important;
        height: calc(100vh - 56px) !important;
        margin-top: 56px;
        background: #f8fafc;
        position: relative;
    }

    .status-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
    }

    .status-dot.bg-success { background-color: #198754; box-shadow: 0 0 0 4px rgba(25, 135, 84, 0.1); }
    .status-dot.bg-warning { background-color: #ffc107; box-shadow: 0 0 0 4px rgba(255, 193, 7, 0.1); }

    .tablet-col-left {
        flex: 1;
        width: 100%;
