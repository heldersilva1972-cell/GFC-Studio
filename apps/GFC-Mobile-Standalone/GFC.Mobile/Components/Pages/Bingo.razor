@page "/mobile/bingo"
@using GFC.Mobile.Components.Shared
@using Microsoft.AspNetCore.Authorization
@using GFC.Core.Interfaces
@using GFC.Core.Models
@using GFC.Core.DTOs
@using System.Threading
@inject NavigationManager Navigation
@inject IMobileReportingService ReportingService
@inject IJSRuntime JSRuntime
@inject ICustomAuthenticationStateProvider AuthStateProvider
@attribute [Authorize]

<PageTitle>Bingo Tracking | GFC Mobile</PageTitle>

                <!-- HEADER MERGED INTO HUB HEADER -->
                <MobileHubHeader IsConnected="@_isCircutAlive" Syncing="@_isSyncing" ShiftType="Bingo" Username="@_currentUsername">
                    <div class="d-flex align-items-center gap-3">
                        <div class="d-flex align-items-center bg-white rounded-pill px-3 py-1 border shadow-sm me-1">
                            <div>
                                <label class="d-block mb-0 text-uppercase fw-bold text-muted" style="font-size: 0.45rem; letter-spacing: 0.05em;">Date</label>
                                <input type="date" class="bg-transparent border-0 p-0 fw-black text-primary" style="font-size: 0.8rem; outline: none; width: 120px;" 
                                       value="@SessionDate.ToString("yyyy-MM-dd")" @onchange="OnDateChanged" />
                            </div>
                        </div>


                        
                        <!-- Dedicated Session Directory button: Easy tablet tap target size -->
                        <button class="btn btn-primary rounded-pill px-3 py-2 fw-black d-flex align-items-center gap-2 border-0 shadow-sm" style="font-size: 0.65rem; height: 36px;" @onclick="async () => { await LoadSessionHistoryAsync(); _showDirectoryModal = true; }">
                            <i class="bi bi-calendar3-range-fill"></i> SESSION DIRECTORY
                        </button>

                        <!-- Sleek lock/unlock action button in header -->
                        @if (_sessionState == "Open")
                        {
                            <button class="btn btn-success rounded-pill px-3 py-2 fw-black d-flex align-items-center gap-2 border-0 shadow-sm animate-pulse" style="font-size: 0.6rem;" @onclick="CloseEntireSession">
                                <i class="bi bi-lock-fill"></i> CLOSE & LOCK SESSION
                            </button>
                            <button class="btn btn-danger rounded-pill px-3 py-2 fw-black d-flex align-items-center gap-2 border-0 shadow-sm text-white ms-1" style="font-size: 0.6rem;" @onclick="PromptCancelSession">
                                <i class="bi bi-trash3-fill"></i> CANCEL SESSION
                            </button>
                        }
                        else if (_sessionState == "Closed")
                        {
                            <button class="btn btn-warning rounded-pill px-3 py-2 fw-black d-flex align-items-center gap-2 border-0 shadow-sm text-dark animate-pulse" style="font-size: 0.6rem;" @onclick="UnlockSession">
                                <i class="bi bi-unlock-fill"></i> UNLOCK SESSION
                            </button>
                        }

                        <div class="text-end position-relative" style="cursor: pointer; min-width: 100px;" @onclick="() => _showSummaryDetail = !_showSummaryDetail">
                            <div class="text-uppercase fw-black text-muted d-flex align-items-center justify-content-end" style="font-size: 0.5rem; letter-spacing: 0.1em;">
                                NET <i class="bi @(_showSummaryDetail ? "bi-chevron-up" : "bi-chevron-down") ms-1"></i>
                            </div>
                            @{
                                var headerCombinedNet = TotalNetProceeds + TotalPullTabNet;
                            }
                            <div class="fw-black @(headerCombinedNet < 0 ? "text-danger" : "text-success")" style="font-size: 1rem; line-height: 1;">@headerCombinedNet.ToString("C2")</div>

                            @if (_showSummaryDetail)
                            {
                                <div class="position-fixed top-0 start-0 w-100 h-100" style="z-index: 9990; background: transparent; cursor: default;" @onclick:stopPropagation="true" @onclick="() => _showSummaryDetail = false"></div>
                                <div class="header-summary-dropdown shadow-lg p-3 bg-dark text-white rounded-4 border border-light border-opacity-10" style="min-width: 320px; z-index: 9999;" @onclick:stopPropagation="true">
                                    <div class="detail-row mb-1"><span>Attendance</span> <span class="fw-black">@AdmissionCount</span></div>
                                    <div class="detail-row mb-2 pb-2 border-bottom border-secondary"><span>Gross Revenue</span> <span class="fw-black text-white">@TotalGross.ToString("C2")</span></div>
                                    
                                    <!-- ADMISSIONS SECTION -->
                                    <div class="text-uppercase fw-black text-primary mb-1 text-start" style="font-size: 0.55rem; letter-spacing: 0.05em;">Admissions Program</div>
                                    @{
                                        var totalSpecialsAdmissionGross = Sheets.Where(s => !s.IsAdmissionOnly && s.IsIncludedInAdmission).Sum(s => GetAllocatedAdmissionGross(s));
                                        var admGross = TotalAdmissionRevenue - totalSpecialsAdmissionGross;
                                        var admLottery = Sheets.Where(s => s.IsAdmissionOnly).Sum(s => CalculateLotteryTake(s));
                                        var doorPrizes = _doorPrizeAmount * _doorPrizeCount;
                                        var currentScale = GetCurrentPayoutPercentage();
                                        var admPrizesCurrent = CalculateAdmissionPrizesForPercentage(currentScale);
                                        var admNetCurrent = admGross - admLottery - admPrizesCurrent - doorPrizes;
                                        var currentProfitPct = admGross > 0 ? (admNetCurrent / admGross) * 100m : 0m;
                                        
                                        var breakEvenScale = CalculateRequiredStandardPayoutScale();
                                        var admPrizesBreakEven = CalculateAdmissionPrizesForPercentage(breakEvenScale);
                                        var admNetBreakEven = admGross - admLottery - admPrizesBreakEven - doorPrizes;
                                    }
                                    <div class="detail-row mb-1 ps-2 opacity-75"><span>Gross Revenue</span> <span>@admGross.ToString("C2")</span></div>
                                    <div class="detail-row mb-1 ps-2 opacity-75 text-danger"><span>Lottery Fees</span> <span>-@admLottery.ToString("C2")</span></div>
                                    @if (doorPrizes > 0)
                                    {
                                        <div class="detail-row mb-1 ps-2 opacity-75 text-danger"><span>Door Prizes</span> <span>-@doorPrizes.ToString("C2")</span></div>
                                    }
                                    <div class="detail-row mb-1 ps-2 text-danger">
                                        <span>Prizes Paid (@currentScale.ToString("N0")% Scale)</span>
                                        <span class="fw-bold">-@admPrizesCurrent.ToString("C2")</span>
                                    </div>
                                    <div class="detail-row mb-1 ps-2 @(admNetCurrent < 0 ? "text-danger" : "text-success")">
                                        <span>Net Earnings</span>
                                        <span class="fw-black">@admNetCurrent.ToString("C2")</span>
                                    </div>
                                    <div class="detail-row mb-2 ps-2 @((_useManualScaling && currentScale < 100m) || breakEvenScale < 100m ? "" : "border-bottom border-secondary pb-2 mb-3") @(currentProfitPct < 0 ? "text-danger" : "text-success")" style="font-size: 0.75rem;">
                                        <span>Actual Profit Margin</span>
                                        <span class="fw-bold">@currentProfitPct.ToString("F1")%</span>
                                    </div>
                                    
                                    <!-- Targets & Break-Even Info -->
                                    @if ((_useManualScaling && currentScale < 100m) || breakEvenScale < 100m)
                                    {
                                        <div class="border-bottom border-secondary pb-2 mb-3">
                                            @if (_useManualScaling && currentScale < 100m)
                                            {
                                                <div class="detail-row mb-1 ps-2 opacity-75" style="font-size: 0.7rem;">
                                                    <span>Desired Profit Target</span>
                                                    <span>@_targetProfitPercentage.ToString("F0")%</span>
                                                </div>
                                            }
                                            @if (breakEvenScale < 100m)
                                            {
                                                <div class="detail-row ps-2 opacity-75" style="font-size: 0.7rem;">
                                                    <span>Required Scale to Break-Even</span>
                                                    <span>@breakEvenScale.ToString("N0")%</span>
                                                </div>
                                            }
                                        </div>
                                    }

                                    <!-- SPECIAL GAMES SECTION -->
                                    <div class="text-uppercase fw-black text-warning mb-1 text-start" style="font-size: 0.55rem; letter-spacing: 0.05em;">Special Games (Floor)</div>
                                    @{
                                        var specSheets = Sheets.Where(s => !s.IsAdmissionOnly).ToList();
                                        var specGross = specSheets.Sum(s => GetAllocatedAdmissionGross(s) + (s.ManualSold * s.Price));
                                        var specLottery = specSheets.Sum(s => CalculateLotteryTake(s));
                                        var specPrizes = specSheets.Sum(s => s.Games.Sum(g => CalculateGamePayout(s, g)));
                                        var specNet = specGross - specLottery - specPrizes;
                                        var specProfitPct = specGross > 0 ? (specNet / specGross) * 100m : 0m;
                                    }
                                    <div class="detail-row mb-1 ps-2 opacity-75"><span>Gross Revenue</span> <span>@specGross.ToString("C2")</span></div>
                                    <div class="detail-row mb-1 ps-2 opacity-75 text-danger"><span>Lottery Fees</span> <span>-@specLottery.ToString("C2")</span></div>
                                    <div class="detail-row mb-1 ps-2 text-danger"><span>Prizes Paid</span> <span>-@specPrizes.ToString("C2")</span></div>
                                    <div class="detail-row mb-1 ps-2 @(specNet < 0 ? "text-danger" : "text-success")">
                                        <span>Special Games Net</span>
                                        <span class="fw-black">@specNet.ToString("C2")</span>
                                    </div>
                                    <div class="detail-row mb-2 ps-2 border-bottom border-secondary pb-2 @(specProfitPct < 0 ? "text-danger" : "text-success")" style="font-size: 0.75rem;">
                                        <span>Special Games Margin</span>
                                        <span class="fw-bold">@specProfitPct.ToString("F1")%</span>
                                    </div>
 
                                    <!-- PULL TABS SECTION -->
                                    <div class="text-uppercase fw-black mb-1 text-start" style="font-size: 0.55rem; letter-spacing: 0.05em; color: #8b5cf6;">Pull Tabs</div>
                                    @{
                                        var ptSales = TotalPullTabSales;
                                        var ptPrizes = TotalPullTabPrizes;
                                        var ptOverShort = TotalPullTabOverShort;
                                        var ptNet = TotalPullTabNet;
                                        var ptProfitPct = ptSales > 0 ? (ptNet / ptSales) * 100m : 0m;
                                    }
                                    <div class="detail-row mb-1 ps-2 opacity-75"><span>Gross Sales</span> <span>@ptSales.ToString("C2")</span></div>
                                    <div class="detail-row mb-1 ps-2 opacity-75 text-danger"><span>Prizes Paid</span> <span>-@ptPrizes.ToString("C2")</span></div>
                                    @if (ptOverShort != 0)
                                    {
                                        <div class="detail-row mb-1 ps-2 opacity-75 @(ptOverShort < 0 ? "text-danger" : "text-success")">
                                            <span>Over/Short</span>
                                            <span>@(ptOverShort < 0 ? "-" : "+")@Math.Abs(ptOverShort).ToString("C2")</span>
                                        </div>
                                    }
                                    <div class="detail-row mb-1 ps-2 @(ptNet < 0 ? "text-danger" : "text-success")">
                                        <span>Pull Tabs Net</span>
                                        <span class="fw-black">@ptNet.ToString("C2")</span>
                                    </div>
                                    <div class="detail-row mb-2 ps-2 border-bottom border-secondary pb-2 @(ptProfitPct < 0 ? "text-danger" : "text-success")" style="font-size: 0.75rem;">
                                        <span>Pull Tabs Margin</span>
                                        <span class="fw-bold">@ptProfitPct.ToString("F1")%</span>
                                    </div>
 
                                    @{
                                        var combinedNet = TotalNetProceeds + TotalPullTabNet;
                                    }
                                    <div class="detail-row mb-1 text-warning"><span>Payout Breakage</span> <span class="fw-black">-@TotalSessionBreakage.ToString("C2")</span></div>
                                    <div class="detail-row @(combinedNet < 0 ? "text-danger" : "text-success") pt-2 border-top mt-2"><span>@(combinedNet < 0 ? "TOTAL LOSS" : "TOTAL PROFIT")</span> <span class="fw-black">@combinedNet.ToString("C2")</span></div>
                                </div>
                            }
                        </div>
                    </div>
                </MobileHubHeader>
<div class="tablet-body">
    <div class="glass-page-container mobile-version">
        @if (Loading)
        {
            <div class="d-flex flex-column align-items-center justify-content-center py-5 mt-5">
                <div class="loader-ring mb-3"></div>
                <span class="text-muted fw-bold text-uppercase" style="letter-spacing: 0.1em;">Loading Bingo Session...</span>
            </div>
        }
        @if (_sessionState == "NotStarted" || !_sessionEntered)
        {
            <div class="d-flex flex-column align-items-center justify-content-center py-5 px-3 text-center mx-auto animate-fade-in" style="max-width: 550px; min-height: 60vh;">
                @if (_sessionState == "NotStarted")
                {
                    <div class="premium-splash-icon mb-4">
                        <i class="bi bi-ticket-perforated text-primary animate-pulse" style="font-size: 5rem; opacity: 0.85;"></i>
                    </div>
                    <h2 class="fw-black text-dark mb-2 text-uppercase" style="letter-spacing: -0.02em;">Bingo Tracking Session</h2>
                    <div class="badge rounded-pill bg-primary bg-opacity-10 text-primary px-4 py-2 fw-black mb-4 fs-6 border border-primary border-opacity-25 shadow-sm">
                        @SessionDate.ToLongDateString()
                    </div>
                    @if (_hasBlockingOpenSession && _blockingSessionDate.HasValue)
                    {
                        <div class="alert alert-danger shadow-sm rounded-4 mb-4 text-start w-100 p-4 border-2 border-danger border-opacity-25 animate-fade-in">
                            <h5 class="fw-black text-danger mb-2 text-uppercase"><i class="bi bi-exclamation-octagon-fill me-2 animate-pulse"></i> Unclosed Session Detected</h5>
                            <p class="small mb-0 text-muted fw-semibold" style="line-height: 1.5;">
                                There is currently an unfinished/open tracking session for <strong>@_blockingSessionDate.Value.ToLongDateString()</strong>.
                                <br/><br/>
                                To ensure progressive goals and statistics remain correct, please select that date using the calendar in the top-left, complete its counts, and click <strong>'Close & Lock Session'</strong> (or cancel it) before opening today's session.
                            </p>
                        </div>
                        <button class="btn btn-secondary w-100 py-3 rounded-pill fw-black text-uppercase" style="font-size: 0.95rem; height: 60px; opacity: 0.65; cursor: not-allowed;" disabled>
                            <i class="bi bi-lock-fill me-2"></i> Start Session Blocked
                        </button>
                    }
                    else
                    {
                        <p class="text-muted fw-semibold mb-5 px-4" style="font-size: 0.9rem; line-height: 1.6;">
                            An active session records all player admissions, floor sheets sold, game winner payouts, and progressive jackpot ball counts. 
                            Tapping the button below opens the session draft for tracking.
                        </p>
                        <button class="btn btn-primary w-100 py-3 rounded-pill fw-black shadow-lg text-uppercase" style="font-size: 0.95rem; letter-spacing: 0.05em; height: 60px;" @onclick="StartSession">
                            <i class="bi bi-play-fill me-2"></i> Start / Open Bingo Session
                        </button>
                    }
                }
                else if (_sessionState == "Open")
                {
                    <div class="premium-splash-icon mb-4">
                        <i class="bi bi-play-circle-fill text-success animate-pulse" style="font-size: 5rem; opacity: 0.85;"></i>
                    </div>
                    <h2 class="fw-black text-dark mb-2 text-uppercase" style="letter-spacing: -0.02em;">Active Session Open</h2>
                    <div class="badge rounded-pill bg-success bg-opacity-10 text-success px-4 py-2 fw-black mb-4 fs-6 border border-success border-opacity-25 shadow-sm">
                        @SessionDate.ToLongDateString()
                    </div>
                    <p class="text-muted fw-semibold mb-5 px-4" style="font-size: 0.9rem; line-height: 1.6;">
                        A tracking session is currently active and open for this date. 
                        You can continue tracking or view details in read-only mode.
                    </p>
                    <div class="d-flex flex-column gap-2 w-100">
                        <button class="btn btn-success py-3 rounded-pill fw-black shadow-lg text-uppercase" style="font-size: 0.95rem; letter-spacing: 0.05em; height: 55px;" @onclick="() => _sessionEntered = true">
                            <i class="bi bi-arrow-right-circle-fill me-2"></i> Continue Tracking Session
                        </button>
                        <button class="btn btn-outline-secondary py-3 rounded-pill fw-bold text-uppercase" style="font-size: 0.85rem; height: 50px;" @onclick='() => { _sessionState = "Closed"; _sessionEntered = true; }'>
                            <i class="bi bi-eye-fill me-2"></i> View Details (Read-Only)
                        </button>
                    </div>
                }
                else if (_sessionState == "Closed")
                {
                    <div class="premium-splash-icon mb-4">
                        <i class="bi bi-lock-fill text-danger" style="font-size: 5rem; opacity: 0.85;"></i>
                    </div>
                    <h2 class="fw-black text-dark mb-2 text-uppercase" style="letter-spacing: -0.02em;">Session Closed & Locked</h2>
                    <div class="badge rounded-pill bg-danger bg-opacity-10 text-danger px-4 py-2 fw-black mb-4 fs-6 border border-danger border-opacity-25 shadow-sm">
                        @SessionDate.ToLongDateString()
                    </div>
                    <p class="text-muted fw-semibold mb-5 px-4" style="font-size: 0.9rem; line-height: 1.6;">
                        This tracking session is finalized and locked. You can review all session summary details in read-only mode, or unlock it to perform adjustments.
                    </p>
                    <div class="d-flex flex-column gap-2 w-100">
                        <button class="btn btn-primary py-3 rounded-pill fw-black shadow-lg text-uppercase" style="font-size: 0.95rem; letter-spacing: 0.05em; height: 55px;" @onclick="() => _sessionEntered = true">
                            <i class="bi bi-eye-fill me-2"></i> View Session Summary (Read-Only)
                        </button>
                        <button class="btn btn-warning py-3 rounded-pill fw-black text-uppercase text-dark shadow-sm" style="font-size: 0.9rem; height: 50px;" @onclick="UnlockSession">
                            <i class="bi bi-unlock-fill me-2"></i> Unlock & Edit Session
                        </button>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="page-content-wrapper">
                @if (_sessionState == "Closed")
                {
                    <div class="alert alert-danger py-3 px-4 mb-4 rounded-4 d-flex align-items-center justify-content-between border-0 shadow-sm animate-fade-in" style="background: rgba(239, 68, 68, 0.08); border: 1px solid rgba(239, 68, 68, 0.2) !important;">
                        <div class="d-flex align-items-center gap-3">
                            <div class="bg-danger bg-opacity-20 rounded-circle p-2 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                                <i class="bi bi-lock-fill text-danger fs-5"></i>
                            </div>
                            <div>
                                <div class="fw-black text-dark text-uppercase mb-0" style="letter-spacing: 0.05em; font-size: 0.75rem;">Bingo Session Closed & Locked (Read-Only)</div>
                                <div class="text-muted fw-bold" style="font-size: 0.65rem;">This session is finalized. To make corrections, tap 'Unlock / Correct Session'.</div>
                            </div>
                        </div>
                        <button class="btn btn-danger btn-sm rounded-pill fw-black px-4 py-2 shadow-sm" style="font-size: 0.65rem;" @onclick="UnlockSession">
                            <i class="bi bi-unlock-fill me-1"></i> UNLOCK / CORRECT
                        </button>
                    </div>
                }

                        <!-- Dashboard Break-Even Indicator -->
                        @{
                            var requiredScalePct = CalculateRequiredStandardPayoutScale();
                        }
                        @if (requiredScalePct < 100m)
                        {
                            <div class="alert alert-danger border-0 rounded-4 p-2 px-3 mb-2 d-flex align-items-center gap-2 shadow-sm" style="font-size: 0.75rem;">
                                <i class="bi bi-exclamation-triangle-fill text-danger animate-pulse"></i>
                                <span class="fw-semibold text-muted text-uppercase" style="font-size: 0.6rem;">Standard Payout Scale:</span>
                                <span class="fw-black text-danger text-uppercase" style="font-size: 0.65rem;">To break even on the session, scale standard games to @requiredScalePct.ToString("N0")%.</span>
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-success border-0 rounded-4 p-2 px-3 mb-2 d-flex align-items-center gap-2 shadow-sm" style="font-size: 0.75rem;">
                                <i class="bi bi-check-circle-fill text-success"></i>
                                <span class="fw-semibold text-muted text-uppercase" style="font-size: 0.6rem;">Standard Payout Scale:</span>
                                <span class="fw-black text-success text-uppercase" style="font-size: 0.65rem;">Session target met: 100% of standard games can be paid out.</span>
                            </div>
                        }

                        <!-- Profit Margins Summary Badges -->
                        @{
                            var dashAdmGross = NetAdmissionRevenue;
                            var dashAdmLottery = Sheets.Where(s => s.IsAdmissionOnly).Sum(s => CalculateLotteryTake(s));
                            var dashDoorPrizes = _doorPrizeAmount * _doorPrizeCount;
                            var dashAdmPrizes = CalculateAdmissionPrizesForPercentage(GetCurrentPayoutPercentage());
                            var dashAdmNet = dashAdmGross - dashAdmLottery - dashAdmPrizes - dashDoorPrizes;
                            var dashAdmProfitPct = dashAdmGross > 0 ? (dashAdmNet / dashAdmGross) * 100m : 0m;

                            var dashSpecSheets = Sheets.Where(s => !s.IsAdmissionOnly).ToList();
                            var dashSpecGross = dashSpecSheets.Sum(s => GetAllocatedAdmissionGross(s) + (s.ManualSold * s.Price));
                            var dashSpecLottery = dashSpecSheets.Sum(s => CalculateLotteryTake(s));
                            var dashSpecPrizes = dashSpecSheets.Sum(s => s.Games.Sum(g => CalculateGamePayout(s, g)));
                            var dashSpecNet = dashSpecGross - dashSpecLottery - dashSpecPrizes;
                            var dashSpecProfitPct = dashSpecGross > 0 ? (dashSpecNet / dashSpecGross) * 100m : 0m;
                        }
                        <div class="d-flex align-items-center gap-2 mb-3">
                            <div class="rounded-4 p-2 px-3 bg-white border border-light border-opacity-10 shadow-sm d-flex align-items-center gap-2" style="font-size: 0.75rem;">
                                <span class="fw-semibold text-muted text-uppercase" style="font-size: 0.55rem; letter-spacing: 0.02em;">Admissions Margin:</span>
                                <span class="fw-black @(dashAdmProfitPct < 0 ? "text-danger" : "text-success")" style="font-size: 0.7rem;">@dashAdmProfitPct.ToString("F1")%</span>
                            </div>
                            <div class="rounded-4 p-2 px-3 bg-white border border-light border-opacity-10 shadow-sm d-flex align-items-center gap-2" style="font-size: 0.75rem;">
                                <span class="fw-semibold text-muted text-uppercase" style="font-size: 0.55rem; letter-spacing: 0.02em;">Special Games Margin:</span>
                                <span class="fw-black @(dashSpecProfitPct < 0 ? "text-danger" : "text-success")" style="font-size: 0.7rem;">@dashSpecProfitPct.ToString("F1")%</span>
                            </div>
                        </div>

                        <!-- COMPACT ADMISSION SUMMARY BAR -->
                        <div class="admission-summary-bar mb-3" @onclick="OpenAdmissionEntry">
                            <div class="summary-left">
                                <div class="summary-item main">
                                    <label>TOTAL ATTENDANCE</label>
                                    <div class="val">@AdmissionPacks.Sum(p => p.Sold)</div>
                                </div>
                                <div class="summary-item main">
                                    <label>ADDITIONAL CARDS</label>
                                    <div class="val text-primary">@TotalExtraCards</div>
                                </div>
                                <div class="summary-item main">
                                    <label>ADMISSION REVENUE</label>
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="val text-primary">@AdmissionPacks.Sum(p => p.Sold * p.Price).ToString("C2")</div>
                                        <button class="btn btn-primary rounded-pill px-4 py-2 fw-black d-flex align-items-center gap-2 border-0 shadow-sm" style="font-size: 0.75rem; min-height: 38px;" @onclick:stopPropagation="true" @onclick="OpenAdmissionAudit">
                                            <i class="bi bi-graph-up-arrow"></i> SUMMARY
                                        </button>
                                        <button class="btn btn-warning rounded-pill px-4 py-2 fw-black d-flex align-items-center gap-2 border-0 shadow-sm text-dark ms-2" style="font-size: 0.75rem; min-height: 38px;" @onclick:stopPropagation="true" @onclick="OpenBeanoReport">
                                            <i class="bi bi-file-earmark-spreadsheet-fill"></i> BEANO REPORT
                                        </button>
                                    </div>
                                </div>
                            </div>
                            
                            <div class="summary-divider"></div>
                            
                            <div class="summary-right flex-wrap">
                                @foreach (var pack in AdmissionPacks)
                                {
                                    <div class="pack-badge @(pack.Sold > 0 ? "has-data" : "empty")">
                                        <div class="badge-accent" style="background: @pack.DisplayColor"></div>
                                        <div class="badge-content">
                                            <span class="pack-name">@pack.Name</span>
                                            <div class="d-flex align-items-baseline gap-2">
                                                <span class="pack-val">@pack.Sold</span>
                                                @if (pack.Sold > 0)
                                                {
                                                    <span class="pack-total-small">(@((pack.Sold * pack.Price).ToString("C0")))</span>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                            
                            <div class="summary-action">
                                <i class="bi bi-people-fill"></i>
                            </div>
                        </div>

                        <div class="section-divider mb-3">
                            <span>ADDITIONAL SALES TRACKING</span>
                        </div>

                        <!-- FLOOR SALES SUMMARY BAR -->
                        <div class="floor-sales-summary-bar mb-4" @onclick="OpenAdditionalSalesEntry">
                            <div class="summary-left">
                                <div class="summary-item main">
                                    <label>ADDITIONAL SHEETS</label>
                                    <div class="val">@Sheets.Sum(s => s.ManualSold)</div>
                                </div>
                                <div class="summary-item main">
                                    <label>ADDITIONAL REVENUE</label>
                                    <div class="val text-success">@Sheets.Sum(s => s.ManualSold * s.Price).ToString("C2")</div>
                                </div>
                            </div>
                            
                            <div class="summary-divider"></div>
                            
                            <div class="summary-right flex-wrap">
                                @foreach (var sheet in Sheets.Where(s => s.ManualSold > 0))
                                {
                                    <div class="pack-badge has-data floor">
                                        <div class="badge-accent" style="background: @sheet.DisplayColor"></div>
                                        <div class="badge-content">
                                            <span class="pack-name">@sheet.ColorName</span>
                                            <div class="d-flex align-items-baseline gap-2">
                                                <span class="pack-val">@sheet.ManualSold</span>
                                                <span class="pack-total-small">(@((sheet.ManualSold * sheet.Price).ToString("C0")))</span>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                            
                            <div class="summary-action">
                                <i class="bi bi-cart-fill"></i>
                            </div>
                        </div>

                        <!-- PULL TABS SUMMARY BAR -->
                        <div class="admission-summary-bar mb-4" style="border-color: rgba(139, 92, 246, 0.2);" @onclick="OpenAddPullTabModal">
                            <div class="summary-left flex-wrap">
                                <div class="summary-item main">
                                    <label>TOTAL PULL TAB SALES</label>
                                    <div class="val text-purple" style="color: #8b5cf6 !important;">@TotalPullTabSales.ToString("C2")</div>
                                </div>
                                <div class="summary-item main">
                                    <label>TOTAL PULL TAB PRIZES</label>
                                    <div class="val text-danger">@TotalPullTabPrizes.ToString("C2")</div>
                                </div>
                                <div class="summary-item main">
                                    <label>PULL TAB CLUB PROFIT</label>
                                    <div class="val text-success">@TotalPullTabNet.ToString("C2")</div>
                                </div>
                                <div class="summary-item main">
                                    <label>PULL TAB OVER/SHORT</label>
                                    <div class="val @(TotalPullTabOverShort < 0 ? "text-danger" : "text-success")">@TotalPullTabOverShort.ToString("C2")</div>
                                </div>
                            </div>
                            <div class="summary-divider"></div>
                            <div class="summary-right">
                                <button class="btn btn-primary rounded-pill px-3 py-2 fw-black d-flex align-items-center gap-2 border-0 shadow-sm" style="font-size: 0.65rem; height: 36px; background: #8b5cf6;" @onclick:stopPropagation="true" @onclick="OpenAddPullTabModal">
                                    <i class="bi bi-plus-circle-fill"></i> ADD PULL TAB GAME
                                </button>
                            </div>
                            <div class="summary-action" style="color: #8b5cf6;">
                                <i class="bi bi-ticket-detailed-fill"></i>
                            </div>
                        </div>

                        <!-- DOOR PRIZES SUMMARY BAR -->
                        <div class="admission-summary-bar mb-4" style="border-color: rgba(236, 72, 153, 0.2);" @onclick="OpenDoorPrizesEntry">
                            <div class="summary-left flex-wrap">
                                <div class="summary-item main">
                                    <label>DOOR PRIZE AMOUNT</label>
                                    <div class="val text-pink" style="color: #ec4899 !important;">@_doorPrizeAmount.ToString("C2")</div>
                                </div>
                                <div class="summary-item main">
                                    <label>DOOR PRIZES COUNT</label>
                                    <div class="val text-dark">@_doorPrizeCount</div>
                                </div>
                                <div class="summary-item main">
                                    <label>TOTAL PAID</label>
                                    <div class="val text-danger">@((_doorPrizeAmount * _doorPrizeCount).ToString("C2"))</div>
                                </div>
                            </div>
                            <div class="summary-divider"></div>
                            <div class="summary-right">
                                <button class="btn btn-primary rounded-pill px-3 py-2 fw-black d-flex align-items-center gap-2 border-0 shadow-sm" style="font-size: 0.65rem; height: 36px; background: #ec4899;" @onclick:stopPropagation="true" @onclick="OpenDoorPrizesEntry">
                                    <i class="bi bi-pencil-fill"></i> EDIT DOOR PRIZES
                                </button>
                            </div>
                            <div class="summary-action" style="color: #ec4899;">
                                <i class="bi bi-gift-fill"></i>
                            </div>
                        </div>

                        <!-- DOOR PRIZES MODAL -->
                        @if (_showDoorPrizesPopup)
                        {
                            <div class="admission-modal-overlay @(_showFloatingKeypad ? "keypad-open" : "")" @onclick="CloseEntryModals">
                                <div class="admission-modal-content shadow-lg" @onclick:stopPropagation>
                                    <div class="modal-header-compact">
                                        <h5 class="fw-black mb-0">DOOR PRIZES ENTRY</h5>
                                        <button class="btn-close-compact" @onclick="CloseEntryModals">
                                            <i class="bi bi-x-lg"></i>
                                        </button>
                                    </div>
                                    
                                    <div class="modal-body-compact p-3">
                                        <div class="d-flex flex-column gap-3">
                                            <div class="p-3 bg-light rounded-4 border border-light border-opacity-10 shadow-sm">
                                                <div class="d-flex align-items-center justify-content-between">
                                                    <div>
                                                        <span class="extra-small text-uppercase fw-black text-muted d-block" style="letter-spacing: 0.05em; font-size: 0.55rem; line-height: 1.2;">Door Prize Amount</span>
                                                        <span class="extra-small text-muted fw-bold">Individual prize amount in dollars</span>
                                                    </div>
                                                    <div class="form-control text-end fw-black text-primary border shadow-sm d-flex align-items-center justify-content-end @(_activeField == "DoorPrizeAmount" ? "border-primary bg-light" : "")" 
                                                         style="width: 140px; height: 42px; border-radius: 10px; font-size: 1rem; cursor: pointer; padding-right: 15px;"
                                                         @onclick='() => ActivateField("DoorPrizeAmount")'>
                                                        @_doorPrizeAmount.ToString("C2")
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="p-3 bg-light rounded-4 border border-light border-opacity-10 shadow-sm">
                                                <div class="d-flex align-items-center justify-content-between">
                                                    <div>
                                                        <span class="extra-small text-uppercase fw-black text-muted d-block" style="letter-spacing: 0.05em; font-size: 0.55rem; line-height: 1.2;">Door Prize Count</span>
                                                        <span class="extra-small text-muted fw-bold">Number of prizes awarded</span>
                                                    </div>
                                                    <div class="form-control text-end fw-black text-primary border shadow-sm d-flex align-items-center justify-content-end @(_activeField == "DoorPrizeCount" ? "border-primary bg-light" : "")" 
                                                         style="width: 140px; height: 42px; border-radius: 10px; font-size: 1rem; cursor: pointer; padding-right: 15px;"
                                                         @onclick='() => ActivateField("DoorPrizeCount")'>
                                                        @_doorPrizeCount
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="mt-4 p-3 rounded-4 text-center" style="background: rgba(13, 110, 253, 0.08); border: 1px solid rgba(13, 110, 253, 0.2) !important;">
                                             <span class="extra-small text-uppercase fw-black text-primary d-block" style="letter-spacing: 0.05em; font-size: 0.65rem; line-height: 1.2;">Total Door Prize Payout</span>
                                             <span class="fw-black text-danger fs-4 mt-1 d-block">@((_doorPrizeAmount * _doorPrizeCount).ToString("C2"))</span>
                                         </div>
                                    </div>
                                </div>
                            </div>
                        }

                        <!-- FLOOR SALES MODAL -->
                        @if (_showFloorSalesPopup)
                        {
                            <div class="admission-modal-overlay @(_showFloatingKeypad ? "keypad-open" : "")" @onclick="CloseEntryModals">
                                <div class="admission-modal-content shadow-lg" @onclick:stopPropagation>
                                    <div class="modal-header-compact">
                                        <h5 class="fw-black mb-0">ADDITIONAL SALES ENTRY</h5>
                                        <button class="btn-close-compact" @onclick="CloseEntryModals">
                                            <i class="bi bi-x-lg"></i>
                                        </button>
                                    </div>
                                    
                                    <div class="modal-body-compact p-3">
                                        <!-- Entry Mode Selector -->
                                        <div class="d-flex justify-content-center mb-3">
                                            <div class="btn-group bg-light rounded-pill p-1 shadow-sm border border-light border-opacity-10" style="display: inline-flex;">
                                                <button class="btn btn-sm rounded-pill px-4 fw-black @(!_entryModeIsDollars ? "btn-success shadow-sm text-white" : "btn-light text-muted border-0")" 
                                                        style="font-size: 0.7rem; height: 32px;" @onclick="() => ToggleEntryMode(false)">
                                                    ENTER QUANTITY
                                                </button>
                                                <button class="btn btn-sm rounded-pill px-4 fw-black @(_entryModeIsDollars ? "btn-success shadow-sm text-white" : "btn-light text-muted border-0")" 
                                                        style="font-size: 0.7rem; height: 32px;" @onclick="() => ToggleEntryMode(true)">
                                                    ENTER DOLLAR AMOUNT ($)
                                                </button>
                                            </div>
                                        </div>

                                        <div class="admissions-expanded-list">
                                            @foreach (var sheet in Sheets.Where(s => !s.IsAdmissionOnly))
                                            {
                                                <div id="floor-row-@sheet.ColorName" class="admission-entry-row p-3 rounded-4 mb-2 border-2 @(_activeField == sheet.ColorName + "_Sold" ? "border-success bg-success-subtle shadow-sm" : "bg-white border-light")" 
                                                     @onclick='() => ActivateField(sheet.ColorName + "_Sold")'>
                                                    <div class="d-flex justify-content-between align-items-center">
                                                        <div class="d-flex align-items-center gap-3">
                                                            <div class="color-dot-large" style="background: @sheet.DisplayColor"></div>
                                                            <div class="d-flex flex-column">
                                                                <span class="fw-black text-uppercase" style="font-size: 0.9rem;">@sheet.ColorName</span>
                                                                <span class="extra-small text-muted fw-bold">
                                                                    @sheet.Price.ToString("C0") PER SHEET
                                                                    @if (_entryModeIsDollars)
                                                                    {
                                                                        <span class="text-success ms-1">(@sheet.ManualSold SHEETS SOLD)</span>
                                                                    }
                                                                </span>
                                                                @if (_entryModeIsDollars && _activeField == sheet.ColorName + "_Sold" && _currentBuffer != "")
                                                                {
                                                                    @if (decimal.TryParse(_currentBuffer, out var enteredAmt))
                                                                    {
                                                                        var calcSheets = (int)(enteredAmt / sheet.Price);
                                                                        var rem = enteredAmt - (calcSheets * sheet.Price);
                                                                        if (rem > 0)
                                                                        {
                                                                            <span class="text-warning extra-small fw-bold d-block mt-1">
                                                                                <i class="bi bi-exclamation-triangle-fill me-1"></i>
                                                                                $@enteredAmt.ToString("N0") is not a multiple of @sheet.Price.ToString("C0"). (@calcSheets sheets + $@rem.ToString("N0") remainder)
                                                                            </span>
                                                                        }
                                                                    }
                                                                }
                                                            </div>
                                                        </div>
                                                        <div class="d-flex align-items-center gap-4">
                                                            <div class="text-end">
                                                                <span class="extra-small text-muted d-block">TOTAL</span>
                                                                <span class="fw-black">@((sheet.ManualSold * sheet.Price).ToString("C0"))</span>
                                                            </div>
                                                            <div class="entry-val-large @(_activeField == sheet.ColorName + "_Sold" ? "focused-success" : "")">
                                                                @if (_activeField == sheet.ColorName + "_Sold")
                                                                {
                                                                    <div class="d-flex align-items-center">
                                                                        @if (_entryModeIsDollars)
                                                                        {
                                                                            <span class="text-success me-1">$</span>
                                                                        }
                                                                        <span class="@(_currentBuffer == "" ? "ghost-value" : "")">
                                                                            @if (_currentBuffer == "")
                                                                            {
                                                                                @(_entryModeIsDollars ? (sheet.ManualSold * sheet.Price).ToString("N0") : sheet.ManualSold.ToString())
                                                                            }
                                                                            else
                                                                            {
                                                                                @_currentBuffer
                                                                            }
                                                                        </span>
                                                                        <span class="cursor-blink">|</span>
                                                                    </div>
                                                                }
                                                                else
                                                                {
                                                                    @(_entryModeIsDollars ? (sheet.ManualSold * sheet.Price).ToString("C0") : sheet.ManualSold.ToString())
                                                                }
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                    
                                    <div class="modal-footer-compact p-3 bg-light rounded-bottom-4">
                                        <button class="btn btn-success w-100 rounded-pill fw-black py-3 shadow" @onclick="CloseEntryModals">
                                            DONE & CLOSE
                                        </button>
                                    </div>
                                </div>
                            </div>
                        }

                        <!-- ADMISSION ENTRY MODAL (existing) -->
                        @if (_showAdmissionPopup)
                        {
                            var basePack = AdmissionPacks.OrderBy(p => GetAdmitCount(p.Name)).FirstOrDefault();
                            var baseCount = basePack != null ? GetAdmitCount(basePack.Name) : 9;

                            <div class="admission-modal-overlay @(_showFloatingKeypad ? "keypad-open" : "")" @onclick="CloseEntryModals">
                                <div class="admission-modal-content shadow-lg" @onclick:stopPropagation>
                                    <div class="modal-header-compact">
                                        <h5 class="fw-black mb-0">ADMISSION ENTRY</h5>
                                        <button class="btn-close-compact" @onclick="CloseEntryModals">
                                            <i class="bi bi-x-lg"></i>
                                        </button>
                                    </div>
                                    
                                    <div class="modal-body-compact p-3">
                                        <!-- 2-Column Summary Banner -->
                                        <div class="row g-2 mb-3">
                                            <div class="col-6">
                                                <div class="p-3 rounded-4 bg-primary bg-opacity-10 border border-primary border-opacity-10 text-center h-100 d-flex flex-column justify-content-center">
                                                    <span class="extra-small text-uppercase fw-bold text-muted d-block" style="letter-spacing: 0.05em; font-size: 0.55rem; line-height: 1.2;">Admission Packs Sold</span>
                                                    <span class="fw-black text-primary fs-5 mt-1">@AdmissionPacks.Sum(p => p.Sold)</span>
                                                </div>
                                            </div>
                                            <div class="col-6">
                                                <div class="p-3 rounded-4 bg-primary bg-opacity-10 border border-primary border-opacity-10 text-center h-100 d-flex flex-column justify-content-center">
                                                    <span class="extra-small text-uppercase fw-bold text-muted d-block" style="letter-spacing: 0.05em; font-size: 0.55rem; line-height: 1.2;">Additional Cards</span>
                                                    <span class="fw-black text-primary fs-5 mt-1">@AdmissionPacks.Sum(p => p.Sold * (GetAdmitCount(p.Name) - baseCount) / 3)</span>
                                                </div>
                                            </div>
                                        </div>

                                         <!-- Break-Even Payout Indicator -->
                                         @{
                                             var modalRequiredScalePct = CalculateRequiredStandardPayoutScale();
                                         }
                                         @if (modalRequiredScalePct < 100m)
                                         {
                                             <div class="alert alert-danger border-0 rounded-4 p-3 mb-3 d-flex align-items-center gap-3 shadow-sm">
                                                 <div class="rounded-circle bg-danger bg-opacity-10 d-flex align-items-center justify-content-center" style="width: 38px; height: 38px; min-width: 38px;">
                                                     <i class="bi bi-exclamation-triangle-fill text-danger fs-5 animate-pulse"></i>
                                                 </div>
                                                 <div>
                                                     <span class="d-block extra-small text-uppercase fw-bold text-muted" style="letter-spacing: 0.05em; font-size: 0.55rem; line-height: 1.2;">Standard Payout Scale</span>
                                                     <span class="fw-black text-danger fs-6">To break even on the session, scale standard games to @modalRequiredScalePct.ToString("N0")%.</span>
                                                 </div>
                                             </div>
                                         }
                                         else
                                         {
                                             <div class="alert alert-success border-0 rounded-4 p-3 mb-3 d-flex align-items-center gap-3 shadow-sm">
                                                 <div class="rounded-circle bg-success bg-opacity-10 d-flex align-items-center justify-content-center" style="width: 38px; height: 38px; min-width: 38px;">
                                                     <i class="bi bi-check-circle-fill text-success fs-5"></i>
                                                 </div>
                                                 <div>
                                                     <span class="d-block extra-small text-uppercase fw-bold text-muted" style="letter-spacing: 0.05em; font-size: 0.55rem; line-height: 1.2;">Standard Payout Scale</span>
                                                     <span class="fw-black text-success fs-6">Session target met: 100% of standard games can be paid out.</span>
                                                 </div>
                                             </div>
                                         }

                                         <!-- Payout Scaling Toggle & Manual input inside Admission Modal -->
                                         <div class="p-3 bg-light rounded-4 border border-light border-opacity-10 mb-3 shadow-sm" @onclick:stopPropagation="true">
                                             <div class="d-flex align-items-center justify-content-between">
                                                 <div>
                                                     <span class="extra-small text-uppercase fw-black text-muted d-block" style="letter-spacing: 0.05em; font-size: 0.55rem; line-height: 1.2;">Payout Scaling Mode</span>
                                                     <span class="extra-small text-muted fw-bold">Select how standard prizes should scale</span>
                                                 </div>
                                                 <div class="d-flex align-items-center gap-2">
                                                     <select class="form-select form-select-sm fw-black text-primary border bg-white shadow-sm" style="width: 155px; height: 38px; border-radius: 10px; font-size: 0.8rem; cursor: pointer;"
                                                             value="@_useManualScaling.ToString().ToLower()" @onchange="OnScalingModeChanged">
                                                         <option value="true">Manual Mode</option>
                                                         <option value="false">Attendance</option>
                                                     </select>
                                                     @if (_useManualScaling)
                                                     {
                                                         <div class="input-group input-group-sm" style="width: 95px; height: 38px;">
                                                             <div class="form-control text-center fw-black text-primary border shadow-sm d-flex align-items-center justify-content-center @(_activeField == "PayoutPercentage" ? "border-primary bg-light" : "")" 
                                                                  style="border-radius: 10px 0 0 10px; font-size: 0.9rem; cursor: pointer; padding: 0;"
                                                                  @onclick='() => ActivateField("PayoutPercentage")'>
                                                                 @if (_activeField == "PayoutPercentage")
                                                                 {
                                                                     @_currentBuffer
                                                                     <span class="cursor-blink">|</span>
                                                                 }
                                                                 else
                                                                 {
                                                                     @_payoutPercentage
                                                                 }
                                                             </div>
                                                             <span class="input-group-text bg-white border fw-black text-primary" style="border-radius: 0 10px 10px 0; font-size: 0.8rem;">%</span>
                                                         </div>
                                                     }
                                                 </div>
                                             </div>
                                         </div>

                                         <!-- Target Profit Percentage Input -->
                                         @if (_useManualScaling)
                                         {
                                             <div class="p-3 bg-light rounded-4 border border-light border-opacity-10 mb-3 shadow-sm" @onclick:stopPropagation="true">
                                                 <div class="d-flex align-items-center justify-content-between">
                                                     <div>
                                                         <span class="extra-small text-uppercase fw-black text-muted d-block" style="letter-spacing: 0.05em; font-size: 0.55rem; line-height: 1.2;">Target Profit Margin</span>
                                                         <span class="extra-small text-muted fw-bold">Set desired profit margin on admissions</span>
                                                     </div>
                                                     <div class="d-flex align-items-center gap-2">
                                                         <div class="input-group input-group-sm" style="width: 115px; height: 38px;">
                                                             <div class="form-control text-center fw-black text-primary border shadow-sm d-flex align-items-center justify-content-center @(_activeField == "TargetProfitPercentage" ? "border-primary bg-light" : "")" 
                                                                  style="border-radius: 10px 0 0 10px; font-size: 0.9rem; cursor: pointer; padding: 0;"
                                                                  @onclick='() => ActivateField("TargetProfitPercentage")'>
                                                                 @if (_activeField == "TargetProfitPercentage")
                                                                 {
                                                                     @_currentBuffer
                                                                     <span class="cursor-blink">|</span>
                                                                 }
                                                                 else
                                                                 {
                                                                     @_targetProfitPercentage.ToString("F0")
                                                                 }
                                                             </div>
                                                             <span class="input-group-text bg-white border fw-black text-primary" style="border-radius: 0 10px 10px 0; font-size: 0.8rem;">%</span>
                                                         </div>
                                                     </div>
                                                 </div>
                                             </div>
                                         }

                                        <div class="admissions-expanded-list">
                                            @foreach (var pack in AdmissionPacks)
                                            {
                                                var extraCount = GetAdmitCount(pack.Name) - baseCount;
                                                var extraCards = extraCount / 3;

                                                <div id="admin-row-@pack.Id" class="admission-entry-row p-3 rounded-4 mb-2 border-2 @(_activeField == "Pack_" + pack.Id ? "border-primary bg-primary-subtle shadow-sm" : "bg-white border-light")" 
                                                     @onclick='() => ActivateField("Pack_" + pack.Id)'>
                                                    <div class="d-flex justify-content-between align-items-center">
                                                        <div class="d-flex align-items-center gap-3">
                                                            <div class="color-dot-large" style="background: @pack.DisplayColor"></div>
                                                            <div class="d-flex flex-column">
                                                                <div class="d-flex align-items-center gap-2 flex-wrap">
                                                                    <span class="fw-black text-uppercase" style="font-size: 0.9rem;">@pack.Name</span>
                                                                    @if (extraCards > 0)
                                                                    {
                                                                        <span class="badge rounded-pill bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 px-2 py-0.5 fw-black" style="font-size: 0.6rem; letter-spacing: 0.02em;">
                                                                            +@extraCards EXTRA @(extraCards == 1 ? "CARD" : "CARDS")
                                                                        </span>
                                                                    }
                                                                    <button class="btn btn-link p-0 text-muted" @onclick:stopPropagation="true" @onclick="() => _selectedPackDetail = pack">
                                                                        <i class="bi bi-info-circle-fill"></i>
                                                                    </button>
                                                                </div>
                                                                <span class="extra-small text-muted fw-bold">@pack.Price.ToString("C0") PER PACK</span>
                                                            </div>
                                                        </div>
                                                        <div class="d-flex align-items-center gap-4">
                                                            <div class="text-end">
                                                                <span class="extra-small text-muted d-block">TOTAL</span>
                                                                <span class="fw-black">@((pack.Sold * pack.Price).ToString("C0"))</span>
                                                            </div>
                                                            <div class="entry-val-large @(_activeField == "Pack_" + pack.Id ? "focused" : "")">
                                                                @if (_activeField == "Pack_" + pack.Id)
                                                                {
                                                                    <div class="d-flex align-items-center">
                                                                        <span class="@(_currentBuffer == "" ? "ghost-value" : "")">@(_currentBuffer == "" ? pack.Sold.ToString() : _currentBuffer)</span>
                                                                        <span class="cursor-blink">|</span>
                                                                    </div>
                                                                }
                                                                else
                                                                {
                                                                    @pack.Sold
                                                                }
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                    
                                    <div class="modal-footer-compact p-3 bg-light rounded-bottom-4">
                                        <button class="btn btn-primary w-100 rounded-pill fw-black py-3 shadow" @onclick="CloseEntryModals">
                                            DONE & CLOSE
                                        </button>
                                    </div>
                                </div>
                            </div>
                        }


                        <div class="section-divider mb-3">
                            <span>BINGO PROGRAM</span>
                        </div>

                        <!-- SHEETS GRID -->
                        <div class="bingo-tiles-grid">
                            @foreach (var sheet in Sheets)
                            {
                                <div class="bingo-tile @(!_showFloorSalesPopup && !_showAdmissionPopup && _activeField.StartsWith(sheet.ColorName) ? "active-tile" : "")" 
                                     style="--accent-color: @sheet.DisplayColor; cursor: pointer;" @onclick="() => OpenSheetDetail(sheet)">
                                    <div class="tile-accent" style="background: @sheet.DisplayColor"></div>
                                    <div class="tile-header">
                                        <div class="d-flex align-items-center gap-2 flex-wrap">
                                            <div class="color-dot" style="background: @sheet.DisplayColor"></div>
                                            <span class="tile-title">@sheet.ColorName</span>
                                            @{
                                                var sheetBreakage = sheet.Games.Sum(g => CalculateGameTotalBreakage(sheet, g));
                                            }
                                            @if (sheetBreakage != 0)
                                            {
                                                <span class="badge rounded-3 animate-pulse px-2 py-0.5 fw-extrabold" 
                                                      style="font-size: 0.55rem; color: #b45309 !important; background: #fffbeb !important; border: 1.5px solid #fde68a !important; letter-spacing: 0.01em;"
                                                      title="Sheet Breakage: @sheetBreakage.ToString("C2")">
                                                    <i class="bi bi-calculator-fill me-1" style="font-size: 0.55rem;"></i>@((sheetBreakage > 0 ? "+" : "") + sheetBreakage.ToString("C2"))
                                                </span>
                                            }
                                        </div>
                                        <div class="d-flex gap-1 flex-wrap justify-content-end">
                                            @if (sheet.IsClosedOut)
                                            {
                                                @if (sheet.IsSynced)
                                                {
                                                    <span class="badge rounded-pill bg-success text-white border shadow-sm" style="font-size: 0.5rem;">
                                                        <i class="bi bi-check-circle-fill"></i> COMPLETED
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge rounded-pill bg-warning text-dark border shadow-sm animate-pulse" style="font-size: 0.5rem;">
                                                        <i class="bi bi-cloud-arrow-up-fill"></i> PENDING SYNC
                                                    </span>
                                                }
                                            }
                                            else if (sheet.IsIncludedInAdmission && sheet.IsAdmissionOnly)
                                            {
                                                <span class="badge rounded-pill bg-primary text-white border shadow-sm" style="font-size: 0.5rem;">STANDARD</span>
                                            }
                                            else if (sheet.IsIncludedInAdmission && !sheet.IsAdmissionOnly)
                                            {
                                                <span class="badge rounded-pill bg-info text-dark border shadow-sm" style="font-size: 0.5rem;">SPECIAL (INCLUDED)</span>
                                            }
                                            else
                                            {
                                                <span class="badge rounded-pill bg-secondary text-white border shadow-sm" style="font-size: 0.5rem;">ADDITIONAL PURCHASE</span>
                                            }

                                            @if (sheet.PayoutMode == 1)
                                            {
                                                <span class="badge rounded-pill bg-warning text-dark border shadow-sm" style="font-size: 0.5rem;">50/50</span>
                                            }
                                            else if (sheet.PayoutMode == 2)
                                            {
                                                <span class="badge rounded-pill bg-success text-white border shadow-sm" style="font-size: 0.5rem;">GROSS %</span>
                                            }
                                        </div>
                                    </div>

                                    <div class="tile-body">
                                        <div class="tile-stat-multi mb-3">
                                            <div class="stat-main">
                                                <label>TOTAL SOLD</label>
                                                <div class="val">
                                                    @sheet.Sold
                                                </div>
                                            </div>
                                            <div class="stat-breakdown">
                                                @if (sheet.IsAdmissionOnly)
                                                {
                                                    <div class="break-item w-100 text-center">
                                                        <label>STANDARD PROGRAM</label>
                                                        <span class="fw-black">@AdmissionCount PLAYERS</span>
                                                    </div>
                                                }
                                                else if (sheet.IsIncludedInAdmission)
                                                {
                                                    <div class="break-item">
                                                        <label>9-PACK</label>
                                                        <span class="fw-black">@AdmissionCount</span>
                                                    </div>
                                                    <div class="break-item">
                                                        <label>ADDITIONAL</label>
                                                        <span class="fw-black">@sheet.ManualSold</span>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div class="break-item w-100 text-center">
                                                        <label>ADDITIONAL PURCHASE ONLY</label>
                                                        <span class="fw-black">@sheet.ManualSold SOLD</span>
                                                    </div>
                                                }
                                            </div>
                                        </div>

                                        <div class="tile-games-list">
                                             @foreach (var game in sheet.Games)
                                             {
                                                 <div class="tile-game-item py-1">
                                                     <div class="d-flex justify-content-between align-items-center w-100">
                                                         <span class="game-name" style="font-size: 0.65rem;">
                                                             @game.Name
                                                             @if (!sheet.IsAdmissionOnly && !game.IsProgressive && game.IncludeInTargetProfit)
                                                             {
                                                                 <span class="badge bg-primary text-white ms-1" style="font-size: 0.45rem; padding: 1px 3px; font-weight: 800; border-radius: 3px; letter-spacing: 0.02em;">TARGET PROFIT</span>
                                                             }
                                                         </span>
                                                         <div class="text-end">
                                                             <span class="game-payout text-primary fw-black" style="font-size: 0.75rem;">@CalculateGamePayout(sheet, game).ToString("C2")</span>
                                                             @if (game.WinnerCount > 1)
                                                             {
                                                                 <div class="extra-small fw-black text-primary opacity-75" style="font-size: 0.45rem; line-height: 1;">
                                                                     @game.WinnerCount WINS @@ @((CalculateGamePayout(sheet, game) / game.WinnerCount).ToString("C2"))
                                                                 </div>
                                                             }
                                                             else if (game.WinnerCount == 1)
                                                             {
                                                                 <div class="extra-small fw-bold text-muted" style="font-size: 0.45rem; line-height: 1;">
                                                                     1 WINNER
                                                                 </div>
                                                             }
                                                             @if ((sheet.IsAdmissionOnly || (!game.IsProgressive && game.IncludeInTargetProfit)) && !game.CustomPayoutOverride.HasValue)
                                                             {
                                                                 var curPayout = CalculateGamePayout(sheet, game);
                                                                 if (curPayout < game.DefaultPayout)
                                                                 {
                                                                     <div class="extra-small text-muted font-monospace" style="font-size: 0.42rem; line-height: 1.1; margin-top: 1px;">
                                                                         @if (sheet.IsAdmissionOnly)
                                                                         {
                                                                             <span>Scaled from @game.DefaultPayout.ToString("C0") (@(GetCurrentPayoutPercentage().ToString("F0"))%)</span>
                                                                         }
                                                                         else
                                                                         {
                                                                             var isMin = game.MinimumPayout > 0 && curPayout == game.MinimumPayout;
                                                                             <span>Scaled by sales (Target: @(_targetProfitPercentage.ToString("F0"))%@(isMin ? " | Min Payout" : ""))</span>
                                                                         }
                                                                     </div>
                                                                 }
                                                             }
                                                         </div>
                                                     </div>
                                                 </div>
                                             }
                                        </div>
                                    </div>

                                    <div class="tile-footer">
                                        @if (sheet.IsAdmissionOnly)
                                        {
                                            <div class="footer-stat w-100 text-center">
                                                <span class="label">INCLUDED IN ADMISSION</span>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="footer-stat">
                                                <span class="label">CLUB PROFIT</span>
                                                @{
                                                    var cTake = CalculateClubTake(sheet);
                                                    var cClass = cTake >= 0 ? "text-success" : "text-danger";
                                                }
                                                <span class="value @cClass fw-bold">@cTake.ToString("C2")</span>
                                            </div>
                                            <div class="footer-stat text-end">
                                                <span class="label">LOTTERY</span>
                                                <span class="value">@CalculateLotteryTake(sheet).ToString("C2")</span>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        </div>

                        <div class="section-divider mt-4 mb-3">
                            <span>PULL TAB GAMES</span>
                        </div>

                        <!-- PULL TAB ENTRIES LIST (TILES GRID matching colored sheets) -->
                        <div class="bingo-tiles-grid">
                            @if (!_pullTabEntries.Any())
                            {
                                <div class="w-100 text-center py-4 bg-white rounded-4 border border-light" style="grid-column: 1 / -1;">
                                    <span class="text-muted fw-bold text-uppercase" style="font-size: 0.75rem;">No Pull Tab Games Tracked Today</span>
                                </div>
                            }
                            else
                            {
                                @foreach (var entry in _pullTabEntries)
                                {
                                    var def = _pullTabDefinitions.FirstOrDefault(d => d.Id == entry.GameDefinitionId);
                                    var ticketsSold = GetTicketsSold(entry);
                                    var gross = GetGrossReceipts(entry);
                                    var net = GetNetCashDue(entry);
                                    var overShort = GetOverShort(entry);
                                    
                                    var optLabel = def?.PrizeOptions?.FirstOrDefault(o => o.Id == entry.SelectedPrizeOptionId)?.OptionLabel ?? "";
                                    var (majorAmt, minorCount, minorAmt) = ParsePrizeStructure(optLabel);
                                    int minorPaid = 0;
                                    if (minorCount > 0)
                                    {
                                        var remainder = entry.PrizesPaid - majorAmt;
                                        if (remainder > 0 && minorAmt > 0)
                                        {
                                            minorPaid = Math.Min(minorCount, (int)(remainder / minorAmt));
                                        }
                                    }
                                    
                                    <div class="bingo-tile pulltab-tile" style="--accent-color: #8b5cf6; border: 2px dashed rgba(139, 92, 246, 0.45); cursor: pointer;" @onclick="() => EditPullTab(entry)">
                                        <div class="tile-accent" style="background: #8b5cf6;"></div>
                                        <div class="tile-header" style="background: rgba(139, 92, 246, 0.04); padding: 8px 12px; border-bottom: 1px solid rgba(0, 0, 0, 0.03);">
                                            <div class="d-flex align-items-center gap-2">
                                                <i class="bi bi-ticket-detailed-fill" style="color: #8b5cf6; font-size: 0.95rem;"></i>
                                                <span class="tile-title" style="color: #8b5cf6;">PULL TAB: @(def?.GameName ?? "Unknown")</span>
                                            </div>
                                            <div class="d-flex align-items-center gap-1">
                                                @if (_sessionState == "Closed")
                                                {
                                                    <button class="btn btn-sm btn-outline-secondary border-0 p-0 rounded-circle d-flex align-items-center justify-content-center" style="width: 24px; height: 24px;" @onclick="() => EditPullTab(entry)" @onclick:stopPropagation="true">
                                                        <i class="bi bi-eye-fill" style="font-size: 0.85rem; color: #64748b;"></i>
                                                    </button>
                                                }
                                                else
                                                {
                                                    <button class="btn btn-sm btn-outline-primary border-0 p-0 rounded-circle d-flex align-items-center justify-content-center" style="width: 24px; height: 24px; color: #8b5cf6;" @onclick="() => EditPullTab(entry)" @onclick:stopPropagation="true">
                                                        <i class="bi bi-pencil-fill" style="font-size: 0.75rem;"></i>
                                                    </button>
                                                    <button class="btn btn-sm btn-outline-danger border-0 p-0 rounded-circle d-flex align-items-center justify-content-center" style="width: 24px; height: 24px;" @onclick="() => DeletePullTab(entry)" @onclick:stopPropagation="true">
                                                        <i class="bi bi-trash3-fill" style="font-size: 0.75rem;"></i>
                                                    </button>
                                                }
                                            </div>
                                        </div>
                                        <div class="tile-body">
                                            <div class="tile-stat-multi mb-3">
                                                <div class="stat-main" style="padding: 6px; flex: 1.15;">
                                                    <label style="font-size: 0.48rem;">CASH RECEIVED</label>
                                                    <div class="val text-success" style="font-size: 1.15rem; min-height: 1.4rem;">@entry.CashReceived.ToString("C0")</div>
                                                </div>
                                                <div class="stat-breakdown" style="flex: 0.85;">
                                                    <div class="break-item" style="padding: 2px 8px;">
                                                        <label style="font-size: 0.42rem;">TICKETS</label>
                                                        <span class="fw-black" style="font-size: 0.75rem;">@ticketsSold</span>
                                                    </div>
                                                    <div class="break-item" style="padding: 2px 8px;">
                                                        <label style="font-size: 0.42rem;">GROSS</label>
                                                        <span class="fw-black text-dark" style="font-size: 0.75rem;">@gross.ToString("C0")</span>
                                                    </div>
                                                </div>
                                            </div>
                                            
                                            <div class="tile-games-list">
                                                <div class="tile-game-item py-1">
                                                    <div class="d-flex justify-content-between align-items-center w-100">
                                                        <span class="game-name" style="font-size: 0.65rem;">Prizes Paid</span>
                                                        <span class="game-payout text-danger fw-black" style="font-size: 0.75rem;">-@entry.PrizesPaid.ToString("C2")</span>
                                                    </div>
                                                </div>
                                                @if (minorCount > 0)
                                                {
                                                    <div class="tile-game-item py-1">
                                                        <div class="d-flex justify-content-between align-items-center w-100">
                                                            <span class="game-name" style="font-size: 0.65rem;">@($"{minorAmt:C0} Prizes Paid")</span>
                                                            <span class="fw-black text-purple" style="font-size: 0.75rem;">@minorPaid / @minorCount</span>
                                                        </div>
                                                    </div>
                                                }
                                                <div class="tile-game-item py-1">
                                                    <div class="d-flex justify-content-between align-items-center w-100">
                                                        <span class="game-name" style="font-size: 0.65rem;">Seller</span>
                                                        <span class="fw-black text-dark text-truncate ms-1" style="font-size: 0.75rem; max-width: 140px;">@entry.SellerName</span>
                                                    </div>
                                                </div>
                                                <div class="tile-game-item py-1">
                                                    <div class="d-flex justify-content-between align-items-center w-100">
                                                        <span class="game-name" style="font-size: 0.65rem;">Serial Number</span>
                                                        <span class="fw-black text-muted" style="font-size: 0.75rem;">@entry.SerialNumber</span>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="tile-footer" style="background: rgba(139, 92, 246, 0.02);">
                                            <div class="footer-stat">
                                                <span class="label">CLUB PROFIT</span>
                                                <span class="value text-success fw-bold">@net.ToString("C2")</span>
                                            </div>
                                            <div class="footer-stat text-end">
                                                <span class="label">OVER/SHORT</span>
                                                <span class="value @(overShort < 0 ? "text-danger" : "text-success") fw-black">@overShort.ToString("C2")</span>
                                            </div>
                                        </div>
                                    </div>
                                }
                            }
                        </div>
                        
                        <!-- GLOBAL SESSION ACTIONS -->
                        <div class="mt-5 mb-4 p-4 bg-white rounded-4 border border-light shadow-sm text-center">
                            @if (_sessionState == "Open")
                            {
                                <h5 class="fw-black text-dark text-uppercase mb-1" style="font-size: 0.9rem;">Finalize Bingo Night</h5>
                                <p class="text-muted small mb-4">Make sure all admission packs, floor sales, and game winners are completely recorded before closing.</p>
                                <button class="btn btn-success w-100 py-3 rounded-pill fw-black shadow-lg" style="height: 55px;" @onclick="CloseEntireSession">
                                    <i class="bi bi-check-circle-fill me-2"></i> CLOSE BINGO SESSION & LOCK
                                </button>
                            }
                            else if (_sessionState == "Closed")
                            {
                                <h5 class="fw-black text-danger text-uppercase mb-1" style="font-size: 0.9rem;">🔒 Session Finalized & Synced</h5>
                                <p class="text-muted small mb-4">No edits are allowed. Click below if you need to perform adjustments.</p>
                                <button class="btn btn-warning w-100 py-3 rounded-pill fw-black shadow" style="height: 55px;" @onclick="UnlockSession">
                                    <i class="bi bi-unlock-fill me-2"></i> UNLOCK / CORRECT SESSION
                                </button>
                            }
                        </div>
                <!-- FLOATING KEYPAD OVERLAY -->
                @if (_showFloatingKeypad)
                {
                    <div class="floating-keypad-container">
                        <MobileKeypad OnKeyPressed="KeyPressed" 
                                      OnBackspacePressed="BackspaceCurrentField" 
                                      OnNextPressed="HandleNext" 
                                      OnSubmitPressed='() => {}'
                                      OnClosePressed="CloseKeypad"
                                      Disabled="false"
                                      PulseSubmit="@(TotalGross > 0)" />
                    </div>
                }
            </div>
        }
    </div>
</div>
<style>
