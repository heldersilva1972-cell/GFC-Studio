    // MATH
    private static bool IsAdditionalCardsPack(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return false;
        var lower = name.ToLowerInvariant();
        return lower.Contains("additional") ||
               lower.Contains("extra") ||
               lower.Contains("card") ||
               lower.Contains("add-on") ||
               lower.Contains("addon");
    }

    private int TotalPacksSold => AdmissionPacks.Where(p => !IsAdditionalCardsPack(p.Name)).Sum(p => p.Sold);
    private int AdmissionCount => TotalPacksSold;
    private decimal TotalAdmissionRevenue => AdmissionPacks.Sum(p => p.Sold * p.Price);
    private decimal TotalFloorRevenue => Sheets.Sum(s => s.ManualSold * s.Price);
    private decimal TotalGross => TotalAdmissionRevenue + TotalFloorRevenue;
    private decimal TotalPrizes => Sheets.Sum(s => s.Games.Sum(g => CalculateGamePayout(s, g)));
    private decimal TotalRoundingAdjustment => Sheets.Sum(s => s.Games.Sum(g => CalculateGameRoundingAdjustment(s, g)));
    
    // The "Standard Program" is the revenue reserved for the Base games ($15 + extra squares)
    private decimal StandardProgramRevenue => (TotalPacksSold * _bingoSettings.BasePrice) + (TotalExtraCards * _bingoSettings.CardPrice);

    private int TotalExtraCards => AdmissionPacks.Sum(p => p.Sold * (GetAdmitCount(p.Name) - 9) / 3);

    // Standard Program Lottery (5% of the Standard Revenue)
    private decimal StandardLotteryFee => StandardProgramRevenue * 0.05m;
    
    // Total Lottery is the sum of all individual sheet lotteries (now including distributed admission lottery)
    private decimal TotalLotteryTake => Sheets.Sum(CalculateLotteryTake);
    
    // Total Club Take is the final bottom line after prizes and lottery
    private decimal TotalClubTake => Sheets.Sum(CalculateClubTake);
    
    private decimal TotalNetProceeds => TotalGross - TotalPrizes - TotalLotteryTake;

    private decimal GetAllocatedAdmissionGross(BingoSheet sheet)
    {
        if (!sheet.IsIncludedInAdmission || TotalPacksSold <= 0) return 0;
        
        // If it's a special with a fixed price included in the pack, its value is that price
        if (!sheet.IsAdmissionOnly && sheet.Price > 0) return TotalPacksSold * sheet.Price;
        
        // If it's an "Admission Only" sheet (Standard program), it shares the remaining admission pool
        if (sheet.IsAdmissionOnly)
        {
            var standardSheets = Sheets.Where(s => s.IsAdmissionOnly).ToList();
            if (standardSheets.Count == 0) return 0;
            
            // Pool is Total Admission Revenue minus the value already attributed to priced specials
            var totalSpecialsAdmissionGross = Sheets.Where(s => !s.IsAdmissionOnly && s.IsIncludedInAdmission).Sum(s => TotalPacksSold * s.Price);
            var totalPoolForStandards = TotalAdmissionRevenue - totalSpecialsAdmissionGross;
            
            return totalPoolForStandards / standardSheets.Count;
        }
        
        return 0;
    }

    private decimal CalculateLotteryTake(BingoSheet sheet) 
    {
        var gross = GetAllocatedAdmissionGross(sheet) + (sheet.ManualSold * sheet.Price);
        return gross * sheet.LotteryPercentage;
    }

    private decimal CalculateClubTake(BingoSheet sheet)
    {
        var gross = GetAllocatedAdmissionGross(sheet) + (sheet.ManualSold * sheet.Price);
        var lottery = CalculateLotteryTake(sheet);
        var prizes = sheet.Games.Sum(g => CalculateGamePayout(sheet, g));
        
        return gross - lottery - prizes;
    }

    private decimal CalculateSheetNet(BingoSheet sheet)
    {
        // For reporting, Sheet Net is effectively what the Club keeps
        return CalculateClubTake(sheet);
    }

    private decimal GetCurrentPayoutPercentage()
    {
        if (_useManualScaling) return _payoutPercentage;

        if (_bingoSettings.PayoutTiers == null || !_bingoSettings.PayoutTiers.Any()) return 100m;
        
        var admissions = AdmissionCount;
        var tier = _bingoSettings.PayoutTiers
            .Where(t => t.MinAdmissions <= admissions)
            .OrderByDescending(t => t.MinAdmissions)
            .FirstOrDefault();
            
        return tier?.PayoutPercentage ?? _bingoSettings.PayoutTiers.Min(t => t.PayoutPercentage);
    }



    private decimal CalculateGamePayoutRawShare(BingoSheet sheet, BingoGame game)
    {
        return Math.Round(CalculateGamePayoutRaw(sheet, game) / game.WinnerCount, 2);
    }

    private decimal CalculateGamePayoutRoundedShare(BingoSheet sheet, BingoGame game)
    {
        var rawShare = CalculateGamePayoutRawShare(sheet, game);
        if (_bingoSettings.PayoutRoundingMode == 1) // Round Up
            return Math.Ceiling(rawShare);
        if (_bingoSettings.PayoutRoundingMode == 2) // Round Down
            return Math.Floor(rawShare);
        return rawShare;
    }

    private decimal CalculateGamePayoutFinalShare(BingoSheet sheet, BingoGame game)
    {
        return game.CustomPayoutOverride ?? CalculateGamePayoutRoundedShare(sheet, game);
    }

    private decimal CalculateGamePayout(BingoSheet sheet, BingoGame game)
    {
        return CalculateGamePayoutFinalShare(sheet, game) * game.WinnerCount;
    }

    private decimal CalculateGameRoundingAdjustment(BingoSheet sheet, BingoGame game)
    {
        var rawShare = CalculateGamePayoutRawShare(sheet, game);
        var roundedShare = CalculateGamePayoutRoundedShare(sheet, game);
        return (roundedShare - rawShare) * game.WinnerCount;
    }

    private decimal CalculateGameManualAdjustmentBreakage(BingoSheet sheet, BingoGame game)
    {
        var roundedShare = CalculateGamePayoutRoundedShare(sheet, game);
        var finalShare = CalculateGamePayoutFinalShare(sheet, game);
        return (finalShare - roundedShare) * game.WinnerCount;
    }

    private decimal CalculateGameTotalBreakage(BingoSheet sheet, BingoGame game)
    {
        return CalculateGameRoundingAdjustment(sheet, game) + CalculateGameManualAdjustmentBreakage(sheet, game);
    }

    private decimal TotalSessionBreakage => Sheets.Sum(s => s.Games.Sum(g => CalculateGameTotalBreakage(s, g)));

    private decimal CalculateGamePayoutRaw(BingoSheet sheet, BingoGame game)
    {
        if (game.IsProgressive)
        {
            return (game.BallsCalled == 0 || game.BallsCalled <= game.CurrentBallGoal)
                ? game.JackpotAmount 
                : game.ConsolationAmount;
        }

        if (game.PayoutMode == 1 || game.PayoutMode == 2)
        {
            var gross = sheet.Sold * sheet.Price;
            decimal availableForPrizes;
            // Standard sheets (IsAdmissionOnly) do not have state tax deducted from game payouts
            var effectiveLottery = (sheet.IsAdmissionOnly) ? 0m : sheet.LotteryPercentage;
            var effectiveClub = game.ClubPercentage ?? (game.PayoutMode == 2 ? 0.05m : 0.5m);

            if (game.PayoutMode == 1) // 50/50 Split (Sequential)
            {
                var lottery = gross * effectiveLottery;
                // availableForPrizes is the remainder (Gross - Lottery) multiplied by (1 - ClubPercentage)
                // If ClubPercentage is 0.5 (50%), then availableForPrizes is 50% of the remainder.
                availableForPrizes = (gross - lottery) * (1 - effectiveClub);
            }
            else // Mode 2: Additive (Gross %)
            {
                var totalDeductionPercent = effectiveLottery + effectiveClub;
                availableForPrizes = gross * (1 - totalDeductionPercent);
            }
            
            return sheet.Games.Count > 0 ? (availableForPrizes / sheet.Games.Count) : availableForPrizes;
        }

        // Mode 0: Fixed Prize (Adjusted by attendance)
        var pct = GetCurrentPayoutPercentage() / 100m;
        return game.DefaultPayout * pct;
    }

    // PERSISTENCE
    private async Task SaveDraftAsync()
    {
        var key = $"gfc_bingo_draft_{SessionDate:yyyyMMdd}";
        var data = new BingoDraft { AdmissionPacks = AdmissionPacks, Sheets = Sheets, SessionState = _sessionState, UseManualScaling = _useManualScaling, PayoutPercentage = _payoutPercentage };
        await JSRuntime.InvokeVoidAsync("window.gfcSetAsync", key, data);
        _lastSavedTime = DateTime.Now;
        StateHasChanged();
    }

    private async Task CheckForBlockingOpenSessionAsync()
    {
        try
        {
            _hasBlockingOpenSession = false;
            _blockingSessionDate = null;

            var records = await JSRuntime.InvokeAsync<List<VaultRecord>>("window.gfcGetAllAsync");
            if (records != null)
            {
                var options = new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true };
                foreach (var rec in records)
                {
                    if (rec.Key != null && rec.Key.StartsWith("gfc_bingo_draft_"))
                    {
                        var keySuffix = rec.Key.Replace("gfc_bingo_draft_", "");
                        if (DateTime.TryParseExact(keySuffix, "yyyyMMdd", null, System.Globalization.DateTimeStyles.None, out var parsedDate))
                        {
                            if (parsedDate.Date == SessionDate.Date)
                            {
                                continue;
                            }
                            
                            var draft = System.Text.Json.JsonSerializer.Deserialize<BingoDraft>(rec.Data.GetRawText(), options);
                            if (draft != null && draft.SessionState == "Open")
                            {
                                _hasBlockingOpenSession = true;
                                _blockingSessionDate = parsedDate;
                                return;
                            }
                        }
                    }
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[BINGO] Error checking blocking open session: {ex.Message}");
        }
    }

    private async Task LoadDraftAsync()
    {
        try 
        {
            await CheckForBlockingOpenSessionAsync();
            var key = $"gfc_bingo_draft_{SessionDate:yyyyMMdd}";
            var draft = await JSRuntime.InvokeAsync<BingoDraft>("window.gfcGetAsync", key);
            
            if (draft != null)
            {
                _sessionState = draft.SessionState ?? "NotStarted";
                _useManualScaling = draft.UseManualScaling;
                _payoutPercentage = draft.PayoutPercentage > 0 ? draft.PayoutPercentage : 100m;
                foreach (var dPack in draft.AdmissionPacks)
                {
                    var p = AdmissionPacks.FirstOrDefault(x => x.Id == dPack.Id);
                    if (p != null) p.Sold = dPack.Sold;
                }
                foreach (var dSheet in draft.Sheets)
                {
                    var s = Sheets.FirstOrDefault(x => x.ColorName == dSheet.ColorName);
                    if (s != null)
                    {
                        s.ManualSold = dSheet.ManualSold;
                        s.IsClosedOut = dSheet.IsClosedOut;
                        foreach (var dGame in dSheet.Games)
                        {
                            var g = s.Games.FirstOrDefault(x => x.Name == dGame.Name);
                            if (g != null) 
                            {
                                g.Payout = dGame.Payout;
                                g.WinnerCount = dGame.WinnerCount;
                                g.BallsCalled = dGame.BallsCalled;
                                g.CustomPayoutOverride = dGame.CustomPayoutOverride;
                            }
                        }
                    }
                }
                if (_sessionState == "Open" || _sessionState == "NotStarted")
                {
                    foreach (var s in Sheets) s.IsClosedOut = false;
                }
                RecalculateSheetTotals();
                _needsSync = true;
            }
            else
            {
                // TRY QUERYING SERVER FOR PREVIOUSLY SUBMITTED/SYNCED SESSION
                BingoSession? serverSession = null;
                try
                {
                    serverSession = await ReportingService.GetBingoSessionByDateAsync(SessionDate);
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"[BINGO] GetBingoSessionByDateAsync error: {ex.Message}");
                }

                if (serverSession != null)
                {
                    _sessionState = serverSession.Status ?? "Closed";
                    _sessionEntered = true; // Auto-enter to show pre-populated data!
                    
                    // 1. Populate AdmissionPacks
                    foreach (var p in AdmissionPacks)
                    {
                        var entry = serverSession.AdmissionEntries?.FirstOrDefault(ae => ae.AdmissionDefinitionId == p.Id);
                        p.Sold = entry?.Quantity ?? 0;
                    }

                    // 2. Populate Sheets and Games
                    foreach (var s in Sheets)
                    {
                        var sheetEntries = serverSession.GameEntries?.Where(ge => ge.SheetColor == s.ColorName).ToList() ?? new List<BingoGameEntry>();
                        
                        var extraEntry = sheetEntries.FirstOrDefault(e => e.PricePerSheet > 0);
                        s.ManualSold = extraEntry?.SheetsSold ?? 0;
                        
                        s.IsClosedOut = true; 
                        s.IsSynced = true;
                        
                        foreach (var g in s.Games)
                        {
                            var gameEntries = sheetEntries.Where(e => e.GameName == g.Name).ToList();
                            
                            var entryWithBalls = gameEntries.FirstOrDefault(e => e.BallsCalled > 0);
                            g.BallsCalled = entryWithBalls?.BallsCalled ?? 0;

                            g.WinnerCount = 1;
                            g.CustomPayoutOverride = null;
                            
                            // Reconstruct CustomPayoutOverride if the prize paid on server differs from standard calculated payout
                            var defaultPayout = CalculateGamePayout(s, g); 
                            var actualPrizePaid = gameEntries.Sum(e => e.PrizePaid);
                            if (actualPrizePaid > 0 && Math.Abs(actualPrizePaid - defaultPayout) > 0.05m)
                            {
                                g.CustomPayoutOverride = actualPrizePaid;
                            }
                        }
                    }
                    
                    RecalculateSheetTotals();
                    _needsSync = false;
                }
                else
                {
                    // FULL RESET FOR BLANK SESSION
                    _sessionState = "NotStarted";
                    _useManualScaling = true;
                    _payoutPercentage = 100m;
                    foreach (var p in AdmissionPacks)
                    {
                        p.Sold = 0;
                    }
                    foreach (var s in Sheets)
                    {
                        s.ManualSold = 0;
                        s.IsClosedOut = false;
                        s.IsSynced = false;
                        foreach (var g in s.Games)
                        {
                            g.WinnerCount = 1;
                            g.BallsCalled = 0;
                            g.CustomPayoutOverride = null;
                        }
                    }
                    RecalculateSheetTotals();
                    _needsSync = false;
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Draft error: {ex.Message}");
        }
    }

    private async Task CloseOutColorAsync()
    {
        if (_selectedSheet == null) return;
        
        // Mark as closed locally immediately
        _selectedSheet.IsClosedOut = true;
        _selectedSheet.IsSynced = false; // Assume pending until server confirms
        _showCloseOutConfirmation = false;

        // Save locally first so the "Closed" state is persisted even if the next part fails
        await SaveDraftAsync();
        
        // Prepare session object for the server
        var session = PrepareSessionObject();
        session.Status = "Partial"; 
        
        try
        {
            var success = await ReportingService.SubmitBingoSessionAsync(session, _currentUsername);
            if (success)
            {
                _selectedSheet.IsSynced = true;
                await SaveDraftAsync(); // Update local draft with synced status
                await ShowToast("Closed & Synced", $"{_selectedSheet.ColorName} data has been saved to the server.");
            }
            else
            {
                await ShowToast("Saved Offline", $"{_selectedSheet.ColorName} is closed locally and will sync when online.", "warning");
            }
        }
        catch
        {
            // Fail silently on server error, we have the local backup
            await ShowToast("Saved Offline", $"{_selectedSheet.ColorName} is closed locally and will sync when online.", "warning");
        }
        
        _selectedSheet = null;
        StateHasChanged();
    }

    private async Task BackgroundSyncAsync()
    {
        if (_isSyncing || !_needsSync) return;

        try
        {
            // Submit the entire session state silently in the background
            var session = PrepareSessionObject();
            session.Status = "Partial";

            var success = await ReportingService.SubmitBingoSessionAsync(session, _currentUsername);
            if (success)
            {
                // Mark all closed sheets as synced
                foreach (var s in Sheets.Where(s => s.IsClosedOut)) s.IsSynced = true;
                _needsSync = false;
                await SaveDraftAsync();
                Console.WriteLine("[BINGO] Background sync successful.");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[BINGO] Background sync failed: {ex.Message}");
        }
        // NOTE: We do NOT set _isSyncing = true/false here to avoid pulsing the header UI every 30 seconds
    }

    private BingoSession PrepareSessionObject()
    {
        return new BingoSession
        {
            SessionDate = SessionDate,
            AdmissionCount = AdmissionCount,
            TotalGrossReceipts = TotalGross,
            TotalPrizesPaid = TotalPrizes,
            TotalLotteryTake = TotalLotteryTake,
            TotalClubTake = TotalClubTake,
            RoundingAdjustment = TotalRoundingAdjustment,
            Status = "Submitted",
            AdmissionEntries = AdmissionPacks.Where(p => p.Sold > 0).Select(p => new BingoAdmissionEntry
            {
                AdmissionDefinitionId = p.Id,
                Quantity = p.Sold,
                PriceAtTime = p.Price
            }).ToList(),
            Category = "Standard", // Default or drive from state
            GameEntries = Sheets.SelectMany(s => {
                var entries = new List<BingoGameEntry>();
                var pkgCount = s.IsIncludedInAdmission ? AdmissionCount : 0;
                var extraCount = s.ManualSold;

                foreach (var g in s.Games)
                {
                    // 1. Add Package Entry (if applicable)
                    if (pkgCount > 0)
                    {
                        var pkgGross = GetAllocatedAdmissionGross(s) / s.Games.Count;
                        var totalSheetGross = GetAllocatedAdmissionGross(s) + (s.ManualSold * s.Price);
                        var pkgPrizeRatio = totalSheetGross > 0 ? (GetAllocatedAdmissionGross(s) / totalSheetGross) : 1.0m;

                        entries.Add(new BingoGameEntry
                        {
                            SheetColor = s.ColorName,
                            GameName = g.Name,
                            SheetsSold = pkgCount,
                            PricePerSheet = 0, // Identity for "Package" in reports
                            GrossReceipts = pkgGross,
                            PrizePaid = CalculateGamePayout(s, g) * pkgPrizeRatio,
                            RoundingAdjustment = CalculateGameRoundingAdjustment(s, g) * pkgPrizeRatio,
                            LotteryPercentage = s.LotteryPercentage,
                            ClubPercentage = s.ClubPercentage,
                            LotteryTake = CalculateLotteryTake(s) * pkgPrizeRatio / s.Games.Count,
                            ClubTake = CalculateClubTake(s) * pkgPrizeRatio / s.Games.Count,
                            NetProceeds = CalculateSheetNet(s) * pkgPrizeRatio / s.Games.Count,
                            BallsCalled = g.BallsCalled,
                            Category = s.Category.ToString()
                        });
                    }

                    // 2. Add Extra Entry (if applicable)
                    if (extraCount > 0)
                    {
                        var extraGross = (s.ManualSold * s.Price) / s.Games.Count;
                        var totalSheetGross = GetAllocatedAdmissionGross(s) + (s.ManualSold * s.Price);
                        var extraPrizeRatio = totalSheetGross > 0 ? ((s.ManualSold * s.Price) / totalSheetGross) : 1.0m;

                        entries.Add(new BingoGameEntry
                        {
                            SheetColor = s.ColorName,
                            GameName = g.Name,
                            SheetsSold = extraCount,
                            PricePerSheet = s.Price,
                            GrossReceipts = s.ManualSold * s.Price / s.Games.Count,
                            PrizePaid = CalculateGamePayout(s, g) * extraPrizeRatio,
                            RoundingAdjustment = CalculateGameRoundingAdjustment(s, g) * extraPrizeRatio,
                            LotteryPercentage = s.LotteryPercentage,
                            ClubPercentage = s.ClubPercentage,
                            LotteryTake = CalculateLotteryTake(s) * extraPrizeRatio / s.Games.Count,
                            ClubTake = CalculateClubTake(s) * extraPrizeRatio / s.Games.Count,
                            NetProceeds = CalculateSheetNet(s) * extraPrizeRatio / s.Games.Count,
                            BallsCalled = g.BallsCalled,
                            Category = s.Category.ToString()
                        });
                    }
                }
                return entries;
            }).ToList()
        };
    }

