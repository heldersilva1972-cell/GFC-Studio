    private decimal _activeMajorAmt = 0;
    int _activeMinorCount = 0;
    private decimal _activeMinorAmt = 0;

    private (decimal MajorAmt, int MinorCount, decimal MinorAmt) ParsePrizeStructure(string label)
    {
        decimal majorAmt = 0;
        int minorCount = 0;
        decimal minorAmt = 0;
        try
        {
            if (string.IsNullOrWhiteSpace(label)) return (0, 0, 0);
            var atIndex = label.IndexOf("@ $");
            if (atIndex != -1)
            {
                var spaceIndex = label.IndexOf(" ", atIndex + 3);
                var ampIndex = label.IndexOf("&", atIndex + 3);
                int endIndex = spaceIndex != -1 ? spaceIndex : (ampIndex != -1 ? ampIndex : label.Length);
                var majorStr = label.Substring(atIndex + 3, endIndex - (atIndex + 3)).Trim();
                decimal.TryParse(majorStr, out majorAmt);
            }
            var ampIndex2 = label.IndexOf("&");
            if (ampIndex2 != -1)
            {
                var minorPart = label.Substring(ampIndex2 + 1).Trim();
                var atIndex2 = minorPart.IndexOf("@");
                if (atIndex2 != -1)
                {
                    var countStr = minorPart.Substring(0, atIndex2).Trim();
                    int.TryParse(countStr, out minorCount);
                    var cashIndex = minorPart.IndexOf("$", atIndex2);
                    if (cashIndex != -1)
                    {
                        var amtStr = minorPart.Substring(cashIndex + 1).Trim();
                        decimal.TryParse(amtStr, out minorAmt);
                    }
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error parsing label: {ex.Message}");
        }
        return (majorAmt, minorCount, minorAmt);
    }

    private void ReconstructPrizeSelections(PullTabGameEntry entry)
    {
        var label = _activePrizeOptions.FirstOrDefault(o => o.Id == entry.SelectedPrizeOptionId)?.OptionLabel ?? "";
        var (majorAmt, minorCount, minorAmt) = ParsePrizeStructure(label);
        _activeMajorAmt = majorAmt;
        _activeMinorCount = minorCount;
        _activeMinorAmt = minorAmt;

        if (minorCount > 0)
        {
            var remainder = entry.PrizesPaid - majorAmt;
            if (remainder > 0 && minorAmt > 0)
            {
                _minorPrizesPaidCount = Math.Min(minorCount, (int)(remainder / minorAmt));
            }
            else
            {
                _minorPrizesPaidCount = 0;
            }
        }
        else
        {
            _minorPrizesPaidCount = 0;
        }
    }

    private void RecalculatePrizesPaid()
    {
        var def = _pullTabDefinitions.FirstOrDefault(d => d.Id == _editingPullTab.GameDefinitionId);
        if (def != null && def.GameName.Contains("speedball", StringComparison.OrdinalIgnoreCase))
        {
            _editingPullTab.PrizesPaid = 150m;
        }
        else
        {
            _editingPullTab.PrizesPaid = _activeMajorAmt + (_minorPrizesPaidCount * _activeMinorAmt);
        }
    }

    private void DecrementMinorPrizes()
    {
        if (_minorPrizesPaidCount > 0)
        {
            _minorPrizesPaidCount--;
            RecalculatePrizesPaid();
        }
    }

    private void IncrementMinorPrizes()
    {
        if (_minorPrizesPaidCount < _activeMinorCount)
        {
            _minorPrizesPaidCount++;
            RecalculatePrizesPaid();
        }
    }

