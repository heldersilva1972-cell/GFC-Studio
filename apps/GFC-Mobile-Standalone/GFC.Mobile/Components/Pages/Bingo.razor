    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        _currentUsername = authState.User.Identity?.Name ?? "Staff";
        
        try 
        {
            _isOffline = false;
            // 1. ALWAYS ATTEMPT TO FETCH LATEST FROM SERVER
            var programTask = ReportingService.GetBingoProgramAsync();
            var admissionsTask = ReportingService.GetBingoAdmissionsAsync();
            var settingsTask = ReportingService.GetBingoSettingsAsync();
            
            await Task.WhenAll(programTask, admissionsTask, settingsTask);
            
            var program = await programTask;
            var admissions = await admissionsTask;
            _bingoSettings = await settingsTask;

            if (program != null && program.Any())
            {
                Sheets = program.Select(p => new BingoSheet 
                { 
                    ColorName = p.ColorName, 
                    DisplayColor = p.DisplayColor,
                    Price = p.DefaultPrice,
                    PayoutMode = p.PayoutMode,
                    IsAdmissionOnly = p.IsAdmissionOnly,
                    IsIncludedInAdmission = p.IsIncludedInAdmission,
                    LotteryPercentage = p.LotteryPercentage,
                    ClubPercentage = p.ClubPercentage,
                    Games = p.Games.OrderBy(g => g.DisplayOrder).Select(g => new BingoGame 
                    { 
                        Name = g.GameName,
                        DefaultPayout = g.DefaultPayout,
                        IsVariablePayout = g.IsVariablePayout,
                        Payout = g.DefaultPayout 
                    }).ToList()
                }).ToList();
            }

            if (admissions != null && admissions.Any())
            {
                AdmissionPacks = admissions.Select(a => new AdmissionPack 
                { 
                    Id = a.Id, 
                    Name = a.Name, 
                    DisplayColor = a.DisplayColor, 
                    Price = a.Price
                }).ToList();
            }

            if (Sheets.Any() && AdmissionPacks.Any())
            {
                var setup = new BingoSetupCache 
                { 
                    Sheets = Sheets, 
                    AdmissionPacks = AdmissionPacks,
                    Settings = _bingoSettings 
                };
                await JSRuntime.InvokeVoidAsync("window.gfcSetAsync", "gfc_bingo_setup_cache", setup);
            }

            // Inactivity timer
            _inactivityTimer = new Timer(CheckInactivity, null, 60000, 60000);
            await JSRuntime.InvokeVoidAsync("eval", @"
                window.resetBingoTimer = () => { DotNet.invokeMethodAsync('GFC.Mobile', 'ResetInactivityTimer'); };
                window.addEventListener('mousedown', window.resetBingoTimer);
                window.addEventListener('touchstart', window.resetBingoTimer);
                window.addEventListener('keypress', window.resetBingoTimer);
            ");
        }
        catch (Exception ex)
        {
            _isOffline = true;
            // 3. IF OFFLINE OR SERVER ERROR, FALLBACK TO LOCAL CACHE
            Console.WriteLine($"Offline fallback: {ex.Message}");
            var cachedSetup = await JSRuntime.InvokeAsync<BingoSetupCache>("window.gfcGetAsync", "gfc_bingo_setup_cache");
            
            if (cachedSetup != null)
            {
                Sheets = cachedSetup.Sheets;
                AdmissionPacks = cachedSetup.AdmissionPacks;
                if (cachedSetup.Settings != null) _bingoSettings = cachedSetup.Settings;
            }
            else if (!Sheets.Any())
            {
                InitializeDefaultProgram();
            }
        }

        if (!AdmissionPacks.Any())
        {
            AdmissionPacks = new List<AdmissionPack> { new AdmissionPack { Id = 1, Name = "Standard Pack 9", DisplayColor = "#3b82f6", Price = 20 } };
        }

        _activeField = "Pack_" + AdmissionPacks[0].Id;

        await LoadDraftAsync();
        Loading = false;
    }

