        padding: 8px 12px;
        border: 2px solid transparent;
        transition: all 0.2s;
    }

    .tile-stat.focused {
        background: white;
        border-color: var(--bs-primary);
        box-shadow: 0 4px 12px rgba(13, 110, 253, 0.1);
    }

    .tile-stat label {
        display: block;
        font-size: 0.55rem;
        font-weight: 800;
        text-transform: uppercase;
        color: #94a3b8;
        margin-bottom: 2px;
    }

    .tile-stat .val {
        font-weight: 900;
        font-size: 1.1rem;
        color: #1e293b;
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 1.5rem;
    }

    .tile-stat .val.disabled {
        color: #cbd5e1;
        font-size: 0.9rem;
    }

    .tile-games-list {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .tile-game-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 0.6rem;
        font-weight: 700;
        padding: 3px 6px;
        background: rgba(0,0,0,0.02);
        border-radius: 6px;
