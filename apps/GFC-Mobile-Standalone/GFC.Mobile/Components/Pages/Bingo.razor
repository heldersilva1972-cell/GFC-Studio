@if (_selectedPackDetail != null)
{
    var basePack = AdmissionPacks.OrderBy(p => GetAdmitCount(p.Name)).FirstOrDefault();
    var basePrice = basePack?.Price ?? 15.00m;
    var baseCount = 9;
    var currentAdmitCount = GetAdmitCount(_selectedPackDetail.Name);
    var extraCount = currentAdmitCount - baseCount;
    var extraPrice = _selectedPackDetail.Price - basePrice;

    <div class="modal-backdrop-custom animate-fade-in" style="z-index: 5500;" @onclick="() => _selectedPackDetail = null"></div>
    <div class="sheet-detail-modal animate-zoom-in" style="z-index: 6000; border-top: 8px solid #3b82f6;">
        <div class="detail-header bg-primary bg-opacity-10 text-dark">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h2 class="fw-black text-uppercase mb-0" style="letter-spacing: -0.02em;">@_selectedPackDetail.Name</h2>
                    <span class="badge bg-primary rounded-pill px-3 py-1 fw-bold text-uppercase" style="font-size: 0.65rem;">ADMISSION STRUCTURE</span>
                </div>
                <button class="btn btn-link text-muted p-0 border-0 fs-3" @onclick="() => _selectedPackDetail = null">
                    <i class="bi bi-x-circle-fill"></i>
                </button>
            </div>
        </div>

        <div class="detail-body">
            <!-- PACK COMPOSITION -->
            <div class="math-card">
                <div class="math-row">
                    <span class="math-label">Base Admission (9 Squares)</span>
                    <span class="math-val">@basePrice.ToString("C2")</span>
                </div>
                @if (extraCount > 0)
                {
                    <div class="math-row">
                        <span class="math-label">Additional Cards (@extraCount Squares)</span>
                        <span class="math-val">@extraPrice.ToString("C2")</span>
                    </div>
                }
                <div class="math-row total">
                    <span class="math-label text-dark">Total Pack Price</span>
                    <span class="math-val text-primary">@_selectedPackDetail.Price.ToString("C2")</span>
                </div>
            </div>

            @if (_selectedPackDetail.Sold > 0)
            {
                <!-- SESSION TOTAL FOR THIS PACK -->
                <div class="section-divider mb-3"><span>SESSION TOTALS (@_selectedPackDetail.Sold SOLD)</span></div>
                <div class="math-card" style="background: #eff6ff; border-color: #bfdbfe;">
                    <div class="math-row">
                        <span class="math-label">Base Revenue (@(_selectedPackDetail.Sold) @baseCount-packs)</span>
                        <span class="math-val">@((_selectedPackDetail.Sold * basePrice).ToString("C2"))</span>
                    </div>
                    @if (extraCount > 0)
                    {
                        <div class="math-row">
                            <span class="math-label">Add-on Revenue (@(_selectedPackDetail.Sold * extraCount) extra cards)</span>
                            <span class="math-val">@((_selectedPackDetail.Sold * extraPrice).ToString("C2"))</span>
                        </div>
                    }
                    <div class="math-row total" style="border-top-color: #bfdbfe;">
                        <span class="math-label text-primary">Total Revenue</span>
                        <span class="math-val text-primary" style="font-size: 1.4rem;">@((_selectedPackDetail.Sold * _selectedPackDetail.Price).ToString("C2"))</span>
                    </div>
                </div>
            }

            <button class="btn btn-outline-primary w-100 py-3 rounded-pill fw-black mt-2" @onclick="() => _selectedPackDetail = null">
                CLOSE BREAKDOWN
            </button>
        </div>
    </div>
}

@if (_showAdmissionAudit)
{
    var baseRate = _bingoSettings.BasePrice;
    var cardRate = _bingoSettings.CardPrice;
    var currentScaling = GetCurrentPayoutPercentage();
    var tSold = AdmissionPacks.Sum(p => p.Sold);
    
    decimal tBaseRev = 0;
    decimal tExtraRev = 0;
    int tExtraCards = 0;

    foreach (var p in AdmissionPacks)
    {
        if (p.Sold <= 0) continue;
        var pSize = GetAdmitCount(p.Name);
        var pExtraCards = Math.Max(0, (pSize - 9) / 3);
        var pBasePortionPerUnit = baseRate + (pExtraCards * cardRate);
        var pAddOnPortionPerUnit = p.Price - pBasePortionPerUnit;

        tBaseRev += p.Sold * pBasePortionPerUnit;
        tExtraRev += p.Sold * pAddOnPortionPerUnit;
        tExtraCards += p.Sold * (pSize - 9);
    }
    
    var tFloorRev = Sheets.Sum(s => s.ManualSold * s.Price);
    var tFloorCount = Sheets.Sum(s => s.ManualSold);
    var tGrandRev = tBaseRev + tExtraRev + tFloorRev;

    <div class="full-screen-summary animate-fade-in">
        <div class="summary-header d-flex justify-content-between align-items-center px-4 py-3 bg-white border-bottom">
            <div class="d-flex align-items-center gap-3">
                <div class="summary-icon-box bg-primary text-white">
                    <i class="bi bi-graph-up-arrow"></i>
                </div>
                <div>
                    <h4 class="fw-black mb-0 text-uppercase">Bingo Session Summary</h4>
                    <span class="text-muted extra-small fw-bold">@SessionDate.ToLongDateString() | @tSold TOTAL PLAYERS</span>
                </div>
            </div>
            <button class="btn btn-light rounded-pill px-4 fw-black border-2" @onclick="() => _showAdmissionAudit = false">
                <i class="bi bi-x-lg me-2"></i> CLOSE SUMMARY
            </button>
        </div>

        <div class="summary-content flex-grow-1 p-4 overflow-auto">
            <div class="container-fluid px-0">
                <!-- TOP LEVEL KPI CARDS -->
                <div class="row g-3 mb-4">
                    <div class="col-md-3">
                        <div class="kpi-card">
                            <label>TOTAL GROSS RECEIPTS</label>
                            <div class="val">@TotalGross.ToString("C2")</div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="kpi-card">
                            <label>TOTAL PRIZES PAID</label>
                            <div class="val text-danger">@TotalPrizes.ToString("C2")</div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="kpi-card text-muted">
                            <label>TOTAL LOTTERY FEES</label>
                            <div class="val text-muted">@TotalLotteryTake.ToString("C2")</div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="kpi-card highlight">
                            <label>NET CLUB PROFIT</label>
                            <div class="val">@TotalClubTake.ToString("C2")</div>
                        </div>
                    </div>
                </div>

                <div class="row g-4">
                    <!-- LEFT COLUMN: ACCOUNTING & ADMISSIONS -->
                    <div class="col-lg-4">
                        <div class="summary-section-card h-100">
                            <div class="section-header-compact">
                                <i class="bi bi-cash-coin me-2"></i> ADMISSION ACCOUNTING
                            </div>
                            <div class="p-3">
                                <div class="accounting-row">
                                    <div>
                                        <span class="d-block">Core Admission Fees</span>
                                        <small class="text-muted fw-bold" style="font-size: 0.6rem;">@tSold PLAYERS @@ @baseRate.ToString("C2")</small>
                                    </div>
                                    <span class="fw-black">@tBaseRev.ToString("C2")</span>
                                </div>
                                <div class="accounting-row">
                                    <div>
                                        <span class="d-block">Included Special Cards</span>
                                        <small class="text-muted fw-bold" style="font-size: 0.6rem;">VALUE WITHIN ADMISSION PACKS</small>
                                    </div>
                                    <span class="fw-black">@tExtraRev.ToString("C2")</span>
                                </div>
                                <div class="accounting-row mb-3">
                                    <div>
                                        <span class="d-block">Separately Purchased</span>
                                        <small class="text-muted fw-bold" style="font-size: 0.6rem;">ADDITIONAL FLOOR SALES (@tFloorCount SHEETS)</small>
                                    </div>
                                    <span class="fw-black">@tFloorRev.ToString("C2")</span>
                                </div>
                                <div class="p-2 bg-light rounded-3 mb-3" style="font-size: 0.75rem;">
                                    <div class="d-flex justify-content-between mb-1 text-muted">
                                        <span>Base 9-Pack Rate</span>
                                        <span>@baseRate.ToString("C2")</span>
                                    </div>
                                    <div class="d-flex justify-content-between text-muted">
                                        <span>Extra Square Rate (3 Sq)</span>
                                        <span>@cardRate.ToString("C2")</span>
                                    </div>
                                </div>
                                <div class="accounting-total text-primary">
                                    <span>Total Session Revenue</span>
                                    <span>@tGrandRev.ToString("C2")</span>
                                </div>
                            </div>

                            <div class="section-header-compact mt-3">
                                <i class="bi bi-info-circle me-2"></i> PAYOUT SCALING
                            </div>
                            <div class="p-3">
                                <div class="p-3 rounded-4 @(currentScaling < 100 ? "bg-warning bg-opacity-10 border border-warning" : "bg-success bg-opacity-10 border border-success")">
                                    <div class="fw-black text-uppercase mb-1" style="font-size: 0.7rem;">Active Payout Scale</div>
                                    <div class="d-flex align-items-baseline gap-2">
                                        <span class="fs-2 fw-black">@currentScaling.ToString("N1")%</span>
                                        <span class="extra-small fw-bold text-muted">(@tSold Players)</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- RIGHT COLUMN: SHEET PERFORMANCE TABLE -->
                    <div class="col-lg-8">
                        <div class="summary-section-card h-100">
                            <div class="section-header-compact">
                                <i class="bi bi-grid-3x3-gap-fill me-2"></i> COLOR SHEET PERFORMANCE
                            </div>
                            <div class="p-0">
                                <table class="table summary-table-detailed mb-0">
                                    <thead>
                                        <tr>
                                            <th>SHEET COLOR</th>
                                            <th class="text-center">MODE</th>
                                            <th class="text-center">ADMISSION</th>
                                            <th class="text-center">ADDITIONAL</th>
                                            <th class="text-center">TOTAL SOLD</th>
                                            <th class="text-end">GROSS</th>
                                            <th class="text-end">PRIZES</th>
                                            <th class="text-end">NET PROFIT</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var s in Sheets)
                                        {
                                            var sAdmission = s.IsIncludedInAdmission ? AdmissionCount : 0;
                                            var sManual = s.ManualSold;
                                            var sGross = (sAdmission * s.Price) + (sManual * s.Price);
                                            var sPrizes = s.Games.Sum(g => CalculateGamePayout(s, g));
                                            var sNet = CalculateSheetNet(s);
                                            <tr class="summary-row-clickable" @onclick="() => OpenSheetFromSummary(s)">
                                                <td>
                                                    <div class="d-flex align-items-center gap-2">
                                                        <div class="color-dot" style="background: @s.DisplayColor"></div>
                                                        <span class="fw-black text-uppercase">@s.ColorName</span>
                                                    </div>
                                                </td>
                                                <td class="text-center">
                                                    <span class="extra-small fw-bold text-muted">
                                                        @(s.PayoutMode == 0 ? "FIXED" : s.PayoutMode == 1 ? "50/50" : "GROSS %")
                                                    </span>
                                                </td>
                                                <td class="text-center fw-bold text-muted">@sAdmission</td>
                                                <td class="text-center fw-bold @(sManual > 0 ? "text-primary" : "text-muted opacity-25")">@sManual</td>
                                                <td class="text-center fw-black">@s.Sold</td>
                                                <td class="text-end">@sGross.ToString("C2")</td>
                                                <td class="text-end text-danger fw-bold">@sPrizes.ToString("C2")</td>
                                                <td class="text-end fw-black text-success">@sNet.ToString("C2")</td>
                                            </tr>
                                        }
                                    </tbody>
                                    <tfoot>
                                        <tr class="table-light">
                                            <th colspan="2">SESSION TOTALS</th>
                                            <th class="text-center">@AdmissionCount <br/><small class="text-muted">PLAYERS</small></th>
                                            <th class="text-center">@Sheets.Sum(s => s.ManualSold) <br/><small class="text-muted">ADDITIONAL</small></th>
                                            <th></th>
                                            <th class="text-end">@TotalGross.ToString("C2")</th>
                                            <th class="text-end text-danger">@TotalPrizes.ToString("C2")</th>
                                            <th class="text-end text-success fs-5">@TotalClubTake.ToString("C2")</th>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- GAME BY GAME DETAILS -->
                <div class="row mt-4 mb-5">
                    <div class="col-12">
                        <div class="summary-section-card">
                            <div class="section-header-compact">
                                <i class="bi bi-list-stars me-2"></i> INDIVIDUAL GAME PAYOUT DETAILS
                            </div>
                            <div class="p-3">
                                <div class="row g-3">
                                    @foreach (var s in Sheets)
                                    {
                                        <div class="col-md-6 col-lg-3">
                                            <div class="game-group-box border rounded-4 p-3 h-100">
                                                <div class="d-flex align-items-center gap-2 mb-2 pb-2 border-bottom">
                                                    <div class="color-dot" style="background: @s.DisplayColor"></div>
                                                    <span class="fw-black text-uppercase" style="font-size: 0.75rem;">@s.ColorName</span>
                                                </div>
                                                @foreach (var g in s.Games)
                                                {
                                                    var totalPayout = CalculateGamePayout(s, g);
                                                    var perWinner = g.WinnerCount > 0 ? totalPayout / g.WinnerCount : totalPayout;
                                                    
                                                    <div class="mb-2 border-bottom border-light pb-1">
                                                        <div class="d-flex justify-content-between align-items-center extra-small">
                                                            <span class="text-muted fw-bold">@g.Name</span>
                                                            <span class="fw-black text-primary">@totalPayout.ToString("C2")</span>
                                                        </div>
                                                        @if (g.WinnerCount > 1)
                                                        {
                                                            <div class="d-flex justify-content-between align-items-center mt-2" style="font-size: 0.8rem;">
                                                                <span class="badge bg-primary text-white py-1 px-2 fw-black shadow-sm">
                                                                    <i class="bi bi-people-fill me-1"></i> @g.WinnerCount WINNERS
                                                                </span>
                                                                <span class="text-primary fw-black">@perWinner.ToString("C2") EACH</span>
                                                            </div>
                                                        }
                                                        else if (g.WinnerCount == 1)
                                                        {
                                                            <div class="mt-1 text-muted fw-bold" style="font-size: 0.7rem;">
                                                                <i class="bi bi-person-fill"></i> SINGLE WINNER
                                                            </div>
                                                        }
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@if (_showScalingTiers)
{
    <div class="modal-backdrop-custom animate-fade-in" style="z-index: 7000;" @onclick="() => _showScalingTiers = false"></div>
    <div class="sheet-detail-modal animate-zoom-in" style="z-index: 7500; max-width: 400px; border-top: 8px solid #1e293b;">
        <div class="detail-header bg-dark text-white">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h3 class="fw-black text-uppercase mb-0" style="letter-spacing: -0.02em;">Payout Scaling</h3>
                    <span class="badge bg-white bg-opacity-20 rounded-pill px-3 py-1 fw-bold text-uppercase" style="font-size: 0.6rem;">Attendance Rules</span>
                </div>
                <button class="btn btn-link text-white p-0 border-0 fs-3" @onclick="() => _showScalingTiers = false">
                    <i class="bi bi-x-circle-fill"></i>
                </button>
            </div>
        </div>
        <div class="detail-body p-0">
            <div class="p-4 bg-light border-bottom text-center">
                <div class="text-muted fw-bold extra-small text-uppercase mb-1">Current Session Attendance</div>
                <div class="display-5 fw-black text-primary">@AdmissionCount</div>
                <div class="fw-bold text-primary opacity-75 small">PLAYERS</div>
            </div>
            <div class="p-4" style="background: white;">
                @foreach (var tier in _bingoSettings.PayoutTiers.OrderBy(t => t.MinAdmissions))
                {
                    var isCurrent = tier == GetCurrentTier();
                    <div class="d-flex justify-content-between align-items-center p-3 mb-2 rounded-4 @(isCurrent ? "bg-primary text-white shadow-lg border-0" : "bg-light border border-light-subtle")" 
                         style="transition: all 0.2s;">
                        <div class="d-flex align-items-center gap-3">
                            <div class="rounded-circle d-flex align-items-center justify-content-center @(isCurrent ? "bg-white text-primary" : "bg-secondary bg-opacity-10 text-secondary")" style="width: 40px; height: 40px;">
                                <i class="bi @(isCurrent ? "bi-check-lg" : "bi-people-fill") fs-5"></i>
                            </div>
                            <div>
                                <div class="fw-black text-uppercase" style="font-size: 0.8rem;">@(tier.MinAdmissions)+ Players</div>
                                <div class="fw-bold extra-small @(isCurrent ? "text-white-50" : "text-muted")">@(isCurrent ? "CURRENT ACTIVE TIER" : "Minimum Requirement")</div>
                            </div>
                        </div>
                        <div class="text-end">
                            <div class="fs-4 fw-black">@tier.PayoutPercentage.ToString("N0")%</div>
                            <div class="fw-bold extra-small @(isCurrent ? "text-white-50" : "text-muted")">PRIZE RATE</div>
                        </div>
                    </div>
                }
            </div>
            <div class="p-4 pt-0">
                <div class="alert alert-info py-2 rounded-3 border-0 mb-4" style="font-size: 0.65rem;">
                    <i class="bi bi-info-circle-fill me-1"></i>
