    private async Task CheckForBlockingOpenSessionAsync()
    {
        try
        {
            _hasBlockingOpenSession = false;
            _blockingSessionDate = null;
            var options = new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true };

            var records = await JSRuntime.InvokeAsync<List<VaultRecord>>("window.gfcGetAllAsync");
            if (records != null)
            {
                foreach (var rec in records)
                {
                    if (rec.Key != null && rec.Key.StartsWith("gfc_bingo_draft_"))
                    {
                        var keySuffix = rec.Key.Replace("gfc_bingo_draft_", "");
                        if (DateTime.TryParseExact(keySuffix, "yyyyMMdd", null, System.Globalization.DateTimeStyles.None, out var parsedDate))
                        {
                            if (parsedDate.Date == SessionDate.Date)
                            {
                                continue;
                            }
                            
                            var draft = System.Text.Json.JsonSerializer.Deserialize<BingoDraft>(rec.Data.GetRawText(), options);
                            if (draft != null && draft.SessionState == "Open")
                            {
                                _hasBlockingOpenSession = true;
                                _blockingSessionDate = parsedDate;
                                return;
                            }
                        }
                    }
                }
            }

            // Check server sessions for open/partial tracking
            try
            {
                var serverHistory = await ReportingService.GetBingoSessionHistoryAsync();
                if (serverHistory != null)
                {
                    foreach (var s in serverHistory)
                    {
                        if (s.SessionDate.Date == SessionDate.Date)
                        {
                            continue;
                        }
                        if (s.Status == "Partial" || s.Status == "Open" || s.Status == "Draft")
                        {
                            // Check if we have a local draft for this date and if it is closed/locked
                            var targetKey = $"gfc_bingo_draft_{s.SessionDate:yyyyMMdd}";
                            var localRecord = records?.FirstOrDefault(r => string.Equals(r.Key, targetKey, StringComparison.OrdinalIgnoreCase));
                            if (localRecord != null)
                            {
                                var localDraft = System.Text.Json.JsonSerializer.Deserialize<BingoDraft>(localRecord.Data.GetRawText(), options);
                                if (localDraft != null && (localDraft.SessionState == "Closed" || localDraft.SessionState == "Submitted"))
                                {
                                    continue; // Local is closed/locked, ignore server's out-of-sync status
                                }
                            }

                            _hasBlockingOpenSession = true;
                            _blockingSessionDate = s.SessionDate;
                            return;
                        }
                    }
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"[BINGO] Error checking server for blocking sessions: {ex.Message}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[BINGO] Error checking blocking open session: {ex.Message}");
        }
    }

    private void LoadFromServerSession(BingoSession serverSession)
    {
        _sessionState = (serverSession.Status == "Submitted" || serverSession.Status == "Closed") ? "Closed" : "Open";
        _sessionEntered = true; // Auto-enter to show pre-populated data!
        _pullTabEntries = serverSession.PullTabEntries?.ToList() ?? new List<PullTabGameEntry>();
        _doorPrizeAmount = serverSession.DoorPrizeAmount;
        _doorPrizeCount = serverSession.DoorPrizeCount;
        _wtaColor = serverSession.WtaColor ?? "";
        _progColor = serverSession.ProgColor ?? "";
        _beanoSuppliesSales = serverSession.BeanoSuppliesSales;
        _beanoOtherReceipts = serverSession.BeanoOtherReceipts;
        _beanoUnexpendedNetProfit = serverSession.BeanoUnexpendedNetProfit;
        _beanoInterest = serverSession.BeanoInterest;
        _beanoGameBank = serverSession.BeanoGameBank;
        _beanoOthers = serverSession.BeanoOthers;
        _beanoCheckbookBalance = serverSession.BeanoCheckbookBalance;
        _beanoSavingsBalance = serverSession.BeanoSavingsBalance;
        _beanoCdBalance = serverSession.BeanoCdBalance;
        _beanoProgBeginningBalance = serverSession.BeanoProgBeginningBalance;
        _beanoTaxCheckNumber = serverSession.BeanoTaxCheckNumber ?? "";
        _beanoOccasionTime = serverSession.BeanoOccasionTime ?? "6:45 PM";
        _fiftyFifty1Color = serverSession.FiftyFifty1Color ?? "";
        _fiftyFifty2Color = serverSession.FiftyFifty2Color ?? "";
        _fiftyFifty3Color = serverSession.FiftyFifty3Color ?? "";

        try
        {
            _beanoDisbursements = !string.IsNullOrEmpty(serverSession.BeanoDisbursementsJson)
                ? System.Text.Json.JsonSerializer.Deserialize<List<BeanoDisbursement>>(serverSession.BeanoDisbursementsJson) ?? new()
                : new();
        }
        catch { _beanoDisbursements = new(); }

        try
        {
            _beanoOtherExpenses = !string.IsNullOrEmpty(serverSession.BeanoOtherExpensesJson)
                ? System.Text.Json.JsonSerializer.Deserialize<List<BeanoExpense>>(serverSession.BeanoOtherExpensesJson) ?? new()
                : new();
        }
        catch { _beanoOtherExpenses = new(); }

        UpdatePreviousSellers();
        
        // 1. Populate AdmissionPacks
        foreach (var p in AdmissionPacks)
        {
            var entry = serverSession.AdmissionEntries?.FirstOrDefault(ae => ae.AdmissionDefinitionId == p.Id);
            p.Sold = entry?.Quantity ?? 0;
        }

        // 2. Populate Sheets and Games
        foreach (var s in Sheets)
        {
            var sheetEntries = serverSession.GameEntries?.Where(ge => ge.SheetColor == s.ColorName).ToList() ?? new List<BingoGameEntry>();
            
            var extraEntry = sheetEntries.FirstOrDefault(e => e.PricePerSheet > 0);
            s.ManualSold = extraEntry?.SheetsSold ?? 0;
            
            s.IsClosedOut = true; 
            s.IsSynced = true;
            
            foreach (var g in s.Games)
            {
                var gameEntries = sheetEntries.Where(e => string.Equals(e.GameName?.Trim(), g.Name?.Trim(), StringComparison.OrdinalIgnoreCase)).ToList();
                
                var entryWithBalls = gameEntries.FirstOrDefault(e => e.BallsCalled > 0);
                g.BallsCalled = entryWithBalls?.BallsCalled ?? 0;

                var entryWithGoal = gameEntries.FirstOrDefault(e => e.ProgressiveBallGoal.HasValue);
                if (entryWithGoal != null)
                {
                    g.CurrentBallGoal = entryWithGoal.ProgressiveBallGoal.Value;
                }

                g.WinnerCount = 1;
                g.CustomPayoutOverride = null;
                
                // Reconstruct CustomPayoutOverride if the prize paid on server differs from standard calculated payout
                var defaultPayout = CalculateGamePayout(s, g); 
                var actualPrizePaid = gameEntries.Sum(e => e.PrizePaid);
                if (actualPrizePaid > 0 && Math.Abs(actualPrizePaid - defaultPayout) > 0.05m)
                {
                    g.CustomPayoutOverride = actualPrizePaid;
                }
            }
        }
        
        RecalculateSheetTotals();
    }

    private async Task LoadDraftAsync()
    {
        try 
        {
            await CheckForBlockingOpenSessionAsync();
            var key = $"gfc_bingo_draft_{SessionDate:yyyyMMdd}";
            var draft = await JSRuntime.InvokeAsync<BingoDraft>("window.gfcGetAsync", key);
            
            // Try querying server for submitted/synced session
            BingoSession? serverSession = null;
            bool serverCallFailed = false;
            try
            {
                serverSession = await ReportingService.GetBingoSessionByDateAsync(SessionDate);
            }
            catch (Exception ex)
            {
                Console.WriteLine($"[BINGO] GetBingoSessionByDateAsync error: {ex.Message}");
                serverCallFailed = true;
            }

            if (serverSession != null && (serverSession.Status == "Submitted" || serverSession.Status == "Closed"))
            {
                LoadFromServerSession(serverSession);
                _needsSync = false;
                await SaveDraftAsync();
            }
            else if (draft != null)
            {
                _sessionState = draft.SessionState ?? "NotStarted";
                _useManualScaling = draft.UseManualScaling;
                _payoutPercentage = draft.PayoutPercentage > 0 ? draft.PayoutPercentage : 100m;
                _targetProfitPercentage = draft.TargetProfitPercentage;
                if (_targetProfitPercentage == 0m && _payoutPercentage != 100m && _useManualScaling)
                {
                    UpdateTargetProfitPercentage();
                }
                _pullTabEntries = draft.PullTabEntries ?? new List<PullTabGameEntry>();
                _doorPrizeAmount = draft.DoorPrizeAmount;
                _doorPrizeCount = draft.DoorPrizeCount;
                _beanoOccasionTime = draft.BeanoOccasionTime ?? "6:45 PM";
                _beanoSuppliesSales = draft.BeanoSuppliesSales;
                _beanoOtherReceipts = draft.BeanoOtherReceipts;
                _beanoTaxCheckNumber = draft.BeanoTaxCheckNumber ?? "";
                _beanoUnexpendedNetProfit = draft.BeanoUnexpendedNetProfit;
                _beanoInterest = draft.BeanoInterest;
                _beanoGameBank = draft.BeanoGameBank;
                _beanoOthers = draft.BeanoOthers;
                _beanoCheckbookBalance = draft.BeanoCheckbookBalance;
                _beanoSavingsBalance = draft.BeanoSavingsBalance;
                _beanoCdBalance = draft.BeanoCdBalance;
                _beanoProgBeginningBalance = draft.BeanoProgBeginningBalance;
                _beanoOtherExpenses = draft.BeanoOtherExpenses ?? new List<BeanoExpense>();
                _beanoDisbursements = draft.BeanoDisbursements ?? new List<BeanoDisbursement>();
                _wtaColor = draft.WtaColor ?? "";
                _progColor = draft.ProgColor ?? "";
                _fiftyFifty1Color = draft.FiftyFifty1Color ?? "";
                _fiftyFifty2Color = draft.FiftyFifty2Color ?? "";
                _fiftyFifty3Color = draft.FiftyFifty3Color ?? "";
                UpdatePreviousSellers();
                foreach (var dPack in draft.AdmissionPacks)
                {
                    var p = AdmissionPacks.FirstOrDefault(x => x.Id == dPack.Id);
                    if (p != null) p.Sold = dPack.Sold;
                }
                foreach (var dSheet in draft.Sheets)
                {
                    var s = Sheets.FirstOrDefault(x => x.ColorName == dSheet.ColorName);
                    if (s != null)
                    {
                        s.ManualSold = dSheet.ManualSold;
                        s.IsClosedOut = dSheet.IsClosedOut;
                        foreach (var dGame in dSheet.Games)
                        {
                            var g = s.Games.FirstOrDefault(x => string.Equals(x.Name?.Trim(), dGame.Name?.Trim(), StringComparison.OrdinalIgnoreCase));
                            if (g != null) 
                            {
                                g.Payout = dGame.Payout;
                                g.WinnerCount = dGame.WinnerCount;
                                g.BallsCalled = dGame.BallsCalled;
                                g.CustomPayoutOverride = dGame.CustomPayoutOverride;
                                if (dGame.CurrentBallGoal > 0)
                                {
                                    g.CurrentBallGoal = dGame.CurrentBallGoal;
                                }
                            }
                        }
                    }
                }
                if (_sessionState == "Open" || _sessionState == "NotStarted")
                {
                    foreach (var s in Sheets) s.IsClosedOut = false;
                }
                RecalculateSheetTotals();
                _needsSync = true;
            }
            else if (serverSession != null)
            {
                LoadFromServerSession(serverSession);
                _needsSync = false;
                await SaveDraftAsync();
            }
            else
            {
                // FULL RESET FOR BLANK SESSION
                _sessionState = "NotStarted";
                _useManualScaling = true;
                _payoutPercentage = 100m;
                UpdateTargetProfitPercentage();
                _pullTabEntries = new List<PullTabGameEntry>();
                _doorPrizeAmount = 0m;
                _doorPrizeCount = 0;
                _wtaColor = "";
                _progColor = "";
                _fiftyFifty1Color = "";
                _fiftyFifty2Color = "";
                _fiftyFifty3Color = "";
                _beanoSuppliesSales = 0m;
                _beanoOtherReceipts = 0m;
                _beanoInterest = 0m;
                _beanoGameBank = 0m;
                _beanoOthers = 0m;
                _beanoCheckbookBalance = 0m;
                _beanoSavingsBalance = 0m;
                _beanoCdBalance = 0m;
                _beanoProgBeginningBalance = 0m;
                _beanoTaxCheckNumber = "";
                _beanoOccasionTime = "6:45 PM";
                _beanoDisbursements = new();
                _beanoOtherExpenses = new();
                _beanoUnexpendedNetProfit = 0m;
                
                await SetPreviousUnexpendedNetProfitAsync();
                
                foreach (var p in AdmissionPacks) p.Sold = 0;
                foreach (var s in Sheets)
                {
                    s.ManualSold = 0;
                    s.IsClosedOut = false;
                    s.IsSynced = false;
                    foreach (var g in s.Games)
                    {
                        g.WinnerCount = 1;
                        g.BallsCalled = 0;
                        g.CustomPayoutOverride = null;
                    }
                }
                RecalculateSheetTotals();
                _needsSync = false;

                // Alert user if this is a past date and we couldn't load it
                if (SessionDate.Date < DateTime.Today)
                {
                    if (_isOffline || serverCallFailed)
                    {
                        await ShowToast("Offline Mode", $"No local draft found for {SessionDate:MM/dd/yyyy}, and server is unreachable.", "warning");
                    }
                    else
                    {
                        await ShowToast("No Session Found", $"No local draft or server session exists for {SessionDate:MM/dd/yyyy}.", "info");
                    }
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Draft error: {ex.Message}");
        }
    }

    private async Task CloseOutColorAsync()
    {
        if (_selectedSheet == null) return;
        
        // Mark as closed locally immediately
        _selectedSheet.IsClosedOut = true;
        _selectedSheet.IsSynced = false; // Assume pending until server confirms
        _showCloseOutConfirmation = false;

        // Save locally first so the "Closed" state is persisted even if the next part fails
        await SaveDraftAsync();
        
        // Prepare session object for the server
        var session = PrepareSessionObject();
        session.Status = "Partial"; 
        
        try
        {
            var success = await ReportingService.SubmitBingoSessionAsync(session, _currentUsername);
            if (success)
            {
                _selectedSheet.IsSynced = true;
                await SaveDraftAsync(); // Update local draft with synced status
                await ShowToast("Closed & Synced", $"{_selectedSheet.ColorName} data has been saved to the server.");
            }
            else
            {
                await ShowToast("Saved Offline", $"{_selectedSheet.ColorName} is closed locally and will sync when online.", "warning");
            }
        }
        catch
        {
            // Fail silently on server error, we have the local backup
            await ShowToast("Saved Offline", $"{_selectedSheet.ColorName} is closed locally and will sync when online.", "warning");
        }
        
        _selectedSheet = null;
        StateHasChanged();
    }

    private async Task BackgroundSyncAsync()
    {
        if (_isSyncing || !_needsSync) return;

        try
        {
            // Submit the entire session state silently in the background
            var session = PrepareSessionObject();
            session.Status = "Partial";

            var success = await ReportingService.SubmitBingoSessionAsync(session, _currentUsername);
            if (success)
            {
                // Mark all closed sheets as synced
                foreach (var s in Sheets.Where(s => s.IsClosedOut)) s.IsSynced = true;
                _needsSync = false;
                await SaveDraftAsync();
                Console.WriteLine("[BINGO] Background sync successful.");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[BINGO] Background sync failed: {ex.Message}");
        }
        // NOTE: We do NOT set _isSyncing = true/false here to avoid pulsing the header UI every 30 seconds
    }

    private BingoSession PrepareSessionObject()
    {
        return new BingoSession
        {
            SessionDate = SessionDate,
            AdmissionCount = AdmissionCount,
            TotalGrossReceipts = TotalGross,
            TotalPrizesPaid = TotalPrizes,
            TotalLotteryTake = TotalLotteryTake,
            TotalClubTake = TotalClubTake,
            RoundingAdjustment = TotalRoundingAdjustment,
            Status = "Submitted",
            DoorPrizeAmount = _doorPrizeAmount,
            DoorPrizeCount = _doorPrizeCount,
            WtaColor = _wtaColor,
            ProgColor = _progColor,
            BeanoSuppliesSales = _beanoSuppliesSales,
            BeanoOtherReceipts = _beanoOtherReceipts,
            BeanoUnexpendedNetProfit = _beanoUnexpendedNetProfit,
            BeanoInterest = _beanoInterest,
            BeanoGameBank = _beanoGameBank,
            BeanoOthers = _beanoOthers,
            BeanoCheckbookBalance = _beanoCheckbookBalance,
            BeanoSavingsBalance = _beanoSavingsBalance,
            BeanoCdBalance = _beanoCdBalance,
            BeanoTaxCheckNumber = _beanoTaxCheckNumber,
            BeanoOccasionTime = _beanoOccasionTime,
            FiftyFifty1Color = _fiftyFifty1Color,
            FiftyFifty2Color = _fiftyFifty2Color,
            FiftyFifty3Color = _fiftyFifty3Color,
            BeanoDisbursementsJson = System.Text.Json.JsonSerializer.Serialize(_beanoDisbursements),
            BeanoOtherExpensesJson = System.Text.Json.JsonSerializer.Serialize(_beanoOtherExpenses),
            AdmissionEntries = AdmissionPacks.Where(p => p.Sold > 0).Select(p => new BingoAdmissionEntry
            {
                AdmissionDefinitionId = p.Id,
                Quantity = p.Sold,
                PriceAtTime = p.Price
            }).ToList(),
            Category = "Standard", // Default or drive from state
            GameEntries = Sheets.SelectMany(s => {
                var entries = new List<BingoGameEntry>();
                var pkgCount = s.IsIncludedInAdmission ? AdmissionCount : 0;
                var extraCount = s.ManualSold;

                foreach (var g in s.Games)
                {
                    // 1. Add Package Entry (if applicable)
                    if (pkgCount > 0)
                    {
                        var pkgGross = GetAllocatedAdmissionGross(s) / s.Games.Count;
                        var totalSheetGross = GetAllocatedAdmissionGross(s) + (s.ManualSold * s.Price);
                        var pkgPrizeRatio = totalSheetGross > 0 ? (GetAllocatedAdmissionGross(s) / totalSheetGross) : 1.0m;

                        entries.Add(new BingoGameEntry
                        {
                            SheetColor = s.ColorName,
                            GameName = g.Name,
                            SheetsSold = pkgCount,
                            PricePerSheet = 0, // Identity for "Package" in reports
                            GrossReceipts = pkgGross,
                            PrizePaid = CalculateGamePayout(s, g) * pkgPrizeRatio,
                            RoundingAdjustment = CalculateGameRoundingAdjustment(s, g) * pkgPrizeRatio,
                            LotteryPercentage = s.LotteryPercentage,
                            ClubPercentage = s.ClubPercentage,
                            LotteryTake = CalculateLotteryTake(s) * pkgPrizeRatio / s.Games.Count,
                            ClubTake = CalculateClubTake(s) * pkgPrizeRatio / s.Games.Count,
                            NetProceeds = CalculateSheetNet(s) * pkgPrizeRatio / s.Games.Count,
                            BallsCalled = g.BallsCalled,
                            Category = s.Category.ToString(),
                            ProgressiveBallGoal = g.IsProgressive ? g.CurrentBallGoal : null
                        });
                    }

                    // 2. Add Extra Entry (if applicable)
                    if (extraCount > 0)
                    {
                        var extraGross = (s.ManualSold * s.Price) / s.Games.Count;
                        var totalSheetGross = GetAllocatedAdmissionGross(s) + (s.ManualSold * s.Price);
                        var extraPrizeRatio = totalSheetGross > 0 ? ((s.ManualSold * s.Price) / totalSheetGross) : 1.0m;

                        entries.Add(new BingoGameEntry
                        {
                            SheetColor = s.ColorName,
                            GameName = g.Name,
                            SheetsSold = extraCount,
                            PricePerSheet = s.Price,
                            GrossReceipts = s.ManualSold * s.Price / s.Games.Count,
                            PrizePaid = CalculateGamePayout(s, g) * extraPrizeRatio,
                            RoundingAdjustment = CalculateGameRoundingAdjustment(s, g) * extraPrizeRatio,
                            LotteryPercentage = s.LotteryPercentage,
                            ClubPercentage = s.ClubPercentage,
                            LotteryTake = CalculateLotteryTake(s) * extraPrizeRatio / s.Games.Count,
                            ClubTake = CalculateClubTake(s) * extraPrizeRatio / s.Games.Count,
                            NetProceeds = CalculateSheetNet(s) * extraPrizeRatio / s.Games.Count,
                            BallsCalled = g.BallsCalled,
                            Category = s.Category.ToString(),
                            ProgressiveBallGoal = g.IsProgressive ? g.CurrentBallGoal : null
                        });
                    }
                }
                return entries;
            }).ToList(),
            PullTabEntries = _pullTabEntries.Select(p => new PullTabGameEntry
            {
                Id = p.Id,
                SessionId = p.SessionId,
                GameDefinitionId = p.GameDefinitionId,
                SelectedPrizeOptionId = p.SelectedPrizeOptionId,
                SellerName = p.SellerName,
                SerialNumber = p.SerialNumber,
                TicketsIssued = p.TicketsIssued,
                TicketsReturned = p.TicketsReturned,
                PrizesPaid = p.PrizesPaid,
                StartingBank = p.StartingBank,
                CashReceived = p.CashReceived
            }).ToList()
        };
    }

    private void AutoMapSpecialSheets()
    {
        // WTA sheets: find sheet that is WTA
        var wtaSheets = Sheets.Where(s => s.ColorName.Contains("W.T.A.", StringComparison.OrdinalIgnoreCase) || s.ColorName.Contains("WTA", StringComparison.OrdinalIgnoreCase) || s.Games.Any(g => g.Name.Contains("W.T.A.", StringComparison.OrdinalIgnoreCase) || g.Name.Contains("WTA", StringComparison.OrdinalIgnoreCase))).ToList();
        if (wtaSheets.Count > 0 && string.IsNullOrEmpty(_wtaColor))
        {
            _wtaColor = wtaSheets[0].ColorName;
        }

        // Progressive sheets: find sheets where games have IsProgressive = true
        var progSheets = Sheets.Where(s => s.Games.Any(g => g.IsProgressive)).ToList();
        if (progSheets.Count > 0 && string.IsNullOrEmpty(_progColor))
        {
            _progColor = progSheets[0].ColorName;
        }

        // 50/50 sheets: find sheets that are Fifty-Fifty (IsFiftyFifty == true) or contain "50"
        var ffSheets = Sheets.Where(s => s.IsFiftyFifty || s.ColorName.Contains("50") || s.Games.Any(g => g.Name.Contains("50"))).ToList();
        if (ffSheets.Count > 0)
        {
            if (string.IsNullOrEmpty(_fiftyFifty1Color)) _fiftyFifty1Color = ffSheets[0].ColorName;
            if (ffSheets.Count > 1 && string.IsNullOrEmpty(_fiftyFifty2Color)) _fiftyFifty2Color = ffSheets[1].ColorName;
            if (ffSheets.Count > 2 && string.IsNullOrEmpty(_fiftyFifty3Color)) _fiftyFifty3Color = ffSheets[2].ColorName;
        }
    }

