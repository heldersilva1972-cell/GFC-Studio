        border-bottom: 1px solid rgba(0,0,0,0.05);
        border-radius: 28px 28px 0 0;
    }

    .btn-close-compact {
        background: #f8fafc;
        border: none;
        width: 36px;
        height: 36px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #64748b;
    }

    .modal-body-compact {
        overflow-y: auto;
        flex-grow: 1;
    }

    .bg-primary-subtle { background-color: rgba(13, 110, 253, 0.08) !important; }

    .color-dot-large {
        width: 14px;
        height: 14px;
        border-radius: 50%;
    }

    .entry-val-large {
        font-weight: 950;
        font-size: 2rem;
        min-width: 80px;
        text-align: center;
        border-radius: 16px;
        padding: 8px 16px;
