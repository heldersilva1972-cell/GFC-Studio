    private decimal CalculateGamePayoutForDraftSheet(BingoSheet sheet, BingoGame game, int prevPacksSold, decimal prevPayoutPercentage, bool prevUseManualScaling, decimal prevTargetProfitPercentage)
    {
        if (game.CustomPayoutOverride.HasValue) return game.CustomPayoutOverride.Value;

        if (game.IsProgressive)
        {
            return (game.BallsCalled > 0 && game.BallsCalled <= game.CurrentBallGoal)
                ? game.JackpotAmount 
                : game.ConsolationAmount;
        }

        var sold = sheet.ManualSold + (sheet.IsIncludedInAdmission && !sheet.IsAdmissionOnly ? prevPacksSold : 0);
        if (game.PayoutMode == 1 || game.PayoutMode == 2)
        {
            var gross = sold * sheet.Price;
            decimal availableForPrizes;
            var effectiveLottery = (sheet.IsAdmissionOnly) ? 0m : sheet.LotteryPercentage;
            var effectiveClub = game.ClubPercentage ?? (game.PayoutMode == 2 ? 0.05m : 0.5m);

            if (game.PayoutMode == 1) // 50/50 Split (Sequential)
            {
                var lottery = gross * effectiveLottery;
                availableForPrizes = (gross - lottery) * (1 - effectiveClub);
            }
            else // Mode 2: Additive (Gross %)
            {
                var totalDeductionPercent = effectiveLottery + effectiveClub;
                availableForPrizes = gross * (1 - totalDeductionPercent);
            }

            var rawShare = (sheet.Games.Count > 0 ? (availableForPrizes / sheet.Games.Count) : availableForPrizes) / game.WinnerCount;
            var roundedShare = rawShare;
            if (_bingoSettings.PayoutRoundingMode == 1)
                roundedShare = Math.Ceiling(rawShare);
            else if (_bingoSettings.PayoutRoundingMode == 2)
                roundedShare = Math.Floor(rawShare);

            return roundedShare * game.WinnerCount;
        }

        // Mode 0: Fixed Prize (Adjusted by attendance for standard admission sheets or flagged target-profit games)
        if (!sheet.IsAdmissionOnly && !game.IsProgressive && game.IncludeInTargetProfit)
        {
            var gross = sold * sheet.Price;
            var lottery = gross * sheet.LotteryPercentage;
            var targetProfit = gross * (prevTargetProfitPercentage / 100m);
            
            decimal otherPayouts = 0;
            foreach (var otherGame in sheet.Games.Where(g => g != game))
            {
                if (otherGame.IsProgressive)
                {
                    otherPayouts += otherGame.ConsolationAmount;
                }
                else if (!otherGame.IncludeInTargetProfit)
                {
                    otherPayouts += CalculateGamePayoutForDraftSheet(sheet, otherGame, prevPacksSold, prevPayoutPercentage, prevUseManualScaling, prevTargetProfitPercentage);
                }
            }
            
            var maxAvailable = gross - lottery - targetProfit - otherPayouts;
            return Math.Min(game.DefaultPayout, Math.Max(game.MinimumPayout, maxAvailable));
        }

        decimal pct = 100m;
        if (sheet.IsAdmissionOnly)
        {
            if (prevUseManualScaling)
            {
                pct = prevPayoutPercentage;
            }
            else if (_bingoSettings.PayoutTiers != null && _bingoSettings.PayoutTiers.Any())
            {
                var tier = _bingoSettings.PayoutTiers
                    .Where(t => t.MinAdmissions <= prevPacksSold)
                    .OrderByDescending(t => t.MinAdmissions)
                    .FirstOrDefault();
                pct = tier?.PayoutPercentage ?? _bingoSettings.PayoutTiers.Min(t => t.PayoutPercentage);
            }
        }
        
        var rawShareFixed = (game.DefaultPayout * (pct / 100m)) / game.WinnerCount;
        var roundedShareFixed = rawShareFixed;
        if (_bingoSettings.PayoutRoundingMode == 1)
            roundedShareFixed = Math.Ceiling(rawShareFixed);
        else if (_bingoSettings.PayoutRoundingMode == 2)
            roundedShareFixed = Math.Floor(rawShareFixed);

        return roundedShareFixed * game.WinnerCount;
    }

    private decimal CalculateDraftFinalUnexpended(BingoDraft draft)
    {
        if (draft == null) return 0m;
        
        var prevPacksSold = draft.AdmissionPacks?.Where(p => !IsAdditionalCardsPack(p.Name)).Sum(p => p.Sold) ?? 0;
        var prevExtraCards = 0;
        if (draft.AdmissionPacks != null)
        {
            foreach (var p in draft.AdmissionPacks)
            {
                var admitCount = 9;
                try 
                {
                    var parts = p.Name.Split(' ');
                    if (int.TryParse(parts.Last(), out var val)) admitCount = val;
                } 
                catch {}
                prevExtraCards += p.Sold * (admitCount - 9) / 3;
            }
        }
        
        var prevStandardProgramRevenue = (prevPacksSold * _bingoSettings.BasePrice) + (prevExtraCards * _bingoSettings.CardPrice);
        
        var prevUnmappedFloorGross = draft.Sheets?
            .Where(s => (s.ManualSold > 0 || (s.IsIncludedInAdmission && !s.IsAdmissionOnly)) && s.ColorName != draft.WtaColor && s.ColorName != draft.ProgColor)
            .Sum(s => (s.ManualSold + (s.IsIncludedInAdmission && !s.IsAdmissionOnly ? prevPacksSold : 0)) * s.Price) ?? 0;
            
        var wtaObj = draft.Sheets?.FirstOrDefault(s => s.ColorName == draft.WtaColor);
        var progObj = draft.Sheets?.FirstOrDefault(s => s.ColorName == draft.ProgColor);
        
        var wtaGross = wtaObj != null ? ((wtaObj.ManualSold + (wtaObj.IsIncludedInAdmission && !wtaObj.IsAdmissionOnly ? prevPacksSold : 0)) * wtaObj.Price) : 0;
        var progGross = progObj != null ? ((progObj.ManualSold + (progObj.IsIncludedInAdmission && !progObj.IsAdmissionOnly ? prevPacksSold : 0)) * progObj.Price) : 0;
        
        var prevCombinedFloor = prevUnmappedFloorGross + wtaGross + progGross;
        var prevGrossBeanoReceipts = prevStandardProgramRevenue + prevCombinedFloor + draft.BeanoSuppliesSales + draft.BeanoOtherReceipts;
        
        var prevTaxPaid = prevGrossBeanoReceipts * 0.05m;
        
        decimal prevSheetPrizes = 0;
        if (draft.Sheets != null)
        {
            foreach (var s in draft.Sheets)
            {
                foreach (var g in s.Games)
                {
                    prevSheetPrizes += g.CustomPayoutOverride ?? CalculateGamePayoutForDraftSheet(s, g, prevPacksSold, draft.PayoutPercentage, draft.UseManualScaling, draft.TargetProfitPercentage);
                }
            }
        }
        var prevTotalPrizesPaid = prevSheetPrizes + (draft.DoorPrizeAmount * draft.DoorPrizeCount);
        var prevTotalExpenditures = prevTaxPaid + prevTotalPrizesPaid + draft.BeanoOtherExpenses.Sum(e => e.Amount);
        
        var prevNetProfit = prevGrossBeanoReceipts - prevTotalExpenditures;
        
        var prevPullTabSales = draft.PullTabEntries?.Sum(GetGrossReceipts) ?? 0;
        var prevPullTabPrizes = draft.PullTabEntries?.Sum(e => e.PrizesPaid) ?? 0;
        var prevPullTabNetProceeds = prevPullTabSales - prevPullTabPrizes;
        
        var prevTotalFundsAvailable = draft.BeanoUnexpendedNetProfit + prevNetProfit + prevPullTabNetProceeds + draft.BeanoInterest + draft.BeanoGameBank + draft.BeanoOthers;
        var prevTotalDisbursements = draft.BeanoDisbursements?.Sum(d => d.Amount) ?? 0;
        
        return prevTotalFundsAvailable - prevTotalDisbursements;
    }

    private decimal CalculateDraftProgressiveCarryover(BingoDraft draft)
    {
        if (draft == null) return 0m;
        var prevPacksSold = draft.AdmissionPacks?.Where(p => !IsAdditionalCardsPack(p.Name)).Sum(p => p.Sold) ?? 0;
        var progObj = draft.Sheets?.FirstOrDefault(s => s.ColorName == draft.ProgColor);
        var progGross = progObj != null ? ((progObj.ManualSold + (progObj.IsIncludedInAdmission && !progObj.IsAdmissionOnly ? prevPacksSold : 0)) * progObj.Price) : 0;
        var taxPaid = progGross * 0.05m;
        
        decimal progPrizes = 0;
        if (progObj != null)
        {
            foreach (var g in progObj.Games)
            {
                progPrizes += g.CustomPayoutOverride ?? CalculateGamePayoutForDraftSheet(progObj, g, prevPacksSold, draft.PayoutPercentage, draft.UseManualScaling, draft.TargetProfitPercentage);
            }
        }
        
        return draft.BeanoProgBeginningBalance + progGross - taxPaid - progPrizes;
    }

    private async Task SetPreviousUnexpendedNetProfitAsync()
    {
        try
        {
            DateTime? prevDate = null;
            decimal prevUnexpended = 0m;
            decimal prevProgCarryover = 0m;
            decimal? targetProfitPercentage = null;
            bool? useManualScaling = null;

            // 1. Check local drafts
            var records = await JSRuntime.InvokeAsync<List<VaultRecord>>("window.gfcGetAllAsync");
            if (records != null)
            {
                var options = new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true };
                foreach (var rec in records)
                {
                    if (rec.Key != null && rec.Key.StartsWith("gfc_bingo_draft_"))
                    {
                        var keySuffix = rec.Key.Replace("gfc_bingo_draft_", "");
                        if (DateTime.TryParseExact(keySuffix, "yyyyMMdd", null, System.Globalization.DateTimeStyles.None, out var parsedDate))
                        {
                            if (parsedDate.Date < SessionDate.Date)
                            {
                                if (prevDate == null || parsedDate.Date > prevDate.Value)
                                {
                                    var draft = System.Text.Json.JsonSerializer.Deserialize<BingoDraft>(rec.Data.GetRawText(), options);
                                    if (draft != null)
                                    {
                                        prevDate = parsedDate.Date;
                                        prevUnexpended = CalculateDraftFinalUnexpended(draft);
                                        prevProgCarryover = CalculateDraftProgressiveCarryover(draft);
                                        targetProfitPercentage = draft.TargetProfitPercentage;
                                        useManualScaling = draft.UseManualScaling;
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // 2. Check server session history
            try
            {
                var serverHistory = await ReportingService.GetBingoSessionHistoryAsync();
                if (serverHistory != null)
                {
                    var mostRecentServer = serverHistory
                        .Where(s => s.SessionDate.Date < SessionDate.Date)
                        .OrderByDescending(s => s.SessionDate.Date)
                        .FirstOrDefault();

                    if (mostRecentServer != null && (prevDate == null || mostRecentServer.SessionDate.Date > prevDate.Value))
                    {
                        prevDate = mostRecentServer.SessionDate.Date;
                        
                        // Compute values from server session
                        decimal prevNetProfit = mostRecentServer.TotalGrossReceipts - mostRecentServer.TotalPrizesPaid - mostRecentServer.TotalLotteryTake;
                        
                        decimal prevTotalDisbursements = 0m;
                        if (!string.IsNullOrEmpty(mostRecentServer.BeanoDisbursementsJson))
                        {
                            try
                            {
                                var disbs = System.Text.Json.JsonSerializer.Deserialize<List<BeanoDisbursement>>(mostRecentServer.BeanoDisbursementsJson);
                                prevTotalDisbursements = disbs?.Sum(d => d.Amount) ?? 0m;
                            }
                            catch {}
                        }
                        
                        decimal prevPullTabSales = mostRecentServer.PullTabEntries?.Sum(p => {
                            var def = _pullTabDefinitions.FirstOrDefault(d => d.Id == p.GameDefinitionId);
                            var price = def?.TicketPrice ?? 0m;
                            return (p.TicketsIssued - p.TicketsReturned) * price;
                        }) ?? 0m;
                        decimal prevPullTabPrizes = mostRecentServer.PullTabEntries?.Sum(p => p.PrizesPaid) ?? 0m;
                        decimal prevPullTabNetProceeds = prevPullTabSales - prevPullTabPrizes;

                        decimal prevTotalFundsAvailable = mostRecentServer.BeanoUnexpendedNetProfit 
                            + prevNetProfit 
                            + prevPullTabNetProceeds 
                            + mostRecentServer.BeanoInterest 
                            + mostRecentServer.BeanoGameBank 
                            + mostRecentServer.BeanoOthers;

                        prevUnexpended = prevTotalFundsAvailable - prevTotalDisbursements;

                        // Calculate server session progressive carryover
                        decimal sProgGross = 0m;
                        decimal sProgPrizes = 0m;
                        if (!string.IsNullOrEmpty(mostRecentServer.ProgColor))
                        {
                            var progColor = mostRecentServer.ProgColor;
                            var progSheetSales = mostRecentServer.GameEntries?.Where(ge => ge.SheetColor == progColor).Select(ge => ge.SheetsSold).FirstOrDefault() ?? 0;
                            var progPrice = mostRecentServer.GameEntries?.Where(ge => ge.SheetColor == progColor).Select(ge => ge.PricePerSheet).FirstOrDefault() ?? 0m;
                            sProgGross = progSheetSales * progPrice;
                            sProgPrizes = mostRecentServer.GameEntries?.Where(ge => ge.SheetColor == progColor).Sum(ge => ge.PrizePaid) ?? 0m;
                        }
                        decimal sTaxPaid = sProgGross * 0.05m;
                        prevProgCarryover = mostRecentServer.BeanoProgBeginningBalance + sProgGross - sTaxPaid - sProgPrizes;
                        
                        targetProfitPercentage = null;
                        useManualScaling = null;
                    }
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"[BINGO] Error fetching server session history for unexpended carryover: {ex.Message}");
            }

            // 3. Apply carryover values if a previous session was found
            if (prevDate != null)
            {
                _beanoUnexpendedNetProfit = prevUnexpended;
                if (_beanoProgBeginningBalance == 0m)
                {
                    _beanoProgBeginningBalance = prevProgCarryover;
                }
                if (targetProfitPercentage != null)
                {
                    _targetProfitPercentage = targetProfitPercentage.Value;
                }
                if (useManualScaling != null)
                {
                    _useManualScaling = useManualScaling.Value;
                }
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[BINGO] Error calculating previous unexpended net profit: {ex.Message}");
        }
    }

    private async Task LoadSessionHistoryAsync()
    {
        try
        {
            // Auto-save current session to database so it is immediately visible in the directory
            if (_sessionState != "NotStarted")
            {
                await SaveDraftAsync();
            }

            var records = await JSRuntime.InvokeAsync<List<VaultRecord>>("window.gfcGetAllAsync");
            _historyItems.Clear();
            if (records != null)
            {
                foreach (var rec in records)
                {
                    if (rec.Key != null && rec.Key.StartsWith("gfc_bingo_draft_"))
                    {
                        var options = new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true };
                        var draft = System.Text.Json.JsonSerializer.Deserialize<BingoDraft>(rec.Data.GetRawText(), options);
                        if (draft != null)
                        {
                            if (string.IsNullOrEmpty(draft.SessionState) || draft.SessionState == "NotStarted")
                            {
                                continue;
                            }
                            var item = new SessionHistoryItem();
                            
                            DateTime date = draft.Date;
                            var keySuffix = rec.Key.Replace("gfc_bingo_draft_", "");
                            if (DateTime.TryParseExact(keySuffix, "yyyyMMdd", null, System.Globalization.DateTimeStyles.None, out var parsedDate))
                            {
                                date = parsedDate;
                            }
                            
                            item.Date = date;
                            item.SessionState = draft.SessionState ?? "NotStarted";
                            
                            var totalPacksSold = draft.AdmissionPacks?.Where(p => !IsAdditionalCardsPack(p.Name)).Sum(p => p.Sold) ?? 0;
                            
                            var totalExtraCards = 0;
                            if (draft.AdmissionPacks != null)
                            {
                                foreach (var p in draft.AdmissionPacks)
                                {
                                    var admitCount = 9;
                                    try 
                                    {
                                        var parts = p.Name.Split(' ');
                                        if (int.TryParse(parts.Last(), out var val)) admitCount = val;
                                    } 
                                    catch {}
                                    totalExtraCards += p.Sold * (admitCount - 9) / 3;
                                }
                            }
                            
                            item.AdmissionCount = totalPacksSold;
                            
                            var admissionRevenue = draft.AdmissionPacks?.Sum(p => p.Sold * p.Price) ?? 0;
                            var floorRevenue = draft.Sheets?.Sum(s => s.ManualSold * s.Price) ?? 0;
                            item.TotalGross = admissionRevenue + floorRevenue;
                            
                            decimal totalPrizes = 0;
                            decimal totalLotteryTake = 0;
                            
                            if (draft.Sheets != null)
                            {
                                foreach (var s in draft.Sheets)
                                {
                                    foreach (var g in s.Games)
                                    {
                                        totalPrizes += g.CustomPayoutOverride ?? g.Payout;
                                    }
                                    
                                    decimal allocatedAdmissionGross = 0;
                                    if (s.IsIncludedInAdmission && totalPacksSold > 0)
                                    {
                                        if (!s.IsAdmissionOnly && s.Price > 0)
                                        {
                                            allocatedAdmissionGross = totalPacksSold * s.Price;
                                        }
                                        else if (s.IsAdmissionOnly)
                                        {
                                            var standardSheets = draft.Sheets.Where(x => x.IsAdmissionOnly).ToList();
                                            if (standardSheets.Count > 0)
                                            {
                                                var totalSpecialsAdmissionGross = draft.Sheets.Where(x => !x.IsAdmissionOnly && x.IsIncludedInAdmission).Sum(x => totalPacksSold * x.Price);
                                                var totalPoolForStandards = admissionRevenue - totalSpecialsAdmissionGross;
                                                allocatedAdmissionGross = totalPoolForStandards / standardSheets.Count;
                                            }
                                        }
                                    }
                                    var sheetGross = allocatedAdmissionGross + (s.ManualSold * s.Price);
                                    totalLotteryTake += sheetGross * s.LotteryPercentage;
                                }
                            }
                            
                            item.TotalPrizes = totalPrizes;
                            item.TotalNet = item.TotalGross - item.TotalPrizes - totalLotteryTake;
                            
                            var progGame = draft.Sheets?.SelectMany(s => s.Games).FirstOrDefault(g => g.IsProgressive);
                            item.ProgressiveGoal = progGame?.CurrentBallGoal;
                            
                            _historyItems.Add(item);
                        }
                    }
                }
            }

            // Try fetching server-side session history to populate database-saved sessions not in IndexedDB
            try
            {
                var serverHistory = await ReportingService.GetBingoSessionHistoryAsync();
                if (serverHistory != null)
                {
                    foreach (var s in serverHistory)
                    {
                        // Check if we already have this date in history from IndexedDB drafts
                        if (!_historyItems.Any(i => i.Date.Date == s.SessionDate.Date))
                        {
                            var progEntry = s.GameEntries?.FirstOrDefault(e => e.ProgressiveBallGoal.HasValue && e.ProgressiveBallGoal.Value > 0);
                            _historyItems.Add(new SessionHistoryItem
                            {
                                Date = s.SessionDate,
                                SessionState = (s.Status == "Submitted" || s.Status == "Closed") ? "Closed" : "Open",
                                AdmissionCount = s.AdmissionCount,
                                TotalGross = s.TotalGrossReceipts,
                                TotalPrizes = s.TotalPrizesPaid,
                                TotalNet = s.TotalGrossReceipts - s.TotalPrizesPaid - s.TotalLotteryTake,
                                ProgressiveGoal = progEntry?.ProgressiveBallGoal
                            });
                        }
                    }
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error fetching server history in directory: {ex.Message}");
            }

            // Ensure the active in-memory session (whether saved, new, or modified) is always present and up-to-the-second accurate
            _historyItems.RemoveAll(i => i.Date.Date == SessionDate.Date);
            var activeProgGame = Sheets?.SelectMany(s => s.Games).FirstOrDefault(g => g.IsProgressive);
            _historyItems.Add(new SessionHistoryItem
            {
                Date = SessionDate,
                SessionState = _sessionState,
                AdmissionCount = AdmissionCount,
                TotalGross = TotalGross,
                TotalPrizes = TotalPrizes,
                TotalNet = TotalNetProceeds,
                ProgressiveGoal = activeProgGame?.CurrentBallGoal
            });

            _historyItems = _historyItems.OrderByDescending(i => i.Date).ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading session history: {ex.Message}");
        }
    }

    private void ConfirmDeleteDirectorySession(DateTime date)
    {
        _directoryDeleteTargetDate = date;
        _showDirectoryDeleteConfirm = true;
        StateHasChanged();
    }

    private async Task DeleteDirectorySessionAsync()
    {
        _showDirectoryDeleteConfirm = false;
        if (!_directoryDeleteTargetDate.HasValue) return;

        var targetDate = _directoryDeleteTargetDate.Value;

        // If the deleted session is the currently active/selected one
        if (targetDate.Date == SessionDate.Date)
        {
            await CancelActiveSessionAsync();
        }
        else
        {
            // 1. Delete local draft
            var key = $"gfc_bingo_draft_{targetDate:yyyyMMdd}";
            await JSRuntime.InvokeVoidAsync("window.gfcRemoveAsync", key);

            // 2. Call backend delete session endpoint if online
            try
            {
                var success = await ReportingService.CancelBingoSessionAsync(targetDate);
                if (success)
                {
                    await ShowToast("Session Deleted", $"The session for {targetDate:MM/dd/yyyy} was successfully removed from the server.");
                }
                else
                {
                    await ShowToast("Deleted Locally", $"Draft for {targetDate:MM/dd/yyyy} cleared locally, but server cancellation was offline.", "warning");
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"[BINGO] Error calling cancel endpoint: {ex.Message}");
                await ShowToast("Deleted Locally", $"Draft for {targetDate:MM/dd/yyyy} cleared locally, but server cancellation failed.", "warning");
            }
        }

        // Refresh directory history
        await LoadSessionHistoryAsync();
        _directoryDeleteTargetDate = null;
        StateHasChanged();
    }

    private async Task SelectHistorySession(DateTime date)
    {
        SessionDate = date;
        _sessionEntered = false;
        await LoadDraftAsync();
        if (_sessionState != "NotStarted")
        {
            _sessionEntered = true;
        }
        _showDirectoryModal = false;
        StateHasChanged();
    }

    public class VaultRecord
    {
        [System.Text.Json.Serialization.JsonPropertyName("key")]
        public string Key { get; set; } = "";

        [System.Text.Json.Serialization.JsonPropertyName("data")]
        public System.Text.Json.JsonElement Data { get; set; }

        [System.Text.Json.Serialization.JsonPropertyName("timestamp")]
        public long Timestamp { get; set; }
    }

    public class SessionHistoryItem
    {
        public DateTime Date { get; set; }
        public string SessionState { get; set; } = "NotStarted";
        public int AdmissionCount { get; set; }
        public decimal TotalGross { get; set; }
        public decimal TotalPrizes { get; set; }
        public decimal TotalNet { get; set; }
        public int? ProgressiveGoal { get; set; }
    }

    private async Task OnInputFocus(FocusEventArgs e)
    {
        // On tablet, select all text when an input is focused to make it easier to overwrite
        await JSRuntime.InvokeVoidAsync("eval", "document.activeElement?.select()");
    }

    public class BeanoExpense
    {
        public string Payee { get; set; } = "";
        public string Description { get; set; } = "";
        public string CheckNumber { get; set; } = "";
        public decimal Amount { get; set; }
    }

    public class BeanoDisbursement
    {
        public DateTime Date { get; set; } = DateTime.Today;
        public string CheckNumber { get; set; } = "";
        public string Payee { get; set; } = "";
        public string Description { get; set; } = "";
        public decimal Amount { get; set; }
    }
