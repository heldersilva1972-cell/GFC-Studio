    private async Task ActivateField(string field)
    {
        _activeField = field;
        _currentBuffer = "";
        _showFloatingKeypad = true;

        // Auto-scroll modal row into view
        if (_showFloorSalesPopup && field.EndsWith("_Sold"))
        {
            var color = field.Split('_')[0];
            await JSRuntime.InvokeVoidAsync("eval", $"document.getElementById('floor-row-{color}')?.scrollIntoView({{ behavior: 'smooth', block: 'center' }})");
        }
        else if (_showAdmissionPopup && field.StartsWith("Pack_"))
        {
            var id = field.Replace("Pack_", "");
            await JSRuntime.InvokeVoidAsync("eval", $"document.getElementById('admin-row-{id}')?.scrollIntoView({{ behavior: 'smooth', block: 'center' }})");
        }
