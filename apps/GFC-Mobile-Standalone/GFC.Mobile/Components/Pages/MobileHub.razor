@page "/mobile"
@page "/"
@using Microsoft.AspNetCore.Authorization

@using GFC.Core.Interfaces
@implements IDisposable
@inject NavigationManager Navigation
@inject ICustomAuthenticationStateProvider AuthStateProvider
@inject IUserManagementService UserService
@inject IShiftComplianceService ShiftComplianceService
@inject IJSRuntime JSRuntime
@inject ILiquorService LiquorService
@inject HttpClient Http
@inject IVersionService VersionService
@inject IMobileReportingService ReportingService
@inject IConnectivityService Connectivity
@using GFC.Mobile.Components.Shared
@using System.Text.Json
@attribute [Authorize]

<PageTitle>GFC Portal | GFC</PageTitle>

<MobileHubHeader IsConnected="@_isCircutAlive" Username="@Username" />


<div class="mobile-hub-container">
    <!-- SCROLLABLE CONTENT -->
    <main class="hub-scroll-area">
        <div class="container py-4" style="margin-top: 56px;">
            <div class="welcome-section mb-4 animate-entrance">
                <h4 class="fw-bold mb-1">GFC Portal</h4>
                <div class="d-flex align-items-center gap-2">
                    <p class="text-muted small mb-0">Access your shift tools and analytics.</p>
                    <button class="btn btn-link btn-sm p-0 text-primary text-decoration-none" @onclick="ManualSyncPermissionsAsync" disabled="@_isSyncingPermissions">
                        <i class="bi bi-arrow-repeat @(_isSyncingPermissions ? "spin" : "")"></i> Sync
                    </button>
                    @if (_canInstall || !string.IsNullOrEmpty(_installInstructions))
                    {
                        <button class="btn btn-link btn-sm p-0 text-success text-decoration-none ms-2" @onclick="InstallAppAsync">
                            <i class="bi bi-download"></i> Download App
                        </button>
                    }
                    @if (!string.IsNullOrEmpty(_syncFeedback))
                    {
                        <span class="extra-small @(_syncFeedback.Contains("Failed") ? "text-danger" : "text-success") animate-fade-in">
                            @_syncFeedback
                        </span>
                    }
                </div>
            </div>


            @if (IsLoading)
            {
                <div class="d-flex justify-content-center py-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                </div>
            }
            else
            {
                <div class="portal-grid">




                    @if (HasAccessTo("End of shift sales"))
                    {
                        <div class="app-card animate-entrance stagger-1" @onclick='() => NavigateTo("/mobile/shift-report")'>
                            <div class="card-icon-box" style="background: rgba(12, 166, 120, 0.1); color: #0ca678;">
                                <i class="bi bi-calendar-check-fill"></i>
                            </div>
                            <div style="flex-grow: 1;">
                                <h6 class="fw-bold mb-0">End of shift sales</h6>
                                <p class="small text-muted mb-0">Record bar & lottery sales</p>
                            </div>
                            <i class="bi bi-chevron-right text-muted opacity-50"></i>
                        </div>
                    }

                    @if (HasAccessTo("Janitor hours entry"))
                    {
                        <div class="app-card animate-entrance stagger-1" @onclick='() => NavigateTo("/mobile/janitor-hours")'>
                            <div class="card-icon-box" style="background: rgba(139, 92, 246, 0.1); color: #8b5cf6;">
                                <i class="bi bi-brush"></i>
                            </div>
                            <div style="flex-grow: 1;">
                                <h6 class="fw-bold mb-0">Janitor hours entry</h6>
                                <p class="small text-muted mb-0">Record daily cleaning hours</p>
                            </div>
                            <i class="bi bi-chevron-right text-muted opacity-50"></i>
                        </div>
                    }

                    @if (HasAccessTo("Bar manager hours entry"))
                    {
                        <div class="app-card animate-entrance stagger-1" @onclick='() => NavigateTo("/mobile/bar-manager-hours")'>
                            <div class="card-icon-box" style="background: rgba(8, 145, 178, 0.1); color: #0891b2;">
                                <i class="bi bi-person-badge"></i>
                            </div>
                            <div style="flex-grow: 1;">
                                <h6 class="fw-bold mb-0">Bar manager hours entry</h6>
                                <p class="small text-muted mb-0">Record daily management hours</p>
                            </div>
                            <i class="bi bi-chevron-right text-muted opacity-50"></i>
                        </div>
                    }


                    @if (HasAccessTo("Inventory Check (Mobile)"))
                    {
                        <div class="app-card animate-entrance stagger-2" @onclick='() => NavigateTo("/mobile/liquor/hub/count")'>
                            <div class="card-icon-box" style="background: rgba(16, 185, 129, 0.1); color: #10b981;">
                                <i class="bi bi-calendar-check"></i>
                            </div>
                            <div style="flex-grow: 1;">
                                <h6 class="fw-bold mb-0">Inventory Check</h6>
                                <p class="small text-muted mb-0">Reconcile product stock counts</p>
                            </div>
                            <i class="bi bi-chevron-right text-muted opacity-50"></i>
                        </div>
                    }

                    @if (HasAccessTo("Ordering List (Mobile)"))
                    {
                        <div class="app-card animate-entrance stagger-2" @onclick='() => NavigateTo("/mobile/liquor/hub/ordering")'>
                            <div class="card-icon-box" style="background: rgba(79, 70, 229, 0.1); color: #4f46e5;">
                                <i class="bi bi-cart3"></i>
                            </div>
                            <div style="flex-grow: 1;">
                                <div class="d-flex align-items-center gap-2">
                                    <h6 class="fw-bold mb-0">Ordering List</h6>
                                    @if (_lowStockCount > 0)
                                    {
                                        <span class="badge bg-danger rounded-pill px-2" style="font-size: 0.65rem;">@_lowStockCount Low</span>
                                    }
                                </div>
                                <p class="small text-muted mb-0">Place and manage product orders</p>
                            </div>
                            <i class="bi bi-chevron-right text-muted opacity-50"></i>
                        </div>
                    }


                    @if (HasAccessTo("Income Charts & Analytics"))
                    {
                        <div class="app-card animate-entrance stagger-2" @onclick='() => NavigateTo("/mobile/analytics")'>
                            <div class="card-icon-box" style="background: rgba(34, 139, 230, 0.1); color: #228be6;">
                                <i class="bi bi-graph-up-arrow"></i>
                            </div>
                            <div style="flex-grow: 1;">
                                <h6 class="fw-bold mb-0">Income charts</h6>
                                <p class="small text-muted mb-0">View monthly performance</p>
                            </div>
                            <i class="bi bi-chevron-right text-muted opacity-50"></i>
                        </div>
                    }



                    @if (HasAccessTo("Door Key Cards (Mobile)"))
                    {
                        <div class="app-card animate-entrance stagger-2" @onclick='() => NavigateTo("/mobile/keycards")'>
                            <div class="card-icon-box" style="background: rgba(236, 72, 153, 0.1); color: #ec4899;">
                                <i class="bi bi-credit-card"></i>
                            </div>
                            <div style="flex-grow: 1;">
                                <h6 class="fw-bold mb-0">Key Cards</h6>
                                <p class="small text-muted mb-0">Manage member access cards</p>
                            </div>
                            <i class="bi bi-chevron-right text-muted opacity-50"></i>
                        </div>
                    }

                    @if (HasAccessTo("Dues & Payments (Mobile)"))
                    {
                        <div class="app-card animate-entrance stagger-2" @onclick='() => NavigateTo("/mobile/dues")'>
                            <div class="card-icon-box" style="background: rgba(16, 185, 129, 0.1); color: #10b981;">
                                <i class="bi bi-cash-coin"></i>
                            </div>
                            <div style="flex-grow: 1;">
                                <h6 class="fw-bold mb-0">Dues & Payments</h6>
                                <p class="small text-muted mb-0">Track membership payments</p>
                            </div>
                            <i class="bi bi-chevron-right text-muted opacity-50"></i>
                        </div>
                    }



                    @if (HasAccessTo("Mobile User Management"))
                    {
                        <div class="app-card animate-entrance stagger-3" @onclick='() => NavigateTo("/mobile/users")'>
                            <div class="card-icon-box" style="background: rgba(245, 158, 11, 0.1); color: #f59e0b;">
                                <i class="bi bi-people-fill"></i>
                            </div>
                            <div style="flex-grow: 1;">
                                <h6 class="fw-bold mb-0">Mobile User Management</h6>
                                <p class="small text-muted mb-0">Manage roles & device onboarding</p>
                            </div>
                            <i class="bi bi-chevron-right text-muted opacity-50"></i>
                        </div>
                    }

                    @if (HasAccessTo("System Vitals (Mobile)"))
                    {
                        <div class="app-card animate-entrance stagger-3" @onclick='() => NavigateTo("/mobile/system/stats")'>
                            <div class="card-icon-box" style="background: rgba(148, 163, 184, 0.1); color: #475569;">
                                <i class="bi bi-activity"></i>
                            </div>
                            <div style="flex-grow: 1;">
                                <h6 class="fw-bold mb-0">System Vitals</h6>
                                <p class="small text-muted mb-0">Disk, Database & CPU Health</p>
                            </div>
                            <i class="bi bi-chevron-right text-muted opacity-50"></i>
                        </div>
                    }

                    @if (HasAccessTo("Bingo Tracking (Mobile)"))
                    {
                        <div class="app-card animate-entrance stagger-3" @onclick='() => NavigateTo("/mobile/bingo")'>
                            <div class="card-icon-box" style="background: rgba(76, 110, 245, 0.1); color: #4c6ef5;">
                                <i class="bi bi-grid-3x3-gap-fill"></i>
                            </div>
                            <div style="flex-grow: 1;">
                                <h6 class="fw-bold mb-0">Bingo Tracking</h6>
                                <p class="small text-muted mb-0">Track sheets, payouts & lottery</p>
                            </div>
                            <i class="bi bi-chevron-right text-muted opacity-50"></i>
                        </div>
                    }

                    @if (!HasAnyMobileTools && !IsLoading)
                    {
                        <div class="empty-state text-center py-5 w-100">
                            <i class="bi bi-shield-lock display-1 text-muted opacity-25"></i>
                            <p class="mt-3 fw-bold text-muted">No permissions found.</p>
                            <p class="small text-muted px-4">You are logged in as <strong>@Username</strong> but do not have access to any mobile tools yet.</p>
                        </div>
                    }

                    <div class="text-center pt-5 pb-2 w-100">
                        <p class="text-muted mb-0" @onclick="OnVersionClicked" style="font-size: 0.65rem; opacity: 0.5; cursor: pointer;">
                            &copy; 2026 GFC Studio Standalone Hub<br/>
                            Revision @VersionService.GetRevision()
                        </p>
                    </div>

                </div>
            }
        </div>
    </main>

    <!-- BOTTOM BAR -->
    <!-- BOTTOM BAR -->
    <div class="fixed-bottom-nav">
        <MobileBottomNav ActiveTab="Home" />
    </div>
</div>


