@page "/mobile"
@page "/"
@using Microsoft.AspNetCore.Authorization

@using GFC.Core.Interfaces
@inject NavigationManager Navigation
@inject ICustomAuthenticationStateProvider AuthStateProvider
@inject IUserManagementService UserService
@inject IShiftComplianceService ShiftComplianceService
@inject IJSRuntime JSRuntime
@inject HttpClient Http
@using GFC.Mobile.Components.Shared
@attribute [Authorize]

<PageTitle>GFC Portal | GFC</PageTitle>

<MobileHubHeader IsConnected="@_isCircutAlive" StatusText="@_syncStatus" LastSynced="@_lastSyncedAt" />

<div class="mobile-hub-container">
    <!-- SCROLLABLE CONTENT -->
    <main class="hub-scroll-area">
        <div class="container py-4" style="margin-top: 50px;">
            <div class="welcome-section mb-4 animate-entrance">
                <h4 class="fw-bold mb-1">GFC Portal</h4>
                <div class="d-flex align-items-center gap-2">
                    <p class="text-muted small mb-0">Access your shift tools and analytics.</p>
                </div>
            </div>

            @if (!IsLoading && _validMissingShifts.Any() && HasAccessTo("Shift Sales Alert"))
            {
                <div class="alert alert-warning border-0 shadow-sm rounded-4 mb-4 animate-entrance" style="background: rgba(245, 158, 11, 0.1); border-left: 4px solid #f59e0b !important;">
                    <div class="d-flex align-items-center gap-3">
                        <div class="rounded-circle bg-warning d-flex align-items-center justify-content-center" style="min-width: 40px; height: 40px;">
                            <i class="bi bi-clock-history text-white fs-5"></i>
                        </div>
                        <div style="flex-grow: 1;">
                            <div class="fw-bold text-primary small text-uppercase" style="letter-spacing: 0.5px;">Shift Sales Alert</div>
                            <div class="text-muted" style="font-size: 0.75rem;">@_validMissingShifts.Count report(s) are missing from the last 48 hours.</div>
                        </div>
                        <button class="btn btn-warning btn-sm rounded-pill fw-bold px-3" @onclick="OpenMissingShiftsModal">View</button>
                    </div>
                </div>
            }

            @if (IsLoading)
            {
                <div class="d-flex justify-content-center py-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                </div>
            }
            else
            {
                <div class="portal-grid">




                    @if (HasAccessTo("End of shift sales"))
                    {
                        <div class="app-card animate-entrance stagger-1" @onclick='() => NavigateTo("/mobile/shift-report")'>
                            <div class="card-icon-box" style="background: rgba(12, 166, 120, 0.1); color: #0ca678;">
                                <i class="bi bi-calendar-check-fill"></i>
                            </div>
                            <div style="flex-grow: 1;">
                                <h6 class="fw-bold mb-0">End of shift sales</h6>
                                <p class="small text-muted mb-0">Record bar & lottery sales</p>
                            </div>
                            <i class="bi bi-chevron-right text-muted opacity-50"></i>
                        </div>
                    }

                    @if (HasAccessTo("Janitor hours entry"))
                    {
                        <div class="app-card animate-entrance stagger-1" @onclick='() => NavigateTo("/mobile/janitor-hours")'>
                            <div class="card-icon-box" style="background: rgba(139, 92, 246, 0.1); color: #8b5cf6;">
                                <i class="bi bi-brush"></i>
                            </div>
                            <div style="flex-grow: 1;">
                                <h6 class="fw-bold mb-0">Janitor hours entry</h6>
                                <p class="small text-muted mb-0">Record daily cleaning hours</p>
                            </div>
                            <i class="bi bi-chevron-right text-muted opacity-50"></i>
                        </div>
                    }


                    @if (HasAccessTo("liquor hub mobile"))
                    {
                        <div class="app-card animate-entrance stagger-2" @onclick='() => NavigateTo("/mobile/liquor/hub")'>
                            <div class="card-icon-box" style="background: rgba(16, 185, 129, 0.1); color: #10b981;">
                                <i class="bi bi-truck-flatbed"></i>
                            </div>
                            <div style="flex-grow: 1;">
                                <h6 class="fw-bold mb-0">Liquor HUB (Mobile)</h6>
                                <p class="small text-muted mb-0">Ordering, Receiving & Counting</p>
                            </div>
                            <i class="bi bi-chevron-right text-muted opacity-50"></i>
                        </div>
                    }


                    @if (HasAccessTo("income charts"))
                    {
                        <div class="app-card animate-entrance stagger-2" @onclick='() => NavigateTo("/mobile/analytics")'>
                            <div class="card-icon-box" style="background: rgba(34, 139, 230, 0.1); color: #228be6;">
                                <i class="bi bi-graph-up-arrow"></i>
                            </div>
                            <div style="flex-grow: 1;">
                                <h6 class="fw-bold mb-0">Income charts</h6>
                                <p class="small text-muted mb-0">View monthly performance</p>
                            </div>
                            <i class="bi bi-chevron-right text-muted opacity-50"></i>
                        </div>
                    }



                    @if (HasAccessTo("Mobile Key Cards"))
                    {
                        <div class="app-card animate-entrance stagger-2" @onclick='() => NavigateTo("/mobile/keycards")'>
                            <div class="card-icon-box" style="background: rgba(236, 72, 153, 0.1); color: #ec4899;">
                                <i class="bi bi-credit-card"></i>
                            </div>
                            <div style="flex-grow: 1;">
                                <h6 class="fw-bold mb-0">Key Cards</h6>
                                <p class="small text-muted mb-0">Manage member access cards</p>
                            </div>
                            <i class="bi bi-chevron-right text-muted opacity-50"></i>
                        </div>
                    }

                    @if (HasAccessTo("Mobile Dues & Payments"))
                    {
                        <div class="app-card animate-entrance stagger-2" @onclick='() => NavigateTo("/mobile/dues")'>
                            <div class="card-icon-box" style="background: rgba(16, 185, 129, 0.1); color: #10b981;">
                                <i class="bi bi-cash-coin"></i>
                            </div>
                            <div style="flex-grow: 1;">
                                <h6 class="fw-bold mb-0">Dues & Payments</h6>
                                <p class="small text-muted mb-0">Track membership payments</p>
                            </div>
                            <i class="bi bi-chevron-right text-muted opacity-50"></i>
                        </div>
                    }



                    @if (HasAccessTo("Mobile User Management"))
                    {
                        <div class="app-card animate-entrance stagger-3" @onclick='() => NavigateTo("/mobile/users")'>
                            <div class="card-icon-box" style="background: rgba(245, 158, 11, 0.1); color: #f59e0b;">
                                <i class="bi bi-people-fill"></i>
                            </div>
                            <div style="flex-grow: 1;">
                                <h6 class="fw-bold mb-0">Mobile User Management</h6>
                                <p class="small text-muted mb-0">Manage roles & device onboarding</p>
                            </div>
                            <i class="bi bi-chevron-right text-muted opacity-50"></i>
                        </div>
                    }

                    @if (HasAccessTo("System Vitals"))
                    {
                        <div class="app-card animate-entrance stagger-3" @onclick='() => NavigateTo("/mobile/system/stats")'>
                            <div class="card-icon-box" style="background: rgba(148, 163, 184, 0.1); color: #475569;">
                                <i class="bi bi-activity"></i>
                            </div>
                            <div style="flex-grow: 1;">
                                <h6 class="fw-bold mb-0">System Vitals</h6>
                                <p class="small text-muted mb-0">Disk, Database & CPU Health</p>
                            </div>
                            <i class="bi bi-chevron-right text-muted opacity-50"></i>
                        </div>
                    }

                    @if (!HasAnyMobileTools && !IsLoading)
                    {
                        <div class="empty-state text-center py-5 w-100">
                            <i class="bi bi-shield-lock display-1 text-muted opacity-25"></i>
                            <p class="mt-3 fw-bold text-muted">No permissions found.</p>
                            <p class="small text-muted px-4">You are logged in as <strong>@Username</strong> but do not have access to any mobile tools yet.</p>
                        </div>
                    }

                </div>
            }
        </div>
    </main>

    <!-- BOTTOM BAR -->
    <!-- BOTTOM BAR -->
    <div class="fixed-bottom-nav">
        <MobileBottomNav ActiveTab="Home" />
    </div>
</div>

<!-- MISSING SHIFTS MODAL -->
@if (_showMissingShiftsModal)
{
    <div class="modal-backdrop-custom" @onclick="CloseMissingShiftsModal"></div>
    <div class="bottom-sheet">
        <div class="sheet-handle"></div>
        <div class="p-4">
            <h5 class="fw-bold mb-3">Missing Shift Reports</h5>
            <p class="text-muted small mb-3">The following shifts have not been submitted.</p>
            
            <div class="list-group list-group-flush mb-3">
                @foreach (var shift in _validMissingShifts)
                {
                    <div class="list-group-item px-0 py-3 d-flex align-items-center justify-content-between">
                        <div class="d-flex align-items-center gap-3">
                            <div class="result-icon-box @(shift.ShiftType == "Day" ? "bg-warning bg-opacity-10 text-warning" : "bg-primary bg-opacity-10 text-primary")">
                                <i class="bi @(shift.ShiftType == "Day" ? "bi-sun-fill" : "bi-moon-stars-fill")"></i>
                            </div>
                            <div>
                                <div class="fw-bold">@shift.Date.ToString("ddd, MMM dd") - @shift.ShiftType</div>
                                <div class="text-muted small">
                                    <i class="bi bi-person-circle me-1"></i>
                                    @(string.IsNullOrEmpty(shift.AssignedBartender) ? "Unassigned" : shift.AssignedBartender)
                                </div>
                            </div>
                        </div>
                        <button class="btn btn-light btn-sm rounded-circle shadow-sm text-muted" 
                                style="width: 32px; height: 32px; display: flex; align-items: center; justify-content: center;"
                                @onclick="() => DismissSingleShift(shift)">
                            <i class="bi bi-x-lg"></i>
                        </button>
                    </div>
                }
            </div>

            <div class="d-grid">
                <button class="btn btn-light py-3" @onclick="CloseMissingShiftsModal">Close</button>
            </div>
        </div>
    </div>
}

<style>
    .portal-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 12px;
    }

    @@media (min-width: 768px) {
        .portal-grid {
            grid-template-columns: 1fr;
        }
    }

    .mobile-hub-container {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        display: flex;
        flex-direction: column;
        background-color: var(--app-bg, #f8f9fa);
        overflow: hidden;
    }

    .header-nav-stack {
        flex-shrink: 0;
        z-index: 1000;
        background: white;
        border-bottom: 1px solid rgba(0, 0, 0, 0.1);
    }

    .hub-scroll-area {
        flex: 1;
        overflow-y: auto;
        -webkit-overflow-scrolling: touch;
        padding-bottom: 90px;
    }

    /* Diagnostics Badge Tooltip */
    .diag-details {
        font-size: 0.6rem;
        background: #333;
        color: #eee;
        padding: 4px;
        border-radius: 4px;
        margin-top: 4px;
    }

    .btn-danger-soft {
        background-color: #fce8e8;
        color: #dc3545;
        border: none;
    }
    .btn-danger-soft:active {
        background-color: #dc3545;
        color: white;
    }

    .btn-signout-pill {
        display: inline-flex;
        align-items: center;
        background: #fef2f2;
        color: #dc2626;
        border: 1.5px solid #fecaca;
        border-radius: 50px;
        padding: 7px 16px;
        font-weight: 700;
        font-size: 0.8rem;
        letter-spacing: 0.03em;
        white-space: nowrap;
        flex-shrink: 0;
        transition: all 0.2s ease;
    }
    .btn-signout-pill:hover, .btn-signout-pill:active {
        background: #dc2626;
        color: white;
        border-color: #dc2626;
    }

    .fixed-bottom-nav {
        flex-shrink: 0;
        background: white;
        z-index: 1000;
    }

    .modal-backdrop-custom {
        position: fixed;
        top: 0; left: 0; right: 0; bottom: 0;
        background: rgba(0,0,0,0.5);
        z-index: 1040;
    }
    .bottom-sheet {
        position: fixed;
        left: 0; right: 0; bottom: 0;
        background: white;
        border-radius: 24px 24px 0 0;
        z-index: 1050;
        padding-bottom: env(safe-area-inset-bottom);
        box-shadow: 0 -10px 40px rgba(0,0,0,0.1);
        animation: slideUp 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .sheet-handle {
        width: 40px;
        height: 4px;
        background: #ddd;
        border-radius: 2px;
        margin: 12px auto;
    }
    
    .result-icon-box {
        width: 40px; 
        height: 40px; 
        border-radius: 10px; 
        display: flex; 
        align-items: center; 
        justify-content: center;
        font-size: 1.1rem;
    }

    @@keyframes slideUp {
        from { transform: translateY(100%); }
        to { transform: translateY(0); }
    }
</style>

@code {
    private string Username { get; set; } = "...";
    private bool IsLoading { get; set; } = true;
    private HashSet<string> UserRoutes { get; set; } = new();
    private List<MissingShiftAlert> _missingShifts = new();
    private HashSet<string> _dismissedShiftIds = new();
    private bool _showMissingShiftsModal = false;
    private bool _isCircutAlive = true;
    private string? _syncStatus = null;
    private DateTime? _lastSyncedAt;
    
    private List<MissingShiftAlert> _validMissingShifts => 
        _missingShifts.Where(s => !_dismissedShiftIds.Contains(GetShiftId(s))).ToList();
    
    private bool IsAdmin { get; set; }
    private string _debugInfo = "";
    private List<GFC.Core.DTOs.MobilePermissionDto> _userPermissions = new();
    private bool HasAnyMobileTools => IsAdmin || _userPermissions.Count > 0;

    private bool IsRefreshing { get; set; }

    protected override async Task OnInitializedAsync()
    {
        // 1. Instant check for current state
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        var currentAppUser = AuthStateProvider.GetCurrentUser();

        // [FIX] Ensure Username is set even if the AppUser object is still loading
        Username = user.Identity?.Name ?? currentAppUser?.Username ?? "...";

        if (user.Identity?.IsAuthenticated == true)
        {
            IsAdmin = currentAppUser?.IsAdmin ?? false;
            
            if (currentAppUser != null) 
            {
                // Step 1: Read permissions from localStorage IMMEDIATELY (no network, no re-render triggers).
                // This gets the hub visible and usable right away.
                var localAuth = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "gfc_auth_state");

                if (string.IsNullOrEmpty(localAuth)) 
                    _debugInfo = "EMPTY";
                else if (!localAuth.Contains("Permissions"))
                    _debugInfo = "NO_PERMS_KEY";
                else if (localAuth.Length < 100)
                    _debugInfo = "SHORT_" + localAuth.Length;
                else
                    _debugInfo = "OK_" + localAuth.Length;

                if (!string.IsNullOrEmpty(localAuth) && localAuth.Contains("Permissions"))
                {
                    try
                    {
                        using var doc = System.Text.Json.JsonDocument.Parse(localAuth);
                        if (doc.RootElement.TryGetProperty("Permissions", out var permsEl))
                        {
                            var perms = System.Text.Json.JsonSerializer.Deserialize<List<GFC.Core.DTOs.MobilePermissionDto>>(permsEl.GetRawText());
                            if (perms != null && perms.Count > 0)
                            {
                                (UserService as GFC.Mobile.Services.MobileUserManagementService)?.UpdateCachedPermissions(perms);
                                Console.WriteLine($"[HUB] Loaded {perms.Count} permissions from localStorage.");
                            }
                        }
                    }
                    catch (Exception ex)
                    {
                        Console.WriteLine($"[HUB] Permission pre-warm failed: {ex.Message}");
                    }
                }

                _userPermissions = UserService.GetUserPagePermissions(currentAppUser.UserId);
                UserRoutes = _userPermissions.Where(p => p.CanAccess).Select(p => p.PageRoute.TrimStart('/').ToLowerInvariant()).ToHashSet();

                // Step 2: Fire background server refresh AFTER the hub is rendered.
                // This silently updates permissions if admin has changed them,
                // without blocking the UI or triggering re-mount loops.
                _ = RefreshPermissionsInBackgroundAsync(currentAppUser.UserId);
            }
            
            
            if (HasAccessTo("Shift Sales Alert"))
            {
                await LoadDismissedShifts();
                _missingShifts = await ShiftComplianceService.GetMissingShiftsAsync();
                _lastSyncedAt = DateTime.Now;
                _syncStatus = "Synced";
            }
            
            _isCircutAlive = true;
            IsLoading = false; 
        }

        // 2. Background refresh disabled to prevent reload loop
        // _ = RefreshData();
    }

    private async Task RefreshData()
    {
        try
        {
            IsRefreshing = true;
            StateHasChanged();
            
            await AuthStateProvider.RefreshUserAsync();
            
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            var currentAppUser = AuthStateProvider.GetCurrentUser();

            // [FIX] Consistent username resolution
            Username = user.Identity?.Name ?? currentAppUser?.Username ?? "Staff Member";
            
            if (currentAppUser != null)
            {
                IsAdmin = currentAppUser.IsAdmin;
                var permissions = UserService.GetUserPagePermissions(currentAppUser.UserId);
                UserRoutes = permissions.Select(p => p.PageRoute.TrimStart('/').ToLowerInvariant()).ToHashSet();

                if (HasAccessTo("Shift Sales Alert"))
                {
                    await LoadDismissedShifts();
                    _missingShifts = await ShiftComplianceService.GetMissingShiftsAsync();
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Hub Refresh Error: {ex.Message}");
        }
        finally
        {
            IsLoading = false;
            IsRefreshing = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    /// <summary>
    /// Fetches fresh permissions from the server in the background AFTER the hub has rendered.
    /// Does NOT call NotifyAuthenticationStateChanged — safe to fire-and-forget from OnInitializedAsync.
    /// Updates the hub's tool list silently if permissions have changed.
    /// </summary>
    private async Task RefreshPermissionsInBackgroundAsync(int userId)
    {
        try
        {
            // Small delay so the initial render completes first
            await Task.Delay(500);

            var authJson = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "gfc_auth_state");
            if (string.IsNullOrEmpty(authJson)) return;

            var authData = System.Text.Json.JsonDocument.Parse(authJson);
            string? token = null;
            if (authData.RootElement.TryGetProperty("Token", out var tokenEl))
                token = tokenEl.GetString();
            if (string.IsNullOrEmpty(token)) return;

            // Fetch fresh permissions directly — bypass auth state notification entirely
            var response = await Http.GetAsync($"/api/mobile-auth/user?token={token}");

            if (!response.IsSuccessStatusCode) return;

            var result = await response.Content.ReadFromJsonAsync<GFC.Core.Models.GfcLoginResult>();
            if (result?.Permissions == null) return;

            // Update the service cache directly — no auth state notification
            (UserService as GFC.Mobile.Services.MobileUserManagementService)
                ?.UpdateCachedPermissions(result.Permissions);

            // Write back to localStorage for next load
            var newAuthData = new
            {
                User = result.User,
                Token = token,
                Permissions = result.Permissions,
                CreatedAt = DateTime.UtcNow,
                ExpiresAt = DateTime.UtcNow.AddDays(30)
            };
            await JSRuntime.InvokeVoidAsync("localStorage.setItem", "gfc_auth_state",
                System.Text.Json.JsonSerializer.Serialize(newAuthData));

            // Refresh the hub's tool list if permissions changed
            var freshRoutes = result.Permissions
                .Where(p => p.CanAccess)
                .Select(p => p.PageRoute.TrimStart('/').ToLowerInvariant())
                .ToHashSet();

            if (!freshRoutes.SetEquals(UserRoutes))
            {
                _userPermissions = result.Permissions;
                UserRoutes = freshRoutes;
                Console.WriteLine($"[HUB] Background refresh updated permissions: {UserRoutes.Count} routes.");
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[HUB] Background permission refresh failed: {ex.Message}");
        }
    }

    private async Task ReloadSessionAsync()
    {
        _debugInfo = "RELOADING...";
        StateHasChanged();
        
        await AuthStateProvider.RefreshUserAsync();
        
        // Re-run diagnostic
        await OnInitializedAsync();
    }

    private bool HasAccessTo(string featureName)
    {
        if (IsAdmin) return true;

        var normalizedSearch = featureName.ToLower();

        // 1. Try matching by specific route patterns
        var cleanRoutes = UserRoutes.Select(r => r.Trim('/').ToLower()).ToHashSet();
        bool routeMatch = normalizedSearch switch
        {
            "end of shift sales" => cleanRoutes.Contains("mobile/shift-report"),
            "liquor hub (mobile)" => cleanRoutes.Contains("mobile/liquor/hub"),
            "income charts" => cleanRoutes.Contains("mobile/analytics"),
            "key cards" => cleanRoutes.Contains("mobile/keycards"),
            "mobile dues & payments" => cleanRoutes.Contains("mobile/dues"),
            "mobile user management" => cleanRoutes.Contains("mobile/users"),
            "shift sales alert" => cleanRoutes.Contains("widgets/shift-sales-alert"),
            "system vitals" => cleanRoutes.Contains("mobile/system/stats"),
            "janitor hours entry" => cleanRoutes.Contains("mobile/janitor-hours"),
            _ => false
        };

        if (routeMatch) return true;

        return false;
    }

    private void NavigateTo(string route)
    {
        Navigation.NavigateTo(route);
    }

    private void GoHome()
    {
        Navigation.NavigateTo("/mobile");
    }

    private void OpenMissingShiftsModal()
    {
        _showMissingShiftsModal = true;
    }

    private void CloseMissingShiftsModal()
    {
        _showMissingShiftsModal = false;
    }

    private string GetShiftId(MissingShiftAlert shift)
    {
        return $"{shift.Date:yyyy-MM-dd}_{shift.ShiftType}";
    }

    private async Task LoadDismissedShifts()
    {
        try
        {
            var json = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "gfc_dismissed_shifts");
            if (!string.IsNullOrEmpty(json))
            {
                var list = System.Text.Json.JsonSerializer.Deserialize<List<string>>(json);
                if (list != null)
                {
                    _dismissedShiftIds = new HashSet<string>(list);
                }
            }
        }
        catch { /* ignore JS errors */ }
    }

    private async Task DismissSingleShift(MissingShiftAlert shift)
    {
        var id = GetShiftId(shift);
        if (!_dismissedShiftIds.Contains(id))
        {
            _dismissedShiftIds.Add(id);
            await SaveDismissedShifts();
            
            if (!_validMissingShifts.Any())
            {
                _showMissingShiftsModal = false;
            }
        }
    }

    private async Task SaveDismissedShifts()
    {
        try
        {
            var json = System.Text.Json.JsonSerializer.Serialize(_dismissedShiftIds.ToList());
            await JSRuntime.InvokeVoidAsync("localStorage.setItem", "gfc_dismissed_shifts", json);
        }
        catch { /* ignore JS errors */ }
    }
    
    private async Task HandleLogout()
    {
        try
        {
            var token = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "gfc_device_token");
            await AuthStateProvider.LogoutAsync(token);
            await JSRuntime.InvokeVoidAsync("localStorage.removeItem", "gfc_device_token");
            await JSRuntime.InvokeVoidAsync("window.setCookie", "GFC_DeviceTrustToken", "", -1);
            await Task.Delay(100);
            Navigation.NavigateTo("/login", forceLoad: true);
        }
        catch
        {
            Navigation.NavigateTo("/login", forceLoad: true);
        }
    }
}
