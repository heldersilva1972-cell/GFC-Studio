    @@keyframes slideUp {
        from { transform: translateY(100%); }
        to { transform: translateY(0); }
    }
    .spin { animation: rotation 1s infinite linear; }
    @@keyframes rotation { from { transform: rotate(0deg); } to { transform: rotate(359deg); } }
</style>

@code {
    private string Username { get; set; } = "...";
    private bool IsLoading { get; set; } = true;
    private HashSet<string> UserRoutes { get; set; } = new();
    private List<MissingShiftAlert> _missingShifts = new();
    private HashSet<string> _dismissedShiftIds = new();
    private bool _showMissingShiftsModal = false;
    private bool _isCircutAlive = true;
    private string? _syncStatus = null;
    private DateTime? _lastSyncedAt;
    
    private List<MissingShiftAlert> _validMissingShifts => 
        _missingShifts.Where(s => !_dismissedShiftIds.Contains(GetShiftId(s))).ToList();
    
    private bool IsAdmin { get; set; }
    private string _debugInfo = "";
    private List<GFC.Core.DTOs.MobilePermissionDto> _userPermissions = new();
    private bool HasAnyMobileTools => IsAdmin || _userPermissions.Count > 0;

    private bool IsRefreshing { get; set; }

    private bool _showDiagnostics = false;
    private int _versionClickCount = 0;
    private bool _isSyncingPermissions = false;
    private string? _syncFeedback;
    private bool _canInstall = false;
    private string? _installInstructions;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // [PWA] Check if the app can be installed
            try {
                var result = await JSRuntime.InvokeAsync<PwaInstallResult>("pwaInstaller.checkInstallability");
                _canInstall = result.CanInstall;
                _installInstructions = result.Instructions;
                StateHasChanged();
            } catch { }
        }
    }

    private async Task InstallAppAsync()
    {
        try {
            await JSRuntime.InvokeVoidAsync("pwaInstaller.install");
            // Re-check after attempt
            var result = await JSRuntime.InvokeAsync<PwaInstallResult>("pwaInstaller.checkInstallability");
            _canInstall = result.CanInstall;
            _installInstructions = result.Instructions;
            StateHasChanged();
        } catch { }
    }

    public class PwaInstallResult {
        public bool CanInstall { get; set; }
        public string? Instructions { get; set; }
    }

    private async Task ForceWipeAndResetAsync()
    {
        await JSRuntime.InvokeVoidAsync("localStorage.clear");
        await JSRuntime.InvokeVoidAsync("sessionStorage.clear");
        await JSRuntime.InvokeVoidAsync("location.assign", "/login");
    }

    private async Task ManualSyncPermissionsAsync()
    {
        if (_isSyncingPermissions) return;
        _isSyncingPermissions = true;
        _syncFeedback = "Syncing...";
        StateHasChanged();

        var currentAppUser = (AuthStateProvider as GFC.Mobile.Auth.CustomAuthenticationStateProvider)?.GetCurrentUser();
        if (currentAppUser != null)
        {
            await RefreshPermissionsInBackgroundAsync(currentAppUser.UserId);
        }

        _isSyncingPermissions = false;
        StateHasChanged();
        
        // Clear feedback after 3 seconds
        _ = Task.Delay(3000).ContinueWith(_ => { _syncFeedback = null; InvokeAsync(StateHasChanged); });
    }

    private void OnVersionClicked()
    {
        _versionClickCount++;
        if (_versionClickCount >= 5)
        {
            _showDiagnostics = true;
            _versionClickCount = 0;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        // 1. Instant check for current state
        var versionJson = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "gfc_app_version");
        Console.WriteLine($"[HUB] Initializing Mobile Hub v{versionJson ?? "Unknown"}");

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        var currentAppUser = AuthStateProvider.GetCurrentUser();

        // [FIX] Ensure Username is set even if the AppUser object is still loading
        Username = user.Identity?.Name ?? currentAppUser?.Username ?? "...";

        if (user.Identity?.IsAuthenticated == true)
        {
            IsAdmin = currentAppUser?.IsAdmin ?? false;
            
            if (currentAppUser != null) 
            {
                // [NEW] Subscribe to updates so if background load finishes, we re-render
                UserService.PermissionsUpdated += OnPermissionsUpdated;

                // Step 1: Read permissions from localStorage IMMEDIATELY
                var localAuth = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "gfc_auth_state");

                if (!string.IsNullOrEmpty(localAuth))
                {
                    try
                    {
                        using var doc = System.Text.Json.JsonDocument.Parse(localAuth);
                        // Check for both PascalCase and camelCase
                        JsonElement permsEl;
                        bool hasPerms = doc.RootElement.TryGetProperty("Permissions", out permsEl) || 
                                       doc.RootElement.TryGetProperty("permissions", out permsEl);

                        if (hasPerms)
                        {
                            var perms = System.Text.Json.JsonSerializer.Deserialize<List<GFC.Core.DTOs.MobilePermissionDto>>(permsEl.GetRawText(), 
                                new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                            
                            if (perms != null && perms.Count > 0)
                            {
                                (UserService as GFC.Mobile.Services.MobileUserManagementService)?.UpdateCachedPermissions(perms);
                                _debugInfo = "OK_" + perms.Count;
                            }
                            else _debugInfo = "EMPTY_PERMS";
                        }
                        else _debugInfo = "NO_PERMS_KEY";
                    }
                    catch (Exception ex)
                    {
                        _debugInfo = "PARSE_FAIL: " + ex.Message;
                    }
                }
                else _debugInfo = "NO_AUTH_DATA";

                _userPermissions = UserService.GetUserPagePermissions(currentAppUser.UserId);
                UserRoutes = _userPermissions.Where(p => p.CanAccess).Select(p => (p.PageRoute ?? "").Trim('/').ToLowerInvariant()).ToHashSet();

                // Step 2: Fire background server refresh AFTER the hub is rendered.
                // This silently updates permissions if admin has changed them,
                // without blocking the UI or triggering re-mount loops.
                _ = RefreshPermissionsInBackgroundAsync(currentAppUser.UserId);
            }
            
            
            _isCircutAlive = true;
            IsLoading = false; 

            // [PROGRESSIVE LOAD] Load alerts in the background so the Portal icons show up instantly
            if (HasAccessTo("Shift Sales Alert"))
            {
                _syncStatus = "Checking Server...";
                _ = Task.Run(async () => {
                    await LoadDismissedShifts();
                    _missingShifts = await ShiftComplianceService.GetMissingShiftsAsync();
                    _lastSyncedAt = DateTime.Now;
                    _syncStatus = "Synced";
                    await InvokeAsync(StateHasChanged);
                });
            }
        }

        // 2. Background refresh disabled to prevent reload loop
        // _ = RefreshData();
    }

    private async Task RefreshData()
    {
        try
        {
            IsRefreshing = true;
            StateHasChanged();
            
            await AuthStateProvider.RefreshUserAsync();
            
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            var currentAppUser = AuthStateProvider.GetCurrentUser();

            // [FIX] Consistent username resolution
            Username = user.Identity?.Name ?? currentAppUser?.Username ?? "Staff Member";
            
            if (currentAppUser != null)
            {
                IsAdmin = currentAppUser.IsAdmin;
                var permissions = UserService.GetUserPagePermissions(currentAppUser.UserId);
                UserRoutes = permissions.Select(p => p.PageRoute.TrimStart('/').ToLowerInvariant()).ToHashSet();

                if (HasAccessTo("Shift Sales Alert"))
                {
                    await LoadDismissedShifts();
                    _missingShifts = await ShiftComplianceService.GetMissingShiftsAsync();
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Hub Refresh Error: {ex.Message}");
        }
        finally
        {
            IsLoading = false;
            IsRefreshing = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    /// <summary>
    /// Fetches fresh permissions from the server in the background AFTER the hub has rendered.
    /// Does NOT call NotifyAuthenticationStateChanged — safe to fire-and-forget from OnInitializedAsync.
    /// Updates the hub's tool list silently if permissions have changed.
    /// </summary>
    private async Task RefreshPermissionsInBackgroundAsync(int userId)
    {
        try
        {
            var token = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "gfc_device_token");
            if (string.IsNullOrEmpty(token)) return;

            Console.WriteLine($"[HUB] Refreshing permissions for User {userId}...");
            var result = await UserService.RefreshPermissionsAsync(token);
            
            if (result.Success && result.Permissions != null)
            {
                var freshRoutes = result.Permissions
                    .Where(p => p.CanAccess)
                    .Select(p => (p.PageRoute ?? "").Trim('/').ToLowerInvariant())
                    .Where(r => !string.IsNullOrEmpty(r))
                    .ToHashSet();
                
                // [FORCE UPDATE] Always update the local state to ensure reactivity
                _userPermissions = result.Permissions;
                UserRoutes = freshRoutes;
                
                // Store in local storage via the service (already handled by RefreshPermissionsAsync)
                
                _syncFeedback = "Synced";
                Console.WriteLine($"[HUB] Permissions synchronized: {UserRoutes.Count} routes.");
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (Exception ex)
        {
            _syncFeedback = "Sync Failed";
            Console.WriteLine($"[HUB] Permission refresh failed: {ex.Message}");
        }
    }

    private void OnPermissionsUpdated()
    {
        var currentAppUser = (AuthStateProvider as GFC.Mobile.Auth.CustomAuthenticationStateProvider)?.GetCurrentUser();
        if (currentAppUser != null)
        {
            _userPermissions = UserService.GetUserPagePermissions(currentAppUser.UserId);
            UserRoutes = _userPermissions.Where(p => p.CanAccess).Select(p => p.PageRoute.TrimStart('/').ToLowerInvariant()).ToHashSet();
            InvokeAsync(StateHasChanged);
        }
    }

    public void Dispose()
    {
        UserService.PermissionsUpdated -= OnPermissionsUpdated;
    }

    private async Task ReloadSessionAsync()
    {
        _debugInfo = "RELOADING...";
        StateHasChanged();
        
        await AuthStateProvider.RefreshUserAsync();
        
        // Re-run diagnostic
        await OnInitializedAsync();
    }

    private bool HasAccessTo(string featureName)
    {
        if (IsAdmin) return true;

        var normalizedSearch = featureName.ToLower().Trim();

        // 1. Try matching by specific route patterns (High precision)
        // UserRoutes is already normalized to lowercase and trimmed in OnInitializedAsync
        var cleanRoutes = UserRoutes;
        bool routeMatch = normalizedSearch switch
        {
            "end of shift sales" => cleanRoutes.Contains("mobile/shift-report") || cleanRoutes.Contains("shift-report"),
            "liquor hub" => cleanRoutes.Contains("mobile/liquor/hub") || cleanRoutes.Contains("liquor/hub"),
            "liquor hub mobile" => cleanRoutes.Contains("mobile/liquor/hub") || cleanRoutes.Contains("liquor/hub"),
            "liquor hub (mobile)" => cleanRoutes.Contains("mobile/liquor/hub") || cleanRoutes.Contains("liquor/hub"),
            "income charts" => cleanRoutes.Contains("mobile/analytics") || cleanRoutes.Contains("analytics"),
            "income charts & analytics" => cleanRoutes.Contains("mobile/analytics") || cleanRoutes.Contains("analytics"),
            "key cards" => cleanRoutes.Contains("mobile/keycards") || cleanRoutes.Contains("keycards"),
            "door key cards (mobile)" => cleanRoutes.Contains("mobile/keycards") || cleanRoutes.Contains("keycards"),
            "mobile dues & payments" => cleanRoutes.Contains("mobile/dues") || cleanRoutes.Contains("dues"),
            "dues & payments (mobile)" => cleanRoutes.Contains("mobile/dues") || cleanRoutes.Contains("dues"),
            "mobile user management" => cleanRoutes.Contains("mobile/users") || cleanRoutes.Contains("users"),
            "shift sales alert" => cleanRoutes.Contains("widgets/shift-sales-alert"),
            "system vitals" => cleanRoutes.Contains("mobile/system/stats") || cleanRoutes.Contains("system/stats"),
            "system vitals (mobile)" => cleanRoutes.Contains("mobile/system/stats") || cleanRoutes.Contains("system/stats"),
            "janitor hours entry" => cleanRoutes.Contains("mobile/janitor-hours") || cleanRoutes.Contains("janitor-hours"),
            "janitor hours (mobile)" => cleanRoutes.Contains("mobile/janitor-hours") || cleanRoutes.Contains("janitor-hours"),
            _ => false
        };

        if (routeMatch) return true;

        // 2. Fallback: Match by PageName (if the routes are slightly different in DB or switch is missing)
        if (_userPermissions != null && _userPermissions.Any())
        {
            return _userPermissions.Any(p => p.CanAccess && 
                (p.PageName.ToLower().Contains(normalizedSearch) || normalizedSearch.Contains(p.PageName.ToLower())));
        }

        return false;
    }

    private void NavigateTo(string route)
    {
        Navigation.NavigateTo(route);
    }

    private void GoHome()
    {
        Navigation.NavigateTo("/mobile");
    }

    private void OpenMissingShiftsModal()
    {
        _showMissingShiftsModal = true;
    }

    private void CloseMissingShiftsModal()
    {
        _showMissingShiftsModal = false;
    }

    private string GetShiftId(MissingShiftAlert shift)
    {
        return $"{shift.Date:yyyy-MM-dd}_{shift.ShiftType}";
    }

    private async Task LoadDismissedShifts()
    {
        try
        {
            var json = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "gfc_dismissed_shifts");
            if (!string.IsNullOrEmpty(json))
            {
                var list = System.Text.Json.JsonSerializer.Deserialize<List<string>>(json);
                if (list != null)
                {
                    _dismissedShiftIds = new HashSet<string>(list);
                }
            }
        }
        catch { /* ignore JS errors */ }
    }

    private async Task DismissSingleShift(MissingShiftAlert shift)
    {
        var id = GetShiftId(shift);
        if (!_dismissedShiftIds.Contains(id))
        {
            _dismissedShiftIds.Add(id);
            await SaveDismissedShifts();
            
            if (!_validMissingShifts.Any())
            {
                _showMissingShiftsModal = false;
            }
        }
    }

    private async Task SaveDismissedShifts()
    {
        try
        {
            var json = System.Text.Json.JsonSerializer.Serialize(_dismissedShiftIds.ToList());
            await JSRuntime.InvokeVoidAsync("localStorage.setItem", "gfc_dismissed_shifts", json);
        }
        catch { /* ignore JS errors */ }
    }
    
    private async Task HandleLogout()
    {
        try
        {
            var token = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "gfc_device_token");
            await AuthStateProvider.LogoutAsync(token);
            await JSRuntime.InvokeVoidAsync("localStorage.removeItem", "gfc_device_token");
            await JSRuntime.InvokeVoidAsync("window.setCookie", "GFC_DeviceTrustToken", "", -1);
            await Task.Delay(100);
            Navigation.NavigateTo("/login");
        }
        catch
        {
            Navigation.NavigateTo("/login");
        }
    }
}
