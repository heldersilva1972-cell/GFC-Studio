    }
    .spin { animation: rotation 1s infinite linear; }
    @@keyframes rotation { from { transform: rotate(0deg); } to { transform: rotate(359deg); } }
</style>

@code {
    public void Dispose()
    {
        UserService.PermissionsUpdated -= OnPermissionsUpdated;
    }

    private string Username { get; set; } = "...";
    private bool IsLoading { get; set; } = true;
    private HashSet<string> UserRoutes { get; set; } = new();
    private HashSet<string> UserPageNames { get; set; } = new();
    private bool _isCircutAlive = true;
    
    private bool IsAdmin { get; set; }
    private string _debugInfo = "";
    private List<GFC.Core.DTOs.MobilePermissionDto> _userPermissions = new();
    private bool HasAnyMobileTools => IsAdmin || _userPermissions.Count > 0;

    private bool IsRefreshing { get; set; }

    private bool _showDiagnostics = false;
    private int _versionClickCount = 0;
    private bool _isSyncingPermissions = false;
    private string? _syncFeedback;
    private bool _canInstall = false;
    private string? _installInstructions;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // [PWA] Check if the app can be installed
            try {
                var result = await JSRuntime.InvokeAsync<PwaInstallResult>("pwaInstaller.checkInstallability");
                _canInstall = result.CanInstall;
                _installInstructions = result.Instructions;
                StateHasChanged();
            } catch { }
        }
    }

    private async Task InstallAppAsync()
    {
        try {
            await JSRuntime.InvokeVoidAsync("pwaInstaller.install");
            // Re-check after attempt
            var result = await JSRuntime.InvokeAsync<PwaInstallResult>("pwaInstaller.checkInstallability");
            _canInstall = result.CanInstall;
            _installInstructions = result.Instructions;
            StateHasChanged();
        } catch { }
    }

    public class PwaInstallResult {
        public bool CanInstall { get; set; }
        public string? Instructions { get; set; }
    }

    private async Task ForceWipeAndResetAsync()
    {
        await JSRuntime.InvokeVoidAsync("localStorage.clear");
        await JSRuntime.InvokeVoidAsync("sessionStorage.clear");
        await JSRuntime.InvokeVoidAsync("location.assign", "/login");
    }

    private async Task ClearCacheAndLogout()
    {
        _syncFeedback = "Clearing Cache...";
        StateHasChanged();
        
        await JSRuntime.InvokeVoidAsync("localStorage.clear");
        await AuthStateProvider.LogoutAsync();
        Navigation.NavigateTo("/login", true);
    }

    private async Task ManualSyncPermissionsAsync()
    {
        if (_isSyncingPermissions) return;

        // [OFFLINE GUARD]
        if (!Connectivity.IsServerReachable)
        {
            _syncFeedback = "Server Offline";
            StateHasChanged();
            await Task.Delay(2000);
            _syncFeedback = null;
            StateHasChanged();
            return;
        }

        _isSyncingPermissions = true;
        _syncFeedback = "Syncing...";
        StateHasChanged();

        // [VERSION CHECK] Also check for updates when manual syncing
        try {
            var serverVersion = await ReportingService.GetServerVersionAsync();
            var clientVersion = VersionService.GetFullVersion();
            if (serverVersion != "Offline" && serverVersion != clientVersion)
            {
                Console.WriteLine($"[GFC SYNC] Version mismatch detected: S={serverVersion}, C={clientVersion}. Triggering reload...");
                await JSRuntime.InvokeVoidAsync("eval", "window.location.reload(true)");
                return; 
            }
        } catch { }

        var currentAppUser = (AuthStateProvider as GFC.Mobile.Auth.CustomAuthenticationStateProvider)?.GetCurrentUser();
        if (currentAppUser != null)
        {
            await RefreshPermissionsInBackgroundAsync(currentAppUser.UserId);
        }

        // Trigger an immediate outbox flush too
        await ReportingService.FlushOutboxAsync();

        _isSyncingPermissions = false;
        StateHasChanged();
        
        // Clear feedback after 3 seconds
        _ = Task.Delay(3000).ContinueWith(_ => { _syncFeedback = null; InvokeAsync(StateHasChanged); });
    }

    private void OnVersionClicked()
    {
        _versionClickCount++;
        if (_versionClickCount >= 5)
        {
            _showDiagnostics = true;
            _versionClickCount = 0;
        }
    }

    private int _lowStockCount = 0;

    private bool IsLiquorInventoryItem(LiquorItem item, IEnumerable<PosCategory> categories)
    {
        if (item.ParentItemId.HasValue) return false;
        if (item.InventoryTrackType == 2) return true;
        if (item.InventoryTrackType == 1 || item.InventoryTrackType == 3) return false;

        if (string.IsNullOrEmpty(item.Category)) return true;
        var cat = categories.FirstOrDefault(c => string.Equals(c.Name, item.Category, StringComparison.OrdinalIgnoreCase));
        if (cat != null)
        {
            return cat.InventoryTrackType == 1;
        }
        return true;
    }

    private async Task LoadLowStockCountAsync()
    {
        try
        {
            if (HasAccessTo("Ordering List (Mobile)"))
            {
                var items = await LiquorService.GetAllItemsAsync();
                var categories = await LiquorService.GetAllCategoriesAsync();
                if (items != null && categories != null)
                {
                    _lowStockCount = items.Where(i => IsLiquorInventoryItem(i, categories)).Count(i => i.CurrentStock <= i.MinStockLimit);
                    await InvokeAsync(StateHasChanged);
                }
            }
        }
        catch { }
    }

    protected override async Task OnInitializedAsync()
    {
        // 1. Instant check for current state
        var versionJson = await JSRuntime.InvokeAsync<string >("localStorage.getItem", "gfc_app_version");
        Console.WriteLine($"[HUB] Initializing Mobile Hub v{versionJson ?? "Unknown"}");

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        var currentAppUser = AuthStateProvider.GetCurrentUser();

        // [FIX] Ensure Username is set even if the AppUser object is still loading
        Username = user.Identity?.Name ?? currentAppUser?.Username ?? "...";

        if (user.Identity?.IsAuthenticated == true)
        {
            IsAdmin = currentAppUser?.IsAdmin ?? false;
            
            if (currentAppUser != null) 
            {
                // [NEW] Subscribe to updates so if background load finishes, we re-render
                UserService.PermissionsUpdated += OnPermissionsUpdated;

                // Step 1: Read permissions from localStorage IMMEDIATELY
                var localAuth = await JSRuntime.InvokeAsync<string >("localStorage.getItem", "gfc_auth_state");

                if (!string.IsNullOrEmpty(localAuth))
                {
                    try
                    {
                        using var doc = System.Text.Json.JsonDocument.Parse(localAuth);
                        // Check for both PascalCase and camelCase
                        JsonElement permsEl;
                        bool hasPerms = doc.RootElement.TryGetProperty("Permissions", out permsEl) || 
                                       doc.RootElement.TryGetProperty("permissions", out permsEl);

                        if (hasPerms)
                        {
                            var perms = System.Text.Json.JsonSerializer.Deserialize<List<GFC.Core.DTOs.MobilePermissionDto>>(permsEl.GetRawText(), 
                                new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                            
                            if (perms != null && perms.Count > 0)
                            {
                                (UserService as GFC.Mobile.Services.MobileUserManagementService)?.UpdateCachedPermissions(perms);
                                _debugInfo = "OK_" + perms.Count;
                            }
                            else _debugInfo = "EMPTY_PERMS";
                        }
                        else _debugInfo = "NO_PERMS_KEY";
                    }
                    catch (Exception ex)
                    {
                        _debugInfo = "PARSE_FAIL: " + ex.Message;
                    }
                }
                else 
                {
                    _debugInfo = "NO_AUTH_DATA";
                }

                _userPermissions = UserService.GetUserPagePermissions(currentAppUser.UserId);
                UserRoutes = _userPermissions.Where(p => p.CanAccess).Select(p => (p.PageRoute ?? "").Trim('/').ToLowerInvariant()).ToHashSet();
                UserPageNames = _userPermissions
                    .Where(p => p.CanAccess && (p.Category?.ToUpper() == "MOBILE HUB" || (p.PageName != null && p.PageName.Contains("(Mobile)"))))
                    .Select(p => (p.PageName ?? "").Trim().ToLowerInvariant())
                    .ToHashSet();

                // Step 2: Fire background server refresh AFTER the hub is rendered.
                // This silently updates permissions if admin has changed them,
                // without blocking the UI or triggering re-mount loops.
                _ = RefreshPermissionsInBackgroundAsync(currentAppUser.UserId);
            }
            
            _isCircutAlive = true;
            IsLoading = false; 
            _ = LoadLowStockCountAsync();
        }
    }

    private async Task RefreshData()
    {
        try
        {
            IsRefreshing = true;
            StateHasChanged();
            
            await AuthStateProvider.RefreshUserAsync();
            
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            var currentAppUser = AuthStateProvider.GetCurrentUser();

            // [FIX] Consistent username resolution
            Username = user.Identity?.Name ?? currentAppUser?.Username ?? "Staff Member";
            
            if (currentAppUser != null)
            {
                IsAdmin = currentAppUser.IsAdmin;
                _userPermissions = UserService.GetUserPagePermissions(currentAppUser.UserId);
                UserRoutes = _userPermissions.Where(p => p.CanAccess).Select(p => (p.PageRoute ?? "").Trim('/').ToLowerInvariant()).ToHashSet();
                UserPageNames = _userPermissions
                    .Where(p => p.CanAccess && (p.Category?.ToUpper() == "MOBILE HUB" || (p.PageName != null && p.PageName.Contains("(Mobile)"))))
                    .Select(p => (p.PageName ?? "").Trim().ToLowerInvariant())
                    .ToHashSet();
                
                await LoadLowStockCountAsync();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Hub Refresh Error: {ex.Message}");
        }
        finally
        {
            IsLoading = false;
            IsRefreshing = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    /// <summary>
    /// Fetches fresh permissions from the server in the background AFTER the hub has rendered.
    /// Does NOT call NotifyAuthenticationStateChanged — safe to fire-and-forget from OnInitializedAsync.
    /// Updates the hub's tool list silently if permissions have changed.
    /// </summary>
    private async Task RefreshPermissionsInBackgroundAsync(int userId)
    {
        try
        {
            string? token = null;
            var authStateJson = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "gfc_auth_state");
            if (!string.IsNullOrEmpty(authStateJson))
            {
                try
                {
                    using var doc = System.Text.Json.JsonDocument.Parse(authStateJson);
                    if (doc.RootElement.TryGetProperty("token", out var tokenProp) || doc.RootElement.TryGetProperty("Token", out tokenProp))
                    {
                        token = tokenProp.GetString();
                    }
                }
                catch { }
            }

            if (string.IsNullOrEmpty(token))
            {
                token = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "gfc_device_token");
            }

            if (string.IsNullOrEmpty(token)) return;

            Console.WriteLine($"[HUB] Refreshing permissions for User {userId}...");
            var result = await UserService.RefreshPermissionsAsync(token);
            
            if (result.Success && result.Permissions != null)
            {
                // [FORCE UPDATE] Strictly filter dashboard tiles to MOBILE HUB category
                UserPageNames = result.Permissions
                    .Where(p => p.CanAccess && (p.Category?.ToUpper() == "MOBILE HUB" || (p.PageName != null && p.PageName.Contains("(Mobile)"))))
                    .Select(p => (p.PageName ?? "").Trim().ToLowerInvariant())
                    .ToHashSet();

                UserRoutes = result.Permissions
                    .Where(p => p.CanAccess)
                    .Select(p => (p.PageRoute ?? "").Trim('/').ToLowerInvariant())
                    .ToHashSet();
                
                _syncFeedback = "Synced";
                Console.WriteLine($"[HUB] Mobile Dashboard Permissions synchronized: {UserPageNames.Count} specific hub items.");
                _ = LoadLowStockCountAsync();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (Exception ex)
        {
            _syncFeedback = "Sync Failed";
            Console.WriteLine($"[HUB] Permission refresh failed: {ex.Message}");
        }
    }

    private void OnPermissionsUpdated()
    {
        var currentAppUser = (AuthStateProvider as GFC.Mobile.Auth.CustomAuthenticationStateProvider)?.GetCurrentUser();
        if (currentAppUser != null)
        {
            _userPermissions = UserService.GetUserPagePermissions(currentAppUser.UserId);
            
            // [FORCE UPDATE] Strictly filter dashboard tiles to MOBILE HUB category
            UserPageNames = _userPermissions
                .Where(p => p.CanAccess && (p.Category?.ToUpper() == "MOBILE HUB" || (p.PageName != null && p.PageName.Contains("(Mobile)"))))
                .Select(p => (p.PageName ?? "").Trim().ToLowerInvariant())
                .ToHashSet();

            UserRoutes = _userPermissions
                .Where(p => p.CanAccess)
                .Select(p => (p.PageRoute ?? "").Trim('/').ToLowerInvariant())
                .ToHashSet();
                
            _ = LoadLowStockCountAsync();
            InvokeAsync(StateHasChanged);
        }
    }

    private async Task ReloadSessionAsync()
    {
        _debugInfo = "RELOADING...";
        StateHasChanged();
        
        await AuthStateProvider.RefreshUserAsync();
        
        // Re-run diagnostic
        await OnInitializedAsync();
    }

    private bool HasAccessTo(string featureName)
    {
        if (UserPageNames == null || UserRoutes == null) return false;
        
        // [ADMIN OVERRIDE] Safety fallback: if they are an admin, they should see everything
        // even if the registry sync is currently failing.
        if (IsAdmin) return true;

        var normalizedSearch = featureName.Trim().ToLowerInvariant();

        if (UserRoutes.Contains(normalizedSearch)) return true;
        if (UserPageNames.Contains(normalizedSearch)) return true;

        // Route-based mapping for legacy or descriptive names
        return normalizedSearch switch
        {
            "end of shift sales" => UserRoutes.Contains("mobile/shift-report"),
            "janitor hours entry" => UserRoutes.Contains("mobile/janitor-hours"),
            "bar manager hours entry" => UserRoutes.Contains("mobile/bar-manager-hours"),
            "income charts" => UserRoutes.Contains("mobile/analytics"),
            "key cards" => UserRoutes.Contains("mobile/keycards"),
            "dues" => UserRoutes.Contains("mobile/dues"),
            "liquor hub (mobile)" => UserRoutes.Contains("mobile/liquor/hub"),
            "inventory check (mobile)" => UserRoutes.Contains("mobile/liquor/hub/count"),
            "ordering list (mobile)" => UserRoutes.Contains("mobile/liquor/hub/ordering"),
            "bingo tracking" => UserRoutes.Contains("mobile/bingo"),
            _ => false
        };
    }

    private void NavigateTo(string route)
    {
        Navigation.NavigateTo(route);
    }

    private void GoHome()
    {
        Navigation.NavigateTo("/mobile");
    }

    
    private async Task HandleLogout()
    {
        try
        {
            await AuthStateProvider.LogoutAsync();
            await Task.Delay(100);
            Navigation.NavigateTo("/login");
        }
        catch
        {
            Navigation.NavigateTo("/login");
        }
    }
}
