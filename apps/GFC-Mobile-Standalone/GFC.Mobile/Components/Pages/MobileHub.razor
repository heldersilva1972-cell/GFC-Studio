        display: grid;
        grid-template-columns: 1fr;
        gap: 12px;
    }

    @@media (min-width: 768px) {
        .portal-grid {
            grid-template-columns: 1fr 1fr;
            gap: 16px;
        }
    }

    .mobile-hub-container {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        display: flex;
        flex-direction: column;
        background-color: var(--app-bg, #f8f9fa);
        overflow: hidden;
    }

    .header-nav-stack {
        flex-shrink: 0;
        z-index: 1000;
        background: white;
        border-bottom: 1px solid rgba(0, 0, 0, 0.1);
    }

    .hub-scroll-area {
        flex: 1;
        overflow-y: auto;
        -webkit-overflow-scrolling: touch;
        padding-bottom: 90px;
    }

    /* Diagnostics Badge Tooltip */
    .diag-details {
        font-size: 0.6rem;
        background: #333;
        color: #eee;
        padding: 4px;
        border-radius: 4px;
        margin-top: 4px;
    }

    .btn-danger-soft {
        background-color: #fce8e8;
        color: #dc3545;
        border: none;
    }
    .btn-danger-soft:active {
        background-color: #dc3545;
        color: white;
    }

    .btn-signout-pill {
        display: inline-flex;
        align-items: center;
        background: #fef2f2;
        color: #dc2626;
        border: 1.5px solid #fecaca;
        border-radius: 50px;
        padding: 7px 16px;
        font-weight: 700;
        font-size: 0.8rem;
        letter-spacing: 0.03em;
        white-space: nowrap;
