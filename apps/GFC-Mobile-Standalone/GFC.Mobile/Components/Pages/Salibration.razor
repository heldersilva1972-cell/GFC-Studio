        // Find roll matching ticket prefix if available
        var matchedRoll = GetRollForTicket(ticket);
        if (matchedRoll != null)
        {
            _activeRollId = matchedRoll.Id;
        }

        var prefix = matchedRoll?.Prefix ?? _settings.TicketPrefix ?? "";
        string variableDigits;
        if (!string.IsNullOrEmpty(prefix) && ticket.StartsWith(prefix, StringComparison.OrdinalIgnoreCase))
        {
            variableDigits = ticket.Substring(prefix.Length);
        }
        else
        {
            variableDigits = ticket;
        }

        // Initialize digits buffer to match roll setting length
        InitializeDigitTiles();

        for (int i = 0; i < _currentDigits.Length && i < variableDigits.Length; i++)
        {
            _currentDigits[i] = variableDigits[i].ToString();
        }

        // Remove from list so user can edit and re-add or correct it
        _enteredTickets.Remove(ticket);
        _ticketInputError = null;
    }

