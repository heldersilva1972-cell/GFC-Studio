    /* HERO WELCOME SCREEN (STEP 1) */
    .sal-welcome-hero {
        max-width: 680px;
        margin: 2rem auto;
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 28px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.04);
    }
    .sal-hero-icon-wrapper {
        width: 88px;
        height: 88px;
        border-radius: 24px;
        background: linear-gradient(135deg, rgba(37, 99, 235, 0.12), rgba(59, 130, 246, 0.06));
        border: 1px solid rgba(37, 99, 235, 0.2);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2.8rem;
        box-shadow: 0 8px 24px rgba(37, 99, 235, 0.15);
    }
    .btn-hero-start {
        background: linear-gradient(135deg, #2563eb, #1d4ed8);
        color: #ffffff;
        font-size: 1.2rem;
        font-weight: 800;
        padding: 16px 36px;
        border-radius: 50px;
        border: none;
        letter-spacing: 0.3px;
