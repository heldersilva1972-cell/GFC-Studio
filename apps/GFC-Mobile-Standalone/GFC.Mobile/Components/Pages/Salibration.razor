    }

    private void AppendPrefixDigit(string digit)
    {
        _tempSettings.TicketPrefix = (_tempSettings.TicketPrefix ?? "") + digit;
    }

    private void ClearPrefix()
    {
        _tempSettings.TicketPrefix = "";
    }

    private void BackspacePrefix()
    {
