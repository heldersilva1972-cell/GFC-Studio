        }
        else if (phoneDigitsOnly.Length > 10)
        {
            _phoneError = true;
            _phoneErrorMessage = $"Phone number has {phoneDigitsOnly.Length} digits. Please enter a 10-digit number (area code + number).";
        }
        else
        {
            _phoneError = false;
            _phoneErrorMessage = null;
        }

        // Email Validation (Optional, but if entered, must be valid email format)
        if (!string.IsNullOrWhiteSpace(_email))
        {
            var emailPattern = @"^[^@\s]+@[^@\s]+\.[^@\s]+$";
            if (!Regex.IsMatch(_email.Trim(), emailPattern, RegexOptions.IgnoreCase))
            {
                _emailError = true;
                _emailErrorMessage = "Please enter a valid email address (e.g. name@domain.com).";
            }
