@page "/mobile/salibration"
@using GFC.Core.Interfaces
@using GFC.Core.Models
@using Microsoft.AspNetCore.Authorization
@using System.Text.RegularExpressions
@attribute [Authorize]
@inject ISalibrationService SalibrationService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject ICustomAuthenticationStateProvider AuthStateProvider
@inject IUserManagementService UserService

<PageTitle>@_settings.PageTitle | GFC Mobile</PageTitle>

<div class="sal-page-container @(_activeTab == "roster" ? "sal-page-container-roster" : (_activeTab == "entry" && _entryStep == EntryStep.TicketEntry ? "sal-page-container-entry-locked" : ""))">
    <!-- CLEAN MINIMAL TOP APP HEADER (HIDDEN IN REGISTER KIOSK MODE) -->
    @if (_activeTab != "entry")
    {
        <header class="sal-header animate-entrance flex-shrink-0">
            <div class="container-fluid px-3 py-2 d-flex align-items-center justify-content-between">
                <div>
                    @if (_activeTab == "main")
                    {
                        <button class="btn btn-outline-secondary btn-sm rounded-pill px-3 fw-bold d-flex align-items-center gap-1" @onclick='() => Navigation.NavigateTo("/mobile")' aria-label="Exit to Mobile App Main Page">
                            <i class="bi bi-box-arrow-left fs-6"></i>
                            <span>Exit to Mobile App</span>
                        </button>
                    }
                </div>
                
                <div class="sal-title-container text-center">
                    <h5 class="mb-0 fw-bold sal-brand-title">
                        <span class="sal-highlight">SAL</span>@GetFormattedTitleRest()
                    </h5>
                    <span class="sal-subtitle">@( _activeTab == "roster" ? "Saved Ticket Entries" : "Raffle Management Hub" )</span>
                </div>

                <div style="min-width: 100px;" class="text-end">
                    @if (_activeTab == "roster")
                    {
                        <button class="btn btn-sm btn-outline-secondary rounded-pill px-3 fw-bold d-flex align-items-center gap-1 ms-auto" @onclick="ExitToMainHub" title="Close and return to Main Menu">
                            <i class="bi bi-x-circle me-1"></i> Close
                        </button>
                    }
                </div>
            </div>
        </header>
    }

    <!-- MAIN SCROLLABLE AREA -->
    <main class="sal-main-content @(_activeTab == "roster" ? "sal-main-content-roster" : (_activeTab == "entry" && _entryStep == EntryStep.TicketEntry ? "sal-main-content-entry-locked" : ""))">
        <div class="container-fluid px-3 py-2">
            @if (_isLoading)
            {
                <div class="d-flex justify-content-center py-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                </div>
            }
            else if (_activeTab == "main")
            {
                <!-- ==================================================== -->
                <!-- MAIN MANAGEMENT HUB SCREEN                           -->
                <!-- ==================================================== -->
                <div class="sal-hub-container animate-entrance my-2">
                    <!-- EVENT BANNER -->
                    <div class="sal-hub-hero text-center p-4 mb-4 rounded-4 shadow-sm bg-white border">
                        <div class="sal-hub-badge mx-auto mb-3">
                            <i class="bi bi-ticket-detailed-fill text-primary"></i>
                        </div>
                        <h2 class="fw-bolder text-dark mb-1">@_settings.PageTitle</h2>
                        <p class="text-muted mb-0">Select an action below to manage raffle entries, start the donor kiosk, or draw winning tickets.</p>
                    </div>

                    <!-- ACTION CARDS GRID -->
                    <div class="row g-3 mb-4">
                        <!-- 1. REGISTER / START KIOSK -->
                        <div class="col-12 col-md-6">
                            <div class="sal-hub-card hub-card-primary shadow-sm h-100" @onclick="StartKioskRegistration">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="hub-card-icon bg-primary text-white">
                                        <i class="bi bi-person-fill-add"></i>
                                    </div>
                                    <div class="flex-grow-1">
                                        <h5 class="fw-bold mb-1 text-dark">Register Tickets</h5>
                                        <p class="text-muted small mb-0">Launch the dedicated donor registration kiosk for attendee entry.</p>
                                    </div>
                                    <i class="bi bi-chevron-right fs-4 text-primary opacity-50"></i>
                                </div>
                            </div>
                        </div>

                        <!-- 2. SAVED ENTRIES ROSTER -->
                        <div class="col-12 col-md-6">
                            <div class="sal-hub-card shadow-sm h-100" @onclick='() => SetTab("roster")'>
                                <div class="d-flex align-items-center gap-3">
                                    <div class="hub-card-icon bg-success bg-opacity-10 text-success">
                                        <i class="bi bi-collection-fill"></i>
                                    </div>
                                    <div class="flex-grow-1">
                                        <div class="d-flex align-items-center gap-2">
                                            <h5 class="fw-bold mb-1 text-dark">Saved Entries</h5>
                                            <span class="badge bg-success rounded-pill">@_participants.Count</span>
                                        </div>
                                        <p class="text-muted small mb-0">View registered participants and all @_totalTicketsRegistered tickets.</p>
                                    </div>
                                    <i class="bi bi-chevron-right fs-4 text-muted opacity-50"></i>
                                </div>
                            </div>
                        </div>

                        <!-- 3. CHECK WINNER -->
                        <div class="col-12 col-md-6">
                            <div class="sal-hub-card shadow-sm h-100" @onclick="OpenWinnerModal">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="hub-card-icon bg-warning bg-opacity-15 text-warning-emphasis">
                                        <i class="bi bi-trophy-fill"></i>
                                    </div>
                                    <div class="flex-grow-1">
                                        <h5 class="fw-bold mb-1 text-dark">Check Winner</h5>
                                        <p class="text-muted small mb-0">Look up drawn raffle ticket numbers to find winning donors.</p>
                                    </div>
                                    <i class="bi bi-chevron-right fs-4 text-muted opacity-50"></i>
                                </div>
                            </div>
                        </div>

                        <!-- 4. SETTINGS -->
                        <div class="col-12 col-md-6">
                            <div class="sal-hub-card shadow-sm h-100" @onclick="OpenSettingsModal">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="hub-card-icon bg-secondary bg-opacity-10 text-secondary">
                                        <i class="bi bi-gear-fill"></i>
                                    </div>
                                    <div class="flex-grow-1">
                                        <h5 class="fw-bold mb-1 text-dark">Event Settings</h5>
                                        <p class="text-muted small mb-0">Configure title, ticket prefix, digits, and thank you message.</p>
                                    </div>
                                    <i class="bi bi-chevron-right fs-4 text-muted opacity-50"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
            else if (_activeTab == "entry")
            {
                <!-- ==================================================== -->
                <!-- STAGE 1: WELCOME / START SCREEN                      -->
                <!-- ==================================================== -->
                @if (_entryStep == EntryStep.Welcome)
                {
                    <div class="sal-welcome-hero animate-scale-up text-center my-auto py-5 px-3">
                        <div class="d-flex justify-content-end px-3">
                            <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-3 py-1 fw-bold" @onclick="ExitToMainHub" title="Exit and return to Sal-ibration Main Screen">
                                <i class="bi bi-arrow-left-circle me-1"></i> Return to Main Screen
                            </button>
                        </div>
                        <div class="sal-hero-icon-wrapper mb-4 mx-auto">
                            <i class="bi bi-ticket-perforated-fill text-primary"></i>
                        </div>
                        <h2 class="fw-bolder text-dark mb-2">Welcome to the Sal-ibration Raffle!</h2>
                        <p class="text-muted fs-5 mb-4 mx-auto" style="max-width: 540px;">
                            Tap the button below to register your contact information and enter your raffle tickets.
                        </p>
                        <div class="d-inline-block">
                            <button type="button" class="btn btn-hero-start shadow-lg" @onclick="StartNewEntry">
                                <i class="bi bi-person-fill-add me-2"></i> Enter My Information & Tickets
                            </button>
                        </div>
                        @if (_participants.Count > 0)
                        {
                            <div class="mt-4 pt-3 text-muted small">
                                <span class="badge bg-light text-secondary border px-3 py-2 rounded-pill">
                                    <i class="bi bi-check2-circle text-success me-1"></i> @_participants.Count entries recorded so far
                                </span>
                            </div>
                        }
                    </div>
                }
                <!-- ==================================================== -->
                <!-- STAGE 2: PARTICIPANT INFORMATION SCREEN               -->
                <!-- ==================================================== -->
                else if (_entryStep == EntryStep.ParticipantInfo)
                {
                    <div class="row justify-content-center animate-entrance">
                        <div class="col-12 col-md-9 col-lg-7">
                            <div class="sal-card shadow-sm mb-0">
                                <div class="sal-card-header d-flex align-items-center justify-content-between">
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="sal-badge-icon"><i class="bi bi-person-fill-add"></i></span>
                                        <div>
                                            <h6 class="mb-0 fw-bold">Step 1 of 2: Participant Information</h6>
                                            <small class="text-muted">Enter your name, phone number, and optional email</small>
                                        </div>
                                    </div>
                                    <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-3" @onclick="CancelToWelcome">
                                        <i class="bi bi-x-lg me-1"></i> Cancel
                                    </button>
                                </div>

                                <div class="sal-card-body p-4">
                                    @if (_nameError || _phoneError || _emailError)
                                    {
                                        <div class="alert alert-danger d-flex align-items-center gap-2 py-2 px-3 mb-3 rounded-3 shadow-sm border-danger animate-shake">
                                            <i class="bi bi-exclamation-triangle-fill fs-5 text-danger flex-shrink-0"></i>
                                            <div class="small fw-bold">
                                                @if (_nameError)
                                                {
                                                    <div>• Participant Full Name is required.</div>
                                                }
                                                @if (_phoneError)
                                                {
                                                    <div>• @(_phoneErrorMessage ?? "A valid 10-digit phone number with area code is required.")</div>
                                                }
                                                @if (_emailError)
                                                {
                                                    <div>• @(_emailErrorMessage ?? "Please enter a valid email address (e.g. name@domain.com).")</div>
                                                }
                                            </div>
                                        </div>
                                    }

                                    <!-- Full Name Input -->
                                    <div class="mb-3">
                                        <div class="d-flex justify-content-between align-items-center mb-1">
                                            <label class="form-label required-label mb-0">Full Name</label>
                                            @if (!string.IsNullOrEmpty(FullName))
                                            {
                                                <button type="button" class="btn btn-field-clear-pill" @onclick='() => FullName = ""'>
                                                    <i class="bi bi-x-circle-fill me-1"></i>Clear
                                                </button>
                                            }
                                        </div>
                                        <div class="input-group-modern @(_nameError ? "input-group-error animate-shake" : (_activeField == "name" ? "focused-field" : ""))" @onclick='() => SetActiveField("name")'>
                                            <span class="input-icon"><i class="bi bi-person-fill @(_nameError ? "text-danger" : "text-primary")"></i></span>
                                            <input type="text" id="participant-name-input" class="form-control-modern" 
                                                   placeholder="e.g. John Doe" @bind="FullName" @bind:event="oninput" @onfocus='() => SetActiveField("name")' />
                                            @if (_nameError)
                                            {
                                                <i class="bi bi-exclamation-circle-fill text-danger ms-2" title="Name is required"></i>
                                            }
                                        </div>
                                        @if (_nameError)
                                        {
                                            <div class="field-error-msg fw-bold text-danger mt-1">
                                                <i class="bi bi-arrow-return-right me-1"></i> Full Name is required
                                            </div>
                                        }
                                    </div>

                                    <!-- Phone & Email Inputs -->
                                    <div class="row g-3 mb-3">
                                        <div class="col-12 col-md-6">
                                            <div class="d-flex justify-content-between align-items-center mb-1">
                                                <label class="form-label required-label mb-0">Phone Number (Area Code + Number)</label>
                                                @if (!string.IsNullOrEmpty(PhoneNumber))
                                                {
                                                    <button type="button" class="btn btn-field-clear-pill" @onclick='() => PhoneNumber = ""'>
                                                        <i class="bi bi-x-circle-fill me-1"></i>Clear
                                                    </button>
                                                }
                                            </div>
                                            <div class="input-group-modern @(_phoneError ? "input-group-error animate-shake" : (_activeField == "phone" ? "focused-field" : ""))" @onclick='() => SetActiveField("phone")'>
                                                <span class="input-icon"><i class="bi bi-telephone-fill @(_phoneError ? "text-danger" : "text-primary")"></i></span>
                                                <input type="tel" class="form-control-modern" 
                                                       placeholder="e.g. (555) 123-4567" @bind="PhoneNumber" @bind:event="oninput" @onfocus='() => SetActiveField("phone")' />
                                                @if (_phoneError)
                                                {
                                                    <i class="bi bi-exclamation-circle-fill text-danger ms-2" title="Phone error"></i>
                                                }
                                            </div>
                                            @if (_phoneError)
                                            {
                                                <div class="field-error-msg fw-bold text-danger mt-1">
                                                    <i class="bi bi-arrow-return-right me-1"></i> @(_phoneErrorMessage ?? "10-digit phone number with area code required (e.g. 555-123-4567)")
                                                </div>
                                            }
                                        </div>
                                        <div class="col-12 col-md-6">
                                            <div class="d-flex justify-content-between align-items-center mb-1">
                                                <label class="form-label optional-label mb-0">Email Address <span class="badge-optional">Optional</span></label>
                                                @if (!string.IsNullOrEmpty(Email))
                                                {
                                                    <button type="button" class="btn btn-field-clear-pill" @onclick='() => Email = ""'>
                                                        <i class="bi bi-x-circle-fill me-1"></i>Clear
                                                    </button>
                                                }
                                            </div>
                                            <div class="input-group-modern @(_emailError ? "input-group-error animate-shake" : (_activeField == "email" ? "focused-field" : ""))" @onclick='() => SetActiveField("email")'>
                                                <span class="input-icon"><i class="bi bi-envelope-fill @(_emailError ? "text-danger" : "text-primary")"></i></span>
                                                <input type="email" class="form-control-modern" 
                                                       placeholder="e.g. john@example.com" @bind="Email" @bind:event="oninput" @onfocus='() => SetActiveField("email")' />
                                                @if (_emailError)
                                                {
                                                    <i class="bi bi-exclamation-circle-fill text-danger ms-2" title="Email error"></i>
                                                }
                                            </div>
                                            @if (_emailError)
                                            {
                                                <div class="field-error-msg fw-bold text-danger mt-1">
                                                    <i class="bi bi-arrow-return-right me-1"></i> @(_emailErrorMessage ?? "Invalid email format (e.g. name@domain.com)")
                                                </div>
                                            }
                                            <div class="quick-domain-pills mt-1 d-flex gap-1 flex-wrap">
                                                <button type="button" class="btn btn-xs-domain" @onclick="AppendGmail">gmail.com</button>
                                                <button type="button" class="btn btn-xs-domain" @onclick="AppendYahoo">yahoo.com</button>
                                                <button type="button" class="btn btn-xs-domain" @onclick="AppendHotmail">hotmail.com</button>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Next button -->
                                    <div class="mt-4 pt-2">
                                        <button type="button" class="btn btn-sal-finish w-100 shadow-sm" @onclick="ProceedToTickets">
                                            <span>Save My Information & Enter Ticket Numbers</span>
                                            <i class="bi bi-arrow-right-circle-fill ms-2 fs-5"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
                <!-- ==================================================== -->
                <!-- STAGE 3: TICKET NUMBERS ENTRY & KEYPAD SCREEN         -->
                <!-- ==================================================== -->
                else if (_entryStep == EntryStep.TicketEntry)
                {
                    <div class="row g-3 animate-entrance ticket-entry-row">
                        <!-- LEFT COLUMN: ENTERED TICKET NUMBERS LIST -->
                        <div class="col-12 col-md-5 col-lg-5 order-2 order-md-1 ticket-entry-col">
                            <div class="sal-card h-100 mb-0 shadow-sm d-flex flex-column ticket-entry-card-left">
                                <div class="sal-card-header d-flex justify-content-between align-items-center flex-shrink-0">
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="sal-badge-icon bg-primary text-white">
                                            <i class="bi bi-collection-fill"></i>
                                        </span>
                                        <div>
                                            <h6 class="mb-0 fw-bold">Entered Tickets</h6>
                                            <small class="text-muted">For @_fullName</small>
                                        </div>
                                    </div>
                                    <span class="badge bg-success rounded-pill px-2 py-1 fs-6 shadow-sm">
                                        <i class="bi bi-check-all me-1"></i> @_enteredTickets.Count @(_enteredTickets.Count == 1 ? "Ticket" : "Tickets")
                                    </span>
                                </div>

                                <div class="sal-card-body flex-grow-1 d-flex flex-column p-3 ticket-entry-body-left">
                                    @if (_enteredTickets.Count > 0)
                                    {
                                        <div class="large-ticket-list flex-grow-1">
                                            @for (int i = 0; i < _enteredTickets.Count; i++)
                                            {
                                                var idx = i;
                                                var t = _enteredTickets[idx];
                                                var matchedRoll = GetRollForTicket(t);
                                                <div class="large-ticket-row animate-scale-up mb-2">
                                                    <div class="d-flex align-items-center gap-2">
                                                        <div class="ticket-index-badge">#@(idx + 1)</div>
                                                        <div>
                                                            <div class="large-ticket-number">
                                                                <i class="bi bi-ticket-perforated-fill text-primary me-1"></i>@t
                                                            </div>
                                                            @if (matchedRoll != null && !string.IsNullOrEmpty(matchedRoll.Label))
                                                            {
                                                                <span class="badge @GetBadgeClassForColor(matchedRoll.ColorBadge) extra-small py-0 px-2 rounded-pill">
                                                                    @matchedRoll.Label
                                                                </span>
                                                            }
                                                        </div>
                                                    </div>
                                                    <div class="d-flex align-items-center gap-2">
                                                        <button type="button" class="btn btn-edit-ticket-large" @onclick="() => EditTicket(t)" title="Edit ticket number">
                                                            <i class="bi bi-pencil-square"></i>
                                                        </button>
                                                        <button type="button" class="btn btn-delete-ticket-large" @onclick="() => RemoveTicket(t)" title="Remove ticket number">
                                                            <i class="bi bi-trash3-fill"></i>
                                                        </button>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="text-center py-5 my-auto text-muted">
                                            <i class="bi bi-ticket-perforated display-4 text-muted opacity-25 d-block mb-2"></i>
                                            <p class="fw-bold mb-1">No tickets entered yet</p>
                                            <small class="text-muted">Use the digit tiles and keypad on the right to enter each raffle ticket number.</small>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>

                        <!-- RIGHT COLUMN: DIGIT TILES & TOUCH KEYPAD -->
                        <div class="col-12 col-md-7 col-lg-7 order-1 order-md-2 ticket-entry-col">
                            <div class="sal-card mb-0 shadow-sm ticket-entry-card-right">
                                <div class="sal-card-header d-flex justify-content-between align-items-center flex-shrink-0">
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="sal-badge-icon"><i class="bi bi-ticket-perforated-fill"></i></span>
                                        <div>
                                            <h6 class="mb-0 fw-bold">Step 2 of 2: Enter Ticket Numbers</h6>
                                            <small class="text-muted">Participant: <strong>@_fullName</strong> (@_phoneNumber)</small>
                                        </div>
                                    </div>
                                    <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-3" @onclick="BackToParticipantInfo">
                                        <i class="bi bi-arrow-left me-1"></i> Edit Info
                                    </button>
                                </div>

                                <div class="sal-card-body p-3 ticket-entry-body-right">
                                    @if (!string.IsNullOrEmpty(_ticketInputError))
                                    {
                                        <div class="alert alert-danger d-flex align-items-center gap-2 py-2 px-3 mb-3 rounded-3 shadow-sm border-danger animate-shake">
                                            <i class="bi bi-exclamation-triangle-fill fs-5 text-danger flex-shrink-0"></i>
                                            <div class="small fw-bold">@_ticketInputError</div>
                                        </div>
                                    }

                                    <!-- VISUAL ILLUSTRATED STEP-BY-STEP INSTRUCTIONS -->
                                    <div class="sal-instructions-card mb-3 p-3 rounded-3 border bg-white shadow-2xs">
                                        <div class="d-flex align-items-center justify-content-between mb-2">
                                            <div class="d-flex align-items-center gap-2">
                                                <i class="bi bi-info-circle-fill text-primary fs-5"></i>
                                                <span class="fw-bold text-dark small">How to Enter Your Ticket Numbers</span>
                                            </div>
                                            <button type="button" class="btn btn-link btn-xs p-0 text-muted text-decoration-none" @onclick="() => _showHelpGuide = !_showHelpGuide">
                                                <i class="bi @(_showHelpGuide ? "bi-chevron-up" : "bi-chevron-down") me-1"></i>
                                                @(_showHelpGuide ? "Hide Guide" : "Show Guide")
                                            </button>
                                        </div>

                                        @if (_showHelpGuide)
                                        {
                                            <div class="row g-2 pt-1 animate-fade-in text-center">
                                                <div class="col-4">
                                                    <div class="p-2 rounded-2 bg-light border h-100 d-flex flex-column align-items-center justify-content-center">
                                                        <div class="step-circle mb-1">1</div>
                                                        <span class="extra-small fw-bold text-dark d-block">Check Ticket Prefix</span>
                                                        <span class="extra-small text-muted" style="font-size: 0.68rem;">Tap matching prefix button below</span>
                                                    </div>
                                                </div>
                                                <div class="col-4">
                                                    <div class="p-2 rounded-2 bg-light border h-100 d-flex flex-column align-items-center justify-content-center">
                                                        <div class="step-circle mb-1">2</div>
                                                        <span class="extra-small fw-bold text-dark d-block">Prefix is Locked</span>
                                                        <span class="extra-small text-muted" style="font-size: 0.68rem;">First digits are already entered</span>
                                                    </div>
                                                </div>
                                                <div class="col-4">
                                                    <div class="p-2 rounded-2 bg-light border h-100 d-flex flex-column align-items-center justify-content-center">
                                                        <div class="step-circle mb-1">3</div>
                                                        <span class="extra-small fw-bold text-dark d-block">Tap Remaining Digits</span>
                                                        <span class="extra-small text-muted" style="font-size: 0.68rem;">Ticket adds automatically on last digit!</span>
                                                    </div>
                                                </div>
                                            </div>

                                            <!-- PHYSICAL TICKET VISUAL EXAMPLE -->
                                            <div class="physical-ticket-demo mt-2 p-2 rounded-2 border d-flex align-items-center justify-content-center gap-2">
                                                <span class="extra-small text-muted fw-bold">Example Ticket:</span>
                                                <div class="demo-ticket-pill">
                                                    <span class="demo-prefix">@(ActiveRoll?.Prefix ?? "1987")</span>
                                                    <span class="demo-dash">-</span>
                                                    <span class="demo-variable">@string.Join("", Enumerable.Repeat("9", ActiveRoll?.DigitCount ?? 3))</span>
                                                </div>
                                                <span class="extra-small text-muted">← Type only the <strong class="text-primary fs-6">last @(ActiveRoll?.DigitCount ?? 3) numbers</strong></span>
                                            </div>
                                        }
                                    </div>

                                    <!-- PREFIX QUICK SELECTOR (If more than 1 prefix exists) -->
                                    @if (_settings.GetActiveRollConfigs().Count > 1)
                                    {
                                        <div class="mb-3">
                                            <div class="d-flex flex-wrap gap-2 justify-content-center">
                                                @foreach (var roll in _settings.GetActiveRollConfigs())
                                                {
                                                    var isSelected = ActiveRollId == roll.Id;
                                                    <button type="button" 
                                                            class="btn prefix-choice-pill flex-grow-1 @(isSelected ? "prefix-choice-active" : "prefix-choice-inactive")" 
                                                            @onclick="() => SelectRoll(roll)">
                                                        <div class="d-flex align-items-center justify-content-center gap-2">
                                                            <i class="bi @(isSelected ? "bi-check-circle-fill text-primary" : "bi-circle text-muted") prefix-choice-icon"></i>
                                                            <span class="prefix-choice-number">@roll.Prefix</span>
                                                        </div>
                                                    </button>
                                                }
                                            </div>
                                        </div>
                                    }

                                    <!-- TICKET NUMBERS HEADER -->
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="badge bg-light text-dark border px-2 py-1 rounded-pill fw-bold">
                                                @(ActiveRoll?.Label ?? "Ticket") (Prefix: @(ActiveRoll?.Prefix ?? "-"))
                                            </span>
                                            <span class="text-muted extra-small">Type <strong>@(ActiveRoll?.DigitCount ?? 3) digits</strong> on keypad below</span>
                                        </div>
                                        <span class="badge rounded-pill bg-primary bg-opacity-10 text-primary fw-bold px-3 py-1">
                                            @_enteredTickets.Count @(_enteredTickets.Count == 1 ? "Ticket" : "Tickets")
                                        </span>
                                    </div>

                                    <!-- DIGIT TILES ENTRY ROW (READONLY TO PREVENT OS KEYBOARD POPUP) -->
                                    <div class="sal-tile-entry-box mb-3">
                                        <div class="tile-row-wrapper">
                                            <!-- Prefix locked tiles -->
                                            @if (!string.IsNullOrEmpty(ActiveRoll?.Prefix))
                                            {
                                                <div class="prefix-tiles-group" title="Fixed Roll Prefix">
                                                    @foreach (var ch in ActiveRoll.Prefix)
                                                    {
                                                        <div class="digit-tile locked-tile">@ch</div>
                                                    }
                                                </div>
                                                <div class="tile-separator">-</div>
                                            }

                                            <!-- Variable Digit Input Display Tiles (NO OS KEYBOARD) -->
                                            <div class="active-tiles-group">
                                                @for (int i = 0; i < (ActiveRoll?.DigitCount ?? 3); i++)
                                                {
                                                    var idx = i;
                                                    var isCurrentActiveTile = _currentDigits.Length > idx && string.IsNullOrEmpty(_currentDigits[idx]) && (idx == 0 || !string.IsNullOrEmpty(_currentDigits[idx - 1]));
                                                    <div class="digit-tile editable-tile @(isCurrentActiveTile ? "active-entry-tile" : "")" 
                                                         id="@($"tile-input-{idx}")"
                                                         tabindex="-1">
                                                        @GetDigitAt(idx)
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    </div>

                                    <!-- ON-SCREEN TABLET KEYPAD -->
                                    <div class="tablet-keypad-container mb-3 animate-fade-in">
                                        <div class="keypad-grid">
                                            @for (int n = 1; n <= 9; n++)
                                            {
                                                var numStr = n.ToString();
                                                <button type="button" class="btn btn-keypad-digit" @onclick="() => OnKeypadPress(numStr)">
                                                    @numStr
                                                </button>
                                            }
                                            <button type="button" class="btn btn-keypad-action btn-keypad-clear" @onclick="OnKeypadClear">
                                                <i class="bi bi-trash"></i> Clear
                                            </button>
                                            <button type="button" class="btn btn-keypad-digit" @onclick='() => OnKeypadPress("0")'>
                                                0
                                            </button>
                                            <button type="button" class="btn btn-keypad-action btn-keypad-backspace" @onclick="OnKeypadBackspace">
                                                <i class="bi bi-backspace-fill"></i>
                                            </button>
                                        </div>
                                    </div>

                                    <!-- SAVE ALL ACTION BUTTON -->
                                    <div class="mt-4 pt-2">
                                        <button class="btn btn-sal-finish w-100 shadow-sm" @onclick="HandleFinishEntry" disabled="@_isSaving">
                                            @if (_isSaving)
                                            {
                                                <span class="spinner-border spinner-border-sm me-2"></span>
                                                <span>Saving Entry...</span>
                                            }
                                            else
                                            {
                                                <i class="bi bi-check2-circle me-2 fs-5"></i>
                                                <span>I Have Finished / Save My Entry</span>
                                            }
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
            else if (_activeTab == "roster")
            {
                <!-- SAVED RAFFLE TICKET ENTRIES VIEW -->
                <div class="roster-dashboard animate-entrance d-flex flex-column h-100">
                    <!-- SUMMARY METRIC STATS -->
                    <div class="row g-2 mb-2 flex-shrink-0">
                        <div class="col-12 col-md-4">
                            <div class="roster-stat-card shadow-sm">
                                <div class="stat-icon bg-primary bg-opacity-10 text-primary">
                                    <i class="bi bi-people-fill"></i>
                                </div>
                                <div>
                                    <span class="stat-label">Total Saved Entries</span>
                                    <h4 class="stat-value text-dark mb-0">@_participants.Count</h4>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-md-4">
                            <div class="roster-stat-card shadow-sm">
                                <div class="stat-icon bg-success bg-opacity-10 text-success">
                                    <i class="bi bi-ticket-perforated-fill"></i>
                                </div>
                                <div>
                                    <span class="stat-label">Total Tickets Sold</span>
                                    <h4 class="stat-value text-success mb-0">@_totalTicketsRegistered</h4>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-md-4">
                            <div class="roster-stat-card shadow-sm">
                                <div class="stat-icon bg-warning bg-opacity-10 text-warning">
                                    <i class="bi bi-trophy-fill"></i>
                                </div>
                                <div>
                                    <span class="stat-label">Average / Person</span>
                                    <h4 class="stat-value text-dark mb-0">
                                        @(_participants.Count > 0 ? (_totalTicketsRegistered / (double)_participants.Count).ToString("0.0") : "0")
                                    </h4>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- MAIN SAVED RAFFLE TICKET ENTRIES CARD -->
                    <div class="sal-card roster-card shadow-sm">
                        <div class="sal-card-header d-flex flex-wrap justify-content-between align-items-center gap-2 flex-shrink-0">
                            <div class="d-flex align-items-center gap-2">
                                <span class="sal-badge-icon bg-primary text-white"><i class="bi bi-collection-fill"></i></span>
                                <div>
                                    <h6 class="mb-0 fw-bold">Saved Raffle Ticket Entries</h6>
                                    <small class="text-muted">Live participant list & ticket allocations</small>
                                </div>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <button class="btn btn-sm btn-outline-secondary rounded-pill px-3" @onclick="LoadSettingsAndData" title="Refresh List">
                                    <i class="bi bi-arrow-clockwise me-1"></i> Refresh
                                </button>
                                <button class="btn btn-sm btn-primary rounded-pill px-3 fw-bold" @onclick="StartKioskRegistration">
                                    <i class="bi bi-person-plus-fill me-1"></i> Register Entry
                                </button>
                            </div>
                        </div>

                        <div class="roster-card-body p-3 d-flex flex-column">
                            <!-- SEARCH & FILTER BAR -->
                            <div class="search-box-wrapper mb-3 flex-shrink-0">
                                <span class="search-box-icon"><i class="bi bi-search"></i></span>
                                <input type="text" class="form-control-search" 
                                       placeholder="Search participant name, phone number or ticket #..." 
                                       @bind="_searchTerm" @bind:event="oninput" />
                                @if (!string.IsNullOrEmpty(_searchTerm))
                                {
                                    <button class="btn-clear-search" @onclick='() => _searchTerm = ""'>
                                        <i class="bi bi-x-circle-fill"></i>
                                    </button>
                                }
                            </div>

                            @if (FilteredParticipants.Count == 0)
                            {
                                <div class="text-center py-5 text-muted">
                                    <div class="empty-roster-illustration mb-3">
                                        <i class="bi bi-person-vcard display-3 text-muted opacity-25"></i>
                                    </div>
                                    <h5 class="fw-bold mb-1 text-dark">No Saved Entries Found</h5>
                                    <p class="text-muted small mb-3">
                                        @(string.IsNullOrEmpty(_searchTerm) ? "No ticket entries have been saved for this event yet." : "No saved entries match your search criteria.")
                                    </p>
                                    @if (string.IsNullOrEmpty(_searchTerm))
                                    {
                                        <button class="btn btn-primary rounded-pill px-4" @onclick="StartKioskRegistration">
                                            <i class="bi bi-plus-lg me-1"></i> Register First Entry
                                        </button>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="roster-grid">
                                    @foreach (var p in FilteredParticipants)
                                    {
                                        <div class="roster-attendee-card animate-scale-up py-2 px-3">
                                            <div class="d-flex justify-content-between align-items-center mb-2">
                                                <div class="d-flex align-items-center gap-2">
                                                    <div class="attendee-avatar sm-avatar">
                                                        @(string.IsNullOrWhiteSpace(p.FullName) ? "G" : p.FullName.Substring(0, 1).ToUpper())
                                                    </div>
                                                    <div>
                                                        <h6 class="fw-bold mb-0 text-dark attendee-name" style="font-size: 0.98rem;">@p.FullName</h6>
                                                        <div class="d-flex flex-wrap align-items-center gap-2 mt-0">
                                                            <span class="attendee-contact-pill py-0 px-2">
                                                                <i class="bi bi-telephone-fill text-muted me-1"></i> @FormatPhoneNumber(p.PhoneNumber)
                                                            </span>
                                                            @if (!string.IsNullOrEmpty(p.Email))
                                                            {
                                                                <span class="attendee-contact-pill py-0 px-2">
                                                                    <i class="bi bi-envelope-fill text-muted me-1"></i> @p.Email
                                                                </span>
                                                            }
                                                        </div>
                                                    </div>
                                                </div>
                                                
                                                <div class="d-flex align-items-center gap-2">
                                                    <span class="attendee-ticket-counter py-1 px-2">
                                                        <i class="bi bi-ticket-perforated-fill text-primary me-1"></i>
                                                        <strong>@p.Tickets.Count</strong> @(p.Tickets.Count == 1 ? "Ticket" : "Tickets")
                                                    </span>
                                                    <button class="btn btn-delete-attendee" @onclick="() => ConfirmDeleteParticipant(p)" title="Delete Participant">
                                                        <i class="bi bi-trash3-fill"></i>
                                                    </button>
                                                </div>
                                            </div>

                                            <div class="roster-tickets-container pt-1 mt-1">
                                                <div class="roster-tickets-pills-list">
                                                    @foreach (var tk in p.Tickets)
                                                    {
                                                        <span class="modern-ticket-badge d-inline-flex align-items-center gap-1">
                                                            <i class="bi bi-ticket-fill me-1 text-primary"></i>#@tk.TicketNumber
                                                            <button type="button" class="btn btn-xs-pill-action text-primary ms-1" @onclick="() => OpenEditTicketModal(p, tk)" title="Correct this ticket number">
                                                                <i class="bi bi-pencil-square"></i>
                                                            </button>
                                                        </span>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    </main>
</div>

<!-- ========================================================== -->
<!-- 1. CHECK FOR WINNER MODAL -->
<!-- ========================================================== -->
@if (_showWinnerModal)
{
    <div class="sal-modal-backdrop animate-fade-in" @onclick="CloseWinnerModal">
        <div class="sal-modal-dialog winner-modal-dialog animate-scale-up" @onclick:stopPropagation="true">
            <div class="sal-modal-header">
                <div class="d-flex align-items-center gap-2">
                    <span class="winner-trophy-badge"><i class="bi bi-trophy-fill"></i></span>
                    <div>
                        <h6 class="mb-0 fw-bold">Check Winning Ticket</h6>
                        <small class="text-muted">Enter drawn raffle number</small>
                    </div>
                </div>
                <button class="btn btn-close-modal" @onclick="CloseWinnerModal"><i class="bi bi-x-lg"></i></button>
            </div>

            <div class="sal-modal-body">
                <div class="row g-4 align-items-start">
                    <!-- INPUT / KEYPAD COLUMN -->
                    <div class="col-12 @(_hasSearchedWinner ? "col-lg-6" : "") text-center mx-auto" style="@(_hasSearchedWinner ? "" : "max-width: 440px;")">
                        <!-- PREFIX PICKER FOR WINNER LOOKUP (If more than 1 prefix) -->
                        @if (_settings.GetActiveRollConfigs().Count > 1)
                        {
                            <div class="mb-3">
                                <div class="d-flex flex-wrap justify-content-center gap-2">
                                    @foreach (var roll in _settings.GetActiveRollConfigs())
                                    {
                                        var isSelected = WinnerRollId == roll.Id;
                                        <button type="button" 
                                                class="btn prefix-choice-pill py-2 px-3 @(isSelected ? "prefix-choice-active" : "prefix-choice-inactive")"
                                                @onclick="() => SelectWinnerRoll(roll)">
                                            <div class="d-flex align-items-center justify-content-center gap-2">
                                                <i class="bi @(isSelected ? "bi-check-circle-fill text-primary" : "bi-circle text-muted") prefix-choice-icon"></i>
                                                <span class="prefix-choice-number">@roll.Prefix</span>
                                            </div>
                                        </button>
                                    }
                                </div>
                            </div>
                        }

                        <!-- WINNER LOOKUP DIGIT TILES (SINGLE HORIZONTAL ROW, NEVER WRAPPING) -->
                        <div class="mb-3 text-center">
                            <label class="form-label fw-bold mb-2">Enter Drawn Ticket Number</label>
                            
                            <div class="sal-tile-entry-box d-flex justify-content-center mb-3">
                                <div class="tile-row-wrapper justify-content-center" style="flex-wrap: nowrap !important;">
                                    @if (!string.IsNullOrEmpty(ActiveWinnerRoll?.Prefix))
                                    {
                                        <div class="prefix-tiles-group" title="Fixed Prefix">
                                            @foreach (var ch in ActiveWinnerRoll.Prefix)
                                            {
                                                <div class="digit-tile locked-tile">@ch</div>
                                            }
                                        </div>
                                        <div class="tile-separator">-</div>
                                    }

                                    <!-- Variable Tiles for Winner Lookup (NO OS KEYBOARD) -->
                                    <div class="active-tiles-group">
                                        @for (int i = 0; i < (ActiveWinnerRoll?.DigitCount ?? 3); i++)
                                        {
                                            var idx = i;
                                            var isWinnerCurrentActiveTile = _winnerDigits.Length > idx && string.IsNullOrEmpty(_winnerDigits[idx]) && (idx == 0 || !string.IsNullOrEmpty(_winnerDigits[idx - 1]));
                                            <div class="digit-tile editable-tile @(isWinnerCurrentActiveTile ? "active-entry-tile" : "")" 
                                                 id="@($"winner-tile-input-{idx}")"
                                                 tabindex="-1">
                                                @GetWinnerDigitAt(idx)
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>

                            <!-- ON-SCREEN TABLET TOUCH KEYPAD FOR WINNER LOOKUP -->
                            <div class="tablet-keypad-container mb-3 animate-fade-in" style="max-width: 320px;">
                                <div class="keypad-grid">
                                    @for (int n = 1; n <= 9; n++)
                                    {
                                        var numStr = n.ToString();
                                        <button type="button" class="btn btn-keypad-digit" @onclick="() => OnWinnerKeypadPress(numStr)">
                                            @numStr
                                        </button>
                                    }
                                    <button type="button" class="btn btn-keypad-action btn-keypad-clear" @onclick="ClearWinnerTiles">
                                        <i class="bi bi-trash"></i> Clear
                                    </button>
                                    <button type="button" class="btn btn-keypad-digit" @onclick='() => OnWinnerKeypadPress("0")'>
                                        0
                                    </button>
                                    <button type="button" class="btn btn-keypad-action btn-keypad-backspace" @onclick="OnWinnerKeypadBackspace">
                                        <i class="bi bi-backspace-fill"></i>
                                    </button>
                                </div>
                            </div>
                            
                            <div class="d-flex justify-content-center gap-2 mt-3">
                                <button type="button" class="btn btn-outline-secondary rounded-pill px-3 py-2 fw-semibold" @onclick="ClearWinnerTiles">
                                    <i class="bi bi-arrow-counterclockwise me-1"></i> Reset
                                </button>
                                <button type="button" class="btn btn-lg btn-primary rounded-pill px-4 py-2 fw-bold shadow flex-grow-1" style="font-size: 1.15rem;" @onclick="ExecuteWinnerSearch">
                                    <i class="bi bi-search me-2"></i> Check Ticket
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- WINNER RESULT COLUMN -->
                    @if (_hasSearchedWinner)
                    {
                        <div class="col-12 col-lg-6 my-auto">
                            @if (_winnerResult != null && _winnerResult.Found && _winnerResult.Participant != null)
                            {
                                <div class="winner-found-card animate-scale-up shadow-sm">
                                    <div class="confetti-icon-strip">🎉 🏆 ✨ 🏆 🎉</div>
                                    <h5 class="fw-black text-success mb-1">WINNER FOUND!</h5>
                                    <div class="winner-ticket-display mb-3">Ticket #@_winnerResult.TicketNumber</div>

                                    <!-- WINNER PARTICIPANT DETAILS (NO CALL BUTTONS) -->
                                    <div class="winner-details-box bg-white p-3 rounded-3 border text-start shadow-sm">
                                        <div class="d-flex align-items-center gap-2 mb-2 pb-2 border-bottom">
                                            <i class="bi bi-person-circle text-success fs-4"></i>
                                            <div>
                                                <h5 class="fw-bold mb-0 text-dark">@_winnerResult.Participant.FullName</h5>
                                                <small class="text-muted">Registered Participant</small>
                                            </div>
                                        </div>
                                        
                                        <div class="row g-2 pt-1">
                                            <div class="col-12">
                                                <div class="d-flex align-items-center gap-2 text-dark">
                                                    <i class="bi bi-telephone-fill text-muted"></i>
                                                    <span class="fw-bold">@_winnerResult.Participant.PhoneNumber</span>
                                                </div>
                                            </div>
                                            @if (!string.IsNullOrEmpty(_winnerResult.Participant.Email))
                                            {
                                                <div class="col-12">
                                                    <div class="d-flex align-items-center gap-2 text-dark">
                                                        <i class="bi bi-envelope-fill text-muted"></i>
                                                        <span>@_winnerResult.Participant.Email</span>
                                                    </div>
                                                </div>
                                            }
                                            <div class="col-12 mt-1">
                                                <div class="d-flex align-items-center gap-2 text-muted small">
                                                    <i class="bi bi-ticket-perforated-fill text-primary"></i>
                                                    <span>Holds <strong>@_winnerResult.TotalTicketsHeld</strong> total tickets</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="winner-not-found-card animate-fade-in shadow-sm">
                                    <i class="bi bi-emoji-frown display-5 text-muted opacity-50 mb-2"></i>
                                    <h6 class="fw-bold text-danger mb-1">No Matching Winner</h6>
                                    <p class="small text-muted mb-0">Ticket #@GetFullWinnerTicketSearchString() is not registered in the database.</p>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>

            <div class="sal-modal-footer">
                <button class="btn btn-secondary w-100 fw-bold" @onclick="CloseWinnerModal">Close</button>
            </div>
        </div>
    </div>
}

<!-- ========================================================== -->
<!-- 2. MODERN SAVED CONFIRMATION POPUP (AUTO-CLOSES) -->
<!-- ========================================================== -->
@if (_showThankYouModal)
{
    <div class="sal-modal-backdrop animate-fade-in" @onclick="RegisterNextPerson">
        <div class="sal-modal-dialog confirmation-dialog animate-bounce-in text-center p-4 shadow-lg" @onclick:stopPropagation="true">
            <div class="confirmation-celebrate-header text-center pb-2">
                <div class="sal-confetti-sparkles mb-2">🎉 ✨ 🎁 ✨ 🎉</div>
                <div class="success-check-badge animate-scale-up mx-auto mb-2">
                    <i class="bi bi-heart-fill text-danger" style="font-size: 3.2rem; filter: drop-shadow(0 4px 10px rgba(239, 68, 68, 0.35));"></i>
                </div>
                <h2 class="fw-bolder text-dark mb-1" style="font-family: 'Outfit', sans-serif;">Thank You!</h2>
                <div class="fs-5 fw-bold text-primary mb-2">For Supporting the Sal-ibration Raffle</div>
                <p class="text-muted mb-0 fs-6">
                    <strong>@_lastSavedParticipantName</strong>'s entry of <span class="badge bg-primary bg-opacity-10 text-primary px-3 py-1 fs-6 fw-bolder rounded-pill">@_lastSavedTicketCount @(_lastSavedTicketCount == 1 ? "Ticket" : "Tickets")</span> has been recorded!
                </p>
            </div>

            @if (!string.IsNullOrWhiteSpace(_settings.ThankYouMessage))
            {
                <div class="sal-premium-thankyou-card mt-3 mb-3 p-3 text-center animate-scale-up">
                    <div class="sal-thankyou-custom-text fw-bold">@_settings.ThankYouMessage</div>
                </div>
            }

            <div class="p-2 px-3 bg-light rounded-pill d-inline-flex align-items-center gap-2 text-muted small border mt-2">
                <span class="spinner-grow spinner-grow-sm text-success" role="status"></span>
                <span>Resetting for next person in a moment...</span>
            </div>

            <div class="mt-4">
                <button type="button" class="btn btn-hero-start btn-md w-100 rounded-pill py-3 fw-bold shadow-sm" @onclick="RegisterNextPerson">
                    <i class="bi bi-person-plus-fill me-2 fs-5"></i> Start Next Person Now
                </button>
            </div>
        </div>
    </div>
}

<!-- ========================================================== -->
<!-- 3. CONFIGURATION SETTINGS MODAL -->
<!-- ========================================================== -->
@if (_showSettingsModal)
{
    <div class="sal-modal-backdrop animate-fade-in" @onclick="CloseSettingsModal">
        <div class="sal-modal-dialog sal-settings-dialog animate-scale-up" @onclick:stopPropagation="true">
            <div class="sal-modal-header">
                <div class="d-flex align-items-center gap-2">
                    <span class="settings-gear-badge"><i class="bi bi-gear-fill"></i></span>
                    <div>
                        <h6 class="mb-0 fw-bold">Event & Ticket Settings</h6>
                        <small class="text-muted">Customize title, prefixes, timers & messages</small>
                    </div>
                </div>
                <button class="btn btn-close-modal" @onclick="CloseSettingsModal"><i class="bi bi-x-lg"></i></button>
            </div>

            <div class="sal-modal-body p-3 p-md-4">
                <div class="row g-3">
                    <!-- LEFT COLUMN: EVENT DETAILS & TICKET CONFIGURATION -->
                    <div class="col-12 col-md-6">
                        <div class="settings-card-section h-100 p-3 rounded-3 border bg-white shadow-2xs">
                            <div class="d-flex align-items-center gap-2 mb-3 pb-2 border-bottom">
                                <i class="bi bi-sliders text-primary fs-5"></i>
                                <span class="fw-bold text-dark">Ticket Configuration</span>
                            </div>

                            <!-- Page Title -->
                            <div class="mb-3">
                                <label class="setting-field-label">Page / Event Display Title</label>
                                <input type="text" class="setting-input-box" @bind="_tempSettings.PageTitle" placeholder="e.g. Sal-ibration" />
                                <small class="setting-field-hint">Custom title shown across all screens</small>
                            </div>

                            <!-- MULTI-TICKET CONFIGURATION SECTION -->
                            <div class="mb-3">
                                <div class="d-flex align-items-center justify-content-between mb-2">
                                    <div>
                                        <label class="setting-field-label mb-0 fs-6">Ticket Configurations</label>
                                        <small class="setting-field-hint">Configure ticket types with custom starting prefixes & digit counts</small>
                                    </div>
                                    <button type="button" class="btn btn-primary btn-sm rounded-pill px-3 py-1 fw-bold shadow-sm" @onclick="AddTempRollConfig">
                                        <i class="bi bi-plus-lg me-1"></i> Add Ticket Type
                                    </button>
                                </div>

                                <div class="rolls-config-list d-flex flex-column gap-3 mt-3">
                                    @for (int r = 0; r < _tempRollConfigs.Count; r++)
                                    {
                                        var rollIdx = r;
                                        var roll = _tempRollConfigs[rollIdx];
                                        <div class="roll-config-card p-3 rounded-3 border bg-light shadow-2xs">
                                            <div class="d-flex align-items-center justify-content-between mb-2 pb-2 border-bottom">
                                                <div class="d-flex align-items-center gap-2 flex-grow-1 me-2">
                                                    <span class="badge bg-secondary text-white rounded-pill px-2 py-1 fw-bold">
                                                        #@(rollIdx + 1)
                                                    </span>
                                                    <input type="text" 
                                                           class="form-control form-control-sm fw-bold border bg-white px-2 py-1 text-dark rounded-2 flex-grow-1" 
                                                           style="max-width: 240px;"
                                                           @bind="roll.Label" 
                                                           placeholder="Ticket Type Name (e.g. Regular, VIP)" />
                                                </div>
                                                <button type="button" class="btn btn-outline-danger btn-sm px-2 py-1 rounded-pill fw-semibold d-flex align-items-center gap-1" 
                                                        @onclick="() => RemoveTempRollConfig(rollIdx)" 
                                                        title="Delete this ticket prefix configuration">
                                                    <i class="bi bi-trash3-fill"></i>
                                                    <span class="d-none d-sm-inline extra-small">Delete</span>
                                                </button>
                                            </div>

                                            <div class="row g-3 align-items-center">
                                                <!-- Ticket Prefix Numbers -->
                                                <div class="col-12 col-xl-7">
                                                    <label class="extra-small text-dark fw-bold d-block mb-1">Ticket Prefix Numbers</label>
                                                    <div class="input-group">
                                                        <input type="text" class="setting-input-box py-2 no-spinner fw-bold fs-6" 
                                                               @bind="roll.Prefix" 
                                                               @onclick="() => ToggleRollPrefixKeypad(rollIdx)" 
                                                               placeholder="e.g. 1987" 
                                                               readonly />
                                                        <button class="btn @(_activeKeypadRollIndex == rollIdx ? "btn-primary" : "btn-outline-secondary") px-3 fw-bold" type="button" @onclick="() => ToggleRollPrefixKeypad(rollIdx)" title="Toggle On-Screen Keypad">
                                                            <i class="bi bi-grid-3x3-gap-fill me-1"></i>Keypad
                                                        </button>
                                                    </div>
                                                </div>

                                                <!-- Digits to type -->
                                                <div class="col-12 col-xl-5">
                                                    <label class="extra-small text-dark fw-bold d-block mb-1">Digits to Type</label>
                                                    <div class="d-flex align-items-center gap-2">
                                                        <button type="button" class="btn btn-stepper-round" @onclick="() => roll.DigitCount = Math.Max(1, roll.DigitCount - 1)" title="Decrease digits">-</button>
                                                        <input type="number" class="setting-input-box py-2 no-spinner text-center fw-bold fs-5" style="width: 60px; min-width: 50px;" min="1" max="8" @bind="roll.DigitCount" inputmode="numeric" />
                                                        <button type="button" class="btn btn-stepper-round" @onclick="() => roll.DigitCount = Math.Min(8, roll.DigitCount + 1)" title="Increase digits">+</button>
                                                        <span class="text-muted small fw-semibold">numbers</span>
                                                    </div>
                                                </div>
                                            </div>

                                            @if (_activeKeypadRollIndex == rollIdx)
                                            {
                                                <!-- TOUCH KEYPAD FOR THIS ROLL'S PREFIX -->
                                                <div class="p-2 mt-2 rounded-3 bg-white border animate-scale-up" style="max-width: 280px; margin: 8px auto 0 auto;">
                                                    <div class="d-flex justify-content-between align-items-center mb-1 px-1">
                                                        <span class="extra-small fw-bold text-primary"><i class="bi bi-keyboard-fill me-1"></i>Keypad for @roll.Label</span>
                                                        <button type="button" class="btn btn-link btn-xs p-0 text-muted" @onclick="() => _activeKeypadRollIndex = null">Close</button>
                                                    </div>
                                                    <div class="keypad-grid" style="grid-template-columns: repeat(3, 1fr); gap: 4px;">
                                                        @for (int n = 1; n <= 9; n++)
                                                        {
                                                            var numStr = n.ToString();
                                                            <button type="button" class="btn btn-sm btn-light border fw-bold py-1 fs-6" @onclick="() => AppendRollPrefixDigit(roll, numStr)">
                                                                @numStr
                                                            </button>
                                                        }
                                                        <button type="button" class="btn btn-sm btn-danger bg-opacity-10 text-danger border border-danger border-opacity-25 py-1 fw-bold" @onclick="() => roll.Prefix = string.Empty">
                                                            Clear
                                                        </button>
                                                        <button type="button" class="btn btn-sm btn-light border fw-bold py-1 fs-6" @onclick='() => AppendRollPrefixDigit(roll, "0")'>
                                                            0
                                                        </button>
                                                        <button type="button" class="btn btn-sm btn-outline-secondary py-1 fw-bold text-primary bg-white border" @onclick="() => BackspaceRollPrefix(roll)" title="Backspace">
                                                            <i class="bi bi-backspace-fill fs-6 text-primary"></i>
                                                        </button>
                                                    </div>
                                                </div>
                                            }

                                            <!-- Live Preview for This Roll -->
                                            <div class="d-flex align-items-center justify-content-between mt-2 pt-2 border-top extra-small text-muted">
                                                <span class="fw-semibold">Resulting Ticket Format:</span>
                                                <span class="demo-ticket-pill py-1 px-2">
                                                    <span class="demo-prefix">@(roll.Prefix ?? "")</span>
                                                    <span class="demo-dash">-</span>
                                                    <span class="demo-variable">@string.Join("", Enumerable.Repeat("#", Math.Max(1, roll.DigitCount)))</span>
                                                </span>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- RIGHT COLUMN: THANK YOU MESSAGE & RESET -->
                    <div class="col-12 col-md-6">
                        <div class="settings-card-section h-100 p-3 rounded-3 border bg-white shadow-2xs d-flex flex-column justify-content-between">
                            <div>
                                <div class="d-flex align-items-center gap-2 mb-3 pb-2 border-bottom">
                                    <i class="bi bi-chat-heart-fill text-danger fs-5"></i>
                                    <span class="fw-bold text-dark">Thank You Screen Settings</span>
                                </div>

                                <!-- Custom Thank You Message -->
                                <div class="mb-3">
                                    <label class="setting-field-label">Custom Thank You Message</label>
                                    <textarea class="setting-input-box" rows="4" @bind="_tempSettings.ThankYouMessage" placeholder="Custom appreciation message..."></textarea>
                                    <small class="setting-field-hint">Displayed to attendee after saving entry</small>
                                </div>

                                <!-- Thank You Duration with Quick Step Buttons -->
                                <div class="mb-3">
                                    <label class="setting-field-label">Message Duration (Seconds)</label>
                                    <div class="d-flex align-items-center gap-2">
                                        <button type="button" class="btn btn-stepper-round" @onclick='() => _tempSettings.ThankYouDisplaySeconds = Math.Max(2, _tempSettings.ThankYouDisplaySeconds - 1)' title="Decrease duration">-</button>
                                        <input type="number" class="setting-input-box py-2 no-spinner text-center fw-bold fs-5" style="width: 70px; min-width: 60px;" min="2" max="60" @bind="_tempSettings.ThankYouDisplaySeconds" inputmode="numeric" />
                                        <button type="button" class="btn btn-stepper-round" @onclick='() => _tempSettings.ThankYouDisplaySeconds = Math.Min(60, _tempSettings.ThankYouDisplaySeconds + 1)' title="Increase duration">+</button>
                                        <span class="text-muted small fw-semibold ms-1">seconds</span>
                                    </div>
                                    <small class="setting-field-hint">Time before auto-resetting to welcome screen</small>
                                </div>
                            </div>

                            <!-- DANGER ZONE -->
                            <div class="p-2 mt-2 rounded-3 border border-danger border-opacity-25 bg-danger bg-opacity-10">
                                <div class="d-flex align-items-center justify-content-between">
                                    <div class="d-flex align-items-center gap-1 text-danger small fw-bold">
                                        <i class="bi bi-exclamation-triangle-fill"></i>
                                        <span>Reset Event Data</span>
                                    </div>
                                    <button class="btn btn-danger btn-xs rounded-pill px-3 fw-bold" @onclick="ConfirmClearAllData" disabled="@_isClearingData">
                                        @if (_isClearingData)
                                        {
                                            <span>Clearing...</span>
                                        }
                                        else
                                        {
                                            <i class="bi bi-trash3-fill me-1"></i>
                                            <span>Wipe All Data</span>
                                        }
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="sal-modal-footer d-flex gap-2">
                <button class="btn btn-outline-secondary rounded-pill flex-grow-1" @onclick="CloseSettingsModal">Cancel</button>
                <button class="btn btn-primary rounded-pill flex-grow-1 fw-bold" @onclick="SaveSettings">Save Settings</button>
            </div>
        </div>
    </div>
}

<!-- ========================================================== -->
<!-- 4. EDIT / CORRECT SAVED TICKET NUMBER MODAL -->
<!-- ========================================================== -->
@if (_showEditTicketModal && _editingParticipant != null && _editingTicket != null)
{
    <div class="sal-modal-backdrop animate-fade-in" @onclick="CloseEditTicketModal">
        <div class="sal-modal-dialog animate-scale-up text-center p-3 p-md-4 shadow-lg" style="max-width: 440px;" @onclick:stopPropagation="true">
            <div class="sal-modal-header border-0 pb-1">
                <div class="d-flex align-items-center gap-2">
                    <span class="sal-badge-icon bg-primary text-white"><i class="bi bi-pencil-fill"></i></span>
                    <div class="text-start">
                        <h6 class="mb-0 fw-bold">Correct Ticket Number</h6>
                        <small class="text-muted">Participant: <strong>@_editingParticipant.FullName</strong></small>
                    </div>
                </div>
                <button class="btn btn-close-modal" @onclick="CloseEditTicketModal"><i class="bi bi-x-lg"></i></button>
            </div>

            <div class="sal-modal-body text-center pt-2">
                @if (!string.IsNullOrEmpty(_editTicketError))
                {
                    <div class="alert alert-danger py-2 px-3 mb-2 rounded-3 text-start small fw-bold animate-shake">
                        <i class="bi bi-exclamation-triangle-fill me-1"></i> @_editTicketError
                    </div>
                }

                <div class="mb-2">
                    <small class="text-muted d-block mb-1">Current Ticket Number:</small>
                    <span class="badge bg-secondary bg-opacity-10 text-secondary fs-6 px-3 py-1 rounded-pill">
                        #@_editingTicket.TicketNumber
                    </span>
                </div>

                <!-- TILE ENTRY FOR CORRECTION -->
                <!-- TILE ENTRY FOR CORRECTION (NO OS KEYBOARD) -->
                <div class="sal-tile-entry-box justify-content-center mb-3">
                    <div class="tile-row-wrapper justify-content-center">
                        @if (!string.IsNullOrEmpty(_editingPrefix))
                        {
                            <div class="prefix-tiles-group" title="Fixed Prefix">
                                @foreach (var ch in _editingPrefix)
                                {
                                    <div class="digit-tile locked-tile">@ch</div>
                                }
                            </div>
                            <div class="tile-separator">-</div>
                        }

                        <div class="active-tiles-group">
                            @for (int i = 0; i < _editDigits.Length; i++)
                            {
                                var idx = i;
                                var isEditActiveTile = _editDigits.Length > idx && string.IsNullOrEmpty(_editDigits[idx]) && (idx == 0 || !string.IsNullOrEmpty(_editDigits[idx - 1]));
                                <div class="digit-tile editable-tile @(isEditActiveTile ? "active-entry-tile" : "")" 
                                     id="@($"edit-tile-input-{idx}")"
                                     tabindex="-1">
                                    @GetEditDigitAt(idx)
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- ON-SCREEN KEYPAD FOR CORRECTION -->
                <div class="tablet-keypad-container mb-3 animate-fade-in" style="max-width: 300px;">
                    <div class="keypad-grid" style="grid-template-columns: repeat(3, 1fr); gap: 6px;">
                        @for (int n = 1; n <= 9; n++)
                        {
                            var numStr = n.ToString();
                            <button type="button" class="btn btn-keypad-digit" style="height: 46px; font-size: 1.25rem;" @onclick="() => OnEditKeypadPress(numStr)">
                                @numStr
                            </button>
                        }
                        <button type="button" class="btn btn-keypad-action btn-keypad-clear" style="height: 46px; font-size: 0.85rem;" @onclick="ClearEditTiles">
                            Clear
                        </button>
                        <button type="button" class="btn btn-keypad-digit" style="height: 46px; font-size: 1.25rem;" @onclick='() => OnEditKeypadPress("0")'>
                            0
                        </button>
                        <button type="button" class="btn btn-keypad-action btn-keypad-backspace" style="height: 46px;" @onclick="OnEditKeypadBackspace">
                            <i class="bi bi-backspace-fill"></i>
                        </button>
                    </div>
                </div>

                <div class="d-flex gap-2 justify-content-center">
                    <button type="button" class="btn btn-outline-danger btn-sm rounded-pill px-3" @onclick="ConfirmDeleteIndividualTicket" title="Remove this single ticket">
                        <i class="bi bi-trash3 me-1"></i> Delete Ticket
                    </button>
                    <button type="button" class="btn btn-primary rounded-pill px-4 fw-bold shadow-sm" @onclick="ConfirmSaveTicketCorrection">
                        <i class="bi bi-check2-circle me-1"></i> Save Correction
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<style>
    /* PAGE CONTAINER */
    .sal-page-container {
        min-height: 100vh;
        width: 100%;
        background: #f8fafc;
        display: flex;
        flex-direction: column;
        font-family: 'Inter', system-ui, -apple-system, sans-serif;
    }
    .sal-page-container-roster,
    .sal-page-container-entry-locked {
        height: 100vh !important;
        max-height: 100vh !important;
        overflow: hidden !important;
    }
    .sal-main-content {
        flex: 1;
        width: 100%;
        padding-bottom: 4rem;
    }
    .sal-main-content-roster {
        overflow: hidden !important;
        display: flex !important;
        flex-direction: column !important;
        padding-bottom: 0.5rem !important;
        height: calc(100vh - 65px) !important;
    }
    .sal-main-content-roster > .container-fluid {
        flex: 1;
        display: flex;
        flex-direction: column;
        overflow: hidden;
        height: 100%;
        padding-bottom: 0.5rem;
    }
    .sal-main-content-entry-locked {
        overflow: hidden !important;
        display: flex !important;
        flex-direction: column !important;
        padding-bottom: 0.5rem !important;
        height: 100vh !important;
        max-height: 100vh !important;
    }
