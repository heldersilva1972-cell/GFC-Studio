        flex: 1;
        display: flex;
        flex-direction: column;
        overflow: hidden;
        height: 100%;
        padding-bottom: 0.25rem;
    }
    .ticket-entry-row {
        flex: 1;
        min-height: 0;
        height: 100%;
        overflow: hidden;
    }
    @@media (min-width: 768px) {
        .ticket-entry-col {
            height: 100%;
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }
        .ticket-entry-card-left,
        .ticket-entry-card-right {
            height: 100% !important;
            max-height: 100% !important;
