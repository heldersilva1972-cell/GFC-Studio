    .btn-hero-start:hover {
        background: linear-gradient(135deg, #1d4ed8, #1e40af);
        transform: translateY(-2px);
        box-shadow: 0 12px 28px rgba(37, 99, 235, 0.45);
        color: #ffffff;
    }
    .btn-hero-start:active {
        transform: scale(0.96);
    }

    /* CONFIRMATION THANK YOU POPUP */
    .confirmation-dialog {
        border-radius: 28px;
        max-width: 480px;
    }
    .confirmation-celebrate-header {
        background: linear-gradient(180deg, rgba(239, 68, 68, 0.05) 0%, rgba(37, 99, 235, 0.03) 100%);
        border-radius: 20px;
        padding: 16px 12px;
    }
    .sal-confetti-sparkles {
        font-size: 1.4rem;
        letter-spacing: 6px;
    }
    .sal-premium-thankyou-card {
        background: linear-gradient(135deg, #eff6ff, #f8fafc);
