    private void InitializeWinnerTiles()
    {
        var count = _settings.VariableDigitCount > 0 ? _settings.VariableDigitCount : 3;
        _winnerDigits = new string[count];
        for (int i = 0; i < _winnerDigits.Length; i++) _winnerDigits[i] = "";
    }

    private string GetWinnerDigitAt(int index)
    {
        if (_winnerDigits != null && index >= 0 && index < _winnerDigits.Length)
        {
            return _winnerDigits[index] ?? "";
        }
        return "";
    }

    private async Task OnWinnerKeypadPress(string digit)
    {
        if (_winnerDigits == null || _winnerDigits.Length == 0) return;

        int targetIndex = -1;
        for (int i = 0; i < _winnerDigits.Length; i++)
        {
            if (string.IsNullOrEmpty(_winnerDigits[i]))
            {
                targetIndex = i;
                break;
            }
        }

        if (targetIndex == -1)
        {
            targetIndex = _winnerDigits.Length - 1;
        }

        _winnerDigits[targetIndex] = digit;

        if (targetIndex < _winnerDigits.Length - 1)
        {
            await JSRuntime.InvokeVoidAsync("eval", $"document.getElementById('winner-tile-input-{targetIndex + 1}')?.focus()");
        }
        else
        {
            if (_winnerDigits.All(d => !string.IsNullOrEmpty(d)))
            {
                await ExecuteWinnerSearch();
            }
        }
    }

    private async Task OnWinnerKeypadBackspace()
    {
        if (_winnerDigits == null || _winnerDigits.Length == 0) return;

        int targetIndex = -1;
        for (int i = _winnerDigits.Length - 1; i >= 0; i--)
        {
            if (!string.IsNullOrEmpty(_winnerDigits[i]))
            {
                targetIndex = i;
                break;
            }
        }

        if (targetIndex >= 0)
        {
            _winnerDigits[targetIndex] = "";
            await JSRuntime.InvokeVoidAsync("eval", $"document.getElementById('winner-tile-input-{targetIndex}')?.focus()");
        }
        else
        {
            await JSRuntime.InvokeVoidAsync("eval", "document.getElementById('winner-tile-input-0')?.focus()");
        }
    }

    private void ClearWinnerTiles()
    {
        InitializeWinnerTiles();
        _hasSearchedWinner = false;
        _winnerResult = null;

        _ = Task.Run(async () =>
        {
            await Task.Delay(50);
            await JSRuntime.InvokeVoidAsync("eval", "document.getElementById('winner-tile-input-0')?.focus()");
        });
    }

    private async Task OnWinnerDigitInput(int index, ChangeEventArgs e)
    {
        var val = e.Value?.ToString() ?? "";
        val = Regex.Replace(val, @"[^\d]", "");
        if (val.Length > 1)
        {
            val = val.Substring(val.Length - 1);
        }

        _winnerDigits[index] = val;

        if (!string.IsNullOrEmpty(val))
        {
            // Auto advance to next tile
            if (index < _settings.VariableDigitCount - 1)
            {
                await JSRuntime.InvokeVoidAsync("eval", $"document.getElementById('winner-tile-input-{index + 1}')?.focus()");
            }
            else
            {
                // Last tile filled: auto execute winner search
                if (_winnerDigits.All(d => !string.IsNullOrEmpty(d)))
                {
                    await ExecuteWinnerSearch();
                }
            }
        }
    }

    private async Task OnWinnerTileKeyDown(int index, KeyboardEventArgs e)
    {
        if (e.Key == "Backspace" && string.IsNullOrEmpty(_winnerDigits[index]) && index > 0)
        {
            await JSRuntime.InvokeVoidAsync("eval", $"document.getElementById('winner-tile-input-{index - 1}')?.focus()");
        }
        else if (e.Key == "Enter")
        {
            await ExecuteWinnerSearch();
        }
    }

    private string GetFullWinnerTicketSearchString()
    {
        var variablePart = string.Join("", _winnerDigits ?? Array.Empty<string>());
        return (_settings.TicketPrefix ?? "") + variablePart;
    }

    private void CloseWinnerModal()
    {
        _showWinnerModal = false;
    }

    private async Task ExecuteWinnerSearch()
    {
        var fullTicket = GetFullWinnerTicketSearchString();
        if (string.IsNullOrWhiteSpace(fullTicket)) return;
        _hasSearchedWinner = true;
        _winnerResult = await SalibrationService.LookupWinnerByTicketAsync(fullTicket.Trim());
    }

