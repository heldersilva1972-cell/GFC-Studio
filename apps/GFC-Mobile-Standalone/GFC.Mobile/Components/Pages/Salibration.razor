    private void TryAddCurrentTileTicket()
    {
        if (_currentDigits.Any(string.IsNullOrWhiteSpace))
        {
            _ticketInputError = "Please complete all digit boxes.";
            return;
        }

        var variablePart = string.Join("", _currentDigits);
        var rollPrefix = ActiveRoll?.Prefix ?? _settings.TicketPrefix ?? "";
        var fullTicketNumber = rollPrefix + variablePart;

        // Check 1: Already added in the current registration session
        if (_enteredTickets.Contains(fullTicketNumber, StringComparer.OrdinalIgnoreCase))
        {
            _ticketInputError = $"Ticket #{fullTicketNumber} is already added in this list.";
            InitializeDigitTiles();
            return;
        }

        // Check 2: Already registered to an existing participant in this event
        var isAlreadyRegistered = _participants.Any(p => 
            p.Tickets != null && p.Tickets.Any(t => string.Equals(t.TicketNumber, fullTicketNumber, StringComparison.OrdinalIgnoreCase)));

        if (isAlreadyRegistered)
        {
            _ticketInputError = $"Ticket #{fullTicketNumber} has already been registered. Duplicate tickets are not allowed.";
            InitializeDigitTiles();
            return;
        }

        _enteredTickets.Add(fullTicketNumber);
        _ticketInputError = null;

        // Reset tiles for the next ticket on this roll
        InitializeDigitTiles();
    }

    private void EditTicket(string ticket)
    {
