                _isClearingData = false;
            }
        }
    }

    private async Task ConfirmDeleteParticipant(SalibrationParticipant p)
    {
        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", $"Are you sure you want to remove {p.FullName} and their {p.Tickets.Count} tickets?");
        if (confirmed)
        {
            await SalibrationService.DeleteParticipantAsync(p.Id);
            _participants = await SalibrationService.GetAllParticipantsAsync();
            _totalTicketsRegistered = _participants.Sum(x => x.Tickets?.Count ?? 0);
