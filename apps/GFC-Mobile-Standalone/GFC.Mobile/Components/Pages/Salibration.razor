        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.15rem;
    }
    .settings-gear-badge {
        background: rgba(100, 116, 139, 0.15);
        color: #475569;
    }
    .btn-close-modal {
        background: transparent;
        border: none;
        color: #94a3b8;
        font-size: 1.1rem;
    }

    /* WINNER FOUND CARD */
    .winner-found-card {
        background: linear-gradient(135deg, #ecfdf5, #d1fae5);
        border: 2px solid #34d399;
        border-radius: 16px;
        padding: 18px;
        text-align: center;
    }
    .winner-ticket-display {
        font-size: 1.3rem;
        font-weight: 900;
        color: #065f46;
        letter-spacing: 0.5px;
    }
    .confetti-icon-strip {
        font-size: 1.25rem;
        letter-spacing: 4px;
        margin-bottom: 4px;
    }
    .winner-not-found-card {
        background: #fef2f2;
        border: 1px solid #fecaca;
        border-radius: 14px;
        padding: 20px;
        text-align: center;
