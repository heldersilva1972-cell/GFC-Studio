    .roster-dashboard {
        width: 100%;
        flex: 1;
        display: flex;
        flex-direction: column;
        overflow: hidden;
        height: 100%;
    }
    .roster-card {
        flex: 1;
        display: flex;
        flex-direction: column;
        overflow: hidden;
