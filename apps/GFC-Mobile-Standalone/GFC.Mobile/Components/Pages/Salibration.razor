        _enteredTickets.Remove(ticket);
        _ticketInputError = null;

        _ = Task.Run(async () =>
        {
            await Task.Delay(50);
            await JSRuntime.InvokeVoidAsync("eval", "document.getElementById('tile-input-0')?.focus()");
        });
    }

    private void RemoveTicket(string ticket)
    {
        _enteredTickets.Remove(ticket);
    }

    private async Task HandleFinishEntry()
    {
        _nameError = string.IsNullOrWhiteSpace(_fullName);

        // Phone Validation (Must be area code + 7 digits = 10 digits)
        var phoneDigitsOnly = Regex.Replace(_phoneNumber ?? "", @"[^\d]", "");
        if (string.IsNullOrWhiteSpace(_phoneNumber))
        {
            _phoneError = true;
            _phoneErrorMessage = "Phone number with area code is required (10 digits total).";
        }
        else if (phoneDigitsOnly.Length < 10)
        {
            _phoneError = true;
            _phoneErrorMessage = $"Phone number has only {phoneDigitsOnly.Length} digits. Please include 3-digit area code and 7-digit number (10 digits total).";
        }
        else if (phoneDigitsOnly.Length > 10)
        {
            _phoneError = true;
            _phoneErrorMessage = $"Phone number has {phoneDigitsOnly.Length} digits. Please enter a 10-digit number (area code + number).";
        }
        else
        {
            _phoneError = false;
            _phoneErrorMessage = null;
        }

        // Email Validation (Optional, but if entered, must be valid email format)
        if (!string.IsNullOrWhiteSpace(_email))
        {
            var emailPattern = @"^[^@\s]+@[^@\s]+\.[^@\s]+$";
            if (!Regex.IsMatch(_email.Trim(), emailPattern, RegexOptions.IgnoreCase))
            {
                _emailError = true;
                _emailErrorMessage = "Please enter a valid email address (e.g. john@example.com).";
            }
            else
            {
                _emailError = false;
                _emailErrorMessage = null;
            }
        }
        else
        {
            _emailError = false;
            _emailErrorMessage = null;
        }

        if (_nameError || _phoneError || _emailError)
        {
            StateHasChanged();
            return;
        }

        // If user left partially filled or filled digits, try adding them
        if (_currentDigits.All(d => !string.IsNullOrEmpty(d)))
        {
            TryAddCurrentTileTicket();
        }

        if (_enteredTickets.Count == 0)
        {
            _ticketInputError = "Please enter at least one ticket number before saving.";
            StateHasChanged();
            return;
        }

        _isSaving = true;
        StateHasChanged();

        try
        {
            var currentAppUser = AuthStateProvider.GetCurrentUser();
            var participant = new SalibrationParticipant
            {
                FullName = _fullName.Trim(),
                PhoneNumber = _phoneNumber.Trim(),
                Email = string.IsNullOrWhiteSpace(_email) ? null : _email.Trim(),
                CreatedBy = currentAppUser?.Username ?? "Mobile User"
            };

            var ticketSnapshot = _enteredTickets.ToList();

            await SalibrationService.SaveParticipantWithTicketsAsync(participant, ticketSnapshot);

            // Set up Saved Details
            _lastSavedParticipantName = participant.FullName;
            _lastSavedPhone = participant.PhoneNumber;
            _lastSavedTicketCount = ticketSnapshot.Count;

            // Immediately clear the entered tickets list and input state for the next person
            _fullName = "";
            _phoneNumber = "";
            _email = "";
            _enteredTickets.Clear();
            InitializeDigitTiles();
            _nameError = false;
            _phoneError = false;
            _phoneErrorMessage = null;
            _emailError = false;
            _emailErrorMessage = null;
            _ticketInputError = null;

            // Refresh roster in background
            _participants = await SalibrationService.GetAllParticipantsAsync();
            _totalTicketsRegistered = _participants.Sum(p => p.Tickets?.Count ?? 0);

            // Show saved confirmation popup and automatically reset for next person after configured seconds
            _showThankYouModal = true;
            StateHasChanged();

            var displayDelayMs = Math.Max(2, _settings.ThankYouDisplaySeconds > 0 ? _settings.ThankYouDisplaySeconds : 5) * 1000;

            _ = Task.Run(async () =>
            {
                await Task.Delay(displayDelayMs);
                if (_showThankYouModal)
                {
                    await InvokeAsync(RegisterNextPerson);
                }
            });
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Salibration] Save Error: {ex.Message}");
            _ticketInputError = "Error saving entry: " + ex.Message;
        }
        finally
        {
            _isSaving = false;
            StateHasChanged();
        }
    }

    private void RegisterNextPerson()
    {
        _showThankYouModal = false;
        _fullName = "";
        _phoneNumber = "";
        _email = "";
        _enteredTickets.Clear();
        InitializeDigitTiles();
        _nameError = false;
        _phoneError = false;
        _phoneErrorMessage = null;
        _emailError = false;
        _emailErrorMessage = null;
        _ticketInputError = null;
        _entryStep = EntryStep.Welcome;
        _activeTab = "entry";
