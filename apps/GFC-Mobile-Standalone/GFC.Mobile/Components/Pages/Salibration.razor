    // EDIT / CORRECT SAVED TICKET MODAL LOGIC
    private bool _showEditTicketModal = false;
    private SalibrationParticipant? _editingParticipant;
    private SalibrationTicket? _editingTicket;
    private string[] _editDigits = Array.Empty<string>();
    private string? _editTicketError;

    private void OpenEditTicketModal(SalibrationParticipant p, SalibrationTicket tk)
    {
        _editingParticipant = p;
        _editingTicket = tk;
        _editTicketError = null;

        var matchedRoll = GetRollForTicket(tk.TicketNumber ?? "");
        _editingPrefix = matchedRoll?.Prefix ?? _settings.TicketPrefix ?? "";
        var count = matchedRoll?.DigitCount > 0 ? matchedRoll.DigitCount : (_settings.VariableDigitCount > 0 ? _settings.VariableDigitCount : 3);
        _editDigits = new string[count];
        for (int i = 0; i < _editDigits.Length; i++) _editDigits[i] = "";

        // Populate variable portion of current ticket number
        string variablePortion = tk.TicketNumber ?? "";
        if (!string.IsNullOrEmpty(_editingPrefix) && variablePortion.StartsWith(_editingPrefix, StringComparison.OrdinalIgnoreCase))
        {
            variablePortion = variablePortion.Substring(_editingPrefix.Length);
        }

        for (int i = 0; i < _editDigits.Length && i < variablePortion.Length; i++)
        {
            _editDigits[i] = variablePortion[i].ToString();
        }

        _showEditTicketModal = true;
    }

    private void CloseEditTicketModal()
    {
        _showEditTicketModal = false;
        _editingParticipant = null;
        _editingTicket = null;
        _editTicketError = null;
    }

    private string GetEditDigitAt(int index)
    {
        if (_editDigits != null && index >= 0 && index < _editDigits.Length)
        {
            return _editDigits[index] ?? "";
        }
        return "";
    }

    private void OnEditKeypadPress(string digit)
    {
        _editTicketError = null;
        for (int i = 0; i < _editDigits.Length; i++)
        {
            if (string.IsNullOrEmpty(_editDigits[i]))
            {
                _editDigits[i] = digit;
                break;
            }
        }
    }

    private void ClearEditTiles()
    {
        for (int i = 0; i < _editDigits.Length; i++) _editDigits[i] = "";
        _editTicketError = null;
    }

    private void OnEditKeypadBackspace()
    {
        _editTicketError = null;
        for (int i = _editDigits.Length - 1; i >= 0; i--)
        {
            if (!string.IsNullOrEmpty(_editDigits[i]))
            {
                _editDigits[i] = "";
                break;
            }
        }
    }

    private async Task ConfirmSaveTicketCorrection()
    {
        if (_editingParticipant == null || _editingTicket == null) return;

        if (_editDigits.Any(string.IsNullOrWhiteSpace))
        {
            _editTicketError = "Please complete all digit boxes.";
            return;
        }

        var variablePart = string.Join("", _editDigits);
        var newTicketNumber = (_editingPrefix ?? "") + variablePart;

        // Check if duplicate across entire registry (excluding this exact ticket being edited)
        var isDuplicate = _participants.Any(p => 
            p.Tickets != null && p.Tickets.Any(t => t.Id != _editingTicket.Id && string.Equals(t.TicketNumber, newTicketNumber, StringComparison.OrdinalIgnoreCase)));

        if (isDuplicate)
        {
            _editTicketError = $"Ticket #{newTicketNumber} is already registered. Duplicate tickets are not allowed.";
            return;
        }

        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", 
            $"Are you sure you want to change ticket #{_editingTicket.TicketNumber} to #{newTicketNumber} for {_editingParticipant.FullName}?");

        if (confirmed)
        {
            // Update ticket list for this participant
            var updatedTickets = _editingParticipant.Tickets.Select(t => t.TicketNumber == _editingTicket.TicketNumber ? newTicketNumber : t.TicketNumber).ToList();
            await SalibrationService.SaveParticipantWithTicketsAsync(_editingParticipant, updatedTickets);
            _participants = await SalibrationService.GetAllParticipantsAsync();
            _totalTicketsRegistered = _participants.Sum(x => x.Tickets?.Count ?? 0);
            CloseEditTicketModal();
        }
    }

    private async Task ConfirmDeleteIndividualTicket()
    {
        if (_editingParticipant == null || _editingTicket == null) return;

        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", 
            $"Are you sure you want to delete ticket #{_editingTicket.TicketNumber} from {_editingParticipant.FullName}?");

        if (confirmed)
        {
            var remainingTickets = _editingParticipant.Tickets.Where(t => t.TicketNumber != _editingTicket.TicketNumber).Select(t => t.TicketNumber).ToList();
            if (remainingTickets.Count == 0)
            {
                // Delete whole participant if no tickets left
                await SalibrationService.DeleteParticipantAsync(_editingParticipant.Id);
            }
            else
            {
                await SalibrationService.SaveParticipantWithTicketsAsync(_editingParticipant, remainingTickets);
            }

            _participants = await SalibrationService.GetAllParticipantsAsync();
            _totalTicketsRegistered = _participants.Sum(x => x.Tickets?.Count ?? 0);
            CloseEditTicketModal();
        }
    }

    private List<SalibrationParticipant> FilteredParticipants
    {
        get
        {
            if (string.IsNullOrWhiteSpace(_searchTerm)) return _participants;
            var term = _searchTerm.Trim().ToLowerInvariant();
            return _participants.Where(p =>
                (p.FullName ?? "").ToLowerInvariant().Contains(term) ||
                (p.PhoneNumber ?? "").Contains(term) ||
                (p.Email ?? "").ToLowerInvariant().Contains(term) ||
                (p.Tickets != null && p.Tickets.Any(t => (t.TicketNumber ?? "").ToLowerInvariant().Contains(term)))
            ).ToList();
        }
    }
