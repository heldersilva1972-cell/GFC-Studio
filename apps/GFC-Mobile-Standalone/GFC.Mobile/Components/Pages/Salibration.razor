        border: 1px solid #e2e8f0;
    }
    .tile-row-wrapper {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        flex-wrap: wrap;
    }
    .prefix-tiles-group, .active-tiles-group {
        display: flex;
