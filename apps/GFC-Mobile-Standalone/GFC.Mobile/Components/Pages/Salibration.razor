    private void OpenSettingsModal()
    {
        _showPrefixKeypad = false;
        _activeKeypadRollIndex = null;

        var activeRolls = _settings.GetActiveRollConfigs();
        _tempRollConfigs = activeRolls.Select(r => new SalibrationRollConfig
        {
            Id = r.Id,
            Label = r.Label,
            Prefix = r.Prefix,
            DigitCount = r.DigitCount,
            ColorBadge = r.ColorBadge
        }).ToList();

        if (_tempRollConfigs.Count == 0)
        {
            _tempRollConfigs.Add(new SalibrationRollConfig
            {
                Id = "roll_1",
                Label = "Main Roll",
                Prefix = _settings.TicketPrefix ?? "",
                DigitCount = _settings.VariableDigitCount > 0 ? _settings.VariableDigitCount : 3,
                ColorBadge = "primary"
            });
        }

        _tempSettings = new SalibrationSettings
        {
            PageTitle = _settings.PageTitle,
            TicketPrefix = _settings.TicketPrefix,
            VariableDigitCount = _settings.VariableDigitCount,
            ThankYouMessage = _settings.ThankYouMessage,
            ThankYouDisplaySeconds = _settings.ThankYouDisplaySeconds > 0 ? _settings.ThankYouDisplaySeconds : 5,
            RollConfigs = _tempRollConfigs
        };
        _showSettingsModal = true;
    }

    private void CloseSettingsModal()
    {
        _showPrefixKeypad = false;
        _activeKeypadRollIndex = null;
        _showSettingsModal = false;
    }

    private async Task SaveSettings()
    {
        var firstRoll = _tempRollConfigs.FirstOrDefault();
        var primaryPrefix = firstRoll?.Prefix ?? (_tempSettings.TicketPrefix ?? "").Trim();
        var primaryDigitCount = firstRoll?.DigitCount ?? (_tempSettings.VariableDigitCount > 0 ? _tempSettings.VariableDigitCount : 3);

        _settings = new SalibrationSettings
        {
            PageTitle = string.IsNullOrWhiteSpace(_tempSettings.PageTitle) ? "Sal-ibration" : _tempSettings.PageTitle.Trim(),
            TicketPrefix = primaryPrefix,
            VariableDigitCount = primaryDigitCount,
            ThankYouMessage = string.IsNullOrWhiteSpace(_tempSettings.ThankYouMessage) ? "Thank you for supporting our fundraiser!" : _tempSettings.ThankYouMessage.Trim(),
            ThankYouDisplaySeconds = _tempSettings.ThankYouDisplaySeconds > 0 ? _tempSettings.ThankYouDisplaySeconds : 5,
            RollConfigs = _tempRollConfigs.ToList()
        };

        await SalibrationService.SaveSettingsAsync(_settings);
        InitializeDigitTiles();
        _showSettingsModal = false;
    }

    private bool _isClearingData = false;

    private async Task ConfirmClearAllData()
    {
        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", "WARNING: This will permanently delete all participants and all raffle tickets recorded for this event. Are you sure you want to start from scratch?");
        if (confirmed)
        {
            _isClearingData = true;
            try
            {
                await SalibrationService.ClearAllDataAsync();
                _participants = await SalibrationService.GetAllParticipantsAsync();
                _totalTicketsRegistered = 0;
                _enteredTickets.Clear();
                InitializeDigitTiles();
                _showSettingsModal = false;
                _activeTab = "entry";
            }
            finally
