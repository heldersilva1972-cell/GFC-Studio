    {
        _ticketInputError = null;
        // Find the first empty digit tile
        int emptyIdx = -1;
        for (int i = 0; i < _currentDigits.Length; i++)
        {
            if (string.IsNullOrEmpty(_currentDigits[i]))
            {
                emptyIdx = i;
                break;
            }
        }

        if (emptyIdx != -1)
        {
            _currentDigits[emptyIdx] = digit;
            // All tiles filled
            if (_currentDigits.All(d => !string.IsNullOrEmpty(d)))
            {
                TryAddCurrentTileTicket();
            }
        }
    }

