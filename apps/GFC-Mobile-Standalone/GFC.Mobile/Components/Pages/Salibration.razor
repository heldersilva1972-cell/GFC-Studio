            _ticketInputError = "Please enter at least one ticket number before saving.";
            StateHasChanged();
            return;
        }

        _isSaving = true;
        StateHasChanged();

        try
        {
            var currentAppUser = AuthStateProvider.GetCurrentUser();
            var participant = new SalibrationParticipant
            {
                FullName = _fullName.Trim(),
                PhoneNumber = _phoneNumber.Trim(),
                Email = string.IsNullOrWhiteSpace(_email) ? null : _email.Trim(),
                CreatedBy = currentAppUser?.Username ?? "Mobile User"
            };

            var ticketSnapshot = _enteredTickets.ToList();

            await SalibrationService.SaveParticipantWithTicketsAsync(participant, ticketSnapshot);

            // Set up Saved Details
            _lastSavedParticipantName = participant.FullName;
            _lastSavedPhone = participant.PhoneNumber;
            _lastSavedTicketCount = ticketSnapshot.Count;

            // Immediately clear the entered tickets list and input state for the next person
            _fullName = "";
            _phoneNumber = "";
            _email = "";
            _enteredTickets.Clear();
            InitializeDigitTiles();
            _nameError = false;
            _phoneError = false;
            _phoneErrorMessage = null;
            _emailError = false;
            _emailErrorMessage = null;
            _ticketInputError = null;

            // Refresh roster in background
            _participants = await SalibrationService.GetAllParticipantsAsync();
            _totalTicketsRegistered = _participants.Sum(p => p.Tickets?.Count ?? 0);

            // Show saved confirmation popup and automatically reset for next person after configured seconds
            _showThankYouModal = true;
            StateHasChanged();

            var displayDelayMs = Math.Max(2, _settings.ThankYouDisplaySeconds > 0 ? _settings.ThankYouDisplaySeconds : 5) * 1000;

            _ = Task.Run(async () =>
            {
                await Task.Delay(displayDelayMs);
                if (_showThankYouModal)
                {
                    await InvokeAsync(RegisterNextPerson);
                }
            });
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Salibration] Save Error: {ex.Message}");
            _ticketInputError = "Error saving entry: " + ex.Message;
        }
        finally
        {
            _isSaving = false;
            StateHasChanged();
        }
    }

    private void RegisterNextPerson()
    {
        _showThankYouModal = false;
        _fullName = "";
        _phoneNumber = "";
        _email = "";
        _enteredTickets.Clear();
        InitializeDigitTiles();
        _nameError = false;
        _phoneError = false;
        _phoneErrorMessage = null;
        _emailError = false;
        _emailErrorMessage = null;
        _ticketInputError = null;
        _entryStep = EntryStep.Welcome;
        _activeTab = "entry";
        StateHasChanged();
    }

    private void CloseThankYouModal()
    {
        _showThankYouModal = false;
        _activeTab = "roster";
    }

    // WINNER MODAL ACTIONS
    private void OpenWinnerModal()
    {
        _showWinnerModal = true;
        _hasSearchedWinner = false;
        _winnerResult = null;
        var activeRolls = _settings.GetActiveRollConfigs();
        _winnerRollId = activeRolls.FirstOrDefault()?.Id ?? "roll_1";
        InitializeWinnerTiles();
    }

    private void InitializeWinnerTiles()
    {
        var roll = ActiveWinnerRoll;
        var count = roll?.DigitCount > 0 ? roll.DigitCount : (_settings.VariableDigitCount > 0 ? _settings.VariableDigitCount : 3);
        _winnerDigits = new string[count];
        for (int i = 0; i < _winnerDigits.Length; i++) _winnerDigits[i] = "";
    }

    private string GetWinnerDigitAt(int index)
    {
        if (_winnerDigits != null && index >= 0 && index < _winnerDigits.Length)
        {
            return _winnerDigits[index] ?? "";
        }
        return "";
    }

    private async Task OnWinnerKeypadPress(string digit)
    {
        if (_winnerDigits == null || _winnerDigits.Length == 0) return;

        int targetIndex = -1;
        for (int i = 0; i < _winnerDigits.Length; i++)
        {
            if (string.IsNullOrEmpty(_winnerDigits[i]))
            {
                targetIndex = i;
                break;
            }
        }

        if (targetIndex == -1)
        {
            targetIndex = _winnerDigits.Length - 1;
        }

        _winnerDigits[targetIndex] = digit;

        if (_winnerDigits.All(d => !string.IsNullOrEmpty(d)))
        {
            await ExecuteWinnerSearch();
        }
    }

    private void OnWinnerKeypadBackspace()
    {
        if (_winnerDigits == null || _winnerDigits.Length == 0) return;

        for (int i = _winnerDigits.Length - 1; i >= 0; i--)
        {
            if (!string.IsNullOrEmpty(_winnerDigits[i]))
            {
                _winnerDigits[i] = "";
                break;
            }
        }
    }

    private void ClearWinnerTiles()
    {
        InitializeWinnerTiles();
        _hasSearchedWinner = false;
        _winnerResult = null;
    }

    private string GetFullWinnerTicketSearchString()
    {
        var variablePart = string.Join("", _winnerDigits ?? Array.Empty<string>());
        var rollPrefix = ActiveWinnerRoll?.Prefix ?? _settings.TicketPrefix ?? "";
        return rollPrefix + variablePart;
    }

    private void CloseWinnerModal()
    {
        _showWinnerModal = false;
    }

    private async Task ExecuteWinnerSearch()
    {
        var fullTicket = GetFullWinnerTicketSearchString();
        if (string.IsNullOrWhiteSpace(fullTicket)) return;
        _hasSearchedWinner = true;
        _winnerResult = await SalibrationService.LookupWinnerByTicketAsync(fullTicket.Trim());
    }

