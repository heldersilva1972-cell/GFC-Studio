@inject IJSRuntime JSRuntime
@implements IDisposable

@code {
    [Parameter] public EventCallback OnIdle { get; set; }
    
    private DotNetObjectReference<IdleHandler>? _objRef;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _objRef = DotNetObjectReference.Create(this);
            // 15 minutes = 900,000 milliseconds
            await JSRuntime.InvokeVoidAsync("idleTimer.initialize", _objRef, 900000);
        }
    }

    [JSInvokable]
    public async Task OnIdleTimeout()
    {
        await OnIdle.InvokeAsync();
    }

    public void Dispose()
    {
        _objRef?.Dispose();
    }
}
