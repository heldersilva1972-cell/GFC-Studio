<div class="premium-keypad shadow-2xl">
    <div class="keypad-header mb-3">
        <div class="d-flex align-items-center gap-2">
            <div class="header-dot pulse"></div>
            <span class="fw-black text-muted extra-small text-uppercase" style="letter-spacing: 0.1em;">Input Panel</span>
        </div>
        <button class="btn-key-close" @onclick="OnClose">
            <i class="bi bi-x-lg"></i>
        </button>
    </div>
    
    <div class="keypad-grid">
        @foreach (var key in new[] { "7", "8", "9", "4", "5", "6", "1", "2", "3" })
        {
            <button class="key-btn" @onclick='() => OnKeyPress(key)' disabled="@Disabled">@key</button>
        }
        <button class="key-btn action-red" @onclick="OnBackspace" disabled="@Disabled">
            <i class="bi bi-backspace-fill"></i>
        </button>
        <button class="key-btn" @onclick='() => OnKeyPress("0")' disabled="@Disabled">0</button>
        <button class="key-btn" @onclick='() => OnKeyPress(".")' disabled="@Disabled">.</button>
    </div>

    <div class="keypad-footer mt-4">
        @if (PulseSubmit)
        {
            <button class="btn btn-premium-submit w-100 pulse-active mb-3" @onclick="OnSubmit" disabled="@(Disabled || SubmitDisabled)">
                FINALIZE & SUBMIT <i class="bi bi-send-fill ms-2"></i>
            </button>
        }
        <div class="row g-2">
            <div class="col-6">
                <button class="btn btn-premium-next w-100" @onclick="OnNext" disabled="@Disabled">
                    NEXT <i class="bi bi-chevron-right ms-2"></i>
                </button>
            </div>
            <div class="col-6">
                <button class="btn btn-premium-done w-100" @onclick="OnClose" disabled="@Disabled">
                    DONE <i class="bi bi-check-lg ms-2"></i>
                </button>
            </div>
        </div>
    </div>
</div>

<style>
    .premium-keypad {
        background: rgba(255, 255, 255, 0.9);
        backdrop-filter: blur(20px);
        border: 1px solid rgba(255, 255, 255, 0.3);
        border-radius: 32px;
        padding: 24px;
        width: 320px;
        user-select: none;
    }

    .keypad-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .header-dot {
        width: 8px;
        height: 8px;
        background: #3b82f6;
        border-radius: 50%;
    }

    .header-dot.pulse {
        animation: dot-pulse 2s infinite;
    }

    @@keyframes dot-pulse {
        0% { box-shadow: 0 0 0 0 rgba(59, 130, 246, 0.4); }
        70% { box-shadow: 0 0 0 10px rgba(59, 130, 246, 0); }
        100% { box-shadow: 0 0 0 0 rgba(59, 130, 246, 0); }
    }

    .btn-key-close {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        border: none;
        background: #f1f5f9;
        color: #64748b;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s;
    }

    .btn-key-close:hover {
        background: #e2e8f0;
        color: #1e293b;
    }

    .keypad-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 12px;
    }

    .key-btn {
        background: white;
        border: 1px solid #e2e8f0;
        border-radius: 20px;
        height: 64px;
        font-size: 1.6rem;
        font-weight: 900;
        color: #1e293b;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.1s cubic-bezier(0.4, 0, 0.2, 1);
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
    }

    .key-btn:active:not(:disabled) {
        transform: scale(0.95);
        background: #f8fafc;
        border-color: #3b82f6;
    }

    .key-btn.action-red {
        color: #ef4444;
        background: #fef2f2;
    }

    .btn-premium-next {
        background: #f1f5f9;
        border: none;
        border-radius: 16px;
        padding: 12px;
        font-weight: 900;
        color: #475569;
        font-size: 0.8rem;
        letter-spacing: 0.05em;
        transition: all 0.2s;
    }

    .btn-premium-next:active { background: #e2e8f0; }

    .btn-premium-done {
        background: #eff6ff;
        border: none;
        border-radius: 16px;
        padding: 12px;
        font-weight: 900;
        color: #3b82f6;
        font-size: 0.8rem;
        letter-spacing: 0.05em;
        transition: all 0.2s;
    }

    .btn-premium-done:active { background: #dbeafe; }

    .btn-premium-submit {
        background: #3b82f6;
        border: none;
        border-radius: 20px;
        padding: 16px;
        color: white;
        font-weight: 950;
        font-size: 1rem;
        letter-spacing: 0.02em;
        box-shadow: 0 10px 15px -3px rgba(59, 130, 246, 0.3);
        transition: all 0.2s;
    }

    .btn-premium-submit:active { transform: translateY(2px); box-shadow: 0 5px 10px -3px rgba(59, 130, 246, 0.3); }

    .btn-premium-submit:disabled { opacity: 0.5; filter: grayscale(0.5); }

    .pulse-active { animation: premium-pulse 2s infinite; }

    @@keyframes premium-pulse {
        0% { box-shadow: 0 0 0 0 rgba(59, 130, 246, 0.5); }
        70% { box-shadow: 0 0 0 15px rgba(59, 130, 246, 0); }
        100% { box-shadow: 0 0 0 0 rgba(59, 130, 246, 0); }
    }
</style>

@code {
    [Parameter] public EventCallback<string> OnKeyPressed { get; set; }
    [Parameter] public EventCallback OnBackspacePressed { get; set; }
    [Parameter] public EventCallback OnNextPressed { get; set; }
    [Parameter] public EventCallback OnSubmitPressed { get; set; }
    [Parameter] public EventCallback OnClosePressed { get; set; }
    
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool SubmitDisabled { get; set; }
    [Parameter] public bool PulseSubmit { get; set; }

    private async Task OnKeyPress(string key) => await OnKeyPressed.InvokeAsync(key);
    private async Task OnBackspace() => await OnBackspacePressed.InvokeAsync();
    private async Task OnNext() => await OnNextPressed.InvokeAsync();
    private async Task OnSubmit() => await OnSubmitPressed.InvokeAsync();
    private async Task OnClose() => await OnClosePressed.InvokeAsync();
}
