<div class="keypad-container shadow-lg animate-slide-up">
    <div class="keypad-grid">
        @for (int i = 1; i <= 9; i++)
        {
            var key = i.ToString();
            <button class="key-btn" @onclick="() => OnKeyPress(key)" disabled="@Disabled">@key</button>
        }
        
        <button class="key-btn ivory-btn" @onclick="() => OnBackspace()" disabled="@Disabled">
            <i class="bi bi-backspace"></i>
        </button>
        <button class="key-btn" @onclick='() => OnKeyPress("0")' disabled="@Disabled">0</button>
        <button class="key-btn" @onclick='() => OnKeyPress(".")' disabled="@Disabled">.</button>
    </div>
    
    <div class="keypad-actions mt-2 p-2 pt-0">
        <div class="row g-2">
            <div class="col-12">
                <button class="btn btn-primary w-100 py-3 rounded-4 fw-black d-flex align-items-center justify-content-center gap-2" 
                        @onclick="OnNext" 
                        disabled='@Disabled'>
                    NEXT ENTRY <i class="bi bi-arrow-right-circle-fill fs-5"></i>
                </button>
            </div>
            <div class="col-12 mt-2">
                <button class="btn btn-indigo w-100 py-3 rounded-4 fw-black fs-5 shadow @(PulseSubmit ? "pulse-submit-btn" : "")" 
                        disabled="@(Disabled || SubmitDisabled)" 
                        @onclick="OnSubmit">
                    <i class="bi bi-send-check-fill me-2"></i> SUBMIT REPORT
                </button>
            </div>
        </div>
    </div>
</div>

<style>
    .keypad-container {
        background: #ffffff;
        border: 1.5px solid rgba(0,0,0,0.08);
        border-radius: 20px;
        padding: 10px;
    }

    .keypad-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 8px;
    }

    .key-btn {
        background: #f8fafc;
        border: 1.5px solid rgba(0,0,0,0.08);
        border-radius: 12px;
        font-size: 1.5rem;
        font-weight: 800;
        color: #1e293b;
        height: 65px;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.1s ease;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
    }

    .key-btn:active:not(:disabled) {
        transform: scale(0.92) translateY(2px);
        background: #f1f5f9;
    }

    .ivory-btn { color: #ef4444; }

    .btn-indigo { background-color: #6366f1; border-color: #6366f1; color: white; }
    .btn-indigo:disabled { opacity: 0.6; }

    .pulse-submit-btn { animation: pulse-indigo 2.5s infinite ease-in-out; }
    @@keyframes pulse-indigo {
        0% { box-shadow: 0 0 0 0 rgba(99, 102, 241, 0.5); }
        70% { box-shadow: 0 0 0 15px rgba(99, 102, 241, 0); }
        100% { box-shadow: 0 0 0 0 rgba(99, 102, 241, 0); }
    }
</style>

@code {
    [Parameter] public EventCallback<string> OnKeyPressed { get; set; }
    [Parameter] public EventCallback OnBackspacePressed { get; set; }
    [Parameter] public EventCallback OnNextPressed { get; set; }
    [Parameter] public EventCallback OnSubmitPressed { get; set; }
    
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool SubmitDisabled { get; set; }
    [Parameter] public bool PulseSubmit { get; set; }

    private async Task OnKeyPress(string key) => await OnKeyPressed.InvokeAsync(key);
    private async Task OnBackspace() => await OnBackspacePressed.InvokeAsync();
    private async Task OnNext() => await OnNextPressed.InvokeAsync();
    private async Task OnSubmit() => await OnSubmitPressed.InvokeAsync();
}
