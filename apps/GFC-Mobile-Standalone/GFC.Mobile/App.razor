@inject GFC.Mobile.Services.IConnectivityService Connectivity
@implements IAsyncDisposable

@if (!_isInitialized)
{
    @* [STARTUP SHIELD] Prevent flickering between login and initializing *@
    <div class="startup-shield d-flex flex-column justify-content-center align-items-center" style="height: 100vh; background: #f1f5f9; color: #4f46e5;">
        <div class="gfc-logo-pulse-mini">GFC</div>
        <div class="mt-4 text-uppercase fw-black text-muted" style="font-size: 0.7rem; letter-spacing: 0.2rem;">Initializing Hub...</div>
    </div>
    
    <style>
        .gfc-logo-pulse-mini {
            width: 80px; height: 80px;
            background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%);
            border-radius: 20px; display: flex; justify-content: center; align-items: center;
            font-size: 1.8rem; font-weight: 900; color: white;
            box-shadow: 0 10px 30px rgba(79, 70, 229, 0.3);
            animation: gfc-pulse-mini 2s infinite ease-in-out;
        }
        @@keyframes gfc-pulse-mini {
            0% { transform: scale(1); }
            50% { transform: scale(1.05); }
            100% { transform: scale(1); }
        }
    </style>
}
else
{
    <CascadingAuthenticationState>
        <ErrorBoundary>
            <ChildContent>
                <Router AppAssembly="@typeof(App).Assembly">
                    <Found Context="routeData">
                        <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(GFC.Mobile.Layout.MainLayout)">
                            <NotAuthorized>
                                <RedirectToLogin />
                            </NotAuthorized>
                            <Authorizing>
                                <div class="p-4 text-center">
                                    <div class="spinner-border text-primary" role="status"></div>
                                    <p class="mt-2 text-muted">Checking Security...</p>
                                </div>
                            </Authorizing>
                        </AuthorizeRouteView>
                        <FocusOnNavigate RouteData="@routeData" Selector="h1" />
                    </Found>
                    <NotFound>
                        <LayoutView Layout="@typeof(GFC.Mobile.Layout.MainLayout)">
                            <p role="alert">Sorry, there's nothing at this address.</p>
                        </LayoutView>
                    </NotFound>
                </Router>
            </ChildContent>
            <ErrorContent>
                <div class="p-5 text-center">
                    <i class="bi bi-exclamation-triangle text-danger display-1"></i>
                    <h3 class="mt-3">Application Error</h3>
                    <p class="text-muted">Something went wrong. Please try refreshing the page.</p>
                    <button class="btn btn-primary rounded-pill px-4" onclick="location.reload()">Reload Application</button>
                </div>
            </ErrorContent>
        </ErrorBoundary>
    </CascadingAuthenticationState>
}

@code {
    private bool _isInitialized = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Initialize core services
            await Connectivity.InitializeAsync();
            
            // Give the Auth state a moment to settle from LocalStorage
            await Task.Delay(500); 
            
            _isInitialized = true;
            StateHasChanged();
        }
    }

    public async ValueTask DisposeAsync()
    {
        await Connectivity.DisposeAsync();
    }
}
