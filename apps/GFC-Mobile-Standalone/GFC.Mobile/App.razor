@inject GFC.Mobile.Services.IConnectivityService Connectivity
@implements IAsyncDisposable

<CascadingAuthenticationState>
    <ErrorBoundary>
        <ChildContent>
            <Router AppAssembly="@typeof(App).Assembly">
                <Found Context="routeData">
                    <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(GFC.Mobile.Layout.MainLayout)">
                        <NotAuthorized>
                            <RedirectToLogin />
                        </NotAuthorized>
                        <Authorizing>
                            <div class="p-4 text-center">
                                <div class="spinner-border text-primary" role="status"></div>
                                <p class="mt-2 text-muted">Checking Security...</p>
                            </div>
                        </Authorizing>
                    </AuthorizeRouteView>
                    <FocusOnNavigate RouteData="@routeData" Selector="h1" />
                </Found>
                <NotFound>
                    <LayoutView Layout="@typeof(GFC.Mobile.Layout.MainLayout)">
                        <p role="alert">Sorry, there's nothing at this address.</p>
                    </LayoutView>
                </NotFound>
            </Router>
        </ChildContent>
        <ErrorContent>
            <div class="p-5 text-center">
                <i class="bi bi-exclamation-triangle text-danger display-1"></i>
                <h3 class="mt-3">Application Error</h3>
                <p class="text-muted">Something went wrong. Please try refreshing the page.</p>
                <button class="btn btn-primary rounded-pill px-4" onclick="location.reload()">Reload Application</button>
            </div>
        </ErrorContent>
    </ErrorBoundary>
</CascadingAuthenticationState>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Initialize connectivity listener once the JS runtime is ready
            await Connectivity.InitializeAsync();
        }
    }

    public async ValueTask DisposeAsync()
    {
        await Connectivity.DisposeAsync();
    }
}
