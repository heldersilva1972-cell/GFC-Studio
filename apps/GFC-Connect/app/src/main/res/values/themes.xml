<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base Theme: Material 3 Dark -->
    <style name="Theme.GfcConnect" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowBackground">@color/bg_dark</item>
        <item name="android:statusBarColor">@color/bg_dark</item>
        <item name="android:navigationBarColor">@color/bg_dark</item>
        <item name="colorPrimary">@color/cyan_accent</item>
        <item name="colorSecondary">@color/blue_subtle</item>
        <item name="colorSurface">@color/surface_dark</item>
    </style>

    <!-- Splash Theme -->
    <style name="Theme.GfcConnect.Splash" parent="Theme.GfcConnect">
        <item name="android:windowBackground">@color/bg_dark</item>
    </style>

    <!-- Calendar Dark Theme Overlay -->
    <style name="CalendarDarkTheme" parent="ThemeOverlay.Material3.Dark">
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/cyan_accent</item>
        <item name="android:textColorPrimaryInverse">@color/bg_dark</item>
        <item name="android:colorControlNormal">@color/cyan_accent</item>
        <item name="colorControlNormal">@color/cyan_accent</item>
        <item name="colorControlActivated">@color/cyan_accent</item>
        <item name="colorAccent">@color/cyan_accent</item>
        <item name="colorPrimary">@color/cyan_accent</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurface">@color/surface_dark_card</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="CalendarDateTextAppearance" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="CalendarWeekDayTextAppearance" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textColor">@color/cyan_accent</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
