<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardShiftItem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="14dp"
    app:strokeColor="@color/tier3_shift_stroke"
    app:strokeWidth="1dp"
    app:cardBackgroundColor="@color/tier3_shift_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- Status Stripe (Red for Short, Emerald for Over) -->
        <View
            android:id="@+id/viewShiftStripe"
            android:layout_width="5dp"
            android:layout_height="match_parent"
            android:background="@drawable/bg_stripe_red"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <!-- Top Header: Date, Shift, and Variance Badge -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtShiftEmployee"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Employee Name"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/txtShiftDateAndType"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Oct 14, 2026 • Night Shift"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>

            <!-- Variance Amount Highlight Badge & Expand Affordance -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="end">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="VARIANCE"
                    android:textColor="@color/text_muted"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"
                    android:layout_marginBottom="2dp"/>

                <TextView
                    android:id="@+id/txtVarianceAmountBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="-$25.00"
                    android:textColor="@color/status_red"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_badge_gray"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="3dp"/>
            </LinearLayout>

            <ImageView
                android:id="@+id/imgExpandChevron"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="8dp"
                android:src="@drawable/ic_chevron_right"
                app:tint="@color/text_muted"/>
        </LinearLayout>

        <!-- Financial Breakdown Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/bg_pill_sync"
            android:padding="10dp"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="EXPECTED"
                    android:textColor="@color/text_muted"
                    android:textSize="10sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/txtExpectedCash"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="$420.00"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="@color/border_dark"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ACTUAL ENDING"
                    android:textColor="@color/text_muted"
                    android:textSize="10sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/txtEndingCash"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="$395.00"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Bartender Historical Performance Pill -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingVertical="4dp"
            android:layout_marginBottom="12dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_gear"
                app:tint="@color/text_muted"
                android:layout_marginEnd="6dp"/>

            <TextView
                android:id="@+id/txtBartenderLifetimeSummary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Bartender History: -$35.00 net variance across 18 shifts"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"/>
        </LinearLayout>

        <!-- COMPLETE SHIFT AUDIT DETAILS CONTAINER -->
        <LinearLayout
            android:id="@+id/layoutCompleteDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_surface_card"
            android:padding="12dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FULL SHIFT ENTRY BREAKDOWN"
                android:textColor="@color/cyan_accent"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:layout_marginBottom="8dp"/>

            <!-- Grid Row 1: Cash Bag Movement & Envelope -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="6dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Starting Cash" android:textColor="@color/text_muted" android:textSize="10sp"/>
                    <TextView android:id="@+id/txtDetailStartingCash" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="$300.00" android:textColor="@color/text_primary" android:textSize="12sp" android:textStyle="bold"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Removed from Bag (+)" android:textColor="@color/text_muted" android:textSize="10sp"/>
                    <TextView android:id="@+id/txtDetailBagAdded" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="$0.00" android:textColor="@color/text_primary" android:textSize="12sp" android:textStyle="bold"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Returned to Bag (↓)" android:textColor="@color/text_muted" android:textSize="10sp"/>
                    <TextView android:id="@+id/txtDetailBagRefill" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="$0.00" android:textColor="@color/text_primary" android:textSize="12sp" android:textStyle="bold"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Grid Row 2: Sales & Tickets Activity -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="6dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Net Sales" android:textColor="@color/text_muted" android:textSize="10sp"/>
                    <TextView android:id="@+id/txtDetailTotalSales" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="$0.00" android:textColor="@color/text_primary" android:textSize="12sp" android:textStyle="bold"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Payouts / Cashes" android:textColor="@color/text_muted" android:textSize="10sp"/>
                    <TextView android:id="@+id/txtDetailTotalPayouts" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="$0.00" android:textColor="@color/text_primary" android:textSize="12sp" android:textStyle="bold"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Scratch Tickets" android:textColor="@color/text_muted" android:textSize="10sp"/>
                    <TextView android:id="@+id/txtDetailTotalCancels" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="$0.00" android:textColor="@color/text_primary" android:textSize="12sp" android:textStyle="bold"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Grid Row 3: Envelope Drop & Shift Metadata (Net Due removed) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="6dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Shift" android:textColor="@color/text_muted" android:textSize="10sp"/>
                    <TextView android:id="@+id/txtDetailShiftType" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Night Shift" android:textColor="@color/cyan_accent" android:textSize="12sp" android:textStyle="bold"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Envelope Drop" android:textColor="@color/text_muted" android:textSize="10sp"/>
                    <TextView android:id="@+id/txtDetailEnvelope" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="$0.00" android:textColor="@color/emerald_accent" android:textSize="12sp" android:textStyle="bold"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Status / Machine" android:textColor="@color/text_muted" android:textSize="10sp"/>
                    <TextView android:id="@+id/txtDetailStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Submitted" android:textColor="@color/text_secondary" android:textSize="11sp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Notes Section -->
            <LinearLayout
                android:id="@+id/layoutDetailNotes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="4dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Shift Notes:" android:textColor="@color/text_muted" android:textSize="10sp"/>
                <TextView android:id="@+id/txtDetailNotes" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="None" android:textColor="@color/text_secondary" android:textSize="11sp" android:textStyle="italic"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Action / Status Row -->
        <LinearLayout
            android:id="@+id/layoutActionRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end">

            <TextView
                android:id="@+id/txtAcknowledgedInfo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="✓ Acknowledged by Helder on Oct 15"
                android:textColor="@color/emerald_accent"
                android:textSize="11sp"
                android:visibility="gone"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAcknowledgeShift"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="✓ Acknowledge &amp; Dismiss"
                android:textSize="12sp"
                android:textColor="@color/emerald_accent"
                android:textStyle="bold"
                app:backgroundTint="@color/surface_dark"
                app:strokeColor="@color/emerald_accent"
                app:strokeWidth="1dp"
                app:cornerRadius="10dp"/>
        </LinearLayout>

        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
