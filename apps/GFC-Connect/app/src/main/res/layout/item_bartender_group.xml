<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardBartenderGroup"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:layout_marginHorizontal="2dp"
    app:cardCornerRadius="14dp"
    app:strokeColor="@color/tier2_bartender_stroke"
    app:strokeWidth="1dp"
    app:cardBackgroundColor="@color/tier2_bartender_bg"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Bartender Group Header -->
        <LinearLayout
            android:id="@+id/layoutBartenderHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp">

            <!-- Avatar / Initial Circle -->
            <TextView
                android:id="@+id/txtBartenderInitial"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_circle_icon"
                android:gravity="center"
                android:text="B"
                android:textColor="@color/cyan_accent"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginEnd="14dp"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtBartenderName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bartender Name"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/txtBartenderStats"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="3 variance shifts • Net -$15.00"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>

            <!-- Separate Variance Pill Badges (Over / Short) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginEnd="8dp">

                <TextView
                    android:id="@+id/txtBartenderPositiveBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="+$10.00"
                    android:textColor="@color/emerald_accent"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_badge_emerald"
                    android:paddingHorizontal="7dp"
                    android:paddingVertical="3dp"
                    android:layout_marginEnd="5dp"
                    android:visibility="gone"/>

                <TextView
                    android:id="@+id/txtBartenderNegativeBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="-$15.00"
                    android:textColor="@color/status_red"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_badge_gray"
                    android:paddingHorizontal="7dp"
                    android:paddingVertical="3dp"
                    android:visibility="gone"/>
            </LinearLayout>

            <!-- Expand / Collapse Arrow -->
            <ImageView
                android:id="@+id/imgGroupChevron"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_chevron_right"
                app:tint="@color/text_muted"/>
        </LinearLayout>

        <!-- Divider Line when expanded -->
        <View
            android:id="@+id/dividerBartender"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/tier2_bartender_stroke"
            android:visibility="gone"/>

        <!-- Nested RecyclerView for this Bartender's individual shifts -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerBartenderShifts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="8dp"
            android:paddingTop="8dp"
            android:paddingBottom="4dp"
            android:visibility="gone"
            android:nestedScrollingEnabled="false"/>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
