<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardMonthGroup"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="16dp"
    app:strokeColor="@color/tier1_month_stroke"
    app:strokeWidth="1.5dp"
    app:cardBackgroundColor="@color/tier1_month_bg"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Month Group Header -->
        <LinearLayout
            android:id="@+id/layoutMonthHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_calendar"
                app:tint="@color/cyan_accent"
                android:layout_marginEnd="14dp"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtMonthTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="October 2026"
                    android:textColor="@color/text_primary"
                    android:textSize="17sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/txtMonthStats"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="4 past shifts • Net -$25.00"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>

            <!-- Separate Variance Pill Badges (Over / Short) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginEnd="8dp">

                <TextView
                    android:id="@+id/txtMonthPositiveBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="+$10.00"
                    android:textColor="@color/emerald_accent"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_badge_emerald"
                    android:paddingHorizontal="7dp"
                    android:paddingVertical="3dp"
                    android:layout_marginEnd="5dp"
                    android:visibility="gone"/>

                <TextView
                    android:id="@+id/txtMonthNegativeBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="-$25.00"
                    android:textColor="@color/status_red"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_badge_gray"
                    android:paddingHorizontal="7dp"
                    android:paddingVertical="3dp"
                    android:visibility="gone"/>
            </LinearLayout>

            <!-- Expand / Collapse Arrow -->
            <ImageView
                android:id="@+id/imgMonthChevron"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_chevron_right"
                app:tint="@color/text_muted"/>
        </LinearLayout>

        <!-- Divider Line when expanded -->
        <View
            android:id="@+id/dividerMonth"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/tier1_month_stroke"
            android:visibility="gone"/>

        <!-- Nested RecyclerView for this Month's Bartenders -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerMonthBartenders"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="10dp"
            android:paddingTop="10dp"
            android:paddingBottom="6dp"
            android:visibility="gone"
            android:nestedScrollingEnabled="false"/>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
