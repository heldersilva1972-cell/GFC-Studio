<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/surface_dark"
    android:padding="20dp">

    <!-- Header with Icon & Target Date Badge -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_calendar"
            app:tint="@color/purple_accent"
            android:layout_marginEnd="12dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Book Club Event"
                android:textColor="@color/text_primary"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtDialogTargetDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Target Date: 2026-10-20"
                android:textColor="@color/gold_accent"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginTop="2dp" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- STEP 1: EVENT TITLE -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1. EVENT TITLE"
                android:textColor="@color/text_muted"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:layout_marginBottom="6dp" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:hintEnabled="false"
                app:boxCornerRadiusTopStart="10dp"
                app:boxCornerRadiusTopEnd="10dp"
                app:boxCornerRadiusBottomStart="10dp"
                app:boxCornerRadiusBottomEnd="10dp"
                app:boxStrokeColor="@color/border_dark"
                app:boxBackgroundColor="@color/card_dark"
                android:layout_marginBottom="16dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editDialogEventTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="e.g. Board Meeting, Club Dinner"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_muted"
                    android:textSize="13sp"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:imeOptions="actionDone"
                    android:padding="12dp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- STEP 2: SELECT EVENT SPACE -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2. SELECT EVENT SPACE"
                android:textColor="@color/text_muted"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:layout_marginBottom="8dp" />

            <!-- Space Selection Radio Group inside Card Container -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/card_dark"
                app:cardCornerRadius="12dp"
                app:strokeColor="@color/border_dark"
                app:strokeWidth="1dp"
                android:layout_marginBottom="16dp">

                <RadioGroup
                    android:id="@+id/radioGroupLocation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <RadioButton
                        android:id="@+id/rbDialogFunctionHall"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="🏛️  Function Hall\nPrimary Managed Space"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:checked="true"
                        android:lineSpacingExtra="3dp"
                        android:paddingVertical="8dp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/border_subtle"
                        android:layout_marginHorizontal="6dp" />

                    <RadioButton
                        android:id="@+id/rbDialogOffice"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="🏢  Office\nSecondary Flexible Space"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:lineSpacingExtra="3dp"
                        android:paddingVertical="8dp" />
                </RadioGroup>
            </com.google.android.material.card.MaterialCardView>

            <!-- STEP 3: SCHEDULE / TIME SLOT -->
            <TextView
                android:id="@+id/txtDialogTimeSlotHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3. TIME SLOT &amp; AVAILABILITY"
                android:textColor="@color/text_muted"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:layout_marginBottom="8dp" />

            <!-- Function Hall Slot Container Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardDialogHallSlots"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/card_dark"
                app:cardCornerRadius="12dp"
                app:strokeColor="@color/border_dark"
                app:strokeWidth="1dp"
                android:layout_marginBottom="14dp">

                <RadioGroup
                    android:id="@+id/radioGroupHallSlots"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <RadioButton
                        android:id="@+id/rbDialogFullDay"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Full Day Blackout"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:paddingVertical="8dp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/border_subtle"
                        android:layout_marginHorizontal="6dp" />

                    <RadioButton
                        android:id="@+id/rbDialogAfternoon"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Afternoon (12:00 PM – 5:00 PM)"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:paddingVertical="8dp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/border_subtle"
                        android:layout_marginHorizontal="6dp" />

                    <RadioButton
                        android:id="@+id/rbDialogEvening"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Evening (6:00 PM – 11:00 PM)"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:paddingVertical="8dp" />
                </RadioGroup>
            </com.google.android.material.card.MaterialCardView>

            <!-- Office Slot Container Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardDialogOfficeSlots"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/card_dark"
                app:cardCornerRadius="12dp"
                app:strokeColor="@color/border_dark"
                app:strokeWidth="1dp"
                android:visibility="gone"
                android:layout_marginBottom="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <RadioGroup
                        android:id="@+id/radioGroupOfficeSlots"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <RadioButton
                            android:id="@+id/rbDialogOfficeCustom"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="⏰  Specific Custom Hours"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp"
                            android:paddingVertical="6dp" />

                        <RadioButton
                            android:id="@+id/rbDialogOfficeFullDay"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="📅  Full Day Office Blackout"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp"
                            android:paddingVertical="6dp" />
                    </RadioGroup>

                    <!-- Office Hours Buttons Row -->
                    <LinearLayout
                        android:id="@+id/layoutDialogOfficeHoursRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="10dp">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnDialogStartTime"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="42dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="6dp"
                            android:text="Start: 6:00 PM"
                            android:textColor="@color/gold_accent"
                            app:strokeColor="@color/gold_accent"
                            app:cornerRadius="8dp"
                            android:textSize="12sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnDialogEndTime"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="42dp"
                            android:layout_weight="1"
                            android:layout_marginStart="6dp"
                            android:text="End: 8:30 PM"
                            android:textColor="@color/gold_accent"
                            app:strokeColor="@color/gold_accent"
                            app:cornerRadius="8dp"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Public Calendar Visibility Option -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardDialogPublicVisibility"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/card_dark"
                app:cardCornerRadius="12dp"
                app:strokeColor="@color/border_dark"
                app:strokeWidth="1dp"
                android:layout_marginBottom="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="12dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginEnd="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🌐  Display on Public Calendar"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Show event title on website public calendar grid."
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchDialogPublicVisibility"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="false" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- STEP 4: AVAILABILITY STATUS CALLOUT -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardDialogStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/surface_dark_muted"
                app:cardCornerRadius="10dp"
                app:strokeColor="@color/emerald_accent"
                app:strokeWidth="1.5dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/txtDialogStatusIcon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="✓"
                        android:textColor="@color/emerald_accent"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginEnd="10dp" />

                    <TextView
                        android:id="@+id/txtDialogStatus"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Space Available: No conflicting bookings for this slot."
                        android:textColor="@color/emerald_accent"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:lineSpacingExtra="2dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>

    <!-- Dialog Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:layout_marginTop="8dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDialogCancel"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="Cancel"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:layout_marginEnd="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDialogSubmit"
            style="@style/Widget.Material3.Button"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="Book Event"
            android:textColor="@color/bg_dark"
            android:textStyle="bold"
            app:backgroundTint="@color/cyan_accent"
            app:cornerRadius="10dp"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
