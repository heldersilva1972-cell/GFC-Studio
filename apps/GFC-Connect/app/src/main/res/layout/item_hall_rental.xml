<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardRentalItem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    app:cardCornerRadius="18dp"
    app:strokeColor="@color/card_dark_stroke"
    app:strokeWidth="1dp"
    app:cardBackgroundColor="@color/card_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- General Inquiry Visual Alert Banner (Only shown when inquiry) -->
        <LinearLayout
            android:id="@+id/layoutInquiryBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_badge_inquiry"
            android:paddingHorizontal="10dp"
            android:paddingVertical="5dp"
            android:layout_marginBottom="10dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📋"
                android:textSize="13sp"
                android:layout_marginEnd="6dp"/>

            <TextView
                android:id="@+id/txtInquiryBannerTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GENERAL INQUIRY • NOT A CONFIRMED BOOKING"
                android:textColor="@color/status_yellow"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.04"/>
        </LinearLayout>

        <!-- Top Header: Event Type & Status Badge -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp">

            <TextView
                android:id="@+id/txtItemEventType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Birthday Party"
                android:textColor="@color/text_primary"
                android:textSize="17sp"
                android:textStyle="bold"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"/>

            <TextView
                android:id="@+id/txtItemStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pending"
                android:textColor="@color/cyan_accent"
                android:textSize="11sp"
                android:textStyle="bold"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp"
                android:background="@drawable/bg_pill_sync"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"/>
        </RelativeLayout>

        <!-- Date & Time -->
        <TextView
            android:id="@+id/txtItemDateRange"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📅 Sat, Nov 14, 2026 • 2:00 PM - 7:00 PM"
            android:textColor="@color/cyan_accent"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp"/>

        <!-- Room & Setup Details -->
        <TextView
            android:id="@+id/txtItemRoomGuests"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🏛️ Function Hall • 75 Guests • Bar Included"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:layout_marginBottom="8dp"/>

        <!-- Matrix & Member Verification Badges Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="10dp">

            <TextView
                android:id="@+id/txtItemMatrixBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🏷️ Matrix: Non-Member"
                android:textColor="@color/cyan_accent"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="@drawable/bg_pill_sync"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2.5dp"
                android:layout_marginEnd="6dp"/>

            <TextView
                android:id="@+id/txtItemMemberVerifyBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✓ Verified Member"
                android:textColor="@color/emerald_accent"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="@drawable/bg_badge_emerald"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2.5dp"
                android:layout_marginEnd="6dp"/>

            <TextView
                android:id="@+id/txtItemTrackingBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⏱️ 2d ago"
                android:textColor="@color/text_muted"
                android:textSize="11sp"
                android:background="@drawable/bg_pill_sync"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2.5dp"/>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/card_dark_stroke"
            android:layout_marginBottom="10dp"/>

        <!-- Renter Contact Information, Call Button & Total Price -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp">

            <LinearLayout
                android:id="@+id/layoutContactInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_alignParentStart="true"
                android:layout_toStartOf="@+id/layoutRightPriceCol"
                android:layout_centerVertical="true"
                android:layout_marginEnd="8dp">

                <TextView
                    android:id="@+id/txtItemApplicant"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="👤 John Doe"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold"/>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="4dp">

                    <TextView
                        android:id="@+id/txtItemContact"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📞 (555) 123-4567"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnItemCallApplicant"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="28dp"
                        android:layout_marginStart="8dp"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="0dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="Call"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="@color/emerald_accent"
                        app:backgroundTint="#1A10B981"
                        app:strokeColor="@color/emerald_accent"
                        app:strokeWidth="1dp"
                        app:cornerRadius="6dp"
                        app:icon="@drawable/ic_phone"
                        app:iconSize="11dp"
                        app:iconTint="@color/emerald_accent"
                        app:iconPadding="3dp"/>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutRightPriceCol"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="end"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true">

                <TextView
                    android:id="@+id/txtItemPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="$400.00"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold"/>
            </LinearLayout>
        </RelativeLayout>

        <!-- Action Buttons (Approve / Deny) for Pending Rentals -->
        <LinearLayout
            android:id="@+id/layoutAdminActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="6dp"
            android:visibility="gone">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnApproveRental"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="Approve"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/bg_dark"
                app:backgroundTint="@color/status_green"
                app:cornerRadius="10dp"
                android:layout_marginEnd="6dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDenyRental"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="Deny"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/status_red"
                app:strokeColor="@color/status_red"
                app:cornerRadius="10dp"
                android:layout_marginStart="6dp"/>
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
