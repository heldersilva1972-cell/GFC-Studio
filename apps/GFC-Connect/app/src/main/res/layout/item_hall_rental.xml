<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    app:cardCornerRadius="18dp"
    app:strokeColor="@color/card_dark_stroke"
    app:strokeWidth="1dp"
    app:cardBackgroundColor="@color/card_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top Header: Event Type & Status Badge -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp">

            <TextView
                android:id="@+id/txtItemEventType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Birthday Party"
                android:textColor="@color/text_primary"
                android:textSize="17sp"
                android:textStyle="bold"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"/>

            <TextView
                android:id="@+id/txtItemStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pending"
                android:textColor="@color/cyan_accent"
                android:textSize="11sp"
                android:textStyle="bold"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp"
                android:background="@drawable/bg_pill_sync"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"/>
        </RelativeLayout>

        <!-- Date & Time -->
        <TextView
            android:id="@+id/txtItemDateRange"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📅 Sat, Nov 14, 2026 • 2:00 PM - 7:00 PM"
            android:textColor="@color/cyan_accent"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp"/>

        <!-- Room & Setup Details -->
        <TextView
            android:id="@+id/txtItemRoomGuests"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🏛️ Function Hall • 75 Guests • Bar Included"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:layout_marginBottom="8dp"/>

        <!-- Matrix & Member Verification Badges Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="10dp">

            <TextView
                android:id="@+id/txtItemMatrixBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🏷️ Matrix: Non-Member"
                android:textColor="@color/cyan_accent"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="@drawable/bg_pill_sync"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2.5dp"
                android:layout_marginEnd="6dp"/>

            <TextView
                android:id="@+id/txtItemMemberVerifyBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✓ Verified Member"
                android:textColor="@color/emerald_accent"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="@drawable/bg_badge_emerald"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2.5dp"/>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/card_dark_stroke"
            android:layout_marginBottom="10dp"/>

        <!-- Renter Contact Information & Total Price -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true">

                <TextView
                    android:id="@+id/txtItemApplicant"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Renter: John Doe"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/txtItemContact"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📞 (555) 123-4567"
                    android:textColor="@color/text_muted"
                    android:textSize="12sp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="end"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true">

                <TextView
                    android:id="@+id/txtItemPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="$400.00"
                    android:textColor="@color/text_primary"
                    android:textSize="17sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Details &amp; Edit ›"
                    android:textColor="@color/cyan_accent"
                    android:textSize="11sp"
                    android:textStyle="bold"/>
            </LinearLayout>
        </RelativeLayout>

        <!-- Action Buttons (Approve / Deny) for Pending Rentals -->
        <LinearLayout
            android:id="@+id/layoutAdminActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="6dp"
            android:visibility="gone">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnApproveRental"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="Approve"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/bg_dark"
                app:backgroundTint="@color/status_green"
                app:cornerRadius="10dp"
                android:layout_marginEnd="6dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDenyRental"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="Deny"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/status_red"
                app:strokeColor="@color/status_red"
                app:cornerRadius="10dp"
                android:layout_marginStart="6dp"/>
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
