<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layoutDayCell"
    android:layout_width="match_parent"
    android:layout_height="48dp"
    android:orientation="vertical"
    android:gravity="center"
    android:layout_margin="1dp"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true">

    <TextView
        android:id="@+id/txtDayNumber"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:gravity="center"
        android:text="1"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:textStyle="bold"/>

    <!-- Indicator Dots Container -->
    <LinearLayout
        android:id="@+id/layoutDotsContainer"
        android:layout_width="wrap_content"
        android:layout_height="7dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="2dp">

        <View
            android:id="@+id/dotEmerald"
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:background="@drawable/dot_emerald"
            android:layout_marginHorizontal="1.5dp"
            android:visibility="gone"/>

        <View
            android:id="@+id/dotYellow"
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:background="@drawable/dot_yellow"
            android:layout_marginHorizontal="1.5dp"
            android:visibility="gone"/>

        <View
            android:id="@+id/dotPurple"
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:background="@drawable/dot_purple"
            android:layout_marginHorizontal="1.5dp"
            android:visibility="gone"/>
    </LinearLayout>
</LinearLayout>
