<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <!-- ============================================================= -->
    <!-- VIEW 1: ONE-TIME ONBOARDING / PAIRING SCREEN                  -->
    <!-- ============================================================= -->
    <LinearLayout
        android:id="@+id/layoutOnboarding"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:src="@drawable/ic_shield_badge"
            android:contentDescription="GFC Badge"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="GFC Connect"
            android:textColor="@color/text_primary"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Enter the 8-digit setup code generated from the club web portal to activate this device."
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginBottom="28dp"/>

        <FrameLayout
            android:layout_width="260dp"
            android:layout_height="60dp"
            android:layout_marginBottom="20dp">

            <EditText
                android:id="@+id/editSetupCode"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_code_input"
                android:gravity="center"
                android:hint="0000 - 0000"
                android:textColorHint="@color/text_muted"
                android:textColor="@color/cyan_accent"
                android:textSize="22sp"
                android:textStyle="bold"
                android:inputType="number"
                android:digits="0123456789-"
                android:maxLength="9"
                android:letterSpacing="0.15"
                android:paddingStart="36dp"
                android:paddingEnd="36dp"/>

            <ImageView
                android:id="@+id/btnClearCode"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="10dp"
                android:padding="6dp"
                android:src="@drawable/ic_close_circle"
                android:contentDescription="Clear code"
                android:visibility="gone"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="@color/text_muted"/>
        </FrameLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVerifyCode"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Verify &amp; Activate"
            android:textColor="@color/bg_dark"
            android:textStyle="bold"
            app:backgroundTint="@color/cyan_accent"
            app:cornerRadius="14dp"
            android:layout_marginBottom="12dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnToggleServer"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🌐 Server: Localhost (5207)"
            android:textColor="@color/text_muted"
            android:textSize="12sp"
            android:layout_marginBottom="8dp"/>

        <ProgressBar
            android:id="@+id/progressOnboarding"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:indeterminateTint="@color/cyan_accent"
            android:visibility="gone"/>

        <TextView
            android:id="@+id/txtOnboardingError"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/status_red"
            android:textSize="13sp"
            android:visibility="gone"/>
    </LinearLayout>

    <!-- ============================================================= -->
    <!-- VIEW 2: BIOMETRIC LOCK SCREEN                                 -->
    <!-- ============================================================= -->
    <LinearLayout
        android:id="@+id/layoutBiometricLock"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@drawable/ic_fingerprint_shield"
            android:contentDescription="Biometric"
            android:layout_marginBottom="20dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="GFC Connect Locked"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/txtBiometricUserGreeting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Touch the fingerprint sensor to unlock."
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginBottom="32dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRetryBiometric"
            android:layout_width="220dp"
            android:layout_height="52dp"
            android:text="Scan Fingerprint"
            android:textColor="@color/bg_dark"
            android:textStyle="bold"
            app:backgroundTint="@color/cyan_accent"
            app:cornerRadius="14dp"/>
    </LinearLayout>

    <!-- ============================================================= -->
    <!-- VIEW 3: MAIN HUB LAUNCHPAD (THE CORE APP LAUNCHPAD)           -->
    <!-- ============================================================= -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/layoutMainHub"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Sleek Top Header Bar -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtWelcomeHeader"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Welcome"
                        android:textColor="@color/text_primary"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:letterSpacing="-0.02"/>

                    <TextView
                        android:id="@+id/txtMemberIdSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Member Portal"
                        android:textColor="@color/cyan_accent"
                        android:textSize="13sp"
                        android:textStyle="bold"/>
                </LinearLayout>

                <!-- Settings Gear Icon -->
                <ImageView
                    android:id="@+id/btnSettings"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:src="@drawable/ic_gear"
                    android:contentDescription="Settings"
                    android:padding="9dp"
                    android:background="@drawable/bg_circle_icon"
                    android:clickable="true"
                    android:focusable="true"/>
            </RelativeLayout>

            <!-- In-App Update Alert Banner (Hidden by default) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardUpdateBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardCornerRadius="16dp"
                app:strokeColor="@color/cyan_accent"
                app:strokeWidth="1dp"
                app:cardBackgroundColor="@color/surface_dark"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_download_cloud"
                        android:layout_marginEnd="12dp"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/txtUpdateTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="New Version Available"
                            android:textColor="@color/cyan_accent"
                            android:textStyle="bold"
                            android:textSize="14sp"/>

                        <TextView
                            android:id="@+id/txtUpdateSubtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tap to update GFC Connect"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"/>
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnApplyUpdate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Update"
                        android:textSize="12sp"
                        android:textColor="@color/bg_dark"
                        app:backgroundTint="@color/cyan_accent"
                        app:cornerRadius="10dp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Core Action Cards (Only Hall Rentals) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Hall Rentals Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardHallRentals"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardCornerRadius="18dp"
                    app:strokeColor="@color/card_dark_stroke"
                    app:strokeWidth="1dp"
                    app:cardBackgroundColor="@color/card_dark"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="20dp">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:src="@drawable/ic_building_hall"
                            android:layout_marginEnd="16dp"/>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Hall Rentals"
                                android:textColor="@color/text_primary"
                                android:textSize="17sp"
                                android:textStyle="bold"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="View inquiries, requests, calendar &amp; approve rentals"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp"/>
                        </LinearLayout>

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="@color/text_muted"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
