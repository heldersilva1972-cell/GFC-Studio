<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface_dark">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbarRentals"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="?attr/homeAsUpIndicator"
            app:title="Hall Rentals"
            app:titleTextColor="@color/text_primary">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOpenCalendar"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_gravity="end"
                android:layout_marginEnd="16dp"
                android:text="Calendar"
                android:textSize="12sp"
                android:textColor="@color/cyan_accent"
                app:backgroundTint="@color/surface_dark_card"
                app:cornerRadius="8dp"
                app:icon="@drawable/ic_calendar"
                app:iconSize="14dp"
                app:iconTint="@color/cyan_accent"/>
        </androidx.appcompat.widget.Toolbar>

        <!-- Status Filter Tabs -->
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabLayoutStatus"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:background="@color/surface_dark"
            app:tabMode="scrollable"
            app:tabIndicatorColor="@color/cyan_accent"
            app:tabIndicatorHeight="3dp"
            app:tabSelectedTextColor="@color/cyan_accent"
            app:tabTextColor="@color/text_secondary"
            app:tabRippleColor="@color/cyan_accent"
            android:layout_marginBottom="4dp"/>
    </com.google.android.material.appbar.AppBarLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <!-- Offline Info Banner -->
        <LinearLayout
            android:id="@+id/bannerOffline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#26F59E0B"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:gravity="center_vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/txtOfflineBanner"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="⚠️ Offline • Showing cached data"
                android:textColor="@color/status_yellow"
                android:textSize="12sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/btnBannerReconnect"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Retry Now"
                android:textColor="@color/cyan_accent"
                android:textSize="12sp"
                android:textStyle="bold"
                android:padding="4dp"/>
        </LinearLayout>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp">

            <ProgressBar
                android:id="@+id/progressRentals"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_centerInParent="true"
                android:indeterminateTint="@color/cyan_accent"
                android:visibility="gone"/>

            <LinearLayout
                android:id="@+id/layoutEmptyRentals"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <ImageView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:src="@drawable/ic_building_hall"
                    android:layout_marginBottom="12dp"
                    app:tint="@color/text_muted"/>

                <TextView
                    android:id="@+id/txtEmptyFilterTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="No Hall Rentals Found"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:id="@+id/txtEmptyFilterSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="There are no rentals matching this status filter."
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:layout_marginBottom="16dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRetryLoad"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:text="Check Server Connection"
                    android:textColor="@color/cyan_accent"
                    app:backgroundTint="@color/surface_dark"
                    app:cornerRadius="10dp"/>
            </LinearLayout>

            <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
                android:id="@+id/swipeRefreshRentals"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerRentals"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingBottom="24dp"/>
            </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
        </RelativeLayout>
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
