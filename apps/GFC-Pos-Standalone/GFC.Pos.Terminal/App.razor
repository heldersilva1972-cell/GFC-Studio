@inject GFC.Pos.UI.Services.ConnectivityService Connectivity
@implements IAsyncDisposable

@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.AspNetCore.Components.Web

<Router AppAssembly="@typeof(App).Assembly" 
        AdditionalAssemblies="new[] { typeof(GFC.Pos.UI.Pages.PosTerminal).Assembly }">
    <Found Context="routeData">
        <RouteView RouteData="@routeData" DefaultLayout="@typeof(GFC.Pos.UI.Layout.MainLayout)"/>
        <FocusOnNavigate RouteData="@routeData" Selector="h1" />
    </Found>
    <NotFound>
        <LayoutView Layout="@typeof(GFC.Pos.UI.Layout.MainLayout)">
            <GFC.Pos.UI.Pages.NotFound />
        </LayoutView>
    </NotFound>
</Router>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await Connectivity.InitializeAsync();
    }

    public async ValueTask DisposeAsync()
    {
        await Connectivity.DisposeAsync();
    }
}
