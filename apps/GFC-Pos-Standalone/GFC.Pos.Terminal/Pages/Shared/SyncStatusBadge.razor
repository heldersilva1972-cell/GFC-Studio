@inject ConnectivityService Connectivity
@inject PosTerminalService PosService
@implements IDisposable

<div class="sync-status-bar @(Connectivity.IsOnline ? "online" : "offline")">
    <div class="sync-dot"></div>
    <span class="sync-label">
        @if (!Connectivity.IsOnline)
        {
            <span>Offline — @PosService.TotalPendingCount pending</span>
        }
        else if (PosService.TotalPendingCount > 0)
        {
            <span>Syncing @PosService.TotalPendingCount item@(PosService.TotalPendingCount == 1 ? "" : "s")...</span>
        }
        else if (_justSynced)
        {
            <span>Synced ✓</span>
        }
        else
        {
            <span>Online</span>
        }
    </span>
</div>

@code {
    private bool _justSynced;
    private System.Threading.Timer? _clearTimer;

    protected override async Task OnInitializedAsync()
    {
        Connectivity.ConnectivityChanged += OnConnectivityChanged;
        PosService.OutboxChanged         += OnOutboxChanged;
        await PosService.GetTotalPendingAsync();
    }

    private void OnConnectivityChanged(bool isOnline)
        => InvokeAsync(StateHasChanged);

    private void OnOutboxChanged()
    {
        if (PosService.TotalPendingCount == 0)
        {
            _justSynced = true;
            _clearTimer?.Dispose();
            _clearTimer = new System.Threading.Timer(_ =>
            {
                _justSynced = false;
                InvokeAsync(StateHasChanged);
            }, null, 3000, Timeout.Infinite);
        }
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Connectivity.ConnectivityChanged -= OnConnectivityChanged;
        PosService.OutboxChanged         -= OnOutboxChanged;
        _clearTimer?.Dispose();
    }
}

<style>
    .sync-status-bar {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 3px 10px;
        border-radius: 20px;
        font-size: 0.7rem;
        font-weight: 600;
        letter-spacing: 0.03em;
        transition: background 0.3s, color 0.3s;
    }
    .sync-status-bar.online  { background: rgba(25,135,84,.12); color: #198754; }
    .sync-status-bar.offline { background: rgba(220,53,69,.12); color: #dc3545; animation: pulse-bar 2s infinite; }
    .sync-dot { width:7px; height:7px; border-radius:50%; flex-shrink:0; }
    .online  .sync-dot { background:#198754; }
    .offline .sync-dot { background:#dc3545; }
    @@keyframes pulse-bar { 0%,100%{opacity:1} 50%{opacity:.6} }
</style>
