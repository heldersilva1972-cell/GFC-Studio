<Project Sdk="Microsoft.NET.Sdk.Razor">
  <Import Project="..\PosVersion.props" />
  <PropertyGroup>
    <Version>$(PosVersion)</Version>
    <AssemblyVersion>$(PosVersion).0</AssemblyVersion>
    <FileVersion>$(PosVersion).0</FileVersion>
  </PropertyGroup>


  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>


  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Blazored.Toast" Version="4.2.1" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.7" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\webapp\GFC.Core\GFC.Core.csproj" />
  </ItemGroup>

</Project>
