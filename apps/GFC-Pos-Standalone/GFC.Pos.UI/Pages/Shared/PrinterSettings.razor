@using GFC.Pos.UI.Services
@inject IPrinterService PrinterService
@inject IPrinterConfigService PrinterConfig
@inject Blazored.Toast.Services.IToastService Toast

<div class="settings-group">
    <div class="d-grid mb-3">
        <button class="btn btn-dark fw-bold rounded-pill py-3 mb-2" @onclick="ScanForPrinters">
            <i class="bi bi-search me-2"></i> SCAN FOR PRINTERS
        </button>
        
        @if (_detectedDevices.Any())
        {
            <div class="list-group mb-3 animate__animated animate__fadeIn">
                @foreach (var dev in _detectedDevices)
                {
                    <button class="list-group-item list-group-item-action d-flex justify-content-between align-items-center py-3" 
                            @onclick="() => SelectDevice(dev)">
                        <div>
                            <div class="fw-bold">@dev.Name</div>
                            <div class="small text-muted">VID: @dev.VidHex | PID: @dev.PidHex</div>
                        </div>
                        <i class="bi bi-plus-circle-fill text-primary fs-4"></i>
                    </button>
                }
            </div>
        }
    </div>

    <div class="row g-2">
        <div class="col-6">
            <label class="settings-label">Vendor ID (Hex)</label>
            <input type="text" class="form-control settings-input" 
                   @bind="PrinterConfig.PrinterVendorId" placeholder="04B8" />
        </div>
        <div class="col-6">
            <label class="settings-label">Product ID (Hex)</label>
            <input type="text" class="form-control settings-input" 
                   @bind="PrinterConfig.PrinterProductId" placeholder="0202" />
        </div>
    </div>
    <div class="d-flex gap-2 mt-3">
        <button class="btn btn-primary flex-grow-1 fw-bold rounded-pill py-3" @onclick="SaveSettings">SAVE PRINTER</button>
        <button class="btn btn-outline-primary flex-grow-1 fw-bold rounded-pill py-3" @onclick="TestPrint">TEST PRINT</button>
    </div>
    <div class="mt-2 small text-muted opacity-50 text-center" style="font-size: 0.6rem;">
        ESC/POS DIRECT USB Communication
    </div>
</div>

@code {
    private List<UsbDeviceDto> _detectedDevices = new();

    protected override async Task OnInitializedAsync()
    {
        await PrinterConfig.LoadSettingsAsync();
    }

    private async Task ScanForPrinters()
    {
        _detectedDevices = await PrinterService.GetConnectedDevicesAsync();
        if (!_detectedDevices.Any()) Toast.ShowInfo("No USB devices detected.");
    }

    private void SelectDevice(UsbDeviceDto dev)
    {
        PrinterConfig.PrinterVendorId = dev.VidHex;
        PrinterConfig.PrinterProductId = dev.PidHex;
        _detectedDevices.Clear();
        Toast.ShowSuccess($"Selected {dev.Name}");
    }

    private void SaveSettings()
    {
        PrinterConfig.SaveSettings(PrinterConfig.PrinterVendorId, PrinterConfig.PrinterProductId);
        Toast.ShowSuccess("Printer settings saved.");
    }

    private async Task TestPrint()
    {
        bool success = await PrinterService.PrintReceiptAsync("GFC POS TEST PRINT\nUSB DIRECT CONNECTION\n\nREADY TO SERVE\n\n\n\n\n");
        if (success)
            Toast.ShowSuccess("Test print sent.");
        else
            Toast.ShowError("Test print failed. Check connection & permissions.");
    }
}
