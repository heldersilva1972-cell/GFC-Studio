    private async Task SaveInlineTally(bool closeEvent)
    {
        if (inlineTallyEvent == null) return;
        var evSnapshot = inlineTallyEvent;

        // Perform sanity check: Returned cannot exceed Taken
        foreach (var t in currentTallies)
        {
            if (t.QuantityReturned > t.QuantityTaken)
            {
                await JSRuntime.InvokeVoidAsync("alert", $"For {t.Name}, quantity returned ({t.QuantityReturned}) cannot exceed quantity taken ({t.QuantityTaken}).");
                return;
            }
        }

        var evId = evSnapshot.Id;
        var localEvent = DbActiveEvents.FirstOrDefault(e => e.Id == evId);

        // ── 1. SYNCHRONOUSLY UPDATE LOCAL MEMORY TALLIES & DONATED POOL (PREVENT RACE CONDITION) ──
        var talliesToSave = currentTallies.ToList(); // Clone current tallies before modal reset
        var talliesJson = global::System.Text.Json.JsonSerializer.Serialize(talliesToSave);
        decimal totalConsumedCost = talliesToSave.Sum(t => GetTallyClubPortion(evSnapshot, t));
        decimal newBalance = (evSnapshot.Type == GFC.Core.Enums.EventTabType.PrePaid)
            ? evSnapshot.InitialAmount - totalConsumedCost
            : -totalConsumedCost;

        var allDonatedStock = GetAllDonatedStockForEvent(evSnapshot);
        var tmpl = DbEventTemplates?.FirstOrDefault(t => (evSnapshot.TemplateId.HasValue && t.Id == evSnapshot.TemplateId.Value) || (!string.IsNullOrEmpty(evSnapshot.Name) && string.Equals(t.Name, evSnapshot.Name, StringComparison.OrdinalIgnoreCase)));

        if (closeEvent && localEvent != null)
        {
            var targetCleanName = GetEventDisplayName(evSnapshot.Name).Replace("EVENT:", "").Replace("[Direct]", "").Trim().ToLower();

            List<ActiveEvent> donorEventsToUpdate = new();
            if (!string.IsNullOrEmpty(localEvent.DonatedItemIdsJson)) donorEventsToUpdate.Add(localEvent);

            var allActiveEvents = DbActiveEvents ?? _cachedMenu?.ActiveEvents ?? new();
            foreach (var dev in allActiveEvents)
            {
                if (dev.Id == localEvent.Id || string.IsNullOrWhiteSpace(dev.RecipientEventName) || string.IsNullOrEmpty(dev.DonatedItemIdsJson)) continue;
                var srcRecipient = dev.RecipientEventName.Replace("EVENT:", "").Replace("[Direct]", "").Trim().ToLower();
                if (srcRecipient == targetCleanName || targetCleanName.Contains(srcRecipient) || srcRecipient.Contains(targetCleanName) || (targetCleanName.Contains("horseshoe") && srcRecipient.Contains("horseshoe")))
                {
                    if (!donorEventsToUpdate.Any(e => e.Id == dev.Id)) donorEventsToUpdate.Add(dev);
                }
            }

            foreach (var t in talliesToSave.Where(t => t.Consumed > 0))
            {
                var ds = allDonatedStock.FirstOrDefault(d => d.ItemId == t.ItemId);
                int totalDonatedBottlesAvailable = ds != null ? ds.TotalCans : 0;
                int donatedUsedThisRun = Math.Min(t.Consumed, totalDonatedBottlesAvailable);

                if (donatedUsedThisRun > 0 && ds != null)
                {
                    int remainingToDeduct = donatedUsedThisRun;

                    if (!string.IsNullOrEmpty(localEvent.DonatedItemIdsJson))
                    {
                        remainingToDeduct = DeductFromDonatedJson(localEvent, t.ItemId, remainingToDeduct);
                    }

                    if (remainingToDeduct > 0)
                    {
                        foreach (var dev in donorEventsToUpdate.Where(d => d.Id != localEvent.Id))
                        {
                            remainingToDeduct = DeductFromDonatedJson(dev, t.ItemId, remainingToDeduct);
                            if (remainingToDeduct <= 0) break;
                        }
                    }
                }
            }
        }

        if (localEvent != null)
        {
            localEvent.BeerTalliesJson = talliesJson;
            localEvent.InitialAmount = evSnapshot.InitialAmount;
            localEvent.CurrentBalance = newBalance;
            localEvent.IsRecurring = evSnapshot.IsRecurring;
        }

        if (_selectedActiveEvent != null && _selectedActiveEvent.Id == evId)
        {
            _selectedActiveEvent.BeerTalliesJson = talliesJson;
            _selectedActiveEvent.CurrentBalance = newBalance;
        }

        // ── 2. SYNCHRONOUS SERVER & HARDWARE SYNC ─────────────────────
        try
        {
            var request = new UpdateEventTallyRequest
            {
                Id = evId,
                BeerTalliesJson = talliesJson,
                InitialAmount = evSnapshot.InitialAmount,
                CurrentBalance = newBalance,
                CloseEvent = closeEvent,
                DonatedItemIdsJson = localEvent?.DonatedItemIdsJson,
                DonatedItemTalliesJson = localEvent?.DonatedItemTalliesJson,
                IsRecurring = localEvent?.IsRecurring ?? evSnapshot.IsRecurring
            };

            var response = await Http.PostAsJsonAsync("api/pos/events/update-tally", request);
            if (response.IsSuccessStatusCode)
            {
                Console.WriteLine($"[POS] Settle & Update-tally succeeded for Event ID {evId}.");
            }
            else
            {
                var err = await response.Content.ReadAsStringAsync();
                Console.WriteLine($"[POS] Settle & Update-tally error for Event ID {evId}: {err}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[POS] SaveInlineTally HTTP error: {ex.Message}");
        }

        // Kick drawer hardware if club portion is owed
        decimal clubPortionOwed = 0m;
        foreach (var t in talliesToSave.Where(t => t.Consumed > 0))
        {
            var ds = allDonatedStock.FirstOrDefault(d => d.ItemId == t.ItemId);
            int totalDonatedBottles = ds != null ? ds.TotalCans : 0;
            int standardUsed = Math.Max(0, t.Consumed - totalDonatedBottles);
            clubPortionOwed += standardUsed * (t.EnableClubSplit ? t.ClubSplitAmount : t.Price);
        }

        if (clubPortionOwed > 0)
        {
            KickDrawerBackground();
            if (closeEvent)
            {
                int totalConsumedCount = talliesToSave.Sum(t => t.Consumed);
                ShowEventDepositBanner(clubPortionOwed, GetEventDisplayName(evSnapshot.Name), $"{totalConsumedCount} btls consumed");
            }
        }

        if (closeEvent && talliesToSave.Any(t => t.Consumed > 0))
        {
            bool hasSplit = talliesToSave.Any(t => (t.EnableClubSplit || (evSnapshot.Enable100PercentDonatedProceeds && !string.IsNullOrEmpty(evSnapshot.DonatedItemIdsJson))) && t.QuantityTaken > 0);
            var saleItems = new List<ProductItem>();
            foreach (var t in talliesToSave.Where(t => t.Consumed > 0))
            {
                decimal itemClubCost = GetTallyClubPortion(evSnapshot, t);
                decimal unitPrice = t.Consumed > 0 ? (itemClubCost / t.Consumed) : t.Price;
                saleItems.Add(new ProductItem
                {
                    Name = $"TALLY: {t.Name}",
                    Price = unitPrice,
                    Quantity = t.Consumed,
                    Category = "BEER"
                });
            }

            if (saleItems.Any())
            {
                decimal totalSaleAmount = talliesToSave.Sum(t => GetTallyClubPortion(evSnapshot, t));
                var settlementSale = new PosSaleDto
                {
                    Id = Guid.NewGuid(),
                    Timestamp = DateTime.Now,
                    TerminalName = TerminalName,
                    BartenderName = CurrentUserName,
                    PaymentType = hasSplit ? "EVENT SETTLEMENT (SPLIT)" : "EVENT SETTLEMENT",
                    TotalAmount = totalSaleAmount,
                    ActiveEventId = evId,
                    ItemsJson = JsonSerializer.Serialize(saleItems)
                };
                await PosService.SaveSaleAsync(settlementSale);
                await PosService.AddSaleToShiftAsync(settlementSale);
            }
        }

        if (_cachedMenu != null)
        {
            _cachedMenu.ActiveEvents = DbActiveEvents;
            _cachedMenu.EventTemplates = DbEventTemplates;
            try { await PosService.SaveMenuToVaultAsync(_cachedMenu); } catch {}
        }

        // ── 3. INSTANT UI UPDATE ──────────────────────────────────────
        CloseInlineTallyModal();

        if (closeEvent)
        {
            if (localEvent != null)
            {
                localEvent.Status = GFC.Core.Enums.EventTabStatus.Closed;
                DbActiveEvents.Remove(localEvent);
            }

            if (_selectedActiveEvent?.Id == evId)
            {
                var directEvent = DbActiveEvents?.FirstOrDefault(e => e.Name.EndsWith(" [Direct]") || e.Name.EndsWith("[Direct]"));
                _selectedActiveEvent = directEvent;
            }

            var closeVaultKey = $"gfc_pos_vault_event_close_{evId}";
            try { await JSRuntime.InvokeVoidAsync("window.gfcSetAsync", closeVaultKey, evId); } catch {}

            Toast.ShowSuccess("Event settled and closed successfully!");
        }
        else
        {
            Toast.ShowSuccess("Beer tallies saved successfully!");
        }

        StateHasChanged();
    }

