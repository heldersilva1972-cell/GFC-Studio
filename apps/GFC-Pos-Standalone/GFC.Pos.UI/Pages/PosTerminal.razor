    private bool IsEventDirect(ActiveEvent? ev) => ev != null && (ev.Name.EndsWith(" [Direct]") || ev.Name.EndsWith("[Direct]"));
    private string GetEventDisplayName(string name)
    {
        if (string.IsNullOrEmpty(name)) return "";
        if (name.EndsWith(" [Direct]")) return name.Substring(0, name.Length - 9);
        if (name.EndsWith("[Direct]")) return name.Substring(0, name.Length - 8);
        return name;
    }

