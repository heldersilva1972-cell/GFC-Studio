                        </div>
                        <p class="text-muted small mb-4 px-2">
                            @if (_existingPizzaPayoutSale != null)
                            {
                                <span>Recorded at <strong>@_existingPizzaPayoutSale.Timestamp.ToString("t")</strong> by <strong>@_existingPizzaPayoutSale.BartenderName</strong>. You can modify the amount or cancel this payout if made in error.</span>
                            }
                            else
                            {
                                <span>Confirming will deduct <strong>$@_dartPizzaPayoutAmount.ToString("F2")</strong> from the drawer, kick the register, and print a payout voucher.</span>
                            }
