    private async Task SyncUsers()
    {
        try 
        {
            Console.WriteLine("[POS] Starting SyncUsers()...");
            
            // We use HttpClient directly here to inspect the raw response if needed
            var users = await PosService.GetAuthorizedUsersAsync();
            
            if (users != null)
            {
                Console.WriteLine($"[POS] SyncUsers: Found {users.Count} authorized operators.");
                AuthorizedUsers = users;
                await InvokeAsync(StateHasChanged);
            }
            else
            {
                Console.WriteLine("[POS] SyncUsers: No authorized operators found (empty list or error).");
                // Check connectivity status
                var isServerUp = await Connectivity.CheckServerReachableAsync();
                Console.WriteLine($"[POS] Connectivity Status - Online: {Connectivity.IsOnline}, Server: {isServerUp}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[POS] SyncUsers CRITICAL ERROR: {ex.Message}");
        }
    }

