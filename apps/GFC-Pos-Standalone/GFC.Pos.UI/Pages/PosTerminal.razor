                /* Close Shift Out (High contrast red border / warning) */
                .tile-closeshift {
                    background: #fef2f2;
                    border: 2px solid #ef4444 !important;
                    color: #991b1b !important;
                }
                .tile-closeshift:hover {
                    background: #fee2e2;
                    box-shadow: 0 12px 24px rgba(239, 68, 68, 0.15);
                }
                .tile-closeshift .tile-icon-box {
                    background: #dc2626;
                    color: white;
                }
            </style>

        <div class="pos-options-fullpage">
