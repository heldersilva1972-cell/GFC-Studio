                <div class="d-flex align-items-center justify-content-between pb-3 border-bottom mb-3">
                    <div class="d-flex align-items-center gap-3">
                        <span class="rounded-circle bg-warning text-dark d-flex align-items-center justify-content-center shadow-sm" style="width: 44px; height: 44px; font-size: 1.5rem;">
