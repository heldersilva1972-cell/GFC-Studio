                                    <span class="small" style="font-size: 0.8rem; color: @(netOwed < 0 ? "#166534" : "#9a3412") !important;">
                                        @(netOwed < 0 ? "Return excess cash from drawer" : (hasSplit ? "Collect club portion to drawer" : "Collect payment for event tab"))
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="d-flex gap-3 mt-3">
                    <button type="button" class="btn btn-outline-primary rounded-pill py-3 fw-black flex-grow-1" @onclick="() => SaveInlineTally(false)" style="border-color: #2563eb; color: #2563eb; font-weight: 800; height: 54px;">
                        <i class="bi bi-save me-1"></i> SAVE PROGRESS
                    </button>
                    <button type="button" class="settings-footer-btn btn-close-out-yes flex-grow-2" style="background-color: #16a34a; margin: 0; color: white; height: 54px;" @onclick="() => SaveInlineTally(true)">
                        <i class="bi bi-check-circle-fill me-2"></i> SETTLE & CLOSE EVENT
                    </button>
                </div>
            }
        </div>
    </div>
}



@code {
    // ─── EVENT BEER INVENTORY TALLY DASHBOARD STATE ───
    private ActiveEvent? inlineTallyEvent;
    private string? inlineTallyMode;
    private List<BeerTallyItem> currentTallies = new();
    private int selectedBeerIdToAdd;

    public class BeerTallyItem
    {
        public int ItemId { get; set; }
        public string Name { get; set; } = string.Empty;
        public decimal Price { get; set; }
        public int QuantityTaken { get; set; }
        public int QuantityReturned { get; set; }
        public int Consumed => Math.Max(0, QuantityTaken - QuantityReturned);
        public decimal Subtotal => Consumed * Price;
        public bool EnableClubSplit { get; set; }
        public decimal ClubSplitAmount { get; set; }
        public decimal ClubSubtotal => Consumed * (EnableClubSplit ? ClubSplitAmount : Price);
        public decimal EventSubtotal => Consumed * (EnableClubSplit ? Math.Max(0, Price - ClubSplitAmount) : 0);
    }

    private List<BeerTallyItem> GetActiveEventTallies(ActiveEvent ae)
    {
        if (string.IsNullOrEmpty(ae.BeerTalliesJson)) return new List<BeerTallyItem>();
        try
        {
            return global::System.Text.Json.JsonSerializer.Deserialize<List<BeerTallyItem>>(
                ae.BeerTalliesJson,
                new global::System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true }
            ) ?? new();
        }
        catch
        {
            return new List<BeerTallyItem>();
        }
    }

    private bool HasRemovedBeers(ActiveEvent ae)
    {
        var tallies = GetActiveEventTallies(ae);
        return tallies.Any(t => t.QuantityTaken > 0);
    }

    private decimal CalculateRemovedValue(ActiveEvent ae)
    {
        var tallies = GetActiveEventTallies(ae);
        return tallies.Sum(t => t.QuantityTaken * t.Price);
    }

    private decimal CalculateConsumedValue(ActiveEvent ae)
    {
        var tallies = GetActiveEventTallies(ae);
        return tallies.Sum(t => t.Consumed * t.Price);
    }

    private void StartInlineTallyEdit(ActiveEvent ae, string mode)
    {
        inlineTallyEvent = ae;
        inlineTallyMode = mode;
        currentTallies = new List<BeerTallyItem>();
        selectedBeerIdToAdd = 0;

        // Load existing tallies if any
        if (!string.IsNullOrEmpty(ae.BeerTalliesJson))
        {
            try
            {
                currentTallies = global::System.Text.Json.JsonSerializer.Deserialize<List<BeerTallyItem>>(
                    ae.BeerTalliesJson, 
                    new global::System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true }
                ) ?? new();
            }
            catch (Exception)
            {
                currentTallies = new();
            }
        }

        // Always ensure ALL active beer items from DB are included
        if (DbItems != null)
        {
            var templateOverrides = new List<BanquetOverrideDto>();
            if (ae.Template != null && !string.IsNullOrEmpty(ae.Template.ItemsOverrideJson))
            {
                try
                {
                    templateOverrides = global::System.Text.Json.JsonSerializer.Deserialize<List<BanquetOverrideDto>>(
                        ae.Template.ItemsOverrideJson,
                        new global::System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true }
                    ) ?? new();
                }
                catch (Exception) { }
            }

            foreach (var item in DbItems.Where(i => i.Category.Trim().ToUpper() == "BEER"))
            {
                var existing = currentTallies.FirstOrDefault(t => t.ItemId == item.Id);
                var ov = templateOverrides.FirstOrDefault(o => o.ItemId == item.Id);

                // Determine if we should include this beer item on the tally sheet
                bool shouldInclude = false;
                if (existing != null)
                {
                    shouldInclude = true; // Keep already-tally-tracked items
                }
                else if (templateOverrides.Any())
                {
                    shouldInclude = ov != null && ov.TrackTally; // Filter by the new toggle
                }
                else
                {
                    shouldInclude = true; // Default fallback for backward compatibility
                }

                if (shouldInclude)
                {
                    if (existing == null)
                    {
                        decimal price = ov != null ? ov.OverridePrice : item.Price;
                        currentTallies.Add(new BeerTallyItem
                        {
                            ItemId = item.Id,
                            Name = item.Name,
                            Price = price,
                            QuantityTaken = 0,
                            QuantityReturned = 0,
                            EnableClubSplit = ov?.EnableClubSplit ?? false,
                            ClubSplitAmount = ov?.ClubSplitAmount ?? 0
                        });
                    }
                    else
                    {
                        if (ov != null)
                        {
                            existing.Price = ov.OverridePrice;
                            existing.EnableClubSplit = ov.EnableClubSplit;
                            existing.ClubSplitAmount = ov.ClubSplitAmount;
                        }
                    }
                }
            }
        }
    }

    private void CloseInlineTallyModal()
    {
        inlineTallyEvent = null;
        inlineTallyMode = null;
        currentTallies = new List<BeerTallyItem>();
    }

    private void AddBeerToTallySheet()
    {
        if (selectedBeerIdToAdd == 0 || DbItems == null) return;

        var liquorItem = DbItems.FirstOrDefault(i => i.Id == selectedBeerIdToAdd);
        if (liquorItem != null)
        {
            if (!currentTallies.Any(t => t.ItemId == liquorItem.Id))
            {
                currentTallies.Add(new BeerTallyItem
                {
                    ItemId = liquorItem.Id,
                    Name = liquorItem.Name,
                    Price = liquorItem.Price,
                    QuantityTaken = 0,
                    QuantityReturned = 0
                });
            }
        }
        selectedBeerIdToAdd = 0; // reset
    }

    private void RemoveBeerFromTallySheet(BeerTallyItem t)
    {
        currentTallies.Remove(t);
    }

    private async Task SaveInlineTally(bool closeEvent)
    {
        if (inlineTallyEvent == null) return;

        // Perform sanity check: Returned cannot exceed Taken
        foreach (var t in currentTallies)
        {
            if (t.QuantityReturned > t.QuantityTaken)
            {
                await JSRuntime.InvokeVoidAsync("alert", $"For {t.Name}, quantity returned ({t.QuantityReturned}) cannot exceed quantity taken ({t.QuantityTaken}).");
                return;
            }
        }

        try
        {
            var evId = inlineTallyEvent.Id;
            var localEvent = DbActiveEvents.FirstOrDefault(e => e.Id == evId);
            
            var talliesJson = global::System.Text.Json.JsonSerializer.Serialize(currentTallies);
            decimal totalConsumedCost = currentTallies.Sum(t => t.Subtotal);
            decimal newBalance = 0;
            
            if (inlineTallyEvent.Type == GFC.Core.Enums.EventTabType.PrePaid)
            {
                newBalance = inlineTallyEvent.InitialAmount - totalConsumedCost;
            }
            else
            {
                newBalance = -totalConsumedCost;
            }

            if (localEvent != null)
            {
                localEvent.BeerTalliesJson = talliesJson;
                localEvent.InitialAmount = inlineTallyEvent.InitialAmount;
                localEvent.CurrentBalance = newBalance;
                
                if (closeEvent)
                {
                    localEvent.Status = GFC.Core.Enums.EventTabStatus.Closed;
                    DbActiveEvents.Remove(localEvent);
                }
            }

            // Sync menu to vault
            if (_cachedMenu != null)
            {
                _cachedMenu.ActiveEvents = DbActiveEvents;
                await PosService.SaveMenuToVaultAsync(_cachedMenu);
            }

            // Prepare HTTP Request
            var request = new UpdateEventTallyRequest
            {
                Id = evId,
                BeerTalliesJson = talliesJson,
                InitialAmount = inlineTallyEvent.InitialAmount,
                CurrentBalance = newBalance,
                CloseEvent = closeEvent
            };

            // Queue in IndexedDB outbox for offline sync (similar to add-funds)
            var syncKey = $"gfc_pos_vault_event_tally_{Guid.NewGuid()}";
            try
            {
                await JSRuntime.InvokeVoidAsync("window.gfcSetAsync", syncKey, request);
            }
            catch {}

            try
            {
                // Send background update
                _ = Http.PostAsJsonAsync("api/pos/events/update-tally", request);
            }
            catch {}

            CloseInlineTallyModal();
            StateHasChanged();
            
            if (closeEvent)
            {
                Toast.ShowSuccess("Event settled and closed successfully!");
            }
            else
            {
                Toast.ShowSuccess("Beer tallies saved successfully!");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[POS] Error saving event tally: {ex.Message}");
            Toast.ShowError("Failed to save beer tallies.");
        }
    }

