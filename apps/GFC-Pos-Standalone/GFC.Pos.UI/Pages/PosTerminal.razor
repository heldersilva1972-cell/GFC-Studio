            _payoutCategories = new() { "FOOD", "SUPPLIES", "MAINTENANCE", "REBATE/REFUND", "OTHER" };
        }



        Connectivity.ConnectivityChanged += OnConnectivityChanged;
        PosService.OutboxChanged += OnOutboxChanged;
        PosService.MenuRefreshed += OnMenuRefreshed;
        
        await PosService.GetTotalPendingAsync();
        
        // Load Idle Settings
        var idleStored = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "gfc_pos_idle_timeout");
