        }
    }

    private async Task OpenDrawPortal()
    {
        showOptionsMenu = false;
        _drawManualInput = "";
        _drawResult = null;
        _drawError = "";
        _hasDrawn = false;
        _drawnMemberId = null;
        _reelCount = 4;

        // PERFORMANCE: Parallelise the 3 localStorage reads instead of awaiting each one.
        var nameTask  = JSRuntime.InvokeAsync<string>("localStorage.getItem", "gfc_last_drawn_member_name").AsTask();
        var timeTask  = JSRuntime.InvokeAsync<string>("localStorage.getItem", "gfc_last_drawn_member_time").AsTask();
        var elTask    = JSRuntime.InvokeAsync<string>("localStorage.getItem", "gfc_last_drawn_member_eligible").AsTask();

        // Re-initialize arrays for standard safety (sync — no await needed)
        _reelDigits   = new int[_reelCount];
        _reelOffsets  = new int[_reelCount];
        _reelClasses  = new string[_reelCount];
        _reelDurations = new double[_reelCount];
        for (int i = 0; i < _reelCount; i++)
        {
            _reelDigits[i]   = 0;
            _reelOffsets[i]  = 0;
            _reelClasses[i]  = "";
            _reelDurations[i] = 0;
        }

        // Show the draw modal immediately — don't wait for localStorage
        showDrawModal = true;
        StateHasChanged();

        try
        {
            await Task.WhenAll(nameTask, timeTask, elTask);
            _previousDrawName    = nameTask.Result ?? "";
            _previousDrawTime    = timeTask.Result ?? "";
            var elJson           = elTask.Result ?? "false";
            _previousDrawEligible = bool.TryParse(elJson, out var result) && result;
        }
        catch { }

        try
        {
            var pool = await PosService.GetMemberDrawPoolAsync();
            if (pool != null)
            {
                _drawPool    = pool.MemberIds ?? new();
                _maxMemberId = pool.MaxMemberId;
                _reelCount   = Math.Max(3, _maxMemberId.ToString().Length);
                
                // Re-initialize arrays with dynamic length
                _reelDigits   = new int[_reelCount];
                _reelOffsets  = new int[_reelCount];
                _reelClasses  = new string[_reelCount];
                _reelDurations = new double[_reelCount];
                for (int i = 0; i < _reelCount; i++)
                {
                    _reelDigits[i]   = 0;
                    _reelOffsets[i]  = 0;
                    _reelClasses[i]  = "";
                    _reelDurations[i] = 0;
                }

                _allMembers = pool.Members ?? new();
                _activeAlphaLetters = _allMembers
                    .Select(m => {
                        var targetName = !string.IsNullOrEmpty(m.LastName) ? m.LastName : m.FirstName;
                        return string.IsNullOrEmpty(targetName) ? ' ' : char.ToUpper(targetName[0]);
                    })
                    .Where(c => c >= 'A' && c <= 'Z')
                    .ToHashSet();
                _lookupMode = "ID";
                _selectedAlphaLetter = "";
                _alphaMatches.Clear();
            }
            else
            {
                _drawError = "Failed to load member pool. Make sure terminal is online or has cached records.";
            }
        }
        catch (Exception ex)
        {
            _drawError = $"Error retrieving member pool: {ex.Message}";
        }
        StateHasChanged();
    }

    private void DrawKeypadPress(string key)
    {
        if (_isDrawing) return;
        
        _drawnMemberId = null; // Clear previous drawing state if user interacts manually

        if (key == "DEL")
        {
            if (_drawManualInput.Length > 0)
            {
                _drawManualInput = _drawManualInput.Substring(0, _drawManualInput.Length - 1);
            }
            _drawResult = null;
            _drawError = "";
        }
        else if (key == "CLR")
        {
            _drawManualInput = "";
            _drawResult = null;
            _drawError = "";
        }
        else if (key == "ENT")
        {
            if (!string.IsNullOrEmpty(_drawManualInput))
            {
                _ = ValidateManualMemberId();
            }
        }
        else
        {
            if (_drawManualInput.Length < _reelCount)
            {
                _drawManualInput += key;
                _drawResult = null;
                _drawError = "";
            }
        }
        
        StateHasChanged();
    }

    private async Task RecordManualDraw()
    {
        if (_drawResult == null) return;

        _previousDrawName = $"#{_drawResult.MemberId} - {_drawResult.FirstName} {_drawResult.LastName}";
        _previousDrawTime = DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss");
        _previousDrawEligible = _drawResult.IsEligible;

        try
        {
            await JSRuntime.InvokeVoidAsync("localStorage.setItem", "gfc_last_drawn_member_name", _previousDrawName);
            await JSRuntime.InvokeVoidAsync("localStorage.setItem", "gfc_last_drawn_member_time", _previousDrawTime);
            await JSRuntime.InvokeVoidAsync("localStorage.setItem", "gfc_last_drawn_member_eligible", _previousDrawEligible.ToString().ToLower());

            await AddToDrawHistory(_drawResult.MemberId, $"{_drawResult.FirstName} {_drawResult.LastName}", _previousDrawTime, _previousDrawEligible);
        }
        catch { }

        // Clear manual lookup state to show it was recorded
        _drawManualInput = "";
        _drawResult = null;
        _drawError = "";

        StateHasChanged();
    }

