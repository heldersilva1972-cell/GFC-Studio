                }
                .tile-payout:hover {
                    background: #fef08a;
                    box-shadow: 0 12px 24px rgba(245, 158, 11, 0.15);
                }
                .tile-payout .tile-icon-box {
                    background: #f59e0b;
                    color: white;
                }

                /* Print X-Report (Emerald/Teal) */
                .tile-xreport {
                    background: #ecfdf5;
                    border-color: #a7f3d0;
                    color: #065f46 !important;
                }
                .tile-xreport:hover {
                    background: #d1fae5;
                    box-shadow: 0 12px 24px rgba(16, 185, 129, 0.15);
                }
                .tile-xreport .tile-icon-box {
                    background: #10b981;
                    color: white;
                }

                /* Reprint Z-Report (Rose/Red) */
                .tile-zreport {
                    background: #fff1f2;
                    border-color: #fecdd3;
                    color: #9f1239 !important;
                }
