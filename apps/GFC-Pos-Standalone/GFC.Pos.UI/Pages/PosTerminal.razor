    private void ChargeToTab()
    {
        if (CartItems.Count == 0) return;
        
        if (_selectedActiveEvent == null)
        {
            var directEvent = DbActiveEvents?.FirstOrDefault(ev => ev.Name.EndsWith(" [Direct]") || ev.Name.EndsWith("[Direct]"));
            if (directEvent != null)
            {
                _selectedActiveEvent = directEvent;
            }
            else
            {
                return;
            }
        }
        
        if (_selectedActiveEvent.Type == GFC.Core.Enums.EventTabType.PrePaid && _selectedActiveEvent.CurrentBalance < Subtotal)
        {
            ShowNotice("Insufficient Funds on Tab", 
                $"This pre-paid tab only has {_selectedActiveEvent.CurrentBalance:C} remaining, but the total is {Subtotal:C}. Please remove an item, or ring up {_selectedActiveEvent.CurrentBalance:C} to the tab, and the rest to Cash/Card.", 
                "warning", null, "RETURN TO ORDER");
            if (IsEventDirect(_selectedActiveEvent))
            {
                _selectedActiveEvent = null;
            }
            return;
        }
        
        _isTabPayment = true;
        _ = FinalizeSale();
    }

