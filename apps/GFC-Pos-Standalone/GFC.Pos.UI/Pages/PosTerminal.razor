            // 2. [BACKGROUND-INIT] Now handle connectivity and network sync sequentially and safely
            await Connectivity.InitializeAsync();
            await LoadTerminalName();
            await PosService.InitializeAsync();
            await RefreshData(cacheOnly: false);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[POS] Initialization Error: {ex.Message}");
            Toast.ShowError("Error starting up services.");
        }
        finally
        {
            _isInitialLoading = false;
        }
        
        // [AUTO-SYNC] Load from vault instantly, then background refresh from server
        _ = SyncUsers();
        // [INVENTORY WARM-UP] Pre-cache liquor inventory in background so it's available offline
        _ = Task.Run(async () => {
            try { await PosService.GetLiquorInventoryAsync(force: false); }
            catch { }
        });
        
        var trainingStored = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "gfc_pos_training_mode");
        if (!string.IsNullOrEmpty(trainingStored)) forceTrainingMode = bool.Parse(trainingStored);
        
        var voucherStored = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "gfc_pos_print_payout_voucher");
        if (!string.IsNullOrEmpty(voucherStored)) _printPayoutVoucher = bool.Parse(voucherStored);

        var dynamicTokenModeStored = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "gfc_pos_dynamic_token_mode");
        if (!string.IsNullOrEmpty(dynamicTokenModeStored)) _dynamicTokenMode = bool.Parse(dynamicTokenModeStored);

        var bannerDurationStored = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "gfc_pos_change_due_banner_duration");
        if (!string.IsNullOrEmpty(bannerDurationStored) && int.TryParse(bannerDurationStored, out var durVal)) _changeDueBannerDurationSeconds = durVal;

        var sizeStored = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "gfc_pos_print_bottle_size");
        if (!string.IsNullOrEmpty(sizeStored)) _printBottleSize = bool.Parse(sizeStored);

        // Load selected liquor inventory categories
        try
        {
            var catsStored = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "gfc_pos_liquor_inventory_categories");
            if (!string.IsNullOrEmpty(catsStored))
            {
                _selectedLiquorCategories = JsonSerializer.Deserialize<List<string>>(catsStored) ?? new();
            }
        }
        catch {}

        // Populate all liquor categories from cached/local items
        try
        {
            var items = await PosService.GetLiquorInventoryAsync();
            if (items != null)
            {
                _allLiquorCategories = items
                    .Where(i => i.IsActive)
