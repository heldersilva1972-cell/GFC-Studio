    private void HandleLiquorKeypadPress(string key)
    {
        if (_selectedLiquorOrder == null) return;
        if (!_isEditingTotalMode)
        {
            if (key == "DEL")
            {
                if (_invoiceInputString.Length > 0)
                    _invoiceInputString = _invoiceInputString[..^1];
            }
            else if (key == "CLR")
            {
                _invoiceInputString = "";
            }
            else
            {
                _invoiceInputString += key;
            }
        }
        else
        {
            if (key == "DEL")
            {
                if (_invoiceTotalString.Length > 0)
                    _invoiceTotalString = _invoiceTotalString[..^1];
            }
            else if (key == "CLR")
            {
                _invoiceTotalString = "";
            }
            else if (key == "EXPECTED")
            {
                _invoiceTotalString = _selectedLiquorOrder.TotalCost.ToString("F2");
            }
            else if (key == ".")
            {
                if (!_invoiceTotalString.Contains("."))
                    _invoiceTotalString += ".";
            }
            else if (key == "INV-" || key == "-")
            {
                // Ignore hyphen/alphanumeric prefix in amount total mode
            }
            else
            {
                _invoiceTotalString += key;
            }

            if (decimal.TryParse(_invoiceTotalString, out var parsed))
            {
                _invoiceTotalDue = parsed;
            }
            else
            {
                _invoiceTotalDue = 0;
            }
        }
        StateHasChanged();
    }

    private async Task ConfirmReceiveLiquorOrder()
    {
        if (_selectedLiquorOrder == null) return;

        try
        {
            // Guard: invoice total must be greater than zero before queuing
            if (_invoiceTotalDue <= 0)
            {
                Toast.ShowError("Invoice total must be greater than $0.00. Please enter the actual amount due before confirming.");
                return;
            }

            // Find active logged in bartender ID or default to 1 (fallback)
            int activeUserId = 1;
            if (!string.IsNullOrEmpty(CurrentUserName))
            {
                var matchingUser = AuthorizedUsers?.FirstOrDefault(u => u.Username.Equals(CurrentUserName, StringComparison.OrdinalIgnoreCase));
                if (matchingUser != null)
                {
                    activeUserId = matchingUser.UserId;
                }
            }

            var receipt = new LiquorOrderReceiptDto
            {
                OrderId = _selectedLiquorOrder.Id,
                InvoiceNumber = _invoiceInputString,
                TotalDue = _invoiceTotalDue,
                BackorderedOrderItemIds = new List<int>(_selectedBackorderItemIds),
                UserId = activeUserId
            };

            Console.WriteLine($"[POS] Submitting liquor order receive for Order #{receipt.OrderId}. Invoice: {receipt.InvoiceNumber}, Total: {receipt.TotalDue}");
            
            if (forceTrainingMode)
            {
                Toast.ShowSuccess("Delivery received in memory (Training Mode)!");
                
                var orderToRemove = _selectedLiquorOrder;
                _selectedLiquorOrder = null;
                await OpenLiquorOrdersWorkflow();
                
                // Remove from pending list in memory so it disappears from the current training screen
                _pendingLiquorOrders.RemoveAll(o => o.Id == orderToRemove.Id);
                StateHasChanged();
                return;
            }

            // Receive and cache / queue transaction in the background outbox
            await PosService.ReceiveLiquorOrderAsync(receipt);

            Toast.ShowSuccess("Delivery received successfully! Local inventory stocks updated.");
            
            // Refresh list and close / reset
            _selectedLiquorOrder = null;
            await OpenLiquorOrdersWorkflow();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[POS] ConfirmReceiveLiquorOrder Error: {ex.Message}");
            Toast.ShowError($"Failed to receive delivery: {ex.Message}");
        }
    }

