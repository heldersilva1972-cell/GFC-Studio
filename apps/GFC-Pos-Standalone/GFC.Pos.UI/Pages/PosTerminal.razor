                .options-section-header i {
                    font-size: 1.1rem;
                }
                .options-section-grid {
                    display: flex;
                    flex-direction: column;
                    gap: 8px;
                    flex: 1;
                }

                .option-tile-large {
                    grid-column: span 3;
                    background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%);
