        color: #ffffff !important;
    }
    .pos-cart.upstairs-mode-active .cart-header .btn-clear-header {
        background: rgba(255, 255, 255, 0.15) !important;
        color: #ffffff !important;
        border: 1px solid rgba(255, 255, 255, 0.3) !important;
    }
    .pos-cart.upstairs-mode-active .cart-header .btn-clear-header:hover {
        background: rgba(255, 255, 255, 0.35) !important;
        color: #ffffff !important;
    }
    .pos-cart.upstairs-mode-active .cart-footer {
