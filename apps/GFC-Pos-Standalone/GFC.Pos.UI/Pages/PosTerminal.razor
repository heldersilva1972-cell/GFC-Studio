    private bool showRedeemOverlay = false;
    private bool showSuccessOverlay = false;
    private bool showCloseOutSuccessOverlay = false;
    private bool isDartsModeActive = false;
    private bool _isInitialLoading = true;
    private bool showOptionsMenu = false;
    private bool showBanquetsModal = false;
    private int _newBanquetTemplateId = 0;
    private decimal _newBanquetAmount = 0;
    private bool _newEventDirectCheckout = false;
    private ActiveEvent? _selectedBanquetToAddFunds = null;
    private decimal _addFundsAmount = 0;
    private bool _disposed = false;
    private bool isSyncing = false;
    
    // SMART TOKEN STATE
    private bool showTokenCreditSelection = false;
    private bool _isTokenUpgradeMode = false; // New state to track path
    private PosToken? _pendingTokenForCredit = null;
    private IEnumerable<ProductItem> CreditEligibleItems
    {
        get
        {
            if (_pendingTokenForCredit == null) return Enumerable.Empty<ProductItem>();

            // Find the "Base Category" of the token by looking at what it covers for free
            var baseCategories = new HashSet<string>();
            if (!string.IsNullOrEmpty(_pendingTokenForCredit.EligibleItemIds))
            {
                var ids = _pendingTokenForCredit.EligibleItemIds.Split(',', StringSplitOptions.RemoveEmptyEntries)
                            .Select(id => int.TryParse(id, out int val) ? val : (int?)null)
                            .Where(id => id.HasValue)
                            .Select(id => id!.Value);
                
                foreach(var id in ids)
                {
                    var item = DbItems.FirstOrDefault(x => x.Id == id);
                    if (item != null && !string.IsNullOrEmpty(item.Category))
                        baseCategories.Add(item.Category.Trim().ToUpper());
                }
            }

            return CartItems.Where(i => 
                !i.IsTokenApplied && 
                i.Price > 0 && 
                IsCategoryEligibleForToken(i.Category) &&
                !baseCategories.Contains(i.Category.Trim().ToUpper()) // [FIX] Exclude same-category items
            ).ToList();
        }
    }

    private bool IsCategoryEligibleForToken(string? category)
    {
        if (_pendingTokenForCredit == null || string.IsNullOrEmpty(category)) return false;
        if (string.IsNullOrEmpty(_pendingTokenForCredit.CreditEligibleCategories)) return true; // Default to all if empty but upgrade enabled
        var allowed = _pendingTokenForCredit.CreditEligibleCategories.Split(',', StringSplitOptions.RemoveEmptyEntries);
        return allowed.Contains(category.Trim().ToUpper());
    }
    
    private DateTime _lastActivity = DateTime.Now;
    private int _idleTimeoutMinutes = 5;

    private decimal? CashReceived = null;
    private string CashInputString = "";
    private decimal ChangeDue => (CashReceived ?? 0) - Subtotal;

    private Dictionary<int, int> ItemFrequency = new();
    private List<int> SpeedBarItemIds = new();
    private IEnumerable<ProductItem> PopularItems => SpeedBarItemIds.Take(6).Select(id => DbItems.FirstOrDefault(x => x.Id == id)).Where(x => x != null);

    private IEnumerable<ProductItem> FilteredItems
    {
        get
        {
            var category = (ActiveCategory ?? "").Trim().ToUpper();
            var items = DbItems.AsEnumerable();

            if (category == "DARTS CLUB ROUND")
            {
                items = items.Where(i => (i.Category ?? "").Trim().ToUpper() == "BEER" || (i.Category ?? "").Trim().ToUpper() == "LIQUOR");
            }
            else
            {
                items = items.Where(i => (i.Category ?? "").Trim().ToUpper() == category);
            }

            if (_selectedActiveEvent != null)
            {
                var template = DbEventTemplates?.FirstOrDefault(t => t.Id == _selectedActiveEvent.TemplateId);
                if (template != null && !string.IsNullOrEmpty(template.ItemsOverrideJson))
                {
                    try
                    {
                        var overrides = System.Text.Json.JsonSerializer.Deserialize<List<BanquetOverrideDto>>(template.ItemsOverrideJson, new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true }) ?? new();
                        var visibleOverrides = overrides.Where(o => o.IsVisible).ToList();
                        var visibleItemIds = visibleOverrides.Select(o => o.ItemId).ToList();
                        
                        if (!visibleItemIds.Any())
                        {
                            // No overrides defined — show all items at standard prices
                            return items
                                .OrderBy(x => x.DisplayOrder)
                                .ThenBy(x => x.Name)
                                .ToList();
                        }
                        
                        items = items.Where(i => visibleItemIds.Contains(i.Id));

                        return items
                            .Select(i =>
                            {
                                var ov = visibleOverrides.FirstOrDefault(o => o.ItemId == i.Id);
                                // Use the override price only when it has been explicitly set (> 0).
                                // An OverridePrice of 0 means the admin left it at the default, so fall back to retail.
                                var effectivePrice = (ov != null && ov.OverridePrice > 0) ? ov.OverridePrice : i.Price;
                                return new ProductItem
                                {
                                    Id = i.Id,
                                    Name = i.Name,
                                    Price = effectivePrice,
                                    Category = i.Category,
                                    DisplayOrder = i.DisplayOrder,
                                    Modifiers = new List<ProductItem>()
                                };
                            })
                            .OrderBy(x => x.DisplayOrder)
                            .ThenBy(x => x.Name)
                            .ToList();
                    }
                    catch (Exception ex)
                    {
                        Console.WriteLine($"[POS] Error processing banquet overrides for active event {_selectedActiveEvent.Name}: {ex.Message}");
                        // Fall back to standard prices on JSON errors
                        return items
                            .OrderBy(x => x.DisplayOrder)
                            .ThenBy(x => x.Name)
                            .ToList();
                    }
                }
                else
                {
                    // No custom menu defined — show all items at standard prices
                    return items
                        .OrderBy(x => x.DisplayOrder)
                        .ThenBy(x => x.Name)
                        .ToList();
                }
            }

            return items
                .OrderBy(x => x.DisplayOrder)
                .ThenBy(x => x.Name)
                .ToList();
        }
    }

    private DateTime _lastResetCheck = DateTime.MinValue;
    private DateTime GetBusinessDayStart()
    {
        var now = DateTime.Now;
        // If it's before 3am, the business day started at 3am yesterday.
        if (now.Hour < 3) return now.Date.AddDays(-1).AddHours(3);
        // If it's after 3am, the business day started at 3am today.
        return now.Date.AddHours(3);
    }

    private void CheckDailyReset()
    {
        var dayStart = GetBusinessDayStart();
        if (_lastResetCheck < dayStart)
        {
            Console.WriteLine($"[POS] 3AM DAILY RESET: Starting fresh for business day {dayStart:g}");
            ItemFrequency.Clear();
            SpeedBarItemIds.Clear();
            _lastResetCheck = DateTime.Now;
            UpdateSpeedBar();
        }
    }

    private bool _showLoginSplash = false;
    private string _splashUserName = "";

    protected override async Task OnInitializedAsync()
    {
        _isInitialLoading = true;
        
        // 1. [HYDRATE-FIRST] Load from local device immediately
        // Do not wait for connectivity checks or terminal names
        await RefreshData(cacheOnly: true);

        // 2. [BACKGROUND-INIT] Now handle connectivity and network sync
        _ = Task.Run(async () => {
            await Connectivity.InitializeAsync();
            await LoadTerminalName();
            await RefreshData(cacheOnly: false);
        });
        
        _isInitialLoading = false;
        
        // [AUTO-SYNC] Load from vault instantly, then background refresh from server
        _ = SyncUsers(); 
        
        var trainingStored = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "gfc_pos_training_mode");
        if (!string.IsNullOrEmpty(trainingStored)) forceTrainingMode = bool.Parse(trainingStored);

        // HARDENED LOAD: The source of truth is now the Database (Shift Log)
        await UpdateAuditAsync();
        
        var hardwareStored = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "gfc_pos_hardware_practice");
        if (!string.IsNullOrEmpty(hardwareStored)) allowHardwareInTraining = bool.Parse(hardwareStored);



        Connectivity.ConnectivityChanged += OnConnectivityChanged;
        PosService.OutboxChanged += OnOutboxChanged;
        PosService.MenuRefreshed += OnMenuRefreshed;
        
        await PosService.GetTotalPendingAsync();
        
        // Load Idle Settings
        var idleStored = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "gfc_pos_idle_timeout");
        if (int.TryParse(idleStored, out var mins)) _idleTimeoutMinutes = mins;

        // Load Last Sale Bar Setting
        var lastBarStored = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "gfc_pos_show_last_sale_bar");
        if (!string.IsNullOrEmpty(lastBarStored)) _showLastSaleBar = bool.Parse(lastBarStored);

        // [AUTO-REFRESH] Background poll for new users and security checks
        _ = StartAuthPolling();

        // Populate Last Sale from Audit
        var audit = await PosService.GetShiftAuditAsync();
        _lastSale = audit.LatestSale;

        // Initialize Activity Tracker
        await JSRuntime.InvokeVoidAsync("GfcIdleTracker.initialize", DotNetObjectReference.Create(this));

        // Initialize Card Scanner
        await JSRuntime.InvokeVoidAsync("GfcCardScanner.initialize", DotNetObjectReference.Create(this));

        // [INSTANT-UPDATE] Check for update immediately on startup
        _ = Task.Run(async () => {
            await Task.Delay(2000); 
            await CheckForUpdatesAsync();
        });

        // Initialize Popular Items for current business day
        _lastResetCheck = DateTime.Now;
        var dayStart = GetBusinessDayStart();
        var allSales = await PosService.GetShiftAuditAsync(); 
        // For now, we initialize fresh or rely on the shift-persistence.
        UpdateSpeedBar();
    }
    
