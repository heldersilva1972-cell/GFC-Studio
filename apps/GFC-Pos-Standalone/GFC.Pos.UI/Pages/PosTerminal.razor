    private string _banquetNumpadValue = "0";
    private bool _isFirstKeyAfterFocus = true;

    private void HandleBanquetNumpad(string key)
    {
        if (key == "C")
        {
            _banquetNumpadValue = "0";
            _isFirstKeyAfterFocus = true;
        }
        else if (key == ".")
        {
            if (!_banquetNumpadValue.Contains("."))
                _banquetNumpadValue += ".";
            _isFirstKeyAfterFocus = false;
        }
        else
        {
            if (_isFirstKeyAfterFocus || _banquetNumpadValue == "0")
            {
                _banquetNumpadValue = key;
                _isFirstKeyAfterFocus = false;
            }
            else
            {
                if (_banquetNumpadValue.Contains(".") && _banquetNumpadValue.Split('.')[1].Length >= 2) return;
                _banquetNumpadValue += key;
            }
        }

        if (decimal.TryParse(_banquetNumpadValue, out var val))
        {
            if (_selectedBanquetToAddFunds != null)
                _addFundsAmount = val;
            else
                _newBanquetAmount = val;
        }
    }

    private async Task StartBanquet()
    {
        if (_newBanquetTemplateId == 0 || _newBanquetAmount <= 0) return;
        var template = DbEventTemplates.FirstOrDefault(t => t.Id == _newBanquetTemplateId);
        if (template == null) return;

        try
        {
            var newEvent = new ActiveEvent
            {
                Name = template.Name,
                Type = template.DefaultType,
                CurrentBalance = _newBanquetAmount,
                Status = GFC.Core.Enums.EventTabStatus.Open
            };
            
            var response = await Http.PostAsJsonAsync("api/pos/events/start", newEvent);
            if (response.IsSuccessStatusCode)
            {
                var created = await response.Content.ReadFromJsonAsync<ActiveEvent>();
                await LogTabDeposit(template.Name, _newBanquetAmount, created?.Id);
                Toast.ShowSuccess("Banquet started and cash logged!");
                _newBanquetTemplateId = 0;
                _newBanquetAmount = 0;
                await RefreshData();
            }
            else
            {
                Toast.ShowError("Server error starting event");
            }
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Error: {ex.Message}");
        }
    }

    private async Task ConfirmAddFunds()
    {
        if (_selectedBanquetToAddFunds == null || _addFundsAmount <= 0) return;

        try
        {
            var request = new AddFundsRequest { Id = _selectedBanquetToAddFunds.Id, Amount = _addFundsAmount };
            var response = await Http.PostAsJsonAsync("api/pos/events/add-funds", request);
            if (response.IsSuccessStatusCode)
            {
                await LogTabDeposit(_selectedBanquetToAddFunds.Name, _addFundsAmount, _selectedBanquetToAddFunds.Id);
                Toast.ShowSuccess("Funds added and cash logged!");
                _selectedBanquetToAddFunds = null;
                _addFundsAmount = 0;
                await RefreshData();
            }
            else
            {
                Toast.ShowError("Server error adding funds");
            }
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Error: {ex.Message}");
        }
    }

    private async Task CloseBanquet(ActiveEvent ev)
    {
        try
        {
            var response = await Http.PostAsync($"api/pos/events/close/{ev.Id}", null);
            if (response.IsSuccessStatusCode)
            {
                Toast.ShowSuccess("Banquet closed");
                await RefreshData();
            }
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Error: {ex.Message}");
        }
    }

    private async Task LogTabDeposit(string eventName, decimal amount, int? eventId)
    {
        var depositSale = new PosSaleDto
        {
            Id = Guid.NewGuid(),
            Timestamp = DateTime.UtcNow,
            TerminalName = TerminalName,
            BartenderName = CurrentUserName,
            TotalAmount = amount,
            PaymentType = "CASH",
            OriginalTotal = amount,
            AmountReceived = amount,
            ChangeDue = 0,
            ActiveEventId = eventId,
            ItemsJson = JsonSerializer.Serialize(new List<ProductItem>
            {
                new ProductItem { 
                    Id = 0, 
                    Name = $"TAB DEPOSIT: {eventName}", 
                    Price = amount, 
                    Quantity = 1, 
                    Category = "DEPOSIT" 
                }
            })
        };
        await PosService.AddSaleToShiftAsync(depositSale);
        await UpdateAuditAsync();
    }

    public class ProductItem { public int Id { get; set; } public string Name { get; set; } = ""; public decimal Price { get; set; } public int Quantity { get; set; } = 1; public string Category { get; set; } = "MISC"; }
}
