    private async Task OpenModifiersOverlay()
    {
        if (CartItems.Count > 0 && SelectedCartItem == null) SelectedCartItem = CartItems.Last();

        try {
            var selectedItemCat = SelectedCartItem?.Category?.Trim().ToUpper() ?? string.Empty;
            var filtered = Modifiers.AsEnumerable();

            if (!string.IsNullOrEmpty(selectedItemCat))
            {
                filtered = filtered.Where(m => 
                    string.IsNullOrWhiteSpace(m.EligibleCategories) || 
                    m.EligibleCategories.Split(',', StringSplitOptions.RemoveEmptyEntries)
                        .Select(c => c.Trim().ToUpper())
                        .Contains(selectedItemCat)
                );
            }

            ModifierItems = filtered
                .Select(m => new ProductItem {
                    Id = m.ItemId,
                    Name = m.Name,
                    Price = m.Price,
                    Category = "MODIFIERS",
                    DisplayOrder = 0
                })
                .ToList();
        } catch {}
        
        showModifiersOverlay = true;
        StateHasChanged();
    }

    private void AddModifierToCart(ProductItem mod)
    {
        if (SelectedCartItem == null) return;
        
        var existingMod = SelectedCartItem.Modifiers.FirstOrDefault(m => m.Id == mod.Id);
        if (existingMod != null) existingMod.Quantity++;
        else SelectedCartItem.Modifiers.Add(new ProductItem { Id = mod.Id, Name = mod.Name, Price = mod.Price, Quantity = 1 });
        
        showModifiersOverlay = false; // Close window automatically after adding
        StateHasChanged();
    }

    private void RemoveModifier(ProductItem parent, ProductItem mod)
    {
        if (mod.Quantity > 1) mod.Quantity--;
        else parent.Modifiers.Remove(mod);
        StateHasChanged();
    }
    
