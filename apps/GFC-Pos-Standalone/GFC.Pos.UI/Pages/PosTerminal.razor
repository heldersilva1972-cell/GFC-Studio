                    transform: translateY(-2px);
                }
                .option-tile-medium:active {
                    transform: scale(0.98);
                }

                /* Drawer Payout (Amber/Gold) */
                .tile-payout {
                    background: #fef3c7;
                    border-color: #fde68a;
