            if (!string.IsNullOrEmpty(payoutCatsStored))
            {
                _payoutCategories = JsonSerializer.Deserialize<List<string>>(payoutCatsStored) ?? new();
            }
            if (_payoutCategories == null || !_payoutCategories.Any())
            {
                _payoutCategories = new() { "FOOD", "SUPPLIES", "MAINTENANCE", "REBATE/REFUND", "OTHER" };
                await JSRuntime.InvokeVoidAsync("localStorage.setItem", "gfc_payout_categories", JsonSerializer.Serialize(_payoutCategories));
            }
        }
        catch
