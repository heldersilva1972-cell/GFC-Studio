    private async Task HandleBrandTap()
    {
        _brandTapCount++;
        if (_brandTapCount >= 5)
        {
            _brandTapCount = 0;
            var server = await PosService.GetServerVersionAsync();
            var local = VersionService.GetRevision();
            var lastUpdate = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "gfc_last_update_version") ?? "None";
            var status = IsServerNewer(server) ? "UPDATE READY" : "UP TO DATE";
            
            var userCount = AuthorizedUsers?.Count ?? 0;
            var apiUrl = Http.BaseAddress?.ToString() ?? "Not Set";
            
            var userDetails = "";
            if (AuthorizedUsers != null && AuthorizedUsers.Any())
            {
                userDetails = "\n\nLOADED OPERATORS:\n" + string.Join("\n", AuthorizedUsers.Select(u => $"- {u.Username} (Card: {u.CardNumber ?? "NONE"})"));
            }

            await JSRuntime.InvokeVoidAsync("alert", $"GFC POS DIAGNOSTICS\n------------------\nLocal Revision: {local}\nServer Revision: {server}\nStatus: {status}\nOperators Loaded: {userCount}\nAPI URL: {apiUrl}\nLast Attempt: {lastUpdate}\n\nUpdate Banner: {_showUpdateBanner}{userDetails}");
        }
    }

    private bool _isRefreshingMenu = false;

    private void OnOutboxChanged()
    {
        // PERFORMANCE: Do NOT call StateHasChanged here — the pending count badge
        // is non-critical and will update naturally after RefreshData completes.
        InvokeAsync(async () =>
        {
            if (!_isRefreshingMenu)
            {
                _isRefreshingMenu = true;
                try
                {
                    // Debounce batch syncs (e.g. 100 offline sales) to prevent API spam
                    await Task.Delay(1500);
                    await RefreshData();
                }
                finally
                {
                    _isRefreshingMenu = false;
                }
            }
        });
    }

    private void OnMenuRefreshed(PosMenuDto freshMenu)
    {
        // Background menu refresh completed — update in-memory collections so banquet
        // template prices and active events are immediately reflected in the UI.
        InvokeAsync(async () =>
        {
            _cachedMenu = freshMenu;
            await UpdateLocalCollectionsAsync(freshMenu);
            await FilterDbActiveEventsWithPendingClosures();
            await AdjustActiveEventBalancesWithPendingSales();
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        _disposed = true;
        Connectivity.ConnectivityChanged -= OnConnectivityChanged;
        PosService.OutboxChanged -= OnOutboxChanged;
        PosService.MenuRefreshed -= OnMenuRefreshed;
    }

    private async void LockTerminal()
    {
        if (string.IsNullOrEmpty(CurrentUserName)) return;

        // Safely close the supplier delivery overlay on lock/logout
        CloseLiquorOrdersWorkflow();

        // [AUTO-UPDATE] Check for newer POS version before locking
        try
        {
            if (_showUpdateBanner)
            {
                Console.WriteLine("[GFC POS UPDATE] Active update banner detected during logout. Forcing reload/installer...");
                await TriggerNuclearReload();
                return;
            }

            var isUpdateAvailable = await UpdateService.CheckForUpdatesAsync();
            if (isUpdateAvailable)
            {
                Console.WriteLine($"[GFC POS UPDATE] New version ({UpdateService.ServerVersion}) detected during logout. Forcing reload/installer...");
                await TriggerNuclearReload();
                return;
            }
        }
        catch { /* Fallback to standard lock */ }

        CurrentUserName = string.Empty;
        _displayProfile = "normal";
        _showDisplayPopover = false;
        _ = RefreshData(); // Background update for next operator
    }

