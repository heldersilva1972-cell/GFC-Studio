    private void ApplyCompToTarget(string compType)
    {
        var target = _targetCompItem ?? _selectedMultiCompItem;
        if (target != null)
        {
            int qtyToComp = Math.Clamp(_compQuantityToApply, 1, target.Quantity);

            if (target.Quantity > qtyToComp)
            {
                // Split the line item: reduce standard line quantity and add a new comped line item
                target.Quantity -= qtyToComp;

                var compedSplit = new ProductItem
                {
                    Id = target.Id,
                    Name = target.Name,
                    Price = 0,
                    OriginalPrice = target.IsComped ? target.OriginalPrice : target.Price,
                    Category = target.Category,
                    Quantity = qtyToComp,
                    IsComped = true,
                    CompType = compType
                };
                CartItems.Add(compedSplit);
                SelectedCartItem = compedSplit;
            }
            else
            {
                // Comp the entire line item
                if (!target.IsComped)
                {
                    target.OriginalPrice = target.Price;
                }
                target.Price = 0;
                target.IsComped = true;
                target.CompType = compType;
                SelectedCartItem = target;
            }

            _showCompModal = false;
            _targetCompItem = null;
            _selectedMultiCompItem = null;
            _compQuantityToApply = 1;
            SyncCustomerDisplay();
            StateHasChanged();
        }
        else
        {
            // Enter Comp Mode to pick any drink from the menu as a comp
            _pendingCompType = compType;
            _showCompModeBanner = true;
            _showCompModal = false;
            StateHasChanged();
        }
    }

