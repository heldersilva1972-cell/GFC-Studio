    private async Task OpenLiquorOrdersWorkflow()
    {
        try
        {
            showOptionsMenu = false; // Hide administration menu
            showLiquorOrdersModal = true;
            _isFetchingLiquorOrders = true;
            _liquorOrdersIsOffline = false;
            _selectedLiquorOrder = null;
            _pendingLiquorOrders.Clear();
            await InvokeAsync(StateHasChanged);

            Console.WriteLine("[POS] Fetching pending liquor orders...");
            // Check connectivity before fetching — if offline, the service falls back to cache
            _liquorOrdersIsOffline = !Connectivity.IsOnline;
            var orders = await PosService.GetPendingLiquorOrdersAsync(force: true);
            if (orders != null)
            {
                _pendingLiquorOrders = orders;
                Console.WriteLine($"[POS] Loaded {_pendingLiquorOrders.Count} pending liquor orders (offline={_liquorOrdersIsOffline}).");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[POS] OpenLiquorOrdersWorkflow Error: {ex.Message}");
            Toast.ShowError($"Could not retrieve pending deliveries: {ex.Message}");
        }
        finally
        {
            _isFetchingLiquorOrders = false;
            await InvokeAsync(StateHasChanged);
        }
    }

