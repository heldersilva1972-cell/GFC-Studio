                                                <div class="d-flex justify-content-between align-items-center">
                                                    <span class="fw-bold small text-navy text-uppercase">Legacy Beer Token Fallback ($)</span>
                                                    <input type="number" step="0.01" class="form-control text-center fw-bold" style="width: 100px; border-radius: 8px; border: 1.5px solid #cbd5e1;" @bind="_legacyBeerTokenValue" @bind:after="SaveLegacySettings" />
                                                </div>
                                                <div class="d-flex justify-content-between align-items-center">
                                                    <span class="fw-bold small text-navy text-uppercase">Legacy Mixed Drink Fallback ($)</span>
                                                    <input type="number" step="0.01" class="form-control text-center fw-bold" style="width: 100px; border-radius: 8px; border: 1.5px solid #cbd5e1;" @bind="_legacyMixedTokenValue" @bind:after="SaveLegacySettings" />
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>


                            </div>
                        </div>
                    </div>
                }
                else if (_activeSettingsTab == "printer")
                {
                    <div class="pane-header mb-4 animate__animated animate__fadeIn animate__faster">
                        <h2 class="fw-black text-navy mb-1" style="font-size: 2rem; letter-spacing: -0.5px;">Thermal Printer</h2>
                        <p class="text-muted fw-bold small text-uppercase">Establish raw connection sockets and hardware parameters for POS receipt printing.</p>
                    </div>
                    
                    <div class="row g-4 animate__animated animate__fadeIn animate__faster">
                        <div class="col-xl-8 col-lg-10">
                            <PrinterSettings />
                        </div>
                    </div>
                }
                else if (_activeSettingsTab == "inventory")
                {
                    <div class="pane-header mb-4 animate__animated animate__fadeIn animate__faster">
                        <h2 class="fw-black text-navy mb-1" style="font-size: 2rem; letter-spacing: -0.5px;">Inventory Print Settings</h2>
                        <p class="text-muted fw-bold small text-uppercase">Select which liquor and beer categories are printed in the liquor inventory report.</p>
                    </div>
                    
                    <div class="row g-4 animate__animated animate__fadeIn animate__faster">
                        <div class="col-xl-8 col-lg-10">
                            <div class="card shadow-sm border-0 rounded-4 p-4 mb-4" style="background: white; border-radius: 16px;">
                                <h4 class="fw-bold mb-3 text-dark" style="font-size: 1.1rem; border-bottom: 2px solid #f1f5f9; padding-bottom: 8px;">Print Options</h4>
                                <div class="d-flex align-items-center justify-content-between p-2">
                                    <div>
                                        <span class="fw-bold text-dark d-block" style="font-size: 0.95rem;">Print Bottle Size</span>
                                        <span class="text-muted small">If selected, the item size is printed in the inventory report.</span>
                                    </div>
                                    <label class="premium-switch">
                                        <input type="checkbox" checked="@_printBottleSize" @onchange="TogglePrintBottleSize">
                                        <span class="slider-track">
                                            <span class="slider-thumb"></span>
                                        </span>
                                    </label>
                                </div>
                            </div>

                            <div class="card shadow-sm border-0 rounded-4 p-4 mb-4" style="background: white; border-radius: 16px;">
                                <h4 class="fw-bold mb-3 text-dark" style="font-size: 1.1rem; border-bottom: 2px solid #f1f5f9; padding-bottom: 8px;">Active Categories</h4>
                                <div class="d-flex flex-column gap-2" style="max-height: 400px; overflow-y: auto;">
                                    @if (_allLiquorCategories == null || !_allLiquorCategories.Any())
                                    {
                                        <div class="text-muted small">No active liquor categories found. Make sure items are configured with categories.</div>
                                    }
