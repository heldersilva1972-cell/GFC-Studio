    private void PizzaKeypadPress(string key)
    {
        if (key == "DEL")
        {
            if (_customPizzaAmountString.Length > 0)
                _customPizzaAmountString = _customPizzaAmountString.Substring(0, _customPizzaAmountString.Length - 1);
        }
        else if (key == ".")
        {
            if (!_customPizzaAmountString.Contains("."))
            {
                if (string.IsNullOrEmpty(_customPizzaAmountString))
                    _customPizzaAmountString = "0.";
                else
                    _customPizzaAmountString += ".";
            }
        }
        else
        {
            if (_customPizzaAmountString.Contains("."))
            {
                var parts = _customPizzaAmountString.Split('.');
                if (parts.Length > 1 && parts[1].Length < 2)
                    _customPizzaAmountString += key;
            }
            else if (_customPizzaAmountString.Length < 7)
            {
                _customPizzaAmountString += key;
            }
        }

        if (string.IsNullOrEmpty(_customPizzaAmountString) || _customPizzaAmountString == "0.")
            _customPizzaAmount = 0;
        else if (decimal.TryParse(_customPizzaAmountString, out var val))
            _customPizzaAmount = val;

        StateHasChanged();
    }

