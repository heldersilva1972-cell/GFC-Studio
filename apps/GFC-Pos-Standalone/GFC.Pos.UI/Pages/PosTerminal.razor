@page "/"
@using Microsoft.AspNetCore.Authorization
@using GFC.Core.Models
@using GFC.Core.Interfaces
@using GFC.Core.DTOs
@using GFC.Pos.UI.Services
@using global::System.Text.Json
@using Microsoft.AspNetCore.Components
@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation
@inject IPosTerminalService PosService
@inject Blazored.Toast.Services.IToastService Toast
@inject ConnectivityService Connectivity
@inject IVersionService VersionService
@inject IStationSettingsService StationSettings
@inject IPrinterService PrinterService
@inject IPrinterConfigService PrinterConfig
@inject HttpClient Http
@implements IDisposable
@attribute [AllowAnonymous]

<style>
    .redeem-modal {
        background: white !important;
        width: 750px !important;
        max-width: 95vw !important;
        max-height: 95vh !important;
        border-radius: 40px !important;
        padding: 2rem !important;
        border: 6px solid #f1f5f9 !important;
        box-shadow: 0 40px 80px rgba(0,0,0,0.3) !important;
        position: relative;
        text-align: center;
        display: flex;
        flex-direction: column;
        align-items: center;
        overflow: hidden;
    }
    .token-redeem-btn {
        width: 100% !important;
        background: white !important;
        border: 3px solid #e2e8f0 !important;
        border-radius: 16px !important;
        display: flex !important;
        flex-direction: column !important;
        align-items: center !important;
        justify-content: center !important;
        padding: 0.75rem !important;
        transition: all 0.2s !important;
        cursor: pointer !important;
        gap: 6px !important;
        box-shadow: 0 4px 8px rgba(0,0,0,0.05) !important;
        min-height: 80px !important;
    }

    .btn-upgrade-main {
        background: #f1f5f9 !important;
        color: #1e3a8a !important;
        border: 2px solid #1e3a8a !important;
        border-radius: 12px !important;
        padding: 0.5rem !important;
        font-weight: 800 !important;
        font-size: 0.75rem !important;
        text-transform: uppercase !important;
        display: flex !important;
        flex-direction: column !important;
        align-items: center !important;
        justify-content: center !important;
        gap: 4px !important;
        transition: all 0.2s !important;
    }
    .btn-upgrade-main:hover { background: #e0e7ff !important; transform: scale(1.02) !important; }
    .btn-upgrade-main.disabled { opacity: 0.5; cursor: not-allowed; border-color: #cbd5e1 !important; color: #64748b !important; }

    .btn-redeem {
        background: #1e3a8a !important;
        color: white !important;
        border: none !important;
        border-radius: 12px !important;
        padding: 0.5rem !important;
        font-weight: 800 !important;
        font-size: 0.75rem !important;
        text-transform: uppercase !important;
        display: flex !important;
        flex-direction: column !important;
        align-items: center !important;
        justify-content: center !important;
        gap: 4px !important;
        transition: all 0.2s !important;
    }
    .token-redeem-btn:hover {
        border-color: #1e3a8a !important;
        transform: translateY(-5px) !important;
        box-shadow: 0 12px 24px rgba(30, 58, 138, 0.15) !important;
