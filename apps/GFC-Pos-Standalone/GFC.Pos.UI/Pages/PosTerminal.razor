                        {(string.IsNullOrEmpty(inventoryRows) ? "" : $@"
                        <div style='margin-top:15px;'>
                            <div style='font-weight:bold; border-bottom:1px solid #ccc; margin-bottom:5px;'>INVENTORY REMOVAL LOG</div>
                            {inventoryRows}
                        </div>")}

                        <div style='text-align: center; margin-top:20px; font-size: 0.7em; opacity: 0.8;'>
                            <hr/>
                            Standalone Mode v{VersionService.GetRevision()}
                        </div>
                    </div>";

                await PrinterService.PrintReceiptAsync(html);
            }
        }

        _inventoryPullDraft.Clear(); 
        await PosService.ClearShiftAsync();
        await UpdateAuditAsync();
        _currentCloseOutStep = CloseOutStep.None;
        showCloseOutSuccessOverlay = true; StateHasChanged(); await Task.Delay(1500); showCloseOutSuccessOverlay = false; StateHasChanged();
        
        // 5. [NEW] Force reload to reset terminal state (Security Requirement)
        Navigation.NavigateTo("/", true);
    }

