    private enum CloseOutStep { None, PromptInventory, ReviewDraft, Selection, PromptZ }
    private CloseOutStep _currentCloseOutStep = CloseOutStep.None;
    private Dictionary<int, int> _inventoryPullDraft = new();
    private bool _showOpenBanquetsZOutWarning = false;
    private void StartCloseOutWorkflow()
    {
        if (DbActiveEvents.Any())
        {
            _showOpenBanquetsZOutWarning = true;
            StateHasChanged();
        }
        else
        {
            ProceedToCloseOut();
        }
    }
    private void ProceedToCloseOut()
    {
        _showOpenBanquetsZOutWarning = false;
        _currentCloseOutStep = _inventoryPullDraft.Any() ? CloseOutStep.ReviewDraft : CloseOutStep.PromptInventory;
        StateHasChanged();
    }
    private void AddToDraft(int id) { if (_inventoryPullDraft.ContainsKey(id)) _inventoryPullDraft[id]++; else _inventoryPullDraft[id] = 1; }
    private void RemoveFromDraft(int id) { if (_inventoryPullDraft.ContainsKey(id) && _inventoryPullDraft[id] > 1) _inventoryPullDraft[id]--; else _inventoryPullDraft.Remove(id); }
    private async Task ProcessZOut(bool print)
    {
        if (!forceTrainingMode) {
            // Calculate final audit from Database
            var finalAudit = await PosService.GetShiftAuditAsync();
            
            // Calculate Token Credits directly from computed audit
            decimal tokenCredits = finalAudit.TokenCredits;
            
            var z = new PosZReportDto { 
                Id = Guid.NewGuid(), Timestamp = DateTime.Now, TerminalName = TerminalName, BartenderName = CurrentUserName, 
                CashTotal = finalAudit.CashTotal, TotalGrossSales = finalAudit.GrossTotal, 
                InventoryPullsJson = JsonSerializer.Serialize(_inventoryPullDraft),
                SalesSummaryJson = JsonSerializer.Serialize(finalAudit.ItemSummary),
                BanquetSummaryJson = JsonSerializer.Serialize(finalAudit.Banquets),
                TokenCredits = tokenCredits
            };
            await PosService.SaveZReportAsync(z);

            if (print) 
            {
                if (!forceTrainingMode || allowHardwareInTraining)
                {
                    await PrinterService.KickDrawerAsync();
                }
                
                // ─── GENERATE REGULAR SALES (EXCLUDES BANQUETS) ───
                var groupedRegular = finalAudit.RegularItemSummary
                    .Select(kvp => {
                        var product = DbItems.FirstOrDefault(i => i.Name == kvp.Key);
                        var category = product?.Category;
                        if (kvp.Key.StartsWith("TAB DEPOSIT:")) category = "DEPOSITS";
                        if (kvp.Key.Contains("TOKEN CREDIT") || kvp.Key.Contains("(TOKEN REDEEMED)")) category = "TOKENS";
                        return new { 
                            Name = kvp.Key, 
                            Quantity = kvp.Value, 
                            Category = category ?? "MISC", 
                            Total = finalAudit.RegularItemTotals.ContainsKey(kvp.Key) ? finalAudit.RegularItemTotals[kvp.Key] : 0
                        };
                    })
                    .GroupBy(x => x.Category)
                    .OrderBy(g => g.Key);

                var salesRows = "";
                foreach(var group in groupedRegular) {
                    salesRows += $"<div style='font-weight:bold; margin-top:12px; border-bottom:1px solid #000; text-transform:uppercase; font-size:0.9em;'>{group.Key}</div>";
                    foreach(var item in group.OrderByDescending(x => x.Quantity)) {
                        salesRows += $"<div style='display:flex; justify-content:space-between; font-size:0.85em; padding: 2px 0;'><span>{item.Name} (x{item.Quantity})</span><span>{item.Total:C}</span></div>";
                    }
                    var groupTotal = group.Sum(x => x.Total);
                    salesRows += $"<div style='display:flex; justify-content:space-between; font-weight:bold; font-size:0.85em; border-top:1px dashed #ccc; margin-top:2px;'><span>{group.Key} TOTAL</span><span>{groupTotal:C}</span></div>";
                }

                var voidedRows = "";
                foreach(var vs in finalAudit.VoidedSales) {
                    voidedRows += $"<div style='display:flex; justify-content:space-between; color: #666; font-style: italic;'><span>{vs.Timestamp:h:mm tt} - {vs.AdjustmentReason ?? "Void"}</span><span>({vs.TotalAmount:C})</span></div>";
                }

                var inventoryRows = "";
                foreach(var pull in _inventoryPullDraft) {
                    var prod = DbItems.FirstOrDefault(i => i.Id == pull.Key);
                    if (prod != null) inventoryRows += $"<div style='display:flex; justify-content:space-between;'><span>{prod.Name}</span><span>{pull.Value}</span></div>";
                }

                var banquetRows = "";
                foreach (var b in finalAudit.Banquets)
                {
                    banquetRows += $@"
                        <div style='margin-top:10px; border:1px solid #ccc; padding:8px; border-radius:4px;'>
                            <div style='font-weight:bold; font-size:1.1em; color:#000; border-bottom:1px solid #eee; margin-bottom:5px;'>EVENT: {b.EventName}</div>
                            <div style='font-weight:bold; font-size:0.8em; color:#666;'>DEPOSITS:</div>";
                    
                    foreach (var dep in b.Deposits)
                    {
                        banquetRows += $"<div style='display:flex; justify-content:space-between; font-size:0.85em;'><span>- Add Funds</span><span>{dep:C}</span></div>";
                    }
                    
                    banquetRows += $@"<div style='font-weight:bold; font-size:0.8em; color:#666; margin-top:5px;'>TAB PURCHASES:</div>";
                    foreach (var item in b.ItemSummary.OrderByDescending(x => x.Value))
                    {
                        var itemTotal = b.ItemTotals.ContainsKey(item.Key) ? b.ItemTotals[item.Key] : 0;
                        banquetRows += $"<div style='display:flex; justify-content:space-between; font-size:0.85em;'><span>{item.Value} x {item.Key}</span><span>{itemTotal:C}</span></div>";
                    }
                    
                    banquetRows += $@"
                            <div style='display:flex; justify-content:space-between; font-weight:bold; border-top:1px solid #eee; margin-top:5px; padding-top:2px;'>
                                <span>TAB TOTAL SPENT:</span><span>{b.TotalSpent:C}</span>
                            </div>
                        </div>";
                }

                var html = BuildZReportHtml(z);
                try
                {
                    await JSRuntime.InvokeVoidAsync("localStorage.setItem", "gfc_last_printed_z_html", html);
                }
                catch {}
                
                // Execute print in background
                _ = Task.Run(async () =>
                {
                    try
                    {
                        if (!forceTrainingMode || allowHardwareInTraining)
                        {
                            await PrinterService.KickDrawerAsync();
                        }
                        await PrintReceiptAsync(html);
                    }
                    catch (Exception ex)
                    {
                        Console.WriteLine($"[POS] Z-Report background print failed: {ex.Message}");
                    }
                });
            }
        }

        _inventoryPullDraft.Clear(); 
        await PosService.ClearShiftAsync();
        await UpdateAuditAsync();
        _currentCloseOutStep = CloseOutStep.None;
        showCloseOutSuccessOverlay = true; StateHasChanged(); await Task.Delay(1500); showCloseOutSuccessOverlay = false; StateHasChanged();
        
        // 5. [NEW] Force reload to reset terminal state (Security Requirement)
        Navigation.NavigateTo("/", true);
    }

