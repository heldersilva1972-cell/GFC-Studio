                            <button class="btn @(_existingPizzaPayoutSale != null ? "btn-warning py-3 fs-5 fw-black text-dark border-warning" : "btn-light py-2.5 fw-bold text-muted border") w-100 rounded-pill"
                                    @onclick="StartEditPizzaAmount">
                                <i class="bi bi-pencil-fill me-1"></i> @(_existingPizzaPayoutSale != null ? "Change Payout Amount" : "Edit Amount (Receipt Differs)")
                            </button>
                            @if (_existingPizzaPayoutSale != null)
                            {
                                <button class="btn btn-outline-danger w-100 py-2.5 rounded-pill fw-bold border-2 mt-1"
                                        @onclick="VoidExistingPizzaPayout">
                                    <i class="bi bi-trash3-fill me-1"></i> Cancel / Void Pizza Payout
                                </button>
