    [JSInvokable]
    public async Task OnCardScanned(string cardNumber)
    {
        // Only allow login if terminal is locked (CurrentUserName is empty)
        if (!string.IsNullOrEmpty(CurrentUserName)) return;

        var user = AuthorizedUsers.FirstOrDefault(u => {
            if (string.IsNullOrEmpty(u.CardNumber)) return false;
            
            var dbCard = u.CardNumber.Trim();
            var scanCard = cardNumber.Trim();
            
            // Exact match
            if (dbCard == scanCard) return true;
            
            // Numeric match (ignores leading zeros)
            if (long.TryParse(dbCard, out var dbLong) && long.TryParse(scanCard, out var scanLong))
            {
                return dbLong == scanLong;
            }
            
            return false;
        });

        if (user != null)
        {
            Console.WriteLine($"[POS] CARD AUTH SUCCESS: {user.Username}");
            
            // Show Premium Splash
            _splashUserName = user.Username;
            _showLoginSplash = true;
            StateHasChanged();

            // Set operator and reset idle
            CurrentUserName = user.Username;
            _lastActivity = DateTime.Now;

            // Wait and then hide splash
            await Task.Delay(1500);
            _showLoginSplash = false;
            StateHasChanged();
        }
        else
        {
            Console.WriteLine($"[POS] CARD AUTH FAILED: No match for {cardNumber}");
            Toast.ShowWarning($"UNKNOWN CARD: {cardNumber}");
        }
    }

    private async Task SaveIdleSettings() => await JSRuntime.InvokeVoidAsync("localStorage.setItem", "gfc_pos_idle_timeout", _idleTimeoutMinutes.ToString());

    private async Task StartAuthPolling()
    {
        while (!_disposed)
        {
            await Task.Delay(TimeSpan.FromSeconds(10));
            if (_disposed) continue;

            // 1. Idle Timeout Check (Highest Priority)
            if (_idleTimeoutMinutes > 0 && !string.IsNullOrEmpty(CurrentUserName))
            {
                if ((DateTime.Now - _lastActivity).TotalMinutes >= _idleTimeoutMinutes)
                {
                    Console.WriteLine($"[POS] IDLE TIMEOUT: No activity for {_idleTimeoutMinutes}m. Locking station.");
                    LockTerminal();
                    await InvokeAsync(StateHasChanged);
                }
            }

            // 2. Security / Permissions Sync + Update Check
            await SyncUsers();

                // [AUTO-UPDATE] Check for newer version while idle/logged out
            await CheckForUpdatesAsync();

            // 3. 3AM Daily Reset Check
            CheckDailyReset();

            // Security Check: If a user is currently logged in, verify they are still in the authorized list
            if (!string.IsNullOrEmpty(CurrentUserName))
            {
                var isStillAuth = AuthorizedUsers.Any(u => u.Username.Equals(CurrentUserName, StringComparison.OrdinalIgnoreCase));
                if (!isStillAuth)
                {
                    Console.WriteLine($"[POS] SECURITY: {CurrentUserName} is no longer authorized. Forcing terminal lock.");
                    LockTerminal();
                    await InvokeAsync(StateHasChanged);
                }
            }
        }
    }

    private async Task CheckForUpdatesAsync()
    {
        try
        {
            var serverVersion = await PosService.GetServerVersionAsync();
            _serverVersionFound = serverVersion;
            
            if (!string.IsNullOrEmpty(serverVersion) && serverVersion != "Offline" && IsServerNewer(serverVersion))
            {
                // [LOOP-PROTECTION] Verify if we just tried to update to this specific version
                var lastAttemptVersion = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "gfc_last_update_version");
                var lastAttemptTimeStr = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "gfc_last_update_time");
                
                if (lastAttemptVersion == serverVersion && !string.IsNullOrEmpty(lastAttemptTimeStr))
                {
                    if (long.TryParse(lastAttemptTimeStr, out long lastTime))
                    {
                        var diffSeconds = DateTimeOffset.UtcNow.ToUnixTimeSeconds() - lastTime;
                        if (diffSeconds < 120) // 2 minute cooling period for the same version
                        {
                            Console.WriteLine($"[GFC POS UPDATE] Suppressing update loop. Last attempt for {serverVersion} was {diffSeconds}s ago.");
                            return;
                        }
                    }
                }

                if (string.IsNullOrEmpty(CurrentUserName))
                {
                    // SAFE TO AUTO-UPDATE: No user is logged in
                    Console.WriteLine($"[GFC POS UPDATE] New version detected ({serverVersion}). Forcing cache-clear reload...");
                    await TriggerNuclearReload();
                }
                else if (!_showUpdateBanner)
                {
                    // USER IS ACTIVE: Show banner instead of reloading
                    Console.WriteLine($"[GFC POS UPDATE] New version detected ({serverVersion}). Showing update pill.");
                    _showUpdateBanner = true;
                    await InvokeAsync(StateHasChanged);
                }
            }
        }
        catch { }
    }

