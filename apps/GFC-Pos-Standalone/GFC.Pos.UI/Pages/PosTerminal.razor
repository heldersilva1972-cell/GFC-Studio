    }

    private async Task ValidateManualMemberId()
    {
        if (string.IsNullOrEmpty(_drawManualInput)) return;
        if (!int.TryParse(_drawManualInput, out int memberId)) return;

        try
        {
            _drawError = "";
            var result = await PosService.GetMemberDrawStatusAsync(memberId);
            if (result != null)
            {
                _drawResult = result;
            }
            else
            {
                _drawResult = new MemberDrawStatusDto
                {
                    MemberId = memberId,
                    FirstName = "NOT",
                    LastName = "FOUND",
                    IsActive = false,
                    IsEligible = false
                };
            }
        }
        catch (Exception ex)
        {
            _drawError = $"Lookup failed: {ex.Message}";
        }
        StateHasChanged();
    }

    private async Task InitializeDrawAudio()
    {
        try
        {
            var jsCode = @"
                const existingCtx = window.gfcDrawAudio ? window.gfcDrawAudio.audioCtx : null;
                const existingInterval = window.gfcDrawAudio ? window.gfcDrawAudio.tickInterval : null;
                const existingWhirrOsc = window.gfcDrawAudio ? window.gfcDrawAudio._whirrOsc : null;
                const existingWhirrGain = window.gfcDrawAudio ? window.gfcDrawAudio._whirrGain : null;
                window.gfcDrawAudio = {
                    audioCtx: existingCtx,
                    tickInterval: existingInterval,
                    _whirrOsc: existingWhirrOsc,
                    _whirrGain: existingWhirrGain,
                    init() {
                        if (!this.audioCtx) {
                            this.audioCtx = new (window.AudioContext || window.webkitAudioContext)();
                        } else if (this.audioCtx.state === 'suspended') {
                            this.audioCtx.resume();
                        }
                    },
                    playTick() {
                        // Removed clicking sound as requested
                    },
                    playLock() {
                        this.init();
                        const ctx = this.audioCtx;
                        if (ctx.state === 'suspended') ctx.resume();
                        const osc = ctx.createOscillator();
                        const gain = ctx.createGain();
                        osc.type = 'sine';
                        osc.frequency.setValueAtTime(440, ctx.currentTime); // A4
                        osc.frequency.exponentialRampToValueAtTime(659.25, ctx.currentTime + 0.15); // E5
                        gain.gain.setValueAtTime(0.08, ctx.currentTime);
                        gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.2);
                        osc.connect(gain);
                        gain.connect(ctx.destination);
                        osc.start();
                        osc.stop(ctx.currentTime + 0.2);
                    },
                    playCelebration() {
                        this.init();
                        const ctx = this.audioCtx;
                        if (ctx.state === 'suspended') ctx.resume();
                        const notes = [523.25, 659.25, 783.99, 1046.50]; // C5, E5, G5, C6
                        notes.forEach((freq, index) => {
                            const osc = ctx.createOscillator();
                            const gain = ctx.createGain();
                            osc.type = 'sine';
                            osc.frequency.setValueAtTime(freq, ctx.currentTime + index * 0.08);
                            gain.gain.setValueAtTime(0.0, ctx.currentTime + index * 0.08);
                            gain.gain.linearRampToValueAtTime(0.08, ctx.currentTime + index * 0.08 + 0.02);
                            gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + index * 0.08 + 0.35);
                            osc.connect(gain);
                            gain.connect(ctx.destination);
                            osc.start(ctx.currentTime + index * 0.08);
                            osc.stop(ctx.currentTime + index * 0.08 + 0.35);
                        });
                    },
                    startTicking(speedMs) {
                        this.stopTicking();
                        this.init();
                        const ctx = this.audioCtx;
                        if (ctx.state === 'suspended') ctx.resume();
                        // Continuous mechanical whirring hum: sawtooth through lowpass
                        const whirrOsc = ctx.createOscillator();
                        const whirrFilter = ctx.createBiquadFilter();
                        const whirrGain = ctx.createGain();
                        whirrOsc.type = 'sawtooth';
                        whirrOsc.frequency.setValueAtTime(80, ctx.currentTime);
                        whirrFilter.type = 'lowpass';
                        whirrFilter.frequency.setValueAtTime(250, ctx.currentTime);
                        whirrGain.gain.setValueAtTime(0.003, ctx.currentTime);
                        whirrOsc.connect(whirrFilter);
                        whirrFilter.connect(whirrGain);
                        whirrGain.connect(ctx.destination);
                        whirrOsc.start();
                        this._whirrOsc = whirrOsc;
                        this._whirrGain = whirrGain;
                        // Rhythmic ticks on top
                        this.tickInterval = setInterval(() => {
                            this.playTick();
                        }, speedMs);
                    },
                    stopTicking() {
                        if (this.tickInterval) {
                            clearInterval(this.tickInterval);
                            this.tickInterval = null;
                        }
                        if (this._whirrOsc) {
                            try {
                                const g = this._whirrGain;
                                const ctx = this.audioCtx;
                                g.gain.setValueAtTime(g.gain.value, ctx.currentTime);
                                g.gain.exponentialRampToValueAtTime(0.0001, ctx.currentTime + 0.3);
                                this._whirrOsc.stop(ctx.currentTime + 0.3);
                            } catch(e) {}
                            this._whirrOsc = null;
                            this._whirrGain = null;
                        }
                    }
                };
            ";
            await JSRuntime.InvokeVoidAsync("eval", jsCode);
        }
        catch (Exception)
        {
            // Fail silent if Web Audio is unsupported
        }
    }

    private async Task StartDrawing()
    {
        if (_isDrawing || !_drawPool.Any()) return;

        // Move current draw results to "previous draw" before starting a new one
        if (_hasDrawn && _drawResult != null)
        {
            _previousDrawName = $"#{_drawResult.MemberId} - {_drawResult.FirstName} {_drawResult.LastName}";
            _previousDrawTime = DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss");
            _previousDrawEligible = _drawResult.IsEligible;
            try
            {
                await JSRuntime.InvokeVoidAsync("localStorage.setItem", "gfc_last_drawn_member_name", _previousDrawName);
                await JSRuntime.InvokeVoidAsync("localStorage.setItem", "gfc_last_drawn_member_time", _previousDrawTime);
                await JSRuntime.InvokeVoidAsync("localStorage.setItem", "gfc_last_drawn_member_eligible", _previousDrawEligible.ToString().ToLower());

                await AddToDrawHistory(_drawResult.MemberId, $"{_drawResult.FirstName} {_drawResult.LastName}", _previousDrawTime, _previousDrawEligible);
            }
            catch { }
        }

        _isDrawing = true;
        _hasDrawn = false;
        _drawResult = null;
        _drawError = "";
        _drawManualInput = ""; // Clear manual lookup to focus on the draw
        
        // --- STEP 1: INITIALIZE SOUND SYSTEM & SNAPBACK RESET ---
        await InitializeDrawAudio();
        
        // Zero-duration reset back to baseline display position inside 100-digit bounds
        for (int i = 0; i < _reelCount; i++)
        {
            _reelDurations[i] = 0.0;
            _reelOffsets[i] = 10 + (_reelOffsets[i] % 10);
            _reelClasses[i] = "";
        }
        StateHasChanged();
        await Task.Delay(50); // Let Blazor commit this baseline frame instantly

        // Select visual random winner
        var winnerIndex = _random.Next(0, _drawPool.Count);
        var winningId = _drawPool[winnerIndex];
        _drawnMemberId = winningId;

        // Perform validation check in parallel
        var checkTask = PosService.GetMemberDrawStatusAsync(winningId);

        // Format winning ID with leading zeros
        var winningIdStr = winningId.ToString().PadLeft(_reelCount, '0');

        // --- STEP 2: LAUNCH SEAMLESS INFINITE SPIN & BACKGROUND TICK AUDIO ---
        try
        {
            await JSRuntime.InvokeVoidAsync("gfcDrawAudio.startTicking", 90);
        }
        catch (Exception) {}

        for (int i = 0; i < _reelCount; i++)
        {
            _reelClasses[i] = "reel-looping-fast";
            _reelOffsets[i] = 0; // Baseline offset while fast looping
            _reelDurations[i] = 0.0; // No transition duration during fast loop
        }
        StateHasChanged();

        // Fetch draw status from backend
        MemberDrawStatusDto? status = null;
        try
        {
            status = await checkTask;
        }
        catch (Exception ex)
        {
            _drawError = $"Error fetching draw status: {ex.Message}";
        }

        // --- STEP 3: SEQUENTIAL STOPPING TIMERS (18 Seconds Total Suspense) ---
        for (int i = 0; i < _reelCount; i++)
        {
            // Initial delay before Reel 0 decelerates is 10 seconds.
            // Subsequent reels start decelerating immediately when the previous reel locks!
            if (i == 0)
            {
                await Task.Delay(10000);
            }

            var targetDigit = int.Parse(winningIdStr[i].ToString());
            _reelOffsets[i] = 20 + targetDigit; 
            _reelDurations[i] = 2.0; // 2.0s smooth physical slowdown deceleration
            _reelClasses[i] = ""; // Remove looping class to initiate transition
            StateHasChanged();

            // Wait 2.0 seconds for deceleration to complete and lock
            await Task.Delay(2000);
            
            try
            {
                await JSRuntime.InvokeVoidAsync("gfcDrawAudio.playLock");
            }
            catch (Exception) {}
        }

        // Stop background ticking once all reels are locked
        try
        {
            await JSRuntime.InvokeVoidAsync("gfcDrawAudio.stopTicking");
        }
        catch (Exception) {}

        // Wait another brief tick to present the result card with premium feel
        await Task.Delay(250);

        _drawResult = status ?? new MemberDrawStatusDto
        {
            MemberId = winningId,
            FirstName = "UNKNOWN",
            LastName = "MEMBER",
            IsActive = false,
            IsEligible = false
        };

        _isDrawing = false;
        _hasDrawn = true;
        StateHasChanged();

        // Play winning celebration sound if drawn member is active/paid
        if (_drawResult.IsEligible)
        {
            try
            {
                await JSRuntime.InvokeVoidAsync("gfcDrawAudio.playCelebration");
            }
            catch (Exception) {}
        }
    }

    private void OpenPayoutWorkflow()
    {
        showOptionsMenu = false;
        _payoutAmount = 0;
        _payoutInputString = "";
        _selectedPayoutCategory = "";
        showPayoutModal = true;
        StateHasChanged();
    }

    private async Task SubmitPayout()
    {
        if (string.IsNullOrEmpty(_selectedPayoutCategory))
        {
            _showMissingCategoryModal = true;
            StateHasChanged();
            return;
        }
        
        if (_payoutAmount <= 0)
        {
            Toast.ShowError("Please enter a valid amount.");
            return;
        }

        try
        {
            var payoutSale = new PosSaleDto
            {
                Id = Guid.NewGuid(),
                Timestamp = DateTime.Now,
                TerminalName = forceTrainingMode ? $"{TerminalName} (TRAINING)" : TerminalName,
                BartenderName = CurrentUserName,
                TotalAmount = _payoutAmount,
                PaymentType = "PAYOUT",
                OriginalTotal = _payoutAmount,
                ItemsJson = JsonSerializer.Serialize(new List<ProductItem>
                {
                    new ProductItem { 
                        Name = $"PAYOUT:{_selectedPayoutCategory}", 
                        Price = _payoutAmount, 
                        Quantity = 1, 
                        Category = "PAYOUT" 
                    }
                })
            };

            await PosService.AddSaleToShiftAsync(payoutSale);
            await PosService.SaveSaleAsync(payoutSale);

            // PERFORMANCE: Close the modal first so the cashier sees instant feedback.
            showPayoutModal = false;
            Toast.ShowSuccess($"Payout of {_payoutAmount:C} recorded successfully.");
            StateHasChanged();

            // Then kick the drawer and print voucher (hardware ops — run in background so UI doesn't lock up)
            _ = Task.Run(async () =>
            {
                try
                {
                    if (!forceTrainingMode || allowHardwareInTraining)
                    {
                        await PrinterService.KickDrawerAsync();
                    }

                    if (_printPayoutVoucher)
                    {
                        await PrintPayoutVoucher(payoutSale);
                    }
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"[POS] Payout hardware operation failed: {ex.Message}");
                    await InvokeAsync(() => Toast.ShowError("Payout recorded, but drawer/printer failed."));
                }
            });

            // Re-calculate local audit totals in background
            _ = UpdateAuditAsync();
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Failed to record payout: {ex.Message}");
        }
    }

    private async Task PrintPayoutVoucher(PosSaleDto payout)
    {
        var item = JsonSerializer.Deserialize<List<ProductItem>>(payout.ItemsJson)?.FirstOrDefault();
        var parts = item?.Name.Split(':') ?? Array.Empty<string>();
        var cat  = parts.Length > 1 ? parts[1] : "OTHER";
        var desc = parts.Length > 2 ? parts[2] : "";

        var sb = new System.Text.StringBuilder();

        ReceiptFormatter.AppendReceiptHeader(sb,
            title1: "GFC PAYOUT VOUCHER",
            title2: payout.TerminalName.ToUpper(),
            dateStr: payout.Timestamp.ToString("MM/dd/yyyy  h:mm tt"),
            operatorName: $"Operator: {payout.BartenderName.ToUpper()}");

        ReceiptFormatter.AppendBlank(sb);
        ReceiptFormatter.AppendLine(sb, "CATEGORY", cat.ToUpper());
        if (!string.IsNullOrEmpty(desc))
            ReceiptFormatter.AppendLine(sb, "NOTE", desc);
        ReceiptFormatter.AppendBlank(sb);
        ReceiptFormatter.AppendDivider(sb, '-');
        ReceiptFormatter.AppendLine(sb, "PAID OUT", $"{payout.TotalAmount:C}");
        ReceiptFormatter.AppendDivider(sb, '-');
        ReceiptFormatter.AppendBlank(sb);
        ReceiptFormatter.AppendBlank(sb);
        ReceiptFormatter.AppendBlank(sb);
        ReceiptFormatter.AppendDivider(sb, '_');
        ReceiptFormatter.AppendCenter(sb, "SIGNATURE");

        try
        {
            await PrintReceiptAsync(sb.ToString());
        }
        catch {}
    }


    private string BuildZReportHtml(PosZReportDto z, bool isXReport = false, bool isReprint = false)
    {
        var salesSummary = JsonSerializer.Deserialize<Dictionary<string, int>>(z.SalesSummaryJson) ?? new();
        var banquetSummary = JsonSerializer.Deserialize<List<BanquetShiftReportDto>>(z.BanquetSummaryJson) ?? new();
        var inventoryPulls = JsonSerializer.Deserialize<Dictionary<int, int>>(z.InventoryPullsJson) ?? new();
        var totalPrepaidDeposits = banquetSummary.Sum(b => b.Deposits.Where(d => d > 0).Sum());
        var totalPrepaidReturned = banquetSummary.Sum(b => b.Deposits.Where(d => d < 0).Sum());

        // Parse Payouts from SalesSummaryJson
        decimal payoutTotal = 0;
        var payoutLines = new List<(string label, string amount)>();
        var regularSalesSummary = new Dictionary<string, int>(salesSummary);

        // Extract No Sale count
        int noSaleCount = 0;
        if (regularSalesSummary.ContainsKey("NO SALE (Drawer Open)"))
        {
            noSaleCount = regularSalesSummary["NO SALE (Drawer Open)"];
            regularSalesSummary.Remove("NO SALE (Drawer Open)");
        }

        foreach (var kvp in salesSummary)
        {
            if (kvp.Key.StartsWith("PAYOUT:"))
            {
                var parts = kvp.Key.Split(':');
                if (parts.Length >= 4 && int.TryParse(parts[3], out var amountCents))
                {
                    var cat = parts[1];
                    var desc = parts[2];
                    var amt = amountCents / 100m;
                    payoutTotal += amt;
                    var payLabel = string.IsNullOrEmpty(desc) ? $"  - {cat}" : $"  - {cat} ({desc})";
                    payoutLines.Add((payLabel, $"-{amt:C}"));
                }
                regularSalesSummary.Remove(kvp.Key);
            }
        }

        // Subtract banquet item sales from standard category calculations
        foreach (var b in banquetSummary)
        {
            foreach (var item in b.ItemSummary)
            {
                if (regularSalesSummary.ContainsKey(item.Key))
                {
                    regularSalesSummary[item.Key] -= item.Value;
                    if (regularSalesSummary[item.Key] <= 0)
                        regularSalesSummary.Remove(item.Key);
                }
            }
        }

        // Remove deposit keys
        var depositKeys = regularSalesSummary.Keys
            .Where(k => k.StartsWith("TAB DEPOSIT:") || k.StartsWith("INITIAL DEPOSIT:") || k.StartsWith("DEPOSIT CORRECTION:"))
            .ToList();
        foreach (var k in depositKeys) regularSalesSummary.Remove(k);

        decimal tokenCredits = z.TokenCredits;

        // Group regular sales by category
        var groupedRegular = regularSalesSummary
            .Select(kvp => {
                var cleanKey = kvp.Key;
                if (cleanKey.EndsWith(" (CREDITED)")) cleanKey = cleanKey.Replace(" (CREDITED)", "");
                if (cleanKey.Contains(" (TOKEN SALE)")) cleanKey = cleanKey.Replace(" (TOKEN SALE)", "");
                if (cleanKey.Contains(" (TOKEN REDEEMED)")) cleanKey = cleanKey.Replace(" (TOKEN REDEEMED)", "");
                
                var product = DbItems.FirstOrDefault(i => i.Name == cleanKey);
                var category = product?.Category;
                if (kvp.Key.StartsWith("TAB DEPOSIT:")) category = "DEPOSITS";
                if (kvp.Key.Contains("TOKEN CREDIT") || kvp.Key.Contains("(TOKEN REDEEMED)") || kvp.Key.Contains("TOKEN")) category = "TOKENS";
                
                decimal price = product?.Price ?? 0;
                if (price == 0 && (kvp.Key.Contains("TOKEN") || kvp.Key.Contains("Token")))
                {
                    var token = DbTokens.FirstOrDefault(t => t.Name.Equals(cleanKey, StringComparison.OrdinalIgnoreCase));
                    if (token != null)
                    {
                        price = token.SalePrice;
                    }
                }
                
                if (kvp.Key.StartsWith("> ") && kvp.Key.Contains(" TOKEN CREDIT FOR "))
                {
                    var tokenPart = kvp.Key.Substring(2, kvp.Key.IndexOf(" TOKEN CREDIT FOR ") - 2).Trim();
                    var token = DbTokens.FirstOrDefault(t => t.Name.Equals(tokenPart, StringComparison.OrdinalIgnoreCase));
                    if (token != null) price = -(token.CreditValue ?? token.SalePrice);
                }
                return new { Name = kvp.Key, Quantity = kvp.Value, Category = category ?? "MISC", Total = price * kvp.Value };
            })
            .GroupBy(x => x.Category)
            .OrderBy(g => g.Key);

        // ── Build pre-formatted plain-text receipt ──────────────────────────
        var sb = new System.Text.StringBuilder();

        // Header
        ReceiptFormatter.AppendReceiptHeader(sb,
            title1: isXReport ? "GFC X-REPORT" : "GFC Z-REPORT",
            title2: z.TerminalName,
            dateStr: z.Timestamp.ToString("ddd, MMM d yyyy  h:mm tt"),
            operatorName: $"Bartender: {z.BartenderName}",
            isReprint: isReprint);

        // Financial Summary section
        ReceiptFormatter.AppendSectionHeader(sb, "FINANCIAL SUMMARY");
        ReceiptFormatter.AppendBlank(sb);
        ReceiptFormatter.AppendLine(sb, "GROSS SALES", $"{z.TotalGrossSales:C}");
        if (totalPrepaidDeposits > 0)
            ReceiptFormatter.AppendLine(sb, "PREPAID FUNDS DEPOSITED", $"+{totalPrepaidDeposits:C}");
        if (totalPrepaidReturned < 0)
            ReceiptFormatter.AppendLine(sb, "PREPAID FUNDS RETURNED", $"-{Math.Abs(totalPrepaidReturned):C}");
        if (tokenCredits > 0)
            ReceiptFormatter.AppendLine(sb, "TOKEN CREDITS", $"-{tokenCredits:C}");
        if (payoutTotal > 0)
            ReceiptFormatter.AppendLine(sb, "TOTAL PAYOUTS", $"-{payoutTotal:C}");
        if (noSaleCount > 0)
            ReceiptFormatter.AppendLine(sb, "NO SALE COUNT", noSaleCount.ToString());
        ReceiptFormatter.AppendBlank(sb);
        
        if (payoutTotal > 0)
        {
            ReceiptFormatter.AppendLine(sb, "CASH SALES", $"{z.CashTotal:C}");
            ReceiptFormatter.AppendLine(sb, "TOTAL PAYOUTS", $"-{payoutTotal:C}");
            ReceiptFormatter.AppendLine(sb, "EXPECTED CASH IN DRAWER", $"{(z.CashTotal - payoutTotal):C}");
            ReceiptFormatter.AppendBlank(sb);
            foreach (var wl in ReceiptFormatter.WrapText("* Expected cash in drawer = Cash Sales minus Payouts.", 0))
                sb.Append(wl).Append('\n');
        }
        else
        {
            ReceiptFormatter.AppendLine(sb, "CASH IN DRAWER", $"{z.CashTotal:C}");
        }

        // Payouts detail
        if (payoutLines.Any())
        {
            ReceiptFormatter.AppendSectionHeader(sb, "DRAWER PAYOUTS");
            foreach (var (lbl, amt) in payoutLines)
                ReceiptFormatter.AppendLine(sb, lbl, amt);
            ReceiptFormatter.AppendDivider(sb, '-');
            ReceiptFormatter.AppendLine(sb, "TOTAL PAYOUTS", $"-{payoutTotal:C}");
        }

        // Shift Breakdown (regular sales by category)
        ReceiptFormatter.AppendSectionHeader(sb, "SHIFT BREAKDOWN");
        foreach (var group in groupedRegular)
        {
            ReceiptFormatter.AppendBlank(sb);
            ReceiptFormatter.AppendLeft(sb, group.Key.ToUpper());
            foreach (var item in group.OrderByDescending(x => x.Quantity))
            {
                var qty = $"{item.Quantity} x";
                var name = item.Name.ToUpper();
                var combined = qty.PadRight(4) + " " + name;
                if (combined.Length > ReceiptFormatter.Width)
                    combined = combined[..ReceiptFormatter.Width];
                sb.Append(combined.PadRight(ReceiptFormatter.Width)).Append('\n');
            }
            var groupTotal = group.Sum(x => x.Total);
            ReceiptFormatter.AppendLine(sb, $"  {group.Key} TOTAL", $"{groupTotal:C}");
        }

        // Banquet Activity
        if (banquetSummary.Any())
        {
            ReceiptFormatter.AppendSectionHeader(sb, "BANQUET ACTIVITY");
            foreach (var b in banquetSummary)
            {
                var isRunningTab = b.EventType == "RunningTab";
                ReceiptFormatter.AppendBlank(sb);
                ReceiptFormatter.AppendLeft(sb, $"EVENT: {b.EventName.ToUpper()}");
                ReceiptFormatter.AppendDivider(sb, '.');
                if (!isRunningTab && b.Deposits.Any(d => d >= 0))
                {
                    ReceiptFormatter.AppendLeft(sb, "DEPOSITS:");
                    for (int i = 0; i < b.Deposits.Count; i++)
                    {
                        var dep = b.Deposits[i];
                        if (dep < 0) continue;
                        var lbl = i == 0 ? "  - Initial Deposit" : "  - Add Funds";
                        var amt = $"{dep:C}";
                        ReceiptFormatter.AppendLine(sb, lbl, amt);
                    }
                }
                ReceiptFormatter.AppendLeft(sb, "TAB PURCHASES:");
                foreach (var item in b.ItemSummary.OrderByDescending(x => x.Value))
                {
                    var itemTotal = b.ItemTotals.ContainsKey(item.Key) ? b.ItemTotals[item.Key] : 0;
                    ReceiptFormatter.AppendLine(sb, $"  {item.Value} x {item.Key}", $"{itemTotal:C}");
                }
                ReceiptFormatter.AppendDivider(sb, '.');
                ReceiptFormatter.AppendLine(sb, "TOTAL SPENT", $"{b.TotalSpent:C}");
                var remaining = b.Deposits.Sum() - b.TotalSpent;
                if (!isRunningTab)
                    ReceiptFormatter.AppendLine(sb, "TAB BALANCE", $"{remaining:C}");
                else
                    ReceiptFormatter.AppendLine(sb, "TOTAL DUE", $"{b.TotalSpent:C}");
            }
        }

        // Inventory Removal Log
        if (inventoryPulls.Any())
        {
            ReceiptFormatter.AppendSectionHeader(sb, "INVENTORY REMOVAL LOG");
            foreach (var pull in inventoryPulls)
            {
                var prod = DbItems.FirstOrDefault(i => i.Id == pull.Key);
                if (prod != null)
                    ReceiptFormatter.AppendLine(sb, prod.Name.ToUpper(), pull.Value.ToString());
            }
        }

        // Total Sales footer
        ReceiptFormatter.AppendBlank(sb);
        ReceiptFormatter.AppendDivider(sb, '=');
        ReceiptFormatter.AppendLine(sb, "TOTAL SALES", $"{z.TotalGrossSales:C}");
        ReceiptFormatter.AppendDivider(sb, '=');
        ReceiptFormatter.AppendBlank(sb);
        ReceiptFormatter.AppendCenter(sb, $"REF: {z.Id}");
        ReceiptFormatter.AppendCenter(sb, $"Standalone v{VersionService.GetRevision()}");

        return sb.ToString();
    }


