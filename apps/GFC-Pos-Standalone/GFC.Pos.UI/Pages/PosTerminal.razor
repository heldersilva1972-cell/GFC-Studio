    private DateTime GetBusinessDayStart()
    {
        var now = DateTime.Now;
        // If it's before 3am, the business day started at 3am yesterday.
        if (now.Hour < 3) return now.Date.AddDays(-1).AddHours(3);
        // If it's after 3am, the business day started at 3am today.
        return now.Date.AddHours(3);
    }

    private void CheckDailyReset()
    {
        var dayStart = GetBusinessDayStart();
        if (_lastResetCheck < dayStart)
        {
            Console.WriteLine($"[POS] 3AM DAILY RESET: Starting fresh for business day {dayStart:g}");
            ItemFrequency.Clear();
            SpeedBarItemIds.Clear();
            _lastResetCheck = DateTime.Now;
            UpdateSpeedBar();
        }
    }

