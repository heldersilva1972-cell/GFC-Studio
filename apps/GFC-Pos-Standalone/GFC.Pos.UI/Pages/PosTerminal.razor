    .shift-overlay { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(15, 23, 42, 0.85) !important; z-index: 5000; display: flex; align-items: center; justify-content: center; backdrop-filter: blur(8px); }
    @@keyframes pulse-red { 0% { box-shadow: 0 0 0 0 rgba(220,38,38,0.4); } 70% { box-shadow: 0 0 0 15px rgba(220,38,38,0); } 100% { box-shadow: 0 0 0 0 rgba(220,38,38,0); } }

    .banquet-manager-card {
        background: white !important;
        width: 1050px !important;
        max-width: 98vw !important;
        border-radius: 40px !important;
        padding: 2.5rem !important;
        border: 1px solid rgba(0,0,0,0.1) !important;
        box-shadow: 0 50px 100px -20px rgba(0,0,0,0.3) !important;
        max-height: 90vh;
        display: flex;
        flex-direction: column;
        overflow: hidden;
        transition: width 0.3s ease;
    }
    .banquet-manager-card.no-active-banquets {
        width: 720px !important;
    }
