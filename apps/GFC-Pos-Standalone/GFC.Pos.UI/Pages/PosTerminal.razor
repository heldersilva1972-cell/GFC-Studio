    private IEnumerable<ProductItem> CreditEligibleItems
    {
        get
        {
            if (_pendingTokenForCredit == null) return Enumerable.Empty<ProductItem>();

            return CartItems.Where(i => 
                !i.IsTokenApplied && 
                i.Price > 0 && 
                IsItemEligibleForCredit(i)
            ).ToList();
        }
    }

    private bool IsItemEligibleForCredit(ProductItem item)
    {
        if (_pendingTokenForCredit == null || item == null) return false;

        // 1. If explicit approved items are configured on the upgrade token, strictly enforce them
        if (!string.IsNullOrEmpty(_pendingTokenForCredit.EligibleItemIds))
        {
            var allowedIds = _pendingTokenForCredit.EligibleItemIds.Split(',', StringSplitOptions.RemoveEmptyEntries)
                                .Select(id => int.TryParse(id.Trim(), out int val) ? val : (int?)null)
                                .Where(id => id.HasValue)
                                .Select(id => id!.Value)
                                .ToList();
            return allowedIds.Contains(item.Id);
        }

        // 2. Otherwise, fall back to matching by categories or auto-inference
        return IsCategoryEligibleForToken(item.Category);
    }


    private bool IsCategoryEligibleForToken(string? category)
    {
        if (_pendingTokenForCredit == null || string.IsNullOrEmpty(category)) return false;
        
        // 1. If explicit upgrade categories are defined, restrict by them
        if (!string.IsNullOrEmpty(_pendingTokenForCredit.CreditEligibleCategories))
        {
            var allowed = _pendingTokenForCredit.CreditEligibleCategories.Split(',', StringSplitOptions.RemoveEmptyEntries)
                            .Select(c => c.Trim().ToUpper());
            return allowed.Contains(category.Trim().ToUpper());
        }
        
        // 2. Auto-inference: If no explicit upgrade categories are defined, default to the categories of the items
        // that the base token (or current token if no base) was eligible to cover (EligibleItemIds)!
        var sourceToken = _pendingTokenForCredit.UpgradesFromTokenId.HasValue
            ? (DbTokens.FirstOrDefault(t => t.Id == _pendingTokenForCredit.UpgradesFromTokenId.Value) ?? _pendingTokenForCredit)
            : _pendingTokenForCredit;

        var baseCategories = new HashSet<string>();
        if (!string.IsNullOrEmpty(sourceToken.EligibleItemIds))
        {
            var ids = sourceToken.EligibleItemIds.Split(',', StringSplitOptions.RemoveEmptyEntries)
                        .Select(id => int.TryParse(id, out int val) ? val : (int?)null)
                        .Where(id => id.HasValue)
                        .Select(id => id!.Value);
            
            foreach(var id in ids)
            {
                var item = DbItems.FirstOrDefault(x => x.Id == id);
                if (item != null && !string.IsNullOrEmpty(item.Category))
                    baseCategories.Add(item.Category.Trim().ToUpper());
            }
        }
        
        if (baseCategories.Any())
        {
            return baseCategories.Contains(category.Trim().ToUpper());
        }
        
        // 3. Ultimate Fallback: if no eligible items or categories are defined, allow upgrading any item
        return true;
    }
    
