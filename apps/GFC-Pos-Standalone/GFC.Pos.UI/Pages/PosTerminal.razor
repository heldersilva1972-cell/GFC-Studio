    private async Task FinalizeSale()
    {
        var amountToRecord = Subtotal;
        var payment = _isTabPayment ? "TAB" : ((amountToRecord == 0) ? "TOKEN/COMP" : "CASH");
        var saleId = _correctingSaleId ?? Guid.NewGuid();

        // BUILD THE SALE RECORD FIRST
        var sale = new PosSaleDto
        {
            Id = saleId,
            Timestamp = DateTime.Now,
            TerminalName = forceTrainingMode ? $"{TerminalName} (TRAINING)" : TerminalName,
            TotalAmount = amountToRecord,
            BartenderName = CurrentUserName,
            PaymentType = payment,
            ActiveEventId = _isTabPayment ? _selectedActiveEvent?.Id : null,
            ItemsJson = JsonSerializer.Serialize(CartItems),
            AmountReceived = _isTabPayment ? amountToRecord : CashReceived,
            ChangeDue = _isTabPayment ? 0 : ((CashReceived.HasValue && CashReceived.Value > amountToRecord) ? (CashReceived.Value - amountToRecord) : null),
            OriginalTotal = _isCorrectionMode ? _originalSaleAmount : 0,
            IsCorrection = _isCorrectionMode
        };
        
        if (!forceTrainingMode && _isTabPayment && _selectedActiveEvent != null)
        {
            _selectedActiveEvent.CurrentBalance -= amountToRecord;
        }
        
        // 1. UPDATE SHIFT DATABASE (PROPER ARCHITECTURE)
        if (!forceTrainingMode)
        {
            if (_isCorrectionMode && _lastSale != null)
            {
                await PosService.VoidSaleAsync(_lastSale.Id, "Correction Replacement");
                sale.IsCorrection = true;
                sale.OriginalSaleId = _lastSale.Id;
                sale.AdjustmentReason = $"Corrected from {_originalSaleAmount:N2}";
            }

            await PosService.AddSaleToShiftAsync(sale);
            await UpdateAuditAsync();
        }

        _lastSale = sale; // Update last sale tracker
        _isCorrectionMode = false;
        _originalSaleAmount = 0;

        if (!forceTrainingMode) 
        {
            // Open drawer for CASH sales or ANY Correction (where cash may need to be returned/collected)
            if (payment == "CASH" || _isCorrectionMode)
            {
                await PrinterService.KickDrawerAsync();
            }

            await PosService.SaveSaleAsync(sale);
            
            if (_correctingSaleId != null)
            {
                _correctingSaleId = null;
            }
            
            foreach (var ci in CartItems.Where(i => i.Category != "TOKENS" && i.Category != "FOOD")) 
            {
                if (!ItemFrequency.ContainsKey(ci.Id)) ItemFrequency[ci.Id] = 0;
                ItemFrequency[ci.Id] += ci.Quantity;
            }
        }
        
        ClearCart(); 
        _correctingSaleId = null; 
        _isTabPayment = false;
        ShowCheckoutOverlay = false; 
        CashReceived = null; 
        CashInputString = "";
        showSuccessOverlay = true; 
        StateHasChanged(); 
        await Task.Delay(1000); 
        showSuccessOverlay = false;
        UpdateSpeedBar(); 
        StateHasChanged();
    }

