    private string _lastSyncError = "";
    private async Task RefreshData(bool cacheOnly = false)
    {
        // 1. [HYDRATE] Always pull from local vault first.
        try
        {
            var cached = await PosService.GetCachedMenuAsync();
            if (cached != null && (cached.Items.Any() || cached.Categories.Any()))
            {
                _cachedMenu = cached;
                await UpdateLocalCollectionsAsync(cached);
                _isInitialLoading = false;
                await InvokeAsync(StateHasChanged);
                Console.WriteLine($"[POS] HYDRATED: Loaded {cached.Items.Count} items from Local Vault.");
            }
        }
        catch (Exception ex) { Console.WriteLine($"[POS] Hydrate Error: {ex.Message}"); }

        if (cacheOnly) return;

        // 2. [SYNC] Silent refresh from server.
        try
        {
            if (Connectivity.IsServerReachable)
            {
                var menu = await PosService.GetMenuAsync(force: true);
                // [SYNC-GUARD] Only overwrite if we actually got items back
                if (menu != null && (menu.Items.Any() || menu.Categories.Any()))
                {
                    _cachedMenu = menu;
                    await UpdateLocalCollectionsAsync(menu);
                    await FilterDbActiveEventsWithPendingClosures();
                    await AdjustActiveEventBalancesWithPendingSales();
                    Console.WriteLine($"[POS] SYNC SUCCESS: Updated Vault with {menu.Items.Count} items.");
                }
                else
                {
                    Console.WriteLine("[POS] SYNC SKIPPED: Server returned empty/null. Preserving local data.");
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[POS] SYNC ERROR (Silently Ignored): {ex.Message}");
        }
        finally
        {
            _isInitialLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task FilterDbActiveEventsWithPendingClosures()
    {
        try
        {
            var vaultItems = await JSRuntime.InvokeAsync<JsonElement>("window.gfcGetAllAsync");
            if (vaultItems.ValueKind == JsonValueKind.Array && DbActiveEvents != null && DbActiveEvents.Any())
            {
                var closedEventIds = new HashSet<int>();
                foreach (var item in vaultItems.EnumerateArray())
                {
                    var key = item.GetProperty("key").GetString();
                    if (key != null && key.StartsWith("gfc_pos_vault_event_close_"))
                    {
                        var rawData = item.GetProperty("data");
                        int eventId = 0;
                        if (rawData.ValueKind == JsonValueKind.Number)
                            eventId = rawData.GetInt32();
                        else if (rawData.ValueKind == JsonValueKind.String)
                            int.TryParse(rawData.GetString(), out eventId);
                        
                        if (eventId != 0)
                        {
                            closedEventIds.Add(eventId);
                        }
                    }
                }

                if (closedEventIds.Any())
                {
                    DbActiveEvents.RemoveAll(e => closedEventIds.Contains(e.Id));
                    if (_cachedMenu != null)
                    {
                        _cachedMenu.ActiveEvents = DbActiveEvents;
                    }
                    if (_selectedActiveEvent != null && closedEventIds.Contains(_selectedActiveEvent.Id))
                    {
                        var directEvent = DbActiveEvents.FirstOrDefault(ev => ev.Name.EndsWith(" [Direct]") || ev.Name.EndsWith("[Direct]"));
                        _selectedActiveEvent = directEvent;
                        ActiveCategory = "BEER";
                    }
                    Console.WriteLine($"[POS] Filtered out {closedEventIds.Count} pending closed events from active UI list.");
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[POS] Error filtering pending event closures: {ex.Message}");
        }
    }

    private async Task AdjustActiveEventBalancesWithPendingSales()
    {
        try
        {
            // 1. Adjust for pending TAB sales
            var unsyncedSales = await PosService.GetUnsyncedSalesAsync();
            if (unsyncedSales != null && unsyncedSales.Any())
            {
                // Group unsynced, non-voided TAB sales by ActiveEventId and sum their TotalAmount
                var unsyncedTabTotals = unsyncedSales
                    .Where(s => s.PaymentType == "TAB" && s.ActiveEventId.HasValue && !s.IsVoided)
                    .GroupBy(s => s.ActiveEventId!.Value)
                    .ToDictionary(g => g.Key, g => g.Sum(s => s.TotalAmount));

                if (unsyncedTabTotals.Any() && DbActiveEvents != null)
                {
                    foreach (var ev in DbActiveEvents)
                    {
                        if (unsyncedTabTotals.TryGetValue(ev.Id, out var pendingDeduction))
                        {
                            ev.CurrentBalance -= pendingDeduction;
                            Console.WriteLine($"[POS] Adjusted event '{ev.Name}' balance with pending outbox sales: -{pendingDeduction:C} (New Balance: {ev.CurrentBalance:C})");
                        }
                    }
                }
            }

            // 2. Adjust for pending offline Add Funds requests
            var vaultItems = await JSRuntime.InvokeAsync<JsonElement>("window.gfcGetAllAsync");
            if (vaultItems.ValueKind == JsonValueKind.Array && DbActiveEvents != null && DbActiveEvents.Any())
            {
                var pendingAddFunds = new Dictionary<int, decimal>();
                foreach (var item in vaultItems.EnumerateArray())
                {
                    var key = item.GetProperty("key").GetString();
                    if (key != null && key.StartsWith("gfc_pos_vault_event_add_funds_"))
                    {
                        try
                        {
                            var rawData = item.GetProperty("data");
                            AddFundsRequest? req = null;
                            if (rawData.ValueKind == JsonValueKind.String)
                                req = JsonSerializer.Deserialize<AddFundsRequest>(rawData.GetString()!, new JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                            else
                                req = JsonSerializer.Deserialize<AddFundsRequest>(rawData.GetRawText(), new JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                            
                            if (req != null && req.Amount > 0)
                            {
                                if (pendingAddFunds.ContainsKey(req.Id))
                                    pendingAddFunds[req.Id] += req.Amount;
                                else
                                    pendingAddFunds[req.Id] = req.Amount;
                            }
                        }
                        catch {}
                    }
                }

                if (pendingAddFunds.Any())
                {
                    foreach (var ev in DbActiveEvents)
                    {
                        if (pendingAddFunds.TryGetValue(ev.Id, out var pendingAddition))
                        {
                            ev.CurrentBalance += pendingAddition;
                            Console.WriteLine($"[POS] Adjusted event '{ev.Name}' balance with pending offline added funds: +{pendingAddition:C} (New Balance: {ev.CurrentBalance:C})");
                        }
                    }
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[POS] Error adjusting balances with pending sales/funds: {ex.Message}");
        }
    }


