    private void ActivateDartsMode()
    {
        isDartsModeActive = true; 
        
        if (CartItems.Any()) 
        {
            // 1. Remove food items (strictly prohibited)
            int removedFood = CartItems.RemoveAll(i => i.Category == "FOOD");
            if (removedFood > 0) 
            {
                ShowNotice("Items Removed", "Food items were removed because they are not allowed during Darts Club Rounds.", "warning");
            }

            // 2. Zero out eligible items
            foreach (var item in CartItems.Where(i => i.Price > 0)) 
            {
                if (item.Category == "BEER" || item.Category == "LIQUOR" || item.Category == "TOKENS") 
                {
                    item.Name = item.Name.Contains("(DARTS)") ? item.Name : $"{item.Name} (DARTS)";
                    item.Price = 0;
                }
            }
        }
        StateHasChanged();
    }

    private Guid? _correctingSaleId = null;
    private void LoadDartsRoundForCorrection(PosSaleDto sale) { _correctingSaleId = sale.Id; isDartsModeActive = true; CartItems = JsonSerializer.Deserialize<List<ProductItem>>(sale.ItemsJson) ?? new(); StateHasChanged(); }

    private async Task AddToCart(ProductItem item)
    {
        if (isDartsModeActive && item.Category == "FOOD") 
        {
             ShowNotice("Not Allowed", "Food items cannot be added during Darts Club Rounds.", "warning");
             return;
        }

        var isDartComp = isDartsModeActive;
        var price = isDartComp ? 0 : item.Price;
        var name = isDartComp && !item.Name.Contains("(DARTS)") ? $"{item.Name} (DARTS)" : item.Name;

        var existing = CartItems.FirstOrDefault(x => x.Id == item.Id && x.Price == price && x.Name == name && (!x.Modifiers.Any()));
        if (existing != null) 
        {
            existing.Quantity++;
            SelectedCartItem = existing;
        }
        else 
        {
            var newItem = new ProductItem { Id = item.Id, Name = name, Price = price, Category = item.Category, Quantity = 1 };
            CartItems.Add(newItem);
            SelectedCartItem = newItem;
        }
        
        StateHasChanged();
        
        // SPEED OPTIMIZATION: Don't await JS scroll, fire and forget for instant response
        _ = JSRuntime.InvokeVoidAsync("window.gfcScrollToBottom", "cartItemsList");
    }

    private void AddTokenToCart(PosToken token)
    {
        int tokenId = -token.Id;
        var price = isDartsModeActive ? 0 : token.SalePrice;
        var name = isDartsModeActive ? $"{token.Name} (TOKEN SALE) (DARTS)" : $"{token.Name} (TOKEN SALE)";
        var existing = CartItems.FirstOrDefault(x => x.Id == tokenId && x.Price == price);
        if (existing != null) existing.Quantity++;
        else CartItems.Add(new ProductItem { Id = tokenId, Name = name, Price = price, Category = "TOKENS", Quantity = 1 });
        
        StateHasChanged();
        
        // SPEED OPTIMIZATION: Don't await JS scroll
        _ = JSRuntime.InvokeVoidAsync("window.gfcScrollToBottom", "cartItemsList");
    }

    private void ApplyTokenRedemption(PosToken token, bool forceUpgrade)
    {
        // 1. If Upgrade is explicitly selected, switch to selection view
        if (forceUpgrade && token.AllowCreditUpgrade.GetValueOrDefault())
        {
            _pendingTokenForCredit = token;
            StateHasChanged();
            return;
        }

        // 2. Standard Logic: Try for EXACT matches first (Zero-Out)
        var eligibleIds = string.IsNullOrEmpty(token.EligibleItemIds) 
            ? new List<int>() 
            : token.EligibleItemIds.Split(',', StringSplitOptions.RemoveEmptyEntries)
                .Select(id => int.TryParse(id, out int val) ? val : (int?)null)
                .Where(id => id.HasValue)
                .Select(id => id!.Value)
                .ToList();
        
        var itemToZero = CartItems.FirstOrDefault(i => !i.IsTokenApplied && eligibleIds.Contains(i.Id) && i.Price > 0);
        
        if (itemToZero != null) 
        {
            // Standard redemption
            if (itemToZero.Quantity > 1) 
            { 
                itemToZero.Quantity--; 
                CartItems.Add(new ProductItem { Id = itemToZero.Id, Name = $"{itemToZero.Name} (TOKEN REDEEMED)", Price = 0, Category = itemToZero.Category, Quantity = 1, IsTokenApplied = true }); 
            }
            else 
            { 
                itemToZero.Name = $"{itemToZero.Name} (TOKEN REDEEMED)"; 
                itemToZero.Price = 0; 
                itemToZero.IsTokenApplied = true;
            }
            showRedeemOverlay = false;
            _pendingTokenForCredit = null;
            Toast.ShowSuccess($"{token.Name} applied!");
            StateHasChanged();
        } 
        else if (token.AllowCreditUpgrade.GetValueOrDefault())
        {
            // Fallback: If no exact match but upgrade is possible, show the selection anyway
            _pendingTokenForCredit = token;
            StateHasChanged();
        }
        else 
        { 
            ShowNotice("Missing Item", $"No qualifying item found in cart for {token.Name}.", "warning"); 
        }
    }

    private void ApplyTokenCreditToItem(ProductItem item)
    {
        if (_pendingTokenForCredit == null || item.IsTokenApplied) return;

        decimal creditValue = _pendingTokenForCredit.CreditValue ?? _pendingTokenForCredit.SalePrice;
        
        // If the item is cheaper than the token, just zero it out (No change rule)
        if (item.Price <= creditValue)
        {
            if (item.Quantity > 1) 
            { 
                item.Quantity--; 
                CartItems.Add(new ProductItem { Id = item.Id, Name = $"{item.Name} (TOKEN REDEEMED)", Price = 0, Category = item.Category, Quantity = 1, IsTokenApplied = true }); 
            }
            else 
            { 
                item.Name = $"{item.Name} (TOKEN REDEEMED)"; 
                item.Price = 0; 
                item.IsTokenApplied = true;
            }
        }
        else
        {
            // Tag the original item so it can't be credited again
            if (item.Quantity > 1)
            {
                // Split the item if quantity > 1 so only one unit is credited
                item.Quantity--;
                var creditedUnit = new ProductItem 
                { 
                    Id = item.Id, 
                    Name = $"{item.Name} (CREDITED)", 
                    Price = item.Price, 
                    Category = item.Category, 
                    Quantity = 1, 
                    IsTokenApplied = true 
                };
                CartItems.Add(creditedUnit);
            }
            else
            {
                item.Name = $"{item.Name} (CREDITED)";
                item.IsTokenApplied = true;
            }

            // Add the negative credit line
            var creditItem = new ProductItem
            {
                Id = -_pendingTokenForCredit.Id, // Negative ID to distinguish
                Name = $"> {_pendingTokenForCredit.Name.ToUpper()} TOKEN CREDIT FOR {item.Name.Replace(" (CREDITED)", "").ToUpper()}",
                Price = -creditValue,
                Quantity = 1,
                Category = "TOKEN_CREDIT",
                IsTokenApplied = true // Credit line itself is protected
            };
            CartItems.Add(creditItem);
        }

        // Cleanup
        _pendingTokenForCredit = null;
        showRedeemOverlay = false;
        showTokenCreditSelection = false;
        Toast.ShowSuccess("Token credit applied!");
        StateHasChanged();
    }

    private void RemoveItem(ProductItem item) { if (item.Quantity > 1) item.Quantity--; else CartItems.Remove(item); }
