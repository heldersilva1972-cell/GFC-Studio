@if (showRedeemOverlay)
{
    <div class="shift-overlay">
            <div class="redeem-modal animate__animated animate__zoomIn">
                <div class="notice-icon-circle bg-blue">
                    <i class="bi bi-ticket-perforated-fill"></i>
                </div>
                
                @if (_pendingTokenForCredit == null)
                {
                    <h2 class="fw-black text-uppercase mb-1" style="color: #1e3a8a; letter-spacing: -1px; font-size: 1.8rem;">REDEEM TOKENS</h2>
                    <p class="text-muted fw-bold small mb-3 px-4">Select the token type to redeem one qualifying item.</p>
                    
                    <div class="p-3" style="max-height: 40vh; overflow-y: auto; overflow-x: hidden; width: 100%;">
                        <div class="row row-cols-4 g-2 w-100 m-0">
                            @foreach (var token in DbTokens.Where(t => t.IsActive))
                            {
                                @if (token.AllowCreditUpgrade.GetValueOrDefault())
                                {
                                    <div class="col">
                                        <button class="token-redeem-btn" @onclick="() => ApplyTokenRedemption(token, true)" style="border-top: 6px solid @token.ColorHex !important; background: #fffdf5 !important; border-bottom: 3px solid #fbbf24 !important;">
                                            <span class="token-name" style="color: #92400e !important; font-size: 0.7rem !important;">@token.Name UPGRADE</span>
                                            <div class="mt-1">
                                                <span class="badge bg-warning text-dark border shadow-sm px-2 py-0.5 rounded-pill" style="font-weight: 900; font-size: 0.5rem;">UPGRADE</span>
                                            </div>
                                        </button>
                                    </div>
                                }
                                else
                                {
                                    <div class="col">
                                        <button class="token-redeem-btn" @onclick="() => ApplyTokenRedemption(token, false)" style="border-top: 6px solid @token.ColorHex !important">
                                            <span class="token-name">@token.Name</span>
                                            <div class="mt-1">
                                                <span class="badge bg-primary text-white border shadow-sm px-2 py-0.5 rounded-pill" style="font-weight: 900; font-size: 0.5rem;">REDEEM</span>
                                            </div>
                                        </button>
                                    </div>
                                }
                            }
                        </div>
                    </div>

                    <div class="row w-100 m-0 mb-3 px-2">
                        <!-- Left Column: Quick Redeem Eligible Items -->
                        <div class="col-6 p-1">
                            <div class="p-3 bg-light rounded-4 text-start border shadow-sm h-100">
                                <div class="fw-black text-primary text-uppercase mb-2" style="font-size: 0.85rem; letter-spacing: 0.5px;">Quick Redeem Eligible:</div>
                                @if (GetRedeemableCartItems().Any())
                                {
                                    <div class="d-grid gap-2" style="max-height: 35vh; overflow-y: auto; overflow-x: hidden;">
                                        @foreach (var item in GetRedeemableCartItems())
                                        {
                                            var matchingToken = DbTokens.FirstOrDefault(t => t.IsActive && 
                                                !t.AllowCreditUpgrade.GetValueOrDefault() && 
                                                GetEligibleItemIds(t).Contains(item.Id));
                                                
                                            if (matchingToken != null)
                                            {
                                                <div class="d-flex justify-content-between align-items-center p-2 bg-white rounded-3 border">
                                                    <div class="d-flex align-items-center">
                                                        <span class="badge bg-primary text-white border shadow-sm px-2 py-1 rounded-3 me-2" style="font-weight: 900; font-size: 0.9rem; min-width: 45px; display: inline-block; text-align: center;">x @item.Quantity</span>
                                                        <div class="d-flex flex-column">
                                                            <span class="fw-black text-dark text-uppercase" style="font-size: 0.75rem; letter-spacing: -0.5px; line-height: 1.1;">@item.Name</span>
                                                            <span class="small text-muted fw-bold" style="font-size: 0.65rem;">Price: @item.Price.ToString("C")</span>
                                                        </div>
                                                    </div>
                                                    <button class="btn btn-sm btn-success rounded-pill px-2 py-1 fw-black text-uppercase" 
                                                            style="font-size: 0.65rem; background-color: #166534; border: none; letter-spacing: 0.5px;"
                                                            @onclick="() => ApplyTokenRedemption(matchingToken, false)">
                                                        Redeem
                                                    </button>
                                                </div>
                                            }
                                        }
                                    </div>
                                }
                                else
                                {
                                    <div class="text-muted small fw-bold text-center py-4">No eligible items left.</div>
                                }
                            </div>
                        </div>

                        <!-- Right Column: Already Redeemed Items -->
                        <div class="col-6 p-1">
                            <div class="p-3 bg-light rounded-4 text-start border shadow-sm h-100" style="border-left: 5px solid #166534 !important;">
                                <div class="fw-black text-success text-uppercase mb-2" style="font-size: 0.85rem; letter-spacing: 0.5px;">Already Redeemed:</div>
                                @if (GetRedeemedCartItems().Any())
                                {
                                    <div class="d-grid gap-2" style="max-height: 35vh; overflow-y: auto; overflow-x: hidden;">
                                        @foreach (var item in GetRedeemedCartItems())
                                        {
                                            <div class="d-flex justify-content-between align-items-center p-2 bg-white rounded-3 border" style="border-left: 4px solid #166534 !important;">
                                                <div class="d-flex align-items-center">
                                                    <span class="badge bg-success text-white border shadow-sm px-2 py-1 rounded-3 me-2" style="font-weight: 900; font-size: 0.9rem; min-width: 45px; display: inline-block; text-align: center;">x @item.Quantity</span>
                                                    <div class="d-flex flex-column">
                                                        <span class="fw-black text-success text-uppercase" style="font-size: 0.75rem; letter-spacing: -0.5px; line-height: 1.1;">@item.Name</span>
                                                        <span class="small text-muted fw-bold" style="font-size: 0.65rem;">Token Applied</span>
                                                    </div>
                                                </div>
                                                <button class="btn btn-sm btn-outline-danger rounded-pill px-2 py-1 fw-black text-uppercase" 
                                                        style="font-size: 0.65rem; border-width: 2px; letter-spacing: 0.5px;"
                                                        @onclick="() => UndoTokenRedemption(item)">
                                                    Undo
                                                </button>
                                            </div>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <div class="text-muted small fw-bold text-center py-4">No items redeemed yet.</div>
                                }
                            </div>
                        </div>
                    </div>
                    
                    <button class="btn btn-secondary w-100 rounded-pill py-3 fw-black shadow-sm" @onclick="() => showRedeemOverlay = false">
                        <i class="bi bi-check-lg me-2"></i> DONE
                    </button>

                }
                else
                {
                    <h2 class="fw-black text-uppercase mb-1" style="color: #1e3a8a; letter-spacing: -1px;">UPGRADE @(_pendingTokenForCredit.Name.ToUpper())</h2>
                    <p class="text-muted fw-bold small mb-4 px-4">Select the item from the cart to apply this @(_pendingTokenForCredit.Name) credit to:</p>
                    
                    <div class="w-100 mb-4" style="max-height: 40vh; overflow-y: auto;">
                        @if (CreditEligibleItems.Any())
                        {
                            <div class="d-grid gap-2">
                                @foreach (var item in CreditEligibleItems)
                                {
                                    <button class="btn btn-light border-2 text-start p-3 rounded-4 d-flex justify-content-between align-items-center transition-all hover-lift" 
                                            @onclick="() => ApplyTokenCreditToItem(item)">
                                        <div class="d-flex flex-column">
                                            <span class="fw-black text-primary text-uppercase" style="font-size: 0.9rem;">UPGRADE TO @item.Name</span>
                                            <span class="small text-muted fw-bold">CURRENT PRICE: @item.Price.ToString("C")</span>
                                        </div>
                                        <i class="bi bi-arrow-right-circle-fill text-primary fs-3"></i>
                                    </button>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-warning border-0 rounded-4 p-4 text-center">
                                <i class="bi bi-exclamation-triangle-fill fs-2 d-block mb-2"></i>
                                <div class="fw-bold">NO ELIGIBLE ITEMS IN CART</div>
                                @if (!string.IsNullOrEmpty(_pendingTokenForCredit.EligibleItemIds))
                                {
                                    <div class="small opacity-75">This token is only valid for upgrading specific configured premium items.</div>
                                }
                                else
                                {
                                    <div class="small opacity-75">This token requires a liquor or beer item to be in the order.</div>
                                }
                            </div>
                        }
                    </div>
                    
                    <div class="d-flex gap-2 w-100">
                        <button class="btn btn-outline-secondary flex-grow-1 rounded-pill py-3 fw-black" @onclick="() => _pendingTokenForCredit = null">
                            <i class="bi bi-arrow-left me-2"></i> BACK
                        </button>
                        <button class="btn btn-secondary flex-grow-1 rounded-pill py-3 fw-black" @onclick="() => { _pendingTokenForCredit = null; showRedeemOverlay = false; }">
                            CANCEL
                        </button>
                    </div>
                }
            </div>
    </div>
}


@if (ShowCheckoutOverlay)
{
    <div class="shift-overlay checkout-overlay">
          <div class="checkout-card animate__animated animate__zoomIn animate__faster">
              <div class="d-flex justify-content-between align-items-center">
                  <h3 class="fw-black mb-0">CHECKOUT</h3>
                  <button class="btn btn-light rounded-circle p-2" @onclick="CloseCheckoutOverlay">
                      <i class="bi bi-x-lg fs-5"></i>
                  </button>
              </div>
  
              <div class="checkout-display shadow-inner">
                  @if (_isCorrectionMode && _isMoneyCollected)
                  {
                      decimal diff = Subtotal - _originalSaleAmount;
                      
                      @if (diff < 0)
                      {
                          @* REFUND DISPLAY *@
                          <div class="refund-action-display animate__animated animate__pulse animate__infinite animate__slow">
                              <div class="refund-label">GIVE BACK REFUND</div>
                              <div class="refund-amount">@Math.Abs(diff).ToString("C")</div>
                              <div class="correction-footer">
                                  <span>WAS: @_originalSaleAmount.ToString("C")</span>
                                  <i class="bi bi-arrow-right mx-2"></i>
                                  <span>NOW: @Subtotal.ToString("C")</span>
                              </div>
                          </div>
                      }
                      else
                      {
                          @* COLLECT EXTRA DISPLAY - UNIFIED WITH STANDARD UI *@
                          <div class="display-row top">
                              <span class="label">EXTRA AMOUNT DUE</span>
                              <span class="value animate__animated animate__pulse animate__infinite" style="color: #dc2626;">@Math.Abs(diff).ToString("C")</span>
                          </div>
  
                          <div class="display-row-input-wrapper">
                              <span class="input-label">CASH TENDERED</span>
                              <div class="display-row main">
                                  <span class="currency">$</span>
                                  <span class="value">@(string.IsNullOrEmpty(CashInputString) ? "0.00" : CashInputString)</span>
                              </div>
                          </div>
  
                          <div class="display-status-bar @(CashReceived.HasValue && CashReceived.Value >= Math.Abs(diff) ? "status-change" : "status-pending")">
                              @if (CashReceived.HasValue && CashReceived.Value >= Math.Abs(diff))
                              {
                                  <span class="status-label">CHANGE DUE</span>
                                  <span class="status-value">@((CashReceived.Value - Math.Abs(diff)).ToString("C"))</span>
                              }
                              else
                              {
                                  <span class="status-label">STILL OWED</span>
                                  <span class="status-value">@(Math.Abs(Math.Abs(diff) - (CashReceived ?? 0)).ToString("C"))</span>
                              }
                          </div>
                      }
                  }
                  else
                  {
                      <div class="display-row top">
                          <span class="label">@( _isCorrectionMode ? "COLLECT NEW TOTAL" : "TOTAL DUE")</span>
                          <span class="value animate__animated animate__pulse animate__infinite">@Subtotal.ToString("C")</span>
                      </div>
  
                      <div class="display-row-input-wrapper">
                          <span class="input-label">CASH TENDERED</span>
                          <div class="display-row main">
                              <span class="currency">$</span>
                              <span class="value">@(string.IsNullOrEmpty(CashInputString) ? "0.00" : CashInputString)</span>
                          </div>
                      </div>
                      
                      <div class="display-status-bar @(CashReceived.HasValue && CashReceived.Value >= Subtotal ? "status-change" : "status-pending")">
                          <span class="status-label">@(CashReceived.HasValue && CashReceived.Value >= Subtotal ? "CHANGE DUE" : "STILL OWED")</span>
                          <span class="status-value">@Math.Abs(ChangeDue).ToString("C")</span>
                      </div>
                  }
              </div>
  
              @if (!(_isCorrectionMode && _isMoneyCollected && (Subtotal - _originalSaleAmount) < 0))
              {
                  <div class="checkout-main-grid">
                      <div class="numpad-container">
                          @foreach (var k in new[] { "7", "8", "9", "4", "5", "6", "1", "2", "3", ".", "0", "BACK" })
                          {
                              <button class="numpad-btn" @onclick='() => HandleNumPad(k)'>
                                  @if (k == "BACK") { <i class="bi bi-backspace-fill"></i> } else { @k }
                              </button>
                          }
                      </div>
  
                      <div class="quick-cash-column">
                          <button class="btn btn-quick-cash" @onclick="ClearCashReceived">CLEAR</button>
                          <button class="btn btn-quick-cash" @onclick="() => AddCashReceived(5)">$5</button>
                          <button class="btn btn-quick-cash" @onclick="() => AddCashReceived(10)">$10</button>
                          <button class="btn btn-quick-cash" @onclick="() => AddCashReceived(20)">$20</button>
                      </div>
                  </div>
              }
  
              <div class="checkout-button-group">
                  <button class="btn btn-primary btn-complete" @onclick="FinalizeSale" disabled="@_isFinalizingSale">
                      @(_isCorrectionMode ? "CONFIRM ADJUSTMENT" : "COMPLETE TRANSACTION")
                  </button>
                  <button class="btn btn-outline-secondary btn-add-more" @onclick="CloseCheckoutOverlay">BACK TO ORDER</button>
              </div>
          </div>
    </div>
}

@if (_showCorrectionConfirm)
{
    <div class="shift-overlay">
        <div class="notice-modal animate__animated animate__fadeInUp">
            <div class="notice-icon-circle bg-amber">
                <i class="bi bi-pencil-square"></i>
            </div>
            <h3 class="fw-black mb-2">CORRECT TRANSACTION?</h3>
            <p class="text-muted fw-bold mb-4">This will VOID the last transaction and load the items back into the cart for editing. The difference in cash will be calculated at checkout.</p>
            <div class="d-grid gap-2">
                <button class="btn btn-warning py-3 rounded-pill fw-black" @onclick="StartCorrection">YES, START CORRECTION</button>
                <button class="btn btn-light py-3 rounded-pill fw-bold" @onclick="() => _showCorrectionConfirm = false">CANCEL</button>
            </div>
        </div>
    </div>
}

@if (_showMoneyCollectedQuestion)
{
    <div class="shift-overlay" style="z-index: 1060;">
        <div class="money-question-card animate__animated animate__fadeInUp animate__faster">
            <div class="mb-4 text-primary">
                <i class="bi bi-cash-coin" style="font-size: 4rem; opacity: 0.8;"></i>
            </div>
            <h2 class="fw-black mb-3">CASH RECONCILIATION</h2>
            <p class="text-muted mb-5 px-4">Has the cash for the <strong>original</strong> amount (<span class="text-dark fw-bold">@_originalSaleAmount.ToString("C")</span>) already been collected from the customer?</p>
            
            <div class="d-grid gap-3 px-4">
                <button class="btn btn-success btn-lg py-4 fw-black rounded-pill shadow-sm animate__animated animate__pulse animate__infinite animate__slow" @onclick="() => HandleMoneyCollected(true)">
                    <i class="bi bi-check-circle-fill me-2"></i> YES, IT WAS COLLECTED
                </button>
                <button class="btn btn-outline-primary btn-lg py-4 fw-black rounded-pill" @onclick="() => HandleMoneyCollected(false)">
                    <i class="bi bi-x-circle me-2"></i> NO, COLLECT NEW TOTAL
                </button>
            </div>
            
            <button class="btn btn-link mt-4 text-muted text-decoration-none" @onclick="() => { _showMoneyCollectedQuestion = false; ShowCheckoutOverlay = false; }">
                <i class="bi bi-arrow-left me-1"></i> BACK TO ORDER
            </button>
        </div>
    </div>
}

@if (_showNoticeModal)
{
    <div class="shift-overlay no-backdrop" style="z-index: 100000;">
        <div class="notice-modal animate__animated animate__fadeInUp">
            <div class="notice-icon-circle @(_noticeType == "warning" || _noticeType == "dual" ? "bg-amber" : "bg-blue")">
                <i class="bi @(_noticeType == "warning" || _noticeType == "dual" ? "bi-exclamation-triangle-fill" : "bi-info-circle-fill")"></i>
            </div>
            <h3>@_noticeTitle</h3>
            <p>@_noticeMessage</p>
            <div class="d-flex gap-3 mt-4">
                @if (_noticeType == "dual") { 
                    <button class="btn btn-outline-secondary w-50 py-3 rounded-pill fw-bold" @onclick="() => _showNoticeModal = false">CANCEL</button> 
                    <button class="btn btn-primary w-50 py-3 rounded-pill fw-bold shadow-sm" @onclick="OnNoticeConfirm">YES, PROCEED</button> 
                }
                else { 
                    <button class="btn btn-primary w-100 py-3 rounded-pill fw-bold shadow-sm" @onclick="() => _showNoticeModal = false">@_noticeBtnText</button> 
                }
            </div>
        </div>
    </div>
}

@if (_showBanquetCloseModal && _closingBanquet != null)
{
    var evTmpl = DbEventTemplates?.FirstOrDefault(t => (_closingBanquet.TemplateId.HasValue && t.Id == _closingBanquet.TemplateId.Value) || (!string.IsNullOrEmpty(_closingBanquet.Name) && string.Equals(t.Name, _closingBanquet.Name, StringComparison.OrdinalIgnoreCase)));
    bool shouldPromptPrint = _closingBanquet.PromptPrintSummaryOnClose || (evTmpl?.PromptPrintSummaryOnClose ?? false);
    decimal amountOwed = _closingBanquet.CurrentBalance < 0 ? Math.Abs(_closingBanquet.CurrentBalance) : 0;

    <div class="shift-overlay no-backdrop" style="z-index: 9999;">
        <div class="notice-modal animate__animated animate__fadeInUp" style="max-width: 460px; @(amountOwed > 0 ? "border: 3px solid #ef4444;" : "")">
            @if (amountOwed > 0)
            {
                <div class="notice-icon-circle" style="background-color: #ef4444 !important; color: white;">
                    <i class="bi bi-cash-stack" style="font-size: 2.2rem;"></i>
                </div>
                <h3 class="text-danger fw-black">Collect Tab Balance</h3>
                <p class="mb-1 text-muted">
                    Total amount due for <strong>@GetEventDisplayName(_closingBanquet.Name)</strong>:
                </p>
                <div class="display-6 fw-black text-dark mb-3">@amountOwed.ToString("C")</div>
                <div class="alert alert-danger text-start mb-3 py-2.5 px-3 border rounded-3" style="background-color: #fef2f2; border-color: #fecaca; color: #991b1b;">
                    <i class="bi bi-exclamation-triangle-fill me-1"></i>
                    <strong>Cash Drawer:</strong> The drawer will kick open. Please collect <strong>@amountOwed.ToString("C")</strong> and place it in the drawer to finalize the tab.
                </div>
            }
            else
            {
                <div class="notice-icon-circle bg-amber" style="background-color: #f59e0b !important;">
                    <i class="bi bi-shield-lock-fill"></i>
                </div>
                <h3>Close Event Tab?</h3>
                <p class="mb-3">Are you sure you want to close <strong>@GetEventDisplayName(_closingBanquet.Name)</strong>? This will finalize all tab transactions.</p>
            }
            <div class="d-flex flex-column gap-2 mt-4">
                @if (shouldPromptPrint)
                {
                    <button class="btn btn-warning w-100 py-3 rounded-pill fw-black shadow-sm" style="background-color: #d97706; border-color: #d97706; color: white;" @onclick="() => ExecuteCloseBanquet(true)">
                        <i class="bi bi-printer-fill me-1"></i> @(amountOwed > 0 ? "COLLECTED, PRINT SUMMARY & CLOSE" : "YES, PRINT SUMMARY & CLOSE")
                    </button>
                    <button class="btn btn-primary w-100 py-3 rounded-pill fw-bold shadow-sm" @onclick="() => ExecuteCloseBanquet(false)">
                        <i class="bi bi-check-circle me-1"></i> @(amountOwed > 0 ? "COLLECTED, CLOSE WITHOUT PRINTING" : "YES, CLOSE WITHOUT PRINTING")
                    </button>
                }
                else
                {
                    <button class="btn btn-success w-100 py-3 rounded-pill fw-black shadow-sm" style="background-color: #10b981; border-color: #10b981; color: white;" @onclick="() => ExecuteCloseBanquet(false)">
                        <i class="bi bi-check-circle-fill me-1"></i> @(amountOwed > 0 ? $"COLLECTED {amountOwed:C} & CLOSE EVENT" : "YES, CLOSE EVENT")
                    </button>
                }
                <button class="btn btn-outline-secondary w-100 py-3 rounded-pill fw-bold mt-2" @onclick="() => { _showBanquetCloseModal = false; _closingBanquet = null; }">
                    CANCEL
                </button>
            </div>
        </div>
    </div>
}

@if (_showBanquetRefundPrompt && _closingBanquet != null)
{
    <div class="shift-overlay no-backdrop" style="z-index: 9999;">
        <div class="notice-modal animate__animated animate__fadeInUp" style="max-width: 480px; border: 3px solid #10b981;">
            <div class="notice-icon-circle" style="background-color: #10b981 !important; color: white;">
                <i class="bi bi-cash-coin" style="font-size: 2.5rem;"></i>
            </div>
            <h3 class="text-success fw-black">Refund Remaining Funds</h3>
            <p class="mb-3 text-muted">
                This event has a remaining prepaid balance of <strong class="text-dark fs-5">@_closingBanquet.CurrentBalance.ToString("C")</strong>.
            </p>
            <div class="alert alert-success d-flex align-items-center gap-3 text-start mb-4 py-3" style="background-color: #ecfdf5; border-color: #a7f3d0; color: #065f46;">
                <i class="bi bi-info-circle-fill fs-4 text-success"></i>
                <div class="small fw-bold">
                    Please REMOVE <span class="fs-6">@_closingBanquet.CurrentBalance.ToString("C")</span> from the cash drawer and return it to the customer. This ensures the cash drawer expectations remain 100% correct.
                </div>
            </div>
            
            <p class="fw-bold mb-4">Please confirm that you have removed these funds from the drawer:</p>
            
            <div class="d-grid gap-2">
                <button class="btn btn-success w-100 py-3 rounded-pill fw-black shadow-sm" style="background-color: #10b981; border-color: #10b981; color: white;" @onclick="ConfirmBanquetRefund">
                    <i class="bi bi-check-lg me-1"></i> YES, FUNDS REMOVED & RETURNED
                </button>
                <button class="btn btn-outline-secondary w-100 py-3 rounded-pill fw-bold" @onclick="() => { _showBanquetRefundPrompt = false; _closingBanquet = null; }">
                    CANCEL CLOSE
                </button>
            </div>
        </div>
    </div>
}

@if (_showPrepaidDepositWarningModal)
{
    <div class="shift-overlay no-backdrop" style="z-index: 9999;">
        <div class="notice-modal animate__animated animate__fadeInUp" style="max-width: 480px; border: 3px solid #dc2626;">
            <div class="notice-icon-circle" style="background-color: #dc2626 !important; color: white;">
                <i class="bi bi-exclamation-triangle-fill" style="font-size: 2.2rem;"></i>
            </div>
            <h3 class="text-danger fw-black">Deposit Required</h3>
            <p class="mb-3 text-muted">
                Prepaid events require a starting cash deposit before they can be opened.
            </p>
            <div class="alert alert-danger d-flex align-items-center gap-3 text-start mb-4 py-3" style="background-color: #fef2f2; border-color: #fca5a5; color: #991b1b;">
                <i class="bi bi-info-circle-fill fs-4 text-danger"></i>
                <div class="small fw-bold">
                    Please enter the starting cash amount received from the customer using the keypad to initialize the event balance.
                </div>
            </div>
            <div class="d-grid">
                <button class="btn btn-danger w-100 py-3 rounded-pill fw-black shadow-sm" style="background-color: #dc2626; border-color: #dc2626; color: white;" @onclick="() => _showPrepaidDepositWarningModal = false">
                    OK, UNDERSTOOD
                </button>
            </div>
        </div>
    </div>
}

@if (_showBanquetRefundSuccessConfirm)
{
    <div class="shift-overlay no-backdrop" style="z-index: 9999;">
        <div class="notice-modal animate__animated animate__fadeInUp" style="max-width: 480px; border: 3px solid #10b981;">
            <div class="notice-icon-circle" style="background-color: #10b981 !important; color: white;">
                <i class="bi bi-check-circle-fill" style="font-size: 2.5rem;"></i>
            </div>
            <h3 class="text-success fw-black">Refund Recorded</h3>
            <p class="mb-4 text-muted">
                A refund of <strong class="text-dark fs-5">@_refundedAmount.ToString("C")</strong> has been successfully recorded. The cash expectation in the drawer has been reduced accordingly.
            </p>
            
            <div class="d-flex flex-column gap-2">
                @if (_closingBanquet != null && (_closingBanquet.PromptPrintSummaryOnClose || (DbEventTemplates?.FirstOrDefault(t => (_closingBanquet.TemplateId.HasValue && t.Id == _closingBanquet.TemplateId.Value) || (!string.IsNullOrEmpty(_closingBanquet.Name) && string.Equals(t.Name, _closingBanquet.Name, StringComparison.OrdinalIgnoreCase)))?.PromptPrintSummaryOnClose ?? false)))
                {
                    <button class="btn btn-warning w-100 py-3 rounded-pill fw-black shadow-sm" style="background-color: #d97706; border-color: #d97706; color: white;" @onclick="() => { _showBanquetRefundSuccessConfirm = false; ExecuteCloseBanquet(true); }">
                        <i class="bi bi-printer-fill me-1"></i> PRINT SUMMARY & CLOSE
                    </button>
                    <button class="btn btn-primary w-100 py-3 rounded-pill fw-bold shadow-sm" @onclick="() => { _showBanquetRefundSuccessConfirm = false; ExecuteCloseBanquet(false); }">
                        <i class="bi bi-check-circle me-1"></i> CLOSE WITHOUT PRINTING
                    </button>
                }
                else
                {
                    <button class="btn btn-primary w-100 py-3 rounded-pill fw-bold shadow-sm" @onclick="() => { _showBanquetRefundSuccessConfirm = false; ExecuteCloseBanquet(false); }">
                        <i class="bi bi-check-circle me-1"></i> CLOSE EVENT
                    </button>
                }
            </div>
        </div>
    </div>
}

@if (_showOpenBanquetsZOutWarning)
{
    <div class="shift-overlay no-backdrop" style="z-index: 9999;">
        <div class="notice-modal animate__animated animate__fadeInUp" style="max-width: 480px; border: 3px solid #ef4444;">
            <div class="notice-icon-circle bg-amber" style="background-color: #ef4444 !important;">
                <i class="bi bi-exclamation-octagon-fill"></i>
            </div>
            <h3 class="text-danger fw-black">Open Events Detected!</h3>
            <p class="mb-3">
                There are currently <strong>@DbActiveEvents.Count</strong> active event(s) open:
            </p>
            <div class="bg-light p-3 rounded-3 mb-4 text-start" style="max-height: 150px; overflow-y: auto; border: 1px solid #e5e7eb; background-color: #f3f4f6 !important; color: #374151 !important;">
                @foreach (var ev in DbActiveEvents)
                {
                    <div class="d-flex justify-content-between align-items-center mb-2 pb-2 border-bottom">
                        <span class="fw-bold">@GetEventDisplayName(ev.Name)</span>
                        <span class="badge bg-danger rounded-pill px-2.5 py-1" style="background-color: #ef4444 !important;">OPEN TAB</span>
                    </div>
                }
            </div>
            <p class="small text-muted mb-4">
                Bartender shift close-out (Z-Report) can proceed with open events remaining open for subsequent shifts, but please verify before continuing.
            </p>
            <div class="d-flex flex-column gap-2">
                <button class="btn btn-danger w-100 py-3 rounded-pill fw-black shadow-sm" style="background-color: #ef4444; border-color: #ef4444;" @onclick="ProceedToCloseOut">
                    <i class="bi bi-arrow-right-circle-fill me-1"></i> PROCEED WITH CLOSE-OUT anyway
                </button>
                <button class="btn btn-outline-secondary w-100 py-3 rounded-pill fw-bold" @onclick="() => _showOpenBanquetsZOutWarning = false">
                    GO BACK TO CLOSE/MANAGE EVENTS
                </button>
            </div>
        </div>
    </div>
}

@if (showLiquorOrdersModal && !string.IsNullOrEmpty(CurrentUserName))
{
    <div class="shift-overlay" style="z-index: 10000; background: rgba(15, 23, 42, 0.85); backdrop-filter: blur(8px);">
        <div class="liquor-receive-card animate__animated animate__zoomIn bg-white shadow-lg border p-4 rounded-4" style="width: 1000px; max-width: 95vw; max-height: 90vh; display: flex; flex-direction: column; overflow: hidden;">
            
            <!-- Modal Header -->
            <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
                <div class="d-flex align-items-center gap-3">
                    <span class="rounded-circle text-white d-flex align-items-center justify-content-center" style="width: 50px; height: 50px; background-color: #22c55e;">
                        <i class="bi bi-truck fs-4"></i>
                    </span>
                    <div>
                        <h3 class="fw-black m-0" style="letter-spacing: -0.5px;">RECEIVE SUPPLIER DELIVERIES</h3>
                        <p class="text-muted m-0 small">Mark incoming Liquor Hub shipments as received and update local stocks</p>
                    </div>
                </div>
                <button class="btn border-0 bg-transparent" @onclick="CloseLiquorOrdersWorkflow">
                    <i class="bi bi-x-lg fs-4"></i>
                </button>
            </div>
            @if (_liquorOrdersIsOffline)
            {
                <div class="d-flex align-items-center gap-2 mb-3 px-1">
                    <span class="badge rounded-pill fw-black px-3 py-2 animate__animated animate__pulse animate__infinite" style="background: #fef3c7; color: #92400e; border: 1.5px solid #fde68a; font-size: 0.72rem; letter-spacing: 0.5px;">
                        <i class="bi bi-wifi-off me-1"></i> OFFLINE — Showing Cached Orders
                    </span>
                    <span class="text-muted small">Receipts will sync automatically when reconnected.</span>
                </div>
            }

            <!-- Modal Content -->
            <div class="row g-4 flex-grow-1 overflow-hidden" style="min-height: 0;">
                <!-- LEFT COLUMN: Shipments list OR Order item receiving -->
                <div class="col-7 d-flex flex-column h-100 overflow-hidden">
                    @if (_isFetchingLiquorOrders)
                    {
                        <div class="d-flex flex-column align-items-center justify-content-center flex-grow-1 py-5">
                            <div class="spinner-border text-success mb-3" role="status" style="width: 3rem; height: 3rem;"></div>
                            <h5 class="fw-bold text-muted">Retrieving Active Deliveries...</h5>
                        </div>
                    }
                    else if (_selectedLiquorOrder == null)
                    {
                        <h5 class="fw-black mb-3 text-secondary" style="font-size: 0.9rem; letter-spacing: 0.5px; text-transform: uppercase;">Pending Supplier Shipments (@_pendingLiquorOrders.Count)</h5>
                        @if (!_pendingLiquorOrders.Any())
                        {
                            <div class="d-flex flex-column align-items-center justify-content-center flex-grow-1 bg-light rounded-4 border border-dashed p-5 text-center">
                                <i class="bi bi-check-circle-fill text-success fs-1 mb-3"></i>
                                <h5 class="fw-bold m-0">All Deliveries Received</h5>
                                <p class="text-muted small m-0 mt-1">There are no outstanding Liquor Hub orders to receive at this time.</p>
                            </div>
                        }
                        else
                        {
                            <div class="liquor-shipments-list flex-grow-1 overflow-auto pe-2">
                                <div class="d-flex flex-column gap-2">
                                    @foreach (var order in _pendingLiquorOrders)
                                    {
                                        <div class="card border-2 supplier-shipment-card shadow-sm cursor-pointer position-relative animate__animated animate__fadeInUp" 
                                             @onclick="() => SelectLiquorOrder(order)">
                                            <div class="d-flex justify-content-between align-items-center">
                                                <div>
                                                    <div class="badge text-emerald mb-1.5 px-2.5 py-1 rounded-pill fw-bold" style="background: #f0fdf4; color: #166534; font-size: 0.72rem;">
                                                        <i class="bi bi-box-seam me-1"></i> Order #@order.Id
                                                    </div>
                                                    <h5 class="fw-black m-0" style="color: #0f172a; font-size: 1.1rem;">@(order.Vendor?.Name ?? "Supplier Delivery")</h5>
                                                    <p class="text-muted small mt-1 mb-0">
                                                        Ordered on <strong>@order.OrderDate.ToLocalTime().ToString("MMM dd, yyyy")</strong>
                                                    </p>
                                                </div>
                                                <div class="text-end">
                                                    <h4 class="fw-black text-dark m-0" style="font-size: 1.35rem;">@order.TotalCost.ToString("C")</h4>
                                                    <span class="badge rounded-pill mt-1.5 px-2 py-0.5 small" style="background: #f1f5f9; color: #475569;">
                                                        @(order.OrderItems?.Count ?? 0) Items
                                                    </span>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <!-- Order selected: list items -->
                        <div class="d-flex align-items-center justify-content-between mb-3">
                            <div>
                                <button class="btn btn-sm btn-outline-secondary border-2 rounded-pill fw-bold px-3 py-1 me-2" @onclick="() => _selectedLiquorOrder = null">
                                    <i class="bi bi-chevron-left"></i> Back to List
                                </button>
                                <span class="fw-black text-dark fs-5">@(_selectedLiquorOrder.Vendor?.Name ?? "Supplier") Order #@_selectedLiquorOrder.Id</span>
                            </div>
                            <div class="text-muted small">
                                Receiving @(_selectedLiquorOrder.OrderItems?.Count ?? 0) item@(_selectedLiquorOrder.OrderItems?.Count == 1 ? "" : "s")
                            </div>
                        </div>

                        <div class="liquor-items-list flex-grow-1 overflow-auto pe-2">
                            <div class="d-flex flex-column gap-2">
                                @foreach (var item in _selectedLiquorOrder.OrderItems)
                                {
                                    var isBackordered = _selectedBackorderItemIds.Contains(item.Id);
                                    <div class="liquor-item-row p-3 d-flex justify-content-between align-items-center animate__animated animate__fadeIn">
                                        <div class="d-flex align-items-center gap-3">
                                            <div class="rounded-circle d-flex align-items-center justify-content-center fw-black text-white" 
                                                 style="width: 40px; height: 40px; background-color: @(isBackordered ? "#ef4444" : "#22c55e"); font-size: 1rem;">
                                                @(item.Quantity)
                                            </div>
                                            <div>
                                                <h5 class="fw-bold m-0" style="color: #1e293b;">@(item.LiquorItem?.Name ?? "Liquor Item")</h5>
                                                <p class="text-muted small m-0">
                                                    Size: @(item.LiquorItem?.BottleSize ?? "Standard") | Category: @(item.LiquorItem?.Category ?? "General")
                                                </p>
                                            </div>
                                        </div>
                                        <div class="d-flex align-items-center gap-3">
                                            <div class="text-end me-2">
                                                <div class="fw-bold">@((item.Quantity * item.UnitPriceAtTimeOfOrder).ToString("C"))</div>
                                                <div class="text-muted small">@item.UnitPriceAtTimeOfOrder.ToString("C") ea</div>
                                            </div>
                                            
                                            <!-- RECEIVED / BACKORDER PILL -->
                                            <button type="button" class="btn @(isBackordered ? "btn-toggle-backordered" : "btn-toggle-received") px-3 py-2 border-0" 
                                                    style="min-width: 140px;" @onclick="() => ToggleBackorderItem(item.Id)">
                                                @if (isBackordered)
                                                {
                                                    <i class="bi bi-clock-history me-1"></i><span>BACKORDERED</span>
                                                }
                                                else
                                                {
                                                    <i class="bi bi-check-circle-fill me-1"></i><span>RECEIVED</span>
                                                }
                                            </button>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>

                <!-- RIGHT COLUMN: Inputs & Custom Keypad -->
                <div class="col-5 d-flex flex-column h-100 overflow-hidden border-start ps-4">
                    @if (_selectedLiquorOrder == null)
                    {
                        <div class="d-flex flex-column align-items-center justify-content-center flex-grow-1 text-center py-5">
                            <div class="rounded-circle bg-light d-flex align-items-center justify-content-center mb-4" style="width: 120px; height: 120px;">
                                <i class="bi bi-receipt-cutoff text-muted" style="font-size: 3.5rem;"></i>
                            </div>
                            <h4 class="fw-black text-dark">Supplier Receiving</h4>
                            <p class="text-muted px-4" style="max-width: 320px;">Select a pending delivery from the list on the left to verify item counts, invoice numbers, and finalize stock receiving.</p>
                        </div>
                    }
                    else
                    {
                        <div class="d-flex flex-column h-100">
                            <!-- Invoice / Price Fields -->
                            <div class="d-flex flex-column gap-2 mb-3">
                                <div class="invoice-input-card p-3 rounded-4 border-2 d-flex justify-content-between align-items-center cursor-pointer" 
                                     style="@InvoiceInputStyle" 
                                     @onclick="() => _isEditingTotalMode = false">
                                    <div>
                                        <span class="text-muted small uppercase fw-bold" style="letter-spacing: 0.5px; font-size: 0.7rem;">INVOICE NUMBER</span>
                                        <h4 class="fw-black m-0 @(string.IsNullOrEmpty(_invoiceInputString) ? "text-muted" : "text-dark")" style="font-size: 1.15rem;">
                                            @(string.IsNullOrEmpty(_invoiceInputString) ? "ENTER INVOICE #" : _invoiceInputString)
                                        </h4>
                                    </div>
                                    @if (!_isEditingTotalMode)
                                    {
                                        <span class="badge rounded-pill px-2 py-1 fw-bold" style="background: #22c55e; color: white; font-size: 0.7rem;">ACTIVE</span>
                                    }
                                </div>

                                <div class="invoice-input-card p-3 rounded-4 border-2 d-flex justify-content-between align-items-center cursor-pointer" 
                                     style="@InvoiceTotalStyle" 
                                     @onclick="SetEditingTotalMode">
                                    <div>
                                        <span class="text-muted small uppercase fw-bold" style="letter-spacing: 0.5px; font-size: 0.7rem;">ACTUAL INVOICE TOTAL</span>
                                        <h4 class="fw-black m-0 text-dark" style="font-size: 1.15rem;">
                                            @_invoiceTotalDue.ToString("C")
                                        </h4>
                                    </div>
                                    <div class="text-end">
                                        <span class="text-muted d-block" style="font-size: 0.75rem;">Expected: @_selectedLiquorOrder.TotalCost.ToString("C")</span>
                                        @if (_isEditingTotalMode)
                                        {
                                            <span class="badge rounded-pill px-2 py-1 fw-bold mt-1" style="background: #22c55e; color: white; font-size: 0.7rem;">ACTIVE</span>
                                        }
                                    </div>
                                </div>
                            </div>

                            <!-- Visual Keypad -->
                            <div class="flex-grow-1 d-flex flex-column justify-content-center">
                                <div class="liquor-keypad mb-3 animate__animated animate__fadeIn">
