    private void StartCorrection()
    {
        if (_lastSale == null) return;
        
        _isCorrectionMode = true;
        _originalSaleAmount = _lastSale.TotalAmount;
        
        // Load items back to cart
        CartItems.Clear();
        var items = JsonSerializer.Deserialize<List<ProductItem>>(_lastSale.ItemsJson);
        if (items != null) CartItems.AddRange(items);
        
