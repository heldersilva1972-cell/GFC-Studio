@code {
    // ─── EVENT BEER INVENTORY TALLY DASHBOARD STATE ───
    private ActiveEvent? inlineTallyEvent;
    private string? inlineTallyMode;
    private List<BeerTallyItem> currentTallies = new();
    private int selectedBeerIdToAdd;
    private bool showCloseEventConfirm = false;

    private void PromptCloseEventConfirm()
    {
        showCloseEventConfirm = true;
    }

    private async Task ConfirmCloseEvent()
    {
        showCloseEventConfirm = false;
        await SaveInlineTally(true);
    }

    public class BeerTallyItem
    {
        public int ItemId { get; set; }
        public string Name { get; set; } = string.Empty;
        public decimal Price { get; set; }
        public int QuantityTaken { get; set; }
        public int QuantityReturned { get; set; }
        public int Consumed => Math.Max(0, QuantityTaken - QuantityReturned);
        public decimal Subtotal => Consumed * Price;
        public bool EnableClubSplit { get; set; }
        public decimal ClubSplitAmount { get; set; }
        public decimal ClubSubtotal => Consumed * (EnableClubSplit ? ClubSplitAmount : Price);
        public decimal EventSubtotal => Consumed * (EnableClubSplit ? Math.Max(0, Price - ClubSplitAmount) : 0);
    }

    private List<BeerTallyItem> GetActiveEventTallies(ActiveEvent ae)
    {
        var list = new List<BeerTallyItem>();
        if (ae == null) return list;

        if (!string.IsNullOrEmpty(ae.BeerTalliesJson))
        {
            try
            {
                list = global::System.Text.Json.JsonSerializer.Deserialize<List<BeerTallyItem>>(
                    ae.BeerTalliesJson,
                    new global::System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true }
                ) ?? new();
            }
            catch {}
        }

        // Merge any donated items into the tally list so they are available to sell (default QuantityTaken = 0 until actually removed/sold)
        var donatedStock = GetAllDonatedStockForEvent(ae);
        if (donatedStock.Any())
        {
            foreach (var ds in donatedStock)
            {
                var existing = list.FirstOrDefault(t => t.ItemId == ds.ItemId);
                if (existing == null)
                {
                    var item = DbItems?.FirstOrDefault(i => i.Id == ds.ItemId);
                    list.Add(new BeerTallyItem
                    {
                        ItemId = ds.ItemId,
                        Name = !string.IsNullOrWhiteSpace(ds.BeerName) ? ds.BeerName : (item?.Name ?? "Donated Beer"),
                        Price = item?.Price ?? ds.Price,
                        QuantityTaken = 0,
                        QuantityReturned = 0,
                        EnableClubSplit = false,
                        ClubSplitAmount = 0m
                    });
                }
            }
        }

        return list;
    }

    private bool HasRemovedBeers(ActiveEvent ae)
    {
        var tallies = GetActiveEventTallies(ae);
        return tallies.Any(t => t.QuantityTaken > 0);
    }

    private decimal CalculateRemovedValue(ActiveEvent ae)
    {
        var tallies = GetActiveEventTallies(ae);
        return tallies.Sum(t => t.QuantityTaken * t.Price);
    }

    private decimal GetTallyClubPortion(ActiveEvent ev, BeerTallyItem t)
    {
        if (ev == null || t == null) return t?.ClubSubtotal ?? 0m;
        
        var allDonatedStock = GetAllDonatedStockForEvent(ev);
        var ds = allDonatedStock.FirstOrDefault(d => d.ItemId == t.ItemId);
        if (ds != null && ds.TotalCans > 0)
        {
            int donatedCansQuota = ds.TotalCans;
            int donatedApplied = Math.Min(t.Consumed, donatedCansQuota);
            int standardConsumed = Math.Max(0, t.Consumed - donatedApplied);
            
            decimal standardClubUnit = t.EnableClubSplit ? t.ClubSplitAmount : t.Price;
            return standardConsumed * standardClubUnit;
        }

        return t.ClubSubtotal;
    }

    private decimal GetTallyEventPortion(ActiveEvent ev, BeerTallyItem t)
    {
        if (ev == null || t == null) return t?.EventSubtotal ?? 0m;

        var allDonatedStock = GetAllDonatedStockForEvent(ev);
        var ds = allDonatedStock.FirstOrDefault(d => d.ItemId == t.ItemId);
        if (ds != null && ds.TotalCans > 0)
        {
            int donatedCansQuota = ds.TotalCans;
            int donatedApplied = Math.Min(t.Consumed, donatedCansQuota);
            int standardConsumed = Math.Max(0, t.Consumed - donatedApplied);

            decimal eventDonatedUnit = t.Price;
            decimal eventStandardUnit = t.EnableClubSplit ? Math.Max(0, t.Price - t.ClubSplitAmount) : 0m;

            return (donatedApplied * eventDonatedUnit) + (standardConsumed * eventStandardUnit);
        }

        return t.EventSubtotal;
    }

    private int DeductFromDonatedJson(object target, int itemId, int cansToDeduct)
    {
        string? json = target switch
        {
            ActiveEvent ev => ev.DonatedItemIdsJson,
            EventTemplate tmpl => tmpl.DonatedItemIdsJson,
            _ => null
        };

        if (string.IsNullOrEmpty(json)) return cansToDeduct;

        try
        {
            var dict = JsonSerializer.Deserialize<Dictionary<int, int>>(json);
            if (dict != null && dict.TryGetValue(itemId, out var rawVal) && rawVal > 0)
            {
                int currentCans = rawVal;
                int actualDeduction = Math.Min(currentCans, cansToDeduct);
                int newCans = Math.Max(0, currentCans - actualDeduction);
                dict[itemId] = newCans;
                string updatedJson = JsonSerializer.Serialize(dict);

                if (target is ActiveEvent ev) ev.DonatedItemIdsJson = updatedJson;
                else if (target is EventTemplate tmpl) tmpl.DonatedItemIdsJson = updatedJson;

                return cansToDeduct - actualDeduction;
            }
        }
        catch {}

        return cansToDeduct;
    }

    private decimal CalculateConsumedValue(ActiveEvent ae)
    {
        var tallies = GetActiveEventTallies(ae);
        return tallies.Sum(t => GetTallyClubPortion(ae, t));
    }

    private bool CanCancelActiveEvent(ActiveEvent? ev)
    {
        if (ev == null) return false;
        // Running tab: cannot cancel if balance has increased (money owed)
        if (ev.Type == GFC.Core.Enums.EventTabType.RunningTab && Math.Abs(ev.CurrentBalance) > 0) return false;
        // Prepaid tab: cannot cancel if funds were consumed or changed from starting deposit
        if (ev.Type == GFC.Core.Enums.EventTabType.PrePaid && ev.CurrentBalance != ev.InitialAmount) return false;
        // Beer tally: cannot cancel if any drinks have been consumed/taken
        if (ev.EnableBeerTally)
        {
            var tallies = GetActiveEventTallies(ev);
            if (tallies.Any(t => t.QuantityTaken > 0 || t.Consumed > 0)) return false;
        }
        return true;
    }

    private async Task CancelActiveEvent(ActiveEvent ev)
    {
        if (ev == null) return;
        try
        {
            ev.IsDeleted = true;
            ev.Status = GFC.Core.Enums.EventTabStatus.Closed;
            ev.BeerTalliesJson = null;
            ev.DonatedItemIdsJson = null;
            ev.DonatedItemTalliesJson = null;
            ev.DonatedBeerClaimedCount = 0;
            ev.DonatedBeerReDonatedCount = 0;
            ev.DonatedBeerSoldCount = 0;
            ev.CurrentBalance = 0;

            // Save pending closure in IndexedDB so FilterDbActiveEventsWithPendingClosures permanently excludes it
            var closeVaultKey = $"gfc_pos_vault_event_close_{ev.Id}";
            try { await JSRuntime.InvokeVoidAsync("window.gfcSetAsync", closeVaultKey, ev.Id); } catch {}

            var request = new UpdateEventTallyRequest
            {
                Id = ev.Id,
                BeerTalliesJson = null,
                InitialAmount = ev.InitialAmount,
                CurrentBalance = 0,
                DonatedItemIdsJson = null,
                DonatedItemTalliesJson = null,
                DonatedBeerClaimedCount = 0,
                DonatedBeerReDonatedCount = 0,
                DonatedBeerSoldCount = 0,
                CloseEvent = true,
                IsRecurring = ev.IsRecurring
            };
            try { await Http.PostAsJsonAsync("api/pos/events/update-tally", request); } catch {}
            try { await Http.PostAsync($"api/pos/events/cancel/{ev.Id}", null); } catch {}
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[POS] CancelActiveEvent error: {ex.Message}");
        }

        if (DbActiveEvents != null) DbActiveEvents.RemoveAll(e => e.Id == ev.Id);
        if (_selectedActiveEvent?.Id == ev.Id)
        {
            var directEvent = DbActiveEvents?.FirstOrDefault(e => e.Name.EndsWith(" [Direct]") || e.Name.EndsWith("[Direct]"));
            _selectedActiveEvent = directEvent;
        }

        if (_cachedMenu != null)
        {
            _cachedMenu.ActiveEvents = DbActiveEvents;
            try { await PosService.SaveMenuToVaultAsync(_cachedMenu); } catch {}
        }

        currentTallies = new List<BeerTallyItem>();
        
        Toast.ShowInfo($"Event '{ev.Name}' canceled.");
        StateHasChanged();
    }

    private void StartInlineTallyEdit(ActiveEvent ae, string mode)
    {
        inlineTallyEvent = ae;
        inlineTallyMode = mode;
        currentTallies = new List<BeerTallyItem>();
        selectedBeerIdToAdd = 0;

        // Load existing tallies if any (check both ae and DbActiveEvents instance)
        var localEv = DbActiveEvents?.FirstOrDefault(e => e.Id == ae.Id);
        if (localEv != null)
        {
            if (string.IsNullOrEmpty(ae.DonatedItemIdsJson) && !string.IsNullOrEmpty(localEv.DonatedItemIdsJson))
                ae.DonatedItemIdsJson = localEv.DonatedItemIdsJson;
            if (string.IsNullOrEmpty(localEv.DonatedItemIdsJson) && !string.IsNullOrEmpty(ae.DonatedItemIdsJson))
                localEv.DonatedItemIdsJson = ae.DonatedItemIdsJson;
        }
        var jsonToLoad = !string.IsNullOrEmpty(ae.BeerTalliesJson) ? ae.BeerTalliesJson : localEv?.BeerTalliesJson;

        if (!string.IsNullOrEmpty(jsonToLoad))
        {
            try
            {
                currentTallies = global::System.Text.Json.JsonSerializer.Deserialize<List<BeerTallyItem>>(
                    jsonToLoad, 
                    new global::System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true }
                ) ?? new();
            }
            catch (Exception)
            {
                currentTallies = new();
            }
        }

        var template = ae.Template ?? DbEventTemplates?.FirstOrDefault(t => 
            (ae.TemplateId.HasValue && t.Id == ae.TemplateId.Value) || 
            (!string.IsNullOrEmpty(ae.Name) && (
                string.Equals(t.Name, ae.Name, StringComparison.OrdinalIgnoreCase) ||
                string.Equals(GetEventDisplayName(t.Name).Trim(), GetEventDisplayName(ae.Name).Trim(), StringComparison.OrdinalIgnoreCase) ||
                (t.Name.ToLower().Contains("horseshoe") && ae.Name.ToLower().Contains("horseshoe"))
            ))
        );

        if (template != null)
        {
            if (template.IsRecurring)
            {
                ae.IsRecurring = true;
                inlineTallyEvent.IsRecurring = true;
            }
        }

        var allDonatedStock = GetAllDonatedStockForEvent(ae);

        // Always ensure ALL active beer items from DB are included
        if (DbItems != null)
        {
            var templateOverrides = new List<BanquetOverrideDto>();
            if (template != null && !string.IsNullOrEmpty(template.ItemsOverrideJson))
            {
                try
                {
                    templateOverrides = global::System.Text.Json.JsonSerializer.Deserialize<List<BanquetOverrideDto>>(
                        template.ItemsOverrideJson,
                        new global::System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true }
                    ) ?? new();
                }
                catch (Exception) { }
            }

            foreach (var item in DbItems.Where(i => i.Category.Trim().ToUpper() == "BEER"))
            {
                var existing = currentTallies.FirstOrDefault(t => t.ItemId == item.Id);
                var ov = templateOverrides.FirstOrDefault(o => o.ItemId == item.Id);

                // STRICT: ONLY include if explicitly enabled on the template (TrackTally or IsVisible) OR already has recorded quantities
                bool isEnabledInTemplate = ov != null && (ov.TrackTally || ov.IsVisible);
                bool hasActivity = existing != null && (existing.QuantityTaken > 0 || existing.QuantityReturned > 0);

                if (isEnabledInTemplate || hasActivity)
                {
                    if (existing == null)
                    {
                        decimal price = (ov != null && ov.OverridePrice > 0) ? ov.OverridePrice : item.Price;
                        currentTallies.Add(new BeerTallyItem
                        {
                            ItemId = item.Id,
                            Name = item.Name,
                            Price = price,
                            QuantityTaken = 0,
                            QuantityReturned = 0,
                            EnableClubSplit = ov?.EnableClubSplit ?? false,
                            ClubSplitAmount = ov?.ClubSplitAmount ?? 0
                        });
                    }
                    else
                    {
                        if (ov != null)
                        {
                            existing.Price = ov.OverridePrice > 0 ? ov.OverridePrice : existing.Price;
                            existing.EnableClubSplit = ov.EnableClubSplit;
                            existing.ClubSplitAmount = ov.ClubSplitAmount;
                        }
                    }
                }
            }

            // Ensure any active donated stock items not in regular beer list are also added
            foreach (var ds in allDonatedStock.Where(ds => ds.TotalCans > 0))
            {
                if (!currentTallies.Any(t => t.ItemId == ds.ItemId))
                {
                    var dbItem = DbItems?.FirstOrDefault(i => i.Id == ds.ItemId);
                    currentTallies.Add(new BeerTallyItem
                    {
                        ItemId = ds.ItemId,
                        Name = !string.IsNullOrWhiteSpace(ds.BeerName) ? ds.BeerName : (dbItem?.Name ?? $"Item #{ds.ItemId}"),
                        Price = dbItem?.Price ?? ds.Price,
                        QuantityTaken = 0,
                        QuantityReturned = 0,
                        EnableClubSplit = false,
                        ClubSplitAmount = 0m
                    });
                }
            }
        }
    }

