        background: white;
        color: #d97706;
        padding: 4px 12px;
        border-radius: 50px;
        font-size: 0.7rem;
        animation: pulse-orange 1s infinite;
    }
    @@keyframes pulse-orange {
        0% { opacity: 1; }
        50% { opacity: 0.5; }
        100% { opacity: 1; }
    }
