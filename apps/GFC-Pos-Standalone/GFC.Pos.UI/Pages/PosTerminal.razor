    private decimal ResolveUpstairsPriceForItem(ProductItem item)
    {
        var dbItem = DbItems.FirstOrDefault(x => x.Id == item.Id);
        decimal baseMemberPrice = item.BaseMemberPrice ?? dbItem?.Price ?? item.Price;
        decimal? explicitUpstairs = item.UpstairsPrice ?? dbItem?.UpstairsPrice;
        if (explicitUpstairs.HasValue && explicitUpstairs.Value > 0)
        {
            return explicitUpstairs.Value;
        }
        return baseMemberPrice + Math.Max(0m, _upstairsFallbackUpcharge);
    }

    private decimal ResolveMemberPriceForItem(ProductItem item)
    {
        if (item.BaseMemberPrice.HasValue && item.BaseMemberPrice.Value > 0)
        {
            return item.BaseMemberPrice.Value;
        }
        var dbItem = DbItems.FirstOrDefault(x => x.Id == item.Id);
        return dbItem?.Price ?? item.Price;
    }

    private async Task ToggleUpstairsMode()
    {
        _isUpstairsModeActive = !_isUpstairsModeActive;

        if (_isUpstairsModeActive && !DbItems.Any(x => x.UpstairsPrice.HasValue) && Connectivity.IsServerReachable)
        {
            try
            {
                var freshMenu = await PosService.GetMenuAsync(force: true);
                if (freshMenu != null && freshMenu.Items.Any())
                {
                    _cachedMenu = freshMenu;
                    await UpdateLocalCollectionsAsync(freshMenu);
                }
            }
            catch { }
        }

        foreach (var item in CartItems)
        {
            if (item.IsComped || item.IsTokenApplied || item.Category == "TOKEN_CREDIT" || item.Category == "TOKENS" || item.Name.Contains("(TOKEN") || item.Name.Contains("(DARTS"))
                continue;

            decimal memberPrice = ResolveMemberPriceForItem(item);
            item.BaseMemberPrice = memberPrice;

            if (_isUpstairsModeActive)
            {
                item.Price = ResolveUpstairsPriceForItem(item);
                item.IsUpstairsPrice = true;
            }
            else
            {
                item.Price = memberPrice;
                item.IsUpstairsPrice = false;
            }
        }

        MergeIdenticalCartLines();
        SyncCustomerDisplay();
        StateHasChanged();
    }

    private void ToggleSingleCartItemUpstairsPrice(ProductItem item)
    {
        if (item == null || item.IsComped || item.IsTokenApplied || item.Category == "TOKEN_CREDIT" || item.Category == "TOKENS" || item.Name.Contains("(TOKEN") || item.Name.Contains("(DARTS"))
            return;

        decimal memberPrice = ResolveMemberPriceForItem(item);
        decimal upstairsPrice = ResolveUpstairsPriceForItem(item);
        bool targetUpstairs = !item.IsUpstairsPrice;
        decimal newPrice = targetUpstairs ? upstairsPrice : memberPrice;

        if (item.Quantity > 1)
        {
            item.Quantity--;
            var existingMatch = CartItems.FirstOrDefault(x => x.Id == item.Id && x.IsUpstairsPrice == targetUpstairs && x.Price == newPrice && x.Name == item.Name && !x.Modifiers.Any() && !x.IsComped && !x.IsTokenApplied);
            if (existingMatch != null)
            {
                existingMatch.Quantity++;
                SelectedCartItem = existingMatch;
            }
            else
            {
                var splitItem = new ProductItem
                {
                    Id = item.Id,
                    Name = item.Name,
                    Price = newPrice,
                    BaseMemberPrice = memberPrice,
                    UpstairsPrice = item.UpstairsPrice,
                    IsUpstairsPrice = targetUpstairs,
                    Category = item.Category,
                    Quantity = 1,
                    DisplayOrder = item.DisplayOrder,
                    ZReportGroup = item.ZReportGroup
                };
                CartItems.Add(splitItem);
                SelectedCartItem = splitItem;
            }
        }
        else
        {
            item.BaseMemberPrice = memberPrice;
            item.Price = newPrice;
            item.IsUpstairsPrice = targetUpstairs;
            MergeIdenticalCartLines();
        }

        SyncCustomerDisplay();
        StateHasChanged();
    }

    private void MergeIdenticalCartLines()
    {
        for (int i = 0; i < CartItems.Count; i++)
        {
            var a = CartItems[i];
            if (a.IsComped || a.IsTokenApplied || a.Category == "TOKEN_CREDIT" || (a.Modifiers != null && a.Modifiers.Any()))
                continue;

            for (int j = CartItems.Count - 1; j > i; j--)
            {
                var b = CartItems[j];
                if (b.IsComped || b.IsTokenApplied || b.Category == "TOKEN_CREDIT" || (b.Modifiers != null && b.Modifiers.Any()))
                    continue;

                if (a.Id == b.Id && a.Name == b.Name && a.Price == b.Price && a.IsUpstairsPrice == b.IsUpstairsPrice)
                {
                    a.Quantity += b.Quantity;
                    if (SelectedCartItem == b) SelectedCartItem = a;
                    CartItems.RemoveAt(j);
                }
            }
        }
    }

