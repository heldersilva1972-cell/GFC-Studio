            }

            ModifierItems = filtered
                .Select(m => new ProductItem {
                    Id = m.ItemId,
                    Name = m.Name,
                    Price = m.Price,
                    Category = "MODIFIERS",
                    DisplayOrder = 0
                })
                .ToList();
        } catch {}
        
        showModifiersOverlay = true;
        StateHasChanged();
