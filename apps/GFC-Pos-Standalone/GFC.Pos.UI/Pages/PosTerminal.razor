        await JSRuntime.InvokeVoidAsync("GfcIdleTracker.initialize", DotNetObjectReference.Create(this));

        // Initialize Card Scanner
        await JSRuntime.InvokeVoidAsync("GfcCardScanner.initialize", DotNetObjectReference.Create(this));

        // [INSTANT-UPDATE] Check for update immediately on startup
        _ = Task.Run(async () => {
            await Task.Delay(2000); 
            await CheckForUpdatesAsync();
        });

        // Initialize Popular Items for current business day
        _lastResetCheck = DateTime.Now;
        var dayStart = GetBusinessDayStart();
        var allSales = await PosService.GetShiftAuditAsync(); 
        // For now, we initialize fresh or rely on the shift-persistence.
        UpdateSpeedBar();

        // Initialize draw audio system early so window.gfcDrawAudio is ready for user gestures
        await InitializeDrawAudio();
    }
    
