    }
    .btn-options:hover {
        background: #2563eb !important;
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(30, 58, 138, 0.2) !important;
    }
    .btn-options:active {
        transform: scale(0.95);
    }
