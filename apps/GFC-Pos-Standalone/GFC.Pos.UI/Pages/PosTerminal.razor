                    .Distinct()
                    .OrderBy(c => c)
                    .ToList();
            }
        }
        catch {}

        var legacyBeerStored = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "gfc_pos_legacy_beer_token_value");
        if (!string.IsNullOrEmpty(legacyBeerStored) && decimal.TryParse(legacyBeerStored, out var lbVal)) _legacyBeerTokenValue = lbVal;

        var legacyMixedStored = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "gfc_pos_legacy_mixed_token_value");
        if (!string.IsNullOrEmpty(legacyMixedStored) && decimal.TryParse(legacyMixedStored, out var lmVal)) _legacyMixedTokenValue = lmVal;

        // HARDENED LOAD: The source of truth is now the Database (Shift Log)
        await UpdateAuditAsync();
        
        var hardwareStored = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "gfc_pos_hardware_practice");
        if (!string.IsNullOrEmpty(hardwareStored)) allowHardwareInTraining = bool.Parse(hardwareStored);
        
        var autoDartsStored = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "gfc_pos_auto_darts_on_thursday");
        if (!string.IsNullOrEmpty(autoDartsStored)) _autoDartsOnThursday = bool.Parse(autoDartsStored);

        var dartsStored = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "gfc_pos_darts_in_training");
        if (!string.IsNullOrEmpty(dartsStored)) forceDartsOptionInTraining = bool.Parse(dartsStored);

        // Load Payout Categories
        try
        {
