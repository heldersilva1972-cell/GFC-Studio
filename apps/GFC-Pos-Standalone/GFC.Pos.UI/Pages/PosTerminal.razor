<style>
    /* SYNC STATUS POPOVER */
    .sync-status-popover {
        position: absolute;
        top: calc(100% + 12px);
        right: 0;
        z-index: 1000;
        width: 250px;
        background: white;
        border-radius: 16px;
        box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1), 0 8px 10px -6px rgba(0, 0, 0, 0.05);
        border: 1px solid #e2e8f0;
        padding: 16px;
        color: #1e293b;
        font-family: inherit;
        animation: popoverFadeIn 0.15s ease-out;
    }
    @@keyframes popoverFadeIn {
        from { opacity: 0; transform: translateY(-5px); }
        to { opacity: 1; transform: translateY(0); }
    }
    .sync-status-popover .popover-title {
        font-weight: 900;
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: #64748b;
        border-bottom: 1px solid #f1f5f9;
        padding-bottom: 8px;
        margin-bottom: 12px;
        text-align: left;
    }
    .sync-status-popover .pending-list-container {
        max-height: 200px;
        overflow-y: auto;
        border: 1px solid #f1f5f9;
        border-radius: 8px;
        padding: 4px;
        display: flex;
        flex-direction: column;
        gap: 4px;
    }
    .sync-status-popover .pending-item-row {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 6px 8px;
        border-bottom: 1px solid #f1f5f9;
        font-size: 0.75rem;
        text-align: left;
    }
    .sync-status-popover .pending-item-row:last-child {
        border-bottom: none;
    }
    .sync-status-popover .pending-item-row i {
        font-size: 1.1rem;
        color: #64748b;
        flex-shrink: 0;
    }
    .sync-status-popover .pending-item-row .item-details {
        display: flex;
        flex-direction: column;
        min-width: 0;
    }
    .sync-status-popover .pending-item-row .item-type {
        font-weight: 800;
        color: #475569;
        line-height: 1.2;
    }
    .sync-status-popover .pending-item-row .item-desc {
        color: #94a3b8;
        font-size: 0.68rem;
        word-break: break-all;
        line-height: 1.2;
    }
    .sync-status-popover .spin {
        animation: popoverSpin 1s linear infinite;
        display: inline-block;
    }
    @@keyframes popoverSpin {
        from { transform: rotate(0deg); }
        to { transform: rotate(360deg); }
    }

    /* DARTS CLUB ROUND SIDEBAR STYLE REVISIONS */
    .pos-cart.darts-mode-active {
        border-left: 3px solid #8b5cf6 !important;
        background: #faf5ff !important;
    }
    .pos-cart.darts-mode-active .cart-header {
        background: linear-gradient(135deg, #7c3aed 0%, #6d28d9 100%) !important;
        color: white !important;
    }
    .pos-cart.darts-mode-active .cart-header h3 {
        color: white !important;
    }
    .pos-cart.darts-mode-active .cart-header .items-count-badge {
        background: rgba(255, 255, 255, 0.2) !important;
        color: #ffffff !important;
        border-color: rgba(255, 255, 255, 0.4) !important;
    }
    .pos-cart.darts-mode-active .cart-header .items-count-badge .count,
    .pos-cart.darts-mode-active .cart-header .items-count-badge .label {
        color: #ffffff !important;
    }
    .pos-cart.darts-mode-active .cart-header .btn-clear-header {
        background: rgba(255, 255, 255, 0.15) !important;
        color: #ffffff !important;
        border: 1px solid rgba(255, 255, 255, 0.3) !important;
    }
    .pos-cart.darts-mode-active .cart-header .btn-clear-header:hover {
        background: rgba(255, 255, 255, 0.35) !important;
        color: #ffffff !important;
    }
    .pos-cart.darts-mode-active .cart-footer {
        background: #f3e8ff !important;
        border-top: 1px solid #ddd6fe !important;
    }
    .pos-cart.darts-mode-active .btn-checkout {
        background: linear-gradient(135deg, #8b5cf6 0%, #6d28d9 100%) !important;
        color: white !important;
        border: none !important;
        box-shadow: 0 4px 12px rgba(139, 92, 246, 0.3) !important;
    }
    .pos-cart.darts-mode-active .btn-checkout:hover {
        background: linear-gradient(135deg, #7c3aed 0%, #5b21b6 100%) !important;
        transform: translateY(-2px) !important;
    }

