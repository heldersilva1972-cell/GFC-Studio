                                var claimedPizzaSale = _todayDartsSales.FirstOrDefault(s => s.PaymentType == "PAYOUT" && s.ItemsJson.Contains("DART PIZZA"));
                                if (claimedPizzaSale != null)
                                {
                                    <div class="col">
                                        <button type="button" 
                                                class="btn w-100 p-3 rounded-3 text-start border border-secondary shadow-sm transition-all" 
                                                style="background: rgba(255,255,255,0.08); color: #cbd5e1;"
                                                @onclick="() => PromptEditClaimedPizzaPayout(claimedPizzaSale)">
                                            <div class="d-flex justify-content-between align-items-start mb-1">
                                                <span class="badge bg-secondary rounded-pill px-2.5 py-0.5 fw-bold" style="font-size: 0.68rem;">
                                                    <i class="bi bi-check-circle-fill me-1"></i> PAID OUT $@claimedPizzaSale.TotalAmount.ToString("F2")
                                                </span>
                                                <i class="bi bi-pencil-square text-warning fs-5"></i>
                                            </div>
                                            <div class="fw-black text-white" style="font-size: 0.95rem;">🍕 PIZZA PAYOUT</div>
                                            <p class="small mb-0 text-secondary" style="font-size: 0.72rem;">Click to Edit or Cancel Payout</p>
                                        </button>
                                    </div>
                                }
                                else
                                {
                                    <div class="col">
                                        <button type="button" 
                                                class="btn w-100 p-3 rounded-3 fw-black text-dark shadow-sm d-flex align-items-center justify-content-center gap-2.5 transition-all border-0" 
                                                style="background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%); color: #ffffff !important; box-shadow: 0 4px 14px rgba(245, 158, 11, 0.4) !important; font-size: 0.95rem; letter-spacing: 0.3px;" 
                                                @onclick="() => { _showDartsTeamModal = false; OpenPizzaPayoutModal(); }">
                                            <span class="fs-4">🍕</span>
                                            <div class="text-start">
                                                <div class="lh-1 text-white">PIZZA PAYOUT</div>
                                                <div class="small fw-bold text-white opacity-85 mt-1" style="font-size: 0.72rem;">$@_dartPizzaPayoutAmount.ToString("F2") Drawer Payout</div>
                                            </div>
                                        </button>
                                    </div>
                                }
                            }
                            @if (!_todayDartsSales.Any())
                            {
                                <div class="col">
                                    <button type="button" 
                                            class="btn w-100 p-3 rounded-3 fw-black text-white shadow-sm d-flex align-items-center justify-content-center gap-2.5 transition-all border-0" 
                                            style="background: linear-gradient(135deg, #dc2626 0%, #b91c1c 100%); box-shadow: 0 4px 14px rgba(220, 38, 38, 0.4) !important; font-size: 0.95rem; letter-spacing: 0.3px;" 
                                            @onclick="DismissDartsTonight">
                                        <i class="bi bi-slash-circle-fill fs-5 text-white"></i>
                                        <div class="text-start">
                                            <div class="lh-1 text-white">NO DARTS TONIGHT</div>
                                            <div class="small fw-normal text-white opacity-75 mt-1" style="font-size: 0.72rem;">Dismiss Darts Mode</div>
                                        </div>
                                    </button>
                                </div>
                            }
                            <div class="col">
                                <button type="button" 
                                        class="btn w-100 p-3 rounded-3 fw-black shadow-sm d-flex align-items-center justify-content-center gap-2.5 transition-all border-0" 
                                        style="background: linear-gradient(135deg, #64748b 0%, #475569 100%); color: #ffffff !important; box-shadow: 0 4px 14px rgba(71, 85, 105, 0.4) !important; font-size: 0.95rem; letter-spacing: 0.3px;" 
                                        @onclick="CompleteDartsNightEarly">
                                    <i class="bi bi-check-circle-fill fs-5 text-white"></i>
                                    <div class="text-start">
                                        <div class="lh-1 text-white">DONE FOR TONIGHT</div>
                                        <div class="small fw-bold text-white opacity-75 mt-1" style="font-size: 0.72rem;">Close Darts Session</div>
                                    </div>
                                </button>
                            </div>
                        </div>

                        <!-- HOME TEAMS SECTION -->
                        <div class="mb-4">
                            <div class="d-flex align-items-center justify-content-between mb-2.5">
                                <label class="form-label text-uppercase small fw-black tracking-wider opacity-90 m-0 text-violet-200 d-flex align-items-center gap-1.5">
                                    <i class="bi bi-house-door-fill text-violet-300"></i> Home Teams (@_activeDartsTeamCount Active):
                                </label>
                                <span class="badge rounded-pill bg-violet-subtle text-violet-200 border border-violet-700 px-2.5 py-1" style="font-size: 0.7rem; background: rgba(139, 92, 246, 0.25);">GFC Home</span>
                            </div>

                            <div class="row g-3">
                                @for (int t = 1; t <= _activeDartsTeamCount; t++)
                                {
                                    var teamNum = t;
                                    var teamName = $"Home Team {teamNum}";
                                    var legacyName = $"Team {teamNum}";
                                    var claimedSale = _todayDartsSales.FirstOrDefault(s => 
                                        s.ItemsJson.Contains($"(DARTS - {teamName})") || 
                                        s.ItemsJson.Contains($"(DARTS - {legacyName})") || 
                                        (teamNum == 1 && s.ItemsJson.Contains("(DARTS)") && !s.ItemsJson.Contains("(DARTS - Team") && !s.ItemsJson.Contains("(DARTS - Home") && !s.ItemsJson.Contains("(DARTS - Away")));

                                    if (claimedSale != null)
                                    {
                                        <div class="col-@(_activeDartsTeamCount == 1 ? "12" : _activeDartsTeamCount == 2 ? "6" : "4")">
                                            <button class="btn w-100 p-3.5 rounded-4 text-start border border-secondary shadow-sm transition-all" 
                                                    style="background: rgba(255,255,255,0.06); color: #cbd5e1;"
                                                    @onclick="() => PromptEditClaimedTeamRound(claimedSale, teamName)">
                                                <div class="d-flex justify-content-between align-items-start mb-2">
                                                    <span class="badge bg-secondary rounded-pill px-2.5 py-1 fw-bold" style="font-size: 0.72rem;">
                                                        <i class="bi bi-check-circle-fill me-1"></i> CLAIMED @@ @claimedSale.Timestamp.ToString("t")
                                                    </span>
                                                    <i class="bi bi-pencil-square text-violet-300 fs-5"></i>
                                                </div>
                                                <h5 class="fw-black mb-1 text-white">🏠 @teamName</h5>
                                                <p class="small mb-0 text-secondary" style="font-size: 0.75rem;">Click to Edit / Correct Round</p>
                                            </button>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="col-@(_activeDartsTeamCount == 1 ? "12" : _activeDartsTeamCount == 2 ? "6" : "4")">
                                            <button class="btn w-100 p-3.5 rounded-4 text-start border-2 shadow-sm transition-all animate__animated animate__fadeIn"
                                                    style="background: linear-gradient(135deg, #7c3aed 0%, #6d28d9 100%); border-color: #a78bfa; color: white;"
                                                    @onclick="() => SelectDartsTeam(teamName)">
                                                <div class="d-flex justify-content-between align-items-start mb-2">
                                                    <span class="badge bg-success rounded-pill px-2.5 py-1 fw-bold" style="font-size: 0.72rem;">
                                                        <i class="bi bi-play-fill me-1"></i> READY
                                                    </span>
                                                    <i class="bi bi-arrow-right-circle-fill fs-4 text-white"></i>
                                                </div>
                                                <h5 class="fw-black mb-1 text-white">🏠 @teamName</h5>
                                                <p class="small mb-0 opacity-80" style="font-size: 0.75rem;">Tap to start 100% free round</p>
                                            </button>
                                        </div>
                                    }
                                }
                            </div>
                        </div>

                        <!-- AWAY TEAMS SECTION -->
                        @if (_activeDartsAwayTeamCount > 0)
                        {
                            <div class="pt-3 border-top border-white-10 mb-2" style="border-top: 1px solid rgba(255,255,255,0.1) !important;">
                                <div class="d-flex align-items-center justify-content-between mb-2.5">
                                    <label class="form-label text-uppercase small fw-black tracking-wider opacity-90 m-0 text-emerald-200 d-flex align-items-center gap-1.5" style="color: #6ee7b7;">
                                        <i class="bi bi-airplane-fill text-success"></i> Visiting / Away Teams (@_activeDartsAwayTeamCount Active):
                                    </label>
                                    <span class="badge rounded-pill px-2.5 py-1" style="font-size: 0.7rem; background: rgba(16, 185, 129, 0.2); color: #6ee7b7; border: 1px solid #059669;">Visiting Guests</span>
                                </div>

                                <div class="row g-3">
                                    @for (int a = 1; a <= _activeDartsAwayTeamCount; a++)
                                    {
                                        var awayNum = a;
                                        var awayTeamName = $"Away Team {awayNum}";
                                        var claimedAwaySale = _todayDartsSales.FirstOrDefault(s => s.ItemsJson.Contains($"(DARTS - {awayTeamName})"));

                                        if (claimedAwaySale != null)
                                        {
                                            <div class="col-@(_activeDartsAwayTeamCount == 1 ? "12" : _activeDartsAwayTeamCount == 2 ? "6" : "4")">
                                                <button class="btn w-100 p-3.5 rounded-4 text-start border border-secondary shadow-sm transition-all" 
                                                        style="background: rgba(255,255,255,0.06); color: #cbd5e1;"
                                                        @onclick="() => PromptEditClaimedTeamRound(claimedAwaySale, awayTeamName)">
                                                <div class="d-flex justify-content-between align-items-start mb-2">
                                                    <span class="badge bg-secondary rounded-pill px-2.5 py-1 fw-bold" style="font-size: 0.72rem;">
                                                        <i class="bi bi-check-circle-fill me-1"></i> CLAIMED @@ @claimedAwaySale.Timestamp.ToString("t")
                                                    </span>
                                                    <i class="bi bi-pencil-square text-emerald-300 fs-5" style="color: #6ee7b7;"></i>
                                                </div>
                                                <h5 class="fw-black mb-1 text-white">✈️ @awayTeamName</h5>
                                                <p class="small mb-0 text-secondary" style="font-size: 0.75rem;">Click to Edit / Correct Round</p>
                                                </button>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="col-@(_activeDartsAwayTeamCount == 1 ? "12" : _activeDartsAwayTeamCount == 2 ? "6" : "4")">
                                                <button class="btn w-100 p-3.5 rounded-4 text-start border-2 shadow-sm transition-all animate__animated animate__fadeIn"
                                                        style="background: linear-gradient(135deg, #059669 0%, #047857 100%); border-color: #34d399; color: white;"
                                                        @onclick="() => SelectDartsTeam(awayTeamName)">
                                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                                        <span class="badge bg-warning text-dark rounded-pill px-2.5 py-1 fw-bold" style="font-size: 0.72rem;">
                                                            <i class="bi bi-play-fill me-1"></i> READY
                                                        </span>
                                                        <i class="bi bi-arrow-right-circle-fill fs-4 text-white"></i>
                                                    </div>
                                                    <h5 class="fw-black mb-1 text-white">✈️ @awayTeamName</h5>
                                                    <p class="small mb-0 opacity-85" style="font-size: 0.75rem;">Tap to start 100% free round</p>
                                                </button>
                                            </div>
                                        }
                                    }
                                </div>
                            </div>
                        }
                    </div>

                    <div class="modal-footer border-0 p-4 pt-2 d-flex justify-content-between align-items-center">
                        <div class="small opacity-75">
                            <i class="bi bi-info-circle me-1"></i> Configured: <strong class="text-white">@_activeDartsTeamCount Home</strong> &amp; <strong class="text-white">@_activeDartsAwayTeamCount Away</strong> Team(s).
                        </div>
                        <button class="btn btn-secondary px-4 py-2 rounded-pill fw-bold" @onclick="() => _showDartsTeamModal = false">
                            CANCEL
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }

    @if (_showEmployeeHoursPrintModal)
    {
        <div class="modal fade show d-block" style="background-color: rgba(15, 23, 42, 0.75); backdrop-filter: blur(8px); z-index: 1070;" tabindex="-1">
            <div class="modal-dialog modal-dialog-centered" style="max-width: 480px;">
                <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden bg-white">
                    <div class="modal-header border-0 p-4 pb-2 d-flex align-items-center justify-content-between bg-light">
                        <div class="d-flex align-items-center gap-3">
                            <div class="d-flex align-items-center justify-content-center rounded-circle shadow-sm bg-primary text-white" style="width: 46px; height: 46px; font-size: 1.3rem;">
                                <i class="bi bi-clock-history"></i>
                            </div>
                            <div>
                                <h4 class="fw-black m-0 text-dark" style="font-size: 1.25rem;">Print My Hours</h4>
                                <p class="small text-muted mb-0">Print worked hours to receipt printer</p>
                            </div>
                        </div>
                        <button class="btn btn-sm btn-outline-secondary rounded-circle" style="width: 36px; height: 36px;" @onclick="() => _showEmployeeHoursPrintModal = false">
                            <i class="bi bi-x-lg"></i>
                        </button>
                    </div>

                    <div class="modal-body p-4">
                        <!-- Logged-in Employee Info Card -->
                        <div class="mb-3 p-3 bg-light rounded-3 border d-flex align-items-center gap-3">
                            <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center shadow-sm fw-black" style="width: 42px; height: 42px; font-size: 1.1rem;">
                                @(string.IsNullOrEmpty(CurrentUserName) ? "?" : CurrentUserName.Substring(0, 1).ToUpper())
                            </div>
                            <div>
                                <div class="x-small fw-black text-uppercase text-muted">EMPLOYEE</div>
                                <div class="fw-black text-dark fs-5">@(string.IsNullOrEmpty(CurrentUserName) ? "Current Operator" : CurrentUserName)</div>
                            </div>
                        </div>

                        <!-- Month selection toggle -->
                        <div class="mb-4">
                            <label class="form-label x-small fw-black text-uppercase text-muted">Select Period</label>
                            <div class="d-flex gap-2">
                                <button type="button" 
                                        class="btn flex-fill py-2.5 rounded-3 fw-black text-uppercase border-2 @(_printHoursPeriod == "current" ? "btn-primary shadow-sm" : "btn-outline-secondary")"
                                        @onclick='() => _printHoursPeriod = "current"'>
                                    <i class="bi bi-calendar-check me-1"></i> Current Month<br/>
                                    <span class="x-small fw-normal opacity-75">@DateTime.Today.ToString("MMMM yyyy")</span>
                                </button>
                                <button type="button" 
                                        class="btn flex-fill py-2.5 rounded-3 fw-black text-uppercase border-2 @(_printHoursPeriod == "previous" ? "btn-primary shadow-sm" : "btn-outline-secondary")"
                                        @onclick='() => _printHoursPeriod = "previous"'>
                                    <i class="bi bi-calendar-minus me-1"></i> Previous Month<br/>
                                    <span class="x-small fw-normal opacity-75">@DateTime.Today.AddMonths(-1).ToString("MMMM yyyy")</span>
                                </button>
                            </div>
                        </div>

                        <!-- Action buttons -->
                        <div class="d-flex gap-2 pt-2">
                            <button class="btn btn-light flex-fill py-2.5 rounded-pill fw-bold border" @onclick="() => _showEmployeeHoursPrintModal = false" disabled="@_isPrintingHours">
                                Cancel
                            </button>
                            <button class="btn btn-primary flex-fill py-2.5 rounded-pill fw-black shadow-sm d-flex align-items-center justify-content-center gap-2" 
                                    @onclick="ExecutePrintEmployeeHours" 
                                    disabled="@(_isPrintingHours || string.IsNullOrWhiteSpace(CurrentUserName))">
                                @if (_isPrintingHours)
                                {
                                    <div class="spinner-border spinner-border-sm me-1"></div>
                                    <span>Printing...</span>
                                }
                                else
                                {
                                    <i class="bi bi-printer-fill"></i>
                                    <span>Print</span>
                                }
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    @if (_selectedBanquetToAddFunds != null)
    {
        <div class="shift-overlay" style="z-index: 1070; background: rgba(0,0,0,0.4);">
            <div class="banquet-modal-compact animate__animated animate__zoomIn animate__faster mx-auto">
                <div class="text-center mb-3">
                    <h2 class="fw-black m-0" style="color: @(_isDeductFundsMode ? "#dc2626" : "#1e3a8a"); letter-spacing: -1.5px; transition: color 0.2s;">
                        @(_isDeductFundsMode ? "DEDUCT / VOID" : "ADD FUNDS")
                    </h2>
                    <div class="small fw-bold text-muted text-uppercase">@_selectedBanquetToAddFunds.Name</div>
                </div>

                <div class="d-flex justify-content-center mb-4">
                    <div class="btn-group rounded-pill p-1 bg-light border" style="width: 100%; max-width: 280px; box-shadow: inset 0 2px 4px rgba(0,0,0,0.06);">
                        <button type="button" class="btn btn-sm rounded-pill fw-black transition-all @(!_isDeductFundsMode ? "btn-success text-white shadow-sm" : "btn-light text-muted")"
                                style="font-size: 0.8rem; letter-spacing: 0.5px; border: none;"
                                @onclick="() => { _isDeductFundsMode = false; }">
                            <i class="bi bi-plus-circle-fill me-1"></i> ADD FUNDS
                        </button>
                        <button type="button" class="btn btn-sm rounded-pill fw-black transition-all @(_isDeductFundsMode ? "btn-danger text-white shadow-sm" : "btn-light text-muted")"
                                style="font-size: 0.8rem; letter-spacing: 0.5px; border: none;"
                                @onclick="() => { _isDeductFundsMode = true; }">
                            <i class="bi bi-dash-circle-fill me-1"></i> DEDUCT / VOID
                        </button>
                    </div>
                </div>

                <div class="mb-4">
                    <div class="input-group">
                        <span class="input-group-text bg-white border-2 fw-bold fs-4">$</span>
                        <input type="number" step="0.01" class="form-control border-2 fs-4 fw-black @(_isDeductFundsMode ? "text-danger" : "text-success")" @bind="_addFundsAmount" readonly style="transition: color 0.2s;" />
                    </div>
                </div>

                <div class="banquet-numpad mb-4">
                    @foreach (var n in new[] { "1", "2", "3", "4", "5", "6", "7", "8", "9", ".", "0", "C" })
                    {
                        <div class="numpad-key @(n == "C" ? "key-clear" : "")" @onclick="() => HandleBanquetNumpad(n)">
                            @if (n == "C")
                            {
                                <span style="font-size: 0.9rem; font-weight: 800; text-transform: lowercase;">clear</span>
                            }
                            else
                            {
                                @n
                            }
                        </div>
                    }
                </div>

                <div class="d-grid gap-2">
                    <button class="btn @(_isDeductFundsMode ? "btn-danger" : "btn-success") py-3 rounded-pill fw-black shadow-sm" @onclick="ConfirmAddFunds" disabled="@(_addFundsAmount <= 0)" style="transition: all 0.2s;">
                        @if (_isDeductFundsMode)
                        {
                            <i class="bi bi-dash-circle-fill me-2"></i> @("DEDUCT & RECORD CORRECTION")
                        }
                        else
                        {
                            <i class="bi bi-plus-circle-fill me-2"></i> @("COLLECT CASH & ADD")
                        }
                    </button>
                    <button class="btn btn-light py-3 rounded-pill fw-bold" @onclick="() => { _selectedBanquetToAddFunds = null; _isDeductFundsMode = false; }">CANCEL</button>
                </div>
            </div>
        </div>
    }

    @if (showDonatedPrizeModal && _donatedActionTargetEvent != null)
    {
        <div class="shift-overlay" style="z-index: 1075; background: rgba(0,0,0,0.5); backdrop-filter: blur(4px);">
            <div class="banquet-manager-card animate__animated animate__zoomIn border-0 shadow-lg rounded-4 p-4 text-start mx-auto" style="max-width: 680px; width: 95vw; max-height: 85vh; overflow-y: auto;">
                <!-- Header -->
                <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
                    <div>
                        <span class="badge bg-warning text-dark rounded-pill px-3 py-1 fw-bold small">
                            <i class="bi bi-gift-fill me-1"></i> BEER ALLOCATION MANAGER
                        </span>
                        <h3 class="fw-black text-dark mb-0 mt-1" style="letter-spacing: -0.5px;">@GetEventDisplayName(_donatedActionTargetEvent.Name)</h3>
                        <span class="small text-muted fw-bold">Manage Donated Beer Pool &amp; Winner Prizes</span>
                    </div>
                    <button type="button" class="btn btn-light rounded-circle p-2" @onclick="() => showDonatedPrizeModal = false">
                        <i class="bi bi-x-lg fs-5"></i>
                    </button>
                </div>

                <!-- Action Selector Form -->
                <div class="bg-light p-3 rounded-4 border mb-3">
                    <label class="form-label small fw-black text-muted text-uppercase mb-2">Record Beer Action</label>
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <button type="button" class="btn w-100 p-3 rounded-3 text-start border-2 transition-all @(_donatedActionType == "prize" ? "btn-primary shadow-sm" : "btn-outline-secondary bg-white")"
                                    @onclick='() => _donatedActionType = "prize"'>
                                <div class="fw-black mb-1"><i class="bi bi-trophy-fill me-1 text-warning"></i> Winner Took Prize Home</div>
                                <div class="small opacity-75" style="font-size: 0.75rem;">Deducts 24 cans/case from main bar inventory ($0.00).</div>
                            </button>
                        </div>
                        <div class="col-6">
                            <button type="button" class="btn w-100 p-3 rounded-3 text-start border-2 transition-all @(_donatedActionType == "redonate" ? "btn-success shadow-sm" : "btn-outline-secondary bg-white")"
                                    @onclick='() => _donatedActionType = "redonate"'>
                                <div class="fw-black mb-1"><i class="bi bi-arrow-repeat me-1 text-white"></i> Add to Donated Pool</div>
                                <div class="small opacity-75" style="font-size: 0.75rem;">Adds cases to @GetEventDisplayName(_donatedActionTargetEvent.Name)'s pool (100% event proceeds).</div>
                            </button>
                        </div>
                    </div>

                    @{
                        var targetNameClean = GetEventDisplayName(_donatedActionTargetEvent.Name).Trim();
                        var tmpl = DbEventTemplates?.FirstOrDefault(t => 
                            (_donatedActionTargetEvent.TemplateId.HasValue && t.Id == _donatedActionTargetEvent.TemplateId.Value) || 
                            string.Equals(t.Name, _donatedActionTargetEvent.Name, StringComparison.OrdinalIgnoreCase) ||
                            string.Equals(GetEventDisplayName(t.Name).Trim(), targetNameClean, StringComparison.OrdinalIgnoreCase) ||
                            (t.Name.ToLower().Contains("horseshoe") && _donatedActionTargetEvent.Name.ToLower().Contains("horseshoe"))
                        );

                        Dictionary<int, int> allocatedMap = new();
                        string? jsonSource = _donatedActionTargetEvent.DonatedItemIdsJson;

                        if (!string.IsNullOrEmpty(jsonSource))
                        {
                            try {
                                var rawDict = JsonSerializer.Deserialize<Dictionary<int, int>>(jsonSource) ?? new();
                                foreach (var kvp in rawDict)
                                {
                                    int cases = kvp.Value >= 24 ? (kvp.Value / 24) : kvp.Value;
                                    if (cases > 0) allocatedMap[kvp.Key] = cases;
                                }
                            } catch {
                                try {
                                    var list = JsonSerializer.Deserialize<List<int>>(jsonSource);
                                    if (list != null) allocatedMap = list.ToDictionary(id => id, id => 1);
                                } catch {}
                            }
                        }

                        var allBeers = DbItems?.Where(i => 
                            (i.Category != null && i.Category.Equals("BEER", StringComparison.OrdinalIgnoreCase)) ||
                            (i.Name != null && i.Name.Contains("BEER", StringComparison.OrdinalIgnoreCase))
                        ).ToList() ?? new List<ProductItem>();

                        var enabledItemIds = new HashSet<int>();

                        if (tmpl != null && !string.IsNullOrEmpty(tmpl.ItemsOverrideJson))
                        {
                            try {
                                var templateOverrides = JsonSerializer.Deserialize<List<BanquetOverrideDto>>(
                                    tmpl.ItemsOverrideJson,
                                    new JsonSerializerOptions { PropertyNameCaseInsensitive = true }
                                );
                                if (templateOverrides != null)
                                {
                                    foreach (var o in templateOverrides.Where(o => o.TrackTally || o.IsVisible))
                                    {
                                        enabledItemIds.Add(o.ItemId);
                                    }
                                }
                            } catch {}
                        }

                        var stagedBeerIds = _donatedDrafts.Select(d => d.BeerItemId).ToHashSet();
                        var availableBeers = allBeers.Where(b => enabledItemIds.Contains(b.Id) && !stagedBeerIds.Contains(b.Id)).ToList();

                        var savedRecords = GetSavedDonationRecords(_donatedActionTargetEvent);
                    }

                    <div class="row g-2 mb-2">
                        <div class="col-7">
                            <label class="form-label small fw-bold text-dark mb-1">Beer Brand</label>
                            <select class="form-select rounded-3 border-2 fw-bold" @bind="_selectedDonatedItemId">
                                @if (!availableBeers.Any())
                                {
                                    @if (stagedBeerIds.Any())
                                    {
                                        <option value="0">-- All Selected Beers Added to Batch --</option>
                                    }
                                    else
                                    {
                                        <option value="0">-- No Beers Selected on Event Template --</option>
                                    }
                                }
                                else
                                {
                                    <option value="0">-- Select Beer Brand --</option>
                                    @foreach (var beer in availableBeers)
                                    {
                                        <option value="@beer.Id">@beer.Name</option>
                                    }
                                }
                            </select>
                            @if (!availableBeers.Any() && !stagedBeerIds.Any())
                            {
                                <div class="small text-danger fw-bold mt-1" style="font-size: 0.75rem;">
                                    <i class="bi bi-info-circle-fill me-1"></i> Enable beers in <em>Event Template &rarr; Custom Menu &amp; Prices</em> to allocate here.
                                </div>
                            }
                        </div>
                        <div class="col-5">
                            <label class="form-label small fw-bold text-dark mb-1">Cases</label>
                            <div class="input-group input-group-sm">
                                <button type="button" class="btn btn-outline-secondary fw-bold" @onclick="() => _donatedCaseQuantity = Math.Max(1, _donatedCaseQuantity - 1)">-</button>
                                <input type="number" min="1" class="form-control text-center fw-black" @bind="_donatedCaseQuantity" />
                                <button type="button" class="btn btn-outline-secondary fw-bold" @onclick="() => _donatedCaseQuantity++">+</button>
                            </div>
                        </div>
                    </div>

                    <button type="button" class="btn btn-dark w-100 rounded-pill fw-bold py-2 mt-2 shadow-sm" @onclick="AddDonatedActionDraft" disabled="@(_selectedDonatedItemId == 0 || _donatedCaseQuantity <= 0)">
                        <i class="bi bi-plus-lg me-1"></i> Add Record to Batch
                    </button>
                </div>

                <!-- Staged Batch List -->
                @if (_donatedDrafts.Any())
                {
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-primary mb-1">Pending Batch to Save</label>
                        <div class="list-group">
                            @foreach (var draft in _donatedDrafts)
                            {
                                <div class="list-group-item d-flex justify-content-between align-items-center rounded-3 mb-1 border-primary border-opacity-25 bg-primary bg-opacity-10 p-2">
                                    <div>
                                        <strong class="text-dark">@draft.BeerName</strong> - @draft.Cases @(draft.Cases == 1 ? "Case" : "Cases") (@(draft.Cases * 24) Cans)
                                        <div class="small text-muted">
                                            @(draft.ActionType == "prize" ? "🏆 Prize Claimed by Winner" : $"🔄 Donated to {GetRecipientEventName(_donatedActionTargetEvent)}")
                                        </div>
                                    </div>
                                    <div class="btn-group btn-group-sm">
                                        <button type="button" class="btn btn-sm btn-outline-primary border-0" @onclick="() => EditStagedDraft(draft)" title="Edit staged entry"><i class="bi bi-pencil me-1"></i> Edit</button>
                                        <button type="button" class="btn btn-sm btn-outline-danger border-0" @onclick="() => _donatedDrafts.Remove(draft)" title="Remove staged entry"><i class="bi bi-trash"></i></button>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }

                <!-- Saved Log History -->
                @if (savedRecords.Any())
                {
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-muted text-uppercase mb-1">Recorded History Log (Tap ✏️ Edit or 🗑️ Void)</label>
                        <div class="table-responsive border rounded-3 bg-white" style="max-height: 180px;">
                            <table class="table table-sm table-hover align-middle mb-0" style="font-size: 0.8rem;">
                                <thead class="table-light">
                                    <tr>
                                        <th>Date/Time</th>
                                        <th>Beer Brand</th>
                                        <th>Quantity</th>
                                        <th>Action Taken</th>
                                        <th class="text-end">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var rec in savedRecords.OrderByDescending(r => r.Timestamp))
                                    {
                                        <tr>
                                            <td>@rec.Timestamp.ToString("g")</td>
                                            <td class="fw-bold">@rec.BeerName</td>
                                            <td>@rec.Cases @(rec.Cases == 1 ? "Case" : "Cases") (@rec.Cans Cans)</td>
                                            <td>
                                                @if (rec.ActionType == "prize")
                                                {
                                                    <span class="badge bg-warning text-dark"><i class="bi bi-trophy-fill me-1"></i> Prize Claimed</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-success"><i class="bi bi-arrow-repeat me-1"></i> Donated to @(!string.IsNullOrWhiteSpace(rec.RecipientEventName) ? rec.RecipientEventName : GetRecipientEventName(_donatedActionTargetEvent))</span>
                                                }
                                            </td>
                                            <td class="text-end">
                                                <button type="button" class="btn btn-sm btn-outline-danger py-0 px-2 fw-bold" @onclick="() => VoidSavedDonationRecord(rec)" title="Void/delete this entry and return allocated cases">
                                                    <i class="bi bi-trash me-1"></i> Void / Delete
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }

                <!-- Action Footer -->
                <div class="d-flex justify-content-end gap-2 pt-2 border-top">
                    <button type="button" class="btn btn-light rounded-pill px-4 fw-bold" @onclick="() => showDonatedPrizeModal = false">Cancel</button>
                    <button type="button" class="btn btn-success rounded-pill px-4 fw-black text-white" @onclick="ConfirmProcessDonatedBeer" disabled="@(!_donatedDrafts.Any() && _selectedDonatedItemId == 0)">
                        <i class="bi bi-check-circle-fill me-1"></i> Save &amp; Apply
                    </button>
                </div>
            </div>
        </div>
    }

    @if (showBanquetsModal)
    {
        <div class="shift-overlay" style="z-index: 1055;">
                <!-- Creator Card (No active banquet) -->
                <div class="banquet-manager-card no-active-banquets animate__animated animate__zoomIn">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h2 class="fw-black m-0" style="color: #1e3a8a; letter-spacing: -1.5px;">EVENT MANAGER</h2>
                        <button class="btn btn-light rounded-pill px-4 fw-bold" @onclick="() => showBanquetsModal = false">
                            <i class="bi bi-x-lg me-2"></i> CLOSE
                        </button>
                    </div>

                    <div class="banquet-grid">
                        @if (DbActiveEvents != null && DbActiveEvents.Any(e => !IsEventDirect(e)))
                        {
                            <div class="mb-4">
                                <div class="banquet-section-title text-success fw-black mb-2">
                                    <i class="bi bi-play-circle-fill me-2"></i> CURRENTLY ACTIVE EVENT
                                </div>
                                <div class="bg-white p-3 rounded-4 border border-2 border-warning shadow-sm">
                                    @foreach (var ev in DbActiveEvents.Where(e => !IsEventDirect(e)))
                                    {
                                        <div class="d-flex justify-content-between align-items-center">
                                            <div>
                                                <h5 class="fw-black m-0 text-dark">@GetEventDisplayName(ev.Name).ToUpper()</h5>
                                                <div class="small text-muted fw-bold">
                                                    TYPE: @(ev.Type == GFC.Core.Enums.EventTabType.PrePaid ? "PREPAID TAB" : "RUNNING TAB") | BAL: @ev.CurrentBalance.ToString("C")
                                                </div>
                                            </div>
                                            <div class="d-flex gap-2">
                                                @if (ev.Type == GFC.Core.Enums.EventTabType.PrePaid)
                                                {
                                                    <button class="btn btn-sm btn-success rounded-pill fw-bold px-3" @onclick="() => OpenAddFunds(ev)">
                                                        <i class="bi bi-plus-circle me-1"></i> Add Funds
                                                    </button>
                                                }
                                                <button class="btn btn-sm btn-danger rounded-pill fw-bold px-3" @onclick="() => CloseBanquet(ev)">
                                                    <i class="bi bi-stop-circle me-1"></i> @(ev.EnableBeerTally ? "Settle Event" : (ev.Type == GFC.Core.Enums.EventTabType.RunningTab ? "Settle Tab" : "Close Event"))
                                                </button>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        }

                        <div class="d-flex flex-column">
                            <div class="banquet-section-title">Start New Event</div>
                            <div class="bg-light p-4 rounded-4 border-2 border border-white shadow-sm flex-grow-1">
                                <div class="new-banquet-inner-layout">
                                    <!-- LEFT SIDE: SELECT EVENT TEMPLATE -->
                                    <div class="new-banquet-templates-side">
                                        <label class="form-label small fw-black text-muted text-uppercase tracking-wider mb-2" style="font-size: 0.75rem;">Select Event Template</label>
                                        <div class="d-flex flex-column gap-2" style="max-height: 400px; overflow-y: auto; padding-right: 4px;">
                                            @if (DbEventTemplates != null)
                                            {
                                                @foreach (var t in DbEventTemplates)
                                                {
                                                    var isSelected = _newBanquetTemplateId == t.Id;
                                                    var iconClass = (t.Name ?? "").ToUpper().Contains("DART") ? "bi-bullseye" :
                                                                    (t.Name ?? "").ToUpper().Contains("SPECIAL") ? "bi-heart-fill" :
                                                                    (t.Name ?? "").ToUpper().Contains("PARTY") ? "bi-balloon-fill" : "bi-calendar-event";
                                                                    
                                                    var themeColor = (t.Name ?? "").ToUpper().Contains("DART") ? "#7c3aed" :
                                                                     (t.Name ?? "").ToUpper().Contains("SPECIAL") ? "#ec4899" : "#3b82f6";
                                                                     
                                                    <button type="button" class="btn text-start p-3 rounded-4 border-2 d-flex align-items-center justify-content-between transition-all"
                                                            style="background: @(isSelected ? "rgba(30, 58, 138, 0.05)" : "white"); 
                                                                   border-color: @(isSelected ? "rgba(30, 58, 138, 0.5)" : "#e2e8f0");
                                                                   color: #1e3a8a;
                                                                   transition: all 0.2s ease-in-out;
                                                                   box-shadow: @(isSelected ? "0 4px 12px rgba(30, 58, 138, 0.08)" : "none");"
                                                            @onclick="() => HandleTemplateClick(t)">
                                                        <div class="d-flex align-items-center gap-3">
                                                            <div class="d-flex align-items-center justify-content-center rounded-circle" 
                                                                 style="width: 44px; height: 44px; background: @(isSelected ? themeColor : "#f1f5f9"); color: @(isSelected ? "white" : "#64748b"); transition: all 0.2s;">
                                                                <i class="bi @iconClass fs-5"></i>
                                                            </div>
                                                            <div>
                                                                <div class="fw-black" style="font-size: 0.95rem;">@GetEventDisplayName(t.Name)</div>
                                                                <div class="small text-muted fw-bold" style="font-size: 0.75rem;">
                                                                    @(t.DefaultType == GFC.Core.Enums.EventTabType.PrePaid ? "PREPAID TAB" : "RUNNING TAB")
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div>
                                                            @if (isSelected)
                                                            {
                                                                <span class="badge bg-success rounded-circle p-2 d-flex align-items-center justify-content-center" style="width: 24px; height: 24px;">
                                                                    <i class="bi bi-check-lg text-white" style="font-size: 0.8rem;"></i>
                                                                </span>
                                                            }
                                                            else
                                                            {
                                                                <i class="bi bi-chevron-right text-muted opacity-50"></i>
                                                            }
                                                        </div>
                                                    </button>
                                                }
                                            }
                                        </div>
                                    </div>

                                    <!-- RIGHT SIDE: KEYPAD OR INFO -->
                                    <div class="new-banquet-action-side">
                                        @if (IsPrePaidSelected)
                                        {
                                            <div class="mb-3 animate__animated animate__fadeIn flex-grow-1 d-flex flex-column">
                                                <label class="form-label small fw-bold mb-1">Starting Cash Deposit</label>
                                                <div class="input-group mb-2">
                                                    <span class="input-group-text bg-white border-2 fw-bold">$</span>
                                                    <input type="number" step="0.01" class="form-control border-2 fw-black text-primary" @bind="_newBanquetAmount" readonly />
                                                </div>
                                                <div class="banquet-numpad flex-grow-1">
                                                    @foreach (var n in new[] { "1", "2", "3", "4", "5", "6", "7", "8", "9", ".", "0", "C" })
                                                    {
                                                        <div class="numpad-key @(n == "C" ? "key-clear" : "")" @onclick="() => HandleBanquetNumpad(n)">
                                                            @if (n == "C")
                                                            {
                                                                <span style="font-size: 0.9rem; font-weight: 800; text-transform: lowercase;">clear</span>
                                                            }
                                                            else
                                                            {
                                                                @n
                                                            }
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                        }
                                        else if (_newBanquetTemplateId > 0)
                                        {
                                            <div class="alert alert-info border-0 rounded-4 small fw-bold mb-3 animate__animated animate__fadeIn">
                                                <i class="bi bi-info-circle me-2"></i> This is a RUNNING TAB. No starting deposit required.
                                            </div>
                                        }

                                        @if (_newBanquetTemplateId > 0)
                                        {
                                            <button class="btn btn-success w-100 rounded-pill fw-bold py-3 shadow-sm mt-auto animate__animated animate__fadeIn text-white d-flex align-items-center justify-content-center" 
                                                    style="background-color: #198754; border-color: #198754;" 
                                                    disabled="@_isStartingBanquet"
                                                    @onclick="StartBanquet">
                                                @if (_isStartingBanquet)
                                                {
                                                    <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                                    <span>STARTING EVENT...</span>
                                                }
                                                else
                                                {
                                                    <i class="bi bi-play-circle-fill me-2"></i>
                                                    <span>START EVENT</span>
                                                }
                                            </button>
                                        }
                                        else
                                        {
                                            <div class="d-flex flex-column align-items-center justify-content-center h-100 text-muted opacity-50 py-5">
                                                <i class="bi bi-arrow-left-circle fs-2 mb-2"></i>
                                                <span class="small fw-bold text-center">Select event template to begin</span>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
        </div>
    }

    @if (showSettingsModal)
    {
        <div class="fullscreen-settings-overlay animate__animated animate__fadeIn">
            <!-- LEFT SIDEBAR -->
            <div class="settings-sidebar d-flex flex-column">
                <div class="sidebar-header mb-4">
                    <h5 class="m-0 fw-black text-muted text-uppercase" style="font-size: 0.7rem; letter-spacing: 2px;">GFC STUDIO</h5>
                    <h3 class="m-0 fw-black text-white" style="font-size: 1.5rem; letter-spacing: -0.5px; line-height: 1.1;">POS CONTROL</h3>
                </div>
                
                <div class="sidebar-menu d-flex flex-column gap-2 flex-grow-1">
                    <button class="menu-item @(_activeSettingsTab == "station" ? "active" : "")" @onclick='() => _activeSettingsTab = "station"'>
                        <i class="bi bi-cpu fs-5"></i>
                        <span>Station &amp; Security</span>
                    </button>
                    <button class="menu-item @(_activeSettingsTab == "modes" ? "active" : "")" @onclick='() => _activeSettingsTab = "modes"'>
                        <i class="bi bi-lightning-charge fs-5"></i>
                        <span>Operational Modes</span>
                    </button>
                    <button class="menu-item @(_activeSettingsTab == "printer" ? "active" : "")" @onclick='() => _activeSettingsTab = "printer"'>
                        <i class="bi bi-printer fs-5"></i>
                        <span>Thermal Printer</span>
                    </button>
                    <button class="menu-item @(_activeSettingsTab == "inventory" ? "active" : "")" @onclick='() => _activeSettingsTab = "inventory"'>
                        <i class="bi bi-box-seam fs-5"></i>
                        <span>Inventory Print</span>
                    </button>
                </div>
                
                <div class="sidebar-footer pt-3 border-top" style="border-color: rgba(255,255,255,0.08) !important;">
                    <button class="btn-close-dashboard fw-black w-100 py-3" @onclick="() => showSettingsModal = false">
                        <i class="bi bi-check-circle-fill me-2"></i> SAVE &amp; EXIT
                    </button>
                </div>
            </div>
            
            <!-- RIGHT CONTENT PANE -->
            <div class="settings-content-pane flex-grow-1">
                @if (_activeSettingsTab == "station")
                {
                    <div class="pane-header mb-4 animate__animated animate__fadeIn animate__faster">
                        <h2 class="fw-black text-navy mb-1" style="font-size: 2rem; letter-spacing: -0.5px;">Station &amp; Security</h2>
                        <p class="text-muted fw-bold small text-uppercase">Configure terminal naming, active profile alignment, and automatic lockout policies.</p>
                    </div>
                    
                    <div class="row g-4 animate__animated animate__fadeIn animate__faster">
                        <div class="col-xl-8 col-lg-10">
                            <div class="settings-group">
                                <div class="mb-4">
                                    <label class="settings-label">Station Identifier</label>
                                    <input type="text" class="form-control settings-input w-100" 
                                           @bind="TerminalName" @bind:after="SaveTerminalName" 
                                           placeholder="e.g. Main Bar" style="max-width: 450px;" />
                                    <p class="text-muted small mt-2 mb-0">The unique name for this terminal session displayed on receipts and sync reports.</p>
                                </div>
                                
                                <hr class="settings-divider" />
                                
                                <div class="my-4">
                                    <label class="settings-label">Assigned Menu Profile</label>
                                    <div class="d-flex align-items-center gap-3 bg-light p-3 rounded-4" style="max-width: 450px; border: 1px solid #f1f5f9;">
                                        <div class="icon-circle bg-primary text-white d-flex align-items-center justify-content-center rounded-3" style="width: 42px; height: 42px;">
                                            <i class="bi bi-tags-fill fs-5"></i>
