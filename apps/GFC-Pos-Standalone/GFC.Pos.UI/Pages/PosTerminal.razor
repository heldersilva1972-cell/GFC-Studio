    {
        if (_newBanquetTemplateId == 0) return;
        var template = DbEventTemplates.FirstOrDefault(t => t.Id == _newBanquetTemplateId);
        if (template == null) return;
        if (template.DefaultType == GFC.Core.Enums.EventTabType.PrePaid && _newBanquetAmount <= 0) return;

        try
        {
            var cleanName = template.Name;
            if (cleanName.EndsWith(" [Direct]")) cleanName = cleanName.Substring(0, cleanName.Length - 9);
            else if (cleanName.EndsWith("[Direct]")) cleanName = cleanName.Substring(0, cleanName.Length - 8);

            var newEvent = new ActiveEvent
            {
                Name = cleanName + (_newEventDirectCheckout ? " [Direct]" : ""),
                Type = template.DefaultType,
                TemplateId = template.Id,   // ← Link to template for price overrides & category filtering
                CurrentBalance = _newBanquetAmount,
                Status = GFC.Core.Enums.EventTabStatus.Open,
                InitialAmount = _newBanquetAmount,
                EnableBeerTally = template.EnableBeerTally,
                CreatedAt = DateTime.UtcNow
            };

            if (forceTrainingMode)
            {
                newEvent.Id = new Random().Next(-999999, -1000);
                if (DbActiveEvents == null) DbActiveEvents = new();
                DbActiveEvents.Add(newEvent);
                if (_cachedMenu != null)
                {
                    _cachedMenu.ActiveEvents = DbActiveEvents;
                }
                if (_newBanquetAmount > 0)
                {
                    await LogTabDeposit(template.Name, _newBanquetAmount, newEvent.Id, isInitial: true);
                }
                Toast.ShowSuccess("Event started in memory (Training Mode)!");
                _newBanquetTemplateId = 0;
                _newBanquetAmount = 0;
                _newEventDirectCheckout = false;
                showBanquetsModal = false; // Close the modal cleanly!
                StateHasChanged();
                return;
            }
            
            if (!Connectivity.IsOnline)
            {
                newEvent.Id = new Random().Next(-999999, -1000);
                if (_cachedMenu != null)
                {
                    if (_cachedMenu.ActiveEvents == null) _cachedMenu.ActiveEvents = new();
                    if (!_cachedMenu.ActiveEvents.Any(e => e.Name == newEvent.Name))
                    {
                        _cachedMenu.ActiveEvents.Add(newEvent);
                    }
                    await PosService.SaveMenuToVaultAsync(_cachedMenu);
                }

                var eventKey = $"gfc_pos_vault_event_start_{newEvent.Id}";
                await JSRuntime.InvokeVoidAsync("window.gfcSetAsync", eventKey, newEvent);
                await PosService.GetTotalPendingAsync();

                if (_newBanquetAmount > 0)
                {
                    await LogTabDeposit(template.Name, _newBanquetAmount, newEvent.Id, isInitial: true);
                }

                Toast.ShowSuccess("Event started offline! It will sync once connection is restored.");
                _newBanquetTemplateId = 0;
                _newBanquetAmount = 0;
                _newEventDirectCheckout = false;
                showBanquetsModal = false; // Close the modal cleanly!
                await RefreshData();
                return;
            }
            
            HttpResponseMessage? response = null;
            try
            {
                response = await Http.PostAsJsonAsync("api/pos/events/start", newEvent);
            }
            catch (Exception ex)
            {
                Console.WriteLine($"[POS] Failed to start event online: {ex.Message}. Falling back to offline start.");
            }

            if (response != null && response.IsSuccessStatusCode)
            {
                var created = await response.Content.ReadFromJsonAsync<ActiveEvent>();
                if (_newBanquetAmount > 0)
                {
                    await LogTabDeposit(template.Name, _newBanquetAmount, created?.Id, isInitial: true);
                }
                Toast.ShowSuccess("Event started!");
                _newBanquetTemplateId = 0;
                _newBanquetAmount = 0;
                _newEventDirectCheckout = false;
                _selectedBanquetToAddFunds = null;
                showBanquetsModal = false; // Close the modal cleanly!
                await RefreshData();
            }
            else
            {
                newEvent.Id = new Random().Next(-999999, -1000);
                if (_cachedMenu != null)
                {
                    if (_cachedMenu.ActiveEvents == null) _cachedMenu.ActiveEvents = new();
                    if (!_cachedMenu.ActiveEvents.Any(e => e.Name == newEvent.Name))
                    {
                        _cachedMenu.ActiveEvents.Add(newEvent);
                    }
                    await PosService.SaveMenuToVaultAsync(_cachedMenu);
                }

                var eventKey = $"gfc_pos_vault_event_start_{newEvent.Id}";
                await JSRuntime.InvokeVoidAsync("window.gfcSetAsync", eventKey, newEvent);
                await PosService.GetTotalPendingAsync();

                if (_newBanquetAmount > 0)
                {
                    await LogTabDeposit(template.Name, _newBanquetAmount, newEvent.Id, isInitial: true);
                }

                Toast.ShowSuccess("Event started offline! Will sync later.");
                _newBanquetTemplateId = 0;
                _newBanquetAmount = 0;
                _newEventDirectCheckout = false;
                _selectedBanquetToAddFunds = null;
                showBanquetsModal = false; // Close the modal cleanly!
                await RefreshData();
            }
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Error: {ex.Message}");
        }
    }

    private async Task ConfirmAddFunds()
    {
        if (_selectedBanquetToAddFunds == null || _addFundsAmount <= 0) return;

        var actualAmount = _isDeductFundsMode ? -_addFundsAmount : _addFundsAmount;

        // 1. INSTANT LOCAL UPDATE
        _selectedBanquetToAddFunds.CurrentBalance += actualAmount;
        await LogTabDeposit(_selectedBanquetToAddFunds.Name, actualAmount, _selectedBanquetToAddFunds.Id, isInitial: false, isCorrection: _isDeductFundsMode);
        
        if (_cachedMenu != null && !forceTrainingMode)
        {
             await PosService.SaveMenuToVaultAsync(_cachedMenu);
        }
        
        var name = _selectedBanquetToAddFunds.Name;
        var amt = actualAmount;
        var id = _selectedBanquetToAddFunds.Id;
        
        _selectedBanquetToAddFunds = null;
        _addFundsAmount = 0;
        _isDeductFundsMode = false;
        showBanquetsModal = false; // Close the entire modal after funds are added
        StateHasChanged();

        if (forceTrainingMode)
        {
            Toast.ShowSuccess("Funds updated in memory (Training Mode)");
            return;
        }

        var addFundsKey = $"gfc_pos_vault_event_add_funds_{Guid.NewGuid()}";
        var request = new AddFundsRequest { Id = id, Amount = amt };
        try
        {
            await JSRuntime.InvokeVoidAsync("window.gfcSetAsync", addFundsKey, request);
            await PosService.GetTotalPendingAsync();
        }
        catch {}

        try
        {
            // 2. BACKGROUND SERVER SYNC
            var response = await Http.PostAsJsonAsync("api/pos/events/add-funds", request);
            if (response.IsSuccessStatusCode)
            {
                Toast.ShowSuccess("Funds synced to server");
                try
                {
                    await JSRuntime.InvokeVoidAsync("window.gfcRemoveAsync", addFundsKey);
                }
                catch {}
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[POS] ConfirmAddFunds Server Sync failed: {ex.Message}");
            Toast.ShowWarning("Funds added locally. Server sync pending.");
        }
    }

    private bool _showBanquetCloseModal = false;
    private bool _showBanquetRefundPrompt = false;
    private bool _showBanquetRefundSuccessConfirm = false;
    private decimal _refundedAmount = 0;
    private ActiveEvent? _closingBanquet = null;

    private void CloseBanquet(ActiveEvent ev)
    {
        _closingBanquet = ev;
        if (ev.CurrentBalance > 0)
        {
            _showBanquetRefundPrompt = true;
        }
        else
        {
            _showBanquetCloseModal = true;
        }
        StateHasChanged();
    }

    private async Task ConfirmBanquetRefund()
    {
        if (_closingBanquet == null) return;
        
        var remainingFunds = _closingBanquet.CurrentBalance;
        _refundedAmount = remainingFunds;
        
        // Log the negative deposit correction to reduce the event balance to 0 and reduce shift expected cash
        var refundAmount = -remainingFunds;
        _closingBanquet.CurrentBalance = 0; // Bring balance to 0
        
        await LogTabDeposit(_closingBanquet.Name, refundAmount, _closingBanquet.Id, isInitial: false, isCorrection: false, isRefund: true);

        if (forceTrainingMode)
        {
            _showBanquetRefundPrompt = false;
            _showBanquetRefundSuccessConfirm = true;
            StateHasChanged();
            Toast.ShowSuccess("Refund logged in memory (Training Mode)");
            return;
        }

        // Queue the add-funds (refund) request in IndexedDB outbox so server syncs the negative correction
        var addFundsKey = $"gfc_pos_vault_event_add_funds_{Guid.NewGuid()}";
        var request = new AddFundsRequest { Id = _closingBanquet.Id, Amount = refundAmount };
        try
        {
            await JSRuntime.InvokeVoidAsync("window.gfcSetAsync", addFundsKey, request);
        }
        catch {}

        try
        {
            // Sync to server in background
            _ = Http.PostAsJsonAsync("api/pos/events/add-funds", request);
        }
        catch {}

        _showBanquetRefundPrompt = false;
        _showBanquetRefundSuccessConfirm = true;
        StateHasChanged();
    }

    private async Task ExecuteCloseBanquet(bool print)
    {
        var ev = _closingBanquet;
        _showBanquetCloseModal = false;
        _closingBanquet = null;
        if (ev == null) return;

        // 1. Instant Local Update (Bypass delay)
        DbActiveEvents.RemoveAll(e => e.Id == ev.Id);
        if (_cachedMenu != null)
        {
            _cachedMenu.ActiveEvents = DbActiveEvents;
            if (!forceTrainingMode)
            {
                await PosService.SaveMenuToVaultAsync(_cachedMenu);
            }
        }

        if (forceTrainingMode)
        {
            // Auto reset selected active event if it was the one closed
            if (_selectedActiveEvent?.Id == ev.Id)
            {
                var directEvent = DbActiveEvents.FirstOrDefault(e => e.Name.EndsWith(" [Direct]") || e.Name.EndsWith("[Direct]"));
                _selectedActiveEvent = directEvent;
            }
            showBanquetsModal = false; // Close the event manager modal
            StateHasChanged();

            if (print)
            {
                try
                {
                    _ = PrintBanquetMasterSummary(ev);
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"[POS] Failed to start background print: {ex.Message}");
                }
            }
            Toast.ShowSuccess("Event closed in memory (Training Mode)");
            return;
        }

        // Queue the event closure request in IndexedDB outbox
        var closeKey = $"gfc_pos_vault_event_close_{ev.Id}";
        try
        {
            await JSRuntime.InvokeVoidAsync("window.gfcSetAsync", closeKey, ev.Id);
            await PosService.GetTotalPendingAsync();
        }
        catch {}

        // Auto reset selected active event if it was the one closed
        if (_selectedActiveEvent?.Id == ev.Id)
        {
            var directEvent = DbActiveEvents.FirstOrDefault(e => e.Name.EndsWith(" [Direct]") || e.Name.EndsWith("[Direct]"));
            _selectedActiveEvent = directEvent;
        }
        _selectedBanquetToAddFunds = null;
        showBanquetsModal = false; // Close the event manager modal
        StateHasChanged();

        if (print)
        {
            try
            {
                // Run in background so that slow or offline printers never block the POS terminal closure
                _ = PrintBanquetMasterSummary(ev);
            }
            catch (Exception ex)
            {
                Console.WriteLine($"[POS] Failed to start background print: {ex.Message}");
            }
        }

        try
        {
            // 2. Background Server Update
            var response = await Http.PostAsync($"api/pos/events/close/{ev.Id}", null);
            if (response.IsSuccessStatusCode)
            {
                Toast.ShowSuccess("Event closed on server");
                try
                {
                    await JSRuntime.InvokeVoidAsync("window.gfcRemoveAsync", closeKey);
                }
                catch {}
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[POS] CloseBanquet Server Sync failed (will retry on next refresh): {ex.Message}");
            Toast.ShowWarning("Banquet closed locally. Server sync pending.");
        }
    }

    private async Task PrintBanquetMasterSummary(ActiveEvent ev, bool isReprint = false)
    {
        try
        {
            try
            {
                await JSRuntime.InvokeVoidAsync("localStorage.setItem", "gfc_last_printed_event_id", ev.Id.ToString());
                var json = JsonSerializer.Serialize(ev);
                await JSRuntime.InvokeVoidAsync("localStorage.setItem", "gfc_last_printed_event_data", json);
            }
            catch {}

            // 1. Force flush the sync outbox so any newly logged added funds sales are pushed to the server first
            try
            {
                await PosService.FlushAllPendingAsync();
            }
            catch (Exception ex)
            {
                Console.WriteLine($"[POS] Pre-print outbox flush failed: {ex.Message}");
            }

            var master = await PosService.GetBanquetMasterSummaryAsync(ev.Id);
            bool isOffline = (master == null);

            string eventName = GetEventDisplayName(ev.Name);
            decimal totalDeposited = ev.InitialAmount;
            decimal totalSpent = 0;
            decimal refundedAmount = 0;
            var items = new Dictionary<string, int>();
            var totals = new Dictionary<string, decimal>();

            BanquetShiftReportDto? localB = null;

            // Load local shift banquet report as fallback/merge database
            try
            {
                var finalAudit = await PosService.GetShiftAuditAsync();
                localB = finalAudit.Banquets.FirstOrDefault(b => b.ActiveEventId == ev.Id);
            }
            catch (Exception ex)
            {
                Console.WriteLine($"[POS] Failed to load local banquet shift report: {ex.Message}");
            }

            if (!isOffline && master != null)
            {
                eventName = master.EventName;
                totalDeposited = master.TotalDeposited;
                totalSpent = master.TotalSpent;
                items = master.ItemQuantities;
                totals = master.ItemTotals;
            }
            else if (localB != null)
            {
                eventName = localB.EventName;
                totalDeposited = localB.Deposits.Where(d => d >= 0).Sum();
                totalSpent = localB.TotalSpent;
                items = localB.ItemSummary;
                totals = localB.ItemTotals;
            }

            // Enforce absolute mathematical integrity for prepaid events: Total Deposited = CurrentBalance + TotalSpent
            if (ev.Type == GFC.Core.Enums.EventTabType.PrePaid)
            {
                var computedDeposited = ev.CurrentBalance + totalSpent;
                if (computedDeposited > totalDeposited)
                {
                    totalDeposited = computedDeposited;
                }
            }

            var isRunningTab = ev.Type == GFC.Core.Enums.EventTabType.RunningTab;
            var sb = new System.Text.StringBuilder();

            ReceiptFormatter.AppendReceiptHeader(sb,
                title1: "GFC EVENT RECEIPT",
                title2: eventName,
                dateStr: $"DATE: {DateTime.Now:MM/dd/yyyy h:mm tt}",
                operatorName: isOffline ? "*** OFFLINE MODE ***" : "",
                isReprint: isReprint);

            if (!isRunningTab)
            {
                ReceiptFormatter.AppendSectionHeader(sb, "FUNDS & DEPOSITS LOG");

                // Compile a fully unified, robust deposits list
                var depositsToPrint = new List<BanquetDepositDetailDto>();

                if (master != null && master.Deposits != null && master.Deposits.Any())
                {
                    depositsToPrint = master.Deposits.ToList();
                }

                // If local has more deposits, use local deposits to make sure nothing is missed!
                if (localB != null && localB.Deposits != null && localB.Deposits.Count > depositsToPrint.Count)
                {
                    depositsToPrint = new List<BanquetDepositDetailDto>();
                    bool initialAdded = false;
                    foreach (var amt in localB.Deposits)
                    {
                        if (amt == ev.InitialAmount && !initialAdded)
                        {
                            depositsToPrint.Add(new BanquetDepositDetailDto
                            {
                                Timestamp = ev.CreatedAt,
                                Amount = amt,
                                IsInitial = true
                            });
                            initialAdded = true;
                        }
                        else
                        {
                            depositsToPrint.Add(new BanquetDepositDetailDto
                            {
                                Timestamp = DateTime.Now,
                                Amount = amt,
                                IsInitial = false
                            });
                        }
                    }
                }

                // If the compiled deposits list is missing additional funds (offline or unsynced states),
                // dynamically generate the deposit entries from the initial amount and calculated total deposited.
                if (totalDeposited > ev.InitialAmount)
                {
                    var printedSum = depositsToPrint.Where(d => d.Amount >= 0).Sum(d => d.Amount);
                    if (printedSum < totalDeposited)
                    {
                        if (depositsToPrint.Count <= 1)
                        {
                            depositsToPrint = new List<BanquetDepositDetailDto>
                            {
                                new BanquetDepositDetailDto
                                {
                                    Timestamp = ev.CreatedAt,
                                    Amount = ev.InitialAmount,
                                    IsInitial = true
                                },
                                new BanquetDepositDetailDto
                                {
                                    Timestamp = DateTime.Now,
                                    Amount = totalDeposited - ev.InitialAmount,
                                    IsInitial = false
                                }
                            };
                        }
                        else
                        {
                            depositsToPrint.Add(new BanquetDepositDetailDto
                            {
                                Timestamp = DateTime.Now,
                                Amount = totalDeposited - printedSum,
                                IsInitial = false
                            });
                        }
                    }
                }

                decimal grossDeposited = 0;
                refundedAmount = 0;
                if (depositsToPrint.Any())
                {
                    foreach (var dep in depositsToPrint)
                    {
                        if (dep.Amount >= 0)
                            grossDeposited += dep.Amount;
                        else
                            refundedAmount += Math.Abs(dep.Amount);
                    }
                }
                else
                {
                    grossDeposited = ev.InitialAmount;
                }

                if (depositsToPrint.Any(d => d.Amount >= 0))
                {
                    foreach (var dep in depositsToPrint.Where(d => d.Amount >= 0))
                    {
                        var label = dep.IsInitial ? "INITIAL DEPOSIT" : "ADDED FUNDS";
                        var amtStr = $"{dep.Amount:C}";
                        var lineText = $"- {label} ({dep.Timestamp.ToLocalTime():MM/dd h:mm tt})";
                        ReceiptFormatter.AppendLine(sb, lineText, amtStr);
                    }
                }
                else
                {
                    ReceiptFormatter.AppendLine(sb, "- INITIAL DEPOSIT", $"{ev.InitialAmount:C}");
                }

                ReceiptFormatter.AppendDivider(sb, '-');
                ReceiptFormatter.AppendLine(sb, "TOTAL FUNDS DEPOSITED", $"{grossDeposited:C}");

                if (refundedAmount > 0)
                {
                    ReceiptFormatter.AppendLine(sb, "UNUSED DEPOSIT RETURNED", $"-{refundedAmount:C}");
                }
            }

            ReceiptFormatter.AppendBlank(sb);
            ReceiptFormatter.AppendSectionHeader(sb, "TAB ITEM SUMMARY");

            if (items.Any())
            {
                foreach (var item in items.OrderByDescending(x => x.Value))
                {
                    var itemTotal = totals.ContainsKey(item.Key) ? totals[item.Key] : 0;
                    ReceiptFormatter.AppendLine(sb, $"{item.Value} x {item.Key}", $"{itemTotal:C}");
                }
            }
            else
            {
                ReceiptFormatter.AppendCenter(sb, "No purchases recorded on tab.");
            }

            var remaining = totalDeposited - refundedAmount - totalSpent;
            ReceiptFormatter.AppendDivider(sb, '-');

            if (!isRunningTab)
            {
                ReceiptFormatter.AppendLine(sb, "TOTAL SPENT", $"{totalSpent:C}");
                ReceiptFormatter.AppendLine(sb, "TAB BALANCE", $"{remaining:C}");
            }
            else
            {
                ReceiptFormatter.AppendLine(sb, "TOTAL DUE", $"{totalSpent:C}");
            }

            ReceiptFormatter.AppendDivider(sb, '=');
            ReceiptFormatter.AppendBlank(sb);
            ReceiptFormatter.AppendCenter(sb, "Thank you for hosting");
            ReceiptFormatter.AppendCenter(sb, "your event with GFC!");

            var receiptText = sb.ToString();

            if (!isReprint)
            {
                try
                {
                    await JSRuntime.InvokeVoidAsync("localStorage.setItem", "gfc_last_printed_event_html", receiptText);
                }
                catch {}
            }

            await PrintReceiptAsync(receiptText);
        }
        catch (Exception ex)
        {
            Console.WriteLine($@"[POS] Error printing banquet summary: {ex.Message}");
            Toast.ShowError("Failed to print banquet summary.");
        }
    }

    private async Task PrintReceiptAsync(string html)
    {
        if (string.IsNullOrWhiteSpace(html))
        {
            Console.WriteLine("[POS] PrintReceiptAsync aborted: Input HTML string is null or whitespace.");
            return;
        }

        if (forceTrainingMode)
        {
            bool isHtmlFormat = html.Contains("<div") || html.Contains("<body") || html.Contains("<html") || html.Contains("<p");
            if (isHtmlFormat)
            {
                var warningHeader = "<div style='text-align:center; font-weight:bold; font-size:1.1em; border: 2px dashed #dc2626; color:#dc2626; padding:8px; margin-bottom:15px; font-family:sans-serif;'>*** TRAINING MODE - NOT A REAL RECEIPT ***</div>";
                var warningFooter = "<div style='text-align:center; font-weight:bold; font-size:1.1em; border: 2px dashed #dc2626; color:#dc2626; padding:8px; margin-top:15px; font-family:sans-serif;'>*** TRAINING MODE - NOT A REAL RECEIPT ***</div>";
                
                if (html.Contains("<body>"))
                {
                    html = html.Replace("<body>", $"<body>{warningHeader}");
                }
                else
                {
                    html = warningHeader + html;
                }
                
                if (html.Contains("</body>"))
                {
                    html = html.Replace("</body>", $"{warningFooter}</body>");
                }
                else
                {
                    html = html + warningFooter;
                }
            }
            else
            {
                // Plain text ESC/POS warning
                var warningHeader = "******************************************\n" +
                                    "***   TRAINING MODE - NOT A REAL   ***\n" +
                                    "******************************************\n\n";
                var warningFooter = "\n******************************************\n" +
                                    "***   TRAINING MODE - NOT A REAL   ***\n" +
                                    "******************************************\n";
                html = warningHeader + html + warningFooter;
            }
        }
        await PrinterService.PrintReceiptAsync(html);
    }

    private async Task LogTabDeposit(string eventName, decimal amount, int? eventId, bool isInitial = false, bool isCorrection = false, bool isRefund = false)
    {
        var label = isInitial ? "INITIAL DEPOSIT" : (isRefund ? "RETURNED FUNDS" : (isCorrection ? "DEPOSIT CORRECTION" : "TAB DEPOSIT"));
        var depositSale = new PosSaleDto
        {
            Id = Guid.NewGuid(),
            Timestamp = DateTime.Now,
            TerminalName = forceTrainingMode ? $"{TerminalName} (TRAINING)" : TerminalName,
            BartenderName = CurrentUserName,
            TotalAmount = amount,
            PaymentType = "CASH",
            OriginalTotal = amount,
            AmountReceived = amount,
            ChangeDue = 0,
            ActiveEventId = eventId,
            ItemsJson = JsonSerializer.Serialize(new List<ProductItem>
            {
                new ProductItem { 
                    Id = 0, 
                    Name = $"{label}: {eventName}", 
                    Price = amount, 
                    Quantity = 1, 
                    Category = "DEPOSIT" 
                }
            })
        };
        if (!forceTrainingMode)
        {
            await PosService.AddSaleToShiftAsync(depositSale);
            await PosService.SaveSaleAsync(depositSale);
            await UpdateAuditAsync();
        }
    }

    private bool _showChangeDueBanner = false;
    private decimal _changeDueBannerAmount = 0;
    private decimal _changeDueBannerReceived = 0;
    private decimal _changeDueBannerTotal = 0;
    private global::System.Threading.CancellationTokenSource _changeDueBannerCts;
    private int _changeDueBannerDurationSeconds = 10;

    private async Task SaveChangeDueBannerDuration()
    {
        if (_changeDueBannerDurationSeconds < 0) _changeDueBannerDurationSeconds = 0;
        if (_changeDueBannerDurationSeconds == 1) _changeDueBannerDurationSeconds = 2;
        if (_changeDueBannerDurationSeconds > 60) _changeDueBannerDurationSeconds = 60;
        await JSRuntime.InvokeVoidAsync("localStorage.setItem", "gfc_pos_change_due_banner_duration", _changeDueBannerDurationSeconds.ToString());
    }

    private void ShowChangeDueBanner(decimal change, decimal received, decimal total)
    {
        if (_changeDueBannerDurationSeconds <= 0) return;

        _changeDueBannerCts?.Cancel();
        _changeDueBannerCts = new global::System.Threading.CancellationTokenSource();
        var token = _changeDueBannerCts.Token;

        _changeDueBannerAmount = change;
        _changeDueBannerReceived = received;
        _changeDueBannerTotal = total;
        _showChangeDueBanner = true;

        _ = Task.Run(async () =>
        {
            try
            {
                await Task.Delay(_changeDueBannerDurationSeconds * 1000, token);
                if (!token.IsCancellationRequested)
                {
                    await InvokeAsync(() =>
                    {
                        _showChangeDueBanner = false;
                        StateHasChanged();
                    });
                }
            }
            catch (TaskCanceledException) { }
            catch (Exception ex)
            {
                Console.WriteLine($"[POS] ChangeDue banner timer error: {ex.Message}");
            }
        });
    }

    private void DismissChangeDueBanner()
    {
        if (_showChangeDueBanner)
        {
            _changeDueBannerCts?.Cancel();
            _showChangeDueBanner = false;
            _changeDueBannerAmount = 0;
            _changeDueBannerReceived = 0;
            _changeDueBannerTotal = 0;
            StateHasChanged();
        }
    }

