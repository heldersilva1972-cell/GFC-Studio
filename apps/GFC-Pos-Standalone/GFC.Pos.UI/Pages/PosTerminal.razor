    .locked-screen-bg {
        z-index: 20000; 
        background: radial-gradient(circle at center, #1e293b 0%, #0f172a 100%) !important;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .rfid-icon-container {
        position: relative;
        display: inline-block;
    }
    .rfid-icon-container::after {
        content: '';
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 150%;
        height: 150%;
        border: 2px solid rgba(255,255,255,0.1);
        border-radius: 50%;
        animation: rfid-ping 2s infinite;
    }
    @@keyframes rfid-ping {
        0% { transform: translate(-50%, -50%) scale(0.8); opacity: 0.8; }
        100% { transform: translate(-50%, -50%) scale(1.5); opacity: 0; }
    }

    .pos-header.correction-mode {
        background: #fef3c7 !important;
        border-bottom: 4px solid #f59e0b !important;
    }
    .correction-active-badge {
        background: #f59e0b;
        color: white;
        padding: 4px 12px;
        border-radius: 50px;
        font-size: 0.7rem;
        font-weight: 900;
        margin-left: 15px;
        animation: blink-amber 1.5s infinite;
        display: flex;
        align-items: center;
        gap: 5px;
        box-shadow: 0 2px 8px rgba(245, 158, 11, 0.4);
    }
    @@keyframes blink-amber {
        0% { opacity: 1; transform: scale(1); }
        50% { opacity: 0.7; transform: scale(0.98); }
        100% { opacity: 1; transform: scale(1); }
    }
