    private void HandleNumPad(string k) 
    { 
        if (k == "CLEAR") 
        {
            CashInputString = ""; 
        }
        else if (k == "BACK") 
        { 
            if (CashInputString.Length > 0) CashInputString = CashInputString[..^1]; 
        } 
        else 
        { 
            // SMART REPLACE: If the last input was a quick-cash button, 
            // clear the string and start fresh with the manual entry.
            if (_isQuickCashInput) 
            {
                CashInputString = "";
                _isQuickCashInput = false;
            }

            if (CashInputString.Contains(".") && CashInputString.Split('.')[1].Length >= 2) return; 
            CashInputString += k; 
        } 
        
        if (decimal.TryParse(CashInputString, out var v)) CashReceived = v; 
        else CashReceived = null; 
    }
    
    private void SetCashReceived(decimal a) 
    { 
        CashReceived = Math.Round(a, 2); 
        CashInputString = CashReceived.Value.ToString("F2"); 
        _isQuickCashInput = true; // Mark as quick-cash for smart replacement
    }
