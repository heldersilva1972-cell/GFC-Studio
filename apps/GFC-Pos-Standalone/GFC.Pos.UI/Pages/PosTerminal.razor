    private async Task TriggerNuclearReload()
    {
        if (_isDownloadingUpdate) return;
        
        // Store attempt info to prevent infinite loops (set prior to wipe, then preserved)
        var serverVersion = !string.IsNullOrEmpty(_serverVersionFound) ? _serverVersionFound : UpdateService.ServerVersion;
        if (string.IsNullOrEmpty(serverVersion)) serverVersion = "FORCE_LIMIT";
        
        var unixTime = DateTimeOffset.UtcNow.ToUnixTimeSeconds().ToString();

        try
        {
            await JSRuntime.InvokeVoidAsync("localStorage.setItem", "gfc_last_update_version", serverVersion);
            await JSRuntime.InvokeVoidAsync("localStorage.setItem", "gfc_last_update_time", unixTime);
        }
        catch { }

        if (UpdateService.IsAndroidPlatform)
        {
            _isDownloadingUpdate = true;
            _downloadProgress = 0;
            _showUpdateBanner = false;
            await InvokeAsync(StateHasChanged);

            bool success = await UpdateService.DownloadAndInstallUpdateAsync(async progress =>
            {
                _downloadProgress = progress;
                await InvokeAsync(StateHasChanged);
            });

            if (!success)
            {
                _isDownloadingUpdate = false;
                _downloadProgress = -1;
                Toast.ShowError("Android Native Update Installation Failed. Please try again.");
                await InvokeAsync(StateHasChanged);
            }
            else
            {
                // The native installer was successfully launched. Since the user might cancel the installation,
                // press the back button, or take time to tap Install, we clear the overlay after 8 seconds 
                // so the terminal screen does not remain frozen at 100% in the background.
                _ = Task.Delay(8000).ContinueWith(async t =>
                {
                    _isDownloadingUpdate = false;
                    _downloadProgress = 0;
                    await InvokeAsync(StateHasChanged);
                });
            }
            return;
        }

        await JSRuntime.InvokeVoidAsync("eval", @"
            const wipe = async () => {
                console.log('[GFC] Initiating Nuclear Update Reload...');
                
                // Clear IndexedDB
                if ('indexedDB' in window) {
                    try {
                        indexedDB.deleteDatabase('GfcPosDB');
                        console.log('[GFC] IndexedDB GfcPosDB deleted successfully.');
                    } catch(e) {
                        console.error('[GFC] Error deleting GfcPosDB:', e);
                    }
                }
                
                // Store tracker vars to restore after wipe
                const ver = localStorage.getItem('gfc_last_update_version');
                const tm = localStorage.getItem('gfc_last_update_time');

                // Clear Storage
                localStorage.clear();
                sessionStorage.clear();
                
                // Restore version tracker to prevent reload loops
                if (ver) localStorage.setItem('gfc_last_update_version', ver);
                if (tm) localStorage.setItem('gfc_last_update_time', tm);
                
                // Unregister Service Workers
                if ('serviceWorker' in navigator) {
                    const registrations = await navigator.serviceWorker.getRegistrations();
                    for(let r of registrations) {
                        console.log('[GFC] Unregistering ServiceWorker:', r.scope);
                        await r.unregister();
                    }
                }
                
                // Clear caches
                if ('caches' in window) {
                    const keys = await caches.keys();
                    for(let k of keys) {
                        console.log('[GFC] Purging Cache Storage:', k);
                        await caches.delete(k);
                    }
                }
                
                // Force absolute reload with timestamp to bypass IIS/Browser caches
                const buster = 'u=' + Date.now();
                const url = window.location.origin + window.location.pathname;
                window.location.href = url + (url.includes('?') ? '&' : '?') + buster;
            };
            wipe();
        ");
    }

    private async Task ForceClearCacheAndReload()
    {
        await JSRuntime.InvokeVoidAsync("eval", @"
            const wipe = async () => {
                console.log('[GFC] Nuclear Purging Offline Vaults & Cache...');
                
                // Clear IndexedDB
                if ('indexedDB' in window) {
                    try {
                        indexedDB.deleteDatabase('GfcPosDB');
                        console.log('[GFC] GfcPosDB database deleted.');
                    } catch(e) {}
                }
                
                // Clear Local & Session Storage
                localStorage.clear();
                sessionStorage.clear();
                
                // Unregister Service Workers
                if ('serviceWorker' in navigator) {
                    const registrations = await navigator.serviceWorker.getRegistrations();
                    for(let r of registrations) {
                        await r.unregister();
                    }
                }
                
                // Clear Caches
                if ('caches' in window) {
                    const keys = await caches.keys();
                    for(let k of keys) {
                        await caches.delete(k);
                    }
                }
                
                // Reload
                const buster = 'u=' + Date.now();
                const url = window.location.origin + window.location.pathname;
                window.location.href = url + (url.includes('?') ? '&' : '?') + buster;
            };
            wipe();
        ");
    }

    private bool IsServerNewer(string serverFullVersion)
    {
        try {
            var parts = serverFullVersion.Split(new[] { "Revision ", "v.", "v" }, StringSplitOptions.RemoveEmptyEntries);
            var serverRev = parts.LastOrDefault()?.Trim();
            var clientRev = VersionService.GetRevision();
            
            if (string.IsNullOrEmpty(serverRev) || string.IsNullOrEmpty(clientRev)) return false;
            if (serverRev.Contains(" ")) serverRev = serverRev.Split(' ')[0];

            // [HARDEN] Prevent cross-project version leaks (e.g. Webapp 3.x vs POS 2.x)
            // POS versions are currently in the 2.x track. Webapp is in the 3.x track.
            if (serverRev.StartsWith("3.") && clientRev.StartsWith("2.")) {
                return false; 
            }

            var sParts = serverRev.Split('.').Select(p => int.TryParse(p, out int v) ? v : 0).ToArray();
            var cParts = clientRev.Split('.').Select(p => int.TryParse(p, out int v) ? v : 0).ToArray();

            for (int i = 0; i < Math.Max(sParts.Length, cParts.Length); i++) {
                int s = i < sParts.Length ? sParts[i] : 0;
                int c = i < cParts.Length ? cParts[i] : 0;
                if (s > c) return true;
                if (s < c) return false;
            }
            return false;
        } catch { return false; }
    }

    private async Task UpdateLocalCollectionsAsync(PosMenuDto menu)
    {
        if (menu == null) return;
        
        Categories = menu.Categories.Where(c => c != "DARTS CLUB ROUND").ToList();
        ModifierCategories = menu.ModifierCategories?.Select(c => c.Trim().ToUpper()).ToList() ?? new();
        Modifiers = menu.Modifiers ?? new();
        DbTokens = menu.Tokens;
        DbActiveEvents = menu.ActiveEvents ?? new();
        DbEventTemplates = menu.EventTemplates ?? new();
        
        var directEvent = DbActiveEvents.FirstOrDefault(ev => ev.Name.EndsWith(" [Direct]") || ev.Name.EndsWith("[Direct]"));
        if (_selectedActiveEvent != null)
        {
            var matched = DbActiveEvents.FirstOrDefault(ev => ev.Id == _selectedActiveEvent.Id || ev.Name == _selectedActiveEvent.Name);
            if (matched != null)
            {
                _selectedActiveEvent = matched;
                Console.WriteLine($"[POS] Remapped selected active event '{matched.Name}' to ID: {matched.Id}");
            }
            else if (IsEventDirect(_selectedActiveEvent))
            {
                _selectedActiveEvent = directEvent;
            }
            else
            {
                _selectedActiveEvent = null;
            }
        }
        else
        {
            _selectedActiveEvent = directEvent;
        }
        
        DbItems = menu.Items.Select(i => new ProductItem { 
            Id = i.Id, 
            Name = i.Name, 
            Price = i.Price, 
            Category = (i.Category ?? "MISC").Trim().ToUpper(),
            DisplayOrder = i.DisplayOrder
        }).ToList();

        Categories = menu.Categories.Select(c => c.Trim().ToUpper()).Where(c => c != "DARTS CLUB ROUND").Distinct().ToList();

        // [AUTO-SELECT] Ensure the active category actually exists in the new list (case-insensitive)
        var current = (ActiveCategory ?? "").Trim().ToUpper();
        if (string.IsNullOrEmpty(current) || !Categories.Contains(current))
        {
            ActiveCategory = Categories.FirstOrDefault() ?? "BEER";
            Console.WriteLine($"[POS] Auto-selected category: {ActiveCategory}");
        }

        // [SYNC PAYOUT CATEGORIES] If the server sent categories, persist them locally
        if (menu.PayoutCategories != null && menu.PayoutCategories.Any())
        {
            _payoutCategories = menu.PayoutCategories;
            try
            {
                await JSRuntime.InvokeVoidAsync("localStorage.setItem", "gfc_payout_categories", JsonSerializer.Serialize(_payoutCategories));
            }
            catch (Exception ex)
            {
                Console.WriteLine($"[POS] Failed to persist synced payout categories to local storage: {ex.Message}");
            }
        }

        // PERFORMANCE: Recompute cached product list now that DbItems,
        // _selectedActiveEvent, and ActiveCategory are all finalized.
        InvalidateFilteredItems();

        UpdateSpeedBar();
    }

