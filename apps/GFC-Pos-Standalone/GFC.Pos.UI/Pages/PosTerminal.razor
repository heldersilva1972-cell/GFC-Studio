    private async void LockTerminal()
    {
        if (string.IsNullOrEmpty(CurrentUserName)) return;

        // [AUTO-UPDATE] Check for newer POS version before locking
        try
        {
            var serverVersion = await PosService.GetServerVersionAsync();
            if (!string.IsNullOrEmpty(serverVersion) && serverVersion != "Offline" && IsServerNewer(serverVersion))
            {
                Console.WriteLine($"[GFC POS UPDATE] New version detected during logout. Forcing cache-clear reload...");
                await TriggerNuclearReload();
                return;
            }
        }
        catch { /* Fallback to standard lock */ }

        CurrentUserName = string.Empty;
        _ = RefreshData(); // Background update for next operator
    }

    private async Task TriggerNuclearReload()
    {
        // Store attempt info to prevent infinite loops
        await JSRuntime.InvokeVoidAsync("localStorage.setItem", "gfc_last_update_version", _serverVersionFound);
        await JSRuntime.InvokeVoidAsync("localStorage.setItem", "gfc_last_update_time", DateTimeOffset.UtcNow.ToUnixTimeSeconds().ToString());

        await JSRuntime.InvokeVoidAsync("eval", @"
            const wipe = async () => {
                console.log('[GFC] Initiating Nuclear Update Reload...');
                if ('serviceWorker' in navigator) {
                    const registrations = await navigator.serviceWorker.getRegistrations();
                    for(let r of registrations) {
                        console.log('[GFC] Unregistering ServiceWorker:', r.scope);
                        await r.unregister();
                    }
                }
                if ('caches' in window) {
                    const keys = await caches.keys();
                    for(let k of keys) {
                        console.log('[GFC] Purging Cache Storage:', k);
                        await caches.delete(k);
                    }
                }
                // Force absolute reload with timestamp to bypass IIS/Browser caches
                const buster = 'u=' + Date.now();
                const url = window.location.origin + window.location.pathname;
                window.location.href = url + (url.includes('?') ? '&' : '?') + buster;
            };
            wipe();
        ");
    }

    private bool IsServerNewer(string serverFullVersion)
    {
        try {
            var parts = serverFullVersion.Split(new[] { "Revision ", "v.", "v" }, StringSplitOptions.RemoveEmptyEntries);
            var serverRev = parts.LastOrDefault()?.Trim();
            var clientRev = VersionService.GetRevision();
            
            if (string.IsNullOrEmpty(serverRev) || string.IsNullOrEmpty(clientRev)) return false;
            if (serverRev.Contains(" ")) serverRev = serverRev.Split(' ')[0];

            // [HARDEN] Prevent cross-project version leaks (e.g. Webapp 3.x vs POS 2.x)
            // POS versions are currently in the 2.x track. Webapp is in the 3.x track.
            if (serverRev.StartsWith("3.") && clientRev.StartsWith("2.")) {
                return false; 
            }

            var sParts = serverRev.Split('.').Select(p => int.TryParse(p, out int v) ? v : 0).ToArray();
            var cParts = clientRev.Split('.').Select(p => int.TryParse(p, out int v) ? v : 0).ToArray();

            for (int i = 0; i < Math.Max(sParts.Length, cParts.Length); i++) {
                int s = i < sParts.Length ? sParts[i] : 0;
                int c = i < cParts.Length ? cParts[i] : 0;
                if (s > c) return true;
                if (s < c) return false;
            }
            return false;
        } catch { return false; }
    }

    private void UpdateLocalCollections(PosMenuDto menu)
    {
        if (menu == null) return;
        
        Categories = menu.Categories.Where(c => c != "DARTS CLUB ROUND").ToList();
        ModifierCategories = menu.ModifierCategories?.Select(c => c.Trim().ToUpper()).ToList() ?? new();
        Modifiers = menu.Modifiers ?? new();
        DbTokens = menu.Tokens;
        DbActiveEvents = menu.ActiveEvents ?? new();
        DbEventTemplates = menu.EventTemplates ?? new();
        
        var directEvent = DbActiveEvents.FirstOrDefault(ev => ev.Name.EndsWith(" [Direct]") || ev.Name.EndsWith("[Direct]"));
        if (directEvent != null)
        {
            _selectedActiveEvent = directEvent;
        }
        else if (_selectedActiveEvent != null && IsEventDirect(_selectedActiveEvent))
        {
            _selectedActiveEvent = null;
        }
        
        DbItems = menu.Items.Select(i => new ProductItem { 
            Id = i.Id, 
            Name = i.Name, 
            Price = i.Price, 
            Category = (i.Category ?? "MISC").Trim().ToUpper(),
            DisplayOrder = i.DisplayOrder
        }).ToList();

        Categories = menu.Categories.Select(c => c.Trim().ToUpper()).Where(c => c != "DARTS CLUB ROUND").Distinct().ToList();

        // [AUTO-SELECT] Ensure the active category actually exists in the new list (case-insensitive)
        var current = (ActiveCategory ?? "").Trim().ToUpper();
        if (string.IsNullOrEmpty(current) || !Categories.Contains(current))
        {
            ActiveCategory = Categories.FirstOrDefault() ?? "BEER";
            Console.WriteLine($"[POS] Auto-selected category: {ActiveCategory}");
        }

        UpdateSpeedBar();
    }

