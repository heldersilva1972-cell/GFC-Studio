                                  <span>WAS: @_originalSaleAmount.ToString("C")</span>
                                  <i class="bi bi-arrow-right mx-2"></i>
                                  <span>NOW: @Subtotal.ToString("C")</span>
                              </div>
                          </div>
                      }
                      else
                      {
                          @* COLLECT EXTRA DISPLAY - UNIFIED WITH STANDARD UI *@
                          <div class="display-row top">
                              <span class="label">EXTRA AMOUNT DUE</span>
                              <span class="value animate__animated animate__pulse animate__infinite" style="color: #dc2626;">@Math.Abs(diff).ToString("C")</span>
                          </div>
  
                          <div class="display-row main">
                              <span class="currency">$</span>
                              <span class="value">@(string.IsNullOrEmpty(CashInputString) ? "0.00" : CashInputString)</span>
                          </div>
  
                          <div class="display-status-bar @(CashReceived.HasValue && CashReceived.Value >= Math.Abs(diff) ? "status-change" : "status-pending")">
                              @if (CashReceived.HasValue && CashReceived.Value >= Math.Abs(diff))
                              {
                                  <span class="status-label">CHANGE DUE</span>
                                  <span class="status-value">@((CashReceived.Value - Math.Abs(diff)).ToString("C"))</span>
                              }
                              else
                              {
                                  <span class="status-label">STILL OWED</span>
                                  <span class="status-value">@(Math.Abs(Math.Abs(diff) - (CashReceived ?? 0)).ToString("C"))</span>
                              }
                          </div>
                      }
                  }
                  else
                  {
                      <div class="display-row top">
                          <span class="label">@( _isCorrectionMode ? "COLLECT NEW TOTAL" : "TOTAL DUE")</span>
                          <span class="value animate__animated animate__pulse animate__infinite">@Subtotal.ToString("C")</span>
                      </div>
  
                      <div class="display-row main">
                          <span class="currency">$</span>
                          <span class="value">@(string.IsNullOrEmpty(CashInputString) ? "0.00" : CashInputString)</span>
                      </div>
                      
                      <div class="display-status-bar @(CashReceived.HasValue && CashReceived.Value >= Subtotal ? "status-change" : "status-pending")">
                          <span class="status-label">@(CashReceived.HasValue && CashReceived.Value >= Subtotal ? "CHANGE DUE" : "STILL OWED")</span>
                          <span class="status-value">@Math.Abs(ChangeDue).ToString("C")</span>
                      </div>
                  }
              </div>
  
              @if (!(_isCorrectionMode && _isMoneyCollected && (Subtotal - _originalSaleAmount) < 0))
              {
                  <div class="checkout-main-grid">
                      <div class="numpad-container">
                          @foreach (var k in new[] { "7", "8", "9", "4", "5", "6", "1", "2", "3", ".", "0", "BACK" })
                          {
                              <button class="numpad-btn" @onclick='() => HandleNumPad(k)'>
                                  @if (k == "BACK") { <i class="bi bi-backspace-fill"></i> } else { @k }
                              </button>
                          }
                      </div>
  
                      <div class="quick-cash-column">
                          <button class="btn btn-quick-cash" @onclick='() => SetCashReceived(_isCorrectionMode && _isMoneyCollected ? Math.Abs(Subtotal - _originalSaleAmount) : Subtotal)'>EXACT</button>
                          <button class="btn btn-quick-cash" @onclick="() => SetCashReceived(5)">$5</button>
                          <button class="btn btn-quick-cash" @onclick="() => SetCashReceived(10)">$10</button>
                          <button class="btn btn-quick-cash" @onclick="() => SetCashReceived(20)">$20</button>
                      </div>
                  </div>
              }
  
              <div class="checkout-button-group">
                  <button class="btn btn-primary btn-complete" @onclick="FinalizeSale">
                      @(_isCorrectionMode ? "CONFIRM ADJUSTMENT" : "COMPLETE TRANSACTION")
                  </button>
                  <button class="btn btn-outline-secondary btn-add-more" @onclick="() => ShowCheckoutOverlay = false">BACK TO ORDER</button>
              </div>
          </div>
    </div>
}

