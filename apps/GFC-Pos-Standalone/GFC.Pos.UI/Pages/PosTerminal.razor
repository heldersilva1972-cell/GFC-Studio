    private void InvalidateFilteredItems()
    {
        var category = (ActiveCategory ?? "").Trim().ToUpper();
        var items = DbItems.AsEnumerable();

        if (category == "DARTS CLUB ROUND")
            items = items.Where(i => (i.Category ?? "").Trim().ToUpper() == "BEER" || (i.Category ?? "").Trim().ToUpper() == "LIQUOR");
        else
            items = items.Where(i => (i.Category ?? "").Trim().ToUpper() == category);

        if (_selectedActiveEvent != null)
        {
            var template = _selectedActiveEvent.Template ?? DbEventTemplates?.FirstOrDefault(t => (_selectedActiveEvent.TemplateId.HasValue && t.Id == _selectedActiveEvent.TemplateId.Value) || (!string.IsNullOrEmpty(_selectedActiveEvent.Name) && (string.Equals(t.Name, _selectedActiveEvent.Name, StringComparison.OrdinalIgnoreCase) || _selectedActiveEvent.Name.StartsWith(t.Name, StringComparison.OrdinalIgnoreCase) || t.Name.StartsWith(_selectedActiveEvent.Name, StringComparison.OrdinalIgnoreCase))));
            if (template != null && !string.IsNullOrEmpty(template.ItemsOverrideJson))
            {
                try
                {
                    var overrides = global::System.Text.Json.JsonSerializer.Deserialize<List<BanquetOverrideDto>>(template.ItemsOverrideJson, new global::System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true }) ?? new();
                    var visibleOverrides = overrides.Where(o => o.IsVisible).ToList();
                    var visibleItemIds = visibleOverrides.Select(o => o.ItemId).ToList();

                    if (!visibleItemIds.Any())
                    {
                        _filteredItems = items.ToList();
                        return;
                    }

                    _filteredItems = items
                        .Where(i => visibleItemIds.Contains(i.Id))
                        .Select(i =>
                        {
                            var ov = visibleOverrides.FirstOrDefault(o => o.ItemId == i.Id);
                            var effectivePrice = (ov != null && ov.OverridePrice > 0) ? ov.OverridePrice : i.Price;
                            return new ProductItem
                            {
                                Id = i.Id,
                                Name = i.Name,
                                Price = effectivePrice,
                                Category = i.Category,
                                DisplayOrder = i.DisplayOrder,
                                Modifiers = new List<ProductItem>()
                            };
                        })
                        .ToList();
                    return;
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"[POS] Error processing banquet overrides: {ex.Message}");
                }
            }
        }

        _filteredItems = items.ToList();
    }
    
