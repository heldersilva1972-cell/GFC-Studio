    private ShiftAuditDto _currentAudit = new();
    // PERFORMANCE: Debounce gate — GetShiftAuditAsync() scans all of IndexedDB.
    // Limit to at most once every 2 seconds to prevent accumulating lag as the shift grows.
    private DateTime _lastAuditRefresh = DateTime.MinValue;
    private async Task UpdateAuditAsync()
    {
        if ((DateTime.Now - _lastAuditRefresh).TotalSeconds < 2) return;
        _lastAuditRefresh = DateTime.Now;
        _currentAudit = await PosService.GetShiftAuditAsync();
        RequestRender();
    }

    private async Task FinalizeSale()
    {
        var wasDarts = isDartsModeActive;
        var amountToRecord = Subtotal;
        var payment = _isTabPayment ? "TAB" : ((amountToRecord == 0) ? "TOKEN/COMP" : "CASH");
        var saleId = _correctingSaleId ?? Guid.NewGuid();

        // BUILD THE SALE RECORD FIRST
        var sale = new PosSaleDto
        {
            Id = saleId,
            Timestamp = DateTime.Now,
            TerminalName = forceTrainingMode ? $"{TerminalName} (TRAINING)" : TerminalName,
            TotalAmount = amountToRecord,
            BartenderName = CurrentUserName,
            PaymentType = payment,
            ActiveEventId = _isTabPayment ? _selectedActiveEvent?.Id : null,
            ItemsJson = JsonSerializer.Serialize(CartItems),
            AmountReceived = _isTabPayment ? amountToRecord : CashReceived,
            ChangeDue = _isTabPayment ? 0 : ((CashReceived.HasValue && CashReceived.Value > amountToRecord) ? (CashReceived.Value - amountToRecord) : null),
            OriginalTotal = _isCorrectionMode ? _originalSaleAmount : 0,
            IsCorrection = _isCorrectionMode
        };
        
        if (_isTabPayment && _selectedActiveEvent != null)
        {
            _selectedActiveEvent.CurrentBalance -= amountToRecord;
            if (!forceTrainingMode && _cachedMenu != null)
            {
                await PosService.SaveMenuToVaultAsync(_cachedMenu);
            }
        }
        
        // PERFORMANCE: Capture correction flag BEFORE resetting it below.
        var wasCorrection = _isCorrectionMode;

        // 1. UPDATE SHIFT DATABASE (PROPER ARCHITECTURE)
        if (forceTrainingMode)
        {
            if (_isCorrectionMode && _lastSale != null)
            {
                // Return the money originally removed from the event (prepaid or running tab)
                if (_lastSale.PaymentType == "TAB" && _lastSale.ActiveEventId != null)
                {
                    var originalEvent = DbActiveEvents?.FirstOrDefault(e => e.Id == _lastSale.ActiveEventId);
                    if (originalEvent != null)
                    {
                        originalEvent.CurrentBalance += _lastSale.TotalAmount;
                        Console.WriteLine($"[POS] [TRAINING] Returned {_lastSale.TotalAmount:C} to event '{originalEvent.Name}' due to correction void.");
                    }
                }

                sale.IsCorrection = true;
                sale.OriginalSaleId = _lastSale.Id;
                sale.AdjustmentReason = $"Corrected from {_originalSaleAmount:N2}";
            }
        }
        else
        {
            if (_isCorrectionMode && _lastSale != null)
            {
                await PosService.VoidSaleAsync(_lastSale.Id, "Correction Replacement");
                
                // Return the money originally removed from the event (prepaid or running tab)
                if (_lastSale.PaymentType == "TAB" && _lastSale.ActiveEventId != null)
                {
                    var originalEvent = DbActiveEvents?.FirstOrDefault(e => e.Id == _lastSale.ActiveEventId);
                    if (originalEvent != null)
                    {
                        originalEvent.CurrentBalance += _lastSale.TotalAmount;
                        if (_cachedMenu != null)
                        {
                            _cachedMenu.ActiveEvents = DbActiveEvents;
                            await PosService.SaveMenuToVaultAsync(_cachedMenu);
                        }
                        Console.WriteLine($"[POS] Returned {_lastSale.TotalAmount:C} to event '{originalEvent.Name}' due to correction void.");
                    }
                }

                sale.IsCorrection = true;
                sale.OriginalSaleId = _lastSale.Id;
                sale.AdjustmentReason = $"Corrected from {_originalSaleAmount:N2}";
            }

            await PosService.AddSaleToShiftAsync(sale);
            // PERFORMANCE: Run audit update in the background — do NOT block the UI thread.
            // The shift totals banner will refresh within 2 seconds.
            _ = UpdateAuditAsync();
        }

        _lastSale = sale; // Update last sale tracker
        _isCorrectionMode = false;
        _originalSaleAmount = 0;

        if (!forceTrainingMode) 
        {
            // Open drawer for CASH sales, or corrections (where cash may need to be returned/collected)
            if (payment == "CASH" || wasCorrection)
            {
                _ = Task.Run(async () =>
                {
                    try
                    {
                        await PrinterService.KickDrawerAsync();
                    }
                    catch (Exception ex)
                    {
                        Console.WriteLine($"[POS] Checkout KickDrawerAsync failed: {ex.Message}");
                    }
                });
            }

            await PosService.SaveSaleAsync(sale);
            
            _correctingSaleId = null;
            
            foreach (var ci in CartItems.Where(i => i.Category != "TOKENS" && i.Category != "FOOD")) 
            {
                if (!ItemFrequency.ContainsKey(ci.Id)) ItemFrequency[ci.Id] = 0;
                ItemFrequency[ci.Id] += ci.Quantity;
            }
        }
        
        if (wasDarts)
        {
            _dartsDismissedToday = true;
            if (forceTrainingMode)
            {
                _ = ResetDartsBannerAfterDelay();
            }
        }
        
        // PERFORMANCE: Reset all UI state and clear the cart FIRST — this makes the
        // terminal feel instant. The audit and speed-bar updates happen in the background.
        var directEvent = DbActiveEvents?.FirstOrDefault(ev => ev.Name.EndsWith(" [Direct]") || ev.Name.EndsWith("[Direct]"));
        _selectedActiveEvent = directEvent;
        InvalidateFilteredItems(); // Recompute product list
        ClearCart();
        _correctingSaleId = null;
        _isTabPayment = false;
        ShowCheckoutOverlay = false;
        if (payment == "CASH" && CashReceived.HasValue && CashReceived.Value > amountToRecord)
        {
            ShowChangeDueBanner(CashReceived.Value - amountToRecord, CashReceived.Value, amountToRecord);
        }
        CashReceived = null;
        CashInputString = "";
        showSuccessOverlay = true;
        RequestRender(); // Show success overlay immediately
        await Task.Delay(250); // Snappy success delay to keep transaction fast
        showSuccessOverlay = false;
        UpdateSpeedBar();
        RequestRender();
    }

    private async Task ReprintLastZReport()
    {
        try
        {
            // 1. Try to load from localStorage HTML cache first (fully offline-safe and reliable)
            var storedHtml = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "gfc_last_printed_z_html");
            if (!string.IsNullOrEmpty(storedHtml))
            {
                showOptionsMenu = false;
                var printHtml = storedHtml;
                if (!printHtml.Contains("*** REPRINT ***"))
                {
                    printHtml = printHtml.Replace("Z-REPORT SUMMARY", "*** REPRINT ***\nZ-REPORT SUMMARY");
                }
                await PrintReceiptAsync(printHtml);
                Toast.ShowSuccess("Z-Report re-printing...");
                return;
            }

            // 2. Fallback to reconstructing from the database/outbox reports list
            var reports = await PosService.GetZReportsAsync(TerminalName);
            var last = reports?.OrderByDescending(x => x.Timestamp).FirstOrDefault();
            
            if (last == null)
            {
                Toast.ShowWarning("No Z-reports found for this terminal.");
                return;
            }

            var html = BuildZReportHtml(last, isReprint: true);
            await PrintReceiptAsync(html);
            Toast.ShowSuccess("Z-Report re-printing...");
            showOptionsMenu = false;
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Error reprinting Z-report: {ex.Message}");
        }
    }

