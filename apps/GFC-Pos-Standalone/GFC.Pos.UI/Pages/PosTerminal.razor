    private bool IsEligibleBeverageForComp(ProductItem? item)
    {
        if (item == null) return false;
        var cat = (item.Category ?? "").Trim().ToUpperInvariant();
        if (cat == "FOOD" || cat == "SNACKS" || cat == "SNACK" || cat == "TOKENS" || cat == "TOKEN_CREDIT" || cat == "MISC")
            return false;
        if (item.Name.Contains("(TOKEN") || item.Category == "TOKEN_CREDIT")
            return false;
        return true;
    }

    private void StartCartItemLongPress(ProductItem item)
    {
        bool allowUpstairsToggle = _enableUpstairsPricingButton && (_isUpstairsModeActive || item.IsUpstairsPrice);
        if ((!_cartCompGestureEnabled && !allowUpstairsToggle) || !IsEligibleBeverageForComp(item)) return;
        _longPressTimer?.Dispose();
        _longPressTimer = new System.Threading.Timer(_ =>
        {
            _ = InvokeAsync(() =>
            {
                HandleCartItemQuickComp(item);
            });
        }, null, 600, System.Threading.Timeout.Infinite);
    }

    private void CancelCartItemLongPress()
    {
        _longPressTimer?.Dispose();
        _longPressTimer = null;
    }

    private void HandleCartItemQuickComp(ProductItem item)
    {
        CancelCartItemLongPress();
        if (_enableUpstairsPricingButton && (_isUpstairsModeActive || item.IsUpstairsPrice))
        {
            ToggleSingleCartItemUpstairsPrice(item);
            return;
        }
        if (!_cartCompGestureEnabled) return;
        if (!IsEligibleBeverageForComp(item))
        {
            ShowNotice("Item Not Eligible", "Only drinks (Beer, Liquor, Wine, Seltzer, etc.) can be comped. Food and snack items cannot be comped.", "warning");
            return;
        }

        _targetCompItem = item;
        _selectedMultiCompItem = null;
        _compQuantityToApply = 1; // Default to 1 bottle/unit
        _showCompModal = true;
        StateHasChanged();
    }

