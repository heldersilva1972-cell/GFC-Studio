                                <button class="btn btn-warning w-100 py-3 rounded-pill fw-black fs-5 shadow-sm text-dark border-warning"
                                        @onclick="() => SubmitPizzaPayout(_dartPizzaPayoutAmount)">
                                    <i class="bi bi-check-circle-fill me-2"></i> CONFIRM PAYOUT ($@_dartPizzaPayoutAmount.ToString("F2"))
                                </button>
