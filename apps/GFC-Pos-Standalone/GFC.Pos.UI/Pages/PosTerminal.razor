                            <button class="option-tile-medium tile-closeshift border" @onclick='() => { showOptionsMenu = false; _inventoryPullDraft.Clear(); _currentCloseOutStep = CloseOutStep.PromptInventory; }'>
                                <div class="d-flex justify-content-between align-items-start w-100 mb-1.5">
                                    <div class="tile-icon-box shadow-sm">
                                        <i class="bi bi-door-closed-fill"></i>
                                    </div>
                                    <i class="bi bi-arrow-right-short fs-4 opacity-50"></i>
                                </div>
