    private async Task FinalizeSale()
    {
        var amountToRecord = Subtotal;
        var payment = _isTabPayment ? "TAB" : ((amountToRecord == 0) ? "TOKEN/COMP" : "CASH");
        var saleId = _correctingSaleId ?? Guid.NewGuid();

        // BUILD THE SALE RECORD FIRST
        var sale = new PosSaleDto
        {
            Id = saleId,
            Timestamp = DateTime.Now,
            TerminalName = forceTrainingMode ? $"{TerminalName} (TRAINING)" : TerminalName,
            TotalAmount = amountToRecord,
            BartenderName = CurrentUserName,
            PaymentType = payment,
            ActiveEventId = _isTabPayment ? _selectedActiveEvent?.Id : null,
            ItemsJson = JsonSerializer.Serialize(CartItems),
            AmountReceived = _isTabPayment ? amountToRecord : CashReceived,
            ChangeDue = _isTabPayment ? 0 : ((CashReceived.HasValue && CashReceived.Value > amountToRecord) ? (CashReceived.Value - amountToRecord) : null),
            OriginalTotal = _isCorrectionMode ? _originalSaleAmount : 0,
            IsCorrection = _isCorrectionMode
        };
        
        if (!forceTrainingMode && _isTabPayment && _selectedActiveEvent != null)
        {
            _selectedActiveEvent.CurrentBalance -= amountToRecord;
        }
        
        // 1. UPDATE SHIFT DATABASE (PROPER ARCHITECTURE)
        if (!forceTrainingMode)
        {
            if (_isCorrectionMode && _lastSale != null)
            {
                await PosService.VoidSaleAsync(_lastSale.Id, "Correction Replacement");
                sale.IsCorrection = true;
                sale.OriginalSaleId = _lastSale.Id;
                sale.AdjustmentReason = $"Corrected from {_originalSaleAmount:N2}";
            }

            await PosService.AddSaleToShiftAsync(sale);
            await UpdateAuditAsync();
        }

        _lastSale = sale; // Update last sale tracker
        _isCorrectionMode = false;
        _originalSaleAmount = 0;

        if (!forceTrainingMode) 
        {
            // Open drawer for CASH sales or ANY Correction (where cash may need to be returned/collected)
            if (payment == "CASH" || _isCorrectionMode)
            {
                await PrinterService.KickDrawerAsync();
            }

            await PosService.SaveSaleAsync(sale);
            
            if (_correctingSaleId != null)
            {
                _correctingSaleId = null;
            }
            
            foreach (var ci in CartItems.Where(i => i.Category != "TOKENS" && i.Category != "FOOD")) 
            {
                if (!ItemFrequency.ContainsKey(ci.Id)) ItemFrequency[ci.Id] = 0;
                ItemFrequency[ci.Id] += ci.Quantity;
            }
        }
        
        ClearCart(); 
        _correctingSaleId = null; 
        _isTabPayment = false;
        // Snap back to regular walk-in mode, or the active direct event if one exists!
        var directEvent = DbActiveEvents?.FirstOrDefault(ev => ev.Name.EndsWith(" [Direct]") || ev.Name.EndsWith("[Direct]"));
        _selectedActiveEvent = directEvent;
        ActiveCategory = "BEER"; // Reset default category
        ShowCheckoutOverlay = false; 
        CashReceived = null; 
        CashInputString = "";
        showSuccessOverlay = true; 
        StateHasChanged(); 
        await Task.Delay(1000); 
        showSuccessOverlay = false;
        UpdateSpeedBar(); 
        StateHasChanged();
    }

    private async Task ReprintLastZReport()
    {
        try
        {
            var reports = await PosService.GetZReportsAsync(TerminalName);
            var last = reports?.OrderByDescending(x => x.Timestamp).FirstOrDefault();
            
            if (last == null)
            {
                Toast.ShowWarning("No Z-reports found for this terminal.");
                return;
            }

            var html = BuildZReportHtml(last);
            await PrinterService.PrintReceiptAsync(html);
            Toast.ShowSuccess("Z-Report re-printing...");
            showOptionsMenu = false;
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Error reprinting: {ex.Message}");
        }
    }

    private string BuildZReportHtml(PosZReportDto z)
    {
        var salesSummary = JsonSerializer.Deserialize<Dictionary<string, int>>(z.SalesSummaryJson) ?? new();
        var banquetSummary = JsonSerializer.Deserialize<List<BanquetShiftReportDto>>(z.BanquetSummaryJson) ?? new();
        var inventoryPulls = JsonSerializer.Deserialize<Dictionary<int, int>>(z.InventoryPullsJson) ?? new();
        var totalPrepaidDeposits = banquetSummary.Sum(b => b.Deposits.Sum());

        // [SMART SUBTRACTION] Subtract banquet item sales from standard category calculations
        var regularSalesSummary = new Dictionary<string, int>(salesSummary);
        foreach (var b in banquetSummary)
        {
            foreach (var item in b.ItemSummary)
            {
                if (regularSalesSummary.ContainsKey(item.Key))
                {
                    regularSalesSummary[item.Key] -= item.Value;
                    if (regularSalesSummary[item.Key] <= 0)
                    {
                        regularSalesSummary.Remove(item.Key);
                    }
                }
            }
        }

        // Calculate Token Credits
        decimal tokenCredits = 0;
        foreach (var kvp in salesSummary)
        {
            if (kvp.Key.Contains("TOKEN CREDIT") || kvp.Key.Contains("(TOKEN REDEEMED)"))
            {
                var product = DbItems.FirstOrDefault(i => i.Name == kvp.Key);
                if (product != null) tokenCredits += Math.Abs(product.Price) * kvp.Value;
            }
        }

        // Generate Sales Rows (Grouped by Category)
        var groupedRegular = regularSalesSummary
            .Select(kvp => {
                var product = DbItems.FirstOrDefault(i => i.Name == kvp.Key);
                var category = product?.Category;
                if (kvp.Key.StartsWith("TAB DEPOSIT:")) category = "DEPOSITS";
                if (kvp.Key.Contains("TOKEN CREDIT") || kvp.Key.Contains("(TOKEN REDEEMED)")) category = "TOKENS";
                
                decimal price = product?.Price ?? 0;
                return new { 
                    Name = kvp.Key, 
                    Quantity = kvp.Value, 
                    Category = category ?? "MISC", 
                    Total = price * kvp.Value
                };
            })
            .GroupBy(x => x.Category)
            .OrderBy(g => g.Key);

        var salesRows = "";
        foreach(var group in groupedRegular) {
            salesRows += $"<div style='font-weight:bold; margin-top:12px; border-bottom:1px solid #000; text-transform:uppercase; font-size:0.9em;'>{group.Key}</div>";
            foreach(var item in group.OrderByDescending(x => x.Quantity)) {
                salesRows += $"<div style='display:flex; justify-content:space-between; font-size:0.85em; padding: 2px 0;'><span>{item.Name} (x{item.Quantity})</span><span>{item.Total:C}</span></div>";
            }
            var groupTotal = group.Sum(x => x.Total);
            salesRows += $"<div style='display:flex; justify-content:space-between; font-weight:bold; font-size:0.85em; border-top:1px dashed #ccc; margin-top:2px;'><span>{group.Key} TOTAL</span><span>{groupTotal:C}</span></div>";
        }

        var inventoryRows = "";
        foreach(var pull in inventoryPulls) {
            var prod = DbItems.FirstOrDefault(i => i.Id == pull.Key);
            if (prod != null) inventoryRows += $"<div style='display:flex; justify-content:space-between;'><span>{prod.Name}</span><span>{pull.Value}</span></div>";
        }

        var banquetRows = "";
        foreach (var b in banquetSummary)
        {
            var isRunningTab = b.EventType == "RunningTab" || b.EventName.EndsWith(" [Direct]") || b.EventName.EndsWith("[Direct]");
            banquetRows += $@"
                <div style='margin-top:10px; border:1px solid #ccc; padding:8px; border-radius:4px;'>
                    <div style='font-weight:bold; font-size:1.1em; color:#000; border-bottom:1px solid #eee; margin-bottom:5px;'>BANQUET: {b.EventName}</div>";
            
            if (!isRunningTab)
            {
                banquetRows += $@"<div style='font-weight:bold; font-size:0.8em; color:#666;'>DEPOSITS:</div>";
                foreach (var dep in b.Deposits)
                {
                    banquetRows += $"<div style='display:flex; justify-content:space-between; font-size:0.85em;'><span>- Add Funds</span><span>{dep:C}</span></div>";
                }
            }
            
            banquetRows += $@"<div style='font-weight:bold; font-size:0.8em; color:#666; margin-top:5px;'>TAB PURCHASES:</div>";
            foreach (var item in b.ItemSummary.OrderByDescending(x => x.Value))
            {
                var itemTotal = b.ItemTotals.ContainsKey(item.Key) ? b.ItemTotals[item.Key] : 0;
                banquetRows += $"<div style='display:flex; justify-content:space-between; font-size:0.85em;'><span>{item.Key} (x{item.Value})</span><span>{itemTotal:C}</span></div>";
            }
            
            var remaining = b.Deposits.Sum() - b.TotalSpent;
            banquetRows += $@"
                    <div style='display:flex; justify-content:space-between; font-size:0.9em; border-top:1px solid #eee; margin-top:5px; padding-top:2px;'>
                        <span>TOTAL SPENT:</span><span>{b.TotalSpent:C}</span>
                    </div>";

            if (!isRunningTab)
            {
                banquetRows += $@"
                    <div style='display:flex; justify-content:space-between; font-weight:bold; font-size:0.95em;'>
                        <span>TAB BALANCE:</span><span>{remaining:C}</span>
                    </div>";
            }
            else
            {
                banquetRows += $@"
                    <div style='display:flex; justify-content:space-between; font-weight:bold; font-size:0.95em;'>
                        <span>TOTAL DUE:</span><span>{b.TotalSpent:C}</span>
                    </div>";
            }
            banquetRows += "</div>";
        }

        return $@"
            <div style='font-family: monospace; width: 300px; padding: 10px;'>
                <div style='text-align: center;'>
                    <h2 style='margin:0;'>GFC TERMINAL</h2>
                    <div style='font-size:0.9em;'>{TerminalName}</div>
                    <hr/>
                    <h3 style='margin:10px 0;'>Z-REPORT SUMMARY</h3>
                    <hr/>
                </div>
                
                <div style='margin-bottom:10px;'>
                    <div>Date: {z.Timestamp:g}</div>
                    <div>Operator: {z.BartenderName}</div>
                </div>

                <div style='border: 1px solid #000; padding: 5px; margin-bottom:10px;'>
                    <div style='display:flex; justify-content:space-between; font-weight:bold;'>
                        <span>GROSS SALES:</span><span>{z.TotalGrossSales:C}</span>
                    </div>
                    {(totalPrepaidDeposits > 0 ? $@"
                        <div style='display:flex; justify-content:space-between; font-weight:bold; color: #166534; margin-top:2px;'>
                            <span>PREPAID FUNDS ADDED:</span><span>+ {totalPrepaidDeposits:C}</span>
                        </div>" : "")}
                    {(tokenCredits > 0 ? $@"
                        <div style='display:flex; justify-content:space-between; font-weight:bold; color: #991b1b; margin-top:2px;'>
                            <span>TOKEN CREDITS:</span><span>- {tokenCredits:C}</span>
                        </div>" : "")}
                    <div style='display:flex; justify-content:space-between; font-weight:bold; border-top: 1px solid #000; margin-top:4px; padding-top:4px;'>
                        <span>CASH IN DRAWER:</span><span>{z.CashTotal:C}</span>
                    </div>
                    <div style='font-size:0.7em; margin-top:4px; opacity:0.8;'>* Includes Tab purchases; excludes Deposits.</div>
                </div>

                <div style='margin-top:15px;'>
                    <div style='font-weight:bold; border-bottom:2px solid #000; margin-bottom:5px; font-size:1.1em;'>REGULAR SALES</div>
                    {salesRows}
                </div>

                {(string.IsNullOrEmpty(banquetRows) ? "" : $@"
                <div style='margin-top:15px;'>
                    <div style='font-weight:bold; border-bottom:1px solid #ccc; margin-bottom:5px;'>BANQUET ACTIVITY</div>
                    {banquetRows}
                </div>")}

                {(string.IsNullOrEmpty(inventoryRows) ? "" : $@"
                <div style='margin-top:15px;'>
                    <div style='font-weight:bold; border-bottom:1px solid #ccc; margin-bottom:5px;'>INVENTORY REMOVAL LOG</div>
                    {inventoryRows}
                </div>")}

                <div style='text-align: center; margin-top:20px; font-size: 0.7em; opacity: 0.8;'>
                    <hr/>
                    Standalone Mode v{VersionService.GetRevision()}
                </div>
            </div>";
    }

