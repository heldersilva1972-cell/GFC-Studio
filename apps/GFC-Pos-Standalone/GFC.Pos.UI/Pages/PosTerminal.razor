    private void PayoutKeypadPress(string key)
    {
        if (key == "DEL")
        {
            if (_payoutInputString.Length > 0)
                _payoutInputString = _payoutInputString.Substring(0, _payoutInputString.Length - 1);
        }
        else if (key == ".")
        {
            if (!_payoutInputString.Contains("."))
            {
                if (string.IsNullOrEmpty(_payoutInputString))
                    _payoutInputString = "0.";
                else
                    _payoutInputString += ".";
            }
        }
        else
        {
            // If there's a decimal, restrict to 2 decimal places
            if (_payoutInputString.Contains("."))
            {
                var parts = _payoutInputString.Split('.');
                if (parts[1].Length < 2)
                    _payoutInputString += key;
            }
            else if (_payoutInputString.Length < 7)
            {
                _payoutInputString += key;
            }
        }

        if (string.IsNullOrEmpty(_payoutInputString) || _payoutInputString == "0.")
            _payoutAmount = 0;
        else if (decimal.TryParse(_payoutInputString, out var val))
            _payoutAmount = val;
    }
