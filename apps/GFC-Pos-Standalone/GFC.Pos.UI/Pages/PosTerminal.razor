    private async Task LoadDrawHistory()
    {
        try
        {
            var json = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "gfc_draw_history_list") ?? "";
            if (!string.IsNullOrEmpty(json))
            {
                _drawHistoryList = global::System.Text.Json.JsonSerializer.Deserialize<List<DrawHistoryEntry>>(json) ?? new();
            }
            else
            {
                _drawHistoryList = new();
            }
        }
        catch
        {
            _drawHistoryList = new();
        }
    }

    private async Task AddToDrawHistory(int memberId, string name, string timestamp, bool isEligible)
    {
        try
        {
            await LoadDrawHistory();
            var newEntry = new DrawHistoryEntry
            {
                MemberId = memberId,
                Name = name,
                Timestamp = timestamp,
                IsEligible = isEligible
            };

            // Insert at the beginning so most recent shows first
            _drawHistoryList.Insert(0, newEntry);

            // Keep last 50 entries
            if (_drawHistoryList.Count > 50)
            {
                _drawHistoryList = _drawHistoryList.Take(50).ToList();
            }

            var json = global::System.Text.Json.JsonSerializer.Serialize(_drawHistoryList);
            await JSRuntime.InvokeVoidAsync("localStorage.setItem", "gfc_draw_history_list", json);
        }
        catch { }
    }

    private async Task ClearDrawHistory()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("localStorage.removeItem", "gfc_draw_history_list");
            _drawHistoryList.Clear();
            StateHasChanged();
        }
