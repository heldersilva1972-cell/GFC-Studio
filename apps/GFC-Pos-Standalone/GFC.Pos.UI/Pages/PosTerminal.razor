    private void ActivateDartsMode()
    {
        isDartsModeActive = true; 
        
        if (CartItems.Any()) 
        {
            // 1. Remove food items (strictly prohibited)
            int removedFood = CartItems.RemoveAll(i => i.Category == "FOOD");
            if (removedFood > 0) 
            {
                ShowNotice("Items Removed", "Food items were removed because they are not allowed during Darts Club Rounds.", "warning");
            }

            // 2. Zero out eligible items
            foreach (var item in CartItems.Where(i => i.Price > 0)) 
            {
                if (item.Category == "BEER" || item.Category == "LIQUOR" || item.Category == "TOKENS") 
                {
                    item.Name = item.Name.Contains("(DARTS)") ? item.Name : $"{item.Name} (DARTS)";
                    item.Price = 0;
                }
            }
        }
        StateHasChanged();
    }

