    private string BuildLiquorInventoryHtml(List<GFC.Core.Models.LiquorItem> items)
    {
        // Update all categories list dynamically
        _allLiquorCategories = items
            .Where(i => i.IsActive)
            .Select(i => string.IsNullOrWhiteSpace(i.Category) ? "UNASSIGNED" : i.Category.Trim().ToUpper())
            .Distinct()
            .OrderBy(c => c)
            .ToList();

        // Only active and selected category items
        var active = items
            .Where(i => i.IsActive)
            .Where(i => IsCategorySelected(string.IsNullOrWhiteSpace(i.Category) ? "UNASSIGNED" : i.Category.Trim().ToUpper()))
            .ToList();

        var sb = new System.Text.StringBuilder();

        ReceiptFormatter.AppendReceiptHeader(sb,
            title1: "GFC TERMINAL",
            title2: TerminalName,
            dateStr: $"Printed: {DateTime.Now:MM/dd/yyyy h:mm tt}",
            operatorName: $"By: {CurrentUserName}");

        ReceiptFormatter.AppendCenter(sb, "LIQUOR INVENTORY");
        ReceiptFormatter.AppendDivider(sb, '-');

        ReceiptFormatter.AppendLine(sb, "ITEM", "QTY");
        ReceiptFormatter.AppendDivider(sb, '-');

        void AppendSection(string title, List<GFC.Core.Models.LiquorItem> list)
        {
            if (!list.Any()) return;
            
            ReceiptFormatter.AppendSectionHeader(sb, $"{title} ({list.Count})");
            foreach (var item in list)
            {
                var size    = _printBottleSize && !string.IsNullOrEmpty(item.BottleSize) ? $" ({item.BottleSize})" : "";
                var lowWarn = item.CurrentStock <= item.MinStockLimit ? " !" : "";
                var itemName = $"{item.Name}{size}{lowWarn}";
                var qtyStr  = item.AllowLooseReconciliation && item.PackSize > 1
                    ? $"{(item.CurrentStock / item.PackSize)} cs, {(item.CurrentStock % item.PackSize)} loose"
                    : item.CurrentStock.ToString();
                ReceiptFormatter.AppendLine(sb, itemName, qtyStr, '.');
            }
        }

        var groups = active
            .GroupBy(i => string.IsNullOrWhiteSpace(i.Category) ? "UNASSIGNED" : i.Category.Trim().ToUpper())
            .OrderBy(g => g.Key)
            .ToList();

        foreach (var group in groups)
        {
            var groupItems = group.OrderBy(i => i.Name).ToList();
            AppendSection(group.Key, groupItems);
        }

        ReceiptFormatter.AppendDivider(sb, '-');
        ReceiptFormatter.AppendCenter(sb, $"Total Active Items: {active.Count}");
        ReceiptFormatter.AppendCenter(sb, "! = Low Stock");

        return sb.ToString();
    }

    private async Task PrintXReport()
    {
        try
        {
            // PERFORMANCE: Close menu immediately so the UI responds at once.
            showOptionsMenu = false;
            StateHasChanged();

            // Use the already-cached audit if available (debounce gate may have it fresh)
            // If not, we must scan — but we do it after the menu is gone.
            var currentAudit = _currentAudit.CashTotal == 0 && _currentAudit.GrossTotal == 0
                ? await PosService.GetShiftAuditAsync()
                : _currentAudit;
            
            // Calculate Token Credits directly from computed audit
            decimal tokenCredits = currentAudit.TokenCredits;
            
            var x = new PosZReportDto { 
                Id = Guid.NewGuid(), 
                Timestamp = DateTime.Now, 
                TerminalName = TerminalName, 
                BartenderName = CurrentUserName, 
                CashTotal = currentAudit.CashTotal, 
                TotalGrossSales = currentAudit.GrossTotal, 
                InventoryPullsJson = JsonSerializer.Serialize(new Dictionary<int, int>()),
                SalesSummaryJson = JsonSerializer.Serialize(currentAudit.ItemSummary),
                BanquetSummaryJson = JsonSerializer.Serialize(currentAudit.Banquets),
                TokenCredits = tokenCredits
            };
            
            if (!forceTrainingMode || allowHardwareInTraining)
            {
                await PrinterService.KickDrawerAsync();
