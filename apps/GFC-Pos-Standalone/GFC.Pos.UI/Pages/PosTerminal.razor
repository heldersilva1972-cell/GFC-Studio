                            <button class="option-tile-medium tile-zreport border" @onclick="ReprintLastZReport">
                                <div class="d-flex justify-content-between align-items-start w-100 mb-1.5">
                                    <div class="tile-icon-box shadow-sm">
                                        <i class="bi bi-printer-fill"></i>
                                    </div>
                                    <i class="bi bi-arrow-right-short fs-4 opacity-50"></i>
                                </div>
                                <div>
                                    <h5 class="fw-black mb-0.5" style="font-size: 0.88rem; letter-spacing: -0.3px;">REPRINT LAST Z-REPORT</h5>
                                    <div class="small opacity-80 fw-normal" style="font-size: 0.75rem; line-height: 1.3;">Reprint ONLY the last Z-Report (does not close shift or zero totals)</div>
                                </div>
                            </button>

                            <!-- STAFF: PRINT MY HOURS -->
                            <button class="option-tile-medium tile-hours border" @onclick="OpenPrintEmployeeHoursModal">
                                <div class="d-flex justify-content-between align-items-start w-100 mb-1.5">
                                    <div class="tile-icon-box shadow-sm" style="background: #0284c7; color: white;">
                                        <i class="bi bi-clock-history"></i>
                                    </div>
                                    <i class="bi bi-printer-fill fs-4 opacity-50"></i>
                                </div>
                                <div>
                                    <h5 class="fw-black mb-0.5" style="font-size: 0.88rem; letter-spacing: -0.3px;">PRINT MY HOURS</h5>
                                    <div class="small opacity-80 fw-normal" style="font-size: 0.75rem; line-height: 1.3;">Print worked hours for current or previous month</div>
