@* OFFLINE PRINT ZONE REMOVED (Now using C# Generator) *@

@code {
    private string CurrentUserName = string.Empty;
    private string TerminalName = "TERMINAL 1";
    private List<UserListItemDto> AuthorizedUsers = new();
    private int PendingSyncCount => PosService.TotalPendingCount;
    
    private List<ProductItem> DbItems = new();
    private List<string> Categories = new();
    private List<string> ModifierCategories = new();
    private List<PosModifierDto> Modifiers = new();
    private List<PosToken> DbTokens = new();
    private List<ActiveEvent> DbActiveEvents = new();
    private List<EventTemplate> DbEventTemplates = new();
    private PosMenuDto? _cachedMenu; // Keep full menu for local updates
    private ActiveEvent? _selectedActiveEvent = null;
    private bool _isTabPayment = false;
    
    private List<ProductItem> CartItems = new();
    private ProductItem? SelectedCartItem;
    private bool showModifiersOverlay = false;
    private List<ProductItem> ModifierItems = new();
    private decimal Subtotal => CartItems.Sum(x => (x.Price * x.Quantity) + (x.Modifiers?.Sum(m => m.Price * m.Quantity) ?? 0));

    private void SelectCartItem(ProductItem item)
    {
        SelectedCartItem = SelectedCartItem == item ? null : item;
        StateHasChanged();
    }

    private async Task OpenModifiersOverlay()
    {
        try {
            ModifierItems = Modifiers
                .Select(m => new ProductItem {
                    Id = m.ItemId,
                    Name = m.Name,
                    Price = m.Price,
                    Category = "MODIFIERS",
                    DisplayOrder = 0
                })
                .ToList();
        } catch {}
        
        if (CartItems.Count > 0 && SelectedCartItem == null) SelectedCartItem = CartItems.Last();
        showModifiersOverlay = true;
        StateHasChanged();
    }

    private void AddModifierToCart(ProductItem mod)
    {
        if (SelectedCartItem == null) return;
        
        var existingMod = SelectedCartItem.Modifiers.FirstOrDefault(m => m.Id == mod.Id);
        if (existingMod != null) existingMod.Quantity++;
        else SelectedCartItem.Modifiers.Add(new ProductItem { Id = mod.Id, Name = mod.Name, Price = mod.Price, Quantity = 1 });
        
        showModifiersOverlay = false; // Close window automatically after adding
        StateHasChanged();
    }

    private void RemoveModifier(ProductItem parent, ProductItem mod)
    {
        if (mod.Quantity > 1) mod.Quantity--;
        else parent.Modifiers.Remove(mod);
        StateHasChanged();
    }
    
    private string ActiveCategory = "BEER";

    private IEnumerable<string> DisplayCategories
    {
        get
        {
            if (_selectedActiveEvent != null)
            {
                var template = DbEventTemplates?.FirstOrDefault(t => t.Id == _selectedActiveEvent.TemplateId);
                if (template != null && !string.IsNullOrEmpty(template.ItemsOverrideJson))
                {
                    try
                    {
                        var overrides = System.Text.Json.JsonSerializer.Deserialize<List<BanquetOverrideDto>>(template.ItemsOverrideJson, new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true }) ?? new();
                        var visibleItemIds = overrides.Where(o => o.IsVisible).Select(o => o.ItemId).ToList();
                        
                        if (!visibleItemIds.Any())
                        {
                            return Categories;
                        }
                        
                        var banquetCategories = DbItems
                            .Where(i => visibleItemIds.Contains(i.Id))
                            .Select(i => (i.Category ?? "MISC").Trim().ToUpper())
                            .Distinct()
                            .ToList();

                        return Categories.Where(c => banquetCategories.Contains(c.Trim().ToUpper())).ToList();
                    }
                    catch
                    {
                        return Categories;
                    }
                }
                else
                {
                    // No custom menu defined — show all standard categories
                    return Categories;
                }
            }

            return Categories;
        }
    }

    private async Task SetOrderMode(ActiveEvent? ev)
    {
        // Always refresh templates first so prices are guaranteed current
        await RefreshData();

        _selectedActiveEvent = ev;
        if (ev != null)
        {
            var template = DbEventTemplates?.FirstOrDefault(t => t.Id == ev.TemplateId);
            if (template != null && !string.IsNullOrEmpty(template.ItemsOverrideJson))
            {
                try
                {
                    var overrides = System.Text.Json.JsonSerializer.Deserialize<List<BanquetOverrideDto>>(template.ItemsOverrideJson, new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true }) ?? new();
                    var visibleItemIds = overrides.Where(o => o.IsVisible).Select(o => o.ItemId).ToList();
                    if (visibleItemIds.Any())
                    {
                        var visibleCategories = DbItems.Where(i => visibleItemIds.Contains(i.Id)).Select(i => (i.Category ?? "MISC").Trim().ToUpper()).Distinct().ToList();

                        if (!visibleCategories.Contains(ActiveCategory.Trim().ToUpper()))
                        {
                            var firstCat = visibleCategories.FirstOrDefault();
                            if (firstCat != null) ActiveCategory = firstCat;
                        }
                    }
                }
                catch {}
            }
        }
        else
        {
            ActiveCategory = "BEER";
        }
        StateHasChanged();
    }
    private bool forceTrainingMode = false;
    private bool allowHardwareInTraining = false;
