    // PERFORMANCE: Track when expensive HTTP calls were last run in the poll loop.
    private DateTime _lastUserSync = DateTime.MinValue;
    private DateTime _lastUpdateCheck = DateTime.MinValue;

    private async Task StartAuthPolling()
    {
        while (!_disposed)
        {
            await Task.Delay(TimeSpan.FromSeconds(10));
            if (_disposed) break;

            // 1. CHEAP: Idle Timeout Check (local timestamp only)
            if (_idleTimeoutMinutes > 0 && !string.IsNullOrEmpty(CurrentUserName))
            {
                if ((DateTime.Now - _lastActivity).TotalMinutes >= _idleTimeoutMinutes)
                {
                    Console.WriteLine($"[POS] IDLE TIMEOUT: No activity for {_idleTimeoutMinutes}m. Locking station.");
                    LockTerminal();
                    await InvokeAsync(RequestRender);
                }
            }

            // 2. CHEAP: Security check — local list lookup only, no HTTP
            if (!string.IsNullOrEmpty(CurrentUserName))
            {
                var isStillAuth = AuthorizedUsers.Any(u => u.Username.Equals(CurrentUserName, StringComparison.OrdinalIgnoreCase));
                if (!isStillAuth)
                {
                    Console.WriteLine($"[POS] SECURITY: {CurrentUserName} is no longer authorized. Forcing terminal lock.");
                    LockTerminal();
                    await InvokeAsync(RequestRender);
                }
            }

            // 3. CHEAP: 3AM Daily Reset Check (local timestamp only)
            CheckDailyReset();

            // 4. EXPENSIVE: Sync users from server — only every 5 minutes
            if ((DateTime.Now - _lastUserSync).TotalMinutes >= 5)
            {
                _lastUserSync = DateTime.Now;
                await SyncUsers();
            }

            // 5. EXPENSIVE: Check for POS update — only every 5 minutes
            if ((DateTime.Now - _lastUpdateCheck).TotalMinutes >= 5)
            {
                _lastUpdateCheck = DateTime.Now;
                await CheckForUpdatesAsync();
            }
        }
    }

    private async Task CheckForUpdatesAsync()
    {
        if (_isDownloadingUpdate) return;
        try
        {
            var isUpdateAvailable = await UpdateService.CheckForUpdatesAsync();
            _serverVersionFound = UpdateService.ServerVersion;
            
            if (isUpdateAvailable)
            {
                // [LOOP-PROTECTION] Verify if we just tried to update to this specific version
                var lastAttemptVersion = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "gfc_last_update_version");
                var activeServerVersion = !string.IsNullOrEmpty(_serverVersionFound) ? _serverVersionFound : UpdateService.ServerVersion;
                
                if (lastAttemptVersion == activeServerVersion || 
                    (!string.IsNullOrEmpty(lastAttemptVersion) && !string.IsNullOrEmpty(activeServerVersion) && 
                     (lastAttemptVersion.Contains(activeServerVersion) || activeServerVersion.Contains(lastAttemptVersion))))
                {
                    // We already tried to update to this exact version! Since we are still running,
                    // the server files are not yet fully compiled/published or browser cache is persistent.
                    // DO NOT automatically reload again to prevent an infinite reload loop.
                    Console.WriteLine($"[GFC POS UPDATE] Suppressing auto-reload loop. Already tried updating to {activeServerVersion} but client is still running {VersionService.GetRevision()}.");
                    if (!_showUpdateBanner)
                    {
                        _showUpdateBanner = true;
                        await InvokeAsync(StateHasChanged);
                    }
                    return;
                }

                if (!_showUpdateBanner)
                {
                    // Show update banner/pill instead of executing background reload.
                    // This satisfies the requirement that updates only happen after logging out or when manual button is pressed.
                    Console.WriteLine($"[GFC POS UPDATE] New version detected ({activeServerVersion}). Showing update pill.");
                    _showUpdateBanner = true;
                    await InvokeAsync(StateHasChanged);
                }
            }
        }
        catch { }
    }

