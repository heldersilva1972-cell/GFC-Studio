            <div class="pos-options-header">
                <div>
                    <h2 class="fw-black mb-0 text-dark" style="letter-spacing: -1px; font-size: 1.5rem;">POS OPTIONS</h2>
                    <div class="text-muted small fw-bold mt-1">Select an administrative task or tool below</div>
                </div>
                <button class="btn btn-outline-secondary rounded-pill fw-bold px-4 py-2 d-flex align-items-center gap-2" @onclick="() => showOptionsMenu = false">
                    <i class="bi bi-x-lg"></i> CLOSE
                </button>
            </div>

            <!-- Scrollable tile grid body -->
            <div class="pos-options-body">
                <div class="options-sections-container">
                    
                    <!-- COLUMN 1: CASH & SHIFT CONTROLS -->
