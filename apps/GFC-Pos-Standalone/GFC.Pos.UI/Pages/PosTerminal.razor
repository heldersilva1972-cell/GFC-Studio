    private void ConvertCartItemToToken(ProductItem item)
    {
        if (item == null || item.IsTokenApplied || item.Name.Contains("(TOKEN SALE)")) return;

        PosToken? matchedToken = null;
        if (item.Category == "BEER")
        {
            matchedToken = DbTokens.FirstOrDefault(t => t.IsActive && t.AllowCreditUpgrade != true && t.Name.ToUpper().Contains("BEER"));
        }
        else if (item.Category == "LIQUOR" || item.Category == "WINE")
        {
            matchedToken = DbTokens.FirstOrDefault(t => t.IsActive && t.AllowCreditUpgrade != true && (t.Name.ToUpper().Contains("MIXED") || t.Name.ToUpper().Contains("DRINK")));
        }

        if (matchedToken == null)
        {
            Toast.ShowWarning("No matching standard token found for this category.");
            return;
        }

        var tokenName = $"{matchedToken.Name} ({item.Name}) (TOKEN SALE)";
        var tokenId   = -matchedToken.Id;

        if (item.Quantity > 1)
        {
            // Split: leave the remaining units as-is, add one new token sale line
            item.Quantity--;
            CartItems.Add(new ProductItem
            {
                Id       = tokenId,
                Name     = tokenName,
                Price    = item.Price,
                Category = "TOKENS",
                Quantity = 1
            });
        }
        else
        {
            // Only one unit — convert it in place
            item.Id       = tokenId;
            item.Name     = tokenName;
            item.Category = "TOKENS";
        }

        StateHasChanged();
    }

    private void AddTokenToCart(PosToken token)
    {
        DismissChangeDueBanner();
        int tokenId = -token.Id;
        var price = isDartsModeActive ? 0 : token.SalePrice;
        var name = isDartsModeActive ? $"{token.Name} (TOKEN SALE) (DARTS)" : $"{token.Name} (TOKEN SALE)";
        var existing = CartItems.FirstOrDefault(x => x.Id == tokenId && x.Price == price);
        if (existing != null) existing.Quantity++;
        else CartItems.Add(new ProductItem { Id = tokenId, Name = name, Price = price, Category = "TOKENS", Quantity = 1 });
        
        StateHasChanged();
        
        // SPEED OPTIMIZATION: Don't await JS scroll
        _ = JSRuntime.InvokeVoidAsync("window.gfcScrollToBottom", "cartItemsList");
    }

    private Dictionary<int, decimal> _tokenBlendedAverages = new();

    private async Task OpenRedeemOverlay()
    {
        if (_dynamicTokenMode)
        {
            _tokenBlendedAverages.Clear();
            var audit = await PosService.GetShiftAuditAsync(); // Fetch once from local storage/db
            foreach (var token in DbTokens)
            {
                _tokenBlendedAverages[token.Id] = GetBlendedAverageValue(token, audit); // Process in-memory (blazing fast)
            }
        }
        showRedeemOverlay = true;
        StateHasChanged();
    }

    private decimal GetBlendedAverageValue(PosToken token, ShiftAuditDto audit)
    {
        try
        {
            int soldCount = 0;
            decimal totalSoldAmount = 0;
            
            foreach (var kvp in audit.ItemSummary)
            {
                var itemName = kvp.Key;
                var qty = kvp.Value;
                
                if (itemName.ToUpper().Contains(token.Name.ToUpper()) && itemName.ToUpper().Contains("TOKEN SALE"))
                {
                    soldCount += qty;
                    if (audit.ItemTotals.TryGetValue(itemName, out var totalRevenue))
                    {
                        totalSoldAmount += totalRevenue;
                    }
                }
            }

            int redeemedCount = 0;
            foreach (var kvp in audit.ItemSummary)
            {
                var itemName = kvp.Key;
                var qty = kvp.Value;
                
                if (itemName.ToUpper().Contains(token.Name.ToUpper()) && 
                    (itemName.ToUpper().Contains("TOKEN CREDIT") || itemName.ToUpper().Contains("TOKEN REDEEMED") || itemName.ToUpper().Contains(" (CREDITED)")))
                {
                    redeemedCount += qty;
                }
            }

            int outstandingCount = soldCount - redeemedCount;

            if (outstandingCount <= 0 || soldCount <= 0)
            {
                return token.Name.ToUpper().Contains("BEER") ? _legacyBeerTokenValue : _legacyMixedTokenValue;
            }

            return totalSoldAmount / soldCount;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[POS] Error calculating blended average: {ex.Message}");
            return token.Name.ToUpper().Contains("BEER") ? _legacyBeerTokenValue : _legacyMixedTokenValue;
        }
    }

    private void ApplyTokenRedemption(PosToken token, bool forceUpgrade)
    {
        // 1. If Upgrade is explicitly selected, switch to selection view
        if (forceUpgrade && token.AllowCreditUpgrade.GetValueOrDefault())
        {
            _pendingTokenForCredit = token;
            StateHasChanged();
            return;
        }

        // 2. Standard Logic: Try for EXACT matches first (Zero-Out / Credit-Line)
        var eligibleIds = string.IsNullOrEmpty(token.EligibleItemIds) 
            ? new List<int>() 
            : token.EligibleItemIds.Split(',', StringSplitOptions.RemoveEmptyEntries)
                .Select(id => int.TryParse(id, out int val) ? val : (int?)null)
                .Where(id => id.HasValue)
                .Select(id => id!.Value)
                .ToList();
        
        var itemToZero = CartItems.FirstOrDefault(i => !i.IsTokenApplied && eligibleIds.Contains(i.Id) && i.Price > 0);
        
        if (itemToZero != null) 
        {
            _pendingTokenForCredit = token;
            ApplyTokenCreditToItem(itemToZero);
        } 
        else if (token.AllowCreditUpgrade.GetValueOrDefault() || _dynamicTokenMode)
        {
            // Fallback: If no exact match but upgrade/dynamic is possible, show the selection overlay
            _pendingTokenForCredit = token;
            StateHasChanged();
        }
        else 
        { 
            ShowNotice("Missing Item", $"No qualifying item found in cart for {token.Name}.", "warning"); 
        }
    }

    private void ApplyTokenCreditToItem(ProductItem item)
    {
        if (_pendingTokenForCredit == null || item.IsTokenApplied) return;

        decimal creditValue = (_dynamicTokenMode && !_pendingTokenForCredit.AllowCreditUpgrade.GetValueOrDefault())
            ? (_tokenBlendedAverages.TryGetValue(_pendingTokenForCredit.Id, out var val) ? val : (_pendingTokenForCredit.Name.ToUpper().Contains("BEER") ? _legacyBeerTokenValue : _legacyMixedTokenValue))
            : (_pendingTokenForCredit.CreditValue ?? _pendingTokenForCredit.SalePrice);
        
        decimal threshold = _pendingTokenForCredit.Name.ToUpper().Contains("BEER") ? _legacyBeerTokenValue : _legacyMixedTokenValue;
        if (!_dynamicTokenMode) threshold = creditValue;

        if (item.Price <= threshold)
        {
            // Fully covered: price becomes 0, no negative credit line clutter
            string cleanName = item.Name.Replace(" (CREDITED)", "");
            string newName = _dynamicTokenMode
                ? $"{cleanName} ({_pendingTokenForCredit.Name.Replace(" TOKEN", "").Replace(" Token", "")}) (TOKEN REDEEMED)"
                : $"{cleanName} (TOKEN REDEEMED)";

            if (item.Quantity > 1) 
            { 
                item.Quantity--; 
                CartItems.Add(new ProductItem 
                { 
                    Id = item.Id, 
                    Name = newName, 
                    Price = 0, 
                    Category = item.Category, 
                    Quantity = 1, 
                    IsTokenApplied = true, 
                    AppliedTokenId = _pendingTokenForCredit.Id 
                }); 
            }
            else 
            { 
                item.Name = newName; 
                item.Price = 0; 
                item.IsTokenApplied = true;
                item.AppliedTokenId = _pendingTokenForCredit.Id;
            }
        }
        else
        {
            // Premium Upgrade: Keep the negative credit line to charge the remaining upgrade fee
            ProductItem creditedUnit;
            if (item.Quantity > 1)
            {
                // Split the item if quantity > 1 so only one unit is credited
                item.Quantity--;
                creditedUnit = new ProductItem 
                { 
                    Id = item.Id, 
                    Name = $"{item.Name} (CREDITED)", 
                    Price = item.Price, 
                    Category = item.Category, 
                    Quantity = 1, 
                    IsTokenApplied = true,
                    AppliedTokenId = _pendingTokenForCredit.Id
                };
                CartItems.Add(creditedUnit);
            }
            else
            {
                item.Name = $"{item.Name} (CREDITED)";
                item.IsTokenApplied = true;
                item.AppliedTokenId = _pendingTokenForCredit.Id;
                creditedUnit = item;
            }

            // Add the negative credit line
            var creditItem = new ProductItem
            {
                Id = -_pendingTokenForCredit.Id, // Negative ID to distinguish
                Name = $"> {_pendingTokenForCredit.Name.ToUpper()} TOKEN CREDIT FOR {creditedUnit.Name.Replace(" (CREDITED)", "").ToUpper()}",
                Price = -creditValue,
                Quantity = 1,
                Category = "TOKEN_CREDIT",
                IsTokenApplied = true, // Credit line itself is protected
                AssociatedCartItemId = creditedUnit.CartItemId
            };
            CartItems.Add(creditItem);
        }

        // Cleanup
        _pendingTokenForCredit = null;
        showRedeemOverlay = false;
        showTokenCreditSelection = false;
        StateHasChanged();
    }

    private void RemoveItem(ProductItem item)
    {
        if (item.Quantity > 1)
        {
            item.Quantity--;
        }
        else
        {
            // Case 1: The item is a negative credit line itself (TOKEN_CREDIT)
            if (item.Category == "TOKEN_CREDIT")
            {
                var upgradedItem = CartItems.FirstOrDefault(x => x.CartItemId == item.AssociatedCartItemId);
                CartItems.Remove(item);
                
                if (upgradedItem != null)
                {
                    upgradedItem.Name = upgradedItem.Name.Replace(" (CREDITED)", "");
                    upgradedItem.IsTokenApplied = false;
                    upgradedItem.AppliedTokenId = null;
                }
                
                Toast.ShowWarning("Token credit removed from cart.");
            }
            // Case 2: The item had a token applied to it
            else if (item.AppliedTokenId.HasValue)
            {
                var token = DbTokens.FirstOrDefault(t => t.Id == item.AppliedTokenId.Value);
                var associatedCreditItem = CartItems.FirstOrDefault(x => x.Category == "TOKEN_CREDIT" && x.AssociatedCartItemId == item.CartItemId);
                
                CartItems.Remove(item);
                if (associatedCreditItem != null)
                {
                    CartItems.Remove(associatedCreditItem);
                }
                
                if (token != null && token.AllowCreditUpgrade.GetValueOrDefault())
                {
                    _pendingTokenForCredit = token;
                    var hasEligibleItems = CreditEligibleItems.Any();
                    
                    if (hasEligibleItems)
                    {
                        showRedeemOverlay = true;
                        Toast.ShowInfo($"Upgrade token '{token.Name}' can be applied to another item in the cart.");
                    }
                    else
                    {
                        _pendingTokenForCredit = null;
                        Toast.ShowWarning($"Upgrade token '{token.Name}' credit was removed because no eligible item is in the cart.");
                    }
                }
            }
            // Case 3: Normal item removal
            else
            {
                CartItems.Remove(item);
            }
        }
        StateHasChanged();
    }
    private void ClearCart() { CartItems.Clear(); isDartsModeActive = false; UpdateSpeedBar(); }
    private void Checkout()
    {
        if (CartItems.Count == 0 && !_isCorrectionMode) return;
        
        CashInputString = "";
        CashReceived = null;
        
        if (Subtotal == 0)
        {
            _ = FinalizeSale();
            return;
        }
        
        if (_isCorrectionMode)
        {
            // If the original transaction was made towards an event (prepaid or running tab),
            // no cash was originally collected from the customer. Therefore, we bypass
            // the cash reconciliation question and go straight to the checkout overlay.
            if (_lastSale != null && (_lastSale.PaymentType == "TAB" || _lastSale.ActiveEventId != null || _lastSale.TotalAmount == 0 || (_lastSale.ItemsJson != null && (_lastSale.ItemsJson.Contains("(DARTS)") || _lastSale.ItemsJson.Contains("(TOKEN SALE) (DARTS)")))))
            {
                _isMoneyCollected = false;
                _showMoneyCollectedQuestion = false;
                ShowCheckoutOverlay = true;
            }
            else
            {
                _showMoneyCollectedQuestion = true;
            }
        }
        else
        {
            ShowCheckoutOverlay = true;
        }
    }
    
