        isSyncing = false;
        await InvokeAsync(StateHasChanged);
    }

    private int _brandTapCount = 0;
    private int _shieldTapCount = 0;
    private bool _showEmergencyLogin = false;
    private bool _emergencyAuthSuccess = false;
    private string _emergencyPinInput = "";

    // Forgot Card fallback login state
    private bool _showForgotCard = false;
    private bool _forgotCardLocked = false;
    private string _forgotCardInput = "";
    private string _forgotCardError = "";

    private void HandleShieldTap()
    {
        _shieldTapCount++;
        if (_shieldTapCount >= 5)
        {
            _shieldTapCount = 0;
            _emergencyPinInput = "";
            _emergencyAuthSuccess = false;
            _showEmergencyLogin = true;
        }
    }

    private void HandleEmergencyPin(string key)
    {
        if (key == "C") _emergencyPinInput = "";
        else if (key == "DEL") { if (_emergencyPinInput.Length > 0) _emergencyPinInput = _emergencyPinInput.Substring(0, _emergencyPinInput.Length - 1); }
        else if (_emergencyPinInput.Length < 4)
        {
            _emergencyPinInput += key;
            if (_emergencyPinInput == "1972") // EMERGENCY CODE
            {
                _emergencyAuthSuccess = true;
                _emergencyPinInput = "";
            }
        }
    }

    private void OpenForgotCard()
    {
        _forgotCardInput = "";
        _forgotCardError = "";
        _forgotCardLocked = false;
        _showForgotCard = true;
    }

    private async Task HandleForgotCardKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await ForgotCardLogin();
    }

    private async Task ForgotCardLogin()
    {
        _forgotCardError = "";
        var typed = (_forgotCardInput ?? "").Trim();
        if (string.IsNullOrEmpty(typed)) return;

        // Validate against cached AuthorizedUsers (works offline)
        var user = AuthorizedUsers.FirstOrDefault(u => u.Username.Equals(typed, StringComparison.OrdinalIgnoreCase));
        if (user == null)
        {
            _forgotCardError = "Username not recognised. Please check spelling and try again.";
            StateHasChanged();
            return;
        }

        // Read grace counter from localStorage
        var graceKey = $"gfc_grace_{user.Username.ToLower().Replace(" ", "_")}";
        var stored = await JSRuntime.InvokeAsync<string>("localStorage.getItem", graceKey);
        int remaining = 2;
        if (!string.IsNullOrEmpty(stored) && int.TryParse(stored, out var parsed))
            remaining = parsed;

        if (remaining <= 0)
        {
            _forgotCardLocked = true;
            StateHasChanged();
            return;
        }

        // Decrement and persist
        remaining--;
        await JSRuntime.InvokeVoidAsync("localStorage.setItem", graceKey, remaining.ToString());
        Console.WriteLine($"[POS] FORGOT-CARD LOGIN: {user.Username} — {remaining} grace login(s) remaining.");

        _showForgotCard = false;

        // Show login splash and set operator
        _splashUserName = user.Username;
        _showLoginSplash = true;
        StateHasChanged();

        CurrentUserName = user.Username;
        _lastActivity = DateTime.Now;
        await LoadUserDisplayProfile(user.Username);

        await Task.Delay(1500);
        _showLoginSplash = false;
        StateHasChanged();

        if (remaining == 0)
            Toast.ShowWarning($"Manual login locked. Please bring your card — scanning it will restore access, {user.Username}.");
        else
            Toast.ShowInfo($"Logged in without card. {remaining} grace login{(remaining == 1 ? "" : "s")} remaining.");
    }

