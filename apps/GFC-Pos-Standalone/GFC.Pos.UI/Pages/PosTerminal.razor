                            <button class="option-tile-medium tile-xreport border" @onclick="PrintXReport">
                                <div class="d-flex justify-content-between align-items-start w-100 mb-1.5">
                                    <div class="tile-icon-box shadow-sm">
                                        <i class="bi bi-file-earmark-bar-graph-fill"></i>
                                    </div>
                                    <i class="bi bi-arrow-right-short fs-4 opacity-50"></i>
                                </div>
                                <div>
                                    <h5 class="fw-black mb-0.5" style="font-size: 0.88rem; letter-spacing: -0.3px;">PRINT X-REPORT</h5>
                                    <div class="small opacity-80 fw-normal" style="font-size: 0.75rem; line-height: 1.3;">Print mid-day shift totals (No closeout)</div>
                                </div>
                            </button>

