    private void AddModifierToCart(ProductItem mod)
    {
        if (SelectedCartItem == null) return;
        
        var existingMod = SelectedCartItem.Modifiers.FirstOrDefault(m => m.Id == mod.Id);
        if (existingMod != null) existingMod.Quantity++;
        else SelectedCartItem.Modifiers.Add(new ProductItem { Id = mod.Id, Name = mod.Name, Price = mod.Price, Quantity = 1 });
        
        showModifiersOverlay = false; // Close window automatically after adding
        StateHasChanged();
    }

    private void RemoveModifier(ProductItem parent, ProductItem mod)
    {
        if (mod.Quantity > 1) mod.Quantity--;
        else parent.Modifiers.Remove(mod);
        StateHasChanged();
    }
    
