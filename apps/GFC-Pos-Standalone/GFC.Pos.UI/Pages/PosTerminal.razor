                            <div class="col-4">
                                <button class="btn btn-danger w-100 fs-3 fw-bold rounded-4 p-2.5 shadow-sm border" @onclick='() => PizzaKeypadPress("DEL")'><i class="bi bi-backspace"></i></button>
                            </div>
