    private async Task ReprintLastEventReceipt()
    {
        // 1. Try to load the last printed event HTML from localStorage (so it can be printed even after being closed!)
        try
        {
            var storedHtml = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "gfc_last_printed_event_html");
            if (!string.IsNullOrEmpty(storedHtml))
            {
                showOptionsMenu = false;
                var printHtml = storedHtml;
                if (!printHtml.Contains("*** REPRINT ***"))
                {
                    printHtml = printHtml.Replace("GFC EVENT RECEIPT", "******************************************\n***            *** REPRINT ***         ***\n******************************************\n\nGFC EVENT RECEIPT");
                }
                await PrintReceiptAsync(printHtml);
                Toast.ShowSuccess("Reprinting last event receipt...");
                return;
            }
        }
        catch {}

        ActiveEvent? eventToPrint = null;

        // 2. Fallback: Try to load the last printed event object from localStorage (so it can be printed even after being closed!)
        try
        {
            var storedJson = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "gfc_last_printed_event_data");
            if (!string.IsNullOrEmpty(storedJson))
            {
                eventToPrint = JsonSerializer.Deserialize<ActiveEvent>(storedJson);
            }
        }
        catch {}

        // 3. Fallback: If not found, look up by ID or use the most recently created active event
        if (eventToPrint == null)
        {
            try
            {
                var storedIdStr = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "gfc_last_printed_event_id");
                if (!string.IsNullOrEmpty(storedIdStr) && int.TryParse(storedIdStr, out var storedId) && DbActiveEvents != null)
                {
                    eventToPrint = DbActiveEvents.FirstOrDefault(e => e.Id == storedId);
                }
            }
            catch {}
        }

        if (eventToPrint == null && DbActiveEvents != null && DbActiveEvents.Any())
        {
            eventToPrint = DbActiveEvents.OrderByDescending(e => e.CreatedAt).FirstOrDefault();
        }

        if (eventToPrint != null)
        {
            showOptionsMenu = false;
            await PrintBanquetMasterSummary(eventToPrint, isReprint: true);
            Toast.ShowSuccess($"Reprinting receipt for event '{eventToPrint.Name}'...");
        }
        else
        {
            Toast.ShowError("No event found to reprint.");
        }
    }

    private bool IsCategorySelected(string cat)
    {
        if (_selectedLiquorCategories == null || !_selectedLiquorCategories.Any()) return true;
        return _selectedLiquorCategories.Contains(cat.Trim().ToUpper());
    }

    private async Task ToggleLiquorCategory(string cat, object? checkedValue)
    {
        bool isChecked = checkedValue is bool b && b;
        if (_selectedLiquorCategories == null) _selectedLiquorCategories = new();
        
        var normalizedCat = cat.Trim().ToUpper();
        
        if (!_selectedLiquorCategories.Any() && _allLiquorCategories != null)
        {
            _selectedLiquorCategories.AddRange(_allLiquorCategories);
        }

        if (isChecked)
        {
            if (!_selectedLiquorCategories.Contains(normalizedCat))
            {
                _selectedLiquorCategories.Add(normalizedCat);
            }
        }
        else
        {
            _selectedLiquorCategories.Remove(normalizedCat);
        }

        await JSRuntime.InvokeVoidAsync("localStorage.setItem", "gfc_pos_liquor_inventory_categories", JsonSerializer.Serialize(_selectedLiquorCategories));
        StateHasChanged();
    }

