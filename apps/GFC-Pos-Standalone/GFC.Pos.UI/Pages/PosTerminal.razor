@if (inlineTallyEvent != null)

{
    <div class="shift-overlay" style="z-index: 999999;">
        <div class="settings-card shadow-lg" style="max-width: 1120px !important; width: 98% !important; background: #ffffff; border-radius: 24px; padding: 1.5rem 2rem; border: 1px solid #e2e8f0;">

            


            @if (inlineTallyMode == "settle")
            {
                var allDonatedStock = GetAllDonatedStockForEvent(inlineTallyEvent);
                var donatedPoolStock = allDonatedStock.Where(ds => {
                    var tallyItem = currentTallies.FirstOrDefault(t => t.ItemId == ds.ItemId);
                    int totalConsumedTally = tallyItem != null ? tallyItem.Consumed : 0;
                    return (ds.TotalCans - totalConsumedTally) > 0;
                }).ToList();
                
                // Financial Calculation Accounting for 100% Donated Proceeds
                decimal totalConsumed = 0m;
                decimal clubPortion = 0m;
                decimal eventPortion = 0m;
                bool hasSplit = currentTallies.Any(t => t.EnableClubSplit && t.QuantityTaken > 0);

                foreach (var t in currentTallies)
                {
                    if (t.Consumed <= 0) continue;

                    decimal itemTotal = t.Subtotal;
                    totalConsumed += itemTotal;

                    var ds = allDonatedStock.FirstOrDefault(d => d.ItemId == t.ItemId);
                    int totalDonatedBottles = ds != null ? ds.TotalCans : 0;

                    int donatedUsed = Math.Min(t.Consumed, totalDonatedBottles);
                    int standardUsed = Math.Max(0, t.Consumed - totalDonatedBottles);

                    // Donated bottles: 100% proceeds go to Event, 0 to Club
                    decimal donatedEventSubtotal = donatedUsed * t.Price;

                    // Standard bottles: Split between Club and Event according to EnableClubSplit
                    decimal standardClubSubtotal = standardUsed * (t.EnableClubSplit ? t.ClubSplitAmount : t.Price);
                    decimal standardEventSubtotal = standardUsed * (t.EnableClubSplit ? Math.Max(0, t.Price - t.ClubSplitAmount) : 0m);

                    clubPortion += standardClubSubtotal;
                    eventPortion += (donatedEventSubtotal + standardEventSubtotal);
                }

                decimal expectedInDrawer = clubPortion;
                decimal netOwed = expectedInDrawer - (inlineTallyEvent?.InitialAmount ?? 0m);

