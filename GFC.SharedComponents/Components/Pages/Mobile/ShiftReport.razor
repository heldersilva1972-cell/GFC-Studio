    // Shift Delta Tracking (for cumulative machine reports)
    private decimal _prevDaySales { get; set; } = 0;
    private decimal _prevDayCashes { get; set; } = 0;
    private decimal _prevDayTickets { get; set; } = 0;
    private decimal _prevDayNetDue { get; set; } = 0; 
    private decimal _prevDayBag { get; set; } = 0;

    // Math Logic
    private decimal LottoDrawerValue {
        get {
            decimal salesActivity = (ShiftType == "Night" && (LottoSales == null || LottoSales == 0)) ? 0 : (LottoSales ?? 0) - (ShiftType == "Night" ? _prevDaySales : 0);
            decimal cashesActivity = (ShiftType == "Night" && (LottoCashes == null || LottoCashes == 0)) ? 0 : (LottoCashes ?? 0) - (ShiftType == "Night" ? _prevDayCashes : 0);
            decimal ticketsActivity = (ShiftType == "Night" && (LottoInstantTickets == null || LottoInstantTickets == 0)) ? 0 : (LottoInstantTickets ?? 0) - (ShiftType == "Night" ? _prevDayTickets : 0);
            return (LottoOpeningCash ?? 0) + salesActivity - cashesActivity - ticketsActivity + (LottoBackupBag ?? 0) - LottoBagRefill;
        }
    }

    private decimal LottoNetMade {
        get {
            decimal salesActivity = (ShiftType == "Night" && (LottoSales == null || LottoSales == 0)) ? 0 : (LottoSales ?? 0) - (ShiftType == "Night" ? _prevDaySales : 0);
            decimal cashesActivity = (ShiftType == "Night" && (LottoCashes == null || LottoCashes == 0)) ? 0 : (LottoCashes ?? 0) - (ShiftType == "Night" ? _prevDayCashes : 0);
            decimal ticketsActivity = (ShiftType == "Night" && (LottoInstantTickets == null || LottoInstantTickets == 0)) ? 0 : (LottoInstantTickets ?? 0) - (ShiftType == "Night" ? _prevDayTickets : 0);
            return salesActivity - cashesActivity - ticketsActivity;
        }
    }

    private decimal LottoSalesActivity => (ShiftType == "Night" ? (LottoSales ?? 0) - _prevDaySales : (LottoSales ?? 0));
    private decimal LottoDiscrepancy => (LottoCashCounted ?? 0) - LottoDrawerValue;
    
    // NIGHT SHIFT RECONCILIATION MATH
    private decimal LottoTotalDrop => Math.Max(0, (LottoCashCounted ?? 0) - 1200);
    private decimal TotalBagIOU => _totalBagDebt + (ShiftType == "Night" ? (LottoBackupBag ?? 0) : 0);
    private decimal LottoBagRefill => (ShiftType == "Day") ? 0 : Math.Min(LottoTotalDrop, TotalBagIOU);

    private decimal LottoEnvelopeAmount {
        get {
            if (ShiftType == "Day") return 0; 
            return LottoTotalDrop - LottoBagRefill;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try 
            {
                var savedPreference = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "GFC_GuidedMode_Preference");
                if (savedPreference != null && bool.TryParse(savedPreference, out bool pref))
                {
                    _isGuidedMode = pref;
                    StateHasChanged();
                }
            }
            catch { /* Device interop silent fail */ }

            _ = CheckForLocalDraft();
        }
    }

    private async Task CheckForLocalDraft() {
        if (string.IsNullOrEmpty(ShiftType)) return;
        try {
            var key = $"gfc_shift_draft_{ReportDate:yyyyMMdd}_{ShiftType}";
            var json = await JSRuntime.InvokeAsync<string>("localStorage.getItem", key);
            if (!string.IsNullOrEmpty(json)) {
                using var doc = global::System.Text.Json.JsonDocument.Parse(json);
                var root = doc.RootElement;
                if (root.TryGetProperty("Timestamp", out var tsProp)) {
                    var ts = tsProp.GetDateTime();
                    if ((DateTime.UtcNow - ts).TotalHours < 4) { 
                        _localDraft = json; 
                        _showRecoveryModal = true;
                        StateHasChanged();
                    }
                }
            }
        } catch { }
    }

    private async Task RestoreFromLocal() {
        if (string.IsNullOrEmpty(_localDraft)) return;
        try {
            using var doc = global::System.Text.Json.JsonDocument.Parse(_localDraft);
            var root = doc.RootElement;
            if (root.TryGetProperty("BarSales", out global::System.Text.Json.JsonElement bar)) BarSales = bar.ValueKind == global::System.Text.Json.JsonValueKind.Null ? null : bar.GetDecimal();
            if (root.TryGetProperty("LottoSales", out global::System.Text.Json.JsonElement ls)) LottoSales = ls.ValueKind == global::System.Text.Json.JsonValueKind.Null ? null : ls.GetDecimal();
            if (root.TryGetProperty("LottoCashes", out global::System.Text.Json.JsonElement lc)) LottoCashes = lc.ValueKind == global::System.Text.Json.JsonValueKind.Null ? null : lc.GetDecimal();
            if (root.TryGetProperty("LottoInstantTickets", out global::System.Text.Json.JsonElement lit)) LottoInstantTickets = lit.ValueKind == global::System.Text.Json.JsonValueKind.Null ? null : lit.GetDecimal();
            if (root.TryGetProperty("LottoNetDue", out global::System.Text.Json.JsonElement lnd)) LottoNetDue = lnd.ValueKind == global::System.Text.Json.JsonValueKind.Null ? null : lnd.GetDecimal();
            if (root.TryGetProperty("LottoOpeningCash", out global::System.Text.Json.JsonElement loc)) LottoOpeningCash = loc.ValueKind == global::System.Text.Json.JsonValueKind.Null ? null : loc.GetDecimal();
            if (root.TryGetProperty("LottoBackupBag", out global::System.Text.Json.JsonElement lbb)) LottoBackupBag = lbb.ValueKind == global::System.Text.Json.JsonValueKind.Null ? null : lbb.GetDecimal();
            if (root.TryGetProperty("LottoCashCounted", out global::System.Text.Json.JsonElement lcc)) LottoCashCounted = lcc.ValueKind == global::System.Text.Json.JsonValueKind.Null ? null : lcc.GetDecimal();
            if (root.TryGetProperty("TotalHours", out global::System.Text.Json.JsonElement h)) TotalHours = h.ValueKind == global::System.Text.Json.JsonValueKind.Null ? null : h.GetDecimal();
            if (root.TryGetProperty("Notes", out global::System.Text.Json.JsonElement n)) Notes = n.GetString();
            _showRecoveryModal = false;
            _syncStatus = "Recovered";
            _hasLocalChanges = true;
            _ = AutoSave();
            StateHasChanged();
        } catch { }
    }

    private async Task DiscardLocalDraft() {
        try {
            var key = $"gfc_shift_draft_{ReportDate:yyyyMMdd}_{ShiftType}";
            await JSRuntime.InvokeVoidAsync("localStorage.removeItem", key);
            _showRecoveryModal = false;
            StateHasChanged();
        } catch { }
    }

    private string? _lastProcessedQueryDate;
    private string? _lastProcessedQueryShift;

    protected override async Task OnParametersSetAsync()
    {
        if (!_initialized || QueryDate != _lastProcessedQueryDate || QueryShift != _lastProcessedQueryShift)
        {
            _initialized = true;
            _lastProcessedQueryDate = QueryDate;
            _lastProcessedQueryShift = QueryShift;

            if (!string.IsNullOrEmpty(QueryDate) && DateTime.TryParse(QueryDate, out var qDate))
            {
                ReportDate = qDate;
                if (!string.IsNullOrEmpty(QueryShift))
                {
                    ShiftType = QueryShift;
                }
            }
            else
            {
                ApplyBusinessDayLogic();
            }

            // [FIX] Populate CurrentUser for locking logic
            try {
                var authState = await AuthStateProvider.GetAuthenticationStateAsync();
                var user = authState.User;
                if (user.Identity?.IsAuthenticated == true) {
                    CurrentUser = new GFC.Core.Models.AppUser {
                        Username = user.Identity.Name,
                        IsAdmin = user.IsInRole("Admin") || user.IsInRole("Manager")
                    };
                }
            } catch { }

            await UpdateShiftAvailability();
            await CheckExisting();

            // [VERSION CHECK] - No guessing!
            try {
                var serverVersion = await ReportingService.GetServerVersionAsync();
                _hasUpdate = serverVersion != VersionService.GetFullVersion();
            } catch { }

            Loading = false;
            StateHasChanged();
        }
    }

    private void ApplyBusinessDayLogic()
    {
        var now = DateTime.Now;
        if (now.Hour < 5) ReportDate = DateTime.Today.AddDays(-1);
    }

    private async Task OnDateChanged(ChangeEventArgs e)
    {
        if (e.Value != null && DateTime.TryParse(e.Value.ToString(), out var newDate))
        {
            ReportDate = newDate;
        }

        Loading = true;
        StateHasChanged();
        try {
            _currentBuffer = "";
            await UpdateShiftAvailability();
            await CheckExisting();
        } finally {
            Loading = false;
            StateHasChanged();
        }
    }

