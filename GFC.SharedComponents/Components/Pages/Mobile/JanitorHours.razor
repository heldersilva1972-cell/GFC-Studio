@page "/mobile/janitor-hours"
@using Microsoft.AspNetCore.Authorization
@using GFC.Core.Interfaces
@using GFC.Core.Models
@using GFC.Mobile.Data
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<GfcDbContext> DbFactory
@inject NavigationManager Navigation
@inject ICustomAuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JSRuntime
@attribute [Authorize]

<PageTitle>Janitor Hours | GFC Mobile</PageTitle>

<MobileHubHeader IsConnected="@_isCircutAlive" StatusText="@_syncStatus" LastSynced="@_lastSyncedAt" />



<div class="janitor-page-wrapper animate-entrance">
    <div class="container d-flex flex-column justify-content-center align-items-center min-vh-80 py-4">
        <div class="col-12 col-md-8 col-lg-6">
            
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden mb-4">
                <div class="card-header bg-primary text-white p-4 border-0">
                    <div class="d-flex align-items-center gap-3">
                        <div class="rounded-circle bg-white d-flex align-items-center justify-content-center shadow-sm" style="width: 54px; height: 54px; flex-shrink: 0;">
                            <i class="bi bi-brush fs-3 text-primary"></i>
                        </div>
                        <div class="flex-grow-1">
                            <h4 class="fw-black mb-1 text-uppercase tracking-tight">Record Daily Hours</h4>
                            <div class="d-flex align-items-center gap-2">
                                <span class="fw-bold opacity-90 small">EMPLOYEE:</span>
                                <span class="fw-black text-white px-2 py-1 bg-white bg-opacity-25 rounded-2 tracking-wider" style="font-size: 0.85rem;">
                                    @(string.IsNullOrEmpty(_displayName) ? currentAppUser?.Username : _displayName)
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
                
                <div class="card-body p-4 bg-white">
                    @if (IsSuccess)
                    {
                        <div class="text-center py-5">
                            <div class="success-icon-box mb-4 mx-auto shadow-lg animate-bounce-in">
                                <i class="bi bi-check2-circle text-success fs-1"></i>
                            </div>
                            <h3 class="fw-black mb-2">Hours Secured!</h3>
                            <p class="text-muted mb-4">Your entry for @ReportDate.ToString("MMMM dd, yyyy") has been recorded.</p>
                            
                            <div class="d-flex align-items-center justify-content-center gap-2 text-primary fw-bold">
                                <div class="spinner-border spinner-border-sm" role="status"></div>
                                <span>Logging out securely...</span>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="mb-4">
                            <label class="form-label fw-bold text-uppercase small text-muted mb-1" style="letter-spacing: 0.05em;">Work Date</label>
                            <div class="input-group-modern py-3 px-4 rounded-4 shadow-sm border bg-light">
                                <div class="d-flex align-items-center justify-content-between w-100">
                                    <div class="d-flex align-items-center gap-3">
                                        <i class="bi bi-calendar3 text-primary fs-4"></i>
                                        <input type="date" class="border-0 bg-transparent fw-bold fs-5 text-dark" style="outline: none;" 
                                               value="@ReportDate.ToString("yyyy-MM-dd")" @onchange="OnDateChanged" />
                                    </div>
                                    <div class="badge bg-primary rounded-pill px-3 py-2 fw-black text-uppercase" style="font-size: 0.65rem;">
                                        @ReportDate.DayOfWeek
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold text-uppercase small text-muted mb-1" style="letter-spacing: 0.05em;">Hours Worked</label>
                            <div class="input-group-modern p-0 rounded-4 shadow-sm border bg-white @(IsHoursFocused ? "ring-2 ring-primary border-primary" : "")" style="height: 100px;">
                                <div class="d-flex align-items-center justify-content-between w-100 h-100 px-4">
                                    <div class="d-flex flex-column">
                                        <span class="fw-black text-muted fs-6">DAILY TOTAL</span>
                                        @if (_hasExistingRecord)
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle extra-small mt-1 animate-fade-in" style="font-size: 0.65rem; width: fit-content; font-weight: 800;"><i class="bi bi-check-circle-fill me-1"></i>Hours Recorded</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">Hours worked today</span>
                                        }
                                    </div>
                                    <div class="d-flex align-items-center">
                                        <div class="form-input-modern text-end pe-1 fw-black text-primary" style="font-size: 3rem;">
                                            @(string.IsNullOrEmpty(_hoursInput) ? "0.0" : _hoursInput)
                                        </div>
                                        <div class="ms-1 border-end border-3 border-primary animate-pulse" style="height: 2.2rem;"></div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- CUSTOM TOUCH KEYPAD -->
                        <div class="keypad-container mb-4">
                            <div class="keypad-grid">
                                <button class="key-btn" @onclick='() => KeyPressed("1")'>1</button>
                                <button class="key-btn" @onclick='() => KeyPressed("2")'>2</button>
                                <button class="key-btn" @onclick='() => KeyPressed("3")'>3</button>
                                
                                <button class="key-btn" @onclick='() => KeyPressed("4")'>4</button>
                                <button class="key-btn" @onclick='() => KeyPressed("5")'>5</button>
                                <button class="key-btn" @onclick='() => KeyPressed("6")'>6</button>
                                <button class="key-btn" @onclick='() => KeyPressed("7")'>7</button>
                                <button class="key-btn" @onclick='() => KeyPressed("8")'>8</button>
                                <button class="key-btn" @onclick='() => KeyPressed("9")'>9</button>
                                
                                <button class="key-btn ivory-btn" @onclick='BackspaceCurrentField'><i class="bi bi-backspace"></i></button>
                                <button class="key-btn" @onclick='() => KeyPressed("0")'>0</button>
                                <button class="key-btn" @onclick='() => KeyPressed(".")'>.</button>
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(ErrorMessage))
                        {
                            <div class="alert alert-danger border-0 rounded-4 mb-4 d-flex align-items-center gap-2">
                                <i class="bi bi-exclamation-circle-fill"></i>
                                <span class="small fw-bold">@ErrorMessage</span>
                            </div>
                        }

                        <button class="btn btn-primary w-100 rounded-pill py-3 fw-black fs-5 shadow-lg d-flex align-items-center justify-content-center gap-2" 
                                disabled="@(IsSubmitting || TotalHours <= 0)" @onclick="PreCheckSubmit">
                            @if (IsSubmitting)
                            {
                                <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                                <span>VERIFYING...</span>
                            }
                            else
                            {
                                <i class="bi @(_hasExistingRecord ? "bi-pencil-square" : "bi-send-fill")"></i>
                                <span>@(_hasExistingRecord ? "CORRECT/UPDATE HOURS" : "SUBMIT HOURS")</span>
                            }
                        </button>
                    }
                </div>
            </div>
            
            <p class="text-center text-muted small px-4">
                <i class="bi bi-shield-check me-1"></i> These hours will be automatically added to the next payroll cycle.
            </p>
        </div>
    </div>
</div>

@if (_showCorrectionModal)
{
    <div class="modal-backdrop-custom animate-fade-in" @onclick="() => _showCorrectionModal = false"></div>
    <div class="correction-sheet animate-slide-up">
        <div class="sheet-handle"></div>
        <div class="p-4 text-center">
            <div class="alert-icon-box mb-3 mx-auto shadow-sm">
                <i class="bi bi-exclamation-triangle-fill text-warning fs-3"></i>
            </div>
            <h4 class="fw-black text-dark mb-2">RECORD CONFLICT</h4>
            <div class="px-3 mb-4">
                <p class="text-muted mb-1"><strong>@_existingHours.ToString("N1") Hours</strong> have been submitted already for this date.</p>
                <p class="small text-muted opacity-75">Do you want to make a correction to <strong>@TotalHours.ToString("N1") Hours</strong>?</p>
            </div>
            
            <div class="d-grid gap-2">
                <button class="btn btn-primary py-3 rounded-pill fw-black shadow-sm" @onclick="() => ProceedWithSave(true)">
                    YES, UPDATE HOURS
                </button>
                <button class="btn btn-light py-3 rounded-pill fw-bold text-muted border" @onclick="() => _showCorrectionModal = false">
                    NO, KEEP PREVIOUS
                </button>
            </div>
        </div>
    </div>
}

<style>
    .janitor-page-wrapper {
        min-height: calc(100vh - 80px);
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .min-vh-80 { min-height: 80vh; }
    .opacity-90 { opacity: 0.9; }
    .tracking-tight { letter-spacing: -0.025em; }
    .tracking-wider { letter-spacing: 0.05em; }
    body { background-color: #f8fafc; }
    .fw-black { font-weight: 900; }
    .animate-entrance { animation: slideUp 0.4s cubic-bezier(0.16, 1, 0.3, 1); }
    .animate-bounce-in { animation: bounceIn 0.5s cubic-bezier(0.34, 1.56, 0.64, 1); }
    .animate-fade-in { animation: fadeIn 0.2s ease-out; }
    .animate-slide-up { animation: slideUp 0.3s cubic-bezier(0.16, 1, 0.3, 1); }

    .modal-backdrop-custom {
        position: fixed; top: 0; left: 0; right: 0; bottom: 0;
        background: rgba(0,0,0,0.4); backdrop-filter: blur(4px); z-index: 1060;
    }

    .correction-sheet {
        position: fixed; top: 50%; left: 50%; transform: translate(-50%, -50%);
        width: 90%; max-width: 400px;
        background: white; border-radius: 32px;
        z-index: 1070; overflow: hidden;
        box-shadow: 0 20px 60px rgba(0,0,0,0.3);
    }
    .sheet-handle { display: none; }

    .alert-icon-box {
        width: 60px; height: 60px;
        background: #fffbeb;
        border: 2px solid #fef3c7;
        border-radius: 20px;
        display: flex; align-items: center; justify-content: center;
    }
    
    .input-group-modern { transition: all 0.2s ease; }
    .success-icon-box {
        width: 80px; height: 80px;
        background: #f0fdf4;
        color: #10b981;
        border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        border: 4px solid #d1fae5;
    }

    @@keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
    @@keyframes slideUp {
        from { transform: translateY(20px); opacity: 0; }
        to { transform: translateY(0); opacity: 1; }
    }
    @@keyframes bounceIn {
        from { transform: scale(0.8); opacity: 0; }
        to { transform: scale(1); opacity: 1; }
    }
    
    /* KEYPAD STYLES FROM SHIFT REPORT */
    .keypad-container {
        background: #f1f5f9;
        border-radius: 20px;
        padding: 15px;
        border: 1px solid #e2e8f0;
    }

    .keypad-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 12px;
    }

    .key-btn {
        height: 65px;
        border-radius: 16px;
        border: none;
        background: white;
        color: #1e293b;
        font-size: 1.5rem;
        font-weight: 900;
        box-shadow: 0 4px 0 #e2e8f0;
        transition: all 0.1s;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .key-btn:active {
        transform: translateY(3px);
        box-shadow: 0 1px 0 #e2e8f0;
        background: #f8fafc;
    }

    .ivory-btn { color: #64748b; background: #f8fafc; }

    /* Remove keypad spinners */
    input::-webkit-outer-spin-button,
    input::-webkit-inner-spin-button {
      -webkit-appearance: none;
      margin: 0;
    }
    input[type=number] {
      -moz-appearance: textfield;
    }
</style>

@code {
    private DateTime ReportDate { get; set; } = DateTime.Today;
    private decimal TotalHours { get; set; }
    private string _hoursInput = "";
    private bool IsSubmitting { get; set; }
    private bool IsSuccess { get; set; }
    private string ErrorMessage { get; set; }
    private bool IsHoursFocused { get; set; }
    private bool _showCorrectionModal { get; set; }
    private bool _hasExistingRecord { get; set; }
    private bool _isPrePopulatedActive { get; set; }
    private decimal _existingHours { get; set; }
    private string _displayName { get; set; } = "";
    private AppUser? currentAppUser { get; set; }
    private bool _isCircutAlive = true;
    private string? _syncStatus = null;
    private DateTime? _lastSyncedAt;

    protected override async Task OnInitializedAsync()
    {
        currentAppUser = AuthStateProvider.GetCurrentUser();
        if (currentAppUser?.MemberId != null)
        {
            using var db = await DbFactory.CreateDbContextAsync();
            var member = await db.Members
                .AsNoTracking()
                .FirstOrDefaultAsync(m => m.MemberID == currentAppUser.MemberId);
            
            if (member != null)
            {
                _displayName = $"{member.FirstName} {member.LastName}";
            }
        }
        await LoadExistingHoursForDate();
    }

    private async Task LoadExistingHoursForDate()
    {
        ErrorMessage = null;
        try
        {
            var user = AuthStateProvider.GetCurrentUser();
            if (user == null) return;

            using var db = await DbFactory.CreateDbContextAsync();
            var existing = await db.BarSaleEntries
                .AsNoTracking()
                .FirstOrDefaultAsync(e => (e.AdjustedSaleDate ?? e.SaleDate).Date == ReportDate.Date 
                                       && e.Shift == "Janitor" 
                                       && e.CreatedBy == user.Username
                                       && !e.IsDeleted);

            if (existing != null)
            {
                _hasExistingRecord = true;
                _isPrePopulatedActive = true;
                _existingHours = existing.TotalHours ?? 0m;
                TotalHours = _existingHours;
                _hoursInput = _existingHours > 0 ? _existingHours.ToString("0.#") : "";
            }
            else
            {
                _hasExistingRecord = false;
                _isPrePopulatedActive = false;
                _existingHours = 0m;
                TotalHours = 0m;
                _hoursInput = "";
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading existing janitor hours: {ex.Message}");
        }
    }

    private void KeyPressed(string key)
    {
        if (_isPrePopulatedActive)
        {
            _isPrePopulatedActive = false;
            _hoursInput = "";
            TotalHours = 0;
        }

        if (key == "." && _hoursInput.Contains(".")) return;
        if (_hoursInput.Length >= 6) return;
        
        _hoursInput += key;
        if (decimal.TryParse(_hoursInput, out var val))
        {
            TotalHours = val;
        }
    }

    private void BackspaceCurrentField()
    {
        if (_isPrePopulatedActive)
        {
            _isPrePopulatedActive = false;
            _hoursInput = "";
            TotalHours = 0;
            return;
        }

        if (_hoursInput.Length > 0)
        {
            _hoursInput = _hoursInput.Substring(0, _hoursInput.Length - 1);
            if (string.IsNullOrEmpty(_hoursInput))
            {
                TotalHours = 0;
            }
            else if (decimal.TryParse(_hoursInput, out var val))
            {
                TotalHours = val;
            }
        }
    }

    private async Task OnDateChanged(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out var date))
        {
            ReportDate = date;
            await LoadExistingHoursForDate();
        }
    }

    private async Task PreCheckSubmit()
    {
        if (TotalHours <= 0)
        {
            ErrorMessage = "Please enter hours worked.";
            return;
        }

        IsSubmitting = true;
        ErrorMessage = null;

        try
        {
            var currentAppUser = AuthStateProvider.GetCurrentUser();
            if (currentAppUser == null)
            {
                ErrorMessage = "User session lost. Please login again.";
                return;
            }

            using var db = await DbFactory.CreateDbContextAsync();
            var existing = await db.BarSaleEntries
                .FirstOrDefaultAsync(e => (e.AdjustedSaleDate ?? e.SaleDate).Date == ReportDate.Date 
                                       && e.Shift == "Janitor" 
                                       && e.CreatedBy == currentAppUser.Username
                                       && !e.IsDeleted);

            if (existing != null)
            {
                if (existing.TotalHours == TotalHours)
                {
                    ErrorMessage = "Hours are already set to this value.";
                    IsSubmitting = false;
                    return;
                }
                _existingHours = existing.TotalHours ?? 0m;
                _showCorrectionModal = true;
                IsSubmitting = false;
            }
            else
            {
                await ProceedWithSave(false);
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = "Error during verification.";
            Console.WriteLine($"Janitor PreCheck Error: {ex.Message}");
            IsSubmitting = false;
        }
    }

    private async Task ProceedWithSave(bool isCorrection)
    {
        IsSubmitting = true;
        _showCorrectionModal = false;

        try
        {
            var currentAppUser = AuthStateProvider.GetCurrentUser();
            using var db = await DbFactory.CreateDbContextAsync();
            
            if (isCorrection)
            {
                var existing = await db.BarSaleEntries
                    .FirstOrDefaultAsync(e => (e.AdjustedSaleDate ?? e.SaleDate).Date == ReportDate.Date 
                                           && e.Shift == "Janitor" 
                                           && e.CreatedBy == currentAppUser.Username
                                           && !e.IsDeleted);
                
                if (existing != null)
                {
                    existing.TotalHours = TotalHours;
                    existing.ModifiedAt = DateTime.UtcNow;
                    existing.ModifiedBy = currentAppUser.Username;
                    existing.Status = "Submitted";
                }
            }
            else
            {
                var entry = new BarSaleEntry
                {
                    SaleDate = ReportDate,
                    AdjustedSaleDate = ReportDate,
                    Shift = "Janitor",
                    TotalHours = TotalHours,
                    Status = "Submitted",
                    CreatedBy = currentAppUser.Username,
                    CreatedAt = DateTime.UtcNow,
                    IsDeleted = false,
                    IsRentalHall = false,
                    TotalSales = 0,
                    TotalItemsSold = 0
                };

                db.BarSaleEntries.Add(entry);
            }

            await db.SaveChangesAsync();
            _lastSyncedAt = DateTime.Now;
            _syncStatus = "Synced";
            IsSuccess = true;
            StateHasChanged();
            
            // Auto-logout after 2 seconds
            await Task.Delay(2000);
            await HandleLogout();
        }
        catch (Exception ex)
        {
            ErrorMessage = "An error occurred while saving. Please try again.";
            Console.WriteLine($"Janitor Submit Error: {ex.Message}");
        }
        finally
        {
            IsSubmitting = false;
        }
    }

    private async Task HandleLogout()
    {
        try
        {
            var token = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "gfc_device_token");
            await AuthStateProvider.LogoutAsync(token);
            await JSRuntime.InvokeVoidAsync("localStorage.removeItem", "gfc_device_token");
            await JSRuntime.InvokeVoidAsync("window.setCookie", "GFC_DeviceTrustToken", "", -1);
            await Task.Delay(100);
            Navigation.NavigateTo("/login?returnUrl=%2Fmobile", forceLoad: true);
        }
        catch
        {
            Navigation.NavigateTo("/login", forceLoad: true);
        }
    }

    private void ResetForm()
    {
        TotalHours = 0;
        _hoursInput = "";
        IsSuccess = false;
        ErrorMessage = null;
    }
}
