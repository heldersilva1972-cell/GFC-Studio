    private async Task CaptureLivePhoto()
    {
        if (_isUploadingImage) return;
        
        _isUploadingImage = true;
        StateHasChanged();

        try
        {
            // Verify JS side has a video stream before attempting capture
            string? dataUrl = null;
            try {
                dataUrl = await JSRuntime.InvokeAsync<string>("LiquorScanner.takeSnapshot");
            } catch (Exception jsEx) {
                throw new Exception("Browser failed to capture image frame: " + jsEx.Message);
            }

            if (!string.IsNullOrEmpty(dataUrl))
            {
                _editingItem.ImageUrl = dataUrl;
                _isLiveCameraMode = false;
                StateHasChanged();

                // Convert DataURL (base64) to stream for backend
                var parts = dataUrl.Split(',');
                if (parts.Length < 2) throw new Exception("Invalid image data returned from camera.");
                
                var base64Data = parts[1];
                var bytes = Convert.FromBase64String(base64Data);
                
                using var stream = new MemoryStream(bytes);
                await ProcessAndUploadImage(stream, "LiveCapture.jpg");
            }
            else
            {
                throw new Exception("No image data captured. Is the camera feed active?");
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", "Capture Error: " + ex.Message);
        }
        finally
        {
            _isUploadingImage = false;
            _isLiveCameraMode = false;
            StateHasChanged();
        }
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;

        _isUploadingImage = true;
        StateHasChanged();

        try
        {
            // 1. Immediately show local preview via Base64
            var resizedFile = await file.RequestImageFileAsync("image/jpeg", 400, 400);
            using var previewStream = resizedFile.OpenReadStream(1024 * 1024 * 5);
            var buffer = new byte[resizedFile.Size];
            int totalRead = 0;
            while (totalRead < buffer.Length)
            {
                int read = await previewStream.ReadAsync(buffer, totalRead, buffer.Length - totalRead);
                if (read == 0) break;
                totalRead += read;
            }
            var base64 = Convert.ToBase64String(buffer);
            _editingItem.ImageUrl = $"data:image/jpeg;base64,{base64}";
            StateHasChanged();

            // 2. High Resolution Image Resizing and Upload
            using var fullStream = new MemoryStream();
            await file.OpenReadStream(1024 * 1024 * 20).CopyToAsync(fullStream);
            fullStream.Position = 0;
            
            await ProcessAndUploadImage(fullStream, file.Name);
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Image Error: {ex.Message}");
        }
        finally
        {
            _isUploadingImage = false;
            StateHasChanged();
        }
    }

    private async Task ProcessAndUploadImage(Stream inputData, string fileName)
    {
        try
        {
            using var image = await SixLabors.ImageSharp.Image.LoadAsync(inputData);
            
            int maxWidth = 800;
            int maxHeight = 800;
            
            if (image.Width > maxWidth || image.Height > maxHeight)
            {
                image.Mutate(x => x.Resize(new ResizeOptions
                {
                    Mode = ResizeMode.Max,
                    Size = new SixLabors.ImageSharp.Size(maxWidth, maxHeight)
                }));
            }

            using var compressedStream = new MemoryStream();
            await image.SaveAsync(compressedStream, new SixLabors.ImageSharp.Formats.Jpeg.JpegEncoder { Quality = 85 });
            compressedStream.Position = 0;

            var asset = await MediaService.CreateMediaAssetAsync(compressedStream, $"{Guid.NewGuid()}_{fileName}", "LiquorReference", "System");
            
            if (asset != null)
            {
                _editingItem.ImageUrl = $"/uploads/{asset.StoredFileName}";
            }
        }
        catch (Exception ex)
        {
             await JSRuntime.InvokeVoidAsync("alert", $"Processing Error: {ex.Message}");
        }
    }

    private string GetStockClass(int stock, int limit)
    {
        if (stock == 0) return "critical";
        if (stock <= limit) return "low";
        return "normal";
    }

