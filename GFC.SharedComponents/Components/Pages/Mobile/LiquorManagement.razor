@implements IDisposable

@code {
    private string? _zoomedImageUrl;
    private string _activeTab = "inventory";
    private List<LiquorItem> _items = new();
    private List<LiquorTransaction> _recentTransactions = new();
    private List<ReconcileEntry> _reconcileEntries = new();
    private LiquorNotificationRule _myRules = new();
    
    private bool _showEditModal = false;
    private bool _modalClosing = false;
    private bool _isUploadingImage = false;
    private LiquorItem _editingItem = new();
    private bool _isLiveCameraMode = false;
    private string? _error;

    // Helper class for reconciliation state
    private class ReconcileEntry
    {
        public int ItemId { get; set; }
        public string ItemName { get; set; } = "";
        public string BottleSize { get; set; } = "";
        public int CurrentSystem { get; set; }
        public int ActualStart { get; set; }
    }

    private void EnterReconcileMode()
    {
        _activeTab = "reconcile";
        _reconcileEntries = _items.Select(i => new ReconcileEntry 
        { 
            ItemId = i.Id, 
            ItemName = i.Name, 
            BottleSize = i.BottleSize,
            CurrentSystem = i.CurrentStock, 
            ActualStart = i.CurrentStock // Default to expecting correct count
        }).OrderBy(e => e.ItemName).ToList();
    }

    private async Task QuickAdjust(LiquorItem item, int delta)
    {
        try {
            var user = AuthStateProvider.GetCurrentUser();
            await LiquorService.AdjustStockAsync(item.Id, user?.UserId ?? 0, delta, "Quick Adjustment");
            
            // Optimistic update
            item.CurrentStock += delta;
            if (item.CurrentStock < 0) item.CurrentStock = 0;
            
            StateHasChanged();
        }
        catch (Exception ex) {
            await JSRuntime.InvokeVoidAsync("alert", "Failed to adjust stock: " + ex.Message);
            await LoadData(); // Revert on failure
        }
    }

    private async Task SubmitReconciliation()
    {
        var adjustments = _reconcileEntries.Where(e => e.ActualStart != e.CurrentSystem).ToList();
        if (!adjustments.Any()) return;

        bool confirm = await JSRuntime.InvokeAsync<bool>("confirm", $"You are about to adjust {adjustments.Count} items. Proceed?");
        if (!confirm) return;

        try 
        {
            var user = AuthStateProvider.GetCurrentUser();
            foreach (var adj in adjustments)
            {
                int delta = adj.ActualStart - adj.CurrentSystem;
                await LiquorService.AdjustStockAsync(adj.ItemId, user?.UserId ?? 0, delta, "Reconciliation Audit");
            }

            await JSRuntime.InvokeVoidAsync("alert", "Reconciliation Complete!");
            _activeTab = "inventory";
            await LoadData();
        }
        catch (Exception ex)
        {
             await JSRuntime.InvokeVoidAsync("alert", "Error during reconciliation: " + ex.Message);
             await LoadData();
        }
    }

    // --- RECEIVING MODE ---
    private bool _isReceivingMode = false;
    private Dictionary<int, int> _pendingRestock = new();

    private void ToggleReceivingMode()
    {
        _isReceivingMode = !_isReceivingMode;
        _pendingRestock.Clear();
    }

    private void AdjustPendingRestock(int itemId, int delta)
    {
        if (!_pendingRestock.ContainsKey(itemId)) _pendingRestock[itemId] = 0;
        
        _pendingRestock[itemId] += delta;
        
        if (_pendingRestock[itemId] < 0) _pendingRestock[itemId] = 0;
    }

    private void SetPendingRestock(int itemId, object val)
    {
        if (int.TryParse(val.ToString(), out int newVal))
        {
            if (newVal < 0) newVal = 0;
             _pendingRestock[itemId] = newVal;
        }
    }

    private async Task CommitRestock()
    {
        var validUpdates = _pendingRestock.Where(x => x.Value > 0).ToList();
        if (!validUpdates.Any()) return;

        bool confirm = await JSRuntime.InvokeAsync<bool>("confirm", "Confirm receipt of these items?");
        if (!confirm) return;

        try
        {
            var user = AuthStateProvider.GetCurrentUser();
            foreach(var update in validUpdates)
            {
                await LiquorService.RestockItemAsync(update.Key, user?.UserId ?? 0, update.Value, "Bulk Shipment Receipt");
            }

            _isReceivingMode = false;
            _pendingRestock.Clear();
            await JSRuntime.InvokeVoidAsync("alert", "Stock received successfully!");
            await LoadData();
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", "Error receiving stock: " + ex.Message);
             await LoadData();
        }
    }

