@page "/mobile/liquor/manage"
@using GFC.Core.Interfaces
@using GFC.Core.Models
@using Microsoft.AspNetCore.Authorization
@using SixLabors.ImageSharp
@using SixLabors.ImageSharp.Processing
@using SixLabors.ImageSharp.Formats.Jpeg
@attribute [Authorize]
@inject ILiquorService LiquorService
@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation
@inject ICustomAuthenticationStateProvider AuthStateProvider
@inject GFC.Core.Interfaces.IMediaAssetService MediaService
@inject INotificationService NotificationService
@using GFC.Mobile.Components.Shared

<PageTitle>liquor inventory manager | GFC Staff</PageTitle>

<div class="mobile-liquor-hub-container">
    <!-- FIXED TOP SECTION -->
    <div class="header-nav-stack">
        <!-- PREMIUM HEADER -->
        <header class="app-header px-4 py-3 d-flex align-items-center justify-content-between">
            <h1 class="h5 mb-0 fw-black">Liquor inventory manager</h1>
            <div class="d-flex align-items-center gap-2">
                <button class="btn-settings-dots" @onclick='() => _activeTab = "alerts"' title="Alert Settings">
                    <i class="bi bi-three-dots-vertical"></i>
                </button>
                <button class="btn-add-circle" @onclick="OpenAddModal">
                    <i class="bi bi-plus-lg"></i>
                </button>
            </div>
        </header>

        <!-- TABS -->
        <div class="custom-tabs mx-4 my-2">
            <button class='tab-item @(_activeTab == "inventory" ? "active" : "")' @onclick='() => _activeTab = "inventory"'>
                <i class="bi bi-boxes"></i> <span>Stock</span>
            </button>
            <button class='tab-item @(_activeTab == "lowstock" ? "active" : "")' @onclick='() => _activeTab = "lowstock"'>
                <i class="bi bi-exclamation-triangle"></i> <span>Low Stock</span>
                @if (_items.Any(i => i.CurrentStock <= i.MinStockLimit))
                {
                    <span class="badge bg-danger rounded-pill ms-1" style="font-size: 0.6rem; padding: 0.2rem 0.4rem;">@_items.Count(i => i.CurrentStock <= i.MinStockLimit)</span>
                }
            </button>
            <button class='tab-item @(_activeTab == "history" ? "active" : "")' @onclick='() => _activeTab = "history"'>
                <i class="bi bi-clock-history"></i> <span>History</span>
            </button>
            <button class='tab-item @(_activeTab == "reconcile" ? "active" : "")' @onclick='() => EnterReconcileMode()'>
                <i class="bi bi-clipboard-check"></i> <span>Reconcile</span>
            </button>
        </div>
    </div>

    <!-- MAIN CONTENT -->
    <main class="hub-scroll-area px-4 pt-3">
        @if (_activeTab == "inventory" || _activeTab == "lowstock")
        {
            <div class="inventory-section animate-entrance stagger-1">
                <!-- ACTIONS BAR -->
                @if (_activeTab == "inventory")
                {
                    <div class="actions-bar mb-4">
                        <button class="btn w-100 rounded-pill fw-black shadow-sm @(_isReceivingMode ? "btn-light border text-muted" : "btn-app-primary")" 
                                @onclick="ToggleReceivingMode">
                            @if (_isReceivingMode)
                            {
                                <span><i class="bi bi-x-lg me-2"></i>Exit Receiving Mode</span>
                            }
                            else
                            {
                                <span><i class="bi bi-box-seam-fill me-2"></i>Receive New Shipment</span>
                            }
                        </button>
                    </div>
                }

                @if (_activeTab == "lowstock")
                {
                    <div class="alerts-summary mb-4 p-3 rounded-4 bg-danger bg-opacity-10 border border-danger border-opacity-25">
                        <div class="d-flex align-items-center gap-3">
                            <div class="icon-box bg-danger text-white rounded-3 p-2">
                                <i class="bi bi-exclamation-octagon-fill"></i>
                            </div>
                            <div>
                                <h6 class="mb-0 fw-black text-danger">Inventory Alerts</h6>
                                <p class="small text-danger mb-0 opacity-75">Showing items at or below minimum threshold.</p>
                            </div>
                        </div>
                    </div>
                }

                <div class="inventory-grid">
                    @{
                        var displayItems = _activeTab == "lowstock" 
                            ? _items.Where(i => i.CurrentStock <= i.MinStockLimit).ToList() 
                            : _items;
                    }
                    @foreach (var item in displayItems)
                    {
                        bool hasPending = _isReceivingMode && _pendingRestock.ContainsKey(item.Id) && _pendingRestock[item.Id] > 0;
                        <div class="product-card @(hasPending ? "highlight-receive" : "")" @onclick="() => OpenEditModal(item)">
                            <div class="product-img-wrapper" @onclick:stopPropagation="true" @onclick='() => _zoomedImageUrl = item.ImageUrl'>
                                @if (!string.IsNullOrEmpty(item.ImageUrl))
                                {
                                    <img src="@item.ImageUrl" alt="@item.Name" />
                                    <div class="img-zoom-hint"><i class="bi bi-zoom-in"></i></div>
                                }
                                else
                                {
                                    <div class="empty-img">
                                        <i class="bi bi-bottle"></i>
                                    </div>
                                }
                            </div>
                            <div class="product-info">
                                <h3 class="product-title">@item.Name</h3>
                                <div class="product-meta">
                                    <span class="size">@item.BottleSize</span>
                                </div>
                                
                                @if (_isReceivingMode)
                                {
                                    <!-- Receiving Mode UI -->
                                    <div class="receiving-panel mt-3 p-3 bg-white rounded-4 border shadow-sm" @onclick:stopPropagation="true">
                                        <label class="d-block small fw-black text-muted text-uppercase mb-2 ls-1" style="font-size: 0.65rem;">
                                            <i class="bi bi-box-seam me-1"></i> Add to Shipment
                                        </label>
                                        
                                        <div class="d-flex align-items-center gap-2 mb-3">
                                            <button class="btn btn-step-pill" @onclick="() => AdjustPendingRestock(item.Id, -1)">
                                                <i class="bi bi-dash"></i>
                                            </button>
                                            
                                            <input type="number" class="form-control shipment-input"
                                                   value="@(_pendingRestock.ContainsKey(item.Id) ? _pendingRestock[item.Id] : 0)" 
                                                   @onchange="@(e => SetPendingRestock(item.Id, e.Value))"
                                                   onfocus="this.setSelectionRange(0, 999); this.select();" />
                                            
                                            <button class="btn btn-step-pill active" @onclick="() => AdjustPendingRestock(item.Id, 1)">
                                                <i class="bi bi-plus"></i>
                                            </button>
                                        </div>
                                        
                                        <div class="d-flex gap-2">
                                            <button class="btn btn-quick-add" @onclick="() => AdjustPendingRestock(item.Id, 6)">+6</button>
                                            <button class="btn btn-quick-add" @onclick="() => AdjustPendingRestock(item.Id, 12)">+12</button>
                                        </div>
                                    </div>
                                }
                            </div>
                            
                            <!-- BOLD QUANTITY DISPLAY -->
                            <div class="product-stock-display text-center @(GetStockClass(item.CurrentStock, item.MinStockLimit))">
                                <span class="stock-label">ON HAND</span>
                                <span class="stock-value">@item.CurrentStock</span>
                                <span class="stock-unit">BOTTLES</span>
                            </div>
                        </div>
                    }

                    @if (!_items.Any())
                    {
                        <div class="empty-state text-center py-5">
                            <i class="bi bi-box-seam display-1 text-muted opacity-25"></i>
                            <p class="mt-3 fw-bold text-muted">No products in inventory.</p>
                        </div>
                    }
                </div>

                @if (_isReceivingMode)
                {
                    <div class="reconcile-footer slide-up">
                        @{ var totalItems = _pendingRestock.Values.Sum(); var totalSkus = _pendingRestock.Count(x => x.Value > 0); }
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="small fw-bold text-muted">Receiving Shipment:</span>
                            <span class="badge bg-primary rounded-pill px-3 py-2">+@totalItems bottles <span style="opacity:0.8; font-weight:400;">(@totalSkus items)</span></span>
                        </div>
                        <div class="d-flex gap-2">
                             <button class="btn btn-light flex-grow-0 border fw-bold" @onclick="ToggleReceivingMode">Cancel</button>
                             <button class="btn btn-primary flex-grow-1 shadow-lg fw-black" @onclick="CommitRestock" disabled="@(totalItems <= 0)">
                                <i class="bi bi-check2-circle me-2"></i> CONFIRM RECEIPT
                            </button>
                        </div>
                    </div>
                }
            </div>
        }
        else if (_activeTab == "history")
        {
            <div class="history-section animate-entrance stagger-1">
                <!-- ANALYTICS CARD -->
                <div class="analytics-card mb-4 p-3 bg-white rounded-4 border shadow-sm">
                    <h5 class="fw-black mb-1 p-1">30-Day Usage Trends</h5>
                    <p class="small text-muted mb-3 px-1">Consumption by brand vs. previous period</p>
                    
                    <div class="trends-grid">
                        @foreach (var trend in _usageTrends.Take(4)) 
                        {
                            <div class="trend-item p-2 rounded-3 bg-light">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <span class="small fw-bold text-muted text-truncate" style="font-size: 0.75rem; max-width: 80px;" title="@trend.ProductName">@trend.ProductName</span>
                                    <span class="badge @(trend.IsUp ? "bg-danger-subtle text-danger" : "bg-success-subtle text-success") rounded-pill" style="font-size: 0.65rem;">
                                        @(trend.IsUp ? "⬆" : "⬇") @Math.Abs(trend.PercentageChange)%
                                    </span>
                                </div>
                                <div class="d-flex align-items-baseline gap-1">
                                    <span class="fw-black" style="font-size: 1.1rem;">@trend.CurrentPeriodUsage</span>
                                    <span class="small text-muted mb-0">btls</span>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <h6 class="fw-bold text-muted px-2 mb-2 text-uppercase small" style="letter-spacing: 1px;">Recent Activity</h6>
                @foreach (var tx in _recentTransactions)
                {
                    <div class="history-card">
                       <div class="tx-icon @(tx.TransactionType.ToLower())">
                            <i class="bi @(GetTxIcon(tx.TransactionType))"></i>
                        </div>
                        <div class="tx-details">
                            <div class="tx-header">
                                <span class="tx-brand">@(tx.Item?.Name ?? "Deleted Item")</span>
                                <span class="tx-amount @(tx.ChangeAmount > 0 ? "pos" : "neg")">
                                    @(tx.ChangeAmount > 0 ? "+" : "")@tx.ChangeAmount
                                </span>
                            </div>
                            <div class="tx-footer">
                                <span>@(tx.User != null ? tx.User.Username : $"User #{tx.UserId}")</span>
                                <span class="dot"></span>
                                <span>@tx.Timestamp.ToString("MMM dd, HH:mm")</span>
                            </div>
                            @if (!string.IsNullOrEmpty(tx.Notes))
                            {
                                <div class="tx-notes">
                                    @tx.Notes
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        }
        else if (_activeTab == "reconcile")
        {
            <div class="reconcile-section animate-entrance stagger-1 p-b-100">
                <div class="reconcile-header mb-4">
                     <p class="text-muted small mb-2">Use this tool to audit your inventory. Enter the <strong>actual</strong> number of bottles you see on the shelf.</p>
                     
                </div>

                <div class="reconcile-list">
                    @foreach (var entry in _reconcileEntries)
                    {
                        var diff = entry.ActualStart - entry.CurrentSystem;
                        <div class="reconcile-card @(diff != 0 ? "modified" : "")">
                            <div class="reconcile-info">
                                <span class="reconcile-name">@entry.ItemName</span>
                                <div class="d-flex align-items-center gap-2 mt-1">
                                    <span class="badge bg-light text-muted border fw-bold" style="font-size: 0.65rem;">@entry.BottleSize</span>
                                    <span class="small fw-black text-muted text-uppercase" style="font-size: 0.6rem;">System: <strong>@entry.CurrentSystem</strong></span>
                                </div>
                            </div>
                            <div class="reconcile-input-wrapper shadow-sm border @(diff != 0 ? "border-primary" : "")">
                                <button class="btn-step" @onclick="() => entry.ActualStart--"><i class="bi bi-dash-lg"></i></button>
                                <input type="number" class="reconcile-input" @bind="entry.ActualStart" onfocus="this.setSelectionRange(0, 999); this.select();" />
                                <button class="btn-step" @onclick="() => entry.ActualStart++"><i class="bi bi-plus-lg"></i></button>
                            </div>
                        </div>
                    }
                </div>

                <div class="reconcile-footer">
                     <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="small fw-bold text-muted">Items Pending Adjustment:</span>
                        <span class="badge bg-primary rounded-pill">@_reconcileEntries.Count(e => e.ActualStart != e.CurrentSystem)</span>
                    </div>
                    <button class="btn btn-app-primary w-100 py-3 shadow-lg" @onclick="SubmitReconciliation" disabled="@(!_reconcileEntries.Any(e => e.ActualStart != e.CurrentSystem))">
                        Confirm & Adjust Inventory
                    </button>
                </div>
            </div>
        }
        else if (_activeTab == "alerts")
        {
             <div class="alerts-section animate-entrance stagger-1">
                <div class="premium-settings-card">
                    <h2 class="h6 fw-black mb-1">Notification Preferences</h2>
                    <p class="small text-muted mb-4">Manage how you receive low stock alerts.</p>
                    
                    <div class="setting-row">
                        <div class="setting-text">
                            <span class="fw-bold">Low Stock Warning</span>
                            <span class="small text-muted">Notify when stock hits the limit</span>
                        </div>
                        <div class="form-check form-switch p-0">
                            <input class="form-check-input ms-0" type="checkbox" @bind="_myRules.NotifyOnLowStock" />
                        </div>
                    </div>

                    <div class="setting-row">
                        <div class="setting-text">
                            <span class="fw-bold">Out of Stock Alert</span>
                            <span class="small text-muted">Urgent alert when stock is empty</span>
                        </div>
                        <div class="form-check form-switch p-0">
                            <input class="form-check-input ms-0" type="checkbox" @bind="_myRules.NotifyOnEmpty" />
                        </div>
                    </div>

                    <div class="divider text-uppercase small fw-black text-muted my-3" style="letter-spacing: 1px; font-size: 0.65rem;">Delivery Channels</div>

                    <div class="setting-row">
                        <div class="setting-text">
                            <span class="fw-bold"><i class="bi bi-phone me-2"></i>Push Notifications</span>
                        </div>
                        <div class="form-check form-switch p-0">
                            <input class="form-check-input ms-0" type="checkbox" @bind="_myRules.ReceivePush" />
                        </div>
                    </div>

                    <div class="setting-row">
                        <div class="setting-text">
                            <span class="fw-bold"><i class="bi bi-envelope me-2"></i>Email Notifications</span>
                            <span class="small text-muted">Receive alerts via your registered email</span>
                        </div>
                        <div class="form-check form-switch p-0">
                            <input class="form-check-input ms-0" type="checkbox" @bind="_myRules.ReceiveEmail" />
                        </div>
                    </div>

                    <div class="setting-row">
                        <div class="setting-text">
                            <span class="fw-bold"><i class="bi bi-chat-dots me-2"></i>SMS Text</span>
                        </div>
                        <div class="form-check form-switch p-0">
                            <input class="form-check-input ms-0" type="checkbox" @bind="_myRules.ReceiveSms" />
                        </div>
                    </div>

                    <button class="btn btn-app-primary w-100 mt-4" @onclick="SaveRules">
                        Update Alert Rules
                    </button>
                </div>
             </div>
        }
    </main>

    <!-- BOTTOM TAB BAR -->
    <div class="fixed-bottom-nav" style="position: fixed; bottom: 0; left: 0; right: 0; z-index: 1000; background: white; border-top: 1px solid #f1f5f9;">
        <MobileBottomNav ActiveTab="liquor inventory manager" />
    </div>
</div>

@if (!string.IsNullOrEmpty(_zoomedImageUrl))
{
    <div class="zoom-overlay animate-fade-in" @onclick="() => _zoomedImageUrl = null">
        <div class="zoom-content animate-zoom">
            <img src="@_zoomedImageUrl" />
            <div class="zoom-close"><i class="bi bi-x-circle-fill"></i> Tap anywhere to close</div>
        </div>
    </div>
}

<!-- ADD/EDIT MODAL -->
@if (_showEditModal)
{
    <div class="premium-modal-overlay @(_modalClosing ? "closing" : "")" @onclick="CloseModal">
        <div class="premium-modal-content animate-slide-up" @onclick:stopPropagation="true">
            <div class="modal-handle"></div>
            
            <div class="modal-header-modern">
                <h2 class="h5 fw-black m-0">@(_editingItem.Id == 0 ? "New Product" : "Edit Product")</h2>
                <button class="btn-close-modal" @onclick="CloseModal">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <div class="modal-body-scrollable">
                <!-- DYNAMIC PHOTO HEADER -->
                @if (_isLiveCameraMode)
                {
                    <div class="camera-mode-container mb-3 animate-entrance">
                        <div class="photo-preview-box active-camera" id="product-photo-area">
                            <div id="live-camera-feed" class="main-preview"></div>
                        </div>
                        <div class="camera-controls mt-2 d-flex gap-2 justify-content-center">
                            <button class="btn btn-primary rounded-pill px-4 fw-black shadow-lg" @onclick="CaptureLivePhoto">
                                <i class="bi bi-camera-fill me-2"></i> CAPTURE
                            </button>
                            <button class="btn btn-light rounded-pill px-4 fw-black" @onclick="StopLiveCamera">
                                CANCEL
                            </button>
                        </div>
                    </div>
                }
                else
                {
                    <div class="compact-header d-flex gap-3 mb-4">
                        <!-- PHOTO THUMBNAIL -->
                        <div class="compact-photo-box shadow-sm" @onclick="StartLiveCamera">
                            @if (!string.IsNullOrEmpty(_editingItem.ImageUrl))
                            {
                                <img src="@_editingItem.ImageUrl" class="thumb-img" />
                                <button class="btn-mini-delete" @onclick="ClearImage" @onclick:stopPropagation="true">
                                    <i class="bi bi-x"></i>
                                </button>
                            }
                            else
                            {
                                <div class="empty-thumb">
                                    <i class="bi bi-camera-fill"></i>
                                    <span>Add</span>
                                </div>
                            }
                            
                            @if (_isUploadingImage)
                            {
                                <div class="upload-overlay">
                                    <span class="spinner-border spinner-border-sm"></span>
                                </div>
                            }
                        </div>

                        <!-- IDENTITY INPUTS -->
                        <div class="flex-grow-1 d-flex flex-column gap-2">
                            <div class="form-group mb-0">
                                <label class="small fw-black text-muted text-uppercase ls-1 mb-1">BRAND NAME</label>
                                <input type="text" class="form-control form-control-lg fw-black fs-4" @bind="_editingItem.Name" placeholder="e.g. Jameson" />
                            </div>
                        </div>
                    </div>

                    <!-- HIDDEN INPUTS for file selection -->
                    <InputFile id="photo-take" OnChange="HandleFileSelected" accept="image/*" capture="environment" style="display:none;" />
                    <InputFile id="photo-upload" OnChange="HandleFileSelected" accept="image/*" style="display:none;" />
                    
                    <div class="action-bar mb-4 d-flex gap-2">
                         <button class="btn btn-sm btn-outline-secondary rounded-pill flex-grow-1" @onclick='() => JSRuntime.InvokeVoidAsync("LiquorScanner.triggerClick", "photo-upload")'>
                            <i class="bi bi-upload me-2"></i>Upload Photo
                        </button>
                    </div>
                }

                @if (!string.IsNullOrEmpty(_error))
                {
                    <div class="alert alert-danger rounded-3 py-2 small fw-bold mb-3">
                         @_error
                    </div>
                }

                <!-- DETAILS GRID -->
                <div class="details-grid">
                    <div class="row g-3 mb-3">
                        <div class="col-12">
                            <label class="small fw-black text-muted text-uppercase mb-2 ls-1">Bottle/Can Size</label>
                            <select class="form-select form-select-lg fw-bold rounded-3" @bind="_editingItem.BottleSize">
                                <option value="">-- Choose Size --</option>
                                <option value="50ml">50ml</option>
                                <option value="375ml">375ml</option>
                                <option value="750ml">750ml</option>
                                <option value="1L">1L</option>
                                <option value="1.75L">1.75L</option>
                                <option value="12oz">12oz (Can/Bottle)</option>
                                <option value="16oz">16oz (Pint)</option>
                            </select>
                        </div>
                    </div>

                    <!-- Row 2: Stock Management -->
                    <div class="p-4 bg-light rounded-4 mb-3 border border-secondary border-opacity-10">
                        <div class="row g-4">
                            <div class="col-12">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <label class="h6 fw-black text-muted mb-0">CURRENT INVENTORY</label>
                                    <span class="badge @(GetStockClass(_editingItem.CurrentStock, _editingItem.MinStockLimit)) rounded-pill px-3">
                                        @(GetStockClass(_editingItem.CurrentStock, _editingItem.MinStockLimit).ToUpper())
                                    </span>
                                </div>
                                
                                <div class="modern-stepper bg-white shadow-sm border mb-3">
                                    <button class="py-3" style="width: 60px;" @onclick="() => { if(_editingItem.CurrentStock > 0) _editingItem.CurrentStock--; }"><i class="bi bi-dash-lg"></i></button>
                                    <input type="number" class="fs-2 fw-black" @bind="_editingItem.CurrentStock" onfocus="this.setSelectionRange(0, 999); this.select();" />
                                    <button class="py-3" style="width: 60px;" @onclick="() => _editingItem.CurrentStock++"><i class="bi bi-plus-lg"></i></button>
                                </div>

                                <div class="d-flex gap-2 mb-4">
                                    <button class="btn btn-sm btn-white border flex-fill fw-bold py-2" @onclick="() => _editingItem.CurrentStock += 6">+6 <small class="text-muted">(Half Case)</small></button>
                                    <button class="btn btn-sm btn-white border flex-fill fw-bold py-2" @onclick="() => _editingItem.CurrentStock += 12">+12 <small class="text-muted">(Case)</small></button>
                                </div>
                            </div>

                            <div class="col-12">
                                <label class="small fw-black text-muted text-uppercase mb-2 ls-1">Low Stock Alert Threshold</label>
                                <div class="modern-stepper bg-white shadow-sm border border-warning border-opacity-25" style="height: 50px;">
                                    <button style="width: 50px;" @onclick="() => { if(_editingItem.MinStockLimit > 0) _editingItem.MinStockLimit--; }"><i class="bi bi-dash"></i></button>
                                    <input type="number" class="fw-bold" @bind="_editingItem.MinStockLimit" onfocus="this.setSelectionRange(0, 999); this.select();" />
                                    <button style="width: 50px;" @onclick="() => _editingItem.MinStockLimit++"><i class="bi bi-plus"></i></button>
                                </div>
                                <p class="small text-muted mt-2 mb-0">System will notify you when stock falls to or below this number.</p>
                            </div>
                        </div>
                    </div>
                </div>

            </div>

            <div class="modal-footer-modern gap-3">
                @if (_editingItem.Id != 0)
                {
                    <button class="btn btn-icon-only text-danger" @onclick="DeleteCurrent">
                        <i class="bi bi-trash3"></i>
                    </button>
                }
                <button class="btn btn-app-primary flex-grow-1 shadow-lg" @onclick="SaveItem" disabled="@_isUploadingImage">
                    @if (_isUploadingImage) 
                    { 
                        <span class="spinner-border spinner-border-sm me-2"></span> 
                        <span>Wait...</span>
                    }
                    else 
                    {
                        <span>@(_editingItem.Id == 0 ? "Create Product" : "Save Changes")</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

<style>
    /* COMPACT MODAL STYLES */
    .compact-photo-box {
        width: 88px;
        height: 88px;
        border-radius: 18px;
        background: #f8fafc;
        border: 2px dashed #e2e8f0;
        position: relative;
        overflow: hidden;
        cursor: pointer;
        display: flex;
        align-items: center;
