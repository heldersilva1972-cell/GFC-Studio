    public class PushSubscriptionJSON
    {
        public string endpoint { get; set; }
        public Keys keys { get; set; }
        public class Keys
        {
            public string p256dh { get; set; }
            public string auth { get; set; }
        }
    }

    private async Task SaveRules()
    {
        // 1. Save preferences
        await LiquorService.UpsertNotificationRuleAsync(_myRules);

        // 2. Handle Push Subscription
        if (_myRules.ReceivePush)
        {
            try 
            {
                // Check VAPID key
                var vapidKey = await NotificationService.GetVapidPublicKeyAsync();
                if (string.IsNullOrEmpty(vapidKey))
                {
                    await JSRuntime.InvokeVoidAsync("alert", "Push Notifications cannot be enabled: System VAPID keys are missing. Contact Admin.");
                    return;
                }

                // Request Browser Permission
                var permission = await JSRuntime.InvokeAsync<string>("GFC_Notifications.requestPermission");
                if (permission != "granted")
                {
                    await JSRuntime.InvokeVoidAsync("alert", "Push Permission Denied by Browser. Please reset permissions in site settings.");
                    return;
                }

                // Subscribe via Service Worker
                var subJson = await JSRuntime.InvokeAsync<string>("GFC_Notifications.subscribe", vapidKey);
                
                if (!string.IsNullOrEmpty(subJson))
                {
                    var subData = System.Text.Json.JsonSerializer.Deserialize<PushSubscriptionJSON>(subJson);
                    if (subData != null)
                    {
                        var user = AuthStateProvider.GetCurrentUser();
                        if (user != null)
                        {
                            await NotificationService.SubscribeToPushAsync(
                                user.UserId,
                                subData.endpoint,
                                subData.keys.p256dh,
                                subData.keys.auth,
                                "Mobile Device" // Could get UserAgent if needed
                            );
                            await JSRuntime.InvokeVoidAsync("alert", "Your device is now registered for stock alerts!");
                        }
                    }
                }
            }
            catch (Exception ex)
            {
                await JSRuntime.InvokeVoidAsync("alert", "Push Registration Failed: " + ex.Message);
            }
        }
        else
        {
             await JSRuntime.InvokeVoidAsync("alert", "Alert Rules Updated.");
        }
    }

